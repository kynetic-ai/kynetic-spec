   249→  describe("ac-daemon-unreachable", () => {
   250→    // AC: @doctor-command ac-daemon-unreachable
   251→    it("shows warning when daemon running but health endpoint unreachable", async () => {
   252→      initGitRepo(tempDir);
   253→      await initializeShadow(tempDir, { projectName: "test-project" });
   254→
   255→      // Mock getDaemonStatus to simulate daemon running but health unreachable
   256→      const daemonStatusModule = await import("../../src/parser/daemon-status.js");
   257→      const originalGetDaemonStatus = daemonStatusModule.getDaemonStatus;
   258→
   259→      vi.spyOn(daemonStatusModule, "getDaemonStatus").mockResolvedValue({
   260→        running: true,
   261→        pid: 12345,
   262→        port: 3456,
   263→        uptime: null,
   264→        healthReachable: false,
   265→      });
   266→
   267→      try {
   268→        const report = await getDoctorReport(tempDir);
   269→
   270→        // Should have daemon-running check as ok (process is alive)
   271→        const runningCheck = report.daemon.checks.find(
   272→          (c) => c.name === "daemon-running"
   273→        );
   274→        expect(runningCheck).toBeDefined();
   275→        expect(runningCheck!.severity).toBe("ok");
   276→        expect(runningCheck!.message).toContain("PID: 12345");
   277→
   278→        // Should have daemon-health check as warning (unreachable)
   279→        const healthCheck = report.daemon.checks.find(
   280→          (c) => c.name === "daemon-health"
   281→        );
   282→        expect(healthCheck).toBeDefined();
   283→        expect(healthCheck!.severity).toBe("warning");
   284→        expect(healthCheck!.message).toContain("unreachable");
   285→        expect(healthCheck!.guidance).toBeDefined();
   286→      } finally {
   287→        vi.restoreAllMocks();
   288→      }
   289→    });
   290→  });
   291→
