   497→  describe("CLI integration", () => {
   498→    // AC: @doctor-command ac-exit-zero
   499→    // AC: @trait-semantic-exit-codes ac-1
   500→    it("exits with code 0 when healthy (via CLI)", async () => {
   501→      initGitRepo(tempDir);
   502→      await initializeShadow(tempDir, { projectName: "test-project" });
   503→      // Create minimal setup to avoid errors
   504→      await fs.mkdir(path.join(tempDir, ".claude", "hooks"), { recursive: true });
   505→      await fs.writeFile(
   506→        path.join(tempDir, ".claude", "settings.json"),
   507→        JSON.stringify({
   508→          hooks: {
   509→            UserPromptSubmit: [{ hooks: [{ command: "prompt-check" }] }],
   510→          },
   511→        })
   512→      );
   513→      await fs.writeFile(
   514→        path.join(tempDir, "kspec-agents.md"),
   515→        "# Test agents"
   516→      );
   517→      await fs.writeFile(
   518→        path.join(tempDir, ".kspec", ".kspec-agents-hash"),
   519→        JSON.stringify({ metaHash: "test", generatedAt: new Date().toISOString() })
   520→      );
   521→
   522→      const result = kspec("doctor --json", tempDir);
   523→
   524→      // Parse the JSON and verify healthy status
   525→      const report = JSON.parse(result.stdout) as DoctorReport;
   526→
   527→      // AC: @doctor-command ac-exit-zero — exit code 0 when healthy
   528→      expect(result.exitCode).toBe(0);
   529→      // AC: @trait-semantic-exit-codes ac-1 — exit 0 indicates success
   530→      expect(report.overall.healthy).toBe(true);
   531→      expect(report.overall.errorCount).toBe(0);
   532→    });
   533→
   534→    // AC: @doctor-command ac-exit-one
   535→    // AC: @trait-semantic-exit-codes ac-2
   536→    it("exits with code 1 when errors exist (via CLI)", async () => {
   537→      initGitRepo(tempDir);
   538→      // Don't initialize - this creates errors
   539→
   540→      const result = kspec("doctor --json", tempDir, { expectFail: true });
   541→
   542→      expect(result.exitCode).toBe(1); // ERROR (health check failed)
   543→      const report = JSON.parse(result.stdout) as DoctorReport;
   544→      expect(report.overall.healthy).toBe(false);
   545→    });
   546→
   547→    // AC: @doctor-command ac-json-output
   548→    it("outputs valid JSON with --json flag", async () => {
   549→      initGitRepo(tempDir);
   550→      await initializeShadow(tempDir, { projectName: "test-project" });
   551→
