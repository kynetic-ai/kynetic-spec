   331→        path.join(tempDir, ".claude", "settings.json"),
   332→        JSON.stringify({
   333→          hooks: {
   334→            UserPromptSubmit: [{ hooks: [{ command: "prompt-check" }] }],
   335→          },
   336→        })
   337→      );
   338→      await fs.writeFile(
   339→        path.join(tempDir, "kspec-agents.md"),
   340→        "# Test agents"
   341→      );
   342→      // Create hash file
   343→      await fs.mkdir(path.join(tempDir, ".kspec"), { recursive: true });
   344→      await fs.writeFile(
   345→        path.join(tempDir, ".kspec", ".kspec-agents-hash"),
   346→        JSON.stringify({ metaHash: "test", generatedAt: new Date().toISOString() })
   347→      );
   348→
   349→      const report = await getDoctorReport(tempDir);
   350→
   351→      // Check overall verdict structure
   352→      expect(report.overall).toHaveProperty("healthy");
   353→      expect(report.overall).toHaveProperty("errorCount");
