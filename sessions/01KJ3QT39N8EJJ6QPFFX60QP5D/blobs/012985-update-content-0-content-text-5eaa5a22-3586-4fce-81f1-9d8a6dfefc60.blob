```
     1→/**
     2→ * Tests for kspec doctor command
     3→ *
     4→ * AC coverage:
     5→ * - @doctor-command ac-no-git-repo: No git repository returns error
     6→ * - @doctor-command ac-not-initialized: kspec not initialized returns error
     7→ * - @doctor-command ac-shadow-healthy: Shadow branch health checks
     8→ * - @doctor-command ac-setup-agent-hooks: Setup hooks status
     9→ * - @doctor-command ac-setup-skills-agents-md: Skills and agents.md status
    10→ * - @doctor-command ac-daemon-running: Daemon running status with PID/port/uptime
    11→ * - @doctor-command ac-daemon-unreachable: Daemon running but health unreachable
    12→ * - @doctor-command ac-daemon-not-running: Daemon not running is warning
    13→ * - @doctor-command ac-overall-verdict: Overall health verdict
    14→ * - @doctor-command ac-partial-init: Shadow ok but setup missing
    15→ * - @doctor-command ac-staleness-unknown: Agents.md staleness unknown
    16→ * - @doctor-command ac-json-output: JSON output format
    17→ * - @doctor-command ac-exit-zero: Exit 0 when healthy
    18→ * - @doctor-command ac-exit-one: Exit 1 when errors exist
    19→ */
    20→
    21→import { describe, it, expect, beforeEach, afterEach, vi } from "vitest";
    22→import * as fs from "node:fs/promises";
    23→import * as path from "node:path";
    24→import { getDoctorReport, type DoctorReport } from "../../src/parser/doctor.js";
    25→import { createTempDir, cleanupTempDir, initGitRepo, kspec } from "../helpers/cli.js";
    26→import { initializeShadow } from "../../src/parser/shadow.js";
    27→
    28→describe("Doctor Command", () => {
    29→  let tempDir: string;
    30→  let originalCwd: string;
    31→
    32→  beforeEach(async () => {
    33→    tempDir = await createTempDir("kspec-doctor-test-");
    34→    originalCwd = process.cwd();
    35→  });
    36→
    37→  afterEach(async () => {
    38→    process.chdir(originalCwd);
    39→    await cleanupTempDir(tempDir);
    40→  });
    41→
    42→  describe("ac-no-git-repo", () => {
    43→    // AC: @doctor-command ac-no-git-repo
    44→    it("returns error when not in a git repository", async () => {
    45→      // tempDir is not a git repo
    46→      const report = await getDoctorReport(tempDir);
    47→
    48→      expect(report.shadow.checks.length).toBeGreaterThan(0);
    49→      expect(report.shadow.checks[0].severity).toBe("error");
    50→      expect(report.shadow.checks[0].message).toContain("git");
    51→      expect(report.overall.healthy).toBe(false);
    52→      expect(report.overall.errorCount).toBe(1);
    53→    });
    54→  });
    55→
    56→  describe("ac-not-initialized", () => {
    57→    // AC: @doctor-command ac-not-initialized
    58→    it("returns error when kspec is not initialized", async () => {
    59→      initGitRepo(tempDir);
    60→
    61→      const report = await getDoctorReport(tempDir);
    62→
    63→      // Should have shadow checks but fail on initialization
    64→      const initCheck = report.shadow.checks.find(
    65→        (c) => c.name === "initialized" || c.name === "branch-exists"
    66→      );
    67→      expect(initCheck).toBeDefined();
    68→      expect(initCheck!.severity).toBe("error");
    69→      expect(report.overall.healthy).toBe(false);
    70→    });
    71→
    72→    // AC: @doctor-command ac-not-initialized
    73→    it("provides guidance to run kspec init", async () => {
    74→      initGitRepo(tempDir);
    75→
    76→      const report = await getDoctorReport(tempDir);
    77→
    78→      const errorCheck = report.shadow.checks.find((c) => c.severity === "error");
    79→      expect(errorCheck).toBeDefined();
    80→      expect(errorCheck!.guidance).toContain("kspec init");
    81→    });
    82→  });
    83→
    84→  describe("ac-shadow-healthy", () => {
