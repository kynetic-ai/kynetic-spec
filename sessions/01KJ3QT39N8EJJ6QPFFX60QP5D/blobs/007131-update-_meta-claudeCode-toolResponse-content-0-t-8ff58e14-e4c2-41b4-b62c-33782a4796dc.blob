  import { commitIfShadow } from '../../parser/shadow.js';
  ```

**Problem**: When `bun build --compile` bundles the daemon, these relative paths require the `src/parser/` and `src/utils/` directories to exist at the **same relative paths** in the final bundle. The build process (`src/` → `dist/daemon/`) preserves these but requires careful path resolution.

### 6. Main Entry Point: packages/daemon/src/index.ts

```typescript
#!/usr/bin/env bun
/**
 * Kspec Daemon Entry Point
 * 
 * Long-running server that exposes kspec state via HTTP API and WebSocket.
 * Supports foreground and background modes with PID file management.
 * AC: @daemon-server ac-9
 */

import { createServer } from './server.js';
import { parseArgs } from 'util';
import { join } from 'path';

// Parse command line args
const { values } = parseArgs({
  args: process.argv.slice(2),
  options: {
    port: { type: 'string', default: '3456' },
    'kspec-dir': { type: 'string' }
  },
  allowPositionals: true
});

const port = parseInt(values.port as string, 10);
const kspecDir = (values['kspec-dir'] as string) || join(process.cwd(), '.kspec');

async function main() {
  try {
    console.log(`[daemon] Starting kspec daemon on port ${port}...`);
    const server = await createServer({
      port,
      isDaemon: true,
      kspecDir
    });
  } catch (error) {
    console.error('[daemon] Failed to start:', error);
    process.exit(1);
  }
}

main();
```

**Key points:**
- Shebang `#!/usr/bin/env bun` allows direct execution on Unix systems
- Accepts `--port` (default 3456) and `--kspec-dir` arguments
- Delegates to `createServer()` with `isDaemon: true`
- No explicit port/URL listening log—that happens in server.ts

### 7. Server Setup: packages/daemon/src/server.ts

**createServer() function** (404 lines):

1. **Port/Directory Setup**:
   - Default port: 3456
   - Default kspecDir: `.kspec` in process.cwd()
   - Derives startup project path (parent of `.kspec`)

2. **Initialization Chain**:
   ```typescript
   - PidFileManager() → writes ~/.config/kspec/daemon.pid and daemon.port
   - PubSubManager() → WebSocket pub/sub
   - HeartbeatManager() → periodic ping/pong checks
   - WebSocketHandler() → message routing
   - ProjectContextManager() → multi-project support
   ```

3. **Elysia.js Setup**:
   ```typescript
   const app = new Elysia()
     .use(cors(...))                              // CORS for localhost:5173
     .onRequest(localhostOnly())                  // Reject non-localhost
     .use(projectContextMiddleware(...))          // X-Kspec-Dir extraction
     .get('/api/health', ...)                     // Health check
     .use(createTasksRoutes(...))                 // Task API
     .use(createItemsRoutes(...))                 // Item API
     .use(createInboxRoutes(...))                 // Inbox API
     .use(createMetaRoutes(...))                  // Meta API
     .use(createValidationRoutes(...))            // Validation API
     .use(createProjectsRoutes(...))              // Projects API
     .ws('/ws', ...)                              // WebSocket endpoint
     .use(staticPlugin(...))                      // Web UI serving
   ```

4. **Middleware Features**:
   - **localhostOnly()**: Enforces 127.0.0.1, ::1, or localhost hostname
   - **projectContextMiddleware()**: Extracts `X-Kspec-Dir` header, auto-registers projects, stores in `request.projectContext`

5. **WebSocket Binding**:
   - Supports `X-Kspec-Dir` header OR `?project=` query param
   - Auto-registers projects on first connection
   - Stores immutable project path in `ws.data.projectPath`
   - Broadcasts on `files:updates`, `tasks:updates`, `inbox:updates`, `files:errors`

6. **Graceful Shutdown**:
   - Handles SIGTERM/SIGINT
   - Stops all watchers
   - Closes WebSocket connections
   - Removes PID files

### 8. Root Package Build Script

**From root package.json:**
```json
{
  "scripts": {
    "build": "tsc && chmod +x dist/cli/index.js && npm run build:daemon && npm run build:plugin",
    "build:daemon": "shx rm -rf dist/daemon && shx mkdir -p dist/daemon && shx cp -r packages/daemon/src/* dist/daemon/",
  }
}
```

**What `npm run build:daemon` does:**
1. Removes existing `dist/daemon/` directory
2. Creates fresh `dist/daemon/` directory
3. **Copies entire `packages/daemon/src/*` to `dist/daemon/`** (TypeScript source files, NOT compiled)

**Why this matters**: 
- The daemon **source files** end up in the root `dist/` alongside compiled root code
- This enables the relative imports (`../../parser/`, `../../utils/`) to work from the bundled paths
- When `bun build --compile` runs, it finds these copied source files alongside parser/utils

**Build pipeline:**
```
1. tsc                    → Compile root TypeScript (src/ → dist/)
2. chmod +x dist/cli/index.js
3. npm run build:daemon   → Copy daemon sources to dist/daemon/
4. npm run build:plugin   → Process plugin assets
5. bun build --compile    → Bundle daemon executable (can find ../../parser now)
```

