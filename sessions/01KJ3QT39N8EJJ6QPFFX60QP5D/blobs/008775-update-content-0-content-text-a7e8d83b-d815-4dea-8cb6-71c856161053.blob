```
     1→/**
     2→ * Triage API Routes
     3→ *
     4→ * REST endpoints for triage operations:
     5→ * - GET /api/triage - list records with filters and pagination
     6→ * - GET /api/triage/export - export records for agent handoff
     7→ * - POST /api/triage - record a triage decision
     8→ * - GET /api/triage/:ref - get single record
     9→ * - POST /api/triage/:ref/override - override a decision
    10→ * - POST /api/triage/:ref/act - execute a triage action
    11→ *
    12→ * AC Coverage:
    13→ * - @triage-daemon-api ac-1: GET list sorted by created_at desc
    14→ * - @triage-daemon-api ac-2: Status filter on GET list
    15→ * - @triage-daemon-api ac-3: POST creates record with snapshot
    16→ * - @triage-daemon-api ac-4: PUT override sets override fields
    17→ * - @triage-daemon-api ac-5: PUT act executes and transitions
    18→ * - @triage-daemon-api ac-6: GET export with format parameter
    19→ * - @triage-daemon-api ac-7: POST 404 for nonexistent inbox item
    20→ * - @triage-daemon-api ac-8: PUT act 409 for already acted
    21→ * - @triage-daemon-api ac-9: PUT act 422 for pending record
    22→ */
    23→
    24→import { Elysia, t } from 'elysia';
    25→import { ulid } from 'ulidx';
    26→import {
    27→  initContext,
    28→  loadTriageRecords,
    29→  saveTriageRecord,
    30→  findTriageRecordByRef,
    31→  loadInboxItems,
    32→  findInboxItemByRef,
    33→  loadAllTasks,
    34→  loadAllItems,
    35→  ReferenceIndex,
    36→  getAuthor,
    37→  createObservation,
    38→  saveObservation,
    39→  createTask,
    40→  saveTask,
    41→  deleteInboxItem,
    42→  type LoadedTriageRecord,
    43→} from '../../parser/index.js';
    44→import { commitIfShadow } from '../../parser/shadow.js';
    45→import type { TriageAction } from '../../schema/index.js';
    46→import type { PubSubManager } from '../websocket/pubsub';
    47→
    48→interface TriageRouteOptions {
    49→  pubsub: PubSubManager;
    50→}
    51→
    52→const VALID_ACTIONS = ['promote', 'delete', 'defer', 'spec-gap', 'duplicate'];
    53→
    54→/**
    55→ * Truncate text for display
    56→ */
    57→function truncateText(text: string, maxLen: number = 60): string {
    58→  const firstLine = text.split('\n')[0].trim();
    59→  if (firstLine.length <= maxLen) return firstLine;
    60→  return `${firstLine.slice(0, maxLen - 3)}...`;
    61→}
    62→
    63→/**
    64→ * Format a triage record for context export
    65→ * AC: @triage-daemon-api ac-6
    66→ */
    67→function formatTriageContext(record: LoadedTriageRecord): string {
    68→  const lines: string[] = [];
    69→  lines.push(`### ${record._ulid.slice(0, 8)} — ${truncateText(record.item_snapshot, 80)}`);
    70→  lines.push('');
    71→  lines.push(`**Item:** ${record.item_snapshot}`);
    72→  lines.push(`**Status:** ${record.status}`);
    73→  if (record.action) lines.push(`**Action:** ${record.action}`);
    74→  if (record.reasoning) lines.push(`**Reasoning:** ${record.reasoning}`);
    75→  if (record.decided_by) lines.push(`**Decided by:** ${record.decided_by}`);
    76→  if (record.evidence_refs.length > 0) {
    77→    lines.push(`**Evidence:** ${record.evidence_refs.join(', ')}`);
    78→  }
    79→  if (record.override_reasoning) {
    80→    lines.push(`**Override:** ${record.override_reasoning} (by ${record.override_by || 'unknown'})`);
    81→  }
    82→  if (record.acted_at) {
    83→    lines.push(`**Acted at:** ${record.acted_at}`);
    84→    if (record.result_ref) lines.push(`**Result:** ${record.result_ref}`);
    85→  }
    86→  lines.push('');
    87→  return lines.join('\n');
    88→}
    89→
    90→/**
    91→ * Execute a triage action (reused from CLI logic)
    92→ * AC: @triage-daemon-api ac-5
    93→ */
    94→async function executeTriageAction(
    95→  record: LoadedTriageRecord,
    96→  ctx: Awaited<ReturnType<typeof initContext>>,
    97→): Promise<{ resultRef?: string }> {
    98→  const action = record.action;
    99→  if (!action) return {};
   100→
   101→  switch (action) {
   102→    case 'promote': {
   103→      const task = createTask({
   104→        title: record.item_snapshot.split('\n')[0].slice(0, 100),
   105→        type: 'task',
   106→        priority: 3,
   107→        spec_ref: null,
   108→        tags: [],
   109→        description: record.item_snapshot,
   110→      });
   111→      await saveTask(ctx, task);
   112→      const tasks = await loadAllTasks(ctx);
   113→      const items = await loadAllItems(ctx);
   114→      const index = new ReferenceIndex(tasks, items);
   115→      const taskRef = `@${index.shortUlid(task._ulid)}`;
   116→      return { resultRef: taskRef };
   117→    }
   118→
   119→    case 'delete':
   120→    case 'duplicate': {
   121→      const inboxItems = await loadInboxItems(ctx);
   122→      const inboxItem = findInboxItemByRef(inboxItems, record.inbox_ref);
   123→      if (inboxItem) {
   124→        await deleteInboxItem(ctx, inboxItem._ulid);
   125→      }
   126→      return {};
   127→    }
   128→
   129→    case 'defer': {
   130→      return {};
   131→    }
   132→
   133→    case 'spec-gap': {
   134→      const content = `[spec-gap] ${record.item_snapshot}\n\nReasoning: ${record.reasoning || ''}`;
   135→      const observation = createObservation('question', content, {
   136→        configAuthor: ctx.config?.identity?.author,
   137→      });
   138→      await saveObservation(ctx, observation);
   139→      const obsRef = `@${observation._ulid.slice(0, 8)}`;
   140→      return { resultRef: obsRef };
   141→    }
   142→
   143→    default:
   144→      return {};
   145→  }
   146→}
   147→
   148→export function createTriageRoutes(options: TriageRouteOptions) {
   149→  const { pubsub } = options;
   150→
   151→  return new Elysia({ prefix: '/api/triage' })
   152→    // AC: @triage-daemon-api ac-1, ac-2 - List triage records with filters and pagination
   153→    // AC: @trait-api-endpoint ac-1, ac-4 - JSON response with pagination wrapper
   154→    .get(
   155→      '/',
   156→      async ({ query, projectContext }) => {
   157→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   158→        const ctx = await initContext(projectContext.path);
   159→        const records = await loadTriageRecords(ctx);
   160→
   161→        // Apply filters
   162→        let filtered = records;
   163→
   164→        // AC: @triage-daemon-api ac-2 - Status filter
   165→        if (query.status) {
   166→          const statusFilters = Array.isArray(query.status) ? query.status : [query.status];
   167→          filtered = filtered.filter((r) => statusFilters.includes(r.status));
   168→        }
   169→
   170→        // Action filter
   171→        if (query.action) {
   172→          const actionFilters = Array.isArray(query.action) ? query.action : [query.action];
   173→          filtered = filtered.filter((r) => r.action && actionFilters.includes(r.action));
   174→        }
   175→
   176→        // AC: @triage-daemon-api ac-1 - Sort by created_at descending (newest first)
   177→        filtered.sort(
   178→          (a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime()
   179→        );
   180→
   181→        // AC: @trait-api-endpoint ac-4 - Pagination with limit and offset
   182→        const total = filtered.length;
   183→        const offset = Number(query.offset) || 0;
   184→        const limit = Number(query.limit) || total;
   185→
   186→        const paginated = filtered.slice(offset, offset + limit);
   187→
   188→        return {
   189→          items: paginated,
   190→          total,
   191→          offset,
   192→          limit,
   193→        };
   194→      },
   195→      {
   196→        query: t.Object({
   197→          status: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   198→          action: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   199→          limit: t.Optional(t.String()),
   200→          offset: t.Optional(t.String()),
   201→        }),
   202→      }
   203→    )
   204→
   205→    // AC: @triage-daemon-api ac-6 - Export triage records
   206→    // NOTE: This route MUST be defined before /:ref to avoid "export" being parsed as a ref
   207→    .get(
   208→      '/export',
   209→      async ({ query, projectContext }) => {
   210→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   211→        const ctx = await initContext(projectContext.path);
   212→        let records = await loadTriageRecords(ctx);
   213→
   214→        // Optional status filter on export
   215→        if (query.status) {
   216→          const statusFilters = Array.isArray(query.status) ? query.status : [query.status];
   217→          records = records.filter((r) => statusFilters.includes(r.status));
   218→        }
   219→
   220→        const format = query.format || 'json';
   221→
   222→        if (format === 'context') {
   223→          // AC: @triage-daemon-api ac-6 - Context markdown format
   224→          if (records.length === 0) {
   225→            return { format: 'context', content: 'No triage decisions recorded.' };
   226→          }
   227→          let content = '# Triage Decisions\n\n';
   228→          for (const record of records) {
   229→            content += formatTriageContext(record);
   230→          }
   231→          return { format: 'context', content };
   232→        }
   233→
   234→        // AC: @triage-daemon-api ac-6 - JSON format (default)
   235→        return {
   236→          format: 'json',
   237→          items: records,
   238→          total: records.length,
   239→        };
   240→      },
   241→      {
   242→        query: t.Object({
   243→          format: t.Optional(t.String()),
   244→          status: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   245→        }),
   246→      }
   247→    )
   248→
   249→    // AC: @triage-daemon-api ac-3 - Record a triage decision
   250→    // AC: @trait-api-endpoint ac-1, ac-3, ac-5 - JSON response, validation, shadow commit
   251→    .post(
   252→      '/',
   253→      async ({ body, error: errorResponse, projectContext }) => {
   254→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   255→        const ctx = await initContext(projectContext.path);
   256→
   257→        // AC: @trait-api-endpoint ac-3 - Validate action
   258→        if (!VALID_ACTIONS.includes(body.action)) {
   259→          return errorResponse(400, {
   260→            error: 'validation_error',
   261→            details: [
   262→              {
   263→                field: 'action',
   264→                message: `Action must be one of: ${VALID_ACTIONS.join(', ')}`,
   265→              },
   266→            ],
   267→          });
   268→        }
   269→
   270→        // AC: @triage-daemon-api ac-7 - Validate inbox item exists
   271→        const inboxItems = await loadInboxItems(ctx);
   272→        const inboxItem = findInboxItemByRef(inboxItems, body.inbox_ref);
   273→        if (!inboxItem) {
   274→          // AC: @trait-api-endpoint ac-2 - 404 with error guidance
   275→          return errorResponse(404, {
   276→            error: 'not_found',
   277→            message: `Inbox item reference "${body.inbox_ref}" not found`,
   278→            suggestion: 'Use kspec inbox list or GET /api/inbox to find valid inbox item references',
   279→          });
   280→        }
   281→
   282→        const author = body.decided_by || getAuthor(ctx.config?.identity?.author);
   283→        const evidenceRefs = body.evidence_refs
   284→          ? body.evidence_refs.map((r: string) => r.startsWith('@') ? r : `@${r}`)
   285→          : [];
   286→
   287→        // AC: @triage-daemon-api ac-3 - Create record with item_snapshot
   288→        const record: LoadedTriageRecord = {
   289→          _ulid: ulid(),
   290→          inbox_ref: inboxItem._ulid,
   291→          item_snapshot: inboxItem.text,
   292→          status: 'triaged',
   293→          action: body.action as TriageAction,
   294→          reasoning: body.reasoning,
   295→          decided_by: author,
   296→          evidence_refs: evidenceRefs,
   297→          created_at: new Date().toISOString(),
   298→        };
   299→
   300→        await saveTriageRecord(ctx, record);
   301→
   302→        // AC: @trait-api-endpoint ac-5 - Shadow commit
   303→        await commitIfShadow(ctx.shadow, `triage: record ${record._ulid.slice(0, 8)} as ${record.action}`);
   304→
   305→        // AC: @triage-daemon-api ac-3 - Broadcast triage:updates via WebSocket
   306→        // AC: @trait-websocket-protocol ac-3 - Broadcast event
   307→        pubsub.broadcast('triage:updates', 'triage_record_created', {
   308→          ulid: record._ulid,
   309→          inbox_ref: record.inbox_ref,
   310→          action: record.action,
   311→        }, projectContext.path);
   312→
   313→        // AC: @trait-api-endpoint ac-1 - Return 2xx with JSON body
   314→        return {
   315→          success: true,
   316→          record,
   317→        };
   318→      },
   319→      {
   320→        body: t.Object({
   321→          inbox_ref: t.String(),
   322→          action: t.String(),
   323→          reasoning: t.String(),
   324→          decided_by: t.Optional(t.String()),
   325→          evidence_refs: t.Optional(t.Array(t.String())),
   326→        }),
   327→      }
   328→    )
   329→
   330→    // GET single triage record
   331→    .get(
   332→      '/:ref',
   333→      async ({ params, error: errorResponse, projectContext }) => {
   334→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   335→        const ctx = await initContext(projectContext.path);
   336→        const records = await loadTriageRecords(ctx);
   337→
   338→        // AC: @trait-api-endpoint ac-2 - Resolve ref
   339→        const record = findTriageRecordByRef(records, params.ref);
   340→        if (!record) {
   341→          return errorResponse(404, {
   342→            error: 'not_found',
   343→            message: `Triage record reference "${params.ref}" not found`,
   344→            suggestion: 'Use kspec triage list or GET /api/triage to find valid triage record references',
   345→          });
   346→        }
   347→
   348→        return record;
   349→      },
   350→      {
   351→        params: t.Object({
   352→          ref: t.String(),
   353→        }),
   354→      }
   355→    )
   356→
   357→    // AC: @triage-daemon-api ac-4 - Override a triage decision
   358→    // AC: @trait-api-endpoint ac-1, ac-5 - JSON response, shadow commit
   359→    .post(
   360→      '/:ref/override',
   361→      async ({ params, body, error: errorResponse, projectContext }) => {
   362→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   363→        const ctx = await initContext(projectContext.path);
   364→        const records = await loadTriageRecords(ctx);
   365→
   366→        // AC: @trait-api-endpoint ac-2 - Resolve ref
   367→        const record = findTriageRecordByRef(records, params.ref);
   368→        if (!record) {
   369→          return errorResponse(404, {
   370→            error: 'not_found',
   371→            message: `Triage record reference "${params.ref}" not found`,
   372→            suggestion: 'Use kspec triage list or GET /api/triage to find valid triage record references',
   373→          });
   374→        }
   375→
   376→        // AC: @trait-api-endpoint ac-3 - Validate action
   377→        if (!VALID_ACTIONS.includes(body.action)) {
   378→          return errorResponse(400, {
   379→            error: 'validation_error',
   380→            details: [
   381→              {
   382→                field: 'action',
   383→                message: `Action must be one of: ${VALID_ACTIONS.join(', ')}`,
   384→              },
   385→            ],
   386→          });
   387→        }
   388→
   389→        const overrideBy = body.override_by || getAuthor(ctx.config?.identity?.author);
   390→
   391→        // AC: @triage-daemon-api ac-4 - Set override fields and update action
   392→        record.override_reasoning = body.reasoning;
   393→        record.override_by = overrideBy;
   394→        record.override_at = new Date().toISOString();
   395→        record.action = body.action as TriageAction;
   396→        record.updated_at = new Date().toISOString();
   397→
   398→        // Re-triage if already acted on (allows re-acting with new action)
   399→        if (record.status === 'acted_on') {
   400→          record.status = 'triaged';
   401→        }
   402→
   403→        await saveTriageRecord(ctx, record);
   404→
   405→        // AC: @trait-api-endpoint ac-5 - Shadow commit
   406→        await commitIfShadow(ctx.shadow, `triage: override ${record._ulid.slice(0, 8)}`);
   407→
   408→        // AC: @triage-daemon-api ac-4 - Broadcast triage:updates
   409→        pubsub.broadcast('triage:updates', 'triage_record_updated', {
   410→          ulid: record._ulid,
   411→          action: 'override',
   412→          new_action: record.action,
   413→        }, projectContext.path);
   414→
   415→        return {
   416→          success: true,
   417→          record,
   418→        };
   419→      },
   420→      {
   421→        params: t.Object({
   422→          ref: t.String(),
   423→        }),
   424→        body: t.Object({
   425→          action: t.String(),
   426→          reasoning: t.String(),
   427→          override_by: t.Optional(t.String()),
   428→        }),
   429→      }
   430→    )
   431→
   432→    // AC: @triage-daemon-api ac-5, ac-8, ac-9 - Execute a triage action
   433→    // AC: @trait-api-endpoint ac-1, ac-5 - JSON response, shadow commit
   434→    .post(
   435→      '/:ref/act',
   436→      async ({ params, error: errorResponse, projectContext }) => {
   437→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   438→        const ctx = await initContext(projectContext.path);
   439→        const records = await loadTriageRecords(ctx);
   440→
   441→        // AC: @trait-api-endpoint ac-2 - Resolve ref
   442→        const record = findTriageRecordByRef(records, params.ref);
   443→        if (!record) {
   444→          return errorResponse(404, {
   445→            error: 'not_found',
   446→            message: `Triage record reference "${params.ref}" not found`,
   447→            suggestion: 'Use kspec triage list or GET /api/triage to find valid triage record references',
   448→          });
   449→        }
   450→
   451→        // AC: @triage-daemon-api ac-8 - Already acted on → 409
   452→        if (record.status === 'acted_on') {
   453→          return errorResponse(409, {
   454→            error: 'invalid_transition',
   455→            message: 'Triage record has already been acted on',
   456→            current: record.status,
   457→            suggestion: 'Use override to change the decision before acting again',
   458→          });
   459→        }
   460→
   461→        // AC: @triage-daemon-api ac-9 - Pending (no decision) → 422
   462→        if (record.status === 'pending') {
   463→          return errorResponse(422, {
   464→            error: 'incomplete_record',
   465→            message: 'No decision has been recorded for this triage record. Complete triage first.',
   466→            suggestion: 'Use POST /api/triage to record a decision, or kspec triage record <inbox-ref> --action <action> --reasoning <text>',
   467→          });
   468→        }
   469→
   470→        // AC: @triage-daemon-api ac-5 - Execute the action
   471→        const result = await executeTriageAction(record, ctx);
   472→
   473→        // Transition to acted_on
   474→        record.status = 'acted_on';
   475→        record.acted_at = new Date().toISOString();
   476→        if (result.resultRef) {
   477→          record.result_ref = result.resultRef;
   478→        }
   479→        record.updated_at = new Date().toISOString();
   480→
   481→        await saveTriageRecord(ctx, record);
   482→
   483→        // AC: @trait-api-endpoint ac-5 - Shadow commit
   484→        await commitIfShadow(ctx.shadow, `triage: act ${record._ulid.slice(0, 8)}`);
   485→
   486→        // AC: @triage-daemon-api ac-5 - Broadcast triage:updates
   487→        pubsub.broadcast('triage:updates', 'triage_record_acted', {
   488→          ulid: record._ulid,
   489→          action: record.action,
   490→          result_ref: record.result_ref,
   491→        }, projectContext.path);
   492→
   493→        return {
   494→          success: true,
   495→          record,
   496→        };
   497→      },
   498→      {
   499→        params: t.Object({
   500→          ref: t.String(),
   501→        }),
   502→      }
   503→    );
   504→}
   505→
```