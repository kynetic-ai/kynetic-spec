   333→  describe('Export format', () => {
   334→    it('should support context markdown format via shared formatter', async () => {
   335→      const content = await readFile(ROUTES_PATH, 'utf-8');
   336→
   337→      // AC: @triage-daemon-api ac-6 - Uses shared export formatter
   338→      // AC: @triage-agent-export ac-1 - Shared formatter for context format
