   340→
   341→      // Verify the shared formatter produces the expected markdown fields
   342→      const { exportTriageAsContext } = await import('../src/export/triage.js');
   343→      const mockRecord = {
   344→        _ulid: '01TESTUL1D000000000000000',
   345→        inbox_ref: '01INBOXRE000000000000000F',
   346→        item_snapshot: 'Test item',
   347→        status: 'triaged' as const,
   348→        action: 'promote' as const,
   349→        reasoning: 'Test reasoning',
   350→        decided_by: '@claude',
   351→        evidence_refs: [],
