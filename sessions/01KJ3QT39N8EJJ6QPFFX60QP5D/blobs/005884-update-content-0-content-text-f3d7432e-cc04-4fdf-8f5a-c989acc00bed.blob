   513→describe("kspec triage start (interactive)", () => {
   514→  // AC: @triage-cli-commands ac-9
   515→  it("should show message when no untriaged items exist", () => {
   516→    const result = kspec("triage start", tempDir);
   517→    expect(result.stdout).toContain("No untriaged inbox items");
   518→  });
   519→
   520→  // AC: @triage-cli-commands ac-9
   521→  it("should skip already-triaged items and show correct count", () => {
   522→    const ulid1 = addInboxItem("Already triaged");
   523→    addInboxItem("Not yet triaged");
   524→    recordTriage(ulid1, "defer", "already done");
   525→
   526→    // Start interactive triage — with EOF on stdin, it will display but not record
   527→    // The key assertion is the count and which items are shown
   528→    const result = kspec(
   529→      "triage start",
   530→      tempDir,
   531→      { stdin: "skip\n" },
   532→    );
   533→    // Should show only 1 item to review (the untriaged one)
   534→    expect(result.stdout).toContain("1 item(s) to review");
   535→    // Should show the untriaged item text
   536→    expect(result.stdout).toContain("Not yet triaged");
   537→    // Should NOT show the already-triaged item
   538→    expect(result.stdout).not.toContain("Already triaged");
   539→  });
   540→
   541→  // AC: @triage-cli-commands ac-10 (partial — tests EOF preservation, not SIGINT)
   542→  it("should preserve records that were committed before input ends", () => {
   543→    addInboxItem("First item to triage");
   544→    addInboxItem("Second item to triage");
   545→
   546→    // Provide action+reasoning for first item, then skip second
   547→    // Each triage record is committed individually, so even if the process
   548→    // ends early, committed records are preserved
   549→    const result = kspec(
   550→      "triage start",
   551→      tempDir,
   552→      { stdin: "defer\nfirst item reasoning\nskip\n" },
   553→    );
   554→
   555→    // At least one record should have been created
   556→    const records = kspecJson<Array<{ status: string }>>(
   557→      "triage list",
   558→      tempDir,
   559→    );
   560→    expect(records.length).toBeGreaterThanOrEqual(1);
   561→    expect(records.some((r) => r.status === "triaged")).toBe(true);
   562→  });
   563→});
