   196→    const records = kspecJson<Array<{ _ulid: string; status: string }>>(
   197→      "triage list",
   198→      tempDir,
   199→    );
   200→    expect(Array.isArray(records)).toBe(true);
   201→    expect(records.length).toBe(1);
   202→    expect(records[0]._ulid).toBeDefined();
   203→  });
   204→
   205→  // AC: @trait-filterable-list ac-6
   206→  it("should show empty message when no records exist", () => {
   207→    const result = kspec("triage list", tempDir);
   208→    expect(result.stdout).toContain("No triage records");
   209→  });
   210→
   211→  // AC: @trait-filterable-list ac-4
   212→  it("should support --offset to skip first N results", () => {
   213→    const ulid1 = addInboxItem("Offset test 1");
   214→    const ulid2 = addInboxItem("Offset test 2");
   215→    const ulid3 = addInboxItem("Offset test 3");
   216→    recordTriage(ulid1, "promote", "first");
   217→    recordTriage(ulid2, "defer", "second");
   218→    recordTriage(ulid3, "delete", "third");
   219→
   220→    const all = kspecJson<Array<{ _ulid: string }>>("triage list", tempDir);
   221→    expect(all.length).toBe(3);
   222→
   223→    const offset1 = kspecJson<Array<{ _ulid: string }>>("triage list --offset 1", tempDir);
   224→    expect(offset1.length).toBe(2);
