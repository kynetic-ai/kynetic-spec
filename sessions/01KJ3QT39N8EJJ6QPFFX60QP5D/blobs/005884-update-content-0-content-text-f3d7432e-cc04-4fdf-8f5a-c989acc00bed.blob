   243→describe("kspec triage act", () => {
   244→  // AC: @triage-cli-commands ac-4
   245→  it("should execute promote action creating a task from snapshot", () => {
   246→    const inboxUlid = addInboxItem("Create this as a task");
   247→    const record = recordTriage(inboxUlid, "promote", "clear feature");
   248→
   249→    const result = kspec(
   250→      `triage act @${record._ulid.slice(0, 8)}`,
   251→      tempDir,
   252→    );
   253→    expect(result.stdout).toContain("Acted on triage record");
   254→    expect(result.stdout).toContain("promote");
   255→
   256→    // Verify record transitioned to acted_on
   257→    const records = kspecJson<Array<{ _ulid: string; status: string; acted_at: string; result_ref: string }>>(
   258→      "triage list",
   259→      tempDir,
   260→    );
   261→    const acted = records.find((r) => r._ulid === record._ulid);
   262→    expect(acted).toBeDefined();
   263→    expect(acted!.status).toBe("acted_on");
   264→    expect(acted!.acted_at).toBeDefined();
   265→    expect(acted!.result_ref).toBeDefined();
   266→  });
   267→
   268→  // AC: @triage-cli-commands ac-5
   269→  it("should execute delete action removing inbox item", () => {
   270→    const inboxUlid = addInboxItem("Delete this item");
   271→    const record = recordTriage(inboxUlid, "delete", "not needed");
   272→
   273→    kspec(`triage act @${record._ulid.slice(0, 8)}`, tempDir);
   274→
   275→    // Verify inbox item was deleted
   276→    const inboxResult = kspecJson<Array<{ _ulid: string }>>(
   277→      "inbox list",
   278→      tempDir,
   279→    );
   280→    const found = inboxResult.find((item) => item._ulid === inboxUlid);
   281→    expect(found).toBeUndefined();
   282→  });
   283→
   284→  // AC: @triage-cli-commands ac-6
   285→  it("should execute defer action with no side effects", () => {
   286→    const inboxUlid = addInboxItem("Defer this item");
   287→    const record = recordTriage(inboxUlid, "defer", "not ready yet");
   288→
   289→    kspec(`triage act @${record._ulid.slice(0, 8)}`, tempDir);
   290→
   291→    // Verify record transitioned to acted_on
   292→    const records = kspecJson<Array<{ _ulid: string; status: string }>>(
   293→      "triage list",
   294→      tempDir,
   295→    );
   296→    const acted = records.find((r) => r._ulid === record._ulid);
   297→    expect(acted!.status).toBe("acted_on");
   298→
   299→    // Inbox item should still exist
   300→    const inboxResult = kspecJson<Array<{ _ulid: string }>>(
   301→      "inbox list",
   302→      tempDir,
   303→    );
   304→    const inboxItem = inboxResult.find((item) => item._ulid === inboxUlid);
   305→    expect(inboxItem).toBeDefined();
   306→  });
   307→
   308→  // AC: @triage-cli-commands ac-7
   309→  it("should execute spec-gap action creating an observation tagged spec-gap", () => {
   310→    const inboxUlid = addInboxItem("Spec gap identified here");
   311→    const record = recordTriage(inboxUlid, "spec-gap", "needs spec review");
   312→
   313→    const result = kspec(`triage act @${record._ulid.slice(0, 8)}`, tempDir);
   314→    expect(result.stdout).toContain("Acted on triage record");
   315→    expect(result.stdout).toContain("spec-gap observation");
   316→
   317→    // Verify record has result_ref
   318→    const records = kspecJson<Array<{ _ulid: string; status: string; result_ref: string }>>(
   319→      "triage list",
   320→      tempDir,
   321→    );
   322→    const acted = records.find((r) => r._ulid === record._ulid);
   323→    expect(acted!.status).toBe("acted_on");
   324→    expect(acted!.result_ref).toBeDefined();
   325→
   326→    // Verify the observation contains spec-gap marker
   327→    const observations = kspecJson<Array<{ type: string; content: string }>>(
   328→      "meta observations --all",
   329→      tempDir,
   330→    );
   331→    const specGapObs = observations.find((o) => o.content.includes("[spec-gap]"));
   332→    expect(specGapObs).toBeDefined();
   333→    expect(specGapObs!.type).toBe("question");
   334→    expect(specGapObs!.content).toContain("Spec gap identified here");
   335→    expect(specGapObs!.content).toContain("needs spec review");
   336→  });
   337→
   338→  // AC: @triage-cli-commands ac-8
   339→  it("should execute duplicate action deleting inbox item", () => {
   340→    const inboxUlid = addInboxItem("This is a duplicate");
   341→    const record = recordTriage(inboxUlid, "duplicate", "duplicate of existing item");
   342→
   343→    kspec(`triage act @${record._ulid.slice(0, 8)}`, tempDir);
   344→
   345→    // Verify inbox item was deleted
   346→    const inboxResult = kspecJson<Array<{ _ulid: string }>>(
   347→      "inbox list",
   348→      tempDir,
   349→    );
   350→    const found = inboxResult.find((item) => item._ulid === inboxUlid);
   351→    expect(found).toBeUndefined();
   352→
   353→    // Verify record is acted_on
   354→    const records = kspecJson<Array<{ _ulid: string; status: string }>>(
   355→      "triage list",
   356→      tempDir,
   357→    );
   358→    const acted = records.find((r) => r._ulid === record._ulid);
   359→    expect(acted!.status).toBe("acted_on");
   360→  });
   361→
   362→  // AC: @triage-cli-commands ac-15
   363→  // AC: @trait-error-guidance ac-1
   364→  it("should error when acting on already acted_on record", () => {
   365→    const inboxUlid = addInboxItem("Already acted on");
   366→    const record = recordTriage(inboxUlid, "defer", "defer it");
   367→
   368→    // Act once
   369→    kspec(`triage act @${record._ulid.slice(0, 8)}`, tempDir);
