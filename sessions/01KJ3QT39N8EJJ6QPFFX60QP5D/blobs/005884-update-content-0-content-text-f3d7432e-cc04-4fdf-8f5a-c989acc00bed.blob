   380→
   381→  // AC: @triage-cli-commands ac-16
   382→  // AC: @trait-error-guidance ac-1, ac-2
   383→  it("should error when acting on pending record with no decision", async () => {
   384→    // Create a pending triage record by writing directly to the triage YAML file
   385→    const pendingUlid = testUlid("PEND", 1);
   386→    const inboxUlid = testUlid("PEND", 2);
   387→    const triageData = {
   388→      kynetic_triage: "1.0",
   389→      triage: [{
   390→        _ulid: pendingUlid,
   391→        inbox_ref: inboxUlid,
   392→        item_snapshot: "A pending item",
   393→        status: "pending",
   394→        created_at: new Date().toISOString(),
   395→      }],
   396→    };
   397→    await fs.writeFile(
   398→      path.join(tempDir, "project.triage.yaml"),
   399→      yamlStringify(triageData),
   400→    );
   401→
   402→    const result = kspec(
   403→      `triage act @${pendingUlid.slice(0, 8)}`,
   404→      tempDir,
   405→      { expectFail: true },
   406→    );
   407→    expect(result.exitCode).toBe(4); // VALIDATION_FAILED
   408→    expect(result.stderr).toContain("no decision yet");
   409→    expect(result.stderr).toContain("kspec triage record");
   410→  });
