     1→/**
     2→ * Triage API Routes
     3→ *
     4→ * REST endpoints for triage operations:
     5→ * - GET /api/triage - list records with filters and pagination
     6→ * - GET /api/triage/export - export records for agent handoff
     7→ * - POST /api/triage - record a triage decision
     8→ * - GET /api/triage/:ref - get single record
     9→ * - POST /api/triage/:ref/override - override a decision
    10→ * - POST /api/triage/:ref/act - execute a triage action
    11→ *
    12→ * AC Coverage:
    13→ * - @triage-daemon-api ac-1: GET list sorted by created_at desc
    14→ * - @triage-daemon-api ac-2: Status filter on GET list
    15→ * - @triage-daemon-api ac-3: POST creates record with snapshot
    16→ * - @triage-daemon-api ac-4: PUT override sets override fields
    17→ * - @triage-daemon-api ac-5: PUT act executes and transitions
    18→ * - @triage-daemon-api ac-6: GET export with format parameter
    19→ * - @triage-daemon-api ac-7: POST 404 for nonexistent inbox item
    20→ * - @triage-daemon-api ac-8: PUT act 409 for already acted
    21→ * - @triage-daemon-api ac-9: PUT act 422 for pending record
    22→ */
    23→
    24→import { Elysia, t } from 'elysia';
    25→import { ulid } from 'ulidx';
    26→import {
    27→  initContext,
    28→  loadTriageRecords,
    29→  saveTriageRecord,
    30→  findTriageRecordByRef,
    31→  loadInboxItems,
    32→  findInboxItemByRef,
    33→  loadAllTasks,
    34→  loadAllItems,
    35→  ReferenceIndex,
    36→  getAuthor,
    37→  createObservation,
    38→  saveObservation,
    39→  createTask,
    40→  saveTask,
    41→  deleteInboxItem,
    42→  type LoadedTriageRecord,
    43→} from '../../parser/index.js';
    44→import { commitIfShadow } from '../../parser/shadow.js';
    45→import type { TriageAction } from '../../schema/index.js';
    46→import type { PubSubManager } from '../websocket/pubsub';
    47→
    48→interface TriageRouteOptions {
    49→  pubsub: PubSubManager;
    50→}
    51→
    52→const VALID_ACTIONS = ['promote', 'delete', 'defer', 'spec-gap', 'duplicate'];
    53→
    54→/**
    55→ * Truncate text for display
    56→ */
    57→function truncateText(text: string, maxLen: number = 60): string {
    58→  const firstLine = text.split('\n')[0].trim();
    59→  if (firstLine.length <= maxLen) return firstLine;
    60→  return `${firstLine.slice(0, maxLen - 3)}...`;
    61→}
    62→
    63→/**
    64→ * Format a triage record for context export
    65→ * AC: @triage-daemon-api ac-6
    66→ */
    67→function formatTriageContext(record: LoadedTriageRecord): string {
    68→  const lines: string[] = [];
    69→  lines.push(`### ${record._ulid.slice(0, 8)} — ${truncateText(record.item_snapshot, 80)}`);
    70→  lines.push('');
    71→  lines.push(`**Item:** ${record.item_snapshot}`);
    72→  lines.push(`**Status:** ${record.status}`);
    73→  if (record.action) lines.push(`**Action:** ${record.action}`);
    74→  if (record.reasoning) lines.push(`**Reasoning:** ${record.reasoning}`);
    75→  if (record.decided_by) lines.push(`**Decided by:** ${record.decided_by}`);
    76→  if (record.evidence_refs.length > 0) {
    77→    lines.push(`**Evidence:** ${record.evidence_refs.join(', ')}`);
    78→  }
    79→  if (record.override_reasoning) {
    80→    lines.push(`**Override:** ${record.override_reasoning} (by ${record.override_by || 'unknown'})`);
    81→  }
    82→  if (record.acted_at) {
    83→    lines.push(`**Acted at:** ${record.acted_at}`);
    84→    if (record.result_ref) lines.push(`**Result:** ${record.result_ref}`);
    85→  }
    86→  lines.push('');
    87→  return lines.join('\n');
    88→}
    89→
    90→/**
    91→ * Execute a triage action (reused from CLI logic)
    92→ * AC: @triage-daemon-api ac-5
    93→ */
    94→async function executeTriageAction(
    95→  record: LoadedTriageRecord,
    96→  ctx: Awaited<ReturnType<typeof initContext>>,
    97→): Promise<{ resultRef?: string }> {
    98→  const action = record.action;
    99→  if (!action) return {};
   100→
   101→  switch (action) {
   102→    case 'promote': {
   103→      const task = createTask({
   104→        title: record.item_snapshot.split('\n')[0].slice(0, 100),
   105→        type: 'task',
   106→        priority: 3,
   107→        spec_ref: null,
   108→        tags: [],
   109→        description: record.item_snapshot,
   110→      });
   111→      await saveTask(ctx, task);
   112→      const tasks = await loadAllTasks(ctx);
   113→      const items = await loadAllItems(ctx);
   114→      const index = new ReferenceIndex(tasks, items);
   115→      const taskRef = `@${index.shortUlid(task._ulid)}`;
   116→      return { resultRef: taskRef };
   117→    }
   118→
   119→    case 'delete': {
   120→      const inboxItems = await loadInboxItems(ctx);
   121→      const inboxItem = findInboxItemByRef(inboxItems, record.inbox_ref);
   122→      if (inboxItem) {
   123→        await deleteInboxItem(ctx, inboxItem._ulid);
   124→      }
   125→      return {};
   126→    }
   127→
   128→    case 'defer': {
   129→      return {};
   130→    }
   131→
   132→    case 'spec-gap': {
   133→      const content = `[spec-gap] ${record.item_snapshot}\n\nReasoning: ${record.reasoning || ''}`;
   134→      const observation = createObservation('question', content, {
   135→        configAuthor: ctx.config?.identity?.author,
   136→      });
   137→      await saveObservation(ctx, observation);
   138→      const obsRef = `@${observation._ulid.slice(0, 8)}`;
   139→      return { resultRef: obsRef };
   140→    }
   141→
   142→    case 'duplicate': {
   143→      const dupItems = await loadInboxItems(ctx);
   144→      const dupItem = findInboxItemByRef(dupItems, record.inbox_ref);
   145→      if (dupItem) {
   146→        await deleteInboxItem(ctx, dupItem._ulid);
   147→      }
   148→      return {};
   149→    }
   150→  }
   151→}
   152→
   153→export function createTriageRoutes(options: TriageRouteOptions) {
   154→  const { pubsub } = options;
   155→
   156→  return new Elysia({ prefix: '/api/triage' })
   157→    // AC: @triage-daemon-api ac-1, ac-2 - List triage records with filters and pagination
   158→    // AC: @trait-api-endpoint ac-1, ac-4 - JSON response with pagination wrapper
   159→    .get(
   160→      '/',
   161→      async ({ query, projectContext }) => {
   162→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   163→        const ctx = await initContext(projectContext.path);
   164→        const records = await loadTriageRecords(ctx);
   165→
   166→        // Apply filters
   167→        let filtered = records;
   168→
   169→        // AC: @triage-daemon-api ac-2 - Status filter
   170→        if (query.status) {
   171→          const statusFilters = Array.isArray(query.status) ? query.status : [query.status];
   172→          filtered = filtered.filter((r) => statusFilters.includes(r.status));
   173→        }
   174→
   175→        // Action filter
   176→        if (query.action) {
   177→          const actionFilters = Array.isArray(query.action) ? query.action : [query.action];
   178→          filtered = filtered.filter((r) => r.action && actionFilters.includes(r.action));
   179→        }
   180→
   181→        // AC: @triage-daemon-api ac-1 - Sort by created_at descending (newest first)
   182→        filtered.sort(
   183→          (a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime()
   184→        );
   185→
   186→        // AC: @trait-api-endpoint ac-4 - Pagination with limit and offset
   187→        const total = filtered.length;
   188→        const offset = Number(query.offset) || 0;
   189→        const limit = Number(query.limit) || total;
   190→
   191→        const paginated = filtered.slice(offset, offset + limit);
   192→
   193→        return {
   194→          items: paginated,
   195→          total,
   196→          offset,
   197→          limit,
   198→        };
   199→      },
   200→      {
   201→        query: t.Object({
   202→          status: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   203→          action: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   204→          limit: t.Optional(t.String()),
   205→          offset: t.Optional(t.String()),
   206→        }),
   207→      }
   208→    )
   209→
   210→    // AC: @triage-daemon-api ac-6 - Export triage records
   211→    // NOTE: This route MUST be defined before /:ref to avoid "export" being parsed as a ref
   212→    .get(
   213→      '/export',
   214→      async ({ query, projectContext }) => {
   215→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   216→        const ctx = await initContext(projectContext.path);
   217→        let records = await loadTriageRecords(ctx);
   218→
   219→        // Optional status filter on export
   220→        if (query.status) {
   221→          const statusFilters = Array.isArray(query.status) ? query.status : [query.status];
   222→          records = records.filter((r) => statusFilters.includes(r.status));
   223→        }
   224→
   225→        const format = query.format || 'json';
   226→
   227→        if (format === 'context') {
   228→          // AC: @triage-daemon-api ac-6 - Context markdown format
   229→          if (records.length === 0) {
   230→            return { format: 'context', content: 'No triage decisions recorded.' };
   231→          }
   232→          let content = '# Triage Decisions\n\n';
   233→          for (const record of records) {
   234→            content += formatTriageContext(record);
   235→          }
   236→          return { format: 'context', content };
   237→        }
   238→
   239→        // AC: @triage-daemon-api ac-6 - JSON format (default)
   240→        return {
   241→          format: 'json',
   242→          items: records,
   243→          total: records.length,
   244→        };
   245→      },
   246→      {
   247→        query: t.Object({
   248→          format: t.Optional(t.String()),
   249→          status: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   250→        }),
   251→      }
   252→    )
   253→
   254→    // AC: @triage-daemon-api ac-3 - Record a triage decision
   255→    // AC: @trait-api-endpoint ac-1, ac-3, ac-5 - JSON response, validation, shadow commit
   256→    .post(
   257→      '/',
   258→      async ({ body, error: errorResponse, projectContext }) => {
   259→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   260→        const ctx = await initContext(projectContext.path);
   261→
   262→        // AC: @trait-api-endpoint ac-3 - Validate action
   263→        if (!VALID_ACTIONS.includes(body.action)) {
   264→          return errorResponse(400, {
   265→            error: 'validation_error',
   266→            details: [
   267→              {
   268→                field: 'action',
   269→                message: `Action must be one of: ${VALID_ACTIONS.join(', ')}`,
   270→              },
   271→            ],
   272→          });
   273→        }
   274→
   275→        // AC: @triage-daemon-api ac-7 - Validate inbox item exists
   276→        const inboxItems = await loadInboxItems(ctx);
   277→        const inboxItem = findInboxItemByRef(inboxItems, body.inbox_ref);
   278→        if (!inboxItem) {
   279→          // AC: @trait-api-endpoint ac-2 - 404 with error guidance
   280→          return errorResponse(404, {
   281→            error: 'not_found',
   282→            message: `Inbox item reference "${body.inbox_ref}" not found`,
   283→            suggestion: 'Use kspec inbox list or GET /api/inbox to find valid inbox item references',
   284→          });
   285→        }
   286→
   287→        const author = body.decided_by || getAuthor(ctx.config?.identity?.author);
   288→        const evidenceRefs = body.evidence_refs
   289→          ? body.evidence_refs.map((r: string) => r.startsWith('@') ? r : `@${r}`)
   290→          : [];
   291→
   292→        // AC: @triage-daemon-api ac-3 - Create record with item_snapshot
   293→        const record: LoadedTriageRecord = {
   294→          _ulid: ulid(),
   295→          inbox_ref: inboxItem._ulid,
   296→          item_snapshot: inboxItem.text,
   297→          status: 'triaged',
   298→          action: body.action as TriageAction,
   299→          reasoning: body.reasoning,
   300→          decided_by: author,
   301→          evidence_refs: evidenceRefs,
   302→          created_at: new Date().toISOString(),
   303→        };
   304→
   305→        await saveTriageRecord(ctx, record);
   306→
   307→        // AC: @trait-api-endpoint ac-5 - Shadow commit
   308→        await commitIfShadow(ctx.shadow, `triage: record ${record._ulid.slice(0, 8)} as ${record.action}`);
   309→
   310→        // AC: @triage-daemon-api ac-3 - Broadcast triage:updates via WebSocket
   311→        // AC: @trait-websocket-protocol ac-3 - Broadcast event
   312→        pubsub.broadcast('triage:updates', 'triage_record_created', {
   313→          ulid: record._ulid,
   314→          inbox_ref: record.inbox_ref,
   315→          action: record.action,
   316→        }, projectContext.path);
   317→
   318→        // AC: @trait-api-endpoint ac-1 - Return 2xx with JSON body
   319→        return {
   320→          success: true,
   321→          record,
   322→        };
   323→      },
   324→      {
   325→        body: t.Object({
   326→          inbox_ref: t.String(),
   327→          action: t.String(),
   328→          reasoning: t.String(),
   329→          decided_by: t.Optional(t.String()),
   330→          evidence_refs: t.Optional(t.Array(t.String())),
   331→        }),
   332→      }
   333→    )
   334→
   335→    // GET single triage record
   336→    .get(
   337→      '/:ref',
   338→      async ({ params, error: errorResponse, projectContext }) => {
   339→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   340→        const ctx = await initContext(projectContext.path);
   341→        const records = await loadTriageRecords(ctx);
   342→
   343→        // AC: @trait-api-endpoint ac-2 - Resolve ref
   344→        const record = findTriageRecordByRef(records, params.ref);
   345→        if (!record) {
   346→          return errorResponse(404, {
   347→            error: 'not_found',
   348→            message: `Triage record reference "${params.ref}" not found`,
   349→            suggestion: 'Use kspec triage list or GET /api/triage to find valid triage record references',
   350→          });
   351→        }
   352→
   353→        return record;
   354→      },
   355→      {
   356→        params: t.Object({
   357→          ref: t.String(),
   358→        }),
   359→      }
   360→    )
   361→
   362→    // AC: @triage-daemon-api ac-4 - Override a triage decision
   363→    // AC: @trait-api-endpoint ac-1, ac-5 - JSON response, shadow commit
   364→    .post(
   365→      '/:ref/override',
   366→      async ({ params, body, error: errorResponse, projectContext }) => {
   367→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   368→        const ctx = await initContext(projectContext.path);
   369→        const records = await loadTriageRecords(ctx);
   370→
   371→        // AC: @trait-api-endpoint ac-2 - Resolve ref
   372→        const record = findTriageRecordByRef(records, params.ref);
   373→        if (!record) {
   374→          return errorResponse(404, {
   375→            error: 'not_found',
   376→            message: `Triage record reference "${params.ref}" not found`,
   377→            suggestion: 'Use kspec triage list or GET /api/triage to find valid triage record references',
   378→          });
   379→        }
   380→
   381→        // AC: @trait-api-endpoint ac-3 - Validate action
   382→        if (!VALID_ACTIONS.includes(body.action)) {
   383→          return errorResponse(400, {
   384→            error: 'validation_error',
   385→            details: [
   386→              {
   387→                field: 'action',
   388→                message: `Action must be one of: ${VALID_ACTIONS.join(', ')}`,
   389→              },
   390→            ],
   391→          });
   392→        }
   393→
   394→        const overrideBy = body.override_by || getAuthor(ctx.config?.identity?.author);
   395→
   396→        // AC: @triage-daemon-api ac-4 - Set override fields and update action
   397→        record.override_reasoning = body.reasoning;
   398→        record.override_by = overrideBy;
   399→        record.override_at = new Date().toISOString();
   400→        record.action = body.action as TriageAction;
   401→        record.updated_at = new Date().toISOString();
   402→
   403→        // Re-triage if already acted on (allows re-acting with new action)
   404→        if (record.status === 'acted_on') {
   405→          record.status = 'triaged';
   406→        }
   407→
   408→        await saveTriageRecord(ctx, record);
   409→
   410→        // AC: @trait-api-endpoint ac-5 - Shadow commit
   411→        await commitIfShadow(ctx.shadow, `triage: override ${record._ulid.slice(0, 8)}`);
   412→
   413→        // AC: @triage-daemon-api ac-4 - Broadcast triage:updates
   414→        pubsub.broadcast('triage:updates', 'triage_record_updated', {
   415→          ulid: record._ulid,
   416→          action: 'override',
   417→          new_action: record.action,
   418→        }, projectContext.path);
   419→
   420→        return {
   421→          success: true,
   422→          record,
   423→        };
   424→      },
   425→      {
   426→        params: t.Object({
   427→          ref: t.String(),
   428→        }),
   429→        body: t.Object({
   430→          action: t.String(),
   431→          reasoning: t.String(),
   432→          override_by: t.Optional(t.String()),
   433→        }),
   434→      }
   435→    )
   436→
   437→    // AC: @triage-daemon-api ac-5, ac-8, ac-9 - Execute a triage action
   438→    // AC: @trait-api-endpoint ac-1, ac-5 - JSON response, shadow commit
   439→    .post(
   440→      '/:ref/act',
   441→      async ({ params, error: errorResponse, projectContext }) => {
   442→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   443→        const ctx = await initContext(projectContext.path);
   444→        const records = await loadTriageRecords(ctx);
   445→
   446→        // AC: @trait-api-endpoint ac-2 - Resolve ref
   447→        const record = findTriageRecordByRef(records, params.ref);
   448→        if (!record) {
   449→          return errorResponse(404, {
   450→            error: 'not_found',
   451→            message: `Triage record reference "${params.ref}" not found`,
   452→            suggestion: 'Use kspec triage list or GET /api/triage to find valid triage record references',
   453→          });
   454→        }
   455→
   456→        // AC: @triage-daemon-api ac-8 - Already acted on → 409
   457→        if (record.status === 'acted_on') {
   458→          return errorResponse(409, {
   459→            error: 'invalid_transition',
   460→            message: 'Triage record has already been acted on',
   461→            current: record.status,
   462→            suggestion: 'Use override to change the decision before acting again',
   463→          });
   464→        }
   465→
   466→        // AC: @triage-daemon-api ac-9 - Pending (no decision) → 422
   467→        if (record.status === 'pending') {
   468→          return errorResponse(422, {
   469→            error: 'incomplete_record',
   470→            message: 'No decision has been recorded for this triage record. Complete triage first.',
   471→            suggestion: 'Use POST /api/triage to record a decision, or kspec triage record <inbox-ref> --action <action> --reasoning <text>',
   472→          });
   473→        }
   474→
   475→        // AC: @triage-daemon-api ac-5 - Execute the action
   476→        const result = await executeTriageAction(record, ctx);
   477→
   478→        // Transition to acted_on
   479→        record.status = 'acted_on';
   480→        record.acted_at = new Date().toISOString();
   481→        if (result.resultRef) {
   482→          record.result_ref = result.resultRef;
   483→        }
   484→        record.updated_at = new Date().toISOString();
   485→
   486→        await saveTriageRecord(ctx, record);
   487→
   488→        // AC: @trait-api-endpoint ac-5 - Shadow commit
   489→        await commitIfShadow(ctx.shadow, `triage: act ${record._ulid.slice(0, 8)}`);
   490→
   491→        // AC: @triage-daemon-api ac-5 - Broadcast triage:updates
   492→        pubsub.broadcast('triage:updates', 'triage_record_acted', {
   493→          ulid: record._ulid,
   494→          action: record.action,
   495→          result_ref: record.result_ref,
   496→        }, projectContext.path);
   497→
   498→        return {
   499→          success: true,
   500→          record,
   501→        };
   502→      },
   503→      {
   504→        params: t.Object({
   505→          ref: t.String(),
   506→        }),
   507→      }
   508→    );
   509→}
   510→