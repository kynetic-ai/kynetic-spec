     1→import * as readline from "node:readline";
     2→import { ulid } from "ulid";
     3→import type { Command } from "commander";
     4→import { markMutating } from "../command-annotations.js";
     5→import {
     6→  createObservation,
     7→  createTask,
     8→  deleteInboxItem,
     9→  findInboxItemByRef,
    10→  getAuthor,
    11→  initContext,
    12→  type LoadedInboxItem,
    13→  type LoadedTriageRecord,
    14→  loadAllItems,
    15→  loadAllTasks,
    16→  loadInboxItems,
    17→  loadTriageRecords,
    18→  ReferenceIndex,
    19→  saveObservation,
    20→  saveTask,
    21→  saveTriageRecord,
    22→  findTriageRecordByRef,
    23→} from "../../parser/index.js";
    24→import { commitIfShadow } from "../../parser/shadow.js";
    25→import type { TriageAction, TriageRecord } from "../../schema/index.js";
    26→import { errors } from "../../strings/index.js";
    27→import { formatRelativeTime as formatRelativeTimeUtil } from "../../utils/time.js";
    28→import { EXIT_CODES } from "../exit-codes.js";
    29→import { error, info, output, success } from "../output.js";
    30→
    31→/**
    32→ * Format relative time for display
    33→ */
    34→function formatRelativeTime(dateStr: string): string {
    35→  return formatRelativeTimeUtil(new Date(dateStr));
    36→}
    37→
    38→/**
    39→ * Resolve triage record ref with error handling
    40→ */
    41→function resolveTriageRef(
    42→  ref: string,
    43→  records: LoadedTriageRecord[],
    44→): LoadedTriageRecord {
    45→  const record = findTriageRecordByRef(records, ref);
    46→  if (!record) {
    47→    error(`Triage record not found: ${ref}`);
    48→    process.exit(EXIT_CODES.NOT_FOUND);
    49→  }
    50→  return record;
    51→}
    52→
    53→/**
    54→ * Truncate text for display
    55→ */
    56→function truncateText(text: string, maxLen: number = 60): string {
    57→  const firstLine = text.split("\n")[0].trim();
    58→  if (firstLine.length <= maxLen) return firstLine;
    59→  return `${firstLine.slice(0, maxLen - 3)}...`;
    60→}
    61→
    62→/**
    63→ * Execute a triage action
    64→ * AC: @triage-cli-commands ac-4, ac-5, ac-6, ac-7, ac-8
    65→ */
    66→async function executeTriageAction(
    67→  record: LoadedTriageRecord,
    68→  ctx: Awaited<ReturnType<typeof initContext>>,
    69→  dryRun: boolean = false,
    70→): Promise<{ resultRef?: string }> {
    71→  const action = record.action;
    72→  if (!action) {
    73→    error("Record has no action to execute");
    74→    process.exit(EXIT_CODES.VALIDATION_FAILED);
    75→  }
    76→
    77→  switch (action) {
    78→    case "promote": {
    79→      // AC: @triage-cli-commands ac-4
    80→      if (dryRun) {
    81→        info(`Would create task from inbox item snapshot: "${truncateText(record.item_snapshot)}"`);
    82→        return {};
    83→      }
    84→      const task = createTask({
    85→        title: record.item_snapshot.split("\n")[0].slice(0, 100),
    86→        type: "task",
    87→        priority: 3,
    88→        spec_ref: null,
    89→        tags: [],
    90→        description: record.item_snapshot,
    91→      });
    92→      await saveTask(ctx, task);
    93→      const tasks = await loadAllTasks(ctx);
    94→      const items = await loadAllItems(ctx);
    95→      const index = new ReferenceIndex(tasks, items);
    96→      const taskRef = `@${index.shortUlid(task._ulid)}`;
    97→      info(`Created task: ${taskRef} - ${task.title}`);
    98→      return { resultRef: taskRef };
    99→    }
   100→
   101→    case "delete": {
   102→      // AC: @triage-cli-commands ac-5
   103→      if (dryRun) {
   104→        info(`Would delete inbox item: ${record.inbox_ref.slice(0, 8)}`);
   105→        return {};
   106→      }
   107→      const inboxItems = await loadInboxItems(ctx);
   108→      const inboxItem = findInboxItemByRef(inboxItems, record.inbox_ref);
   109→      if (inboxItem) {
   110→        await deleteInboxItem(ctx, inboxItem._ulid);
   111→        info(`Deleted inbox item: ${record.inbox_ref.slice(0, 8)}`);
   112→      }
   113→      return {};
   114→    }
   115→
   116→    case "defer": {
   117→      // AC: @triage-cli-commands ac-6
   118→      if (dryRun) {
   119→        info(`Would defer: no side effects beyond recording the deferral`);
   120→        return {};
   121→      }
   122→      return {};
   123→    }
   124→
   125→    case "spec-gap": {
   126→      // AC: @triage-cli-commands ac-7
   127→      if (dryRun) {
   128→        info(`Would create spec-gap observation from: "${truncateText(record.item_snapshot)}"`);
   129→        return {};
   130→      }
   131→      const content = `[spec-gap] ${record.item_snapshot}\n\nReasoning: ${record.reasoning || ""}`;
   132→      const observation = createObservation("question", content, {
   133→        configAuthor: ctx.config?.identity?.author,
   134→      });
   135→      await saveObservation(ctx, observation);
   136→      const obsRef = `@${observation._ulid.slice(0, 8)}`;
   137→      info(`Created spec-gap observation: ${obsRef}`);
   138→      return { resultRef: obsRef };
   139→    }
   140→
   141→    case "duplicate": {
   142→      // AC: @triage-cli-commands ac-8
   143→      if (dryRun) {
   144→        info(`Would delete duplicate inbox item: ${record.inbox_ref.slice(0, 8)}`);
   145→        return {};
   146→      }
   147→      const dupItems = await loadInboxItems(ctx);
   148→      const dupItem = findInboxItemByRef(dupItems, record.inbox_ref);
   149→      if (dupItem) {
   150→        await deleteInboxItem(ctx, dupItem._ulid);
   151→        info(`Deleted duplicate inbox item: ${record.inbox_ref.slice(0, 8)}`);
   152→      }
   153→      return {};
   154→    }
   155→  }
   156→}
   157→
   158→/**
   159→ * Format a triage record for context export
   160→ * AC: @triage-cli-commands ac-13
   161→ */
   162→function formatTriageContext(record: TriageRecord): string {
   163→  const lines: string[] = [];
   164→  lines.push(`### ${record._ulid.slice(0, 8)} — ${truncateText(record.item_snapshot, 80)}`);
   165→  lines.push("");
   166→  lines.push(`**Item:** ${record.item_snapshot}`);
   167→  lines.push(`**Status:** ${record.status}`);
   168→  if (record.action) lines.push(`**Action:** ${record.action}`);
   169→  if (record.reasoning) lines.push(`**Reasoning:** ${record.reasoning}`);
   170→  if (record.decided_by) lines.push(`**Decided by:** ${record.decided_by}`);
   171→  if (record.evidence_refs.length > 0) {
   172→    lines.push(`**Evidence:** ${record.evidence_refs.join(", ")}`);
   173→  }
   174→  if (record.override_reasoning) {
   175→    lines.push(`**Override:** ${record.override_reasoning} (by ${record.override_by || "unknown"})`);
   176→  }
   177→  if (record.acted_at) {
   178→    lines.push(`**Acted at:** ${record.acted_at}`);
   179→    if (record.result_ref) lines.push(`**Result:** ${record.result_ref}`);
   180→  }
   181→  lines.push("");
   182→  return lines.join("\n");
   183→}
   184→
   185→/**
   186→ * Register the 'triage' command group
   187→ * AC: @triage-cli-commands ac-1 through ac-17
   188→ */
   189→export function registerTriageCommands(program: Command): void {
   190→  const triage = program
   191→    .command("triage")
   192→    .description("Record, review, and act on triage decisions");
   193→
   194→  // kspec triage record <inbox-ref>
   195→  // AC: @triage-cli-commands ac-1, ac-11
   196→  markMutating(triage.command("record <inbox-ref>"))
   197→    .description("Record a triage decision for an inbox item")
   198→    .requiredOption("--action <action>", "Triage action (promote, delete, defer, spec-gap, duplicate)")
   199→    .requiredOption("--reasoning <text>", "Reasoning for the decision")
   200→    .option("--decided-by <author>", "Who made the decision")
   201→    .option("--evidence <refs...>", "Evidence references")
   202→    .option("--dry-run", "Show what would happen without making changes")
   203→    .addHelpText(
   204→      "after",
   205→      `
   206→Examples:
   207→  $ kspec triage record @ref --action promote --reasoning "clear feature request"
   208→  $ kspec triage record @ref --action defer --reasoning "needs more discussion"`,
   209→    )
   210→    .action(async (inboxRef: string, options) => {
   211→      try {
   212→        const ctx = await initContext();
   213→
   214→        // Validate action
   215→        const validActions = ["promote", "delete", "defer", "spec-gap", "duplicate"];
   216→        if (!validActions.includes(options.action)) {
   217→          error(`Invalid action: ${options.action}. Must be one of: ${validActions.join(", ")}`);
   218→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   219→        }
   220→
   221→        // Resolve inbox item
   222→        const inboxItems = await loadInboxItems(ctx);
   223→        const item = findInboxItemByRef(inboxItems, inboxRef);
   224→        if (!item) {
   225→          error(errors.reference.inboxNotFound(inboxRef));
   226→          process.exit(EXIT_CODES.NOT_FOUND);
   227→        }
   228→
   229→        if (options.dryRun) {
   230→          info(`Would create triage record for inbox item ${item._ulid.slice(0, 8)} with action: ${options.action}`);
   231→          return;
   232→        }
   233→
   234→        const author = options.decidedBy || getAuthor(ctx.config?.identity?.author);
   235→        const evidenceRefs = options.evidence
   236→          ? options.evidence.map((r: string) => r.startsWith("@") ? r : `@${r}`)
   237→          : [];
   238→
   239→        const record: LoadedTriageRecord = {
   240→          _ulid: ulid(),
   241→          inbox_ref: item._ulid,
   242→          item_snapshot: item.text,
   243→          status: "triaged",
   244→          action: options.action as TriageAction,
   245→          reasoning: options.reasoning,
   246→          decided_by: author,
   247→          evidence_refs: evidenceRefs,
   248→          created_at: new Date().toISOString(),
   249→        };
   250→
   251→        await saveTriageRecord(ctx, record);
   252→        await commitIfShadow(
   253→          ctx.shadow,
   254→          "triage-record",
   255→          record._ulid.slice(0, 8),
   256→          options.action,
   257→        );
   258→
   259→        // AC: @triage-cli-commands ac-11 — JSON output
   260→        // AC: @trait-json-output ac-1, ac-2, ac-4, ac-5
   261→        success(`Recorded triage decision: ${record._ulid.slice(0, 8)}`, { record });
   262→      } catch (err) {
   263→        error("Failed to record triage decision", err);
   264→        process.exit(EXIT_CODES.ERROR);
   265→      }
   266→    });
   267→
   268→  // kspec triage list
   269→  // AC: @triage-cli-commands ac-2, ac-3
   270→  triage
   271→    .command("list")
   272→    .description("List triage records")
   273→    .option("--status <status>", "Filter by status (pending, triaged, acted_on)")
   274→    .option("--action <action>", "Filter by action")
   275→    .option("--decided-by <author>", "Filter by decision author")
   276→    .option("--limit <n>", "Limit results")
   277→    .option("--offset <n>", "Skip first N results")
   278→    .option("--count", "Show only the count")
   279→    .action(async (options) => {
   280→      try {
   281→        const ctx = await initContext();
   282→        let records = await loadTriageRecords(ctx);
   283→        const totalCount = records.length;
   284→        const activeFilters: string[] = [];
   285→
   286→        // AC: @triage-cli-commands ac-3 — status filter
   287→        // AC: @trait-filterable-list ac-1
   288→        if (options.status) {
   289→          records = records.filter((r) => r.status === options.status);
   290→          activeFilters.push(`status=${options.status}`);
   291→        }
   292→
   293→        // AC: @trait-filterable-list ac-5
   294→        if (options.action) {
   295→          records = records.filter((r) => r.action === options.action);
   296→          activeFilters.push(`action=${options.action}`);
   297→        }
   298→
   299→        if (options.decidedBy) {
   300→          records = records.filter((r) => r.decided_by === options.decidedBy);
   301→          activeFilters.push(`decided_by=${options.decidedBy}`);
   302→        }
   303→
   304→        // Sort by created_at desc (newest first)
   305→        records.sort((a, b) => {
   306→          return new Date(b.created_at).getTime() - new Date(a.created_at).getTime();
   307→        });
   308→
   309→        // AC: @trait-filterable-list ac-8
   310→        if (options.count) {
   311→          output({ count: records.length }, () => {
   312→            console.log(records.length);
   313→          });
   314→          return;
   315→        }
   316→
   317→        // AC: @trait-filterable-list ac-4 — offset
   318→        if (options.offset) {
   319→          const offset = parseInt(options.offset, 10);
   320→          records = records.slice(offset);
   321→        }
   322→
   323→        // AC: @trait-filterable-list ac-3 — limit
   324→        if (options.limit) {
   325→          const limit = parseInt(options.limit, 10);
   326→          records = records.slice(0, limit);
   327→        }
   328→
   329→        // AC: @trait-json-output ac-1, ac-2
   330→        output(records, () => {
   331→          if (records.length === 0) {
   332→            // AC: @trait-filterable-list ac-6
   333→            console.log("No triage records");
   334→            return;
   335→          }
   336→
   337→          // AC: @trait-filterable-list ac-7 — summary with total and filter state
   338→          const filterInfo = activeFilters.length > 0
   339→            ? ` (${activeFilters.join(", ")})`
   340→            : "";
   341→          const showing = records.length < totalCount
   342→            ? `${records.length} of ${totalCount}`
   343→            : `${records.length}`;
   344→          console.log(
   345→            `Triage records (${showing}${filterInfo}):\n`,
   346→          );
   347→
   348→          // AC: @triage-cli-commands ac-2
   349→          for (const record of records) {
   350→            const snapshot = truncateText(record.item_snapshot, 50);
   351→            const age = formatRelativeTime(record.created_at);
   352→            const action = record.action ? ` [${record.action}]` : "";
   353→            const decidedBy = record.decided_by ? ` by ${record.decided_by}` : "";
   354→            console.log(`  ${record._ulid.slice(0, 8)} (${age}${decidedBy}) ${record.status}${action}`);
   355→            console.log(`    ${snapshot}`);
   356→            console.log("");
   357→          }
   358→        });
   359→      } catch (err) {
   360→        error("Failed to list triage records", err);
   361→        process.exit(EXIT_CODES.ERROR);
   362→      }
   363→    });
   364→
   365→  // kspec triage act <triage-ref>
   366→  // AC: @triage-cli-commands ac-4, ac-5, ac-6, ac-7, ac-8, ac-15, ac-16, ac-17
   367→  markMutating(triage.command("act <triage-ref>"))
   368→    .description("Execute a triage decision")
   369→    .option("--dry-run", "Show what would happen without executing")
   370→    .action(async (triageRef: string, options) => {
   371→      try {
   372→        const ctx = await initContext();
   373→        const records = await loadTriageRecords(ctx);
   374→        const record = resolveTriageRef(triageRef, records);
   375→
   376→        // AC: @triage-cli-commands ac-15 — already acted on
   377→        // AC: @trait-error-guidance ac-1, ac-2
   378→        if (record.status === "acted_on") {
   379→          error(`Triage record ${record._ulid.slice(0, 8)} has already been acted on. No further action is possible.`);
   380→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   381→        }
   382→
   383→        // AC: @triage-cli-commands ac-16 — no decision yet
   384→        // AC: @trait-error-guidance ac-1, ac-2
   385→        if (record.status === "pending") {
   386→          error(`Triage record ${record._ulid.slice(0, 8)} has no decision yet. Record a decision first with: kspec triage record <inbox-ref> --action <action> --reasoning <text>`);
   387→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   388→        }
   389→
   390→        // AC: @triage-cli-commands ac-17 — dry run
   391→        if (options.dryRun) {
   392→          info(`Dry run for triage record ${record._ulid.slice(0, 8)}:`);
   393→          await executeTriageAction(record, ctx, true);
   394→          return;
   395→        }
   396→
   397→        // Execute the action
   398→        const result = await executeTriageAction(record, ctx, false);
   399→
   400→        // Transition to acted_on
   401→        record.status = "acted_on";
   402→        record.acted_at = new Date().toISOString();
   403→        if (result.resultRef) {
   404→          record.result_ref = result.resultRef;
   405→        }
   406→        record.updated_at = new Date().toISOString();
   407→
   408→        await saveTriageRecord(ctx, record);
   409→        await commitIfShadow(
   410→          ctx.shadow,
   411→          "triage-act",
   412→          record._ulid.slice(0, 8),
   413→          record.action,
   414→        );
   415→
   416→        success(`Acted on triage record: ${record._ulid.slice(0, 8)} (${record.action})`, { record });
   417→      } catch (err) {
   418→        error("Failed to act on triage record", err);
   419→        process.exit(EXIT_CODES.ERROR);
   420→      }
   421→    });
   422→
   423→  // kspec triage override <triage-ref>
   424→  // AC: @triage-cli-commands ac-12
   425→  markMutating(triage.command("override <triage-ref>"))
   426→    .description("Override an existing triage decision")
   427→    .requiredOption("--action <action>", "New action (promote, delete, defer, spec-gap, duplicate)")
   428→    .requiredOption("--reasoning <text>", "Reasoning for the override")
   429→    .option("--override-by <author>", "Who is overriding")
   430→    .action(async (triageRef: string, options) => {
   431→      try {
   432→        const ctx = await initContext();
   433→        const records = await loadTriageRecords(ctx);
   434→        const record = resolveTriageRef(triageRef, records);
   435→
   436→        // Validate action
   437→        const validActions = ["promote", "delete", "defer", "spec-gap", "duplicate"];
   438→        if (!validActions.includes(options.action)) {
   439→          error(`Invalid action: ${options.action}. Must be one of: ${validActions.join(", ")}`);
   440→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   441→        }
   442→
   443→        const overrideBy = options.overrideBy || getAuthor(ctx.config?.identity?.author);
   444→
   445→        // AC: @triage-cli-commands ac-12
   446→        record.override_reasoning = options.reasoning;
   447→        record.override_by = overrideBy;
   448→        record.override_at = new Date().toISOString();
   449→        record.action = options.action as TriageAction;
   450→
   451→        // Ensure status is triaged (for re-acting after override)
   452→        if (record.status === "acted_on") {
   453→          record.status = "triaged";
   454→        }
   455→
   456→        await saveTriageRecord(ctx, record);
   457→        await commitIfShadow(
   458→          ctx.shadow,
   459→          "triage-override",
   460→          record._ulid.slice(0, 8),
   461→          options.action,
   462→        );
   463→
   464→        success(`Overrode triage decision: ${record._ulid.slice(0, 8)} → ${options.action}`, { record });
   465→      } catch (err) {
   466→        error("Failed to override triage decision", err);
   467→        process.exit(EXIT_CODES.ERROR);
   468→      }
   469→    });
   470→
   471→  // kspec triage export
   472→  // AC: @triage-cli-commands ac-13, ac-14
   473→  triage
   474→    .command("export")
   475→    .description("Export triage decisions for agent handoff")
   476→    .requiredOption("--format <format>", "Export format (context, json)")
   477→    .option("--status <status>", "Filter by status")
   478→    .action(async (options) => {
   479→      try {
   480→        const ctx = await initContext();
   481→        let records = await loadTriageRecords(ctx);
   482→
   483→        if (options.status) {
   484→          records = records.filter((r) => r.status === options.status);
   485→        }
   486→
   487→        if (options.format === "json") {
   488→          // AC: @triage-cli-commands ac-14
   489→          // AC: @trait-json-output ac-1, ac-2, ac-5
   490→          console.log(JSON.stringify(records, null, 2));
   491→        } else if (options.format === "context") {
   492→          // AC: @triage-cli-commands ac-13
   493→          if (records.length === 0) {
   494→            console.log("No triage decisions recorded.");
   495→            return;
   496→          }
   497→          console.log("# Triage Decisions\n");
   498→          for (const record of records) {
   499→            console.log(formatTriageContext(record));
   500→          }
   501→        } else {
   502→          error(`Invalid format: ${options.format}. Must be one of: context, json`);
   503→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   504→        }
   505→      } catch (err) {
   506→        error("Failed to export triage records", err);
   507→        process.exit(EXIT_CODES.ERROR);
   508→      }
   509→    });
   510→
   511→  // kspec triage start
   512→  // AC: @triage-cli-commands ac-9, ac-10
   513→  markMutating(triage.command("start"))
   514→    .description("Start interactive triage of inbox items")
   515→    .action(async () => {
   516→      try {
   517→        const ctx = await initContext();
   518→        const inboxItems = await loadInboxItems(ctx);
   519→        const existingRecords = await loadTriageRecords(ctx);
   520→
   521→        // Find untriaged items (no existing triage record)
   522→        const triagedInboxRefs = new Set(existingRecords.map((r) => r.inbox_ref));
   523→        const untriaged = inboxItems.filter((item) => !triagedInboxRefs.has(item._ulid));
   524→
   525→        if (untriaged.length === 0) {
   526→          info("No untriaged inbox items");
   527→          return;
   528→        }
   529→
   530→        console.log(`\nInteractive triage: ${untriaged.length} item(s) to review\n`);
   531→        console.log("Actions: promote, delete, defer, spec-gap, duplicate, skip\n");
   532→
   533→        const validActions = ["promote", "delete", "defer", "spec-gap", "duplicate", "skip"];
   534→        let triaged = 0;
   535→
   536→        // Use a line-buffering approach for interactive prompts.
   537→        // readline.question() has issues with piped stdin because the close
   538→        // event can fire before subsequent question() calls process buffered lines.
   539→        // Instead, we collect lines via the 'line' event and read from the buffer.
   540→        const lineBuffer: string[] = [];
   541→        let lineResolve: ((value: string | null) => void) | null = null;
   542→        let inputClosed = false;
   543→
   544→        const rl = readline.createInterface({
   545→          input: process.stdin,
   546→          output: process.stdout,
   547→          terminal: false,
   548→        });
   549→
   550→        rl.on("line", (line) => {
   551→          if (lineResolve) {
   552→            const resolve = lineResolve;
   553→            lineResolve = null;
   554→            resolve(line.trim());
   555→          } else {
   556→            lineBuffer.push(line.trim());
   557→          }
   558→        });
   559→
   560→        rl.on("close", () => {
   561→          inputClosed = true;
   562→          if (lineResolve) {
   563→            const resolve = lineResolve;
   564→            lineResolve = null;
   565→            resolve(null);
   566→          }
   567→        });
   568→
   569→        const askQuestion = (question: string): Promise<string | null> => {
   570→          process.stdout.write(question);
   571→          if (lineBuffer.length > 0) {
   572→            return Promise.resolve(lineBuffer.shift()!);
   573→          }
   574→          if (inputClosed) return Promise.resolve(null);
   575→          return new Promise((resolve) => {
   576→            lineResolve = resolve;
   577→          });
   578→        };
   579→
   580→        // AC: @triage-cli-commands ac-9 — present items one at a time
   581→        for (const item of untriaged) {
   582→          console.log("─".repeat(60));
   583→          console.log(`Item: ${item._ulid.slice(0, 8)} (${formatRelativeTime(item.created_at)})`);
   584→          if (item.tags.length > 0) {
   585→            console.log(`Tags: ${item.tags.join(", ")}`);
   586→          }
   587→          if (item.added_by) {
   588→            console.log(`Added by: ${item.added_by}`);
   589→          }
   590→          console.log("");
   591→          console.log(item.text);
   592→          console.log("");
   593→
   594→          // AC: @triage-cli-commands ac-10 — Ctrl+C preserves committed records
   595→          const action = await askQuestion("Action (promote/delete/defer/spec-gap/duplicate/skip): ");
   596→
   597→          if (action === null) {
   598→            // Ctrl+C or closed input
   599→            console.log(`\nTriage interrupted. ${triaged} record(s) saved.`);
   600→            rl.close();
   601→            return;
   602→          }
   603→
   604→          if (!action || action === "skip") {
   605→            console.log("Skipped\n");
   606→            continue;
   607→          }
   608→
   609→          if (!validActions.includes(action)) {
   610→            console.log(`Invalid action: ${action}. Skipping.\n`);
   611→            continue;
   612→          }
   613→
   614→          const reasoning = await askQuestion("Reasoning: ");
   615→
   616→          if (reasoning === null) {
   617→            console.log(`\nTriage interrupted. ${triaged} record(s) saved.`);
   618→            rl.close();
   619→            return;
   620→          }
   621→
   622→          if (!reasoning) {
   623→            console.log("Reasoning required. Skipping.\n");
   624→            continue;
   625→          }
   626→
   627→          const author = getAuthor(ctx.config?.identity?.author);
   628→
   629→          const record: LoadedTriageRecord = {
   630→            _ulid: ulid(),
   631→            inbox_ref: item._ulid,
   632→            item_snapshot: item.text,
   633→            status: "triaged",
   634→            action: action as TriageAction,
   635→            reasoning,
   636→            decided_by: author,
   637→            evidence_refs: [],
   638→            created_at: new Date().toISOString(),
   639→          };
   640→
   641→          await saveTriageRecord(ctx, record);
   642→          await commitIfShadow(
   643→            ctx.shadow,
   644→            "triage-record",
   645→            record._ulid.slice(0, 8),
   646→            action,
   647→          );
   648→
   649→          triaged++;
   650→          console.log(`Recorded: ${record._ulid.slice(0, 8)} → ${action}\n`);
   651→        }
   652→
   653→        rl.close();
   654→        console.log(`\nTriage complete. ${triaged} record(s) created.`);
   655→      } catch (err) {
   656→        error("Failed to start interactive triage", err);
   657→        process.exit(EXIT_CODES.ERROR);
   658→      }
   659→    });
   660→
   661→  // kspec triage get <triage-ref>
   662→  triage
   663→    .command("get <triage-ref>")
   664→    .description("Show details of a triage record")
   665→    .action(async (triageRef: string) => {
   666→      try {
   667→        const ctx = await initContext();
   668→        const records = await loadTriageRecords(ctx);
   669→        const record = resolveTriageRef(triageRef, records);
   670→
   671→        output(record, () => {
   672→          console.log(`ULID:        ${record._ulid}`);
   673→          console.log(`Inbox ref:   ${record.inbox_ref}`);
   674→          console.log(`Status:      ${record.status}`);
   675→          if (record.action) console.log(`Action:      ${record.action}`);
   676→          if (record.reasoning) console.log(`Reasoning:   ${record.reasoning}`);
   677→          if (record.decided_by) console.log(`Decided by:  ${record.decided_by}`);
   678→          if (record.evidence_refs.length > 0) {
   679→            console.log(`Evidence:    ${record.evidence_refs.join(", ")}`);
   680→          }
   681→          console.log(`Created:     ${record.created_at} (${formatRelativeTime(record.created_at)})`);
   682→          if (record.updated_at) {
   683→            console.log(`Updated:     ${record.updated_at}`);
   684→          }
   685→          if (record.override_reasoning) {
   686→            console.log("");
   687→            console.log("Override:");
   688→            console.log(`  Reasoning: ${record.override_reasoning}`);
   689→            if (record.override_by) console.log(`  By:        ${record.override_by}`);
   690→            if (record.override_at) console.log(`  At:        ${record.override_at}`);
   691→          }
   692→          if (record.acted_at) {
   693→            console.log("");
   694→            console.log(`Acted at:    ${record.acted_at}`);
   695→            if (record.result_ref) console.log(`Result ref:  ${record.result_ref}`);
   696→          }
   697→          console.log("");
   698→          console.log("Item snapshot:");
   699→          console.log(record.item_snapshot);
   700→        });
   701→      } catch (err) {
   702→        error("Failed to get triage record", err);
   703→        process.exit(EXIT_CODES.ERROR);
   704→      }
   705→    });
   706→}
   707→