    97→// AC: @triage-record-schema ac-3
    98→describe('TriageRecordSchema - decision fields', () => {
    99→  it('should accept reasoning, decided_by, and evidence_refs', () => {
   100→    const result = TriageRecordSchema.safeParse(validRecord({
   101→      reasoning: 'Clear feature request',
   102→      decided_by: '@claude',
   103→      evidence_refs: ['@some-spec', '@another-ref'],
   104→    }));
   105→    expect(result.success).toBe(true);
   106→    if (result.success) {
   107→      expect(result.data.reasoning).toBe('Clear feature request');
   108→      expect(result.data.decided_by).toBe('@claude');
   109→      expect(result.data.evidence_refs).toEqual(['@some-spec', '@another-ref']);
   110→    }
   111→  });
   112→
   113→  it('should default evidence_refs to empty array', () => {
   114→    const result = TriageRecordSchema.safeParse(validRecord({
   115→      evidence_refs: undefined,
   116→    }));
   117→    expect(result.success).toBe(true);
   118→    if (result.success) {
   119→      expect(result.data.evidence_refs).toEqual([]);
   120→    }
   121→  });
   122→
   123→  // AC: @triage-record-schema ac-3
   124→  // AC: @trait-error-guidance ac-5 — validation error indicates which field failed
   125→  it('should reject triaged record without reasoning', () => {
   126→    const result = TriageRecordSchema.safeParse(validRecord({
   127→      reasoning: undefined,
   128→    }));
   129→    expect(result.success).toBe(false);
   130→    if (!result.success) {
   131→      const issues = result.error.issues;
   132→      expect(issues.some(i => i.path.includes('reasoning'))).toBe(true);
   133→    }
   134→  });
   135→
   136→  // AC: @triage-record-schema ac-3
   137→  // AC: @trait-error-guidance ac-5 — validation error indicates which field failed
   138→  it('should reject triaged record without decided_by', () => {
   139→    const result = TriageRecordSchema.safeParse(validRecord({
   140→      decided_by: undefined,
   141→    }));
   142→    expect(result.success).toBe(false);
   143→    if (!result.success) {
   144→      const issues = result.error.issues;
   145→      expect(issues.some(i => i.path.includes('decided_by'))).toBe(true);
   146→    }
   147→  });
   148→
   149→  // AC: @triage-record-schema ac-3
   150→  // AC: @trait-error-guidance ac-5 — validation error indicates which field failed
   151→  it('should reject triaged record without action', () => {
   152→    const result = TriageRecordSchema.safeParse(validRecord({
   153→      action: undefined,
   154→    }));
   155→    expect(result.success).toBe(false);
   156→    if (!result.success) {
   157→      const issues = result.error.issues;
   158→      expect(issues.some(i => i.path.includes('action'))).toBe(true);
   159→    }
   160→  });
   161→
   162→  it('should allow pending record without decision fields', () => {
   163→    const result = TriageRecordSchema.safeParse({
   164→      _ulid: VALID_ULID,
   165→      inbox_ref: INBOX_ULID,
