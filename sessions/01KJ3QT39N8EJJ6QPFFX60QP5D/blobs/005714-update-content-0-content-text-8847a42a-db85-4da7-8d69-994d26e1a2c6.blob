   334→// AC: @trait-error-guidance ac-1 — error includes description of what went wrong
   335→// AC: @trait-error-guidance ac-2 — error includes suggested action to resolve
   336→describe('TriageRecordSchema - error guidance (trait)', () => {
   337→  it('should include descriptive error for invalid ULID', () => {
   338→    const result = TriageRecordSchema.safeParse(validRecord({ _ulid: 'bad' }));
   339→    expect(result.success).toBe(false);
   340→    if (!result.success) {
   341→      const ulidIssue = result.error.issues.find(i => i.path.includes('_ulid'));
   342→      expect(ulidIssue).toBeDefined();
   343→      expect(ulidIssue?.message).toBeTruthy();
   344→    }
   345→  });
   346→
   347→  // AC: @trait-error-guidance ac-5 — validation error indicates which field/value failed
   348→  it('should include field path in validation errors', () => {
   349→    const result = TriageRecordSchema.safeParse(validRecord({ status: 'invalid_status' }));
   350→    expect(result.success).toBe(false);
   351→    if (!result.success) {
   352→      const statusIssue = result.error.issues.find(i =>
   353→        i.path.includes('status')
   354→      );
   355→      expect(statusIssue).toBeDefined();
   356→    }
   357→  });
   358→
   359→  // AC: @trait-error-guidance ac-4 — invalid state transition guidance
   360→  it('should provide guidance when triaged record missing decision metadata', () => {
   361→    const result = TriageRecordSchema.safeParse(validRecord({
   362→      action: undefined,
   363→      reasoning: undefined,
   364→      decided_by: undefined,
   365→    }));
   366→    expect(result.success).toBe(false);
   367→    if (!result.success) {
   368→      // Should have issues for all three missing fields
   369→      const paths = result.error.issues.map(i => i.path).flat();
   370→      expect(paths).toContain('action');
   371→      expect(paths).toContain('reasoning');
   372→      expect(paths).toContain('decided_by');
   373→    }
   374→  });
   375→
   376→  // AC: @trait-error-guidance ac-6 — errors in structured format (Zod issues are JSON-serializable)
   377→  it('should produce JSON-serializable error objects', () => {
   378→    const result = TriageRecordSchema.safeParse(validRecord({ _ulid: 'bad' }));
   379→    expect(result.success).toBe(false);
   380→    if (!result.success) {
   381→      const json = JSON.stringify(result.error.issues);
   382→      expect(json).toBeTruthy();
   383→      const parsed = JSON.parse(json);
   384→      expect(Array.isArray(parsed)).toBe(true);
   385→      expect(parsed[0]).toHaveProperty('message');
   386→      expect(parsed[0]).toHaveProperty('path');
   387→    }
   388→  });
   389→});
