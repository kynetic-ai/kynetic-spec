   174→// AC: @triage-record-schema ac-4
   175→describe('TriageRecordSchema - override fields', () => {
   176→  it('should accept override_reasoning, override_by, and override_at', () => {
   177→    const result = TriageRecordSchema.safeParse(validRecord({
   178→      override_reasoning: 'Not ready yet, defer instead',
   179→      override_by: 'alice',
   180→      override_at: '2026-02-22T01:00:00.000Z',
   181→      action: 'defer',
   182→    }));
   183→    expect(result.success).toBe(true);
   184→    if (result.success) {
   185→      expect(result.data.override_reasoning).toBe('Not ready yet, defer instead');
   186→      expect(result.data.override_by).toBe('alice');
   187→      expect(result.data.override_at).toBe('2026-02-22T01:00:00.000Z');
   188→      // Original decision fields preserved
   189→      expect(result.data.reasoning).toBe('Clear feature request with user demand');
   190→      expect(result.data.decided_by).toBe('@claude');
   191→    }
   192→  });
   193→
   194→  it('should allow override fields to be optional', () => {
   195→    const result = TriageRecordSchema.safeParse(validRecord());
   196→    expect(result.success).toBe(true);
   197→    if (result.success) {
   198→      expect(result.data.override_reasoning).toBeUndefined();
   199→      expect(result.data.override_by).toBeUndefined();
   200→      expect(result.data.override_at).toBeUndefined();
   201→    }
   202→  });
   203→});
