     1→import { describe, it, expect } from 'vitest';
     2→import {
     3→  TriageStatusSchema,
     4→  TriageActionSchema,
     5→  TriageRecordSchema,
     6→  TriageRecordInputSchema,
     7→  TriageFileSchema,
     8→} from '../src/schema/index.js';
     9→import { testUlid } from './helpers/cli.js';
    10→
    11→const VALID_ULID = testUlid('TRJAGE', 0);
    12→const INBOX_ULID = testUlid('JNBOX', 0);
    13→
    14→function validRecord(overrides: Record<string, unknown> = {}) {
    15→  return {
    16→    _ulid: VALID_ULID,
    17→    inbox_ref: INBOX_ULID,
    18→    item_snapshot: 'Add dark mode support',
    19→    status: 'triaged',
    20→    action: 'promote',
    21→    reasoning: 'Clear feature request with user demand',
    22→    decided_by: '@claude',
    23→    evidence_refs: [],
    24→    created_at: '2026-02-22T00:00:00.000Z',
    25→    ...overrides,
    26→  };
    27→}
    28→
    29→function actedOnRecord(overrides: Record<string, unknown> = {}) {
    30→  return validRecord({
    31→    status: 'acted_on',
    32→    acted_at: '2026-02-22T02:00:00.000Z',
    33→    result_ref: '@task-new-feature',
    34→    ...overrides,
    35→  });
    36→}
    37→
    38→// AC: @triage-record-schema ac-1
    39→describe('TriageRecordSchema - required fields', () => {
    40→  it('should accept a valid triage record with all required fields', () => {
    41→    const result = TriageRecordSchema.safeParse(validRecord());
    42→    expect(result.success).toBe(true);
    43→  });
    44→
    45→  // AC: @triage-record-schema ac-1
    46→  it('should require _ulid, inbox_ref, item_snapshot, status, created_at', () => {
    47→    const requiredFields = ['_ulid', 'inbox_ref', 'item_snapshot', 'status', 'created_at'];
    48→    for (const field of requiredFields) {
    49→      const record = validRecord();
    50→      delete (record as Record<string, unknown>)[field];
    51→      const result = TriageRecordSchema.safeParse(record);
    52→      expect(result.success, `should reject missing ${field}`).toBe(false);
    53→    }
    54→  });
    55→
    56→  it('should accept a minimal pending record with only required fields', () => {
    57→    const result = TriageRecordSchema.safeParse({
    58→      _ulid: VALID_ULID,
    59→      inbox_ref: INBOX_ULID,
    60→      item_snapshot: 'Some idea',
    61→      status: 'pending',
    62→      created_at: '2026-02-22T00:00:00.000Z',
    63→    });
    64→    expect(result.success).toBe(true);
    65→  });
    66→});
    67→
    68→// AC: @triage-record-schema ac-2
    69→describe('TriageActionSchema', () => {
    70→  it('should accept valid actions: promote, delete, defer, spec-gap, duplicate', () => {
    71→    for (const action of ['promote', 'delete', 'defer', 'spec-gap', 'duplicate']) {
    72→      expect(TriageActionSchema.safeParse(action).success, `should accept ${action}`).toBe(true);
    73→    }
    74→  });
    75→
    76→  it('should reject invalid actions', () => {
    77→    expect(TriageActionSchema.safeParse('archive').success).toBe(false);
    78→    expect(TriageActionSchema.safeParse('').success).toBe(false);
    79→    expect(TriageActionSchema.safeParse('PROMOTE').success).toBe(false);
    80→  });
    81→});
    82→
    83→// AC: @triage-record-schema ac-1
    84→describe('TriageStatusSchema', () => {
    85→  it('should accept valid statuses: pending, triaged, acted_on', () => {
    86→    for (const status of ['pending', 'triaged', 'acted_on']) {
    87→      expect(TriageStatusSchema.safeParse(status).success, `should accept ${status}`).toBe(true);
    88→    }
    89→  });
    90→
    91→  it('should reject invalid statuses', () => {
    92→    expect(TriageStatusSchema.safeParse('completed').success).toBe(false);
    93→    expect(TriageStatusSchema.safeParse('').success).toBe(false);
    94→  });
