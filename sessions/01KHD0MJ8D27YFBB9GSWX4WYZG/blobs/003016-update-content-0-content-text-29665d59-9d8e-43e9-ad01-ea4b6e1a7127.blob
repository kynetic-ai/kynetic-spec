```
     1→/**
     2→ * Workflow run CLI commands
     3→ *
     4→ * Implements workflow run lifecycle management:
     5→ * - kspec workflow start @ref [--task @ref] [--json]
     6→ * - kspec workflow runs [--active] [--completed] [--workflow @ref] [--json]
     7→ * - kspec workflow show @run [--json]
     8→ * - kspec workflow abort @run [--reason text] [--json]
     9→ * - kspec workflow complete @run [--result <result>] [--json]
    10→ */
    11→
    12→import chalk from "chalk";
    13→import Table from "cli-table3";
    14→import type { Command } from "commander";
    15→import { ulid } from "ulid";
    16→import { markMutating } from "../command-annotations.js";
    17→import {
    18→  deleteWorkflowRuns,
    19→  findActiveRuns,
    20→  findWorkflowRunByRef,
    21→  getAuthor,
    22→  initContext,
    23→  loadAllTasks,
    24→  loadMetaContext,
    25→  loadWorkflowRuns,
    26→  ReferenceIndex,
    27→  saveWorkflowRun,
    28→  updateWorkflowRun,
    29→  type Workflow,
    30→} from "../../parser/index.js";
    31→import { commitIfShadow } from "../../parser/shadow.js";
    32→import type { WorkflowRun, WorkflowRunResult } from "../../schema/index.js";
    33→import { WorkflowRunResultSchema } from "../../schema/index.js";
    34→import { errors } from "../../strings/errors.js";
    35→import { EXIT_CODES } from "../exit-codes.js";
    36→import { error, isJsonMode, output, success } from "../output.js";
    37→
    38→/**
    39→ * Find a workflow by reference
    40→ */
    41→function resolveWorkflowRef(
    42→  ref: string,
    43→  workflows: Workflow[],
    44→): Workflow | null {
    45→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
    46→
    47→  // Try by ID first
    48→  let workflow = workflows.find((w) => w.id === cleanRef);
    49→  if (workflow) return workflow;
    50→
    51→  // Try by ULID or ULID prefix
    52→  workflow = workflows.find(
    53→    (w) =>
    54→      w._ulid === cleanRef ||
    55→      w._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
    56→  );
    57→  return workflow || null;
    58→}
    59→
    60→/**
    61→ * Format a short ULID (first 8 chars)
    62→ */
    63→function shortUlid(ulid: string): string {
    64→  return ulid.slice(0, 8).toUpperCase();
    65→}
    66→
    67→/**
    68→ * Format run status with color
    69→ */
    70→function formatStatus(status: string): string {
    71→  switch (status) {
    72→    case "active":
    73→      return chalk.green(status);
    74→    case "paused":
    75→      return chalk.yellow(status);
    76→    case "completed":
    77→      return chalk.blue(status);
    78→    case "aborted":
    79→      return chalk.red(status);
    80→    default:
    81→      return status;
    82→  }
    83→}
    84→
    85→/**
    86→ * Command: kspec workflow start @workflow-ref [--task @task-ref] [--json]
    87→ * AC: @workflow-run-foundation ac-1, ac-6
    88→ */
    89→async function workflowStart(
    90→  workflowRef: string,
    91→  options: { task?: string; json?: boolean },
    92→) {
    93→  const ctx = await initContext();
    94→  const metaCtx = await loadMetaContext(ctx);
    95→
    96→  // DEBUG: Log loaded workflows
    97→  // Resolve workflow reference
    98→  const workflow = resolveWorkflowRef(workflowRef, metaCtx.workflows);
    99→  if (!workflow) {
   100→    error(errors.workflowRun.workflowNotFound(workflowRef));
   101→    process.exit(EXIT_CODES.NOT_FOUND);
   102→  }
   103→
   104→  // Validate task reference if provided (AC: @workflow-run-foundation ac-6)
   105→  let taskRef: string | undefined;
   106→  if (options.task) {
   107→    const tasks = await loadAllTasks(ctx);
   108→    const index = new ReferenceIndex(tasks, []);
   109→    const result = index.resolve(options.task);
   110→    if (!result.ok) {
   111→      error(errors.reference.taskNotFound(options.task));
   112→      process.exit(EXIT_CODES.NOT_FOUND);
   113→    }
   114→    taskRef = `@${result.ulid}`;
   115→  }
   116→
   117→  // Create new workflow run
   118→  const run: WorkflowRun = {
   119→    _ulid: ulid(),
   120→    workflow_ref: `@${workflow._ulid}`,
   121→    status: "active",
   122→    current_step: 0,
   123→    total_steps: workflow.steps.length,
   124→    started_at: new Date().toISOString(),
   125→    step_results: [],
   126→    initiated_by: getAuthor(),
   127→    task_ref: taskRef,
   128→  };
   129→
   130→  // Save the run
   131→  await saveWorkflowRun(ctx, run);
   132→
   133→  // Commit to shadow
   134→  await commitIfShadow(ctx.shadow, "workflow-start");
   135→
   136→  // Output result
   137→  if (isJsonMode()) {
   138→    output({
   139→      run_id: run._ulid,
   140→      workflow_ref: run.workflow_ref,
   141→      status: run.status,
   142→    });
   143→  } else {
   144→    success(`Started workflow run: ${shortUlid(run._ulid)}`);
   145→    console.log(`  Workflow: ${workflow.id}`);
   146→    console.log(`  Steps: ${run.total_steps}`);
   147→    if (taskRef) {
   148→      console.log(`  Linked task: ${taskRef}`);
   149→    }
   150→  }
   151→}
   152→
   153→/**
   154→ * Command: kspec workflow runs [--active] [--completed] [--workflow @ref] [--json]
   155→ * AC: @workflow-run-foundation ac-2
   156→ */
   157→async function workflowRuns(options: {
   158→  active?: boolean;
   159→  completed?: boolean;
   160→  workflow?: string;
   161→  json?: boolean;
   162→}) {
   163→  const ctx = await initContext();
   164→  const metaCtx = await loadMetaContext(ctx);
   165→  let runs = await loadWorkflowRuns(ctx);
   166→
   167→  // Apply filters
   168→  if (options.active) {
   169→    runs = runs.filter((r) => r.status === "active");
   170→  }
   171→  if (options.completed) {
   172→    runs = runs.filter((r) => r.status === "completed");
   173→  }
   174→  if (options.workflow) {
   175→    const workflow = resolveWorkflowRef(options.workflow, metaCtx.workflows);
   176→    if (!workflow) {
   177→      error(errors.workflowRun.workflowNotFound(options.workflow));
   178→      process.exit(EXIT_CODES.NOT_FOUND);
   179→    }
   180→    runs = runs.filter((r) => r.workflow_ref === `@${workflow._ulid}`);
   181→  }
   182→
   183→  if (isJsonMode()) {
   184→    output({ runs });
   185→  } else {
   186→    if (runs.length === 0) {
   187→      console.log(chalk.gray("No workflow runs found"));
   188→      return;
   189→    }
   190→
   191→    const table = new Table({
   192→      head: ["ID", "Workflow", "Status", "Step", "Started"],
   193→      colWidths: [12, 25, 12, 10, 20],
   194→    });
   195→
   196→    for (const run of runs) {
   197→      const workflow = metaCtx.workflows.find(
   198→        (w) => `@${w._ulid}` === run.workflow_ref,
   199→      );
   200→      const workflowName = workflow?.id || run.workflow_ref;
   201→      const stepProgress = `${run.current_step + 1}/${run.total_steps}`;
   202→      const started = new Date(run.started_at).toLocaleString();
   203→
   204→      table.push([
   205→        shortUlid(run._ulid),
   206→        workflowName,
   207→        formatStatus(run.status),
   208→        stepProgress,
   209→        started,
   210→      ]);
   211→    }
   212→
   213→    console.log(table.toString());
   214→  }
   215→}
   216→
   217→/**
   218→ * Command: kspec workflow show @run-id [--json]
   219→ * AC: @workflow-run-foundation ac-4
   220→ */
   221→async function workflowShow(runRef: string, _options: { json?: boolean }) {
   222→  const ctx = await initContext();
   223→  const metaCtx = await loadMetaContext(ctx);
   224→
   225→  const run = await findWorkflowRunByRef(ctx, runRef);
   226→  if (!run) {
   227→    error(errors.workflowRun.runNotFound(runRef));
   228→    process.exit(EXIT_CODES.NOT_FOUND);
   229→  }
   230→
   231→  if (isJsonMode()) {
   232→    output({ run });
   233→  } else {
   234→    const workflow = metaCtx.workflows.find(
   235→      (w) => `@${w._ulid}` === run.workflow_ref,
   236→    );
   237→    const workflowName = workflow?.id || run.workflow_ref;
   238→
   239→    console.log(chalk.bold("Workflow Run Details"));
   240→    console.log(chalk.gray("─".repeat(50)));
   241→    console.log(`ID:           ${shortUlid(run._ulid)}`);
   242→    console.log(`Workflow:     ${workflowName} (${run.workflow_ref})`);
   243→    console.log(`Status:       ${formatStatus(run.status)}`);
   244→    console.log(`Progress:     ${run.current_step + 1}/${run.total_steps}`);
   245→    console.log(`Started:      ${new Date(run.started_at).toLocaleString()}`);
   246→
   247→    if (run.initiated_by) {
   248→      console.log(`Initiated by: ${run.initiated_by}`);
   249→    }
   250→    if (run.task_ref) {
   251→      console.log(`Task:         ${run.task_ref}`);
   252→    }
   253→    if (run.paused_at) {
   254→      console.log(`Paused:       ${new Date(run.paused_at).toLocaleString()}`);
   255→    }
   256→    if (run.completed_at) {
   257→      console.log(
   258→        `Completed:    ${new Date(run.completed_at).toLocaleString()}`,
   259→      );
   260→    }
   261→    if (run.abort_reason) {
   262→      console.log(`Abort reason: ${run.abort_reason}`);
   263→    }
   264→
   265→    if (run.step_results.length > 0) {
   266→      console.log(chalk.gray("\nStep Results:"));
   267→      const table = new Table({
   268→        head: ["Step", "Status", "Started", "Completed"],
   269→        colWidths: [8, 12, 20, 20],
   270→      });
   271→
   272→      for (const result of run.step_results) {
   273→        table.push([
   274→          (result.step_index + 1).toString(),
   275→          formatStatus(result.status),
   276→          new Date(result.started_at).toLocaleString(),
   277→          new Date(result.completed_at).toLocaleString(),
   278→        ]);
   279→      }
   280→
   281→      console.log(table.toString());
   282→    }
   283→  }
   284→}
   285→
   286→/**
   287→ * Command: kspec workflow abort @run-id [--reason text] [--json]
   288→ * AC: @workflow-run-foundation ac-3, ac-5
   289→ */
   290→async function workflowAbort(
   291→  runRef: string,
   292→  options: { reason?: string; json?: boolean },
   293→) {
   294→  const ctx = await initContext();
   295→
   296→  const run = await findWorkflowRunByRef(ctx, runRef);
   297→  if (!run) {
   298→    error(errors.workflowRun.runNotFound(runRef));
   299→    process.exit(EXIT_CODES.NOT_FOUND);
   300→  }
   301→
   302→  // AC: @workflow-run-foundation ac-5 - Cannot abort completed or aborted runs
   303→  if (run.status === "completed") {
   304→    error(errors.workflowRun.cannotAbortCompleted);
   305→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   306→  }
   307→
   308→  if (run.status === "aborted") {
   309→    error(errors.workflowRun.cannotAbortAborted);
   310→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   311→  }
   312→
   313→  // Update run status
   314→  run.status = "aborted";
   315→  run.abort_reason = options.reason;
   316→  run.completed_at = new Date().toISOString();
   317→
   318→  await updateWorkflowRun(ctx, run);
   319→  await commitIfShadow(ctx.shadow, "workflow-abort");
   320→
   321→  if (isJsonMode()) {
   322→    output({ run_id: run._ulid, status: run.status });
   323→  } else {
   324→    success(`Aborted workflow run: ${shortUlid(run._ulid)}`);
   325→    if (options.reason) {
   326→      console.log(`  Reason: ${options.reason}`);
   327→    }
   328→  }
   329→}
   330→
   331→/**
   332→ * Command: kspec workflow complete @run-id [--result <result>] [--json]
   333→ * Marks a workflow run as completed with an optional result.
   334→ * Use this for graceful exits (e.g., no_work_available) instead of aborting.
   335→ */
   336→async function workflowComplete(
   337→  runRef: string,
   338→  options: { result?: string; json?: boolean },
   339→) {
   340→  const ctx = await initContext();
   341→
   342→  const run = await findWorkflowRunByRef(ctx, runRef);
   343→  if (!run) {
   344→    error(errors.workflowRun.runNotFound(runRef));
   345→    process.exit(EXIT_CODES.NOT_FOUND);
   346→  }
   347→
   348→  // Cannot complete already finished runs
   349→  if (run.status === "completed") {
   350→    error(`Cannot complete run ${shortUlid(run._ulid)}: already completed`);
   351→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   352→  }
   353→
   354→  if (run.status === "aborted") {
   355→    error(`Cannot complete run ${shortUlid(run._ulid)}: already aborted`);
   356→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   357→  }
   358→
   359→  // Validate result if provided
   360→  let result: WorkflowRunResult | undefined;
   361→  if (options.result) {
   362→    const parseResult = WorkflowRunResultSchema.safeParse(options.result);
   363→    if (!parseResult.success) {
   364→      const validResults = WorkflowRunResultSchema.options.join(", ");
   365→      error(`Invalid result: ${options.result}. Must be one of: ${validResults}`);
   366→      process.exit(EXIT_CODES.VALIDATION_FAILED);
   367→    }
   368→    result = parseResult.data;
   369→  }
   370→
   371→  // Update run status
   372→  run.status = "completed";
   373→  run.completed_at = new Date().toISOString();
   374→  if (result) {
   375→    run.result = result;
   376→  }
   377→
   378→  await updateWorkflowRun(ctx, run);
   379→  await commitIfShadow(ctx.shadow, "workflow-complete");
   380→
   381→  if (isJsonMode()) {
   382→    output({
   383→      run_id: run._ulid,
   384→      status: run.status,
   385→      result: run.result,
   386→      completed_at: run.completed_at,
   387→    });
   388→  } else {
   389→    const resultInfo = run.result ? ` (${run.result})` : "";
   390→    success(`Completed workflow run: ${shortUlid(run._ulid)}${resultInfo}`);
   391→  }
   392→}
   393→
   394→/**
   395→ * Command: kspec workflow pause @run-id [--json]
   396→ * AC: @workflow-advanced-features ac-1
   397→ */
   398→async function workflowPause(runRef: string, _options: { json?: boolean }) {
   399→  const ctx = await initContext();
   400→
   401→  const run = await findWorkflowRunByRef(ctx, runRef);
   402→  if (!run) {
   403→    error(errors.workflowRun.runNotFound(runRef));
   404→    process.exit(EXIT_CODES.NOT_FOUND);
   405→  }
   406→
   407→  // Only active runs can be paused
   408→  if (run.status !== "active") {
   409→    error(
   410→      `Cannot pause run ${shortUlid(run._ulid)}: current status is ${run.status}`,
   411→    );
   412→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   413→  }
   414→
   415→  // Update run status
   416→  run.status = "paused";
   417→  run.paused_at = new Date().toISOString();
   418→
   419→  await updateWorkflowRun(ctx, run);
   420→  await commitIfShadow(ctx.shadow, "workflow-pause");
   421→
   422→  if (isJsonMode()) {
   423→    output({ run_id: run._ulid, status: run.status, paused_at: run.paused_at });
   424→  } else {
   425→    success(
   426→      `Paused run ${shortUlid(run._ulid)} at step ${run.current_step + 1}/${run.total_steps}`,
   427→    );
   428→  }
   429→}
   430→
   431→/**
   432→ * Command: kspec workflow resume @run-id [--json]
   433→ * AC: @workflow-advanced-features ac-2, ac-4
   434→ */
   435→async function workflowResume(runRef: string, _options: { json?: boolean }) {
   436→  const ctx = await initContext();
   437→  const metaCtx = await loadMetaContext(ctx);
   438→
   439→  const run = await findWorkflowRunByRef(ctx, runRef);
   440→  if (!run) {
   441→    error(errors.workflowRun.runNotFound(runRef));
   442→    process.exit(EXIT_CODES.NOT_FOUND);
   443→  }
   444→
   445→  // AC: @workflow-advanced-features ac-4 - Error if not paused
   446→  if (run.status !== "paused") {
   447→    error(
   448→      `Cannot resume run ${shortUlid(run._ulid)}: current status is ${run.status} (expected paused)`,
   449→    );
   450→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   451→  }
   452→
   453→  // Update run status
   454→  run.status = "active";
   455→  run.paused_at = undefined;
   456→
   457→  await updateWorkflowRun(ctx, run);
   458→  await commitIfShadow(ctx.shadow, "workflow-resume");
   459→
   460→  // Get workflow definition to show current step
   461→  const workflow = metaCtx.workflows.find(
   462→    (w) => `@${w._ulid}` === run.workflow_ref,
   463→  );
   464→  if (!workflow) {
   465→    error(errors.workflowRun.workflowNotFound(run.workflow_ref));
   466→    process.exit(EXIT_CODES.NOT_FOUND);
   467→  }
   468→
   469→  const currentStep = workflow.steps[run.current_step];
   470→
   471→  if (isJsonMode()) {
   472→    output({
   473→      run_id: run._ulid,
   474→      status: run.status,
   475→      current_step: run.current_step,
   476→      total_steps: run.total_steps,
   477→      next_step: {
   478→        type: currentStep.type,
   479→        content: currentStep.content,
   480→      },
   481→    });
   482→  } else {
   483→    success(`Resumed run ${shortUlid(run._ulid)}`);
   484→    console.log(
   485→      `\nStep ${run.current_step + 1}/${run.total_steps}: [${currentStep.type}] ${currentStep.content}`,
   486→    );
   487→  }
   488→}
   489→
   490→/**
   491→ * Command: kspec workflow next [run-ref] [--skip] [--notes text] [--confirm] [--force] [--input key=value] [--json]
   492→ * AC: @workflow-step-navigation ac-1 through ac-6
   493→ * AC: @workflow-enforcement-modes ac-1 through ac-4
   494→ * AC: @workflow-advanced-features ac-3
   495→ */
   496→async function workflowNext(
   497→  runRef: string | undefined,
   498→  options: {
   499→    skip?: boolean;
   500→    notes?: string;
   501→    confirm?: boolean;
   502→    force?: boolean;
   503→    input?: string[];
   504→    json?: boolean;
   505→  },
   506→) {
   507→  const ctx = await initContext();
   508→  const metaCtx = await loadMetaContext(ctx);
   509→
   510→  let run: WorkflowRun | undefined;
   511→
   512→  // AC: @workflow-step-navigation ac-3, ac-4, ac-5
   513→  if (!runRef) {
   514→    const activeRuns = await findActiveRuns(ctx);
   515→
   516→    if (activeRuns.length === 0) {
   517→      // AC: @workflow-step-navigation ac-5
   518→      error(errors.workflowRun.noActiveRuns);
   519→      process.exit(EXIT_CODES.NOT_FOUND);
   520→    }
   521→
   522→    if (activeRuns.length > 1) {
   523→      // AC: @workflow-step-navigation ac-4
   524→      const runIds = activeRuns.map((r) => shortUlid(r._ulid));
   525→      error(errors.workflowRun.multipleActiveRuns(runIds));
   526→      process.exit(EXIT_CODES.VALIDATION_FAILED);
   527→    }
   528→
   529→    // AC: @workflow-step-navigation ac-3 - exactly one active run
   530→    run = activeRuns[0];
   531→  } else {
   532→    run = await findWorkflowRunByRef(ctx, runRef);
   533→    if (!run) {
   534→      error(errors.workflowRun.runNotFound(runRef));
   535→      process.exit(EXIT_CODES.NOT_FOUND);
   536→    }
   537→
   538→    if (run.status !== "active") {
   539→      error(errors.workflowRun.runNotActive(runRef, run.status));
   540→      process.exit(EXIT_CODES.VALIDATION_FAILED);
   541→    }
   542→  }
   543→
   544→  // Get workflow definition to access steps
   545→  const workflow = metaCtx.workflows.find(
   546→    (w) => `@${w._ulid}` === run.workflow_ref,
   547→  );
   548→  if (!workflow) {
   549→    error(errors.workflowRun.workflowNotFound(run.workflow_ref));
   550→    process.exit(EXIT_CODES.NOT_FOUND);
   551→  }
   552→
   553→  // Get current step and next step
   554→  const currentStepIndex = run.current_step;
   555→  const currentStep = workflow.steps[currentStepIndex];
   556→  const isStrictMode = workflow.enforcement === "strict";
   557→  const isLastStep = currentStepIndex === run.total_steps - 1;
   558→
   559→  // AC: @workflow-advanced-features ac-3 - Handle step inputs
   560→  const stepInputs: Record<string, string> = {};
   561→  if (currentStep.inputs && currentStep.inputs.length > 0) {
   562→    // Display required inputs if not in JSON mode
   563→    if (!isJsonMode()) {
   564→      console.log(
   565→        `Step ${currentStepIndex + 1}/${run.total_steps}: [${currentStep.type}] ${currentStep.content}`,
   566→      );
   567→      console.log(chalk.cyan("  Inputs required:"));
   568→      for (const input of currentStep.inputs) {
   569→        const requiredLabel = input.required !== false ? "" : " (optional)";
   570→        const typeLabel = input.type ? ` (${input.type})` : "";
   571→        const desc = input.description ? `: ${input.description}` : "";
   572→        console.log(
   573→          chalk.cyan(`    - ${input.name}${typeLabel}${requiredLabel}${desc}`),
   574→        );
   575→      }
   576→      console.log();
   577→    }
   578→
   579→    // Parse --input flags
   580→    if (options.input) {
   581→      for (const inputStr of options.input) {
   582→        const [key, ...valueParts] = inputStr.split("=");
   583→        if (!valueParts.length) {
   584→          error(
   585→            `Invalid input format: "${inputStr}". Expected format: key=value`,
   586→          );
   587→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   588→        }
   589→        stepInputs[key] = valueParts.join("="); // Rejoin in case value contains '='
   590→      }
   591→    }
   592→
   593→    // Validate required inputs
   594→    for (const input of currentStep.inputs) {
   595→      if (input.required !== false && !stepInputs[input.name]) {
   596→        error(`Missing required input: ${input.name}`);
   597→        process.exit(EXIT_CODES.VALIDATION_FAILED);
   598→      }
   599→    }
   600→  }
   601→
   602→  // AC: @workflow-enforcement-modes ac-3 - Strict mode: --skip requires --force
   603→  if (options.skip && isStrictMode && !options.force) {
   604→    error(errors.workflowRun.skipRequiresForce);
   605→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   606→  }
   607→
   608→  // AC: @workflow-enforcement-modes ac-2, ac-3 - Check exit criteria for CURRENT step
   609→  if (
   610→    currentStep.exit_criteria &&
   611→    currentStep.exit_criteria.length > 0 &&
   612→    !options.skip
   613→  ) {
   614→    // AC: @workflow-enforcement-modes ac-3 - Strict mode requires --confirm
   615→    if (isStrictMode && !options.confirm) {
   616→      if (!isJsonMode()) {
   617→        console.log(
   618→          `Completing step ${currentStepIndex + 1}/${run.total_steps}: [${currentStep.type}] ${currentStep.content}`,
   619→        );
   620→        console.log(chalk.yellow("  Exit criteria:"));
   621→        for (const criterion of currentStep.exit_criteria) {
   622→          console.log(chalk.yellow(`    - ${criterion}`));
   623→        }
   624→        console.log();
   625→      }
   626→      error(errors.workflowRun.exitCriteriaNotConfirmed);
   627→      process.exit(EXIT_CODES.VALIDATION_FAILED);
   628→    }
   629→
   630→    // AC: @workflow-enforcement-modes ac-4 - Advisory mode shows criteria as guidance
   631→    if (!isStrictMode && !isJsonMode()) {
   632→      console.log(chalk.gray("  Exit criteria:"));
   633→      for (const criterion of currentStep.exit_criteria) {
   634→        console.log(chalk.gray(`    - ${criterion}`));
   635→      }
   636→    }
   637→  }
   638→
   639→  // AC: @workflow-enforcement-modes ac-1, ac-3 - Check entry criteria for NEXT step
   640→  // (Only applies when advancing from current step normally, not when skipping or completing the workflow)
   641→  // When skipping, we don't check entry criteria because we're not actually starting the next step yet
   642→  if (!isLastStep && !options.skip) {
   643→    const nextStep = workflow.steps[currentStepIndex + 1];
   644→    if (nextStep.entry_criteria && nextStep.entry_criteria.length > 0) {
   645→      // AC: @workflow-enforcement-modes ac-3 - Strict mode requires --confirm
   646→      if (isStrictMode && !options.confirm) {
   647→        if (!isJsonMode()) {
   648→          console.log(
   649→            `Step ${currentStepIndex + 2}/${run.total_steps}: [${nextStep.type}] ${nextStep.content}`,
   650→          );
   651→          console.log(chalk.yellow("  Entry criteria:"));
   652→          for (const criterion of nextStep.entry_criteria) {
   653→            console.log(chalk.yellow(`    - ${criterion}`));
   654→          }
   655→          console.log();
   656→        }
   657→        error(errors.workflowRun.entryCriteriaNotConfirmed);
   658→        process.exit(EXIT_CODES.VALIDATION_FAILED);
   659→      }
   660→
   661→      // AC: @workflow-enforcement-modes ac-4 - Advisory mode shows criteria as guidance
   662→      if (!isStrictMode && !isJsonMode()) {
   663→        console.log(
   664→          `Step ${currentStepIndex + 2}/${run.total_steps}: [${nextStep.type}] ${nextStep.content}`,
   665→        );
   666→        console.log(chalk.gray("  Entry criteria:"));
   667→        for (const criterion of nextStep.entry_criteria) {
   668→          console.log(chalk.gray(`    - ${criterion}`));
   669→        }
   670→        console.log();
   671→      }
   672→    }
   673→  }
   674→
   675→  // AC: @workflow-step-navigation ac-1, ac-6 - Complete current step
   676→  const previousResult = run.step_results[run.step_results.length - 1];
   677→  const startedAt = previousResult
   678→    ? previousResult.completed_at
   679→    : run.started_at;
   680→
   681→  // AC: @workflow-enforcement-modes ac-3 - Record confirmations in StepResult
   682→  // Check if a stub result already exists for this step (created when we advanced to it)
   683→  const existingResultIndex = run.step_results.findIndex(
   684→    (r) => r.step_index === currentStepIndex,
   685→  );
   686→
   687→  if (existingResultIndex >= 0) {
   688→    // Update existing stub result with completion data
   689→    const existingResult = run.step_results[existingResultIndex];
   690→    run.step_results[existingResultIndex] = {
   691→      ...existingResult,
   692→      status: options.skip ? ("skipped" as const) : ("completed" as const),
   693→      completed_at: new Date().toISOString(),
   694→      notes: options.notes,
   695→      exit_confirmed:
   696→        currentStep.exit_criteria &&
   697→        currentStep.exit_criteria.length > 0 &&
   698→        options.confirm
   699→          ? true
   700→          : undefined,
   701→      inputs: Object.keys(stepInputs).length > 0 ? stepInputs : undefined,
   702→    };
   703→  } else {
   704→    // No stub exists (first step or old data), create complete result
   705→    const stepResult = {
   706→      step_index: currentStepIndex,
   707→      status: options.skip ? ("skipped" as const) : ("completed" as const),
   708→      started_at: startedAt,
   709→      completed_at: new Date().toISOString(),
   710→      notes: options.notes,
   711→      exit_confirmed:
   712→        currentStep.exit_criteria &&
   713→        currentStep.exit_criteria.length > 0 &&
   714→        options.confirm
   715→          ? true
   716→          : undefined,
   717→      entry_confirmed: undefined,
   718→      inputs: Object.keys(stepInputs).length > 0 ? stepInputs : undefined,
   719→    };
   720→    run.step_results.push(stepResult);
   721→  }
   722→
   723→  // AC: @workflow-step-navigation ac-1 - Advance to next step or complete run
   724→  if (isLastStep) {
   725→    // AC: @workflow-step-navigation ac-2 - Complete the run
   726→    run.status = "completed";
   727→    run.completed_at = new Date().toISOString();
   728→
   729→    await updateWorkflowRun(ctx, run);
   730→    await commitIfShadow(ctx.shadow, "workflow-next");
   731→
   732→    // Calculate summary stats
   733→    const totalDuration =
   734→      new Date(run.completed_at).getTime() - new Date(run.started_at).getTime();
   735→    const completedSteps = run.step_results.filter(
   736→      (r) => r.status === "completed",
   737→    ).length;
   738→    const skippedSteps = run.step_results.filter(
   739→      (r) => r.status === "skipped",
   740→    ).length;
   741→
   742→    if (isJsonMode()) {
   743→      output({
   744→        run_id: run._ulid,
   745→        status: run.status,
   746→        completed_at: run.completed_at,
   747→        total_duration_ms: totalDuration,
   748→        steps_completed: completedSteps,
   749→        steps_skipped: skippedSteps,
   750→      });
   751→    } else {
   752→      const currentStep = workflow.steps[currentStepIndex];
   753→      success(
   754→        `Completed step ${currentStepIndex + 1}/${run.total_steps}: [${currentStep.type}] ${currentStep.content}`,
   755→      );
   756→      console.log();
   757→      console.log(chalk.bold("Workflow completed!"));
   758→      console.log(`  Duration: ${Math.round(totalDuration / 1000)}s`);
   759→      console.log(`  Steps completed: ${completedSteps}`);
   760→      console.log(`  Steps skipped: ${skippedSteps}`);
   761→    }
   762→  } else {
   763→    // Advance to next step
   764→    run.current_step += 1;
   765→
   766→    // AC: @workflow-enforcement-modes ac-3 - Record entry confirmation for the next step
   767→    // Create a stub step result for the next step to capture entry_confirmed and started_at
   768→    // This will be updated with completion data when the step is completed
   769→    const nextStep = workflow.steps[run.current_step];
   770→    const nextStepStartedAt =
   771→      run.step_results[run.step_results.length - 1]?.completed_at ||
   772→      new Date().toISOString();
   773→    const nextStepStub = {
   774→      step_index: run.current_step,
   775→      status: "completed" as const, // Placeholder, will be updated
   776→      started_at: nextStepStartedAt,
   777→      completed_at: nextStepStartedAt, // Placeholder, will be updated
   778→      entry_confirmed:
   779→        nextStep.entry_criteria &&
   780→        nextStep.entry_criteria.length > 0 &&
   781→        options.confirm
   782→          ? true
   783→          : undefined,
   784→    };
   785→    run.step_results.push(nextStepStub);
   786→
   787→    await updateWorkflowRun(ctx, run);
   788→    await commitIfShadow(ctx.shadow, "workflow-next");
   789→
   790→    if (isJsonMode()) {
   791→      output({
   792→        run_id: run._ulid,
   793→        current_step: run.current_step,
   794→        total_steps: run.total_steps,
   795→        next_step: {
   796→          type: nextStep.type,
   797→          content: nextStep.content,
   798→        },
   799→      });
   800→    } else {
   801→      const previousStep = workflow.steps[currentStepIndex];
   802→      success(
   803→        `Completed step ${currentStepIndex + 1}/${run.total_steps}: [${previousStep.type}] ${previousStep.content}`,
   804→      );
   805→      console.log();
   806→      console.log(
   807→        `Step ${run.current_step + 1}/${run.total_steps}: [${nextStep.type}] ${nextStep.content}`,
   808→      );
   809→    }
   810→  }
   811→}
   812→
   813→/**
   814→ * Command: kspec workflow prune [--older-than <duration>] [--status <status>] [--abandoned] [--dry-run]
   815→ * AC: @workflow-prune ac-1, ac-2, ac-3, ac-4
   816→ */
   817→async function workflowPrune(options: {
   818→  olderThan?: string;
   819→  status?: string;
   820→  abandoned?: boolean;
   821→  dryRun?: boolean;
   822→  json?: boolean;
   823→}) {
   824→  const ctx = await initContext();
   825→  let runs = await loadWorkflowRuns(ctx);
   826→
   827→  // Track which runs to prune
   828→  let toPrune: WorkflowRun[] = [];
   829→
   830→  // AC: @workflow-prune ac-1 - Filter by age
   831→  if (options.olderThan) {
   832→    const match = options.olderThan.match(/^(\d+)([dhm])$/);
   833→    if (!match) {
   834→      error(
   835→        'Invalid duration format. Use format like: 30d (days), 12h (hours), 45m (minutes)',
   836→      );
   837→      process.exit(EXIT_CODES.USAGE_ERROR);
   838→    }
   839→
   840→    const [, amount, unit] = match;
   841→    const amountNum = parseInt(amount);
   842→    const milliseconds = {
   843→      m: amountNum * 60 * 1000,
   844→      h: amountNum * 60 * 60 * 1000,
   845→      d: amountNum * 24 * 60 * 60 * 1000,
   846→    }[unit];
   847→
   848→    if (milliseconds === undefined) {
   849→      error('Invalid duration unit. Use d (days), h (hours), or m (minutes)');
   850→      process.exit(EXIT_CODES.USAGE_ERROR);
   851→    }
   852→
   853→    const cutoffTime = Date.now() - milliseconds;
   854→    toPrune = runs.filter((r) => {
   855→      const runTime = new Date(r.started_at).getTime();
   856→      return runTime < cutoffTime;
   857→    });
   858→  }
   859→
   860→  // AC: @workflow-prune ac-2 - Filter by status
   861→  if (options.status) {
   862→    const validStatuses = ['active', 'paused', 'completed', 'aborted'];
   863→    if (!validStatuses.includes(options.status)) {
   864→      error(
   865→        `Invalid status: ${options.status}. Must be one of: ${validStatuses.join(', ')}`,
   866→      );
   867→      process.exit(EXIT_CODES.USAGE_ERROR);
   868→    }
   869→
   870→    if (toPrune.length > 0) {
   871→      // Filter existing toPrune list
   872→      toPrune = toPrune.filter((r) => r.status === options.status);
   873→    } else {
   874→      // No age filter, just status
   875→      toPrune = runs.filter((r) => r.status === options.status);
   876→    }
   877→  }
   878→
   879→  // AC: @workflow-prune ac-3 - Filter by abandoned (active with no activity for 7+ days)
   880→  if (options.abandoned) {
   881→    const abandonedCutoff = Date.now() - 7 * 24 * 60 * 60 * 1000; // 7 days
   882→    const abandonedRuns = runs.filter((r) => {
   883→      if (r.status !== 'active') return false;
   884→
   885→      // Find most recent activity time
   886→      let lastActivity = new Date(r.started_at).getTime();
   887→      if (r.step_results.length > 0) {
   888→        const lastStep = r.step_results[r.step_results.length - 1];
   889→        lastActivity = new Date(lastStep.completed_at).getTime();
   890→      }
   891→
   892→      return lastActivity < abandonedCutoff;
   893→    });
   894→
   895→    if (toPrune.length > 0) {
   896→      // Intersect with existing toPrune list
   897→      const abandonedUlids = new Set(abandonedRuns.map((r) => r._ulid));
   898→      toPrune = toPrune.filter((r) => abandonedUlids.has(r._ulid));
   899→    } else {
   900→      toPrune = abandonedRuns;
   901→    }
   902→  }
   903→
   904→  // If no filters provided, error
   905→  if (!options.olderThan && !options.status && !options.abandoned) {
   906→    error(
   907→      'Must specify at least one filter: --older-than, --status, or --abandoned',
   908→    );
   909→    process.exit(EXIT_CODES.USAGE_ERROR);
   910→  }
   911→
   912→  // AC: @workflow-prune ac-4 - Dry run mode
   913→  if (options.dryRun || isJsonMode()) {
   914→    const output_data = {
   915→      would_delete: toPrune.length,
   916→      runs: toPrune.map((r) => ({
   917→        _ulid: r._ulid,
   918→        workflow_ref: r.workflow_ref,
   919→        status: r.status,
   920→        started_at: r.started_at,
   921→      })),
   922→    };
   923→
   924→    if (isJsonMode()) {
   925→      output(output_data);
   926→    } else {
   927→      console.log(
   928→        chalk.yellow(
   929→          `Would delete ${toPrune.length} workflow run${toPrune.length === 1 ? '' : 's'}:`,
   930→        ),
   931→      );
   932→      if (toPrune.length > 0) {
   933→        const table = new Table({
   934→          head: ['ID', 'Workflow', 'Status', 'Started'],
   935→          colWidths: [12, 25, 12, 20],
   936→        });
   937→
   938→        const metaCtx = await loadMetaContext(ctx);
   939→        for (const run of toPrune) {
   940→          const workflow = metaCtx.workflows.find(
   941→            (w) => `@${w._ulid}` === run.workflow_ref,
   942→          );
   943→          const workflowName = workflow?.id || run.workflow_ref;
   944→          const started = new Date(run.started_at).toLocaleString();
   945→
   946→          table.push([
   947→            shortUlid(run._ulid),
   948→            workflowName,
   949→            formatStatus(run.status),
   950→            started,
   951→          ]);
   952→        }
   953→
   954→        console.log(table.toString());
   955→        console.log(
   956→          chalk.gray('\nRun without --dry-run to actually delete these runs'),
   957→        );
   958→      }
   959→    }
   960→    return;
   961→  }
   962→
   963→  // Actually delete
   964→  if (toPrune.length === 0) {
   965→    if (!isJsonMode()) {
   966→      console.log(chalk.gray('No runs match the specified criteria'));
   967→    } else {
   968→      output({ deleted: 0 });
   969→    }
   970→    return;
   971→  }
   972→
   973→  const ulidsToDelete = toPrune.map((r) => r._ulid);
   974→  await deleteWorkflowRuns(ctx, ulidsToDelete);
   975→  await commitIfShadow(ctx.shadow, 'workflow-prune');
   976→
   977→  if (isJsonMode()) {
   978→    output({ deleted: toPrune.length });
   979→  } else {
   980→    success(
   981→      `Deleted ${toPrune.length} workflow run${toPrune.length === 1 ? '' : 's'}`,
   982→    );
   983→  }
   984→}
   985→
   986→/**
   987→ * Register workflow commands
   988→ */
   989→export function registerWorkflowCommand(program: Command): void {
   990→  const workflow = program
   991→    .command("workflow")
   992→    .description("Manage workflow runs");
   993→
   994→  markMutating(workflow.command("start"))
   995→    .description("Start a new workflow run")
   996→    .argument("<workflow-ref>", "Workflow reference (@id or @ulid)")
   997→    .option("--task <task-ref>", "Link run to a task")
   998→    .option("--json", "Output JSON")
   999→    .action(workflowStart);
  1000→
  1001→  workflow
  1002→    .command("runs")
  1003→    .description("List workflow runs")
  1004→    .option("--active", "Show only active runs")
  1005→    .option("--completed", "Show only completed runs")
  1006→    .option("--workflow <ref>", "Filter by workflow")
  1007→    .option("--json", "Output JSON")
  1008→    .action(workflowRuns);
  1009→
  1010→  workflow
  1011→    .command("show")
  1012→    .description("Show workflow run details")
  1013→    .argument("<run-ref>", "Run reference (@ulid or ulid prefix)")
  1014→    .option("--json", "Output JSON")
  1015→    .action(workflowShow);
  1016→
  1017→  markMutating(workflow.command("abort"))
  1018→    .description("Abort an active workflow run")
  1019→    .argument("<run-ref>", "Run reference (@ulid or ulid prefix)")
  1020→    .option("--reason <text>", "Reason for aborting")
  1021→    .option("--json", "Output JSON")
  1022→    .action(workflowAbort);
  1023→
  1024→  markMutating(workflow.command("complete"))
  1025→    .description("Mark workflow run as completed (graceful exit)")
  1026→    .argument("<run-ref>", "Run reference (@ulid or ulid prefix)")
  1027→    .option(
  1028→      "--result <result>",
  1029→      "Completion result (success, no_work_available, early_exit)",
  1030→    )
  1031→    .option("--json", "Output JSON")
  1032→    .action(workflowComplete);
  1033→
  1034→  markMutating(workflow.command("next"))
  1035→    .description("Advance workflow run to next step")
  1036→    .argument("[run-ref]", "Run reference (optional if only one active run)")
  1037→    .option("--skip", "Mark current step as skipped")
  1038→    .option("--notes <text>", "Notes for the completed step")
  1039→    .option(
  1040→      "--confirm",
  1041→      "Acknowledge entry/exit criteria (required in strict mode)",
  1042→    )
  1043→    .option("--force", "Allow --skip in strict mode")
  1044→    .option(
  1045→      "--input <key=value>",
  1046→      "Provide step input (repeatable)",
  1047→      (value, previous: string[] = []) => [...previous, value],
  1048→    )
  1049→    .option("--json", "Output JSON")
  1050→    .action(workflowNext);
  1051→
  1052→  markMutating(workflow.command("pause"))
  1053→    .description("Pause an active workflow run")
  1054→    .argument("<run-ref>", "Run reference (@ulid or ulid prefix)")
  1055→    .option("--json", "Output JSON")
  1056→    .action(workflowPause);
  1057→
  1058→  markMutating(workflow.command("resume"))
  1059→    .description("Resume a paused workflow run")
  1060→    .argument("<run-ref>", "Run reference (@ulid or ulid prefix)")
  1061→    .option("--json", "Output JSON")
  1062→    .action(workflowResume);
  1063→
  1064→  markMutating(workflow.command("prune"))
  1065→    .description("Remove old or stale workflow runs")
  1066→    .option(
  1067→      "--older-than <duration>",
  1068→      "Delete runs older than specified duration (e.g., 30d, 12h, 45m)",
  1069→    )
  1070→    .option(
  1071→      "--status <status>",
  1072→      "Delete runs with specific status (active, paused, completed, aborted)",
  1073→    )
  1074→    .option(
  1075→      "--abandoned",
  1076→      "Delete active runs with no activity for 7+ days",
  1077→    )
  1078→    .option("--dry-run", "Show what would be deleted without deleting")
  1079→    .option("--json", "Output JSON")
  1080→    .action(workflowPrune);
  1081→}
  1082→

