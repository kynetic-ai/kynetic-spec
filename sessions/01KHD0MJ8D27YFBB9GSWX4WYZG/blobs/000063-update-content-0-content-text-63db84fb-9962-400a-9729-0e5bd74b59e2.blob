```
     1→/**
     2→ * Workflow run CLI commands
     3→ *
     4→ * Implements workflow run lifecycle management:
     5→ * - kspec workflow start @ref [--task @ref] [--json]
     6→ * - kspec workflow runs [--active] [--completed] [--workflow @ref] [--json]
     7→ * - kspec workflow show @run [--json]
     8→ * - kspec workflow abort @run [--reason text] [--json]
     9→ */
    10→
    11→import chalk from "chalk";
    12→import Table from "cli-table3";
    13→import type { Command } from "commander";
    14→import { ulid } from "ulid";
    15→import { markMutating } from "../command-annotations.js";
    16→import {
    17→  deleteWorkflowRuns,
    18→  findActiveRuns,
    19→  findWorkflowRunByRef,
    20→  getAuthor,
    21→  initContext,
    22→  loadAllTasks,
    23→  loadMetaContext,
    24→  loadWorkflowRuns,
    25→  ReferenceIndex,
    26→  saveWorkflowRun,
    27→  updateWorkflowRun,
    28→  type Workflow,
    29→} from "../../parser/index.js";
    30→import { commitIfShadow } from "../../parser/shadow.js";
    31→import type { WorkflowRun } from "../../schema/index.js";
    32→import { errors } from "../../strings/errors.js";
    33→import { EXIT_CODES } from "../exit-codes.js";
    34→import { error, isJsonMode, output, success } from "../output.js";
    35→
    36→/**
    37→ * Find a workflow by reference
    38→ */
    39→function resolveWorkflowRef(
    40→  ref: string,
    41→  workflows: Workflow[],
    42→): Workflow | null {
    43→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
    44→
    45→  // Try by ID first
    46→  let workflow = workflows.find((w) => w.id === cleanRef);
    47→  if (workflow) return workflow;
    48→
    49→  // Try by ULID or ULID prefix
    50→  workflow = workflows.find(
    51→    (w) =>
    52→      w._ulid === cleanRef ||
    53→      w._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
    54→  );
    55→  return workflow || null;
    56→}
    57→
    58→/**
    59→ * Format a short ULID (first 8 chars)
    60→ */
    61→function shortUlid(ulid: string): string {
    62→  return ulid.slice(0, 8).toUpperCase();
    63→}
    64→
    65→/**
    66→ * Format run status with color
    67→ */
    68→function formatStatus(status: string): string {
    69→  switch (status) {
    70→    case "active":
    71→      return chalk.green(status);
    72→    case "paused":
    73→      return chalk.yellow(status);
    74→    case "completed":
    75→      return chalk.blue(status);
    76→    case "aborted":
    77→      return chalk.red(status);
    78→    default:
    79→      return status;
    80→  }
    81→}
    82→
    83→/**
    84→ * Command: kspec workflow start @workflow-ref [--task @task-ref] [--json]
    85→ * AC: @workflow-run-foundation ac-1, ac-6
    86→ */
    87→async function workflowStart(
    88→  workflowRef: string,
    89→  options: { task?: string; json?: boolean },
    90→) {
    91→  const ctx = await initContext();
    92→  const metaCtx = await loadMetaContext(ctx);
    93→
    94→  // DEBUG: Log loaded workflows
    95→  // Resolve workflow reference
    96→  const workflow = resolveWorkflowRef(workflowRef, metaCtx.workflows);
    97→  if (!workflow) {
    98→    error(errors.workflowRun.workflowNotFound(workflowRef));
    99→    process.exit(EXIT_CODES.NOT_FOUND);
   100→  }
   101→
   102→  // Validate task reference if provided (AC: @workflow-run-foundation ac-6)
   103→  let taskRef: string | undefined;
   104→  if (options.task) {
   105→    const tasks = await loadAllTasks(ctx);
   106→    const index = new ReferenceIndex(tasks, []);
   107→    const result = index.resolve(options.task);
   108→    if (!result.ok) {
   109→      error(errors.reference.taskNotFound(options.task));
   110→      process.exit(EXIT_CODES.NOT_FOUND);
   111→    }
   112→    taskRef = `@${result.ulid}`;
   113→  }
   114→
   115→  // Create new workflow run
   116→  const run: WorkflowRun = {
   117→    _ulid: ulid(),
   118→    workflow_ref: `@${workflow._ulid}`,
   119→    status: "active",
   120→    current_step: 0,
   121→    total_steps: workflow.steps.length,
   122→    started_at: new Date().toISOString(),
   123→    step_results: [],
   124→    initiated_by: getAuthor(),
   125→    task_ref: taskRef,
   126→  };
   127→
   128→  // Save the run
   129→  await saveWorkflowRun(ctx, run);
   130→
   131→  // Commit to shadow
   132→  await commitIfShadow(ctx.shadow, "workflow-start");
   133→
   134→  // Output result
   135→  if (isJsonMode()) {
   136→    output({
   137→      run_id: run._ulid,
   138→      workflow_ref: run.workflow_ref,
   139→      status: run.status,
   140→    });
   141→  } else {
   142→    success(`Started workflow run: ${shortUlid(run._ulid)}`);
   143→    console.log(`  Workflow: ${workflow.id}`);
   144→    console.log(`  Steps: ${run.total_steps}`);
   145→    if (taskRef) {
   146→      console.log(`  Linked task: ${taskRef}`);
   147→    }
   148→  }
   149→}
   150→
   151→/**
   152→ * Command: kspec workflow runs [--active] [--completed] [--workflow @ref] [--json]
   153→ * AC: @workflow-run-foundation ac-2
   154→ */
   155→async function workflowRuns(options: {
   156→  active?: boolean;
   157→  completed?: boolean;
   158→  workflow?: string;
   159→  json?: boolean;
   160→}) {
   161→  const ctx = await initContext();
   162→  const metaCtx = await loadMetaContext(ctx);
   163→  let runs = await loadWorkflowRuns(ctx);
   164→
   165→  // Apply filters
   166→  if (options.active) {
   167→    runs = runs.filter((r) => r.status === "active");
   168→  }
   169→  if (options.completed) {
   170→    runs = runs.filter((r) => r.status === "completed");
   171→  }
   172→  if (options.workflow) {
   173→    const workflow = resolveWorkflowRef(options.workflow, metaCtx.workflows);
   174→    if (!workflow) {
   175→      error(errors.workflowRun.workflowNotFound(options.workflow));
   176→      process.exit(EXIT_CODES.NOT_FOUND);
   177→    }
   178→    runs = runs.filter((r) => r.workflow_ref === `@${workflow._ulid}`);
   179→  }
   180→
   181→  if (isJsonMode()) {
   182→    output({ runs });
   183→  } else {
   184→    if (runs.length === 0) {
   185→      console.log(chalk.gray("No workflow runs found"));
   186→      return;
   187→    }
   188→
   189→    const table = new Table({
   190→      head: ["ID", "Workflow", "Status", "Step", "Started"],
   191→      colWidths: [12, 25, 12, 10, 20],
   192→    });
   193→
   194→    for (const run of runs) {
   195→      const workflow = metaCtx.workflows.find(
   196→        (w) => `@${w._ulid}` === run.workflow_ref,
   197→      );
   198→      const workflowName = workflow?.id || run.workflow_ref;
   199→      const stepProgress = `${run.current_step + 1}/${run.total_steps}`;
   200→      const started = new Date(run.started_at).toLocaleString();
   201→
   202→      table.push([
   203→        shortUlid(run._ulid),
   204→        workflowName,
   205→        formatStatus(run.status),
   206→        stepProgress,
   207→        started,
   208→      ]);
   209→    }
   210→
   211→    console.log(table.toString());
   212→  }
   213→}
   214→
   215→/**
   216→ * Command: kspec workflow show @run-id [--json]
   217→ * AC: @workflow-run-foundation ac-4
   218→ */
   219→async function workflowShow(runRef: string, _options: { json?: boolean }) {
   220→  const ctx = await initContext();
   221→  const metaCtx = await loadMetaContext(ctx);
   222→
   223→  const run = await findWorkflowRunByRef(ctx, runRef);
   224→  if (!run) {
   225→    error(errors.workflowRun.runNotFound(runRef));
   226→    process.exit(EXIT_CODES.NOT_FOUND);
   227→  }
   228→
   229→  if (isJsonMode()) {
   230→    output({ run });
   231→  } else {
   232→    const workflow = metaCtx.workflows.find(
   233→      (w) => `@${w._ulid}` === run.workflow_ref,
   234→    );
   235→    const workflowName = workflow?.id || run.workflow_ref;
   236→
   237→    console.log(chalk.bold("Workflow Run Details"));
   238→    console.log(chalk.gray("─".repeat(50)));
   239→    console.log(`ID:           ${shortUlid(run._ulid)}`);
   240→    console.log(`Workflow:     ${workflowName} (${run.workflow_ref})`);
   241→    console.log(`Status:       ${formatStatus(run.status)}`);
   242→    console.log(`Progress:     ${run.current_step + 1}/${run.total_steps}`);
   243→    console.log(`Started:      ${new Date(run.started_at).toLocaleString()}`);
   244→
   245→    if (run.initiated_by) {
   246→      console.log(`Initiated by: ${run.initiated_by}`);
   247→    }
   248→    if (run.task_ref) {
   249→      console.log(`Task:         ${run.task_ref}`);
   250→    }
   251→    if (run.paused_at) {
   252→      console.log(`Paused:       ${new Date(run.paused_at).toLocaleString()}`);
   253→    }
   254→    if (run.completed_at) {
   255→      console.log(
   256→        `Completed:    ${new Date(run.completed_at).toLocaleString()}`,
   257→      );
   258→    }
   259→    if (run.abort_reason) {
   260→      console.log(`Abort reason: ${run.abort_reason}`);
   261→    }
   262→
   263→    if (run.step_results.length > 0) {
   264→      console.log(chalk.gray("\nStep Results:"));
   265→      const table = new Table({
   266→        head: ["Step", "Status", "Started", "Completed"],
   267→        colWidths: [8, 12, 20, 20],
   268→      });
   269→
   270→      for (const result of run.step_results) {
   271→        table.push([
   272→          (result.step_index + 1).toString(),
   273→          formatStatus(result.status),
   274→          new Date(result.started_at).toLocaleString(),
   275→          new Date(result.completed_at).toLocaleString(),
   276→        ]);
   277→      }
   278→
   279→      console.log(table.toString());
   280→    }
   281→  }
   282→}
   283→
   284→/**
   285→ * Command: kspec workflow abort @run-id [--reason text] [--json]
   286→ * AC: @workflow-run-foundation ac-3, ac-5
   287→ */
   288→async function workflowAbort(
   289→  runRef: string,
   290→  options: { reason?: string; json?: boolean },
   291→) {
   292→  const ctx = await initContext();
   293→
   294→  const run = await findWorkflowRunByRef(ctx, runRef);
   295→  if (!run) {
   296→    error(errors.workflowRun.runNotFound(runRef));
   297→    process.exit(EXIT_CODES.NOT_FOUND);
   298→  }
   299→
   300→  // AC: @workflow-run-foundation ac-5 - Cannot abort completed or aborted runs
   301→  if (run.status === "completed") {
   302→    error(errors.workflowRun.cannotAbortCompleted);
   303→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   304→  }
   305→
   306→  if (run.status === "aborted") {
   307→    error(errors.workflowRun.cannotAbortAborted);
   308→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   309→  }
   310→
   311→  // Update run status
   312→  run.status = "aborted";
   313→  run.abort_reason = options.reason;
   314→  run.completed_at = new Date().toISOString();
   315→
   316→  await updateWorkflowRun(ctx, run);
   317→  await commitIfShadow(ctx.shadow, "workflow-abort");
   318→
   319→  if (isJsonMode()) {
   320→    output({ run_id: run._ulid, status: run.status });
   321→  } else {
   322→    success(`Aborted workflow run: ${shortUlid(run._ulid)}`);
   323→    if (options.reason) {
   324→      console.log(`  Reason: ${options.reason}`);
   325→    }
   326→  }
   327→}
   328→
   329→/**
   330→ * Command: kspec workflow pause @run-id [--json]
   331→ * AC: @workflow-advanced-features ac-1
   332→ */
   333→async function workflowPause(runRef: string, _options: { json?: boolean }) {
   334→  const ctx = await initContext();
   335→
   336→  const run = await findWorkflowRunByRef(ctx, runRef);
   337→  if (!run) {
   338→    error(errors.workflowRun.runNotFound(runRef));
   339→    process.exit(EXIT_CODES.NOT_FOUND);
   340→  }
   341→
   342→  // Only active runs can be paused
   343→  if (run.status !== "active") {
   344→    error(
   345→      `Cannot pause run ${shortUlid(run._ulid)}: current status is ${run.status}`,
   346→    );
   347→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   348→  }
   349→
   350→  // Update run status
   351→  run.status = "paused";
   352→  run.paused_at = new Date().toISOString();
   353→
   354→  await updateWorkflowRun(ctx, run);
   355→  await commitIfShadow(ctx.shadow, "workflow-pause");
   356→
   357→  if (isJsonMode()) {
   358→    output({ run_id: run._ulid, status: run.status, paused_at: run.paused_at });
   359→  } else {
   360→    success(
   361→      `Paused run ${shortUlid(run._ulid)} at step ${run.current_step + 1}/${run.total_steps}`,
   362→    );
   363→  }
   364→}
   365→
   366→/**
   367→ * Command: kspec workflow resume @run-id [--json]
   368→ * AC: @workflow-advanced-features ac-2, ac-4
   369→ */
   370→async function workflowResume(runRef: string, _options: { json?: boolean }) {
   371→  const ctx = await initContext();
   372→  const metaCtx = await loadMetaContext(ctx);
   373→
   374→  const run = await findWorkflowRunByRef(ctx, runRef);
   375→  if (!run) {
   376→    error(errors.workflowRun.runNotFound(runRef));
   377→    process.exit(EXIT_CODES.NOT_FOUND);
   378→  }
   379→
   380→  // AC: @workflow-advanced-features ac-4 - Error if not paused
   381→  if (run.status !== "paused") {
   382→    error(
   383→      `Cannot resume run ${shortUlid(run._ulid)}: current status is ${run.status} (expected paused)`,
   384→    );
   385→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   386→  }
   387→
   388→  // Update run status
   389→  run.status = "active";
   390→  run.paused_at = undefined;
   391→
   392→  await updateWorkflowRun(ctx, run);
   393→  await commitIfShadow(ctx.shadow, "workflow-resume");
   394→
   395→  // Get workflow definition to show current step
   396→  const workflow = metaCtx.workflows.find(
   397→    (w) => `@${w._ulid}` === run.workflow_ref,
   398→  );
   399→  if (!workflow) {
   400→    error(errors.workflowRun.workflowNotFound(run.workflow_ref));
   401→    process.exit(EXIT_CODES.NOT_FOUND);
   402→  }
   403→
   404→  const currentStep = workflow.steps[run.current_step];
   405→
   406→  if (isJsonMode()) {
   407→    output({
   408→      run_id: run._ulid,
   409→      status: run.status,
   410→      current_step: run.current_step,
   411→      total_steps: run.total_steps,
   412→      next_step: {
   413→        type: currentStep.type,
   414→        content: currentStep.content,
   415→      },
   416→    });
   417→  } else {
   418→    success(`Resumed run ${shortUlid(run._ulid)}`);
   419→    console.log(
   420→      `\nStep ${run.current_step + 1}/${run.total_steps}: [${currentStep.type}] ${currentStep.content}`,
   421→    );
   422→  }
   423→}
   424→
   425→/**
   426→ * Command: kspec workflow next [run-ref] [--skip] [--notes text] [--confirm] [--force] [--input key=value] [--json]
   427→ * AC: @workflow-step-navigation ac-1 through ac-6
   428→ * AC: @workflow-enforcement-modes ac-1 through ac-4
   429→ * AC: @workflow-advanced-features ac-3
   430→ */
   431→async function workflowNext(
   432→  runRef: string | undefined,
   433→  options: {
   434→    skip?: boolean;
   435→    notes?: string;
   436→    confirm?: boolean;
   437→    force?: boolean;
   438→    input?: string[];
   439→    json?: boolean;
   440→  },
   441→) {
   442→  const ctx = await initContext();
   443→  const metaCtx = await loadMetaContext(ctx);
   444→
   445→  let run: WorkflowRun | undefined;
   446→
   447→  // AC: @workflow-step-navigation ac-3, ac-4, ac-5
   448→  if (!runRef) {
   449→    const activeRuns = await findActiveRuns(ctx);
   450→
   451→    if (activeRuns.length === 0) {
   452→      // AC: @workflow-step-navigation ac-5
   453→      error(errors.workflowRun.noActiveRuns);
   454→      process.exit(EXIT_CODES.NOT_FOUND);
   455→    }
   456→
   457→    if (activeRuns.length > 1) {
   458→      // AC: @workflow-step-navigation ac-4
   459→      const runIds = activeRuns.map((r) => shortUlid(r._ulid));
   460→      error(errors.workflowRun.multipleActiveRuns(runIds));
   461→      process.exit(EXIT_CODES.VALIDATION_FAILED);
   462→    }
   463→
   464→    // AC: @workflow-step-navigation ac-3 - exactly one active run
   465→    run = activeRuns[0];
   466→  } else {
   467→    run = await findWorkflowRunByRef(ctx, runRef);
   468→    if (!run) {
   469→      error(errors.workflowRun.runNotFound(runRef));
   470→      process.exit(EXIT_CODES.NOT_FOUND);
   471→    }
   472→
   473→    if (run.status !== "active") {
   474→      error(errors.workflowRun.runNotActive(runRef, run.status));
   475→      process.exit(EXIT_CODES.VALIDATION_FAILED);
   476→    }
   477→  }
   478→
   479→  // Get workflow definition to access steps
   480→  const workflow = metaCtx.workflows.find(
   481→    (w) => `@${w._ulid}` === run.workflow_ref,
   482→  );
   483→  if (!workflow) {
   484→    error(errors.workflowRun.workflowNotFound(run.workflow_ref));
   485→    process.exit(EXIT_CODES.NOT_FOUND);
   486→  }
   487→
   488→  // Get current step and next step
   489→  const currentStepIndex = run.current_step;
   490→  const currentStep = workflow.steps[currentStepIndex];
   491→  const isStrictMode = workflow.enforcement === "strict";
   492→  const isLastStep = currentStepIndex === run.total_steps - 1;
   493→
   494→  // AC: @workflow-advanced-features ac-3 - Handle step inputs
   495→  const stepInputs: Record<string, string> = {};
   496→  if (currentStep.inputs && currentStep.inputs.length > 0) {
   497→    // Display required inputs if not in JSON mode
   498→    if (!isJsonMode()) {
   499→      console.log(
   500→        `Step ${currentStepIndex + 1}/${run.total_steps}: [${currentStep.type}] ${currentStep.content}`,
   501→      );
   502→      console.log(chalk.cyan("  Inputs required:"));
   503→      for (const input of currentStep.inputs) {
   504→        const requiredLabel = input.required !== false ? "" : " (optional)";
   505→        const typeLabel = input.type ? ` (${input.type})` : "";
   506→        const desc = input.description ? `: ${input.description}` : "";
   507→        console.log(
   508→          chalk.cyan(`    - ${input.name}${typeLabel}${requiredLabel}${desc}`),
   509→        );
   510→      }
   511→      console.log();
   512→    }
   513→
   514→    // Parse --input flags
   515→    if (options.input) {
   516→      for (const inputStr of options.input) {
   517→        const [key, ...valueParts] = inputStr.split("=");
   518→        if (!valueParts.length) {
   519→          error(
   520→            `Invalid input format: "${inputStr}". Expected format: key=value`,
   521→          );
   522→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   523→        }
   524→        stepInputs[key] = valueParts.join("="); // Rejoin in case value contains '='
   525→      }
   526→    }
   527→
   528→    // Validate required inputs
   529→    for (const input of currentStep.inputs) {
   530→      if (input.required !== false && !stepInputs[input.name]) {
   531→        error(`Missing required input: ${input.name}`);
   532→        process.exit(EXIT_CODES.VALIDATION_FAILED);
   533→      }
   534→    }
   535→  }
   536→
   537→  // AC: @workflow-enforcement-modes ac-3 - Strict mode: --skip requires --force
   538→  if (options.skip && isStrictMode && !options.force) {
   539→    error(errors.workflowRun.skipRequiresForce);
   540→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   541→  }
   542→
   543→  // AC: @workflow-enforcement-modes ac-2, ac-3 - Check exit criteria for CURRENT step
   544→  if (
   545→    currentStep.exit_criteria &&
   546→    currentStep.exit_criteria.length > 0 &&
   547→    !options.skip
   548→  ) {
   549→    // AC: @workflow-enforcement-modes ac-3 - Strict mode requires --confirm
   550→    if (isStrictMode && !options.confirm) {
   551→      if (!isJsonMode()) {
   552→        console.log(
   553→          `Completing step ${currentStepIndex + 1}/${run.total_steps}: [${currentStep.type}] ${currentStep.content}`,
   554→        );
   555→        console.log(chalk.yellow("  Exit criteria:"));
   556→        for (const criterion of currentStep.exit_criteria) {
   557→          console.log(chalk.yellow(`    - ${criterion}`));
   558→        }
   559→        console.log();
   560→      }
   561→      error(errors.workflowRun.exitCriteriaNotConfirmed);
   562→      process.exit(EXIT_CODES.VALIDATION_FAILED);
   563→    }
   564→
   565→    // AC: @workflow-enforcement-modes ac-4 - Advisory mode shows criteria as guidance
   566→    if (!isStrictMode && !isJsonMode()) {
   567→      console.log(chalk.gray("  Exit criteria:"));
   568→      for (const criterion of currentStep.exit_criteria) {
   569→        console.log(chalk.gray(`    - ${criterion}`));
   570→      }
   571→    }
   572→  }
   573→
   574→  // AC: @workflow-enforcement-modes ac-1, ac-3 - Check entry criteria for NEXT step
   575→  // (Only applies when advancing from current step normally, not when skipping or completing the workflow)
   576→  // When skipping, we don't check entry criteria because we're not actually starting the next step yet
   577→  if (!isLastStep && !options.skip) {
   578→    const nextStep = workflow.steps[currentStepIndex + 1];
   579→    if (nextStep.entry_criteria && nextStep.entry_criteria.length > 0) {
   580→      // AC: @workflow-enforcement-modes ac-3 - Strict mode requires --confirm
   581→      if (isStrictMode && !options.confirm) {
   582→        if (!isJsonMode()) {
   583→          console.log(
   584→            `Step ${currentStepIndex + 2}/${run.total_steps}: [${nextStep.type}] ${nextStep.content}`,
   585→          );
   586→          console.log(chalk.yellow("  Entry criteria:"));
   587→          for (const criterion of nextStep.entry_criteria) {
   588→            console.log(chalk.yellow(`    - ${criterion}`));
   589→          }
   590→          console.log();
   591→        }
   592→        error(errors.workflowRun.entryCriteriaNotConfirmed);
   593→        process.exit(EXIT_CODES.VALIDATION_FAILED);
   594→      }
   595→
   596→      // AC: @workflow-enforcement-modes ac-4 - Advisory mode shows criteria as guidance
   597→      if (!isStrictMode && !isJsonMode()) {
   598→        console.log(
   599→          `Step ${currentStepIndex + 2}/${run.total_steps}: [${nextStep.type}] ${nextStep.content}`,
   600→        );
   601→        console.log(chalk.gray("  Entry criteria:"));
   602→        for (const criterion of nextStep.entry_criteria) {
   603→          console.log(chalk.gray(`    - ${criterion}`));
   604→        }
   605→        console.log();
   606→      }
   607→    }
   608→  }
   609→
   610→  // AC: @workflow-step-navigation ac-1, ac-6 - Complete current step
   611→  const previousResult = run.step_results[run.step_results.length - 1];
   612→  const startedAt = previousResult
   613→    ? previousResult.completed_at
   614→    : run.started_at;
   615→
   616→  // AC: @workflow-enforcement-modes ac-3 - Record confirmations in StepResult
   617→  // Check if a stub result already exists for this step (created when we advanced to it)
   618→  const existingResultIndex = run.step_results.findIndex(
   619→    (r) => r.step_index === currentStepIndex,
   620→  );
   621→
   622→  if (existingResultIndex >= 0) {
   623→    // Update existing stub result with completion data
   624→    const existingResult = run.step_results[existingResultIndex];
   625→    run.step_results[existingResultIndex] = {
   626→      ...existingResult,
   627→      status: options.skip ? ("skipped" as const) : ("completed" as const),
   628→      completed_at: new Date().toISOString(),
   629→      notes: options.notes,
   630→      exit_confirmed:
   631→        currentStep.exit_criteria &&
   632→        currentStep.exit_criteria.length > 0 &&
   633→        options.confirm
   634→          ? true
   635→          : undefined,
   636→      inputs: Object.keys(stepInputs).length > 0 ? stepInputs : undefined,
   637→    };
   638→  } else {
   639→    // No stub exists (first step or old data), create complete result
   640→    const stepResult = {
   641→      step_index: currentStepIndex,
   642→      status: options.skip ? ("skipped" as const) : ("completed" as const),
   643→      started_at: startedAt,
   644→      completed_at: new Date().toISOString(),
   645→      notes: options.notes,
   646→      exit_confirmed:
   647→        currentStep.exit_criteria &&
   648→        currentStep.exit_criteria.length > 0 &&
   649→        options.confirm
   650→          ? true
   651→          : undefined,
   652→      entry_confirmed: undefined,
   653→      inputs: Object.keys(stepInputs).length > 0 ? stepInputs : undefined,
   654→    };
   655→    run.step_results.push(stepResult);
   656→  }
   657→
   658→  // AC: @workflow-step-navigation ac-1 - Advance to next step or complete run
   659→  if (isLastStep) {
   660→    // AC: @workflow-step-navigation ac-2 - Complete the run
   661→    run.status = "completed";
   662→    run.completed_at = new Date().toISOString();
   663→
   664→    await updateWorkflowRun(ctx, run);
   665→    await commitIfShadow(ctx.shadow, "workflow-next");
   666→
   667→    // Calculate summary stats
   668→    const totalDuration =
   669→      new Date(run.completed_at).getTime() - new Date(run.started_at).getTime();
   670→    const completedSteps = run.step_results.filter(
   671→      (r) => r.status === "completed",
   672→    ).length;
   673→    const skippedSteps = run.step_results.filter(
   674→      (r) => r.status === "skipped",
   675→    ).length;
   676→
   677→    if (isJsonMode()) {
   678→      output({
   679→        run_id: run._ulid,
   680→        status: run.status,
   681→        completed_at: run.completed_at,
   682→        total_duration_ms: totalDuration,
   683→        steps_completed: completedSteps,
   684→        steps_skipped: skippedSteps,
   685→      });
   686→    } else {
   687→      const currentStep = workflow.steps[currentStepIndex];
   688→      success(
   689→        `Completed step ${currentStepIndex + 1}/${run.total_steps}: [${currentStep.type}] ${currentStep.content}`,
   690→      );
   691→      console.log();
   692→      console.log(chalk.bold("Workflow completed!"));
   693→      console.log(`  Duration: ${Math.round(totalDuration / 1000)}s`);
   694→      console.log(`  Steps completed: ${completedSteps}`);
   695→      console.log(`  Steps skipped: ${skippedSteps}`);
   696→    }
   697→  } else {
   698→    // Advance to next step
   699→    run.current_step += 1;
   700→
   701→    // AC: @workflow-enforcement-modes ac-3 - Record entry confirmation for the next step
   702→    // Create a stub step result for the next step to capture entry_confirmed and started_at
   703→    // This will be updated with completion data when the step is completed
   704→    const nextStep = workflow.steps[run.current_step];
   705→    const nextStepStartedAt =
   706→      run.step_results[run.step_results.length - 1]?.completed_at ||
   707→      new Date().toISOString();
   708→    const nextStepStub = {
   709→      step_index: run.current_step,
   710→      status: "completed" as const, // Placeholder, will be updated
   711→      started_at: nextStepStartedAt,
   712→      completed_at: nextStepStartedAt, // Placeholder, will be updated
   713→      entry_confirmed:
   714→        nextStep.entry_criteria &&
   715→        nextStep.entry_criteria.length > 0 &&
   716→        options.confirm
   717→          ? true
   718→          : undefined,
   719→    };
   720→    run.step_results.push(nextStepStub);
   721→
   722→    await updateWorkflowRun(ctx, run);
   723→    await commitIfShadow(ctx.shadow, "workflow-next");
   724→
   725→    if (isJsonMode()) {
   726→      output({
   727→        run_id: run._ulid,
   728→        current_step: run.current_step,
   729→        total_steps: run.total_steps,
   730→        next_step: {
   731→          type: nextStep.type,
   732→          content: nextStep.content,
   733→        },
   734→      });
   735→    } else {
   736→      const previousStep = workflow.steps[currentStepIndex];
   737→      success(
   738→        `Completed step ${currentStepIndex + 1}/${run.total_steps}: [${previousStep.type}] ${previousStep.content}`,
   739→      );
   740→      console.log();
   741→      console.log(
   742→        `Step ${run.current_step + 1}/${run.total_steps}: [${nextStep.type}] ${nextStep.content}`,
   743→      );
   744→    }
   745→  }
   746→}
   747→
   748→/**
   749→ * Command: kspec workflow prune [--older-than <duration>] [--status <status>] [--abandoned] [--dry-run]
   750→ * AC: @workflow-prune ac-1, ac-2, ac-3, ac-4
   751→ */
   752→async function workflowPrune(options: {
   753→  olderThan?: string;
   754→  status?: string;
   755→  abandoned?: boolean;
   756→  dryRun?: boolean;
   757→  json?: boolean;
   758→}) {
   759→  const ctx = await initContext();
   760→  let runs = await loadWorkflowRuns(ctx);
   761→
   762→  // Track which runs to prune
   763→  let toPrune: WorkflowRun[] = [];
   764→
   765→  // AC: @workflow-prune ac-1 - Filter by age
   766→  if (options.olderThan) {
   767→    const match = options.olderThan.match(/^(\d+)([dhm])$/);
   768→    if (!match) {
   769→      error(
   770→        'Invalid duration format. Use format like: 30d (days), 12h (hours), 45m (minutes)',
   771→      );
   772→      process.exit(EXIT_CODES.USAGE_ERROR);
   773→    }
   774→
   775→    const [, amount, unit] = match;
   776→    const amountNum = parseInt(amount);
   777→    const milliseconds = {
   778→      m: amountNum * 60 * 1000,
   779→      h: amountNum * 60 * 60 * 1000,
   780→      d: amountNum * 24 * 60 * 60 * 1000,
   781→    }[unit];
   782→
   783→    if (milliseconds === undefined) {
   784→      error('Invalid duration unit. Use d (days), h (hours), or m (minutes)');
   785→      process.exit(EXIT_CODES.USAGE_ERROR);
   786→    }
   787→
   788→    const cutoffTime = Date.now() - milliseconds;
   789→    toPrune = runs.filter((r) => {
   790→      const runTime = new Date(r.started_at).getTime();
   791→      return runTime < cutoffTime;
   792→    });
   793→  }
   794→
   795→  // AC: @workflow-prune ac-2 - Filter by status
   796→  if (options.status) {
   797→    const validStatuses = ['active', 'paused', 'completed', 'aborted'];
   798→    if (!validStatuses.includes(options.status)) {
   799→      error(
   800→        `Invalid status: ${options.status}. Must be one of: ${validStatuses.join(', ')}`,
   801→      );
   802→      process.exit(EXIT_CODES.USAGE_ERROR);
   803→    }
   804→
   805→    if (toPrune.length > 0) {
   806→      // Filter existing toPrune list
   807→      toPrune = toPrune.filter((r) => r.status === options.status);
   808→    } else {
   809→      // No age filter, just status
   810→      toPrune = runs.filter((r) => r.status === options.status);
   811→    }
   812→  }
   813→
   814→  // AC: @workflow-prune ac-3 - Filter by abandoned (active with no activity for 7+ days)
   815→  if (options.abandoned) {
   816→    const abandonedCutoff = Date.now() - 7 * 24 * 60 * 60 * 1000; // 7 days
   817→    const abandonedRuns = runs.filter((r) => {
   818→      if (r.status !== 'active') return false;
   819→
   820→      // Find most recent activity time
   821→      let lastActivity = new Date(r.started_at).getTime();
   822→      if (r.step_results.length > 0) {
   823→        const lastStep = r.step_results[r.step_results.length - 1];
   824→        lastActivity = new Date(lastStep.completed_at).getTime();
   825→      }
   826→
   827→      return lastActivity < abandonedCutoff;
   828→    });
   829→
   830→    if (toPrune.length > 0) {
   831→      // Intersect with existing toPrune list
   832→      const abandonedUlids = new Set(abandonedRuns.map((r) => r._ulid));
   833→      toPrune = toPrune.filter((r) => abandonedUlids.has(r._ulid));
   834→    } else {
   835→      toPrune = abandonedRuns;
   836→    }
   837→  }
   838→
   839→  // If no filters provided, error
   840→  if (!options.olderThan && !options.status && !options.abandoned) {
   841→    error(
   842→      'Must specify at least one filter: --older-than, --status, or --abandoned',
   843→    );
   844→    process.exit(EXIT_CODES.USAGE_ERROR);
   845→  }
   846→
   847→  // AC: @workflow-prune ac-4 - Dry run mode
   848→  if (options.dryRun || isJsonMode()) {
   849→    const output_data = {
   850→      would_delete: toPrune.length,
   851→      runs: toPrune.map((r) => ({
   852→        _ulid: r._ulid,
   853→        workflow_ref: r.workflow_ref,
   854→        status: r.status,
   855→        started_at: r.started_at,
   856→      })),
   857→    };
   858→
   859→    if (isJsonMode()) {
   860→      output(output_data);
   861→    } else {
   862→      console.log(
   863→        chalk.yellow(
   864→          `Would delete ${toPrune.length} workflow run${toPrune.length === 1 ? '' : 's'}:`,
   865→        ),
   866→      );
   867→      if (toPrune.length > 0) {
   868→        const table = new Table({
   869→          head: ['ID', 'Workflow', 'Status', 'Started'],
   870→          colWidths: [12, 25, 12, 20],
   871→        });
   872→
   873→        const metaCtx = await loadMetaContext(ctx);
   874→        for (const run of toPrune) {
   875→          const workflow = metaCtx.workflows.find(
   876→            (w) => `@${w._ulid}` === run.workflow_ref,
   877→          );
   878→          const workflowName = workflow?.id || run.workflow_ref;
   879→          const started = new Date(run.started_at).toLocaleString();
   880→
   881→          table.push([
   882→            shortUlid(run._ulid),
   883→            workflowName,
   884→            formatStatus(run.status),
   885→            started,
   886→          ]);
   887→        }
   888→
   889→        console.log(table.toString());
   890→        console.log(
   891→          chalk.gray('\nRun without --dry-run to actually delete these runs'),
   892→        );
   893→      }
   894→    }
   895→    return;
   896→  }
   897→
   898→  // Actually delete
   899→  if (toPrune.length === 0) {
   900→    if (!isJsonMode()) {
   901→      console.log(chalk.gray('No runs match the specified criteria'));
   902→    } else {
   903→      output({ deleted: 0 });
   904→    }
   905→    return;
   906→  }
   907→
   908→  const ulidsToDelete = toPrune.map((r) => r._ulid);
   909→  await deleteWorkflowRuns(ctx, ulidsToDelete);
   910→  await commitIfShadow(ctx.shadow, 'workflow-prune');
   911→
   912→  if (isJsonMode()) {
   913→    output({ deleted: toPrune.length });
   914→  } else {
   915→    success(
   916→      `Deleted ${toPrune.length} workflow run${toPrune.length === 1 ? '' : 's'}`,
   917→    );
   918→  }
   919→}
   920→
   921→/**
   922→ * Register workflow commands
   923→ */
   924→export function registerWorkflowCommand(program: Command): void {
   925→  const workflow = program
   926→    .command("workflow")
   927→    .description("Manage workflow runs");
   928→
   929→  markMutating(workflow.command("start"))
   930→    .description("Start a new workflow run")
   931→    .argument("<workflow-ref>", "Workflow reference (@id or @ulid)")
   932→    .option("--task <task-ref>", "Link run to a task")
   933→    .option("--json", "Output JSON")
   934→    .action(workflowStart);
   935→
   936→  workflow
   937→    .command("runs")
   938→    .description("List workflow runs")
   939→    .option("--active", "Show only active runs")
   940→    .option("--completed", "Show only completed runs")
   941→    .option("--workflow <ref>", "Filter by workflow")
   942→    .option("--json", "Output JSON")
   943→    .action(workflowRuns);
   944→
   945→  workflow
   946→    .command("show")
   947→    .description("Show workflow run details")
   948→    .argument("<run-ref>", "Run reference (@ulid or ulid prefix)")
   949→    .option("--json", "Output JSON")
   950→    .action(workflowShow);
   951→
   952→  markMutating(workflow.command("abort"))
   953→    .description("Abort an active workflow run")
   954→    .argument("<run-ref>", "Run reference (@ulid or ulid prefix)")
   955→    .option("--reason <text>", "Reason for aborting")
   956→    .option("--json", "Output JSON")
   957→    .action(workflowAbort);
   958→
   959→  markMutating(workflow.command("next"))
   960→    .description("Advance workflow run to next step")
   961→    .argument("[run-ref]", "Run reference (optional if only one active run)")
   962→    .option("--skip", "Mark current step as skipped")
   963→    .option("--notes <text>", "Notes for the completed step")
   964→    .option(
   965→      "--confirm",
   966→      "Acknowledge entry/exit criteria (required in strict mode)",
   967→    )
   968→    .option("--force", "Allow --skip in strict mode")
   969→    .option(
   970→      "--input <key=value>",
   971→      "Provide step input (repeatable)",
   972→      (value, previous: string[] = []) => [...previous, value],
   973→    )
   974→    .option("--json", "Output JSON")
   975→    .action(workflowNext);
   976→
   977→  markMutating(workflow.command("pause"))
   978→    .description("Pause an active workflow run")
   979→    .argument("<run-ref>", "Run reference (@ulid or ulid prefix)")
   980→    .option("--json", "Output JSON")
   981→    .action(workflowPause);
   982→
   983→  markMutating(workflow.command("resume"))
   984→    .description("Resume a paused workflow run")
   985→    .argument("<run-ref>", "Run reference (@ulid or ulid prefix)")
   986→    .option("--json", "Output JSON")
   987→    .action(workflowResume);
   988→
   989→  markMutating(workflow.command("prune"))
   990→    .description("Remove old or stale workflow runs")
   991→    .option(
   992→      "--older-than <duration>",
   993→      "Delete runs older than specified duration (e.g., 30d, 12h, 45m)",
   994→    )
   995→    .option(
   996→      "--status <status>",
   997→      "Delete runs with specific status (active, paused, completed, aborted)",
   998→    )
   999→    .option(
  1000→      "--abandoned",
  1001→      "Delete active runs with no activity for 7+ days",
  1002→    )
  1003→    .option("--dry-run", "Show what would be deleted without deleting")
  1004→    .option("--json", "Output JSON")
  1005→    .action(workflowPrune);
  1006→}
  1007→

