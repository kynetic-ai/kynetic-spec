```
     1→/**
     2→ * Ralph Event System
     3→ *
     4→ * Translates ACP SessionUpdate events into structured RalphEvents.
     5→ * This layer is pure data - no rendering concerns. Enables future
     6→ * TUI or other renderers to consume the same event stream.
     7→ */
     8→
     9→import type { SessionUpdate } from "../acp/types.js";
    10→
    11→// ============================================================================
    12→// Event Types
    13→// ============================================================================
    14→
    15→export type RalphEventType =
    16→  | "agent_message"
    17→  | "agent_thought"
    18→  | "tool_start"
    19→  | "tool_update"
    20→  | "tool_result"
    21→  | "status";
    22→
    23→export interface RalphEvent {
    24→  type: RalphEventType;
    25→  timestamp: number; // ms since session start
    26→  data: RalphEventData;
    27→}
    28→
    29→export type RalphEventData =
    30→  | AgentMessageData
    31→  | AgentThoughtData
    32→  | ToolStartData
    33→  | ToolUpdateData
    34→  | ToolResultData
    35→  | StatusData;
    36→
    37→export interface AgentMessageData {
    38→  kind: "agent_message";
    39→  content: string;
    40→  isStreaming: boolean;
    41→}
    42→
    43→export interface AgentThoughtData {
    44→  kind: "agent_thought";
    45→  content: string;
    46→  isStreaming: boolean;
    47→}
    48→
    49→export interface ToolStartData {
    50→  kind: "tool_start";
    51→  toolCallId: string;
    52→  tool: string;
    53→  summary: string;
    54→  input: unknown;
    55→}
    56→
    57→export interface ToolUpdateData {
    58→  kind: "tool_update";
    59→  toolCallId: string;
    60→  tool: string;
    61→  status: "pending" | "running";
    62→  summary?: string; // Present when input becomes available in phased events
    63→}
    64→
    65→export interface ToolResultData {
    66→  kind: "tool_result";
    67→  toolCallId: string;
    68→  tool: string;
    69→  status: "completed" | "failed" | "cancelled";
    70→  output?: string;
    71→  truncated: boolean;
    72→}
    73→
    74→export interface StatusData {
    75→  kind: "status";
    76→  status: string;
    77→  message?: string;
    78→}
    79→
    80→// ============================================================================
    81→// Translator Interface
    82→// ============================================================================
    83→
    84→export interface RalphTranslator {
    85→  /**
    86→   * Translate an ACP SessionUpdate to a RalphEvent.
    87→   * Returns null if the update should be suppressed.
    88→   */
    89→  translate(update: SessionUpdate): RalphEvent | null;
    90→
    91→  /**
    92→   * Signal end of stream. Returns final event if there's pending state.
    93→   */
    94→  finalize(): RalphEvent | null;
    95→}
    96→
    97→// ============================================================================
    98→// Tool Summary Extraction
    99→// ============================================================================
   100→
   101→/**
   102→ * Extract a human-readable summary for a tool call.
   103→ * Based on kynetic ui-event-translator.ts patterns.
   104→ */
   105→function getToolSummary(tool: string, input: unknown): string {
   106→  const inp = input as Record<string, unknown>;
   107→
   108→  switch (tool) {
   109→    case "Bash": {
   110→      const cmd = inp.command as string | undefined;
   111→      if (cmd) {
   112→        return cmd.length > 50 ? `${cmd.slice(0, 47)}...` : cmd;
   113→      }
   114→      return "";
   115→    }
   116→
   117→    case "Read":
   118→    case "Write":
   119→    case "Edit": {
   120→      const filePath = inp.file_path as string | undefined;
   121→      if (filePath) {
   122→        // Extract filename from path
   123→        const parts = filePath.split("/");
   124→        return parts[parts.length - 1] || filePath;
   125→      }
   126→      return "";
   127→    }
   128→
   129→    case "Grep": {
   130→      const pattern = inp.pattern as string | undefined;
   131→      return pattern ? `/${pattern}/` : "";
   132→    }
   133→
   134→    case "Glob": {
   135→      const pattern = inp.pattern as string | undefined;
   136→      return pattern || "";
   137→    }
   138→
   139→    case "WebSearch": {
   140→      const query = inp.query as string | undefined;
   141→      return query || "";
   142→    }
   143→
   144→    case "Task": {
   145→      const desc = inp.description as string | undefined;
   146→      return desc || "";
   147→    }
   148→
   149→    case "TodoWrite": {
   150→      const todos = inp.todos as Array<{ content: string }> | undefined;
   151→      if (todos && todos.length > 0) {
   152→        return `${todos.length} item(s)`;
   153→      }
   154→      return "";
   155→    }
   156→
   157→    default:
   158→      return "";
   159→  }
   160→}
   161→
   162→/**
   163→ * Extract tool name from SessionUpdate.
   164→ * Handles Claude Code's _meta.claudeCode.toolName pattern and MCP prefixes.
   165→ */
   166→function extractToolName(update: Record<string, unknown>): string {
   167→  // Try _meta.claudeCode.toolName first (Claude Code pattern)
   168→  const meta = update._meta as Record<string, unknown> | undefined;
   169→  if (meta) {
   170→    const claudeCode = meta.claudeCode as Record<string, unknown> | undefined;
   171→    if (claudeCode?.toolName) {
   172→      return normalizeTool(claudeCode.toolName as string);
   173→    }
   174→    if (meta.toolName) {
   175→      return normalizeTool(meta.toolName as string);
   176→    }
   177→  }
   178→
   179→  // Fall back to name field
   180→  if (update.name) {
   181→    return normalizeTool(update.name as string);
   182→  }
   183→
   184→  // Fall back to title
   185→  if (update.title) {
   186→    return normalizeTool(update.title as string);
   187→  }
   188→
   189→  return "unknown";
   190→}
   191→
   192→/**
   193→ * Normalize tool name by stripping MCP prefixes.
   194→ */
   195→function normalizeTool(name: string): string {
   196→  // Strip mcp__<namespace>__ prefix
   197→  const mcpMatch = name.match(/^mcp__[^_]+__(.+)$/);
   198→  if (mcpMatch) {
   199→    return mcpMatch[1];
   200→  }
   201→  return name;
   202→}
   203→
   204→/**
   205→ * Extract tool output, handling Claude Code's non-standard delivery.
   206→ */
   207→function extractToolOutput(
   208→  update: Record<string, unknown>,
   209→): string | undefined {
   210→  // Try rawOutput first
   211→  if (update.rawOutput !== undefined) {
   212→    return truncateOutput(stringify(update.rawOutput));
   213→  }
   214→
   215→  // Try _meta.claudeCode.toolResponse (Claude Code pattern)
   216→  // toolResponse is an object with stdout/stderr, not a string
   217→  const meta = update._meta as Record<string, unknown> | undefined;
   218→  if (meta) {
   219→    const claudeCode = meta.claudeCode as Record<string, unknown> | undefined;
   220→    if (claudeCode?.toolResponse !== undefined) {
   221→      const toolResponse = claudeCode.toolResponse as Record<string, unknown>;
   222→      // Extract stdout, falling back to stringifying the whole response
   223→      if (typeof toolResponse.stdout === "string") {
   224→        const combined =
   225→          toolResponse.stdout +
   226→          (toolResponse.stderr ? `\n${toolResponse.stderr}` : "");
   227→        return truncateOutput(combined.trim());
   228→      }
   229→      return truncateOutput(stringify(toolResponse));
   230→    }
   231→  }
   232→
   233→  // Try output field
   234→  if (update.output !== undefined) {
   235→    return truncateOutput(stringify(update.output));
   236→  }
   237→
   238→  return undefined;
   239→}
   240→
   241→/**
   242→ * Extract original (non-truncated) output for truncation detection.
   243→ */
   244→function extractOriginalOutput(
   245→  update: Record<string, unknown>,
   246→): string | undefined {
   247→  if (update.rawOutput !== undefined) {
   248→    return stringify(update.rawOutput);
   249→  }
   250→
   251→  const meta = update._meta as Record<string, unknown> | undefined;
   252→  if (meta) {
   253→    const claudeCode = meta.claudeCode as Record<string, unknown> | undefined;
   254→    if (claudeCode?.toolResponse !== undefined) {
   255→      const toolResponse = claudeCode.toolResponse as Record<string, unknown>;
   256→      if (typeof toolResponse.stdout === "string") {
   257→        return (
   258→          toolResponse.stdout +
   259→          (toolResponse.stderr ? `\n${toolResponse.stderr}` : "")
   260→        ).trim();
   261→      }
   262→    }
   263→  }
   264→
   265→  if (update.output !== undefined) {
   266→    return stringify(update.output);
   267→  }
   268→
   269→  return undefined;
   270→}
   271→
   272→/**
   273→ * Safely stringify a value that may be a string, array of content blocks, or object.
   274→ * Handles ACP tool results delivered as arrays like [{type:'text',text:'...'},...]
   275→ */
   276→function stringify(value: unknown): string {
   277→  if (typeof value === "string") return value;
   278→  if (Array.isArray(value)) {
   279→    // Array of content blocks: extract .text fields
   280→    const texts = value
   281→      .map((item) =>
   282→        typeof item === "string"
   283→          ? item
   284→          : typeof item === "object" && item !== null && "text" in item
   285→            ? String((item as { text: unknown }).text)
   286→            : JSON.stringify(item),
   287→      )
   288→      .filter(Boolean);
   289→    return texts.join("\n");
   290→  }
   291→  if (typeof value === "object" && value !== null) {
   292→    return JSON.stringify(value);
   293→  }
   294→  return String(value);
   295→}
   296→
   297→/**
   298→ * Truncate output to reasonable size.
   299→ */
   300→function truncateOutput(output: string): string {
   301→  const MAX_LINES = 20;
   302→  const MAX_CHARS = 1000;
   303→
   304→  const lines = output.split("\n");
   305→  if (lines.length > MAX_LINES) {
   306→    return lines.slice(0, MAX_LINES).join("\n");
   307→  }
   308→  if (output.length > MAX_CHARS) {
   309→    return output.slice(0, MAX_CHARS);
   310→  }
   311→  return output;
   312→}
   313→
   314→/**
   315→ * Check if output was truncated.
   316→ */
   317→function wasOutputTruncated(
   318→  original: string | undefined,
   319→  truncated: string | undefined,
   320→): boolean {
   321→  if (!original || !truncated) return false;
   322→  return original.length > truncated.length;
   323→}
   324→
   325→// ============================================================================
   326→// Noise Suppression
   327→// ============================================================================
   328→
   329→/**
   330→ * Noise patterns to strip from streaming content.
   331→ * These match Claude Code hook warning messages that leak into agent output.
   332→ * Pattern structure handles various noise forms:
   333→ * - "No on[Pre|Post]ToolUseHook found"
   334→ * - "No on[Pre|Post]ToolUseHook found for tool use"
   335→ * - "No on[Pre|Post]ToolUseHook found for tool use ID: toolu_<24 chars>"
   336→ * Tool IDs are exactly 24 base62 characters after "toolu_".
   337→ */
   338→const NOISE_PATTERNS = [
   339→  /No onPostToolUseHook found(?:\s+for\s+tool\s+use(?:\s+ID:\s*toolu_[A-Za-z0-9]{24})?)?/gi,
   340→  /No onPreToolUseHook found(?:\s+for\s+tool\s+use(?:\s+ID:\s*toolu_[A-Za-z0-9]{24})?)?/gi,
   341→];
   342→
   343→/**
   344→ * Strip noise patterns from content.
   345→ * Returns the cleaned content, or null if nothing remains after stripping.
   346→ * Preserves whitespace-only chunks that aren't noise to maintain streaming formatting.
   347→ */
   348→function stripNoise(content: string): string | null {
   349→  let cleaned = content;
   350→  for (const pattern of NOISE_PATTERNS) {
   351→    cleaned = cleaned.replace(pattern, "");
   352→  }
   353→
   354→  // If nothing was stripped, return original (preserves pure whitespace chunks)
   355→  if (cleaned === content) {
   356→    return content;
   357→  }
   358→
   359→  // Something was stripped - return cleaned if non-empty, null otherwise
   360→  return cleaned.length > 0 ? cleaned : null;
   361→}
   362→
   363→// ============================================================================
   364→// Translator Implementation
   365→// ============================================================================
   366→
   367→interface TranslatorState {
   368→  sessionStart: number;
   369→  activeMessage: {
   370→    type: "agent_message" | "agent_thought";
   371→    content: string;
   372→  } | null;
   373→  pendingTools: Map<
   374→    string,
   375→    { tool: string; input: unknown; startTime: number }
   376→  >;
   377→}
   378→
   379→export function createTranslator(): RalphTranslator {
   380→  const state: TranslatorState = {
   381→    sessionStart: Date.now(),
   382→    activeMessage: null,
   383→    pendingTools: new Map(),
   384→  };
   385→
   386→  function getTimestamp(): number {
   387→    return Date.now() - state.sessionStart;
   388→  }
   389→
   390→  function translate(update: SessionUpdate): RalphEvent | null {
   391→    const updateType = update.sessionUpdate;
   392→    const timestamp = getTimestamp();
   393→
   394→    switch (updateType) {
   395→      // ─── Content Chunks ─────────────────────────────────────────────────────
   396→      case "agent_message_chunk": {
   397→        const content = (
   398→          update as { content?: { type: string; text?: string } }
   399→        ).content;
   400→        if (content?.type === "text" && typeof content.text === "string") {
   401→          // Empty string signals finalization
   402→          if (content.text === "") {
   403→            if (state.activeMessage?.type === "agent_message") {
   404→              // Strip noise from accumulated content to handle split-chunk noise
   405→              const finalContent = stripNoise(state.activeMessage.content);
   406→              state.activeMessage = null;
   407→              if (finalContent === null) {
   408→                return null;
   409→              }
   410→              return {
   411→                type: "agent_message",
   412→                timestamp,
   413→                data: {
   414→                  kind: "agent_message",
   415→                  content: finalContent,
   416→                  isStreaming: false,
   417→                },
   418→              };
   419→            }
   420→            return null;
   421→          }
   422→
   423→          // Strip noise patterns from content
   424→          const cleanedText = stripNoise(content.text);
   425→          if (cleanedText === null) {
   426→            return null;
   427→          }
   428→
   429→          // Accumulate content
   430→          if (state.activeMessage?.type === "agent_message") {
   431→            state.activeMessage.content += cleanedText;
   432→          } else {
   433→            state.activeMessage = {
   434→              type: "agent_message",
   435→              content: cleanedText,
   436→            };
   437→          }
   438→
   439→          return {
   440→            type: "agent_message",
   441→            timestamp,
   442→            data: {
   443→              kind: "agent_message",
   444→              content: cleanedText,
   445→              isStreaming: true,
   446→            },
   447→          };
   448→        }
   449→        return null;
   450→      }
   451→
   452→      case "agent_thought_chunk": {
   453→        const content = (
   454→          update as { content?: { type: string; text?: string } }
   455→        ).content;
   456→        if (content?.type === "text" && typeof content.text === "string") {
   457→          if (content.text === "") {
   458→            if (state.activeMessage?.type === "agent_thought") {
   459→              // Strip noise from accumulated content to handle split-chunk noise
   460→              const finalContent = stripNoise(state.activeMessage.content);
   461→              state.activeMessage = null;
   462→              if (finalContent === null) {
   463→                return null;
   464→              }
   465→              return {
   466→                type: "agent_thought",
   467→                timestamp,
   468→                data: {
   469→                  kind: "agent_thought",
   470→                  content: finalContent,
   471→                  isStreaming: false,
   472→                },
   473→              };
   474→            }
   475→            return null;
   476→          }
   477→
   478→          // Strip noise patterns from content
   479→          const cleanedText = stripNoise(content.text);
   480→          if (cleanedText === null) {
   481→            return null;
   482→          }
   483→
   484→          if (state.activeMessage?.type === "agent_thought") {
   485→            state.activeMessage.content += cleanedText;
   486→          } else {
   487→            state.activeMessage = {
   488→              type: "agent_thought",
   489→              content: cleanedText,
   490→            };
   491→          }
   492→
   493→          return {
   494→            type: "agent_thought",
   495→            timestamp,
   496→            data: {
   497→              kind: "agent_thought",
   498→              content: cleanedText,
   499→              isStreaming: true,
   500→            },
   501→          };
   502→        }
   503→        return null;
   504→      }
   505→
   506→      case "user_message_chunk": {
   507→        // User messages are typically the prompt we sent, skip display
   508→        return null;
   509→      }
   510→
   511→      // ─── Tool Events ────────────────────────────────────────────────────────
   512→      case "tool_call": {
   513→        const u = update as Record<string, unknown>;
   514→        const toolCallId = (u.tool_call_id || u.toolCallId || u.id) as string;
   515→        const tool = extractToolName(u);
   516→        const input = u.rawInput || u.input || u.params || {};
   517→        const summary = getToolSummary(tool, input);
   518→
   519→        // Check if this is an update to an existing tool call (phased events)
   520→        const existing = state.pendingTools.get(toolCallId);
   521→        if (existing) {
   522→          // Update existing entry with new input if present
   523→          const hadSummary = getToolSummary(existing.tool, existing.input);
   524→          existing.input = input;
   525→          existing.tool = tool;
   526→
   527→          // Only emit update if we now have a summary we didn't have before
   528→          if (summary && !hadSummary) {
   529→            return {
   530→              type: "tool_update",
   531→              timestamp,
   532→              data: {
   533→                kind: "tool_update",
   534→                toolCallId,
   535→                tool,
   536→                status: "pending" as const,
   537→                summary,
   538→              },
   539→            };
   540→          }
   541→          // No meaningful change, suppress event
   542→          return null;
   543→        }
   544→
   545→        // First time seeing this tool_call_id - create entry and emit tool_start
   546→        state.pendingTools.set(toolCallId, {
   547→          tool,
   548→          input,
   549→          startTime: timestamp,
   550→        });
   551→
   552→        return {
   553→          type: "tool_start",
   554→          timestamp,
   555→          data: {
   556→            kind: "tool_start",
   557→            toolCallId,
   558→            tool,
   559→            summary,
   560→            input,
   561→          },
   562→        };
   563→      }
   564→
   565→      case "tool_call_update": {
   566→        const u = update as Record<string, unknown>;
   567→        const toolCallId = (u.tool_call_id || u.toolCallId || u.id) as string;
   568→        const status = u.status as string | undefined;
   569→        const pending = state.pendingTools.get(toolCallId);
   570→        const tool = pending?.tool || extractToolName(u);
   571→
   572→        // Non-terminal status update
   573→        if (
   574→          status === "pending" ||
   575→          status === "in_progress" ||
   576→          status === "running"
   577→        ) {
   578→          return {
   579→            type: "tool_update",
   580→            timestamp,
   581→            data: {
   582→              kind: "tool_update",
   583→              toolCallId,
   584→              tool,
   585→              status:
   586→                status === "in_progress"
   587→                  ? "running"
   588→                  : (status as "pending" | "running"),
   589→            },
   590→          };
   591→        }
   592→
   593→        // Terminal status - treat as result
   594→        if (
   595→          status === "completed" ||
   596→          status === "failed" ||
   597→          status === "cancelled"
   598→        ) {
   599→          const rawOutput = extractToolOutput(u);
   600→          const originalOutput = extractOriginalOutput(u);
   601→          state.pendingTools.delete(toolCallId);
   602→
   603→          return {
   604→            type: "tool_result",
   605→            timestamp,
   606→            data: {
   607→              kind: "tool_result",
   608→              toolCallId,
   609→              tool,
   610→              status,
   611→              output: rawOutput,
   612→              truncated: wasOutputTruncated(originalOutput, rawOutput),
   613→            },
   614→          };
   615→        }
   616→
   617→        return null;
   618→      }
   619→
   620→      // Note: 'status' is not a SessionUpdate type in the ACP spec.
   621→      // Status changes come through other mechanisms (e.g., prompt completion).
   622→
   623→      default:
   624→        // Unknown update type - ignore
   625→        return null;
   626→    }
   627→  }
   628→
   629→  function finalize(): RalphEvent | null {
   630→    if (state.activeMessage) {
   631→      // Strip noise from accumulated content to handle split-chunk noise
   632→      const finalContent = stripNoise(state.activeMessage.content);
   633→      const type = state.activeMessage.type;
   634→      state.activeMessage = null;
   635→      if (finalContent === null) {
   636→        return null;
   637→      }
   638→      return {
   639→        type,
   640→        timestamp: getTimestamp(),
   641→        data: {
   642→          kind: type,
   643→          content: finalContent,
   644→          isStreaming: false,
   645→        } as AgentMessageData | AgentThoughtData,
   646→      };
   647→    }
   648→    return null;
   649→  }
   650→
   651→  return { translate, finalize };
   652→}
   653→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
```