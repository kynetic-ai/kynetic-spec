   374→// ─── Streaming Output ────────────────────────────────────────────────────────
   375→
   376→// Translator and renderer are created per-session in the action handler.
   377→// This allows the architecture to be reused by future TUI renderers.
   378→
   379→// ─── Adapter Validation ──────────────────────────────────────────────────────
   380→
   381→// AC: @ralph-adapter-validation valid-adapter-proceeds, invalid-adapter-error, validation-before-spawn
   382→/**
   383→ * Validate that the specified ACP adapter package exists.
   384→ * Uses npx --no-install to check both global and local node_modules.
   385→ *
   386→ * @throws {Error} Never throws - exits process with code 3 if validation fails
   387→ */
   388→function validateAdapter(adapterPackage: string): void {
   389→  // Use npx --no-install with --version to check if package exists
   390→  // This checks both global and local node_modules, handles scoped packages
   391→  const result = spawnSync(
   392→    "npx",
   393→    ["--no-install", adapterPackage, "--version"],
   394→    {
   395→      encoding: "utf-8",
   396→      stdio: "pipe",
   397→    },
   398→  );
   399→
   400→  if (result.status !== 0) {
   401→    error(
   402→      `Adapter package not found: ${adapterPackage}. Install with: npm install -g ${adapterPackage}`,
   403→    );
   404→    process.exit(EXIT_CODES.NOT_FOUND);
   405→  }
   406→}
   407→
   408→// ─── Tool Request Handler ────────────────────────────────────────────────────
   409→
   410→/**
   411→ * Handle tool requests from ACP agent.
   412→ * Implements file operations, terminal commands, and permission handling.
   413→ */
   414→async function handleRequest(
   415→  client: ACPClient,
   416→  id: string | number,
   417→  method: string,
   418→  params: unknown,
   419→  yolo: boolean,
   420→): Promise<void> {
   421→  try {
   422→    switch (method) {
   423→      case "session/request_permission": {
   424→        const p = params as RequestPermissionRequest;
   425→        // In yolo mode, auto-approve all permissions
   426→        // In normal mode, would need to implement permission UI
   427→        const options = p.options || [];
   428→
   429→        if (yolo) {
   430→          // Find an "allow" option (prefer allow_always, then allow_once)
   431→          const allowOption =
   432→            options.find((o) => o.kind === "allow_always") ||
   433→            options.find((o) => o.kind === "allow_once");
   434→
   435→          if (allowOption) {
   436→            client.respondPermission(id, {
   437→              outcome: { outcome: "selected", optionId: allowOption.optionId },
   438→            });
   439→          } else {
   440→            // No allow option available - cancel
   441→            client.respondPermission(id, { outcome: { outcome: "cancelled" } });
   442→          }
   443→        } else {
   444→          // TODO: Implement permission prompting
   445→          client.respondPermission(id, { outcome: { outcome: "cancelled" } });
   446→        }
   447→        break;
   448→      }
   449→
   450→      case "file/read": {
   451→        const p = params as ReadTextFileRequest;
   452→        const content = await fs.readFile(p.path, "utf-8");
   453→        client.respondReadTextFile(id, { content });
   454→        break;
   455→      }
   456→
   457→      case "file/write": {
   458→        const p = params as WriteTextFileRequest;
   459→        await fs.mkdir(path.dirname(p.path), { recursive: true });
   460→        await fs.writeFile(p.path, p.content, "utf-8");
   461→        client.respondWriteTextFile(id, {});
   462→        break;
   463→      }
   464→
   465→      case "terminal/run": {
   466→        // Custom method (not part of ACP spec - ACP uses createTerminal instead)
   467→        // TODO: Consider migrating to standard ACP terminal methods
   468→        const p = params as {
   469→          command: string;
   470→          cwd?: string;
   471→          timeout?: number;
   472→        };
   473→        const command = p.command;
   474→        const cwd = p.cwd || process.cwd();
   475→        const timeout = p.timeout || 60000;
   476→
   477→        const result = await new Promise<{
   478→          stdout: string;
   479→          stderr: string;
   480→          exitCode: number;
   481→        }>((resolve) => {
   482→          const child = spawn(command, [], {
   483→            cwd,
   484→            shell: true,
   485→            timeout,
   486→          });
   487→
   488→          let stdout = "";
   489→          let stderr = "";
   490→
   491→          child.stdout?.on("data", (data) => {
   492→            stdout += data.toString();
   493→          });
   494→
   495→          child.stderr?.on("data", (data) => {
   496→            stderr += data.toString();
   497→          });
   498→
   499→          child.on("close", (code) => {
   500→            resolve({ stdout, stderr, exitCode: code ?? 1 });
   501→          });
   502→
   503→          child.on("error", (err) => {
   504→            resolve({ stdout, stderr: err.message, exitCode: 1 });
   505→          });
   506→        });
   507→
   508→        // Using generic respond() since this is a custom method
   509→        client.respond(id, result);
   510→        break;
   511→      }
   512→
   513→      default:
   514→        // Unknown method - return error
   515→        client.respondError(id, -32601, `Method not found: ${method}`);
   516→    }
   517→  } catch (err) {
   518→    const message = err instanceof Error ? err.message : String(err);
   519→    client.respondError(id, -32000, message);
   520→  }
   521→}
   522→
   523→// ─── Subagent Support ─────────────────────────────────────────────────────────
   524→
   525→/**
   526→ * Build context for a PR review subagent.
   527→ * AC: @ralph-subagent-spawning ac-10
   528→ */
   529→async function buildSubagentContext(
   530→  ctx: KspecContext,
   531→  taskRef: string,
   532→): Promise<SubagentContext> {
   533→  // Load all tasks and items
   534→  const tasks = await loadAllTasks(ctx);
   535→  const items = await loadAllItems(ctx);
   536→  const index = new ReferenceIndex(tasks, items);
   537→
   538→  // Resolve task reference
   539→  const taskResult = index.resolve(taskRef);
   540→  if (!taskResult.ok) {
   541→    throw new Error(`Task not found: ${taskRef}`);
   542→  }
   543→
   544→  const task = tasks.find((t) => t._ulid === taskResult.ulid);
   545→  if (!task) {
   546→    throw new Error(`Task not found by ULID: ${taskResult.ulid}`);
   547→  }
   548→
   549→  // Get linked spec with ACs if spec_ref exists
   550→  let specWithACs: Record<string, unknown> | null = null;
   551→  if (task.spec_ref) {
   552→    const specResult = index.resolve(task.spec_ref);
   553→    if (specResult.ok) {
   554→      const item = items.find((i) => i._ulid === specResult.ulid);
   555→      if (item) {
   556→        specWithACs = item as unknown as Record<string, unknown>;
   557→      }
   558→    }
   559→  }
   560→
   561→  // Get git branch
   562→  const gitBranch = getCurrentBranch(ctx.rootDir) || "unknown";
   563→
   564→  return {
   565→    taskRef,
   566→    taskDetails: task as unknown as Record<string, unknown>,
   567→    specWithACs,
   568→    gitBranch,
   569→  };
   570→}
   571→
   572→/**
   573→ * Check if a task was completed by the subagent.
   574→ * AC: @ralph-subagent-spawning ac-12
   575→ */
   576→async function verifyTaskCompleted(taskRef: string): Promise<boolean> {
   577→  const result = spawnSync("kspec", ["task", "get", taskRef, "--json"], {
   578→    encoding: "utf-8",
   579→    stdio: "pipe",
   580→  });
   581→
   582→  if (result.status !== 0) {
   583→    warn(`Failed to check task status for ${taskRef}: ${result.stderr}`);
   584→    return false;
   585→  }
   586→
   587→  try {
   588→    const task = JSON.parse(result.stdout);
   589→    return task.status === "completed";
   590→  } catch {
   591→    warn(`Failed to parse task status for ${taskRef}`);
   592→    return false;
   593→  }
   594→}
   595→
   596→/**
   597→ * Mark a task as needing review due to subagent timeout.
   598→ * AC: @ralph-subagent-spawning ac-9
   599→ */
   600→async function markTaskNeedsReview(
   601→  taskRef: string,
   602→  reason: string,
   603→): Promise<void> {
   604→  const { spawnSync } = await import("node:child_process");
   605→
   606→  // Use kspec CLI to set automation status
   607→  const result = spawnSync(
   608→    "kspec",
   609→    ["task", "set-automation", taskRef, "needs_review"],
   610→    {
   611→      encoding: "utf-8",
   612→      stdio: "pipe",
   613→    },
   614→  );
   615→
   616→  if (result.status !== 0) {
   617→    warn(`Failed to mark task ${taskRef} as needs_review: ${result.stderr}`);
   618→  }
   619→
   620→  // Add a note explaining the timeout
   621→  const noteResult = spawnSync(
   622→    "kspec",
   623→    ["task", "note", taskRef, `[RALPH SUBAGENT] ${reason}`],
   624→    {
   625→      encoding: "utf-8",
   626→      stdio: "pipe",
   627→    },
   628→  );
   629→
   630→  if (noteResult.status !== 0) {
   631→    warn(`Failed to add timeout note to task ${taskRef}: ${noteResult.stderr}`);
   632→  }
   633→}
   634→
   635→/**
   636→ * Handle failed iteration by tracking per-task failures and escalating at threshold.
   637→ * AC: @loop-mode-error-handling ac-1, ac-2, ac-3, ac-4, ac-5, ac-8
   638→ */
   639→async function handleIterationFailure(
   640→  ctx: KspecContext,
   641→  tasksInProgressAtStart: ActiveTaskSummary[],
   642→  iterationStartTime: Date,
   643→  errorDescription: string,
   644→): Promise<void> {
   645→  if (tasksInProgressAtStart.length === 0) {
   646→    return;
   647→  }
   648→
   649→  // Re-load current tasks to check progress
   650→  const currentTasks = await loadAllTasks(ctx);
   651→  const index = new ReferenceIndex(currentTasks, await loadAllItems(ctx));
   652→
   653→  // Convert ActiveTaskSummary to Task-like objects for processing
   654→  const tasksInProgressFull = tasksInProgressAtStart
   655→    .map((summary) => {
   656→      const resolved = index.resolve(summary.ref);
   657→      if (!resolved.ok) return undefined;
   658→      // Check if the resolved item is a task (not a spec item or meta item)
   659→      const item = resolved.item;
   660→      if (!("status" in item)) return undefined; // Spec items don't have status
   661→      return currentTasks.find((t) => t._ulid === resolved.ulid);
   662→    })
   663→    .filter((t): t is LoadedTask => t !== undefined && t.status === "in_progress");
   664→
   665→  if (tasksInProgressFull.length === 0) {
   666→    return;
   667→  }
   668→
   669→  // Process failures
   670→  const { processFailedIteration, createFailureNote, getTaskFailureCount } = await import("../../ralph/index.js");
   671→
   672→  const results = processFailedIteration(
   673→    tasksInProgressFull,
   674→    currentTasks,
   675→    iterationStartTime,
   676→    errorDescription,
   677→  );
   678→
   679→  // Add notes and escalate tasks
   680→  for (const result of results) {
   681→    const taskRef = result.taskRef;
   682→    const task = currentTasks.find((t) => t._ulid === taskRef);
   683→    if (!task) continue;
   684→
   685→    const priorCount = result.failureCount - 1;
   686→    const noteContent = createFailureNote(taskRef, errorDescription, priorCount);
   687→
   688→    // Add LOOP-FAIL note
   689→    const noteResult = spawnSync(
   690→      "kspec",
   691→      ["task", "note", `@${taskRef}`, noteContent],
   692→      {
   693→        encoding: "utf-8",
   694→        stdio: "pipe",
   695→        cwd: process.cwd(),
   696→      },
   697→    );
   698→
   699→    if (noteResult.status !== 0) {
   700→      warn(`Failed to add failure note to task ${taskRef}: ${noteResult.stderr}`);
   701→      continue;
   702→    }
   703→
   704→    // AC: @loop-mode-error-handling ac-5 - Escalate at threshold
   705→    if (result.escalated) {
   706→      const escalateResult = spawnSync(
   707→        "kspec",
   708→        [
   709→          "task",
   710→          "set",
   711→          `@${taskRef}`,
   712→          "--automation",
   713→          "needs_review",
   714→          "--reason",
   715→          `Loop mode: 3 consecutive failures without progress`,
   716→        ],
   717→        {
   718→          encoding: "utf-8",
   719→          stdio: "pipe",
   720→          cwd: process.cwd(),
   721→        },
   722→      );
   723→
   724→      if (escalateResult.status !== 0) {
   725→        warn(`Failed to escalate task ${taskRef}: ${escalateResult.stderr}`);
   726→      } else {
   727→        info(`Escalated task ${taskRef} to automation:needs_review after 3 failures`);
   728→      }
   729→    }
   730→  }
   731→}
   732→
   733→/**
   734→ * Process pending_review tasks by spawning subagents.
   735→ * AC: @ralph-subagent-spawning ac-6, ac-8
   736→ */
   737→async function processPendingReviewTasks(
   738→  ctx: KspecContext,
   739→  adapter: AgentAdapter,
   740→  pendingReviewTasks: ActiveTaskSummary[],
   741→  options: {
   742→    yolo: boolean;
   743→    maxRetries: number;
   744→    maxFailures: number;
   745→    cwd: string;
   746→  },
   747→  consecutiveFailures: { count: number },
   748→): Promise<boolean> {
   749→  if (pendingReviewTasks.length === 0) {
   750→    return true;
   751→  }
   752→
   753→  // Visual separator for subagent section
   754→  console.log("");
   755→  console.log(chalk.cyan(`${"═".repeat(60)}`));
   756→  console.log(chalk.cyan.bold(`${DEFAULT_SUBAGENT_PREFIX} Processing Pending Review Tasks`));
   757→  console.log(chalk.cyan(`${"═".repeat(60)}`));
   758→  console.log("");
   759→
   760→  info(
   761→    `${DEFAULT_SUBAGENT_PREFIX} Found ${pendingReviewTasks.length} pending_review task(s)`,
   762→  );
   763→
   764→  // AC: @ralph-subagent-spawning ac-6 - Process one at a time
   765→  for (const task of pendingReviewTasks) {
   766→    info(`${DEFAULT_SUBAGENT_PREFIX} Processing: ${task.ref} - ${task.title}`);
   767→
   768→    try {
   769→      // Build context for this task
   770→      const subagentCtx = await buildSubagentContext(ctx, task.ref);
   771→
   772→      // AC: @ralph-subagent-spawning ac-1, ac-3 - Spawn and wait
   773→      const result = await runSubagent(
   774→        adapter,
   775→        subagentCtx,
   776→        {
   777→          timeout: DEFAULT_SUBAGENT_TIMEOUT,
   778→          outputPrefix: DEFAULT_SUBAGENT_PREFIX,
   779→        },
   780→        {
   781→          yolo: options.yolo,
   782→          cwd: options.cwd,
   783→          handleRequest: (client, reqId, method, params) =>
   784→            handleRequest(client, reqId, method, params, options.yolo),
   785→        },
   786→      );
   787→
   788→      if (result.timedOut) {
   789→        // AC: @ralph-subagent-spawning ac-9
   790→        warn(
   791→          `${DEFAULT_SUBAGENT_PREFIX} Subagent timed out for ${task.ref}`,
   792→        );
   793→        await markTaskNeedsReview(
   794→          task.ref,
   795→          "Subagent timed out after 10 minutes",
   796→        );
   797→        consecutiveFailures.count++;
   798→      } else if (!result.success) {
   799→        // AC: @ralph-subagent-spawning ac-7
   800→        error(
   801→          `${DEFAULT_SUBAGENT_PREFIX} Subagent failed for ${task.ref}: ${result.error}`,
   802→        );
   803→        consecutiveFailures.count++;
   804→      } else {
   805→        // AC: @ralph-subagent-spawning ac-12 - Verify task was completed
   806→        const wasCompleted = await verifyTaskCompleted(task.ref);
   807→        if (wasCompleted) {
   808→          success(`${DEFAULT_SUBAGENT_PREFIX} Completed: ${task.ref}`);
   809→          consecutiveFailures.count = 0;
   810→        } else {
   811→          // Task wasn't completed - subagent likely exited early
   812→          warn(
   813→            `${DEFAULT_SUBAGENT_PREFIX} Subagent succeeded but task ${task.ref} is still pending_review`,
   814→          );
   815→          await markTaskNeedsReview(
   816→            task.ref,
   817→            "Subagent merged PR but did not complete the task. Review required to verify merge and complete task manually.",
   818→          );
   819→          consecutiveFailures.count++;
   820→        }
   821→      }
   822→
   823→      // Check if we've hit max failures
   824→      if (consecutiveFailures.count >= options.maxFailures) {
   825→        error(
   826→          `${DEFAULT_SUBAGENT_PREFIX} Reached max failures (${options.maxFailures})`,
   827→        );
   828→        return false;
   829→      }
   830→    } catch (err) {
   831→      const message = err instanceof Error ? err.message : String(err);
   832→      error(`${DEFAULT_SUBAGENT_PREFIX} Error processing ${task.ref}: ${message}`);
   833→      consecutiveFailures.count++;
   834→
   835→      if (consecutiveFailures.count >= options.maxFailures) {
   836→        error(
   837→          `${DEFAULT_SUBAGENT_PREFIX} Reached max failures (${options.maxFailures})`,
   838→        );
   839→        return false;
   840→      }
   841→    }
   842→  }
   843→
   844→  // Visual separator at end of subagent section
   845→  console.log("");
   846→  console.log(chalk.cyan(`${"═".repeat(60)}`));
   847→  console.log(chalk.cyan.bold(`${DEFAULT_SUBAGENT_PREFIX} Completed Review Processing`));
   848→  console.log(chalk.cyan(`${"═".repeat(60)}`));
   849→  console.log("");
   850→
   851→  return true;
   852→}
   853→
   854→// ─── Command Registration ────────────────────────────────────────────────────
   855→
   856→export function registerRalphCommand(program: Command): void {
   857→  const ralph = program
   858→    .command("ralph")
   859→    .description("Ralph automated task loop and agent control");
   860→
   861→  // end-loop subcommand - allows agent to signal loop termination
   862→  // AC: @ralph-end-loop ac-cmd, ac-reason, ac-noop-outside
   863→  ralph
   864→    .command("end-loop")
   865→    .description("End the ralph loop gracefully (stops all remaining iterations)")
   866→    .option("--reason <reason>", "Reason for ending the loop")
   867→    .action(async (options) => {
   868→      try {
   869→        const ctx = await initContext();
   870→
   871→        // Check if we're in a ralph session by looking for any ralph marker
   872→        const taskLimitMarker = await readTaskLimitMarker(ctx.rootDir);
   873→        const endLoopMarker = await readEndLoopMarker(ctx.rootDir);
   874→
   875→        // Write the marker with reason if provided
   876→        await writeEndLoopMarker(ctx.rootDir, options.reason);
   877→
   878→        // Determine if we're likely in a ralph session
   879→        const inRalphSession = taskLimitMarker !== null || endLoopMarker !== null;
   880→
   881→        if (!inRalphSession) {
   882→          // AC: @ralph-end-loop ac-noop-outside
   883→          warn("No active ralph session detected. Marker written but may have no effect.");
   884→          info("This command is designed to be called by agents during a ralph loop.");
   885→        } else {
   886→          success("Loop end signal sent");
   887→        }
   888→
   889→        if (options.reason) {
   890→          info(`Reason: ${options.reason}`);
   891→        }
   892→      } catch (err) {
   893→        error("Failed to signal end-loop", err);
   894→        process.exit(EXIT_CODES.ERROR);
   895→      }
   896→    });
   897→
   898→  // Main ralph run command (default behavior when ralph is called directly)
   899→  ralph
   900→    .command("run", { isDefault: true })
   901→    .description("Run ACP agent in a loop to process ready tasks")
   902→    .argument("[args...]", "")
   903→    .option("--max-loops <n>", "Maximum iterations", "5")
   904→    .option("--max-retries <n>", "Max retries per iteration on error", "3")
   905→    .option(
   906→      "--max-failures <n>",
   907→      "Max consecutive failed iterations before exit",
   908→      "3",
   909→    )
   910→    .option("--dry-run", "Show prompt without executing")
   911→    .option("--yolo", "Use dangerously-skip-permissions (default)", true)
   912→    .option("--no-yolo", "Require normal permission prompts")
   913→    .option("--adapter <id>", "Agent adapter to use", "claude-code-acp")
   914→    .option("--adapter-cmd <cmd>", "Custom adapter command (for testing)")
   915→    .option(
   916→      "--restart-every <n>",
   917→      "Restart agent every N iterations to prevent OOM (0 = never)",
   918→      "10",
   919→    )
   920→    .option(
   921→      "--focus <instructions>",
   922→      "Focus instructions included in every iteration prompt",
   923→    )
   924→    .option(
   925→      "--max-tasks <n>",
   926→      "Max tasks per iteration (0 = unlimited)",
   927→      "1",
   928→    )
   929→    .action(async (args: string[], options) => {
   930→      // Check for unknown subcommands that fell through to default
   931→      // Only check args that look like subcommand names (alphanumeric with hyphens, no quotes)
   932→      if (args.length > 0) {
   933→        const unknownCmd = args[0];
   934→        // Skip if it looks like a malformed option or quoted argument
   935→        const looksLikeSubcommand = /^[a-z][a-z0-9-]*$/i.test(unknownCmd);
   936→        if (looksLikeSubcommand) {
   937→          if (unknownCmd === "end-iteration") {
   938→            error(`Unknown command: ${unknownCmd}. Did you mean 'end-loop'?`);
   939→            info("The command was renamed from 'end-iteration' to 'end-loop' to clarify it ends the entire loop.");
   940→          } else {
   941→            error(`Unknown command: ${unknownCmd}`);
   942→          }
   943→          info("Run 'kspec ralph --help' to see available commands.");
   944→          process.exit(EXIT_CODES.USAGE_ERROR);
   945→        }
   946→      }
   947→      try {
   948→        const maxLoops = parseInt(options.maxLoops, 10);
   949→        const maxRetries = parseInt(options.maxRetries, 10);
   950→        const maxFailures = parseInt(options.maxFailures, 10);
   951→
   952→        if (Number.isNaN(maxLoops) || maxLoops < 1) {
   953→          error(errors.usage.maxLoopsPositive);
   954→          process.exit(EXIT_CODES.ERROR);
   955→        }
   956→
   957→        if (Number.isNaN(maxRetries) || maxRetries < 0) {
   958→          error(errors.usage.maxRetriesNonNegative);
   959→          process.exit(EXIT_CODES.ERROR);
   960→        }
   961→
   962→        if (Number.isNaN(maxFailures) || maxFailures < 1) {
   963→          error(errors.usage.maxFailuresPositive);
   964→          process.exit(EXIT_CODES.ERROR);
   965→        }
   966→
   967→        const restartEvery = parseInt(options.restartEvery, 10);
   968→        if (Number.isNaN(restartEvery) || restartEvery < 0) {
   969→          error("--restart-every must be a non-negative integer");
   970→          process.exit(EXIT_CODES.ERROR);
   971→        }
   972→
   973→        // AC: @ralph-task-limit ac-flag
   974→        const maxTasks = parseInt(options.maxTasks, 10);
   975→        if (Number.isNaN(maxTasks) || maxTasks < 0 || maxTasks > 999) {
   976→          error("--max-tasks must be 0 (unlimited) or a positive integer up to 999");
   977→          process.exit(EXIT_CODES.USAGE_ERROR);
   978→        }
   979→
   980→        // Handle custom adapter command for testing
   981→        if (options.adapterCmd) {
   982→          const parts = options.adapterCmd.split(/\s+/);
   983→          const customAdapter: AgentAdapter = {
   984→            command: parts[0],
   985→            args: parts.slice(1),
   986→            description: "Custom adapter via --adapter-cmd",
   987→          };
   988→          registerAdapter("custom", customAdapter);
   989→          options.adapter = "custom";
   990→        }
   991→
   992→        // Resolve adapter
   993→        const adapter = resolveAdapter(options.adapter);
   994→
   995→        // Validate adapter package exists before proceeding
   996→        // Skip validation for:
   997→        // - Custom adapters (--adapter-cmd)
   998→        // - Non-npx adapters
   999→        // - Dry-run mode with default adapter (doesn't spawn agent, default may not be installed in CI)
  1000→        // Note: If user explicitly specifies --adapter, validate even in dry-run to catch typos
  1001→        const isDefaultAdapter = options.adapter === "claude-code-acp";
  1002→        const skipValidation =
  1003→          options.adapterCmd ||
  1004→          adapter.command !== "npx" ||
  1005→          !adapter.args[0] ||
  1006→          (options.dryRun && isDefaultAdapter);
  1007→
  1008→        if (!skipValidation) {
  1009→          validateAdapter(adapter.args[0]);
  1010→        }
  1011→
  1012→        // Add yolo flag to adapter args if needed
  1013→        if (options.yolo && options.adapter === "claude-code-acp") {
  1014→          adapter.args = [...adapter.args, "--dangerously-skip-permissions"];
  1015→        }
  1016→
  1017→        const restartInfo =
  1018→          restartEvery > 0 ? `, restart every ${restartEvery}` : "";
  1019→        const maxTasksInfo =
  1020→          maxTasks === 0 ? "unlimited" : `${maxTasks}`;
  1021→        info(
  1022→          `Starting ralph loop (adapter=${options.adapter}, max ${maxLoops} iterations, ${maxRetries} retries, ${maxFailures} max failures${restartInfo}, max-tasks=${maxTasksInfo})`,
  1023→        );
  1024→        if (options.focus) {
  1025→          info(`Focus: ${options.focus}`);
  1026→        }
  1027→
  1028→        // Initialize kspec context
  1029→        const ctx = await initContext();
  1030→        const specDir = ctx.specDir;
  1031→
  1032→        // Create session for event tracking
  1033→        const sessionId = ulid();
  1034→        await createSession(specDir, {
  1035→          id: sessionId,
  1036→          agent_type: options.adapter,
  1037→          task_id: undefined, // Will be determined per iteration
  1038→        });
  1039→
  1040→        // Log session start
  1041→        await appendEvent(specDir, {
  1042→          session_id: sessionId,
  1043→          type: "session.start",
  1044→          data: {
  1045→            adapter: options.adapter,
  1046→            maxLoops,
  1047→            maxRetries,
  1048→            maxFailures,
  1049→            maxTasks,
  1050→            yolo: options.yolo,
  1051→            focus: options.focus,
  1052→          },
  1053→        });
  1054→
  1055→        let consecutiveFailures = 0;
  1056→        let agent: SpawnedAgent | null = null;
  1057→        let acpSessionId: string | null = null;
  1058→
  1059→        // AC: @ralph-end-loop ac-signal-cleanup, @ralph-task-limit ac-signal-cleanup
  1060→        // Signal handlers for cleanup on Ctrl+C or kill
  1061→        // Note: Signal handlers must be synchronous, so we use Promise.finally()
  1062→        // to ensure cleanup completes before exit
  1063→        const signalCleanup = (signal: string) => {
  1064→          info(`Received ${signal}, cleaning up...`);
  1065→          // Kill agent if running
  1066→          if (agent) {
  1067→            agent.kill();
  1068→          }
  1069→          // Clean up marker files, then exit after cleanup completes
  1070→          Promise.all([
  1071→            clearTaskLimitMarker(ctx.rootDir),
  1072→            clearEndLoopMarker(ctx.rootDir),
  1073→          ]).finally(() => {
  1074→            process.exit(0);
  1075→          });
  1076→        };
  1077→        const sigintHandler = () => { signalCleanup("SIGINT"); };
  1078→        const sigtermHandler = () => { signalCleanup("SIGTERM"); };
  1079→        process.on("SIGINT", sigintHandler);
  1080→        process.on("SIGTERM", sigtermHandler);
  1081→
  1082→        // Create translator and renderer for this session
  1083→        const translator = createTranslator();
  1084→        const renderer = createCliRenderer();
  1085→
  1086→        // Task limit state - tracks completions per iteration
  1087→        // AC: @ralph-task-limit ac-reset, ac-wrapup
  1088→        let taskLimitReached = false;
  1089→        let tasksCompletedThisIteration = 0;
  1090→
  1091→        // End-loop signal state
  1092→        // AC: @ralph-end-loop ac-detect, ac-graceful
  1093→        let endLoopRequested = false;
  1094→
  1095→        try {
  1096→          for (let iteration = 1; iteration <= maxLoops; iteration++) {
  1097→            renderer.newSection?.(`Iteration ${iteration}/${maxLoops}`);
  1098→
  1099→            // AC: @ralph-task-limit ac-reset - Reset counter and clear stale markers at iteration start
  1100→            taskLimitReached = false;
  1101→            tasksCompletedThisIteration = 0;
  1102→            const wasStale = await clearStaleMarker(ctx.rootDir);
  1103→            if (wasStale) {
  1104→              info("Cleared stale task limit marker from previous session");
  1105→            }
  1106→            // Also clear any marker from previous iteration of this session
  1107→            await clearTaskLimitMarker(ctx.rootDir);
  1108→
  1109→            // AC: @ralph-end-loop ac-cleanup - Reset end-loop state
  1110→            endLoopRequested = false;
  1111→            const wasStaleEndLoop = await clearStaleEndLoopMarker(ctx.rootDir);
  1112→            if (wasStaleEndLoop) {
  1113→              info("Cleared stale end-loop marker from previous session");
  1114→            }
  1115→            await clearEndLoopMarker(ctx.rootDir);
  1116→
  1117→            // Gather fresh context each iteration (only automation-eligible tasks)
  1118→            // AC: @cli-ralph ac-16
  1119→            const sessionCtx = await gatherSessionContext(ctx, {
  1120→              limit: "10",
  1121→              eligible: true,
  1122→            });
  1123→
  1124→            // AC: @ralph-subagent-spawning ac-8 - Process pending_review tasks BEFORE main iteration
  1125→            // This wraps consecutiveFailures in an object so it can be mutated by the helper
  1126→            const failureTracker = { count: consecutiveFailures };
  1127→            const continueLoop = await processPendingReviewTasks(
  1128→              ctx,
  1129→              adapter,
  1130→              sessionCtx.pending_review_tasks,
  1131→              {
  1132→                yolo: options.yolo,
  1133→                maxRetries,
  1134→                maxFailures,
  1135→                cwd: process.cwd(),
  1136→              },
  1137→              failureTracker,
  1138→            );
  1139→            consecutiveFailures = failureTracker.count;
  1140→
  1141→            if (!continueLoop) {
  1142→              break;
  1143→            }
  1144→
  1145→            // AC: @cli-ralph ac-20 - Refresh context after pending_review processing
  1146→            // If pending_review tasks were processed, they may have completed and unblocked
  1147→            // dependent tasks. Re-gather context to detect newly available tasks.
  1148→            let currentCtx = sessionCtx;
  1149→            if (sessionCtx.pending_review_tasks.length > 0) {
  1150→              currentCtx = await gatherSessionContext(ctx, {
  1151→                limit: "10",
  1152→                eligible: true,
  1153→              });
  1154→            }
  1155→
  1156→            // Check for automation-eligible tasks (ready or in_progress)
  1157→            // AC: @cli-ralph ac-19
  1158→            const hasActiveTasks = currentCtx.active_tasks.length > 0;
  1159→            const hasReadyTasks = currentCtx.ready_tasks.length > 0;
  1160→
  1161→            if (!hasActiveTasks && !hasReadyTasks) {
  1162→              info("No automation-eligible tasks (ready or in_progress). Exiting loop.");
  1163→              break;
  1164→            }
  1165→
  1166→            // AC: @loop-mode-error-handling - Track tasks in progress for failure handling
  1167→            const tasksInProgressAtStart = sessionCtx.active_tasks;
  1168→            const iterationStartTime = new Date();
  1169→
  1170→            // Build prompts - task-work first, then reflect
  1171→            const taskWorkPrompt = buildTaskWorkPrompt(
  1172→              currentCtx,
  1173→              iteration,
  1174→              maxLoops,
  1175→              sessionId,
  1176→              options.focus,
  1177→            );
  1178→            const reflectPrompt = buildReflectPrompt(
  1179→              iteration,
  1180→              maxLoops,
  1181→              sessionId,
  1182→            );
  1183→
  1184→            // AC: @ralph-task-limit ac-dryrun
  1185→            if (options.dryRun) {
  1186→              console.log(
  1187→                chalk.yellow("=== DRY RUN - Configuration ===\n"),
  1188→              );
  1189→              console.log(`  max-loops: ${maxLoops}`);
  1190→              console.log(`  max-tasks: ${maxTasks === 0 ? "unlimited" : maxTasks}`);
  1191→              console.log(`  max-retries: ${maxRetries}`);
  1192→              console.log(`  max-failures: ${maxFailures}`);
  1193→              console.log(`  restart-every: ${restartEvery === 0 ? "never" : restartEvery}`);
  1194→              console.log(
  1195→                chalk.yellow("\n=== Task Work Prompt ===\n"),
  1196→              );
  1197→              console.log(taskWorkPrompt);
  1198→              console.log(chalk.yellow("\n=== Reflect Prompt ===\n"));
  1199→              console.log(reflectPrompt);
  1200→              console.log(chalk.yellow("\n=== END DRY RUN ==="));
  1201→              break;
  1202→            }
  1203→
  1204→            // Log task-work prompt
  1205→            await appendEvent(specDir, {
  1206→              session_id: sessionId,
  1207→              type: "prompt.sent",
  1208→              data: {
  1209→                iteration,
  1210→                phase: "task-work",
  1211→                prompt: taskWorkPrompt,
  1212→                tasks: {
  1213→                  active: currentCtx.active_tasks.map((t) => t.ref),
  1214→                  ready: currentCtx.ready_tasks.map((t) => t.ref),
  1215→                },
  1216→              },
  1217→            });
  1218→
  1219→            // Retry loop for this iteration
  1220→            let lastError: Error | null = null;
  1221→            let succeeded = false;
  1222→
  1223→            for (let attempt = 1; attempt <= maxRetries + 1; attempt++) {
  1224→              if (attempt > 1) {
  1225→                console.log(
  1226→                  chalk.yellow(
  1227→                    `\nRetry attempt ${attempt - 1}/${maxRetries}...`,
  1228→                  ),
  1229→                );
  1230→              }
  1231→
  1232→              try {
  1233→                // Spawn agent if not already running
  1234→                if (!agent) {
  1235→                  info("Spawning ACP agent...");
  1236→                  agent = await spawnAndInitialize(adapter, {
  1237→                    cwd: process.cwd(),
  1238→                    clientOptions: {
  1239→                      clientInfo: {
  1240→                        name: "kspec-ralph",
  1241→                        version: packageVersion,
  1242→                      },
  1243→                      methodTimeouts: {
  1244→                        "session/prompt": RALPH_PROMPT_TIMEOUT,
  1245→                        "session/resume": RALPH_PROMPT_TIMEOUT,
  1246→                      },
  1247→                    },
  1248→                  });
  1249→
  1250→                  // Set up streaming update handler with translator + renderer
  1251→                  agent.client.on(
  1252→                    "update",
  1253→                    (_sid: string, update: SessionUpdate) => {
  1254→                      // Translate ACP event to RalphEvent and render
  1255→                      const event = translator.translate(update);
  1256→                      if (event) {
  1257→                        renderer.render(event);
  1258→                      }
  1259→
  1260→                      // AC: @ralph-task-limit ac-detection, ac-wrapup
  1261→                      // Detect task completions for limit enforcement
  1262→                      if (maxTasks > 0 && !taskLimitReached) {
  1263→                        const bashCmd = extractBashCommand(update);
  1264→                        if (bashCmd && detectTaskCompleteCommand(bashCmd)) {
  1265→                          // Pattern matched - verify via kspec query
  1266→                          getIterationStats(ctx, iterationStartTime)
  1267→                            .then(async (stats) => {
  1268→                              if (stats.tasks_completed >= maxTasks && !taskLimitReached) {
  1269→                                taskLimitReached = true;
  1270→                                tasksCompletedThisIteration = stats.tasks_completed;
  1271→                                info(`Task limit reached (${stats.tasks_completed}/${maxTasks})`);
  1272→
  1273→                                // AC: @ralph-task-limit ac-marker-format, ac-wrapup
  1274→                                // Write marker file for hook enforcement
  1275→                                const marker: TaskLimitMarker = {
  1276→                                  active: true,
  1277→                                  since: iterationStartTime.toISOString(),
  1278→                                  max: maxTasks,
  1279→                                  completed: stats.tasks_completed,
  1280→                                  sessionId,
  1281→                                };
  1282→                                await writeTaskLimitMarker(ctx.rootDir, marker);
  1283→
  1284→                                // Inject wrap-up message to agent
  1285→                                if (agent && acpSessionId) {
  1286→                                  const wrapUpMsg = `\n\n**TASK LIMIT REACHED** - ${stats.tasks_completed} task(s) completed this iteration (limit: ${maxTasks}).\n\nPlease wrap up your current work and exit cleanly. Do not start new tasks.\n\nCompleted tasks this iteration: ${stats.completed_refs.join(", ")}`;
  1287→                                  agent.client.prompt({
  1288→                                    sessionId: acpSessionId,
  1289→                                    prompt: [{ type: "text", text: wrapUpMsg }],
  1290→                                  }).catch(() => {
  1291→                                    // Ignore if message injection fails
  1292→                                  });
  1293→                                }
  1294→                              }
  1295→                            })
  1296→                            .catch(() => {
  1297→                              // Ignore query failures - detection is best-effort
  1298→                            });
  1299→                        }
  1300→                      }
  1301→
  1302→                      // AC: @ralph-end-loop ac-detect
  1303→                      // Detect explicit end-loop command
  1304→                      if (!endLoopRequested) {
  1305→                        const bashCmd = extractBashCommand(update);
  1306→                        if (bashCmd && detectEndLoopCommand(bashCmd)) {
  1307→                          endLoopRequested = true;
  1308→                          // Read marker to get reason if present
  1309→                          readEndLoopMarker(ctx.rootDir)
  1310→                            .then((marker) => {
  1311→                              const reason = marker?.reason
  1312→                                ? ` (${marker.reason})`
  1313→                                : "";
  1314→                              info(`End-loop signal received${reason}`);
  1315→                            })
  1316→                            .catch(() => {
  1317→                              info("End-loop signal received");
  1318→                            });
  1319→                        }
  1320→                      }
  1321→
  1322→                      // Log raw update event (async, non-blocking)
  1323→                      appendEvent(specDir, {
  1324→                        session_id: sessionId,
  1325→                        type: "session.update",
  1326→                        data: { iteration, update },
  1327→                      }).catch(() => {
  1328→                        // Ignore logging errors during streaming
  1329→                      });
  1330→                    },
  1331→                  );
  1332→
  1333→                  // Set up tool request handler
  1334→                  agent.client.on(
  1335→                    "request",
  1336→                    (
  1337→                      reqId: string | number,
  1338→                      method: string,
  1339→                      params: unknown,
  1340→                    ) => {
  1341→                      // biome-ignore lint/style/noNonNullAssertion: agent is guaranteed to exist when callback is registered
  1342→                      handleRequest(
  1343→                        agent!.client,
  1344→                        reqId,
  1345→                        method,
  1346→                        params,
  1347→                        options.yolo,
  1348→                      ).catch((err) => {
  1349→                        // biome-ignore lint/style/noNonNullAssertion: agent is guaranteed to exist when callback is registered
  1350→                        agent!.client.respondError(reqId, -32000, err.message);
  1351→                      });
  1352→                    },
  1353→                  );
  1354→                }
  1355→
  1356→                // Create fresh ACP session per iteration to keep context clean
  1357→                info("Creating ACP session...");
  1358→                acpSessionId = await agent.client.newSession({
  1359→                  cwd: process.cwd(),
  1360→                  mcpServers: [], // No MCP servers for now
  1361→                });
  1362→
  1363→                // Phase 1: Task Work
  1364→                info("Sending task-work prompt to agent...");
  1365→                const taskWorkResponse = await agent.client.prompt({
  1366→                  sessionId: acpSessionId!,
  1367→                  prompt: [{ type: "text", text: taskWorkPrompt }],
  1368→                });
  1369→
  1370→                // Log task-work completion
  1371→                await appendEvent(specDir, {
  1372→                  session_id: sessionId,
  1373→                  type: "session.update",
  1374→                  data: {
  1375→                    iteration,
  1376→                    phase: "task-work",
  1377→                    stopReason: taskWorkResponse.stopReason,
  1378→                    completed: true,
  1379→                  },
  1380→                });
  1381→
  1382→                if (taskWorkResponse.stopReason === "cancelled") {
  1383→                  throw new Error(errors.usage.agentPromptCancelled);
  1384→                }
  1385→
  1386→                // Phase 2: Reflect (always sent after task-work completes)
  1387→                info("Sending reflect prompt to agent...");
  1388→                await appendEvent(specDir, {
  1389→                  session_id: sessionId,
  1390→                  type: "prompt.sent",
  1391→                  data: {
  1392→                    iteration,
  1393→                    phase: "reflect",
  1394→                    prompt: reflectPrompt,
  1395→                  },
  1396→                });
  1397→
  1398→                const reflectResponse = await agent.client.prompt({
  1399→                  sessionId: acpSessionId!,
  1400→                  prompt: [{ type: "text", text: reflectPrompt }],
  1401→                });
  1402→
  1403→                // Log reflect completion
  1404→                await appendEvent(specDir, {
  1405→                  session_id: sessionId,
  1406→                  type: "session.update",
  1407→                  data: {
  1408→                    iteration,
  1409→                    phase: "reflect",
  1410→                    stopReason: reflectResponse.stopReason,
  1411→                    completed: true,
  1412→                  },
  1413→                });
  1414→
  1415→                if (reflectResponse.stopReason === "cancelled") {
  1416→                  throw new Error(errors.usage.agentPromptCancelled);
  1417→                }
  1418→
  1419→                succeeded = true;
  1420→                break;
  1421→              } catch (err) {
  1422→                lastError = err as Error;
  1423→                error(errors.failures.iterationFailed(lastError.message));
  1424→
  1425→                // Clean up agent on error - will respawn next attempt
  1426→                if (agent) {
  1427→                  agent.kill();
  1428→                  agent = null;
  1429→                  acpSessionId = null;
  1430→                }
  1431→              }
  1432→            }
  1433→
  1434→            if (succeeded) {
  1435→              console.log(); // Newline after streaming output
  1436→
  1437→              // Save session context snapshot for audit trail
  1438→              await saveSessionContext(
  1439→                specDir,
  1440→                sessionId,
  1441→                iteration,
  1442→                sessionCtx,
  1443→              );
  1444→
  1445→              success(`Completed iteration ${iteration}`);
  1446→              consecutiveFailures = 0;
  1447→
  1448→              // AC: @ralph-end-loop ac-graceful - Check for end-loop signal
  1449→              if (endLoopRequested) {
  1450→                info("Agent requested end of loop. Exiting gracefully.");
  1451→                break;
  1452→              }
  1453→
  1454→              // Periodic agent restart to prevent OOM
  1455→              // AC: @cli-ralph ac-restart-periodic
  1456→              if (
  1457→                restartEvery > 0 &&
  1458→                iteration % restartEvery === 0 &&
  1459→                iteration < maxLoops
  1460→              ) {
  1461→                info(
  1462→                  `Restarting agent to prevent memory buildup (every ${restartEvery} iterations)...`,
  1463→                );
  1464→                if (agent) {
  1465→                  agent.kill();
  1466→                  agent = null;
  1467→                  acpSessionId = null;
  1468→                }
  1469→              }
  1470→            } else {
  1471→              consecutiveFailures++;
  1472→              error(
  1473→                errors.failures.iterationFailedAfterRetries(
  1474→                  iteration,
  1475→                  maxRetries,
  1476→                  consecutiveFailures,
  1477→                  maxFailures,
  1478→                ),
  1479→              );
  1480→              if (lastError) {
  1481→                error(errors.failures.lastError(lastError.message));
  1482→              }
  1483→
  1484→              // AC: @loop-mode-error-handling - Track per-task failures
  1485→              const errorDesc = lastError?.message || "Iteration failed after retries";
  1486→              await handleIterationFailure(
  1487→                ctx,
  1488→                tasksInProgressAtStart,
  1489→                iterationStartTime,
  1490→                errorDesc,
  1491→              );
  1492→
  1493→              if (consecutiveFailures >= maxFailures) {
  1494→                error(errors.failures.reachedMaxFailures(maxFailures));
  1495→                break;
  1496→              }
  1497→
  1498→              info("Continuing to next iteration...");
  1499→            }
  1500→          }
  1501→        } finally {
  1502→          // Remove signal handlers to avoid double cleanup
  1503→          process.off("SIGINT", sigintHandler);
  1504→          process.off("SIGTERM", sigtermHandler);
  1505→
  1506→          // Clean up agent
  1507→          if (agent) {
  1508→            agent.kill();
  1509→          }
  1510→
  1511→          // AC: @ralph-task-limit ac-reset - Clear marker file when session ends
  1512→          await clearTaskLimitMarker(ctx.rootDir);
  1513→
  1514→          // AC: @ralph-end-loop ac-cleanup - Clear end-loop marker when session ends
  1515→          await clearEndLoopMarker(ctx.rootDir);
  1516→
  1517→          // Log session end
  1518→          const status =
  1519→            consecutiveFailures >= maxFailures ? "abandoned" : "completed";
  1520→          await appendEvent(specDir, {
  1521→            session_id: sessionId,
  1522→            type: "session.end",
  1523→            data: {
  1524→              status,
  1525→              consecutiveFailures,
  1526→            },
  1527→          });
  1528→          await updateSessionStatus(specDir, sessionId, status);
  1529→        }
  1530→
  1531→        console.log(chalk.green(`\n${"─".repeat(60)}`));
  1532→        success("Ralph loop completed");
  1533→        console.log(chalk.green(`${"─".repeat(60)}\n`));
  1534→      } catch (err) {
  1535→        error(errors.failures.ralphLoop, err);
  1536→        process.exit(EXIT_CODES.ERROR);
  1537→      }
  1538→    });
  1539→}
  1540→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
