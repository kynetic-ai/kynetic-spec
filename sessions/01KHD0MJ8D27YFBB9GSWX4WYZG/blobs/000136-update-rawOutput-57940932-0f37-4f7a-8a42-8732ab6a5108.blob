    66→
    67→// ─── Task Limit Marker ──────────────────────────────────────────────────────
    68→
    69→/**
    70→ * Marker file schema for task limit enforcement.
    71→ * AC: @ralph-task-limit ac-marker-format
    72→ */
    73→interface TaskLimitMarker {
    74→  active: boolean;
    75→  since: string; // ISO8601
    76→  max: number;
    77→  completed: number;
    78→  sessionId: string;
    79→}
    80→
    81→const TASK_LIMIT_MARKER_PATH = ".claude/ralph-task-limit.json";
    82→const END_LOOP_MARKER_PATH = ".claude/ralph-end-loop.json";
    83→const STALE_MARKER_THRESHOLD_MS = 60 * 60 * 1000; // 1 hour
    84→
    85→// ─── End Loop Marker ────────────────────────────────────────────────────────
    86→
    87→/**
    88→ * Marker file schema for explicit end-loop signaling.
    89→ * AC: @ralph-end-loop ac-cmd
    90→ */
    91→interface EndLoopMarker {
    92→  requested: boolean;
    93→  timestamp: string; // ISO8601
    94→  reason?: string;
    95→}
    96→
    97→/**
    98→ * Write task limit marker file.
    99→ * AC: @ralph-task-limit ac-wrapup, ac-marker-format
   100→ */
   101→async function writeTaskLimitMarker(
   102→  rootDir: string,
   103→  marker: TaskLimitMarker,
   104→): Promise<void> {
   105→  const markerPath = path.join(rootDir, TASK_LIMIT_MARKER_PATH);
   106→  const dir = path.dirname(markerPath);
   107→  await fs.mkdir(dir, { recursive: true });
   108→  await fs.writeFile(markerPath, JSON.stringify(marker, null, 2));
   109→}
   110→
   111→/**
   112→ * Read task limit marker file if it exists.
   113→ */
   114→async function readTaskLimitMarker(
   115→  rootDir: string,
   116→): Promise<TaskLimitMarker | null> {
   117→  const markerPath = path.join(rootDir, TASK_LIMIT_MARKER_PATH);
   118→  try {
   119→    const content = await fs.readFile(markerPath, "utf-8");
   120→    return JSON.parse(content) as TaskLimitMarker;
   121→  } catch {
   122→    return null;
   123→  }
   124→}
   125→
   126→/**
   127→ * Clear task limit marker file.
   128→ * AC: @ralph-task-limit ac-reset
   129→ */
   130→async function clearTaskLimitMarker(rootDir: string): Promise<void> {
   131→  const markerPath = path.join(rootDir, TASK_LIMIT_MARKER_PATH);
   132→  try {
   133→    await fs.unlink(markerPath);
   134→  } catch {
   135→    // Ignore if file doesn't exist
   136→  }
   137→}
   138→
   139→/**
   140→ * Clear stale marker files (older than 1 hour).
   141→ * AC: @ralph-task-limit ac-reset
   142→ */
   143→async function clearStaleMarker(rootDir: string): Promise<boolean> {
   144→  const marker = await readTaskLimitMarker(rootDir);
   145→  if (!marker) return false;
   146→
   147→  const markerAge = Date.now() - new Date(marker.since).getTime();
   148→  if (markerAge > STALE_MARKER_THRESHOLD_MS) {
   149→    await clearTaskLimitMarker(rootDir);
   150→    return true;
   151→  }
   152→  return false;
   153→}
   154→
   155→/**
   156→ * Write end-loop marker file.
   157→ * AC: @ralph-end-loop ac-cmd
   158→ */
   159→async function writeEndLoopMarker(
   160→  rootDir: string,
   161→  reason?: string,
   162→): Promise<void> {
   163→  const markerPath = path.join(rootDir, END_LOOP_MARKER_PATH);
   164→  const dir = path.dirname(markerPath);
   165→  await fs.mkdir(dir, { recursive: true });
   166→  const marker: EndLoopMarker = {
   167→    requested: true,
   168→    timestamp: new Date().toISOString(),
   169→    reason,
   170→  };
   171→  await fs.writeFile(markerPath, JSON.stringify(marker, null, 2));
   172→}
   173→
   174→/**
   175→ * Read end-loop marker file if it exists.
   176→ * AC: @ralph-end-loop ac-detect
   177→ */
   178→async function readEndLoopMarker(
   179→  rootDir: string,
   180→): Promise<EndLoopMarker | null> {
   181→  const markerPath = path.join(rootDir, END_LOOP_MARKER_PATH);
   182→  try {
   183→    const content = await fs.readFile(markerPath, "utf-8");
   184→    return JSON.parse(content) as EndLoopMarker;
   185→  } catch {
   186→    return null;
   187→  }
   188→}
   189→
   190→/**
   191→ * Clear end-loop marker file.
   192→ * AC: @ralph-end-loop ac-cleanup
   193→ */
   194→async function clearEndLoopMarker(rootDir: string): Promise<void> {
   195→  const markerPath = path.join(rootDir, END_LOOP_MARKER_PATH);
   196→  try {
   197→    await fs.unlink(markerPath);
   198→  } catch {
   199→    // Ignore if file doesn't exist
   200→  }
   201→}
   202→
   203→/**
   204→ * Clear stale end-loop markers (older than 1 hour).
   205→ * AC: @ralph-end-loop ac-cleanup
   206→ */
   207→async function clearStaleEndLoopMarker(rootDir: string): Promise<boolean> {
   208→  const marker = await readEndLoopMarker(rootDir);
   209→  if (!marker) return false;
   210→
   211→  const markerAge = Date.now() - new Date(marker.timestamp).getTime();
   212→  if (markerAge > STALE_MARKER_THRESHOLD_MS) {
   213→    await clearEndLoopMarker(rootDir);
   214→    return true;
   215→  }
   216→  return false;
   217→}
   218→
   219→/**
   220→ * Detect if a Bash command is a task complete command.
   221→ * AC: @ralph-task-limit ac-detection
   222→ */
   223→function detectTaskCompleteCommand(command: string): boolean {
   224→  // Match variations of "kspec task complete"
   225→  // Don't match "kspec task submit" - that's just status change to pending_review
   226→  return /\bkspec\s+task\s+complete\b/.test(command);
   227→}
   228→
   229→/**
   230→ * Detect if a Bash command is an end-loop command.
   231→ * AC: @ralph-end-loop ac-detect
   232→ */
   233→function detectEndLoopCommand(command: string): boolean {
   234→  // Match "kspec ralph end-loop" with any arguments
   235→  return /\bkspec\s+ralph\s+end-loop\b/.test(command);
   236→}
   237→
   238→/**
   239→ * Extract Bash command from SessionUpdate if it's a tool_call or tool_call_update event.
   240→ * Returns null if not a Bash tool call.
   241→ */
   242→function extractBashCommand(update: SessionUpdate): string | null {
   243→  const u = update as Record<string, unknown>;
   244→
   245→  // Check if this is a tool call event
   246→  if (u.sessionUpdate !== "tool_call" && u.sessionUpdate !== "tool_call_update") {
   247→    return null;
   248→  }
   249→
   250→  // Extract tool name - check various locations Claude Code uses
   251→  let toolName: string | undefined;
   252→
   253→  // Try _meta.claudeCode.toolName first (Claude Code pattern)
   254→  const meta = u._meta as Record<string, unknown> | undefined;
   255→  if (meta) {
   256→    const claudeCode = meta.claudeCode as Record<string, unknown> | undefined;
   257→    if (claudeCode?.toolName) {
   258→      toolName = String(claudeCode.toolName);
   259→    } else if (meta.toolName) {
   260→      toolName = String(meta.toolName);
   261→    }
   262→  }
   263→
   264→  // Fall back to name or title field
   265→  if (!toolName && u.name) {
   266→    toolName = String(u.name);
   267→  }
   268→  if (!toolName && u.title) {
   269→    toolName = String(u.title);
   270→  }
   271→
   272→  // Check if it's a Bash tool (handle MCP prefix variations)
   273→  if (!toolName) return null;
   274→  const isBash = toolName === "Bash" || toolName.endsWith("__Bash");
   275→  if (!isBash) return null;
   276→
   277→  // Extract command from input
   278→  const input = (u.rawInput || u.input || u.params) as Record<string, unknown> | undefined;
   279→  if (!input) return null;
   280→
   281→  const command = input.command;
   282→  if (typeof command !== "string") return null;
   283→
   284→  return command;
   285→}
   286→
   287→// ─── Prompt Template ─────────────────────────────────────────────────────────
   288→
   289→// AC: @ralph-skill-delegation ac-1, ac-2, ac-3
   290→function buildTaskWorkPrompt(
   291→  sessionCtx: SessionContext,
   292→  iteration: number,
   293→  maxLoops: number,
   294→  sessionId: string,
   295→  focus?: string,
   296→): string {
   297→  const focusSection = focus
   298→    ? `
   299→## Session Focus (applies to ALL iterations)
   300→
   301→> **${focus}**
   302→
   303→Keep this focus in mind throughout your work. It takes priority over default task selection.
   304→`
   305→    : "";
   306→
   307→  return `# Kspec Automation Session - Task Work
   308→
   309→**Session ID:** \`${sessionId}\`
   310→**Iteration:** ${iteration} of ${maxLoops}
   311→**Mode:** Automated (no human in the loop)
   312→${focusSection}
   313→
   314→## Current State
   315→\`\`\`json
   316→${JSON.stringify(sessionCtx, null, 2)}
   317→\`\`\`
   318→
   319→## Instructions
   320→
   321→Run the task-work skill in loop mode:
   322→
   323→\`\`\`
   324→/task-work loop
   325→\`\`\`
   326→
   327→Loop mode means: no confirmations, auto-resolve decisions, automation-eligible tasks only.
   328→
   329→**Normal flow:** Work on a task, create a PR, then stop responding. Ralph continues automatically —
   330→it checks for remaining eligible tasks at the start of each iteration and exits the loop itself when none remain.
   331→
   332→**Do NOT call \`end-loop\` after completing a task.** Simply stop responding.
   333→\`end-loop\` is a rare escape hatch for when work is stalling across multiple iterations with no progress — not a normal exit path.
   334→`;
   335→}
   336→
   337→/**
   338→ * Build the reflect prompt sent after task-work completes.
   339→ * Ralph sends this as a separate prompt to ensure reflection always happens.
   340→ */
   341→function buildReflectPrompt(
   342→  iteration: number,
   343→  maxLoops: number,
   344→  sessionId: string,
   345→): string {
   346→  const isFinal = iteration === maxLoops;
   347→
   348→  return `# Kspec Automation Session - Reflection
   349→
   350→**Session ID:** \`${sessionId}\`
   351→**Iteration:** ${iteration} of ${maxLoops}
   352→**Phase:** Post-task reflection
   353→
   354→## Instructions
   355→
   356→Run the reflect skill in loop mode:
   357→
   358→\`\`\`
   359→/reflect loop
   360→\`\`\`
   361→
   362→Loop mode means: high-confidence captures only, must search existing before capturing, no user prompts.
   363→${
   364→  isFinal
   365→    ? `
   366→**FINAL ITERATION** - This is the last chance to capture insights from this session.
   367→`
   368→    : ""
   369→}
   370→Exit when reflection is complete.
   371→`;
   372→}
