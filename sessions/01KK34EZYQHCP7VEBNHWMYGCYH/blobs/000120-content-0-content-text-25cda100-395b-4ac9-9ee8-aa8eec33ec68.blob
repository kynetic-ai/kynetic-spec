   740→// ============================================================
   741→// Plans API Functions
   742→// AC: @ui-plans-view ac-1
   743→// ============================================================
   744→
   745→/**
   746→ * Fetch plans with optional status filter
   747→ * AC: @ui-plans-view ac-1
   748→ */
   749→export async function fetchPlans(params?: {
   750→	status?: string;
   751→}): Promise<{ items: PlanSummary[]; total: number }> {
   752→	if (isStaticMode()) {
   753→		return fetchPlansStatic(params);
   754→	}
   755→
   756→	const url = new URL(`${API_BASE}/api/plans`);
   757→
   758→	if (params) {
   759→		Object.entries(params).forEach(([key, value]) => {
   760→			if (value !== undefined && value !== '') {
   761→				url.searchParams.set(key, String(value));
   762→			}
   763→		});
   764→	}
   765→
   766→	const response = await fetch(url.toString(), {
   767→		headers: getProjectHeaders()
   768→	});
   769→	if (!response.ok) {
   770→		await handleResponseError(response);
   771→	}
   772→
   773→	return response.json();
   774→}
