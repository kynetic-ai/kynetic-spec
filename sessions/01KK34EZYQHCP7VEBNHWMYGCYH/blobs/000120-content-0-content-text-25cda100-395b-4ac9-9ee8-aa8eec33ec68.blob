   490→/**
   491→ * Search across all entities
   492→ * AC: @web-dashboard ac-24
   493→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   494→ * AC: @gh-pages-export ac-11 - Static mode support
   495→ */
   496→export async function search(query: string): Promise<SearchResponse> {
   497→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   498→	if (isStaticMode()) {
   499→		return searchStatic(query);
   500→	}
   501→
   502→	const url = new URL(`${API_BASE}/api/search`);
   503→	url.searchParams.set('q', query);
   504→
   505→	const response = await fetch(url.toString(), {
   506→		headers: getProjectHeaders()
   507→	});
   508→	if (!response.ok) {
   509→		await handleResponseError(response);
   510→	}
   511→
   512→	return response.json();
   513→}
