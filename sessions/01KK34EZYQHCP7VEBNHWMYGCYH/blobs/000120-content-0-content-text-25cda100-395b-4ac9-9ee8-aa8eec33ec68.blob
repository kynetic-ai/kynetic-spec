   776→// ============================================================
   777→// Session API Functions
   778→// AC: @ui-session-stream ac-1, ac-2, ac-4
   779→// ============================================================
   780→
   781→/**
   782→ * Session summary from the daemon API.
   783→ */
   784→export interface SessionSummary {
   785→	id: string;
   786→	status: 'active' | 'completed' | 'abandoned' | 'timed_out' | 'failed';
   787→	agent_type: string;
   788→	session_type: 'loop' | 'invocation';
   789→	/** Dispatch trigger for distinguishing dispatched agent vs manual CLI run. */
   790→	trigger?: string;
   791→	/** Task ID being worked on (if any). AC: @ui-session-history ac-1 */
   792→	task_id?: string;
   793→	started_at: string;
   794→	ended_at?: string;
   795→	duration_ms: number;
   796→	event_count: number;
   797→	iteration_count: number;
   798→	tasks_completed: number;
   799→}
   800→
   801→/**
   802→ * Spec context with acceptance criteria checklist.
   803→ * AC: @ui-session-stream ac-4
   804→ */
   805→export interface SessionSpecContext {
   806→	spec_ref: string;
   807→	title: string;
   808→	acceptance_criteria: Array<{ id: string; description: string }>;
   809→}
   810→
   811→/**
   812→ * Session budget info.
   813→ * AC: @ui-session-stream ac-4
   814→ */
   815→export interface SessionBudget {
   816→	max_per_cycle: number;
   817→	started_this_cycle: number;
   818→}
   819→
   820→/**
   821→ * Session detail with additional metadata.
   822→ * AC: @ui-session-stream ac-4
   823→ */
   824→export interface SessionDetail extends SessionSummary {
   825→	task_id?: string;
   826→	agent_id?: string;
   827→	trigger?: string;
   828→	spec_context?: SessionSpecContext | null;
   829→	budget?: SessionBudget | null;
   830→}
   831→
   832→/**
   833→ * A single event from events.jsonl.
   834→ */
   835→export interface SessionEvent {
   836→	ts: number;
   837→	seq: number;
   838→	type: string;
   839→	session_id: string;
   840→	trace_id?: string;
   841→	data: unknown;
   842→}
   843→
   844→/**
   845→ * Fetch all sessions with summaries.
   846→ * AC: @ui-session-stream ac-1
   847→ */
   848→export async function fetchSessions(): Promise<{ items: SessionSummary[]; total: number }> {
   849→	if (isStaticMode()) {
   850→		return { items: [], total: 0 };
   851→	}
   852→
   853→	const response = await fetch(`${API_BASE}/api/sessions`, {
   854→		headers: getProjectHeaders()
   855→	});
   856→	if (!response.ok) {
   857→		await handleResponseError(response);
   858→	}
   859→
   860→	return response.json();
   861→}
   862→
   863→/**
   864→ * Fetch a single session by ID.
   865→ * AC: @ui-session-stream ac-4
   866→ */
   867→export async function fetchSession(id: string): Promise<SessionDetail> {
   868→	if (isStaticMode()) {
   869→		throw new Error('Session data not available in static mode');
   870→	}
   871→
   872→	const response = await fetch(`${API_BASE}/api/sessions/${id}`, {
   873→		headers: getProjectHeaders()
   874→	});
   875→	if (!response.ok) {
   876→		await handleResponseError(response);
   877→	}
   878→
   879→	return response.json();
   880→}
   881→
   882→/**
   883→ * Fetch session events (optionally incremental via since_seq).
   884→ * AC: @ui-session-stream ac-1, ac-2
   885→ */
   886→export async function fetchSessionEvents(
   887→	id: string,
   888→	sinceSeq?: number
   889→): Promise<{ events: SessionEvent[]; total: number }> {
   890→	if (isStaticMode()) {
   891→		return { events: [], total: 0 };
   892→	}
   893→
   894→	const url = new URL(`${API_BASE}/api/sessions/${id}/events`);
   895→	if (sinceSeq !== undefined) {
   896→		url.searchParams.set('since_seq', String(sinceSeq));
   897→	}
   898→
   899→	const response = await fetch(url.toString(), {
   900→		headers: getProjectHeaders()
   901→	});
   902→	if (!response.ok) {
   903→		await handleResponseError(response);
   904→	}
   905→
   906→	return response.json();
   907→}
