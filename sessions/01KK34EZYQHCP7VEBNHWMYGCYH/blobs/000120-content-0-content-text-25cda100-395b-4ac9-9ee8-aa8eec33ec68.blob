   909→// ============================================================
   910→// Validation & Alignment API Functions
   911→// AC: @ui-validation-view ac-1
   912→// ============================================================
   913→
   914→export interface SchemaValidationError {
   915→	file: string;
   916→	path?: string;
   917→	message: string;
   918→	details?: unknown;
   919→}
   920→
   921→export interface RefValidationError {
   922→	ref: string;
   923→	sourceFile?: string;
   924→	sourceUlid?: string;
   925→	field: string;
   926→	error: 'not_found' | 'ambiguous' | 'duplicate_slug';
   927→	message: string;
   928→}
   929→
   930→export interface RefValidationWarning {
   931→	ref: string;
   932→	sourceFile?: string;
   933→	sourceUlid?: string;
   934→	field: string;
   935→	warning: 'deprecated_target';
   936→	message: string;
   937→}
   938→
   939→export interface OrphanItem {
   940→	ulid: string;
   941→	title: string;
   942→	type: string;
   943→	file?: string;
   944→}
   945→
   946→export type CompletenessWarningType =
   947→	| 'missing_acceptance_criteria'
   948→	| 'missing_description'
   949→	| 'status_inconsistency'
   950→	| 'missing_test_coverage'
   951→	| 'automation_eligible_no_spec'
   952→	| 'ac_schema_field_mismatch';
   953→
   954→export interface CompletenessWarning {
   955→	type: CompletenessWarningType;
   956→	subtype?: 'own_ac' | 'trait_ac';
   957→	itemRef: string;
   958→	itemTitle: string;
   959→	message: string;
   960→	details?: string;
   961→}
   962→
   963→export interface TraitCycleError {
   964→	traitRef: string;
   965→	traitTitle: string;
   966→	cycle: string[];
   967→	message: string;
   968→}
   969→
   970→export interface ValidationResponse {
   971→	valid: boolean;
   972→	schemaErrors: SchemaValidationError[];
   973→	refErrors: RefValidationError[];
   974→	refWarnings: RefValidationWarning[];
   975→	orphans: OrphanItem[];
   976→	completenessWarnings: CompletenessWarning[];
   977→	traitCycles: TraitCycleError[];
   978→}
   979→
   980→/** Alias for backward compatibility with dashboard overview */
   981→export type ValidationResult = ValidationResponse;
   982→
   983→export interface AlignmentWarning {
   984→	type: 'orphaned_spec' | 'status_mismatch' | 'stale_implementation';
   985→	specUlid?: string;
   986→	specTitle?: string;
   987→	taskUlid?: string;
   988→	message: string;
   989→}
   990→
   991→export interface AlignmentStats {
   992→	totalSpecs: number;
   993→	specsWithTasks: number;
   994→	alignedSpecs: number;
   995→	orphanedSpecs: number;
   996→}
   997→
   998→export interface AlignmentResponse {
   999→	stats: AlignmentStats;
  1000→	warnings: AlignmentWarning[];
  1001→}
  1002→
  1003→/**
  1004→ * Fetch validation results
  1005→ * AC: @ui-validation-view ac-1
  1006→ */
  1007→export async function fetchValidation(): Promise<ValidationResponse> {
  1008→	if (isStaticMode()) {
  1009→		return {
  1010→			valid: true,
  1011→			schemaErrors: [],
  1012→			refErrors: [],
  1013→			refWarnings: [],
  1014→			orphans: [],
  1015→			completenessWarnings: [],
  1016→			traitCycles: []
  1017→		};
  1018→	}
  1019→
  1020→	const response = await fetch(`${API_BASE}/api/validate`, {
  1021→		headers: getProjectHeaders()
  1022→	});
  1023→	if (!response.ok) {
  1024→		await handleResponseError(response);
  1025→	}
  1026→
  1027→	return response.json();
  1028→}
  1029→
  1030→/**
  1031→ * Fetch alignment stats and warnings
  1032→ * AC: @ui-validation-view ac-1
  1033→ */
  1034→export async function fetchAlignment(): Promise<AlignmentResponse> {
  1035→	if (isStaticMode()) {
  1036→		return {
  1037→			stats: { totalSpecs: 0, specsWithTasks: 0, alignedSpecs: 0, orphanedSpecs: 0 },
  1038→			warnings: []
  1039→		};
  1040→	}
  1041→
  1042→	const response = await fetch(`${API_BASE}/api/alignment`, {
  1043→		headers: getProjectHeaders()
  1044→	});
  1045→	if (!response.ok) {
  1046→		await handleResponseError(response);
  1047→	}
  1048→
  1049→	return response.json();
  1050→}
