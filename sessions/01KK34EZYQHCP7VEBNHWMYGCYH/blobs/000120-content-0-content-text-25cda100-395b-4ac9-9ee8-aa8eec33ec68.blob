   259→/**
   260→ * Fetch spec items with optional filters
   261→ * AC: @web-dashboard ac-11
   262→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   263→ * AC: @gh-pages-export ac-11 - Static mode support
   264→ */
   265→export async function fetchItems(params?: {
   266→	type?: string | string[];
   267→	tag?: string;
   268→	plan?: string;
   269→	limit?: number;
   270→	offset?: number;
   271→}): Promise<PaginatedResponse<ItemSummary>> {
   272→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   273→	if (isStaticMode()) {
   274→		return fetchItemsStatic(params);
   275→	}
   276→
   277→	const url = new URL(`${API_BASE}/api/items`);
   278→
   279→	if (params) {
   280→		Object.entries(params).forEach(([key, value]) => {
   281→			if (value !== undefined && value !== '') {
   282→				if (Array.isArray(value)) {
   283→					value.forEach((v) => url.searchParams.append(key, String(v)));
   284→				} else {
   285→					url.searchParams.set(key, String(value));
   286→				}
   287→			}
   288→		});
   289→	}
   290→
   291→	const response = await fetch(url.toString(), {
   292→		headers: getProjectHeaders()
   293→	});
   294→	if (!response.ok) {
   295→		await handleResponseError(response);
   296→	}
   297→
   298→	return response.json();
   299→}
