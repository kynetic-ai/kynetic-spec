     1→/**
     2→ * E2E API Tests for Daemon Tasks Endpoints
     3→ *
     4→ * Tests verify actual HTTP behavior by calling the running daemon directly.
     5→ * These replace the static analysis tests in tests/daemon-api-tasks.test.ts
     6→ * which only read source files and check string patterns.
     7→ *
     8→ * Covered ACs:
     9→ * - @api-contract ac-2: GET /api/tasks returns tasks with expected fields
    10→ * - @api-contract ac-3: GET /api/tasks?status filter (multi-value)
    11→ * - @api-contract ac-4: GET /api/tasks pagination {items, total, offset, limit}
    12→ * - @api-contract ac-5: GET /api/tasks/:ref returns full task with notes, todos, deps
    13→ * - @api-contract ac-6: POST /api/tasks/:ref/start transitions to in_progress
    14→ * - @api-contract ac-7: POST /api/tasks/:ref/note appends note
    15→ */
    16→
    17→import { test, expect } from '../fixtures/test-base';
    18→
    19→const DAEMON_URL = 'http://localhost:3456';
    20→
    21→test.describe('Tasks API', () => {
    22→  // Ensure daemon is running for all tests via fixture
    23→  test.beforeEach(async ({ daemon }) => {
    24→    // daemon fixture ensures daemon is running
    25→  });
    26→
    27→  test.describe('GET /api/tasks', () => {
    28→    // AC: @api-contract ac-2
    29→    test('returns tasks with required fields', async ({ request, daemon }) => {
    30→      const response = await request.get(`${DAEMON_URL}/api/tasks`);
    31→
    32→      expect(response.status()).toBe(200);
    33→
    34→      const body = await response.json();
    35→
    36→      // Response should have items array (paginated format)
    37→      expect(body).toHaveProperty('items');
    38→      expect(body).toHaveProperty('total');
    39→      expect(body).toHaveProperty('offset');
    40→      expect(body).toHaveProperty('limit');
    41→      expect(Array.isArray(body.items)).toBe(true);
    42→      expect(body.items.length).toBeGreaterThan(0);
    43→
    44→      // Each task should have required fields
    45→      const task = body.items[0];
    46→      expect(task).toHaveProperty('_ulid');
    47→      expect(task).toHaveProperty('title');
    48→      expect(task).toHaveProperty('status');
    49→      expect(task).toHaveProperty('priority');
    50→      // notes_count is derived field
    51→      expect(task).toHaveProperty('notes_count');
    52→    });
    53→
    54→    // AC: @api-contract ac-2 - spec_ref field
    55→    test('returns tasks with spec_ref field when present', async ({ request, daemon }) => {
    56→      const response = await request.get(`${DAEMON_URL}/api/tasks`);
    57→      expect(response.status()).toBe(200);
    58→
    59→      const body = await response.json();
    60→      expect(Array.isArray(body.items)).toBe(true);
    61→
    62→      // Find a task with spec_ref
    63→      const taskWithSpecRef = body.items.find(
    64→        (t: { spec_ref?: string }) => t.spec_ref !== undefined && t.spec_ref !== null
    65→      );
    66→      if (taskWithSpecRef) {
    67→        expect(typeof taskWithSpecRef.spec_ref).toBe('string');
    68→        expect(taskWithSpecRef.spec_ref).toMatch(/^@/);
    69→      }
    70→    });
    71→
    72→    // AC: @api-contract ac-3 - status filter (single value)
    73→    test('filters tasks by single status value', async ({ request, daemon }) => {
    74→      const response = await request.get(`${DAEMON_URL}/api/tasks?status=pending`);
    75→      expect(response.status()).toBe(200);
    76→
    77→      const body = await response.json();
    78→      expect(Array.isArray(body.items)).toBe(true);
    79→
    80→      // All returned tasks should have pending status
    81→      for (const task of body.items) {
    82→        expect(task.status).toBe('pending');
    83→      }
    84→    });
    85→
    86→    // AC: @api-contract ac-3 - status filter (multi-value)
    87→    test('filters tasks by multiple status values', async ({ request, daemon }) => {
    88→      const response = await request.get(
    89→        `${DAEMON_URL}/api/tasks?status=pending&status=in_progress`
    90→      );
    91→      expect(response.status()).toBe(200);
    92→
    93→      const body = await response.json();
    94→      expect(Array.isArray(body.items)).toBe(true);
    95→
    96→      // All returned tasks should have pending or in_progress status
    97→      for (const task of body.items) {
    98→        expect(['pending', 'in_progress']).toContain(task.status);
    99→      }
   100→    });
   101→
   102→    // AC: @api-contract ac-3 - comma-separated status filter
   103→    test('filters tasks by comma-separated status values', async ({ request, daemon }) => {
   104→      const response = await request.get(
   105→        `${DAEMON_URL}/api/tasks?status=pending,in_progress`
   106→      );
   107→      expect(response.status()).toBe(200);
   108→
   109→      const body = await response.json();
   110→      expect(Array.isArray(body.items)).toBe(true);
   111→
   112→      // All returned tasks should match the filter
   113→      for (const task of body.items) {
   114→        expect(['pending', 'in_progress']).toContain(task.status);
   115→      }
   116→    });
   117→
   118→    // AC: @api-contract ac-4 - pagination shape
   119→    test('returns paginated response with {items, total, offset, limit}', async ({
   120→      request,
   121→      daemon,
   122→    }) => {
   123→      const response = await request.get(`${DAEMON_URL}/api/tasks?offset=0&limit=2`);
   124→      expect(response.status()).toBe(200);
   125→
   126→      const body = await response.json();
   127→      expect(body).toHaveProperty('items');
   128→      expect(body).toHaveProperty('total');
   129→      expect(body).toHaveProperty('offset');
   130→      expect(body).toHaveProperty('limit');
   131→
   132→      expect(typeof body.total).toBe('number');
   133→      expect(body.offset).toBe(0);
   134→      expect(body.limit).toBe(2);
   135→      expect(body.items.length).toBeLessThanOrEqual(2);
   136→    });
   137→
   138→    // AC: @api-contract ac-4 - pagination offset
   139→    test('respects offset parameter for pagination', async ({ request, daemon }) => {
   140→      // Get first page
   141→      const page1 = await request.get(`${DAEMON_URL}/api/tasks?offset=0&limit=2`);
   142→      expect(page1.status()).toBe(200);
   143→      const body1 = await page1.json();
   144→
   145→      // Get second page
   146→      const page2 = await request.get(`${DAEMON_URL}/api/tasks?offset=2&limit=2`);
   147→      expect(page2.status()).toBe(200);
   148→      const body2 = await page2.json();
   149→
   150→      if (body1.total > 2) {
   151→        // Pages should have different items
   152→        const ids1 = body1.items.map((t: { _ulid: string }) => t._ulid);
   153→        const ids2 = body2.items.map((t: { _ulid: string }) => t._ulid);
   154→        // No overlap between pages
   155→        for (const id of ids2) {
   156→          expect(ids1).not.toContain(id);
   157→        }
   158→      }
   159→    });
   160→
   161→    // AC: @api-contract ac-4 - total count is consistent
   162→    test('total count is consistent across paginated requests', async ({ request, daemon }) => {
   163→      const response1 = await request.get(`${DAEMON_URL}/api/tasks?offset=0&limit=2`);
   164→      const response2 = await request.get(`${DAEMON_URL}/api/tasks?offset=2&limit=2`);
   165→
   166→      const body1 = await response1.json();
   167→      const body2 = await response2.json();
   168→
   169→      // Total should be the same across pages
   170→      expect(body1.total).toBe(body2.total);
   171→    });
   172→  });
   173→
   174→  test.describe('GET /api/tasks/:ref', () => {
   175→    // AC: @api-contract ac-5 - resolve by slug
   176→    test('resolves task by slug and returns full task', async ({ request, daemon }) => {
   177→      // Use a known task slug from fixtures
   178→      const response = await request.get(`${DAEMON_URL}/api/tasks/@test-task-ready`);
   179→      expect(response.status()).toBe(200);
   180→
   181→      const task = await response.json();
   182→      expect(task).toHaveProperty('_ulid');
   183→      expect(task).toHaveProperty('title');
   184→      expect(task).toHaveProperty('status');
   185→      expect(task).toHaveProperty('priority');
   186→      expect(task).toHaveProperty('notes');
   187→      expect(task).toHaveProperty('todos');
   188→      expect(task).toHaveProperty('depends_on');
   189→    });
   190→
   191→    // AC: @api-contract ac-5 - returns notes array
   192→    test('returns task with notes array', async ({ request, daemon }) => {
   193→      // test-task-in-progress has a note in the fixture
   194→      const response = await request.get(`${DAEMON_URL}/api/tasks/@test-task-in-progress`);
   195→      expect(response.status()).toBe(200);
   196→
   197→      const task = await response.json();
   198→      expect(Array.isArray(task.notes)).toBe(true);
   199→      expect(task.notes.length).toBeGreaterThan(0);
   200→
   201→      const note = task.notes[0];
   202→      expect(note).toHaveProperty('_ulid');
   203→      expect(note).toHaveProperty('content');
   204→      expect(note).toHaveProperty('created_at');
   205→    });
   206→
   207→    // AC: @api-contract ac-5 - returns dependencies
   208→    test('returns task with depends_on array', async ({ request, daemon }) => {
   209→      // test-task-blocked depends on test-task-ready
   210→      const response = await request.get(`${DAEMON_URL}/api/tasks/@test-task-blocked`);
   211→      expect(response.status()).toBe(200);
   212→
   213→      const task = await response.json();
   214→      expect(Array.isArray(task.depends_on)).toBe(true);
   215→      expect(task.depends_on.length).toBeGreaterThan(0);
   216→    });
   217→
   218→    // AC: @api-contract ac-5 - resolve by ULID
   219→    test('resolves task by ULID prefix', async ({ request, daemon }) => {
   220→      // First get the task to find its ULID
   221→      const listResponse = await request.get(`${DAEMON_URL}/api/tasks`);
   222→      const body = await listResponse.json();
   223→      expect(body.items.length).toBeGreaterThan(0);
   224→
   225→      const firstTask = body.items[0];
   226→      // Get by full ULID
   227→      const response = await request.get(`${DAEMON_URL}/api/tasks/@${firstTask._ulid}`);
   228→      expect(response.status()).toBe(200);
   229→
   230→      const task = await response.json();
   231→      expect(task._ulid).toBe(firstTask._ulid);
   232→    });
   233→
   234→    // AC: @api-contract ac-5 (error handling) - 404 for invalid ref
   235→    test('returns 404 for non-existent task ref', async ({ request, daemon }) => {
   236→      const response = await request.get(`${DAEMON_URL}/api/tasks/@nonexistent-task-xyz`);
   237→      expect(response.status()).toBe(404);
   238→
   239→      const body = await response.json();
   240→      expect(body).toHaveProperty('error');
   241→      expect(body.error).toBe('not_found');
   242→    });
   243→  });
   244→
   245→  test.describe('POST /api/tasks/:ref/start', () => {
   246→    // AC: @api-contract ac-6 - transition to in_progress
   247→    test('transitions pending task to in_progress', async ({ request, daemon }) => {
   248→      // Use a fresh fixture — test-task-ready starts as pending
   249→      const startResponse = await request.post(
   250→        `${DAEMON_URL}/api/tasks/@test-task-ready/start`,
   251→        { data: {} }
   252→      );
   253→      expect(startResponse.status()).toBe(200);
   254→
   255→      const updatedTask = await startResponse.json();
   256→      expect(updatedTask.status).toBe('in_progress');
   257→      expect(updatedTask).toHaveProperty('started_at');
   258→      expect(updatedTask.started_at).toBeTruthy();
   259→    });
   260→
   261→    // AC: @api-contract ac-6 - returns updated task
   262→    test('returns the updated task in response', async ({ request, daemon }) => {
   263→      // Start a pending task and verify response shape
   264→      // Use test-task-ready (may already be in_progress from previous test, which is ok — we
   265→      // just need the response to have the right shape; if already started, this will 409)
   266→      const startResponse = await request.post(
   267→        `${DAEMON_URL}/api/tasks/@test-task-pending-review/start`,
   268→        { data: {} }
   269→      );
   270→
   271→      // Could be 200 (transitioned) or 409 (already in wrong state)
   272→      if (startResponse.status() === 200) {
   273→        const task = await startResponse.json();
   274→        expect(task).toHaveProperty('_ulid');
   275→        expect(task).toHaveProperty('status');
   276→        expect(task).toHaveProperty('title');
   277→      } else if (startResponse.status() === 409) {
   278→        // Acceptable - task is in a state that can't transition to in_progress
   279→        const body = await startResponse.json();
   280→        expect(body).toHaveProperty('error');
   281→        expect(body.error).toBe('invalid_transition');
   282→        expect(body).toHaveProperty('current');
   283→        expect(body).toHaveProperty('valid_transitions');
   284→      }
   285→    });
   286→
   287→    // AC: @api-contract ac-6 (error handling) - 404 for invalid ref
   288→    test('returns 404 for non-existent task', async ({ request, daemon }) => {
   289→      const response = await request.post(
   290→        `${DAEMON_URL}/api/tasks/@nonexistent-task-xyz/start`,
   291→        { data: {} }
   292→      );
   293→      expect(response.status()).toBe(404);
   294→
   295→      const body = await response.json();
   296→      expect(body.error).toBe('not_found');
   297→    });
   298→
   299→    // AC: @api-contract ac-6 (error handling) - 409 for invalid state transition
   300→    test('returns 409 with transition info for invalid state transition', async ({
   301→      request,
   302→      daemon,
   303→    }) => {
   304→      // test-task-completed is in completed state — cannot be started
   305→      const response = await request.post(
   306→        `${DAEMON_URL}/api/tasks/@test-task-completed/start`,
   307→        { data: {} }
   308→      );
   309→      expect(response.status()).toBe(409);
   310→
   311→      const body = await response.json();
   312→      expect(body).toHaveProperty('error');
   313→      expect(body.error).toBe('invalid_transition');
   314→      expect(body).toHaveProperty('current');
   315→      expect(body).toHaveProperty('valid_transitions');
   316→      expect(Array.isArray(body.valid_transitions)).toBe(true);
   317→    });
   318→  });
   319→
   320→  test.describe('POST /api/tasks/:ref/note', () => {
   321→    // AC: @api-contract ac-7 - append note
   322→    test('appends note to task and returns updated task', async ({ request, daemon }) => {
   323→      const noteContent = `E2E test note ${Date.now()}`;
   324→      const response = await request.post(
   325→        `${DAEMON_URL}/api/tasks/@test-task-in-progress/note`,
   326→        {
   327→          data: { content: noteContent, author: '@test' },
   328→        }
   329→      );
   330→      expect(response.status()).toBe(200);
   331→
   332→      const updatedTask = await response.json();
   333→      expect(updatedTask).toHaveProperty('notes');
   334→      expect(Array.isArray(updatedTask.notes)).toBe(true);
   335→
   336→      // The new note should be in the notes array
   337→      const addedNote = updatedTask.notes.find(
   338→        (n: { content: string }) => n.content === noteContent
   339→      );
   340→      expect(addedNote).toBeDefined();
   341→      expect(addedNote.content).toBe(noteContent);
   342→    });
   343→
   344→    // AC: @api-contract ac-7 - note has required fields
   345→    test('created note has ulid, content, created_at', async ({ request, daemon }) => {
   346→      const noteContent = `Note field check ${Date.now()}`;
   347→      const response = await request.post(
   348→        `${DAEMON_URL}/api/tasks/@test-task-in-progress/note`,
   349→        {
   350→          data: { content: noteContent },
   351→        }
   352→      );
   353→      expect(response.status()).toBe(200);
   354→
   355→      const updatedTask = await response.json();
   356→      const notes = updatedTask.notes;
   357→      const newNote = notes[notes.length - 1]; // most recently added note
   358→
   359→      expect(newNote).toHaveProperty('_ulid');
   360→      expect(newNote).toHaveProperty('content');
   361→      expect(newNote).toHaveProperty('created_at');
   362→      expect(typeof newNote._ulid).toBe('string');
   363→      expect(newNote._ulid.length).toBeGreaterThan(0);
   364→    });
   365→
   366→    // AC: @api-contract ac-7 (error handling) - 400 for missing content
   367→    test('returns 400 validation error when content is missing', async ({ request, daemon }) => {
   368→      const response = await request.post(
   369→        `${DAEMON_URL}/api/tasks/@test-task-in-progress/note`,
   370→        { data: {} }
   371→      );
   372→      expect(response.status()).toBe(400);
   373→
   374→      const body = await response.json();
   375→      expect(body).toHaveProperty('error');
   376→      expect(body.error).toBe('validation_error');
   377→    });
   378→
   379→    // AC: @api-contract ac-7 (error handling) - 404 for invalid ref
   380→    test('returns 404 for non-existent task', async ({ request, daemon }) => {
   381→      const response = await request.post(
   382→        `${DAEMON_URL}/api/tasks/@nonexistent-task-xyz/note`,
   383→        { data: { content: 'test note' } }
   384→      );
   385→      expect(response.status()).toBe(404);
   386→
   387→      const body = await response.json();
   388→      expect(body.error).toBe('not_found');
   389→    });
   390→  });
   391→
   392→  test.describe('Content-Type and Response Format', () => {
   393→    // AC: @api-contract ac-1 (partial) - JSON content type
   394→    test('returns JSON content type for all endpoints', async ({ request, daemon }) => {
   395→      const endpoints = [
   396→        { method: 'GET', url: `${DAEMON_URL}/api/tasks` },
   397→        { method: 'GET', url: `${DAEMON_URL}/api/tasks/@test-task-ready` },
   398→      ];
   399→
   400→      for (const endpoint of endpoints) {
   401→        const response = await request.get(endpoint.url);
   402→        const contentType = response.headers()['content-type'] || '';
   403→        expect(contentType).toContain('application/json');
   404→      }
   405→    });
   406→
   407→    // AC: @api-contract ac-2 - items have consistent shape across list and detail
   408→    test('list and detail responses have consistent task fields', async ({ request, daemon }) => {
   409→      // Get list
   410→      const listResponse = await request.get(`${DAEMON_URL}/api/tasks`);
   411→      const listBody = await listResponse.json();
   412→      expect(listBody.items.length).toBeGreaterThan(0);
   413→
   414→      const listTask = listBody.items[0];
   415→      const listRef = listTask._ulid || (listTask.slugs && listTask.slugs[0]);
   416→      expect(listRef).toBeTruthy();
   417→
   418→      // Get detail
   419→      const detailResponse = await request.get(`${DAEMON_URL}/api/tasks/@${listRef}`);
   420→      expect(detailResponse.status()).toBe(200);
   421→      const detailTask = await detailResponse.json();
   422→
   423→      // Core fields should be consistent
   424→      expect(detailTask._ulid).toBe(listTask._ulid);
   425→      expect(detailTask.title).toBe(listTask.title);
   426→      expect(detailTask.status).toBe(listTask.status);
   427→    });
   428→  });
   429→});
