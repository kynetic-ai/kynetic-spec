     1→/**
     2→ * E2E API Tests for Daemon Tasks Endpoints
     3→ *
     4→ * Tests verify actual HTTP behavior by calling the running daemon directly.
     5→ * These replace the static analysis tests in tests/daemon-api-tasks.test.ts
     6→ * which only read source files and check string patterns.
     7→ *
     8→ * Covered ACs:
     9→ * - @api-contract ac-2: GET /api/tasks returns tasks with expected fields
    10→ * - @api-contract ac-3: GET /api/tasks?status filter (multi-value)
    11→ * - @api-contract ac-4: GET /api/tasks pagination {items, total, offset, limit}
    12→ * - @api-contract ac-5: GET /api/tasks/:ref returns full task with notes, todos, deps
    13→ * - @api-contract ac-6: POST /api/tasks/:ref/start transitions to in_progress
    14→ * - @api-contract ac-7: POST /api/tasks/:ref/note appends note
    15→ */
    16→
    17→import { test, expect } from '../fixtures/test-base';
    18→
    19→const DAEMON_URL = 'http://localhost:3456';
    20→
    21→test.describe('Tasks API', () => {
    22→  test.describe('GET /api/tasks', () => {
    23→    // AC: @api-contract ac-2
    24→    test('returns tasks with required fields', async ({ request, daemon }) => {
    25→      const response = await request.get(`${DAEMON_URL}/api/tasks`);
    26→
    27→      expect(response.status()).toBe(200);
    28→
    29→      const body = await response.json();
    30→
    31→      // Response should have items array (paginated format)
    32→      expect(body).toHaveProperty('items');
    33→      expect(body).toHaveProperty('total');
    34→      expect(body).toHaveProperty('offset');
    35→      expect(body).toHaveProperty('limit');
    36→      expect(Array.isArray(body.items)).toBe(true);
    37→      expect(body.items.length).toBeGreaterThan(0);
    38→
    39→      // Each task should have required fields
    40→      const task = body.items[0];
    41→      expect(task).toHaveProperty('_ulid');
    42→      expect(task).toHaveProperty('title');
    43→      expect(task).toHaveProperty('status');
    44→      expect(task).toHaveProperty('priority');
    45→      // notes_count is derived field
    46→      expect(task).toHaveProperty('notes_count');
    47→    });
    48→
    49→    // AC: @api-contract ac-2 - spec_ref field
    50→    test('returns spec_ref on tasks that have it', async ({ request, daemon }) => {
    51→      const response = await request.get(`${DAEMON_URL}/api/tasks`);
    52→      expect(response.status()).toBe(200);
    53→
    54→      const body = await response.json();
    55→      expect(Array.isArray(body.items)).toBe(true);
    56→      // Fixtures include tasks with spec_ref — at least one must have it
    57→      expect(body.items.length).toBeGreaterThan(0);
    58→
    59→      // Find a task with spec_ref (fixture has tasks with @test-feature)
    60→      const taskWithSpecRef = body.items.find(
    61→        (t: { spec_ref?: string }) => t.spec_ref !== undefined && t.spec_ref !== null
    62→      );
    63→      expect(taskWithSpecRef).toBeDefined();
    64→      expect(typeof taskWithSpecRef.spec_ref).toBe('string');
    65→      expect(taskWithSpecRef.spec_ref).toMatch(/^@/);
    66→    });
    67→
    68→    // AC: @api-contract ac-3 - status filter (single value)
    69→    test('filters tasks by single status value', async ({ request, daemon }) => {
    70→      const response = await request.get(`${DAEMON_URL}/api/tasks?status=pending`);
    71→      expect(response.status()).toBe(200);
    72→
    73→      const body = await response.json();
    74→      expect(Array.isArray(body.items)).toBe(true);
    75→      // Fixtures have pending tasks
    76→      expect(body.items.length).toBeGreaterThan(0);
    77→
    78→      // All returned tasks should have pending status
    79→      for (const task of body.items) {
    80→        expect(task.status).toBe('pending');
    81→      }
    82→    });
    83→
    84→    // AC: @api-contract ac-3 - status filter (multi-value, repeated param)
    85→    test('filters tasks by multiple status values using repeated param', async ({
    86→      request,
    87→      daemon,
    88→    }) => {
    89→      const response = await request.get(
    90→        `${DAEMON_URL}/api/tasks?status=pending&status=in_progress`
    91→      );
    92→      expect(response.status()).toBe(200);
    93→
    94→      const body = await response.json();
    95→      expect(Array.isArray(body.items)).toBe(true);
    96→      // Fixtures have both pending and in_progress tasks
    97→      expect(body.items.length).toBeGreaterThan(0);
    98→
    99→      // All returned tasks should have pending or in_progress status
   100→      for (const task of body.items) {
   101→        expect(['pending', 'in_progress']).toContain(task.status);
   102→      }
   103→    });
   104→
   105→    // AC: @api-contract ac-3 - comma-separated status filter
   106→    test('filters tasks by comma-separated status values', async ({ request, daemon }) => {
   107→      const response = await request.get(
   108→        `${DAEMON_URL}/api/tasks?status=pending,in_progress`
   109→      );
   110→      expect(response.status()).toBe(200);
   111→
   112→      const body = await response.json();
   113→      expect(Array.isArray(body.items)).toBe(true);
   114→      // Fixtures have pending and in_progress tasks — filter must return non-empty
   115→      expect(body.items.length).toBeGreaterThan(0);
   116→
   117→      // All returned tasks should match the filter
   118→      for (const task of body.items) {
   119→        expect(['pending', 'in_progress']).toContain(task.status);
   120→      }
   121→    });
   122→
   123→    // AC: @api-contract ac-4 - pagination shape
   124→    test('returns paginated response with {items, total, offset, limit}', async ({
   125→      request,
   126→      daemon,
   127→    }) => {
   128→      const response = await request.get(`${DAEMON_URL}/api/tasks?offset=0&limit=2`);
   129→      expect(response.status()).toBe(200);
   130→
   131→      const body = await response.json();
   132→      expect(body).toHaveProperty('items');
   133→      expect(body).toHaveProperty('total');
   134→      expect(body).toHaveProperty('offset');
   135→      expect(body).toHaveProperty('limit');
   136→
   137→      expect(typeof body.total).toBe('number');
   138→      expect(body.offset).toBe(0);
   139→      expect(body.limit).toBe(2);
   140→      expect(body.items.length).toBeLessThanOrEqual(2);
   141→    });
   142→
   143→    // AC: @api-contract ac-4 - pagination offset
   144→    test('respects offset parameter for pagination', async ({ request, daemon }) => {
   145→      // Get first page
   146→      const page1 = await request.get(`${DAEMON_URL}/api/tasks?offset=0&limit=2`);
   147→      expect(page1.status()).toBe(200);
   148→      const body1 = await page1.json();
   149→
   150→      // Fixtures have 5 tasks — there must be more than 2 for pagination to be meaningful
   151→      expect(body1.total).toBeGreaterThan(2);
   152→      expect(body1.items.length).toBe(2);
   153→
   154→      // Get second page
   155→      const page2 = await request.get(`${DAEMON_URL}/api/tasks?offset=2&limit=2`);
   156→      expect(page2.status()).toBe(200);
   157→      const body2 = await page2.json();
   158→
   159→      // Pages should have different items
   160→      const ids1 = body1.items.map((t: { _ulid: string }) => t._ulid);
   161→      const ids2 = body2.items.map((t: { _ulid: string }) => t._ulid);
   162→      // No overlap between pages
   163→      for (const id of ids2) {
   164→        expect(ids1).not.toContain(id);
   165→      }
   166→    });
   167→
   168→    // AC: @api-contract ac-4 - total count is consistent
   169→    test('total count is consistent across paginated requests', async ({ request, daemon }) => {
   170→      const response1 = await request.get(`${DAEMON_URL}/api/tasks?offset=0&limit=2`);
   171→      const response2 = await request.get(`${DAEMON_URL}/api/tasks?offset=2&limit=2`);
   172→
   173→      const body1 = await response1.json();
   174→      const body2 = await response2.json();
   175→
   176→      // Total should be the same across pages
   177→      expect(body1.total).toBe(body2.total);
   178→    });
   179→  });
   180→
   181→  test.describe('GET /api/tasks/:ref', () => {
   182→    // AC: @api-contract ac-5 - resolve by slug
   183→    test('resolves task by slug and returns full task', async ({ request, daemon }) => {
   184→      // Use a known task slug from fixtures
   185→      const response = await request.get(`${DAEMON_URL}/api/tasks/@test-task-ready`);
   186→      expect(response.status()).toBe(200);
   187→
   188→      const task = await response.json();
   189→      expect(task).toHaveProperty('_ulid');
   190→      expect(task).toHaveProperty('title');
   191→      expect(task).toHaveProperty('status');
   192→      expect(task).toHaveProperty('priority');
   193→      expect(task).toHaveProperty('notes');
   194→      expect(task).toHaveProperty('todos');
   195→      expect(task).toHaveProperty('depends_on');
   196→    });
   197→
   198→    // AC: @api-contract ac-5 - returns notes array
   199→    test('returns task with notes array', async ({ request, daemon }) => {
   200→      // test-task-in-progress has a note in the fixture
   201→      const response = await request.get(`${DAEMON_URL}/api/tasks/@test-task-in-progress`);
   202→      expect(response.status()).toBe(200);
   203→
   204→      const task = await response.json();
   205→      expect(Array.isArray(task.notes)).toBe(true);
   206→      expect(task.notes.length).toBeGreaterThan(0);
   207→
   208→      const note = task.notes[0];
   209→      expect(note).toHaveProperty('_ulid');
   210→      expect(note).toHaveProperty('content');
   211→      expect(note).toHaveProperty('created_at');
   212→    });
   213→
   214→    // AC: @api-contract ac-5 - returns dependencies
   215→    test('returns task with depends_on array', async ({ request, daemon }) => {
   216→      // test-task-blocked depends on test-task-ready
   217→      const response = await request.get(`${DAEMON_URL}/api/tasks/@test-task-blocked`);
   218→      expect(response.status()).toBe(200);
   219→
   220→      const task = await response.json();
   221→      expect(Array.isArray(task.depends_on)).toBe(true);
   222→      expect(task.depends_on.length).toBeGreaterThan(0);
   223→    });
   224→
   225→    // AC: @api-contract ac-5 - resolve by full ULID
   226→    test('resolves task by full ULID', async ({ request, daemon }) => {
   227→      // First get the task list to find a ULID
   228→      const listResponse = await request.get(`${DAEMON_URL}/api/tasks`);
   229→      const body = await listResponse.json();
   230→      expect(body.items.length).toBeGreaterThan(0);
   231→
   232→      const firstTask = body.items[0];
   233→      expect(firstTask._ulid).toBeTruthy();
   234→
   235→      // Get by full ULID
   236→      const response = await request.get(`${DAEMON_URL}/api/tasks/@${firstTask._ulid}`);
   237→      expect(response.status()).toBe(200);
   238→
   239→      const task = await response.json();
   240→      expect(task._ulid).toBe(firstTask._ulid);
   241→      expect(task.title).toBe(firstTask.title);
   242→    });
   243→
   244→    // AC: @api-contract ac-5 (error handling) - 404 for invalid ref
   245→    test('returns 404 for non-existent task ref', async ({ request, daemon }) => {
   246→      const response = await request.get(`${DAEMON_URL}/api/tasks/@nonexistent-task-xyz`);
   247→      expect(response.status()).toBe(404);
   248→
   249→      const body = await response.json();
   250→      expect(body).toHaveProperty('error');
   251→      expect(body.error).toBe('not_found');
   252→    });
   253→  });
   254→
   255→  test.describe('POST /api/tasks/:ref/start', () => {
   256→    // AC: @api-contract ac-6 - transition to in_progress
   257→    test('transitions pending task to in_progress', async ({ request, daemon }) => {
   258→      // Use a fresh fixture — test-task-ready starts as pending (daemon fixture is test-scoped)
   259→      const startResponse = await request.post(
   260→        `${DAEMON_URL}/api/tasks/@test-task-ready/start`,
   261→        { data: {} }
   262→      );
   263→      expect(startResponse.status()).toBe(200);
   264→
   265→      const updatedTask = await startResponse.json();
   266→      expect(updatedTask.status).toBe('in_progress');
   267→      expect(updatedTask).toHaveProperty('started_at');
   268→      expect(updatedTask.started_at).toBeTruthy();
   269→    });
   270→
   271→    // AC: @api-contract ac-6 - returns full task shape in response
   272→    test('response includes full task shape after start', async ({ request, daemon }) => {
   273→      // Each test gets a fresh daemon fixture (test-scoped), so test-task-ready is pending again
   274→      const startResponse = await request.post(
   275→        `${DAEMON_URL}/api/tasks/@test-task-ready/start`,
   276→        { data: {} }
   277→      );
   278→      // Fresh fixture — test-task-ready must be pending, so this must return 200
   279→      expect(startResponse.status()).toBe(200);
   280→
   281→      const task = await startResponse.json();
   282→      expect(task).toHaveProperty('_ulid');
   283→      expect(task).toHaveProperty('status');
   284→      expect(task.status).toBe('in_progress');
   285→      expect(task).toHaveProperty('title');
   286→      expect(task).toHaveProperty('started_at');
   287→    });
   288→
   289→    // AC: @api-contract ac-6 (error handling) - 404 for invalid ref
   290→    test('returns 404 for non-existent task', async ({ request, daemon }) => {
   291→      const response = await request.post(
   292→        `${DAEMON_URL}/api/tasks/@nonexistent-task-xyz/start`,
   293→        { data: {} }
   294→      );
   295→      expect(response.status()).toBe(404);
   296→
   297→      const body = await response.json();
   298→      expect(body.error).toBe('not_found');
   299→    });
   300→
   301→    // AC: @api-contract ac-6 (error handling) - 409 for invalid state transition
   302→    test('returns 409 with transition info for invalid state transition', async ({
   303→      request,
   304→      daemon,
   305→    }) => {
   306→      // test-task-completed is in completed state — cannot be started
   307→      const response = await request.post(
   308→        `${DAEMON_URL}/api/tasks/@test-task-completed/start`,
   309→        { data: {} }
   310→      );
   311→      expect(response.status()).toBe(409);
   312→
   313→      const body = await response.json();
   314→      expect(body).toHaveProperty('error');
   315→      expect(body.error).toBe('invalid_transition');
   316→      expect(body).toHaveProperty('current');
   317→      expect(body).toHaveProperty('valid_transitions');
   318→      expect(Array.isArray(body.valid_transitions)).toBe(true);
   319→    });
   320→  });
