   322→  test.describe('POST /api/tasks/:ref/note', () => {
   323→    // AC: @api-contract ac-7 - append note
   324→    // Route returns { success: true, note, task } shape
   325→    test('appends note to task and returns {success, note, task}', async ({ request, daemon }) => {
   326→      const noteContent = `E2E test note ${Date.now()}`;
   327→      const response = await request.post(
   328→        `${DAEMON_URL}/api/tasks/@test-task-in-progress/note`,
   329→        {
   330→          data: { content: noteContent, author: '@test' },
   331→        }
   332→      );
   333→      expect(response.status()).toBe(200);
   334→
   335→      const body = await response.json();
   336→      // Route returns { success: true, note, task }
   337→      expect(body).toHaveProperty('success');
   338→      expect(body.success).toBe(true);
   339→      expect(body).toHaveProperty('note');
   340→      expect(body).toHaveProperty('task');
   341→
   342→      // The note in the response should match what we sent
   343→      expect(body.note.content).toBe(noteContent);
   344→
   345→      // The task in the response should include our new note
   346→      expect(Array.isArray(body.task.notes)).toBe(true);
   347→      const addedNote = body.task.notes.find(
   348→        (n: { content: string }) => n.content === noteContent
   349→      );
   350→      expect(addedNote).toBeDefined();
   351→    });
   352→
   353→    // AC: @api-contract ac-7 - note has required fields
   354→    test('created note has _ulid, content, created_at', async ({ request, daemon }) => {
   355→      const noteContent = `Note field check ${Date.now()}`;
   356→      const response = await request.post(
   357→        `${DAEMON_URL}/api/tasks/@test-task-in-progress/note`,
   358→        {
   359→          data: { content: noteContent },
   360→        }
   361→      );
   362→      expect(response.status()).toBe(200);
   363→
   364→      const body = await response.json();
   365→      const note = body.note;
   366→
   367→      expect(note).toHaveProperty('_ulid');
   368→      expect(note).toHaveProperty('content');
   369→      expect(note).toHaveProperty('created_at');
   370→      expect(typeof note._ulid).toBe('string');
   371→      expect(note._ulid.length).toBeGreaterThan(0);
   372→      expect(note.content).toBe(noteContent);
   373→    });
   374→
   375→    // AC: @api-contract ac-7 (error handling) - 422 for missing content (Elysia schema validation)
   376→    // Elysia validates body schema before handler runs, returning 422 (not 400)
   377→    test('returns 422 validation error when content is missing', async ({ request, daemon }) => {
   378→      const response = await request.post(
