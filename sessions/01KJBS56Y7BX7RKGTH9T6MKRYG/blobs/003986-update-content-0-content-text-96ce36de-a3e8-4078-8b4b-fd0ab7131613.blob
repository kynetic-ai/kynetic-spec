   383→    });
   384→
   385→    // AC: @api-contract ac-7 (error handling) - 404 for invalid ref
   386→    test('returns 404 for non-existent task', async ({ request, daemon }) => {
   387→      const response = await request.post(
   388→        `${DAEMON_URL}/api/tasks/@nonexistent-task-xyz/note`,
   389→        { data: { content: 'test note' } }
   390→      );
   391→      expect(response.status()).toBe(404);
   392→
   393→      const body = await response.json();
   394→      expect(body.error).toBe('not_found');
   395→    });
   396→  });
   397→
   398→  test.describe('Content-Type and Response Format', () => {
   399→    // AC: @api-contract ac-1 (partial) - JSON content type for GET endpoints
   400→    test('returns JSON content type for GET endpoints', async ({ request, daemon }) => {
   401→      const responses = await Promise.all([
   402→        request.get(`${DAEMON_URL}/api/tasks`),
   403→        request.get(`${DAEMON_URL}/api/tasks/@test-task-ready`),
   404→      ]);
   405→
   406→      for (const response of responses) {
   407→        const contentType = response.headers()['content-type'] || '';
   408→        expect(contentType).toContain('application/json');
   409→      }
   410→    });
   411→
   412→    // AC: @api-contract ac-2 - items have consistent shape across list and detail
   413→    test('list and detail responses have consistent task fields', async ({ request, daemon }) => {
   414→      // Get list
   415→      const listResponse = await request.get(`${DAEMON_URL}/api/tasks`);
   416→      const listBody = await listResponse.json();
   417→      expect(listBody.items.length).toBeGreaterThan(0);
   418→
   419→      const listTask = listBody.items[0];
   420→      expect(listTask._ulid).toBeTruthy();
   421→
   422→      // Get detail by ULID
   423→      const detailResponse = await request.get(`${DAEMON_URL}/api/tasks/@${listTask._ulid}`);
   424→      expect(detailResponse.status()).toBe(200);
   425→      const detailTask = await detailResponse.json();
   426→
   427→      // Core fields should be consistent
