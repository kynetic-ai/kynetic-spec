     1→import { test, expect } from '../fixtures/test-base';
     2→
     3→/**
     4→ * Tasks View E2E Tests
     5→ *
     6→ * Tests for the tasks view in the web dashboard.
     7→ * These tests document expected behavior and will be enabled
     8→ * once the task UI components are implemented.
     9→ *
    10→ * Covered ACs:
    11→ * - AC-4: Task list displays with status, priority, spec_ref, notes count
    12→ * - AC-5: Task detail panel with notes, todos, dependencies
    13→ * - AC-6: Spec reference as clickable link
    14→ * - AC-7: Start Task button triggers state change
    15→ * - AC-8: Add Note form appends note
    16→ * - AC-9: Filter controls for status, type, tag, assignee, automation
    17→ * - AC-10: URL updates with filter params
    18→ * - AC-33: WebSocket updates highlight changed items
    19→ */
    20→
    21→test.describe('Tasks View', () => {
    22→  test.describe('Task List', () => {
    23→    // AC: @web-dashboard ac-4
    24→    test('displays task with title, status badge, priority, spec_ref, notes count', async ({
    25→      page,
    26→      daemon,
    27→    }) => {
    28→      await page.goto('/tasks');
    29→
    30→      // Wait for task list to load
    31→      const taskList = page.getByTestId('task-list');
    32→      await expect(taskList).toBeVisible();
    33→
    34→      // Find first task item
    35→      const taskItem = taskList.getByTestId('task-list-item').first();
    36→      await expect(taskItem).toBeVisible();
    37→
    38→      // Verify task displays all required fields
    39→      await expect(taskItem.getByTestId('task-title')).toBeVisible();
    40→      await expect(taskItem.getByTestId('task-status-badge')).toBeVisible();
    41→      await expect(taskItem.getByTestId('task-priority')).toBeVisible();
    42→      await expect(taskItem.getByTestId('task-spec-ref')).toBeVisible();
    43→      await expect(taskItem.getByTestId('task-notes-count')).toBeVisible();
    44→    });
    45→
    46→    // AC: @web-dashboard ac-9
    47→    test('filters tasks by status', async ({ page, daemon }) => {
    48→      await page.goto('/tasks');
    49→
    50→      // Wait for task list to load first (ensures page is ready)
    51→      const taskList = page.getByTestId('task-list');
    52→      await expect(taskList).toBeVisible();
    53→      const taskItems = page.getByTestId('task-list-item');
    54→      await expect(taskItems.first()).toBeVisible({ timeout: 10000 });
    55→
    56→      // Wait for filter controls
    57→      const filterStatus = page.getByTestId('filter-status');
    58→      await expect(filterStatus).toBeVisible();
    59→
    60→      // Select "pending" status
    61→      await filterStatus.click();
    62→      await page.getByRole('option', { name: 'Pending', exact: true }).click();
    63→
    64→      // Wait for URL to update with filter
    65→      await page.waitForURL(/status=pending/, { timeout: 10000 });
    66→
    67→      // Verify filtered results - should now show only pending tasks
    68→      await expect(taskItems.first()).toBeVisible({ timeout: 5000 });
    69→
    70→      // All visible tasks should have "pending" status badge
    71→      const count = await taskItems.count();
    72→      for (let i = 0; i < count; i++) {
    73→        const statusBadge = taskItems.nth(i).getByTestId('task-status-badge');
    74→        await expect(statusBadge).toContainText(/pending/i);
    75→      }
    76→    });
    77→
    78→    // AC: @web-dashboard ac-9
    79→    test('filters tasks by type', async ({ page, daemon }) => {
    80→      await page.goto('/tasks');
    81→
    82→      const filterType = page.getByTestId('filter-type');
    83→      await expect(filterType).toBeVisible();
    84→
    85→      // Select "task" type (use exact match to avoid matching "Subtask")
    86→      await filterType.click();
    87→      await page.getByRole('option', { name: 'Task', exact: true }).click();
    88→
    89→      // Wait for URL to update with filter
    90→      await page.waitForURL(/type=task/, { timeout: 5000 });
    91→
    92→      // Verify tasks displayed match selected type
    93→      const taskItems = page.getByTestId('task-list-item');
    94→      await expect(taskItems.first()).toBeVisible({ timeout: 5000 });
    95→    });
    96→
    97→    // AC: @web-dashboard ac-9
    98→    test('filters tasks by tag', async ({ page, daemon }) => {
    99→      await page.goto('/tasks');
   100→
   101→      // Wait for task list to load
   102→      const taskList = page.getByTestId('task-list');
   103→      await expect(taskList).toBeVisible();
   104→      await expect(page.getByTestId('task-list-item').first()).toBeVisible();
   105→
   106→      const filterTag = page.getByTestId('filter-tag');
   107→      await expect(filterTag).toBeVisible();
   108→
   109→      // Type a tag to filter using keyboard (triggers input events properly)
   110→      await filterTag.click();
   111→      await filterTag.pressSequentially('e2e', { delay: 50 });
   112→
   113→      // Wait for URL to update with filter
   114→      await page.waitForURL(/tag=e2e/, { timeout: 5000 });
   115→
   116→      // Verify filtered tasks have the selected tag
   117→      const taskItems = page.getByTestId('task-list-item');
   118→      await expect(taskItems.first()).toBeVisible({ timeout: 5000 });
   119→
   120→      const taskTags = taskItems.first().getByTestId('task-tags');
   121→      await expect(taskTags).toContainText(/e2e/i);
   122→    });
   123→
   124→    // AC: @web-dashboard ac-9
   125→    test('filters tasks by assignee', async ({ page, daemon }) => {
   126→      await page.goto('/tasks');
   127→
   128→      const filterAssignee = page.getByTestId('filter-assignee');
   129→      await expect(filterAssignee).toBeVisible();
   130→
   131→      // Type an assignee to filter (text input, not select)
   132→      // Note: Our test fixtures don't have assignees, so we test that filter works
   133→      // by checking we get no results for a non-existent assignee
   134→      await filterAssignee.fill('nonexistent');
   135→
   136→      // Wait for filter to apply
   137→      await page.waitForTimeout(500);
   138→
   139→      // Should show no results or "No tasks found"
   140→      const taskList = page.getByTestId('task-list');
   141→      await expect(taskList).toBeVisible();
   142→    });
   143→
   144→    // AC: @web-dashboard ac-9
   145→    test('filters tasks by automation status', async ({ page, daemon }) => {
   146→      await page.goto('/tasks');
   147→
   148→      const filterAutomation = page.getByTestId('filter-automation');
   149→      await expect(filterAutomation).toBeVisible();
   150→
   151→      // Select "eligible" automation status
   152→      await filterAutomation.click();
   153→      await page.getByRole('option', { name: 'Eligible' }).click();
   154→
   155→      // Verify filtered results show eligible tasks
   156→      const taskItems = page.getByTestId('task-list-item');
   157→      await expect(taskItems.first()).toBeVisible();
   158→    });
   159→
   160→    // AC: @web-dashboard ac-10
   161→    test('URL updates with filter query params', async ({ page, daemon }) => {
   162→      await page.goto('/tasks');
   163→
   164→      // Apply status filter
   165→      const filterStatus = page.getByTestId('filter-status');
   166→      await filterStatus.click();
   167→      await page.getByRole('option', { name: 'Pending', exact: true }).click();
   168→
   169→      // Wait for URL to update
   170→      await page.waitForURL(/\/tasks\?.*status=pending/);
   171→      expect(page.url()).toContain('status=pending');
   172→
   173→      // Apply tag filter (text input, not select)
   174→      const filterTag = page.getByTestId('filter-tag');
   175→      await filterTag.fill('e2e');
   176→
   177→      // URL should now include both filters
   178→      await page.waitForURL(/tag=e2e/);
   179→      expect(page.url()).toContain('status=pending');
   180→      expect(page.url()).toContain('tag=e2e');
   181→    });
   182→
   183→    // AC: @web-dashboard ac-10
   184→    test('restores filters from URL query params on page load', async ({ page, daemon }) => {
   185→      // Navigate directly with query params
   186→      await page.goto('/tasks?status=pending&tag=e2e');
   187→
   188→      // Wait for page to load and filters to be applied
   189→      // Select components show their value in the trigger text
   190→      const filterStatus = page.getByTestId('filter-status');
   191→      await expect(filterStatus).toContainText(/pending/i);
   192→
   193→      // Tag input should have the value
   194→      const filterTag = page.getByTestId('filter-tag');
   195→      await expect(filterTag).toHaveValue('e2e');
   196→
   197→      // Task list should show filtered results
   198→      const taskItems = page.getByTestId('task-list-item');
   199→      await expect(taskItems.first()).toBeVisible({ timeout: 5000 });
   200→    });
   201→  });
   202→
   203→  test.describe('Task Detail', () => {
   204→    // AC: @web-dashboard ac-5
   205→    test('opens detail panel when task clicked', async ({ page, daemon }) => {
   206→      // Capture console logs
   207→      const consoleLogs: string[] = [];
   208→      page.on('console', (msg) => {
   209→        consoleLogs.push(`${msg.type()}: ${msg.text()}`);
   210→      });
   211→
   212→      // Capture network requests
   213→      const apiCalls: string[] = [];
   214→      page.on('request', (request) => {
   215→        if (request.url().includes('/api/')) {
   216→          apiCalls.push(`${request.method()} ${request.url()}`);
   217→        }
   218→      });
   219→      page.on('response', (response) => {
   220→        if (response.url().includes('/api/')) {
   221→          apiCalls.push(`-> ${response.status()} ${response.url()}`);
   222→        }
   223→      });
   224→
   225→      await page.goto('/tasks');
   226→
   227→      // Wait for task list to load
   228→      const taskList = page.getByTestId('task-list');
   229→      await expect(taskList).toBeVisible();
   230→
   231→      // Wait for tasks to appear
   232→      const taskItem = page.getByTestId('task-list-item').first();
   233→      await expect(taskItem).toBeVisible();
   234→
   235→
   236→      // Click the first task
   237→      await taskItem.click();
   238→
   239→      // Wait briefly for API call and sheet animation
   240→      await page.waitForTimeout(2000);
   241→
   242→      // Debug output
   243→      console.log('=== Console logs ===');
   244→      consoleLogs.forEach(log => console.log(log));
   245→      console.log('=== API calls ===');
   246→      apiCalls.forEach(call => console.log(call));
   247→
   248→      // Detail panel should open
   249→      const detailPanel = page.getByTestId('task-detail-panel');
   250→      await expect(detailPanel).toBeVisible({ timeout: 5000 });
   251→
   252→      // Verify panel contains expected sections
   253→      await expect(detailPanel.getByTestId('task-description')).toBeVisible();
   254→      await expect(detailPanel.getByTestId('task-notes')).toBeVisible();
   255→    });
   256→
   257→    // AC: @web-dashboard ac-5
   258→    test('displays notes in chronological order', async ({ page, daemon }) => {
   259→      await page.goto('/tasks');
   260→
   261→      // Click task to open detail
   262→      const taskItem = page.getByTestId('task-list-item').first();
   263→      await taskItem.click();
   264→
   265→      // Get notes section
   266→      const notesSection = page.getByTestId('task-notes');
   267→      await expect(notesSection).toBeVisible();
   268→
   269→      // Notes should be ordered by timestamp
   270→      const noteItems = notesSection.getByTestId('note-item');
   271→      const count = await noteItems.count();
   272→
   273→      if (count > 1) {
   274→        // Check first note timestamp is earlier than last note timestamp
   275→        const firstNoteTime = await noteItems.first().getByTestId('note-timestamp').textContent();
   276→        const lastNoteTime = await noteItems.last().getByTestId('note-timestamp').textContent();
   277→        // Both should be present (chronological order validation)
   278→        expect(firstNoteTime).toBeTruthy();
   279→        expect(lastNoteTime).toBeTruthy();
   280→      }
   281→    });
   282→
   283→    // AC: @web-dashboard ac-5
   284→    test('displays todos and dependencies', async ({ page, daemon }) => {
   285→      await page.goto('/tasks');
   286→
   287→      // Click task to open detail
   288→      const taskItem = page.getByTestId('task-list-item').first();
   289→      await taskItem.click();
   290→
   291→      const detailPanel = page.getByTestId('task-detail-panel');
   292→      await expect(detailPanel).toBeVisible();
   293→
   294→      // Check for todos section (may be empty)
   295→      const todosSection = detailPanel.getByTestId('task-todos');
   296→      await expect(todosSection).toBeVisible();
   297→
   298→      // Check for dependencies section (may be empty)
   299→      const depsSection = detailPanel.getByTestId('task-dependencies');
   300→      await expect(depsSection).toBeVisible();
   301→    });
   302→
   303→    // AC: @web-dashboard ac-6
   304→    test('spec reference links to spec item detail', async ({ page, daemon }) => {
   305→      await page.goto('/tasks');
   306→
   307→      // Click task with spec_ref
   308→      const taskItem = page.getByTestId('task-list-item').first();
   309→      await taskItem.click();
   310→
   311→      const detailPanel = page.getByTestId('task-detail-panel');
   312→      await expect(detailPanel).toBeVisible();
   313→
   314→      const specRefLink = detailPanel.getByTestId('task-spec-ref-link');
   315→      await expect(specRefLink).toBeVisible();
   316→
   317→      // Click the actual anchor link within the spec ref container
   318→      const link = specRefLink.locator('a');
   319→      await expect(link).toBeVisible();
   320→      await link.click();
   321→
   322→      // Should navigate to items page with spec detail
   323→      await page.waitForURL(/\/items/, { timeout: 10000 });
   324→      expect(page.url()).toContain('/items');
   325→
   326→      // Spec detail panel should be visible (Sheet may need time to open)
   327→      const specDetailPanel = page.getByTestId('spec-detail-panel');
   328→      await expect(specDetailPanel).toBeVisible({ timeout: 5000 });
   329→    });
   330→  });
