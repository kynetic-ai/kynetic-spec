   454→      // Filter controls should adapt (may collapse to dropdown)
   455→      const filterControls = page.getByTestId('filter-controls');
   456→      await expect(filterControls).toBeVisible();
   457→    });
   458→
   459→    // AC: @web-dashboard ac-27
   460→    test('shows detail panel as slide-over on desktop', async ({ page, daemon }) => {
   461→      // Set desktop viewport
   462→      await page.setViewportSize({ width: 1280, height: 720 });
   463→      await page.goto('/tasks');
   464→
   465→      // Click task to open detail
   466→      const taskItem = page.getByTestId('task-list-item').first();
   467→      await taskItem.click();
   468→
   469→      // Detail panel should slide over without navigating away
   470→      const detailPanel = page.getByTestId('task-detail-panel');
   471→      await expect(detailPanel).toBeVisible();
   472→
   473→      // Task list should still be visible
