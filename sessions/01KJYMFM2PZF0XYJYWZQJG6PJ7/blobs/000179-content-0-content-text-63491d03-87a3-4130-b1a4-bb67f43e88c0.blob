```
     1→/**
     2→ * Streaming Message Store
     3→ *
     4→ * Aggregates streaming session events into coherent UI messages.
     5→ * Uses Svelte 5 runes for reactivity.
     6→ *
     7→ * @see specs/STREAMING_MESSAGE_AGGREGATION.md
     8→ * @see kynetic-r0i5 - Phase 1: Core aggregation types and streaming store
     9→ */
    10→
    11→import {
    12→  type AgentMessage,
    13→  type AgentThought,
    14→  type AggregatedMessage,
    15→  type AggregationState,
    16→  type Command,
    17→  createAggregationState,
    18→  createSessionMeta,
    19→  generateMessageId,
    20→  type MessageManagerEvent,
    21→  type PlanEntry,
    22→  parseMessageId,
    23→  roleForMessageType,
    24→  type SessionMeta,
    25→  type ToolCall,
    26→  type UserMessage,
    27→} from '@kynetic/shared/aggregated-message';
    28→import {
    29→  type SessionMessageEventData,
    30→  type SessionMetaEventData,
    31→  type SessionStatusEventData,
    32→  type SessionThoughtEventData,
    33→  type SessionToolCallUpdateEventData,
    34→  type SessionToolResultEventData,
    35→  type SessionToolUseEventData,
    36→  translateAcpToUiEvent,
    37→  type UiEventType,
    38→} from '@kynetic/shared/ui-event-translator';
    39→import type { HubEvent } from '$lib/api/index.js';
    40→
    41→// =============================================================================
    42→// Role Determination
    43→// =============================================================================
    44→
    45→/**
    46→ * Get the role for a UI event type.
    47→ *
    48→ * Per spec Section 4.2:
    49→ * - User events: 'user_message'
    50→ * - Agent events: all others except 'meta'
    51→ * - Meta events: return null (don't participate in turn tracking)
    52→ */
    53→export function roleForUiEvent(eventType: UiEventType): 'user' | 'agent' | null {
    54→  switch (eventType) {
    55→    case 'user_message':
    56→      return 'user';
    57→    case 'agent_message':
    58→    case 'agent_thought':
    59→    case 'tool_use':
    60→    case 'tool_call_update':
    61→    case 'tool_result':
    62→    case 'status':
    63→      return 'agent';
    64→    case 'meta':
    65→      return null; // Meta events don't participate in turn tracking
    66→    default:
    67→      return null;
    68→  }
    69→}
    70→
    71→// =============================================================================
    72→// Turn Tracking
    73→// =============================================================================
    74→
    75→/**
    76→ * Update turn/block indices based on role change.
    77→ *
    78→ * Per spec Section 4.3:
    79→ * - Role change = new turn (turnIndex++, blockIndex reset to 0)
    80→ * - Same role, new block = blockIndex++
    81→ * - Same role, same type = no change (appending)
    82→ */
    83→function updateTurnTracking(
    84→  state: AggregationState,
    85→  role: 'user' | 'agent',
    86→  isNewBlock: boolean,
    87→): void {
    88→  if (role !== state.lastRole) {
    89→    // Role change = new turn
    90→    state.turnIndex++;
    91→    state.blockIndex = 0;
    92→    state.lastRole = role;
    93→  } else if (isNewBlock) {
    94→    // Same role, new block type
    95→    state.blockIndex++;
    96→  }
    97→  // Same role, same type = no change (appending)
    98→}
    99→
   100→// =============================================================================
   101→// Helper Functions
   102→// =============================================================================
   103→
   104→/**
   105→ * Finalize the active streaming message.
   106→ */
   107→function finalizeActiveMessage(state: AggregationState, timestamp?: string): void {
   108→  if (state.activeMessageId) {
   109→    const activeMsg = state.messages.find((m) => m.id === state.activeMessageId);
   110→    if (activeMsg) {
   111→      activeMsg.is_streaming = false;
   112→      if (timestamp) {
   113→        activeMsg.updated_at = timestamp;
   114→      }
   115→    }
   116→    state.activeMessageId = null;
   117→  }
   118→}
   119→
   120→/**
   121→ * Find a message by ID.
   122→ *
   123→ * IMPORTANT: Must search the messages array (not messageById Map) to get the
   124→ * reactive proxy. The Map stores the original plain object, which bypasses
   125→ * Svelte 5's $state reactivity when mutated.
   126→ * @see kynetic-w9e2
   127→ */
   128→function findMessageById(state: AggregationState, id: string): AggregatedMessage | undefined {
   129→  // Search the reactive array to get the proxy, not the plain object from Map
   130→  return state.messages.find((m) => m.id === id);
   131→}
   132→
   133→// =============================================================================
   134→// Event Handlers
   135→// =============================================================================
   136→
   137→/**
   138→ * Handle text events (user_message, agent_message).
   139→ *
   140→ * Per spec Section 4.6:
   141→ * - If same type and still streaming, append content
   142→ * - Otherwise, finalize active and start new message
   143→ *
   144→ * IMPORTANT: We always look up through state.messages to ensure Svelte 5
   145→ * reactivity works. Direct object references bypass the $state proxy.
   146→ */
   147→function handleTextEvent(
   148→  messageType: 'user_message' | 'agent_message',
   149→  content: string,
   150→  timestamp: string,
   151→  state: AggregationState,
   152→): void {
   153→  const role = roleForUiEvent(messageType);
   154→  if (!role) throw new Error(`No role for message type: ${messageType}`);
   155→
   156→  // Empty string signals new message boundary (Claude streaming API convention)
   157→  // Finalize current message if exists, then return - next content chunk creates new message
   158→  if (content === '') {
   159→    if (state.activeMessageId) {
   160→      finalizeActiveMessage(state, timestamp);
   161→    }
   162→    // Don't create a new empty message - wait for actual content
   163→    return;
   164→  }
   165→
   166→  // Check continuation: same type, still streaming
   167→  // Look up through messages array to get proxied reference for Svelte 5 reactivity
   168→  if (state.activeMessageId) {
   169→    const activeMsg = state.messages.find((m) => m.id === state.activeMessageId);
   170→    if (activeMsg?.type === messageType && activeMsg.is_streaming) {
   171→      // Append in place - mutation goes through Svelte proxy
   172→      const msg = activeMsg as AgentMessage | UserMessage;
   173→      msg.content += content;
   174→      msg.updated_at = timestamp;
   175→      return;
   176→    }
   177→  }
   178→
   179→  // Start new message
   180→  finalizeActiveMessage(state, timestamp);
   181→
   182→  const isNewBlock = state.lastRole === role; // Same role = new block
   183→  updateTurnTracking(state, role, isNewBlock);
   184→
   185→  const newMessage: AgentMessage | UserMessage = {
   186→    id: generateMessageId(state),
   187→    type: messageType,
   188→    content: content,
   189→    started_at: timestamp,
   190→    updated_at: timestamp,
   191→    is_streaming: true,
   192→  };
   193→
   194→  state.messages.push(newMessage);
   195→  state.messageById.set(newMessage.id, newMessage);
   196→  state.activeMessageId = newMessage.id;
   197→}
   198→
   199→/**
   200→ * Handle thought events.
   201→ *
   202→ * Per spec Section 4.7:
   203→ * - Thoughts accumulate like text messages
   204→ * - Same continuation rules apply
   205→ *
   206→ * IMPORTANT: We always look up through state.messages to ensure Svelte 5
   207→ * reactivity works. Direct object references bypass the $state proxy.
   208→ */
   209→function handleThoughtEvent(
   210→  data: SessionThoughtEventData,
   211→  timestamp: string,
   212→  state: AggregationState,
   213→): void {
   214→  const content = data.content || '';
   215→  const role = roleForUiEvent('agent_thought'); // Always "agent"
   216→  if (!role) throw new Error('No role for agent_thought');
   217→
   218→  // Check continuation - look up through messages array for Svelte 5 reactivity
   219→  if (state.activeMessageId) {
   220→    const activeMsg = state.messages.find((m) => m.id === state.activeMessageId);
   221→    if (activeMsg?.type === 'agent_thought' && activeMsg.is_streaming) {
   222→      // Append in place - mutation goes through Svelte proxy
   223→      const msg = activeMsg as AgentThought;
   224→      msg.content += content;
   225→      msg.updated_at = timestamp;
   226→      return;
   227→    }
   228→  }
   229→
   230→  // Start new thought block
   231→  finalizeActiveMessage(state, timestamp);
   232→
   233→  const isNewBlock = state.lastRole === role;
   234→  updateTurnTracking(state, role, isNewBlock);
   235→
   236→  const thought: AgentThought = {
   237→    id: generateMessageId(state),
   238→    type: 'agent_thought',
   239→    content: content,
   240→    started_at: timestamp,
   241→    updated_at: timestamp,
   242→    is_streaming: true,
   243→  };
   244→
   245→  state.messages.push(thought);
   246→  state.messageById.set(thought.id, thought);
   247→  state.activeMessageId = thought.id;
   248→}
   249→
   250→/**
   251→ * Handle tool_use events.
   252→ *
   253→ * Per spec Section 4.8:
   254→ * - Tool calls are tracked in pendingTools, NOT as activeMessage
   255→ * - If tool_call_id already exists, update the existing tool (streaming input)
   256→ * - Otherwise, create new tool call with status "pending"
   257→ */
   258→function handleToolUse(
   259→  data: SessionToolUseEventData,
   260→  timestamp: string,
   261→  state: AggregationState,
   262→): void {
   263→  const role = roleForUiEvent('tool_use'); // Always "agent"
   264→  if (!role) throw new Error('No role for tool_use');
   265→
   266→  // Check if this is an update to existing tool call (streaming input)
   267→  const existingId = state.pendingTools.get(data.tool_call_id);
   268→  if (existingId !== undefined) {
   269→    const existing = findMessageById(state, existingId) as ToolCall | undefined;
   270→    if (existing) {
   271→      // Tool input arrives as progressively more complete JSON objects
   272→      // Replace with newer (more complete) version
   273→      if (data.input != null) existing.input = data.input;
   274→      if (data.tool) existing.tool = data.tool;
   275→      if (data.summary) existing.summary = data.summary;
   276→      existing.updated_at = timestamp;
   277→    }
   278→    return;
   279→  }
   280→
   281→  // New tool call
   282→  finalizeActiveMessage(state, timestamp);
   283→
   284→  const isNewBlock = state.lastRole === role;
   285→  updateTurnTracking(state, role, isNewBlock);
   286→
   287→  const toolMessage: ToolCall = {
   288→    id: generateMessageId(state),
   289→    type: 'tool_call',
   290→    tool_call_id: data.tool_call_id,
   291→    tool: data.tool,
   292→    summary: data.summary,
   293→    input: data.input,
   294→    status: 'pending',
   295→    started_at: timestamp,
   296→    updated_at: timestamp,
   297→    is_streaming: true,
   298→  };
   299→
   300→  state.messages.push(toolMessage);
   301→  state.messageById.set(toolMessage.id, toolMessage);
   302→  // Store message.id instead of index (resilient to array reordering)
   303→  state.pendingTools.set(data.tool_call_id, toolMessage.id);
   304→  // Note: tool calls don't become activeMessage (text can follow immediately)
   305→}
   306→
   307→/**
   308→ * Handle tool_call_update events.
   309→ *
   310→ * Per spec Section 4.9:
   311→ * - Handle non-terminal status updates (pending -> running)
   312→ * - Does NOT finalize activeMessage or clear pendingTools
   313→ */
   314→function handleToolCallUpdate(
   315→  data: SessionToolCallUpdateEventData,
   316→  timestamp: string,
   317→  state: AggregationState,
   318→): void {
   319→  const messageId = state.pendingTools.get(data.tool_call_id);
   320→
   321→  if (messageId === undefined) {
   322→    // Tool not found - may have been created before we connected
   323→    console.warn(`[Aggregation] tool_call_update for unknown tool_call_id=${data.tool_call_id}`);
   324→    return;
   325→  }
   326→
   327→  const tool = findMessageById(state, messageId) as ToolCall | undefined;
   328→  if (!tool) return;
   329→
   330→  // Update status: pending -> running
   331→  if (data.status === 'in_progress') {
   332→    tool.status = 'running';
   333→  }
   334→
   335→  // Optional: capture partial output if provided
   336→  if (data.partial_output !== undefined) {
   337→    tool.output = data.partial_output;
   338→  }
   339→
   340→  tool.updated_at = timestamp;
   341→
   342→  // IMPORTANT: Do NOT finalize activeMessage or clear pendingTools
   343→  // This is a progress update, not a turn boundary
   344→}
   345→
   346→/**
   347→ * Handle tool_result events.
   348→ *
   349→ * Per spec Section 4.10:
   350→ * - Update tool status to completed/failed
   351→ * - Set output and completed_at
   352→ * - Remove from pendingTools
   353→ */
   354→function handleToolResult(
   355→  data: SessionToolResultEventData,
   356→  timestamp: string,
   357→  state: AggregationState,
   358→): void {
   359→  const messageId = state.pendingTools.get(data.tool_call_id);
   360→
   361→  if (messageId === undefined) {
   362→    // Orphaned result - log for debugging but don't crash
   363→    console.warn(
   364→      `[Aggregation] Orphaned tool_result for tool_call_id=${data.tool_call_id}. ` +
   365→        `This may indicate event ordering issues or reconnection gaps.`,
   366→    );
   367→    return;
   368→  }
   369→
   370→  const tool = findMessageById(state, messageId) as ToolCall | undefined;
   371→  if (!tool) return;
   372→
   373→  tool.status = data.success ? 'completed' : 'failed';
   374→  // Only overwrite output if present - avoid losing partial_output captured during execution
   375→  // @see kynetic-w9e2 - completion events may lack rawOutput
   376→  if (data.output !== undefined) {
   377→    tool.output = data.output;
   378→  }
   379→  tool.completed_at = timestamp;
   380→  tool.updated_at = timestamp;
   381→  tool.is_streaming = false;
   382→
   383→  state.pendingTools.delete(data.tool_call_id);
   384→}
   385→
   386→/**
   387→ * Check if a stop_reason indicates a terminal session state.
   388→ * Terminal states mean the session is done and pending tools will never complete.
   389→ */
   390→function isTerminalStopReason(stopReason: SessionStatusEventData['stop_reason']): boolean {
   391→  return (
   392→    stopReason === 'cancelled' ||
   393→    stopReason === 'completed' ||
   394→    stopReason === 'error' ||
   395→    stopReason === 'context_limit' ||
   396→    stopReason === 'crashed'
   397→  );
   398→}
   399→
   400→/**
   401→ * Handle status events (turn/session boundaries).
   402→ *
   403→ * Per spec Section 4.11:
   404→ * - Finalize active message
   405→ * - Handle terminal states: mark pending tools as cancelled
   406→ * - Handle end_turn: just finalize (tools may continue)
   407→ *
   408→ * Terminal stop_reasons: cancelled, completed, error, context_limit, crashed
   409→ * Non-terminal: end_turn
   410→ */
   411→function handleStatus(
   412→  data: SessionStatusEventData,
   413→  timestamp: string,
   414→  state: AggregationState,
   415→): void {
   416→  // All status events finalize the current streaming message
   417→  finalizeActiveMessage(state, timestamp);
   418→
   419→  // Terminal statuses - session is done, pending tools will never complete
   420→  if (isTerminalStopReason(data.stop_reason)) {
   421→    for (const [, messageId] of state.pendingTools) {
   422→      const tool = findMessageById(state, messageId) as ToolCall | undefined;
   423→      if (tool?.is_streaming) {
   424→        // Mark as cancelled since session ended without tool completion
   425→        tool.status = 'cancelled';
   426→        tool.is_streaming = false;
   427→        tool.updated_at = timestamp;
   428→        tool.completed_at = timestamp;
   429→      }
   430→    }
   431→    state.pendingTools.clear();
   432→    return;
   433→  }
   434→
   435→  // end_turn: just finalize the active message
   436→  // Pending tools may continue and later deliver tool_call_update/tool_result events.
   437→}
   438→
   439→/**
   440→ * Handle meta events (plan, mode, commands).
   441→ *
   442→ * Per spec Section 4.12:
   443→ * - Finalize active message (but don't affect pendingTools)
   444→ * - Update sessionMeta (not transcript)
   445→ * - Do NOT modify turnIndex, blockIndex, or lastRole
   446→ */
   447→function handleMetaEvent(
   448→  data: SessionMetaEventData,
   449→  timestamp: string,
   450→  state: AggregationState,
   451→): void {
   452→  // Meta events finalize any active streaming message (per expert recommendation)
   453→  // This ensures text doesn't stream across mode/plan updates
   454→  finalizeActiveMessage(state, timestamp);
   455→
   456→  // Update session metadata (NOT transcript messages)
   457→  switch (data.type) {
   458→    case 'plan':
   459→      // Plan updates are full replacement per ACP spec
   460→      state.sessionMeta.plan = (data.plan as PlanEntry[]) ?? null;
   461→      break;
   462→
   463→    case 'current_mode_update':
   464→      state.sessionMeta.currentModeId = data.currentModeId ?? null;
   465→      break;
   466→
   467→    case 'available_commands_update':
   468→      // Store but don't affect transcript or IDs
   469→      state.sessionMeta.availableCommands = (data.availableCommands as Command[]) ?? null;
   470→      break;
   471→  }
   472→
   473→  // IMPORTANT: Do NOT modify turnIndex, blockIndex, or lastRole
   474→  // Meta events don't participate in turn tracking
   475→  // IMPORTANT: Do NOT clear pendingTools - tools can still complete
   476→}
   477→
   478→// =============================================================================
   479→// Main Event Processor
   480→// =============================================================================
   481→
   482→/**
   483→ * Process a hub event and update aggregation state.
   484→ *
   485→ * Per spec Section 4.5:
   486→ * - Deduplicate by sequence number
   487→ * - Translate ACP event to UI event
   488→ * - Dispatch to appropriate handler
   489→ */
   490→export function processEvent(event: HubEvent, state: AggregationState): void {
   491→  // Deduplicate: skip events we've already processed (Section 8.5)
   492→  if (event.seq !== undefined && event.seq <= state.lastSeqProcessed) {
   493→    return;
   494→  }
   495→
   496→  // The event.data contains the SessionUpdate which we need to translate
   497→  const sessionUpdate = event.data as { update?: unknown };
   498→  if (!sessionUpdate.update) {
   499→    // Not a session update event, skip
   500→    return;
   501→  }
   502→
   503→  // Type assertion: sessionUpdate.update is a SessionUpdate from ACP
   504→  // eslint-disable-next-line @typescript-eslint/no-explicit-any
   505→  const translated = translateAcpToUiEvent(
   506→    sessionUpdate.update as Parameters<typeof translateAcpToUiEvent>[0],
   507→  );
   508→  const timestamp = event.timestamp; // Use server timestamp from envelope
   509→
   510→  // Update lastSeqProcessed AFTER successful translation but BEFORE processing
   511→  // This ensures we don't reprocess on retry if processing fails partway through
   512→  if (event.seq !== undefined) {
   513→    state.lastSeqProcessed = event.seq;
   514→  }
   515→
   516→  switch (translated.event) {
   517→    case 'agent_message': {
   518→      const data = translated.data as SessionMessageEventData;
   519→      handleTextEvent('agent_message', data.content, timestamp, state);
   520→      break;
   521→    }
   522→
   523→    case 'user_message': {
   524→      const data = translated.data as SessionMessageEventData;
   525→      handleTextEvent('user_message', data.content, timestamp, state);
   526→      break;
   527→    }
   528→
   529→    case 'agent_thought': {
   530→      handleThoughtEvent(translated.data as SessionThoughtEventData, timestamp, state);
   531→      break;
   532→    }
   533→
   534→    case 'tool_use': {
   535→      handleToolUse(translated.data as SessionToolUseEventData, timestamp, state);
   536→      break;
   537→    }
   538→
   539→    case 'tool_call_update': {
   540→      handleToolCallUpdate(translated.data as SessionToolCallUpdateEventData, timestamp, state);
   541→      break;
   542→    }
   543→
   544→    case 'tool_result': {
   545→      handleToolResult(translated.data as SessionToolResultEventData, timestamp, state);
   546→      break;
   547→    }
   548→
   549→    case 'status': {
   550→      handleStatus(translated.data as SessionStatusEventData, timestamp, state);
   551→      break;
   552→    }
   553→
   554→    case 'meta': {
   555→      handleMetaEvent(translated.data as SessionMetaEventData, timestamp, state);
   556→      break;
   557→    }
   558→
   559→    default:
   560→      console.warn(`[Aggregation] Unhandled translated event: ${translated.event}`);
   561→  }
   562→}
   563→
   564→// =============================================================================
   565→// Hydration
   566→// =============================================================================
   567→
   568→/**
   569→ * Hydrate aggregation state from REST API response.
   570→ *
   571→ * Per spec Section 8.2:
   572→ * - REST returns AggregatedMessage[] format
   573→ * - Derive turn/block indices from last message ID
   574→ * - Rebuild lookup maps
   575→ * - CRITICAL: Tools are NEVER set as activeMessage
   576→ */
   577→export function hydrateFromMessages(
   578→  sessionId: string,
   579→  messages: AggregatedMessage[],
   580→  sessionMeta?: SessionMeta,
   581→): AggregationState {
   582→  const state = createAggregationState(sessionId);
   583→  state.messages = messages;
   584→
   585→  if (sessionMeta) {
   586→    state.sessionMeta = sessionMeta;
   587→  }
   588→
   589→  // Rebuild lookup maps
   590→  for (const msg of messages) {
   591→    state.messageById.set(msg.id, msg);
   592→
   593→    if (msg.type === 'tool_call' && msg.is_streaming) {
   594→      state.pendingTools.set((msg as ToolCall).tool_call_id, msg.id);
   595→    }
   596→  }
   597→
   598→  if (messages.length > 0) {
   599→    const lastMsg = messages[messages.length - 1];
   600→
   601→    // Parse ID to extract turn/block indices
   602→    const parsed = parseMessageId(lastMsg.id);
   603→    if (parsed) {
   604→      const [turnIndex, blockIndex] = parsed;
   605→      state.turnIndex = turnIndex;
   606→      state.blockIndex = blockIndex;
   607→    }
   608→
   609→    // Derive lastRole from last message type
   610→    state.lastRole = roleForMessageType(lastMsg.type);
   611→
   612→    // If last message is still streaming, track it by ID
   613→    // CRITICAL: Tools are NEVER set as activeMessage - they track via pendingTools map
   614→    // Only text-like messages (user_message, agent_message, agent_thought) can be active
   615→    if (lastMsg.is_streaming && lastMsg.type !== 'tool_call') {
   616→      state.activeMessageId = lastMsg.id;
   617→    }
   618→  }
   619→
   620→  return state;
   621→}
   622→
   623→// =============================================================================
   624→// Semantic Event Processing
   625→// =============================================================================
   626→
   627→/**
   628→ * Process a semantic MessageManagerEvent and update aggregation state.
   629→ *
   630→ * This is a MUCH simpler handler than processEvent because the server
   631→ * has already done all the aggregation work. We just need to apply
   632→ * the pre-computed deltas to our local state.
   633→ *
   634→ * @see kynetic-f8vf.5 - Simplify UI streaming-messages aggregation
   635→ */
   636→export function processSemanticEvent(event: MessageManagerEvent, state: AggregationState): void {
   637→  // Filter: only process events for our session
   638→  if (event.sessionId !== state.sessionId) {
   639→    return;
   640→  }
   641→
   642→  switch (event.type) {
   643→    case 'message_started': {
   644→      // New message - add to state
   645→      const msg = event.message;
   646→      state.messages.push(msg);
   647→      state.messageById.set(msg.id, msg);
   648→
   649→      // Extract turn/block from message ID and update tracking
   650→      const parsed = parseMessageId(msg.id);
   651→      if (parsed) {
   652→        const [turnIndex, blockIndex] = parsed;
   653→        state.turnIndex = turnIndex;
   654→        state.blockIndex = blockIndex;
   655→      }
   656→      state.lastRole = roleForMessageType(msg.type);
   657→
   658→      // Track as active message (unless it's a tool call)
   659→      if (msg.type !== 'tool_call') {
   660→        state.activeMessageId = msg.id;
   661→      }
   662→
   663→      // Track pending tools
   664→      if (msg.type === 'tool_call') {
   665→        state.pendingTools.set((msg as ToolCall).tool_call_id, msg.id);
   666→      }
   667→      break;
   668→    }
   669→
   670→    case 'message_chunk': {
   671→      // Append content to existing message
   672→      // Search the reactive array to get the proxy for Svelte 5 reactivity
   673→      const msg = state.messages.find((m) => m.id === event.messageId);
   674→      if (msg && 'content' in msg) {
   675→        (msg as AgentMessage | UserMessage | AgentThought).content += event.content;
   676→        msg.updated_at = event.timestamp;
   677→      }
   678→      break;
   679→    }
   680→
   681→    case 'message_finalized': {
   682→      // Mark message as no longer streaming
   683→      const msg = state.messages.find((m) => m.id === event.message.id);
   684→      if (msg) {
   685→        msg.is_streaming = false;
   686→        msg.updated_at = event.message.updated_at;
   687→      }
   688→
   689→      // Clear active message if this was it
   690→      if (state.activeMessageId === event.message.id) {
   691→        state.activeMessageId = null;
   692→      }
   693→      break;
   694→    }
   695→
   696→    case 'tool_started': {
   697→      // New tool call - add to state
   698→      const tool = event.tool;
   699→      state.messages.push(tool);
   700→      state.messageById.set(tool.id, tool);
   701→      state.pendingTools.set(tool.tool_call_id, tool.id);
   702→
   703→      // Update turn/block tracking
   704→      const parsed = parseMessageId(tool.id);
   705→      if (parsed) {
   706→        const [turnIndex, blockIndex] = parsed;
   707→        state.turnIndex = turnIndex;
   708→        state.blockIndex = blockIndex;
   709→      }
   710→      state.lastRole = 'agent';
   711→      break;
   712→    }
   713→
   714→    case 'tool_updated': {
   715→      // Update existing tool call
   716→      const existingId = state.pendingTools.get(event.tool.tool_call_id);
   717→      if (existingId) {
   718→        const tool = state.messages.find((m) => m.id === existingId) as ToolCall | undefined;
   719→        if (tool) {
   720→          tool.status = event.tool.status;
   721→          tool.input = event.tool.input;
   722→          tool.output = event.tool.output;
   723→          tool.updated_at = event.tool.updated_at;
   724→          if (event.tool.tool) tool.tool = event.tool.tool;
   725→          if (event.tool.summary) tool.summary = event.tool.summary;
   726→        }
   727→      }
   728→      break;
   729→    }
   730→
   731→    case 'tool_completed': {
   732→      // Tool call finished
   733→      const existingId = state.pendingTools.get(event.tool.tool_call_id);
   734→      if (existingId) {
   735→        const tool = state.messages.find((m) => m.id === existingId) as ToolCall | undefined;
   736→        if (tool) {
   737→          tool.status = event.tool.status;
   738→          tool.output = event.tool.output;
   739→          tool.completed_at = event.tool.completed_at;
   740→          tool.updated_at = event.tool.updated_at;
   741→          tool.is_streaming = false;
   742→        }
   743→        state.pendingTools.delete(event.tool.tool_call_id);
   744→      }
   745→      break;
   746→    }
   747→
   748→    case 'turn_completed': {
   749→      // Finalize any active message
   750→      if (state.activeMessageId) {
   751→        const msg = state.messages.find((m) => m.id === state.activeMessageId);
   752→        if (msg) {
   753→          msg.is_streaming = false;
   754→        }
   755→        state.activeMessageId = null;
   756→      }
   757→      break;
   758→    }
   759→
   760→    case 'meta_updated': {
   761→      // Update session metadata
   762→      state.sessionMeta.plan = event.meta.plan;
   763→      state.sessionMeta.currentModeId = event.meta.currentModeId;
   764→      state.sessionMeta.availableCommands = event.meta.availableCommands;
   765→      break;
   766→    }
   767→  }
   768→}
   769→
   770→// =============================================================================
   771→// Svelte 5 Store
   772→// =============================================================================
   773→
   774→/**
   775→ * Create a streaming message store for a session.
   776→ *
   777→ * Per spec Section 9.1:
   778→ * - Uses Svelte 5 $state for deep reactivity
   779→ * - Direct mutation triggers reactivity
   780→ * - Exposes messages, sessionMeta, handleEvent
   781→ */
   782→export function createStreamingStore(sessionId: string) {
   783→  // Svelte 5 $state with deep reactivity
   784→  const messages = $state<AggregatedMessage[]>([]);
   785→
   786→  // Session metadata (separate from transcript)
   787→  const sessionMeta = $state<SessionMeta>(createSessionMeta());
   788→
   789→  // Internal aggregation state (non-reactive primitives)
   790→  let turnIndex = -1; // First event increments to 0
   791→  let blockIndex = 0;
   792→  let lastRole: 'user' | 'agent' | null = null;
   793→  let activeMessageId: string | null = null;
   794→  let lastSeqProcessed = -1;
   795→  const pendingTools = new Map<string, string>(); // tool_call_id -> message.id
   796→  const messageById = new Map<string, AggregatedMessage>(); // O(1) lookup
   797→
   798→  /**
   799→   * Get the current aggregation state (for use with processEvent).
   800→   * Creates a view that uses the reactive messages array.
   801→   */
   802→  function getState(): AggregationState {
   803→    return {
   804→      sessionId,
   805→      messages,
   806→      messageById,
   807→      lastSeqProcessed,
   808→      turnIndex,
   809→      blockIndex,
   810→      lastRole,
   811→      activeMessageId,
   812→      pendingTools,
   813→      sessionMeta,
   814→    };
   815→  }
   816→
   817→  /**
   818→   * Sync internal state from the aggregation state after processing.
   819→   */
   820→  function syncFromState(state: AggregationState): void {
   821→    turnIndex = state.turnIndex;
   822→    blockIndex = state.blockIndex;
   823→    lastRole = state.lastRole;
   824→    activeMessageId = state.activeMessageId;
   825→    lastSeqProcessed = state.lastSeqProcessed;
   826→    // Note: messages, messageById, pendingTools are already mutated in place
   827→  }
   828→
   829→  /**
   830→   * Handle a hub event.
   831→   */
   832→  function handleEvent(event: HubEvent): void {
   833→    const state = getState();
   834→    processEvent(event, state);
   835→    syncFromState(state);
   836→  }
   837→
   838→  /**
   839→   * Replace state from REST API hydration.
   840→   */
   841→  function replaceState(newState: AggregationState): void {
   842→    // Replace messages array (triggers reactivity)
   843→    messages.length = 0;
   844→    messages.push(...newState.messages);
   845→
   846→    // Replace sessionMeta
   847→    sessionMeta.plan = newState.sessionMeta.plan;
   848→    sessionMeta.currentModeId = newState.sessionMeta.currentModeId;
   849→    sessionMeta.availableCommands = newState.sessionMeta.availableCommands;
   850→
   851→    // Rebuild maps
   852→    messageById.clear();
   853→    for (const msg of messages) {
   854→      messageById.set(msg.id, msg);
   855→    }
   856→
   857→    pendingTools.clear();
   858→    for (const [toolCallId, msgId] of newState.pendingTools) {
   859→      pendingTools.set(toolCallId, msgId);
   860→    }
   861→
   862→    // Sync indices
   863→    turnIndex = newState.turnIndex;
   864→    blockIndex = newState.blockIndex;
   865→    lastRole = newState.lastRole;
   866→    activeMessageId = newState.activeMessageId;
   867→    lastSeqProcessed = newState.lastSeqProcessed;
   868→  }
   869→
   870→  /**
   871→   * Clear all state.
   872→   */
   873→  function clear(): void {
   874→    messages.length = 0;
   875→    messageById.clear();
   876→    pendingTools.clear();
   877→    turnIndex = -1;
   878→    blockIndex = 0;
   879→    lastRole = null;
   880→    activeMessageId = null;
   881→    lastSeqProcessed = -1;
   882→    sessionMeta.plan = null;
   883→    sessionMeta.currentModeId = null;
   884→    sessionMeta.availableCommands = null;
   885→  }
   886→
   887→  /**
   888→   * Reset sequence tracking after WebSocket reconnection.
   889→   *
   890→   * After a WebSocket reconnect, the Hub creates a new client state with nextSeq: 1.
   891→   * Without resetting, new events (seq 1, 2, 3...) would be dropped because
   892→   * lastSeqProcessed might be at a higher value from before the disconnect.
   893→   *
   894→   * @see kynetic-91ja - Bug: Hub UI stops rendering events after WebSocket reconnection
   895→   */
   896→  function resetSequenceTracking(): void {
   897→    lastSeqProcessed = -1;
   898→  }
   899→
   900→  /**
   901→   * Handle a semantic MessageManagerEvent from the Hub.
   902→   *
   903→   * This is a simpler alternative to handleEvent() that processes
   904→   * pre-aggregated semantic events instead of raw ACP events.
   905→   * The server has already done the heavy lifting.
   906→   *
   907→   * @see kynetic-f8vf.5 - Simplify UI streaming-messages aggregation
   908→   */
   909→  function handleSemanticEvent(event: MessageManagerEvent): void {
   910→    const state = getState();
   911→    processSemanticEvent(event, state);
   912→    syncFromState(state);
   913→  }
   914→
   915→  return {
   916→    // Reactive getters
   917→    get messages() {
   918→      return messages;
   919→    },
   920→    get sessionMeta() {
   921→      return sessionMeta;
   922→    },
   923→
   924→    // Methods
   925→    handleEvent,
   926→    handleSemanticEvent,
   927→    replaceState,
   928→    clear,
   929→    resetSequenceTracking,
   930→
   931→    // For testing/debugging
   932→    get _state() {
   933→      return getState();
   934→    },
   935→  };
   936→}
   937→
   938→/**
   939→ * Type for the streaming store.
   940→ */
   941→export type StreamingStore = ReturnType<typeof createStreamingStore>;
   942→
```