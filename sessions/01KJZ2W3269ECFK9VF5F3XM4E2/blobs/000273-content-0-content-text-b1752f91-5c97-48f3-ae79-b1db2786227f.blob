   248→      // In live daemon mode (not static), action form should be available for pending items
   249→      const actionForm = card.getByTestId('triage-action-form');
   250→      const hasForm = await actionForm.isVisible().catch(() => false);
   251→
   252→      // If item is pending, form should be shown; if already acted, it may not be
   253→      // Either way, the page is NOT in static mode (we're running against daemon)
   254→      const staticNotice = page.getByTestId('triage-static-notice');
   255→      const hasStaticNotice = await staticNotice.isVisible().catch(() => false);
   256→      // In E2E with running daemon, static mode notice should NOT be shown
   257→      expect(hasStaticNotice).toBe(false);
   258→    }
   259→  });
