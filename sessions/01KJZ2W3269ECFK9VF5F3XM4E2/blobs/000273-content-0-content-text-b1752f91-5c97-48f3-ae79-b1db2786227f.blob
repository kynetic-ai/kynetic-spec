   200→  // AC: @interactive-triage-ui ac-7
   201→  test('action filter narrows cards by triage action and resets card index', async ({ page, request }) => {
   202→    let targetAction = 'defer';
   203→    const triageListResponse = await request.get('http://localhost:3456/api/triage?limit=1000');
   204→    expect(triageListResponse.ok()).toBe(true);
   205→    const triageListBody = await triageListResponse.json();
   206→    const existingAction = triageListBody.items.find((item: { action?: string | null }) => item.action)?.action;
   207→
   208→    if (existingAction) {
   209→      targetAction = existingAction;
   210→    } else {
   211→      const inboxResponse = await request.post('http://localhost:3456/api/inbox', {
   212→        data: { text: `Action filter test item ${Date.now()}` },
   213→      });
   214→      expect(inboxResponse.status()).toBe(200);
   215→      const inboxBody = await inboxResponse.json();
   216→      const inboxUlid = inboxBody.item._ulid;
   217→
   218→      const triageResponse = await request.post('http://localhost:3456/api/triage', {
   219→        data: {
   220→          inbox_ref: `@${inboxUlid}`,
   221→          action: targetAction,
   222→          reasoning: 'Create deterministic action-filter test record',
   223→        },
   224→      });
   225→      expect(triageResponse.status()).toBe(200);
   226→      await reloadWithRetry(page);
   227→    }
   228→
   229→    const nextBtn = page.getByTestId('triage-next');
   230→    if (await nextBtn.isEnabled()) {
   231→      await nextBtn.click();
   232→    }
   233→
   234→    await page.getByTestId('triage-action-filter').selectOption(targetAction);
   235→
   236→    // Filter change should reset navigation index to the first matching card.
   237→    await expect(page.getByTestId('triage-position')).toContainText(/^1\s*\/\s*\d+/);
   238→    await expect(page.getByTestId('triage-progress')).toContainText('Showing');
   239→    await expect(page.getByTestId('triage-rec-action')).toContainText(ACTION_LABELS[targetAction]);
   240→  });
