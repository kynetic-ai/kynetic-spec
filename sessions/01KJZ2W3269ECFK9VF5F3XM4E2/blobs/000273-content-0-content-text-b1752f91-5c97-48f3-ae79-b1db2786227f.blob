   149→
   150→  // AC: @interactive-triage-ui ac-7
   151→  test('tag filter controls are visible', async ({ page }) => {
   152→    // Tag filter exists alongside status filter
   153→    await expect(page.getByTestId('triage-tag-filter')).toBeVisible();
   154→  });
   155→
   156→  // AC: @interactive-triage-ui ac-7
   157→  test('filter selections update URL query params', async ({ page }) => {
   158→    const statusFilter = page.getByTestId('triage-status-filter');
   159→    const actionFilter = page.getByTestId('triage-action-filter');
   160→    const tagFilter = page.getByTestId('triage-tag-filter');
   161→
   162→    await statusFilter.selectOption('triaged');
   163→    await expect(page).toHaveURL(/\/triage\?.*status=triaged/);
   164→
   165→    await actionFilter.selectOption('defer');
   166→    await expect(page).toHaveURL(/\/triage\?.*status=triaged/);
   167→    await expect(page).toHaveURL(/\/triage\?.*action=defer/);
   168→
   169→    const optionCount = await tagFilter.locator('option').count();
   170→    if (optionCount > 1) {
   171→      const firstTag = await tagFilter.locator('option').nth(1).getAttribute('value');
   172→      if (firstTag) {
   173→        await tagFilter.selectOption(firstTag);
   174→        const encodedTag = encodeURIComponent(firstTag);
   175→        await expect(page).toHaveURL(new RegExp(`\\/triage\\?.*tag=${encodedTag}`));
   176→      }
   177→    }
   178→  });
   179→
   180→  // AC: @interactive-triage-ui ac-7
   181→  test('restores filter selections from URL and supports back-forward history', async ({ page }) => {
   182→    await page.goto('/triage?status=triaged&action=defer');
   183→    await page.waitForLoadState('networkidle');
   184→
   185→    await expect(page.getByTestId('triage-status-filter')).toHaveValue('triaged');
   186→    await expect(page.getByTestId('triage-action-filter')).toHaveValue('defer');
   187→
   188→    await page.getByTestId('triage-status-filter').selectOption('acted_on');
   189→    await expect(page).toHaveURL(/\/triage\?.*status=acted_on/);
   190→
   191→    await page.goBack();
   192→    await expect(page).toHaveURL(/\/triage\?.*status=triaged/);
   193→    await expect(page.getByTestId('triage-status-filter')).toHaveValue('triaged');
   194→
   195→    await page.goForward();
   196→    await expect(page).toHaveURL(/\/triage\?.*status=acted_on/);
   197→    await expect(page.getByTestId('triage-status-filter')).toHaveValue('acted_on');
   198→  });
