   308→test.describe('Triage real-time updates via WebSocket', () => {
   309→  // AC: @interactive-triage-ui ac-6
   310→  test('triage page updates progress count in real-time when another client submits a triage decision', async ({ page, request, daemon }) => {
   311→    void daemon;
   312→    // Open triage page — Svelte component subscribes to triage:updates on mount
   313→    await page.goto('/triage');
   314→    await page.waitForLoadState('networkidle');
   315→
   316→    // Record initial progress count from the triage-progress element
   317→    const progressEl = page.getByTestId('triage-progress');
   318→    await expect(progressEl).toBeVisible();
   319→    const initialProgress = await progressEl.textContent();
   320→
   321→    // Create a fresh inbox item to triage (so we don't conflict with fixture records)
   322→    const inboxResp = await request.post('http://localhost:3456/api/inbox', {
   323→      data: { text: `Real-time update test item ${Date.now()}` },
   324→    });
   325→    expect(inboxResp.status()).toBe(200);
   326→    const inboxBody = await inboxResp.json();
   327→    const newInboxUlid = inboxBody.item._ulid;
   328→
   329→    // POST triage decision via API (simulates another client acting on the item).
   330→    // The daemon broadcasts triage:updates after mutation, which the triage page
   331→    // receives and calls loadTriageData() to refresh the displayed count.
   332→    const triageResp = await request.post('http://localhost:3456/api/triage', {
   333→      data: {
   334→        inbox_ref: `@${newInboxUlid}`,
   335→        action: 'defer',
   336→        reasoning: 'E2E real-time test',
   337→      },
   338→    });
   339→    expect(triageResp.status()).toBe(200);
   340→
   341→    // Wait for the triage page to receive the WebSocket broadcast and re-render.
   342→    // The progress count should increase since we added a new triaged record.
   343→    await expect(progressEl).not.toHaveText(initialProgress ?? '', { timeout: 5000 });
   344→  });
   345→});
   346→
   347→test.describe('Triage API operations via UI', () => {
   348→  // AC: @interactive-triage-ui ac-3
   349→  test('submitting a triage decision calls the API and updates state', async ({ page, request, daemon }) => {
   350→    void daemon;
   351→    await page.goto('/triage');
   352→    await page.waitForLoadState('networkidle');
   353→
   354→    const card = page.getByTestId('triage-card');
   355→    const hasCard = await card.isVisible().catch(() => false);
   356→
   357→    if (hasCard) {
   358→      const actionForm = card.getByTestId('triage-action-form');
   359→      const hasForm = await actionForm.isVisible().catch(() => false);
   360→
   361→      if (hasForm) {
   362→        // Select the first available action button
   363→        const actionButtons = actionForm.getByTestId(/^triage-action-/);
   364→        const buttonCount = await actionButtons.count();
   365→
   366→        if (buttonCount > 0) {
   367→          const initialPositionText = await page.getByTestId('triage-position').textContent();
   368→
   369→          await actionButtons.first().click();
   370→          const submitBtn = actionForm.getByTestId('triage-submit');
   371→          await expect(submitBtn).toBeEnabled({ timeout: 2000 });
   372→          await submitBtn.click();
   373→
   374→          // After submit, position should advance or form should update
   375→          await page.waitForTimeout(500);
   376→          // Page should still be functional (no errors thrown)
   377→          await expect(page.getByTestId('triage-position')).toBeVisible();
   378→        }
   379→      }
   380→    }
   381→  });
   382→});
