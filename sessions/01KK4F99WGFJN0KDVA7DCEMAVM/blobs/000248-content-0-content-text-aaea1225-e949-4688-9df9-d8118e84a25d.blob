     1→/**
     2→ * E2E Tests for Validation and Alignment View
     3→ *
     4→ * Tests verify the /validate page renders validation summary, alignment stats,
     5→ * and issues list grouped by severity.
     6→ *
     7→ * Covered ACs:
     8→ * - @ui-validation-view ac-1: Summary shows error count, warning count, valid item count.
     9→ *   Alignment section shows spec coverage %, AC coverage %, orphaned tasks/specs counts.
    10→ *   Issues list grouped by severity.
    11→ */
    12→
    13→import { test, expect } from '../fixtures/test-base';
    14→
    15→/** Mock validation response with issues. */
    16→function mockValidationWithIssues() {
    17→	return {
    18→		valid: false,
    19→		schemaErrors: [
    20→			{
    21→				file: 'modules/broken.yaml',
    22→				path: 'features[0]',
    23→				message: 'Invalid schema: missing required field "title"'
    24→			}
    25→		],
    26→		refErrors: [
    27→			{
    28→				ref: '@nonexistent',
    29→				sourceFile: 'modules/core.yaml',
    30→				field: 'spec_ref',
    31→				error: 'not_found',
    32→				message: 'Reference @nonexistent not found'
    33→			}
    34→		],
    35→		refWarnings: [
    36→			{
    37→				ref: '@deprecated-item',
    38→				sourceFile: 'modules/core.yaml',
    39→				field: 'implements',
    40→				warning: 'deprecated_target',
    41→				message: 'Reference @deprecated-item targets a deprecated item'
    42→			}
    43→		],
    44→		orphans: [
    45→			{
    46→				ulid: '01KTEST000000000ORPHAN0001',
    47→				title: 'Orphan requirement',
    48→				type: 'requirement',
    49→				file: 'modules/orphan.yaml'
    50→			}
    51→		],
    52→		completenessWarnings: [
    53→			{
    54→				type: 'missing_acceptance_criteria',
    55→				itemRef: '@some-feature',
    56→				itemTitle: 'Some Feature',
    57→				message: 'Item @some-feature has no acceptance criteria'
    58→			},
    59→			{
    60→				type: 'missing_test_coverage',
    61→				subtype: 'own_ac',
    62→				itemRef: '@test-feature',
    63→				itemTitle: 'Test Feature',
    64→				message: 'Item @test-feature has 1 AC(s) without test coverage',
    65→				details: 'Uncovered: ac-2'
    66→			},
    67→			{
    68→				type: 'missing_test_coverage',
    69→				subtype: 'trait_ac',
    70→				itemRef: '@batch-exec',
    71→				itemTitle: 'Batch Command Execution',
    72→				message: 'Item @batch-exec has 2 inherited trait AC(s) without test coverage',
    73→				details: 'Uncovered trait ACs: @trait-priority-parameter ac-1, @trait-priority-parameter ac-2'
    74→			}
    75→		],
    76→		traitCycles: []
    77→	};
    78→}
    79→
    80→/** Mock validation response with no issues. */
    81→function mockValidationClean() {
    82→	return {
    83→		valid: true,
    84→		schemaErrors: [],
    85→		refErrors: [],
    86→		refWarnings: [],
    87→		orphans: [],
    88→		completenessWarnings: [],
    89→		traitCycles: []
    90→	};
    91→}
    92→
    93→/** Mock alignment response. */
    94→function mockAlignment() {
    95→	return {
    96→		stats: {
    97→			totalSpecs: 10,
    98→			specsWithTasks: 7,
    99→			alignedSpecs: 5,
   100→			orphanedSpecs: 3
   101→		},
   102→		warnings: [
   103→			{
   104→				type: 'orphaned_spec',
   105→				specUlid: '01KTEST000000000ORPHSPEC01',
   106→				specTitle: 'Unimplemented Feature',
   107→				message: 'Spec item "Unimplemented Feature" has no implementing tasks'
   108→			},
   109→			{
   110→				type: 'status_mismatch',
   111→				specUlid: '01KTEST000000000MISMATCH1',
   112→				specTitle: 'Misaligned Feature',
   113→				message:
   114→					'Spec "Misaligned Feature" status is "not_started" but should be "in_progress"'
   115→			}
   116→		]
   117→	};
   118→}
   119→
   120→/** Mock items response (with acceptance_criteria_count for AC coverage calculation). */
   121→function mockItems() {
   122→	// Total ACs: 3+2+1+2+3+1+2+1+3+2 = 20 ACs across 10 items
   123→	return {
   124→		items: [
   125→			{ _ulid: '01KTEST000000000000ITEM001', title: 'Item 1', acceptance_criteria_count: 3 },
   126→			{ _ulid: '01KTEST000000000000ITEM002', title: 'Item 2', acceptance_criteria_count: 2 },
   127→			{ _ulid: '01KTEST000000000000ITEM003', title: 'Item 3', acceptance_criteria_count: 1 },
   128→			{ _ulid: '01KTEST000000000000ITEM004', title: 'Item 4', acceptance_criteria_count: 2 },
   129→			{ _ulid: '01KTEST000000000000ITEM005', title: 'Item 5', acceptance_criteria_count: 3 },
   130→			{ _ulid: '01KTEST000000000000ITEM006', title: 'Item 6', acceptance_criteria_count: 1 },
   131→			{ _ulid: '01KTEST000000000000ITEM007', title: 'Item 7', acceptance_criteria_count: 2 },
   132→			{ _ulid: '01KTEST000000000000ITEM008', title: 'Item 8', acceptance_criteria_count: 1 },
   133→			{ _ulid: '01KTEST000000000000ITEM009', title: 'Item 9', acceptance_criteria_count: 3 },
   134→			{ _ulid: '01KTEST000000000000ITEM010', title: 'Item 10', acceptance_criteria_count: 2 }
   135→		],
   136→		total: 10,
   137→		offset: 0,
   138→		limit: 999
   139→	};
   140→}
   141→
   142→/** Mock tasks response (for orphaned task count). */
   143→function mockTasks() {
   144→	return {
   145→		items: [
   146→			{
   147→				_ulid: '01KTEST000000000000TASK001',
   148→				title: 'Task with spec',
   149→				status: 'pending',
   150→				priority: 2,
   151→				spec_ref: '@test-feature',
   152→				tags: [],
   153→				depends_on: [],
   154→				created_at: '2026-01-01T00:00:00Z',
   155→				notes_count: 0
   156→			},
   157→			{
   158→				_ulid: '01KTEST000000000000TASK002',
   159→				title: 'Task without spec',
   160→				status: 'in_progress',
   161→				priority: 3,
   162→				tags: [],
   163→				depends_on: [],
   164→				created_at: '2026-01-01T00:00:00Z',
   165→				notes_count: 0
   166→			},
   167→			{
   168→				_ulid: '01KTEST000000000000TASK003',
   169→				title: 'Another orphan task',
   170→				status: 'pending',
   171→				priority: 1,
   172→				tags: [],
   173→				depends_on: [],
   174→				created_at: '2026-01-01T00:00:00Z',
   175→				notes_count: 0
   176→			}
   177→		],
   178→		total: 3,
   179→		offset: 0,
   180→		limit: 999
   181→	};
   182→}
   183→
   184→/** Register all route mocks for the validate page. */
   185→async function setupValidateRoutes(
   186→	page: import('@playwright/test').Page,
   187→	options?: {
   188→		validation?: ReturnType<typeof mockValidationWithIssues>;
   189→		alignment?: ReturnType<typeof mockAlignment>;
   190→		items?: ReturnType<typeof mockItems>;
   191→		tasks?: ReturnType<typeof mockTasks>;
   192→	}
   193→) {
   194→	const validationData = options?.validation ?? mockValidationWithIssues();
   195→	const alignmentData = options?.alignment ?? mockAlignment();
   196→	const itemsData = options?.items ?? mockItems();
   197→	const tasksData = options?.tasks ?? mockTasks();
   198→
   199→	await page.route('**/api/validate', (route) => {
   200→		route.fulfill({
   201→			status: 200,
   202→			contentType: 'application/json',
   203→			body: JSON.stringify(validationData)
   204→		});
   205→	});
   206→
   207→	await page.route('**/api/alignment', (route) => {
   208→		route.fulfill({
   209→			status: 200,
   210→			contentType: 'application/json',
   211→			body: JSON.stringify(alignmentData)
   212→		});
   213→	});
   214→
   215→	await page.route('**/api/items?*', (route) => {
   216→		route.fulfill({
   217→			status: 200,
   218→			contentType: 'application/json',
   219→			body: JSON.stringify(itemsData)
   220→		});
   221→	});
   222→
   223→	await page.route('**/api/tasks?*', (route) => {
   224→		route.fulfill({
   225→			status: 200,
   226→			contentType: 'application/json',
   227→			body: JSON.stringify(tasksData)
   228→		});
   229→	});
   230→}
   231→
   232→test.describe('Validation and Alignment View', () => {
   233→	test.describe('Summary Cards (AC-1)', () => {
   234→		// AC: @ui-validation-view ac-1
   235→		test('displays error count, warning count, and valid item count', async ({
   236→			page,
   237→			daemon
   238→		}) => {
   239→			await setupValidateRoutes(page);
   240→			await page.goto('/validate');
   241→
   242→			// Wait for data to load
   243→			await expect(page.getByTestId('summary-cards')).toBeVisible();
   244→
   245→			// Error count card
   246→			const errorCard = page.getByTestId('error-count-card');
   247→			await expect(errorCard).toBeVisible();
   248→			// 1 schemaError + 1 refError + 0 traitCycles = 2 errors
   249→			await expect(errorCard).toContainText('2');
   250→			await expect(errorCard).toContainText('Errors');
   251→
   252→			// Warning count card
   253→			const warningCard = page.getByTestId('warning-count-card');
   254→			await expect(warningCard).toBeVisible();
   255→			// 1 refWarning + 3 completenessWarnings + 1 orphan = 5 warnings
   256→			await expect(warningCard).toContainText('5');
   257→			await expect(warningCard).toContainText('Warnings');
   258→
   259→			// Valid items card
   260→			const validCard = page.getByTestId('valid-count-card');
   261→			await expect(validCard).toBeVisible();
   262→			await expect(validCard).toContainText('Valid Items');
   263→			// 10 items total, 2 source items with errors:
   264→			// schemaError from 'modules/broken.yaml', refError from sourceFile 'modules/core.yaml'
   265→			// → 10 - 2 = 8 valid items
   266→			const validCount = page.getByTestId('valid-item-count');
   267→			await expect(validCount).toContainText('8');
   268→		});
   269→
   270→		// AC: @ui-validation-view ac-1
   271→		test('shows "Issues Found" badge when validation has errors', async ({
   272→			page,
   273→			daemon
   274→		}) => {
   275→			await setupValidateRoutes(page);
   276→			await page.goto('/validate');
   277→
   278→			await expect(page.getByTestId('status-invalid')).toBeVisible();
   279→			await expect(page.getByTestId('status-invalid')).toContainText('Issues Found');
   280→		});
   281→
   282→		// AC: @ui-validation-view ac-1
   283→		test('shows "Valid" badge when all checks pass', async ({ page, daemon }) => {
   284→			await setupValidateRoutes(page, { validation: mockValidationClean() });
   285→			await page.goto('/validate');
   286→
   287→			await expect(page.getByTestId('status-valid')).toBeVisible();
   288→			await expect(page.getByTestId('status-valid')).toContainText('Valid');
   289→		});
   290→	});
   291→
   292→	test.describe('Alignment Section (AC-1)', () => {
   293→		// AC: @ui-validation-view ac-1
   294→		test('shows spec coverage percentage', async ({ page, daemon }) => {
   295→			await setupValidateRoutes(page);
   296→			await page.goto('/validate');
   297→
   298→			const specCoverage = page.getByTestId('spec-coverage');
   299→			await expect(specCoverage).toBeVisible();
   300→			// 7/10 specs with tasks = 70%
   301→			await expect(specCoverage).toContainText('70%');
   302→			await expect(specCoverage).toContainText('Spec Coverage');
   303→		});
   304→
   305→		// AC: @ui-validation-view ac-1
   306→		test('shows AC coverage percentage', async ({ page, daemon }) => {
   307→			await setupValidateRoutes(page);
   308→			await page.goto('/validate');
   309→
   310→			const acCoverage = page.getByTestId('ac-coverage');
   311→			await expect(acCoverage).toBeVisible();
   312→			await expect(acCoverage).toContainText('AC Coverage');
   313→			// 20 total ACs (from acceptance_criteria_count)
   314→			// 1 uncovered own AC (from "Uncovered: ac-2") + 2 uncovered trait ACs
   315→			// (from "Uncovered trait ACs: @trait-priority-parameter ac-1, @trait-priority-parameter ac-2")
   316→			// Coverage = (20 - 3) / 20 = 85%
   317→			await expect(acCoverage).toContainText('85%');
   318→			await expect(acCoverage).toContainText('17/20 ACs with tests');
   319→		});
   320→
   321→		// AC: @ui-validation-view ac-1
   322→		test('AC coverage includes uncovered trait ACs', async ({ page, daemon }) => {
   323→			// Build validation with ONLY trait AC warnings (no own AC warnings)
   324→			const traitOnlyValidation = {
   325→				...mockValidationClean(),
   326→				completenessWarnings: [
   327→					{
   328→						type: 'missing_test_coverage',
   329→						subtype: 'trait_ac',
   330→						itemRef: '@batch-exec',
   331→						itemTitle: 'Batch Command Execution',
   332→						message: 'Item @batch-exec has 3 inherited trait AC(s) without test coverage',
   333→						details:
   334→							'Uncovered trait ACs: @trait-priority-parameter ac-1, @trait-priority-parameter ac-2, @trait-priority-parameter ac-3'
   335→					}
   336→				]
   337→			};
   338→			await setupValidateRoutes(page, { validation: traitOnlyValidation });
   339→			await page.goto('/validate');
   340→
   341→			const acCoverage = page.getByTestId('ac-coverage');
   342→			await expect(acCoverage).toBeVisible();
   343→			// 20 total ACs, 3 uncovered trait ACs → (20 - 3) / 20 = 85%
   344→			await expect(acCoverage).toContainText('85%');
   345→			await expect(acCoverage).toContainText('17/20 ACs with tests');
   346→		});
   347→
   348→		// AC: @ui-validation-view ac-1
   349→		test('shows orphaned tasks count', async ({ page, daemon }) => {
   350→			await setupValidateRoutes(page);
   351→			await page.goto('/validate');
   352→
   353→			const orphanedTasks = page.getByTestId('orphaned-tasks');
   354→			await expect(orphanedTasks).toBeVisible();
   355→			await expect(orphanedTasks).toContainText('Orphaned Tasks');
   356→			// 2 tasks without spec_ref
   357→			await expect(orphanedTasks).toContainText('2');
   358→		});
   359→
   360→		// AC: @ui-validation-view ac-1
   361→		test('shows orphaned specs count', async ({ page, daemon }) => {
   362→			await setupValidateRoutes(page);
   363→			await page.goto('/validate');
   364→
   365→			const orphanedSpecs = page.getByTestId('orphaned-specs');
   366→			await expect(orphanedSpecs).toBeVisible();
   367→			await expect(orphanedSpecs).toContainText('Orphaned Specs');
   368→			// 3 orphaned specs from alignment stats
   369→			await expect(orphanedSpecs).toContainText('3');
   370→		});
   371→	});
   372→
   373→	test.describe('Issues List (AC-1)', () => {
   374→		// AC: @ui-validation-view ac-1
   375→		test('shows issues grouped by severity', async ({ page, daemon }) => {
   376→			await setupValidateRoutes(page);
   377→			await page.goto('/validate');
   378→
   379→			const issuesList = page.getByTestId('issues-list');
   380→			await expect(issuesList).toBeVisible();
   381→
   382→			// Error issues group
   383→			const errorGroup = page.getByTestId('error-issues');
   384→			await expect(errorGroup).toBeVisible();
   385→			await expect(errorGroup).toContainText('Errors (2)');
   386→
   387→			// Warning issues group
   388→			const warningGroup = page.getByTestId('warning-issues');
   389→			await expect(warningGroup).toBeVisible();
   390→			// 1 refWarning + 3 completenessWarnings + 1 status_mismatch alignment = 5 warnings
   391→			await expect(warningGroup).toContainText('Warnings (5)');
   392→
   393→			// Info issues group
   394→			const infoGroup = page.getByTestId('info-issues');
   395→			await expect(infoGroup).toBeVisible();
   396→			// 1 orphan + 1 orphaned_spec alignment warning = 2 info
   397→			await expect(infoGroup).toContainText('Info (2)');
   398→		});
   399→
   400→		// AC: @ui-validation-view ac-1
   401→		test('error issues show category badge and message', async ({ page, daemon }) => {
   402→			await setupValidateRoutes(page);
   403→			await page.goto('/validate');
   404→
   405→			const errorIssues = page.getByTestId('issue-error');
   406→			await expect(errorIssues).toHaveCount(2);
   407→
   408→			// First error: schema error
   409→			const firstError = errorIssues.nth(0);
   410→			await expect(firstError).toContainText('Schema');
   411→			await expect(firstError).toContainText('Invalid schema');
   412→
   413→			// Second error: reference error
   414→			const secondError = errorIssues.nth(1);
   415→			await expect(secondError).toContainText('Reference');
   416→			await expect(secondError).toContainText('@nonexistent not found');
   417→		});
   418→
   419→		// AC: @ui-validation-view ac-1
   420→		test('shows no issues message when validation is clean', async ({ page, daemon }) => {
   421→			await setupValidateRoutes(page, {
   422→				validation: mockValidationClean(),
   423→				alignment: { stats: mockAlignment().stats, warnings: [] }
   424→			});
