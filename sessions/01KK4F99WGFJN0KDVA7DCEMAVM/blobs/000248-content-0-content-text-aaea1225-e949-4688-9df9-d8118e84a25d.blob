   433→	test.describe('Loading State', () => {
   434→		test('shows loading skeleton while fetching', async ({ page, daemon }) => {
   435→			// Delay the response to observe loading state
   436→			await page.route('**/api/validate', async (route) => {
   437→				await new Promise((r) => setTimeout(r, 500));
   438→				route.fulfill({
   439→					status: 200,
   440→					contentType: 'application/json',
   441→					body: JSON.stringify(mockValidationClean())
   442→				});
   443→			});
   444→			await page.route('**/api/alignment', (route) => {
   445→				route.fulfill({
   446→					status: 200,
   447→					contentType: 'application/json',
   448→					body: JSON.stringify(mockAlignment())
   449→				});
   450→			});
   451→			await page.route('**/api/items?*', (route) => {
   452→				route.fulfill({
   453→					status: 200,
   454→					contentType: 'application/json',
   455→					body: JSON.stringify(mockItems())
   456→				});
   457→			});
   458→			await page.route('**/api/tasks?*', (route) => {
   459→				route.fulfill({
   460→					status: 200,
   461→					contentType: 'application/json',
   462→					body: JSON.stringify(mockTasks())
   463→				});
   464→			});
   465→
   466→			await page.goto('/validate');
   467→
   468→			const skeleton = page.getByTestId('loading');
   469→			await expect(skeleton).toBeVisible();
   470→
   471→			// Eventually loads
   472→			await expect(page.getByTestId('summary-cards')).toBeVisible({ timeout: 5000 });
   473→		});
   474→	});
