```
     1→<script lang="ts">
     2→	// AC: @ui-validation-view ac-1
     3→	import {
     4→		fetchValidation,
     5→		fetchAlignment,
     6→		fetchItems,
     7→		fetchTasks,
     8→		type ValidationResponse,
     9→		type AlignmentResponse,
    10→		type CompletenessWarning
    11→	} from '$lib/api';
    12→	import { Card, CardContent, CardHeader, CardTitle } from '$lib/components/ui/card';
    13→	import { Badge } from '$lib/components/ui/badge';
    14→	import {
    15→		ShieldCheck,
    16→		ShieldAlert,
    17→		AlertTriangle,
    18→		AlertCircle,
    19→		CheckCircle2,
    20→		Info,
    21→		Link2Off,
    22→		FileWarning,
    23→		RefreshCw
    24→	} from 'lucide-svelte';
    25→	import { getProjectVersion, isInitialized as isProjectInitialized } from '$lib/stores/project.svelte';
    26→
    27→	// --- State ---
    28→
    29→	let validation = $state<ValidationResponse | null>(null);
    30→	let alignment = $state<AlignmentResponse | null>(null);
    31→	let totalItemCount = $state(0);
    32→	let totalAcCount = $state(0);
    33→	let orphanedTaskCount = $state(0);
    34→	let loading = $state(true);
    35→	let error = $state('');
    36→
    37→	// --- Derived counts ---
    38→	// AC: @ui-validation-view ac-1 — error count, warning count, valid item count
    39→
    40→	let errorCount = $derived.by(() => {
    41→		if (!validation) return 0;
    42→		return (
    43→			validation.schemaErrors.length +
    44→			validation.refErrors.length +
    45→			validation.traitCycles.length
    46→		);
    47→	});
    48→
    49→	let warningCount = $derived.by(() => {
    50→		if (!validation) return 0;
    51→		return (
    52→			validation.refWarnings.length +
    53→			validation.completenessWarnings.length +
    54→			validation.orphans.length
    55→		);
    56→	});
    57→
    58→	// AC: @ui-validation-view ac-1 — valid item count
    59→	// Count unique items that have errors (using the source item, not the broken target)
    60→	let validItemCount = $derived.by(() => {
    61→		if (!validation) return 0;
    62→		const itemsWithErrors = new Set<string>();
    63→		for (const e of validation.schemaErrors) {
    64→			// schemaErrors.file = the YAML file containing the invalid item
    65→			if (e.file) itemsWithErrors.add(e.file);
    66→		}
    67→		for (const e of validation.refErrors) {
    68→			// sourceUlid/sourceFile = the item containing the broken reference
    69→			// (NOT e.ref, which is the target that doesn't exist)
    70→			const source = e.sourceUlid ?? e.sourceFile;
    71→			if (source) itemsWithErrors.add(source);
    72→		}
    73→		for (const e of validation.traitCycles) {
    74→			// traitRef = the trait involved in the cycle
    75→			if (e.traitRef) itemsWithErrors.add(e.traitRef);
    76→		}
    77→		return Math.max(0, totalItemCount - itemsWithErrors.size);
    78→	});
    79→
    80→	// AC: @ui-validation-view ac-1 — spec coverage %, AC coverage %
    81→	let specCoverage = $derived.by(() => {
    82→		if (!alignment || alignment.stats.totalSpecs === 0) return 0;
    83→		return Math.round(
    84→			(alignment.stats.specsWithTasks / alignment.stats.totalSpecs) * 100
    85→		);
    86→	});
    87→
    88→	// AC: @ui-validation-view ac-1 — AC coverage %
    89→	// Computed from total AC count (from items API) minus uncovered ACs (from completeness warnings)
    90→	let uncoveredAcCount = $derived.by(() => {
    91→		if (!validation) return 0;
    92→		return countUncoveredACs(validation.completenessWarnings);
    93→	});
    94→
    95→	let acCoverage = $derived.by(() => {
    96→		if (totalAcCount === 0) return 100;
    97→		const covered = totalAcCount - uncoveredAcCount;
    98→		return Math.round((covered / totalAcCount) * 100);
    99→	});
   100→
   101→	// --- Group issues by severity ---
   102→
   103→	type GroupedIssue = {
   104→		severity: 'error' | 'warning' | 'info';
   105→		category: string;
   106→		message: string;
   107→		detail?: string;
   108→	};
   109→
   110→	let groupedIssues = $derived.by((): GroupedIssue[] => {
   111→		if (!validation && !alignment) return [];
   112→		const issues: GroupedIssue[] = [];
   113→
   114→		if (validation) {
   115→			for (const e of validation.schemaErrors) {
   116→				issues.push({
   117→					severity: 'error',
   118→					category: 'Schema',
   119→					message: e.message,
   120→					detail: e.file + (e.path ? ` (${e.path})` : '')
   121→				});
   122→			}
   123→			for (const e of validation.refErrors) {
   124→				issues.push({
   125→					severity: 'error',
   126→					category: 'Reference',
   127→					message: e.message,
   128→					detail: `${e.ref} in ${e.field}`
   129→				});
   130→			}
   131→			for (const e of validation.traitCycles) {
   132→				issues.push({
   133→					severity: 'error',
   134→					category: 'Trait Cycle',
   135→					message: e.message,
   136→					detail: e.cycle.join(' → ')
   137→				});
   138→			}
   139→			for (const w of validation.refWarnings) {
   140→				issues.push({
   141→					severity: 'warning',
   142→					category: 'Reference',
   143→					message: w.message,
   144→					detail: `${w.ref} in ${w.field}`
   145→				});
   146→			}
   147→			for (const w of validation.completenessWarnings) {
   148→				issues.push({
   149→					severity: 'warning',
   150→					category: completenessLabel(w.type),
   151→					message: w.message,
   152→					detail: w.details ?? `${w.itemRef} — ${w.itemTitle}`
   153→				});
   154→			}
   155→			for (const o of validation.orphans) {
   156→				issues.push({
   157→					severity: 'info',
   158→					category: 'Orphan',
   159→					message: `${o.title} (${o.type})`,
   160→					detail: o.file ?? o.ulid
   161→				});
   162→			}
   163→		}
   164→
   165→		if (alignment) {
   166→			for (const w of alignment.warnings) {
   167→				issues.push({
   168→					severity: w.type === 'status_mismatch' ? 'warning' : 'info',
   169→					category: alignmentLabel(w.type),
   170→					message: w.message,
   171→					detail: w.specTitle ?? w.specUlid
   172→				});
   173→			}
   174→		}
   175→
   176→		return issues;
   177→	});
   178→
   179→	let errorIssues = $derived(groupedIssues.filter((i) => i.severity === 'error'));
   180→	let warningIssues = $derived(groupedIssues.filter((i) => i.severity === 'warning'));
   181→	let infoIssues = $derived(groupedIssues.filter((i) => i.severity === 'info'));
   182→
   183→	// --- Lifecycle ---
   184→	// Load data when project is ready and reload on project change.
   185→	// Gates on isProjectInitialized() to prevent loading with wrong/missing project context.
   186→	$effect(() => {
   187→		const version = getProjectVersion();
   188→		const ready = isProjectInitialized();
   189→		if (!ready) return;
   190→		loadData();
   191→	});
   192→
   193→	async function loadData() {
   194→		try {
   195→			loading = true;
   196→			error = '';
   197→			const [v, a, itemsRes, tasksRes] = await Promise.all([
   198→				fetchValidation(),
   199→				fetchAlignment(),
   200→				fetchItems({ limit: 999 }),
   201→				fetchTasks({ limit: 999 })
   202→			]);
   203→			validation = v;
   204→			alignment = a;
   205→			totalItemCount = itemsRes.total;
   206→			// Sum acceptance_criteria_count from all items (field returned by daemon but not in ItemSummary type)
   207→			totalAcCount = itemsRes.items.reduce(
   208→				(sum, item) => sum + ((item as any).acceptance_criteria_count ?? 0),
   209→				0
   210→			);
   211→			// Orphaned tasks = tasks without a spec_ref
   212→			orphanedTaskCount = tasksRes.items.filter((t) => !t.spec_ref).length;
   213→		} catch (err) {
   214→			error = err instanceof Error ? err.message : 'Failed to load validation data';
   215→		} finally {
   216→			loading = false;
   217→		}
   218→	}
   219→
   220→	// --- Helpers ---
   221→
   222→	function completenessLabel(type: string): string {
   223→		const labels: Record<string, string> = {
   224→			missing_acceptance_criteria: 'Missing AC',
   225→			missing_description: 'Missing Description',
   226→			status_inconsistency: 'Status Inconsistency',
   227→			missing_test_coverage: 'Test Coverage',
   228→			automation_eligible_no_spec: 'No Spec',
   229→			ac_schema_field_mismatch: 'AC Schema Mismatch'
   230→		};
   231→		return labels[type] ?? type;
   232→	}
   233→
   234→	/** Count total uncovered ACs from completeness warnings details field.
   235→	 * Own AC format: "Uncovered: ac-1, ac-2"
   236→	 * Trait AC format: "Uncovered trait ACs: @trait-slug ac-1, @trait-slug ac-2"
   237→	 */
   238→	function countUncoveredACs(warnings: CompletenessWarning[]): number {
   239→		let count = 0;
   240→		for (const w of warnings) {
   241→			if (w.type === 'missing_test_coverage' && w.details) {
   242→				// Match both "Uncovered: ..." and "Uncovered trait ACs: ..."
   243→				const match = w.details.match(/^Uncovered(?:\s+trait\s+ACs)?:\s*(.+)$/);
   244→				if (match) {
   245→					count += match[1].split(',').length;
   246→				}
   247→			}
   248→		}
   249→		return count;
   250→	}
   251→
   252→	function alignmentLabel(type: string): string {
   253→		const labels: Record<string, string> = {
   254→			orphaned_spec: 'Orphaned Spec',
   255→			status_mismatch: 'Status Mismatch',
   256→			stale_implementation: 'Stale Implementation'
   257→		};
   258→		return labels[type] ?? type;
   259→	}
   260→</script>
   261→
   262→<!-- AC: @ui-validation-view ac-1 -->
   263→<div class="flex flex-col gap-6" data-testid="validate-page">
   264→	<div class="flex items-center justify-between">
   265→		<div class="flex items-center gap-3">
   266→			<h1 class="text-3xl font-bold">Validate</h1>
   267→			{#if !loading && validation}
   268→				{#if validation.valid && errorCount === 0}
   269→					<Badge class="bg-severity-success text-severity-success-fg" data-testid="status-valid">
   270→						<CheckCircle2 class="mr-1 h-3 w-3" />
   271→						Valid
   272→					</Badge>
   273→				{:else}
   274→					<Badge class="bg-severity-error text-severity-error-fg" data-testid="status-invalid">
