   480→							<AlertCircle class="h-4 w-4" />
   481→							Errors ({errorIssues.length})
   482→						</h3>
   483→						<div class="space-y-2">
   484→							{#each errorIssues as issue}
   485→								<div class="rounded-md border p-3 bg-severity-error-muted border-severity-error-border" data-testid="issue-error">
   486→									<div class="flex items-start gap-2">
   487→										<AlertCircle class="h-4 w-4 mt-0.5 text-severity-error shrink-0" />
   488→										<div class="min-w-0">
   489→											<div class="flex items-center gap-2 flex-wrap">
   490→												<Badge variant="outline" class="text-xs">{issue.category}</Badge>
   491→												<span class="text-sm font-medium">{issue.message}</span>
   492→											</div>
   493→											{#if issue.detail}
   494→												<p class="text-xs text-muted-foreground mt-1 font-mono truncate">
   495→													{issue.detail}
   496→												</p>
   497→											{/if}
   498→										</div>
   499→									</div>
   500→								</div>
   501→							{/each}
   502→						</div>
   503→					</div>
   504→				{/if}
   505→
   506→				<!-- Warnings group -->
   507→				{#if warningIssues.length > 0}
   508→					<div data-testid="warning-issues">
   509→						<h3 class="text-sm font-medium text-severity-warning-muted-fg mb-2 flex items-center gap-1.5">
   510→							<AlertTriangle class="h-4 w-4" />
   511→							Warnings ({warningIssues.length})
   512→						</h3>
   513→						<div class="space-y-2">
   514→							{#each warningIssues as issue}
   515→								<div class="rounded-md border p-3 bg-severity-warning-muted border-severity-warning-border" data-testid="issue-warning">
   516→									<div class="flex items-start gap-2">
   517→										<AlertTriangle class="h-4 w-4 mt-0.5 text-severity-warning-muted-fg shrink-0" />
   518→										<div class="min-w-0">
   519→											<div class="flex items-center gap-2 flex-wrap">
   520→												<Badge variant="outline" class="text-xs">{issue.category}</Badge>
   521→												<span class="text-sm font-medium">{issue.message}</span>
   522→											</div>
   523→											{#if issue.detail}
