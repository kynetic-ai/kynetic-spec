   278→				{/if}
   279→			{/if}
   280→		</div>
   281→		{#if !loading}
   282→			<button
   283→				class="inline-flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-sm
   284→					text-muted-foreground transition-colors hover:bg-muted/50"
   285→				onclick={loadData}
   286→				data-testid="refresh-btn"
   287→			>
   288→				<RefreshCw class="h-3.5 w-3.5" />
   289→				Refresh
   290→			</button>
   291→		{/if}
   292→	</div>
   293→
   294→	<!-- Error banner -->
   295→	{#if error}
   296→		<div
   297→			class="rounded-md bg-severity-error-muted p-4 text-sm text-severity-error-muted-fg"
