   300→		>
   301→			{error}
   302→		</div>
   303→	{/if}
   304→
   305→	<!-- Loading state -->
   306→	{#if loading}
   307→		<div class="space-y-4" data-testid="loading">
   308→			<div class="grid gap-4 md:grid-cols-3">
   309→				{#each Array(3) as _}
   310→					<Card>
   311→						<CardHeader class="pb-2">
   312→							<div class="h-4 w-24 rounded bg-muted ds-shimmer"></div>
   313→						</CardHeader>
   314→						<CardContent>
   315→							<div class="h-8 w-16 rounded bg-muted ds-shimmer"></div>
   316→						</CardContent>
   317→					</Card>
   318→				{/each}
   319→			</div>
   320→			<Card>
   321→				<CardHeader class="pb-2">
   322→					<div class="h-4 w-32 rounded bg-muted ds-shimmer"></div>
   323→				</CardHeader>
   324→				<CardContent class="space-y-3">
   325→					{#each Array(3) as _}
   326→						<div class="h-4 w-full rounded bg-muted ds-shimmer"></div>
   327→					{/each}
   328→				</CardContent>
   329→			</Card>
   330→		</div>
   331→
   332→	<!-- Empty state (no data returned) -->
   333→	{:else if !validation && !alignment && !error}
   334→		<div class="text-center text-muted-foreground py-12" data-testid="empty">
   335→			<ShieldCheck class="mx-auto h-12 w-12 mb-4 opacity-50" />
   336→			<p>No validation data available.</p>
   337→			<p class="text-sm">Connect to a running daemon to run validation.</p>
   338→		</div>
   339→
   340→	<!-- Data loaded -->
   341→	{:else}
   342→		<!-- Summary Cards -->
   343→		<!-- AC: @ui-validation-view ac-1 — error count, warning count, valid item count -->
   344→		<div class="grid gap-4 md:grid-cols-3" data-testid="summary-cards">
   345→			<Card data-testid="error-count-card">
   346→				<CardHeader class="flex flex-row items-center justify-between pb-2 space-y-0">
   347→					<CardTitle class="text-sm font-medium">Errors</CardTitle>
