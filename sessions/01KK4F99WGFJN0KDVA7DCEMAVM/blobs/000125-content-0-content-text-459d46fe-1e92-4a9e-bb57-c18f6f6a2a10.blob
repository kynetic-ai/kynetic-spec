   391→		<!-- Alignment Section -->
   392→		<!-- AC: @ui-validation-view ac-1 — spec coverage %, AC coverage %, orphaned tasks/specs counts -->
   393→		{#if alignment}
   394→			<Card data-testid="alignment-section">
