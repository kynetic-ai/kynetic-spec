   465→		{/if}
   466→
   467→		<!-- Issues List -->
   468→		<!-- AC: @ui-validation-view ac-1 — Issues list grouped by severity -->
   469→		{#if groupedIssues.length > 0}
   470→			<div class="space-y-4" data-testid="issues-list">
   471→				<h2 class="text-xl font-semibold flex items-center gap-2">
