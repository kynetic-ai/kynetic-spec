   321→/**
   322→ * Add a new inbox item
   323→ * AC: @web-dashboard ac-18
   324→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   325→ * AC: @gh-pages-export ac-17, ac-18 - Disabled in static mode
   326→ */
   327→export async function addInboxItem(text: string, tags?: string[]): Promise<InboxItem> {
   328→	// AC: @gh-pages-export ac-17, ac-18 - Write operations throw in static mode
   329→	assertWritable('add inbox item');
   330→
   331→	const response = await fetch(`${API_BASE}/api/inbox`, {
   332→		method: 'POST',
   333→		headers: {
   334→			'Content-Type': 'application/json',
   335→			...getProjectHeaders()
   336→		},
   337→		body: JSON.stringify({ text, tags })
   338→	});
   339→	if (!response.ok) {
   340→		await handleResponseError(response);
   341→	}
   342→
   343→	const result = await response.json();
   344→	return result.item;
   345→}
