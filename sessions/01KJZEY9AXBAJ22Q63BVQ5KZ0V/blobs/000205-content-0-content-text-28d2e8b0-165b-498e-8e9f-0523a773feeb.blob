   657→/**
   658→ * Execute a triage action
   659→ * AC: @interactive-triage-ui ac-3
   660→ */
   661→export async function actOnTriageRecord(
   662→	ref: string
   663→): Promise<{ success: boolean; record: TriageRecord }> {
   664→	assertWritable('execute triage action');
   665→
   666→	const response = await fetch(`${API_BASE}/api/triage/${ref}/act`, {
   667→		method: 'POST',
   668→		headers: getProjectHeaders()
   669→	});
   670→	if (!response.ok) {
   671→		await handleResponseError(response);
   672→	}
   673→
   674→	return response.json();
   675→}
