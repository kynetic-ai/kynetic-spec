   427→/**
   428→ * Search across all entities
   429→ * AC: @web-dashboard ac-24
   430→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   431→ * AC: @gh-pages-export ac-11 - Static mode support
   432→ */
   433→export async function search(query: string): Promise<SearchResponse> {
   434→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   435→	if (isStaticMode()) {
   436→		return searchStatic(query);
   437→	}
   438→
   439→	const url = new URL(`${API_BASE}/api/search`);
   440→	url.searchParams.set('q', query);
   441→
   442→	const response = await fetch(url.toString(), {
   443→		headers: getProjectHeaders()
   444→	});
   445→	if (!response.ok) {
   446→		await handleResponseError(response);
   447→	}
   448→
   449→	return response.json();
   450→}
