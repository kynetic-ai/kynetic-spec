   248→		if (!item) {
   249→			throw new Error(`Item not found: ${ref}`);
   250→		}
   251→		return item;
   252→	}
   253→
   254→	const response = await fetch(`${API_BASE}/api/items/${ref}`, {
   255→		headers: getProjectHeaders()
   256→	});
   257→	if (!response.ok) {
   258→		await handleResponseError(response);
   259→	}
   260→
   261→	return response.json();
   262→}
