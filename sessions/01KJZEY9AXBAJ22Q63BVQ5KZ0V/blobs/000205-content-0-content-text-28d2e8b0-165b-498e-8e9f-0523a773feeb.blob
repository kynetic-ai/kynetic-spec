   554→/**
   555→ * Agent definition from GET /api/meta/agents
   556→ */
   557→export interface AgentDefinition {
   558→	_ulid: string;
   559→	id: string;
   560→	name: string;
   561→	description?: string;
   562→	adapter?: string;
   563→	dispatch: Array<{
   564→		on: string;
   565→		filter?: {
   566→			automation?: string;
   567→			tags?: string[];
   568→			priority?: number;
   569→		};
   570→	}>;
   571→	capabilities: string[];
   572→	tools: string[];
   573→	skills: string[];
   574→	budget?: {
   575→		max_tasks?: number;
   576→		timeout_minutes?: number;
   577→	};
   578→	concurrency: {
   579→		max_concurrent: number;
   580→	};
   581→	auto_approve: boolean;
   582→}
   583→
   584→/**
   585→ * Active invocation from GET /api/agent/status
   586→ */
