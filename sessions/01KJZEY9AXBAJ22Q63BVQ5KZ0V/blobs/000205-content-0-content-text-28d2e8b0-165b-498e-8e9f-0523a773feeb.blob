   713→// ============================================================
   714→// Session API Functions
   715→// AC: @ui-session-stream ac-1, ac-2, ac-4
   716→// ============================================================
   717→
   718→/**
   719→ * Session summary from the daemon API.
   720→ */
   721→export interface SessionSummary {
   722→	id: string;
   723→	status: 'active' | 'completed' | 'abandoned' | 'timed_out' | 'failed';
   724→	agent_type: string;
   725→	session_type: 'loop' | 'invocation';
   726→	/** Task ID being worked on (if any). AC: @ui-session-history ac-1 */
   727→	task_id?: string;
   728→	started_at: string;
   729→	ended_at?: string;
   730→	duration_ms: number;
   731→	event_count: number;
   732→	iteration_count: number;
   733→	tasks_completed: number;
   734→}
   735→
   736→/**
   737→ * Spec context with acceptance criteria checklist.
   738→ * AC: @ui-session-stream ac-4
   739→ */
   740→export interface SessionSpecContext {
   741→	spec_ref: string;
   742→	title: string;
   743→	acceptance_criteria: Array<{ id: string; description: string }>;
   744→}
   745→
   746→/**
   747→ * Session budget info.
   748→ * AC: @ui-session-stream ac-4
   749→ */
   750→export interface SessionBudget {
   751→	max_per_cycle: number;
   752→	started_this_cycle: number;
   753→}
   754→
   755→/**
   756→ * Session detail with additional metadata.
   757→ * AC: @ui-session-stream ac-4
   758→ */
   759→export interface SessionDetail extends SessionSummary {
   760→	task_id?: string;
   761→	agent_id?: string;
   762→	trigger?: string;
   763→	spec_context?: SessionSpecContext | null;
   764→	budget?: SessionBudget | null;
   765→}
   766→
   767→/**
   768→ * A single event from events.jsonl.
   769→ */
   770→export interface SessionEvent {
   771→	ts: number;
   772→	seq: number;
   773→	type: string;
   774→	session_id: string;
   775→	trace_id?: string;
   776→	data: unknown;
   777→}
   778→
   779→/**
   780→ * Fetch all sessions with summaries.
   781→ * AC: @ui-session-stream ac-1
   782→ */
   783→export async function fetchSessions(): Promise<{ items: SessionSummary[]; total: number }> {
   784→	if (isStaticMode()) {
   785→		return { items: [], total: 0 };
   786→	}
   787→
   788→	const response = await fetch(`${API_BASE}/api/sessions`, {
   789→		headers: getProjectHeaders()
   790→	});
   791→	if (!response.ok) {
   792→		await handleResponseError(response);
   793→	}
   794→
   795→	return response.json();
   796→}
   797→
   798→/**
   799→ * Fetch a single session by ID.
   800→ * AC: @ui-session-stream ac-4
   801→ */
   802→export async function fetchSession(id: string): Promise<SessionDetail> {
   803→	if (isStaticMode()) {
   804→		throw new Error('Session data not available in static mode');
   805→	}
   806→
   807→	const response = await fetch(`${API_BASE}/api/sessions/${id}`, {
   808→		headers: getProjectHeaders()
   809→	});
   810→	if (!response.ok) {
   811→		await handleResponseError(response);
   812→	}
   813→
   814→	return response.json();
   815→}
   816→
   817→/**
   818→ * Fetch session events (optionally incremental via since_seq).
   819→ * AC: @ui-session-stream ac-1, ac-2
   820→ */
   821→export async function fetchSessionEvents(
   822→	id: string,
   823→	sinceSeq?: number
   824→): Promise<{ events: SessionEvent[]; total: number }> {
   825→	if (isStaticMode()) {
   826→		return { events: [], total: 0 };
   827→	}
   828→
   829→	const url = new URL(`${API_BASE}/api/sessions/${id}/events`);
   830→	if (sinceSeq !== undefined) {
   831→		url.searchParams.set('since_seq', String(sinceSeq));
   832→	}
   833→
   834→	const response = await fetch(url.toString(), {
   835→		headers: getProjectHeaders()
   836→	});
   837→	if (!response.ok) {
   838→		await handleResponseError(response);
   839→	}
   840→
   841→	return response.json();
   842→}
