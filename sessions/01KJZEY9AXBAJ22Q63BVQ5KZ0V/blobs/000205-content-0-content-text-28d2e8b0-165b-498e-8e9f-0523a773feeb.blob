   677→// ============================================================
   678→// Plans API Functions
   679→// AC: @ui-plans-view ac-1
   680→// ============================================================
   681→
   682→/**
   683→ * Fetch plans with optional status filter
   684→ * AC: @ui-plans-view ac-1
   685→ */
   686→export async function fetchPlans(params?: {
   687→	status?: string;
   688→}): Promise<{ items: PlanSummary[]; total: number }> {
   689→	if (isStaticMode()) {
   690→		return fetchPlansStatic(params);
   691→	}
   692→
   693→	const url = new URL(`${API_BASE}/api/plans`);
   694→
   695→	if (params) {
   696→		Object.entries(params).forEach(([key, value]) => {
   697→			if (value !== undefined && value !== '') {
   698→				url.searchParams.set(key, String(value));
   699→			}
   700→		});
   701→	}
   702→
   703→	const response = await fetch(url.toString(), {
   704→		headers: getProjectHeaders()
   705→	});
   706→	if (!response.ok) {
   707→		await handleResponseError(response);
   708→	}
   709→
   710→	return response.json();
   711→}
