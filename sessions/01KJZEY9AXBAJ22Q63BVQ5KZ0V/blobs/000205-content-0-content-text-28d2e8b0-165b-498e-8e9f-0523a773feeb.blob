   366→/**
   367→ * Fetch session context
   368→ * AC: @web-dashboard ac-20
   369→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   370→ * AC: @gh-pages-export ac-11 - Static mode support
   371→ */
   372→export async function fetchSessionContext(): Promise<SessionContext> {
   373→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   374→	if (isStaticMode()) {
   375→		const session = fetchSessionContextStatic();
   376→		if (!session) {
   377→			return { focus: null, threads: [], open_questions: [], updated_at: new Date().toISOString() };
   378→		}
   379→		return session;
   380→	}
   381→
   382→	const response = await fetch(`${API_BASE}/api/meta/session`, {
   383→		headers: getProjectHeaders()
   384→	});
   385→	if (!response.ok) {
   386→		await handleResponseError(response);
   387→	}
   388→
   389→	return response.json();
   390→}
