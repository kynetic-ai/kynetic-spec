```
     1→/**
     2→ * API Client
     3→ *
     4→ * Helper functions for making requests to the kspec daemon API.
     5→ * Supports both daemon mode (live) and static mode (read-only JSON).
     6→ *
     7→ * AC Coverage:
     8→ * - ac-26 (@multi-directory-daemon): X-Kspec-Dir header injection
     9→ * - ac-36 (@multi-directory-daemon): Invalid project error detection
    10→ * - ac-11 (@gh-pages-export): Mode-aware API dispatch
    11→ * - ac-18 (@gh-pages-export): Graceful no-op for write operations
    12→ */
    13→
    14→import type {
    15→	TaskSummary,
    16→	TaskDetail,
    17→	ItemSummary,
    18→	ItemDetail,
    19→	InboxItem,
    20→	SessionContext,
    21→	Observation,
    22→	PaginatedResponse,
    23→	PlanSummary,
    24→	ErrorResponse,
    25→	SearchResponse
    26→} from '@kynetic-ai/shared';
    27→import type { TriageRecord } from './types/triage';
    28→import {
    29→	getSelectedProjectPath,
    30→	clearInvalidSelection,
    31→	isInvalidProjectError,
    32→	type Project
    33→} from './stores/project.svelte';
    34→import { isStaticMode, assertWritable } from './stores/mode.svelte';
    35→import {
    36→	fetchTasksStatic,
    37→	fetchTaskStatic,
    38→	fetchItemsStatic,
    39→	fetchItemStatic,
    40→	fetchItemTasksStatic,
    41→	fetchInboxStatic,
    42→	fetchSessionContextStatic,
    43→	fetchObservationsStatic,
    44→	searchStatic,
    45→	fetchTriageRecordsStatic,
    46→	fetchPlansStatic
    47→} from './api-static';
    48→import { DAEMON_API_BASE } from './constants';
    49→
    50→const API_BASE = DAEMON_API_BASE;
    51→
    52→/**
    53→ * Get headers for API requests, including X-Kspec-Dir if project is selected
    54→ * AC: @multi-directory-daemon ac-26
    55→ */
    56→function getProjectHeaders(): HeadersInit {
    57→	const path = getSelectedProjectPath();
    58→	return path ? { 'X-Kspec-Dir': path } : {};
    59→}
    60→
    61→/**
    62→ * Handle response errors, detecting invalid project errors
    63→ * AC: @multi-directory-daemon ac-36
    64→ */
    65→async function handleResponseError(response: Response): Promise<never> {
    66→	const error: ErrorResponse = await response.json();
    67→	const message = error.message || error.error;
    68→
    69→	// Check if this is an invalid project error
    70→	if (isInvalidProjectError(response, message)) {
    71→		clearInvalidSelection();
    72→	}
    73→
    74→	throw new Error(message);
    75→}
    76→
    77→/**
    78→ * Fetch registered projects
    79→ * AC: @multi-directory-daemon ac-25, ac-28
    80→ */
    81→export async function fetchProjects(): Promise<{ projects: Project[] }> {
    82→	const response = await fetch(`${API_BASE}/api/projects`);
    83→	if (!response.ok) {
    84→		await handleResponseError(response);
    85→	}
    86→	return response.json();
    87→}
    88→
    89→/**
    90→ * Fetch tasks with optional filters
    91→ * AC: @web-dashboard ac-9, ac-10
    92→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
    93→ * AC: @gh-pages-export ac-11 - Static mode support
    94→ */
    95→export async function fetchTasks(params?: {
    96→	status?: string;
    97→	type?: string;
    98→	tag?: string;
    99→	assignee?: string;
   100→	automation?: string;
   101→	limit?: number;
   102→	offset?: number;
   103→}): Promise<PaginatedResponse<TaskSummary>> {
   104→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   105→	if (isStaticMode()) {
   106→		return fetchTasksStatic(params);
   107→	}
   108→
   109→	const url = new URL(`${API_BASE}/api/tasks`);
   110→
   111→	if (params) {
   112→		Object.entries(params).forEach(([key, value]) => {
   113→			if (value !== undefined && value !== '') {
   114→				url.searchParams.set(key, String(value));
   115→			}
   116→		});
   117→	}
   118→
   119→	const response = await fetch(url.toString(), {
   120→		headers: getProjectHeaders()
   121→	});
   122→	if (!response.ok) {
   123→		await handleResponseError(response);
   124→	}
   125→
   126→	return response.json();
   127→}
   128→
   129→/**
   130→ * Fetch single task by reference
   131→ * AC: @web-dashboard ac-5
   132→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   133→ * AC: @gh-pages-export ac-12 - Static mode deep linking
   134→ */
   135→export async function fetchTask(ref: string): Promise<TaskDetail> {
   136→	// AC: @gh-pages-export ac-12 - Use static data in static mode
   137→	if (isStaticMode()) {
   138→		const task = fetchTaskStatic(ref);
   139→		if (!task) {
   140→			throw new Error(`Task not found: ${ref}`);
   141→		}
   142→		return task;
   143→	}
   144→
   145→	const response = await fetch(`${API_BASE}/api/tasks/${ref}`, {
   146→		headers: getProjectHeaders()
   147→	});
   148→	if (!response.ok) {
   149→		await handleResponseError(response);
   150→	}
   151→
   152→	return response.json();
   153→}
   154→
   155→/**
   156→ * Start a task (change status to in_progress)
   157→ * AC: @web-dashboard ac-7
   158→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   159→ * AC: @gh-pages-export ac-16, ac-18 - Disabled in static mode
   160→ */
   161→export async function startTask(ref: string): Promise<void> {
   162→	// AC: @gh-pages-export ac-16, ac-18 - Write operations throw in static mode
   163→	assertWritable('start task');
   164→
   165→	const response = await fetch(`${API_BASE}/api/tasks/${ref}/start`, {
   166→		method: 'POST',
   167→		headers: getProjectHeaders()
   168→	});
   169→	if (!response.ok) {
   170→		await handleResponseError(response);
   171→	}
   172→}
   173→
   174→/**
   175→ * Add a note to a task
   176→ * AC: @web-dashboard ac-8
   177→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   178→ * AC: @gh-pages-export ac-18 - Disabled in static mode
   179→ */
   180→export async function addTaskNote(ref: string, content: string): Promise<void> {
   181→	// AC: @gh-pages-export ac-18 - Write operations throw in static mode
   182→	assertWritable('add note');
   183→
   184→	const response = await fetch(`${API_BASE}/api/tasks/${ref}/note`, {
   185→		method: 'POST',
   186→		headers: {
   187→			'Content-Type': 'application/json',
   188→			...getProjectHeaders()
   189→		},
   190→		body: JSON.stringify({ content })
   191→	});
   192→	if (!response.ok) {
   193→		await handleResponseError(response);
   194→	}
   195→}
   196→
   197→/**
   198→ * Fetch spec items with optional filters
   199→ * AC: @web-dashboard ac-11
   200→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   201→ * AC: @gh-pages-export ac-11 - Static mode support
   202→ */
   203→export async function fetchItems(params?: {
   204→	type?: string | string[];
   205→	tag?: string;
   206→	limit?: number;
   207→	offset?: number;
   208→}): Promise<PaginatedResponse<ItemSummary>> {
   209→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   210→	if (isStaticMode()) {
   211→		return fetchItemsStatic(params);
   212→	}
   213→
   214→	const url = new URL(`${API_BASE}/api/items`);
   215→
   216→	if (params) {
   217→		Object.entries(params).forEach(([key, value]) => {
   218→			if (value !== undefined && value !== '') {
   219→				if (Array.isArray(value)) {
   220→					value.forEach((v) => url.searchParams.append(key, String(v)));
   221→				} else {
   222→					url.searchParams.set(key, String(value));
   223→				}
   224→			}
   225→		});
   226→	}
   227→
   228→	const response = await fetch(url.toString(), {
   229→		headers: getProjectHeaders()
   230→	});
   231→	if (!response.ok) {
   232→		await handleResponseError(response);
   233→	}
   234→
   235→	return response.json();
   236→}
   237→
   238→/**
   239→ * Fetch single spec item by reference
   240→ * AC: @web-dashboard ac-12
   241→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   242→ * AC: @gh-pages-export ac-13 - Static mode deep linking
   243→ */
   244→export async function fetchItem(ref: string): Promise<ItemDetail> {
   245→	// AC: @gh-pages-export ac-13 - Use static data in static mode
   246→	if (isStaticMode()) {
