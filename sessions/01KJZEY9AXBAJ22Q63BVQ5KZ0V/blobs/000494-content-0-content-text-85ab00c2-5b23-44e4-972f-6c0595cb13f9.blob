```
     1→/**
     2→ * Plan document parser for structured plan files.
     3→ *
     4→ * Parses markdown documents with embedded YAML blocks defining specs and tasks.
     5→ * Supports topological ordering, error recovery, and dry-run mode.
     6→ *
     7→ * AC: @plan-import ac-11 - Parse ## Specs YAML blocks
     8→ * AC: @plan-import ac-12 - Support derive_from_specs flag
     9→ * AC: @plan-import ac-13 - Extract ## Implementation Notes
    10→ */
    11→
    12→import { parse as parseYaml } from "yaml";
    13→import { z } from "zod";
    14→import { AcceptanceCriterionSchema } from "../schema/spec.js";
    15→
    16→/**
    17→ * Spec definition from plan document
    18→ */
    19→export const PlanSpecSchema = z.object({
    20→  title: z.string(),
    21→  slug: z.string().optional(),
    22→  type: z.string().optional(),
    23→  parent: z.string().optional(),
    24→  description: z.string().optional(),
    25→  priority: z.number().int().min(1).max(5).optional(),
    26→  acceptance_criteria: z.array(AcceptanceCriterionSchema).optional(),
    27→  traits: z.array(z.string()).optional(),
    28→  depends_on: z.array(z.string()).optional(),
    29→  implementation_notes: z.string().min(1).optional(),
    30→});
    31→
    32→export type PlanSpec = z.infer<typeof PlanSpecSchema>;
    33→
    34→/**
    35→ * Manual task definition from plan document
    36→ */
    37→export const PlanTaskSchema = z.object({
    38→  title: z.string(),
    39→  slug: z.string().optional(),
    40→  priority: z.number().optional(),
    41→  description: z.string().optional(),
    42→  tags: z.array(z.string()).optional(),
    43→  spec_ref: z.string().optional(),
    44→  depends_on: z.array(z.string()).optional(),
    45→});
    46→
    47→export type PlanTask = z.infer<typeof PlanTaskSchema>;
    48→
    49→/**
    50→ * Tasks section configuration
    51→ */
    52→export const TasksSectionSchema = z.object({
    53→  derive_from_specs: z.boolean().optional(),
    54→  additional_tasks: z.array(PlanTaskSchema).optional(),
    55→});
    56→
    57→export type TasksSection = z.infer<typeof TasksSectionSchema>;
    58→
    59→/**
    60→ * Parsed plan document structure
    61→ */
    62→export interface ParsedPlanDocument {
    63→  title: string;
    64→  content: string;
    65→  specs: PlanSpec[];
    66→  tasks: TasksSection;
    67→  implementationNotes: string | null;
    68→  errors: ParseError[];
    69→}
    70→
    71→/**
    72→ * Parse error with context
    73→ */
    74→export interface ParseError {
    75→  type: "yaml" | "validation" | "dependency" | "circular";
    76→  message: string;
    77→  line?: number;
    78→  specIndex?: number;
    79→  spec?: PlanSpec;
    80→}
    81→
    82→/**
    83→ * Parse a plan document from markdown text.
    84→ *
    85→ * AC: @plan-import ac-11 - Extract and parse ## Specs YAML blocks
    86→ * AC: @plan-import ac-12 - Parse Tasks section for derive_from_specs
    87→ * AC: @plan-import ac-13 - Extract ## Implementation Notes section
    88→ * AC: @plan-import ac-21 - Report YAML parse errors with line numbers
    89→ */
    90→export function parsePlanDocument(content: string): ParsedPlanDocument {
    91→  const errors: ParseError[] = [];
    92→
    93→  // Extract title from first heading
    94→  const titleMatch = content.match(/^#\s+(.+)$/m);
    95→  const title = titleMatch ? titleMatch[1].trim() : "Untitled Plan";
    96→
    97→  // Extract ## Specs section
    98→  const specs = extractSpecsSection(content, errors);
    99→
   100→  // Extract ## Tasks section
   101→  const tasks = extractTasksSection(content, errors);
   102→
   103→  // Extract ## Implementation Notes section
   104→  const implementationNotes = extractImplementationNotes(content);
   105→
   106→  return {
   107→    title,
   108→    content,
   109→    specs,
   110→    tasks,
   111→    implementationNotes,
   112→    errors,
   113→  };
   114→}
   115→
   116→/**
   117→ * Extract and parse the ## Specs section.
   118→ *
   119→ * AC: @plan-import ac-11 - Parse YAML array of spec definitions
   120→ * AC: @plan-import ac-21 - Handle YAML parse errors
   121→ * AC: @plan-import ac-22 - Validate required fields
   122→ */
   123→function extractSpecsSection(content: string, errors: ParseError[]): PlanSpec[] {
   124→  // Find ## Specs section
   125→  const specsMatch = content.match(/##\s+Specs\s*\n([\s\S]*?)(?=\n##\s+\w|$)/);
   126→
   127→  if (!specsMatch) {
   128→    return [];
   129→  }
   130→
   131→  const specsContent = specsMatch[1];
   132→
   133→  // Extract YAML code block
   134→  const yamlMatch = specsContent.match(/```(?:yaml)?\s*\n([\s\S]*?)\n```/);
   135→
   136→  if (!yamlMatch) {
   137→    errors.push({
   138→      type: "validation",
   139→      message:
   140→        "Specs section found but contains no YAML code block. Wrap specs in ```yaml ... ```",
   141→    });
   142→    return [];
   143→  }
   144→
   145→  const yamlContent = yamlMatch[1];
   146→
   147→  // Parse YAML
   148→  let parsed: unknown;
   149→  try {
   150→    parsed = parseYaml(yamlContent);
   151→  } catch (err) {
   152→    const yamlError = err instanceof Error ? err.message : String(err);
   153→    const diagnostics = detectYamlUnsafeValues(yamlContent);
   154→
   155→    if (diagnostics.length > 0) {
   156→      const hints = diagnostics
   157→        .map(d => `  Line ${d.line}: ${d.field} value contains unquoted colon: "${d.value}"`)
   158→        .join("\n");
   159→      errors.push({
   160→        type: "yaml",
   161→        message:
   162→          `Malformed YAML in Specs section: ${yamlError}\n\n` +
   163→          `Hint: Found YAML-unsafe values (unquoted colons in text):\n${hints}\n` +
   164→          `Fix: Use YAML block scalars (|) for values containing colons:\n` +
   165→          `  then: |\n    User sees error: Invalid input`,
   166→      });
   167→    } else {
   168→      errors.push({
   169→        type: "yaml",
   170→        message: `Malformed YAML in Specs section: ${yamlError}`,
   171→      });
   172→    }
   173→    return [];
   174→  }
   175→
   176→  // Validate array
   177→  if (!Array.isArray(parsed)) {
   178→    errors.push({
   179→      type: "validation",
   180→      message: "Specs section must contain a YAML array",
   181→    });
   182→    return [];
   183→  }
   184→
   185→  // Validate each spec
   186→  const specs: PlanSpec[] = [];
   187→
   188→  for (let i = 0; i < parsed.length; i++) {
   189→    const spec = parsed[i];
   190→
   191→    // Validate required title field
   192→    if (!spec || typeof spec !== "object" || !("title" in spec)) {
   193→      errors.push({
   194→        type: "validation",
   195→        message: `Spec at index ${i} missing required field: title`,
   196→        specIndex: i,
   197→      });
   198→      continue;
   199→    }
   200→
   201→    // Validate against schema
   202→    const result = PlanSpecSchema.safeParse(spec);
   203→    if (!result.success) {
   204→      errors.push({
   205→        type: "validation",
   206→        message: `Spec at index ${i} validation failed: ${result.error.message}`,
   207→        specIndex: i,
   208→      });
   209→      continue;
   210→    }
   211→
   212→    specs.push(result.data);
   213→  }
   214→
   215→  return specs;
   216→}
   217→
   218→/**
   219→ * Extract and parse the ## Tasks section.
   220→ *
   221→ * AC: @plan-import ac-12 - Parse derive_from_specs flag
   222→ * AC: @plan-import ac-27 - Parse additional_tasks array
   223→ */
   224→function extractTasksSection(content: string, errors: ParseError[]): TasksSection {
   225→  // Find ## Tasks section
   226→  const tasksMatch = content.match(/##\s+Tasks\s*\n([\s\S]*?)(?=\n##\s+\w|$)/);
   227→
   228→  if (!tasksMatch) {
   229→    return {};
   230→  }
   231→
   232→  const tasksContent = tasksMatch[1].trim();
   233→
   234→  // Check for derive_from_specs flag
   235→  const deriveMatch = tasksContent.match(/^derive_from_specs:\s*(true|false)/m);
   236→  const deriveFromSpecs = deriveMatch ? deriveMatch[1] === "true" : undefined;
   237→
   238→  // Extract YAML code block for additional tasks
   239→  const yamlMatch = tasksContent.match(/```(?:yaml)?\s*\n([\s\S]*?)\n```/);
   240→
   241→  let additionalTasks: PlanTask[] | undefined;
   242→
   243→  if (yamlMatch) {
   244→    const yamlContent = yamlMatch[1];
   245→
   246→    try {
   247→      const parsed = parseYaml(yamlContent);
   248→
   249→      if (Array.isArray(parsed)) {
   250→        additionalTasks = [];
   251→        for (let i = 0; i < parsed.length; i++) {
   252→          const result = PlanTaskSchema.safeParse(parsed[i]);
   253→          if (!result.success) {
   254→            errors.push({
   255→              type: "validation",
   256→              message: `Task at index ${i} validation failed: ${result.error.message}`,
   257→            });
   258→            continue;
   259→          }
   260→          additionalTasks.push(result.data);
   261→        }
   262→      }
   263→    } catch (err) {
   264→      const yamlError = err instanceof Error ? err.message : String(err);
   265→      const diagnostics = detectYamlUnsafeValues(yamlContent);
   266→
   267→      if (diagnostics.length > 0) {
   268→        const hints = diagnostics
   269→          .map(d => `  Line ${d.line}: ${d.field} value contains unquoted colon: "${d.value}"`)
   270→          .join("\n");
   271→        errors.push({
   272→          type: "yaml",
   273→          message:
   274→            `Malformed YAML in Tasks section: ${yamlError}\n\n` +
   275→            `Hint: Found YAML-unsafe values (unquoted colons in text):\n${hints}\n` +
   276→            `Fix: Use YAML block scalars (|) for values containing colons:\n` +
   277→            `  then: |\n    User sees error: Invalid input`,
   278→        });
   279→      } else {
   280→        errors.push({
   281→          type: "yaml",
   282→          message: `Malformed YAML in Tasks section: ${yamlError}`,
   283→        });
   284→      }
   285→    }
   286→  }
   287→
   288→  return {
   289→    derive_from_specs: deriveFromSpecs,
   290→    additional_tasks: additionalTasks,
   291→  };
   292→}
   293→
   294→/**
   295→ * Extract ## Implementation Notes section.
   296→ *
   297→ * AC: @plan-import ac-13 - Extract implementation notes as plain text
   298→ */
   299→function extractImplementationNotes(content: string): string | null {
   300→  const notesMatch = content.match(/##\s+Implementation\s+Notes\s*\n([\s\S]*?)(?=\n##\s+\w|$)/);
   301→
   302→  if (!notesMatch) {
   303→    return null;
   304→  }
   305→
   306→  return notesMatch[1].trim();
   307→}
   308→
   309→/**
   310→ * Sort specs in topological order (parents before children).
   311→ *
   312→ * AC: @plan-import ac-16 - Create specs in dependency order
   313→ * AC: @plan-import ac-18 - Detect circular dependencies
   314→ *
   315→ * @returns Sorted specs or null if circular dependency detected
   316→ */
   317→export function topologicalSort(
   318→  specs: PlanSpec[],
   319→): { sorted: PlanSpec[]; error: ParseError | null } {
   320→  // Build adjacency list
   321→  const graph = new Map<string, string[]>();
   322→  const specBySlug = new Map<string, PlanSpec>();
   323→
   324→  for (const spec of specs) {
   325→    const slug = spec.slug || slugify(spec.title);
   326→    if (specBySlug.has(slug)) {
   327→      return {
   328→        sorted: [],
   329→        error: {
   330→          type: "validation",
   331→          message: `Duplicate slug detected: "${slug}". Ensure each spec has a unique slug or title.`,
   332→        },
   333→      };
   334→    }
   335→    specBySlug.set(slug, spec);
   336→    graph.set(slug, []);
   337→  }
   338→
   339→  // Add edges for parent dependencies
   340→  for (const spec of specs) {
   341→    const slug = spec.slug || slugify(spec.title);
   342→    if (spec.parent) {
   343→      const parentRef = spec.parent.startsWith("@") ? spec.parent.slice(1) : spec.parent;
   344→
   345→      // Only add edge if parent is in this plan (local reference)
   346→      if (specBySlug.has(parentRef)) {
   347→        const children = graph.get(parentRef) || [];
   348→        children.push(slug);
   349→        graph.set(parentRef, children);
   350→      }
   351→    }
   352→  }
   353→
   354→  // Detect cycles using DFS
   355→  const visited = new Set<string>();
   356→  const recursionStack = new Set<string>();
   357→
   358→  function hasCycle(node: string, path: string[]): string[] | null {
   359→    visited.add(node);
   360→    recursionStack.add(node);
   361→
   362→    const children = graph.get(node) || [];
   363→    for (const child of children) {
   364→      if (!visited.has(child)) {
   365→        const cyclePath = hasCycle(child, [...path, child]);
   366→        if (cyclePath) return cyclePath;
   367→      } else if (recursionStack.has(child)) {
   368→        return [...path, child];
   369→      }
   370→    }
   371→
   372→    recursionStack.delete(node);
   373→    return null;
   374→  }
   375→
   376→  for (const slug of graph.keys()) {
   377→    if (!visited.has(slug)) {
   378→      const cyclePath = hasCycle(slug, [slug]);
   379→      if (cyclePath) {
   380→        const cycleRefs = cyclePath.map(s => `@${s}`).join(" -> ");
   381→        return {
   382→          sorted: [],
   383→          error: {
   384→            type: "circular",
   385→            message: `Circular parent reference: ${cycleRefs}`,
   386→          },
   387→        };
   388→      }
   389→    }
   390→  }
   391→
   392→  // Topological sort using DFS
   393→  const sorted: PlanSpec[] = [];
   394→  const processed = new Set<string>();
   395→
   396→  function visit(node: string) {
   397→    if (processed.has(node)) return;
   398→
   399→    const spec = specBySlug.get(node);
   400→    if (!spec) return;
   401→
   402→    // Visit parent first if it's in this plan
   403→    if (spec.parent) {
   404→      const parentRef = spec.parent.startsWith("@") ? spec.parent.slice(1) : spec.parent;
   405→      if (specBySlug.has(parentRef)) {
   406→        visit(parentRef);
   407→      }
   408→    }
   409→
   410→    processed.add(node);
   411→    sorted.push(spec);
   412→  }
   413→
   414→  for (const slug of specBySlug.keys()) {
   415→    visit(slug);
   416→  }
   417→
   418→  return { sorted, error: null };
   419→}
   420→
   421→/**
   422→ * Simple slugification helper
   423→ */
   424→function slugify(title: string): string {
   425→  return title
   426→    .toLowerCase()
   427→    .replace(/[^a-z0-9]+/g, "-")
   428→    .replace(/^-|-$/g, "");
   429→}
   430→
   431→/**
   432→ * Validate parent references.
   433→ *
   434→ * AC: @plan-import ac-17 - Detect missing parent references
   435→ * AC: @plan-import ac-33 - Provide recovery hints
   436→ *
   437→ * @param specs Specs to validate
   438→ * @param existingRefs Set of existing spec refs in the project
   439→ * @returns Errors for specs with invalid parents
   440→ */
   441→export function validateParentRefs(
   442→  specs: PlanSpec[],
   443→  existingRefs: Set<string>,
   444→): ParseError[] {
   445→  const errors: ParseError[] = [];
   446→  const planSlugs = new Set(
   447→    specs.map(s => s.slug || slugify(s.title))
   448→  );
   449→
   450→  for (const spec of specs) {
   451→    if (!spec.parent) continue;
   452→
   453→    const parentRef = spec.parent.startsWith("@") ? spec.parent.slice(1) : spec.parent;
   454→
   455→    // Check if parent exists in plan or project
   456→    if (!planSlugs.has(parentRef) && !existingRefs.has(parentRef)) {
   457→      errors.push({
   458→        type: "dependency",
   459→        message: `Parent ${spec.parent} not found. Check parent exists or define it earlier in plan`,
   460→        spec,
   461→      });
   462→    }
   463→  }
   464→
   465→  return errors;
   466→}
   467→
   468→/**
   469→ * Diagnostic for YAML-unsafe values in plan document YAML.
   470→ *
   471→ * Scans raw YAML text for unquoted values that contain colons (the most common
   472→ * cause of "Nested mappings are not allowed in compact mappings" errors).
   473→ * Used to enrich error messages when YAML parsing fails.
   474→ *
   475→ * Only flags lines where a known AC field (given, when, then, description, title)
   476→ * has an unquoted value containing a subsequent colon.
   477→ */
   478→export interface YamlUnsafeDiagnostic {
   479→  line: number;
   480→  field: string;
   481→  value: string;
   482→}
   483→
   484→/**
   485→ * Detect YAML-unsafe values in raw YAML text.
   486→ *
   487→ * Looks for lines matching `key: value` where value contains an unquoted colon.
   488→ * This pattern causes YAML to interpret the second colon as a nested mapping key.
   489→ */
   490→export function detectYamlUnsafeValues(yamlText: string): YamlUnsafeDiagnostic[] {
   491→  const diagnostics: YamlUnsafeDiagnostic[] = [];
   492→  const lines = yamlText.split("\n");
   493→
   494→  // AC fields and other prose fields where colons commonly appear
   495→  // Allow optional YAML list marker (- ) before field name
   496→  const proseFields = /^\s*(?:-\s+)?(given|when|then|description|title|implementation_notes):\s+(.+)$/;
   497→
   498→  for (let i = 0; i < lines.length; i++) {
   499→    const match = lines[i].match(proseFields);
   500→    if (!match) continue;
   501→
   502→    const field = match[1];
   503→    const value = match[2];
   504→
   505→    // Skip values that are already quoted or use block scalar indicators
   506→    if (/^["']/.test(value) || /^\|/.test(value) || /^>/.test(value)) continue;
   507→
   508→    // Check if value contains a colon followed by a space (YAML mapping indicator)
   509→    if (/:\s/.test(value)) {
   510→      diagnostics.push({
   511→        line: i + 1,
   512→        field,
   513→        value: value.length > 60 ? value.slice(0, 57) + "..." : value,
   514→      });
   515→    }
   516→  }
   517→
   518→  return diagnostics;
   519→}
   520→
```