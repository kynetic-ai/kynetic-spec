     1→/**
     2→ * Shadow branch utilities for transparent spec/task state tracking.
     3→ *
     4→ * Shadow branch concept:
     5→ * - Orphan branch (kspec-meta) stores kspec state
     6→ * - .kspec/ directory is a git worktree pointing to shadow branch
     7→ * - Main branch gitignores .kspec/
     8→ * - All kspec read/write operations target .kspec/
     9→ * - Changes auto-commit to shadow branch
    10→ */
    11→
    12→import { exec, execSync } from "node:child_process";
    13→import * as fs from "node:fs/promises";
    14→import * as path from "node:path";
    15→import { promisify } from "node:util";
    16→import { fileURLToPath } from "node:url";
    17→import { isBatchMode } from "../cli/batch-context.js";
    18→
    19→const __filename = fileURLToPath(import.meta.url);
    20→const __dirname = path.dirname(__filename);
    21→
    22→const execAsync = promisify(exec);
    23→
    24→// Import getVerboseMode for checking CLI --debug-shadow flag
    25→// We use a getter function to avoid issues with circular dependencies
    26→let getVerboseModeFunc: (() => boolean) | null = null;
    27→
    28→export function setVerboseModeGetter(getter: () => boolean): void {
    29→  getVerboseModeFunc = getter;
    30→}
    31→
    32→/**
    33→ * Shadow branch configuration
    34→ */
    35→export interface ShadowConfig {
    36→  /** Whether shadow branch is enabled/detected */
    37→  enabled: boolean;
    38→  /** Path to .kspec/ worktree directory */
    39→  worktreeDir: string;
    40→  /** Shadow branch name (default: kspec-meta) */
    41→  branchName: string;
    42→  /** Project root (where .kspec/ lives) */
    43→  projectRoot: string;
    44→}
    45→
    46→/**
    47→ * Shadow branch status
    48→ */
    49→export interface ShadowStatus {
    50→  exists: boolean;
    51→  healthy: boolean;
    52→  branchExists: boolean;
    53→  worktreeExists: boolean;
    54→  worktreeLinked: boolean;
    55→  error?: string;
    56→}
    57→
    58→/**
    59→ * Error types for shadow branch issues
    60→ */
    61→export class ShadowError extends Error {
    62→  constructor(
    63→    message: string,
    64→    public code:
    65→      | "NOT_INITIALIZED"
    66→      | "WORKTREE_DISCONNECTED"
    67→      | "DIRECTORY_MISSING"
    68→      | "GIT_ERROR"
    69→      | "RUNNING_FROM_SHADOW",
    70→    public suggestion: string,
    71→  ) {
    72→    super(message);
    73→    this.name = "ShadowError";
    74→  }
    75→}
    76→
    77→/**
    78→ * Default shadow branch name
    79→ */
    80→export const SHADOW_BRANCH_NAME = "kspec-meta";
    81→
    82→/**
    83→ * Default shadow worktree directory
    84→ */
    85→export const SHADOW_WORKTREE_DIR = ".kspec";
    86→
    87→/**
    88→ * Options for shadow branch operations.
    89→ *
    90→ * AC: @config-shadow ac-7 — all fields optional for backward compatibility
    91→ *
    92→ * When not provided, functions use SHADOW_BRANCH_NAME and SHADOW_WORKTREE_DIR constants.
    93→ */
    94→export interface ShadowOptions {
    95→  /** Branch name (default: kspec-meta) */
    96→  branchName?: string;
    97→  /** Worktree directory name (default: .kspec) */
    98→  directory?: string;
    99→  /**
   100→   * Remote target for push/pull. Can be:
   101→   * - Named remote (e.g., "origin", "specs-origin")
   102→   * - Local filesystem path (starts with /, ./, or ~)
   103→   * - Git URL (contains :// or starts with git@)
   104→   */
   105→  remote?: string;
   106→  /** Type of remote (detected from remote string) */
   107→  remoteType?: "named" | "path" | "url";
   108→}
   109→
   110→/**
   111→ * Get effective branch name from options or default.
   112→ * AC: @config-shadow ac-7 — backward compat when called without config
   113→ */
   114→function getBranchName(options?: ShadowOptions): string {
   115→  return options?.branchName ?? SHADOW_BRANCH_NAME;
   116→}
   117→
   118→/**
   119→ * Get effective directory name from options or default.
   120→ * AC: @config-shadow ac-7 — backward compat when called without config
   121→ */
   122→function getDirectoryName(options?: ShadowOptions): string {
   123→  return options?.directory ?? SHADOW_WORKTREE_DIR;
   124→}
   125→
   126→/**
   127→ * Check if debug mode is enabled.
   128→ * Debug mode can be enabled via:
   129→ * - KSPEC_DEBUG=1 environment variable
   130→ * - Verbose flag (passed from CLI --debug-shadow option)
   131→ *
   132→ * When enabled, shadow branch operations output detailed information.
   133→ */
   134→export function isDebugMode(verboseFlag?: boolean): boolean {
   135→  if (process.env.KSPEC_DEBUG === "1") {
   136→    return true;
   137→  }
   138→  if (verboseFlag === true) {
   139→    return true;
   140→  }
   141→  // Check CLI --debug-shadow flag via getter
   142→  if (getVerboseModeFunc?.()) {
   143→    return true;
   144→  }
   145→  return false;
   146→}
   147→
   148→/**
   149→ * Check if we're in a git repository
   150→ */
   151→export async function isGitRepo(dir: string): Promise<boolean> {
   152→  try {
   153→    execSync("git rev-parse --git-dir", {
   154→      cwd: dir,
   155→      stdio: ["pipe", "pipe", "pipe"],
   156→      encoding: "utf-8",
   157→    });
   158→    return true;
   159→  } catch {
   160→    return false;
   161→  }
   162→}
   163→
   164→/**
   165→ * Get the git root directory
   166→ */
   167→export function getGitRoot(dir: string): string | null {
   168→  try {
   169→    const result = execSync("git rev-parse --show-toplevel", {
   170→      cwd: dir,
   171→      stdio: ["pipe", "pipe", "pipe"],
   172→      encoding: "utf-8",
   173→    }).trim();
   174→    return result;
   175→  } catch {
   176→    return null;
   177→  }
   178→}
   179→
   180→/**
   181→ * Check if a branch exists
   182→ */
   183→export async function branchExists(
   184→  dir: string,
   185→  branchName: string,
   186→): Promise<boolean> {
   187→  try {
   188→    execSync(`git show-ref --verify --quiet refs/heads/${branchName}`, {
   189→      cwd: dir,
   190→      stdio: ["pipe", "pipe", "pipe"],
   191→    });
   192→    return true;
   193→  } catch {
   194→    return false;
   195→  }
   196→}
   197→
   198→/**
   199→ * Check if a directory is a valid git worktree
   200→ */
   201→export async function isValidWorktree(worktreeDir: string): Promise<boolean> {
   202→  try {
   203→    // Check if .git file exists (worktrees have a .git file, not directory)
   204→    const gitPath = path.join(worktreeDir, ".git");
   205→    const stat = await fs.stat(gitPath);
   206→
   207→    if (stat.isFile()) {
   208→      // Read the .git file to verify it points to a worktree
   209→      const content = await fs.readFile(gitPath, "utf-8");
   210→      return content.trim().startsWith("gitdir:");
   211→    }
   212→
   213→    return false;
   214→  } catch {
   215→    return false;
   216→  }
   217→}
   218→
   219→/**
   220→ * Detect if running from inside the shadow worktree directory.
   221→ * Returns the main project root if detected, null otherwise.
   222→ *
   223→ * AC: @config-shadow ac-8 — detects custom worktree directories using git metadata
   224→ *
   225→ * Detection logic:
   226→ * 1. Check if .git is a file (worktrees have .git files, not directories)
   227→ * 2. Read the gitdir reference from the .git file
   228→ * 3. Check if it points to a worktree for kspec (pattern: <project>/.git/worktrees/...)
   229→ *
   230→ * For custom directories, we detect ANY worktree that:
   231→ * - Has a kspec manifest in it (indicating it's a kspec shadow worktree)
   232→ * - Or has a worktree name containing "kspec" or the configured directory name
   233→ *
   234→ * @param cwd Current working directory
   235→ * @param configuredDirectory Optional configured directory name for matching
   236→ */
   237→export async function detectRunningFromShadowWorktree(
   238→  cwd: string,
   239→  configuredDirectory?: string,
   240→): Promise<string | null> {
   241→  try {
   242→    const gitPath = path.join(cwd, ".git");
   243→    const stat = await fs.stat(gitPath);
   244→
   245→    // Worktrees have a .git file, not directory
   246→    if (!stat.isFile()) {
   247→      return null;
   248→    }
   249→
   250→    const content = await fs.readFile(gitPath, "utf-8");
   251→    const match = content.trim().match(/^gitdir:\s*(.+)$/);
   252→    if (!match) {
   253→      return null;
   254→    }
   255→
   256→    const gitdir = match[1];
   257→
   258→    // Check if this is a worktree (pattern: <project>/.git/worktrees/<name>)
   259→    if (gitdir.includes(".git/worktrees/")) {
   260→      const worktreesMatch = gitdir.match(/^(.+)\/\.git\/worktrees\//);
   261→      if (worktreesMatch) {
   262→        const mainProjectRoot = worktreesMatch[1];
   263→        const cwdBase = path.basename(cwd);
   264→        const worktreeName = path.basename(gitdir);
   265→
   266→        // AC: ac-8 — check multiple patterns for shadow worktree detection
   267→        const directoryToCheck = configuredDirectory || SHADOW_WORKTREE_DIR;
   268→
   269→        // Check if directory name matches default, configured, or worktree contains "kspec"
   270→        if (
   271→          cwdBase === SHADOW_WORKTREE_DIR ||
   272→          cwdBase === directoryToCheck ||
   273→          worktreeName.includes("kspec")
   274→        ) {
   275→          return mainProjectRoot;
   276→        }
   277→
   278→        // Additional check: see if this directory has a kspec manifest
   279→        // This catches custom directories that don't have "kspec" in the name
   280→        try {
   281→          const files = await fs.readdir(cwd);
   282→          const hasKspecManifest = files.some(
   283→            (f) =>
   284→              (f.endsWith(".yaml") || f.endsWith(".yml")) &&
   285→              !f.includes(".tasks.") &&
   286→              !f.includes(".inbox."),
   287→          );
   288→          // Check for modules directory or tasks file as additional signals
   289→          const hasModules = files.includes("modules");
   290→          const hasTasksFile = files.some((f) => f.includes(".tasks."));
   291→
   292→          if (hasKspecManifest && (hasModules || hasTasksFile)) {
   293→            return mainProjectRoot;
   294→          }
   295→        } catch {
   296→          // Ignore read errors
   297→        }
   298→      }
   299→    }
   300→
   301→    return null;
   302→  } catch {
   303→    return null;
   304→  }
   305→}
   306→
   307→/**
   308→ * Detect shadow branch configuration from a directory.
   309→ * Returns shadow config if worktree directory exists and is valid.
   310→ *
   311→ * AC: @config-shadow ac-1 ac-2 — uses configured branch/directory names
   312→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
   313→ *
   314→ * @param startDir Directory to start detection from
   315→ * @param options Optional shadow configuration (branch name, directory)
   316→ */
   317→export async function detectShadow(
   318→  startDir: string,
   319→  options?: ShadowOptions,
   320→): Promise<ShadowConfig | null> {
   321→  const gitRoot = getGitRoot(startDir);
   322→  if (!gitRoot) {
   323→    return null;
   324→  }
   325→
   326→  const directoryName = getDirectoryName(options);
   327→  const branchName = getBranchName(options);
   328→  const worktreeDir = path.join(gitRoot, directoryName);
   329→
   330→  try {
   331→    await fs.access(worktreeDir);
   332→
   333→    // Verify it's a valid worktree
   334→    if (await isValidWorktree(worktreeDir)) {
   335→      return {
   336→        enabled: true,
   337→        worktreeDir,
   338→        branchName,
   339→        projectRoot: gitRoot,
   340→      };
   341→    }
   342→
   343→    // Directory exists but not a valid worktree
   344→    return null;
   345→  } catch {
   346→    // Worktree directory doesn't exist
   347→    return null;
   348→  }
   349→}
   350→
   351→/**
   352→ * Get detailed shadow branch status.
   353→ *
   354→ * AC: @config-shadow ac-1 ac-2 — uses configured branch/directory names
   355→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
   356→ *
   357→ * @param projectRoot Git repository root
   358→ * @param options Optional shadow configuration
   359→ */
   360→export async function getShadowStatus(
   361→  projectRoot: string,
   362→  options?: ShadowOptions,
   363→): Promise<ShadowStatus> {
   364→  const directoryName = getDirectoryName(options);
   365→  const branchName = getBranchName(options);
   366→  const worktreeDir = path.join(projectRoot, directoryName);
   367→
   368→  const status: ShadowStatus = {
   369→    exists: false,
   370→    healthy: false,
   371→    branchExists: false,
   372→    worktreeExists: false,
   373→    worktreeLinked: false,
   374→  };
   375→
   376→  // Check if we're in a git repo
   377→  if (!(await isGitRepo(projectRoot))) {
   378→    status.error = "Not a git repository";
   379→    return status;
   380→  }
   381→
   382→  // Check if branch exists
   383→  status.branchExists = await branchExists(projectRoot, branchName);
   384→
   385→  // Check if worktree directory exists
   386→  try {
   387→    await fs.access(worktreeDir);
   388→    status.worktreeExists = true;
   389→  } catch {
   390→    status.worktreeExists = false;
   391→  }
   392→
   393→  // Check if worktree is properly linked
   394→  if (status.worktreeExists) {
   395→    status.worktreeLinked = await isValidWorktree(worktreeDir);
   396→  }
   397→
   398→  // Determine overall status
   399→  status.exists = status.branchExists || status.worktreeExists;
   400→  status.healthy =
   401→    status.branchExists && status.worktreeExists && status.worktreeLinked;
   402→
   403→  if (!status.healthy && status.exists) {
   404→    if (!status.branchExists) {
   405→      status.error = "Shadow branch missing but worktree exists";
   406→    } else if (!status.worktreeExists) {
   407→      status.error = "Shadow branch exists but worktree missing";
   408→    } else if (!status.worktreeLinked) {
   409→      status.error = "Worktree exists but not properly linked";
   410→    }
   411→  }
   412→
   413→  return status;
   414→}
   415→
   416→/**
   417→ * Result from checking config mismatch.
   418→ */
   419→export interface ShadowConfigMismatch {
   420→  /** Whether there is a mismatch */
   421→  hasMismatch: boolean;
   422→  /** Mismatched branch name (detected vs configured) */
   423→  branchMismatch?: { detected: string; configured: string };
   424→  /** Mismatched directory (detected vs configured) */
   425→  directoryMismatch?: { detected: string; configured: string };
   426→  /** Guidance message for the user */
   427→  guidance?: string;
   428→}
   429→
   430→/**
   431→ * Check if detected shadow branch settings match the configuration.
   432→ *
   433→ * AC: @config-shadow ac-9 — detect mismatch and guide user to migrate
   434→ *
   435→ * This function detects when:
   436→ * - A shadow branch exists with default settings (kspec-meta, .kspec)
   437→ * - But config specifies different settings
   438→ *
   439→ * @param projectRoot Git repository root
   440→ * @param configuredBranch Configured branch name
   441→ * @param configuredDirectory Configured directory name
   442→ */
   443→export async function checkConfigMismatch(
   444→  projectRoot: string,
   445→  configuredBranch: string,
   446→  configuredDirectory: string,
   447→): Promise<ShadowConfigMismatch> {
   448→  const result: ShadowConfigMismatch = { hasMismatch: false };
   449→
   450→  // First check if default shadow exists
   451→  const defaultStatus = await getShadowStatus(projectRoot, {
   452→    branchName: SHADOW_BRANCH_NAME,
   453→    directory: SHADOW_WORKTREE_DIR,
   454→  });
   455→
   456→  if (!defaultStatus.healthy) {
   457→    // No existing shadow with defaults - no mismatch possible
   458→    return result;
   459→  }
   460→
   461→  // Check if configured settings differ from defaults
   462→  const branchDiffers = configuredBranch !== SHADOW_BRANCH_NAME;
   463→  const directoryDiffers = configuredDirectory !== SHADOW_WORKTREE_DIR;
   464→
   465→  if (!branchDiffers && !directoryDiffers) {
   466→    // Config matches defaults - no mismatch
   467→    return result;
   468→  }
   469→
   470→  // There's a mismatch - existing shadow uses defaults but config specifies different values
   471→  result.hasMismatch = true;
   472→
   473→  if (branchDiffers) {
   474→    result.branchMismatch = {
   475→      detected: SHADOW_BRANCH_NAME,
   476→      configured: configuredBranch,
   477→    };
   478→  }
   479→
   480→  if (directoryDiffers) {
   481→    result.directoryMismatch = {
   482→      detected: SHADOW_WORKTREE_DIR,
   483→      configured: configuredDirectory,
   484→    };
   485→  }
   486→
   487→  // Build guidance message
   488→  const parts: string[] = [];
   489→  if (result.branchMismatch) {
   490→    parts.push(
   491→      `branch "${SHADOW_BRANCH_NAME}" (config wants "${configuredBranch}")`,
   492→    );
   493→  }
   494→  if (result.directoryMismatch) {
   495→    parts.push(
   496→      `directory "${SHADOW_WORKTREE_DIR}" (config wants "${configuredDirectory}")`,
   497→    );
   498→  }
   499→
   500→  result.guidance = [
   501→    `Shadow branch exists with ${parts.join(" and ")}.`,
   502→    "",
   503→    "To migrate to configured settings:",
   504→    "  1. Export your specs: kspec export --all > backup.yaml",
   505→    "  2. Remove existing shadow: rm -rf .kspec && git branch -D kspec-meta",
   506→    "  3. Re-initialize: kspec init",
   507→    "  4. Import specs: kspec import backup.yaml",
   508→    "",
   509→    "Or update kspec.config.yaml to match existing settings.",
   510→  ].join("\n");
   511→
   512→  return result;
   513→}
   514→
   515→/**
   516→ * Create an appropriate ShadowError based on status
   517→ */
   518→export function createShadowError(status: ShadowStatus): ShadowError {
   519→  if (!status.branchExists && !status.worktreeExists) {
   520→    return new ShadowError(
   521→      "Shadow branch not initialized",
   522→      "NOT_INITIALIZED",
   523→      "Run `kspec init` to create shadow branch and worktree.",
   524→    );
   525→  }
   526→
   527→  if (status.branchExists && !status.worktreeExists) {
   528→    return new ShadowError(
   529→      ".kspec/ directory missing",
   530→      "DIRECTORY_MISSING",
   531→      "Run `kspec shadow repair` to recreate the worktree.",
   532→    );
   533→  }
   534→
   535→  if (status.worktreeExists && !status.worktreeLinked) {
   536→    return new ShadowError(
   537→      "Worktree disconnected from git",
   538→      "WORKTREE_DISCONNECTED",
   539→      "Run `kspec shadow repair` to fix the worktree link.",
   540→    );
   541→  }
   542→
   543→  return new ShadowError(
   544→    status.error || "Unknown shadow branch error",
   545→    "GIT_ERROR",
   546→    "Check git status and try `kspec shadow repair`.",
   547→  );
   548→}
   549→
   550→/**
   551→ * Auto-commit changes to shadow branch.
   552→ * Called after write operations when shadow is enabled.
   553→ *
   554→ * @param worktreeDir Path to .kspec/ directory
   555→ * @param message Commit message
   556→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   557→ * @returns true if commit succeeded, false if nothing to commit
   558→ */
   559→export async function shadowAutoCommit(
   560→  worktreeDir: string,
   561→  message: string,
   562→  verbose?: boolean,
   563→): Promise<boolean> {
   564→  const debug = isDebugMode(verbose);
   565→
   566→  try {
   567→    if (debug) {
   568→      console.error(
   569→        `[DEBUG] Shadow auto-commit: git add -A (cwd: ${worktreeDir})`,
   570→      );
   571→    }
   572→
   573→    // Stage all changes
   574→    execSync("git add -A", {
   575→      cwd: worktreeDir,
   576→      stdio: ["pipe", "pipe", "pipe"],
   577→    });
   578→
   579→    // Check if there are staged changes
   580→    try {
   581→      if (debug) {
   582→        console.error(`[DEBUG] Shadow auto-commit: git diff --cached --quiet`);
   583→      }
   584→
   585→      execSync("git diff --cached --quiet", {
   586→        cwd: worktreeDir,
   587→        stdio: ["pipe", "pipe", "pipe"],
   588→      });
   589→      // No error = no changes
   590→      if (debug) {
   591→        console.error(`[DEBUG] Shadow auto-commit: No changes to commit`);
   592→      }
   593→      return false;
   594→    } catch {
   595→      // Error = there are changes, proceed with commit
   596→    }
   597→
   598→    if (debug) {
   599→      console.error(`[DEBUG] Shadow auto-commit: git commit -m "${message}"`);
   600→    }
   601→
   602→    // Commit with message
   603→    // Set KSPEC_SHADOW_COMMIT=1 to signal authorized commit to git hooks
   604→    execSync(`git commit -m "${message.replace(/"/g, '\\"')}"`, {
   605→      cwd: worktreeDir,
   606→      stdio: ["pipe", "pipe", "pipe"],
   607→      env: { ...process.env, KSPEC_SHADOW_COMMIT: "1" },
   608→    });
   609→
   610→    if (debug) {
   611→      console.error(`[DEBUG] Shadow auto-commit: Success`);
   612→    }
   613→
   614→    return true;
   615→  } catch (error) {
   616→    // AC: Only log error if debug mode enabled
   617→    if (debug) {
   618→      console.error("Shadow auto-commit failed:", error);
   619→    }
   620→    return false;
   621→  }
   622→}
   623→
   624→/**
   625→ * Generate commit message for a kspec operation.
   626→ */
   627→export function generateCommitMessage(
   628→  operation: string,
   629→  ref?: string,
   630→  detail?: string,
   631→): string {
   632→  const parts: string[] = [];
   633→
   634→  switch (operation) {
   635→    case "task-start":
   636→      parts.push(`Start @${ref}`);
   637→      break;
   638→    case "task-complete":
   639→      parts.push(`Complete @${ref}`);
   640→      if (detail) parts.push(`: ${detail}`);
   641→      break;
   642→    case "task-note":
   643→      parts.push(`Note on @${ref}`);
   644→      break;
   645→    case "task-add":
   646→      parts.push(`Add task: ${detail || ref}`);
   647→      break;
   648→    case "inbox-add":
   649→      parts.push(
   650→        `Inbox: ${detail?.slice(0, 50)}${(detail?.length || 0) > 50 ? "..." : ""}`,
   651→      );
   652→      break;
   653→    case "inbox-promote":
   654→      parts.push(`Promote to @${ref}`);
   655→      break;
   656→    case "item-add":
   657→      parts.push(`Add @${ref}`);
   658→      break;
   659→    case "item-set":
   660→      parts.push(`Update @${ref}`);
   661→      break;
   662→    case "item-delete":
   663→      parts.push(`Delete @${ref}`);
   664→      break;
   665→    case "derive":
   666→      parts.push(`Derive from @${ref}`);
   667→      break;
   668→    default:
   669→      parts.push(operation);
   670→      if (ref) parts.push(` @${ref}`);
   671→  }
   672→
   673→  return parts.join("");
   674→}
   675→
   676→/**
   677→ * Resolve a path relative to shadow worktree if enabled.
   678→ * Falls back to original path if shadow is not enabled.
   679→ *
   680→ * Uses the worktreeDir from shadowConfig for custom directory support.
   681→ */
   682→export function resolveShadowPath(
   683→  originalPath: string,
   684→  shadowConfig: ShadowConfig | null,
   685→  projectRoot: string,
   686→): string {
   687→  if (!shadowConfig?.enabled) {
   688→    return originalPath;
   689→  }
   690→
   691→  // If the path is within the project root, rewrite to shadow worktree
   692→  const relativePath = path.relative(projectRoot, originalPath);
   693→
   694→  // Get the directory name from the worktree path (supports custom directories)
   695→  const worktreeDirName = path.basename(shadowConfig.worktreeDir);
   696→
   697→  // Skip if path is outside project or already in shadow worktree
   698→  if (
   699→    relativePath.startsWith("..") ||
   700→    relativePath.startsWith(worktreeDirName)
   701→  ) {
   702→    return originalPath;
   703→  }
   704→
   705→  // Handle spec/ -> shadow worktree mapping
   706→  if (relativePath.startsWith("spec/") || relativePath.startsWith("spec\\")) {
   707→    const specRelative = relativePath.slice(5); // Remove 'spec/'
   708→    return path.join(shadowConfig.worktreeDir, specRelative);
   709→  }
   710→
   711→  // For task/inbox files at root, move to shadow worktree
   712→  if (
   713→    relativePath.endsWith(".tasks.yaml") ||
   714→    relativePath.endsWith(".inbox.yaml")
   715→  ) {
   716→    return path.join(shadowConfig.worktreeDir, relativePath);
   717→  }
   718→
   719→  return originalPath;
   720→}
   721→
   722→/**
   723→ * Commit changes to shadow branch if enabled.
   724→ * This is the primary interface for CLI commands to trigger auto-commit.
   725→ *
   726→ * @param shadowConfig Shadow configuration (from KspecContext.shadow)
   727→ * @param operation Operation type (e.g., 'task-start', 'task-complete')
   728→ * @param ref Reference slug or ULID (optional)
   729→ * @param detail Additional detail for commit message (optional)
   730→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   731→ * @returns true if committed, false if shadow not enabled or nothing to commit
   732→ */
   733→export async function commitIfShadow(
   734→  shadowConfig: ShadowConfig | null,
   735→  operation: string,
   736→  ref?: string,
   737→  detail?: string,
   738→  verbose?: boolean,
   739→): Promise<boolean> {
   740→  // Suppress auto-commits during atomic batch execution
   741→  if (isBatchMode()) {
   742→    return false;
   743→  }
   744→
   745→  if (!shadowConfig?.enabled) {
   746→    return false;
   747→  }
   748→
   749→  const message = generateCommitMessage(operation, ref, detail);
   750→  const committed = await shadowAutoCommit(
   751→    shadowConfig.worktreeDir,
   752→    message,
   753→    verbose,
   754→  );
   755→
   756→  // AC: @shadow-sync ac-1 - Fire-and-forget push after each commit
   757→  if (committed) {
   758→    shadowPushAsync(shadowConfig.worktreeDir, verbose);
   759→  }
   760→
   761→  return committed;
   762→}
   763→
   764→/**
   765→ * Check if shadow is required but not available, and throw appropriate error.
   766→ * Use this at the start of commands that require shadow mode.
   767→ *
   768→ * @param shadowConfig Shadow configuration from context
   769→ * @param projectRoot Project root for status check
   770→ * @throws ShadowError if shadow is not properly configured
   771→ */
   772→export async function requireShadow(
   773→  shadowConfig: ShadowConfig | null,
   774→  projectRoot: string,
   775→): Promise<void> {
   776→  if (shadowConfig?.enabled) {
   777→    return; // Shadow is available
   778→  }
   779→
   780→  const status = await getShadowStatus(projectRoot);
   781→  throw createShadowError(status);
   782→}
   783→
   784→/**
   785→ * Format a ShadowError for display in CLI.
   786→ * Returns a user-friendly message with suggestion.
   787→ */
   788→export function formatShadowError(error: ShadowError): string {
   789→  return `${error.message}\n\nSuggestion: ${error.suggestion}`;
   790→}
   791→
   792→/**
   793→ * Result from shadow initialization
   794→ */
   795→export interface ShadowInitResult {
   796→  success: boolean;
   797→  branchCreated: boolean;
   798→  worktreeCreated: boolean;
   799→  gitignoreUpdated: boolean;
   800→  initialCommit: boolean;
   801→  alreadyExists: boolean;
   802→  /** Whether shadow was created from existing remote branch */
   803→  createdFromRemote: boolean;
   804→  /** Whether new branch was pushed to remote to establish tracking */
   805→  pushedToRemote: boolean;
   806→  error?: string;
   807→}
   808→
   809→/**
   810→ * Options for shadow initialization.
   811→ *
   812→ * AC: @config-shadow ac-1 ac-2 — branch and directory configurable
   813→ */
   814→export interface ShadowInitOptions {
   815→  /** Project name for manifest */
   816→  projectName?: string;
   817→  /** Force reinitialize even if exists */
   818→  force?: boolean;
   819→  /** Shadow branch/directory/remote configuration */
   820→  shadow?: ShadowOptions;
   821→}
   822→
   823→/**
   824→ * Check if a remote exists (default: origin)
   825→ */
   826→export async function hasRemote(
   827→  projectRoot: string,
   828→  remoteName = "origin",
   829→): Promise<boolean> {
   830→  try {
   831→    const { stdout } = await execAsync(`git remote get-url ${remoteName}`, {
   832→      cwd: projectRoot,
   833→    });
   834→    return stdout.trim().length > 0;
   835→  } catch {
   836→    return false;
   837→  }
   838→}
   839→
   840→/**
   841→ * Check if a branch exists on a remote
   842→ */
   843→export async function remoteBranchExists(
   844→  projectRoot: string,
   845→  branchName: string,
   846→  remoteName = "origin",
   847→): Promise<boolean> {
   848→  try {
   849→    execSync(
   850→      `git show-ref --verify --quiet refs/remotes/${remoteName}/${branchName}`,
   851→      {
   852→        cwd: projectRoot,
   853→        stdio: ["pipe", "pipe", "pipe"],
   854→      },
   855→    );
   856→    return true;
   857→  } catch {
   858→    return false;
   859→  }
   860→}
   861→
   862→/**
   863→ * Fetch from remote to ensure refs are up to date.
   864→ * Returns true if fetch succeeded, false otherwise.
   865→ */
   866→export async function fetchRemote(
   867→  projectRoot: string,
   868→  remoteName = "origin",
   869→): Promise<boolean> {
   870→  try {
   871→    await execAsync(`git fetch ${remoteName}`, {
   872→      cwd: projectRoot,
   873→    });
   874→    return true;
   875→  } catch {
   876→    return false;
   877→  }
   878→}
   879→
   880→/**
   881→ * Push shadow branch to remote with tracking.
   882→ * Returns true if push succeeded, false otherwise.
   883→ *
   884→ * AC: @config-shadow ac-3 — uses configured remote name
   885→ * AC: @config-shadow ac-7 — defaults to origin when not provided
   886→ *
   887→ * @param worktreeDir Path to shadow worktree
   888→ * @param remoteName Remote name (default: origin)
   889→ * @param options Optional shadow configuration
   890→ */
   891→export async function pushShadowBranch(
   892→  worktreeDir: string,
   893→  remoteName = "origin",
   894→  options?: ShadowOptions,
   895→): Promise<boolean> {
   896→  const branchName = getBranchName(options);
   897→  try {
   898→    await execAsync(`git push -u ${remoteName} ${branchName}`, {
   899→      cwd: worktreeDir,
   900→    });
   901→    return true;
   902→  } catch {
   903→    return false;
   904→  }
   905→}
   906→
   907→/**
   908→ * Check if shadow branch has remote tracking configured.
   909→ * AC-4: Used to determine whether sync should be attempted.
   910→ *
   911→ * AC: @config-shadow ac-7 — backward compat when called without config
   912→ *
   913→ * @param worktreeDir Path to shadow worktree
   914→ * @param options Optional shadow configuration
   915→ */
   916→export async function hasRemoteTracking(
   917→  worktreeDir: string,
   918→  options?: ShadowOptions,
   919→): Promise<boolean> {
   920→  const branchName = getBranchName(options);
   921→  try {
   922→    const { stdout } = await execAsync(
   923→      `git config branch.${branchName}.remote`,
   924→      { cwd: worktreeDir },
   925→    );
   926→    return stdout.trim().length > 0;
   927→  } catch {
   928→    return false;
   929→  }
   930→}
   931→
   932→/**
   933→ * Ensure shadow branch has remote tracking configured.
   934→ * AC-8: If shadow has no tracking but main branch has origin remote,
   935→ * automatically configure tracking to origin/kspec-meta.
   936→ *
   937→ * AC: @config-shadow ac-3 ac-4 ac-5 — handles different remote types
   938→ * AC: @config-shadow ac-6 — error with guidance if named remote doesn't exist
   939→ * AC: @config-shadow ac-7 — backward compat when called without config
   940→ *
   941→ * @param worktreeDir Path to shadow worktree
   942→ * @param projectRoot Git repository root
   943→ * @param options Optional shadow configuration
   944→ * @returns Result with success status and error details if applicable
   945→ */
   946→export async function ensureRemoteTracking(
   947→  worktreeDir: string,
   948→  projectRoot: string,
   949→  options?: ShadowOptions,
   950→): Promise<EnsureRemoteTrackingResult> {
   951→  const branchName = getBranchName(options);
   952→
   953→  // Check if already has tracking
   954→  if (await hasRemoteTracking(worktreeDir, options)) {
   955→    return { success: true };
   956→  }
   957→
   958→  // Determine remote name to use
   959→  let remoteName = "origin";
   960→
   961→  if (options?.remote) {
   962→    const remoteType = options.remoteType ?? "named";
   963→
   964→    if (remoteType === "named") {
   965→      // AC: ac-3 — use the named remote directly
   966→      remoteName = options.remote;
   967→
   968→      // AC: ac-6 — verify the named remote exists with guidance
   969→      if (!(await hasRemote(projectRoot, remoteName))) {
   970→        // Named remote doesn't exist - provide helpful guidance
   971→        return {
   972→          success: false,
   973→          missingRemote: remoteName,
   974→          guidance: `Remote '${remoteName}' does not exist. To fix this:\n` +
   975→            `  1. Add the remote: git remote add ${remoteName} <url>\n` +
   976→            `  2. Or update kspec.config.yaml to use an existing remote\n` +
   977→            `  3. Or remove shadow.remote to use the default 'origin' remote`,
   978→        };
   979→      }
   980→    } else if (remoteType === "path" || remoteType === "url") {
   981→      // AC: ac-4 ac-5 — add a git remote for path/URL if not already present
   982→      const specRemoteName = "kspec-specs";
   983→      const hasSpecsRemote = await hasRemote(projectRoot, specRemoteName);
   984→
   985→      if (!hasSpecsRemote) {
   986→        try {
   987→          // Expand tilde for paths if needed
   988→          let remoteTarget = options.remote;
   989→          if (remoteType === "path" && remoteTarget.startsWith("~")) {
   990→            remoteTarget = remoteTarget.replace(
   991→              /^~/,
   992→              process.env.HOME || process.env.USERPROFILE || "~",
   993→            );
   994→          }
   995→
   996→          await execAsync(`git remote add ${specRemoteName} "${remoteTarget}"`, {
   997→            cwd: projectRoot,
   998→          });
   999→        } catch {
  1000→          // Remote add failed - may already exist with different URL
  1001→          return { success: false };
  1002→        }
  1003→      }
  1004→
  1005→      remoteName = specRemoteName;
  1006→    }
  1007→  } else {
  1008→    // No remote configured - check if main branch has origin
  1009→    if (!(await hasRemote(projectRoot))) {
  1010→      return { success: false };
  1011→    }
  1012→  }
  1013→
  1014→  // Set up tracking for shadow branch
  1015→  try {
  1016→    await execAsync(`git config branch.${branchName}.remote ${remoteName}`, {
  1017→      cwd: worktreeDir,
  1018→    });
  1019→    await execAsync(
  1020→      `git config branch.${branchName}.merge refs/heads/${branchName}`,
  1021→      { cwd: worktreeDir },
  1022→    );
  1023→    return { success: true };
  1024→  } catch {
  1025→    return { success: false };
  1026→  }
  1027→}
  1028→
  1029→/**
  1030→ * Result from ensuring remote tracking
  1031→ * AC: @config-shadow ac-6 — includes error details when named remote doesn't exist
  1032→ */
  1033→export interface EnsureRemoteTrackingResult {
  1034→  success: boolean;
  1035→  /** Error when remote doesn't exist (AC-6) */
  1036→  missingRemote?: string;
  1037→  /** Guidance message for user */
  1038→  guidance?: string;
  1039→}
  1040→
  1041→/**
  1042→ * Result from a sync operation
  1043→ */
  1044→export interface ShadowSyncResult {
  1045→  success: boolean;
  1046→  pulled: boolean;
  1047→  pushed: boolean;
  1048→  hadConflict: boolean;
  1049→  error?: string;
  1050→}
  1051→
  1052→/**
  1053→ * Fire-and-forget push to remote.
  1054→ * AC-1: Called after each auto-commit when tracking is configured.
  1055→ * AC-8: Automatically sets up tracking if main branch has remote.
  1056→ * Silently ignores errors - the local commit succeeded regardless.
  1057→ *
  1058→ * AC: @config-shadow ac-7 — backward compat when called without config
  1059→ *
  1060→ * @param worktreeDir Path to shadow worktree
  1061→ * @param verbose Enable debug output
  1062→ * @param options Optional shadow configuration
  1063→ */
  1064→export async function shadowPushAsync(
  1065→  worktreeDir: string,
  1066→  verbose?: boolean,
  1067→  options?: ShadowOptions,
  1068→): Promise<void> {
  1069→  const debug = isDebugMode(verbose);
  1070→
  1071→  // AC: @shadow-sync ac-8 - Auto-configure tracking if main has remote but shadow doesn't
  1072→  const projectRoot = path.dirname(worktreeDir);
  1073→  const trackingResult = await ensureRemoteTracking(worktreeDir, projectRoot, options);
  1074→
  1075→  // AC: @config-shadow ac-6 — log guidance if named remote doesn't exist
  1076→  if (!trackingResult.success && trackingResult.missingRemote) {
  1077→    if (debug) {
  1078→      console.error(`[DEBUG] Shadow push: ${trackingResult.guidance}`);
  1079→    }
  1080→    return;
  1081→  }
  1082→
  1083→  // Check if tracking is configured before attempting push
  1084→  if (!(await hasRemoteTracking(worktreeDir, options))) {
  1085→    if (debug) {
  1086→      console.error(
  1087→        "[DEBUG] Shadow push: No remote tracking configured, skipping",
  1088→      );
  1089→    }
  1090→    return; // AC: @shadow-sync ac-4 - silently skip if no tracking
  1091→  }
  1092→
  1093→  try {
  1094→    if (debug) {
  1095→      console.error(`[DEBUG] Shadow push: git push (cwd: ${worktreeDir})`);
  1096→    }
  1097→
  1098→    // Don't await - fire and forget
  1099→    execAsync("git push", { cwd: worktreeDir }).catch((err) => {
  1100→      if (debug) {
  1101→        console.error("[DEBUG] Shadow push failed:", err);
  1102→      }
  1103→      // Silently ignore push failures - local state is correct
  1104→    });
  1105→  } catch (err) {
  1106→    if (debug) {
  1107→      console.error("[DEBUG] Shadow push error:", err);
  1108→    }
  1109→  }
  1110→}
  1111→
  1112→/**
  1113→ * Pull remote changes to shadow branch.
  1114→ * AC-2: Called at session start to sync before operations.
  1115→ * AC-6: Uses --ff-only first, falls back to --rebase.
  1116→ * AC-3: On conflict, returns failure with suggestion.
  1117→ * AC-8: Automatically sets up tracking if main branch has remote.
  1118→ *
  1119→ * AC: @config-shadow ac-7 — backward compat when called without config
  1120→ *
  1121→ * @param worktreeDir Path to shadow worktree
  1122→ * @param options Optional shadow configuration
  1123→ */
  1124→export async function shadowPull(
  1125→  worktreeDir: string,
  1126→  options?: ShadowOptions,
  1127→): Promise<ShadowSyncResult> {
  1128→  const branchName = getBranchName(options);
  1129→  const result: ShadowSyncResult = {
  1130→    success: false,
  1131→    pulled: false,
  1132→    pushed: false,
  1133→    hadConflict: false,
  1134→  };
  1135→
  1136→  // AC: @shadow-sync ac-8 - Auto-configure tracking if main has remote but shadow doesn't
  1137→  const projectRoot = path.dirname(worktreeDir);
  1138→  const trackingResult = await ensureRemoteTracking(worktreeDir, projectRoot, options);
  1139→
  1140→  // AC: @config-shadow ac-6 — error with guidance if named remote doesn't exist
  1141→  if (!trackingResult.success && trackingResult.missingRemote) {
  1142→    result.error = trackingResult.guidance;
  1143→    return result;
  1144→  }
  1145→
  1146→  // AC: @shadow-sync ac-4 - Skip if no remote tracking
  1147→  if (!(await hasRemoteTracking(worktreeDir, options))) {
  1148→    result.success = true;
  1149→    return result;
  1150→  }
  1151→
  1152→  // Check if remote branch exists before attempting pull
  1153→  // Fetch first to ensure refs are up to date
  1154→  await fetchRemote(projectRoot);
  1155→  const remoteHasBranch = await remoteBranchExists(projectRoot, branchName);
  1156→  if (!remoteHasBranch) {
  1157→    // Remote branch doesn't exist yet - nothing to pull, but success
  1158→    result.success = true;
  1159→    return result;
  1160→  }
  1161→
  1162→  try {
  1163→    // Try fast-forward only first (cleanest)
  1164→    await execAsync("git pull --ff-only", { cwd: worktreeDir });
  1165→    result.success = true;
  1166→    result.pulled = true;
  1167→    return result;
  1168→  } catch {
  1169→    // Fast-forward failed, try rebase
  1170→  }
  1171→
  1172→  try {
  1173→    // AC: @shadow-sync ac-6 - Fall back to rebase
  1174→    await execAsync("git pull --rebase", { cwd: worktreeDir });
  1175→    result.success = true;
  1176→    result.pulled = true;
  1177→    return result;
  1178→  } catch {
  1179→    // Rebase failed - likely conflict
  1180→  }
  1181→
  1182→  // AC: @shadow-sync ac-3 - Conflict detected - abort rebase and report
  1183→  try {
  1184→    await execAsync("git rebase --abort", { cwd: worktreeDir });
  1185→  } catch {
  1186→    // May not be in rebase state, ignore
  1187→  }
  1188→
  1189→  result.hadConflict = true;
  1190→  result.error = "Sync conflict detected. Run `kspec shadow resolve` to fix.";
  1191→  return result;
  1192→}
  1193→
  1194→/**
  1195→ * Full sync operation: pull then push.
  1196→ * Used by session start and explicit sync commands.
  1197→ *
  1198→ * AC: @config-shadow ac-7 — backward compat when called without config
  1199→ *
  1200→ * @param worktreeDir Path to shadow worktree
  1201→ * @param options Optional shadow configuration
  1202→ */
  1203→export async function shadowSync(
  1204→  worktreeDir: string,
  1205→  options?: ShadowOptions,
  1206→): Promise<ShadowSyncResult> {
  1207→  // First pull
  1208→  const pullResult = await shadowPull(worktreeDir, options);
  1209→  if (!pullResult.success) {
  1210→    return pullResult;
  1211→  }
  1212→
  1213→  // Then push (only if tracking configured, checked inside)
  1214→  if (await hasRemoteTracking(worktreeDir, options)) {
  1215→    try {
  1216→      await execAsync("git push", { cwd: worktreeDir });
  1217→      pullResult.pushed = true;
  1218→    } catch {
  1219→      // Push failed - not a critical error, local state is correct
  1220→      // Could be permissions, network, etc.
  1221→    }
  1222→  }
  1223→
  1224→  return pullResult;
  1225→}
  1226→
  1227→/**
  1228→ * Check if .gitignore has uncommitted changes
  1229→ */
  1230→async function hasUncommittedGitignore(projectRoot: string): Promise<boolean> {
  1231→  try {
  1232→    // Check both staged and unstaged changes to .gitignore
  1233→    const { stdout } = await execAsync("git status --porcelain .gitignore", {
  1234→      cwd: projectRoot,
  1235→    });
  1236→    return stdout.trim().length > 0;
  1237→  } catch {
  1238→    return false;
  1239→  }
  1240→}
  1241→
  1242→/**
  1243→ * Commit only .gitignore with a message.
  1244→ *
  1245→ * @param projectRoot Git repository root
  1246→ * @param directoryName Shadow directory name (for commit message)
  1247→ */
  1248→async function commitGitignore(
  1249→  projectRoot: string,
  1250→  directoryName: string,
  1251→): Promise<void> {
  1252→  await execAsync("git add .gitignore", { cwd: projectRoot });
  1253→  await execAsync(
  1254→    `git commit -m "chore: add ${directoryName}/ to .gitignore for shadow branch"`,
  1255→    {
  1256→      cwd: projectRoot,
  1257→    },
  1258→  );
  1259→}
  1260→
  1261→/**
  1262→ * Add shadow directory to .gitignore if not already present.
  1263→ * Fails if .gitignore has uncommitted changes.
  1264→ * Commits the change after adding.
  1265→ *
  1266→ * AC: @config-shadow ac-2 — uses configured directory name
  1267→ * AC: @config-shadow ac-7 — defaults to .kspec when not provided
  1268→ *
  1269→ * @param projectRoot Git repository root
  1270→ * @param options Optional shadow configuration
  1271→ */
  1272→async function ensureGitignore(
  1273→  projectRoot: string,
  1274→  options?: ShadowOptions,
  1275→): Promise<boolean> {
  1276→  const directoryName = getDirectoryName(options);
  1277→  const gitignorePath = path.join(projectRoot, ".gitignore");
  1278→  const entry = `${directoryName}/`;
  1279→
  1280→  // Fail fast if .gitignore has uncommitted changes
  1281→  if (await hasUncommittedGitignore(projectRoot)) {
  1282→    throw new ShadowError(
  1283→      ".gitignore has uncommitted changes",
  1284→      "GIT_ERROR",
  1285→      "Commit or stash your .gitignore changes before running kspec init.",
  1286→    );
  1287→  }
  1288→
  1289→  try {
  1290→    let content = "";
  1291→    try {
  1292→      content = await fs.readFile(gitignorePath, "utf-8");
  1293→    } catch {
  1294→      // File doesn't exist, will create
  1295→    }
  1296→
  1297→    // Check if already present (handle various formats)
  1298→    const lines = content.split("\n");
  1299→    const patterns = [
  1300→      directoryName,
  1301→      `${directoryName}/`,
  1302→      `/${directoryName}`,
  1303→      `/${directoryName}/`,
  1304→    ];
  1305→
  1306→    for (const line of lines) {
  1307→      const trimmed = line.trim();
  1308→      if (patterns.includes(trimmed)) {
  1309→        return false; // Already present
  1310→      }
  1311→    }
  1312→
  1313→    // Add to gitignore
  1314→    const newContent =
  1315→      content.endsWith("\n") || content === ""
  1316→        ? `${content}${entry}\n`
  1317→        : `${content}\n${entry}\n`;
  1318→
  1319→    await fs.writeFile(gitignorePath, newContent, "utf-8");
  1320→
  1321→    // Commit the change
  1322→    await commitGitignore(projectRoot, directoryName);
  1323→
  1324→    return true;
  1325→  } catch (error) {
  1326→    if (error instanceof ShadowError) {
  1327→      throw error;
  1328→    }
  1329→    throw new ShadowError(
  1330→      `Failed to update .gitignore: ${error}`,
  1331→      "GIT_ERROR",
  1332→      "Check file permissions for .gitignore",
  1333→    );
  1334→  }
  1335→}
  1336→
  1337→/**
  1338→ * Generate initial manifest content for shadow branch
  1339→ */
  1340→function generateShadowManifest(projectName: string): string {
  1341→  return `# ${projectName} - Kynetic Spec
  1342→# Generated by kspec init
  1343→
  1344→kynetic: "1.0"
  1345→
  1346→project:
  1347→  name: "${projectName}"
  1348→  version: "0.1.0"
  1349→  status: draft
  1350→  description: |
  1351→    Add your project description here.
  1352→
  1353→# Module includes
  1354→includes:
  1355→  - modules/main.yaml
  1356→`;
  1357→}
  1358→
  1359→/**
  1360→ * Generate initial module content
  1361→ */
  1362→function generateShadowModule(projectName: string): string {
  1363→  return `# ${projectName} - Main Module
  1364→# Add your spec items here
  1365→
  1366→items: []
  1367→`;
  1368→}
  1369→
  1370→/**
  1371→ * Generate initial tasks file
  1372→ */
  1373→function generateShadowTasks(projectName: string): string {
  1374→  return `# ${projectName} - Tasks
  1375→# Track implementation work here
  1376→
  1377→tasks: []
  1378→`;
  1379→}
  1380→
  1381→/**
  1382→ * Generate initial inbox file
  1383→ */
  1384→function generateShadowInbox(): string {
  1385→  return `# Inbox - Quick Capture
  1386→# Ideas and notes that haven't been triaged yet
  1387→
  1388→items: []
  1389→`;
  1390→}
  1391→
  1392→/**
  1393→ * Get the kspec package root directory.
  1394→ * Navigates from dist/parser/ to package root.
  1395→ */
  1396→function getPackageRoot(): string {
  1397→  return path.resolve(__dirname, "..", "..");
  1398→}
  1399→
  1400→/**
  1401→ * Install pre-commit hook to protect kspec-meta branch.
  1402→ * Hook prevents direct commits to shadow branch unless KSPEC_SHADOW_COMMIT=1.
  1403→ *
  1404→ * Note: Git worktrees use hooks from the main .git/hooks directory (via commondir),
  1405→ * not from .git/worktrees/-kspec/hooks. So we install to main hooks directory.
  1406→ *
  1407→ * The hook source is located in the kspec package's templates/hooks/ directory.
  1408→ *
  1409→ * @param projectRoot Git repository root
  1410→ * @returns true if hook was installed, false if already exists
  1411→ */
  1412→async function installShadowHook(projectRoot: string): Promise<boolean> {
  1413→  const hooksDir = path.join(projectRoot, ".git", "hooks");
  1414→  const hookPath = path.join(hooksDir, "pre-commit");
  1415→
  1416→  // Look for hook in package templates directory
  1417→  const packageRoot = getPackageRoot();
  1418→  const sourceHookPath = path.join(packageRoot, "templates", "hooks", "pre-commit");
  1419→
  1420→  try {
  1421→    // Check if source hook exists in package templates
  1422→    try {
  1423→      await fs.access(sourceHookPath);
  1424→    } catch {
  1425→      // Source hook doesn't exist - skip installation
  1426→      return false;
  1427→    }
  1428→
  1429→    // Check if hook already exists
  1430→    try {
  1431→      await fs.access(hookPath);
  1432→      // Hook exists - don't overwrite (user may have custom hooks)
  1433→      return false;
  1434→    } catch {
  1435→      // Hook doesn't exist - install it
  1436→    }
  1437→
  1438→    // Copy hook from package templates
  1439→    const hookContent = await fs.readFile(sourceHookPath, "utf-8");
  1440→    await fs.writeFile(hookPath, hookContent, { mode: 0o755 });
  1441→    return true;
  1442→  } catch (_error) {
  1443→    // Silently fail - hook installation is optional
  1444→    return false;
  1445→  }
  1446→}
  1447→
  1448→/**
  1449→ * Convert project name to slug (kebab-case)
  1450→ */
  1451→function toSlug(projectName: string): string {
  1452→  return projectName
  1453→    .toLowerCase()
  1454→    .replace(/[^a-z0-9]+/g, "-")
  1455→    .replace(/^-|-$/g, "");
  1456→}
  1457→
  1458→/**
  1459→ * Configure git merge driver for kspec YAML files.
  1460→ * AC: @yaml-merge-driver ac-12
  1461→ *
  1462→ * Configures the merge driver in .git/config and adds .gitattributes in the shadow branch.
  1463→ *
  1464→ * @param projectRoot Git repository root
  1465→ * @param worktreeDir Path to shadow worktree directory
  1466→ * @returns true if configuration was successful
  1467→ */
  1468→async function configureMergeDriver(
  1469→  projectRoot: string,
  1470→  worktreeDir: string,
  1471→): Promise<boolean> {
  1472→  try {
  1473→    // Step 1: Configure merge driver in .git/config
  1474→    const kspecPath = execSync("which kspec", {
  1475→      encoding: "utf-8",
  1476→      stdio: ["pipe", "pipe", "pipe"],
  1477→    }).trim();
  1478→
  1479→    // Add merge driver configuration to git config
  1480→    try {
  1481→      execSync(
  1482→        `git config merge.kspec.name "Kspec YAML semantic merge driver"`,
  1483→        {
  1484→          cwd: projectRoot,
  1485→          stdio: ["pipe", "pipe", "pipe"],
  1486→        },
  1487→      );
  1488→      execSync(
  1489→        `git config merge.kspec.driver "${kspecPath} merge-driver %O %A %B --non-interactive"`,
  1490→        {
  1491→          cwd: projectRoot,
  1492→          stdio: ["pipe", "pipe", "pipe"],
  1493→        },
  1494→      );
  1495→    } catch (error) {
  1496→      // Config may fail if already set - check if it's set correctly
  1497→      try {
  1498→        const existingDriver = execSync("git config merge.kspec.driver", {
  1499→          cwd: projectRoot,
  1500→          encoding: "utf-8",
  1501→          stdio: ["pipe", "pipe", "pipe"],
  1502→        }).trim();
  1503→
  1504→        if (!existingDriver.includes("kspec merge-driver")) {
  1505→          throw new Error("Merge driver config exists but is incorrect");
  1506→        }
  1507→      } catch {
  1508→        throw error; // Re-throw original error
  1509→      }
  1510→    }
  1511→
  1512→    // Step 2: Create .gitattributes in shadow branch
  1513→    const gitattributesPath = path.join(worktreeDir, ".gitattributes");
  1514→
  1515→    // Check if .gitattributes exists
  1516→    let existingContent = "";
  1517→    try {
  1518→      existingContent = await fs.readFile(gitattributesPath, "utf-8");
  1519→    } catch {
  1520→      // File doesn't exist, that's fine
  1521→    }
  1522→
  1523→    // Check if merge driver is already configured
  1524→    if (!existingContent.includes("merge=kspec")) {
  1525→      const attributesContent = existingContent
  1526→        ? existingContent + "\n"
  1527→        : "# Git attributes for kspec\n\n";
  1528→
  1529→      await fs.writeFile(
  1530→        gitattributesPath,
  1531→        attributesContent + "*.yaml merge=kspec\n*.yml merge=kspec\n",
  1532→        "utf-8",
  1533→      );
  1534→
  1535→      // Commit .gitattributes to shadow branch
  1536→      await shadowAutoCommit(worktreeDir, "Configure kspec merge driver");
  1537→    }
  1538→
  1539→    return true;
  1540→  } catch (_error) {
  1541→    // Silently fail - merge driver configuration is optional
  1542→    return false;
  1543→  }
  1544→}
  1545→
  1546→/**
  1547→ * Initialize shadow branch and worktree.
  1548→ * Creates orphan branch, worktree, updates gitignore, and creates initial structure.
  1549→ *
  1550→ * AC: @config-shadow ac-1 — creates orphan branch with configured name
  1551→ * AC: @config-shadow ac-2 — creates worktree at configured directory
  1552→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
  1553→ *
  1554→ * @param projectRoot Git repository root
  1555→ * @param options Initialization options
  1556→ * @returns Result indicating what was created
  1557→ */
  1558→export async function initializeShadow(
  1559→  projectRoot: string,
  1560→  options: ShadowInitOptions = {},
  1561→): Promise<ShadowInitResult> {
  1562→  const result: ShadowInitResult = {
  1563→    success: false,
  1564→    branchCreated: false,
  1565→    worktreeCreated: false,
  1566→    gitignoreUpdated: false,
  1567→    initialCommit: false,
  1568→    alreadyExists: false,
  1569→    createdFromRemote: false,
  1570→    pushedToRemote: false,
  1571→  };
  1572→
  1573→  // Check if we're in a git repo
  1574→  if (!(await isGitRepo(projectRoot))) {
  1575→    result.error = "Not a git repository";
  1576→    return result;
  1577→  }
  1578→
  1579→  // AC: ac-1 ac-2 — use configured branch/directory or defaults
  1580→  const branchName = getBranchName(options.shadow);
  1581→  const directoryName = getDirectoryName(options.shadow);
  1582→  const worktreeDir = path.join(projectRoot, directoryName);
  1583→
  1584→  // Check current status with configured options
  1585→  const status = await getShadowStatus(projectRoot, options.shadow);
  1586→
  1587→  // Handle existing shadow branch
  1588→  if (status.healthy && !options.force) {
  1589→    result.alreadyExists = true;
  1590→    result.success = true;
  1591→    return result;
  1592→  }
  1593→
  1594→  // Derive project name if not provided
  1595→  const projectName =
  1596→    options.projectName ||
  1597→    path
  1598→      .basename(projectRoot)
  1599→      .replace(/[-_]/g, " ")
  1600→      .replace(/\b\w/g, (c) => c.toUpperCase());
  1601→
  1602→  const slug = toSlug(projectName);
  1603→
  1604→  // Determine remote name to use
  1605→  let remoteName = "origin";
  1606→  if (options.shadow?.remote && options.shadow.remoteType === "named") {
  1607→    remoteName = options.shadow.remote;
  1608→  }
  1609→
  1610→  // Check for remote shadow branch (AC-4: fetch to ensure refs are up to date)
  1611→  const remoteExists = await hasRemote(projectRoot, remoteName);
  1612→  let remoteHasShadow = false;
  1613→  if (remoteExists) {
  1614→    await fetchRemote(projectRoot, remoteName); // Best effort, ignore failures
  1615→    remoteHasShadow = await remoteBranchExists(projectRoot, branchName, remoteName);
  1616→  }
  1617→
  1618→  try {
  1619→    // Step 1: Update .gitignore first (before creating worktree)
  1620→    result.gitignoreUpdated = await ensureGitignore(projectRoot, options.shadow);
  1621→
  1622→    // Step 2: Create worktree with orphan branch (or attach to existing branch)
  1623→    if (!status.worktreeExists || !status.worktreeLinked) {
  1624→      // Remove existing directory if present but not linked
  1625→      if (status.worktreeExists && !status.worktreeLinked) {
  1626→        await fs.rm(worktreeDir, { recursive: true, force: true });
  1627→      }
  1628→
  1629→      // Remove stale worktree reference if any
  1630→      try {
  1631→        await execAsync(`git worktree remove "${directoryName}" --force`, {
  1632→          cwd: projectRoot,
  1633→        });
  1634→      } catch {
  1635→        // Ignore - worktree may not exist in git's list
  1636→      }
  1637→
  1638→      if (remoteHasShadow) {
  1639→        // AC: @shadow-init-remote ac-1 - Remote has shadow branch - create worktree from it with tracking
  1640→        await execAsync(
  1641→          `git worktree add "${directoryName}" ${branchName}`,
  1642→          { cwd: projectRoot },
  1643→        );
  1644→        // Set up tracking for the branch
  1645→        await execAsync(
  1646→          `git branch --set-upstream-to=${remoteName}/${branchName} ${branchName}`,
  1647→          { cwd: projectRoot },
  1648→        );
  1649→        result.createdFromRemote = true;
  1650→      } else if (!status.branchExists) {
  1651→        // AC: @shadow-init-remote ac-2 ac-3 - No remote branch or no remote - create orphan branch
  1652→        // AC: @config-shadow ac-1 — use configured branch name
  1653→        await execAsync(
  1654→          `git worktree add --orphan -b ${branchName} "${directoryName}"`,
  1655→          { cwd: projectRoot },
  1656→        );
  1657→        result.branchCreated = true;
  1658→      } else {
  1659→        // Attach to existing local branch
  1660→        await execAsync(
  1661→          `git worktree add "${directoryName}" ${branchName}`,
  1662→          { cwd: projectRoot },
  1663→        );
  1664→      }
  1665→
  1666→      result.worktreeCreated = true;
  1667→    }
  1668→
  1669→    // Step 3: Create initial structure if empty (only for new branches, not remote)
  1670→    const manifestPath = path.join(worktreeDir, `${slug}.yaml`);
  1671→    const modulesDir = path.join(worktreeDir, "modules");
  1672→    const moduleFilePath = path.join(modulesDir, "main.yaml");
  1673→    const tasksPath = path.join(worktreeDir, `${slug}.tasks.yaml`);
  1674→    const inboxPath = path.join(worktreeDir, `${slug}.inbox.yaml`);
  1675→
  1676→    let filesCreated = false;
  1677→
  1678→    // Only create files if manifest doesn't exist (remote branches will have files)
  1679→    try {
  1680→      // Look for any .yaml manifest file (project name may differ)
  1681→      const files = await fs.readdir(worktreeDir);
  1682→      const hasManifest = files.some(
  1683→        (f) =>
  1684→          f.endsWith(".yaml") &&
  1685→          !f.includes(".tasks.") &&
  1686→          !f.includes(".inbox."),
  1687→      );
  1688→      if (!hasManifest) {
  1689→        throw new Error("No manifest found");
  1690→      }
  1691→    } catch {
  1692→      // Manifest doesn't exist, create initial structure
  1693→      await fs.mkdir(modulesDir, { recursive: true });
  1694→      await fs.writeFile(
  1695→        manifestPath,
  1696→        generateShadowManifest(projectName),
  1697→        "utf-8",
  1698→      );
  1699→      await fs.writeFile(
  1700→        moduleFilePath,
  1701→        generateShadowModule(projectName),
  1702→        "utf-8",
  1703→      );
  1704→      await fs.writeFile(tasksPath, generateShadowTasks(projectName), "utf-8");
  1705→      await fs.writeFile(inboxPath, generateShadowInbox(), "utf-8");
  1706→      filesCreated = true;
  1707→    }
  1708→
  1709→    // Step 4: Initial commit if files were created
  1710→    if (filesCreated) {
  1711→      result.initialCommit = await shadowAutoCommit(
  1712→        worktreeDir,
  1713→        `Initialize ${projectName} spec`,
  1714→      );
  1715→    }
  1716→
  1717→    // Step 5: AC-2: Push new branch to remote to establish tracking
  1718→    if (result.branchCreated && remoteExists && !remoteHasShadow) {
  1719→      result.pushedToRemote = await pushShadowBranch(worktreeDir, remoteName, options.shadow);
  1720→    }
  1721→
  1722→    // Step 6: Install pre-commit hook to protect shadow branch
  1723→    await installShadowHook(projectRoot);
  1724→
  1725→    // Step 7: Configure merge driver for semantic YAML merging
  1726→    // AC: @yaml-merge-driver ac-12
  1727→    await configureMergeDriver(projectRoot, worktreeDir);
  1728→
  1729→    result.success = true;
  1730→    return result;
  1731→  } catch (error) {
  1732→    result.error = error instanceof Error ? error.message : String(error);
  1733→    return result;
  1734→  }
  1735→}
  1736→
  1737→/**
  1738→ * Repair a broken shadow branch setup.
  1739→ * Handles cases where worktree is disconnected or directory is missing.
  1740→ *
  1741→ * AC: @config-shadow ac-7 — backward compat when called without config
  1742→ *
  1743→ * @param projectRoot Git repository root
  1744→ * @param options Optional shadow configuration
  1745→ * @returns Result indicating what was repaired
  1746→ */
  1747→export async function repairShadow(
  1748→  projectRoot: string,
  1749→  options?: ShadowOptions,
  1750→): Promise<ShadowInitResult> {
  1751→  const branchName = getBranchName(options);
  1752→  const directoryName = getDirectoryName(options);
  1753→  const status = await getShadowStatus(projectRoot, options);
  1754→
  1755→  if (status.healthy) {
  1756→    return {
  1757→      success: true,
  1758→      branchCreated: false,
  1759→      worktreeCreated: false,
  1760→      gitignoreUpdated: false,
  1761→      initialCommit: false,
  1762→      alreadyExists: true,
  1763→      createdFromRemote: false,
  1764→      pushedToRemote: false,
  1765→    };
  1766→  }
  1767→
  1768→  if (!status.branchExists) {
  1769→    // Can't repair without a branch - need full init
  1770→    return {
  1771→      success: false,
  1772→      branchCreated: false,
  1773→      worktreeCreated: false,
  1774→      gitignoreUpdated: false,
  1775→      initialCommit: false,
  1776→      alreadyExists: false,
  1777→      createdFromRemote: false,
  1778→      pushedToRemote: false,
  1779→      error: "Shadow branch does not exist. Run `kspec init` instead.",
  1780→    };
  1781→  }
  1782→
  1783→  // Branch exists but worktree is broken - repair it
  1784→  const worktreeDir = path.join(projectRoot, directoryName);
  1785→
  1786→  try {
  1787→    // Remove stale worktree reference
  1788→    try {
  1789→      await execAsync(`git worktree remove "${directoryName}" --force`, {
  1790→        cwd: projectRoot,
  1791→      });
  1792→    } catch {
  1793→      // Ignore - worktree may not be in git's list
  1794→    }
  1795→
  1796→    // Remove directory if exists (handles corrupted .git file case)
  1797→    await fs.rm(worktreeDir, { recursive: true, force: true });
  1798→
  1799→    // Prune stale worktree references (cleans up orphaned entries)
  1800→    try {
  1801→      await execAsync("git worktree prune", { cwd: projectRoot });
  1802→    } catch {
  1803→      // Ignore - prune is best-effort
  1804→    }
  1805→
  1806→    // Recreate worktree
  1807→    await execAsync(
  1808→      `git worktree add "${directoryName}" ${branchName}`,
  1809→      { cwd: projectRoot },
  1810→    );
  1811→
  1812→    // Install pre-commit hook
  1813→    await installShadowHook(projectRoot);
  1814→
  1815→    return {
  1816→      success: true,
  1817→      branchCreated: false,
  1818→      worktreeCreated: true,
  1819→      gitignoreUpdated: false,
  1820→      initialCommit: false,
  1821→      alreadyExists: false,
  1822→      createdFromRemote: false,
  1823→      pushedToRemote: false,
  1824→    };
  1825→  } catch (error) {
  1826→    return {
  1827→      success: false,
  1828→      branchCreated: false,
  1829→      worktreeCreated: false,
  1830→      gitignoreUpdated: false,
  1831→      initialCommit: false,
  1832→      alreadyExists: false,
  1833→      createdFromRemote: false,
  1834→      pushedToRemote: false,
  1835→      error: error instanceof Error ? error.message : String(error),
  1836→    };
  1837→  }
  1838→}
  1839→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
