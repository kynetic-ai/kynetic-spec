```
     1→/**
     2→ * kspec serve commands - daemon server lifecycle management
     3→ * AC: @cli-serve-commands
     4→ */
     5→
     6→import type { Command } from 'commander';
     7→import { spawn, execSync } from 'child_process';
     8→import { existsSync, readdirSync, statSync } from 'fs';
     9→import { join, dirname } from 'path';
    10→import { fileURLToPath } from 'url';
    11→import { error, info, output, success, warn, isJsonMode } from '../output.js';
    12→import { EXIT_CODES } from '../exit-codes.js';
    13→import { PidFileManager } from '../pid-utils.js';
    14→
    15→/**
    16→ * Check if Bun runtime is available.
    17→ * Daemon requires Bun to run TypeScript directly.
    18→ */
    19→function isBunAvailable(): boolean {
    20→  try {
    21→    execSync('bun --version', { stdio: 'pipe' });
    22→    return true;
    23→  } catch {
    24→    return false;
    25→  }
    26→}
    27→
    28→const __filename = fileURLToPath(import.meta.url);
    29→const __dirname = dirname(__filename);
    30→
    31→/**
    32→ * Check if daemon dist files are stale (source newer than dist)
    33→ * Returns true if rebuild is recommended
    34→ */
    35→function checkDaemonStaleness(): boolean {
    36→  // __dirname is dist/cli/commands, go up 3 levels to package root, then into packages/daemon/src
    37→  const sourceDir = join(__dirname, '../../../packages/daemon/src');
    38→  // dist/daemon is 2 levels up from __dirname
    39→  const distDir = join(__dirname, '../../daemon');
    40→
    41→  if (!existsSync(sourceDir) || !existsSync(distDir)) return false;
    42→
    43→  try {
    44→    const getNewestMtime = (dir: string): number => {
    45→      const files = readdirSync(dir, { withFileTypes: true });
    46→      let newest = 0;
    47→      for (const f of files) {
    48→        const fullPath = join(dir, f.name);
    49→        if (f.isDirectory()) {
    50→          newest = Math.max(newest, getNewestMtime(fullPath));
    51→        } else if (f.name.endsWith('.ts')) {
    52→          newest = Math.max(newest, statSync(fullPath).mtimeMs);
    53→        }
    54→      }
    55→      return newest;
    56→    };
    57→
    58→    const newestSource = getNewestMtime(sourceDir);
    59→    const newestDist = getNewestMtime(distDir);
    60→
    61→    return newestSource > newestDist;
    62→  } catch {
    63→    return false; // Don't warn if check fails
    64→  }
    65→}
    66→
    67→
    68→/**
    69→ * Register serve commands
    70→ */
    71→export function registerServeCommands(program: Command): void {
    72→  const serve = program
    73→    .command('serve')
    74→    .description('Manage the kspec daemon server');
    75→
    76→  // AC: @cli-serve-commands ac-1, ac-2, ac-3
    77→  serve
    78→    .command('start', { isDefault: true })
    79→    .description('Start the daemon server')
    80→    .option('-d, --daemon', 'Run in background (detached mode)')
    81→    .option('-p, --port <port>', 'Server port (default: 3456)', '3456')
    82→    .option('--kspec-dir <dir>', 'Path to .kspec directory', join(process.cwd(), '.kspec'))
    83→    .option('--json', 'Output as JSON')
    84→    .action(async (opts) => {
    85→      try {
    86→        await startServer(opts);
    87→      } catch (err) {
    88→        if (isJsonMode()) {
    89→          output({ error: err instanceof Error ? err.message : String(err) });
    90→        } else {
    91→          error(`Failed to start server: ${err instanceof Error ? err.message : String(err)}`);
    92→        }
    93→        process.exit(EXIT_CODES.ERROR);
    94→      }
    95→    });
    96→
    97→  // AC: @cli-serve-commands ac-4, ac-5
    98→  serve
    99→    .command('stop')
   100→    .description('Stop the daemon server')
   101→    .option('--kspec-dir <dir>', 'Path to .kspec directory', join(process.cwd(), '.kspec'))
   102→    .option('--json', 'Output as JSON')
   103→    .action(async (opts) => {
   104→      try {
   105→        await stopServer(opts);
   106→      } catch (err) {
   107→        if (isJsonMode()) {
   108→          output({ error: err instanceof Error ? err.message : String(err) });
   109→        } else {
   110→          error(`Failed to stop server: ${err instanceof Error ? err.message : String(err)}`);
   111→        }
   112→        process.exit(EXIT_CODES.ERROR);
   113→      }
   114→    });
   115→
   116→  // AC: @cli-serve-commands ac-6
   117→  serve
   118→    .command('status')
   119→    .description('Check daemon server status')
   120→    .option('--kspec-dir <dir>', 'Path to .kspec directory', join(process.cwd(), '.kspec'))
   121→    .option('--json', 'Output as JSON')
   122→    .action(async (opts) => {
   123→      try {
   124→        await statusServer(opts);
   125→      } catch (err) {
   126→        if (isJsonMode()) {
   127→          output({ error: err instanceof Error ? err.message : String(err) });
   128→        } else {
   129→          error(`Failed to check status: ${err instanceof Error ? err.message : String(err)}`);
   130→        }
   131→        process.exit(EXIT_CODES.ERROR);
   132→      }
   133→    });
   134→
   135→  // AC: @cli-serve-commands ac-7
   136→  serve
   137→    .command('restart')
   138→    .description('Restart the daemon server')
   139→    .option('--kspec-dir <dir>', 'Path to .kspec directory', join(process.cwd(), '.kspec'))
   140→    .option('--json', 'Output as JSON')
   141→    .action(async (opts) => {
   142→      try {
   143→        await restartServer(opts);
   144→      } catch (err) {
   145→        if (isJsonMode()) {
   146→          output({ error: err instanceof Error ? err.message : String(err) });
   147→        } else {
   148→          error(`Failed to restart server: ${err instanceof Error ? err.message : String(err)}`);
   149→        }
   150→        process.exit(EXIT_CODES.ERROR);
   151→      }
   152→    });
   153→}
   154→
   155→/**
   156→ * Start the daemon server
   157→ * AC: @cli-serve-commands ac-1 (foreground), ac-2 (daemon), ac-3 (port), ac-10 (port error)
   158→ */
   159→async function startServer(opts: {
   160→  daemon?: boolean;
   161→  port: string;
   162→  kspecDir: string;
   163→}): Promise<void> {
   164→  const port = parseInt(opts.port, 10);
   165→  const jsonMode = isJsonMode();
   166→
   167→  // AC: @cli-serve-commands ac-10
   168→  if (isNaN(port) || port < 1 || port > 65535) {
   169→    if (jsonMode) {
   170→      output({
   171→        error: 'Invalid port number. Must be between 1 and 65535.',
   172→        hint: 'Try: kspec serve --port <PORT>',
   173→      });
   174→    } else {
   175→      error('Invalid port number. Must be between 1 and 65535.');
   176→      error('Try: kspec serve --port <PORT>');
   177→    }
   178→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   179→  }
   180→
   181→  const pidManager = new PidFileManager();
   182→
   183→  // Check if already running
   184→  if (pidManager.isDaemonRunning()) {
   185→    const pid = pidManager.readPid();
   186→    const existingPort = pidManager.readPort();
   187→    if (isJsonMode()) {
   188→      output({ running: true, pid, port: existingPort, message: 'Daemon already running' });
   189→    } else {
   190→      warn(`Daemon already running on port ${existingPort}`);
   191→    }
   192→    process.exit(EXIT_CODES.SUCCESS);
   193→  }
   194→
   195→  // Get path to daemon entry point
   196→  // Daemon source is bundled at dist/daemon/index.ts (relative to package root)
   197→  // __dirname is dist/cli/commands, so go up 2 levels to dist/, then into daemon/
   198→  // Note: Daemon is TypeScript source - requires Bun runtime
   199→  const daemonBinary = join(__dirname, '../../daemon/index.ts');
   200→
   201→  if (!existsSync(daemonBinary)) {
   202→    if (isJsonMode()) {
   203→      output({ error: `Daemon binary not found at ${daemonBinary}`, hint: 'Ensure the kspec package is properly installed' });
   204→    } else {
   205→      error(`Daemon binary not found at: ${daemonBinary}`);
   206→      error('Ensure the kspec package is properly installed');
   207→    }
   208→    process.exit(EXIT_CODES.ERROR);
   209→  }
   210→
   211→  // Daemon requires Bun to run TypeScript directly
   212→  if (!isBunAvailable()) {
   213→    if (isJsonMode()) {
   214→      output({ error: 'Bun runtime not found', hint: 'Install Bun: https://bun.sh/docs/installation' });
   215→    } else {
   216→      error('Bun runtime is required for the daemon server');
   217→      error('Install Bun: https://bun.sh/docs/installation');
   218→    }
   219→    process.exit(EXIT_CODES.ERROR);
   220→  }
   221→
   222→  // Check for stale daemon build (dev experience improvement)
   223→  if (checkDaemonStaleness() && !jsonMode) {
   224→    warn('Warning: dist/daemon/ may be stale (source files are newer).');
   225→    warn('  Run "npm run build:daemon" to update.');
   226→  }
   227→
   228→  // AC: @cli-serve-commands ac-2 - background mode
   229→  if (opts.daemon) {
   230→    const runtime = 'bun';
   231→
   232→    // Spawn detached process
   233→    // Set BUN_ENV=production to prevent Bun dev mode HTML transformation
   234→    // which can cause asset hash mismatches in the web UI
   235→    const child = spawn(runtime, [daemonBinary, '--port', opts.port, '--kspec-dir', opts.kspecDir], {
   236→      detached: true,
   237→      stdio: 'ignore', // TODO: redirect to log file when logging implemented
   238→      cwd: process.cwd(),
   239→      env: { ...process.env, BUN_ENV: 'production' },
   240→    });
   241→
   242→    // Detach from parent
   243→    child.unref();
   244→
   245→    // Poll for PID file with timeout (max 5 seconds)
   246→    const maxWait = 5000;
   247→    const startTime = Date.now();
   248→    let pid: number | null = null;
   249→
   250→    while (Date.now() - startTime < maxWait) {
   251→      pid = pidManager.readPid();
   252→      if (pid && pidManager.isDaemonRunning()) {
   253→        break;
   254→      }
   255→      await new Promise(resolve => setTimeout(resolve, 100));
   256→    }
   257→
   258→    if (pid && pidManager.isDaemonRunning()) {
   259→      if (isJsonMode()) {
   260→        output({ running: true, pid, port });
   261→      } else {
   262→        success(`Daemon started with PID ${pid} on port ${port}`);
   263→        output({ running: true, pid, port });
   264→      }
   265→    } else {
   266→      if (isJsonMode()) {
   267→        output({ error: 'Daemon failed to start within 5 seconds' });
   268→      } else {
   269→        error('Daemon failed to start within 5 seconds');
   270→      }
   271→      process.exit(EXIT_CODES.ERROR);
   272→    }
   273→  } else {
   274→    // AC: @cli-serve-commands ac-1 - foreground mode
   275→    if (!isJsonMode()) {
   276→      info(`Starting server in foreground on port ${port}...`);
   277→      info('Press Ctrl+C to stop');
   278→    }
   279→
   280→    const runtime = 'bun';
   281→
   282→    // Set BUN_ENV=production to prevent Bun dev mode HTML transformation
   283→    const child = spawn(runtime, [daemonBinary, '--port', opts.port, '--kspec-dir', opts.kspecDir], {
   284→      stdio: 'inherit',
   285→      cwd: process.cwd(),
   286→      env: { ...process.env, BUN_ENV: 'production' },
   287→    });
   288→
   289→    // Handle Ctrl+C - forward SIGTERM to child for graceful shutdown
   290→    process.on('SIGINT', () => {
   291→      if (!isJsonMode()) {
   292→        info('\nStopping server...');
   293→      }
   294→      child.kill('SIGTERM');
   295→
   296→      // Wait for graceful shutdown (max 5 seconds)
   297→      const shutdownTimeout = setTimeout(() => {
   298→        child.kill('SIGKILL'); // Force kill if not stopped
   299→      }, 5000);
   300→
   301→      child.on('exit', () => {
   302→        clearTimeout(shutdownTimeout);
   303→      });
   304→    });
   305→
   306→    // Wait for process to exit
   307→    child.on('exit', (code) => {
   308→      process.exit(code ?? 0);
   309→    });
   310→  }
   311→}
   312→
   313→/**
   314→ * Stop the daemon server
   315→ * AC: @cli-serve-commands ac-4 (stop), ac-5 (idempotent)
   316→ */
   317→async function stopServer(opts: { kspecDir: string; json?: boolean }): Promise<void> {
   318→  if (isJsonMode()) {
   319→  }
   320→
   321→  const pidManager = new PidFileManager();
   322→
   323→  if (!pidManager.isDaemonRunning()) {
   324→    // AC: @cli-serve-commands ac-5
   325→    if (isJsonMode()) {
   326→      output({ running: false });
   327→    } else {
   328→      info('Daemon not running');
   329→      output({ running: false });
   330→    }
   331→    process.exit(EXIT_CODES.SUCCESS);
   332→  }
   333→
   334→  const pid = pidManager.readPid();
   335→  if (!pid) {
   336→    if (isJsonMode()) {
   337→      output({ error: 'Failed to read PID file' });
   338→    } else {
   339→      error('Failed to read PID file');
   340→    }
   341→    process.exit(EXIT_CODES.ERROR);
   342→  }
   343→
   344→  // AC: @cli-serve-commands ac-4
   345→  if (!isJsonMode()) {
   346→    info(`Stopping daemon (PID ${pid})...`);
   347→  }
   348→
   349→  try {
   350→    // Send SIGTERM
   351→    process.kill(pid, 'SIGTERM');
   352→
   353→    // Wait for clean shutdown (max 5 seconds)
   354→    const maxWait = 5000;
   355→    const startTime = Date.now();
   356→    while (Date.now() - startTime < maxWait) {
   357→      if (!pidManager.isDaemonRunning()) {
   358→        break;
   359→      }
   360→      await new Promise(resolve => setTimeout(resolve, 100));
   361→    }
   362→
   363→    if (pidManager.isDaemonRunning()) {
   364→      if (!isJsonMode()) {
   365→        warn(`Daemon did not stop gracefully, forcing...`);
   366→      }
   367→      process.kill(pid, 'SIGKILL');
   368→      await new Promise(resolve => setTimeout(resolve, 500));
   369→    }
   370→
   371→    if (isJsonMode()) {
   372→      output({ stopped: true, pid });
   373→    } else {
   374→      success('Daemon stopped');
   375→      output({ stopped: true, pid });
   376→    }
   377→  } catch (err) {
   378→    if (isJsonMode()) {
   379→      output({ error: err instanceof Error ? err.message : String(err) });
   380→    } else {
   381→      error(`Failed to stop daemon: ${err instanceof Error ? err.message : String(err)}`);
   382→    }
   383→    process.exit(EXIT_CODES.ERROR);
   384→  }
   385→}
   386→
   387→/**
   388→ * Check daemon server status
   389→ * AC: @cli-serve-commands ac-6, @multi-directory-daemon ac-12
   390→ */
   391→async function statusServer(opts: { kspecDir: string; json?: boolean }): Promise<void> {
   392→  if (isJsonMode()) {
   393→  }
   394→
   395→  const pidManager = new PidFileManager();
   396→  const running = pidManager.isDaemonRunning();
   397→  const pid = pidManager.readPid();
   398→
   399→  // Read port from global config (AC: @multi-directory-daemon ac-13)
   400→  let port: number | null = null;
   401→  if (running) {
   402→    try {
   403→      port = pidManager.readPort();
   404→    } catch {
   405→      // Port file might not exist or be invalid
   406→      port = null;
   407→    }
   408→  }
   409→
   410→  // AC: @multi-directory-daemon ac-12 - Fetch list of registered projects and uptime
   411→  let projects: Array<{ path: string; registeredAt: string; watcherStatus: string }> = [];
   412→  let uptime: number | null = null;
   413→  if (running && port) {
   414→    try {
   415→      const response = await fetch(`http://localhost:${port}/api/projects`);
   416→      if (response.ok) {
   417→        const data = await response.json() as { projects: Array<{ path: string; registeredAt: string; watcherStatus: string }> };
   418→        projects = data.projects || [];
   419→      }
   420→    } catch {
   421→      // If daemon is not responding, continue without projects list
   422→      // This can happen if daemon is still starting up or network issues
   423→    }
   424→
   425→    // Fetch uptime from health endpoint
   426→    try {
   427→      const healthResponse = await fetch(`http://localhost:${port}/api/health`);
   428→      if (healthResponse.ok) {
   429→        const healthData = await healthResponse.json() as { status: string; uptime: number };
   430→        uptime = healthData.uptime;
   431→      }
   432→    } catch {
   433→      // If health endpoint fails, continue without uptime
   434→    }
   435→  }
   436→
   437→  const status = {
   438→    running,
   439→    pid: pid ?? null,
   440→    port,
   441→    uptime,
   442→    projects,
   443→  };
   444→
   445→  if (isJsonMode()) {
   446→    output(status);
   447→  } else {
   448→    if (running) {
   449→      output(`Daemon running (PID: ${pid})`);
   450→      if (port) {
   451→        output(`  Port: ${port}`);
   452→      }
   453→      // AC: @multi-directory-daemon ac-12 - Show uptime
   454→      if (uptime !== null) {
   455→        const hours = Math.floor(uptime / 3600);
   456→        const minutes = Math.floor((uptime % 3600) / 60);
   457→        const seconds = Math.floor(uptime % 60);
   458→        if (hours > 0) {
   459→          output(`  Uptime: ${hours}h ${minutes}m ${seconds}s`);
   460→        } else if (minutes > 0) {
   461→          output(`  Uptime: ${minutes}m ${seconds}s`);
   462→        } else {
   463→          output(`  Uptime: ${seconds}s`);
   464→        }
   465→      }
   466→      // AC: @multi-directory-daemon ac-12 - Show registered projects
   467→      if (projects.length > 0) {
   468→        output(`\nRegistered projects (${projects.length}):`);
   469→        for (const project of projects) {
   470→          output(`  ${project.path} (watcher: ${project.watcherStatus})`);
   471→        }
   472→      } else {
   473→        output(`\nNo projects registered`);
   474→      }
   475→    } else {
   476→      output('Daemon not running');
   477→    }
   478→  }
   479→}
   480→
   481→/**
   482→ * Restart the daemon server
   483→ * AC: @cli-serve-commands ac-7
   484→ */
   485→async function restartServer(opts: { kspecDir: string; json?: boolean }): Promise<void> {
   486→  if (isJsonMode()) {
   487→  }
   488→
   489→  const pidManager = new PidFileManager();
   490→
   491→  // AC: @cli-serve-commands ac-7 - preserve port across restarts
   492→  let port = '3456'; // default port
   493→  try {
   494→    port = pidManager.readPort().toString();
   495→  } catch {
   496→    // Port file doesn't exist or is invalid, use default
   497→  }
   498→
   499→  if (pidManager.isDaemonRunning()) {
   500→    if (!isJsonMode()) {
   501→      info('Stopping daemon...');
   502→    }
   503→    await stopServer(opts);
   504→  }
   505→
   506→  if (!isJsonMode()) {
   507→    info('Starting daemon...');
   508→  }
   509→  await startServer({ daemon: true, port, kspecDir: opts.kspecDir });
   510→}
