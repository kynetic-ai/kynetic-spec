     1→/**
     2→ * Tests for project configuration loading (kspec.config.yaml)
     3→ *
     4→ * AC coverage:
     5→ * - @project-config ac-1: no config = defaults
     6→ * - @project-config ac-2: config available on KspecContext.config
     7→ * - @project-config ac-3: invalid YAML = defaults + warning
     8→ * - @project-config ac-4: unknown fields ignored
     9→ * - @project-config ac-5: env vars take precedence
    10→ * - @project-config ac-6: loads from git root, not cwd
    11→ * - @project-config ac-7: batch mode uses real project root
    12→ * - @config-author ac-1: config author used when no env var
    13→ * - @config-author ac-2: env var wins over config author
    14→ * - @config-author ac-3: fallback to git/OS when no config author
    15→ */
    16→
    17→import { describe, it, expect, beforeEach, afterEach } from "vitest";
    18→import * as fs from "node:fs/promises";
    19→import * as path from "node:path";
    20→import {
    21→  loadProjectConfig,
    22→  resolveConfig,
    23→  getDefaultConfig,
    24→  KspecConfigSchema,
    25→  type ResolvedKspecConfig,
    26→} from "../../src/parser/config.js";
    27→import { getAuthor, initContext } from "../../src/parser/yaml.js";
    28→import { createTempDir, cleanupTempDir, initGitRepo } from "../helpers/cli.js";
    29→
    30→describe("Project Config", () => {
    31→  let tempDir: string;
    32→  let originalEnv: NodeJS.ProcessEnv;
    33→
    34→  beforeEach(async () => {
    35→    tempDir = await createTempDir("kspec-config-test-");
    36→    initGitRepo(tempDir);
    37→    originalEnv = { ...process.env };
    38→    // Clean env vars that might affect tests
    39→    delete process.env.KSPEC_AUTHOR;
    40→    delete process.env.KSPEC_DAEMON_PORT;
    41→    delete process.env.KSPEC_DAEMON_HOST;
    42→    delete process.env.KSPEC_BATCH_PROJECT_ROOT;
    43→  });
    44→
    45→  afterEach(async () => {
    46→    await cleanupTempDir(tempDir);
    47→    // Restore env
    48→    process.env = originalEnv;
    49→  });
    50→
    51→  describe("loadProjectConfig", () => {
    52→    // AC: @project-config ac-1
    53→    it("returns defaults when no config file exists", async () => {
    54→      const result = await loadProjectConfig(tempDir);
    55→
    56→      expect(result.configPath).toBeNull();
    57→      expect(result.warning).toBeNull();
    58→      expect(result.gitRoot).toBe(tempDir);
    59→      expect(result.config).toEqual(getDefaultConfig());
    60→    });
    61→
    62→    // AC: @project-config ac-1
    63→    it("returns defaults with no behavior change when no config exists", async () => {
    64→      const result = await loadProjectConfig(tempDir);
    65→      const defaults = getDefaultConfig();
    66→
    67→      expect(result.config.shadow.branch).toBe(defaults.shadow.branch);
    68→      expect(result.config.shadow.directory).toBe(defaults.shadow.directory);
    69→      expect(result.config.shadow.remote).toBe(defaults.shadow.remote);
    70→      expect(result.config.daemon.port).toBe(defaults.daemon.port);
    71→      expect(result.config.daemon.host).toBe(defaults.daemon.host);
    72→      expect(result.config.validation.strictness).toBe(
    73→        defaults.validation.strictness
    74→      );
    75→    });
    76→
    77→    // AC: @project-config ac-2 (partial - config file parsing)
    78→    it("parses valid config file", async () => {
    79→      await fs.writeFile(
    80→        path.join(tempDir, "kspec.config.yaml"),
    81→        `
    82→shadow:
    83→  branch: custom-branch
    84→  directory: .specs
    85→  remote: https://example.com/specs.git
    86→daemon:
    87→  port: 4000
    88→  host: 0.0.0.0
    89→identity:
    90→  author: "@custom-author"
    91→validation:
    92→  strictness: strict
    93→  warn_unknown_fields: false
    94→`
    95→      );
    96→
    97→      const result = await loadProjectConfig(tempDir);
    98→
    99→      expect(result.configPath).toBe(path.join(tempDir, "kspec.config.yaml"));
   100→      expect(result.warning).toBeNull();
   101→      expect(result.config.shadow.branch).toBe("custom-branch");
   102→      expect(result.config.shadow.directory).toBe(".specs");
   103→      expect(result.config.shadow.remote).toEqual({
   104→        value: "https://example.com/specs.git",
   105→        type: "url",
   106→      });
   107→      expect(result.config.daemon.port).toBe(4000);
   108→      expect(result.config.daemon.host).toBe("0.0.0.0");
   109→      expect(result.config.identity.author).toBe("@custom-author");
   110→      expect(result.config.validation.strictness).toBe("strict");
   111→      expect(result.config.validation.warn_unknown_fields).toBe(false);
   112→    });
   113→
   114→    // AC: @project-config ac-3
   115→    it("falls back to defaults and warns on invalid YAML syntax", async () => {
   116→      await fs.writeFile(
   117→        path.join(tempDir, "kspec.config.yaml"),
   118→        `
   119→shadow:
   120→  branch: [invalid yaml
   121→  this is broken:
   122→`
   123→      );
   124→
   125→      const result = await loadProjectConfig(tempDir);
   126→
   127→      expect(result.configPath).toBe(path.join(tempDir, "kspec.config.yaml"));
   128→      expect(result.warning).toContain("Failed to parse kspec.config.yaml");
   129→      expect(result.config).toEqual(getDefaultConfig());
   130→    });
   131→
   132→    // AC: @project-config ac-3
   133→    it("falls back to defaults and warns on validation errors", async () => {
   134→      await fs.writeFile(
   135→        path.join(tempDir, "kspec.config.yaml"),
   136→        `
   137→daemon:
   138→  port: "not-a-number"
   139→`
   140→      );
   141→
   142→      const result = await loadProjectConfig(tempDir);
   143→
   144→      expect(result.warning).toContain("Config validation failed");
   145→      expect(result.config).toEqual(getDefaultConfig());
   146→    });
   147→
   148→    // AC: @project-config ac-4
   149→    it("ignores unknown fields and applies valid fields", async () => {
   150→      await fs.writeFile(
   151→        path.join(tempDir, "kspec.config.yaml"),
   152→        `
   153→daemon:
   154→  port: 5000
   155→unknown_top_level_field: "should be ignored"
   156→another_unknown:
   157→  nested: value
   158→`
   159→      );
   160→
   161→      const result = await loadProjectConfig(tempDir);
   162→
   163→      expect(result.warning).toBeNull();
   164→      expect(result.config.daemon.port).toBe(5000);
   165→      // Defaults should still be applied for unspecified fields
   166→      expect(result.config.shadow.branch).toBe("kspec-meta");
   167→    });
   168→
   169→    // AC: @project-config ac-5
   170→    it("env vars take precedence over config file values", async () => {
   171→      await fs.writeFile(
   172→        path.join(tempDir, "kspec.config.yaml"),
   173→        `
   174→identity:
   175→  author: "@config-author"
   176→daemon:
   177→  port: 5000
   178→  host: from-config.local
   179→`
   180→      );
   181→
   182→      process.env.KSPEC_AUTHOR = "@env-author";
   183→      process.env.KSPEC_DAEMON_PORT = "6000";
   184→      process.env.KSPEC_DAEMON_HOST = "env-host.local";
   185→
   186→      const result = await loadProjectConfig(tempDir);
   187→
   188→      expect(result.config.identity.author).toBe("@env-author");
   189→      expect(result.config.daemon.port).toBe(6000);
   190→      expect(result.config.daemon.host).toBe("env-host.local");
   191→    });
   192→
   193→    // AC: @project-config ac-5
   194→    it("env vars apply even when no config file exists", async () => {
   195→      process.env.KSPEC_AUTHOR = "@env-only";
   196→      process.env.KSPEC_DAEMON_PORT = "7000";
   197→
   198→      const result = await loadProjectConfig(tempDir);
   199→
   200→      expect(result.config.identity.author).toBe("@env-only");
   201→      expect(result.config.daemon.port).toBe(7000);
   202→    });
   203→
   204→    // AC: @project-config ac-6
   205→    it("loads config from git root, not subdirectory", async () => {
   206→      // Create config in git root
   207→      await fs.writeFile(
   208→        path.join(tempDir, "kspec.config.yaml"),
   209→        `
   210→daemon:
   211→  port: 8000
   212→`
   213→      );
   214→
   215→      // Create subdirectory
   216→      const subDir = path.join(tempDir, "src", "deep", "nested");
   217→      await fs.mkdir(subDir, { recursive: true });
   218→
   219→      const result = await loadProjectConfig(subDir);
   220→
   221→      expect(result.gitRoot).toBe(tempDir);
   222→      expect(result.config.daemon.port).toBe(8000);
   223→    });
   224→
   225→    // AC: @project-config ac-7
   226→    it("uses KSPEC_BATCH_PROJECT_ROOT when set (batch mode)", async () => {
   227→      // Create config in the "real" project root
   228→      await fs.writeFile(
   229→        path.join(tempDir, "kspec.config.yaml"),
   230→        `
   231→daemon:
   232→  port: 9000
   233→`
   234→      );
   235→
   236→      // Create a separate temp dir to simulate batch mode
   237→      const batchTempDir = await createTempDir("kspec-batch-");
   238→
   239→      try {
   240→        // Simulate batch mode by setting the env var
   241→        process.env.KSPEC_BATCH_PROJECT_ROOT = tempDir;
   242→
   243→        // Load config from the batch temp dir - should still find config from real root
   244→        const result = await loadProjectConfig(batchTempDir);
   245→
   246→        expect(result.config.daemon.port).toBe(9000);
   247→      } finally {
   248→        await cleanupTempDir(batchTempDir);
   249→      }
   250→    });
   251→  });
   252→
   253→  describe("resolveConfig", () => {
   254→    it("returns defaults for null input", () => {
   255→      const config = resolveConfig(null);
   256→      expect(config).toEqual(getDefaultConfig());
   257→    });
   258→
   259→    it("merges partial config with defaults", () => {
   260→      const config = resolveConfig({
   261→        daemon: { port: 4567 },
   262→      });
   263→
   264→      expect(config.daemon.port).toBe(4567);
   265→      expect(config.daemon.host).toBe("localhost"); // default
   266→      expect(config.shadow.branch).toBe("kspec-meta"); // default
   267→    });
   268→
   269→    it("applies env var overrides", () => {
   270→      process.env.KSPEC_AUTHOR = "@test-author";
   271→
   272→      const config = resolveConfig({
   273→        identity: { author: "@file-author" },
   274→      });
   275→
   276→      expect(config.identity.author).toBe("@test-author");
   277→    });
   278→
   279→    it("handles invalid KSPEC_DAEMON_PORT gracefully", () => {
   280→      process.env.KSPEC_DAEMON_PORT = "not-a-number";
   281→
   282→      const config = resolveConfig({
   283→        daemon: { port: 4000 },
   284→      });
   285→
   286→      // Should fall back to file value since env is invalid
   287→      expect(config.daemon.port).toBe(4000);
   288→    });
   289→  });
   290→
   291→  describe("KspecConfigSchema", () => {
   292→    it("validates correct config", () => {
   293→      const result = KspecConfigSchema.safeParse({
   294→        shadow: {
   295→          branch: "my-branch",
   296→          directory: ".specs",
   297→          remote: "https://github.com/org/repo.git",
   298→        },
   299→        daemon: {
   300→          port: 3000,
   301→          host: "localhost",
   302→        },
   303→        identity: {
   304→          author: "@me",
   305→        },
   306→        validation: {
   307→          strictness: "strict",
   308→          warn_unknown_fields: true,
   309→        },
   310→      });
   311→
   312→      expect(result.success).toBe(true);
   313→    });
   314→
   315→    it("allows partial config", () => {
   316→      const result = KspecConfigSchema.safeParse({
   317→        daemon: { port: 4000 },
   318→      });
   319→
   320→      expect(result.success).toBe(true);
   321→    });
   322→
   323→    it("allows empty config", () => {
   324→      const result = KspecConfigSchema.safeParse({});
   325→      expect(result.success).toBe(true);
   326→    });
   327→
   328→    // AC: @project-config ac-4
   329→    it("allows unknown top-level fields (passthrough)", () => {
   330→      const result = KspecConfigSchema.safeParse({
   331→        daemon: { port: 4000 },
   332→        custom_field: "value",
   333→        another: { nested: true },
   334→      });
   335→
   336→      expect(result.success).toBe(true);
   337→    });
   338→
   339→    it("rejects invalid port", () => {
   340→      const result = KspecConfigSchema.safeParse({
   341→        daemon: { port: 70000 }, // above 65535
   342→      });
   343→
   344→      expect(result.success).toBe(false);
   345→    });
   346→
   347→    it("rejects invalid strictness value", () => {
   348→      const result = KspecConfigSchema.safeParse({
   349→        validation: { strictness: "invalid" },
   350→      });
   351→
   352→      expect(result.success).toBe(false);
   353→    });
   354→  });
   355→
   356→  // AC: @project-config ac-2 - full integration test
   357→  describe("initContext integration", () => {
   358→    it("includes config on KspecContext", async () => {
   359→      // Create a minimal kspec setup
   360→      await fs.mkdir(path.join(tempDir, "spec"), { recursive: true });
   361→      await fs.writeFile(
   362→        path.join(tempDir, "spec", "kynetic.yaml"),
   363→        `
   364→kynetic: "1.0"
   365→title: Test Project
   366→`
   367→      );
   368→      await fs.writeFile(
   369→        path.join(tempDir, "kspec.config.yaml"),
   370→        `
   371→daemon:
   372→  port: 5555
   373→`
   374→      );
   375→
   376→      const ctx = await initContext(tempDir);
   377→
   378→      expect(ctx.config).toBeDefined();
   379→      expect(ctx.config.daemon.port).toBe(5555);
   380→      expect(ctx.config.shadow.branch).toBe("kspec-meta"); // default
   381→    });
   382→
   383→    it("has config available even when no config file exists", async () => {
   384→      // Create a minimal kspec setup without config file
   385→      await fs.mkdir(path.join(tempDir, "spec"), { recursive: true });
   386→      await fs.writeFile(
   387→        path.join(tempDir, "spec", "kynetic.yaml"),
   388→        `
   389→kynetic: "1.0"
   390→title: Test Project
   391→`
   392→      );
   393→
   394→      const ctx = await initContext(tempDir);
   395→
   396→      expect(ctx.config).toBeDefined();
   397→      expect(ctx.config).toEqual(getDefaultConfig());
   398→    });
   399→  });
   400→
   401→  describe("getDefaultConfig", () => {
   402→    it("returns consistent defaults", () => {
   403→      const defaults = getDefaultConfig();
   404→
   405→      expect(defaults.shadow.branch).toBe("kspec-meta");
   406→      expect(defaults.shadow.directory).toBe(".kspec");
   407→      expect(defaults.shadow.remote).toBeNull();
   408→      expect(defaults.identity.author).toBeNull();
   409→      expect(defaults.validation.strictness).toBe("normal");
   410→      expect(defaults.validation.warn_unknown_fields).toBe(true);
   411→      expect(defaults.daemon.port).toBe(3456);
   412→      expect(defaults.daemon.host).toBe("localhost");
   413→    });
   414→
   415→    it("returns independent objects", () => {
   416→      const defaults1 = getDefaultConfig();
   417→      const defaults2 = getDefaultConfig();
   418→
   419→      defaults1.daemon.port = 9999;
   420→
   421→      expect(defaults2.daemon.port).toBe(3456); // Should not be affected
   422→    });
   423→  });
   424→
   425→  // AC: @config-author — config author in priority chain
   426→  describe("config author", () => {
   427→    // AC: @config-author ac-1 — config author is used when no env var
   428→    it("config author is used when no env var set", async () => {
   429→      await fs.writeFile(
   430→        path.join(tempDir, "kspec.config.yaml"),
   431→        `
   432→identity:
   433→  author: "@bot-agent"
   434→`
   435→      );
   436→
   437→      const result = await loadProjectConfig(tempDir);
   438→
   439→      expect(result.config.identity.author).toBe("@bot-agent");
   440→    });
   441→
   442→    // AC: @config-author ac-2 — env var wins over config
   443→    it("env var takes precedence over config author", async () => {
   444→      await fs.writeFile(
   445→        path.join(tempDir, "kspec.config.yaml"),
   446→        `
   447→identity:
   448→  author: "@config-author"
   449→`
   450→      );
   451→
   452→      process.env.KSPEC_AUTHOR = "@env-author";
   453→
   454→      const result = await loadProjectConfig(tempDir);
   455→
   456→      expect(result.config.identity.author).toBe("@env-author");
   457→    });
   458→
   459→    // AC: @config-author ac-3 — fallback to git/OS when no config
   460→    it("author is null when no config and no env var", async () => {
   461→      const result = await loadProjectConfig(tempDir);
   462→
   463→      // Config author should be null, fallback to git/OS happens in getAuthor()
   464→      expect(result.config.identity.author).toBeNull();
   465→    });
   466→  });
   467→
   468→  // AC: @config-author — getAuthor function with config parameter
   469→  describe("getAuthor with config", () => {
   470→    // AC: @config-author ac-1 — config author is used when no env var
   471→    it("returns config author when no env var set", () => {
   472→      delete process.env.KSPEC_AUTHOR;
   473→
   474→      const author = getAuthor("@config-bot");
   475→
   476→      expect(author).toBe("@config-bot");
   477→    });
   478→
   479→    // AC: @config-author ac-2 — env var wins over config
   480→    it("env var takes precedence over config author", () => {
   481→      process.env.KSPEC_AUTHOR = "@env-author";
   482→
   483→      const author = getAuthor("@config-author");
   484→
   485→      expect(author).toBe("@env-author");
   486→    });
   487→
   488→    // AC: @config-author ac-3 — fallback to git/OS when no config author
   489→    it("falls back to git/OS when config author is null", () => {
   490→      delete process.env.KSPEC_AUTHOR;
   491→
   492→      // Pass null to simulate no config author
   493→      const author = getAuthor(null);
   494→
   495→      // Should get git user.name or system user
   496→      // In test env, should get git user since we called initGitRepo
   497→      expect(author).toBeDefined();
   498→      expect(typeof author).toBe("string");
   499→    });
   500→
   501→    // AC: @config-author ac-3 — fallback works when no parameter passed
   502→    it("falls back to git/OS when no config author parameter passed", () => {
   503→      delete process.env.KSPEC_AUTHOR;
   504→
   505→      // No parameter = undefined, should use fallback chain
   506→      const author = getAuthor();
   507→
   508→      // Should get git user.name or system user
   509→      expect(author).toBeDefined();
   510→      expect(typeof author).toBe("string");
   511→    });
   512→
   513→    // AC: @config-author ac-1 — config author works with @-prefix
   514→    it("preserves @-prefix in config author", () => {
   515→      delete process.env.KSPEC_AUTHOR;
   516→
   517→      const author = getAuthor("@bot-agent");
   518→
   519→      expect(author).toBe("@bot-agent");
   520→    });
   521→
   522→    // AC: @config-author ac-1 — config author works without @-prefix
   523→    it("works with config author without @-prefix", () => {
   524→      delete process.env.KSPEC_AUTHOR;
   525→
   526→      const author = getAuthor("project-bot");
   527→
   528→      expect(author).toBe("project-bot");
   529→    });
   530→  });
   531→});
