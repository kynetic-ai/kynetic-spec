     1→/**
     2→ * Tests for Skill Meta Type
     3→ * AC: @skill-meta-type ac-1 through ac-7
     4→ */
     5→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     6→import * as fs from 'node:fs/promises';
     7→import * as path from 'node:path';
     8→import { stringify as yamlStringify } from 'yaml';
     9→import { createTempDir, cleanupTempDir, testUlid, initGitRepo } from './helpers/cli';
    10→import {
    11→  loadMetaContext,
    12→  loadSkillContent,
    13→  findMetaItemByRef,
    14→  getSkillContentPath,
    15→} from '../src/parser/meta';
    16→import { getMetaItemType, isSkill, MetaManifestSchema, SkillSchema } from '../src/schema/meta';
    17→import type { KspecContext } from '../src/parser/yaml';
    18→
    19→describe('Skill Meta Type', () => {
    20→  let tempDir: string;
    21→  let ctx: KspecContext;
    22→
    23→  beforeEach(async () => {
    24→    tempDir = await createTempDir();
    25→    await initGitRepo(tempDir);
    26→    ctx = {
    27→      specDir: tempDir,
    28→      manifestPath: path.join(tempDir, 'kynetic.yaml'),
    29→      rootPath: tempDir,
    30→    };
    31→
    32→    // Create minimal manifest
    33→    await fs.writeFile(
    34→      path.join(tempDir, 'kynetic.yaml'),
    35→      yamlStringify({ kynetic: '1.0' }),
    36→    );
    37→  });
    38→
    39→  afterEach(async () => {
    40→    await cleanupTempDir(tempDir);
    41→  });
    42→
    43→  describe('SkillSchema validation', () => {
    44→    // AC: @skill-meta-type ac-1
    45→    it('should validate skill entries via MetaManifestSchema', () => {
    46→      const skillUlid = testUlid('SKTEST');
    47→      const manifest = {
    48→        kynetic_meta: '1.0',
    49→        skills: [
    50→          {
    51→            _ulid: skillUlid,
    52→            id: 'task-work',
    53→            name: 'Task Work',
    54→            description: 'Work on kspec tasks',
    55→            origin: 'core',
    56→            version: '0.2.0',
    57→            tags: ['workflow'],
    58→          },
    59→        ],
    60→      };
    61→
    62→      const result = MetaManifestSchema.safeParse(manifest);
    63→      expect(result.success).toBe(true);
    64→      if (result.success) {
    65→        expect(result.data.skills).toHaveLength(1);
    66→        expect(result.data.skills[0].id).toBe('task-work');
    67→        expect(result.data.skills[0].origin).toBe('core');
    68→      }
    69→    });
    70→
    71→    // AC: @skill-meta-type ac-2
    72→    it('should validate skill with origin core and version', () => {
    73→      const skillUlid = testUlid('SKCORE');
    74→      const skill = {
    75→        _ulid: skillUlid,
    76→        id: 'pr-review',
    77→        name: 'PR Review',
    78→        origin: 'core',
    79→        version: '0.2.0',
    80→      };
    81→
    82→      const result = SkillSchema.safeParse(skill);
    83→      expect(result.success).toBe(true);
    84→      if (result.success) {
    85→        expect(result.data.origin).toBe('core');
    86→        expect(result.data.version).toBe('0.2.0');
    87→      }
    88→    });
    89→
    90→    it('should accept origin values: core, project, local', () => {
    91→      const baseSkill = {
    92→        _ulid: testUlid('SKORIG'),
    93→        id: 'test-skill',
    94→        name: 'Test Skill',
    95→      };
    96→
    97→      for (const origin of ['core', 'project', 'local']) {
    98→        const result = SkillSchema.safeParse({ ...baseSkill, origin, _ulid: testUlid('SK' + origin.toUpperCase().slice(0, 3)) });
    99→        expect(result.success).toBe(true);
   100→        if (result.success) {
   101→          expect(result.data.origin).toBe(origin);
   102→        }
   103→      }
   104→    });
   105→
   106→    it('should reject invalid origin values', () => {
   107→      const skill = {
   108→        _ulid: testUlid('SKBAD'),
   109→        id: 'bad-skill',
   110→        name: 'Bad Skill',
   111→        origin: 'invalid',
   112→      };
   113→
   114→      const result = SkillSchema.safeParse(skill);
   115→      expect(result.success).toBe(false);
   116→    });
   117→
   118→    it('should require id and name fields', () => {
   119→      const skillNoId = {
   120→        _ulid: testUlid('SKNOID'),
   121→        name: 'No ID Skill',
   122→        origin: 'core',
   123→      };
   124→
   125→      const skillNoName = {
   126→        _ulid: testUlid('SKNONA'),
   127→        id: 'no-name',
   128→        origin: 'core',
   129→      };
   130→
   131→      expect(SkillSchema.safeParse(skillNoId).success).toBe(false);
   132→      expect(SkillSchema.safeParse(skillNoName).success).toBe(false);
   133→    });
   134→  });
   135→
   136→  describe('loadSkillContent', () => {
   137→    // AC: @skill-meta-type ac-3
   138→    it('should return full markdown content of SKILL.md', async () => {
   139→      const skillId = 'my-skill';
   140→      const skillUlid = testUlid('SKLCNT');
   141→
   142→      // Create skill directory and SKILL.md file
   143→      const skillDir = path.join(tempDir, 'skills', skillId);
   144→      await fs.mkdir(skillDir, { recursive: true });
   145→
   146→      const skillContent = `# My Skill
   147→
   148→This is the skill content.
   149→
   150→## Usage
   151→
   152→Some usage instructions.
   153→`;
   154→      await fs.writeFile(path.join(skillDir, 'SKILL.md'), skillContent);
   155→
   156→      const skill = {
   157→        _ulid: skillUlid,
   158→        id: skillId,
   159→        name: 'My Skill',
   160→        origin: 'core' as const,
   161→        tags: [],
   162→      };
   163→
   164→      const content = await loadSkillContent(ctx, skill);
   165→      expect(content).toBe(skillContent);
   166→    });
   167→
   168→    it('should return null when SKILL.md does not exist', async () => {
   169→      const skill = {
   170→        _ulid: testUlid('SKNONE'),
   171→        id: 'nonexistent-skill',
   172→        name: 'Nonexistent Skill',
   173→        origin: 'core' as const,
   174→        tags: [],
   175→      };
   176→
   177→      const content = await loadSkillContent(ctx, skill);
   178→      expect(content).toBeNull();
   179→    });
   180→
   181→    it('should use correct path for skill content', () => {
   182→      const skillPath = getSkillContentPath(ctx, 'test-skill');
   183→      expect(skillPath).toBe(path.join(tempDir, 'skills', 'test-skill', 'SKILL.md'));
   184→    });
   185→  });
   186→
   187→  describe('loadMetaContext with skills', () => {
   188→    // AC: @skill-meta-type ac-4
   189→    it('should load skills into MetaContext with _sourceFile set', async () => {
   190→      const skill1Ulid = testUlid('SK001');
   191→      const skill2Ulid = testUlid('SK002');
   192→      const skill3Ulid = testUlid('SK003');
   193→
   194→      const metaManifest = {
   195→        kynetic_meta: '1.0',
   196→        skills: [
   197→          {
   198→            _ulid: skill1Ulid,
   199→            id: 'skill-one',
   200→            name: 'Skill One',
   201→            origin: 'core',
   202→            version: '0.1.0',
   203→          },
   204→          {
   205→            _ulid: skill2Ulid,
   206→            id: 'skill-two',
   207→            name: 'Skill Two',
   208→            origin: 'project',
   209→          },
   210→          {
   211→            _ulid: skill3Ulid,
   212→            id: 'skill-three',
   213→            name: 'Skill Three',
   214→            origin: 'local',
   215→          },
   216→        ],
   217→      };
   218→
   219→      await fs.writeFile(
   220→        path.join(tempDir, 'kynetic.meta.yaml'),
   221→        yamlStringify(metaManifest),
   222→      );
   223→
   224→      const meta = await loadMetaContext(ctx);
   225→      expect(meta.skills).toHaveLength(3);
   226→
   227→      // Verify _sourceFile is set for all skills
   228→      for (const skill of meta.skills) {
   229→        expect(skill._sourceFile).toBe(path.join(tempDir, 'kynetic.meta.yaml'));
   230→      }
   231→
   232→      // Verify skill data
   233→      const skillOne = meta.skills.find(s => s.id === 'skill-one');
   234→      expect(skillOne).toBeDefined();
   235→      expect(skillOne?.origin).toBe('core');
   236→      expect(skillOne?.version).toBe('0.1.0');
   237→    });
   238→
   239→    it('should return empty skills array when no skills defined', async () => {
   240→      const metaManifest = {
   241→        kynetic_meta: '1.0',
   242→        agents: [],
   243→      };
   244→
   245→      await fs.writeFile(
   246→        path.join(tempDir, 'kynetic.meta.yaml'),
   247→        yamlStringify(metaManifest),
   248→      );
   249→
   250→      const meta = await loadMetaContext(ctx);
   251→      expect(meta.skills).toEqual([]);
   252→    });
   253→  });
   254→
   255→  describe('findMetaItemByRef for skills', () => {
   256→    // AC: @skill-meta-type ac-5
   257→    it('should return skill by semantic id lookup', async () => {
   258→      const skillUlid = testUlid('SKTW01');
   259→      const metaManifest = {
   260→        kynetic_meta: '1.0',
   261→        skills: [
   262→          {
   263→            _ulid: skillUlid,
   264→            id: 'task-work',
   265→            name: 'Task Work',
   266→            origin: 'core',
   267→          },
   268→        ],
   269→      };
   270→
   271→      await fs.writeFile(
   272→        path.join(tempDir, 'kynetic.meta.yaml'),
   273→        yamlStringify(metaManifest),
   274→      );
   275→
   276→      const meta = await loadMetaContext(ctx);
   277→      const found = findMetaItemByRef(meta, 'task-work');
   278→      expect(found).toBeDefined();
   279→      expect('id' in found! && found.id).toBe('task-work');
   280→      expect('origin' in found! && found.origin).toBe('core');
   281→    });
   282→
   283→    // AC: @skill-meta-type ac-6
   284→    it('should return skill by ULID prefix lookup', async () => {
   285→      const skillUlid = testUlid('SKTW02');
   286→      const metaManifest = {
   287→        kynetic_meta: '1.0',
   288→        skills: [
   289→          {
   290→            _ulid: skillUlid,
   291→            id: 'task-work',
   292→            name: 'Task Work',
   293→            origin: 'core',
   294→          },
   295→        ],
   296→      };
   297→
   298→      await fs.writeFile(
   299→        path.join(tempDir, 'kynetic.meta.yaml'),
   300→        yamlStringify(metaManifest),
   301→      );
   302→
   303→      const meta = await loadMetaContext(ctx);
   304→      // Use first 8 chars of the generated ULID as prefix
   305→      const found = findMetaItemByRef(meta, skillUlid.slice(0, 8));
   306→      expect(found).toBeDefined();
   307→      expect('id' in found! && found.id).toBe('task-work');
   308→    });
   309→
   310→    it('should return skill by full ULID', async () => {
   311→      const skillUlid = testUlid('SKTW03');
   312→      const metaManifest = {
   313→        kynetic_meta: '1.0',
   314→        skills: [
   315→          {
   316→            _ulid: skillUlid,
   317→            id: 'task-work',
   318→            name: 'Task Work',
   319→            origin: 'core',
   320→          },
   321→        ],
   322→      };
   323→
   324→      await fs.writeFile(
   325→        path.join(tempDir, 'kynetic.meta.yaml'),
   326→        yamlStringify(metaManifest),
   327→      );
   328→
   329→      const meta = await loadMetaContext(ctx);
   330→      const found = findMetaItemByRef(meta, skillUlid);
   331→      expect(found).toBeDefined();
   332→      expect('id' in found! && found.id).toBe('task-work');
   333→    });
   334→
   335→    it('should return skill with @ prefix', async () => {
   336→      const skillUlid = testUlid('SKTW04');
   337→      const metaManifest = {
   338→        kynetic_meta: '1.0',
   339→        skills: [
   340→          {
   341→            _ulid: skillUlid,
   342→            id: 'task-work',
   343→            name: 'Task Work',
   344→            origin: 'core',
   345→          },
   346→        ],
   347→      };
   348→
   349→      await fs.writeFile(
   350→        path.join(tempDir, 'kynetic.meta.yaml'),
   351→        yamlStringify(metaManifest),
   352→      );
   353→
   354→      const meta = await loadMetaContext(ctx);
   355→      const found = findMetaItemByRef(meta, '@task-work');
   356→      expect(found).toBeDefined();
   357→      expect('id' in found! && found.id).toBe('task-work');
   358→    });
   359→
   360→    it('should return undefined for non-existent ref', async () => {
   361→      const metaManifest = {
   362→        kynetic_meta: '1.0',
   363→        skills: [],
   364→      };
   365→
   366→      await fs.writeFile(
   367→        path.join(tempDir, 'kynetic.meta.yaml'),
   368→        yamlStringify(metaManifest),
   369→      );
   370→
   371→      const meta = await loadMetaContext(ctx);
   372→      const found = findMetaItemByRef(meta, 'nonexistent');
   373→      expect(found).toBeUndefined();
   374→    });
   375→  });
   376→
   377→  describe('getMetaItemType for skills', () => {
   378→    // AC: @skill-meta-type ac-7
   379→    it('should return skill for item with origin field', () => {
   380→      const skill = {
   381→        _ulid: testUlid('SKTYPE'),
   382→        _type: 'skill' as const,
   383→        id: 'test-skill',
   384→        name: 'Test Skill',
   385→        origin: 'core' as const,
   386→        tags: [],
   387→      };
   388→
   389→      const itemType = getMetaItemType(skill);
   390→      expect(itemType).toBe('skill');
   391→    });
   392→
   393→    it('should correctly discriminate skill from other meta types', () => {
   394→      const agent = {
   395→        _ulid: testUlid('AGTYPE'),
   396→        id: 'test-agent',
   397→        name: 'Test Agent',
   398→        capabilities: [],
   399→        tools: [],
   400→        conventions: [],
   401→      };
   402→
   403→      const workflow = {
   404→        _ulid: testUlid('WFTYPE'),
   405→        id: 'test-workflow',
   406→        trigger: 'on command',
   407→        steps: [],
   408→      };
   409→
   410→      const convention = {
   411→        _ulid: testUlid('CVTYPE'),
   412→        domain: 'test-convention',
   413→        rules: [],
   414→        examples: [],
   415→      };
   416→
   417→      const observation = {
   418→        _ulid: testUlid('OBTYPE'),
   419→        type: 'friction' as const,
   420→        content: 'Test observation',
   421→        created_at: new Date().toISOString(),
   422→        resolved: false,
   423→      };
   424→
   425→      const skill = {
   426→        _ulid: testUlid('SKTYPE'),
   427→        _type: 'skill' as const,
   428→        id: 'test-skill',
   429→        name: 'Test Skill',
   430→        origin: 'core' as const,
   431→        tags: [],
   432→      };
   433→
   434→      expect(getMetaItemType(agent)).toBe('agent');
   435→      expect(getMetaItemType(workflow)).toBe('workflow');
   436→      expect(getMetaItemType(convention)).toBe('convention');
   437→      expect(getMetaItemType(observation)).toBe('observation');
   438→      expect(getMetaItemType(skill)).toBe('skill');
   439→    });
   440→  });
   441→
   442→  describe('isSkill type guard', () => {
   443→    // AC: @skill-type-guard ac-1 - isSkill returns true for skill items
   444→    it('should return true for items with _type: skill', () => {
   445→      const skill = {
   446→        _ulid: testUlid('SKGARD'),
   447→        _type: 'skill' as const,
   448→        id: 'test-skill',
   449→        name: 'Test Skill',
   450→        origin: 'core' as const,
   451→        tags: [],
   452→      };
   453→
   454→      expect(isSkill(skill)).toBe(true);
   455→    });
   456→
   457→    // AC: @skill-type-guard ac-2 - isSkill returns false for non-skill items
   458→    it('should return false for items without _type: skill', () => {
   459→      const agent = {
   460→        _ulid: testUlid('AGSKIP'),
   461→        id: 'test-agent',
   462→        name: 'Test Agent',
   463→        capabilities: [],
   464→        tools: [],
   465→        conventions: [],
   466→      };
   467→
   468→      const workflow = {
   469→        _ulid: testUlid('WFSKIP'),
   470→        id: 'test-workflow',
   471→        trigger: 'on command',
   472→        steps: [],
   473→      };
   474→
   475→      const convention = {
   476→        _ulid: testUlid('CVSKIP'),
   477→        domain: 'test-convention',
   478→        rules: [],
   479→        examples: [],
   480→      };
   481→
   482→      const observation = {
   483→        _ulid: testUlid('OBSKIP'),
   484→        type: 'friction' as const,
   485→        content: 'Test observation',
   486→        created_at: new Date().toISOString(),
   487→        resolved: false,
   488→      };
   489→
   490→      expect(isSkill(agent)).toBe(false);
   491→      expect(isSkill(workflow)).toBe(false);
   492→      expect(isSkill(convention)).toBe(false);
   493→      expect(isSkill(observation)).toBe(false);
   494→    });
   495→
   496→    // AC: @skill-type-guard ac-3 - isSkill handles edge cases safely
   497→    it('should handle edge cases safely', () => {
   498→      expect(isSkill(null)).toBe(false);
   499→      expect(isSkill(undefined)).toBe(false);
   500→      expect(isSkill('string')).toBe(false);
   501→      expect(isSkill(123)).toBe(false);
   502→      expect(isSkill({})).toBe(false);
   503→      expect(isSkill({ _type: 'agent' })).toBe(false);
   504→      expect(isSkill({ _type: 'observation' })).toBe(false);
   505→    });
   506→
   507→    // AC: @skill-type-guard ac-4 - isSkill works with parsed schema data
   508→    it('should work with SkillSchema.parse() output', () => {
   509→      const skillData = {
   510→        _ulid: testUlid('SKSHEM'),
   511→        id: 'schema-test',
   512→        name: 'Schema Test Skill',
   513→        origin: 'project' as const,
   514→      };
   515→
   516→      const parsed = SkillSchema.parse(skillData);
   517→      expect(isSkill(parsed)).toBe(true);
   518→      expect(parsed._type).toBe('skill');
   519→    });
   520→
   521→    // AC: @skill-type-guard ac-5 - backward compatibility with origin field
   522→    it('should correctly identify skill items that have origin but were parsed through schema', () => {
   523→      // Items without _type but with origin need to be parsed through schema to get _type
   524→      const rawSkillData = {
   525→        _ulid: testUlid('SKBACK'),
   526→        id: 'backward-compat',
   527→        name: 'Backward Compatible Skill',
   528→        origin: 'local' as const,
   529→        // No _type field - simulating old YAML file
   530→      };
   531→
   532→      // Before parsing, isSkill returns false (no _type)
   533→      expect(isSkill(rawSkillData)).toBe(false);
   534→
   535→      // After parsing through schema, isSkill returns true
   536→      const parsed = SkillSchema.parse(rawSkillData);
   537→      expect(isSkill(parsed)).toBe(true);
   538→      expect(parsed._type).toBe('skill');
   539→    });
   540→  });
   541→});
   542→

