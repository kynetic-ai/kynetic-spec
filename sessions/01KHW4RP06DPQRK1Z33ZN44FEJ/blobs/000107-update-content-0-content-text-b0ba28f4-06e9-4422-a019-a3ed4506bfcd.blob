```
     1→/**
     2→ * Agent instruction generation commands.
     3→ *
     4→ * AC: @agent-instruction-gen ac-1 - kspec agents generate creates kspec-agents.md in project root
     5→ * AC: @agent-instruction-gen ac-2 - output includes Finding Information table with row per skill
     6→ * AC: @agent-instruction-gen ac-3 - output includes conventions section listing rules by domain
     7→ * AC: @agent-instruction-gen ac-4 - output contains freshness comment with kspec version and timestamp
     8→ * AC: @agent-instruction-gen ac-5 - kspec agents status reports stale when not regenerated after meta changes
     9→ *
    10→ * AC: @agents-cli ac-1 - kspec agents generate writes kspec-agents.md to project root
    11→ * AC: @agents-cli ac-2 - kspec agents generate --dry-run prints content without writing
    12→ * AC: @agents-cli ac-3 - kspec agents status reports up to date when current
    13→ * AC: @agents-cli ac-4 - kspec agents status reports stale when meta changed
    14→ *
    15→ * AC: @agent-templates ac-1 - template sections included in output in defined order
    16→ * AC: @agent-templates ac-2 - each template section appears in generated output
    17→ * AC: @agent-templates ac-3 - error if template directory missing or empty
    18→ */
    19→
    20→import * as crypto from "node:crypto";
    21→import * as fs from "node:fs/promises";
    22→import { createRequire } from "node:module";
    23→import * as path from "node:path";
    24→import { fileURLToPath } from "node:url";
    25→import chalk from "chalk";
    26→import type { Command } from "commander";
    27→import {
    28→  generateConventionsSummary,
    29→  generateSkillsTable,
    30→  generateWorkflowsSummary,
    31→  initContext,
    32→  loadMetaContext,
    33→  type LoadedConvention,
    34→  type LoadedSkill,
    35→  type LoadedWorkflow,
    36→} from "../../parser/index.js";
    37→import { errors } from "../../strings/errors.js";
    38→import { EXIT_CODES } from "../exit-codes.js";
    39→import { error, output, success } from "../output.js";
    40→
    41→const __filename = fileURLToPath(import.meta.url);
    42→const __dirname = path.dirname(__filename);
    43→
    44→// Read version from package.json at runtime
    45→const require = createRequire(import.meta.url);
    46→const { version } = require("../../../package.json");
    47→
    48→/**
    49→ * File name for generated agent instructions
    50→ */
    51→const GENERATED_FILE_NAME = "kspec-agents.md";
    52→
    53→/**
    54→ * Hash file name for tracking freshness
    55→ */
    56→const HASH_FILE_NAME = ".kspec-agents-hash";
    57→
    58→/**
    59→ * Templates directory name relative to package root
    60→ */
    61→const TEMPLATES_DIR = "templates/agents-sections";
    62→
    63→/**
    64→ * Compute SHA256 hash of content
    65→ */
    66→function computeHash(content: string): string {
    67→  return crypto.createHash("sha256").update(content, "utf-8").digest("hex");
    68→}
    69→
    70→/**
    71→ * Load template sections from the templates directory.
    72→ * AC: @agent-templates ac-1 - all template sections included in defined order
    73→ * AC: @agent-templates ac-3 - error if directory missing or empty
    74→ */
    75→export async function loadTemplateSections(packageRoot: string): Promise<string[]> {
    76→  const templatesPath = path.join(packageRoot, TEMPLATES_DIR);
    77→
    78→  // Check if templates directory exists
    79→  try {
    80→    await fs.access(templatesPath);
    81→  } catch {
    82→    throw new Error(
    83→      `Templates directory not found at: ${templatesPath}. ` +
    84→        `Expected templates/agents-sections/ directory with section markdown files.`,
    85→    );
    86→  }
    87→
    88→  // Read directory contents
    89→  const entries = await fs.readdir(templatesPath, { withFileTypes: true });
    90→  const mdFiles = entries
    91→    .filter((e) => e.isFile() && e.name.endsWith(".md"))
    92→    .map((e) => e.name)
    93→    .sort(); // Sort to ensure consistent ordering by filename prefix
    94→
    95→  if (mdFiles.length === 0) {
    96→    throw new Error(
    97→      `Templates directory is empty: ${templatesPath}. ` +
    98→        `Expected markdown files for agent instruction sections.`,
    99→    );
   100→  }
   101→
   102→  // Load each template in order
   103→  const sections: string[] = [];
   104→  for (const filename of mdFiles) {
   105→    const filePath = path.join(templatesPath, filename);
   106→    const content = await fs.readFile(filePath, "utf-8");
   107→    sections.push(content.trim());
   108→  }
   109→
   110→  return sections;
   111→}
   112→
   113→/**
   114→ * Get the package root directory (where templates/ is located)
   115→ */
   116→export function getPackageRoot(): string {
   117→  // Navigate from dist/cli/commands/ to package root
   118→  return path.resolve(__dirname, "..", "..", "..");
   119→}
   120→
   121→/**
   122→ * Generate a hash of the meta content that affects the generated file.
   123→ * This is used to detect if the generated file is stale.
   124→ */
   125→export function computeMetaHash(
   126→  skills: LoadedSkill[],
   127→  conventions: LoadedConvention[],
   128→  workflows: LoadedWorkflow[],
   129→  templateSections?: string[],
   130→): string {
   131→  // Create a stable representation of the meta content
   132→  // AC: @cross-platform-and-version-robustness ac-4 - includes templates for staleness detection
   133→  const data: Record<string, unknown> = {
   134→    skills: skills.map((s) => ({
   135→      id: s.id,
   136→      name: s.name,
   137→      description: s.description,
   138→    })),
   139→    conventions: conventions.map((c) => ({
   140→      domain: c.domain,
   141→      rules: c.rules,
   142→      examples: (c.examples ?? []).map((e) => ({ good: e.good, bad: e.bad })),
   143→    })),
   144→    workflows: workflows.map((w) => ({
   145→      id: w.id,
   146→      trigger: w.trigger,
   147→      description: w.description,
   148→    })),
   149→  };
   150→  if (templateSections && templateSections.length > 0) {
   151→    data.templates = templateSections;
   152→  }
   153→  return computeHash(JSON.stringify(data));
   154→}
   155→
   156→/**
   157→ * Generate the freshness comment.
   158→ * AC: @agent-instruction-gen ac-4 - freshness comment with kspec version and timestamp
   159→ */
   160→function generateFreshnessComment(timestamp: string): string {
   161→  return `<!-- Generated by kspec v${version} at ${timestamp} -->\n<!-- Do not edit manually - regenerate with: kspec agents generate -->\n\n`;
   162→}
   163→
   164→/**
   165→ * Generate the full kspec-agents.md content
   166→ * AC: @agent-templates ac-1 - template sections included in output in defined order
   167→ * AC: @agent-templates ac-2 - each template section appears in generated output
   168→ */
   169→export async function generateAgentsContent(
   170→  skills: LoadedSkill[],
   171→  conventions: LoadedConvention[],
   172→  workflows: LoadedWorkflow[],
   173→  timestamp: string,
   174→  templateSections: string[],
   175→): Promise<string> {
   176→  const sections: string[] = [];
   177→
   178→  // AC: @agent-instruction-gen ac-4 - freshness comment
   179→  sections.push(generateFreshnessComment(timestamp));
   180→
   181→  // Header
   182→  sections.push("# kspec Agent Instructions\n");
   183→  sections.push(
   184→    "This file is auto-generated from kspec meta. Include it in your AGENTS.md or similar agent instruction file.\n\n",
   185→  );
   186→
   187→  // AC: @agent-instruction-gen ac-2 - Skills table
   188→  const skillsTable = generateSkillsTable(skills);
   189→  if (skillsTable) {
   190→    sections.push(skillsTable);
   191→  }
   192→
   193→  // AC: @agent-instruction-gen ac-3 - Conventions section
   194→  const conventionsSection = generateConventionsSummary(conventions);
   195→  if (conventionsSection) {
   196→    sections.push(conventionsSection);
   197→  }
   198→
   199→  // Workflows summary
   200→  const workflowsSection = generateWorkflowsSummary(workflows);
   201→  if (workflowsSection) {
   202→    sections.push(workflowsSection);
   203→  }
   204→
   205→  // AC: @agent-templates ac-1, ac-2 - Include template sections in order
   206→  if (templateSections.length > 0) {
   207→    sections.push("\n");
   208→    for (const section of templateSections) {
   209→      sections.push(section);
   210→      sections.push("\n\n");
   211→    }
   212→  }
   213→
   214→  return sections.join("");
   215→}
   216→
   217→/**
   218→ * Result of checking agent file status
   219→ */
   220→interface AgentStatusResult {
   221→  exists: boolean;
   222→  path: string;
   223→  status: "current" | "stale" | "missing";
   224→  metaHash?: string;
   225→  storedHash?: string;
   226→  generatedAt?: string;
   227→}
   228→
   229→/**
   230→ * Check the status of the generated agent file.
   231→ * AC: @agent-instruction-gen ac-5 - reports stale when meta has changed
   232→ */
   233→async function checkAgentStatus(
   234→  projectRoot: string,
   235→  metaHash: string,
   236→): Promise<AgentStatusResult> {
   237→  const filePath = path.join(projectRoot, GENERATED_FILE_NAME);
   238→  const hashPath = path.join(projectRoot, ".kspec", HASH_FILE_NAME);
   239→
   240→  // Check if file exists
   241→  try {
   242→    await fs.access(filePath);
   243→  } catch {
   244→    return {
   245→      exists: false,
   246→      path: filePath,
   247→      status: "missing",
   248→      metaHash,
   249→    };
   250→  }
   251→
   252→  // Check stored hash
   253→  let storedHash: string | undefined;
   254→  let generatedAt: string | undefined;
   255→
   256→  try {
   257→    const hashContent = await fs.readFile(hashPath, "utf-8");
   258→    const hashData = JSON.parse(hashContent);
   259→    storedHash = hashData.metaHash;
   260→    generatedAt = hashData.generatedAt;
   261→  } catch {
   262→    // No hash file, treat as stale
   263→    return {
   264→      exists: true,
   265→      path: filePath,
   266→      status: "stale",
   267→      metaHash,
   268→    };
   269→  }
   270→
   271→  // Compare hashes
   272→  const isCurrent = storedHash === metaHash;
   273→
   274→  return {
   275→    exists: true,
   276→    path: filePath,
   277→    status: isCurrent ? "current" : "stale",
   278→    metaHash,
   279→    storedHash,
   280→    generatedAt,
   281→  };
   282→}
   283→
   284→/**
   285→ * Register agent instruction generation commands
   286→ */
   287→export function registerAgentsCommands(program: Command): void {
   288→  const agents = program
   289→    .command("agents")
   290→    .description("Agent instruction generation commands");
   291→
   292→  // AC: @agent-instruction-gen ac-1 - kspec agents generate
   293→  // AC: @agent-templates ac-3 - error if template directory missing
   294→  // AC: @trait-dry-run ac-1 through ac-6 - dry-run support
   295→  agents
   296→    .command("generate")
   297→    .description("Generate kspec-agents.md from meta (skills, conventions, workflows)")
   298→    .option("--dry-run", "Show what would be generated without writing files")
   299→    .action(async (options) => {
   300→      try {
   301→        const ctx = await initContext();
   302→
   303→        if (!ctx.manifestPath) {
   304→          error(errors.project.noKspecProject);
   305→          process.exit(EXIT_CODES.ERROR);
   306→        }
   307→
   308→        // AC: @agent-templates ac-3 - error if templates missing
   309→        const packageRoot = getPackageRoot();
   310→        let templateSections: string[];
   311→        try {
   312→          templateSections = await loadTemplateSections(packageRoot);
   313→        } catch (err) {
   314→          const message =
   315→            err instanceof Error ? err.message : "Unknown error loading templates";
   316→          error(message, {
   317→            suggestion: `Verify that ${TEMPLATES_DIR}/ exists with markdown files.`,
   318→          });
   319→          process.exit(EXIT_CODES.ERROR);
   320→        }
   321→
   322→        const metaCtx = await loadMetaContext(ctx);
   323→        const dryRun = options.dryRun || false;
   324→        const timestamp = new Date().toISOString();
   325→
   326→        // Generate content - now async due to template loading
   327→        const content = await generateAgentsContent(
   328→          metaCtx.skills,
   329→          metaCtx.conventions,
   330→          metaCtx.workflows,
   331→          timestamp,
   332→          templateSections,
   333→        );
   334→
   335→        // Compute meta hash for freshness tracking (includes templates)
   336→        const metaHash = computeMetaHash(
   337→          metaCtx.skills,
   338→          metaCtx.conventions,
   339→          metaCtx.workflows,
   340→          templateSections,
   341→        );
   342→
   343→        const outputPath = path.join(ctx.rootDir, GENERATED_FILE_NAME);
   344→        const hashPath = path.join(ctx.rootDir, ".kspec", HASH_FILE_NAME);
   345→
   346→        // AC: @trait-dry-run ac-3 - clear indication this is a preview
   347→        if (dryRun) {
   348→          output(
   349→            {
   350→              dry_run: true,
   351→              path: outputPath,
   352→              skills: metaCtx.skills.length,
   353→              conventions: metaCtx.conventions.length,
   354→              workflows: metaCtx.workflows.length,
   355→              templates: templateSections.length,
   356→              content,
   357→            },
   358→            () => {
   359→              console.log(chalk.yellow("DRY RUN - No changes made"));
   360→              console.log();
   361→              console.log(chalk.gray(`Would write to: ${outputPath}`));
   362→              console.log();
   363→              console.log(chalk.gray("--- Generated content ---"));
   364→              console.log(content);
   365→              console.log(chalk.gray("--- End content ---"));
   366→              console.log();
   367→              console.log(
   368→                chalk.yellow("No changes were made. Run without --dry-run to apply."),
   369→              );
   370→            },
   371→          );
   372→          return;
   373→        }
   374→
   375→        // AC: @trait-dry-run ac-2 - no files modified in dry run mode
   376→        // Write the generated file
   377→        await fs.writeFile(outputPath, content, "utf-8");
   378→
   379→        // Write the hash file for freshness tracking
   380→        await fs.mkdir(path.dirname(hashPath), { recursive: true });
   381→        await fs.writeFile(
   382→          hashPath,
   383→          JSON.stringify(
   384→            {
   385→              metaHash,
   386→              generatedAt: timestamp,
   387→              version,
   388→            },
   389→            null,
   390→            2,
   391→          ),
   392→          "utf-8",
   393→        );
   394→
   395→        output(
   396→          {
   397→            path: outputPath,
   398→            skills: metaCtx.skills.length,
   399→            conventions: metaCtx.conventions.length,
   400→            workflows: metaCtx.workflows.length,
   401→            templates: templateSections.length,
   402→            generatedAt: timestamp,
   403→          },
   404→          () => {
   405→            success(`Generated ${GENERATED_FILE_NAME}`, {
   406→              skills: metaCtx.skills.length,
   407→              conventions: metaCtx.conventions.length,
   408→              workflows: metaCtx.workflows.length,
   409→              templates: templateSections.length,
   410→            });
   411→            console.log(chalk.gray(`  Path: ${outputPath}`));
   412→          },
   413→        );
   414→      } catch (err) {
   415→        error("Failed to generate agent instructions", err);
   416→        process.exit(EXIT_CODES.ERROR);
   417→      }
   418→    });
   419→
   420→  // AC: @agent-instruction-gen ac-5 - kspec agents status
   421→  agents
   422→    .command("status")
   423→    .description("Check if kspec-agents.md is up to date with meta")
   424→    .action(async () => {
   425→      try {
   426→        const ctx = await initContext();
   427→
   428→        if (!ctx.manifestPath) {
   429→          error(errors.project.noKspecProject);
   430→          process.exit(EXIT_CODES.ERROR);
   431→        }
   432→
   433→        const metaCtx = await loadMetaContext(ctx);
   434→
   435→        // Load templates for hash computation
   436→        let templateSections: string[] = [];
   437→        try {
   438→          templateSections = await loadTemplateSections(getPackageRoot());
   439→        } catch (_err) {
   440→          // Templates may not exist in all environments
   441→        }
   442→
   443→        // Compute current meta hash (includes templates)
   444→        const metaHash = computeMetaHash(
   445→          metaCtx.skills,
   446→          metaCtx.conventions,
   447→          metaCtx.workflows,
   448→          templateSections,
   449→        );
   450→
   451→        const status = await checkAgentStatus(ctx.rootDir, metaHash);
   452→
   453→        output(status, () => {
   454→          switch (status.status) {
   455→            case "missing":
   456→              console.log(chalk.yellow(`${GENERATED_FILE_NAME} does not exist`));
   457→              console.log();
   458→              console.log(
   459→                chalk.gray("Run 'kspec agents generate' to create it."),
   460→              );
   461→              break;
   462→
   463→            case "stale":
   464→              console.log(
   465→                chalk.yellow(`${GENERATED_FILE_NAME} is stale`),
   466→              );
   467→              console.log();
   468→              console.log(
   469→                chalk.gray(
   470→                  "Meta has changed since the file was generated.",
   471→                ),
   472→              );
   473→              console.log(
   474→                chalk.gray("Run 'kspec agents generate' to regenerate."),
   475→              );
   476→              break;
   477→
   478→            case "current":
   479→              console.log(chalk.green(`${GENERATED_FILE_NAME} is up to date`));
   480→              if (status.generatedAt) {
   481→                console.log(chalk.gray(`  Generated: ${status.generatedAt}`));
   482→              }
   483→              break;
   484→          }
   485→        });
   486→      } catch (err) {
   487→        error("Failed to check agent status", err);
   488→        process.exit(EXIT_CODES.ERROR);
   489→      }
   490→    });
   491→}
