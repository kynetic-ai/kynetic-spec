     1→/**
     2→ * Skill render, status, diff, and verify commands.
     3→ *
     4→ * AC: @skill-rendering ac-1 through ac-5 - kspec skill render
     5→ * AC: @skill-render-cli ac-1 through ac-4 - render/status/diff CLI
     6→ * AC: @skill-drift-detection ac-3, ac-4 - drift handling with --force
     7→ * AC: @multi-platform-render-cli ac-1 through ac-7 - multi-platform rendering
     8→ * AC: @skill-drift-detection-improvements ac-2 - kspec skill verify
     9→ */
    10→
    11→import * as fs from "node:fs/promises";
    12→import * as path from "node:path";
    13→import chalk from "chalk";
    14→import Table from "cli-table3";
    15→import { createTwoFilesPatch } from "diff";
    16→import type { Command } from "commander";
    17→import {
    18→  findMetaItemByRef,
    19→  initContext,
    20→  isSkill,
    21→  loadMetaContext,
    22→  loadSkillContent,
    23→  type LoadedSkill,
    24→  type KspecContext,
    25→} from "../../parser/index.js";
    26→import {
    27→  isKspecManagedSkill as isKspecManaged,
    28→  KSPEC_MANAGED_MARKER,
    29→  generateFrontmatter,
    30→  getRenderer,
    31→  getAllRenderers,
    32→  contentsEqual,
    33→  directoriesEqual,
    34→  type PlatformRenderer,
    35→  type DriftStatus,
    36→} from "../../parser/skill-render.js";
    37→import { errors } from "../../strings/errors.js";
    38→import { EXIT_CODES } from "../exit-codes.js";
    39→import { error, output, success } from "../output.js";
    40→
    41→// ============================================================================
    42→// Types
    43→// ============================================================================
    44→
    45→/**
    46→ * Result of rendering a single skill to a platform
    47→ * AC: @multi-platform-render-cli ac-6 - Includes platform field
    48→ */
    49→interface MultiPlatformRenderResult {
    50→  id: string;
    51→  platform: string;
    52→  action: "created" | "updated" | "unchanged" | "skipped";
    53→  path: string;
    54→  /** Reason why skill was skipped */
    55→  skipReason?: string;
    56→}
    57→
    58→/**
    59→ * Result of a clean operation
    60→ * AC: @multi-platform-render-cli ac-5 - Includes platform field
    61→ */
    62→interface CleanResult {
    63→  id: string;
    64→  path: string;
    65→  action: "removed" | "skipped";
    66→  reason?: string;
    67→  /** Platform this clean result is for */
    68→  platform?: string;
    69→}
    70→
    71→/**
    72→ * Result of checking a skill's sync status for a specific platform
    73→ * AC: @multi-platform-render-cli ac-3
    74→ */
    75→interface MultiPlatformStatusResult {
    76→  id: string;
    77→  platform: string;
    78→  status: "in-sync" | "drifted" | "not-rendered";
    79→  docsStatus?: "in-sync" | "drifted" | "not-rendered" | "no-docs";
    80→  warning?: string;
    81→}
    82→
    83→// ============================================================================
    84→// Helpers
    85→// ============================================================================
    86→
    87→/**
    88→ * Get the sync status of a skill for a specific platform
    89→ * AC: @multi-platform-render-cli ac-3 - Per-platform status checking
    90→ */
    91→async function getMultiPlatformSyncStatus(
    92→  ctx: KspecContext,
    93→  projectRoot: string,
    94→  skill: LoadedSkill,
    95→  renderer: PlatformRenderer
    96→): Promise<MultiPlatformStatusResult> {
    97→  // Use the renderer's drift check
    98→  const driftStatus = await renderer.checkDrift(ctx.specDir, projectRoot, skill.id);
    99→
   100→  // Map drift status to sync status
   101→  let status: "in-sync" | "drifted" | "not-rendered";
   102→  switch (driftStatus) {
   103→    case "in-sync":
   104→      status = "in-sync";
   105→      break;
   106→    case "drifted":
   107→      status = "drifted";
   108→      break;
   109→    case "not-rendered":
   110→      status = "not-rendered";
   111→      break;
   112→    case "no-hash":
   113→      // No hash stored - need to check if content matches expected
   114→      const renderedPath = path.join(
   115→        projectRoot,
   116→        renderer.defaultOutputDir,
   117→        skill.id,
   118→        "SKILL.md"
   119→      );
   120→      try {
   121→        await fs.readFile(renderedPath, "utf-8");
   122→        // File exists but no hash - treat as needing sync
   123→        status = "drifted";
   124→      } catch {
   125→        status = "not-rendered";
   126→      }
   127→      break;
   128→  }
   129→
   130→  // Check docs status for this platform
   131→  const sourceDocsDir = path.join(ctx.specDir, "skills", skill.id, "docs");
   132→  const targetDocsDir = path.join(projectRoot, renderer.defaultOutputDir, skill.id, "docs");
   133→  let docsStatus: "in-sync" | "drifted" | "not-rendered" | "no-docs" = "no-docs";
   134→
   135→  try {
   136→    await fs.stat(sourceDocsDir);
   137→    // Source docs exist, check target
   138→    try {
   139→      await fs.stat(targetDocsDir);
   140→      // Both exist, compare
   141→      const equal = await directoriesEqual(sourceDocsDir, targetDocsDir);
   142→      docsStatus = equal ? "in-sync" : "drifted";
   143→    } catch {
   144→      docsStatus = "not-rendered";
   145→    }
   146→  } catch {
   147→    // No source docs
   148→    docsStatus = "no-docs";
   149→  }
   150→
   151→  return {
   152→    id: skill.id,
   153→    platform: renderer.platform,
   154→    status,
   155→    docsStatus,
   156→  };
   157→}
   158→
   159→/**
   160→ * Get the expected rendered content for a skill
   161→ */
   162→export async function getExpectedRenderedContent(
   163→  ctx: KspecContext,
   164→  skill: LoadedSkill
   165→): Promise<string> {
   166→  const sourceContent = await loadSkillContent(ctx, skill);
   167→
   168→  if (!sourceContent) {
   169→    // No source content, generate placeholder
   170→    const frontmatter = generateFrontmatter(skill);
   171→    return `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
   172→  }
   173→
   174→  // Generate rendered content with frontmatter and marker
   175→  const frontmatter = generateFrontmatter(skill);
   176→
   177→  // Check if source already has frontmatter - if so, strip it
   178→  const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
   179→  const contentWithoutFrontmatter = frontmatterMatch
   180→    ? sourceContent.slice(frontmatterMatch[0].length)
   181→    : sourceContent;
   182→
   183→  return `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
   184→}
   185→
   186→/**
   187→ * Generate unified diff between two strings.
   188→ * Uses the 'diff' library for correct LCS-based diffing.
   189→ * AC: @skill-render-cli ac-4
   190→ * AC: @guard-script-and-diff-quality ac-2
   191→ */
   192→export function generateUnifiedDiff(
   193→  actual: string,
   194→  expected: string,
   195→  actualPath: string,
   196→  expectedPath: string
   197→): string[] {
   198→  if (contentsEqual(actual, expected)) {
   199→    return [];
   200→  }
   201→
   202→  const patch = createTwoFilesPatch(actualPath, expectedPath, actual, expected, "", "", {
   203→    context: 3,
   204→  });
   205→
   206→  // Split into lines and remove the first line (Index: ...) which createTwoFilesPatch adds
   207→  const lines = patch.split("\n");
   208→  // createTwoFilesPatch outputs: "Index: ...\n===...\n--- ...\n+++ ...\n@@ ... @@\n..."
   209→  // Skip the "Index:" and "===" header lines to match our expected format
   210→  const startIdx = lines.findIndex((l) => l.startsWith("---"));
   211→  if (startIdx === -1) return [];
   212→
   213→  // Remove trailing empty line that createTwoFilesPatch adds
   214→  const result = lines.slice(startIdx);
   215→  if (result.length > 0 && result[result.length - 1] === "") {
   216→    result.pop();
   217→  }
   218→
   219→  return result;
   220→}
   221→
   222→// ============================================================================
   223→// Command Registration
   224→// ============================================================================
   225→
   226→/**
   227→ * Register render/status/diff/verify skill commands
   228→ */
   229→export function registerSkillDiffCommands(skill: Command): void {
   230→  // AC: @skill-rendering ac-1 through ac-5 - kspec skill render
   231→  // AC: @skill-render-cli ac-1, ac-2 - kspec skill render / kspec skill render @skill-id
   232→  // AC: @skill-drift-detection ac-3, ac-4 - drift handling with --force
   233→  // AC: @multi-platform-render-cli ac-1 through ac-7 - multi-platform rendering
   234→  // AC: @trait-dry-run - supports --dry-run
   235→  // AC: @trait-error-guidance - provides error guidance
   236→  skill
   237→    .command("render [ref]")
   238→    .description(
   239→      "Render skills from shadow branch to platform-specific files on main branch"
   240→    )
   241→    .option("--clean", "Remove orphaned managed skill directories")
   242→    .option("--dry-run", "Show what would be changed without applying")
   243→    .option("--force", "Overwrite drifted skill files (manually edited)")
   244→    .option("--output-dir <path>", "Custom output directory (overrides platform default)")
   245→    .option("--skill <id>", "Render only a specific skill (deprecated, use positional arg)")
   246→    .action(async (ref: string | undefined, options) => {
   247→      try {
   248→        const ctx = await initContext();
   249→
   250→        if (!ctx.manifestPath) {
   251→          error(errors.project.noKspecProject);
   252→          console.log(
   253→            chalk.gray("Try: kspec init to initialize a kspec project")
   254→          );
   255→          process.exit(EXIT_CODES.ERROR);
   256→        }
   257→
   258→        const metaCtx = await loadMetaContext(ctx);
   259→        // Use rootDir (project root), not specDir (which is .kspec/ in shadow mode)
   260→        const projectRoot = ctx.rootDir;
   261→        const dryRun = options.dryRun || false;
   262→        const force = options.force || false;
   263→        const customOutputDir = options.outputDir;
   264→        const results: MultiPlatformRenderResult[] = [];
   265→        const cleanResults: CleanResult[] = [];
   266→        const warnings: string[] = [];
   267→
   268→        // Get all skills (no platform filtering - we'll check per-platform)
   269→        let skillsToRender = metaCtx.skills;
   270→
   271→        // AC: @skill-render-cli ac-2 - Filter to specific skill if requested
   272→        // Support both positional ref argument and --skill option
   273→        const skillRef = ref || options.skill;
   274→        if (skillRef) {
   275→          // Resolve the ref to a skill (uses _type discriminant)
   276→          const item = findMetaItemByRef(metaCtx, skillRef);
   277→          if (!item || !isSkill(item)) {
   278→            error(`Skill not found: ${skillRef}`);
   279→            console.log(chalk.gray("Try: kspec skill list"));
   280→            process.exit(EXIT_CODES.NOT_FOUND);
   281→          }
   282→          const skill = item as LoadedSkill;
   283→          skillsToRender = skillsToRender.filter((s) => s.id === skill.id);
   284→        }
   285→
   286→        // Track which platforms we're using to create output directories and for clean
   287→        const usedPlatforms = new Set<string>();
   288→
   289→        // AC: @multi-platform-render-cli ac-1, ac-2 - Render each skill to each of its platforms
   290→        for (const skill of skillsToRender) {
   291→          for (const platform of skill.platforms) {
   292→            // Get the renderer for this platform
   293→            const renderer = getRenderer(platform);
   294→
   295→            // AC: @multi-platform-render-cli ac-7 - Warn for unregistered platforms
   296→            if (!renderer) {
   297→              warnings.push(`${skill.id}: unregistered platform '${platform}' (skipped)`);
   298→              results.push({
   299→                id: skill.id,
   300→                platform,
   301→                action: "skipped",
   302→                path: "",
   303→                skipReason: `unregistered platform '${platform}'`,
   304→              });
   305→              continue;
   306→            }
   307→
   308→            usedPlatforms.add(platform);
   309→
   310→            // Determine output directory
   311→            const outputDir = customOutputDir || renderer.defaultOutputDir;
   312→
   313→            // Ensure output directory exists
   314→            const targetSkillsDir = path.join(projectRoot, outputDir);
   315→            if (!dryRun) {
   316→              await fs.mkdir(targetSkillsDir, { recursive: true });
   317→            }
   318→
   319→            // Check for drift before rendering
   320→            // AC: @skill-drift-detection ac-3, ac-4 - Check drift and skip without --force
   321→            const driftStatus = await renderer.checkDrift(
   322→              ctx.specDir,
   323→              projectRoot,
   324→              skill.id,
   325→              { outputDir: customOutputDir }
   326→            );
   327→
   328→            // AC: @skill-drift-detection ac-3 - Skip drifted skills without --force
   329→            if (driftStatus === "drifted" && !force) {
   330→              const renderedPath = path.join(
   331→                projectRoot,
   332→                outputDir,
   333→                skill.id,
   334→                "SKILL.md"
   335→              );
   336→              results.push({
   337→                id: skill.id,
   338→                platform,
   339→                action: "skipped",
   340→                path: renderedPath,
   341→                skipReason: "drifted (use --force to overwrite)",
   342→              });
   343→              continue;
   344→            }
   345→
   346→            // AC: @skill-drift-detection ac-4 - Render (overwrite) when --force is used
   347→            // AC: @multi-platform-render-cli ac-4 - Pass custom outputDir to renderer
   348→            const result = await renderer.render(ctx, projectRoot, skill, {
   349→              dryRun,
   350→              storeHash: true,
   351→              outputDir: customOutputDir,
   352→            });
   353→
   354→            results.push({
   355→              id: result.id,
   356→              platform: result.platform,
   357→              action: result.action,
   358→              path: result.paths[0] || "",
   359→              skipReason: result.skipReason,
   360→            });
   361→          }
   362→        }
   363→
   364→        // Handle --clean: remove orphaned managed skills per platform
   365→        // AC: @skill-rendering ac-4, ac-5
   366→        // AC: @multi-platform-render-cli ac-5 - Per-platform cleanup
   367→        if (options.clean) {
   368→          // Build set of active skill IDs per platform
   369→          const activeSkillIdsByPlatform = new Map<string, Set<string>>();
   370→          for (const skill of metaCtx.skills) {
   371→            for (const platform of skill.platforms) {
   372→              if (!activeSkillIdsByPlatform.has(platform)) {
   373→                activeSkillIdsByPlatform.set(platform, new Set());
   374→              }
   375→              activeSkillIdsByPlatform.get(platform)!.add(skill.id);
   376→            }
   377→          }
   378→
   379→          // Clean each platform's output directory
   380→          const renderers = getAllRenderers();
   381→          for (const renderer of renderers) {
   382→            const outputDir = customOutputDir || renderer.defaultOutputDir;
   383→            const targetSkillsDir = path.join(projectRoot, outputDir);
   384→            const activeIds = activeSkillIdsByPlatform.get(renderer.platform) || new Set();
   385→
   386→            try {
   387→              const entries = await fs.readdir(targetSkillsDir, {
   388→                withFileTypes: true,
   389→              });
   390→
   391→              for (const entry of entries) {
   392→                if (!entry.isDirectory()) continue;
   393→
   394→                const skillId = entry.name;
   395→                const skillDir = path.join(targetSkillsDir, skillId);
   396→                const skillMdPath = path.join(skillDir, "SKILL.md");
   397→
   398→                // Skip if skill still exists in meta for this platform
   399→                if (activeIds.has(skillId)) continue;
   400→
   401→                // AC: @skill-rendering ac-4 - Only consider kspec-managed skills
   402→                const isManaged = await isKspecManaged(skillMdPath);
   403→
   404→                if (isManaged) {
   405→                  // AC: @skill-rendering ac-5 - Remove orphaned directory
   406→                  if (!dryRun) {
   407→                    await fs.rm(skillDir, { recursive: true, force: true });
   408→                  }
   409→                  cleanResults.push({
   410→                    id: skillId,
   411→                    path: skillDir,
   412→                    action: "removed",
   413→                    platform: renderer.platform,
   414→                  });
   415→                } else {
   416→                  cleanResults.push({
   417→                    id: skillId,
   418→                    path: skillDir,
   419→                    action: "skipped",
   420→                    reason: "Not managed by kspec",
   421→                    platform: renderer.platform,
   422→                  });
   423→                }
   424→              }
   425→            } catch {
   426→              // Output directory doesn't exist, nothing to clean
   427→            }
   428→          }
   429→        }
   430→
   431→        // Output results
   432→        // AC: @trait-dry-run ac-6 - JSON output includes dry_run field
   433→        output(
   434→          {
   435→            dry_run: dryRun,
   436→            rendered: results,
   437→            cleaned: cleanResults,
   438→            warnings,
   439→          },
   440→          () => {
   441→            // AC: @trait-dry-run ac-3 - Clear indication this is a preview
   442→            if (dryRun) {
   443→              console.log(chalk.yellow("DRY RUN - No changes made"));
   444→              console.log();
   445→            }
   446→
   447→            // AC: @multi-platform-render-cli ac-7 - Show warnings for unregistered platforms
   448→            if (warnings.length > 0) {
   449→              console.log(chalk.yellow("Warnings:"));
   450→              for (const warning of warnings) {
   451→                console.log(`  ${chalk.yellow("!")} ${warning}`);
   452→              }
   453→              console.log();
   454→            }
   455→
   456→            // Render results
   457→            const created = results.filter((r) => r.action === "created");
   458→            const updated = results.filter((r) => r.action === "updated");
   459→            const unchanged = results.filter((r) => r.action === "unchanged");
   460→            // AC: @skill-drift-detection ac-3 - Track skipped drifted skills
   461→            const skippedDrifted = results.filter(
   462→              (r) => r.action === "skipped" && r.skipReason?.includes("drifted")
   463→            );
   464→            const skippedUnregistered = results.filter(
   465→              (r) => r.action === "skipped" && r.skipReason?.includes("unregistered")
   466→            );
   467→
   468→            // AC: @multi-platform-render-cli ac-6 - Include Platform column in output
   469→            if (created.length > 0) {
   470→              console.log(chalk.green(`Created: ${created.length} skill(s)`));
   471→              for (const r of created) {
   472→                console.log(`  ${chalk.green("+")} ${r.id} ${chalk.gray(`[${r.platform}]`)}`);
   473→              }
   474→            }
   475→
   476→            if (updated.length > 0) {
   477→              console.log(chalk.blue(`Updated: ${updated.length} skill(s)`));
   478→              for (const r of updated) {
   479→                console.log(`  ${chalk.blue("~")} ${r.id} ${chalk.gray(`[${r.platform}]`)}`);
   480→              }
   481→            }
   482→
   483→            if (unchanged.length > 0 && results.length <= 10) {
   484→              console.log(chalk.gray(`Unchanged: ${unchanged.length} skill(s)`));
   485→            }
   486→
   487→            // AC: @skill-drift-detection ac-3 - Show warning for skipped drifted skills
   488→            if (skippedDrifted.length > 0) {
   489→              console.log();
   490→              console.log(chalk.yellow(`Skipped: ${skippedDrifted.length} drifted skill(s)`));
   491→              for (const r of skippedDrifted) {
   492→                console.log(`  ${chalk.yellow("!")} ${r.id} ${chalk.gray(`[${r.platform}]`)}: ${r.skipReason || "drifted"}`);
   493→              }
   494→              console.log();
   495→              console.log(chalk.yellow("Use --force to overwrite drifted skills"));
   496→            }
   497→
   498→            // Clean results
   499→            if (cleanResults.length > 0) {
   500→              const removed = cleanResults.filter((r) => r.action === "removed");
   501→              const skipped = cleanResults.filter((r) => r.action === "skipped");
   502→
   503→              if (removed.length > 0) {
   504→                console.log();
   505→                console.log(chalk.red(`Removed: ${removed.length} orphaned skill(s)`));
   506→                for (const r of removed) {
   507→                  // AC: @multi-platform-render-cli ac-6 - Platform column in clean output
   508→                  console.log(`  ${chalk.red("-")} ${r.id} ${chalk.gray(`[${r.platform}]`)}`);
   509→                }
   510→              }
   511→
   512→              if (skipped.length > 0) {
   513→                console.log(
   514→                  chalk.gray(`Skipped: ${skipped.length} unmanaged skill(s)`)
   515→                );
   516→              }
   517→            }
   518→
   519→            // Summary
   520→            console.log();
   521→            if (dryRun) {
   522→              console.log(
   523→                chalk.yellow("No changes were made. Run without --dry-run to apply.")
   524→              );
   525→            } else {
   526→              const changedCount = created.length + updated.length;
   527→              const cleanedCount = cleanResults.filter(
   528→                (r) => r.action === "removed"
   529→              ).length;
   530→              if (changedCount > 0 || cleanedCount > 0) {
   531→                success(
   532→                  `Rendered ${changedCount} skill(s)${cleanedCount > 0 ? `, cleaned ${cleanedCount}` : ""}`
   533→                );
   534→              } else {
   535→                console.log(chalk.gray("No changes needed"));
   536→              }
   537→            }
   538→          }
   539→        );
   540→      } catch (err) {
   541→        error("Failed to render skills", err);
   542→        process.exit(EXIT_CODES.ERROR);
   543→      }
   544→    });
   545→
   546→  // AC: @skill-render-cli ac-3 - kspec skill status
   547→  // AC: @multi-platform-render-cli ac-3 - Per-platform status rows
   548→  skill
   549→    .command("status")
   550→    .description("Show sync status of rendered skills")
   551→    .action(async () => {
   552→      try {
   553→        const ctx = await initContext();
   554→
   555→        if (!ctx.manifestPath) {
   556→          error(errors.project.noKspecProject);
   557→          console.log(
   558→            chalk.gray("Try: kspec init to initialize a kspec project")
   559→          );
   560→          process.exit(EXIT_CODES.ERROR);
   561→        }
   562→
   563→        const metaCtx = await loadMetaContext(ctx);
   564→        const projectRoot = ctx.rootDir;
   565→
   566→        // Check all skills (not just claude-code)
   567→        const skillsToCheck = metaCtx.skills;
   568→
   569→        if (skillsToCheck.length === 0) {
   570→          console.log(chalk.yellow("No skills found"));
   571→          return;
   572→        }
   573→
   574→        // AC: @multi-platform-render-cli ac-3 - Build status per skill-platform pair
   575→        const statusResults: MultiPlatformStatusResult[] = [];
   576→
   577→        for (const skill of skillsToCheck) {
   578→          for (const platform of skill.platforms) {
   579→            const renderer = getRenderer(platform);
   580→            if (!renderer) {
   581→              // Unregistered platform - show as not-rendered
   582→              statusResults.push({
   583→                id: skill.id,
   584→                platform,
   585→                status: "not-rendered",
   586→                docsStatus: "no-docs",
   587→                warning: `unregistered platform '${platform}'`,
   588→              });
   589→              continue;
   590→            }
   591→
   592→            const status = await getMultiPlatformSyncStatus(ctx, projectRoot, skill, renderer);
   593→            statusResults.push(status);
   594→          }
   595→        }
   596→
   597→        // Output results
   598→        output(
   599→          statusResults,
   600→          () => {
   601→            // AC: @multi-platform-render-cli ac-3 - Table shows Platform column
   602→            const table = new Table({
   603→              head: [
   604→                chalk.bold("ID"),
   605→                chalk.bold("Platform"),
   606→                chalk.bold("Status"),
   607→                chalk.bold("Docs"),
   608→              ],
   609→              style: {
   610→                head: [],
   611→                border: [],
   612→              },
   613→            });
   614→
   615→            for (const result of statusResults) {
   616→              const statusColor =
   617→                result.status === "in-sync"
   618→                  ? chalk.green
   619→                  : result.status === "drifted"
   620→                    ? chalk.yellow
   621→                    : chalk.gray;
   622→
   623→              const docsStatusColor =
   624→                result.docsStatus === "in-sync"
   625→                  ? chalk.green
   626→                  : result.docsStatus === "drifted"
   627→                    ? chalk.yellow
   628→                    : chalk.gray;
   629→
   630→              table.push([
   631→                result.id,
   632→                result.platform,
   633→                statusColor(result.status + (result.warning ? " (!)" : "")),
   634→                docsStatusColor(result.docsStatus || "-"),
   635→              ]);
   636→            }
   637→
   638→            console.log(table.toString());
   639→
   640→            // Summary
   641→            const inSync = statusResults.filter((r) => r.status === "in-sync").length;
   642→            const drifted = statusResults.filter((r) => r.status === "drifted").length;
   643→            const notRendered = statusResults.filter((r) => r.status === "not-rendered").length;
   644→            const warningCount = statusResults.filter((r) => r.warning).length;
   645→
   646→            console.log();
   647→            if (drifted > 0) {
   648→              console.log(chalk.yellow(`${drifted} skill(s) drifted - run 'kspec skill render' to sync`));
   649→            }
   650→            if (notRendered > 0) {
   651→              console.log(chalk.gray(`${notRendered} skill(s) not rendered`));
   652→            }
   653→            if (warningCount > 0) {
   654→              console.log(chalk.yellow(`${warningCount} skill(s) with warnings`));
   655→            }
   656→            if (inSync === statusResults.length) {
   657→              console.log(chalk.green("All skills in sync"));
   658→            }
   659→          }
   660→        );
   661→      } catch (err) {
   662→        error("Failed to check skill status", err);
   663→        process.exit(EXIT_CODES.ERROR);
   664→      }
   665→    });
   666→
   667→  // AC: @skill-render-cli ac-4 - kspec skill diff
   668→  skill
   669→    .command("diff <ref>")
   670→    .description("Show diff between source and rendered skill")
   671→    .action(async (ref: string) => {
   672→      try {
   673→        const ctx = await initContext();
   674→
   675→        if (!ctx.manifestPath) {
   676→          error(errors.project.noKspecProject);
   677→          console.log(
   678→            chalk.gray("Try: kspec init to initialize a kspec project")
   679→          );
   680→          process.exit(EXIT_CODES.ERROR);
   681→        }
   682→
   683→        const metaCtx = await loadMetaContext(ctx);
   684→        const item = findMetaItemByRef(metaCtx, ref);
   685→
   686→        if (!item) {
   687→          error(`Skill not found: ${ref}`);
   688→          console.log(chalk.gray("Try: kspec skill list"));
   689→          process.exit(EXIT_CODES.NOT_FOUND);
   690→        }
   691→
   692→        // Check it's a skill (uses _type discriminant)
   693→        if (!isSkill(item)) {
   694→          error(`Item ${ref} is not a skill`);
   695→          process.exit(EXIT_CODES.ERROR);
   696→        }
   697→
   698→        const skill = item as LoadedSkill;
   699→        const projectRoot = ctx.rootDir;
   700→
   701→        // Get expected rendered content
   702→        const expectedContent = await getExpectedRenderedContent(ctx, skill);
   703→
   704→        // Get actual rendered content
   705→        const renderedPath = path.join(
   706→          projectRoot,
   707→          ".claude",
   708→          "skills",
   709→          skill.id,
   710→          "SKILL.md"
   711→        );
   712→
   713→        let actualContent = "";
   714→        try {
   715→          actualContent = await fs.readFile(renderedPath, "utf-8");
   716→        } catch {
   717→          // File doesn't exist
   718→        }
   719→
   720→        // Generate diff
   721→        const diff = generateUnifiedDiff(
   722→          actualContent,
   723→          expectedContent,
   724→          `a/${skill.id}/SKILL.md`,
   725→          `b/${skill.id}/SKILL.md`
   726→        );
   727→
   728→        // Output
   729→        output(
   730→          {
   731→            id: skill.id,
   732→            hasDiff: diff.length > 0,
   733→            diff,
   734→          },
   735→          () => {
   736→            if (diff.length === 0) {
   737→              console.log(chalk.green(`${skill.id}: in sync`));
   738→            } else {
   739→              console.log(chalk.yellow(`${skill.id}: drifted`));
   740→              console.log();
   741→              // Print colored diff
   742→              for (const line of diff) {
   743→                if (line.startsWith("+") && !line.startsWith("+++")) {
   744→                  console.log(chalk.green(line));
   745→                } else if (line.startsWith("-") && !line.startsWith("---")) {
   746→                  console.log(chalk.red(line));
   747→                } else if (line.startsWith("@@")) {
   748→                  console.log(chalk.cyan(line));
   749→                } else {
   750→                  console.log(line);
   751→                }
   752→              }
   753→            }
   754→          }
   755→        );
   756→      } catch (err) {
   757→        error("Failed to generate diff", err);
   758→        process.exit(EXIT_CODES.ERROR);
   759→      }
   760→    });
   761→
   762→  // AC: @skill-drift-detection-improvements ac-2 - kspec skill verify
   763→  skill
   764→    .command("verify")
   765→    .description("Verify rendered skills match their source (reports drift with guidance)")
   766→    .option("--json", "Output as JSON")
   767→    .action(async (options: { json?: boolean }) => {
   768→      try {
   769→        const ctx = await initContext();
   770→
   771→        if (!ctx.manifestPath) {
   772→          error(errors.project.noKspecProject);
   773→          console.log(
   774→            chalk.gray("Try: kspec init to initialize a kspec project")
   775→          );
   776→          process.exit(EXIT_CODES.ERROR);
   777→        }
   778→
   779→        const metaCtx = await loadMetaContext(ctx);
   780→        const projectRoot = ctx.rootDir;
   781→        const skillsToCheck = metaCtx.skills;
   782→
   783→        if (skillsToCheck.length === 0) {
   784→          output([], () => {
   785→            console.log(chalk.yellow("No skills found"));
   786→          });
   787→          return;
   788→        }
   789→
   790→        // Build verification results for each skill-platform pair
   791→        interface VerifyResult {
   792→          id: string;
   793→          platform: string;
   794→          status: "ok" | "drifted" | "not-rendered" | "no-hash";
   795→          guidance?: string;
   796→        }
   797→
   798→        const results: VerifyResult[] = [];
   799→
   800→        for (const skill of skillsToCheck) {
   801→          for (const platform of skill.platforms) {
   802→            const renderer = getRenderer(platform);
   803→            if (!renderer) {
   804→              results.push({
   805→                id: skill.id,
   806→                platform,
   807→                status: "not-rendered",
   808→                guidance: `Unregistered platform '${platform}'. No renderer available.`,
   809→              });
   810→              continue;
   811→            }
   812→
   813→            const driftStatus = await renderer.checkDrift(
   814→              ctx.specDir,
   815→              projectRoot,
   816→              skill.id
   817→            );
   818→
   819→            switch (driftStatus) {
   820→              case "in-sync":
   821→                results.push({ id: skill.id, platform, status: "ok" });
   822→                break;
   823→              case "drifted":
   824→                results.push({
   825→                  id: skill.id,
   826→                  platform,
   827→                  status: "drifted",
   828→                  guidance: `Rendered file has been modified. Run 'kspec skill render ${skill.id} --force' to overwrite with source, or 'kspec skill diff ${skill.id}' to review changes.`,
   829→                });
   830→                break;
   831→              case "not-rendered":
   832→                results.push({
   833→                  id: skill.id,
   834→                  platform,
   835→                  status: "not-rendered",
   836→                  guidance: `Not yet rendered. Run 'kspec skill render ${skill.id}' to generate.`,
   837→                });
   838→                break;
   839→              case "no-hash":
   840→                results.push({
   841→                  id: skill.id,
   842→                  platform,
   843→                  status: "no-hash",
   844→                  guidance: `No render hash stored. Run 'kspec skill render ${skill.id}' to render and store hash.`,
   845→                });
   846→                break;
   847→            }
   848→          }
   849→        }
   850→
   851→        const driftedResults = results.filter((r) => r.status === "drifted");
   852→        const okResults = results.filter((r) => r.status === "ok");
   853→        const notRenderedResults = results.filter((r) => r.status === "not-rendered");
   854→        const noHashResults = results.filter((r) => r.status === "no-hash");
   855→
   856→        output(
   857→          results,
   858→          () => {
   859→            if (driftedResults.length === 0 && notRenderedResults.length === 0 && noHashResults.length === 0) {
   860→              console.log(chalk.green(`All ${okResults.length} rendered skill(s) verified — no drift detected.`));
   861→              return;
   862→            }
   863→
   864→            // Show drifted skills with guidance
   865→            if (driftedResults.length > 0) {
   866→              console.log(chalk.yellow.bold(`\nDrifted (${driftedResults.length}):`));
   867→              for (const r of driftedResults) {
   868→                console.log(`  ${chalk.yellow("●")} ${r.id} [${r.platform}]`);
   869→                console.log(`    ${chalk.gray(r.guidance!)}`);
   870→              }
   871→            }
   872→
   873→            // Show not-rendered
   874→            if (notRenderedResults.length > 0) {
   875→              console.log(chalk.gray.bold(`\nNot rendered (${notRenderedResults.length}):`));
   876→              for (const r of notRenderedResults) {
   877→                console.log(`  ${chalk.gray("○")} ${r.id} [${r.platform}]`);
   878→                console.log(`    ${chalk.gray(r.guidance!)}`);
   879→              }
   880→            }
   881→
   882→            // Show no-hash
   883→            if (noHashResults.length > 0) {
   884→              console.log(chalk.gray.bold(`\nNo hash (${noHashResults.length}):`));
   885→              for (const r of noHashResults) {
   886→                console.log(`  ${chalk.gray("○")} ${r.id} [${r.platform}]`);
   887→                console.log(`    ${chalk.gray(r.guidance!)}`);
   888→              }
   889→            }
   890→
   891→            // Summary line
   892→            if (okResults.length > 0) {
   893→              console.log(chalk.green(`\n${okResults.length} skill(s) verified OK.`));
   894→            }
   895→
   896→            // Actionable summary
   897→            if (driftedResults.length > 0) {
   898→              console.log(
   899→                chalk.yellow(`\nTo sync all drifted skills: kspec skill render --force`)
   900→              );
   901→            }
   902→          }
   903→        );
   904→
   905→        // Exit with non-zero if any skills drifted
   906→        if (driftedResults.length > 0) {
   907→          process.exit(EXIT_CODES.ERROR);
   908→        }
   909→      } catch (err) {
   910→        error("Failed to verify skills", err);
   911→        process.exit(EXIT_CODES.ERROR);
   912→      }
   913→    });
   914→}
   915→

