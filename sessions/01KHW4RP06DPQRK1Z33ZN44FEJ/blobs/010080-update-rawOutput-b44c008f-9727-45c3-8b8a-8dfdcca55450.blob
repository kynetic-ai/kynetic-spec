    39→} from "./yaml.js";
    40→
    41→// ============================================================
    42→// TYPES
    43→// ============================================================
    44→
    45→/**
    46→ * Schema validation error
    47→ */
    48→export interface SchemaValidationError {
    49→  file: string;
    50→  path?: string;
    51→  message: string;
    52→  details?: unknown;
    53→}
    54→
    55→/**
    56→ * Orphan item (not referenced by anything)
    57→ */
    58→export interface OrphanItem {
    59→  ulid: string;
    60→  title: string;
    61→  type: string;
    62→  file?: string;
    63→}
    64→
    65→/**
    66→ * Completeness warning types
    67→ */
    68→export type CompletenessWarningType =
    69→  | "missing_acceptance_criteria"
    70→  | "missing_description"
    71→  | "status_inconsistency"
    72→  | "missing_test_coverage"
    73→  | "automation_eligible_no_spec"
    74→  | "ac_schema_field_mismatch";
    75→
    76→/**
    77→ * Trait cycle error
    78→ */
    79→export interface TraitCycleError {
    80→  traitRef: string;
    81→  traitTitle: string;
    82→  cycle: string[];
    83→  message: string;
    84→}
    85→
    86→/**
    87→ * Completeness warning
    88→ */
    89→export interface CompletenessWarning {
    90→  type: CompletenessWarningType;
    91→  itemRef: string;
    92→  itemTitle: string;
    93→  message: string;
    94→  details?: string;
    95→}
    96→
    97→/**
    98→ * Complete validation result
    99→ */
   100→export interface ValidationResult {
   101→  valid: boolean;
   102→  schemaErrors: SchemaValidationError[];
   103→  refErrors: RefValidationError[];
   104→  refWarnings: RefValidationWarning[];
   105→  orphans: OrphanItem[];
   106→  completenessWarnings: CompletenessWarning[];
   107→  traitCycleErrors: TraitCycleError[];
   108→  stats: {
   109→    filesChecked: number;
   110→    itemsChecked: number;
   111→    tasksChecked: number;
   112→  };
   113→  metaStats?: {
   114→    agents: number;
   115→    workflows: number;
   116→    conventions: number;
   117→    observations: number;
   118→    skills: number;
   119→  };
   120→}
   121→
   122→/**
   123→ * Validation options
   124→ */
   125→export interface ValidateOptions {
   126→  /** Check schema conformance */
   127→  schema?: boolean;
   128→  /** Check reference resolution */
   129→  refs?: boolean;
   130→  /** Find orphaned items */
   131→  orphans?: boolean;
   132→  /** Check spec completeness (missing AC, descriptions, status inconsistencies) */
   133→  completeness?: boolean;
   134→}
   135→
   136→// ============================================================
   137→// SCHEMA VALIDATION
   138→// ============================================================
   139→
   140→/**
   141→ * Validate a manifest file against schema
   142→ */
   143→async function validateManifestFile(
   144→  filePath: string,
   145→): Promise<SchemaValidationError[]> {
   146→  const errors: SchemaValidationError[] = [];
   147→
   148→  try {
   149→    const raw = await readYamlFile<unknown>(filePath);
   150→    const result = ManifestSchema.safeParse(raw);
   151→
   152→    if (!result.success) {
   153→      for (const issue of result.error.issues) {
   154→        errors.push({
   155→          file: filePath,
   156→          path: issue.path.join("."),
   157→          message: issue.message,
   158→          details: issue,
   159→        });
   160→      }
   161→    }
   162→  } catch (err) {
   163→    errors.push({
   164→      file: filePath,
   165→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   166→    });
   167→  }
   168→
   169→  return errors;
   170→}
   171→
   172→/**
   173→ * Validate a tasks file against schema
   174→ */
   175→async function validateTasksFile(
   176→  filePath: string,
   177→): Promise<SchemaValidationError[]> {
   178→  const errors: SchemaValidationError[] = [];
   179→
   180→  try {
   181→    const raw = await readYamlFile<unknown>(filePath);
   182→
   183→    // Handle both formats: { tasks: [...] } and plain array
   184→    let taskList: unknown[];
   185→
   186→    if (Array.isArray(raw)) {
   187→      taskList = raw;
   188→    } else if (raw && typeof raw === "object" && "tasks" in raw) {
   189→      // Try full TasksFile schema first
   190→      const fileResult = TasksFileSchema.safeParse(raw);
   191→      if (!fileResult.success) {
   192→        // If TasksFile fails, just validate individual tasks
   193→        taskList = (raw as { tasks: unknown[] }).tasks || [];
   194→      } else {
   195→        // File schema passed, validate individual tasks for detailed errors
   196→        taskList = fileResult.data.tasks;
   197→      }
   198→    } else {
   199→      errors.push({
   200→        file: filePath,
   201→        message:
   202→          "Invalid tasks file format: expected array or { tasks: [...] }",
   203→      });
   204→      return errors;
   205→    }
   206→
   207→    // Validate each task
   208→    for (let i = 0; i < taskList.length; i++) {
   209→      const task = taskList[i];
   210→      const result = TaskSchema.safeParse(task);
   211→
   212→      if (!result.success) {
   213→        for (const issue of result.error.issues) {
   214→          errors.push({
   215→            file: filePath,
   216→            path: `tasks[${i}].${issue.path.join(".")}`,
   217→            message: issue.message,
   218→            details: issue,
   219→          });
   220→        }
   221→      }
   222→    }
   223→  } catch (err) {
   224→    errors.push({
   225→      file: filePath,
   226→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   227→    });
   228→  }
   229→
   230→  return errors;
   231→}
   232→
   233→/**
   234→ * Validate a spec module file against schema
   235→ */
   236→async function validateSpecFile(
   237→  filePath: string,
   238→): Promise<SchemaValidationError[]> {
   239→  const errors: SchemaValidationError[] = [];
   240→
   241→  try {
   242→    const raw = await readYamlFile<unknown>(filePath);
   243→
   244→    // Recursively validate spec items
   245→    validateSpecItemRecursive(raw, filePath, "", errors);
   246→  } catch (err) {
   247→    errors.push({
   248→      file: filePath,
   249→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   250→    });
   251→  }
   252→
   253→  return errors;
   254→}
   255→
   256→/**
   257→ * Validate meta manifest file with strict ULID validation
   258→ * AC-meta-manifest-3: Invalid schema exits with code 1 and shows field path + expected type
   259→ */
   260→async function validateMetaManifestFile(
   261→  filePath: string,
   262→): Promise<SchemaValidationError[]> {
   263→  const errors: SchemaValidationError[] = [];
   264→
   265→  try {
   266→    const raw = await readYamlFile<unknown>(filePath);
   267→
   268→    // Validate overall manifest structure
   269→    const manifestResult = MetaManifestSchema.safeParse(raw);
   270→    if (!manifestResult.success) {
   271→      for (const issue of manifestResult.error.issues) {
   272→        errors.push({
   273→          file: filePath,
   274→          path: issue.path.join("."),
   275→          message: issue.message,
   276→          details: issue,
   277→        });
   278→      }
   279→      return errors;
   280→    }
   281→
   282→    // Validate each agent with strict ULID validation
   283→    if (
   284→      raw &&
   285→      typeof raw === "object" &&
   286→      "agents" in raw &&
   287→      Array.isArray((raw as Record<string, unknown>).agents)
   288→    ) {
   289→      const agents = (raw as Record<string, unknown>).agents as unknown[];
   290→      for (let i = 0; i < agents.length; i++) {
   291→        const agent = agents[i];
   292→        const agentResult = AgentSchema.safeParse(agent);
   293→        if (!agentResult.success) {
   294→          for (const issue of agentResult.error.issues) {
   295→            errors.push({
   296→              file: filePath,
   297→              path: `agents[${i}].${issue.path.join(".")}`,
   298→              message: issue.message,
   299→              details: issue,
   300→            });
   301→          }
   302→        }
   303→
   304→        // Strict ULID validation
   305→        if (agent && typeof agent === "object" && "_ulid" in agent) {
   306→          const ulidResult = UlidSchema.safeParse(
   307→            (agent as Record<string, unknown>)._ulid,
   308→          );
   309→          if (!ulidResult.success) {
   310→            errors.push({
   311→              file: filePath,
   312→              path: `agents[${i}]._ulid`,
   313→              message: "Invalid ULID format (expected 26 characters)",
   314→            });
   315→          }
   316→        }
   317→      }
   318→    }
   319→
   320→    // Validate each workflow with strict ULID validation
   321→    if (
   322→      raw &&
   323→      typeof raw === "object" &&
   324→      "workflows" in raw &&
   325→      Array.isArray((raw as Record<string, unknown>).workflows)
   326→    ) {
   327→      const workflows = (raw as Record<string, unknown>).workflows as unknown[];
   328→      for (let i = 0; i < workflows.length; i++) {
   329→        const workflow = workflows[i];
   330→        const workflowResult = WorkflowSchema.safeParse(workflow);
   331→        if (!workflowResult.success) {
   332→          for (const issue of workflowResult.error.issues) {
   333→            errors.push({
   334→              file: filePath,
   335→              path: `workflows[${i}].${issue.path.join(".")}`,
   336→              message: issue.message,
   337→              details: issue,
   338→            });
   339→          }
   340→        }
   341→
   342→        // Strict ULID validation
   343→        if (workflow && typeof workflow === "object" && "_ulid" in workflow) {
   344→          const ulidResult = UlidSchema.safeParse(
   345→            (workflow as Record<string, unknown>)._ulid,
   346→          );
   347→          if (!ulidResult.success) {
   348→            errors.push({
   349→              file: filePath,
   350→              path: `workflows[${i}]._ulid`,
   351→              message: "Invalid ULID format (expected 26 characters)",
   352→            });
   353→          }
   354→        }
   355→      }
   356→    }
   357→
   358→    // Validate each convention with strict ULID validation
   359→    if (
   360→      raw &&
   361→      typeof raw === "object" &&
   362→      "conventions" in raw &&
   363→      Array.isArray((raw as Record<string, unknown>).conventions)
   364→    ) {
   365→      const conventions = (raw as Record<string, unknown>)
   366→        .conventions as unknown[];
   367→      for (let i = 0; i < conventions.length; i++) {
   368→        const convention = conventions[i];
   369→        const conventionResult = ConventionSchema.safeParse(convention);
   370→        if (!conventionResult.success) {
   371→          for (const issue of conventionResult.error.issues) {
   372→            errors.push({
   373→              file: filePath,
   374→              path: `conventions[${i}].${issue.path.join(".")}`,
   375→              message: issue.message,
   376→              details: issue,
   377→            });
   378→          }
   379→        }
   380→
   381→        // Strict ULID validation
   382→        if (
   383→          convention &&
   384→          typeof convention === "object" &&
   385→          "_ulid" in convention
   386→        ) {
   387→          const ulidResult = UlidSchema.safeParse(
   388→            (convention as Record<string, unknown>)._ulid,
   389→          );
   390→          if (!ulidResult.success) {
   391→            errors.push({
   392→              file: filePath,
   393→              path: `conventions[${i}]._ulid`,
   394→              message: "Invalid ULID format (expected 26 characters)",
   395→            });
   396→          }
   397→        }
   398→      }
   399→    }
   400→
   401→    // Validate each observation with strict ULID validation
   402→    if (
   403→      raw &&
   404→      typeof raw === "object" &&
   405→      "observations" in raw &&
   406→      Array.isArray((raw as Record<string, unknown>).observations)
   407→    ) {
   408→      const observations = (raw as Record<string, unknown>)
   409→        .observations as unknown[];
   410→      for (let i = 0; i < observations.length; i++) {
   411→        const observation = observations[i];
   412→        const observationResult = ObservationSchema.safeParse(observation);
   413→        if (!observationResult.success) {
   414→          for (const issue of observationResult.error.issues) {
   415→            errors.push({
   416→              file: filePath,
   417→              path: `observations[${i}].${issue.path.join(".")}`,
   418→              message: issue.message,
   419→              details: issue,
   420→            });
   421→          }
   422→        }
   423→
   424→        // Strict ULID validation
   425→        if (
   426→          observation &&
   427→          typeof observation === "object" &&
   428→          "_ulid" in observation
   429→        ) {
   430→          const ulidResult = UlidSchema.safeParse(
   431→            (observation as Record<string, unknown>)._ulid,
   432→          );
   433→          if (!ulidResult.success) {
   434→            errors.push({
   435→              file: filePath,
   436→              path: `observations[${i}]._ulid`,
   437→              message: "Invalid ULID format (expected 26 characters)",
   438→            });
   439→          }
   440→        }
   441→      }
   442→    }
   443→
   444→    // AC: @skill-validation ac-4 - validate each skill with strict ULID validation
   445→    if (
   446→      raw &&
   447→      typeof raw === "object" &&
   448→      "skills" in raw &&
   449→      Array.isArray((raw as Record<string, unknown>).skills)
   450→    ) {
   451→      const skills = (raw as Record<string, unknown>).skills as unknown[];
   452→      for (let i = 0; i < skills.length; i++) {
   453→        const skill = skills[i];
   454→        const skillResult = SkillSchema.safeParse(skill);
   455→        if (!skillResult.success) {
   456→          for (const issue of skillResult.error.issues) {
   457→            errors.push({
   458→              file: filePath,
   459→              path: `skills[${i}].${issue.path.join(".")}`,
   460→              message: issue.message,
   461→              details: issue,
   462→            });
   463→          }
   464→        }
   465→
   466→        // Strict ULID validation
   467→        if (skill && typeof skill === "object" && "_ulid" in skill) {
   468→          const ulidResult = UlidSchema.safeParse(
   469→            (skill as Record<string, unknown>)._ulid,
   470→          );
   471→          if (!ulidResult.success) {
   472→            errors.push({
   473→              file: filePath,
   474→              path: `skills[${i}]._ulid`,
   475→              message: "Invalid ULID format (expected 26 characters)",
   476→            });
   477→          }
   478→        }
   479→      }
   480→    }
   481→  } catch (err) {
   482→    errors.push({
   483→      file: filePath,
   484→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   485→    });
   486→  }
   487→
   488→  return errors;
   489→}
   490→
   491→/**
   492→ * Recursively validate spec items in a structure
   493→ */
   494→function validateSpecItemRecursive(
   495→  raw: unknown,
   496→  file: string,
   497→  pathPrefix: string,
   498→  errors: SchemaValidationError[],
   499→): void {
   500→  if (!raw || typeof raw !== "object") return;
   501→
   502→  // Check if this is a spec item (has _ulid)
   503→  if ("_ulid" in raw) {
   504→    const result = SpecItemSchema.safeParse(raw);
   505→    if (!result.success) {
   506→      for (const issue of result.error.issues) {
   507→        errors.push({
   508→          file,
   509→          path: pathPrefix
   510→            ? `${pathPrefix}.${issue.path.join(".")}`
   511→            : issue.path.join("."),
   512→          message: issue.message,
   513→          details: issue,
   514→        });
   515→      }
   516→    }
   517→  }
   518→
   519→  // Recurse into nested structures
   520→  const nestedFields = [
   521→    "modules",
   522→    "features",
   523→    "requirements",
   524→    "constraints",
   525→    "decisions",
   526→    "items",
   527→  ];
   528→  const obj = raw as Record<string, unknown>;
   529→
   530→  for (const field of nestedFields) {
   531→    if (field in obj && Array.isArray(obj[field])) {
   532→      const arr = obj[field] as unknown[];
   533→      for (let i = 0; i < arr.length; i++) {
   534→        const newPath = pathPrefix
   535→          ? `${pathPrefix}.${field}[${i}]`
   536→          : `${field}[${i}]`;
   537→        validateSpecItemRecursive(arr[i], file, newPath, errors);
   538→      }
   539→    }
   540→  }
   541→}
   542→
   543→// ============================================================
   544→// ORPHAN DETECTION
   545→// ============================================================
   546→
   547→/**
   548→ * Find items that are not referenced by any other item
   549→ */
   550→function findOrphans(
   551→  tasks: LoadedTask[],
   552→  items: LoadedSpecItem[],
   553→  index: ReferenceIndex,
   554→): OrphanItem[] {
   555→  const orphans: OrphanItem[] = [];
   556→
   557→  // Build set of all referenced ULIDs
   558→  const referenced = new Set<string>();
   559→
   560→  const allItems = [...tasks, ...items];
   561→
   562→  // Fields that contain references
   563→  const refFields = [
   564→    "depends_on",
   565→    "blocked_by",
   566→    "implements",
   567→    "relates_to",
   568→    "tests",
   569→    "supersedes",
   570→    "spec_ref",
   571→    "context",
   572→  ];
   573→
   574→  for (const item of allItems) {
   575→    const obj = item as unknown as Record<string, unknown>;
   576→
   577→    for (const field of refFields) {
   578→      const value = obj[field];
   579→
   580→      if (typeof value === "string" && value.startsWith("@")) {
   581→        const resolved = index.resolve(value);
   582→        if (resolved.ok) {
   583→          referenced.add(resolved.ulid);
   584→        }
   585→      } else if (Array.isArray(value)) {
   586→        for (const v of value) {
   587→          if (typeof v === "string" && v.startsWith("@")) {
   588→            const resolved = index.resolve(v);
   589→            if (resolved.ok) {
   590→              referenced.add(resolved.ulid);
   591→            }
   592→          }
   593→        }
   594→      }
   595→    }
   596→  }
   597→
   598→  // Find items not in the referenced set
   599→  // Skip entry point types: modules are spec entry points, tasks are work items
   600→  const entryPointTypes = ["module", "task", "epic", "bug", "spike", "infra"];
   601→
   602→  for (const item of items) {
   603→    // Only check spec items, not tasks
   604→    if (!referenced.has(item._ulid)) {
   605→      // Skip entry point types
   606→      if (entryPointTypes.includes(item.type || "")) continue;
   607→
   608→      // Skip nested items - they're implicitly referenced by their parent
   609→      // _path indicates nesting (e.g., "features[0].requirements[2]")
   610→      if (item._path) continue;
   611→
   612→      orphans.push({
   613→        ulid: item._ulid,
   614→        title: item.title,
   615→        type: item.type || "unknown",
   616→        file: item._sourceFile,
   617→      });
   618→    }
   619→  }
   620→
   621→  return orphans;
   622→}
   623→
   624→// ============================================================
   625→// TRAIT CYCLE DETECTION
   626→// ============================================================
   627→
   628→/**
   629→ * Detect circular trait references
   630→ * AC: @trait-edge-cases ac-2
   631→ */
   632→function detectTraitCycles(
   633→  items: LoadedSpecItem[],
   634→  index: ReferenceIndex,
   635→): TraitCycleError[] {
   636→  const errors: TraitCycleError[] = [];
   637→  const traits = items.filter((item) => item.type === "trait");
   638→
   639→  // Build adjacency list: trait ULID → trait ULIDs it references
   640→  const graph = new Map<string, string[]>();
   641→  const traitInfo = new Map<string, { ref: string; title: string }>();
   642→
   643→  for (const trait of traits) {
   644→    const ref = trait.slugs?.[0]
   645→      ? `@${trait.slugs[0]}`
   646→      : `@${trait._ulid.slice(0, 8)}`;
   647→    traitInfo.set(trait._ulid, { ref, title: trait.title });
   648→
   649→    const dependencies: string[] = [];
   650→    if (trait.traits && trait.traits.length > 0) {
   651→      for (const traitRef of trait.traits) {
   652→        const result = index.resolve(traitRef);
   653→        if (result.ok) {
   654→          dependencies.push(result.ulid);
   655→        }
   656→      }
   657→    }
   658→    graph.set(trait._ulid, dependencies);
   659→  }
   660→
   661→  // DFS-based cycle detection
   662→  const visiting = new Set<string>();
   663→  const visited = new Set<string>();
   664→
   665→  function dfs(ulid: string, path: string[]): string[] | null {
   666→    if (visiting.has(ulid)) {
   667→      // Found a cycle - return the cycle path
   668→      const cycleStart = path.indexOf(ulid);
   669→      return path.slice(cycleStart);
   670→    }
   671→
   672→    if (visited.has(ulid)) {
   673→      return null; // Already checked this path
   674→    }
   675→
   676→    visiting.add(ulid);
   677→    path.push(ulid);
   678→
   679→    const dependencies = graph.get(ulid) || [];
   680→    for (const depUlid of dependencies) {
   681→      const cycle = dfs(depUlid, path);
   682→      if (cycle) {
   683→        return cycle;
   684→      }
   685→    }
   686→
   687→    visiting.delete(ulid);
   688→    visited.add(ulid);
   689→    path.pop();
   690→
   691→    return null;
   692→  }
   693→
   694→  // Check each trait for cycles
   695→  for (const trait of traits) {
   696→    if (!visited.has(trait._ulid)) {
   697→      const cycle = dfs(trait._ulid, []);
   698→      if (cycle) {
   699→        const info = traitInfo.get(cycle[0]);
   700→        if (info) {
   701→          const cycleRefs = cycle.map((ulid) => {
   702→            const cycleInfo = traitInfo.get(ulid);
   703→            return cycleInfo ? cycleInfo.ref : `@${ulid.slice(0, 8)}`;
   704→          });
   705→
   706→          errors.push({
   707→            traitRef: info.ref,
   708→            traitTitle: info.title,
   709→            cycle: cycleRefs,
   710→            message: `Circular trait reference: ${cycleRefs.join(" → ")} → ${cycleRefs[0]}`,
   711→          });
   712→        }
   713→
   714→        // Mark all traits in cycle as visited to avoid duplicate errors
   715→        for (const ulid of cycle) {
   716→          visited.add(ulid);
   717→        }
   718→      }
   719→    }
   720→  }
   721→
   722→  return errors;
   723→}
   724→
   725→// ============================================================
   726→// COMPLETENESS VALIDATION
   727→// ============================================================
   728→
   729→/**
   730→ * Recursively find all test files in a directory
   731→ */
   732→async function findTestFilesRecursive(dir: string): Promise<string[]> {
   733→  const testFiles: string[] = [];
   734→
   735→  try {
   736→    const entries = await fs.readdir(dir, { withFileTypes: true });
   737→
   738→    for (const entry of entries) {
   739→      const fullPath = path.join(dir, entry.name);
   740→
   741→      if (entry.isDirectory()) {
   742→        // Recurse into subdirectories
   743→        const subFiles = await findTestFilesRecursive(fullPath);
   744→        testFiles.push(...subFiles);
   745→      } else if (
   746→        entry.isFile() &&
   747→        (entry.name.endsWith(".test.ts") || entry.name.endsWith(".test.js"))
   748→      ) {
   749→        testFiles.push(fullPath);
   750→      }
   751→    }
   752→  } catch {
   753→    // Directory doesn't exist or can't be read - return empty
   754→  }
   755→
   756→  return testFiles;
   757→}
   758→
   759→/**
   760→ * Scan test files for AC annotations to build coverage index.
   761→ * Recursively scans all subdirectories under tests/.
   762→ * Returns a Set of covered ACs in format "@spec-ref ac-N"
   763→ */
   764→export async function scanTestCoverage(rootDir: string): Promise<Set<string>> {
   765→  const coveredACs = new Set<string>();
   766→  const testsDir = path.join(rootDir, "tests");
   767→
   768→  try {
   769→    // Check if tests directory exists
   770→    await fs.access(testsDir);
   771→
   772→    // Recursively find all test files
   773→    const testFiles = await findTestFilesRecursive(testsDir);
   774→
   775→    for (const filePath of testFiles) {
   776→      const content = await fs.readFile(filePath, "utf-8");
   777→
   778→      // Match AC annotations: // AC: @spec-ref ac-N
   779→      // Also handle multiple ACs on one line: // AC: @spec-ref ac-1, ac-2
   780→      const acPattern =
   781→        /\/\/\s*AC:\s*(@[\w-]+)(?:\s+(ac-\d+(?:\s*,\s*ac-\d+)*))?/g;
   782→      let match;
   783→
   784→      while ((match = acPattern.exec(content)) !== null) {
   785→        const specRef = match[1]; // @spec-ref
   786→        const acList = match[2]; // "ac-1, ac-2" or just "ac-1" or undefined
   787→
   788→        if (acList) {
   789→          // Split by comma and trim
   790→          const acs = acList.split(",").map((ac) => ac.trim());
   791→          for (const ac of acs) {
   792→            coveredACs.add(`${specRef} ${ac}`);
   793→          }
   794→        } else {
   795→          // No specific AC mentioned, just the spec ref
   796→          // We'll consider this as generic coverage
   797→          coveredACs.add(specRef);
   798→        }
   799→      }
   800→    }
   801→  } catch (_err) {
   802→    // Tests directory doesn't exist or can't be read - that's ok
   803→  }
   804→
   805→  return coveredACs;
   806→}
   807→
   808→/**
   809→ * Compute coverage status for acceptance criteria of a spec item.
   810→ * Shared utility used by both daemon API and JSON export.
   811→ *
   812→ * @param item - The spec item containing acceptance_criteria
   813→ * @param coveredACs - Set of covered AC references from scanTestCoverage()
   814→ * @returns Array of ACs with covered field populated
   815→ */
   816→export function computeACCoverage<
   817→  T extends { id: string; given: string; when: string; then: string },
   818→>(
   819→  item: { _ulid: string; slugs?: string[]; acceptance_criteria?: T[] },
   820→  coveredACs: Set<string>,
   821→): Array<T & { covered: boolean }> {
   822→  if (!item.acceptance_criteria || item.acceptance_criteria.length === 0) {
   823→    return [];
   824→  }
   825→
   826→  return item.acceptance_criteria.map((ac, index) => {
   827→    const acId = `ac-${index + 1}`;
   828→    const possibleRefs: string[] = [];
   829→
   830→    // Try with primary slug
   831→    if (item.slugs && item.slugs.length > 0) {
   832→      possibleRefs.push(`@${item.slugs[0]} ${acId}`);
   833→      possibleRefs.push(`@${item.slugs[0]}`);
   834→    }
   835→
   836→    // Try with ULID (short form)
   837→    possibleRefs.push(`@${item._ulid.slice(0, 8)} ${acId}`);
   838→    possibleRefs.push(`@${item._ulid.slice(0, 8)}`);
   839→
   840→    const covered = possibleRefs.some((ref) => coveredACs.has(ref));
   841→    return { ...ac, covered };
   842→  });
   843→}
   844→
   845→/**
   846→ * Check spec items for completeness
   847→ * AC: @spec-completeness ac-1, ac-2, ac-3
   848→ * AC: @trait-validation ac-1, ac-2, ac-3
   849→ */
   850→async function checkCompleteness(
   851→  items: LoadedSpecItem[],
   852→  _index: ReferenceIndex,
   853→  rootDir: string,
   854→  traitIndex?: TraitIndex,
   855→): Promise<CompletenessWarning[]> {
   856→  const warnings: CompletenessWarning[] = [];
   857→
   858→  // Scan test files for AC coverage
   859→  const coveredACs = await scanTestCoverage(rootDir);
   860→
   861→  for (const item of items) {
   862→    const itemRef = item.slugs?.[0]
   863→      ? `@${item.slugs[0]}`
   864→      : `@${item._ulid.slice(0, 8)}`;
   865→    const isTrait = item.type === "trait";
   866→
   867→    // AC: @spec-completeness ac-1
   868→    // AC: @trait-type ac-2 - Traits should have acceptance criteria for completeness
   869→    // Check for missing acceptance criteria
   870→    if (!item.acceptance_criteria || item.acceptance_criteria.length === 0) {
   871→      warnings.push({
   872→        type: "missing_acceptance_criteria",
   873→        itemRef,
   874→        itemTitle: item.title,
   875→        message: `${isTrait ? "Trait" : "Item"} ${itemRef} has no acceptance criteria`,
   876→      });
   877→    }
   878→
   879→    // AC: @spec-completeness ac-2
   880→    // AC: @trait-type ac-3 - Traits should have description for completeness
   881→    // Check for missing description
   882→    if (!item.description || item.description.trim() === "") {
   883→      warnings.push({
   884→        type: "missing_description",
   885→        itemRef,
   886→        itemTitle: item.title,
   887→        message: `${isTrait ? "Trait" : "Item"} ${itemRef} has no description`,
   888→      });
   889→    }
   890→
   891→    // AC: @spec-completeness ac-3
   892→    // Check for status inconsistency between parent and children
   893→    if (item.status?.implementation === "implemented") {
   894→      // Check if this item has children with not_started status
   895→      const childFields = [
   896→        "modules",
   897→        "features",
   898→        "requirements",
   899→        "constraints",
   900→        "epics",
   901→        "themes",
   902→        "capabilities",
   903→      ];
   904→
   905→      for (const field of childFields) {
   906→        const children = (item as any)[field];
   907→        if (Array.isArray(children)) {
   908→          for (const child of children) {
   909→            if (child.status?.implementation === "not_started") {
   910→              const childRef = child.slugs?.[0]
   911→                ? `@${child.slugs[0]}`
   912→                : `@${child._ulid?.slice(0, 8) || "unknown"}`;
   913→              warnings.push({
   914→                type: "status_inconsistency",
   915→                itemRef,
   916→                itemTitle: item.title,
   917→                message: `Parent ${itemRef} is implemented but child ${childRef} is not_started`,
   918→                details: `Child: ${child.title}`,
   919→              });
   920→            }
   921→          }
   922→        }
   923→      }
   924→    }
   925→
   926→    // Check for test coverage of acceptance criteria
   927→    if (item.acceptance_criteria && item.acceptance_criteria.length > 0) {
   928→      const uncoveredACs: string[] = [];
   929→
   930→      for (const ac of item.acceptance_criteria) {
   931→        // Build all possible references for this AC
   932→        const possibleRefs: string[] = [];
   933→
   934→        // Try with primary slug
   935→        if (item.slugs && item.slugs.length > 0) {
   936→          possibleRefs.push(`@${item.slugs[0]} ${ac.id}`);
   937→          // Also check for just the slug without specific AC
   938→          possibleRefs.push(`@${item.slugs[0]}`);
   939→        }
   940→
   941→        // Try with ULID (short form)
   942→        possibleRefs.push(`@${item._ulid.slice(0, 8)} ${ac.id}`);
   943→        possibleRefs.push(`@${item._ulid.slice(0, 8)}`);
   944→
   945→        // Check if any of these references are covered
   946→        const isCovered = possibleRefs.some((ref) => coveredACs.has(ref));
   947→
   948→        if (!isCovered) {
   949→          uncoveredACs.push(ac.id);
   950→        }
   951→      }
   952→
   953→      // Only warn if there are uncovered ACs
   954→      if (uncoveredACs.length > 0) {
   955→        warnings.push({
   956→          type: "missing_test_coverage",
   957→          itemRef,
   958→          itemTitle: item.title,
   959→          message: `Item ${itemRef} has ${uncoveredACs.length} AC(s) without test coverage`,
   960→          details: `Uncovered: ${uncoveredACs.join(", ")}`,
   961→        });
   962→      }
   963→    }
   964→
   965→    // AC: @trait-validation ac-1, ac-2
   966→    // Check for test coverage of trait acceptance criteria
   967→    if (traitIndex && item.traits && item.traits.length > 0) {
   968→      const inheritedACs = traitIndex.getInheritedAC(item._ulid);
   969→      const uncoveredTraitACs: Array<{ traitSlug: string; acId: string }> = [];
   970→
   971→      for (const { trait, ac } of inheritedACs) {
   972→        // Build all possible references for this trait AC
   973→        const possibleRefs: string[] = [];
   974→
   975→        // Try with trait slug
   976→        possibleRefs.push(`@${trait.slug} ${ac.id}`);
   977→        possibleRefs.push(`@${trait.slug}`);
   978→
   979→        // Try with trait ULID (short form)
   980→        possibleRefs.push(`@${trait.ulid.slice(0, 8)} ${ac.id}`);
   981→        possibleRefs.push(`@${trait.ulid.slice(0, 8)}`);
   982→
   983→        // Check if any of these references are covered
   984→        const isCovered = possibleRefs.some((ref) => coveredACs.has(ref));
   985→
   986→        if (!isCovered) {
   987→          uncoveredTraitACs.push({ traitSlug: trait.slug, acId: ac.id });
   988→        }
   989→      }
   990→
   991→      // Only warn if there are uncovered trait ACs
   992→      if (uncoveredTraitACs.length > 0) {
   993→        const details = uncoveredTraitACs
   994→          .map(({ traitSlug, acId }) => `@${traitSlug} ${acId}`)
   995→          .join(", ");
   996→        warnings.push({
   997→          type: "missing_test_coverage",
   998→          itemRef,
   999→          itemTitle: item.title,
  1000→          message: `Item ${itemRef} has ${uncoveredTraitACs.length} inherited trait AC(s) without test coverage`,
  1001→          details: `Uncovered trait ACs: ${details}`,
  1002→        });
  1003→      }
  1004→    }
  1005→
  1006→    // AC: @trait-retrospective ac-2, ac-3
  1007→    // Check retrospective specs have required verification metadata
  1008→    const isRetrospective = item.traits?.includes("@trait-retrospective");
  1009→    if (isRetrospective) {
  1010→      const isImplementedOrVerified =
  1011→        item.status?.implementation === "implemented" ||
  1012→        item.status?.implementation === "verified";
  1013→
  1014→      // AC: @trait-retrospective ac-2
  1015→      // Retrospective specs with implemented/verified status must have verification metadata
  1016→      if (isImplementedOrVerified) {
  1017→        if (!item.verified_at || !item.verified_by) {
  1018→          warnings.push({
  1019→            type: "status_inconsistency",
  1020→            itemRef,
  1021→            itemTitle: item.title,
  1022→            message: `Retrospective spec ${itemRef} is ${item.status?.implementation} but missing verified_at/verified_by`,
  1023→            details:
  1024→              "Specs using @trait-retrospective must have verified_at and verified_by fields when marked as implemented or verified",
  1025→          });
  1026→        }
  1027→      }
  1028→
  1029→      // Inverse validation: If verification metadata exists, status should be implemented/verified
  1030→      if ((item.verified_at || item.verified_by) && !isImplementedOrVerified) {
  1031→        warnings.push({
  1032→          type: "status_inconsistency",
  1033→          itemRef,
  1034→          itemTitle: item.title,
  1035→          message: `Retrospective spec ${itemRef} has verification metadata but status is not implemented/verified`,
  1036→          details:
  1037→            "Retrospective specs with verified_at/verified_by should have implementation status set to 'implemented' or 'verified'",
  1038→        });
  1039→      }
  1040→    }
  1041→  }
  1042→
  1043→  return warnings;
  1044→}
  1045→
  1046→// ============================================================
  1047→// AC SCHEMA DRIFT DETECTION
  1048→// ============================================================
  1049→
  1050→/**
  1051→ * Known schema fields for SpecItem
  1052→ * These are the actual fields defined in SpecItemSchema
  1053→ */
  1054→const SPEC_ITEM_FIELDS = new Set([
  1055→  "_ulid",
  1056→  "slugs",
  1057→  "title",
  1058→  "type",
  1059→  "status",
  1060→  "maturity",
  1061→  "implementation",
  1062→  "priority",
  1063→  "tags",
  1064→  "description",
  1065→  "acceptance_criteria",
  1066→  "depends_on",
  1067→  "implements",
  1068→  "relates_to",
  1069→  "tests",
  1070→  "traits",
  1071→  "supersedes",
  1072→  "traceability",
  1073→  "created",
  1074→  "created_by",
  1075→  "deprecated_in",
  1076→  "superseded_by",
  1077→  "verified_at",
  1078→  "verified_by",
  1079→  "notes",
  1080→]);
  1081→
  1082→/**
  1083→ * Known schema fields for Task
  1084→ * These are the actual fields defined in TaskSchema
  1085→ */
  1086→const TASK_FIELDS = new Set([
  1087→  "_ulid",
  1088→  "slugs",
  1089→  "title",
  1090→  "type",
  1091→  "description",
  1092→  "spec_ref",
  1093→  "derivation",
  1094→  "meta_ref",
  1095→  "plan_ref",
  1096→  "origin",
  1097→  "status",
  1098→  "blocked_by",
  1099→  "closed_reason",
  1100→  "depends_on",
  1101→  "context",
  1102→  "priority",
  1103→  "complexity",
  1104→  "tags",
  1105→  "assignee",
  1106→  "vcs_refs",
  1107→  "created_at",
  1108→  "started_at",
  1109→  "completed_at",
  1110→  "notes",
  1111→  "todos",
  1112→  "automation",
  1113→]);
  1114→
  1115→/**
  1116→ * Known fields that are referenced but are parse-time or conceptual only
  1117→ * These are common pseudo-fields that ACs reference but don't exist in schema
  1118→ */
  1119→const CONCEPTUAL_FIELDS = new Set([
  1120→  "children", // Hierarchy is parse-time only
  1121→  "parent", // Parent references are derived, not stored
  1122→  "modules", // These are container structures in YAML, not item fields
  1123→  "features",
  1124→  "requirements",
  1125→  "constraints",
  1126→  "decisions",
  1127→  "epics",
  1128→  "themes",
  1129→  "capabilities",
  1130→]);
  1131→
  1132→/**
  1133→ * Extract field reference patterns from AC text
  1134→ * Looks for patterns like:
  1135→ * - item.field
  1136→ * - spec.field
  1137→ * - task.field
  1138→ * - status.field
  1139→ * - spec_ref.field
  1140→ * - the field
  1141→ * - their field
  1142→ * - item's field
  1143→ */
  1144→/**
  1145→ * File extensions to exclude from field matching
  1146→ * These are common file extensions that would otherwise match our patterns
  1147→ */
  1148→const FILE_EXTENSIONS = new Set([
  1149→  "yaml",
  1150→  "yml",
  1151→  "json",
  1152→  "js",
  1153→  "ts",
  1154→  "md",
  1155→  "txt",
  1156→  "html",
  1157→  "css",
  1158→  "log",
  1159→]);
  1160→
  1161→function extractFieldReferences(text: string): Array<{ context: string; field: string }> {
  1162→  const references: Array<{ context: string; field: string }> = [];
  1163→
  1164→  // Pattern: context.field (e.g., item.status, spec_ref.children)
  1165→  // This matches entity.property patterns in prose
  1166→  const dotPattern = /\b(item|spec|task|status|spec_ref|task_ref|meta_ref|plan_ref)\.(\w+)/gi;
  1167→  let match: RegExpExecArray | null;
  1168→  while ((match = dotPattern.exec(text)) !== null) {
  1169→    const field = match[2].toLowerCase();
  1170→    // Skip file extensions (e.g., spec.yaml, task.json)
  1171→    if (FILE_EXTENSIONS.has(field)) {
  1172→      continue;
  1173→    }
  1174→    references.push({ context: match[1].toLowerCase(), field });
  1175→  }
  1176→
  1177→  // Pattern: "the <field>" when discussing items/tasks (common in ACs)
  1178→  // Only match known schema-like words to avoid false positives
  1179→  const thePattern = /\bthe\s+(status|children|parent|spec_ref|depends_on|traits|tags|notes|todos|acceptance_criteria)\b/gi;
  1180→  while ((match = thePattern.exec(text)) !== null) {
  1181→    references.push({ context: "item", field: match[1].toLowerCase() });
  1182→  }
  1183→
  1184→  return references;
  1185→}
  1186→
  1187→/**
  1188→ * Check if a field exists in the appropriate schema
  1189→ */
  1190→function isValidSchemaField(context: string, field: string): { valid: boolean; reason?: string } {
  1191→  // If it's a known conceptual field, it's technically invalid but we can give a specific message
  1192→  if (CONCEPTUAL_FIELDS.has(field)) {
  1193→    return { valid: false, reason: `'${field}' is a parse-time/conceptual field, not stored in schema` };
  1194→  }
  1195→
  1196→  // Check based on context
  1197→  switch (context) {
  1198→    case "spec":
  1199→    case "item":
  1200→      if (SPEC_ITEM_FIELDS.has(field)) {
  1201→        return { valid: true };
  1202→      }
  1203→      break;
  1204→
  1205→    case "task":
  1206→      if (TASK_FIELDS.has(field)) {
  1207→        return { valid: true };
  1208→      }
  1209→      break;
  1210→
  1211→    case "status":
  1212→      // status.maturity, status.implementation are valid for specs
  1213→      if (field === "maturity" || field === "implementation") {
  1214→        return { valid: true };
  1215→      }
  1216→      break;
  1217→
  1218→    case "spec_ref":
  1219→    case "task_ref":
  1220→    case "meta_ref":
  1221→    case "plan_ref":
  1222→      // These are string references, not objects with fields
  1223→      return { valid: false, reason: `'${context}' is a reference string, not an object with fields` };
  1224→  }
  1225→
  1226→  // Check if field exists in either schema (might be ambiguous context)
  1227→  if (SPEC_ITEM_FIELDS.has(field) || TASK_FIELDS.has(field)) {
  1228→    return { valid: true };
  1229→  }
  1230→
  1231→  return { valid: false, reason: `'${field}' is not a known schema field` };
  1232→}
  1233→
  1234→/**
  1235→ * Check acceptance criteria for field references that don't exist in schema
  1236→ * Catches drift between spec prose and implementation reality.
  1237→ */
  1238→export function checkACSchemaReferences(
  1239→  items: LoadedSpecItem[],
  1240→): CompletenessWarning[] {
  1241→  const warnings: CompletenessWarning[] = [];
  1242→
  1243→  for (const item of items) {
  1244→    if (!item.acceptance_criteria || item.acceptance_criteria.length === 0) {
  1245→      continue;
  1246→    }
  1247→
  1248→    const itemRef = item.slugs?.[0]
  1249→      ? `@${item.slugs[0]}`
  1250→      : `@${item._ulid.slice(0, 8)}`;
  1251→
  1252→    for (const ac of item.acceptance_criteria) {
  1253→      // Check all three parts of the AC for field references
  1254→      const textToCheck = `${ac.given} ${ac.when} ${ac.then}`;
  1255→      const fieldRefs = extractFieldReferences(textToCheck);
  1256→
  1257→      for (const { context, field } of fieldRefs) {
  1258→        const result = isValidSchemaField(context, field);
  1259→        if (!result.valid) {
  1260→          warnings.push({
  1261→            type: "ac_schema_field_mismatch",
  1262→            itemRef,
  1263→            itemTitle: item.title,
  1264→            message: `AC ${ac.id} references '${context}.${field}' which doesn't exist in schema`,
  1265→            details: result.reason,
  1266→          });
  1267→        }
  1268→      }
  1269→    }
  1270→  }
  1271→
  1272→  return warnings;
  1273→}
  1274→
  1275→// ============================================================
  1276→// SKILL CONTENT VALIDATION
  1277→// ============================================================
  1278→
  1279→/**
  1280→ * Validate that skill meta entries have corresponding SKILL.md files.
  1281→ * AC: @skill-content-model ac-3 - missing content file reports validation error
  1282→ */
  1283→async function validateSkillContentFiles(
  1284→  ctx: KspecContext,
  1285→  skills: LoadedSkill[],
  1286→): Promise<SchemaValidationError[]> {
  1287→  const errors: SchemaValidationError[] = [];
  1288→
  1289→  for (const skill of skills) {
  1290→    const contentPath = getSkillContentPath(ctx, skill.id);
  1291→
  1292→    try {
  1293→      await fs.access(contentPath);
  1294→    } catch {
  1295→      // File doesn't exist - report validation error
  1296→      errors.push({
  1297→        file: skill._sourceFile || "kynetic.meta.yaml",
  1298→        path: `skills.${skill.id}`,
  1299→        message: `Skill '${skill.id}' is missing content file at ${contentPath}`,
  1300→      });
  1301→    }
  1302→  }
  1303→
  1304→  return errors;
  1305→}
  1306→
  1307→// ============================================================
  1308→// AUTOMATION VALIDATION
  1309→// ============================================================
  1310→
  1311→/**
  1312→ * Check task automation status for warnings
  1313→ * AC: @task-automation-eligibility ac-21, ac-23
  1314→ */
  1315→function checkAutomationEligibility(
  1316→  tasks: LoadedTask[],
  1317→  index: ReferenceIndex,
  1318→): CompletenessWarning[] {
  1319→  const warnings: CompletenessWarning[] = [];
  1320→
  1321→  for (const task of tasks) {
  1322→    const taskRef = task.slugs?.[0]
  1323→      ? `@${task.slugs[0]}`
  1324→      : `@${task._ulid.slice(0, 8)}`;
  1325→
  1326→    // AC: @task-automation-eligibility ac-21
  1327→    // Warn if eligible but no spec_ref
  1328→    if (task.automation === "eligible" && !task.spec_ref) {
  1329→      warnings.push({
  1330→        type: "automation_eligible_no_spec",
  1331→        itemRef: taskRef,
  1332→        itemTitle: task.title,
  1333→        message: `Task ${taskRef} is automation: eligible but has no spec_ref - eligible tasks should have linked specs`,
  1334→      });
  1335→    }
  1336→
  1337→    // AC: @task-automation-eligibility ac-23
  1338→    // Warn if eligible but spec_ref doesn't resolve
  1339→    if (task.automation === "eligible" && task.spec_ref) {
  1340→      const specResult = index.resolve(task.spec_ref);
  1341→      if (!specResult.ok) {
  1342→        warnings.push({
  1343→          type: "automation_eligible_no_spec",
  1344→          itemRef: taskRef,
  1345→          itemTitle: task.title,
  1346→          message: `Task ${taskRef} is automation: eligible but spec_ref ${task.spec_ref} cannot be resolved`,
  1347→        });
  1348→      }
  1349→    }
  1350→  }
  1351→
  1352→  return warnings;
  1353→}
  1354→
  1355→// ============================================================
  1356→// SKILL VALIDATION
  1357→// ============================================================
  1358→
  1359→/**
  1360→ * Validate skill depends_on references
  1361→ * AC: @skill-validation ac-2 - broken depends_on ref reports warning
  1362→ */
  1363→function validateSkillDependsOn(
  1364→  skills: LoadedSkill[],
  1365→  index: ReferenceIndex,
  1366→): RefValidationWarning[] {
  1367→  const warnings: RefValidationWarning[] = [];
  1368→
  1369→  for (const skill of skills) {
  1370→    if (!skill.depends_on || skill.depends_on.length === 0) {
  1371→      continue;
  1372→    }
  1373→
  1374→    for (const depRef of skill.depends_on) {
  1375→      const result = index.resolve(depRef);
  1376→      if (!result.ok) {
  1377→        warnings.push({
  1378→          ref: depRef,
  1379→          sourceFile: skill._sourceFile,
  1380→          sourceUlid: skill._ulid,
  1381→          field: "depends_on",
  1382→          warning: "deprecated_target", // Reuse warning type for broken refs
  1383→          message: `Skill '${skill.id}' depends_on reference '${depRef}' cannot be resolved`,
  1384→        });
  1385→      } else {
  1386→        // Check that the resolved item is actually a skill (uses _type discriminant)
  1387→        if (!isSkill(result.item)) {
  1388→          warnings.push({
  1389→            ref: depRef,
  1390→            sourceFile: skill._sourceFile,
  1391→            sourceUlid: skill._ulid,
  1392→            field: "depends_on",
  1393→            warning: "deprecated_target",
  1394→            message: `Skill '${skill.id}' depends_on reference '${depRef}' points to non-skill item`,
  1395→          });
  1396→        }
  1397→      }
  1398→    }
  1399→  }
  1400→
  1401→  return warnings;
  1402→}
  1403→
  1404→/**
  1405→ * Find orphaned skill directories (directories with no corresponding meta entry)
  1406→ * AC: @skill-validation ac-3 - orphaned directory reports warning
  1407→ */
  1408→async function findOrphanedSkillDirectories(
  1409→  ctx: KspecContext,
  1410→  skills: LoadedSkill[],
  1411→): Promise<RefValidationWarning[]> {
  1412→  const warnings: RefValidationWarning[] = [];
  1413→  const skillsDir = path.join(ctx.specDir, "skills");
  1414→
  1415→  try {
  1416→    // Check if skills directory exists
  1417→    await fs.access(skillsDir);
  1418→
  1419→    // Read all directories in skills/
  1420→    const entries = await fs.readdir(skillsDir, { withFileTypes: true });
  1421→    const directories = entries.filter(entry => entry.isDirectory());
  1422→
  1423→    // Build set of skill IDs from meta
  1424→    const skillIds = new Set(skills.map(s => s.id));
  1425→
  1426→    // Find orphaned directories
  1427→    for (const dir of directories) {
  1428→      if (!skillIds.has(dir.name)) {
  1429→        warnings.push({
  1430→          ref: `@${dir.name}`,
  1431→          sourceFile: path.join(skillsDir, dir.name),
  1432→          field: "directory",
  1433→          warning: "deprecated_target", // Reuse warning type
  1434→          message: `Orphaned skill directory '${dir.name}' has no corresponding meta entry`,
  1435→        });
  1436→      }
  1437→    }
  1438→  } catch {
  1439→    // Skills directory doesn't exist - that's fine
  1440→  }
  1441→
  1442→  return warnings;
  1443→}
  1444→
  1445→// ============================================================
  1446→// MAIN VALIDATION
  1447→// ============================================================
  1448→
  1449→/**
  1450→ * Run full validation on a kspec project
  1451→ */
  1452→export async function validate(
  1453→  ctx: KspecContext,
  1454→  options: ValidateOptions = {},
  1455→): Promise<ValidationResult> {
  1456→  // Default: run all checks
  1457→  const runSchema = options.schema !== false;
  1458→  const runRefs = options.refs !== false;
  1459→  const runOrphans = options.orphans !== false;
  1460→  const runCompleteness = options.completeness !== false;
  1461→
  1462→  const result: ValidationResult = {
  1463→    valid: true,
  1464→    schemaErrors: [],
  1465→    refErrors: [],
  1466→    refWarnings: [],
  1467→    orphans: [],
  1468→    completenessWarnings: [],
  1469→    traitCycleErrors: [],
  1470→    stats: {
  1471→      filesChecked: 0,
  1472→      itemsChecked: 0,
  1473→      tasksChecked: 0,
  1474→    },
  1475→  };
  1476→
  1477→  const allTasks: LoadedTask[] = [];
  1478→  const allItems: LoadedSpecItem[] = [];
  1479→
  1480→  // Validate manifest
  1481→  if (ctx.manifestPath && runSchema) {
  1482→    const manifestErrors = await validateManifestFile(ctx.manifestPath);
  1483→    result.schemaErrors.push(...manifestErrors);
  1484→    result.stats.filesChecked++;
  1485→  }
  1486→
  1487→  // Load items from manifest (traits, inline modules, etc.)
  1488→  if (ctx.manifest && ctx.manifestPath) {
  1489→    const manifestItems = extractItemsFromRaw(ctx.manifest, ctx.manifestPath);
  1490→    allItems.push(...manifestItems);
  1491→    result.stats.itemsChecked += manifestItems.length;
  1492→  }
  1493→
  1494→  // Find and validate task files
  1495→  const taskFiles = await findTaskFiles(ctx.rootDir);
  1496→  const specTaskFiles = await findTaskFiles(path.join(ctx.rootDir, "spec"));
  1497→  const allTaskFiles = [...new Set([...taskFiles, ...specTaskFiles])];
  1498→
  1499→  for (const taskFile of allTaskFiles) {
  1500→    if (runSchema) {
  1501→      const taskErrors = await validateTasksFile(taskFile);
  1502→      result.schemaErrors.push(...taskErrors);
  1503→    }
  1504→    result.stats.filesChecked++;
  1505→
  1506→    // Load tasks for ref validation
  1507→    try {
  1508→      const raw = await readYamlFile<unknown>(taskFile);
  1509→      let taskList: unknown[] = [];
  1510→
  1511→      if (Array.isArray(raw)) {
  1512→        taskList = raw;
  1513→      } else if (raw && typeof raw === "object" && "tasks" in raw) {
  1514→        taskList = (raw as { tasks: unknown[] }).tasks || [];
  1515→      }
  1516→
  1517→      for (const t of taskList) {
  1518→        const parsed = TaskSchema.safeParse(t);
  1519→        if (parsed.success) {
  1520→          allTasks.push({ ...parsed.data, _sourceFile: taskFile });
  1521→          result.stats.tasksChecked++;
  1522→        }
  1523→      }
  1524→    } catch {
  1525→      // Already reported in schema validation
  1526→    }
  1527→  }
  1528→
  1529→  // Validate spec files (from includes)
  1530→  if (ctx.manifest && ctx.manifestPath) {
  1531→    const manifestDir = path.dirname(ctx.manifestPath);
  1532→    const includes = ctx.manifest.includes || [];
  1533→
  1534→    for (const include of includes) {
  1535→      const expandedPaths = await expandIncludePattern(include, manifestDir);
  1536→
  1537→      for (const filePath of expandedPaths) {
  1538→        if (runSchema) {
  1539→          const specErrors = await validateSpecFile(filePath);
  1540→          result.schemaErrors.push(...specErrors);
  1541→        }
  1542→        result.stats.filesChecked++;
  1543→
  1544→        // Load items for ref validation
  1545→        try {
  1546→          const items = await loadSpecFile(filePath);
  1547→          allItems.push(...items);
  1548→          result.stats.itemsChecked += items.length;
  1549→        } catch {
  1550→          // Already reported in schema validation
  1551→        }
  1552→      }
  1553→    }
  1554→  }
  1555→
  1556→  // Load meta items for reference validation
  1557→  // AC: @agent-definitions ac-agent-3
  1558→  const metaCtx = await loadMetaContext(ctx);
  1559→  const allMetaItems = [
  1560→    ...metaCtx.agents,
  1561→    ...metaCtx.workflows,
  1562→    ...metaCtx.conventions,
  1563→    ...metaCtx.observations,
  1564→    ...metaCtx.skills, // Include skills for reference indexing
  1565→  ];
  1566→
  1567→  // Load plans for reference validation
  1568→  // AC: @plan-validation ac-10
  1569→  const allPlans = await loadPlans(ctx);
  1570→
  1571→  // Reference validation
  1572→  if (
  1573→    runRefs &&
  1574→    (allTasks.length > 0 ||
  1575→      allItems.length > 0 ||
  1576→      allMetaItems.length > 0 ||
  1577→      allPlans.length > 0)
  1578→  ) {
  1579→    const index = new ReferenceIndex(
  1580→      allTasks,
  1581→      allItems,
  1582→      allMetaItems,
  1583→      allPlans,
  1584→    );
  1585→    const refResult = validateRefs(index, allTasks, allItems);
  1586→    result.refErrors = refResult.errors;
  1587→    result.refWarnings = refResult.warnings;
  1588→
  1589→    // AC: @skill-validation ac-2 - validate skill depends_on references
  1590→    const skillDependsOnWarnings = validateSkillDependsOn(metaCtx.skills, index);
  1591→    result.refWarnings.push(...skillDependsOnWarnings);
  1592→
  1593→    // AC: @trait-edge-cases ac-2
  1594→    // Detect circular trait references
  1595→    result.traitCycleErrors = detectTraitCycles(allItems, index);
  1596→
  1597→    // Orphan detection
  1598→    if (runOrphans) {
  1599→      result.orphans = findOrphans(allTasks, allItems, index);
  1600→    }
  1601→
  1602→    // Completeness validation
  1603→    // AC: @spec-completeness ac-1, ac-2, ac-3
  1604→    // AC: @trait-validation ac-3
  1605→    if (runCompleteness) {
  1606→      // Build trait index for trait AC coverage validation
  1607→      const traitIndex = new TraitIndex(allItems, index);
  1608→      result.completenessWarnings = await checkCompleteness(
  1609→        allItems,
  1610→        index,
  1611→        ctx.rootDir,
  1612→        traitIndex,
  1613→      );
  1614→
  1615→      // AC: @task-automation-eligibility ac-21, ac-23
  1616→      // Check automation eligibility warnings for tasks
  1617→      const automationWarnings = checkAutomationEligibility(allTasks, index);
  1618→      result.completenessWarnings.push(...automationWarnings);
  1619→    }
  1620→  }
  1621→
  1622→  // Meta manifest validation (AC-meta-manifest-2, AC-meta-manifest-3)
  1623→  const metaManifestPath = await findMetaManifest(ctx.specDir);
  1624→  if (metaManifestPath) {
  1625→    // Use metaCtx already loaded above
  1626→    result.metaStats = {
  1627→      agents: metaCtx.agents.length,
  1628→      workflows: metaCtx.workflows.length,
  1629→      conventions: metaCtx.conventions.length,
  1630→      observations: metaCtx.observations.length,
  1631→      skills: metaCtx.skills.length,
  1632→    };
  1633→
  1634→    // Validate meta manifest schema with strict ULID validation
  1635→    if (runSchema) {
  1636→      const metaErrors = await validateMetaManifestFile(metaManifestPath);
  1637→      // Prefix all meta errors with "meta:"
  1638→      for (const err of metaErrors) {
  1639→        err.path = err.path ? `meta:${err.path}` : "meta:";
  1640→      }
  1641→      result.schemaErrors.push(...metaErrors);
  1642→      result.stats.filesChecked++;
  1643→
  1644→      // AC: @skill-content-model ac-3 - validate skill content files exist
  1645→      if (metaCtx.skills.length > 0) {
  1646→        const skillContentErrors = await validateSkillContentFiles(ctx, metaCtx.skills);
  1647→        result.schemaErrors.push(...skillContentErrors);
  1648→      }
  1649→
  1650→      // AC: @skill-validation ac-3 - detect orphaned skill directories
  1651→      const orphanedSkillWarnings = await findOrphanedSkillDirectories(ctx, metaCtx.skills);
  1652→      result.refWarnings.push(...orphanedSkillWarnings);
  1653→    }
  1654→  }
  1655→
  1656→  // Set valid flag
  1657→  result.valid =
  1658→    result.schemaErrors.length === 0 &&
  1659→    result.refErrors.length === 0 &&
  1660→    result.traitCycleErrors.length === 0;
  1661→
  1662→  return result;
  1663→}
  1664→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
