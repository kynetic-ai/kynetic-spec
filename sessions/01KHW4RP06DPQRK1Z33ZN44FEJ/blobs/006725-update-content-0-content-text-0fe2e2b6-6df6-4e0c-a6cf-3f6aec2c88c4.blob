```
     1→/**
     2→ * Shadow branch utilities for transparent spec/task state tracking.
     3→ *
     4→ * Shadow branch concept:
     5→ * - Orphan branch (kspec-meta) stores kspec state
     6→ * - .kspec/ directory is a git worktree pointing to shadow branch
     7→ * - Main branch gitignores .kspec/
     8→ * - All kspec read/write operations target .kspec/
     9→ * - Changes auto-commit to shadow branch
    10→ */
    11→
    12→import { exec, execSync } from "node:child_process";
    13→import * as fs from "node:fs/promises";
    14→import * as path from "node:path";
    15→import { promisify } from "node:util";
    16→import { fileURLToPath } from "node:url";
    17→import { isBatchMode } from "../cli/batch-context.js";
    18→
    19→const __filename = fileURLToPath(import.meta.url);
    20→const __dirname = path.dirname(__filename);
    21→
    22→const execAsync = promisify(exec);
    23→
    24→// Import getVerboseMode for checking CLI --debug-shadow flag
    25→// We use a getter function to avoid issues with circular dependencies
    26→let getVerboseModeFunc: (() => boolean) | null = null;
    27→
    28→export function setVerboseModeGetter(getter: () => boolean): void {
    29→  getVerboseModeFunc = getter;
    30→}
    31→
    32→/**
    33→ * Shadow branch configuration
    34→ */
    35→export interface ShadowConfig {
    36→  /** Whether shadow branch is enabled/detected */
    37→  enabled: boolean;
    38→  /** Path to .kspec/ worktree directory */
    39→  worktreeDir: string;
    40→  /** Shadow branch name (default: kspec-meta) */
    41→  branchName: string;
    42→  /** Project root (where .kspec/ lives) */
    43→  projectRoot: string;
    44→}
    45→
    46→/**
    47→ * Shadow branch status
    48→ */
    49→export interface ShadowStatus {
    50→  exists: boolean;
    51→  healthy: boolean;
    52→  branchExists: boolean;
    53→  worktreeExists: boolean;
    54→  worktreeLinked: boolean;
    55→  error?: string;
    56→}
    57→
    58→/**
    59→ * Error types for shadow branch issues
    60→ */
    61→export class ShadowError extends Error {
    62→  constructor(
    63→    message: string,
    64→    public code:
    65→      | "NOT_INITIALIZED"
    66→      | "WORKTREE_DISCONNECTED"
    67→      | "DIRECTORY_MISSING"
    68→      | "GIT_ERROR"
    69→      | "RUNNING_FROM_SHADOW",
    70→    public suggestion: string,
    71→  ) {
    72→    super(message);
    73→    this.name = "ShadowError";
    74→  }
    75→}
    76→
    77→/**
    78→ * Default shadow branch name
    79→ */
    80→export const SHADOW_BRANCH_NAME = "kspec-meta";
    81→
    82→/**
    83→ * Default shadow worktree directory
    84→ */
    85→export const SHADOW_WORKTREE_DIR = ".kspec";
    86→
    87→/**
    88→ * Check if debug mode is enabled.
    89→ * Debug mode can be enabled via:
    90→ * - KSPEC_DEBUG=1 environment variable
    91→ * - Verbose flag (passed from CLI --debug-shadow option)
    92→ *
    93→ * When enabled, shadow branch operations output detailed information.
    94→ */
    95→export function isDebugMode(verboseFlag?: boolean): boolean {
    96→  if (process.env.KSPEC_DEBUG === "1") {
    97→    return true;
    98→  }
    99→  if (verboseFlag === true) {
   100→    return true;
   101→  }
   102→  // Check CLI --debug-shadow flag via getter
   103→  if (getVerboseModeFunc?.()) {
   104→    return true;
   105→  }
   106→  return false;
   107→}
   108→
   109→/**
   110→ * Check if we're in a git repository
   111→ */
   112→export async function isGitRepo(dir: string): Promise<boolean> {
   113→  try {
   114→    execSync("git rev-parse --git-dir", {
   115→      cwd: dir,
   116→      stdio: ["pipe", "pipe", "pipe"],
   117→      encoding: "utf-8",
   118→    });
   119→    return true;
   120→  } catch {
   121→    return false;
   122→  }
   123→}
   124→
   125→/**
   126→ * Get the git root directory
   127→ */
   128→export function getGitRoot(dir: string): string | null {
   129→  try {
   130→    const result = execSync("git rev-parse --show-toplevel", {
   131→      cwd: dir,
   132→      stdio: ["pipe", "pipe", "pipe"],
   133→      encoding: "utf-8",
   134→    }).trim();
   135→    return result;
   136→  } catch {
   137→    return null;
   138→  }
   139→}
   140→
   141→/**
   142→ * Check if a branch exists
   143→ */
   144→export async function branchExists(
   145→  dir: string,
   146→  branchName: string,
   147→): Promise<boolean> {
   148→  try {
   149→    execSync(`git show-ref --verify --quiet refs/heads/${branchName}`, {
   150→      cwd: dir,
   151→      stdio: ["pipe", "pipe", "pipe"],
   152→    });
   153→    return true;
   154→  } catch {
   155→    return false;
   156→  }
   157→}
   158→
   159→/**
   160→ * Check if a directory is a valid git worktree
   161→ */
   162→export async function isValidWorktree(worktreeDir: string): Promise<boolean> {
   163→  try {
   164→    // Check if .git file exists (worktrees have a .git file, not directory)
   165→    const gitPath = path.join(worktreeDir, ".git");
   166→    const stat = await fs.stat(gitPath);
   167→
   168→    if (stat.isFile()) {
   169→      // Read the .git file to verify it points to a worktree
   170→      const content = await fs.readFile(gitPath, "utf-8");
   171→      return content.trim().startsWith("gitdir:");
   172→    }
   173→
   174→    return false;
   175→  } catch {
   176→    return false;
   177→  }
   178→}
   179→
   180→/**
   181→ * Detect if running from inside the shadow worktree directory.
   182→ * Returns the main project root if detected, null otherwise.
   183→ *
   184→ * Detection logic:
   185→ * 1. Check if .git is a file (worktrees have .git files, not directories)
   186→ * 2. Read the gitdir reference from the .git file
   187→ * 3. Check if it points to a worktree for .kspec (pattern: <project>/.git/worktrees/-kspec)
   188→ */
   189→export async function detectRunningFromShadowWorktree(
   190→  cwd: string,
   191→): Promise<string | null> {
   192→  try {
   193→    const gitPath = path.join(cwd, ".git");
   194→    const stat = await fs.stat(gitPath);
   195→
   196→    // Worktrees have a .git file, not directory
   197→    if (!stat.isFile()) {
   198→      return null;
   199→    }
   200→
   201→    const content = await fs.readFile(gitPath, "utf-8");
   202→    const match = content.trim().match(/^gitdir:\s*(.+)$/);
   203→    if (!match) {
   204→      return null;
   205→    }
   206→
   207→    const gitdir = match[1];
   208→
   209→    // Check if this is a shadow worktree (pattern: <project>/.git/worktrees/-kspec)
   210→    if (gitdir.includes(".git/worktrees/")) {
   211→      const worktreesMatch = gitdir.match(/^(.+)\/\.git\/worktrees\//);
   212→      if (worktreesMatch) {
   213→        const mainProjectRoot = worktreesMatch[1];
   214→        const cwdBase = path.basename(cwd);
   215→        const worktreeName = path.basename(gitdir);
   216→
   217→        if (cwdBase === SHADOW_WORKTREE_DIR || worktreeName.includes("kspec")) {
   218→          return mainProjectRoot;
   219→        }
   220→      }
   221→    }
   222→
   223→    return null;
   224→  } catch {
   225→    return null;
   226→  }
   227→}
   228→
   229→/**
   230→ * Detect shadow branch configuration from a directory.
   231→ * Returns shadow config if .kspec/ exists and is valid.
   232→ */
   233→export async function detectShadow(
   234→  startDir: string,
   235→): Promise<ShadowConfig | null> {
   236→  const gitRoot = getGitRoot(startDir);
   237→  if (!gitRoot) {
   238→    return null;
   239→  }
   240→
   241→  const worktreeDir = path.join(gitRoot, SHADOW_WORKTREE_DIR);
   242→
   243→  try {
   244→    await fs.access(worktreeDir);
   245→
   246→    // Verify it's a valid worktree
   247→    if (await isValidWorktree(worktreeDir)) {
   248→      return {
   249→        enabled: true,
   250→        worktreeDir,
   251→        branchName: SHADOW_BRANCH_NAME,
   252→        projectRoot: gitRoot,
   253→      };
   254→    }
   255→
   256→    // Directory exists but not a valid worktree
   257→    return null;
   258→  } catch {
   259→    // .kspec/ doesn't exist
   260→    return null;
   261→  }
   262→}
   263→
   264→/**
   265→ * Get detailed shadow branch status
   266→ */
   267→export async function getShadowStatus(
   268→  projectRoot: string,
   269→): Promise<ShadowStatus> {
   270→  const worktreeDir = path.join(projectRoot, SHADOW_WORKTREE_DIR);
   271→
   272→  const status: ShadowStatus = {
   273→    exists: false,
   274→    healthy: false,
   275→    branchExists: false,
   276→    worktreeExists: false,
   277→    worktreeLinked: false,
   278→  };
   279→
   280→  // Check if we're in a git repo
   281→  if (!(await isGitRepo(projectRoot))) {
   282→    status.error = "Not a git repository";
   283→    return status;
   284→  }
   285→
   286→  // Check if branch exists
   287→  status.branchExists = await branchExists(projectRoot, SHADOW_BRANCH_NAME);
   288→
   289→  // Check if worktree directory exists
   290→  try {
   291→    await fs.access(worktreeDir);
   292→    status.worktreeExists = true;
   293→  } catch {
   294→    status.worktreeExists = false;
   295→  }
   296→
   297→  // Check if worktree is properly linked
   298→  if (status.worktreeExists) {
   299→    status.worktreeLinked = await isValidWorktree(worktreeDir);
   300→  }
   301→
   302→  // Determine overall status
   303→  status.exists = status.branchExists || status.worktreeExists;
   304→  status.healthy =
   305→    status.branchExists && status.worktreeExists && status.worktreeLinked;
   306→
   307→  if (!status.healthy && status.exists) {
   308→    if (!status.branchExists) {
   309→      status.error = "Shadow branch missing but worktree exists";
   310→    } else if (!status.worktreeExists) {
   311→      status.error = "Shadow branch exists but worktree missing";
   312→    } else if (!status.worktreeLinked) {
   313→      status.error = "Worktree exists but not properly linked";
   314→    }
   315→  }
   316→
   317→  return status;
   318→}
   319→
   320→/**
   321→ * Create an appropriate ShadowError based on status
   322→ */
   323→export function createShadowError(status: ShadowStatus): ShadowError {
   324→  if (!status.branchExists && !status.worktreeExists) {
   325→    return new ShadowError(
   326→      "Shadow branch not initialized",
   327→      "NOT_INITIALIZED",
   328→      "Run `kspec init` to create shadow branch and worktree.",
   329→    );
   330→  }
   331→
   332→  if (status.branchExists && !status.worktreeExists) {
   333→    return new ShadowError(
   334→      ".kspec/ directory missing",
   335→      "DIRECTORY_MISSING",
   336→      "Run `kspec shadow repair` to recreate the worktree.",
   337→    );
   338→  }
   339→
   340→  if (status.worktreeExists && !status.worktreeLinked) {
   341→    return new ShadowError(
   342→      "Worktree disconnected from git",
   343→      "WORKTREE_DISCONNECTED",
   344→      "Run `kspec shadow repair` to fix the worktree link.",
   345→    );
   346→  }
   347→
   348→  return new ShadowError(
   349→    status.error || "Unknown shadow branch error",
   350→    "GIT_ERROR",
   351→    "Check git status and try `kspec shadow repair`.",
   352→  );
   353→}
   354→
   355→/**
   356→ * Auto-commit changes to shadow branch.
   357→ * Called after write operations when shadow is enabled.
   358→ *
   359→ * @param worktreeDir Path to .kspec/ directory
   360→ * @param message Commit message
   361→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   362→ * @returns true if commit succeeded, false if nothing to commit
   363→ */
   364→export async function shadowAutoCommit(
   365→  worktreeDir: string,
   366→  message: string,
   367→  verbose?: boolean,
   368→): Promise<boolean> {
   369→  const debug = isDebugMode(verbose);
   370→
   371→  try {
   372→    if (debug) {
   373→      console.error(
   374→        `[DEBUG] Shadow auto-commit: git add -A (cwd: ${worktreeDir})`,
   375→      );
   376→    }
   377→
   378→    // Stage all changes
   379→    execSync("git add -A", {
   380→      cwd: worktreeDir,
   381→      stdio: ["pipe", "pipe", "pipe"],
   382→    });
   383→
   384→    // Check if there are staged changes
   385→    try {
   386→      if (debug) {
   387→        console.error(`[DEBUG] Shadow auto-commit: git diff --cached --quiet`);
   388→      }
   389→
   390→      execSync("git diff --cached --quiet", {
   391→        cwd: worktreeDir,
   392→        stdio: ["pipe", "pipe", "pipe"],
   393→      });
   394→      // No error = no changes
   395→      if (debug) {
   396→        console.error(`[DEBUG] Shadow auto-commit: No changes to commit`);
   397→      }
   398→      return false;
   399→    } catch {
   400→      // Error = there are changes, proceed with commit
   401→    }
   402→
   403→    if (debug) {
   404→      console.error(`[DEBUG] Shadow auto-commit: git commit -m "${message}"`);
   405→    }
   406→
   407→    // Commit with message
   408→    // Set KSPEC_SHADOW_COMMIT=1 to signal authorized commit to git hooks
   409→    execSync(`git commit -m "${message.replace(/"/g, '\\"')}"`, {
   410→      cwd: worktreeDir,
   411→      stdio: ["pipe", "pipe", "pipe"],
   412→      env: { ...process.env, KSPEC_SHADOW_COMMIT: "1" },
   413→    });
   414→
   415→    if (debug) {
   416→      console.error(`[DEBUG] Shadow auto-commit: Success`);
   417→    }
   418→
   419→    return true;
   420→  } catch (error) {
   421→    // AC: Only log error if debug mode enabled
   422→    if (debug) {
   423→      console.error("Shadow auto-commit failed:", error);
   424→    }
   425→    return false;
   426→  }
   427→}
   428→
   429→/**
   430→ * Generate commit message for a kspec operation.
   431→ */
   432→export function generateCommitMessage(
   433→  operation: string,
   434→  ref?: string,
   435→  detail?: string,
   436→): string {
   437→  const parts: string[] = [];
   438→
   439→  switch (operation) {
   440→    case "task-start":
   441→      parts.push(`Start @${ref}`);
   442→      break;
   443→    case "task-complete":
   444→      parts.push(`Complete @${ref}`);
   445→      if (detail) parts.push(`: ${detail}`);
   446→      break;
   447→    case "task-note":
   448→      parts.push(`Note on @${ref}`);
   449→      break;
   450→    case "task-add":
   451→      parts.push(`Add task: ${detail || ref}`);
   452→      break;
   453→    case "inbox-add":
   454→      parts.push(
   455→        `Inbox: ${detail?.slice(0, 50)}${(detail?.length || 0) > 50 ? "..." : ""}`,
   456→      );
   457→      break;
   458→    case "inbox-promote":
   459→      parts.push(`Promote to @${ref}`);
   460→      break;
   461→    case "item-add":
   462→      parts.push(`Add @${ref}`);
   463→      break;
   464→    case "item-set":
   465→      parts.push(`Update @${ref}`);
   466→      break;
   467→    case "item-delete":
   468→      parts.push(`Delete @${ref}`);
   469→      break;
   470→    case "derive":
   471→      parts.push(`Derive from @${ref}`);
   472→      break;
   473→    default:
   474→      parts.push(operation);
   475→      if (ref) parts.push(` @${ref}`);
   476→  }
   477→
   478→  return parts.join("");
   479→}
   480→
   481→/**
   482→ * Resolve a path relative to shadow worktree if enabled.
   483→ * Falls back to original path if shadow is not enabled.
   484→ */
   485→export function resolveShadowPath(
   486→  originalPath: string,
   487→  shadowConfig: ShadowConfig | null,
   488→  projectRoot: string,
   489→): string {
   490→  if (!shadowConfig?.enabled) {
   491→    return originalPath;
   492→  }
   493→
   494→  // If the path is within the project root, rewrite to shadow worktree
   495→  const relativePath = path.relative(projectRoot, originalPath);
   496→
   497→  // Skip if path is outside project or already in .kspec
   498→  if (
   499→    relativePath.startsWith("..") ||
   500→    relativePath.startsWith(SHADOW_WORKTREE_DIR)
   501→  ) {
   502→    return originalPath;
   503→  }
   504→
   505→  // Handle spec/ -> .kspec/ mapping
   506→  if (relativePath.startsWith("spec/") || relativePath.startsWith("spec\\")) {
   507→    const specRelative = relativePath.slice(5); // Remove 'spec/'
   508→    return path.join(shadowConfig.worktreeDir, specRelative);
   509→  }
   510→
   511→  // For task/inbox files at root, move to .kspec
   512→  if (
   513→    relativePath.endsWith(".tasks.yaml") ||
   514→    relativePath.endsWith(".inbox.yaml")
   515→  ) {
   516→    return path.join(shadowConfig.worktreeDir, relativePath);
   517→  }
   518→
   519→  return originalPath;
   520→}
   521→
   522→/**
   523→ * Commit changes to shadow branch if enabled.
   524→ * This is the primary interface for CLI commands to trigger auto-commit.
   525→ *
   526→ * @param shadowConfig Shadow configuration (from KspecContext.shadow)
   527→ * @param operation Operation type (e.g., 'task-start', 'task-complete')
   528→ * @param ref Reference slug or ULID (optional)
   529→ * @param detail Additional detail for commit message (optional)
   530→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   531→ * @returns true if committed, false if shadow not enabled or nothing to commit
   532→ */
   533→export async function commitIfShadow(
   534→  shadowConfig: ShadowConfig | null,
   535→  operation: string,
   536→  ref?: string,
   537→  detail?: string,
   538→  verbose?: boolean,
   539→): Promise<boolean> {
   540→  // Suppress auto-commits during atomic batch execution
   541→  if (isBatchMode()) {
   542→    return false;
   543→  }
   544→
   545→  if (!shadowConfig?.enabled) {
   546→    return false;
   547→  }
   548→
   549→  const message = generateCommitMessage(operation, ref, detail);
   550→  const committed = await shadowAutoCommit(
   551→    shadowConfig.worktreeDir,
   552→    message,
   553→    verbose,
   554→  );
   555→
   556→  // AC: @shadow-sync ac-1 - Fire-and-forget push after each commit
   557→  if (committed) {
   558→    shadowPushAsync(shadowConfig.worktreeDir, verbose);
   559→  }
   560→
   561→  return committed;
   562→}
   563→
   564→/**
   565→ * Check if shadow is required but not available, and throw appropriate error.
   566→ * Use this at the start of commands that require shadow mode.
   567→ *
   568→ * @param shadowConfig Shadow configuration from context
   569→ * @param projectRoot Project root for status check
   570→ * @throws ShadowError if shadow is not properly configured
   571→ */
   572→export async function requireShadow(
   573→  shadowConfig: ShadowConfig | null,
   574→  projectRoot: string,
   575→): Promise<void> {
   576→  if (shadowConfig?.enabled) {
   577→    return; // Shadow is available
   578→  }
   579→
   580→  const status = await getShadowStatus(projectRoot);
   581→  throw createShadowError(status);
   582→}
   583→
   584→/**
   585→ * Format a ShadowError for display in CLI.
   586→ * Returns a user-friendly message with suggestion.
   587→ */
   588→export function formatShadowError(error: ShadowError): string {
   589→  return `${error.message}\n\nSuggestion: ${error.suggestion}`;
   590→}
   591→
   592→/**
   593→ * Result from shadow initialization
   594→ */
   595→export interface ShadowInitResult {
   596→  success: boolean;
   597→  branchCreated: boolean;
   598→  worktreeCreated: boolean;
   599→  gitignoreUpdated: boolean;
   600→  initialCommit: boolean;
   601→  alreadyExists: boolean;
   602→  /** Whether shadow was created from existing remote branch */
   603→  createdFromRemote: boolean;
   604→  /** Whether new branch was pushed to remote to establish tracking */
   605→  pushedToRemote: boolean;
   606→  error?: string;
   607→}
   608→
   609→/**
   610→ * Options for shadow initialization
   611→ */
   612→export interface ShadowInitOptions {
   613→  /** Project name for manifest */
   614→  projectName?: string;
   615→  /** Force reinitialize even if exists */
   616→  force?: boolean;
   617→}
   618→
   619→/**
   620→ * Check if a remote exists (default: origin)
   621→ */
   622→export async function hasRemote(
   623→  projectRoot: string,
   624→  remoteName = "origin",
   625→): Promise<boolean> {
   626→  try {
   627→    const { stdout } = await execAsync(`git remote get-url ${remoteName}`, {
   628→      cwd: projectRoot,
   629→    });
   630→    return stdout.trim().length > 0;
   631→  } catch {
   632→    return false;
   633→  }
   634→}
   635→
   636→/**
   637→ * Check if a branch exists on a remote
   638→ */
   639→export async function remoteBranchExists(
   640→  projectRoot: string,
   641→  branchName: string,
   642→  remoteName = "origin",
   643→): Promise<boolean> {
   644→  try {
   645→    execSync(
   646→      `git show-ref --verify --quiet refs/remotes/${remoteName}/${branchName}`,
   647→      {
   648→        cwd: projectRoot,
   649→        stdio: ["pipe", "pipe", "pipe"],
   650→      },
   651→    );
   652→    return true;
   653→  } catch {
   654→    return false;
   655→  }
   656→}
   657→
   658→/**
   659→ * Fetch from remote to ensure refs are up to date.
   660→ * Returns true if fetch succeeded, false otherwise.
   661→ */
   662→export async function fetchRemote(
   663→  projectRoot: string,
   664→  remoteName = "origin",
   665→): Promise<boolean> {
   666→  try {
   667→    await execAsync(`git fetch ${remoteName}`, {
   668→      cwd: projectRoot,
   669→    });
   670→    return true;
   671→  } catch {
   672→    return false;
   673→  }
   674→}
   675→
   676→/**
   677→ * Push shadow branch to remote with tracking.
   678→ * Returns true if push succeeded, false otherwise.
   679→ */
   680→export async function pushShadowBranch(
   681→  worktreeDir: string,
   682→  remoteName = "origin",
   683→): Promise<boolean> {
   684→  try {
   685→    await execAsync(`git push -u ${remoteName} ${SHADOW_BRANCH_NAME}`, {
   686→      cwd: worktreeDir,
   687→    });
   688→    return true;
   689→  } catch {
   690→    return false;
   691→  }
   692→}
   693→
   694→/**
   695→ * Check if shadow branch has remote tracking configured.
   696→ * AC-4: Used to determine whether sync should be attempted.
   697→ */
   698→export async function hasRemoteTracking(worktreeDir: string): Promise<boolean> {
   699→  try {
   700→    const { stdout } = await execAsync(
   701→      `git config branch.${SHADOW_BRANCH_NAME}.remote`,
   702→      { cwd: worktreeDir },
   703→    );
   704→    return stdout.trim().length > 0;
   705→  } catch {
   706→    return false;
   707→  }
   708→}
   709→
   710→/**
   711→ * Ensure shadow branch has remote tracking configured.
   712→ * AC-8: If shadow has no tracking but main branch has origin remote,
   713→ * automatically configure tracking to origin/kspec-meta.
   714→ *
   715→ * @param worktreeDir Path to .kspec/ worktree
   716→ * @param projectRoot Git repository root
   717→ * @returns true if tracking is now configured (was already or just set up)
   718→ */
   719→export async function ensureRemoteTracking(
   720→  worktreeDir: string,
   721→  projectRoot: string,
   722→): Promise<boolean> {
   723→  // Check if already has tracking
   724→  if (await hasRemoteTracking(worktreeDir)) {
   725→    return true;
   726→  }
   727→
   728→  // Check if main branch has origin remote
   729→  if (!(await hasRemote(projectRoot))) {
   730→    return false;
   731→  }
   732→
   733→  // Set up tracking for shadow branch to origin/kspec-meta
   734→  try {
   735→    await execAsync(`git config branch.${SHADOW_BRANCH_NAME}.remote origin`, {
   736→      cwd: worktreeDir,
   737→    });
   738→    await execAsync(
   739→      `git config branch.${SHADOW_BRANCH_NAME}.merge refs/heads/${SHADOW_BRANCH_NAME}`,
   740→      { cwd: worktreeDir },
   741→    );
   742→    return true;
   743→  } catch {
   744→    return false;
   745→  }
   746→}
   747→
   748→/**
   749→ * Result from a sync operation
   750→ */
   751→export interface ShadowSyncResult {
   752→  success: boolean;
   753→  pulled: boolean;
   754→  pushed: boolean;
   755→  hadConflict: boolean;
   756→  error?: string;
   757→}
   758→
   759→/**
   760→ * Fire-and-forget push to remote.
   761→ * AC-1: Called after each auto-commit when tracking is configured.
   762→ * AC-8: Automatically sets up tracking if main branch has remote.
   763→ * Silently ignores errors - the local commit succeeded regardless.
   764→ *
   765→ * @param worktreeDir Path to .kspec/ worktree
   766→ * @param verbose Enable debug output
   767→ */
   768→export async function shadowPushAsync(
   769→  worktreeDir: string,
   770→  verbose?: boolean,
   771→): Promise<void> {
   772→  const debug = isDebugMode(verbose);
   773→
   774→  // AC: @shadow-sync ac-8 - Auto-configure tracking if main has remote but shadow doesn't
   775→  const projectRoot = path.dirname(worktreeDir);
   776→  await ensureRemoteTracking(worktreeDir, projectRoot);
   777→
   778→  // Check if tracking is configured before attempting push
   779→  if (!(await hasRemoteTracking(worktreeDir))) {
   780→    if (debug) {
   781→      console.error(
   782→        "[DEBUG] Shadow push: No remote tracking configured, skipping",
   783→      );
   784→    }
   785→    return; // AC: @shadow-sync ac-4 - silently skip if no tracking
   786→  }
   787→
   788→  try {
   789→    if (debug) {
   790→      console.error(`[DEBUG] Shadow push: git push (cwd: ${worktreeDir})`);
   791→    }
   792→
   793→    // Don't await - fire and forget
   794→    execAsync("git push", { cwd: worktreeDir }).catch((err) => {
   795→      if (debug) {
   796→        console.error("[DEBUG] Shadow push failed:", err);
   797→      }
   798→      // Silently ignore push failures - local state is correct
   799→    });
   800→  } catch (err) {
   801→    if (debug) {
   802→      console.error("[DEBUG] Shadow push error:", err);
   803→    }
   804→  }
   805→}
   806→
   807→/**
   808→ * Pull remote changes to shadow branch.
   809→ * AC-2: Called at session start to sync before operations.
   810→ * AC-6: Uses --ff-only first, falls back to --rebase.
   811→ * AC-3: On conflict, returns failure with suggestion.
   812→ * AC-8: Automatically sets up tracking if main branch has remote.
   813→ */
   814→export async function shadowPull(
   815→  worktreeDir: string,
   816→): Promise<ShadowSyncResult> {
   817→  const result: ShadowSyncResult = {
   818→    success: false,
   819→    pulled: false,
   820→    pushed: false,
   821→    hadConflict: false,
   822→  };
   823→
   824→  // AC: @shadow-sync ac-8 - Auto-configure tracking if main has remote but shadow doesn't
   825→  const projectRoot = path.dirname(worktreeDir);
   826→  await ensureRemoteTracking(worktreeDir, projectRoot);
   827→
   828→  // AC: @shadow-sync ac-4 - Skip if no remote tracking
   829→  if (!(await hasRemoteTracking(worktreeDir))) {
   830→    result.success = true;
   831→    return result;
   832→  }
   833→
   834→  // Check if remote branch exists before attempting pull
   835→  // Fetch first to ensure refs are up to date
   836→  await fetchRemote(projectRoot);
   837→  const remoteHasBranch = await remoteBranchExists(
   838→    projectRoot,
   839→    SHADOW_BRANCH_NAME,
   840→  );
   841→  if (!remoteHasBranch) {
   842→    // Remote branch doesn't exist yet - nothing to pull, but success
   843→    result.success = true;
   844→    return result;
   845→  }
   846→
   847→  try {
   848→    // Try fast-forward only first (cleanest)
   849→    await execAsync("git pull --ff-only", { cwd: worktreeDir });
   850→    result.success = true;
   851→    result.pulled = true;
   852→    return result;
   853→  } catch {
   854→    // Fast-forward failed, try rebase
   855→  }
   856→
   857→  try {
   858→    // AC: @shadow-sync ac-6 - Fall back to rebase
   859→    await execAsync("git pull --rebase", { cwd: worktreeDir });
   860→    result.success = true;
   861→    result.pulled = true;
   862→    return result;
   863→  } catch {
   864→    // Rebase failed - likely conflict
   865→  }
   866→
   867→  // AC: @shadow-sync ac-3 - Conflict detected - abort rebase and report
   868→  try {
   869→    await execAsync("git rebase --abort", { cwd: worktreeDir });
   870→  } catch {
   871→    // May not be in rebase state, ignore
   872→  }
   873→
   874→  result.hadConflict = true;
   875→  result.error = "Sync conflict detected. Run `kspec shadow resolve` to fix.";
   876→  return result;
   877→}
   878→
   879→/**
   880→ * Full sync operation: pull then push.
   881→ * Used by session start and explicit sync commands.
   882→ */
   883→export async function shadowSync(
   884→  worktreeDir: string,
   885→): Promise<ShadowSyncResult> {
   886→  // First pull
   887→  const pullResult = await shadowPull(worktreeDir);
   888→  if (!pullResult.success) {
   889→    return pullResult;
   890→  }
   891→
   892→  // Then push (only if tracking configured, checked inside)
   893→  if (await hasRemoteTracking(worktreeDir)) {
   894→    try {
   895→      await execAsync("git push", { cwd: worktreeDir });
   896→      pullResult.pushed = true;
   897→    } catch {
   898→      // Push failed - not a critical error, local state is correct
   899→      // Could be permissions, network, etc.
   900→    }
   901→  }
   902→
   903→  return pullResult;
   904→}
   905→
   906→/**
   907→ * Check if .gitignore has uncommitted changes
   908→ */
   909→async function hasUncommittedGitignore(projectRoot: string): Promise<boolean> {
   910→  try {
   911→    // Check both staged and unstaged changes to .gitignore
   912→    const { stdout } = await execAsync("git status --porcelain .gitignore", {
   913→      cwd: projectRoot,
   914→    });
   915→    return stdout.trim().length > 0;
   916→  } catch {
   917→    return false;
   918→  }
   919→}
   920→
   921→/**
   922→ * Commit only .gitignore with a message
   923→ */
   924→async function commitGitignore(projectRoot: string): Promise<void> {
   925→  await execAsync("git add .gitignore", { cwd: projectRoot });
   926→  await execAsync(
   927→    'git commit -m "chore: add .kspec/ to .gitignore for shadow branch"',
   928→    {
   929→      cwd: projectRoot,
   930→    },
   931→  );
   932→}
   933→
   934→/**
   935→ * Add .kspec/ to .gitignore if not already present.
   936→ * Fails if .gitignore has uncommitted changes.
   937→ * Commits the change after adding.
   938→ */
   939→async function ensureGitignore(projectRoot: string): Promise<boolean> {
   940→  const gitignorePath = path.join(projectRoot, ".gitignore");
   941→  const entry = `${SHADOW_WORKTREE_DIR}/`;
   942→
   943→  // Fail fast if .gitignore has uncommitted changes
   944→  if (await hasUncommittedGitignore(projectRoot)) {
   945→    throw new ShadowError(
   946→      ".gitignore has uncommitted changes",
   947→      "GIT_ERROR",
   948→      "Commit or stash your .gitignore changes before running kspec init.",
   949→    );
   950→  }
   951→
   952→  try {
   953→    let content = "";
   954→    try {
   955→      content = await fs.readFile(gitignorePath, "utf-8");
   956→    } catch {
   957→      // File doesn't exist, will create
   958→    }
   959→
   960→    // Check if already present (handle various formats)
   961→    const lines = content.split("\n");
   962→    const patterns = [
   963→      SHADOW_WORKTREE_DIR,
   964→      `${SHADOW_WORKTREE_DIR}/`,
   965→      `/${SHADOW_WORKTREE_DIR}`,
   966→      `/${SHADOW_WORKTREE_DIR}/`,
   967→    ];
   968→
   969→    for (const line of lines) {
   970→      const trimmed = line.trim();
   971→      if (patterns.includes(trimmed)) {
   972→        return false; // Already present
   973→      }
   974→    }
   975→
   976→    // Add to gitignore
   977→    const newContent =
   978→      content.endsWith("\n") || content === ""
   979→        ? `${content}${entry}\n`
   980→        : `${content}\n${entry}\n`;
   981→
   982→    await fs.writeFile(gitignorePath, newContent, "utf-8");
   983→
   984→    // Commit the change
   985→    await commitGitignore(projectRoot);
   986→
   987→    return true;
   988→  } catch (error) {
   989→    if (error instanceof ShadowError) {
   990→      throw error;
   991→    }
   992→    throw new ShadowError(
   993→      `Failed to update .gitignore: ${error}`,
   994→      "GIT_ERROR",
   995→      "Check file permissions for .gitignore",
   996→    );
   997→  }
   998→}
   999→
  1000→/**
  1001→ * Generate initial manifest content for shadow branch
  1002→ */
  1003→function generateShadowManifest(projectName: string): string {
  1004→  return `# ${projectName} - Kynetic Spec
  1005→# Generated by kspec init
  1006→
  1007→kynetic: "1.0"
  1008→
  1009→project:
  1010→  name: "${projectName}"
  1011→  version: "0.1.0"
  1012→  status: draft
  1013→  description: |
  1014→    Add your project description here.
  1015→
  1016→# Module includes
  1017→includes:
  1018→  - modules/main.yaml
  1019→
  1020→# Configuration
  1021→config:
  1022→  validation:
  1023→    strict_refs: true
  1024→    require_acceptance: false
  1025→`;
  1026→}
  1027→
  1028→/**
  1029→ * Generate initial module content
  1030→ */
  1031→function generateShadowModule(projectName: string): string {
  1032→  return `# ${projectName} - Main Module
  1033→# Add your spec items here
  1034→
  1035→items: []
  1036→`;
  1037→}
  1038→
  1039→/**
  1040→ * Generate initial tasks file
  1041→ */
  1042→function generateShadowTasks(projectName: string): string {
  1043→  return `# ${projectName} - Tasks
  1044→# Track implementation work here
  1045→
  1046→tasks: []
  1047→`;
  1048→}
  1049→
  1050→/**
  1051→ * Generate initial inbox file
  1052→ */
  1053→function generateShadowInbox(): string {
  1054→  return `# Inbox - Quick Capture
  1055→# Ideas and notes that haven't been triaged yet
  1056→
  1057→items: []
  1058→`;
  1059→}
  1060→
  1061→/**
  1062→ * Get the kspec package root directory.
  1063→ * Navigates from dist/parser/ to package root.
  1064→ */
  1065→function getPackageRoot(): string {
  1066→  return path.resolve(__dirname, "..", "..");
  1067→}
  1068→
  1069→/**
  1070→ * Install pre-commit hook to protect kspec-meta branch.
  1071→ * Hook prevents direct commits to shadow branch unless KSPEC_SHADOW_COMMIT=1.
  1072→ *
  1073→ * Note: Git worktrees use hooks from the main .git/hooks directory (via commondir),
  1074→ * not from .git/worktrees/-kspec/hooks. So we install to main hooks directory.
  1075→ *
  1076→ * The hook source is located in the kspec package's templates/hooks/ directory.
  1077→ *
  1078→ * @param projectRoot Git repository root
  1079→ * @returns true if hook was installed, false if already exists
  1080→ */
  1081→async function installShadowHook(projectRoot: string): Promise<boolean> {
  1082→  const hooksDir = path.join(projectRoot, ".git", "hooks");
  1083→  const hookPath = path.join(hooksDir, "pre-commit");
  1084→
  1085→  // Look for hook in package templates directory
  1086→  const packageRoot = getPackageRoot();
  1087→  const sourceHookPath = path.join(packageRoot, "templates", "hooks", "pre-commit");
  1088→
  1089→  try {
  1090→    // Check if source hook exists in package templates
  1091→    try {
  1092→      await fs.access(sourceHookPath);
  1093→    } catch {
  1094→      // Source hook doesn't exist - skip installation
  1095→      return false;
  1096→    }
  1097→
  1098→    // Check if hook already exists
  1099→    try {
  1100→      await fs.access(hookPath);
  1101→      // Hook exists - don't overwrite (user may have custom hooks)
  1102→      return false;
  1103→    } catch {
  1104→      // Hook doesn't exist - install it
  1105→    }
  1106→
  1107→    // Copy hook from package templates
  1108→    const hookContent = await fs.readFile(sourceHookPath, "utf-8");
  1109→    await fs.writeFile(hookPath, hookContent, { mode: 0o755 });
  1110→    return true;
  1111→  } catch (_error) {
  1112→    // Silently fail - hook installation is optional
  1113→    return false;
  1114→  }
  1115→}
  1116→
  1117→/**
  1118→ * Convert project name to slug (kebab-case)
  1119→ */
  1120→function toSlug(projectName: string): string {
  1121→  return projectName
  1122→    .toLowerCase()
  1123→    .replace(/[^a-z0-9]+/g, "-")
  1124→    .replace(/^-|-$/g, "");
  1125→}
  1126→
  1127→/**
  1128→ * Configure git merge driver for kspec YAML files.
  1129→ * AC: @yaml-merge-driver ac-12
  1130→ *
  1131→ * Configures the merge driver in .git/config and adds .gitattributes in the shadow branch.
  1132→ *
  1133→ * @param projectRoot Git repository root
  1134→ * @param worktreeDir Path to shadow worktree directory
  1135→ * @returns true if configuration was successful
  1136→ */
  1137→async function configureMergeDriver(
  1138→  projectRoot: string,
  1139→  worktreeDir: string,
  1140→): Promise<boolean> {
  1141→  try {
  1142→    // Step 1: Configure merge driver in .git/config
  1143→    const kspecPath = execSync("which kspec", {
  1144→      encoding: "utf-8",
  1145→      stdio: ["pipe", "pipe", "pipe"],
  1146→    }).trim();
  1147→
  1148→    // Add merge driver configuration to git config
  1149→    try {
  1150→      execSync(
  1151→        `git config merge.kspec.name "Kspec YAML semantic merge driver"`,
  1152→        {
  1153→          cwd: projectRoot,
  1154→          stdio: ["pipe", "pipe", "pipe"],
  1155→        },
  1156→      );
  1157→      execSync(
  1158→        `git config merge.kspec.driver "${kspecPath} merge-driver %O %A %B --non-interactive"`,
  1159→        {
  1160→          cwd: projectRoot,
  1161→          stdio: ["pipe", "pipe", "pipe"],
  1162→        },
  1163→      );
  1164→    } catch (error) {
  1165→      // Config may fail if already set - check if it's set correctly
  1166→      try {
  1167→        const existingDriver = execSync("git config merge.kspec.driver", {
  1168→          cwd: projectRoot,
  1169→          encoding: "utf-8",
  1170→          stdio: ["pipe", "pipe", "pipe"],
  1171→        }).trim();
  1172→
  1173→        if (!existingDriver.includes("kspec merge-driver")) {
  1174→          throw new Error("Merge driver config exists but is incorrect");
  1175→        }
  1176→      } catch {
  1177→        throw error; // Re-throw original error
  1178→      }
  1179→    }
  1180→
  1181→    // Step 2: Create .gitattributes in shadow branch
  1182→    const gitattributesPath = path.join(worktreeDir, ".gitattributes");
  1183→
  1184→    // Check if .gitattributes exists
  1185→    let existingContent = "";
  1186→    try {
  1187→      existingContent = await fs.readFile(gitattributesPath, "utf-8");
  1188→    } catch {
  1189→      // File doesn't exist, that's fine
  1190→    }
  1191→
  1192→    // Check if merge driver is already configured
  1193→    if (!existingContent.includes("merge=kspec")) {
  1194→      const attributesContent = existingContent
  1195→        ? existingContent + "\n"
  1196→        : "# Git attributes for kspec\n\n";
  1197→
  1198→      await fs.writeFile(
  1199→        gitattributesPath,
  1200→        attributesContent + "*.yaml merge=kspec\n*.yml merge=kspec\n",
  1201→        "utf-8",
  1202→      );
  1203→
  1204→      // Commit .gitattributes to shadow branch
  1205→      await shadowAutoCommit(worktreeDir, "Configure kspec merge driver");
  1206→    }
  1207→
  1208→    return true;
  1209→  } catch (_error) {
  1210→    // Silently fail - merge driver configuration is optional
  1211→    return false;
  1212→  }
  1213→}
  1214→
  1215→/**
  1216→ * Initialize shadow branch and worktree.
  1217→ * Creates orphan branch, worktree, updates gitignore, and creates initial structure.
  1218→ *
  1219→ * @param projectRoot Git repository root
  1220→ * @param options Initialization options
  1221→ * @returns Result indicating what was created
  1222→ */
  1223→export async function initializeShadow(
  1224→  projectRoot: string,
  1225→  options: ShadowInitOptions = {},
  1226→): Promise<ShadowInitResult> {
  1227→  const result: ShadowInitResult = {
  1228→    success: false,
  1229→    branchCreated: false,
  1230→    worktreeCreated: false,
  1231→    gitignoreUpdated: false,
  1232→    initialCommit: false,
  1233→    alreadyExists: false,
  1234→    createdFromRemote: false,
  1235→    pushedToRemote: false,
  1236→  };
  1237→
  1238→  // Check if we're in a git repo
  1239→  if (!(await isGitRepo(projectRoot))) {
  1240→    result.error = "Not a git repository";
  1241→    return result;
  1242→  }
  1243→
  1244→  const worktreeDir = path.join(projectRoot, SHADOW_WORKTREE_DIR);
  1245→
  1246→  // Check current status
  1247→  const status = await getShadowStatus(projectRoot);
  1248→
  1249→  // Handle existing shadow branch
  1250→  if (status.healthy && !options.force) {
  1251→    result.alreadyExists = true;
  1252→    result.success = true;
  1253→    return result;
  1254→  }
  1255→
  1256→  // Derive project name if not provided
  1257→  const projectName =
  1258→    options.projectName ||
  1259→    path
  1260→      .basename(projectRoot)
  1261→      .replace(/[-_]/g, " ")
  1262→      .replace(/\b\w/g, (c) => c.toUpperCase());
  1263→
  1264→  const slug = toSlug(projectName);
  1265→
  1266→  // Check for remote shadow branch (AC-4: fetch to ensure refs are up to date)
  1267→  const remoteExists = await hasRemote(projectRoot);
  1268→  let remoteHasShadow = false;
  1269→  if (remoteExists) {
  1270→    await fetchRemote(projectRoot); // Best effort, ignore failures
  1271→    remoteHasShadow = await remoteBranchExists(projectRoot, SHADOW_BRANCH_NAME);
  1272→  }
  1273→
  1274→  try {
  1275→    // Step 1: Update .gitignore first (before creating .kspec/)
  1276→    result.gitignoreUpdated = await ensureGitignore(projectRoot);
  1277→
  1278→    // Step 2: Create worktree with orphan branch (or attach to existing branch)
  1279→    if (!status.worktreeExists || !status.worktreeLinked) {
  1280→      // Remove existing directory if present but not linked
  1281→      if (status.worktreeExists && !status.worktreeLinked) {
  1282→        await fs.rm(worktreeDir, { recursive: true, force: true });
  1283→      }
  1284→
  1285→      // Remove stale worktree reference if any
  1286→      try {
  1287→        await execAsync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, {
  1288→          cwd: projectRoot,
  1289→        });
  1290→      } catch {
  1291→        // Ignore - worktree may not exist in git's list
  1292→      }
  1293→
  1294→      if (remoteHasShadow) {
  1295→        // AC: @shadow-init-remote ac-1 - Remote has shadow branch - create worktree from it with tracking
  1296→        await execAsync(
  1297→          `git worktree add ${SHADOW_WORKTREE_DIR} ${SHADOW_BRANCH_NAME}`,
  1298→          { cwd: projectRoot },
  1299→        );
  1300→        // Set up tracking for the branch
  1301→        await execAsync(
  1302→          `git branch --set-upstream-to=origin/${SHADOW_BRANCH_NAME} ${SHADOW_BRANCH_NAME}`,
  1303→          { cwd: projectRoot },
  1304→        );
  1305→        result.createdFromRemote = true;
  1306→      } else if (!status.branchExists) {
  1307→        // AC: @shadow-init-remote ac-2 ac-3 - No remote branch or no remote - create orphan branch
  1308→        await execAsync(
  1309→          `git worktree add --orphan -b ${SHADOW_BRANCH_NAME} ${SHADOW_WORKTREE_DIR}`,
  1310→          { cwd: projectRoot },
  1311→        );
  1312→        result.branchCreated = true;
  1313→      } else {
  1314→        // Attach to existing local branch
  1315→        await execAsync(
  1316→          `git worktree add ${SHADOW_WORKTREE_DIR} ${SHADOW_BRANCH_NAME}`,
  1317→          { cwd: projectRoot },
  1318→        );
  1319→      }
  1320→
  1321→      result.worktreeCreated = true;
  1322→    }
  1323→
  1324→    // Step 3: Create initial structure if empty (only for new branches, not remote)
  1325→    const manifestPath = path.join(worktreeDir, `${slug}.yaml`);
  1326→    const modulesDir = path.join(worktreeDir, "modules");
  1327→    const moduleFilePath = path.join(modulesDir, "main.yaml");
  1328→    const tasksPath = path.join(worktreeDir, `${slug}.tasks.yaml`);
  1329→    const inboxPath = path.join(worktreeDir, `${slug}.inbox.yaml`);
  1330→
  1331→    let filesCreated = false;
  1332→
  1333→    // Only create files if manifest doesn't exist (remote branches will have files)
  1334→    try {
  1335→      // Look for any .yaml manifest file (project name may differ)
  1336→      const files = await fs.readdir(worktreeDir);
  1337→      const hasManifest = files.some(
  1338→        (f) =>
  1339→          f.endsWith(".yaml") &&
  1340→          !f.includes(".tasks.") &&
  1341→          !f.includes(".inbox."),
  1342→      );
  1343→      if (!hasManifest) {
  1344→        throw new Error("No manifest found");
  1345→      }
  1346→    } catch {
  1347→      // Manifest doesn't exist, create initial structure
  1348→      await fs.mkdir(modulesDir, { recursive: true });
  1349→      await fs.writeFile(
  1350→        manifestPath,
  1351→        generateShadowManifest(projectName),
  1352→        "utf-8",
  1353→      );
  1354→      await fs.writeFile(
  1355→        moduleFilePath,
  1356→        generateShadowModule(projectName),
  1357→        "utf-8",
  1358→      );
  1359→      await fs.writeFile(tasksPath, generateShadowTasks(projectName), "utf-8");
  1360→      await fs.writeFile(inboxPath, generateShadowInbox(), "utf-8");
  1361→      filesCreated = true;
  1362→    }
  1363→
  1364→    // Step 4: Initial commit if files were created
  1365→    if (filesCreated) {
  1366→      result.initialCommit = await shadowAutoCommit(
  1367→        worktreeDir,
  1368→        `Initialize ${projectName} spec`,
  1369→      );
  1370→    }
  1371→
  1372→    // Step 5: AC-2: Push new branch to remote to establish tracking
  1373→    if (result.branchCreated && remoteExists && !remoteHasShadow) {
  1374→      result.pushedToRemote = await pushShadowBranch(worktreeDir);
  1375→    }
  1376→
  1377→    // Step 6: Install pre-commit hook to protect shadow branch
  1378→    await installShadowHook(projectRoot);
  1379→
  1380→    // Step 7: Configure merge driver for semantic YAML merging
  1381→    // AC: @yaml-merge-driver ac-12
  1382→    await configureMergeDriver(projectRoot, worktreeDir);
  1383→
  1384→    result.success = true;
  1385→    return result;
  1386→  } catch (error) {
  1387→    result.error = error instanceof Error ? error.message : String(error);
  1388→    return result;
  1389→  }
  1390→}
  1391→
  1392→/**
  1393→ * Repair a broken shadow branch setup.
  1394→ * Handles cases where worktree is disconnected or directory is missing.
  1395→ *
  1396→ * @param projectRoot Git repository root
  1397→ * @returns Result indicating what was repaired
  1398→ */
  1399→export async function repairShadow(
  1400→  projectRoot: string,
  1401→): Promise<ShadowInitResult> {
  1402→  const status = await getShadowStatus(projectRoot);
  1403→
  1404→  if (status.healthy) {
  1405→    return {
  1406→      success: true,
  1407→      branchCreated: false,
  1408→      worktreeCreated: false,
  1409→      gitignoreUpdated: false,
  1410→      initialCommit: false,
  1411→      alreadyExists: true,
  1412→      createdFromRemote: false,
  1413→      pushedToRemote: false,
  1414→    };
  1415→  }
  1416→
  1417→  if (!status.branchExists) {
  1418→    // Can't repair without a branch - need full init
  1419→    return {
  1420→      success: false,
  1421→      branchCreated: false,
  1422→      worktreeCreated: false,
  1423→      gitignoreUpdated: false,
  1424→      initialCommit: false,
  1425→      alreadyExists: false,
  1426→      createdFromRemote: false,
  1427→      pushedToRemote: false,
  1428→      error: "Shadow branch does not exist. Run `kspec init` instead.",
  1429→    };
  1430→  }
  1431→
  1432→  // Branch exists but worktree is broken - repair it
  1433→  const worktreeDir = path.join(projectRoot, SHADOW_WORKTREE_DIR);
  1434→
  1435→  try {
  1436→    // Remove stale worktree reference
  1437→    try {
  1438→      await execAsync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, {
  1439→        cwd: projectRoot,
  1440→      });
  1441→    } catch {
  1442→      // Ignore - worktree may not be in git's list
  1443→    }
  1444→
  1445→    // Remove directory if exists (handles corrupted .git file case)
  1446→    await fs.rm(worktreeDir, { recursive: true, force: true });
  1447→
  1448→    // Prune stale worktree references (cleans up orphaned entries)
  1449→    try {
  1450→      await execAsync("git worktree prune", { cwd: projectRoot });
  1451→    } catch {
  1452→      // Ignore - prune is best-effort
  1453→    }
  1454→
  1455→    // Recreate worktree
  1456→    await execAsync(
  1457→      `git worktree add ${SHADOW_WORKTREE_DIR} ${SHADOW_BRANCH_NAME}`,
  1458→      { cwd: projectRoot },
  1459→    );
  1460→
  1461→    // Install pre-commit hook
  1462→    await installShadowHook(projectRoot);
  1463→
  1464→    return {
  1465→      success: true,
  1466→      branchCreated: false,
  1467→      worktreeCreated: true,
  1468→      gitignoreUpdated: false,
  1469→      initialCommit: false,
  1470→      alreadyExists: false,
  1471→      createdFromRemote: false,
  1472→      pushedToRemote: false,
  1473→    };
  1474→  } catch (error) {
  1475→    return {
  1476→      success: false,
  1477→      branchCreated: false,
  1478→      worktreeCreated: false,
  1479→      gitignoreUpdated: false,
  1480→      initialCommit: false,
  1481→      alreadyExists: false,
  1482→      createdFromRemote: false,
  1483→      pushedToRemote: false,
  1484→      error: error instanceof Error ? error.message : String(error),
  1485→    };
  1486→  }
  1487→}
  1488→

