     1→/**
     2→ * kspec serve commands - daemon server lifecycle management
     3→ * AC: @cli-serve-commands
     4→ */
     5→
     6→import type { Command } from 'commander';
     7→import { spawn, execSync } from 'child_process';
     8→import { existsSync, readdirSync, statSync } from 'fs';
     9→import { join, dirname } from 'path';
    10→import { fileURLToPath } from 'url';
    11→import { error, info, output, success, warn, isJsonMode } from '../output.js';
    12→import { EXIT_CODES } from '../exit-codes.js';
    13→import { PidFileManager } from '../pid-utils.js';
    14→import { loadProjectConfig } from '../../parser/config.js';
    15→import { initContext } from '../../parser/yaml.js';
    16→
    17→/**
    18→ * Check if Bun runtime is available.
    19→ * Daemon requires Bun to run TypeScript directly.
    20→ */
    21→function isBunAvailable(): boolean {
    22→  try {
    23→    execSync('bun --version', { stdio: 'pipe' });
    24→    return true;
    25→  } catch {
    26→    return false;
    27→  }
    28→}
    29→
    30→const __filename = fileURLToPath(import.meta.url);
    31→const __dirname = dirname(__filename);
    32→
    33→/**
    34→ * Check if daemon dist files are stale (source newer than dist)
    35→ * Returns true if rebuild is recommended
    36→ */
    37→function checkDaemonStaleness(): boolean {
    38→  // __dirname is dist/cli/commands, go up 3 levels to package root, then into packages/daemon/src
    39→  const sourceDir = join(__dirname, '../../../packages/daemon/src');
    40→  // dist/daemon is 2 levels up from __dirname
    41→  const distDir = join(__dirname, '../../daemon');
    42→
    43→  if (!existsSync(sourceDir) || !existsSync(distDir)) return false;
    44→
    45→  try {
    46→    const getNewestMtime = (dir: string): number => {
    47→      const files = readdirSync(dir, { withFileTypes: true });
    48→      let newest = 0;
    49→      for (const f of files) {
    50→        const fullPath = join(dir, f.name);
    51→        if (f.isDirectory()) {
    52→          newest = Math.max(newest, getNewestMtime(fullPath));
    53→        } else if (f.name.endsWith('.ts')) {
    54→          newest = Math.max(newest, statSync(fullPath).mtimeMs);
    55→        }
    56→      }
    57→      return newest;
    58→    };
    59→
    60→    const newestSource = getNewestMtime(sourceDir);
    61→    const newestDist = getNewestMtime(distDir);
    62→
    63→    return newestSource > newestDist;
    64→  } catch {
    65→    return false; // Don't warn if check fails
    66→  }
    67→}
    68→
    69→
    70→/**
    71→ * Register serve commands
    72→ */
    73→export function registerServeCommands(program: Command): void {
    74→  const serve = program
    75→    .command('serve')
    76→    .description('Manage the kspec daemon server');
    77→
    78→  // AC: @cli-serve-commands ac-1, ac-2, ac-3
    79→  // AC: @config-daemon ac-1, ac-2 — port from config, CLI flag overrides
    80→  serve
    81→    .command('start', { isDefault: true })
    82→    .description('Start the daemon server')
    83→    .option('-d, --daemon', 'Run in background (detached mode)')
    84→    .option('-p, --port <port>', 'Server port (uses config daemon.port if not specified)')
    85→    .option('--kspec-dir <dir>', 'Path to .kspec directory', join(process.cwd(), '.kspec'))
    86→    .option('--json', 'Output as JSON')
    87→    .action(async (opts) => {
    88→      try {
    89→        await startServer(opts);
    90→      } catch (err) {
    91→        if (isJsonMode()) {
    92→          output({ error: err instanceof Error ? err.message : String(err) });
    93→        } else {
    94→          error(`Failed to start server: ${err instanceof Error ? err.message : String(err)}`);
    95→        }
    96→        process.exit(EXIT_CODES.ERROR);
    97→      }
    98→    });
    99→
   100→  // AC: @cli-serve-commands ac-4, ac-5
   101→  serve
   102→    .command('stop')
   103→    .description('Stop the daemon server')
   104→    .option('--kspec-dir <dir>', 'Path to .kspec directory', join(process.cwd(), '.kspec'))
   105→    .option('--json', 'Output as JSON')
   106→    .action(async (opts) => {
   107→      try {
   108→        await stopServer(opts);
   109→      } catch (err) {
   110→        if (isJsonMode()) {
   111→          output({ error: err instanceof Error ? err.message : String(err) });
   112→        } else {
   113→          error(`Failed to stop server: ${err instanceof Error ? err.message : String(err)}`);
   114→        }
   115→        process.exit(EXIT_CODES.ERROR);
   116→      }
   117→    });
   118→
   119→  // AC: @cli-serve-commands ac-6
   120→  serve
   121→    .command('status')
   122→    .description('Check daemon server status')
   123→    .option('--kspec-dir <dir>', 'Path to .kspec directory', join(process.cwd(), '.kspec'))
   124→    .option('--json', 'Output as JSON')
   125→    .action(async (opts) => {
   126→      try {
   127→        await statusServer(opts);
   128→      } catch (err) {
   129→        if (isJsonMode()) {
   130→          output({ error: err instanceof Error ? err.message : String(err) });
   131→        } else {
   132→          error(`Failed to check status: ${err instanceof Error ? err.message : String(err)}`);
   133→        }
   134→        process.exit(EXIT_CODES.ERROR);
   135→      }
   136→    });
   137→
   138→  // AC: @cli-serve-commands ac-7
   139→  serve
   140→    .command('restart')
   141→    .description('Restart the daemon server')
   142→    .option('--kspec-dir <dir>', 'Path to .kspec directory', join(process.cwd(), '.kspec'))
   143→    .option('--json', 'Output as JSON')
   144→    .action(async (opts) => {
   145→      try {
   146→        await restartServer(opts);
   147→      } catch (err) {
   148→        if (isJsonMode()) {
   149→          output({ error: err instanceof Error ? err.message : String(err) });
   150→        } else {
   151→          error(`Failed to restart server: ${err instanceof Error ? err.message : String(err)}`);
   152→        }
   153→        process.exit(EXIT_CODES.ERROR);
   154→      }
   155→    });
   156→}
   157→
   158→/**
   159→ * Start the daemon server
   160→ * AC: @cli-serve-commands ac-1 (foreground), ac-2 (daemon), ac-3 (port), ac-10 (port error)
   161→ * AC: @config-daemon ac-1 — port from config, ac-2 — CLI flag overrides config
   162→ */
   163→async function startServer(opts: {
   164→  daemon?: boolean;
   165→  port?: string;
   166→  kspecDir: string;
   167→}): Promise<void> {
   168→  const jsonMode = isJsonMode();
   169→
   170→  // AC: @config-daemon ac-1, ac-2 — load config for default port, CLI flag overrides
   171→  const { config } = await loadProjectConfig();
   172→  const configPort = config.daemon.port;
   173→
   174→  // AC: @config-daemon ac-2 — CLI flag takes precedence over config
   175→  const port = opts.port ? parseInt(opts.port, 10) : configPort;
   176→
   177→  // AC: @cli-serve-commands ac-10
   178→  if (isNaN(port) || port < 1 || port > 65535) {
   179→    if (jsonMode) {
   180→      output({
   181→        error: 'Invalid port number. Must be between 1 and 65535.',
   182→        hint: 'Try: kspec serve --port <PORT>',
   183→      });
   184→    } else {
   185→      error('Invalid port number. Must be between 1 and 65535.');
   186→      error('Try: kspec serve --port <PORT>');
   187→    }
   188→    process.exit(EXIT_CODES.VALIDATION_FAILED);
   189→  }
   190→
   191→  const pidManager = new PidFileManager();
   192→
   193→  // Check if already running
   194→  if (pidManager.isDaemonRunning()) {
   195→    const pid = pidManager.readPid();
   196→    const existingPort = pidManager.readPort();
   197→    if (isJsonMode()) {
   198→      output({ running: true, pid, port: existingPort, message: 'Daemon already running' });
   199→    } else {
   200→      warn(`Daemon already running on port ${existingPort}`);
   201→    }
   202→    process.exit(EXIT_CODES.SUCCESS);
   203→  }
   204→
   205→  // Get path to daemon entry point
   206→  // Daemon source is bundled at dist/daemon/index.ts (relative to package root)
   207→  // __dirname is dist/cli/commands, so go up 2 levels to dist/, then into daemon/
   208→  // Note: Daemon is TypeScript source - requires Bun runtime
   209→  const daemonBinary = join(__dirname, '../../daemon/index.ts');
   210→
   211→  if (!existsSync(daemonBinary)) {
   212→    if (isJsonMode()) {
   213→      output({ error: `Daemon binary not found at ${daemonBinary}`, hint: 'Ensure the kspec package is properly installed' });
   214→    } else {
   215→      error(`Daemon binary not found at: ${daemonBinary}`);
   216→      error('Ensure the kspec package is properly installed');
   217→    }
   218→    process.exit(EXIT_CODES.ERROR);
   219→  }
   220→
   221→  // Daemon requires Bun to run TypeScript directly
   222→  if (!isBunAvailable()) {
   223→    if (isJsonMode()) {
   224→      output({ error: 'Bun runtime not found', hint: 'Install Bun: https://bun.sh/docs/installation' });
   225→    } else {
   226→      error('Bun runtime is required for the daemon server');
   227→      error('Install Bun: https://bun.sh/docs/installation');
   228→    }
   229→    process.exit(EXIT_CODES.ERROR);
   230→  }
   231→
   232→  // Check for stale daemon build (dev experience improvement)
   233→  if (checkDaemonStaleness() && !jsonMode) {
   234→    warn('Warning: dist/daemon/ may be stale (source files are newer).');
   235→    warn('  Run "npm run build:daemon" to update.');
   236→  }
   237→
   238→  // AC: @cli-serve-commands ac-2 - background mode
   239→  if (opts.daemon) {
   240→    const runtime = 'bun';
   241→
   242→    // Spawn detached process
   243→    // Set BUN_ENV=production to prevent Bun dev mode HTML transformation
   244→    // which can cause asset hash mismatches in the web UI
   245→    const child = spawn(runtime, [daemonBinary, '--port', String(port), '--kspec-dir', opts.kspecDir], {
   246→      detached: true,
   247→      stdio: 'ignore', // TODO: redirect to log file when logging implemented
   248→      cwd: process.cwd(),
   249→      env: { ...process.env, BUN_ENV: 'production' },
   250→    });
   251→
   252→    // Detach from parent
   253→    child.unref();
   254→
   255→    // Poll for PID file with timeout (max 5 seconds)
   256→    const maxWait = 5000;
   257→    const startTime = Date.now();
   258→    let pid: number | null = null;
   259→
   260→    while (Date.now() - startTime < maxWait) {
   261→      pid = pidManager.readPid();
   262→      if (pid && pidManager.isDaemonRunning()) {
   263→        break;
   264→      }
   265→      await new Promise(resolve => setTimeout(resolve, 100));
   266→    }
   267→
   268→    if (pid && pidManager.isDaemonRunning()) {
   269→      if (isJsonMode()) {
   270→        output({ running: true, pid, port });
   271→      } else {
   272→        success(`Daemon started with PID ${pid} on port ${port}`);
   273→        output({ running: true, pid, port });
   274→      }
   275→    } else {
   276→      if (isJsonMode()) {
   277→        output({ error: 'Daemon failed to start within 5 seconds' });
   278→      } else {
   279→        error('Daemon failed to start within 5 seconds');
   280→      }
   281→      process.exit(EXIT_CODES.ERROR);
   282→    }
   283→  } else {
   284→    // AC: @cli-serve-commands ac-1 - foreground mode
   285→    if (!isJsonMode()) {
   286→      info(`Starting server in foreground on port ${port}...`);
   287→      info('Press Ctrl+C to stop');
   288→    }
   289→
   290→    const runtime = 'bun';
   291→
   292→    // Set BUN_ENV=production to prevent Bun dev mode HTML transformation
   293→    const child = spawn(runtime, [daemonBinary, '--port', String(port), '--kspec-dir', opts.kspecDir], {
   294→      stdio: 'inherit',
   295→      cwd: process.cwd(),
   296→      env: { ...process.env, BUN_ENV: 'production' },
   297→    });
   298→
   299→    // Handle Ctrl+C - forward SIGTERM to child for graceful shutdown
   300→    process.on('SIGINT', () => {
   301→      if (!isJsonMode()) {
   302→        info('\nStopping server...');
   303→      }
   304→      child.kill('SIGTERM');
   305→
   306→      // Wait for graceful shutdown (max 5 seconds)
   307→      const shutdownTimeout = setTimeout(() => {
   308→        child.kill('SIGKILL'); // Force kill if not stopped
   309→      }, 5000);
   310→
   311→      child.on('exit', () => {
   312→        clearTimeout(shutdownTimeout);
   313→      });
   314→    });
   315→
   316→    // Wait for process to exit
   317→    child.on('exit', (code) => {
   318→      process.exit(code ?? 0);
   319→    });
   320→  }
   321→}
   322→
   323→/**
   324→ * Stop the daemon server
   325→ * AC: @cli-serve-commands ac-4 (stop), ac-5 (idempotent)
   326→ */
   327→async function stopServer(opts: { kspecDir: string; json?: boolean }): Promise<void> {
   328→  if (isJsonMode()) {
   329→  }
   330→
   331→  const pidManager = new PidFileManager();
   332→
   333→  if (!pidManager.isDaemonRunning()) {
   334→    // AC: @cli-serve-commands ac-5
   335→    if (isJsonMode()) {
   336→      output({ running: false });
   337→    } else {
   338→      info('Daemon not running');
   339→      output({ running: false });
   340→    }
   341→    process.exit(EXIT_CODES.SUCCESS);
   342→  }
   343→
   344→  const pid = pidManager.readPid();
   345→  if (!pid) {
   346→    if (isJsonMode()) {
   347→      output({ error: 'Failed to read PID file' });
   348→    } else {
   349→      error('Failed to read PID file');
   350→    }
   351→    process.exit(EXIT_CODES.ERROR);
   352→  }
   353→
   354→  // AC: @cli-serve-commands ac-4
   355→  if (!isJsonMode()) {
   356→    info(`Stopping daemon (PID ${pid})...`);
   357→  }
   358→
   359→  try {
   360→    // Send SIGTERM
   361→    process.kill(pid, 'SIGTERM');
   362→
   363→    // Wait for clean shutdown (max 5 seconds)
   364→    const maxWait = 5000;
   365→    const startTime = Date.now();
   366→    while (Date.now() - startTime < maxWait) {
   367→      if (!pidManager.isDaemonRunning()) {
   368→        break;
   369→      }
   370→      await new Promise(resolve => setTimeout(resolve, 100));
   371→    }
   372→
   373→    if (pidManager.isDaemonRunning()) {
   374→      if (!isJsonMode()) {
   375→        warn(`Daemon did not stop gracefully, forcing...`);
   376→      }
   377→      process.kill(pid, 'SIGKILL');
   378→      await new Promise(resolve => setTimeout(resolve, 500));
   379→    }
   380→
   381→    if (isJsonMode()) {
   382→      output({ stopped: true, pid });
   383→    } else {
   384→      success('Daemon stopped');
   385→      output({ stopped: true, pid });
   386→    }
   387→  } catch (err) {
   388→    if (isJsonMode()) {
   389→      output({ error: err instanceof Error ? err.message : String(err) });
   390→    } else {
   391→      error(`Failed to stop daemon: ${err instanceof Error ? err.message : String(err)}`);
   392→    }
   393→    process.exit(EXIT_CODES.ERROR);
   394→  }
   395→}
   396→
   397→/**
   398→ * Check daemon server status
   399→ * AC: @cli-serve-commands ac-6, @multi-directory-daemon ac-12
   400→ */
   401→async function statusServer(opts: { kspecDir: string; json?: boolean }): Promise<void> {
   402→  if (isJsonMode()) {
   403→  }
   404→
   405→  const pidManager = new PidFileManager();
   406→  const running = pidManager.isDaemonRunning();
   407→  const pid = pidManager.readPid();
   408→
   409→  // Read port from global config (AC: @multi-directory-daemon ac-13)
   410→  let port: number | null = null;
   411→  if (running) {
   412→    try {
   413→      port = pidManager.readPort();
   414→    } catch {
   415→      // Port file might not exist or be invalid
   416→      port = null;
   417→    }
   418→  }
   419→
   420→  // AC: @multi-directory-daemon ac-12 - Fetch list of registered projects and uptime
   421→  let projects: Array<{ path: string; registeredAt: string; watcherStatus: string }> = [];
   422→  let uptime: number | null = null;
   423→  if (running && port) {
   424→    try {
   425→      const response = await fetch(`http://localhost:${port}/api/projects`);
   426→      if (response.ok) {
   427→        const data = await response.json() as { projects: Array<{ path: string; registeredAt: string; watcherStatus: string }> };
   428→        projects = data.projects || [];
   429→      }
   430→    } catch {
   431→      // If daemon is not responding, continue without projects list
   432→      // This can happen if daemon is still starting up or network issues
   433→    }
   434→
   435→    // Fetch uptime from health endpoint
   436→    try {
   437→      const healthResponse = await fetch(`http://localhost:${port}/api/health`);
   438→      if (healthResponse.ok) {
   439→        const healthData = await healthResponse.json() as { status: string; uptime: number };
   440→        uptime = healthData.uptime;
   441→      }
   442→    } catch {
   443→      // If health endpoint fails, continue without uptime
   444→    }
   445→  }
   446→
   447→  const status = {
   448→    running,
   449→    pid: pid ?? null,
   450→    port,
   451→    uptime,
   452→    projects,
   453→  };
   454→
   455→  if (isJsonMode()) {
   456→    output(status);
   457→  } else {
   458→    if (running) {
   459→      output(`Daemon running (PID: ${pid})`);
   460→      if (port) {
   461→        output(`  Port: ${port}`);
   462→      }
   463→      // AC: @multi-directory-daemon ac-12 - Show uptime
   464→      if (uptime !== null) {
   465→        const hours = Math.floor(uptime / 3600);
   466→        const minutes = Math.floor((uptime % 3600) / 60);
   467→        const seconds = Math.floor(uptime % 60);
   468→        if (hours > 0) {
   469→          output(`  Uptime: ${hours}h ${minutes}m ${seconds}s`);
   470→        } else if (minutes > 0) {
   471→          output(`  Uptime: ${minutes}m ${seconds}s`);
   472→        } else {
   473→          output(`  Uptime: ${seconds}s`);
   474→        }
   475→      }
   476→      // AC: @multi-directory-daemon ac-12 - Show registered projects
   477→      if (projects.length > 0) {
   478→        output(`\nRegistered projects (${projects.length}):`);
   479→        for (const project of projects) {
   480→          output(`  ${project.path} (watcher: ${project.watcherStatus})`);
   481→        }
   482→      } else {
   483→        output(`\nNo projects registered`);
   484→      }
   485→    } else {
   486→      output('Daemon not running');
   487→    }
   488→  }
   489→}
   490→
   491→/**
   492→ * Restart the daemon server
   493→ * AC: @cli-serve-commands ac-7
   494→ */
   495→async function restartServer(opts: { kspecDir: string; json?: boolean }): Promise<void> {
   496→  const pidManager = new PidFileManager();
   497→
   498→  // AC: @cli-serve-commands ac-7 - preserve port across restarts
   499→  // Try to read port from existing daemon, otherwise startServer will use config default
   500→  let port: string | undefined;
   501→  try {
   502→    port = pidManager.readPort().toString();
   503→  } catch {
   504→    // Port file doesn't exist or is invalid, let startServer use config
   505→  }
   506→
   507→  if (pidManager.isDaemonRunning()) {
   508→    if (!isJsonMode()) {
   509→      info('Stopping daemon...');
   510→    }
   511→    await stopServer(opts);
   512→  }
   513→
   514→  if (!isJsonMode()) {
   515→    info('Starting daemon...');
   516→  }
   517→  await startServer({ daemon: true, port, kspecDir: opts.kspecDir });
   518→}
