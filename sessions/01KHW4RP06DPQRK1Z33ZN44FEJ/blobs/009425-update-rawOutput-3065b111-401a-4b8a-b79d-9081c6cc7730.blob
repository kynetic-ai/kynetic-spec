     1→/**
     2→ * Tests for project configuration loading (kspec.config.yaml)
     3→ *
     4→ * AC coverage:
     5→ * - @project-config ac-1: no config = defaults
     6→ * - @project-config ac-2: config available on KspecContext.config
     7→ * - @project-config ac-3: invalid YAML = defaults + warning
     8→ * - @project-config ac-4: unknown fields ignored
     9→ * - @project-config ac-5: env vars take precedence
    10→ * - @project-config ac-6: loads from git root, not cwd
    11→ * - @project-config ac-7: batch mode uses real project root
    12→ */
    13→
    14→import { describe, it, expect, beforeEach, afterEach } from "vitest";
    15→import * as fs from "node:fs/promises";
    16→import * as path from "node:path";
    17→import {
    18→  loadProjectConfig,
    19→  resolveConfig,
    20→  getDefaultConfig,
    21→  KspecConfigSchema,
    22→  type ResolvedKspecConfig,
    23→} from "../../src/parser/config.js";
    24→import { initContext } from "../../src/parser/yaml.js";
    25→import { createTempDir, cleanupTempDir, initGitRepo } from "../helpers/cli.js";
    26→
    27→describe("Project Config", () => {
    28→  let tempDir: string;
    29→  let originalEnv: NodeJS.ProcessEnv;
    30→
    31→  beforeEach(async () => {
    32→    tempDir = await createTempDir("kspec-config-test-");
    33→    initGitRepo(tempDir);
    34→    originalEnv = { ...process.env };
    35→    // Clean env vars that might affect tests
    36→    delete process.env.KSPEC_AUTHOR;
    37→    delete process.env.KSPEC_DAEMON_PORT;
    38→    delete process.env.KSPEC_DAEMON_HOST;
    39→    delete process.env.KSPEC_BATCH_PROJECT_ROOT;
    40→  });
    41→
    42→  afterEach(async () => {
    43→    await cleanupTempDir(tempDir);
    44→    // Restore env
    45→    process.env = originalEnv;
    46→  });
    47→
    48→  describe("loadProjectConfig", () => {
    49→    // AC: @project-config ac-1
    50→    it("returns defaults when no config file exists", async () => {
    51→      const result = await loadProjectConfig(tempDir);
    52→
    53→      expect(result.configPath).toBeNull();
    54→      expect(result.warning).toBeNull();
    55→      expect(result.gitRoot).toBe(tempDir);
    56→      expect(result.config).toEqual(getDefaultConfig());
    57→    });
    58→
    59→    // AC: @project-config ac-1
    60→    it("returns defaults with no behavior change when no config exists", async () => {
    61→      const result = await loadProjectConfig(tempDir);
    62→      const defaults = getDefaultConfig();
    63→
    64→      expect(result.config.shadow.branch).toBe(defaults.shadow.branch);
    65→      expect(result.config.shadow.directory).toBe(defaults.shadow.directory);
    66→      expect(result.config.shadow.remote).toBe(defaults.shadow.remote);
    67→      expect(result.config.daemon.port).toBe(defaults.daemon.port);
    68→      expect(result.config.daemon.host).toBe(defaults.daemon.host);
    69→      expect(result.config.validation.strictness).toBe(
    70→        defaults.validation.strictness
    71→      );
    72→    });
    73→
    74→    // AC: @project-config ac-2 (partial - config file parsing)
    75→    it("parses valid config file", async () => {
    76→      await fs.writeFile(
    77→        path.join(tempDir, "kspec.config.yaml"),
    78→        `
    79→shadow:
    80→  branch: custom-branch
    81→  directory: .specs
    82→  remote: https://example.com/specs.git
    83→daemon:
    84→  port: 4000
    85→  host: 0.0.0.0
    86→identity:
    87→  author: "@custom-author"
    88→validation:
    89→  strictness: strict
    90→  warn_unknown_fields: false
    91→`
    92→      );
    93→
    94→      const result = await loadProjectConfig(tempDir);
    95→
    96→      expect(result.configPath).toBe(path.join(tempDir, "kspec.config.yaml"));
    97→      expect(result.warning).toBeNull();
    98→      expect(result.config.shadow.branch).toBe("custom-branch");
    99→      expect(result.config.shadow.directory).toBe(".specs");
   100→      expect(result.config.shadow.remote).toEqual({
   101→        value: "https://example.com/specs.git",
   102→        type: "url",
   103→      });
   104→      expect(result.config.daemon.port).toBe(4000);
   105→      expect(result.config.daemon.host).toBe("0.0.0.0");
   106→      expect(result.config.identity.author).toBe("@custom-author");
   107→      expect(result.config.validation.strictness).toBe("strict");
   108→      expect(result.config.validation.warn_unknown_fields).toBe(false);
   109→    });
   110→
   111→    // AC: @project-config ac-3
   112→    it("falls back to defaults and warns on invalid YAML syntax", async () => {
   113→      await fs.writeFile(
   114→        path.join(tempDir, "kspec.config.yaml"),
   115→        `
   116→shadow:
   117→  branch: [invalid yaml
   118→  this is broken:
   119→`
   120→      );
   121→
   122→      const result = await loadProjectConfig(tempDir);
   123→
   124→      expect(result.configPath).toBe(path.join(tempDir, "kspec.config.yaml"));
   125→      expect(result.warning).toContain("Failed to parse kspec.config.yaml");
   126→      expect(result.config).toEqual(getDefaultConfig());
   127→    });
   128→
   129→    // AC: @project-config ac-3
   130→    it("falls back to defaults and warns on validation errors", async () => {
   131→      await fs.writeFile(
   132→        path.join(tempDir, "kspec.config.yaml"),
   133→        `
   134→daemon:
   135→  port: "not-a-number"
   136→`
   137→      );
   138→
   139→      const result = await loadProjectConfig(tempDir);
   140→
   141→      expect(result.warning).toContain("Config validation failed");
   142→      expect(result.config).toEqual(getDefaultConfig());
   143→    });
   144→
   145→    // AC: @project-config ac-4
   146→    it("ignores unknown fields and applies valid fields", async () => {
   147→      await fs.writeFile(
   148→        path.join(tempDir, "kspec.config.yaml"),
   149→        `
   150→daemon:
   151→  port: 5000
   152→unknown_top_level_field: "should be ignored"
   153→another_unknown:
   154→  nested: value
   155→`
   156→      );
   157→
   158→      const result = await loadProjectConfig(tempDir);
   159→
   160→      expect(result.warning).toBeNull();
   161→      expect(result.config.daemon.port).toBe(5000);
   162→      // Defaults should still be applied for unspecified fields
   163→      expect(result.config.shadow.branch).toBe("kspec-meta");
   164→    });
   165→
   166→    // AC: @project-config ac-5
   167→    it("env vars take precedence over config file values", async () => {
   168→      await fs.writeFile(
   169→        path.join(tempDir, "kspec.config.yaml"),
   170→        `
   171→identity:
   172→  author: "@config-author"
   173→daemon:
   174→  port: 5000
   175→  host: from-config.local
   176→`
   177→      );
   178→
   179→      process.env.KSPEC_AUTHOR = "@env-author";
   180→      process.env.KSPEC_DAEMON_PORT = "6000";
   181→      process.env.KSPEC_DAEMON_HOST = "env-host.local";
   182→
   183→      const result = await loadProjectConfig(tempDir);
   184→
   185→      expect(result.config.identity.author).toBe("@env-author");
   186→      expect(result.config.daemon.port).toBe(6000);
   187→      expect(result.config.daemon.host).toBe("env-host.local");
   188→    });
   189→
   190→    // AC: @project-config ac-5
   191→    it("env vars apply even when no config file exists", async () => {
   192→      process.env.KSPEC_AUTHOR = "@env-only";
   193→      process.env.KSPEC_DAEMON_PORT = "7000";
   194→
   195→      const result = await loadProjectConfig(tempDir);
   196→
   197→      expect(result.config.identity.author).toBe("@env-only");
   198→      expect(result.config.daemon.port).toBe(7000);
   199→    });
   200→
   201→    // AC: @project-config ac-6
   202→    it("loads config from git root, not subdirectory", async () => {
   203→      // Create config in git root
   204→      await fs.writeFile(
   205→        path.join(tempDir, "kspec.config.yaml"),
   206→        `
   207→daemon:
   208→  port: 8000
   209→`
   210→      );
   211→
   212→      // Create subdirectory
   213→      const subDir = path.join(tempDir, "src", "deep", "nested");
   214→      await fs.mkdir(subDir, { recursive: true });
   215→
   216→      const result = await loadProjectConfig(subDir);
   217→
   218→      expect(result.gitRoot).toBe(tempDir);
   219→      expect(result.config.daemon.port).toBe(8000);
   220→    });
   221→
   222→    // AC: @project-config ac-7
   223→    it("uses KSPEC_BATCH_PROJECT_ROOT when set (batch mode)", async () => {
   224→      // Create config in the "real" project root
   225→      await fs.writeFile(
   226→        path.join(tempDir, "kspec.config.yaml"),
   227→        `
   228→daemon:
   229→  port: 9000
   230→`
   231→      );
   232→
   233→      // Create a separate temp dir to simulate batch mode
   234→      const batchTempDir = await createTempDir("kspec-batch-");
   235→
   236→      try {
   237→        // Simulate batch mode by setting the env var
   238→        process.env.KSPEC_BATCH_PROJECT_ROOT = tempDir;
   239→
   240→        // Load config from the batch temp dir - should still find config from real root
   241→        const result = await loadProjectConfig(batchTempDir);
   242→
   243→        expect(result.config.daemon.port).toBe(9000);
   244→      } finally {
   245→        await cleanupTempDir(batchTempDir);
   246→      }
   247→    });
   248→  });
   249→
   250→  describe("resolveConfig", () => {
   251→    it("returns defaults for null input", () => {
   252→      const config = resolveConfig(null);
   253→      expect(config).toEqual(getDefaultConfig());
   254→    });
   255→
   256→    it("merges partial config with defaults", () => {
   257→      const config = resolveConfig({
   258→        daemon: { port: 4567 },
   259→      });
   260→
   261→      expect(config.daemon.port).toBe(4567);
   262→      expect(config.daemon.host).toBe("localhost"); // default
   263→      expect(config.shadow.branch).toBe("kspec-meta"); // default
   264→    });
   265→
   266→    it("applies env var overrides", () => {
   267→      process.env.KSPEC_AUTHOR = "@test-author";
   268→
   269→      const config = resolveConfig({
   270→        identity: { author: "@file-author" },
   271→      });
   272→
   273→      expect(config.identity.author).toBe("@test-author");
   274→    });
   275→
   276→    it("handles invalid KSPEC_DAEMON_PORT gracefully", () => {
   277→      process.env.KSPEC_DAEMON_PORT = "not-a-number";
   278→
   279→      const config = resolveConfig({
   280→        daemon: { port: 4000 },
   281→      });
   282→
   283→      // Should fall back to file value since env is invalid
   284→      expect(config.daemon.port).toBe(4000);
   285→    });
   286→  });
   287→
   288→  describe("KspecConfigSchema", () => {
   289→    it("validates correct config", () => {
   290→      const result = KspecConfigSchema.safeParse({
   291→        shadow: {
   292→          branch: "my-branch",
   293→          directory: ".specs",
   294→          remote: "https://github.com/org/repo.git",
   295→        },
   296→        daemon: {
   297→          port: 3000,
   298→          host: "localhost",
   299→        },
   300→        identity: {
   301→          author: "@me",
   302→        },
   303→        validation: {
   304→          strictness: "strict",
   305→          warn_unknown_fields: true,
   306→        },
   307→      });
   308→
   309→      expect(result.success).toBe(true);
   310→    });
   311→
   312→    it("allows partial config", () => {
   313→      const result = KspecConfigSchema.safeParse({
   314→        daemon: { port: 4000 },
   315→      });
   316→
   317→      expect(result.success).toBe(true);
   318→    });
   319→
   320→    it("allows empty config", () => {
   321→      const result = KspecConfigSchema.safeParse({});
   322→      expect(result.success).toBe(true);
   323→    });
   324→
   325→    // AC: @project-config ac-4
   326→    it("allows unknown top-level fields (passthrough)", () => {
   327→      const result = KspecConfigSchema.safeParse({
   328→        daemon: { port: 4000 },
   329→        custom_field: "value",
   330→        another: { nested: true },
   331→      });
   332→
   333→      expect(result.success).toBe(true);
   334→    });
   335→
   336→    it("rejects invalid port", () => {
   337→      const result = KspecConfigSchema.safeParse({
   338→        daemon: { port: 70000 }, // above 65535
   339→      });
   340→
   341→      expect(result.success).toBe(false);
   342→    });
   343→
   344→    it("rejects invalid strictness value", () => {
   345→      const result = KspecConfigSchema.safeParse({
   346→        validation: { strictness: "invalid" },
   347→      });
   348→
   349→      expect(result.success).toBe(false);
   350→    });
   351→  });
   352→
   353→  // AC: @project-config ac-2 - full integration test
   354→  describe("initContext integration", () => {
   355→    it("includes config on KspecContext", async () => {
   356→      // Create a minimal kspec setup
   357→      await fs.mkdir(path.join(tempDir, "spec"), { recursive: true });
   358→      await fs.writeFile(
   359→        path.join(tempDir, "spec", "kynetic.yaml"),
   360→        `
   361→kynetic: "1.0"
   362→title: Test Project
   363→`
   364→      );
   365→      await fs.writeFile(
   366→        path.join(tempDir, "kspec.config.yaml"),
   367→        `
   368→daemon:
   369→  port: 5555
   370→`
   371→      );
   372→
   373→      const ctx = await initContext(tempDir);
   374→
   375→      expect(ctx.config).toBeDefined();
   376→      expect(ctx.config.daemon.port).toBe(5555);
   377→      expect(ctx.config.shadow.branch).toBe("kspec-meta"); // default
   378→    });
   379→
   380→    it("has config available even when no config file exists", async () => {
   381→      // Create a minimal kspec setup without config file
   382→      await fs.mkdir(path.join(tempDir, "spec"), { recursive: true });
   383→      await fs.writeFile(
   384→        path.join(tempDir, "spec", "kynetic.yaml"),
   385→        `
   386→kynetic: "1.0"
   387→title: Test Project
   388→`
   389→      );
   390→
   391→      const ctx = await initContext(tempDir);
   392→
   393→      expect(ctx.config).toBeDefined();
   394→      expect(ctx.config).toEqual(getDefaultConfig());
   395→    });
   396→  });
   397→
   398→  describe("getDefaultConfig", () => {
   399→    it("returns consistent defaults", () => {
   400→      const defaults = getDefaultConfig();
   401→
   402→      expect(defaults.shadow.branch).toBe("kspec-meta");
   403→      expect(defaults.shadow.directory).toBe(".kspec");
   404→      expect(defaults.shadow.remote).toBeNull();
   405→      expect(defaults.identity.author).toBeNull();
   406→      expect(defaults.validation.strictness).toBe("normal");
   407→      expect(defaults.validation.warn_unknown_fields).toBe(true);
   408→      expect(defaults.daemon.port).toBe(3456);
   409→      expect(defaults.daemon.host).toBe("localhost");
   410→    });
   411→
   412→    it("returns independent objects", () => {
   413→      const defaults1 = getDefaultConfig();
   414→      const defaults2 = getDefaultConfig();
   415→
   416→      defaults1.daemon.port = 9999;
   417→
   418→      expect(defaults2.daemon.port).toBe(3456); // Should not be affected
   419→    });
   420→  });
   421→});
   422→

