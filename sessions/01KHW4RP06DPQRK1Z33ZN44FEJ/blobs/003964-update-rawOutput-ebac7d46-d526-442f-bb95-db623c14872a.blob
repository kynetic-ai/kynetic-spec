     1→/**
     2→ * Platform Skill Renderers
     3→ *
     4→ * Defines the contract for platform-specific skill renderers and provides
     5→ * the Claude Code implementation. Each renderer writes platform-specific output
     6→ * (SKILL.md with frontmatter, sidecar config files, supporting directories)
     7→ * to a configurable output directory.
     8→ *
     9→ * AC: @claude-code-renderer ac-1 - renderClaudeCodeSkill creates .claude/skills/<id>/SKILL.md with YAML frontmatter
    10→ * AC: @claude-code-renderer ac-2 - rendered output has YAML frontmatter delimiters with name and description fields
    11→ * AC: @claude-code-renderer ac-3 - skill body content appears verbatim below frontmatter
    12→ * AC: @claude-code-renderer ac-4 - rendered files appear as unstaged changes on main branch
    13→ *
    14→ * AC: @skill-drift-detection ac-1 - Skill shows as in-sync when not manually edited
    15→ * AC: @skill-drift-detection ac-2 - Skill shows as drifted when manually edited
    16→ * AC: @skill-drift-detection ac-5 - Render hash stored in .kspec/skills/<id>/.render-hash
    17→ *
    18→ * AC: @consolidate-skill-render ac-3 - hash/drift functions exported from this module
    19→ *
    20→ * AC: @platform-renderer-trait ac-1 - platform-specific output files written to configured output directory
    21→ * AC: @platform-renderer-trait ac-2 - PlatformRenderResult returned with id, platform, action, paths
    22→ * AC: @platform-renderer-trait ac-3 - supporting directories (references/, scripts/, assets/) copied
    23→ * AC: @platform-renderer-trait ac-4 - dryRun mode: no files written, result reflects what would happen
    24→ * AC: @platform-renderer-trait ac-5 - custom outputDir goes to custom path instead of platform default
    25→ * AC: @platform-renderer-trait ac-6 - per-platform render hash written to .render-hash-<platform>
    26→ *
    27→ * AC: @codex-renderer ac-1 - .agents/skills/<id>/SKILL.md with only name and description in frontmatter
    28→ * AC: @codex-renderer ac-2 - .agents/skills/<id>/agents/openai.yaml sidecar with platform_config.codex fields
    29→ * AC: @codex-renderer ac-3 - no sidecar created when no platform_config.codex
    30→ * AC: @codex-renderer ac-4 - rendered file contains <!-- kspec-managed --> marker
    31→ * AC: @codex-renderer ac-5 - supporting directories (references/, scripts/, assets/) copied
    32→ * AC: @codex-renderer ac-6 - hash written to .render-hash-codex
    33→ */
    34→
    35→import * as crypto from "node:crypto";
    36→import * as fs from "node:fs/promises";
    37→import * as path from "node:path";
    38→import yaml from "yaml";
    39→import type { KspecContext } from "./yaml.js";
    40→import { loadSkillContent, type LoadedSkill } from "./meta.js";
    41→
    42→// ============================================================================
    43→// Platform Renderer Contract (AC: @platform-renderer-trait)
    44→// ============================================================================
    45→
    46→/**
    47→ * Status of drift detection for a rendered skill
    48→ * AC: @platform-renderer-trait ac-2
    49→ */
    50→export type DriftStatus = "not-rendered" | "in-sync" | "drifted" | "no-hash";
    51→
    52→/**
    53→ * Result of rendering a skill to a specific platform
    54→ * AC: @platform-renderer-trait ac-2
    55→ */
    56→export interface PlatformRenderResult {
    57→  /** Skill ID */
    58→  id: string;
    59→  /** Platform this result is for */
    60→  platform: string;
    61→  /** Action taken: created, updated, unchanged, or skipped */
    62→  action: "created" | "updated" | "unchanged" | "skipped";
    63→  /** Paths to all output files */
    64→  paths: string[];
    65→  /** Actions taken on supporting directories (references/, scripts/, assets/, docs/) */
    66→  supportingDirsAction?: Record<string, "created" | "updated" | "unchanged" | "skipped">;
    67→  /** Reason if action is skipped */
    68→  skipReason?: string;
    69→}
    70→
    71→/**
    72→ * Options for rendering a skill to a platform
    73→ * AC: @platform-renderer-trait ac-4, ac-5
    74→ */
    75→export interface PlatformRenderOptions {
    76→  /** If true, don't write files, just return what would be done */
    77→  dryRun?: boolean;
    78→  /** If true, store a hash of the rendered content for drift detection */
    79→  storeHash?: boolean;
    80→  /** Custom output directory (overrides platform default) */
    81→  outputDir?: string;
    82→}
    83→
    84→/**
    85→ * Contract for platform-specific skill renderers
    86→ * AC: @platform-renderer-trait ac-1, ac-2
    87→ */
    88→export interface PlatformRenderer {
    89→  /** Platform identifier (e.g., "claude-code", "codex") */
    90→  platform: string;
    91→  /** Default output directory relative to project root (e.g., ".claude/skills") */
    92→  defaultOutputDir: string;
    93→  /**
    94→   * Render a skill to platform-specific output
    95→   * AC: @platform-renderer-trait ac-1, ac-2, ac-3, ac-4, ac-5
    96→   */
    97→  render(
    98→    ctx: KspecContext,
    99→    projectRoot: string,
   100→    skill: LoadedSkill,
   101→    options?: PlatformRenderOptions
   102→  ): Promise<PlatformRenderResult>;
   103→  /**
   104→   * Check if a rendered skill has drifted from its source
   105→   * AC: @platform-renderer-trait ac-6
   106→   */
   107→  checkDrift(
   108→    specDir: string,
   109→    projectRoot: string,
   110→    skillId: string,
   111→    options?: { outputDir?: string }
   112→  ): Promise<DriftStatus>;
   113→}
   114→
   115→// ============================================================================
   116→// Backward Compatibility Types
   117→// ============================================================================
   118→
   119→/**
   120→ * Result of rendering a skill to Claude Code format
   121→ * @deprecated Use PlatformRenderResult instead
   122→ */
   123→export interface ClaudeCodeRenderResult {
   124→  /** Skill ID */
   125→  id: string;
   126→  /** Action taken: created, updated, or unchanged */
   127→  action: "created" | "updated" | "unchanged";
   128→  /** Path to the rendered SKILL.md file */
   129→  path: string;
   130→  /** Action taken on docs directory */
   131→  docsAction?: "created" | "updated" | "unchanged" | "skipped";
   132→}
   133→
   134→/**
   135→ * Options for rendering a skill
   136→ * @deprecated Use PlatformRenderOptions instead
   137→ */
   138→export interface RenderSkillOptions {
   139→  /** If true, don't write files, just return what would be done */
   140→  dryRun?: boolean;
   141→  /** If true, store a hash of the rendered content for drift detection */
   142→  storeHash?: boolean;
   143→  /** Custom output directory (overrides platform default) */
   144→  outputDir?: string;
   145→}
   146→
   147→/**
   148→ * Marker comment that identifies skill directories managed by kspec
   149→ */
   150→export const KSPEC_MANAGED_MARKER = "<!-- kspec-managed -->";
   151→
   152→/**
   153→ * Generate YAML frontmatter for a skill.
   154→ * AC: @claude-code-renderer ac-2 - YAML frontmatter with name and description fields
   155→ * AC: @claude-code-renderer-extended ac-1 - portable fields (license, allowed-tools)
   156→ * AC: @claude-code-renderer-extended ac-2 - user-invocable from platform_config
   157→ * AC: @claude-code-renderer-extended ac-3 - context and agent from platform_config
   158→ * AC: @claude-code-renderer-extended ac-4 - disable-model-invocation from platform_config
   159→ * AC: @claude-code-renderer-extended ac-5 - only portable fields when no platform_config
   160→ * AC: @claude-code-renderer-extended ac-8 - snake_case to kebab-case conversion
   161→ */
   162→export function generateFrontmatter(skill: LoadedSkill): string {
   163→  const frontmatter: Record<string, unknown> = {
   164→    name: skill.id,
   165→    description: skill.description || skill.name,
   166→  };
   167→
   168→  // AC: @claude-code-renderer-extended ac-1 - Add portable fields
   169→  if (skill.license) {
   170→    frontmatter.license = skill.license;
   171→  }
   172→  if (skill.allowed_tools && skill.allowed_tools.length > 0) {
   173→    frontmatter["allowed-tools"] = skill.allowed_tools;
   174→  }
   175→  if (skill.compatibility) {
   176→    frontmatter.compatibility = skill.compatibility;
   177→  }
   178→
   179→  // AC: @claude-code-renderer-extended ac-2, ac-3, ac-4 - Add Claude Code platform fields
   180→  const claudeCodeConfig = skill.platform_config?.claude_code;
   181→  if (claudeCodeConfig) {
   182→    // AC: @claude-code-renderer-extended ac-2 - user_invocable
   183→    if (claudeCodeConfig.user_invocable !== undefined) {
   184→      frontmatter["user-invocable"] = claudeCodeConfig.user_invocable;
   185→    }
   186→    // AC: @claude-code-renderer-extended ac-4 - disable_model_invocation
   187→    if (claudeCodeConfig.disable_model_invocation !== undefined) {
   188→      frontmatter["disable-model-invocation"] = claudeCodeConfig.disable_model_invocation;
   189→    }
   190→    // AC: @claude-code-renderer-extended ac-3 - context and agent
   191→    if (claudeCodeConfig.context) {
   192→      frontmatter.context = claudeCodeConfig.context;
   193→    }
   194→    if (claudeCodeConfig.agent) {
   195→      frontmatter.agent = claudeCodeConfig.agent;
   196→    }
   197→    // Other Claude Code fields
   198→    if (claudeCodeConfig.model) {
   199→      frontmatter.model = claudeCodeConfig.model;
   200→    }
   201→    if (claudeCodeConfig.argument_hint) {
   202→      frontmatter["argument-hint"] = claudeCodeConfig.argument_hint;
   203→    }
   204→  }
   205→
   206→  return `---\n${yaml.stringify(frontmatter).trim()}\n---`;
   207→}
   208→
   209→/**
   210→ * Get the target directory for rendered skills on main branch.
   211→ * Returns .claude/skills/<id>/ path.
   212→ */
   213→function getRenderedSkillPath(projectRoot: string, skillId: string): string {
   214→  return path.join(projectRoot, ".claude", "skills", skillId);
   215→}
   216→
   217→/**
   218→ * Check if two contents are equal (for idempotency check)
   219→ */
   220→export function contentsEqual(a: string, b: string): boolean {
   221→  return a.trim() === b.trim();
   222→}
   223→
   224→/**
   225→ * Recursively copy a directory
   226→ */
   227→export async function copyDirectory(src: string, dest: string): Promise<void> {
   228→  const entries = await fs.readdir(src, { withFileTypes: true });
   229→
   230→  for (const entry of entries) {
   231→    const srcPath = path.join(src, entry.name);
   232→    const destPath = path.join(dest, entry.name);
   233→
   234→    if (entry.isDirectory()) {
   235→      await fs.mkdir(destPath, { recursive: true });
   236→      await copyDirectory(srcPath, destPath);
   237→    } else {
   238→      await fs.copyFile(srcPath, destPath);
   239→    }
   240→  }
   241→}
   242→
   243→/**
   244→ * Compute SHA256 hash of content
   245→ * AC: @skill-drift-detection ac-5 - Hash computation for render tracking
   246→ */
   247→export function computeContentHash(content: string): string {
   248→  return crypto.createHash("sha256").update(content, "utf-8").digest("hex");
   249→}
   250→
   251→/**
   252→ * Get the path to the render hash file for a skill
   253→ * AC: @skill-drift-detection ac-5 - Hash stored in .kspec/skills/<id>/.render-hash
   254→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   255→ */
   256→export function getRenderHashPath(specDir: string, skillId: string): string {
   257→  return path.join(specDir, "skills", skillId, ".render-hash");
   258→}
   259→
   260→/**
   261→ * Read the stored render hash for a skill
   262→ * AC: @skill-drift-detection ac-5 - Read hash from .kspec/skills/<id>/.render-hash
   263→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   264→ */
   265→export async function readRenderHash(specDir: string, skillId: string): Promise<string | null> {
   266→  try {
   267→    const hashPath = getRenderHashPath(specDir, skillId);
   268→    const content = await fs.readFile(hashPath, "utf-8");
   269→    return content.trim();
   270→  } catch {
   271→    return null;
   272→  }
   273→}
   274→
   275→/**
   276→ * Write the render hash for a skill
   277→ * AC: @skill-drift-detection ac-5 - Store hash in .kspec/skills/<id>/.render-hash
   278→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   279→ */
   280→export async function writeRenderHash(specDir: string, skillId: string, hash: string): Promise<void> {
   281→  const hashPath = getRenderHashPath(specDir, skillId);
   282→  await fs.mkdir(path.dirname(hashPath), { recursive: true });
   283→  await fs.writeFile(hashPath, hash + "\n", "utf-8");
   284→}
   285→
   286→/**
   287→ * Check if a rendered skill has drifted from its last render
   288→ * AC: @skill-drift-detection ac-1, ac-2 - Drift detection via hash comparison
   289→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   290→ *
   291→ * Returns:
   292→ * - "not-rendered": Rendered file doesn't exist
   293→ * - "in-sync": Rendered file matches stored hash
   294→ * - "drifted": Rendered file differs from stored hash (manually edited)
   295→ * - "no-hash": Rendered file exists but no stored hash (first render or hash deleted)
   296→ */
   297→export async function checkSkillDrift(
   298→  specDir: string,
   299→  projectRoot: string,
   300→  skillId: string
   301→): Promise<"not-rendered" | "in-sync" | "drifted" | "no-hash"> {
   302→  const renderedPath = path.join(projectRoot, ".claude", "skills", skillId, "SKILL.md");
   303→
   304→  // Check if rendered file exists
   305→  let renderedContent: string;
   306→  try {
   307→    renderedContent = await fs.readFile(renderedPath, "utf-8");
   308→  } catch {
   309→    return "not-rendered";
   310→  }
   311→
   312→  // Get stored hash
   313→  const storedHash = await readRenderHash(specDir, skillId);
   314→  if (!storedHash) {
   315→    return "no-hash";
   316→  }
   317→
   318→  // Compare hashes
   319→  const currentHash = computeContentHash(renderedContent);
   320→  return currentHash === storedHash ? "in-sync" : "drifted";
   321→}
   322→
   323→/**
   324→ * Recursively check if two directories have the same contents
   325→ */
   326→export async function directoriesEqual(src: string, dest: string): Promise<boolean> {
   327→  try {
   328→    const srcEntries = await fs.readdir(src, { withFileTypes: true });
   329→    const destEntries = await fs.readdir(dest, { withFileTypes: true });
   330→
   331→    // Different number of entries = not equal
   332→    if (srcEntries.length !== destEntries.length) {
   333→      return false;
   334→    }
   335→
   336→    // Create a map of dest entries for quick lookup
   337→    const destMap = new Map(destEntries.map((e) => [e.name, e]));
   338→
   339→    for (const srcEntry of srcEntries) {
   340→      const destEntry = destMap.get(srcEntry.name);
   341→      if (!destEntry) {
   342→        return false;
   343→      }
   344→
   345→      const srcPath = path.join(src, srcEntry.name);
   346→      const destPath = path.join(dest, srcEntry.name);
   347→
   348→      if (srcEntry.isDirectory() && destEntry.isDirectory()) {
   349→        if (!(await directoriesEqual(srcPath, destPath))) {
   350→          return false;
   351→        }
   352→      } else if (srcEntry.isFile() && destEntry.isFile()) {
   353→        const srcContent = await fs.readFile(srcPath, "utf-8");
   354→        const destContent = await fs.readFile(destPath, "utf-8");
   355→        if (!contentsEqual(srcContent, destContent)) {
   356→          return false;
   357→        }
   358→      } else {
   359→        // Type mismatch
   360→        return false;
   361→      }
   362→    }
   363→
   364→    return true;
   365→  } catch {
   366→    return false;
   367→  }
   368→}
   369→
   370→// ============================================================================
   371→// Supporting Directories (AC: @platform-renderer-trait ac-3, @claude-code-renderer-extended ac-7)
   372→// ============================================================================
   373→
   374→/** Known supporting directory names */
   375→const SUPPORTING_DIRS = ["references", "scripts", "assets", "docs"] as const;
   376→
   377→/**
   378→ * Copy supporting directories from source skill to rendered output
   379→ * AC: @platform-renderer-trait ac-3 - Supporting directories copied to platform output
   380→ * AC: @claude-code-renderer-extended ac-7 - references/, scripts/, assets/ copied
   381→ */
   382→async function copySupportingDirectories(
   383→  sourceSkillDir: string,
   384→  targetSkillDir: string,
   385→  dryRun: boolean
   386→): Promise<Record<string, "created" | "updated" | "unchanged" | "skipped">> {
   387→  const results: Record<string, "created" | "updated" | "unchanged" | "skipped"> = {};
   388→
   389→  for (const dirName of SUPPORTING_DIRS) {
   390→    const sourceDir = path.join(sourceSkillDir, dirName);
   391→    const targetDir = path.join(targetSkillDir, dirName);
   392→
   393→    try {
   394→      const stats = await fs.stat(sourceDir);
   395→      if (!stats.isDirectory()) {
   396→        results[dirName] = "skipped";
   397→        continue;
   398→      }
   399→
   400→      // Check if target exists
   401→      let targetExists = false;
   402→      try {
   403→        await fs.stat(targetDir);
   404→        targetExists = true;
   405→      } catch {
   406→        // Target doesn't exist
   407→      }
   408→
   409→      if (!targetExists) {
   410→        results[dirName] = "created";
   411→      } else {
   412→        // Compare directories
   413→        const equal = await directoriesEqual(sourceDir, targetDir);
   414→        results[dirName] = equal ? "unchanged" : "updated";
   415→      }
   416→
   417→      // Apply changes
   418→      if (!dryRun && results[dirName] !== "unchanged") {
   419→        if (targetExists) {
   420→          await fs.rm(targetDir, { recursive: true, force: true });
   421→        }
   422→        await fs.mkdir(targetDir, { recursive: true });
   423→        await copyDirectory(sourceDir, targetDir);
   424→      }
   425→    } catch {
   426→      // Source directory doesn't exist
   427→      results[dirName] = "skipped";
   428→    }
   429→  }
   430→
   431→  return results;
   432→}
   433→
   434→/**
   435→ * Render a skill to Claude Code format.
   436→ *
   437→ * Reads skill content from .kspec/skills/<id>/SKILL.md and writes to
   438→ * .claude/skills/<id>/SKILL.md with YAML frontmatter containing name and description.
   439→ *
   440→ * AC: @claude-code-renderer ac-1 - Creates .claude/skills/<id>/SKILL.md with YAML frontmatter
   441→ * AC: @claude-code-renderer ac-2 - YAML frontmatter has name and description fields
   442→ * AC: @claude-code-renderer ac-3 - Skill body content appears verbatim below frontmatter
   443→ * AC: @claude-code-renderer ac-4 - Files are written to disk as unstaged changes (no git commit)
   444→ *
   445→ * @param ctx - Kspec context with specDir pointing to .kspec/
   446→ * @param projectRoot - Root directory of the project (where .claude/ will be created)
   447→ * @param skill - The skill to render
   448→ * @param options - Render options (dryRun, etc.)
   449→ * @returns Result indicating what action was taken
   450→ */
   451→export async function renderClaudeCodeSkill(
   452→  ctx: KspecContext,
   453→  projectRoot: string,
   454→  skill: LoadedSkill,
   455→  options: RenderSkillOptions = {},
   456→): Promise<ClaudeCodeRenderResult> {
   457→  const dryRun = options.dryRun ?? false;
   458→  const storeHash = options.storeHash ?? false;
   459→  const targetDir = getRenderedSkillPath(projectRoot, skill.id);
   460→  const targetSkillMd = path.join(targetDir, "SKILL.md");
   461→
   462→  // AC: @claude-code-renderer ac-3 - Load source content verbatim
   463→  const sourceContent = await loadSkillContent(ctx, skill);
   464→
   465→  if (!sourceContent) {
   466→    // No source content, but skill exists in meta - create placeholder
   467→    const frontmatter = generateFrontmatter(skill);
   468→    const renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
   469→
   470→    // AC: @claude-code-renderer ac-4 - Write to disk (unstaged)
   471→    if (!dryRun) {
   472→      await fs.mkdir(targetDir, { recursive: true });
   473→      await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
   474→      // AC: @skill-drift-detection ac-5 - Store hash of rendered output
   475→      if (storeHash) {
   476→        const hash = computeContentHash(renderedContent);
   477→        await writeRenderHash(ctx.specDir, skill.id, hash);
   478→      }
   479→    }
   480→
   481→    return {
   482→      id: skill.id,
   483→      action: "created",
   484→      path: targetSkillMd,
   485→    };
   486→  }
   487→
   488→  // AC: @claude-code-renderer ac-2 - Generate frontmatter with name and description
   489→  const frontmatter = generateFrontmatter(skill);
   490→
   491→  // Check if source already has frontmatter - if so, strip it
   492→  const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
   493→  const contentWithoutFrontmatter = frontmatterMatch
   494→    ? sourceContent.slice(frontmatterMatch[0].length)
   495→    : sourceContent;
   496→
   497→  // AC: @claude-code-renderer ac-1, ac-3 - Build rendered content with frontmatter + verbatim body
   498→  const renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
   499→
   500→  // Check if target exists and compare for idempotency
   501→  let targetExists = false;
   502→  let targetContent = "";
   503→  try {
   504→    targetContent = await fs.readFile(targetSkillMd, "utf-8");
   505→    targetExists = true;
   506→  } catch {
   507→    // Target doesn't exist
   508→  }
   509→
   510→  // Determine action based on comparison
   511→  let action: "created" | "updated" | "unchanged";
   512→
   513→  if (!targetExists) {
   514→    action = "created";
   515→  } else if (contentsEqual(renderedContent, targetContent)) {
   516→    action = "unchanged";
   517→  } else {
   518→    action = "updated";
   519→  }
   520→
   521→  // AC: @claude-code-renderer ac-4 - Apply changes to disk (no git commit)
   522→  if (!dryRun && action !== "unchanged") {
   523→    await fs.mkdir(targetDir, { recursive: true });
   524→    await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
   525→    // AC: @skill-drift-detection ac-5 - Store hash of rendered output
   526→    if (storeHash) {
   527→      const hash = computeContentHash(renderedContent);
   528→      await writeRenderHash(ctx.specDir, skill.id, hash);
   529→    }
   530→  }
   531→
   532→  // AC: @claude-code-renderer-extended ac-7 - Copy supporting directories (references/, scripts/, assets/, docs/)
   533→  const sourceSkillDir = path.join(ctx.specDir, "skills", skill.id);
   534→  const supportingDirsAction = await copySupportingDirectories(
   535→    sourceSkillDir,
   536→    targetDir,
   537→    dryRun
   538→  );
   539→
   540→  // For backward compatibility, also expose docsAction
   541→  const docsAction = supportingDirsAction.docs || "skipped";
   542→
   543→  return {
   544→    id: skill.id,
   545→    action,
   546→    path: targetSkillMd,
   547→    docsAction,
   548→  };
   549→}
   550→
   551→/**
   552→ * Check if a skill directory is managed by kspec.
   553→ * Looks for the KSPEC_MANAGED_MARKER in the SKILL.md file.
   554→ */
   555→export async function isKspecManagedSkill(skillMdPath: string): Promise<boolean> {
   556→  try {
   557→    const content = await fs.readFile(skillMdPath, "utf-8");
   558→    return content.includes(KSPEC_MANAGED_MARKER);
   559→  } catch {
   560→    return false;
   561→  }
   562→}
   563→
   564→// ============================================================================
   565→// Per-Platform Hash Functions (AC: @platform-renderer-trait ac-6)
   566→// ============================================================================
   567→
   568→/**
   569→ * Get the path to the per-platform render hash file for a skill
   570→ * AC: @platform-renderer-trait ac-6 - Per-platform hash stored in .render-hash-<platform>
   571→ */
   572→export function getPlatformRenderHashPath(specDir: string, skillId: string, platform: string): string {
   573→  return path.join(specDir, "skills", skillId, `.render-hash-${platform}`);
   574→}
   575→
   576→/**
   577→ * Read the stored render hash for a skill on a specific platform
   578→ * AC: @platform-renderer-trait ac-6 - Read per-platform hash
   579→ * AC: @claude-code-renderer-extended ac-6 - fallback to legacy hash
   580→ */
   581→export async function readPlatformRenderHash(
   582→  specDir: string,
   583→  skillId: string,
   584→  platform: string
   585→): Promise<string | null> {
   586→  try {
   587→    const hashPath = getPlatformRenderHashPath(specDir, skillId, platform);
   588→    const content = await fs.readFile(hashPath, "utf-8");
   589→    return content.trim();
   590→  } catch {
   591→    // Fall back to legacy hash (non-platform-specific)
   592→    return readRenderHash(specDir, skillId);
   593→  }
   594→}
   595→
   596→/**
   597→ * Migrate legacy .render-hash to platform-specific .render-hash-<platform>
   598→ * AC: @claude-code-renderer-extended ac-6 - hash migration
   599→ */
   600→export async function migrateLegacyRenderHash(
   601→  specDir: string,
   602→  skillId: string,
   603→  platform: string
   604→): Promise<boolean> {
   605→  const legacyHashPath = getRenderHashPath(specDir, skillId);
   606→  const platformHashPath = getPlatformRenderHashPath(specDir, skillId, platform);
   607→
   608→  try {
   609→    // Check if platform-specific hash already exists
   610→    await fs.access(platformHashPath);
   611→    return false; // Already migrated
   612→  } catch {
   613→    // Platform-specific doesn't exist, check for legacy
   614→  }
   615→
   616→  try {
   617→    const legacyHash = await fs.readFile(legacyHashPath, "utf-8");
   618→    // Write to platform-specific location
   619→    await writePlatformRenderHash(specDir, skillId, platform, legacyHash.trim());
   620→    return true; // Migrated successfully
   621→  } catch {
   622→    return false; // No legacy hash to migrate
   623→  }
   624→}
   625→
   626→/**
   627→ * Write the render hash for a skill on a specific platform
   628→ * AC: @platform-renderer-trait ac-6 - Store per-platform hash in .render-hash-<platform>
   629→ */
   630→export async function writePlatformRenderHash(
   631→  specDir: string,
   632→  skillId: string,
   633→  platform: string,
   634→  hash: string
   635→): Promise<void> {
   636→  const hashPath = getPlatformRenderHashPath(specDir, skillId, platform);
   637→  await fs.mkdir(path.dirname(hashPath), { recursive: true });
   638→  await fs.writeFile(hashPath, hash + "\n", "utf-8");
   639→}
   640→
   641→/**
   642→ * Check if a rendered skill has drifted from its last render for a specific platform
   643→ * AC: @platform-renderer-trait ac-6 - Platform-specific drift detection
   644→ */
   645→export async function checkPlatformSkillDrift(
   646→  specDir: string,
   647→  projectRoot: string,
   648→  skillId: string,
   649→  platform: string,
   650→  outputDir?: string
   651→): Promise<DriftStatus> {
   652→  // Determine the output directory - use custom or platform default
   653→  const platformOutputDir = outputDir || getPlatformDefaultOutputDir(platform);
   654→  const renderedPath = path.join(projectRoot, platformOutputDir, skillId, "SKILL.md");
   655→
   656→  // Check if rendered file exists
   657→  let renderedContent: string;
   658→  try {
   659→    renderedContent = await fs.readFile(renderedPath, "utf-8");
   660→  } catch {
   661→    return "not-rendered";
   662→  }
   663→
   664→  // AC: @claude-code-renderer-extended ac-6 - Migrate legacy hash if needed
   665→  await migrateLegacyRenderHash(specDir, skillId, platform);
   666→
   667→  // Get stored hash (try platform-specific first, then fall back to legacy)
   668→  const storedHash = await readPlatformRenderHash(specDir, skillId, platform);
   669→  if (!storedHash) {
   670→    return "no-hash";
   671→  }
   672→
   673→  // Compare hashes
   674→  const currentHash = computeContentHash(renderedContent);
   675→  return currentHash === storedHash ? "in-sync" : "drifted";
   676→}
   677→
   678→/**
   679→ * Get the default output directory for a platform
   680→ */
   681→function getPlatformDefaultOutputDir(platform: string): string {
   682→  switch (platform) {
   683→    case "claude-code":
   684→      return ".claude/skills";
   685→    case "codex":
   686→      return ".agents/skills";
   687→    default:
   688→      return `.${platform}/skills`;
   689→  }
   690→}
   691→
   692→// ============================================================================
   693→// Base Render Function
   694→// AC: @skill-module-split ac-2 - Shared render logic extracted into base function
   695→// ============================================================================
   696→
   697→/**
   698→ * Options for the base render function
   699→ */
   700→interface BaseRenderConfig {
   701→  /** Platform name (e.g., "claude-code", "codex") */
   702→  platform: string;
   703→  /** Generate the YAML frontmatter for this skill */
   704→  generateFrontmatter: (skill: LoadedSkill) => string;
   705→  /** Optional: generate additional hash content (e.g., sidecar files) */
   706→  getAdditionalHashContent?: (renderedContent: string) => string | null;
   707→  /** Optional: write additional files after SKILL.md (e.g., sidecar) */
   708→  writeAdditionalFiles?: (
   709→    ctx: KspecContext,
   710→    skill: LoadedSkill,
   711→    targetDir: string,
   712→    dryRun: boolean
   713→  ) => Promise<{ paths: string[]; contentChanged: boolean }>;
   714→  /** Optional: additional hash computation for drift check */
   715→  getAdditionalDriftContent?: (skillDir: string) => Promise<string | null>;
   716→  /** If true, also write legacy .render-hash for backward compatibility */
   717→  writeLegacyHash?: boolean;
   718→}
   719→
   720→/**
   721→ * Base render function that handles shared logic across all platform renderers:
   722→ * content loading, frontmatter stripping, idempotency check, file write,
   723→ * hash storage, and supporting directory copy.
   724→ *
   725→ * AC: @skill-module-split ac-2 - Shared render logic in base function
   726→ * AC: @platform-renderer-trait ac-1 through ac-6
   727→ */
   728→export async function renderSkillBase(
   729→  ctx: KspecContext,
   730→  projectRoot: string,
   731→  skill: LoadedSkill,
   732→  options: PlatformRenderOptions,
   733→  config: BaseRenderConfig,
   734→  defaultOutputDir: string
   735→): Promise<PlatformRenderResult> {
   736→  const dryRun = options.dryRun ?? false;
   737→  const storeHash = options.storeHash ?? false;
   738→  const outputDir = options.outputDir || defaultOutputDir;
   739→
   740→  const targetDir = path.join(projectRoot, outputDir, skill.id);
   741→  const targetSkillMd = path.join(targetDir, "SKILL.md");
   742→  const paths: string[] = [];
   743→
   744→  // Load source content
   745→  const sourceContent = await loadSkillContent(ctx, skill);
   746→
   747→  // Generate platform-specific frontmatter
   748→  const frontmatter = config.generateFrontmatter(skill);
   749→
   750→  // Build rendered content: frontmatter + marker + body
   751→  let renderedContent: string;
   752→  if (!sourceContent) {
   753→    renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
   754→  } else {
   755→    const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
   756→    const contentWithoutFrontmatter = frontmatterMatch
   757→      ? sourceContent.slice(frontmatterMatch[0].length)
   758→      : sourceContent;
   759→    renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
   760→  }
   761→
   762→  // Idempotency check
   763→  let targetExists = false;
   764→  let targetContent = "";
   765→  try {
   766→    targetContent = await fs.readFile(targetSkillMd, "utf-8");
   767→    targetExists = true;
   768→  } catch {
   769→    // Target doesn't exist
   770→  }
   771→
   772→  let action: "created" | "updated" | "unchanged" | "skipped";
   773→  if (!targetExists) {
   774→    action = "created";
   775→  } else if (contentsEqual(renderedContent, targetContent)) {
   776→    action = "unchanged";
   777→  } else {
   778→    action = "updated";
   779→  }
   780→
   781→  // Write SKILL.md
   782→  if (!dryRun && action !== "unchanged") {
   783→    await fs.mkdir(targetDir, { recursive: true });
   784→    await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
   785→  }
   786→  paths.push(targetSkillMd);
   787→
   788→  // Write additional files (e.g., sidecar for codex)
   789→  let additionalContentChanged = false;
   790→  if (config.writeAdditionalFiles) {
   791→    const additional = await config.writeAdditionalFiles(ctx, skill, targetDir, dryRun);
   792→    paths.push(...additional.paths);
   793→    additionalContentChanged = additional.contentChanged;
   794→  }
   795→
   796→  // Store per-platform hash
   797→  const contentChanged = action !== "unchanged" || additionalContentChanged;
   798→  if (!dryRun && storeHash && contentChanged) {
   799→    // Get additional content for hash (e.g., sidecar content)
   800→    const additionalHashContent = config.getAdditionalHashContent?.(renderedContent);
   801→    const hashContent = additionalHashContent
   802→      ? renderedContent + "\n" + additionalHashContent
   803→      : renderedContent;
   804→    const hash = computeContentHash(hashContent);
   805→    await writePlatformRenderHash(ctx.specDir, skill.id, config.platform, hash);
   806→    if (config.writeLegacyHash) {
   807→      await writeRenderHash(ctx.specDir, skill.id, hash);
   808→    }
   809→  }
   810→
   811→  // Copy supporting directories
   812→  const sourceSkillDir = path.join(ctx.specDir, "skills", skill.id);
   813→  const supportingDirsAction = await copySupportingDirectories(
   814→    sourceSkillDir,
   815→    targetDir,
   816→    dryRun
   817→  );
   818→
   819→  for (const [dirName, dirAction] of Object.entries(supportingDirsAction)) {
   820→    if (dirAction !== "skipped") {
   821→      paths.push(path.join(targetDir, dirName));
   822→    }
   823→  }
   824→
   825→  return {
   826→    id: skill.id,
   827→    platform: config.platform,
   828→    action,
   829→    paths,
   830→    supportingDirsAction,
   831→  };
   832→}
   833→
   834→// ============================================================================
   835→// Claude Code Renderer (implements PlatformRenderer)
   836→// ============================================================================
   837→
   838→/**
   839→ * Claude Code platform renderer implementation
   840→ * AC: @platform-renderer-trait ac-1 through ac-6
   841→ */
   842→export const claudeCodeRenderer: PlatformRenderer = {
   843→  platform: "claude-code",
   844→  defaultOutputDir: ".claude/skills",
   845→
   846→  async render(
   847→    ctx: KspecContext,
   848→    projectRoot: string,
   849→    skill: LoadedSkill,
   850→    options: PlatformRenderOptions = {}
   851→  ): Promise<PlatformRenderResult> {
   852→    return renderSkillBase(ctx, projectRoot, skill, options, {
   853→      platform: this.platform,
   854→      generateFrontmatter,
   855→      writeLegacyHash: true,
   856→    }, this.defaultOutputDir);
   857→  },
   858→
   859→  async checkDrift(
   860→    specDir: string,
   861→    projectRoot: string,
   862→    skillId: string,
   863→    options?: { outputDir?: string }
   864→  ): Promise<DriftStatus> {
   865→    return checkPlatformSkillDrift(
   866→      specDir,
   867→      projectRoot,
   868→      skillId,
   869→      this.platform,
   870→      options?.outputDir
   871→    );
   872→  },
   873→};
   874→
   875→// ============================================================================
   876→// Codex Renderer (implements PlatformRenderer)
   877→// AC: @codex-renderer ac-1 through ac-6
   878→// ============================================================================
   879→
   880→/**
   881→ * Generate minimal YAML frontmatter for Codex (name + description only)
   882→ * AC: @codex-renderer ac-1 - Codex frontmatter contains only name and description
   883→ */
   884→function generateCodexFrontmatter(skill: LoadedSkill): string {
   885→  const frontmatter: Record<string, unknown> = {
   886→    name: skill.id,
   887→    description: skill.description || skill.name,
   888→  };
   889→  return `---\n${yaml.stringify(frontmatter).trim()}\n---`;
   890→}
   891→
   892→/**
   893→ * Generate Codex sidecar openai.yaml content from platform_config.codex
   894→ * AC: @codex-renderer ac-2 - sidecar agents/openai.yaml with Codex config fields
   895→ */
   896→function generateCodexSidecarYaml(skill: LoadedSkill): string | null {
   897→  const codexConfig = skill.platform_config?.codex;
   898→  if (!codexConfig) {
   899→    return null;
   900→  }
   901→
   902→  // Build the sidecar structure per Codex docs
   903→  const sidecar: Record<string, unknown> = {};
   904→
   905→  // Interface section (display_name, short_description, icons, colors)
   906→  const interfaceSection: Record<string, unknown> = {};
   907→  if (codexConfig.display_name) {
   908→    interfaceSection.display_name = codexConfig.display_name;
   909→  }
   910→  if (codexConfig.short_description) {
   911→    interfaceSection.short_description = codexConfig.short_description;
   912→  }
   913→  if (codexConfig.icon_small) {
   914→    interfaceSection.icon_small = codexConfig.icon_small;
   915→  }
   916→  if (codexConfig.icon_large) {
   917→    interfaceSection.icon_large = codexConfig.icon_large;
   918→  }
   919→  if (codexConfig.brand_color) {
   920→    interfaceSection.brand_color = codexConfig.brand_color;
   921→  }
   922→  if (codexConfig.default_prompt) {
   923→    interfaceSection.default_prompt = codexConfig.default_prompt;
   924→  }
   925→  if (Object.keys(interfaceSection).length > 0) {
   926→    sidecar.interface = interfaceSection;
   927→  }
   928→
   929→  // Policy section (allow_implicit_invocation)
   930→  if (codexConfig.allow_implicit_invocation !== undefined) {
   931→    sidecar.policy = {
   932→      allow_implicit_invocation: codexConfig.allow_implicit_invocation,
   933→    };
   934→  }
   935→
   936→  // Only return content if there's something to write
   937→  if (Object.keys(sidecar).length === 0) {
   938→    return null;
   939→  }
   940→
   941→  return yaml.stringify(sidecar);
   942→}
   943→
   944→/**
   945→ * Codex platform renderer implementation
   946→ * AC: @codex-renderer ac-1 - Creates .agents/skills/<id>/SKILL.md with minimal frontmatter
   947→ * AC: @codex-renderer ac-2 - Creates sidecar agents/openai.yaml when platform_config.codex exists
   948→ * AC: @codex-renderer ac-3 - No sidecar created when no platform_config.codex
   949→ * AC: @codex-renderer ac-4 - Rendered file contains <!-- kspec-managed --> marker
   950→ * AC: @codex-renderer ac-5 - Supporting directories copied to output
   951→ * AC: @codex-renderer ac-6 - Hash written to .render-hash-codex
   952→ */
   953→export const codexRenderer: PlatformRenderer = {
   954→  platform: "codex",
   955→  defaultOutputDir: ".agents/skills",
   956→
   957→  async render(
   958→    ctx: KspecContext,
   959→    projectRoot: string,
   960→    skill: LoadedSkill,
   961→    options: PlatformRenderOptions = {}
   962→  ): Promise<PlatformRenderResult> {
   963→    // Pre-compute sidecar content so it's available for both hash and write
   964→    const sidecarContent = generateCodexSidecarYaml(skill);
   965→
   966→    return renderSkillBase(ctx, projectRoot, skill, options, {
   967→      platform: this.platform,
   968→      generateFrontmatter: generateCodexFrontmatter,
   969→
   970→      // AC: @skill-drift-detection-improvements ac-1 - Include sidecar in hash
   971→      getAdditionalHashContent: () => sidecarContent,
   972→
   973→      // AC: @codex-renderer ac-2, ac-3 - Write sidecar agents/openai.yaml
   974→      writeAdditionalFiles: async (_ctx, _skill, targetDir, dryRun) => {
   975→        const paths: string[] = [];
   976→        let contentChanged = false;
   977→
   978→        if (sidecarContent) {
   979→          const sidecarDir = path.join(targetDir, "agents");
   980→          const sidecarPath = path.join(sidecarDir, "openai.yaml");
   981→
   982→          // Check existing sidecar
   983→          let sidecarExists = false;
   984→          let existingSidecar = "";
   985→          try {
   986→            existingSidecar = await fs.readFile(sidecarPath, "utf-8");
   987→            sidecarExists = true;
   988→          } catch {
   989→            // Doesn't exist
   990→          }
   991→
   992→          const sidecarAction = !sidecarExists
   993→            ? "created"
   994→            : contentsEqual(sidecarContent, existingSidecar)
   995→              ? "unchanged"
   996→              : "updated";
   997→
   998→          if (!dryRun && sidecarAction !== "unchanged") {
   999→            await fs.mkdir(sidecarDir, { recursive: true });
  1000→            await fs.writeFile(sidecarPath, sidecarContent, "utf-8");
  1001→          }
  1002→
  1003→          paths.push(sidecarPath);
  1004→          contentChanged = sidecarAction !== "unchanged";
  1005→        }
  1006→
  1007→        return { paths, contentChanged };
  1008→      },
  1009→    }, this.defaultOutputDir);
  1010→  },
  1011→
  1012→  // AC: @skill-drift-detection-improvements ac-1 - Include sidecar content in drift hash
  1013→  async checkDrift(
  1014→    specDir: string,
  1015→    projectRoot: string,
  1016→    skillId: string,
  1017→    options?: { outputDir?: string }
  1018→  ): Promise<DriftStatus> {
  1019→    const platformOutputDir = options?.outputDir || this.defaultOutputDir;
  1020→    const skillDir = path.join(projectRoot, platformOutputDir, skillId);
  1021→    const renderedPath = path.join(skillDir, "SKILL.md");
  1022→
  1023→    // Check if rendered file exists
  1024→    let renderedContent: string;
  1025→    try {
  1026→      renderedContent = await fs.readFile(renderedPath, "utf-8");
  1027→    } catch {
  1028→      return "not-rendered";
  1029→    }
  1030→
  1031→    // Migrate legacy hash if needed
  1032→    await migrateLegacyRenderHash(specDir, skillId, this.platform);
  1033→
  1034→    // Get stored hash
  1035→    const storedHash = await readPlatformRenderHash(specDir, skillId, this.platform);
  1036→    if (!storedHash) {
  1037→      return "no-hash";
  1038→    }
  1039→
  1040→    // Read sidecar content if it exists
  1041→    const sidecarPath = path.join(skillDir, "agents", "openai.yaml");
  1042→    let sidecarContent: string | null = null;
  1043→    try {
  1044→      sidecarContent = await fs.readFile(sidecarPath, "utf-8");
  1045→    } catch {
  1046→      // No sidecar file
  1047→    }
  1048→
  1049→    // Combine content for hash (must match render-time computation)
  1050→    const combinedContent = sidecarContent
  1051→      ? renderedContent + "\n" + sidecarContent
  1052→      : renderedContent;
  1053→    const currentHash = computeContentHash(combinedContent);
  1054→    return currentHash === storedHash ? "in-sync" : "drifted";
  1055→  },
  1056→};
  1057→
  1058→// ============================================================================
  1059→// Renderer Registry
  1060→// ============================================================================
  1061→
  1062→/** Map of platform name to renderer implementation */
  1063→const rendererRegistry: Map<string, PlatformRenderer> = new Map([
  1064→  ["claude-code", claudeCodeRenderer],
  1065→  ["codex", codexRenderer],
  1066→]);
  1067→
  1068→/**
  1069→ * Get the renderer for a specific platform
  1070→ */
  1071→export function getRenderer(platform: string): PlatformRenderer | undefined {
  1072→  return rendererRegistry.get(platform);
  1073→}
  1074→
  1075→/**
  1076→ * Get all registered renderers
  1077→ */
  1078→export function getAllRenderers(): PlatformRenderer[] {
  1079→  return Array.from(rendererRegistry.values());
  1080→}
  1081→
  1082→/**
  1083→ * Register a new platform renderer
  1084→ */
  1085→export function registerRenderer(renderer: PlatformRenderer): void {
  1086→  rendererRegistry.set(renderer.platform, renderer);
  1087→}
  1088→

