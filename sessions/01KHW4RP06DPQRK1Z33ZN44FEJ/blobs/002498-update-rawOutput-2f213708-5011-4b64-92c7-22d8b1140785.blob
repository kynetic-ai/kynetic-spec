    54→
    55→/**
    56→ * Resolve a meta reference to its ULID
    57→ * Handles semantic IDs (agent.id, workflow.id, skill.id, convention.domain) and ULID prefixes
    58→ * AC: @skill-meta-integration ac-4 - skills included in resolution
    59→ */
    60→function resolveMetaRefToUlid(
    61→  ref: string,
    62→  metaCtx: MetaContext,
    63→): {
    64→  ulid: string;
    65→  type: "agent" | "workflow" | "convention" | "observation" | "skill";
    66→} | null {
    67→  const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
    68→
    69→  // Check agents
    70→  const agent = (metaCtx.agents || []).find(
    71→    (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef),
    72→  );
    73→  if (agent) return { ulid: agent._ulid, type: "agent" };
    74→
    75→  // Check workflows
    76→  const workflow = (metaCtx.workflows || []).find(
    77→    (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef),
    78→  );
    79→  if (workflow) return { ulid: workflow._ulid, type: "workflow" };
    80→
    81→  // Check conventions
    82→  const convention = (metaCtx.conventions || []).find(
    83→    (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef),
    84→  );
    85→  if (convention) return { ulid: convention._ulid, type: "convention" };
    86→
    87→  // Check observations
    88→  const observation = (metaCtx.observations || []).find((o) =>
    89→    o._ulid.startsWith(normalizedRef),
    90→  );
    91→  if (observation) return { ulid: observation._ulid, type: "observation" };
    92→
    93→  // AC: @skill-meta-integration ac-4 - Check skills
    94→  const skill = (metaCtx.skills || []).find(
    95→    (s) => s.id === normalizedRef || s._ulid.startsWith(normalizedRef),
    96→  );
    97→  if (skill) return { ulid: skill._ulid, type: "skill" };
    98→
    99→  return null;
   100→}
   101→
   102→/**
   103→ * Batch-compatible resolver for observations.
   104→ * Returns null instead of calling process.exit() to allow partial failure handling.
   105→ * AC: @trait-multi-ref-batch ac-2, ac-8 - Partial failure handling and ref resolution
   106→ */
   107→function resolveObservationRefForBatch(
   108→  ref: string,
   109→  observations: Observation[],
   110→): { item: Observation | null; error?: string } {
   111→  const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
   112→  const observation = observations.find((o) =>
   113→    o._ulid.startsWith(normalizedRef),
   114→  );
   115→
   116→  if (!observation) {
   117→    return { item: null, error: `Observation not found: ${ref}` };
   118→  }
   119→
   120→  return { item: observation };
   121→}
   122→
   123→/**
   124→ * Format meta show output
   125→ * AC: @skill-meta-integration ac-3 - skill count included in summary
   126→ */
   127→function formatMetaShow(meta: MetaContext): void {
   128→  const stats = getMetaStats(meta);
   129→
   130→  if (!meta.manifest) {
   131→    console.log(chalk.yellow("No meta manifest found (kynetic.meta.yaml)"));
   132→    console.log(
   133→      chalk.gray(
   134→        "Create one to define agents, workflows, conventions, observations, and skills",
   135→      ),
   136→    );
   137→    return;
   138→  }
   139→
   140→  console.log(chalk.bold("Meta-Spec Summary"));
   141→  console.log(chalk.gray("─".repeat(40)));
   142→  console.log(`Agents:       ${stats.agents}`);
   143→  console.log(`Workflows:    ${stats.workflows}`);
   144→  console.log(`Conventions:  ${stats.conventions}`);
   145→  console.log(
   146→    `Observations: ${stats.observations} (${stats.unresolvedObservations} unresolved)`,
   147→  );
   148→  // AC: @skill-meta-integration ac-3 - include skill count
   149→  console.log(`Skills:       ${stats.skills}`);
   150→}
   151→
   152→/**
   153→ * Format agents table output
   154→ * AC-agent-1: outputs table with columns: ID, Name, Capabilities
   155→ */
   156→function formatAgents(agents: Agent[]): void {
   157→  if (agents.length === 0) {
   158→    console.log(chalk.yellow("No agents defined"));
   159→    return;
   160→  }
   161→
   162→  const table = new Table({
   163→    head: [chalk.bold("ID"), chalk.bold("Name"), chalk.bold("Capabilities")],
   164→    style: {
   165→      head: [],
   166→      border: [],
   167→    },
   168→  });
   169→
   170→  for (const agent of agents) {
   171→    table.push([agent.id, agent.name, agent.capabilities.join(", ")]);
   172→  }
   173→
   174→  console.log(table.toString());
   175→}
   176→
   177→/**
   178→ * Format workflows table output
   179→ * AC-workflow-1: outputs table with columns: ID, Trigger, Steps (count), Mode
   180→ */
   181→function formatWorkflows(workflows: Workflow[]): void {
   182→  if (workflows.length === 0) {
   183→    console.log(chalk.yellow("No workflows defined"));
   184→    return;
   185→  }
   186→
   187→  const table = new Table({
   188→    head: [
   189→      chalk.bold("ID"),
   190→      chalk.bold("Trigger"),
   191→      chalk.bold("Steps"),
   192→      chalk.bold("Mode"),
   193→    ],
   194→    style: {
   195→      head: [],
   196→      border: [],
   197→    },
   198→  });
   199→
   200→  for (const workflow of workflows) {
   201→    table.push([
   202→      workflow.id,
   203→      workflow.trigger,
   204→      workflow.steps.length.toString(),
   205→      workflow.mode || "interactive",
   206→    ]);
   207→  }
   208→
   209→  console.log(table.toString());
   210→}
   211→
   212→/**
   213→ * Format workflows verbose output
   214→ * AC-workflow-2: outputs each workflow with full step list
   215→ * AC: @loop-mode-workflows ac-3 (shows based_on field)
   216→ */
   217→function formatWorkflowsVerbose(workflows: Workflow[]): void {
   218→  if (workflows.length === 0) {
   219→    console.log(chalk.yellow("No workflows defined"));
   220→    return;
   221→  }
   222→
   223→  for (const workflow of workflows) {
   224→    console.log(chalk.bold(`${workflow.id} - ${workflow.trigger}`));
   225→    // Show mode if it's loop (skip for interactive as it's default)
   226→    if (workflow.mode === "loop") {
   227→      console.log(chalk.cyan(`Mode: ${workflow.mode}`));
   228→    }
   229→    // AC: @loop-mode-workflows ac-3 - Show based_on reference
   230→    if (workflow.based_on) {
   231→      console.log(chalk.cyan(`Based on: ${workflow.based_on}`));
   232→    }
   233→    if (workflow.description) {
   234→      console.log(chalk.gray(workflow.description));
   235→    }
   236→    console.log(chalk.gray("─".repeat(60)));
   237→
   238→    for (const step of workflow.steps) {
   239→      const prefix = {
   240→        check: chalk.yellow("[check]"),
   241→        action: chalk.blue("[action]"),
   242→        decision: chalk.magenta("[decision]"),
   243→      }[step.type];
   244→
   245→      console.log(`${prefix} ${step.content}`);
   246→
   247→      if (step.on_fail) {
   248→        console.log(chalk.gray(`  → on fail: ${step.on_fail}`));
   249→      }
   250→
   251→      if (step.options && step.options.length > 0) {
   252→        for (const option of step.options) {
   253→          console.log(chalk.gray(`  • ${option}`));
   254→        }
   255→      }
   256→    }
   257→
   258→    console.log("");
   259→  }
   260→}
   261→
   262→/**
   263→ * Format conventions table output
   264→ * AC-conv-1: outputs table with columns: Domain, Rules (count), Validation (yes/no)
   265→ */
   266→function formatConventions(conventions: Convention[]): void {
   267→  if (conventions.length === 0) {
   268→    console.log(chalk.yellow("No conventions defined"));
   269→    return;
   270→  }
   271→
   272→  const table = new Table({
   273→    head: [chalk.bold("Domain"), chalk.bold("Rules"), chalk.bold("Validation")],
   274→    style: {
   275→      head: [],
   276→      border: [],
   277→    },
   278→  });
   279→
   280→  for (const convention of conventions) {
   281→    table.push([
   282→      convention.domain,
   283→      convention.rules.length.toString(),
   284→      convention.validation ? "yes" : "no",
   285→    ]);
   286→  }
   287→
   288→  console.log(table.toString());
   289→}
   290→
   291→/**
   292→ * Format convention detail output
   293→ * AC-conv-2: outputs full rules list and examples
   294→ */
   295→function formatConventionDetail(convention: Convention): void {
   296→  console.log(chalk.bold(`${convention.domain} Convention`));
   297→  console.log(chalk.gray("─".repeat(60)));
   298→
   299→  console.log(chalk.bold("\nRules:"));
   300→  for (const rule of convention.rules) {
   301→    console.log(`  • ${rule}`);
   302→  }
   303→
   304→  if (convention.examples && convention.examples.length > 0) {
   305→    console.log(chalk.bold("\nExamples:"));
   306→    for (const example of convention.examples) {
   307→      console.log(chalk.green(`  ✓ ${example.good}`));
   308→      console.log(chalk.red(`  ✗ ${example.bad}`));
   309→    }
   310→  }
   311→
   312→  if (convention.validation) {
   313→    console.log(chalk.bold("\nValidation:"));
   314→    console.log(`  Type: ${convention.validation.type}`);
   315→    if (convention.validation.pattern) {
   316→      console.log(`  Pattern: ${convention.validation.pattern}`);
   317→    }
   318→    if (convention.validation.message) {
   319→      console.log(`  Message: ${convention.validation.message}`);
   320→    }
   321→  }
   322→
   323→  console.log("");
   324→}
   325→
   326→/**
   327→ * Format observations table output
   328→ * AC-obs-2: outputs table with columns: ID, Type, Workflow, Created, Content (truncated)
   329→ * AC: @obs-list-display ac-1 - When --all flag used, show Resolved column with ✓/✗
   330→ */
   331→function formatObservations(
   332→  observations: Observation[],
   333→  showResolved: boolean,
   334→): void {
   335→  const filtered = showResolved
   336→    ? observations
   337→    : observations.filter((o) => !o.resolved);
   338→
   339→  if (filtered.length === 0) {
   340→    console.log(
   341→      chalk.yellow(
   342→        showResolved ? "No observations found" : "No unresolved observations",
   343→      ),
   344→    );
   345→    return;
   346→  }
   347→
   348→  // AC: @obs-list-display ac-1 - Include Resolved column when showing all observations
   349→  const headers = showResolved
   350→    ? [
   351→        chalk.bold("ID"),
   352→        chalk.bold("Type"),
   353→        chalk.bold("Resolved"),
   354→        chalk.bold("Workflow"),
   355→        chalk.bold("Created"),
   356→        chalk.bold("Content"),
   357→      ]
   358→    : [
   359→        chalk.bold("ID"),
   360→        chalk.bold("Type"),
   361→        chalk.bold("Workflow"),
   362→        chalk.bold("Created"),
   363→        chalk.bold("Content"),
   364→      ];
   365→
   366→  const colWidths = showResolved
   367→    ? [10, 10, 10, 20, 12, 40]
   368→    : [10, 10, 20, 12, 50];
   369→
   370→  const table = new Table({
   371→    head: headers,
   372→    style: {
   373→      head: [],
   374→      border: [],
   375→    },
   376→    colWidths,
   377→    wordWrap: true,
   378→  });
   379→
   380→  for (const obs of filtered) {
   381→    const id = obs._ulid.substring(0, 8);
   382→    const workflow = obs.workflow_ref || "-";
   383→    const created = new Date(obs.created_at).toISOString().split("T")[0];
   384→    // Adjust content truncation based on available column width
   385→    const maxContentLen = showResolved ? 37 : 47;
   386→    const content =
   387→      obs.content.length > maxContentLen
   388→        ? `${obs.content.substring(0, maxContentLen)}...`
   389→        : obs.content;
   390→
   391→    // AC: @obs-list-display ac-1 - Show ✓ for resolved, ✗ for unresolved
   392→    if (showResolved) {
   393→      const resolvedIndicator = obs.resolved
   394→        ? chalk.green("✓")
   395→        : chalk.red("✗");
   396→      table.push([id, obs.type, resolvedIndicator, workflow, created, content]);
   397→    } else {
   398→      table.push([id, obs.type, workflow, created, content]);
   399→    }
   400→  }
   401→
   402→  console.log(table.toString());
   403→}
   404→
   405→/**
   406→ * Register meta commands
   407→ */
   408→export function registerMetaCommands(program: Command): void {
   409→  const meta = program
   410→    .command("meta")
   411→    .description(
   412→      "Meta-spec commands (agents, workflows, conventions, observations)",
   413→    );
   414→
   415→  // AC-meta-manifest-1: kspec meta show outputs summary with counts
   416→  meta
   417→    .command("show")
   418→    .description("Display meta-spec summary")
   419→    .action(async () => {
   420→      try {
   421→        const ctx = await initContext();
   422→
   423→        if (!ctx.manifestPath) {
   424→          error(errors.project.noKspecProject);
   425→          process.exit(EXIT_CODES.ERROR);
   426→        }
   427→
   428→        const metaCtx = await loadMetaContext(ctx);
   429→        const stats = getMetaStats(metaCtx);
   430→
   431→        output(
   432→          {
   433→            manifest: metaCtx.manifestPath,
   434→            stats,
   435→          },
   436→          () => formatMetaShow(metaCtx),
   437→        );
   438→      } catch (err) {
   439→        error(errors.failures.showMeta, err);
   440→        process.exit(EXIT_CODES.ERROR);
   441→      }
   442→    });
   443→
   444→  // AC-agent-1, AC-agent-2: kspec meta agents
   445→  meta
   446→    .command("agents")
   447→    .description("List agents defined in meta-spec")
   448→    .action(async () => {
   449→      try {
   450→        const ctx = await initContext();
   451→
   452→        if (!ctx.manifestPath) {
   453→          error(errors.project.noKspecProject);
   454→          process.exit(EXIT_CODES.ERROR);
   455→        }
   456→
   457→        const metaCtx = await loadMetaContext(ctx);
   458→        const agents = metaCtx.agents || [];
   459→
   460→        // AC-agent-2: JSON output includes full agent details
   461→        output(
   462→          agents.map((agent) => ({
   463→            id: agent.id,
   464→            name: agent.name,
   465→            description: agent.description,
   466→            capabilities: agent.capabilities,
   467→            tools: agent.tools,
   468→            session_protocol: agent.session_protocol,
   469→            conventions: agent.conventions,
   470→          })),
   471→          // AC-agent-1: Table output with ID, Name, Capabilities
   472→          () => formatAgents(agents),
   473→        );
   474→      } catch (err) {
   475→        error(errors.failures.listAgents, err);
   476→        process.exit(EXIT_CODES.ERROR);
   477→      }
   478→    });
   479→
   480→  // AC-workflow-1, AC-workflow-2, AC-workflow-4: kspec meta workflows
   481→  // AC: @loop-mode-workflows ac-1 (--tag loop filtering)
   482→  meta
   483→    .command("workflows")
   484→    .description("List workflows defined in meta-spec")
   485→    .option("--verbose", "Show full workflow details with all steps")
   486→    .option("--tag <tag>", "Filter workflows by tag (e.g., --tag loop)")
   487→    .action(async (options) => {
   488→      try {
   489→        const ctx = await initContext();
   490→
   491→        if (!ctx.manifestPath) {
   492→          error(errors.project.noKspecProject);
   493→          process.exit(EXIT_CODES.ERROR);
   494→        }
   495→
   496→        const metaCtx = await loadMetaContext(ctx);
   497→        let workflows = metaCtx.workflows || [];
   498→
   499→        // AC: @loop-mode-workflows ac-1 - Filter by tag
   500→        if (options.tag) {
   501→          workflows = workflows.filter((w) => {
   502→            // Match by explicit tags array or by mode field (for "loop" tag)
   503→            const tags = w.tags || [];
   504→            if (tags.includes(options.tag)) return true;
   505→            // Special case: --tag loop also matches mode: loop
   506→            if (options.tag === "loop" && w.mode === "loop") return true;
   507→            return false;
   508→          });
   509→        }
   510→
   511→        // AC-workflow-4: JSON output includes full workflow details
   512→        output(
   513→          workflows.map((workflow) => ({
   514→            id: workflow.id,
   515→            trigger: workflow.trigger,
   516→            description: workflow.description,
   517→            steps: workflow.steps,
   518→            mode: workflow.mode || "interactive",
   519→            based_on: workflow.based_on,
   520→            tags: workflow.tags || [],
   521→          })),
   522→          // AC-workflow-1 (table) or AC-workflow-2 (verbose)
   523→          () => {
   524→            if (options.verbose) {
   525→              formatWorkflowsVerbose(workflows);
   526→            } else {
   527→              formatWorkflows(workflows);
   528→            }
   529→          },
   530→        );
   531→      } catch (err) {
   532→        error(errors.failures.listWorkflows, err);
   533→        process.exit(EXIT_CODES.ERROR);
   534→      }
   535→    });
   536→
   537→  // AC-conv-1, AC-conv-2, AC-conv-5: kspec meta conventions
   538→  meta
   539→    .command("conventions")
   540→    .description("List conventions defined in meta-spec")
   541→    .option("--domain <domain>", "Filter by specific domain")
   542→    .action(async (options) => {
   543→      try {
   544→        const ctx = await initContext();
   545→
   546→        if (!ctx.manifestPath) {
   547→          error(errors.project.noKspecProject);
   548→          process.exit(EXIT_CODES.ERROR);
   549→        }
   550→
   551→        const metaCtx = await loadMetaContext(ctx);
   552→        const conventions = metaCtx.conventions || [];
   553→
   554→        // AC-conv-2: Filter by domain if specified
   555→        const filtered = options.domain
   556→          ? conventions.filter((c) => c.domain === options.domain)
   557→          : conventions;
   558→
   559→        // AC-conv-5: JSON output includes full convention details
   560→        output(
   561→          filtered.map((convention) => ({
   562→            domain: convention.domain,
   563→            rules: convention.rules,
   564→            examples: convention.examples,
   565→            validation: convention.validation,
   566→          })),
   567→          // AC-conv-1 (table) or AC-conv-2 (detail for single domain)
   568→          () => {
   569→            if (options.domain && filtered.length === 1) {
   570→              formatConventionDetail(filtered[0]);
   571→            } else {
   572→              formatConventions(filtered);
   573→            }
   574→          },
   575→        );
   576→      } catch (err) {
   577→        error(errors.failures.listConventions, err);
   578→        process.exit(EXIT_CODES.ERROR);
   579→      }
   580→    });
   581→
   582→  // meta-get-cmd: kspec meta get <ref>
   583→  // AC: @skill-meta-integration ac-1 - skills can be retrieved by id
   584→  meta
   585→    .command("get <ref>")
   586→    .description(
   587→      "Get a meta item by reference (agent, workflow, convention, observation, or skill)",
   588→    )
   589→    .action(async (ref: string) => {
   590→      try {
   591→        const ctx = await initContext();
   592→
   593→        if (!ctx.manifestPath) {
   594→          error(errors.project.noKspecProject);
   595→          process.exit(EXIT_CODES.ERROR);
   596→        }
   597→
   598→        const metaCtx = await loadMetaContext(ctx);
   599→
   600→        // Normalize reference
   601→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
   602→
   603→        // Search in all meta item types
   604→        const agents = metaCtx.agents || [];
   605→        const workflows = metaCtx.workflows || [];
   606→        const conventions = metaCtx.conventions || [];
   607→        const observations = metaCtx.observations || [];
   608→        const skills = metaCtx.skills || [];
   609→
   610→        // Try to find by ID or ULID prefix
   611→        let found: any = null;
   612→        let itemType: string = "";
   613→
   614→        // Check agents (by id or ULID)
   615→        const agent = agents.find(
   616→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef),
   617→        );
   618→        if (agent) {
   619→          found = agent;
   620→          itemType = "agent";
   621→        }
   622→
   623→        // Check workflows (by id or ULID)
   624→        if (!found) {
   625→          const workflow = workflows.find(
   626→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef),
   627→          );
   628→          if (workflow) {
   629→            found = workflow;
   630→            itemType = "workflow";
   631→          }
   632→        }
   633→
   634→        // Check conventions (by domain or ULID)
   635→        if (!found) {
   636→          const convention = conventions.find(
   637→            (c) =>
   638→              c.domain === normalizedRef || c._ulid.startsWith(normalizedRef),
   639→          );
   640→          if (convention) {
   641→            found = convention;
   642→            itemType = "convention";
   643→          }
   644→        }
   645→
   646→        // Check observations (by ULID)
   647→        if (!found) {
   648→          const observation = observations.find((o) =>
   649→            o._ulid.startsWith(normalizedRef),
   650→          );
   651→          if (observation) {
   652→            found = observation;
   653→            itemType = "observation";
   654→          }
   655→        }
   656→
   657→        // AC: @skill-meta-integration ac-1 - Check skills (by id or ULID)
   658→        if (!found) {
   659→          const skill = skills.find(
   660→            (s) => s.id === normalizedRef || s._ulid.startsWith(normalizedRef),
   661→          );
   662→          if (skill) {
   663→            found = skill;
   664→            itemType = "skill";
   665→          }
   666→        }
   667→
   668→        if (!found) {
   669→          error(errors.reference.metaNotFound(ref));
   670→          process.exit(EXIT_CODES.ERROR);
   671→        }
   672→
   673→        // Output the item
   674→        output(found, () => {
   675→          console.log(
   676→            chalk.bold(
   677→              `${itemType.charAt(0).toUpperCase() + itemType.slice(1)}: ${ref}`,
   678→            ),
   679→          );
   680→          console.log(chalk.gray("─".repeat(60)));
   681→          console.log(JSON.stringify(found, null, 2));
   682→        });
   683→      } catch (err) {
   684→        error(errors.failures.getMetaItem, err);
   685→        process.exit(EXIT_CODES.ERROR);
   686→      }
   687→    });
   688→
   689→  // meta-list-cmd: kspec meta list
   690→  // AC: @skill-meta-integration ac-2 - skills can be filtered with --type skill
   691→  meta
   692→    .command("list")
   693→    .description("List all meta items")
   694→    .option(
   695→      "--type <type>",
   696→      "Filter by type (agent, workflow, convention, observation, skill)",
   697→    )
   698→    .action(async (options) => {
   699→      try {
   700→        const ctx = await initContext();
   701→
   702→        if (!ctx.manifestPath) {
   703→          error(errors.project.noKspecProject);
   704→          process.exit(EXIT_CODES.ERROR);
   705→        }
   706→
   707→        const metaCtx = await loadMetaContext(ctx);
   708→
   709→        // Collect all meta items with type information
   710→        interface MetaListItem {
   711→          id: string;
   712→          type: string;
   713→          context: string;
   714→          ulid: string;
   715→        }
   716→
   717→        const items: MetaListItem[] = [];
   718→
   719→        // Add agents
   720→        if (!options.type || options.type === "agent") {
   721→          for (const agent of metaCtx.agents || []) {
   722→            items.push({
   723→              id: agent.id,
   724→              type: "agent",
   725→              context: agent.name,
   726→              ulid: agent._ulid,
   727→            });
   728→          }
   729→        }
   730→
   731→        // Add workflows
   732→        if (!options.type || options.type === "workflow") {
   733→          for (const workflow of metaCtx.workflows || []) {
   734→            items.push({
   735→              id: workflow.id,
   736→              type: "workflow",
   737→              context: workflow.trigger,
   738→              ulid: workflow._ulid,
   739→            });
   740→          }
   741→        }
   742→
   743→        // Add conventions
   744→        if (!options.type || options.type === "convention") {
   745→          for (const convention of metaCtx.conventions || []) {
   746→            items.push({
   747→              id: convention.domain,
   748→              type: "convention",
   749→              context: `${convention.rules.length} rules`,
   750→              ulid: convention._ulid,
   751→            });
   752→          }
   753→        }
   754→
   755→        // Add observations
   756→        if (!options.type || options.type === "observation") {
   757→          for (const observation of metaCtx.observations || []) {
   758→            const ulidPrefix = observation._ulid.substring(0, 8);
   759→            items.push({
   760→              id: ulidPrefix,
   761→              type: "observation",
   762→              context: `${observation.type} ${observation.resolved ? "(resolved)" : ""}`,
   763→              ulid: observation._ulid,
   764→            });
   765→          }
   766→        }
   767→
   768→        // AC: @skill-meta-integration ac-2 - Add skills
   769→        if (!options.type || options.type === "skill") {
   770→          for (const skill of metaCtx.skills || []) {
   771→            items.push({
   772→              id: skill.id,
   773→              type: "skill",
   774→              context: skill.name || skill.description || skill.origin,
   775→              ulid: skill._ulid,
   776→            });
   777→          }
   778→        }
   779→
   780→        // Output
   781→        output(items, () => {
   782→          if (items.length === 0) {
   783→            console.log(chalk.yellow("No meta items found"));
   784→            return;
   785→          }
   786→
   787→          const table = new Table({
   788→            head: [chalk.bold("ID"), chalk.bold("Type"), chalk.bold("Context")],
   789→            style: {
   790→              head: [],
   791→              border: [],
   792→            },
   793→          });
   794→
   795→          for (const item of items) {
   796→            table.push([item.id, item.type, item.context]);
   797→          }
   798→
   799→          console.log(table.toString());
   800→        });
   801→      } catch (err) {
   802→        error(errors.failures.listMetaItems, err);
   803→        process.exit(EXIT_CODES.ERROR);
   804→      }
   805→    });
   806→
   807→  // AC-obs-1: kspec meta observe <type> <content>
   808→  // AC: @meta-observe-cmd from-inbox-conversion
   809→  markMutating(meta.command("observe [type] [content]"))
   810→    .description("Create an observation (friction, success, question, idea)")
   811→    .option(
   812→      "--workflow <ref>",
   813→      "Reference to workflow this observation relates to",
   814→    )
   815→    .option("--author <author>", "Author of the observation")
   816→    .option("--from-inbox <ref>", "Convert inbox item to observation")
   817→    .option(
   818→      "--type <type>",
   819→      "Override type when using --from-inbox (defaults to idea)",
   820→    )
   821→    .action(
   822→      async (
   823→        type: string | undefined,
   824→        content: string | undefined,
   825→        options,
   826→      ) => {
   827→        try {
   828→          const ctx = await initContext();
   829→
   830→          if (!ctx.manifestPath) {
   831→            error(errors.project.noKspecProject);
   832→            process.exit(EXIT_CODES.ERROR);
   833→          }
   834→
   835→          // AC: @meta-observe-cmd from-inbox-conversion
   836→          // Handle --from-inbox flag
   837→          if (options.fromInbox) {
   838→            // Load inbox items
   839→            const inboxItems = await loadInboxItems(ctx);
   840→            const item = findInboxItemByRef(inboxItems, options.fromInbox);
   841→
   842→            if (!item) {
   843→              error(errors.reference.inboxNotFound(options.fromInbox));
   844→              process.exit(EXIT_CODES.NOT_FOUND);
   845→            }
   846→
   847→            // Use inbox item content
   848→            const observationContent = item.text;
   849→
   850→            // Type defaults to 'idea' but can be overridden with --type flag
   851→            const observationType = (options.type || "idea") as ObservationType;
   852→
   853→            // Validate observation type
   854→            const validTypes: ObservationType[] = [
   855→              "friction",
   856→              "success",
   857→              "question",
   858→              "idea",
   859→            ];
   860→            if (!validTypes.includes(observationType)) {
   861→              error(errors.validation.invalidObservationType(observationType));
   862→              console.log(`Valid types: ${validTypes.join(", ")}`);
   863→              process.exit(EXIT_CODES.ERROR);
   864→            }
   865→
   866→            // Create observation
   867→            const observation = createObservation(
   868→              observationType,
   869→              observationContent,
   870→              {
   871→                workflow_ref: options.workflow,
   872→                author: options.author,
   873→              },
   874→            );
   875→
   876→            // Save observation
   877→            await saveObservation(ctx, observation);
   878→
   879→            // Delete inbox item
   880→            const deleted = await deleteInboxItem(ctx, item._ulid);
   881→            if (!deleted) {
   882→              error("Failed to delete inbox item after creating observation");
   883→              process.exit(EXIT_CODES.ERROR);
   884→            }
   885→
   886→            await commitIfShadow(
   887→              ctx.shadow,
   888→              "meta-observe-from-inbox",
   889→              observation._ulid.substring(0, 8),
   890→              `Convert inbox item to ${observationType} observation`,
   891→            );
   892→
   893→            // Return observation ref
   894→            output(observation, () =>
   895→              success(
   896→                `Created observation: ${observation._ulid.substring(0, 8)}`,
   897→              ),
   898→            );
   899→            return;
   900→          }
   901→
   902→          // Standard observe flow (without --from-inbox)
   903→          if (!type || !content) {
   904→            error("Type and content are required when not using --from-inbox");
   905→            process.exit(EXIT_CODES.ERROR);
   906→          }
   907→
   908→          // Validate observation type
   909→          const validTypes: ObservationType[] = [
   910→            "friction",
   911→            "success",
   912→            "question",
   913→            "idea",
   914→          ];
   915→          if (!validTypes.includes(type as ObservationType)) {
   916→            error(errors.validation.invalidObservationType(type));
   917→            console.log(`Valid types: ${validTypes.join(", ")}`);
   918→            process.exit(EXIT_CODES.ERROR);
   919→          }
   920→
   921→          // Create observation
   922→          const observation = createObservation(
   923→            type as ObservationType,
   924→            content,
   925→            {
   926→              workflow_ref: options.workflow,
   927→              author: options.author,
   928→            },
   929→          );
   930→
   931→          // Save to manifest
   932→          await saveObservation(ctx, observation);
   933→
   934→          // AC: @trait-shadow-commit ac-1
   935→          await commitIfShadow(
   936→            ctx.shadow,
   937→            "meta-observe",
   938→            observation._ulid.substring(0, 8),
   939→            type as string,
   940→          );
   941→
   942→          // AC-obs-1: outputs "OK Created observation: <ULID-prefix>"
   943→          // In JSON mode, return the created observation object
   944→          output(observation, () =>
   945→            success(
   946→              `Created observation: ${observation._ulid.substring(0, 8)}`,
   947→            ),
   948→          );
   949→        } catch (err) {
   950→          error(errors.failures.createObservation, err);
   951→          process.exit(EXIT_CODES.ERROR);
   952→        }
   953→      },
   954→    );
   955→
   956→  // AC-obs-2, AC-obs-5: kspec meta observations
   957→  // AC: @observation-content-search ac-search-flag, ac-regex-support, ac-combined-filters
   958→  meta
   959→    .command("observations")
   960→    .description("List observations (shows unresolved by default)")
   961→    .option(
   962→      "--type <type>",
   963→      "Filter by observation type (friction/success/question/idea)",
   964→    )
   965→    .option("--workflow <ref>", "Filter by workflow reference")
   966→    .option("--all", "Include resolved observations")
   967→    .option("--promoted", "Show only observations promoted to tasks")
   968→    .option(
   969→      "--pending-resolution",
   970→      "Show observations with completed tasks awaiting resolution",
   971→    )
   972→    .option(
   973→      "--search <pattern>",
   974→      "Search observations by regex pattern (matches content)",
   975→    )
   976→    .action(async (options) => {
   977→      try {
   978→        const ctx = await initContext();
   979→
   980→        if (!ctx.manifestPath) {
   981→          error(errors.project.noKspecProject);
   982→          process.exit(EXIT_CODES.ERROR);
   983→        }
   984→
   985→        const metaCtx = await loadMetaContext(ctx);
   986→        let observations = metaCtx.observations || [];
   987→
   988→        // Apply filters
   989→        if (options.type) {
   990→          observations = observations.filter(
   991→            (obs) => obs.type === options.type,
   992→          );
   993→        }
   994→
   995→        if (options.workflow) {
   996→          observations = observations.filter(
   997→            (obs) => obs.workflow_ref === options.workflow,
   998→          );
   999→        }
  1000→
  1001→        if (options.promoted) {
  1002→          observations = observations.filter(
  1003→            (obs) => obs.promoted_to !== undefined,
  1004→          );
  1005→        }
  1006→
  1007→        if (options.pendingResolution) {
  1008→          // Load tasks to check if promoted tasks are completed
  1009→          const tasks = await loadAllTasks(ctx);
  1010→          const items = await loadAllItems(ctx);
  1011→          const index = new ReferenceIndex(tasks, items);
  1012→
  1013→          observations = observations.filter((obs) => {
  1014→            if (!obs.promoted_to || obs.resolved) return false;
  1015→            const taskResult = index.resolve(obs.promoted_to);
  1016→            if (!taskResult.ok) return false;
  1017→            const item = taskResult.item;
  1018→            // Type guard: check if item is a task (has status and depends_on properties)
  1019→            return (
  1020→              "status" in item &&
  1021→              "depends_on" in item &&
  1022→              item.status === "completed"
  1023→            );
  1024→          });
  1025→        }
  1026→
  1027→        // AC: @observation-content-search ac-search-flag, ac-regex-support, ac-combined-filters, ac-search-all-fields
  1028→        // Apply --search filter using regex pattern (consistent with kspec search behavior)
  1029→        if (options.search) {
  1030→          const { grepItem } = await import("../../utils/grep.js");
  1031→          observations = observations.filter((obs) => {
  1032→            const match = grepItem(
  1033→              obs as unknown as Record<string, unknown>,
  1034→              options.search,
  1035→            );
  1036→            return match !== null;
  1037→          });
  1038→        }
  1039→
  1040→        // AC-obs-5: JSON output includes full observation objects
  1041→        output(
  1042→          observations.map((obs) => ({
  1043→            _ulid: obs._ulid,
  1044→            type: obs.type,
  1045→            content: obs.content,
  1046→            workflow_ref: obs.workflow_ref ?? null,
  1047→            created_at: obs.created_at,
  1048→            author: obs.author ?? null,
  1049→            resolved: obs.resolved,
  1050→            resolution: obs.resolution ?? null,
  1051→            resolved_at: obs.resolved_at ?? null,
  1052→            resolved_by: obs.resolved_by ?? null,
  1053→            promoted_to: obs.promoted_to ?? null,
  1054→          })),
  1055→          // AC-obs-2: Table output with ID, Type, Workflow, Created, Content
  1056→          () => formatObservations(observations, options.all),
  1057→        );
  1058→      } catch (err) {
  1059→        error(errors.failures.listObservations, err);
  1060→        process.exit(EXIT_CODES.ERROR);
  1061→      }
  1062→    });
  1063→
  1064→  // AC-obs-3, AC-obs-6, AC-obs-8: kspec meta promote
  1065→  markMutating(meta.command("promote <ref>"))
  1066→    .description("Promote observation to a task")
  1067→    .requiredOption("--title <title>", "Task title")
  1068→    .option("--priority <priority>", "Task priority (1-5)", "2")
  1069→    .option("--force", "Force promotion even if observation is resolved")
  1070→    .action(async (ref: string, options) => {
  1071→      try {
  1072→        const ctx = await initContext();
  1073→
  1074→        if (!ctx.manifestPath) {
  1075→          error(errors.project.noKspecProject);
  1076→          process.exit(EXIT_CODES.ERROR);
  1077→        }
  1078→
  1079→        const metaCtx = await loadMetaContext(ctx);
  1080→        const observations = metaCtx.observations || [];
  1081→
  1082→        // Find observation
  1083→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
  1084→        const observation = observations.find((o) =>
  1085→          o._ulid.startsWith(normalizedRef),
  1086→        );
  1087→
  1088→        if (!observation) {
  1089→          error(errors.reference.observationNotFound(ref));
  1090→          process.exit(EXIT_CODES.ERROR);
  1091→        }
  1092→
  1093→        // AC-obs-6: Check if already promoted
  1094→        if (observation.promoted_to) {
  1095→          error(
  1096→            errors.conflict.observationAlreadyPromoted(observation.promoted_to),
  1097→          );
  1098→          process.exit(EXIT_CODES.CONFLICT);
  1099→        }
  1100→
  1101→        // AC-obs-8: Check if resolved
  1102→        if (observation.resolved && !options.force) {
  1103→          error(errors.operation.cannotPromoteResolved);
  1104→          process.exit(EXIT_CODES.ERROR);
  1105→        }
  1106→
  1107→        // Validate priority
  1108→        const priorityResult = parseIntOption(options.priority, {
  1109→          min: 1,
  1110→          max: 5,
  1111→          name: "Priority",
  1112→        });
  1113→        if (!priorityResult.ok) {
  1114→          error(priorityResult.error);
  1115→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1116→        }
  1117→
  1118→        // AC-obs-3: Create task with title, description from observation, meta_ref, and origin
  1119→        const task = createTask({
  1120→          title: options.title,
  1121→          description: observation.content,
  1122→          priority: priorityResult.value,
  1123→          meta_ref: observation.workflow_ref,
  1124→          origin: "observation_promotion",
  1125→        });
  1126→
  1127→        // Save task
  1128→        await saveTask(ctx, task);
  1129→        await commitIfShadow(
  1130→          ctx.shadow,
  1131→          "task-add",
  1132→          task.slugs[0] || task._ulid.slice(0, 8),
  1133→          task.title,
  1134→        );
  1135→        const taskRef = `@${task._ulid.substring(0, 8)}`;
  1136→
  1137→        // Update observation with promoted_to field
  1138→        observation.promoted_to = taskRef;
  1139→        await saveObservation(ctx, observation);
  1140→
  1141→        // AC: @trait-shadow-commit ac-1
  1142→        await commitIfShadow(
  1143→          ctx.shadow,
  1144→          "observation-promote",
  1145→          observation._ulid.substring(0, 8),
  1146→        );
  1147→
  1148→        // AC-obs-3: outputs "OK Created task: <ULID-prefix>"
  1149→        // In JSON mode, return the created task object
  1150→        output(task, () => success(`Created task: ${taskRef.substring(0, 9)}`));
  1151→      } catch (err) {
  1152→        error(errors.failures.promoteObservation, err);
  1153→        process.exit(EXIT_CODES.ERROR);
  1154→      }
  1155→    });
  1156→
  1157→  // AC-obs-4, AC-obs-7, AC-obs-9: kspec meta resolve
  1158→  // AC: @trait-multi-ref-batch - Batch support with --refs flag
  1159→  markMutating(meta.command("resolve [ref] [resolution]"))
  1160→    .description("Resolve an observation (or multiple with --refs)")
  1161→    .option("--refs <refs...>", "Resolve multiple observations by ref")
  1162→    .option(
  1163→      "--resolution <text>",
  1164→      "Resolution text (required for batch mode unless observations have promoted tasks)",
  1165→    )
  1166→    .addHelpText(
  1167→      "after",
  1168→      `
  1169→Examples:
  1170→  $ kspec meta resolve @obs-ref "Fixed in PR #123"
  1171→  $ kspec meta resolve --refs @obs1 @obs2 --resolution "Resolved in batch"`,
  1172→    )
  1173→    .action(
  1174→      async (
  1175→        ref: string | undefined,
  1176→        resolutionArg: string | undefined,
  1177→        options,
  1178→      ) => {
  1179→        try {
  1180→          const ctx = await initContext();
  1181→
  1182→          if (!ctx.manifestPath) {
  1183→            error(errors.project.noKspecProject);
  1184→            process.exit(EXIT_CODES.ERROR);
  1185→          }
  1186→
  1187→          const metaCtx = await loadMetaContext(ctx);
  1188→          const observations = metaCtx.observations || [];
  1189→
  1190→          // Load tasks/items for auto-resolution from promoted tasks
  1191→          const tasks = await loadAllTasks(ctx);
  1192→          const items = await loadAllItems(ctx);
  1193→          const index = new ReferenceIndex(tasks, items);
  1194→
  1195→          // Resolution can come from positional arg or --resolution flag
  1196→          const resolution = resolutionArg || options.resolution;
  1197→
  1198→          // AC: @trait-multi-ref-batch ac-8 - Deduplicate refs
  1199→          const refsFlag = options.refs
  1200→            ? [...new Set(options.refs as string[])]
  1201→            : undefined;
  1202→
  1203→          // AC: @trait-multi-ref-batch ac-1, ac-2, ac-3, ac-4, ac-5
  1204→          const result = await executeBatchOperation({
  1205→            positionalRef: ref,
  1206→            refsFlag,
  1207→            context: { ctx, observations, tasks, items, index, resolution },
  1208→            items: observations,
  1209→            index: index,
  1210→            resolveRef: (refStr, obsList) => {
  1211→              return resolveObservationRefForBatch(
  1212→                refStr,
  1213→                obsList as Observation[],
  1214→              );
  1215→            },
  1216→            executeOperation: async (
  1217→              observation: Observation,
  1218→              { ctx, tasks, items, index, resolution },
  1219→            ) => {
  1220→              // AC-obs-7: Check if already resolved
  1221→              if (observation.resolved) {
  1222→                const resolvedDate = new Date(observation.resolved_at!)
  1223→                  .toISOString()
  1224→                  .split("T")[0];
  1225→                const resolutionText = observation.resolution || "";
  1226→                const truncated =
  1227→                  resolutionText.length > 50
  1228→                    ? `${resolutionText.substring(0, 50)}...`
  1229→                    : resolutionText;
  1230→                return {
  1231→                  success: false,
  1232→                  error: `Already resolved on ${resolvedDate}: ${truncated}`,
  1233→                };
  1234→              }
  1235→
  1236→              // AC-obs-9: Auto-populate resolution from task completion if promoted
  1237→              let finalResolution = resolution;
  1238→              if (!finalResolution && observation.promoted_to) {
  1239→                const taskResult = index.resolve(observation.promoted_to);
  1240→
  1241→                if (taskResult.ok) {
  1242→                  const item = taskResult.item;
  1243→                  // Type guard: ensure this is a task
  1244→                  if ("status" in item && "depends_on" in item) {
  1245→                    const task = item as LoadedTask;
  1246→                    if (task.status === "completed" && task.closed_reason) {
  1247→                      finalResolution = `Resolved via task ${observation.promoted_to}: ${task.closed_reason}`;
  1248→                    } else if (task.status === "completed") {
  1249→                      finalResolution = `Resolved via task ${observation.promoted_to}`;
  1250→                    } else {
  1251→                      return {
  1252→                        success: false,
  1253→                        error: `Task ${observation.promoted_to} is not completed yet`,
  1254→                      };
  1255→                    }
  1256→                  } else {
  1257→                    return {
  1258→                      success: false,
  1259→                      error: `Reference ${observation.promoted_to} is not a task`,
  1260→                    };
  1261→                  }
  1262→                } else {
  1263→                  return {
  1264→                    success: false,
  1265→                    error: `Task ${observation.promoted_to} not found`,
  1266→                  };
  1267→                }
  1268→              }
  1269→
  1270→              if (!finalResolution) {
  1271→                return {
  1272→                  success: false,
  1273→                  error: "Resolution text required",
  1274→                };
  1275→              }
  1276→
  1277→              // AC-obs-4: Update observation
  1278→              observation.resolved = true;
  1279→              observation.resolution = finalResolution;
  1280→              observation.resolved_at = new Date().toISOString();
  1281→              observation.resolved_by = observation.author;
  1282→
  1283→              await saveObservation(ctx, observation);
  1284→
  1285→              // AC: @trait-shadow-commit ac-1
  1286→              await commitIfShadow(
  1287→                ctx.shadow,
  1288→                "observation-resolve",
  1289→                observation._ulid.substring(0, 8),
  1290→              );
  1291→
  1292→              return {
  1293→                success: true,
  1294→                message: `Resolved: ${observation._ulid.substring(0, 8)}`,
  1295→              };
  1296→            },
  1297→            getUlid: (obs: Observation) => obs._ulid,
  1298→          });
  1299→
  1300→          // AC: @trait-multi-ref-batch ac-5, ac-7 - Output formatting
  1301→          formatBatchOutput(result, "Resolve");
  1302→        } catch (err) {
  1303→          error(errors.failures.resolveObservation, err);
  1304→          process.exit(EXIT_CODES.ERROR);
  1305→        }
  1306→      },
  1307→    );
  1308→
  1309→  // Meta add command - create new meta items
  1310→  markMutating(meta.command("add <type>"))
  1311→    .description("Create a new meta item (agent, workflow, or convention)")
  1312→    .option("--id <id>", "Semantic ID (required for agents and workflows)")
  1313→    .option("--domain <domain>", "Domain (required for conventions)")
  1314→    .option("--name <name>", "Name (for agents)")
  1315→    .option("--trigger <trigger>", "Trigger (for workflows)")
  1316→    .option("--description <desc>", "Description")
  1317→    .option("--capability <cap...>", "Capabilities (for agents)")
  1318→    .option("--tool <tool...>", "Tools (for agents)")
  1319→    .option("--convention <conv...>", "Convention references (for agents)")
  1320→    .option("--rule <rule...>", "Rules (for conventions)")
  1321→    .option("--steps <json>", "Workflow steps as JSON array (for workflows)")
  1322→    .option(
  1323→      "--mode <mode>",
  1324→      "Workflow mode: interactive (default) or loop (for workflows)",
  1325→    )
  1326→    .option("--based-on <ref>", "Base workflow reference (for loop workflows)")
  1327→    .option("--tag <tag...>", "Tags for the workflow (for workflows)")
  1328→    .addHelpText(
  1329→      "after",
  1330→      `
  1331→Examples:
  1332→  $ kspec meta add agent --id my-agent --name "My Agent" --capability search code
  1333→  $ kspec meta add convention --domain testing --rule "Always test" --rule "Use mocks"
  1334→  $ kspec meta add workflow --id my-flow --trigger manual --tag automation ci`,
  1335→    )
  1336→    .action(async (type: string, options) => {
  1337→      try {
  1338→        const ctx = await initContext();
  1339→
  1340→        // Validate type
  1341→        const validTypes = ["agent", "workflow", "convention"];
  1342→        if (!validTypes.includes(type)) {
  1343→          error(errors.validation.invalidType(type, validTypes));
  1344→          process.exit(EXIT_CODES.ERROR);
  1345→        }
  1346→
  1347→        // Generate ULID
  1348→        const itemUlid = ulid();
  1349→
  1350→        // Create the item based on type
  1351→        let item: Agent | Workflow | Convention;
  1352→
  1353→        if (type === "agent") {
  1354→          // Validate required fields
  1355→          if (!options.id) {
  1356→            error(errors.validation.agentRequiresId);
  1357→            process.exit(EXIT_CODES.ERROR);
  1358→          }
  1359→          if (!options.name) {
  1360→            error(errors.validation.agentRequiresName);
  1361→            process.exit(EXIT_CODES.ERROR);
  1362→          }
  1363→
  1364→          item = {
  1365→            _ulid: itemUlid,
  1366→            id: options.id,
  1367→            name: options.name,
  1368→            description: options.description || "",
  1369→            capabilities: options.capability || [],
  1370→            tools: options.tool || [],
  1371→            conventions: options.convention || [],
  1372→          };
  1373→        } else if (type === "workflow") {
  1374→          // Validate required fields
  1375→          if (!options.id) {
  1376→            error(errors.validation.workflowRequiresId);
  1377→            process.exit(EXIT_CODES.ERROR);
  1378→          }
  1379→          if (!options.trigger) {
  1380→            error(errors.validation.workflowRequiresTrigger);
  1381→            process.exit(EXIT_CODES.ERROR);
  1382→          }
  1383→
  1384→          // Parse and validate --steps if provided
  1385→          let steps: WorkflowStep[] = [];
  1386→          if (options.steps) {
  1387→            // AC: @meta-add-cmd ac-2 - Parse JSON
  1388→            let parsedSteps: unknown;
  1389→            try {
  1390→              parsedSteps = JSON.parse(options.steps);
  1391→            } catch (err) {
  1392→              const message = err instanceof Error ? err.message : String(err);
  1393→              error(errors.validation.invalidStepsJson(message));
  1394→              process.exit(EXIT_CODES.ERROR);
  1395→            }
  1396→
  1397→            // AC: @meta-add-cmd ac-3 - Verify it's an array
  1398→            if (!Array.isArray(parsedSteps)) {
  1399→              error(errors.validation.stepsNotArray);
  1400→              process.exit(EXIT_CODES.ERROR);
  1401→            }
  1402→
  1403→            // AC: @meta-add-cmd ac-4 - Validate with schema
  1404→            const result = z.array(WorkflowStepSchema).safeParse(parsedSteps);
  1405→            if (!result.success) {
  1406→              const issues = result.error.issues
  1407→                .map((i) => `${i.path.join(".")}: ${i.message}`)
  1408→                .join("; ");
  1409→              error(errors.validation.invalidStepsSchema(issues));
  1410→              process.exit(EXIT_CODES.ERROR);
  1411→            }
  1412→            steps = result.data;
  1413→          }
  1414→
  1415→          // Validate mode if provided
  1416→          const validModes = ["interactive", "loop"];
  1417→          if (options.mode && !validModes.includes(options.mode)) {
  1418→            error(
  1419→              `Invalid mode: ${options.mode}. Valid modes: ${validModes.join(", ")}`,
  1420→            );
  1421→            process.exit(EXIT_CODES.ERROR);
  1422→          }
  1423→
  1424→          item = {
  1425→            _ulid: itemUlid,
  1426→            id: options.id,
  1427→            trigger: options.trigger,
  1428→            description: options.description || "",
  1429→            steps,
  1430→            ...(options.mode && { mode: options.mode }),
  1431→            ...(options.basedOn && { based_on: options.basedOn }),
  1432→            ...(options.tag && options.tag.length > 0 && { tags: parseTagsArray(options.tag) }),
  1433→          };
  1434→        } else {
  1435→          // convention
  1436→          if (!options.domain) {
  1437→            error(errors.validation.conventionRequiresDomain);
  1438→            process.exit(EXIT_CODES.ERROR);
  1439→          }
  1440→
  1441→          item = {
  1442→            _ulid: itemUlid,
  1443→            domain: options.domain,
  1444→            rules: options.rule || [],
  1445→            examples: [],
  1446→          };
  1447→        }
  1448→
  1449→        // Save the item
  1450→        await saveMetaItem(
  1451→          ctx,
  1452→          item,
  1453→          type as "agent" | "workflow" | "convention",
  1454→        );
  1455→
  1456→        // AC: @trait-shadow-commit ac-1
  1457→        await commitIfShadow(
  1458→          ctx.shadow,
  1459→          `meta-add-${type}`,
  1460→          itemUlid.substring(0, 8),
  1461→          "id" in item ? item.id : "domain" in item ? item.domain : undefined,
  1462→        );
  1463→
  1464→        if (isJsonMode()) {
  1465→          // In JSON mode, output the item data directly
  1466→          console.log(JSON.stringify(item, null, 2));
  1467→        } else {
  1468→          const idOrDomain =
  1469→            "id" in item ? item.id : "domain" in item ? item.domain : itemUlid;
  1470→          success(
  1471→            `Created ${type}: ${idOrDomain} (@${itemUlid.substring(0, 8)})`,
  1472→          );
  1473→        }
  1474→      } catch (err) {
  1475→        error(errors.failures.createMeta(type), err);
  1476→        process.exit(EXIT_CODES.ERROR);
  1477→      }
  1478→    });
  1479→
  1480→  // Meta set command - update existing meta items
  1481→  markMutating(meta.command("set <ref>"))
  1482→    .description("Update an existing meta item")
  1483→    .option("--name <name>", "Update name (for agents)")
  1484→    .option("--description <desc>", "Update description")
  1485→    .option("--trigger <trigger>", "Update trigger (for workflows)")
  1486→    .option("--add-capability <cap>", "Add capability (for agents)")
  1487→    .option("--add-tool <tool>", "Add tool (for agents)")
  1488→    .option("--add-convention <conv>", "Add convention reference (for agents)")
  1489→    .option("--add-rule <rule>", "Add rule (for conventions)")
  1490→    .action(async (ref: string, options) => {
  1491→      try {
  1492→        const ctx = await initContext();
  1493→        const metaCtx = await loadMetaContext(ctx);
  1494→
  1495→        // Find the item using unified lookup
  1496→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
  1497→        let found: Agent | Workflow | Convention | null = null;
  1498→        let itemType: "agent" | "workflow" | "convention" | null = null;
  1499→
  1500→        // Search in agents
  1501→        const agents = metaCtx.manifest?.agents || [];
  1502→        const agent = agents.find(
  1503→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef),
  1504→        );
  1505→        if (agent) {
  1506→          found = agent;
  1507→          itemType = "agent";
  1508→        }
  1509→
  1510→        // Search in workflows
  1511→        if (!found) {
  1512→          const workflows = metaCtx.manifest?.workflows || [];
  1513→          const workflow = workflows.find(
  1514→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef),
  1515→          );
  1516→          if (workflow) {
  1517→            found = workflow;
  1518→            itemType = "workflow";
  1519→          }
  1520→        }
  1521→
  1522→        // Search in conventions
  1523→        if (!found) {
  1524→          const conventions = metaCtx.manifest?.conventions || [];
  1525→          const convention = conventions.find(
  1526→            (c) =>
  1527→              c.domain === normalizedRef || c._ulid.startsWith(normalizedRef),
  1528→          );
  1529→          if (convention) {
  1530→            found = convention;
  1531→            itemType = "convention";
  1532→          }
  1533→        }
  1534→
  1535→        if (!found || !itemType) {
  1536→          error(errors.reference.metaNotFound(ref));
  1537→          process.exit(EXIT_CODES.ERROR);
  1538→        }
  1539→
  1540→        // Update fields based on type
  1541→        if (itemType === "agent") {
  1542→          const item = found as Agent;
  1543→          if (options.name) item.name = options.name;
  1544→          if (options.description !== undefined)
  1545→            item.description = options.description;
  1546→          if (options.addCapability) {
  1547→            if (!item.capabilities.includes(options.addCapability)) {
  1548→              item.capabilities.push(options.addCapability);
  1549→            }
  1550→          }
  1551→          if (options.addTool) {
  1552→            if (!item.tools.includes(options.addTool)) {
  1553→              item.tools.push(options.addTool);
  1554→            }
  1555→          }
  1556→          if (options.addConvention) {
  1557→            if (!item.conventions.includes(options.addConvention)) {
  1558→              item.conventions.push(options.addConvention);
  1559→            }
  1560→          }
  1561→        } else if (itemType === "workflow") {
  1562→          const item = found as Workflow;
  1563→          if (options.trigger) item.trigger = options.trigger;
  1564→          if (options.description !== undefined)
  1565→            item.description = options.description;
  1566→        } else {
  1567→          const item = found as Convention;
  1568→          // Convention doesn't have a description field
  1569→          if (options.addRule) {
  1570→            if (!item.rules.includes(options.addRule)) {
  1571→              item.rules.push(options.addRule);
  1572→            }
  1573→          }
  1574→        }
  1575→
  1576→        // Save the updated item
  1577→        await saveMetaItem(ctx, found, itemType);
  1578→
  1579→        // AC: @trait-shadow-commit ac-1
  1580→        await commitIfShadow(
  1581→          ctx.shadow,
  1582→          `meta-set-${itemType}`,
  1583→          found._ulid.substring(0, 8),
  1584→        );
  1585→
  1586→        if (isJsonMode()) {
  1587→          // In JSON mode, output the item data directly
  1588→          console.log(JSON.stringify(found, null, 2));
  1589→        } else {
  1590→          const idOrDomain =
  1591→            itemType === "agent"
  1592→              ? (found as Agent).id
  1593→              : itemType === "workflow"
  1594→                ? (found as Workflow).id
  1595→                : (found as Convention).domain;
  1596→          success(`Updated ${itemType}: ${idOrDomain}`);
  1597→        }
  1598→      } catch (err) {
  1599→        error(errors.failures.updateMetaItem, err);
  1600→        process.exit(EXIT_CODES.ERROR);
  1601→      }
  1602→    });
  1603→
  1604→  // Meta delete command - delete meta items
  1605→  markMutating(meta.command("delete <ref>"))
  1606→    .description("Delete a meta item")
  1607→    .option("--confirm", "Skip confirmation prompt")
  1608→    .action(async (ref: string, options) => {
  1609→      try {
  1610→        const ctx = await initContext();
  1611→        const metaCtx = await loadMetaContext(ctx);
  1612→
  1613→        // Find the item to determine type
  1614→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
  1615→        let itemType:
  1616→          | "agent"
  1617→          | "workflow"
  1618→          | "convention"
  1619→          | "observation"
  1620→          | null = null;
  1621→        let itemUlid: string | null = null;
  1622→        let itemLabel: string | null = null;
  1623→
  1624→        // Search in agents
  1625→        const agents = metaCtx.manifest?.agents || [];
  1626→        const agent = agents.find(
  1627→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef),
  1628→        );
  1629→        if (agent) {
  1630→          itemType = "agent";
  1631→          itemUlid = agent._ulid;
  1632→          itemLabel = `agent ${agent.id}`;
  1633→        }
  1634→
  1635→        // Search in workflows
  1636→        if (!itemType) {
  1637→          const workflows = metaCtx.manifest?.workflows || [];
  1638→          const workflow = workflows.find(
  1639→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef),
  1640→          );
  1641→          if (workflow) {
  1642→            itemType = "workflow";
  1643→            itemUlid = workflow._ulid;
  1644→            itemLabel = `workflow ${workflow.id}`;
  1645→          }
  1646→        }
  1647→
  1648→        // Search in conventions
  1649→        if (!itemType) {
  1650→          const conventions = metaCtx.manifest?.conventions || [];
  1651→          const convention = conventions.find(
  1652→            (c) =>
  1653→              c.domain === normalizedRef || c._ulid.startsWith(normalizedRef),
  1654→          );
  1655→          if (convention) {
  1656→            itemType = "convention";
  1657→            itemUlid = convention._ulid;
  1658→            itemLabel = `convention ${convention.domain}`;
  1659→          }
  1660→        }
  1661→
  1662→        // Search in observations
  1663→        if (!itemType) {
  1664→          const observations = metaCtx.observations || [];
  1665→          const observation = observations.find((o) =>
  1666→            o._ulid.startsWith(normalizedRef),
  1667→          );
  1668→          if (observation) {
  1669→            itemType = "observation";
  1670→            itemUlid = observation._ulid;
  1671→            itemLabel = `observation ${observation._ulid.substring(0, 8)}`;
  1672→          }
  1673→        }
  1674→
  1675→        if (!itemType || !itemUlid || !itemLabel) {
  1676→          error(errors.reference.metaNotFound(ref));
  1677→          process.exit(EXIT_CODES.ERROR);
  1678→        }
  1679→
  1680→        // Check for dangling references (unless --confirm is used to override)
  1681→        if (!options.confirm) {
  1682→          // Check tasks with meta_ref
  1683→          const tasks = await loadAllTasks(ctx);
  1684→          const referencingTasks = tasks.filter((t) => {
  1685→            if (!t.meta_ref) return false;
  1686→            // Resolve the task's meta_ref to a ULID
  1687→            const taskMetaRef = resolveMetaRefToUlid(t.meta_ref, metaCtx);
  1688→            // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1689→            return taskMetaRef && taskMetaRef.ulid === itemUlid;
  1690→          });
  1691→
  1692→          if (referencingTasks.length > 0) {
  1693→            const taskRefs = referencingTasks
  1694→              .map((t) => `@${t.slugs?.[0] || t._ulid.substring(0, 8)}`)
  1695→              .join(", ");
  1696→            error(
  1697→              errors.operation.cannotDeleteReferencedByTasks(
  1698→                itemLabel,
  1699→                referencingTasks.length,
  1700→                taskRefs,
  1701→              ),
  1702→            );
  1703→            process.exit(EXIT_CODES.ERROR);
  1704→          }
  1705→
  1706→          // Check observations with workflow_ref (only for workflows)
  1707→          if (itemType === "workflow") {
  1708→            const observations = metaCtx.observations || [];
  1709→            const referencingObservations = observations.filter((o) => {
  1710→              if (!o.workflow_ref) return false;
  1711→              // Resolve the observation's workflow_ref to a ULID
  1712→              const obsWorkflowRef = resolveMetaRefToUlid(
  1713→                o.workflow_ref,
  1714→                metaCtx,
  1715→              );
  1716→              // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1717→              return obsWorkflowRef && obsWorkflowRef.ulid === itemUlid;
  1718→            });
  1719→
  1720→            if (referencingObservations.length > 0) {
  1721→              const obsRefs = referencingObservations
  1722→                .map((o) => `@${o._ulid.substring(0, 8)}`)
  1723→                .join(", ");
  1724→              error(
  1725→                errors.operation.cannotDeleteReferencedByObservations(
  1726→                  itemLabel,
  1727→                  referencingObservations.length,
  1728→                  obsRefs,
  1729→                ),
  1730→              );
  1731→              process.exit(EXIT_CODES.ERROR);
  1732→            }
  1733→          }
  1734→
  1735→          // Show confirmation prompt even if no references found
  1736→          error(errors.operation.confirmRequired(itemLabel));
  1737→          process.exit(EXIT_CODES.ERROR);
  1738→        }
  1739→
  1740→        // Delete the item
  1741→        const deleted = await deleteMetaItem(ctx, itemUlid, itemType);
  1742→
  1743→        if (!deleted) {
  1744→          error(errors.operation.deleteItemFailed(itemLabel));
  1745→          process.exit(EXIT_CODES.ERROR);
  1746→        }
  1747→
  1748→        // AC: @trait-shadow-commit ac-1
  1749→        await commitIfShadow(
  1750→          ctx.shadow,
  1751→          `meta-delete-${itemType}`,
  1752→          itemUlid.substring(0, 8),
  1753→        );
  1754→
  1755→        success(`Deleted ${itemLabel}`);
  1756→      } catch (err) {
  1757→        error(errors.failures.deleteMetaItem, err);
  1758→        process.exit(EXIT_CODES.ERROR);
  1759→      }
  1760→    });
  1761→
  1762→  // meta-focus-cmd: kspec meta focus [ref]
  1763→  markMutating(meta.command("focus [ref]"))
  1764→    .description("Get or set session focus")
  1765→    .option("--clear", "Clear current focus")
  1766→    .action(async (ref: string | undefined, options) => {
  1767→      try {
  1768→        const ctx = await initContext();
  1769→
  1770→        if (!ctx.manifestPath) {
  1771→          error(errors.project.noKspecProject);
  1772→          process.exit(EXIT_CODES.ERROR);
  1773→        }
  1774→
  1775→        const sessionCtx = await loadSessionContext(ctx);
  1776→
  1777→        // Clear focus
  1778→        if (options.clear) {
  1779→          sessionCtx.focus = null;
  1780→          await saveSessionContext(ctx, sessionCtx);
  1781→
  1782→          output({ focus: null }, () => success("Cleared session focus"));
  1783→          return;
  1784→        }
  1785→
  1786→        // Show current focus
  1787→        if (!ref) {
  1788→          output({ focus: sessionCtx.focus }, () => {
  1789→            if (sessionCtx.focus) {
  1790→              console.log(`Current focus: ${sessionCtx.focus}`);
  1791→            } else {
  1792→              console.log(chalk.yellow("No focus set"));
  1793→            }
  1794→          });
  1795→          return;
  1796→        }
  1797→
  1798→        // Set focus to ref
  1799→        sessionCtx.focus = ref.startsWith("@") ? ref : `@${ref}`;
  1800→        await saveSessionContext(ctx, sessionCtx);
  1801→
  1802→        output({ focus: sessionCtx.focus }, () =>
  1803→          success(`Set focus to: ${sessionCtx.focus}`),
  1804→        );
  1805→      } catch (err) {
  1806→        error(errors.failures.updateSessionContext, err);
  1807→        process.exit(EXIT_CODES.ERROR);
  1808→      }
  1809→    });
  1810→
  1811→  // meta-thread-cmd: kspec meta thread <action> [text]
  1812→  markMutating(meta.command("thread <action> [text]"))
  1813→    .description("Manage active threads")
  1814→    .action(async (action: string, text: string | undefined) => {
  1815→      try {
  1816→        const ctx = await initContext();
  1817→
  1818→        if (!ctx.manifestPath) {
  1819→          error(errors.project.noKspecProject);
  1820→          process.exit(EXIT_CODES.ERROR);
  1821→        }
  1822→
  1823→        const sessionCtx = await loadSessionContext(ctx);
  1824→
  1825→        // List threads
  1826→        if (action === "list") {
  1827→          output({ threads: sessionCtx.threads }, () => {
  1828→            if (sessionCtx.threads.length === 0) {
  1829→              console.log(chalk.yellow("No active threads"));
  1830→            } else {
  1831→              console.log("Active threads:");
  1832→              sessionCtx.threads.forEach((thread, idx) => {
  1833→                console.log(`  ${idx + 1}. ${thread}`);
  1834→              });
  1835→            }
  1836→          });
  1837→          return;
  1838→        }
  1839→
  1840→        // Clear all threads
  1841→        if (action === "clear") {
  1842→          sessionCtx.threads = [];
  1843→          await saveSessionContext(ctx, sessionCtx);
  1844→
  1845→          output({ threads: [] }, () => success("Cleared all threads"));
  1846→          return;
  1847→        }
  1848→
  1849→        // Add thread
  1850→        if (action === "add") {
  1851→          if (!text) {
  1852→            error("Thread text is required for add action");
  1853→            process.exit(EXIT_CODES.ERROR);
  1854→          }
  1855→
  1856→          sessionCtx.threads.push(text);
  1857→          await saveSessionContext(ctx, sessionCtx);
  1858→
  1859→          output({ threads: sessionCtx.threads, added: text }, () =>
  1860→            success(`Added thread: ${text}`),
  1861→          );
  1862→          return;
  1863→        }
  1864→
  1865→        // Remove thread by index (1-based)
  1866→        if (action === "remove") {
  1867→          if (!text) {
  1868→            error("Index is required for remove action");
  1869→            process.exit(EXIT_CODES.ERROR);
  1870→          }
  1871→
  1872→          const index = parseInt(text, 10);
  1873→          if (
  1874→            Number.isNaN(index) ||
  1875→            index < 1 ||
  1876→            index > sessionCtx.threads.length
  1877→          ) {
  1878→            error(
  1879→              `Invalid index: ${text}. Must be between 1 and ${sessionCtx.threads.length}`,
  1880→            );
  1881→            process.exit(EXIT_CODES.ERROR);
  1882→          }
  1883→
  1884→          const removed = sessionCtx.threads.splice(index - 1, 1)[0];
  1885→          await saveSessionContext(ctx, sessionCtx);
  1886→
  1887→          output({ threads: sessionCtx.threads, removed }, () =>
  1888→            success(`Removed thread: ${removed}`),
  1889→          );
  1890→          return;
  1891→        }
  1892→
  1893→        // Unknown action
  1894→        error(`Unknown action: ${action}. Use add, remove, list, or clear`);
  1895→        process.exit(EXIT_CODES.ERROR);
  1896→      } catch (err) {
  1897→        error(errors.failures.updateSessionContext, err);
  1898→        process.exit(EXIT_CODES.ERROR);
  1899→      }
  1900→    });
  1901→
