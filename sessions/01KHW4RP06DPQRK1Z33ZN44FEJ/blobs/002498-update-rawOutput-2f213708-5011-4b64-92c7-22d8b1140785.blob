  1993→  // meta-context-cmd: kspec meta context
  1994→  meta
  1995→    .command("context")
  1996→    .description("Show full session context")
  1997→    .option("--clear", "Clear all session context")
  1998→    .action(async (options) => {
  1999→      try {
  2000→        const ctx = await initContext();
  2001→
  2002→        if (!ctx.manifestPath) {
  2003→          error(errors.project.noKspecProject);
  2004→          process.exit(EXIT_CODES.ERROR);
  2005→        }
  2006→
  2007→        const sessionCtx = await loadSessionContext(ctx);
  2008→
  2009→        // Clear all context
  2010→        if (options.clear) {
  2011→          sessionCtx.focus = null;
  2012→          sessionCtx.threads = [];
  2013→          sessionCtx.open_questions = [];
  2014→          await saveSessionContext(ctx, sessionCtx);
  2015→
  2016→          output(
  2017→            {
  2018→              focus: null,
  2019→              threads: [],
  2020→              open_questions: [],
  2021→              updated_at: sessionCtx.updated_at,
  2022→            },
  2023→            () => success("Cleared all session context"),
  2024→          );
  2025→          return;
  2026→        }
  2027→
  2028→        // Show full session context
  2029→        output(
  2030→          {
  2031→            focus: sessionCtx.focus,
  2032→            threads: sessionCtx.threads,
  2033→            open_questions: sessionCtx.open_questions,
  2034→            updated_at: sessionCtx.updated_at,
  2035→          },
  2036→          () => {
  2037→            console.log(chalk.bold("Session Context"));
  2038→            console.log(chalk.gray("─".repeat(60)));
  2039→
  2040→            // Focus
  2041→            console.log(chalk.bold("\nFocus:"));
  2042→            if (sessionCtx.focus) {
  2043→              console.log(`  ${sessionCtx.focus}`);
  2044→            } else {
  2045→              console.log(chalk.gray("  (none)"));
  2046→            }
  2047→
  2048→            // Active threads
  2049→            console.log(chalk.bold("\nActive Threads:"));
  2050→            if (sessionCtx.threads.length > 0) {
  2051→              sessionCtx.threads.forEach((thread, idx) => {
  2052→                console.log(`  ${idx + 1}. ${thread}`);
  2053→              });
  2054→            } else {
  2055→              console.log(chalk.gray("  (none)"));
  2056→            }
  2057→
  2058→            // Open questions
  2059→            console.log(chalk.bold("\nOpen Questions:"));
  2060→            if (sessionCtx.open_questions.length > 0) {
  2061→              sessionCtx.open_questions.forEach((question, idx) => {
  2062→                console.log(`  ${idx + 1}. ${question}`);
  2063→              });
  2064→            } else {
  2065→              console.log(chalk.gray("  (none)"));
  2066→            }
  2067→
  2068→            // Last updated
  2069→            console.log(chalk.bold("\nLast Updated:"));
  2070→            const updatedDate = new Date(sessionCtx.updated_at);
  2071→            console.log(`  ${updatedDate.toISOString()}`);
  2072→            console.log(chalk.gray(`  (${updatedDate.toLocaleString()})`));
  2073→          },
  2074→        );
  2075→      } catch (err) {
  2076→        error(errors.failures.updateSessionContext, err);
  2077→        process.exit(EXIT_CODES.ERROR);
  2078→      }
  2079→    });
  2080→}
