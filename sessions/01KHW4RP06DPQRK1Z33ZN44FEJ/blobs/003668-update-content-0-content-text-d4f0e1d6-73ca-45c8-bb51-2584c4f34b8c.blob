```
     1→/**
     2→ * Enhanced setup command for kspec agent integration.
     3→ *
     4→ * Orchestrates the full onboarding pipeline:
     5→ * - Detect agent environment (Claude Code, Cline, etc.)
     6→ * - Install hooks (UserPromptSubmit, Stop, PreToolUse guards)
     7→ * - Render skills from .kspec/skills/ to .claude/skills/
     8→ * - Generate kspec-agents.md
     9→ *
    10→ * AC: @enhanced-setup ac-1 - summary displayed listing each step performed
    11→ * AC: @enhanced-setup ac-2 - all hook entries (UserPromptSubmit, Stop, PreToolUse) present
    12→ * AC: @enhanced-setup ac-3 - rendered skill files exist for each skill targeting claude-code
    13→ * AC: @enhanced-setup ac-4 - kspec-agents.md exists after setup
    14→ * AC: @enhanced-setup ac-5 - --skip-skills flag skips skill rendering
    15→ * AC: @enhanced-setup ac-6 - --dry-run displays planned actions without changes
    16→ * AC: @enhanced-setup ac-7 - --status reports current state including agent detected
    17→ * AC: @enhanced-setup ac-8 - --status shows hooks status, skills rendered count, agents.md freshness
    18→ * AC: @enhanced-setup ac-9 - skills referenced by ralph (task-work, reflect) are present
    19→ */
    20→
    21→import * as fs from "node:fs/promises";
    22→import * as os from "node:os";
    23→import * as path from "node:path";
    24→import * as readline from "node:readline/promises";
    25→import chalk from "chalk";
    26→import type { Command } from "commander";
    27→import {
    28→  getGitRoot,
    29→  getShadowStatus,
    30→  repairShadow,
    31→  SHADOW_BRANCH_NAME,
    32→} from "../../parser/shadow.js";
    33→import { errors } from "../../strings/index.js";
    34→import { EXIT_CODES } from "../exit-codes.js";
    35→import { error, output, success, warn } from "../output.js";
    36→
    37→/**
    38→ * Log a message at debug level (only when KSPEC_DEBUG=1)
    39→ * AC: @setup-pipeline-unification ac-4
    40→ */
    41→function debugLog(message: string, detail?: unknown): void {
    42→  if (process.env.KSPEC_DEBUG === "1") {
    43→    if (detail) {
    44→      console.error(`[DEBUG] setup: ${message}`, detail);
    45→    } else {
    46→      console.error(`[DEBUG] setup: ${message}`);
    47→    }
    48→  }
    49→}
    50→
    51→/**
    52→ * Supported agent types for auto-configuration
    53→ */
    54→export type AgentType =
    55→  | "claude-code"
    56→  | "cline"
    57→  | "roo-code"
    58→  | "copilot-cli"
    59→  | "gemini-cli"
    60→  | "codex-cli"
    61→  | "aider"
    62→  | "opencode"
    63→  | "amp"
    64→  | "unknown";
    65→
    66→/**
    67→ * Result of agent detection
    68→ */
    69→export interface DetectedAgent {
    70→  type: AgentType;
    71→  confidence: "high" | "medium" | "low";
    72→  configPath?: string;
    73→  envVars?: Record<string, string>;
    74→}
    75→
    76→/**
    77→ * Detect which agent environment we're running in.
    78→ * Returns the detected agent type and confidence level.
    79→ *
    80→ * Detection priority matters - more specific markers checked first.
    81→ */
    82→export function detectAgent(): DetectedAgent {
    83→  // Claude Code: Multiple possible markers
    84→  // CLAUDECODE=1 is set in CLI sessions
    85→  // CLAUDE_CODE_ENTRYPOINT indicates entry point (cli, etc.)
    86→  // CLAUDE_PROJECT_DIR is set in some contexts
    87→  if (
    88→    process.env.CLAUDECODE === "1" ||
    89→    process.env.CLAUDE_CODE_ENTRYPOINT ||
    90→    process.env.CLAUDE_PROJECT_DIR
    91→  ) {
    92→    return {
    93→      type: "claude-code",
    94→      confidence: "high",
    95→      configPath: path.join(os.homedir(), ".claude", "settings.json"),
    96→      envVars: {
    97→        ...(process.env.CLAUDECODE && { CLAUDECODE: process.env.CLAUDECODE }),
    98→        ...(process.env.CLAUDE_CODE_ENTRYPOINT && {
    99→          CLAUDE_CODE_ENTRYPOINT: process.env.CLAUDE_CODE_ENTRYPOINT,
   100→        }),
   101→        ...(process.env.CLAUDE_PROJECT_DIR && {
   102→          CLAUDE_PROJECT_DIR: process.env.CLAUDE_PROJECT_DIR,
   103→        }),
   104→      },
   105→    };
   106→  }
   107→
   108→  // Cline: CLINE_ACTIVE is set when running in Cline terminal
   109→  if (process.env.CLINE_ACTIVE) {
   110→    return {
   111→      type: "cline",
   112→      confidence: "high",
   113→      // Cline uses VS Code settings, but env vars should be in shell profile
   114→      configPath: undefined,
   115→      envVars: { CLINE_ACTIVE: process.env.CLINE_ACTIVE },
   116→    };
   117→  }
   118→
   119→  // GitHub Copilot CLI: Check for copilot-specific markers
   120→  if (process.env.COPILOT_MODEL || process.env.GH_TOKEN) {
   121→    return {
   122→      type: "copilot-cli",
   123→      confidence: "medium",
   124→      configPath: path.join(os.homedir(), ".copilot", "config.json"),
   125→    };
   126→  }
   127→
   128→  // Aider: Check for AIDER_* env vars
   129→  if (process.env.AIDER_MODEL || process.env.AIDER_DARK_MODE !== undefined) {
   130→    return {
   131→      type: "aider",
   132→      confidence: "high",
   133→      configPath: path.join(os.homedir(), ".aider.conf.yml"),
   134→    };
   135→  }
   136→
   137→  // OpenCode: Check for OPENCODE_* env vars
   138→  if (process.env.OPENCODE_CONFIG_DIR || process.env.OPENCODE_CONFIG) {
   139→    return {
   140→      type: "opencode",
   141→      confidence: "high",
   142→      configPath:
   143→        process.env.OPENCODE_CONFIG ||
   144→        path.join(os.homedir(), ".config", "opencode", "opencode.json"),
   145→    };
   146→  }
   147→
   148→  // Gemini CLI: GEMINI_CLI=1 is set when running in Gemini CLI
   149→  if (process.env.GEMINI_CLI === "1") {
   150→    return {
   151→      type: "gemini-cli",
   152→      confidence: "high",
   153→      configPath: path.join(os.homedir(), ".gemini", "settings.json"),
   154→      envVars: { GEMINI_CLI: "1" },
   155→    };
   156→  }
   157→
   158→  // Codex CLI: CODEX_SANDBOX is set when running in sandbox
   159→  if (process.env.CODEX_SANDBOX) {
   160→    return {
   161→      type: "codex-cli",
   162→      confidence: "high",
   163→      configPath: path.join(os.homedir(), ".codex", "config.toml"),
   164→      envVars: { CODEX_SANDBOX: process.env.CODEX_SANDBOX },
   165→    };
   166→  }
   167→
   168→  // Amp (Sourcegraph): Check for AMP_API_KEY or AMP_TOOLBOX
   169→  if (process.env.AMP_API_KEY || process.env.AMP_TOOLBOX) {
   170→    return {
   171→      type: "amp",
   172→      confidence: "medium",
   173→      configPath: path.join(os.homedir(), ".config", "amp", "settings.json"),
   174→    };
   175→  }
   176→
   177→  return {
   178→    type: "unknown",
   179→    confidence: "low",
   180→  };
   181→}
   182→
   183→/**
   184→ * Install KSPEC_AUTHOR config for Claude Code (global settings)
   185→ */
   186→async function installClaudeCodeConfig(author: string): Promise<boolean> {
   187→  const configPath = path.join(os.homedir(), ".claude", "settings.json");
   188→  const configDir = path.dirname(configPath);
   189→
   190→  try {
   191→    // Ensure directory exists
   192→    await fs.mkdir(configDir, { recursive: true });
   193→
   194→    // Read existing config or start fresh
   195→    let config: Record<string, unknown> = {};
   196→    try {
   197→      const existing = await fs.readFile(configPath, "utf-8");
   198→      config = JSON.parse(existing);
   199→    } catch (err) {
   200→      debugLog("No existing Claude Code config, starting fresh", err);
   201→    }
   202→
   203→    // Merge env settings
   204→    const env = (config.env as Record<string, string>) || {};
   205→    env.KSPEC_AUTHOR = author;
   206→    config.env = env;
   207→
   208→    // Write back
   209→    await fs.writeFile(
   210→      configPath,
   211→      `${JSON.stringify(config, null, 2)}\n`,
   212→      "utf-8",
   213→    );
   214→    return true;
   215→  } catch (err) {
   216→    debugLog("Failed to install Claude Code config", err);
   217→    return false;
   218→  }
   219→}
   220→
   221→/**
   222→ * Result of installing hooks
   223→ * AC: @enhanced-setup ac-2 - tracks all hook types
   224→ */
   225→export interface HooksInstallResult {
   226→  promptCheck: boolean;
   227→  stop: boolean;
   228→  preToolUse: boolean;
   229→  guardsCreated: string[];
   230→}
   231→
   232→/**
   233→ * PreToolUse guard hook scripts
   234→ * These are the shell scripts that will be installed to .claude/hooks/
   235→ */
   236→const GUARD_SCRIPTS: Record<string, string> = {
   237→  "kspec-worktree-guard.sh": `#!/bin/bash
   238→# Guard against dangerous git operations in .kspec worktree
   239→#
   240→# This hook prevents accidentally creating branches or switching
   241→# branches in the .kspec worktree, which should always stay on kspec-meta.
   242→
   243→# Read the tool input from stdin
   244→INPUT=$(cat)
   245→
   246→# Extract the command from the JSON input
   247→COMMAND=$(echo "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null)
   248→
   249→# If no command, allow (not a Bash tool call)
   250→if [ -z "$COMMAND" ]; then
   251→  echo '{"decision": "allow"}'
   252→  exit 0
   253→fi
   254→
   255→# Two views of the command for safe matching:
   256→# 1. UNQUOTED: remove quote chars (keeps content) to catch split-quote
   257→#    bypasses like: git "reset" --hard → git reset --hard
   258→# 2. STRIPPED: remove entire quoted strings to ignore patterns in args
   259→#    like: echo "git reset" → echo
   260→UNQUOTED=$(echo "$COMMAND" | sed 's/["\\x27]//g')
   261→STRIPPED=$(echo "$COMMAND" | sed -e "s/\\x27[^\\x27]*\\x27//g" -e 's/"[^"]*"//g')
   262→# First command word (handles leading whitespace)
   263→FIRST_CMD=$(echo "$COMMAND" | sed 's/^[[:space:]]*//' | cut -d' ' -f1)
   264→
   265→# Block deleting kspec-meta from anywhere (check unquoted to catch bypasses)
   266→if [[ "$UNQUOTED" == *"git branch -d kspec-meta"* || "$UNQUOTED" == *"git branch -D kspec-meta"* ]]; then
   267→  cat <<EOF
   268→{
   269→  "decision": "block",
   270→  "reason": "[kspec-worktree-guard] BLOCKED: Cannot delete kspec-meta branch. This is the main branch for the .kspec worktree."
   271→}
   272→EOF
   273→  exit 0
   274→fi
   275→
   276→# Get cwd from hook input (not pwd - hook runs in different context)
   277→CWD=$(echo "$INPUT" | jq -r '.cwd // empty' 2>/dev/null)
   278→IN_KSPEC=false
   279→
   280→if [[ "$CWD" == *"/.kspec"* || "$CWD" == *"/.kspec" ]]; then
   281→  IN_KSPEC=true
   282→fi
   283→
   284→# Also check if command contains cd to .kspec
   285→if [[ "$COMMAND" == *"cd "*".kspec"* || "$COMMAND" == *"cd .kspec"* ]]; then
   286→  IN_KSPEC=true
   287→fi
   288→
   289→if [ "$IN_KSPEC" = false ]; then
   290→  echo '{"decision": "allow"}'
   291→  exit 0
   292→fi
   293→
   294→# Dangerous patterns in .kspec (branch creation/modification/history rewriting)
   295→# Note: "git checkout kspec-meta" is safe and allowed
   296→DANGEROUS_PATTERNS=(
   297→  # Branch creation
   298→  "git checkout -b"
   299→  "git checkout -B"
   300→  "git branch -c"
   301→  "git branch -C"
   302→  "git branch -m"
   303→  "git branch -M"
   304→  "git switch -c"
   305→  "git switch -C"
   306→  "git switch --create"
   307→  # History rewriting - these can cause conflicts with active sessions
   308→  "git reset"
   309→  "git rebase"
   310→  "git cherry-pick"
   311→  "git commit --amend"
   312→  # Force push
   313→  "git push --force"
   314→  "git push -f"
   315→  # Discarding changes
   316→  "git stash"
   317→  "git clean"
   318→  "git checkout -- "
   319→  "git restore"
   320→)
   321→
   322→for pattern in "\${DANGEROUS_PATTERNS[@]}"; do
   323→  # Block if:
   324→  # - Pattern matches UNQUOTED AND first command is "git" (catches split-quote bypasses), OR
   325→  # - Pattern matches STRIPPED (actual command outside any quotes)
   326→  # This allows: echo "git reset", grep "git stash" (first cmd is echo/grep, pattern not in STRIPPED)
   327→  # This blocks: git reset, git "reset" --hard, git st'ash' (first cmd is git OR pattern in STRIPPED)
   328→  if [[ "$STRIPPED" == *"$pattern"* ]] || { [[ "$UNQUOTED" == *"$pattern"* ]] && [[ "$FIRST_CMD" == "git" ]]; }; then
   329→    cat <<EOF
   330→{
   331→  "decision": "block",
   332→  "reason": "[kspec-worktree-guard] BLOCKED: Dangerous git operation in .kspec worktree. This worktree contains active session data and must stay on kspec-meta. Operations like reset, rebase, stash, and clean can corrupt session files."
   333→}
   334→EOF
   335→    exit 0
   336→  fi
   337→done
   338→
   339→# Allow all other commands
   340→echo '{"decision": "allow"}'
   341→`,
   342→
   343→  "ralph-task-limit-guard.sh": `#!/bin/bash
   344→# Ralph task limit guard - blocks task start when limit reached
   345→#
   346→# This hook provides hard enforcement of the --max-tasks limit.
   347→# Ralph writes a marker file when the limit is reached; this hook
   348→# blocks 'kspec task start' commands when that marker exists.
   349→
   350→# Marker file location (relative to project root)
   351→MARKER_FILE=".claude/ralph-task-limit.json"
   352→
   353→# Read the tool input from stdin
   354→INPUT=$(cat)
   355→
   356→# Extract the command from the JSON input
   357→COMMAND=$(echo "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null)
   358→
   359→# If no command, allow (not a Bash tool call)
   360→if [ -z "$COMMAND" ]; then
   361→  echo '{"decision": "allow"}'
   362→  exit 0
   363→fi
   364→
   365→# Only check commands that match "kspec task start"
   366→if [[ ! "$COMMAND" =~ kspec[[:space:]]+task[[:space:]]+start ]]; then
   367→  echo '{"decision": "allow"}'
   368→  exit 0
   369→fi
   370→
   371→# Get cwd from hook input to find marker file
   372→CWD=$(echo "$INPUT" | jq -r '.cwd // empty' 2>/dev/null)
   373→if [ -z "$CWD" ]; then
   374→  CWD="$PWD"
   375→fi
   376→
   377→# Find project root by walking up looking for .claude directory
   378→PROJECT_ROOT="$CWD"
   379→while [ "$PROJECT_ROOT" != "/" ]; do
   380→  if [ -d "$PROJECT_ROOT/.claude" ]; then
   381→    break
   382→  fi
   383→  PROJECT_ROOT=$(dirname "$PROJECT_ROOT")
   384→done
   385→
   386→if [ "$PROJECT_ROOT" = "/" ]; then
   387→  # No .claude directory found, allow
   388→  echo '{"decision": "allow"}'
   389→  exit 0
   390→fi
   391→
   392→MARKER_PATH="$PROJECT_ROOT/$MARKER_FILE"
   393→
   394→# Check if marker file exists
   395→if [ ! -f "$MARKER_PATH" ]; then
   396→  echo '{"decision": "allow"}'
   397→  exit 0
   398→fi
   399→
   400→# Read marker file and check if active
   401→ACTIVE=$(jq -r '.active // false' "$MARKER_PATH" 2>/dev/null)
   402→if [ "$ACTIVE" != "true" ]; then
   403→  echo '{"decision": "allow"}'
   404→  exit 0
   405→fi
   406→
   407→# Extract limit info for error message
   408→MAX=$(jq -r '.max // "?"' "$MARKER_PATH" 2>/dev/null)
   409→COMPLETED=$(jq -r '.completed // "?"' "$MARKER_PATH" 2>/dev/null)
   410→
   411→# Block the command
   412→cat <<EOF
   413→{
   414→  "decision": "block",
   415→  "reason": "[ralph-task-limit-guard] BLOCKED: Task limit reached (\${COMPLETED}/\${MAX} tasks completed this iteration). This limit was set by --max-tasks. Please wrap up current work and let the iteration end naturally. Do not attempt to start new tasks."
   416→}
   417→EOF
   418→exit 0
   419→`,
   420→};
   421→
   422→/**
   423→ * Install hooks to project-level Claude Code settings (.claude/settings.json)
   424→ * AC: @enhanced-setup ac-2 - all hook entries present
   425→ */
   426→async function installClaudeCodeHooks(
   427→  projectDir: string,
   428→  dryRun = false,
   429→): Promise<HooksInstallResult> {
   430→  const configPath = path.join(projectDir, ".claude", "settings.json");
   431→  const configDir = path.dirname(configPath);
   432→  const hooksDir = path.join(projectDir, ".claude", "hooks");
   433→
   434→  const result: HooksInstallResult = {
   435→    promptCheck: false,
   436→    stop: false,
   437→    preToolUse: false,
   438→    guardsCreated: [],
   439→  };
   440→
   441→  try {
   442→    // Ensure directories exist
   443→    if (!dryRun) {
   444→      await fs.mkdir(configDir, { recursive: true });
   445→      await fs.mkdir(hooksDir, { recursive: true });
   446→    }
   447→
   448→    // Read existing config or start fresh
   449→    let config: Record<string, unknown> = {};
   450→    try {
   451→      const existing = await fs.readFile(configPath, "utf-8");
   452→      config = JSON.parse(existing);
   453→    } catch (err) {
   454→      debugLog("No existing hooks config, starting fresh", err);
   455→    }
   456→
   457→    // Get or create hooks object
   458→    const hooks = (config.hooks as Record<string, unknown[]>) || {};
   459→
   460→    // Install UserPromptSubmit hook (spec-first reminder)
   461→    const promptCheckCommand = "kspec session prompt-check";
   462→    const existingPromptHooks = hooks.UserPromptSubmit as
   463→      | Array<{ hooks?: Array<{ command?: string }> }>
   464→      | undefined;
   465→    const promptAlreadyInstalled = existingPromptHooks?.some((entry) =>
   466→      entry.hooks?.some((hook) =>
   467→        hook.command?.includes("session prompt-check"),
   468→      ),
   469→    );
   470→
   471→    if (!promptAlreadyInstalled) {
   472→      hooks.UserPromptSubmit = [
   473→        ...(existingPromptHooks || []),
   474→        {
   475→          hooks: [
   476→            {
   477→              type: "command",
   478→              command: promptCheckCommand,
   479→            },
   480→          ],
   481→        },
   482→      ];
   483→      result.promptCheck = true;
   484→    } else {
   485→      result.promptCheck = true; // Already configured
   486→    }
   487→
   488→    // Install Stop hook (checkpoint)
   489→    const stopHookCommand = "kspec session checkpoint --json";
   490→    const existingStopHooks = hooks.Stop as
   491→      | Array<{ matcher?: string; hooks?: Array<{ command?: string }> }>
   492→      | undefined;
   493→    const stopAlreadyInstalled = existingStopHooks?.some((entry) =>
   494→      entry.hooks?.some((hook) => hook.command?.includes("session checkpoint")),
   495→    );
   496→
   497→    if (!stopAlreadyInstalled) {
   498→      hooks.Stop = [
   499→        ...(existingStopHooks || []),
   500→        {
   501→          matcher: "",
   502→          hooks: [
   503→            {
   504→              type: "command",
   505→              command: stopHookCommand,
   506→            },
   507→          ],
   508→        },
   509→      ];
   510→      result.stop = true;
   511→    } else {
   512→      result.stop = true; // Already configured
   513→    }
   514→
   515→    // AC: @enhanced-setup ac-2 - Install PreToolUse hooks with guards
   516→    const existingPreToolUseHooks = hooks.PreToolUse as
   517→      | Array<{ matcher?: string; hooks?: Array<{ command?: string }> }>
   518→      | undefined;
   519→
   520→    // Check if our guards are already installed
   521→    const guardHookCommands = Object.keys(GUARD_SCRIPTS).map(
   522→      (name) => `.claude/hooks/${name}`,
   523→    );
   524→    const guardsAlreadyInstalled = existingPreToolUseHooks?.some((entry) =>
   525→      entry.hooks?.some((hook) =>
   526→        guardHookCommands.some((cmd) => hook.command?.includes(cmd)),
   527→      ),
   528→    );
   529→
   530→    if (!guardsAlreadyInstalled) {
   531→      // Create guard script files
   532→      for (const [name, content] of Object.entries(GUARD_SCRIPTS)) {
   533→        const scriptPath = path.join(hooksDir, name);
   534→        if (!dryRun) {
   535→          await fs.writeFile(scriptPath, content, { mode: 0o755 });
   536→        }
   537→        result.guardsCreated.push(name);
   538→      }
   539→
   540→      // Add PreToolUse hook entry
   541→      hooks.PreToolUse = [
   542→        ...(existingPreToolUseHooks || []),
   543→        {
   544→          matcher: "Bash",
   545→          hooks: Object.keys(GUARD_SCRIPTS).map((name) => ({
   546→            type: "command",
   547→            command: `.claude/hooks/${name}`,
   548→          })),
   549→        },
   550→      ];
   551→      result.preToolUse = true;
   552→    } else {
   553→      result.preToolUse = true; // Already configured
   554→    }
   555→
   556→    config.hooks = hooks;
   557→
   558→    // Write back
   559→    if (!dryRun) {
   560→      await fs.writeFile(
   561→        configPath,
   562→        `${JSON.stringify(config, null, 2)}\n`,
   563→        "utf-8",
   564→      );
   565→    }
   566→    return result;
   567→  } catch (err) {
   568→    debugLog("installClaudeCodeHooks failed", err);
   569→    return result;
   570→  }
   571→}
   572→
   573→/**
   574→ * Install stop hook to project-level Claude Code settings (.claude/settings.json)
   575→ * @deprecated Use installClaudeCodeHooks instead
   576→ */
   577→async function _installClaudeCodeStopHook(
   578→  projectDir: string,
   579→): Promise<boolean> {
   580→  const configPath = path.join(projectDir, ".claude", "settings.json");
   581→  const configDir = path.dirname(configPath);
   582→
   583→  try {
   584→    // Ensure directory exists
   585→    await fs.mkdir(configDir, { recursive: true });
   586→
   587→    // Read existing config or start fresh
   588→    let config: Record<string, unknown> = {};
   589→    try {
   590→      const existing = await fs.readFile(configPath, "utf-8");
   591→      config = JSON.parse(existing);
   592→    } catch (err) {
   593→      debugLog("No existing config for stop hook, starting fresh", err);
   594→    }
   595→
   596→    // Build the stop hook command
   597→    const stopHookCommand = "npx kspec session checkpoint --json";
   598→
   599→    // Get or create hooks object
   600→    const hooks = (config.hooks as Record<string, unknown[]>) || {};
   601→
   602→    // Check if Stop hook already exists with our command
   603→    const existingStopHooks = hooks.Stop as
   604→      | Array<{ matcher?: object; hooks?: Array<{ command?: string }> }>
   605→      | undefined;
   606→    const alreadyInstalled = existingStopHooks?.some((entry) =>
   607→      entry.hooks?.some((hook) => hook.command?.includes("session checkpoint")),
   608→    );
   609→
   610→    if (alreadyInstalled) {
   611→      return true; // Already configured
   612→    }
   613→
   614→    // Add our stop hook using Claude Code hooks format
   615→    // Note: matcher field is required even if empty string
   616→    hooks.Stop = [
   617→      ...(existingStopHooks || []),
   618→      {
   619→        matcher: "",
   620→        hooks: [
   621→          {
   622→            type: "command",
   623→            command: stopHookCommand,
   624→          },
   625→        ],
   626→      },
   627→    ];
   628→    config.hooks = hooks;
   629→
   630→    // Write back
   631→    await fs.writeFile(
   632→      configPath,
   633→      `${JSON.stringify(config, null, 2)}\n`,
   634→      "utf-8",
   635→    );
   636→    return true;
   637→  } catch (err) {
   638→    debugLog("_installClaudeCodeStopHook failed", err);
   639→    return false;
   640→  }
   641→}
   642→
   643→/**
   644→ * Install KSPEC_AUTHOR config for Aider (.aider.conf.yml)
   645→ * Aider uses `set-env:` for environment variables in list format
   646→ */
   647→async function installAiderConfig(author: string): Promise<boolean> {
   648→  const configPath = path.join(os.homedir(), ".aider.conf.yml");
   649→
   650→  try {
   651→    let content = "";
   652→    try {
   653→      content = await fs.readFile(configPath, "utf-8");
   654→    } catch (err) {
   655→      debugLog("No existing Aider config, starting fresh", err);
   656→    }
   657→
   658→    // Check if KSPEC_AUTHOR is already set
   659→    if (content.includes("KSPEC_AUTHOR")) {
   660→      // Replace existing value (handles both old and new format)
   661→      content = content.replace(
   662→        /^(\s*-?\s*KSPEC_AUTHOR\s*[=:]\s*).*$/m,
   663→        `  - KSPEC_AUTHOR=${author}`,
   664→      );
   665→    } else {
   666→      // Add to set-env section or create it
   667→      if (content.includes("set-env:")) {
   668→        // Append to existing set-env section
   669→        content = content.replace(
   670→          /(set-env:\s*\n)/m,
   671→          `$1  - KSPEC_AUTHOR=${author}\n`,
   672→        );
   673→      } else {
   674→        // Add new set-env section
   675→        content += `\n# kspec author for note attribution\nset-env:\n  - KSPEC_AUTHOR=${author}\n`;
   676→      }
   677→    }
   678→
   679→    await fs.writeFile(configPath, content, "utf-8");
   680→    return true;
   681→  } catch (err) {
   682→    debugLog("installAiderConfig failed", err);
   683→    return false;
   684→  }
   685→}
   686→
   687→/**
   688→ * Install KSPEC_AUTHOR for generic JSON config files
   689→ */
   690→async function installGenericJsonConfig(
   691→  configPath: string,
   692→  author: string,
   693→): Promise<boolean> {
   694→  try {
   695→    const configDir = path.dirname(configPath);
   696→    await fs.mkdir(configDir, { recursive: true });
   697→
   698→    let config: Record<string, unknown> = {};
   699→    try {
   700→      const existing = await fs.readFile(configPath, "utf-8");
   701→      config = JSON.parse(existing);
   702→    } catch (err) {
   703→      debugLog(`No existing config at ${configPath}, starting fresh`, err);
   704→    }
   705→
   706→    const env = (config.env as Record<string, string>) || {};
   707→    env.KSPEC_AUTHOR = author;
   708→    config.env = env;
   709→
   710→    await fs.writeFile(
   711→      configPath,
   712→      `${JSON.stringify(config, null, 2)}\n`,
   713→      "utf-8",
   714→    );
   715→    return true;
   716→  } catch (err) {
   717→    debugLog(`installGenericJsonConfig failed for ${configPath}`, err);
   718→    return false;
   719→  }
   720→}
   721→
   722→/**
   723→ * Get default author value for an agent type
   724→ */
   725→function getDefaultAuthor(agentType: AgentType): string {
   726→  switch (agentType) {
   727→    case "claude-code":
   728→      return "@claude";
   729→    case "cline":
   730→      return "@cline";
   731→    case "roo-code":
   732→      return "@roo";
   733→    case "copilot-cli":
   734→      return "@copilot";
   735→    case "gemini-cli":
   736→      return "@gemini";
   737→    case "codex-cli":
   738→      return "@codex";
   739→    case "aider":
   740→      return "@aider";
   741→    case "opencode":
   742→      return "@opencode";
   743→    case "amp":
   744→      return "@amp";
   745→    default:
   746→      return "@agent";
   747→  }
   748→}
   749→
   750→/**
   751→ * Prompt user for input with Y/N answer
   752→ */
   753→async function promptYesNo(question: string): Promise<boolean> {
   754→  const rl = readline.createInterface({
   755→    input: process.stdin,
   756→    output: process.stdout,
   757→  });
   758→
   759→  try {
   760→    const answer = await rl.question(`${question} `);
   761→    return answer.toLowerCase() === "y";
   762→  } finally {
   763→    rl.close();
   764→  }
   765→}
   766→
   767→/**
   768→ * Ensure .kspec worktree exists if kspec-meta branch is present.
   769→ * AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
   770→ *
   771→ * @param autoWorktree If true, automatically create worktree without prompting
   772→ * @returns true if worktree is ready to use
   773→ */
   774→async function ensureWorktree(autoWorktree: boolean): Promise<boolean> {
   775→  const projectRoot = getGitRoot(process.cwd());
   776→  if (!projectRoot) {
   777→    // Not in a git repo, skip worktree check
   778→    return true;
   779→  }
   780→
   781→  const status = await getShadowStatus(projectRoot);
   782→
   783→  // AC: worktree-already-exists - if already valid, skip
   784→  if (status.healthy) {
   785→    return true;
   786→  }
   787→
   788→  // AC: detect-existing-repo - branch exists but worktree doesn't
   789→  if (status.branchExists && !status.worktreeExists) {
   790→    // AC: auto-worktree-flag - auto-create if flag set
   791→    if (autoWorktree) {
   792→      console.log(
   793→        `Detected ${SHADOW_BRANCH_NAME} branch without .kspec worktree. Creating...`,
   794→      );
   795→      const result = await repairShadow(projectRoot);
   796→      if (result.success) {
   797→        success("Created .kspec worktree");
   798→        return true;
   799→      } else {
   800→        error(`Failed to create worktree: ${result.error}`);
   801→        return false;
   802→      }
   803→    }
   804→
   805→    // AC: detect-existing-repo - prompt user
   806→    const shouldCreate = await promptYesNo(
   807→      `${SHADOW_BRANCH_NAME} branch exists but .kspec worktree is missing. Create it? (y/N)`,
   808→    );
   809→
   810→    if (shouldCreate) {
   811→      console.log("Creating .kspec worktree...");
   812→      const result = await repairShadow(projectRoot);
   813→      if (result.success) {
   814→        success("Created .kspec worktree");
   815→        return true;
   816→      } else {
   817→        error(`Failed to create worktree: ${result.error}`);
   818→        return false;
   819→      }
   820→    } else {
   821→      warn("Skipping worktree creation");
   822→      return false;
   823→    }
   824→  }
   825→
   826→  // No kspec-meta branch, or already healthy
   827→  return true;
   828→}
   829→
   830→/**
   831→ * Print manual setup instructions
   832→ */
   833→function printManualInstructions(agentType: AgentType): void {
   834→  const author = getDefaultAuthor(agentType);
   835→
   836→  console.log("\nManual setup instructions:\n");
   837→
   838→  switch (agentType) {
   839→    case "claude-code":
   840→      console.log("Add to ~/.claude/settings.json:");
   841→      console.log("```json");
   842→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   843→      console.log("```");
   844→      break;
   845→
   846→    case "cline":
   847→    case "roo-code":
   848→      console.log("Add to your shell profile (~/.bashrc, ~/.zshrc):");
   849→      console.log("```bash");
   850→      console.log(`export KSPEC_AUTHOR="${author}"`);
   851→      console.log("```");
   852→      console.log(
   853→        "\nThis will be inherited by terminals spawned by the VS Code extension.",
   854→      );
   855→      break;
   856→
   857→    case "copilot-cli":
   858→      console.log("Add to ~/.copilot/config.json:");
   859→      console.log("```json");
   860→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   861→      console.log("```");
   862→      break;
   863→
   864→    case "aider":
   865→      console.log("Add to ~/.aider.conf.yml:");
   866→      console.log("```yaml");
   867→      console.log("set-env:");
   868→      console.log(`  - KSPEC_AUTHOR=${author}`);
   869→      console.log("```");
   870→      break;
   871→
   872→    case "codex-cli":
   873→      console.log("Add to ~/.codex/config.toml:");
   874→      console.log("```toml");
   875→      console.log("[shell_environment_policy]");
   876→      console.log(`set = { KSPEC_AUTHOR = "${author}" }`);
   877→      console.log("```");
   878→      break;
   879→
   880→    case "opencode":
   881→      console.log("Add to ~/.config/opencode/opencode.json:");
   882→      console.log("```json");
   883→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   884→      console.log("```");
   885→      break;
   886→
   887→    case "amp":
   888→      console.log("Add to ~/.config/amp/settings.json:");
   889→      console.log("```json");
   890→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   891→      console.log("```");
   892→      break;
   893→
   894→    default:
   895→      console.log("Set the KSPEC_AUTHOR environment variable:");
   896→      console.log("```bash");
   897→      console.log(`export KSPEC_AUTHOR="${author}"`);
   898→      console.log("```");
   899→      console.log("\nOr add to your shell profile (~/.bashrc, ~/.zshrc, etc.)");
   900→  }
   901→}
   902→
   903→/**
   904→ * Result of a setup step
   905→ */
   906→interface SetupStepResult {
   907→  name: string;
   908→  status: "done" | "skipped" | "failed";
   909→  message?: string;
   910→  details?: Record<string, unknown>;
   911→}
   912→
   913→/**
   914→ * Result of running the setup pipeline
   915→ * Used by both the setup command and init --setup
   916→ * AC: @init-setup-integration ac-2, ac-3
   917→ */
   918→export interface SetupPipelineResult {
   919→  success: boolean;
   920→  steps: SetupStepResult[];
   921→  coreSkillsInstalled: number;
   922→  skillsRendered: number;
   923→  hooksInstalled: boolean;
   924→  agentsMdGenerated: boolean;
   925→  permissionsSeeded: boolean;
   926→  memorySeeded: boolean;
   927→}
   928→
   929→/**
   930→ * Options for running the setup pipeline
   931→ */
   932→export interface SetupPipelineOptions {
   933→  dryRun?: boolean;
   934→  skipSkills?: boolean;
   935→  installHooks?: boolean;
   936→  force?: boolean;
   937→  /** Custom author string (overrides auto-detected default) */
   938→  author?: string;
   939→  /** Whether to configure author (only in command handler, not init) */
   940→  configureAuthor?: boolean;
   941→}
   942→
   943→/**
   944→ * Status of the setup state
   945→ * AC: @enhanced-setup ac-7, ac-8 - status reporting
   946→ */
   947→interface SetupStatus {
   948→  agent: {
   949→    detected: AgentType;
   950→    confidence: "high" | "medium" | "low";
   951→  };
   952→  hooks: {
   953→    promptCheck: boolean;
   954→    stop: boolean;
   955→    preToolUse: boolean;
   956→    guardsPresent: string[];
   957→  };
   958→  skills: {
   959→    total: number;
   960→    rendered: number;
   961→    drifted: number;
   962→  };
   963→  agentsMd: {
   964→    exists: boolean;
   965→    status: "current" | "stale" | "missing";
   966→    generatedAt?: string;
   967→  };
   968→  seeding: {
   969→    permissionsSeeded: boolean;
   970→    memorySeeded: boolean;
   971→    memoryPath?: string;
   972→  };
   973→}
   974→
   975→/**
   976→ * Check the current setup status
   977→ * AC: @enhanced-setup ac-7, ac-8
   978→ */
   979→async function getSetupStatus(projectDir: string): Promise<SetupStatus> {
   980→  const detected = detectAgent();
   981→  const configPath = path.join(projectDir, ".claude", "settings.json");
   982→  const hooksDir = path.join(projectDir, ".claude", "hooks");
   983→  const agentsMdPath = path.join(projectDir, "kspec-agents.md");
   984→  const hashPath = path.join(projectDir, ".kspec", ".kspec-agents-hash");
   985→  const skillsDir = path.join(projectDir, ".claude", "skills");
   986→
   987→  // Check hooks
   988→  const hooks = {
   989→    promptCheck: false,
   990→    stop: false,
   991→    preToolUse: false,
   992→    guardsPresent: [] as string[],
   993→  };
   994→
   995→  try {
   996→    const configContent = await fs.readFile(configPath, "utf-8");
   997→    const config = JSON.parse(configContent);
   998→    const hooksConfig = config.hooks || {};
   999→
  1000→    // Check UserPromptSubmit
  1001→    const promptHooks = hooksConfig.UserPromptSubmit as Array<{
  1002→      hooks?: Array<{ command?: string }>;
  1003→    }> | undefined;
  1004→    hooks.promptCheck = promptHooks?.some((entry) =>
  1005→      entry.hooks?.some((h) => h.command?.includes("prompt-check")),
  1006→    ) ?? false;
  1007→
  1008→    // Check Stop
  1009→    const stopHooks = hooksConfig.Stop as Array<{
  1010→      hooks?: Array<{ command?: string }>;
  1011→    }> | undefined;
  1012→    hooks.stop = stopHooks?.some((entry) =>
  1013→      entry.hooks?.some((h) => h.command?.includes("checkpoint")),
  1014→    ) ?? false;
  1015→
  1016→    // Check PreToolUse
  1017→    const preToolUseHooks = hooksConfig.PreToolUse as Array<{
  1018→      hooks?: Array<{ command?: string }>;
  1019→    }> | undefined;
  1020→    hooks.preToolUse = preToolUseHooks?.some((entry) =>
  1021→      entry.hooks?.some((h) => h.command?.includes(".claude/hooks/")),
  1022→    ) ?? false;
  1023→  } catch (err) {
  1024→    debugLog("Failed to read hooks config for status", err);
  1025→  }
  1026→
  1027→  // Check guard scripts
  1028→  try {
  1029→    const guardFiles = await fs.readdir(hooksDir);
  1030→    for (const name of Object.keys(GUARD_SCRIPTS)) {
  1031→      if (guardFiles.includes(name)) {
  1032→        hooks.guardsPresent.push(name);
  1033→      }
  1034→    }
  1035→  } catch (err) {
  1036→    debugLog("Hooks dir doesn't exist", err);
  1037→  }
  1038→
  1039→  // Check skills
  1040→  const skills = {
  1041→    total: 0,
  1042→    rendered: 0,
  1043→    drifted: 0,
  1044→  };
  1045→
  1046→  try {
  1047→    const skillDirs = await fs.readdir(skillsDir, { withFileTypes: true });
  1048→    for (const dir of skillDirs) {
  1049→      if (dir.isDirectory()) {
  1050→        const skillMdPath = path.join(skillsDir, dir.name, "SKILL.md");
  1051→        try {
  1052→          const content = await fs.readFile(skillMdPath, "utf-8");
  1053→          if (content.includes("<!-- kspec-managed -->")) {
  1054→            skills.total++;
  1055→            skills.rendered++;
  1056→            // TODO: check drift status
  1057→          }
  1058→        } catch (err) {
  1059→          debugLog(`SKILL.md doesn't exist in ${dir.name}`, err);
  1060→        }
  1061→      }
  1062→    }
  1063→  } catch (err) {
  1064→    debugLog("Skills dir doesn't exist", err);
  1065→  }
  1066→
  1067→  // Check agents.md
  1068→  const agentsMd: SetupStatus["agentsMd"] = {
  1069→    exists: false,
  1070→    status: "missing",
  1071→  };
  1072→
  1073→  try {
  1074→    await fs.access(agentsMdPath);
  1075→    agentsMd.exists = true;
  1076→
  1077→    try {
  1078→      const hashContent = await fs.readFile(hashPath, "utf-8");
  1079→      const hashData = JSON.parse(hashContent);
  1080→      agentsMd.generatedAt = hashData.generatedAt;
  1081→
  1082→      // AC: @cross-platform-and-version-robustness ac-4
  1083→      // Compare stored hash against current meta to detect staleness
  1084→      try {
  1085→        const { initContext, loadMetaContext } = await import(
  1086→          "../../parser/index.js"
  1087→        );
  1088→        const { computeMetaHash, loadTemplateSections, getPackageRoot } = await import("./agents.js");
  1089→        const ctx = await initContext();
  1090→        if (ctx.manifestPath) {
  1091→          const metaCtx = await loadMetaContext(ctx);
  1092→          let templateSections: string[] = [];
  1093→          try {
  1094→            templateSections = await loadTemplateSections(getPackageRoot());
  1095→          } catch (err) {
  1096→            debugLog("Templates not available for staleness check", err);
  1097→          }
  1098→          const currentHash = computeMetaHash(
  1099→            metaCtx.skills,
  1100→            metaCtx.conventions,
  1101→            metaCtx.workflows,
  1102→            templateSections,
  1103→          );
  1104→          agentsMd.status = hashData.metaHash === currentHash ? "current" : "stale";
  1105→        } else {
  1106→          agentsMd.status = "current"; // No kspec project, can't compare
  1107→        }
  1108→      } catch (err) {
  1109→        debugLog("Could not compute meta hash for staleness check, assuming current", err);
  1110→        agentsMd.status = "current";
  1111→      }
  1112→    } catch (err) {
  1113→      debugLog("Hash file missing or invalid, marking stale", err);
  1114→      agentsMd.status = "stale";
  1115→    }
  1116→  } catch (err) {
  1117→    debugLog("kspec-agents.md doesn't exist", err);
  1118→  }
  1119→
  1120→  // Check seeding state
  1121→  const seeding: SetupStatus["seeding"] = {
  1122→    permissionsSeeded: false,
  1123→    memorySeeded: false,
  1124→  };
  1125→
  1126→  try {
  1127→    const configContent = await fs.readFile(
  1128→      path.join(projectDir, ".claude", "settings.json"),
  1129→      "utf-8",
  1130→    );
  1131→    const config = JSON.parse(configContent);
  1132→    seeding.permissionsSeeded = !!config.permissions;
  1133→  } catch (err) {
  1134→    debugLog("Could not check permissions seeding state", err);
  1135→  }
  1136→
  1137→  if (detected.type === "claude-code") {
  1138→    try {
  1139→      const { claudeCodeMemoryWriter } = await import("./setup-seeding.js");
  1140→      const memoryExists = await claudeCodeMemoryWriter.exists(projectDir);
  1141→      seeding.memorySeeded = memoryExists;
  1142→      if (memoryExists) {
  1143→        seeding.memoryPath = claudeCodeMemoryWriter.getMemoryPath(projectDir);
  1144→      }
  1145→    } catch (err) {
  1146→      debugLog("Could not check memory seeding state", err);
  1147→    }
  1148→  }
  1149→
  1150→  return {
  1151→    agent: {
  1152→      detected: detected.type,
  1153→      confidence: detected.confidence,
  1154→    },
  1155→    hooks,
  1156→    skills,
  1157→    agentsMd,
  1158→    seeding,
  1159→  };
  1160→}
  1161→
  1162→/**
  1163→ * Render skills using the platform renderer registry
  1164→ * AC: @setup-pipeline-unification ac-2 - uses getRenderer/getAllRenderers, not legacy renderClaudeCodeSkill
  1165→ * AC: @setup-pipeline-unification ac-4 - errors logged at debug level
  1166→ */
  1167→async function renderSkillsForSetup(
  1168→  projectDir: string,
  1169→  dryRun: boolean,
  1170→): Promise<{ rendered: number; skipped: number; skillIds: string[] }> {
  1171→  // Dynamically import to avoid circular dependencies
  1172→  const { initContext, loadMetaContext } = await import(
  1173→    "../../parser/index.js"
  1174→  );
  1175→  const { getRenderer } = await import("../../parser/skill-render.js");
  1176→
  1177→  try {
  1178→    const ctx = await initContext();
  1179→
  1180→    if (!ctx.manifestPath) {
  1181→      return { rendered: 0, skipped: 0, skillIds: [] };
  1182→    }
  1183→
  1184→    const metaCtx = await loadMetaContext(ctx);
  1185→
  1186→    // Collect all skills that have a registered renderer for their platform
  1187→    const skillsToRender: Array<{ skill: typeof metaCtx.skills[0]; platform: string }> = [];
  1188→    for (const skill of metaCtx.skills) {
  1189→      for (const platform of skill.platforms) {
  1190→        const renderer = getRenderer(platform);
  1191→        if (renderer) {
  1192→          skillsToRender.push({ skill, platform });
  1193→        }
  1194→      }
  1195→    }
  1196→
  1197→    if (skillsToRender.length === 0) {
  1198→      return { rendered: 0, skipped: 0, skillIds: [] };
  1199→    }
  1200→
  1201→    let rendered = 0;
  1202→    let skipped = 0;
  1203→    const skillIds: string[] = [];
  1204→
  1205→    for (const { skill, platform } of skillsToRender) {
  1206→      const renderer = getRenderer(platform)!;
  1207→      try {
  1208→        const result = await renderer.render(ctx, projectDir, skill, {
  1209→          dryRun,
  1210→        });
  1211→        if (result.action === "created" || result.action === "updated") {
  1212→          rendered++;
  1213→          if (!skillIds.includes(skill.id)) {
  1214→            skillIds.push(skill.id);
  1215→          }
  1216→        } else {
  1217→          skipped++;
  1218→        }
  1219→      } catch (err) {
  1220→        debugLog(`Failed to render skill ${skill.id} for ${platform}`, err);
  1221→        skipped++;
  1222→      }
  1223→    }
  1224→
  1225→    return { rendered, skipped, skillIds };
  1226→  } catch (err) {
  1227→    debugLog("renderSkillsForSetup failed", err);
  1228→    return { rendered: 0, skipped: 0, skillIds: [] };
  1229→  }
  1230→}
  1231→
  1232→/**
  1233→ * Generate kspec-agents.md using the canonical implementation from agents.ts
  1234→ * AC: @setup-pipeline-unification ac-1 - calls generateAgentsContent() from agents.ts
  1235→ * AC: @setup-pipeline-unification ac-4 - errors logged at debug level
  1236→ */
  1237→async function generateAgentInstructions(
  1238→  projectDir: string,
  1239→  dryRun: boolean,
  1240→): Promise<{ success: boolean; path: string }> {
  1241→  const outputPath = path.join(projectDir, "kspec-agents.md");
  1242→  const hashPath = path.join(projectDir, ".kspec", ".kspec-agents-hash");
  1243→
  1244→  // Dynamically import to avoid circular dependencies
  1245→  const { initContext, loadMetaContext } = await import(
  1246→    "../../parser/index.js"
  1247→  );
  1248→  const {
  1249→    generateAgentsContent,
  1250→    loadTemplateSections,
  1251→    getPackageRoot,
  1252→    computeMetaHash,
  1253→  } = await import("./agents.js");
  1254→
  1255→  try {
  1256→    const ctx = await initContext();
  1257→
  1258→    if (!ctx.manifestPath) {
  1259→      return { success: false, path: outputPath };
  1260→    }
  1261→
  1262→    const metaCtx = await loadMetaContext(ctx);
  1263→    const timestamp = new Date().toISOString();
  1264→
  1265→    // Load templates using the canonical implementation
  1266→    let templateSections: string[] = [];
  1267→    try {
  1268→      templateSections = await loadTemplateSections(getPackageRoot());
  1269→    } catch (err) {
  1270→      debugLog("Failed to load template sections", err);
  1271→    }
  1272→
  1273→    // Generate content using the canonical implementation from agents.ts
  1274→    const content = await generateAgentsContent(
  1275→      metaCtx.skills,
  1276→      metaCtx.conventions,
  1277→      metaCtx.workflows,
  1278→      timestamp,
  1279→      templateSections,
  1280→    );
  1281→
  1282→    if (!dryRun) {
  1283→      await fs.writeFile(outputPath, content, "utf-8");
  1284→
  1285→      // Write hash for freshness tracking using the canonical hash function
  1286→      const metaHash = computeMetaHash(
  1287→        metaCtx.skills,
  1288→        metaCtx.conventions,
  1289→        metaCtx.workflows,
  1290→        templateSections,
  1291→      );
  1292→
  1293→      await fs.mkdir(path.dirname(hashPath), { recursive: true });
  1294→      // Dynamically import version to avoid top-level require
  1295→      const { createRequire } = await import("node:module");
  1296→      const req = createRequire(import.meta.url);
  1297→      const { version } = req("../../../package.json");
  1298→
  1299→      await fs.writeFile(
  1300→        hashPath,
  1301→        JSON.stringify(
  1302→          {
  1303→            metaHash,
  1304→            generatedAt: timestamp,
  1305→            version,
  1306→          },
  1307→          null,
  1308→          2,
  1309→        ),
  1310→        "utf-8",
  1311→      );
  1312→    }
  1313→
  1314→    return { success: true, path: outputPath };
  1315→  } catch (err) {
  1316→    debugLog("generateAgentInstructions failed", err);
  1317→    return { success: false, path: outputPath };
  1318→  }
  1319→}
  1320→
  1321→/**
  1322→ * Install core skills for the setup pipeline
  1323→ * AC: @init-setup-integration ac-2 - core skills installed
  1324→ */
  1325→async function installCoreSkillsForSetup(
  1326→  projectDir: string,
  1327→  dryRun: boolean
  1328→): Promise<{ installed: number; skipped: number }> {
  1329→  // Dynamically import to avoid circular dependencies
  1330→  const {
  1331→    initContext,
  1332→    loadMetaContext,
  1333→    saveMetaItem,
  1334→    getSkillContentPath,
  1335→  } = await import("../../parser/index.js");
  1336→  const { commitIfShadow } = await import("../../parser/shadow.js");
  1337→  const { SkillSchema } = await import("../../schema/index.js");
  1338→  const {
  1339→    loadCoreSkillsManifest,
  1340→    loadCoreSkillContent,
  1341→    getKspecPackageVersion,
  1342→  } = await import("./skill.js");
  1343→  const { ulid } = await import("ulid");
  1344→
  1345→  let installed = 0;
  1346→  let skipped = 0;
  1347→
  1348→  try {
  1349→    const ctx = await initContext();
  1350→
  1351→    if (!ctx.manifestPath) {
  1352→      return { installed: 0, skipped: 0 };
  1353→    }
  1354→
  1355→    const metaCtx = await loadMetaContext(ctx);
  1356→    const coreSkills = await loadCoreSkillsManifest();
  1357→    // AC: @cross-platform-and-version-robustness ac-3
  1358→    const kspecVersion = await getKspecPackageVersion();
  1359→    if (!kspecVersion) {
  1360→      debugLog("Could not determine kspec version — skills installed without version tracking");
  1361→    }
  1362→
  1363→    for (const coreSkill of coreSkills) {
  1364→      // Check if skill exists
  1365→      const existingSkill = metaCtx.skills.find((s) => s.id === coreSkill.id);
  1366→
  1367→      if (existingSkill && existingSkill.origin !== "core") {
  1368→        // Custom/project skill exists, skip
  1369→        skipped++;
  1370→        continue;
  1371→      }
  1372→
  1373→      // Build skill data
  1374→      const skillData = {
  1375→        _ulid: existingSkill?._ulid || ulid(),
  1376→        id: coreSkill.id,
  1377→        name: coreSkill.name,
  1378→        description: coreSkill.description,
  1379→        origin: "core" as const,
  1380→        ...(kspecVersion && { version: kspecVersion }),
  1381→        platforms: coreSkill.platforms || ["claude-code"],
  1382→        depends_on: [],
  1383→        tags: ["core"],
  1384→      };
  1385→
  1386→      const parsed = SkillSchema.safeParse(skillData);
  1387→      if (!parsed.success) {
  1388→        skipped++;
  1389→        continue;
  1390→      }
  1391→
  1392→      if (!dryRun) {
  1393→        await saveMetaItem(ctx, parsed.data, "skill");
  1394→
  1395→        // Copy SKILL.md content
  1396→        const sourceContent = await loadCoreSkillContent(coreSkill.id);
  1397→        if (sourceContent) {
  1398→          const targetPath = getSkillContentPath(ctx, parsed.data.id);
  1399→          await fs.writeFile(targetPath, sourceContent, "utf-8");
  1400→        }
  1401→      }
  1402→
  1403→      installed++;
  1404→    }
  1405→
  1406→    // Commit changes
  1407→    if (!dryRun && installed > 0) {
  1408→      const ctx2 = await initContext();
  1409→      await commitIfShadow(
  1410→        ctx2.shadow,
  1411→        "skill-install-core",
  1412→        `${installed} core skills`
  1413→      );
  1414→    }
  1415→
  1416→    return { installed, skipped };
  1417→  } catch (err) {
  1418→    debugLog("installCoreSkillsForSetup failed", err);
  1419→    return { installed: 0, skipped: 0 };
  1420→  }
  1421→}
  1422→
  1423→/**
  1424→ * Run the full setup pipeline programmatically.
  1425→ * Used by both 'kspec setup' command and 'kspec init --setup'.
  1426→ * AC: @init-setup-integration ac-2, ac-3
  1427→ */
  1428→export async function runSetupPipeline(
  1429→  projectDir: string,
  1430→  options: SetupPipelineOptions
  1431→): Promise<SetupPipelineResult> {
  1432→  const dryRun = options.dryRun ?? false;
  1433→  const skipSkills = options.skipSkills ?? false;
  1434→  const installHooksFlag = options.installHooks ?? true;
  1435→
  1436→  const steps: SetupStepResult[] = [];
  1437→  let coreSkillsInstalled = 0;
  1438→  let skillsRendered = 0;
  1439→  let hooksInstalled = false;
  1440→  let agentsMdGenerated = false;
  1441→  let permissionsSeeded = false;
  1442→  let memorySeeded = false;
  1443→
  1444→  try {
  1445→    const detected = detectAgent();
  1446→
  1447→    // Step 1: Agent detection
  1448→    steps.push({
  1449→      name: "Agent detection",
  1450→      status: "done",
  1451→      message: `${detected.type} (${detected.confidence} confidence)`,
  1452→    });
  1453→
  1454→    // Step 2: Install core skills
  1455→    // AC: @init-setup-integration ac-2 - core skills installed in .kspec/skills/
  1456→    const coreResult = await installCoreSkillsForSetup(projectDir, dryRun);
  1457→    coreSkillsInstalled = coreResult.installed;
  1458→
  1459→    if (coreResult.installed > 0 || coreResult.skipped > 0) {
  1460→      steps.push({
  1461→        name: "Install core skills",
  1462→        status: "done",
  1463→        message: `${coreResult.installed} installed, ${coreResult.skipped} skipped`,
  1464→      });
  1465→    } else {
  1466→      steps.push({
  1467→        name: "Install core skills",
  1468→        status: "skipped",
  1469→        message: "No core skills found in package",
  1470→      });
  1471→    }
  1472→
  1473→    // Step 3: Install hooks (Claude Code only)
  1474→    // AC: @init-setup-integration ac-3 - hooks present
  1475→    if (detected.type === "claude-code" && installHooksFlag) {
  1476→      const hooksResult = await installClaudeCodeHooks(projectDir, dryRun);
  1477→      const installedHooks: string[] = [];
  1478→      if (hooksResult.promptCheck) installedHooks.push("UserPromptSubmit");
  1479→      if (hooksResult.stop) installedHooks.push("Stop");
  1480→      if (hooksResult.preToolUse) installedHooks.push("PreToolUse");
  1481→
  1482→      hooksInstalled =
  1483→        hooksResult.promptCheck || hooksResult.stop || hooksResult.preToolUse;
  1484→
  1485→      steps.push({
  1486→        name: "Install hooks",
  1487→        status: "done",
  1488→        message: installedHooks.join(", "),
  1489→        details: {
  1490→          guards: hooksResult.guardsCreated,
  1491→        },
  1492→      });
  1493→    } else if (!installHooksFlag) {
  1494→      steps.push({
  1495→        name: "Install hooks",
  1496→        status: "skipped",
  1497→        message: "--no-hooks flag",
  1498→      });
  1499→    } else {
  1500→      steps.push({
  1501→        name: "Install hooks",
  1502→        status: "skipped",
  1503→        message: `not applicable for ${detected.type}`,
  1504→      });
  1505→    }
  1506→
  1507→    // Step 3a: Seed permissions (Claude Code only)
  1508→    // AC: @new-project-bootstrapping ac-1
  1509→    {
  1510→      const { seedPermissions } = await import("./setup-seeding.js");
  1511→      const permResult = await seedPermissions(projectDir, detected.type, {
  1512→        dryRun,
  1513→        force: options.force,
  1514→      });
  1515→      permissionsSeeded = permResult.seeded;
  1516→
  1517→      steps.push({
  1518→        name: "Seed permissions",
  1519→        status: permResult.seeded ? "done" : "skipped",
  1520→        message: permResult.message,
  1521→      });
  1522→    }
  1523→
  1524→    // Step 3b: Seed memory (platform-extensible)
  1525→    // AC: @new-project-bootstrapping ac-2
  1526→    {
  1527→      const { seedMemory } = await import("./setup-seeding.js");
  1528→      const memResult = await seedMemory(projectDir, detected.type, {
  1529→        dryRun,
  1530→        force: options.force,
  1531→      });
  1532→      memorySeeded = memResult.seeded;
  1533→
  1534→      steps.push({
  1535→        name: "Seed memory",
  1536→        status: memResult.seeded ? "done" : "skipped",
  1537→        message: memResult.seeded ? memResult.path : memResult.message,
  1538→      });
  1539→    }
  1540→
  1541→    // Step 4: Render skills
  1542→    // AC: @init-setup-integration ac-3 - rendered skill files present
  1543→    if (!skipSkills) {
  1544→      const skillsResult = await renderSkillsForSetup(projectDir, dryRun);
  1545→      skillsRendered = skillsResult.rendered;
  1546→
  1547→      if (skillsResult.rendered > 0 || skillsResult.skipped > 0) {
  1548→        steps.push({
  1549→          name: "Render skills",
  1550→          status: "done",
  1551→          message: `${skillsResult.rendered} rendered, ${skillsResult.skipped} unchanged`,
  1552→          details: {
  1553→            skillIds: skillsResult.skillIds,
  1554→          },
  1555→        });
  1556→      } else {
  1557→        steps.push({
  1558→          name: "Render skills",
  1559→          status: "skipped",
  1560→          message: "No claude-code skills in meta",
  1561→        });
  1562→      }
  1563→    } else {
  1564→      steps.push({
  1565→        name: "Render skills",
  1566→        status: "skipped",
  1567→        message: "--skip-skills flag",
  1568→      });
  1569→    }
  1570→
  1571→    // Step 5: Generate kspec-agents.md
  1572→    // AC: @init-setup-integration ac-3 - kspec-agents.md present
  1573→    const agentsResult = await generateAgentInstructions(projectDir, dryRun);
  1574→    agentsMdGenerated = agentsResult.success;
  1575→
  1576→    if (agentsResult.success) {
  1577→      steps.push({
  1578→        name: "Generate kspec-agents.md",
  1579→        status: "done",
  1580→        message: agentsResult.path,
  1581→      });
  1582→    } else {
  1583→      steps.push({
  1584→        name: "Generate kspec-agents.md",
  1585→        status: "failed",
  1586→        message: "No kspec project found",
  1587→      });
  1588→    }
  1589→
  1590→    // Step 6: Configure author (optional, used by setup command)
  1591→    if (options.configureAuthor) {
  1592→      const author = options.author || getDefaultAuthor(detected.type);
  1593→      if (!options.force && process.env.KSPEC_AUTHOR) {
  1594→        steps.push({
  1595→          name: "Configure author",
  1596→          status: "skipped",
  1597→          message: `KSPEC_AUTHOR already set to "${process.env.KSPEC_AUTHOR}"`,
  1598→        });
  1599→      } else {
  1600→        let authorInstalled = false;
  1601→        switch (detected.type) {
  1602→          case "claude-code":
  1603→            if (!dryRun) {
  1604→              authorInstalled = await installClaudeCodeConfig(author);
  1605→            } else {
  1606→              authorInstalled = true;
  1607→            }
  1608→            break;
  1609→          case "aider":
  1610→            if (!dryRun) {
  1611→              authorInstalled = await installAiderConfig(author);
  1612→            } else {
  1613→              authorInstalled = true;
  1614→            }
  1615→            break;
  1616→          default:
  1617→            break;
  1618→        }
  1619→
  1620→        if (authorInstalled) {
  1621→          steps.push({
  1622→            name: "Configure author",
  1623→            status: "done",
  1624→            message: `KSPEC_AUTHOR="${author}"`,
  1625→          });
  1626→        }
  1627→      }
  1628→    }
  1629→
  1630→    // Output summary
  1631→    if (!dryRun) {
  1632→      console.log(chalk.bold("kspec Setup Summary\n"));
  1633→
  1634→      for (const step of steps) {
  1635→        const icon =
  1636→          step.status === "done"
  1637→            ? chalk.green("✓")
  1638→            : step.status === "skipped"
  1639→              ? chalk.gray("○")
  1640→              : chalk.red("✗");
  1641→        const statusText =
  1642→          step.status === "done"
  1643→            ? ""
  1644→            : step.status === "skipped"
  1645→              ? chalk.gray(" (skipped)")
  1646→              : chalk.red(" (failed)");
  1647→
  1648→        console.log(`${icon} ${step.name}${statusText}`);
  1649→        if (step.message) {
  1650→          console.log(chalk.gray(`  ${step.message}`));
  1651→        }
  1652→      }
  1653→    }
  1654→
  1655→    const success = steps.every((s) => s.status !== "failed");
  1656→
  1657→    return {
  1658→      success,
  1659→      steps,
  1660→      coreSkillsInstalled,
  1661→      skillsRendered,
  1662→      hooksInstalled,
  1663→      agentsMdGenerated,
  1664→      permissionsSeeded,
  1665→      memorySeeded,
  1666→    };
  1667→  } catch (err) {
  1668→    debugLog("runSetupPipeline failed", err);
  1669→    return {
  1670→      success: false,
  1671→      steps,
  1672→      coreSkillsInstalled,
  1673→      skillsRendered,
  1674→      hooksInstalled,
  1675→      agentsMdGenerated,
  1676→      permissionsSeeded,
  1677→      memorySeeded,
  1678→    };
  1679→  }
  1680→}
  1681→
  1682→/**
  1683→ * Register the 'setup' command
  1684→ * AC: @enhanced-setup ac-1 through ac-9
  1685→ */
  1686→export function registerSetupCommand(program: Command): void {
  1687→  program
  1688→    .command("setup")
  1689→    .description("Configure agent environment for kspec (orchestrated pipeline)")
  1690→    .option("--dry-run", "Show what would be done without making changes")
  1691→    .option(
  1692→      "--author <author>",
  1693→      "Custom author string (default: auto-detected based on agent)",
  1694→    )
  1695→    .option("--no-hooks", "Skip installing hooks")
  1696→    .option("--skip-skills", "Skip rendering skills")
  1697→    .option("--status", "Report current setup state without making changes")
  1698→    .option("--force", "Overwrite existing configuration")
  1699→    .option(
  1700→      "--auto-worktree",
  1701→      "Automatically create .kspec worktree if kspec-meta branch exists",
  1702→    )
  1703→    .action(async (options) => {
  1704→      try {
  1705→        const projectDir = process.cwd();
  1706→
  1707→        // AC: @enhanced-setup ac-7, ac-8 - --status mode
  1708→        if (options.status) {
  1709→          const status = await getSetupStatus(projectDir);
  1710→
  1711→          output(status, () => {
  1712→            console.log(chalk.bold("kspec Setup Status\n"));
  1713→
  1714→            // Agent detection
  1715→            console.log(chalk.gray("Agent:"));
  1716→            console.log(
  1717→              `  Detected: ${status.agent.detected} (${status.agent.confidence} confidence)`,
  1718→            );
  1719→            console.log();
  1720→
  1721→            // Hooks status
  1722→            console.log(chalk.gray("Hooks:"));
  1723→            console.log(
  1724→              `  UserPromptSubmit: ${status.hooks.promptCheck ? chalk.green("✓") : chalk.red("✗")}`,
  1725→            );
  1726→            console.log(
  1727→              `  Stop:             ${status.hooks.stop ? chalk.green("✓") : chalk.red("✗")}`,
  1728→            );
  1729→            console.log(
  1730→              `  PreToolUse:       ${status.hooks.preToolUse ? chalk.green("✓") : chalk.red("✗")}`,
  1731→            );
  1732→            if (status.hooks.guardsPresent.length > 0) {
  1733→              console.log(
  1734→                `  Guards:           ${status.hooks.guardsPresent.join(", ")}`,
  1735→              );
  1736→            }
  1737→            console.log();
  1738→
  1739→            // Skills status
  1740→            console.log(chalk.gray("Skills:"));
  1741→            console.log(`  Rendered: ${status.skills.rendered}`);
  1742→            if (status.skills.drifted > 0) {
  1743→              console.log(
  1744→                `  Drifted:  ${chalk.yellow(status.skills.drifted.toString())}`,
  1745→              );
  1746→            }
  1747→            console.log();
  1748→
  1749→            // Agents.md status
  1750→            console.log(chalk.gray("kspec-agents.md:"));
  1751→            if (status.agentsMd.exists) {
  1752→              const statusColor =
  1753→                status.agentsMd.status === "current"
  1754→                  ? chalk.green
  1755→                  : chalk.yellow;
  1756→              console.log(`  Status: ${statusColor(status.agentsMd.status)}`);
  1757→              if (status.agentsMd.generatedAt) {
  1758→                console.log(`  Generated: ${status.agentsMd.generatedAt}`);
  1759→              }
  1760→            } else {
  1761→              console.log(`  Status: ${chalk.red("missing")}`);
  1762→              console.log(
  1763→                chalk.gray("  Run 'kspec setup' to generate"),
  1764→              );
  1765→            }
  1766→            console.log();
  1767→
  1768→            // Seeding status
  1769→            console.log(chalk.gray("Seeding:"));
  1770→            console.log(
  1771→              `  Permissions: ${status.seeding.permissionsSeeded ? chalk.green("✓") : chalk.gray("○")}`,
  1772→            );
  1773→            console.log(
  1774→              `  Memory:      ${status.seeding.memorySeeded ? chalk.green("✓") : chalk.gray("○")}`,
  1775→            );
  1776→            if (status.seeding.memoryPath) {
  1777→              console.log(
  1778→                chalk.gray(`  Path: ${status.seeding.memoryPath}`),
  1779→              );
  1780→            }
  1781→          });
  1782→          return;
  1783→        }
  1784→
  1785→        // AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
  1786→        const worktreeReady = await ensureWorktree(
  1787→          options.autoWorktree || false,
  1788→        );
  1789→        if (!worktreeReady) {
  1790→          // User declined worktree creation or it failed
  1791→          process.exit(EXIT_CODES.ERROR);
  1792→        }
  1793→
  1794→        const detected = detectAgent();
  1795→        const dryRun = options.dryRun || false;
  1796→
  1797→        if (detected.type === "unknown") {
  1798→          warn("Could not auto-detect agent environment");
  1799→          printManualInstructions("unknown");
  1800→          return;
  1801→        }
  1802→
  1803→        // AC: @setup-pipeline-unification ac-3 - delegate to runSetupPipeline()
  1804→        // One code path for both 'kspec setup' and 'kspec init --setup'
  1805→        const result = await runSetupPipeline(projectDir, {
  1806→          dryRun,
  1807→          skipSkills: options.skipSkills || false,
  1808→          installHooks: options.hooks !== false,
  1809→          force: options.force || false,
  1810→          author: options.author,
  1811→          configureAuthor: true,
  1812→        });
  1813→
  1814→        // AC: @enhanced-setup ac-1 - Display summary
  1815→        // AC: @enhanced-setup ac-6 - dry-run displays planned actions
  1816→        output(
  1817→          {
  1818→            dry_run: dryRun,
  1819→            steps: result.steps.map((s) => ({
  1820→              name: s.name,
  1821→              status: s.status,
  1822→              message: s.message,
  1823→              details: s.details,
  1824→            })),
  1825→          },
  1826→          () => {
  1827→            if (dryRun) {
  1828→              console.log(chalk.yellow("DRY RUN - No changes made\n"));
  1829→            }
  1830→
  1831→            // Pipeline already prints the summary when not dry-run
  1832→            // For dry-run, print it here since the pipeline skips output
  1833→            if (dryRun) {
  1834→              console.log(chalk.bold("kspec Setup Summary\n"));
  1835→
  1836→              for (const step of result.steps) {
  1837→                const icon =
  1838→                  step.status === "done"
  1839→                    ? chalk.green("✓")
  1840→                    : step.status === "skipped"
  1841→                      ? chalk.gray("○")
  1842→                      : chalk.red("✗");
  1843→                const statusText =
  1844→                  step.status === "done"
  1845→                    ? ""
  1846→                    : step.status === "skipped"
  1847→                      ? chalk.gray(" (skipped)")
  1848→                      : chalk.red(" (failed)");
  1849→
  1850→                console.log(`${icon} ${step.name}${statusText}`);
  1851→                if (step.message) {
  1852→                  console.log(chalk.gray(`  ${step.message}`));
  1853→                }
  1854→              }
  1855→            }
  1856→
  1857→            console.log();
  1858→
  1859→            if (dryRun) {
  1860→              console.log(
  1861→                chalk.yellow("Run without --dry-run to apply changes."),
  1862→              );
  1863→            } else {
  1864→              console.log(
  1865→                chalk.green("Setup complete."),
  1866→              );
  1867→              console.log(
  1868→                chalk.gray("Restart your agent session for changes to take effect."),
  1869→              );
  1870→            }
  1871→          },
  1872→        );
  1873→      } catch (err) {
  1874→        error(errors.failures.setupFailed, err);
  1875→        process.exit(EXIT_CODES.ERROR);
  1876→      }
  1877→    });
  1878→}
  1879→

