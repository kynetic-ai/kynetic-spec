     1→/**
     2→ * Meta manifest loading and operations.
     3→ *
     4→ * The meta manifest (kynetic.meta.yaml) contains process definitions:
     5→ * - Agents: roles, capabilities, conventions
     6→ * - Workflows: structured processes with steps
     7→ * - Conventions: project rules and standards
     8→ * - Observations: feedback about processes
     9→ */
    10→
    11→import * as fs from "node:fs/promises";
    12→import * as path from "node:path";
    13→import { ulid } from "ulid";
    14→import {
    15→  type Agent,
    16→  AgentSchema,
    17→  type Convention,
    18→  ConventionSchema,
    19→  getMetaItemType,
    20→  isSkill,
    21→  type MetaItem,
    22→  type MetaManifest,
    23→  MetaManifestSchema,
    24→  type Observation,
    25→  ObservationSchema,
    26→  type ObservationType,
    27→  type SessionContext,
    28→  SessionContextSchema,
    29→  type Skill,
    30→  SkillSchema,
    31→  type Workflow,
    32→  type WorkflowRun,
    33→  type WorkflowRunsFile,
    34→  WorkflowRunsFileSchema,
    35→  WorkflowSchema,
    36→} from "../schema/index.js";
    37→import type { KspecContext } from "./yaml.js";
    38→import {
    39→  expandIncludePattern,
    40→  getAuthor,
    41→  readYamlFile,
    42→  writeYamlFilePreserveFormat,
    43→} from "./yaml.js";
    44→
    45→/**
    46→ * Loaded agent with runtime metadata
    47→ */
    48→export interface LoadedAgent extends Agent {
    49→  _sourceFile?: string;
    50→}
    51→
    52→/**
    53→ * Loaded workflow with runtime metadata
    54→ */
    55→export interface LoadedWorkflow extends Workflow {
    56→  _sourceFile?: string;
    57→}
    58→
    59→/**
    60→ * Loaded convention with runtime metadata
    61→ */
    62→export interface LoadedConvention extends Convention {
    63→  _sourceFile?: string;
    64→}
    65→
    66→/**
    67→ * Loaded observation with runtime metadata
    68→ */
    69→export interface LoadedObservation extends Observation {
    70→  _sourceFile?: string;
    71→}
    72→
    73→/**
    74→ * Loaded skill with runtime metadata
    75→ */
    76→export interface LoadedSkill extends Skill {
    77→  _sourceFile?: string;
    78→}
    79→
    80→/**
    81→ * Any loaded meta item
    82→ */
    83→export type LoadedMetaItem =
    84→  | LoadedAgent
    85→  | LoadedWorkflow
    86→  | LoadedConvention
    87→  | LoadedObservation
    88→  | LoadedSkill;
    89→
    90→/**
    91→ * Meta context containing all loaded meta items
    92→ */
    93→export interface MetaContext {
    94→  manifest: MetaManifest | null;
    95→  manifestPath: string | null;
    96→  agents: LoadedAgent[];
    97→  workflows: LoadedWorkflow[];
    98→  conventions: LoadedConvention[];
    99→  observations: LoadedObservation[];
   100→  skills: LoadedSkill[];
   101→}
   102→
   103→/**
   104→ * Find the meta manifest file.
   105→ *
   106→ * Discovery algorithm:
   107→ * 1. Check for explicit name: kynetic.meta.yaml (backward compat)
   108→ * 2. If not found, scan directory for *.meta.yaml files
   109→ * 3. For each candidate, validate it contains a 'kynetic_meta:' version field
   110→ * 4. Return first valid match (alphabetically after explicit name)
   111→ *
   112→ * AC: @meta-manifest-discovery ac-1, ac-2, ac-3
   113→ */
   114→export async function findMetaManifest(
   115→  specDir: string,
   116→): Promise<string | null> {
   117→  // AC: @meta-manifest-discovery ac-1, ac-3 - explicit name has priority
   118→  const priorityPath = path.join(specDir, "kynetic.meta.yaml");
   119→  try {
   120→    await fs.access(priorityPath);
   121→    return priorityPath;
   122→  } catch {
   123→    // Continue to glob fallback
   124→  }
   125→
   126→  // AC: @meta-manifest-discovery ac-2, ac-3 - glob fallback with validation
   127→  try {
   128→    const entries = await fs.readdir(specDir);
   129→    // AC: @meta-manifest-discovery ac-3 - alphabetical order
   130→    const candidates = entries
   131→      .filter((f) => f.endsWith(".meta.yaml"))
   132→      .sort();
   133→
   134→    for (const candidate of candidates) {
   135→      const filePath = path.join(specDir, candidate);
   136→      try {
   137→        const raw = await readYamlFile<unknown>(filePath);
   138→        // AC: @meta-manifest-discovery ac-2 - validate kynetic_meta version field
   139→        if (raw && typeof raw === "object" && "kynetic_meta" in raw) {
   140→          return filePath;
   141→        }
   142→      } catch {
   143→        // Skip invalid files
   144→      }
   145→    }
   146→  } catch {
   147→    // Directory read failed
   148→  }
   149→
   150→  return null;
   151→}
   152→
   153→/**
   154→ * Get the base name (slug) from a manifest path.
   155→ * E.g., "kynetic.yaml" -> "kynetic", "myproject.spec.yaml" -> "myproject"
   156→ */
   157→function getManifestBaseName(manifestPath: string | null): string {
   158→  if (!manifestPath) return "kynetic";
   159→  const fileName = path.basename(manifestPath);
   160→  // Remove .yaml extension
   161→  let baseName = fileName.replace(/\.yaml$/, "");
   162→  // Remove .spec suffix if present
   163→  baseName = baseName.replace(/\.spec$/, "");
   164→  return baseName || "kynetic";
   165→}
   166→
   167→/**
   168→ * Get the meta manifest file path.
   169→ * Derives from main manifest name (e.g., myproject.yaml -> myproject.meta.yaml)
   170→ * Returns path even if file doesn't exist yet.
   171→ */
   172→export function getMetaManifestPath(ctx: KspecContext): string {
   173→  const baseName = getManifestBaseName(ctx.manifestPath);
   174→  return path.join(ctx.specDir, `${baseName}.meta.yaml`);
   175→}
   176→
   177→/**
   178→ * Load meta items from a single file.
   179→ */
   180→async function loadMetaFile(filePath: string): Promise<{
   181→  agents: LoadedAgent[];
   182→  workflows: LoadedWorkflow[];
   183→  conventions: LoadedConvention[];
   184→  observations: LoadedObservation[];
   185→  skills: LoadedSkill[];
   186→}> {
   187→  const result: {
   188→    agents: LoadedAgent[];
   189→    workflows: LoadedWorkflow[];
   190→    conventions: LoadedConvention[];
   191→    observations: LoadedObservation[];
   192→    skills: LoadedSkill[];
   193→  } = {
   194→    agents: [],
   195→    workflows: [],
   196→    conventions: [],
   197→    observations: [],
   198→    skills: [],
   199→  };
   200→
   201→  try {
   202→    const raw = await readYamlFile<unknown>(filePath);
   203→    if (!raw || typeof raw !== "object") {
   204→      return result;
   205→    }
   206→
   207→    const obj = raw as Record<string, unknown>;
   208→
   209→    // Parse agents
   210→    if (Array.isArray(obj.agents)) {
   211→      for (const agent of obj.agents) {
   212→        const parsed = AgentSchema.safeParse(agent);
   213→        if (parsed.success) {
   214→          result.agents.push({ ...parsed.data, _sourceFile: filePath });
   215→        }
   216→      }
   217→    }
   218→
   219→    // Parse workflows
   220→    if (Array.isArray(obj.workflows)) {
   221→      for (const workflow of obj.workflows) {
   222→        const parsed = WorkflowSchema.safeParse(workflow);
   223→        if (parsed.success) {
   224→          result.workflows.push({ ...parsed.data, _sourceFile: filePath });
   225→        }
   226→      }
   227→    }
   228→
   229→    // Parse conventions
   230→    if (Array.isArray(obj.conventions)) {
   231→      for (const convention of obj.conventions) {
   232→        const parsed = ConventionSchema.safeParse(convention);
   233→        if (parsed.success) {
   234→          result.conventions.push({ ...parsed.data, _sourceFile: filePath });
   235→        }
   236→      }
   237→    }
   238→
   239→    // Parse observations
   240→    if (Array.isArray(obj.observations)) {
   241→      for (const observation of obj.observations) {
   242→        const parsed = ObservationSchema.safeParse(observation);
   243→        if (parsed.success) {
   244→          result.observations.push({ ...parsed.data, _sourceFile: filePath });
   245→        }
   246→      }
   247→    }
   248→
   249→    // Parse skills
   250→    // AC: @skill-meta-type ac-4 - skills loaded with _sourceFile set
   251→    if (Array.isArray(obj.skills)) {
   252→      for (const skill of obj.skills) {
   253→        const parsed = SkillSchema.safeParse(skill);
   254→        if (parsed.success) {
   255→          result.skills.push({ ...parsed.data, _sourceFile: filePath });
   256→        }
   257→      }
   258→    }
   259→  } catch {
   260→    // File doesn't exist or parse error
   261→  }
   262→
   263→  return result;
   264→}
   265→
   266→/**
   267→ * Load the meta context from a kspec context.
   268→ * Loads meta manifest and follows includes.
   269→ * AC: @skill-meta-type ac-4 - MetaContext.skills contains LoadedSkill objects with _sourceFile set
   270→ */
   271→export async function loadMetaContext(ctx: KspecContext): Promise<MetaContext> {
   272→  const result: MetaContext = {
   273→    manifest: null,
   274→    manifestPath: null,
   275→    agents: [],
   276→    workflows: [],
   277→    conventions: [],
   278→    observations: [],
   279→    skills: [],
   280→  };
   281→
   282→  const manifestPath = await findMetaManifest(ctx.specDir);
   283→  if (!manifestPath) {
   284→    return result;
   285→  }
   286→
   287→  result.manifestPath = manifestPath;
   288→
   289→  try {
   290→    const raw = await readYamlFile<unknown>(manifestPath);
   291→    const parsed = MetaManifestSchema.safeParse(raw);
   292→    if (!parsed.success) {
   293→      // Invalid manifest, but we can still try to extract items
   294→      const items = await loadMetaFile(manifestPath);
   295→      result.agents.push(...items.agents);
   296→      result.workflows.push(...items.workflows);
   297→      result.conventions.push(...items.conventions);
   298→      result.observations.push(...items.observations);
   299→      result.skills.push(...items.skills);
   300→      return result;
   301→    }
   302→
   303→    result.manifest = parsed.data;
   304→
   305→    // Load items from manifest
   306→    const manifestItems = await loadMetaFile(manifestPath);
   307→    result.agents.push(...manifestItems.agents);
   308→    result.workflows.push(...manifestItems.workflows);
   309→    result.conventions.push(...manifestItems.conventions);
   310→    result.observations.push(...manifestItems.observations);
   311→    result.skills.push(...manifestItems.skills);
   312→
   313→    // Process includes
   314→    const includes = parsed.data.includes || [];
   315→    const manifestDir = path.dirname(manifestPath);
   316→
   317→    for (const include of includes) {
   318→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   319→
   320→      for (const filePath of expandedPaths) {
   321→        const items = await loadMetaFile(filePath);
   322→        result.agents.push(...items.agents);
   323→        result.workflows.push(...items.workflows);
   324→        result.conventions.push(...items.conventions);
   325→        result.observations.push(...items.observations);
   326→        result.skills.push(...items.skills);
   327→      }
   328→    }
   329→  } catch {
   330→    // Manifest exists but may be invalid
   331→  }
   332→
   333→  return result;
   334→}
   335→
   336→/**
   337→ * Get meta stats summary
   338→ */
   339→export function getMetaStats(meta: MetaContext): {
   340→  agents: number;
   341→  workflows: number;
   342→  conventions: number;
   343→  observations: number;
   344→  unresolvedObservations: number;
   345→  skills: number;
   346→} {
   347→  return {
   348→    agents: meta.agents.length,
   349→    workflows: meta.workflows.length,
   350→    conventions: meta.conventions.length,
   351→    observations: meta.observations.length,
   352→    unresolvedObservations: meta.observations.filter((o) => !o.resolved).length,
   353→    skills: meta.skills.length,
   354→  };
   355→}
   356→
   357→/**
   358→ * Find a meta item by reference (ULID, short ULID, or id)
   359→ * AC: @skill-meta-type ac-5 - skills returned by semantic id lookup
   360→ * AC: @skill-meta-type ac-6 - skills returned by ULID prefix lookup
   361→ */
   362→export function findMetaItemByRef(
   363→  meta: MetaContext,
   364→  ref: string,
   365→): LoadedMetaItem | undefined {
   366→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
   367→
   368→  // Search all item types
   369→  const allItems: LoadedMetaItem[] = [
   370→    ...meta.agents,
   371→    ...meta.workflows,
   372→    ...meta.conventions,
   373→    ...meta.observations,
   374→    ...meta.skills,
   375→  ];
   376→
   377→  for (const item of allItems) {
   378→    // Match full ULID
   379→    if (item._ulid === cleanRef) return item;
   380→
   381→    // Match short ULID (prefix)
   382→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
   383→      return item;
   384→
   385→    // Match by id (for agents, workflows, and skills)
   386→    if ("id" in item && item.id === cleanRef) return item;
   387→
   388→    // Match by domain (for conventions)
   389→    if ("domain" in item && item.domain === cleanRef) return item;
   390→  }
   391→
   392→  return undefined;
   393→}
   394→
   395→/**
   396→ * Determine if an item is a meta item type
   397→ */
   398→export function isMetaItemType(type: string): boolean {
   399→  return ["agent", "workflow", "convention", "observation", "skill"].includes(
   400→    type,
   401→  );
   402→}
   403→
   404→// ============================================================
   405→// META ITEM CRUD
   406→// ============================================================
   407→
   408→/**
   409→ * Save the entire meta manifest to file
   410→ */
   411→async function saveMetaManifest(
   412→  manifestPath: string,
   413→  manifest: MetaManifest,
   414→): Promise<void> {
   415→  await writeYamlFilePreserveFormat(manifestPath, manifest);
   416→}
   417→
   418→/**
   419→ * Strip runtime metadata before serialization
   420→ */
   421→function stripMetaMetadata<T extends LoadedMetaItem>(
   422→  item: T,
   423→): Omit<T, "_sourceFile"> {
   424→  const { _sourceFile, ...cleanItem } = item;
   425→  return cleanItem as Omit<T, "_sourceFile">;
   426→}
   427→
   428→/**
   429→ * Create a new observation
   430→ */
   431→export function createObservation(
   432→  type: ObservationType,
   433→  content: string,
   434→  options: {
   435→    workflow_ref?: string;
   436→    author?: string;
   437→  } = {},
   438→): Observation {
   439→  return {
   440→    _ulid: ulid(),
   441→    type,
   442→    content,
   443→    workflow_ref: options.workflow_ref,
   444→    created_at: new Date().toISOString(),
   445→    author: options.author ?? getAuthor(),
   446→    resolved: false,
   447→    resolution: null,
   448→  };
   449→}
   450→
   451→/**
   452→ * Save an observation to the meta manifest
   453→ */
   454→export async function saveObservation(
   455→  ctx: KspecContext,
   456→  observation: LoadedObservation,
   457→): Promise<void> {
   458→  const manifestPath = getMetaManifestPath(ctx);
   459→
   460→  // Ensure directory exists
   461→  const dir = path.dirname(manifestPath);
   462→  await fs.mkdir(dir, { recursive: true });
   463→
   464→  // Load existing manifest
   465→  let manifest: MetaManifest = {
   466→    kynetic_meta: "1.0",
   467→    agents: [],
   468→    workflows: [],
   469→    conventions: [],
   470→    observations: [],
   471→    skills: [],
   472→    includes: [],
   473→  };
   474→
   475→  try {
   476→    const raw = await readYamlFile<unknown>(manifestPath);
   477→    const parsed = MetaManifestSchema.safeParse(raw);
   478→    if (parsed.success) {
   479→      manifest = parsed.data;
   480→    }
   481→  } catch {
   482→    // File doesn't exist, use defaults
   483→  }
   484→
   485→  // Strip runtime metadata
   486→  const cleanObs = stripMetaMetadata(observation);
   487→
   488→  // Update or add
   489→  const existingIndex = manifest.observations.findIndex(
   490→    (o) => o._ulid === observation._ulid,
   491→  );
   492→  if (existingIndex >= 0) {
   493→    manifest.observations[existingIndex] = cleanObs as Observation;
   494→  } else {
   495→    manifest.observations.push(cleanObs as Observation);
   496→  }
   497→
   498→  await saveMetaManifest(manifestPath, manifest);
   499→}
   500→
   501→/**
   502→ * Delete an observation from the meta manifest
   503→ */
   504→export async function deleteObservation(
   505→  ctx: KspecContext,
   506→  ulid: string,
   507→): Promise<boolean> {
   508→  const manifestPath = getMetaManifestPath(ctx);
   509→
   510→  try {
   511→    const raw = await readYamlFile<unknown>(manifestPath);
   512→    const parsed = MetaManifestSchema.safeParse(raw);
   513→    if (!parsed.success) {
   514→      return false;
   515→    }
   516→
   517→    const manifest = parsed.data;
   518→    const index = manifest.observations.findIndex((o) => o._ulid === ulid);
   519→    if (index < 0) {
   520→      return false;
   521→    }
   522→
   523→    manifest.observations.splice(index, 1);
   524→    await saveMetaManifest(manifestPath, manifest);
   525→    return true;
   526→  } catch {
   527→    return false;
   528→  }
   529→}
   530→
   531→/**
   532→ * Get the path for skill content file.
   533→ * Skills are stored in .kspec/skills/<id>/SKILL.md
   534→ */
   535→export function getSkillContentPath(ctx: KspecContext, skillId: string): string {
   536→  return path.join(ctx.specDir, "skills", skillId, "SKILL.md");
   537→}
   538→
   539→/**
   540→ * Load skill content from the SKILL.md file.
   541→ * AC: @skill-meta-type ac-3 - loadSkillContent returns full markdown content
   542→ * AC: @skill-content-model ac-1 - loadSkillContent returns markdown content as a string
   543→ */
   544→export async function loadSkillContent(
   545→  ctx: KspecContext,
   546→  skill: LoadedSkill,
   547→): Promise<string | null> {
   548→  const contentPath = getSkillContentPath(ctx, skill.id);
   549→  try {
   550→    const content = await fs.readFile(contentPath, "utf-8");
   551→    return content;
   552→  } catch {
   553→    return null;
   554→  }
   555→}
   556→
   557→/**
   558→ * Skill doc object returned by loadSkillDocs.
   559→ * AC: @skill-content-model ac-2
   560→ */
   561→export interface SkillDoc {
   562→  /** File name (e.g., "quickref.md") */
   563→  name: string;
   564→  /** Full file path */
   565→  path: string;
   566→  /** File content */
   567→  content: string;
   568→}
   569→
   570→/**
   571→ * Supported skill supporting directory types.
   572→ * AC: @supporting-files-convention ac-1
   573→ */
   574→export type SupportingDirType = "references" | "scripts" | "assets" | "docs";
   575→
   576→/**
   577→ * A file from a skill's supporting directory.
   578→ * AC: @supporting-files-convention ac-1
   579→ */
   580→export interface SupportingFile {
   581→  /** File name (e.g., "api.md", "helper.sh") */
   582→  name: string;
   583→  /** Full file path */
   584→  path: string;
   585→  /** File content (for text files) */
   586→  content: string;
   587→  /** Supporting directory type */
   588→  dirType: SupportingDirType;
   589→}
   590→
   591→/**
   592→ * Get the docs directory path for a skill.
   593→ * Skills can have supporting docs at .kspec/skills/<id>/docs/
   594→ */
   595→export function getSkillDocsPath(ctx: KspecContext, skillId: string): string {
   596→  return path.join(ctx.specDir, "skills", skillId, "docs");
   597→}
   598→
   599→/**
   600→ * Load skill documentation files from the docs/ subdirectory.
   601→ * AC: @skill-content-model ac-2 - loadSkillDocs returns array of doc objects
   602→ */
   603→export async function loadSkillDocs(
   604→  ctx: KspecContext,
   605→  skill: LoadedSkill,
   606→): Promise<SkillDoc[]> {
   607→  const docsPath = getSkillDocsPath(ctx, skill.id);
   608→  const docs: SkillDoc[] = [];
   609→
   610→  try {
   611→    const entries = await fs.readdir(docsPath, { withFileTypes: true });
   612→
   613→    for (const entry of entries) {
   614→      if (entry.isFile() && entry.name.endsWith(".md")) {
   615→        const filePath = path.join(docsPath, entry.name);
   616→        try {
   617→          const content = await fs.readFile(filePath, "utf-8");
   618→          docs.push({
   619→            name: entry.name,
   620→            path: filePath,
   621→            content,
   622→          });
   623→        } catch {
   624→          // Skip files that can't be read
   625→        }
   626→      }
   627→    }
   628→  } catch {
   629→    // docs directory doesn't exist or can't be read
   630→  }
   631→
   632→  return docs;
   633→}
   634→
   635→/**
   636→ * Get the path to a supporting directory for a skill.
   637→ * AC: @supporting-files-convention ac-1
   638→ */
   639→export function getSkillSupportingDirPath(
   640→  ctx: KspecContext,
   641→  skillId: string,
   642→  dirType: SupportingDirType
   643→): string {
   644→  return path.join(ctx.specDir, "skills", skillId, dirType);
   645→}
   646→
   647→/**
   648→ * Load files from a skill's supporting directory.
   649→ * AC: @supporting-files-convention ac-1 - references files are accessible
   650→ *
   651→ * @param ctx - Kspec context
   652→ * @param skill - The skill to load files from
   653→ * @param dirType - The supporting directory type (references, scripts, assets, docs)
   654→ * @returns Array of files found in the directory
   655→ */
   656→export async function loadSkillSupportingFiles(
   657→  ctx: KspecContext,
   658→  skill: LoadedSkill,
   659→  dirType: SupportingDirType
   660→): Promise<SupportingFile[]> {
   661→  const dirPath = getSkillSupportingDirPath(ctx, skill.id, dirType);
   662→  const files: SupportingFile[] = [];
   663→
   664→  try {
   665→    const entries = await fs.readdir(dirPath, { withFileTypes: true });
   666→
   667→    for (const entry of entries) {
   668→      if (entry.isFile()) {
   669→        const filePath = path.join(dirPath, entry.name);
   670→        try {
   671→          const content = await fs.readFile(filePath, "utf-8");
   672→          files.push({
   673→            name: entry.name,
   674→            path: filePath,
   675→            content,
   676→            dirType,
   677→          });
   678→        } catch {
   679→          // Skip files that can't be read (e.g., binary files)
   680→        }
   681→      }
   682→    }
   683→  } catch {
   684→    // Directory doesn't exist or can't be read - return empty array
   685→  }
   686→
   687→  return files;
   688→}
   689→
   690→/**
   691→ * List which supporting directories exist for a skill.
   692→ * AC: @supporting-files-convention ac-1
   693→ *
   694→ * @returns Array of directory types that exist for the skill
   695→ */
   696→export async function listSkillSupportingDirs(
   697→  ctx: KspecContext,
   698→  skillId: string
   699→): Promise<SupportingDirType[]> {
   700→  const dirs: SupportingDirType[] = [];
   701→  const allDirs: SupportingDirType[] = ["references", "scripts", "assets", "docs"];
   702→
   703→  for (const dirType of allDirs) {
   704→    const dirPath = getSkillSupportingDirPath(ctx, skillId, dirType);
   705→    try {
   706→      const stat = await fs.stat(dirPath);
   707→      if (stat.isDirectory()) {
   708→        dirs.push(dirType);
   709→      }
   710→    } catch {
   711→      // Directory doesn't exist
   712→    }
   713→  }
   714→
   715→  return dirs;
   716→}
   717→
   718→// Re-export the getMetaItemType and isSkill functions
   719→export { getMetaItemType, isSkill };
   720→export type { Agent, Workflow, Convention, Observation, Skill, MetaItem };
   721→
   722→// ============================================================
   723→// GENERIC META ITEM CRUD
   724→// ============================================================
   725→
   726→/**
   727→ * Save any meta item (agent, workflow, convention, skill) to the manifest
   728→ * AC: @skill-parser ac-1 - skill is appended to manifest.skills and written to disk
   729→ * AC: @skill-parser ac-2 - .kspec/skills/<id>/ directory is created for skills
   730→ */
   731→export async function saveMetaItem(
   732→  ctx: KspecContext,
   733→  item: LoadedMetaItem,
   734→  itemType: "agent" | "workflow" | "convention" | "skill",
   735→): Promise<void> {
   736→  const manifestPath = getMetaManifestPath(ctx);
   737→
   738→  // Ensure directory exists
   739→  const dir = path.dirname(manifestPath);
   740→  await fs.mkdir(dir, { recursive: true });
   741→
   742→  // Load existing manifest
   743→  let manifest: MetaManifest = {
   744→    kynetic_meta: "1.0",
   745→    agents: [],
   746→    workflows: [],
   747→    conventions: [],
   748→    observations: [],
   749→    skills: [],
   750→    includes: [],
   751→  };
   752→
   753→  try {
   754→    const raw = await readYamlFile<unknown>(manifestPath);
   755→    const parsed = MetaManifestSchema.safeParse(raw);
   756→    if (parsed.success) {
   757→      manifest = parsed.data;
   758→    }
   759→  } catch {
   760→    // File doesn't exist, use defaults
   761→  }
   762→
   763→  // Strip runtime metadata
   764→  const cleanItem = stripMetaMetadata(item);
   765→
   766→  // Get the appropriate array
   767→  const getArray = () => {
   768→    switch (itemType) {
   769→      case "agent":
   770→        return manifest.agents;
   771→      case "workflow":
   772→        return manifest.workflows;
   773→      case "convention":
   774→        return manifest.conventions;
   775→      case "skill":
   776→        return manifest.skills;
   777→    }
   778→  };
   779→
   780→  const array = getArray();
   781→
   782→  // Update or add
   783→  const existingIndex = array.findIndex((i) => i._ulid === item._ulid);
   784→  if (existingIndex >= 0) {
   785→    (array as unknown[])[existingIndex] = cleanItem;
   786→  } else {
   787→    (array as unknown[]).push(cleanItem);
   788→  }
   789→
   790→  await saveMetaManifest(manifestPath, manifest);
   791→
   792→  // AC: @skill-parser ac-2 - Create skill content directory
   793→  if (itemType === "skill" && "id" in item) {
   794→    const skillDir = path.join(ctx.specDir, "skills", item.id);
   795→    await fs.mkdir(skillDir, { recursive: true });
   796→  }
   797→}
   798→
   799→/**
   800→ * Delete any meta item from the manifest
   801→ * AC: @skill-parser ac-3 - skill is removed from manifest.skills
   802→ * AC: @skill-parser ac-4 - .kspec/skills/<id>/ directory is deleted for skills
   803→ */
   804→export async function deleteMetaItem(
   805→  ctx: KspecContext,
   806→  itemUlid: string,
   807→  itemType: "agent" | "workflow" | "convention" | "observation" | "skill",
   808→): Promise<boolean> {
   809→  const manifestPath = getMetaManifestPath(ctx);
   810→
   811→  try {
   812→    const raw = await readYamlFile<unknown>(manifestPath);
   813→    const parsed = MetaManifestSchema.safeParse(raw);
   814→    if (!parsed.success) {
   815→      return false;
   816→    }
   817→
   818→    const manifest = parsed.data;
   819→
   820→    const getArray = () => {
   821→      switch (itemType) {
   822→        case "agent":
   823→          return manifest.agents;
   824→        case "workflow":
   825→          return manifest.workflows;
   826→        case "convention":
   827→          return manifest.conventions;
   828→        case "observation":
   829→          return manifest.observations;
   830→        case "skill":
   831→          return manifest.skills;
   832→      }
   833→    };
   834→
   835→    const array = getArray();
   836→    const index = array.findIndex((i) => i._ulid === itemUlid);
   837→    if (index < 0) {
   838→      return false;
   839→    }
   840→
   841→    // AC: @skill-parser ac-4 - Delete skill directory before removing from manifest
   842→    if (itemType === "skill") {
   843→      const skill = array[index] as Skill;
   844→      if (skill.id) {
   845→        const skillDir = path.join(ctx.specDir, "skills", skill.id);
   846→        try {
   847→          await fs.rm(skillDir, { recursive: true, force: true });
   848→        } catch {
   849→          // Directory might not exist, that's fine
   850→        }
   851→      }
   852→    }
   853→
   854→    array.splice(index, 1);
   855→    await saveMetaManifest(manifestPath, manifest);
   856→    return true;
   857→  } catch {
   858→    return false;
   859→  }
   860→}
   861→
   862→// ============================================================
   863→// SESSION CONTEXT
   864→// ============================================================
   865→
   866→/**
   867→ * Get the session context file path
   868→ */
   869→export function getSessionContextPath(ctx: KspecContext): string {
   870→  return path.join(ctx.specDir, ".kspec-session");
   871→}
   872→
   873→/**
   874→ * Load session context (or return empty context if not exists)
   875→ */
   876→export async function loadSessionContext(
   877→  ctx: KspecContext,
   878→): Promise<SessionContext> {
   879→  const contextPath = getSessionContextPath(ctx);
   880→
   881→  try {
   882→    const raw = await readYamlFile<unknown>(contextPath);
   883→    if (!raw || typeof raw !== "object") {
   884→      return {
   885→        focus: null,
   886→        threads: [],
   887→        open_questions: [],
   888→        updated_at: new Date().toISOString(),
   889→      };
   890→    }
   891→
   892→    // Validate and parse using schema
   893→    const result = SessionContextSchema.safeParse(raw);
   894→    if (result.success) {
   895→      return result.data;
   896→    }
   897→
   898→    // If validation fails, return empty context
   899→    return {
   900→      focus: null,
   901→      threads: [],
   902→      open_questions: [],
   903→      updated_at: new Date().toISOString(),
   904→    };
   905→  } catch {
   906→    return {
   907→      focus: null,
   908→      threads: [],
   909→      open_questions: [],
   910→      updated_at: new Date().toISOString(),
   911→    };
   912→  }
   913→}
   914→
   915→/**
   916→ * Save session context
   917→ */
   918→export async function saveSessionContext(
   919→  ctx: KspecContext,
   920→  context: SessionContext,
   921→): Promise<void> {
   922→  const contextPath = getSessionContextPath(ctx);
   923→
   924→  // Update timestamp
   925→  context.updated_at = new Date().toISOString();
   926→
   927→  await writeYamlFilePreserveFormat(contextPath, context);
   928→}
   929→
   930→// ============================================================
   931→// WORKFLOW RUNS
   932→// ============================================================
   933→
   934→/**
   935→ * Get the workflow runs file path.
   936→ * Derives from main manifest name (e.g., myproject.yaml -> myproject.runs.yaml)
   937→ */
   938→export function getWorkflowRunsPath(ctx: KspecContext): string {
   939→  const baseName = getManifestBaseName(ctx.manifestPath);
   940→  return path.join(ctx.specDir, `${baseName}.runs.yaml`);
   941→}
   942→
   943→/**
   944→ * Load workflow runs from file
   945→ */
   946→export async function loadWorkflowRuns(
   947→  ctx: KspecContext,
   948→): Promise<WorkflowRun[]> {
   949→  const runsPath = getWorkflowRunsPath(ctx);
   950→
   951→  try {
   952→    const raw = await readYamlFile<unknown>(runsPath);
   953→    const parsed = WorkflowRunsFileSchema.safeParse(raw);
   954→
   955→    if (!parsed.success) {
   956→      return [];
   957→    }
   958→
   959→    return parsed.data.runs;
   960→  } catch {
   961→    // File doesn't exist
   962→    return [];
   963→  }
   964→}
   965→
   966→/**
   967→ * Save a workflow run (create or update)
   968→ */
   969→export async function saveWorkflowRun(
   970→  ctx: KspecContext,
   971→  run: WorkflowRun,
   972→): Promise<void> {
   973→  const runsPath = getWorkflowRunsPath(ctx);
   974→
   975→  // Load existing runs
   976→  const runs = await loadWorkflowRuns(ctx);
   977→
   978→  // Update or add
   979→  const existingIndex = runs.findIndex((r) => r._ulid === run._ulid);
   980→  if (existingIndex >= 0) {
   981→    runs[existingIndex] = run;
   982→  } else {
   983→    runs.push(run);
   984→  }
   985→
   986→  // Save back
   987→  const runsFile: WorkflowRunsFile = {
   988→    kynetic_runs: "1.0",
   989→    runs,
   990→  };
   991→
   992→  await writeYamlFilePreserveFormat(runsPath, runsFile);
   993→}
   994→
   995→/**
   996→ * Update an existing workflow run
   997→ */
   998→export async function updateWorkflowRun(
   999→  ctx: KspecContext,
  1000→  run: WorkflowRun,
  1001→): Promise<void> {
  1002→  await saveWorkflowRun(ctx, run);
  1003→}
  1004→
  1005→/**
  1006→ * Find a workflow run by reference (ULID or ULID prefix)
  1007→ */
  1008→export async function findWorkflowRunByRef(
  1009→  ctx: KspecContext,
  1010→  ref: string,
  1011→): Promise<WorkflowRun | undefined> {
  1012→  const runs = await loadWorkflowRuns(ctx);
  1013→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  1014→
  1015→  return runs.find(
  1016→    (r) =>
  1017→      r._ulid === cleanRef ||
  1018→      r._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
  1019→  );
  1020→}
  1021→
  1022→/**
  1023→ * Find active workflow runs
  1024→ */
  1025→export async function findActiveRuns(
  1026→  ctx: KspecContext,
  1027→): Promise<WorkflowRun[]> {
  1028→  const runs = await loadWorkflowRuns(ctx);
  1029→  return runs.filter((r) => r.status === "active");
  1030→}
  1031→
  1032→/**
  1033→ * Delete workflow runs by ULIDs
  1034→ * AC: @workflow-prune ac-1, ac-2, ac-3, ac-4
  1035→ */
  1036→export async function deleteWorkflowRuns(
  1037→  ctx: KspecContext,
  1038→  ulidsToDelete: string[],
  1039→): Promise<void> {
  1040→  const runsPath = getWorkflowRunsPath(ctx);
  1041→  const runs = await loadWorkflowRuns(ctx);
  1042→
  1043→  // Filter out runs to delete
  1044→  const remainingRuns = runs.filter((r) => !ulidsToDelete.includes(r._ulid));
  1045→
  1046→  // Save back
  1047→  const runsFile: WorkflowRunsFile = {
  1048→    kynetic_runs: "1.0",
  1049→    runs: remainingRuns,
  1050→  };
  1051→
  1052→  await writeYamlFilePreserveFormat(runsPath, runsFile);
  1053→}
