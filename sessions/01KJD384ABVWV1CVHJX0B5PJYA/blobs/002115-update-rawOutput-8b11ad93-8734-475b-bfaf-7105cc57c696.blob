     1→/**
     2→ * Behavioral integration tests for ralph session budget integration.
     3→ *
     4→ * Tests verify that the session budget lifecycle works correctly
     5→ * when exercised in the same sequence ralph uses:
     6→ * create session with budget → reset at iteration boundary →
     7→ * budget enforcement via task start → cleanup on exit.
     8→ *
     9→ * Producer-side tests use a mock ACP agent (tests/fixtures/mock-acp-agent.mjs)
    10→ * to verify env injection and cleanup through the real ralph code paths.
    11→ *
    12→ * AC: @ralph-session-budget-integration ac-create-budget, ac-reset-iteration,
    13→ *     ac-env-inject, ac-remove-marker-code, ac-session-close-all-paths
    14→ */
    15→import { describe, it, expect, beforeEach, afterEach } from "vitest";
    16→import { execSync, spawn as nodeSpawn } from "node:child_process";
    17→import * as fs from "node:fs/promises";
    18→import * as path from "node:path";
    19→import * as os from "node:os";
    20→import {
    21→  createSessionWithBudget,
    22→  resetBudget,
    23→  getBudget,
    24→  incrementBudget,
    25→  getSessionBudgetPath,
    26→} from "../../src/sessions/store.js";
    27→import { spawnAgent } from "../../src/agents/spawner.js";
    28→import {
    29→  kspec,
    30→  setupTempFixtures,
    31→  cleanupTempDir,
    32→  testUlid,
    33→  CLI_PATH,
    34→  FIXTURES_DIR,
    35→  initGitRepo,
    36→} from "../helpers/cli";
    37→
    38→/** Path to the mock ACP agent script */
    39→const MOCK_AGENT_PATH = path.join(FIXTURES_DIR, "mock-acp-agent.mjs");
    40→
    41→// ─── Budget Creation (ac-create-budget) ─────────────────────────────────────
    42→
    43→describe("ac-create-budget: session creation with budget", () => {
    44→  let specDir: string;
    45→
    46→  beforeEach(async () => {
    47→    specDir = await fs.mkdtemp(path.join(os.tmpdir(), "kspec-ralph-budget-"));
    48→  });
    49→
    50→  afterEach(async () => {
    51→    await fs.rm(specDir, { recursive: true });
    52→  });
    53→
    54→  // AC: @ralph-session-budget-integration ac-create-budget
    55→  it("should write budget.json with max_per_cycle=N when budget > 0", async () => {
    56→    const sessionId = testUlid("RBUDG", 1);
    57→    const result = await createSessionWithBudget(specDir, {
    58→      id: sessionId,
    59→      agent_type: "claude-code",
    60→      budget: 3,
    61→    });
    62→
    63→    expect(result.budget).not.toBeNull();
    64→    expect(result.budget!.max_per_cycle).toBe(3);
    65→    expect(result.budget!.started_this_cycle).toBe(0);
    66→
    67→    // Verify file on disk
    68→    const budgetPath = getSessionBudgetPath(specDir, sessionId);
    69→    const content = await fs.readFile(budgetPath, "utf-8");
    70→    const parsed = JSON.parse(content);
    71→    expect(parsed.max_per_cycle).toBe(3);
    72→    expect(parsed.started_this_cycle).toBe(0);
    73→  });
    74→
    75→  // AC: @ralph-session-budget-integration ac-create-budget
    76→  it("should NOT write budget.json when budget is 0 (unlimited)", async () => {
    77→    const sessionId = testUlid("RBUDG", 2);
    78→    const result = await createSessionWithBudget(specDir, {
    79→      id: sessionId,
    80→      agent_type: "claude-code",
    81→      budget: 0,
    82→    });
    83→
    84→    expect(result.budget).toBeNull();
    85→
    86→    // budget.json should not exist
    87→    const budgetPath = getSessionBudgetPath(specDir, sessionId);
    88→    await expect(fs.access(budgetPath)).rejects.toThrow();
    89→  });
    90→
    91→  // AC: @ralph-session-budget-integration ac-create-budget
    92→  it("should create budget with max_per_cycle matching --max-tasks value", async () => {
    93→    for (const maxTasks of [1, 5, 10]) {
    94→      const sessionId = testUlid("RBUDG", maxTasks + 10);
    95→      const result = await createSessionWithBudget(specDir, {
    96→        id: sessionId,
    97→        agent_type: "claude-code",
    98→        budget: maxTasks,
    99→      });
   100→
   101→      expect(result.budget!.max_per_cycle).toBe(maxTasks);
   102→    }
   103→  });
   104→});
   105→
   106→// ─── Budget Reset (ac-reset-iteration) ──────────────────────────────────────
   107→
   108→describe("ac-reset-iteration: budget reset at iteration boundary", () => {
   109→  let specDir: string;
   110→  let sessionId: string;
   111→
   112→  beforeEach(async () => {
   113→    specDir = await fs.mkdtemp(path.join(os.tmpdir(), "kspec-ralph-reset-"));
   114→    sessionId = testUlid("RRESET", 1);
   115→    await createSessionWithBudget(specDir, {
   116→      id: sessionId,
   117→      agent_type: "claude-code",
   118→      budget: 2,
   119→    });
   120→  });
   121→
   122→  afterEach(async () => {
   123→    await fs.rm(specDir, { recursive: true });
   124→  });
   125→
   126→  // AC: @ralph-session-budget-integration ac-reset-iteration
   127→  it("should reset started_this_cycle to 0 after tasks were started", async () => {
   128→    // Simulate agent starting tasks during an iteration
   129→    await incrementBudget(specDir, sessionId);
   130→    await incrementBudget(specDir, sessionId);
   131→
   132→    let budget = await getBudget(specDir, sessionId);
   133→    expect(budget!.started_this_cycle).toBe(2);
   134→
   135→    // Simulate ralph calling resetBudget at iteration boundary
   136→    await resetBudget(specDir, sessionId);
   137→
   138→    budget = await getBudget(specDir, sessionId);
   139→    expect(budget!.started_this_cycle).toBe(0);
   140→    expect(budget!.max_per_cycle).toBe(2); // max unchanged
   141→  });
   142→
   143→  // AC: @ralph-session-budget-integration ac-reset-iteration
   144→  it("should no-op when no budget exists (maxTasks=0)", async () => {
   145→    const noBudgetSessionId = testUlid("RRESET", 2);
   146→    await createSessionWithBudget(specDir, {
   147→      id: noBudgetSessionId,
   148→      agent_type: "claude-code",
   149→      budget: 0,
   150→    });
   151→
   152→    // resetBudget should return null (no budget to reset)
   153→    const result = await resetBudget(specDir, noBudgetSessionId);
   154→    expect(result).toBeNull();
   155→  });
   156→});
   157→
   158→// ─── Env Injection — Consumer Side (ac-env-inject) ──────────────────────────
   159→
   160→describe("ac-env-inject: KSPEC_SESSION_ID budget enforcement via task start", () => {
   161→  let tempDir: string;
   162→
   163→  beforeEach(async () => {
   164→    tempDir = await setupTempFixtures();
   165→  });
   166→
   167→  afterEach(async () => {
   168→    await cleanupTempDir(tempDir);
   169→  });
   170→
   171→  // AC: @ralph-session-budget-integration ac-env-inject
   172→  it("should enforce budget when KSPEC_SESSION_ID is set and budget exhausted", async () => {
   173→    // Create a session with budget in the fixtures dir (tempDir IS specDir)
   174→    const sessionId = testUlid("RENV", 1);
   175→    await createSessionWithBudget(tempDir, {
   176→      id: sessionId,
   177→      agent_type: "claude-code",
   178→      budget: 1,
   179→    });
   180→
   181→    // Exhaust the budget
   182→    await incrementBudget(tempDir, sessionId);
   183→
   184→    // Now task start should be blocked when KSPEC_SESSION_ID is set
   185→    const result = kspec("task start @test-task-pending", tempDir, {
   186→      expectFail: true,
   187→      env: { KSPEC_SESSION_ID: sessionId },
   188→    });
   189→
   190→    expect(result.exitCode).toBe(4); // VALIDATION_FAILED
   191→    expect(result.stderr).toContain("budget");
   192→  });
   193→
   194→  // AC: @ralph-session-budget-integration ac-env-inject
   195→  it("should allow task start when KSPEC_SESSION_ID is set and budget available", async () => {
   196→    const sessionId = testUlid("RENV", 2);
   197→    await createSessionWithBudget(tempDir, {
   198→      id: sessionId,
   199→      agent_type: "claude-code",
   200→      budget: 5,
   201→    });
   202→
   203→    // Budget not exhausted — task start should succeed
   204→    const result = kspec("task start @test-task-pending", tempDir, {
   205→      env: { KSPEC_SESSION_ID: sessionId },
   206→    });
   207→
   208→    expect(result.exitCode).toBe(0);
   209→  });
   210→
   211→  // AC: @ralph-session-budget-integration ac-env-inject
   212→  it("should not enforce budget when KSPEC_SESSION_ID is not set", async () => {
   213→    // No session ID → no budget check → task start should succeed
   214→    const result = kspec("task start @test-task-pending", tempDir);
   215→    expect(result.exitCode).toBe(0);
   216→  });
   217→});
   218→
   219→// ─── Env Injection — Producer Side (ac-env-inject) ──────────────────────────
   220→
   221→describe("ac-env-inject: spawnAgent passes KSPEC_SESSION_ID to child process", () => {
   222→  let tempDir: string;
   223→  let envFile: string;
   224→
   225→  beforeEach(async () => {
   226→    tempDir = await fs.mkdtemp(path.join(os.tmpdir(), "kspec-ralph-spawn-"));
   227→    envFile = path.join(tempDir, "agent-env.json");
   228→  });
   229→
   230→  afterEach(async () => {
   231→    await fs.rm(tempDir, { recursive: true });
   232→  });
   233→
   234→  // AC: @ralph-session-budget-integration ac-env-inject
   235→  it("should pass KSPEC_SESSION_ID to spawned agent via env", async () => {
   236→    const sessionId = testUlid("RSPAWN", 1);
   237→
   238→    // Spawn mock agent with the same env pattern ralph uses
   239→    const agent = spawnAgent(
   240→      { command: "node", args: [MOCK_AGENT_PATH], description: "mock" },
   241→      {
   242→        cwd: tempDir,
   243→        env: {
   244→          KSPEC_SESSION_ID: sessionId,
   245→          MOCK_ACP_ENV_FILE: envFile,
   246→        },
   247→      },
   248→    );
   249→
   250→    try {
   251→      // Initialize to prove the agent is alive and responding
   252→      await agent.client.initialize();
   253→
   254→      // Mock agent writes env to file on startup — verify it received the session ID
   255→      const envData = JSON.parse(await fs.readFile(envFile, "utf-8"));
   256→      expect(envData.KSPEC_SESSION_ID).toBe(sessionId);
   257→    } finally {
   258→      agent.kill();
   259→    }
   260→  });
   261→
   262→  // AC: @ralph-session-budget-integration ac-env-inject
   263→  it("should not leak KSPEC_SESSION_ID when env is not provided", async () => {
   264→    // Ensure KSPEC_SESSION_ID is NOT in the current process env for this test
   265→    const originalValue = process.env.KSPEC_SESSION_ID;
   266→    delete process.env.KSPEC_SESSION_ID;
   267→
   268→    try {
   269→      const agent = spawnAgent(
   270→        { command: "node", args: [MOCK_AGENT_PATH], description: "mock" },
   271→        {
   272→          cwd: tempDir,
   273→          env: { MOCK_ACP_ENV_FILE: envFile },
   274→        },
   275→      );
   276→
   277→      try {
   278→        await agent.client.initialize();
   279→        const envData = JSON.parse(await fs.readFile(envFile, "utf-8"));
   280→        expect(envData.KSPEC_SESSION_ID).toBeNull();
   281→      } finally {
   282→        agent.kill();
   283→      }
   284→    } finally {
   285→      // Restore original value
   286→      if (originalValue !== undefined) {
   287→        process.env.KSPEC_SESSION_ID = originalValue;
   288→      }
   289→    }
   290→  });
   291→});
   292→
   293→// ─── Marker Code Removal (ac-remove-marker-code) ────────────────────────────
   294→
   295→describe("ac-remove-marker-code: no marker file code in ralph.ts", () => {
   296→  let ralphSource: string;
   297→
   298→  beforeEach(async () => {
   299→    ralphSource = await fs.readFile(
   300→      path.resolve("src/cli/commands/ralph.ts"),
   301→      "utf-8",
   302→    );
   303→  });
   304→
   305→  // Task-limit marker artifacts
   306→  const removedPatterns = [
   307→    "TaskLimitMarker",
   308→    "TASK_LIMIT_MARKER",
   309→    "ralph-task-limit.json",
   310→    "detectTaskCompleteCommand",
   311→    "extractBashCommand",
   312→    "TASK LIMIT REACHED",
   313→    "writeTaskLimitMarker",
   314→    "readTaskLimitMarker",
   315→    "clearTaskLimitMarker",
   316→    "clearStaleMarker",
   317→    "STALE_MARKER_THRESHOLD",
   318→    "taskLimitReached",
   319→    "tasksCompletedThisIteration",
   320→    // End-loop marker artifacts (removed in end-loop migration)
   321→    "END_LOOP_MARKER_PATH",
   322→    "ralph-end-loop.json",
   323→    "writeEndLoopMarker",
   324→    "readEndLoopMarker",
   325→    "clearEndLoopMarker",
   326→  ];
   327→
   328→  // AC: @ralph-session-budget-integration ac-remove-marker-code
   329→  for (const pattern of removedPatterns) {
   330→    it(`should not contain "${pattern}"`, () => {
   331→      expect(ralphSource).not.toContain(pattern);
   332→    });
   333→  }
   334→
   335→  // AC: @ralph-session-budget-integration ac-remove-marker-code
   336→  it("should not import getIterationStats", () => {
   337→    expect(ralphSource).not.toMatch(/import.*getIterationStats/);
   338→  });
   339→});
   340→
   341→// ─── Session Close All Paths (ac-session-close-all-paths) ───────────────────
   342→
   343→describe("ac-session-close-all-paths: ralph cleans up budget on exit", () => {
   344→  let tempDir: string;
   345→
   346→  beforeEach(async () => {
   347→    tempDir = await setupTempFixtures();
   348→    // Initialize a clean git repo so getWorkingTreeStatus() returns clean.
   349→    // This prevents the wrap-up agent from spawning (2-min timeout) and
   350→    // causing flaky test timeouts. The .gitignore ensures session artifacts
   351→    // created by ralph during the test don't dirty the working tree.
   352→    initGitRepo(tempDir);
   353→    await fs.writeFile(path.join(tempDir, ".gitignore"), "sessions/\n");
   354→    execSync("git add -A && git commit -m 'init'", { cwd: tempDir, stdio: "pipe" });
   355→  });
   356→
   357→  afterEach(async () => {
   358→    await cleanupTempDir(tempDir);
   359→  });
   360→
   361→  /**
   362→   * Helper: spawn kspec ralph as a subprocess.
   363→   * Watches combined output for a marker string, then resolves.
   364→   * Ralph may not exit cleanly due to open Node handles, so we
   365→   * kill the process after the marker is seen and cleanup has occurred.
   366→   */
   367→  function spawnRalphUntil(
   368→    args: string[],
   369→    marker: string,
   370→    env: Record<string, string> = {},
   371→  ): Promise<{ output: string }> {
   372→    return new Promise((resolve, reject) => {
   373→      const child = nodeSpawn("node", [CLI_PATH, "ralph", ...args], {
   374→        cwd: tempDir,
   375→        env: {
   376→          ...process.env,
   377→          KSPEC_SPEC_DIR: tempDir,
   378→          KSPEC_AUTHOR: "@test",
   379→          ...env,
   380→        },
   381→        stdio: ["pipe", "pipe", "pipe"],
   382→      });
   383→
   384→      let output = "";
   385→      let resolved = false;
   386→
   387→      const onData = (d: Buffer) => {
   388→        output += d.toString();
   389→        // Once we see the marker, cleanup is done — give a small grace period then kill
   390→        if (!resolved && output.includes(marker)) {
   391→          resolved = true;
   392→          setTimeout(() => {
   393→            child.kill("SIGKILL");
   394→            resolve({ output });
   395→          }, 500);
   396→        }
   397→      };
   398→      child.stdout!.on("data", onData);
   399→      child.stderr!.on("data", onData);
   400→
   401→      child.on("close", () => {
   402→        if (!resolved) {
   403→          resolved = true;
   404→          resolve({ output });
   405→        }
   406→      });
   407→
   408→      // Safety timeout
   409→      setTimeout(() => {
   410→        if (!resolved) {
   411→          resolved = true;
   412→          child.kill("SIGKILL");
   413→          reject(new Error(`Timed out waiting for marker "${marker}"\noutput: ${output}`));
   414→        }
   415→      }, 25_000);
   416→    });
   417→  }
   418→
   419→  // AC: @ralph-session-budget-integration ac-session-close-all-paths
   420→  it("should clean up budget.json after normal exit (max-iterations reached)", async () => {
   421→    // Run ralph with mock agent for 1 iteration.
   422→    // Wait for "Ralph loop completed" which appears after all cleanup.
   423→    const result = await spawnRalphUntil(
   424→      ["--adapter-cmd", `node ${MOCK_AGENT_PATH}`, "--max-loops", "1", "--max-tasks", "2"],
   425→      "Ralph loop completed",
   426→    );
   427→
   428→    expect(result.output).toContain("Completed iteration 1");
   429→
   430→    // Find the session directory ralph created
   431→    const sessionsDir = path.join(tempDir, "sessions");
   432→    const sessionDirs = await fs.readdir(sessionsDir);
   433→
   434→    // Ralph should have created exactly one session
   435→    expect(sessionDirs.length).toBe(1);
   436→
   437→    // Budget.json should NOT exist after ralph cleanup
   438→    const budgetPath = path.join(sessionsDir, sessionDirs[0], "budget.json");
   439→    const budgetExists = await fs.access(budgetPath).then(() => true).catch(() => false);
   440→    expect(budgetExists).toBe(false);
   441→
   442→    // Session should be closed as completed
   443→    const sessionPath = path.join(sessionsDir, sessionDirs[0], "session.yaml");
   444→    const content = await fs.readFile(sessionPath, "utf-8");
   445→    expect(content).toContain("status: completed");
   446→  }, 30_000);
   447→
   448→  /**
   449→   * Helper: spawn ralph, wait for it to start, send a signal, verify cleanup.
   450→   */
   451→  async function testSignalCleanup(signal: "SIGINT" | "SIGTERM") {
   452→    const child = nodeSpawn(
   453→      "node",
   454→      [CLI_PATH, "ralph", "--adapter-cmd", `node ${MOCK_AGENT_PATH}`, "--max-loops", "999", "--max-tasks", "2"],
   455→      {
   456→        cwd: tempDir,
   457→        env: {
   458→          ...process.env,
   459→          KSPEC_SPEC_DIR: tempDir,
   460→          KSPEC_AUTHOR: "@test",
   461→        },
   462→        stdio: ["pipe", "pipe", "pipe"],
   463→      },
   464→    );
   465→
   466→    let output = "";
   467→    const onData = (d: Buffer) => { output += d.toString(); };
   468→    child.stdout!.on("data", onData);
   469→    child.stderr!.on("data", onData);
   470→
   471→    // Wait for ralph to create the session and start working
   472→    await new Promise<void>((resolve) => {
   473→      const check = () => {
   474→        if (output.includes("Creating ACP session")) {
   475→          resolve();
   476→        } else {
   477→          setTimeout(check, 50);
   478→        }
   479→      };
   480→      check();
   481→      setTimeout(resolve, 5_000);
   482→    });
   483→
   484→    // Send the signal
   485→    child.kill(signal);
   486→
   487→    // Wait for process to exit
   488→    await new Promise<void>((resolve) => {
   489→      child.on("close", () => resolve());
   490→      setTimeout(() => {
   491→        child.kill("SIGKILL");
   492→        resolve();
   493→      }, 10_000);
   494→    });
   495→
   496→    // Verify budget.json was cleaned up
   497→    const sessionsDir = path.join(tempDir, "sessions");
   498→    const sessionDirs = await fs.readdir(sessionsDir);
   499→    expect(sessionDirs.length).toBe(1);
   500→
   501→    const budgetPath = path.join(sessionsDir, sessionDirs[0], "budget.json");
   502→    const budgetExists = await fs.access(budgetPath).then(() => true).catch(() => false);
   503→    expect(budgetExists).toBe(false);
   504→
   505→    // Session should be closed as abandoned with signal name
   506→    const sessionPath = path.join(sessionsDir, sessionDirs[0], "session.yaml");
   507→    const content = await fs.readFile(sessionPath, "utf-8");
   508→    expect(content).toContain("status: abandoned");
   509→    expect(content).toContain(signal);
   510→  }
   511→
   512→  // AC: @ralph-session-budget-integration ac-session-close-all-paths
   513→  // AC: @ralph-task-limit ac-signal-cleanup
   514→  it("should clean up budget.json after signal (SIGINT)", async () => {
   515→    await testSignalCleanup("SIGINT");
   516→  }, 30_000);
   517→
   518→  // AC: @ralph-session-budget-integration ac-session-close-all-paths
   519→  // AC: @ralph-task-limit ac-signal-cleanup
   520→  it("should clean up budget.json after signal (SIGTERM)", async () => {
   521→    await testSignalCleanup("SIGTERM");
   522→  }, 30_000);
   523→
   524→  // AC: @ralph-session-budget-integration ac-session-close-all-paths
   525→  it("should clean up budget.json after agent crash (error path)", async () => {
   526→    const crashAgent = path.join(FIXTURES_DIR, "mock-acp-agent-crash.mjs");
   527→
   528→    // Ralph with a crashing agent — retries exhaust, then finally block cleans up.
   529→    // Wait for "Ralph loop completed" (capital R) which appears after all cleanup.
   530→    const result = await spawnRalphUntil(
   531→      ["--adapter-cmd", `node ${crashAgent}`, "--max-loops", "1", "--max-tasks", "2"],
   532→      "Ralph loop completed",
   533→    );
   534→
   535→    // Ralph should have logged iteration failures
   536→    expect(result.output).toContain("Iteration failed");
   537→
   538→    // Find the session directory ralph created
   539→    const sessionsDir = path.join(tempDir, "sessions");
   540→    const sessionDirs = await fs.readdir(sessionsDir);
   541→    expect(sessionDirs.length).toBe(1);
   542→
   543→    // Budget.json should be cleaned up by finally block
   544→    const budgetPath = path.join(sessionsDir, sessionDirs[0], "budget.json");
   545→    const budgetExists = await fs.access(budgetPath).then(() => true).catch(() => false);
   546→    expect(budgetExists).toBe(false);
   547→  }, 30_000);
   548→});
   549→

