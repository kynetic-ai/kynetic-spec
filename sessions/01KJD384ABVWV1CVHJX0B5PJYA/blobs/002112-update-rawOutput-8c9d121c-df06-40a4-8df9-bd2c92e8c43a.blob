   274→  // AC: @session-end-loop-signal ac-session-close-normal
   275→  // AC: @session-end-loop-signal ac-session-close-signal
   276→  // AC: @session-end-loop-signal ac-session-close-error
   277→  describe("session close handlers", () => {
   278→    it("should register SIGINT and SIGTERM handlers that close session", async () => {
   279→      // AC: @session-end-loop-signal ac-session-close-signal
   280→      // Static analysis to verify signal handlers close session
   281→      const ralphContent = await fs.readFile(
   282→        path.join(process.cwd(), "src/cli/commands/ralph.ts"),
   283→        "utf-8",
   284→      );
   285→
   286→      // Verify signal handlers are registered
   287→      expect(ralphContent).toContain('process.on("SIGINT"');
   288→      expect(ralphContent).toContain('process.on("SIGTERM"');
   289→
   290→      // Verify session is closed with abandoned status on signal
   291→      expect(ralphContent).toContain("closeSession");
   292→      expect(ralphContent).toContain('"abandoned"');
   293→      expect(ralphContent).toContain("Received ${signal}");
   294→
   295→      // Verify cleanup awaits before exit (async IIFE pattern)
   296→      expect(ralphContent).toContain("await Promise.all");
   297→      expect(ralphContent).toContain("process.exit(0)");
   298→    });
   299→
   300→    it("should close session with completed status on normal exit", async () => {
   301→      // AC: @session-end-loop-signal ac-session-close-normal
   302→      const ralphContent = await fs.readFile(
   303→        path.join(process.cwd(), "src/cli/commands/ralph.ts"),
   304→        "utf-8",
   305→      );
   306→
   307→      // Verify closeSession is called at the end of the loop
   308→      expect(ralphContent).toContain("closeSession(specDir, sessionId, status, closeReason)");
   309→
   310→      // Verify close reasons are computed for various exit paths
   311→      expect(ralphContent).toContain("Completed all");
   312→      expect(ralphContent).toContain("No eligible tasks remaining");
   313→      expect(ralphContent).toContain("Agent requested end of loop");
   314→    });
   315→
   316→    it("should close session with abandoned status on max failures", async () => {
   317→      // AC: @session-end-loop-signal ac-session-close-error
   318→      const ralphContent = await fs.readFile(
   319→        path.join(process.cwd(), "src/cli/commands/ralph.ts"),
   320→        "utf-8",
   321→      );
   322→
   323→      // Verify max_failures exit sets abandoned status
   324→      expect(ralphContent).toContain("max_failures");
   325→      expect(ralphContent).toContain("Max failures reached");
   326→    });
   327→
   328→    it("should close session with abandoned status on unrecoverable error", async () => {
   329→      // AC: @session-end-loop-signal ac-session-close-error
   330→      const ralphContent = await fs.readFile(
   331→        path.join(process.cwd(), "src/cli/commands/ralph.ts"),
   332→        "utf-8",
   333→      );
   334→
   335→      // Verify unrecoverable errors are caught and set error exit reason
   336→      expect(ralphContent).toContain("} catch (loopErr)");
   337→      expect(ralphContent).toContain('exitReason = exitReason ?? "error"');
   338→      expect(ralphContent).toContain("Unrecoverable error in ralph loop");
   339→
   340→      // Verify error exit reason leads to abandoned status
   341→      expect(ralphContent).toContain('exitReason === "error"');
   342→      expect(ralphContent).toContain("const isErrorExit");
   343→      // Verify the close reason includes the error message
   344→      expect(ralphContent).toContain("Unrecoverable error");
   345→    });
   346→  });
   347→
