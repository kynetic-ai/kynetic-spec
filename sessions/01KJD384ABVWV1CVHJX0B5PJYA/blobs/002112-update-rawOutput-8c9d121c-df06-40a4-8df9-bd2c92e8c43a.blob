   423→describe("Session store: requestEndLoop and isEndLoopRequested", () => {
   424→  let tempDir: string;
   425→
   426→  beforeEach(async () => {
   427→    tempDir = await setupTempFixtures();
   428→    initGitRepo(tempDir);
   429→  });
   430→
   431→  afterEach(async () => {
   432→    await cleanupTempDir(tempDir);
   433→  });
   434→
   435→  it("should write end_requested and end_reason to session", async () => {
   436→    await createTestSession(tempDir, SESSION_ID);
   437→
   438→    // Use end-loop command with session
   439→    const result = kspec(
   440→      'ralph end-loop --reason "Testing"',
   441→      tempDir,
   442→      { env: { KSPEC_SESSION_ID: SESSION_ID } },
   443→    );
   444→    expect(result.exitCode).toBe(0);
   445→
   446→    // Verify the session YAML was updated
   447→    const session = await readTestSession(tempDir, SESSION_ID);
   448→    expect(session!.end_requested).toBe(true);
   449→    expect(session!.end_reason).toBe("Testing");
   450→    // Original fields should be preserved
   451→    expect(session!.status).toBe("active");
   452→    expect(session!.agent_type).toBe("ralph");
   453→  });
   454→
   455→  it("should report end-loop not requested for fresh session", async () => {
   456→    await createTestSession(tempDir, SESSION_ID);
   457→
   458→    // Task start should succeed (no end-loop requested)
   459→    const result = kspec("task start @test-task-pending", tempDir, {
   460→      env: { KSPEC_SESSION_ID: SESSION_ID },
   461→    });
   462→    expect(result.exitCode).toBe(0);
   463→  });
   464→
   465→  it("should ignore end_requested for non-active sessions", async () => {
   466→    // end_requested=true but session is completed — should not block
   467→    await createTestSession(tempDir, SESSION_ID, {
   468→      end_requested: true,
   469→      end_reason: "Old reason",
   470→      status: "completed",
   471→    });
   472→
   473→    // Verify at the CLI level: task start should succeed
   474→    const result = kspec("task start @test-task-pending", tempDir, {
   475→      env: { KSPEC_SESSION_ID: SESSION_ID },
   476→    });
   477→    expect(result.exitCode).toBe(0);
   478→  });
   479→});
