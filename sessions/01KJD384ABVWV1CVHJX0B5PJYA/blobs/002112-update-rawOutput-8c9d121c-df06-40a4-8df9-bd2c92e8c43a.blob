     1→/**
     2→ * Tests for session-scoped end-loop signal.
     3→ *
     4→ * Migrated from marker file approach to session state.
     5→ * AC: @session-end-loop-signal ac-signal, ac-block-task, ac-detect, ac-session-close-normal,
     6→ *     ac-session-close-signal, ac-session-close-error, ac-remove-markers
     7→ * AC: @trait-error-guidance ac-1, ac-2
     8→ * AC: @trait-error-guidance ac-3 N/A — no ref resolution in end-loop command
     9→ * AC: @trait-error-guidance ac-4 N/A — no state transitions in end-loop command
    10→ * AC: @trait-error-guidance ac-5 N/A — no field-level validation in end-loop command
    11→ * AC: @trait-error-guidance ac-6 N/A — ralph end-loop does not support --json output mode
    12→ */
    13→import { describe, it, expect, beforeEach, afterEach } from "vitest";
    14→import * as fs from "node:fs/promises";
    15→import * as path from "node:path";
    16→import * as YAML from "yaml";
    17→import {
    18→  kspec,
    19→  kspecJson,
    20→  setupTempFixtures,
    21→  cleanupTempDir,
    22→  initGitRepo,
    23→} from "../helpers/cli";
    24→
    25→const SESSION_ID = "01KJ7CCCHNMBABEHHDVEYSPJFR";
    26→
    27→/**
    28→ * Helper to create a session.yaml file in the test fixture directory.
    29→ * Sessions live at {specDir}/sessions/{sessionId}/session.yaml
    30→ */
    31→async function createTestSession(
    32→  specDir: string,
    33→  sessionId: string,
    34→  overrides: Record<string, unknown> = {},
    35→): Promise<void> {
    36→  const sessionDir = path.join(specDir, "sessions", sessionId);
    37→  await fs.mkdir(sessionDir, { recursive: true });
    38→  const metadata = {
    39→    id: sessionId,
    40→    agent_type: "ralph",
    41→    status: "active",
    42→    started_at: new Date().toISOString(),
    43→    ...overrides,
    44→  };
    45→  await fs.writeFile(
    46→    path.join(sessionDir, "session.yaml"),
    47→    YAML.stringify(metadata, { indent: 2, lineWidth: 100, sortMapEntries: false }),
    48→  );
    49→}
    50→
    51→/**
    52→ * Helper to read session metadata.
    53→ */
    54→async function readTestSession(
    55→  specDir: string,
    56→  sessionId: string,
    57→): Promise<Record<string, unknown> | null> {
    58→  const sessionPath = path.join(
    59→    specDir,
    60→    "sessions",
    61→    sessionId,
    62→    "session.yaml",
    63→  );
    64→  try {
    65→    const content = await fs.readFile(sessionPath, "utf-8");
    66→    return YAML.parse(content);
    67→  } catch {
    68→    return null;
    69→  }
    70→}
    71→
    72→describe("Session-scoped end-loop signal", () => {
    73→  let tempDir: string;
    74→
    75→  beforeEach(async () => {
    76→    tempDir = await setupTempFixtures();
    77→    initGitRepo(tempDir);
    78→  });
    79→
    80→  afterEach(async () => {
    81→    await cleanupTempDir(tempDir);
    82→  });
    83→
    84→  // AC: @session-end-loop-signal ac-signal
    85→  describe("ac-signal: end-loop writes to session state", () => {
    86→    it("should write end_requested=true to session metadata", async () => {
    87→      await createTestSession(tempDir, SESSION_ID);
    88→
    89→      const result = kspec("ralph end-loop", tempDir, {
    90→        env: { KSPEC_SESSION_ID: SESSION_ID },
    91→      });
    92→
    93→      expect(result.exitCode).toBe(0);
    94→      expect(result.stdout).toContain("Loop end signal sent");
    95→
    96→      // Verify session state was updated
    97→      const session = await readTestSession(tempDir, SESSION_ID);
    98→      expect(session).not.toBeNull();
    99→      expect(session!.end_requested).toBe(true);
   100→    });
   101→
   102→    it("should include reason in session metadata when provided", async () => {
   103→      await createTestSession(tempDir, SESSION_ID);
   104→
   105→      // AC: @session-end-loop-signal ac-signal
   106→      const result = kspec(
   107→        'ralph end-loop --reason "No eligible tasks"',
   108→        tempDir,
   109→        { env: { KSPEC_SESSION_ID: SESSION_ID } },
   110→      );
   111→
   112→      expect(result.exitCode).toBe(0);
   113→      expect(result.stdout).toContain("Reason: No eligible tasks");
   114→
   115→      const session = await readTestSession(tempDir, SESSION_ID);
   116→      expect(session!.end_requested).toBe(true);
   117→      expect(session!.end_reason).toBe("No eligible tasks");
   118→    });
   119→
   120→    it("should fail with exit code 4 when KSPEC_SESSION_ID is not set", async () => {
   121→      // AC: @trait-error-guidance ac-1, ac-2
   122→      const result = kspec("ralph end-loop", tempDir, {
   123→        expectFail: true,
   124→        env: { KSPEC_SESSION_ID: "" },
   125→      });
   126→
   127→      expect(result.exitCode).toBe(4);
   128→      const output = result.stdout + result.stderr;
   129→      expect(output).toContain("KSPEC_SESSION_ID not set");
   130→      expect(output).toContain("kspec session create");
   131→    });
   132→
   133→    it("should fail with exit code 3 when session not found", async () => {
   134→      // AC: @trait-error-guidance ac-1, ac-2
   135→      const result = kspec("ralph end-loop", tempDir, {
   136→        expectFail: true,
   137→        env: { KSPEC_SESSION_ID: "NONEXISTENT_SESSION" },
   138→      });
   139→
   140→      expect(result.exitCode).toBe(3);
   141→      const output = result.stdout + result.stderr;
   142→      expect(output).toContain("Session not found");
   143→      expect(output).toContain("kspec session log list");
   144→    });
   145→  });
   146→
   147→  // AC: @session-end-loop-signal ac-block-task
   148→  describe("ac-block-task: task start blocked when end-loop requested", () => {
   149→    it("should block task start when end_requested is true", async () => {
   150→      await createTestSession(tempDir, SESSION_ID, {
   151→        end_requested: true,
   152→        end_reason: "Wrapping up",
   153→      });
   154→
   155→      const result = kspec("task start @test-task-pending", tempDir, {
   156→        expectFail: true,
   157→        env: { KSPEC_SESSION_ID: SESSION_ID },
   158→      });
   159→
   160→      expect(result.exitCode).toBe(4);
   161→      const output = result.stdout + result.stderr;
   162→      expect(output).toContain("loop is ending");
   163→    });
   164→
   165→    it("should include end-loop reason in error message", async () => {
   166→      await createTestSession(tempDir, SESSION_ID, {
   167→        end_requested: true,
   168→        end_reason: "No more eligible tasks",
   169→      });
   170→
   171→      const result = kspec("task start @test-task-pending", tempDir, {
   172→        expectFail: true,
   173→        env: { KSPEC_SESSION_ID: SESSION_ID },
   174→      });
   175→
   176→      const output = result.stdout + result.stderr;
   177→      expect(output).toContain("No more eligible tasks");
   178→    });
   179→
   180→    it("should include wrap-up guidance in error message", async () => {
   181→      // AC: @trait-error-guidance ac-2
   182→      await createTestSession(tempDir, SESSION_ID, {
   183→        end_requested: true,
   184→      });
   185→
   186→      const result = kspec("task start @test-task-pending", tempDir, {
   187→        expectFail: true,
   188→        env: { KSPEC_SESSION_ID: SESSION_ID },
   189→      });
   190→
   191→      const output = result.stdout + result.stderr;
   192→      expect(output).toMatch(/[Ww]rap up/);
   193→    });
   194→
   195→    it("should allow task start when no session ID is set", async () => {
   196→      // No KSPEC_SESSION_ID means no end-loop check
   197→      await createTestSession(tempDir, SESSION_ID, {
   198→        end_requested: true,
   199→      });
   200→
   201→      const result = kspec("task start @test-task-pending", tempDir, {
   202→        env: { KSPEC_SESSION_ID: "" },
   203→      });
   204→
   205→      expect(result.exitCode).toBe(0);
   206→    });
   207→
   208→    it("should allow task start when end_requested is not set", async () => {
   209→      await createTestSession(tempDir, SESSION_ID);
   210→
   211→      const result = kspec("task start @test-task-pending", tempDir, {
   212→        env: { KSPEC_SESSION_ID: SESSION_ID },
   213→      });
   214→
   215→      expect(result.exitCode).toBe(0);
   216→    });
   217→
   218→    it("should allow task start when session is completed even with end_requested", async () => {
   219→      // Stale session: completed but end_requested is still true
   220→      await createTestSession(tempDir, SESSION_ID, {
   221→        end_requested: true,
   222→        end_reason: "Previous loop ended",
   223→        status: "completed",
   224→        ended_at: new Date().toISOString(),
   225→        close_reason: "No eligible tasks remaining",
   226→      });
   227→
   228→      const result = kspec("task start @test-task-pending", tempDir, {
   229→        env: { KSPEC_SESSION_ID: SESSION_ID },
   230→      });
   231→
   232→      // Should succeed — completed sessions don't block task starts
   233→      expect(result.exitCode).toBe(0);
   234→    });
   235→
   236→    it("should allow task start when session is abandoned even with end_requested", async () => {
   237→      // Stale session: abandoned but end_requested is still true
   238→      await createTestSession(tempDir, SESSION_ID, {
   239→        end_requested: true,
   240→        status: "abandoned",
   241→        ended_at: new Date().toISOString(),
   242→        close_reason: "Received SIGINT",
   243→      });
   244→
   245→      const result = kspec("task start @test-task-pending", tempDir, {
   246→        env: { KSPEC_SESSION_ID: SESSION_ID },
   247→      });
   248→
   249→      // Should succeed — abandoned sessions don't block task starts
   250→      expect(result.exitCode).toBe(0);
   251→    });
   252→  });
   253→
   254→  // AC: @session-end-loop-signal ac-detect
   255→  describe("ac-detect: ralph detects end-loop from session state", () => {
   256→    it("should detect end-loop purely via session state between iterations", async () => {
   257→      // The CLI writes end_requested to session state; ralph checks it
   258→      // between iterations via isEndLoopRequested — no bash command sniffing needed
   259→      const ralphContent = await fs.readFile(
   260→        path.join(process.cwd(), "src/cli/commands/ralph.ts"),
   261→        "utf-8",
   262→      );
   263→
   264→      // Session state check exists between iterations
   265→      expect(ralphContent).toContain("isEndLoopRequested(specDir, sessionId)");
   266→      expect(ralphContent).toContain("endLoopState?.requested");
   267→      expect(ralphContent).toContain('exitReason = "end_loop_signal"');
   268→
   269→      // No bash command detection for end-loop (removed to avoid false positives)
   270→      expect(ralphContent).not.toContain("detectEndLoopCommand");
   271→    });
   272→  });
