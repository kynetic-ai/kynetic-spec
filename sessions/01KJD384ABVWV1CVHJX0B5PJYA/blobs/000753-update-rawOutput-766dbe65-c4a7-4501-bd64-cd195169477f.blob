    55→const DAEMON_WS_URL = 'ws://localhost:3456/ws';
    56→const DAEMON_HTTP_URL = 'http://localhost:3456';
    57→
    58→/**
    59→ * Connect to the daemon WebSocket from the browser context.
    60→ * Stores WebSocket in window.__testWs for subsequent calls.
    61→ */
    62→async function connectWebSocket(page: import('@playwright/test').Page): Promise<void> {
    63→  await page.goto(DAEMON_HTTP_URL + '/api/health');
    64→
    65→  await page.evaluate((wsUrl: string) => {
    66→    return new Promise<void>((resolve, reject) => {
    67→      const ws = new WebSocket(wsUrl);
    68→      (window as unknown as Record<string, unknown>).__testWs = ws;
    69→
    70→      const timeout = setTimeout(() => {
    71→        ws.close();
    72→        reject(new Error('WebSocket connection timed out after 5s'));
    73→      }, 5000);
    74→
    75→      ws.onmessage = (event) => {
    76→        try {
    77→          const data = JSON.parse(event.data);
    78→          if (data.event === 'connected') {
    79→            clearTimeout(timeout);
    80→            resolve();
    81→          }
    82→        } catch {
    83→          // ignore non-JSON messages
    84→        }
    85→      };
    86→
    87→      ws.onerror = () => {
    88→        clearTimeout(timeout);
    89→        reject(new Error('WebSocket error during connection'));
    90→      };
    91→
    92→      ws.onclose = (event) => {
    93→        if (event.code !== 1000 && event.code !== 1001) {
    94→          clearTimeout(timeout);
    95→          reject(new Error(`WebSocket closed unexpectedly: code=${event.code}`));
    96→        }
    97→      };
    98→    });
    99→  }, DAEMON_WS_URL);
   100→}
   101→
   102→/**
   103→ * Subscribe to a WebSocket topic and wait for the ack.
   104→ */
   105→async function subscribeTopic(page: import('@playwright/test').Page, topic: string): Promise<void> {
   106→  await page.evaluate(
   107→    ({ topicName }: { topicName: string }) => {
   108→      return new Promise<void>((resolve, reject) => {
   109→        const ws = (window as unknown as Record<string, WebSocket>).__testWs;
   110→        if (!ws || ws.readyState !== WebSocket.OPEN) {
   111→          reject(new Error('WebSocket not connected'));
   112→          return;
   113→        }
   114→
   115→        const timeout = setTimeout(() => {
   116→          reject(new Error(`Timed out waiting for subscribe ack for topic: ${topicName}`));
   117→        }, 5000);
   118→
   119→        const original = ws.onmessage;
   120→        ws.onmessage = (event) => {
   121→          try {
   122→            const data = JSON.parse(event.data);
   123→            if (data.ack === true && data.success) {
   124→              clearTimeout(timeout);
   125→              ws.onmessage = original;
   126→              resolve();
   127→              return;
   128→            }
   129→          } catch {
   130→            // not JSON
   131→          }
   132→          if (original) original.call(ws, event);
   133→        };
   134→
   135→        ws.send(
   136→          JSON.stringify({
   137→            action: 'subscribe',
   138→            request_id: `sub-${topicName}-${Date.now()}`,
   139→            payload: { topics: [topicName] },
   140→          })
   141→        );
   142→      });
   143→    },
   144→    { topicName: topic }
   145→  );
   146→}
   147→
   148→/**
   149→ * Wait for a broadcast event on a specific topic.
   150→ * Must call subscribeTopic() before this.
   151→ */
   152→async function waitForBroadcast(
   153→  page: import('@playwright/test').Page,
   154→  topic: string,
   155→  timeoutMs = 10000
   156→): Promise<{
   157→  msg_id: string;
   158→  seq: number;
   159→  timestamp: string;
   160→  topic: string;
   161→  event: string;
   162→  data: unknown;
   163→}> {
   164→  return page.evaluate(
   165→    ({ expectedTopic, waitMs }: { expectedTopic: string; waitMs: number }) => {
   166→      return new Promise<{
   167→        msg_id: string;
   168→        seq: number;
   169→        timestamp: string;
   170→        topic: string;
   171→        event: string;
   172→        data: unknown;
   173→      }>((resolve, reject) => {
   174→        const ws = (window as unknown as Record<string, WebSocket>).__testWs;
   175→        if (!ws || ws.readyState !== WebSocket.OPEN) {
   176→          reject(new Error('WebSocket not connected'));
   177→          return;
   178→        }
   179→
   180→        const timeout = setTimeout(() => {
   181→          reject(
   182→            new Error(
   183→              `Timed out after ${waitMs}ms waiting for broadcast on topic: ${expectedTopic}`
   184→            )
   185→          );
   186→        }, waitMs);
   187→
   188→        const original = ws.onmessage;
   189→        ws.onmessage = (event) => {
   190→          try {
   191→            const data = JSON.parse(event.data);
   192→            // Broadcast events: msg_id, seq, timestamp, topic, event, data
   193→            if (data.topic === expectedTopic && data.msg_id) {
   194→              clearTimeout(timeout);
   195→              ws.onmessage = original;
   196→              resolve(data);
   197→              return;
   198→            }
   199→          } catch {
   200→            // not JSON or wrong format
   201→          }
   202→          if (original) original.call(ws, event);
   203→        };
   204→      });
   205→    },
   206→    { expectedTopic: topic, waitMs: timeoutMs }
   207→  );
   208→}
   209→
   210→/**
   211→ * Count broadcasts on a topic received within a time window.
   212→ * The window starts immediately when this promise is created.
   213→ */
   214→async function countBroadcasts(
   215→  page: import('@playwright/test').Page,
   216→  topic: string,
   217→  windowMs: number
   218→): Promise<number> {
   219→  return page.evaluate(
   220→    ({ expectedTopic, durationMs }: { expectedTopic: string; durationMs: number }) => {
   221→      return new Promise<number>((resolve) => {
   222→        const ws = (window as unknown as Record<string, WebSocket>).__testWs;
   223→        if (!ws || ws.readyState !== WebSocket.OPEN) {
   224→          resolve(0);
   225→          return;
   226→        }
   227→
   228→        let count = 0;
   229→        const original = ws.onmessage;
   230→
   231→        ws.onmessage = (event) => {
   232→          try {
   233→            const data = JSON.parse(event.data);
   234→            if (data.topic === expectedTopic && data.msg_id) {
   235→              count++;
   236→            }
   237→          } catch {
   238→            // ignore
   239→          }
   240→          if (original) original.call(ws, event);
   241→        };
   242→
   243→        setTimeout(() => {
   244→          ws.onmessage = original;
   245→          resolve(count);
   246→        }, durationMs);
   247→      });
   248→    },
   249→    { expectedTopic: topic, durationMs: windowMs }
   250→  );
   251→}
   252→
