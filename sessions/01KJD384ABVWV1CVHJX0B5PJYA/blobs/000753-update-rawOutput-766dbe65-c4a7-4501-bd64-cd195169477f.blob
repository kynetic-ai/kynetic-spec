   272→        }
   273→
   274→        const timeout = setTimeout(() => {
   275→          reject(new Error('Timed out waiting for files:errors broadcast'));
   276→        }, waitMs);
   277→
   278→        const original = ws.onmessage;
   279→        ws.onmessage = (event) => {
   280→          try {
   281→            const data = JSON.parse(event.data);
   282→            if (data.topic === 'files:errors' && data.msg_id) {
   283→              clearTimeout(timeout);
   284→              ws.onmessage = original;
   285→              resolve(data);
