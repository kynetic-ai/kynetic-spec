   299→test.describe('File Watcher API', () => {
   300→  // Skip all file watcher tests in CI — GitHub Actions does not support recursive fs.watch.
   301→  // The CI environment's Chokidar fallback doesn't reliably emit events, causing flaky tests.
   302→  // Tests pass locally where native fs.watch with recursive mode works correctly.
   303→  test.beforeEach(async ({}, testInfo) => {
   304→    if (process.env.CI) {
   305→      testInfo.skip(
   306→        true,
   307→        'File watcher tests skip in CI — GitHub Actions does not support recursive fs.watch'
   308→      );
   309→    }
   310→  });
   311→
   312→  test.beforeEach(async ({ page }) => {
   313→    await connectWebSocket(page);
   314→  });
   315→
   316→  // AC: @daemon-server ac-4
   317→  test('broadcasts files:updates when a YAML file in .kspec is modified', async ({
   318→    page,
   319→    daemon,
   320→  }) => {
   321→    await subscribeTopic(page, 'files:updates');
   322→
   323→    // Set up broadcast listener BEFORE modifying the file to avoid race conditions
   324→    const broadcastPromise = waitForBroadcast(page, 'files:updates');
   325→
   326→    // Modify a YAML file directly in the daemon's .kspec directory
   327→    const targetFile = join(daemon.kspecDir, 'kynetic.yaml');
   328→    writeFileSync(
   329→      targetFile,
   330→      [
   331→        'kynetic: "1.0"',
   332→        '',
   333→        'project:',
   334→        '  name: "E2E Watcher Test Project"',
   335→        '  version: "0.2.0"',
   336→        '  status: draft',
   337→        '  description: Modified by file watcher E2E test',
   338→        '',
   339→      ].join('\n')
   340→    );
   341→
   342→    // Wait for watcher to debounce and broadcast
   343→    const broadcast = await broadcastPromise;
   344→
   345→    // AC: @daemon-server ac-4 — file change triggers WebSocket broadcast with correct structure
   346→    expect(broadcast).toHaveProperty('msg_id');
   347→    expect(typeof broadcast.msg_id).toBe('string');
   348→    expect(broadcast.msg_id.length).toBeGreaterThan(0);
   349→
   350→    expect(broadcast.topic).toBe('files:updates');
   351→
   352→    expect(broadcast).toHaveProperty('seq');
   353→    expect(typeof broadcast.seq).toBe('number');
   354→    expect(broadcast.seq).toBeGreaterThan(0);
   355→
   356→    expect(broadcast).toHaveProperty('timestamp');
   357→    expect(typeof broadcast.timestamp).toBe('string');
   358→    expect(isNaN(new Date(broadcast.timestamp as string).getTime())).toBe(false);
   359→
   360→    expect(broadcast).toHaveProperty('event');
   361→    expect(typeof broadcast.event).toBe('string');
   362→
   363→    expect(broadcast).toHaveProperty('data');
   364→  });
   365→
   366→  // AC: @daemon-server ac-4
   367→  test('file change via HTTP API mutation triggers watcher broadcast', async ({
   368→    page,
   369→    daemon,
   370→    request,
   371→  }) => {
   372→    await subscribeTopic(page, 'files:updates');
   373→
   374→    // Get a task from the fixture
   375→    const tasksResponse = await request.get(`${DAEMON_HTTP_URL}/api/tasks`);
   376→    const tasksBody = await tasksResponse.json();
   377→    expect(tasksBody.items.length).toBeGreaterThan(0);
   378→    const taskRef = tasksBody.items[0]._ulid;
   379→
   380→    // Set up listener before triggering mutation
   381→    const broadcastPromise = waitForBroadcast(page, 'files:updates');
   382→
   383→    // Add a note via HTTP API — daemon writes to project.tasks.yaml, watcher detects it
   384→    const noteResponse = await request.post(`${DAEMON_HTTP_URL}/api/tasks/${taskRef}/note`, {
   385→      data: {
   386→        content: 'E2E file watcher detection test note',
   387→        author: '@test',
   388→      },
   389→    });
   390→    expect(noteResponse.status()).toBe(200);
   391→
   392→    // AC: @daemon-server ac-4 — broadcast received after API-triggered file change
   393→    const broadcast = await broadcastPromise;
   394→    expect(broadcast.topic).toBe('files:updates');
   395→    expect(broadcast).toHaveProperty('msg_id');
   396→  });
   397→
   398→  // AC: @daemon-server ac-5
   399→  test('rapid successive file changes are debounced — fewer broadcasts than writes', async ({
   400→    page,
   401→    daemon,
   402→  }) => {
   403→    await subscribeTopic(page, 'files:updates');
   404→
   405→    const targetFile = join(daemon.kspecDir, 'kynetic.yaml');
   406→    const base = [
   407→      'kynetic: "1.0"',
   408→      '',
   409→      'project:',
   410→      '  name: "Debounce Test"',
   411→      '  version: "0.1.0"',
   412→      '  status: draft',
   413→    ].join('\n');
   414→
   415→    // Start counting broadcasts in a 2-second window, then make rapid writes
   416→    // Both the counter and the writes start near-simultaneously
   417→    const countingPromise = countBroadcasts(page, 'files:updates', 2000);
   418→
   419→    // 3 rapid writes within ~120ms — all within the 500ms debounce window
   420→    writeFileSync(targetFile, base + '\n  description: rapid write 1\n');
   421→    await new Promise((r) => setTimeout(r, 40));
   422→    writeFileSync(targetFile, base + '\n  description: rapid write 2\n');
   423→    await new Promise((r) => setTimeout(r, 40));
   424→    writeFileSync(targetFile, base + '\n  description: rapid write 3\n');
   425→
   426→    // Wait for counting window to complete
   427→    const broadcastCount = await countingPromise;
   428→
   429→    // AC: @daemon-server ac-5 — debounce collapses rapid writes into fewer broadcasts
   430→    // Ideal: 1 broadcast. Allow up to 2 for timing edge cases.
   431→    expect(broadcastCount).toBeGreaterThanOrEqual(1); // At least one change was detected
   432→    expect(broadcastCount).toBeLessThanOrEqual(2); // Debounce prevented 3 separate broadcasts
   433→  });
   434→
   435→  // AC: @daemon-server ac-5
   436→  test('no second broadcast arrives within 400ms after debounced rapid writes', async ({
   437→    page,
   438→    daemon,
   439→  }) => {
   440→    await subscribeTopic(page, 'files:updates');
   441→
   442→    const targetFile = join(daemon.kspecDir, 'kynetic.yaml');
   443→    const base = [
   444→      'kynetic: "1.0"',
   445→      '',
   446→      'project:',
   447→      '  name: "Debounce Verify"',
   448→      '  version: "0.1.0"',
   449→      '  status: draft',
   450→    ].join('\n');
   451→
   452→    // 3 rapid writes within ~100ms — all within 500ms debounce
   453→    writeFileSync(targetFile, base + '\n  description: write A\n');
   454→    await new Promise((r) => setTimeout(r, 40));
   455→    writeFileSync(targetFile, base + '\n  description: write B\n');
   456→    await new Promise((r) => setTimeout(r, 40));
   457→    writeFileSync(targetFile, base + '\n  description: write C\n');
   458→
   459→    // The debounce fires 500ms after the last write (write C + 500ms)
   460→    // Wait for the first (debounced) broadcast
   461→    const firstBroadcast = await waitForBroadcast(page, 'files:updates');
   462→
   463→    // AC: @daemon-server ac-5 — debounced broadcast arrives
   464→    expect(firstBroadcast.topic).toBe('files:updates');
   465→    expect(firstBroadcast).toHaveProperty('msg_id');
   466→
   467→    // Verify no additional broadcast arrives in the next 400ms
   468→    // (400ms < 500ms debounce, so any lingering timer would have fired by now)
   469→    const extraCount = await countBroadcasts(page, 'files:updates', 400);
   470→    expect(extraCount).toBe(0);
   471→  });
   472→
   473→  // AC: @daemon-server ac-6
   474→  test('YAML parse error does not crash daemon — broadcasts error event on files:errors', async ({
   475→    page,
   476→    daemon,
   477→    request,
   478→  }) => {
   479→    await subscribeTopic(page, 'files:updates');
   480→    await subscribeTopic(page, 'files:errors');
   481→
   482→    const targetFile = join(daemon.kspecDir, 'kynetic.yaml');
   483→    // Write invalid YAML that will fail to parse
   484→    const invalidYaml = [
   485→      'kynetic: "1.0"',
   486→      '{ invalid yaml: [unclosed bracket',
   487→      '  bad indentation:',
   488→    ].join('\n');
   489→
   490→    // Set up error listener before writing the bad file
   491→    const errorBroadcastPromise = waitForErrorBroadcast(page);
   492→
   493→    writeFileSync(targetFile, invalidYaml);
   494→
   495→    // Wait for the error broadcast
   496→    const errorBroadcast = await errorBroadcastPromise;
   497→
   498→    // AC: @daemon-server ac-6 — error event is broadcast with correct structure
   499→    expect(errorBroadcast.topic).toBe('files:errors');
   500→    expect(errorBroadcast.event).toBe('file_error');
   501→    expect(errorBroadcast).toHaveProperty('msg_id');
   502→    expect(errorBroadcast.data).toHaveProperty('error');
   503→    expect(typeof errorBroadcast.data.error).toBe('string');
   504→    expect(errorBroadcast.data.error.length).toBeGreaterThan(0);
   505→
   506→    // AC: @daemon-server ac-6 — daemon did NOT crash, still responds to health check
   507→    const healthResponse = await request.get(`${DAEMON_HTTP_URL}/api/health`);
   508→    expect(healthResponse.status()).toBe(200);
   509→    const health = await healthResponse.json();
   510→    expect(health.status).toBe('ok');
   511→  });
