   513→  // AC: @daemon-server ac-6
   514→  test('daemon recovers after YAML parse error and processes subsequent valid file change', async ({
   515→    page,
   516→    daemon,
   517→    request,
   518→  }) => {
   519→    await subscribeTopic(page, 'files:updates');
   520→    await subscribeTopic(page, 'files:errors');
   521→
   522→    const targetFile = join(daemon.kspecDir, 'kynetic.yaml');
   523→
   524→    // Step 1: Write invalid YAML — should broadcast error, not crash
   525→    const errorPromise = waitForErrorBroadcast(page);
   526→    writeFileSync(targetFile, 'kynetic: "1.0"\n{ invalid: [unclosed\n');
   527→    await errorPromise; // Confirm error was detected and broadcast (watcher still active)
   528→
   529→    // Step 2: Fix the file with valid YAML — watcher should resume processing normally
   530→    const recoveryPromise = waitForBroadcast(page, 'files:updates');
   531→    writeFileSync(
   532→      targetFile,
   533→      [
   534→        'kynetic: "1.0"',
   535→        '',
   536→        'project:',
   537→        '  name: "Recovered Project"',
   538→        '  version: "0.1.0"',
   539→        '  status: draft',
   540→        '  description: Recovered after YAML parse error',
   541→        '',
   542→      ].join('\n')
   543→    );
   544→    const recoveryBroadcast = await recoveryPromise;
   545→
   546→    // AC: @daemon-server ac-6 — daemon processes valid file after error (not crashed/frozen)
   547→    expect(recoveryBroadcast.topic).toBe('files:updates');
   548→    expect(recoveryBroadcast).toHaveProperty('msg_id');
   549→
   550→    // Final health check
   551→    const healthResponse = await request.get(`${DAEMON_HTTP_URL}/api/health`);
