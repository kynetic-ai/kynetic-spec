```
     1→<!--
     2→  AC: @ui-task-board ac-3 — Task detail modal with full task info.
     3→  AC: @ui-task-board ac-6 — Action buttons: Start, Submit, Complete, Block, Add Note.
     4→-->
     5→<script lang="ts">
     6→	import type { TaskDetail } from '@kynetic-ai/shared';
     7→	import { base } from '$app/paths';
     8→	import {
     9→		fetchTask,
    10→		startTask,
    11→		submitTask,
    12→		completeTask,
    13→		blockTask,
    14→		addTaskNote
    15→	} from '$lib/api';
    16→	import { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';
    17→	import * as Dialog from '$lib/components/ui/dialog';
    18→	import { Badge } from '$lib/components/ui/badge';
    19→	import { Button } from '$lib/components/ui/button';
    20→	import { Textarea } from '$lib/components/ui/textarea';
    21→	import { Input } from '$lib/components/ui/input';
    22→	import { Separator } from '$lib/components/ui/separator';
    23→	import { Skeleton } from '$lib/components/ui/skeleton';
    24→	import { getStatusClasses, formatAge, formatVcsRef } from './board-utils';
    25→	import GitBranch from '@lucide/svelte/icons/git-branch';
    26→	import ExternalLink from '@lucide/svelte/icons/external-link';
    27→
    28→	let {
    29→		open = $bindable(false),
    30→		taskRef = $bindable<string | null>(null),
    31→		onTaskUpdated
    32→	}: {
    33→		open?: boolean;
    34→		taskRef?: string | null;
    35→		onTaskUpdated?: () => void;
    36→	} = $props();
    37→
    38→	let task = $state<TaskDetail | null>(null);
    39→	let loading = $state(false);
    40→	let error = $state('');
    41→	let actionError = $state('');
    42→	let isSubmitting = $state(false);
    43→
    44→	// Note form
    45→	let noteContent = $state('');
    46→
    47→	// Block/Complete reason form
    48→	let reasonInput = $state('');
    49→	let showReasonFor = $state<'block' | 'complete' | null>(null);
    50→
    51→	$effect(() => {
    52→		if (open && taskRef) {
    53→			loadTask(taskRef);
    54→		} else if (!open) {
    55→			task = null;
    56→			error = '';
    57→			actionError = '';
    58→			noteContent = '';
    59→			reasonInput = '';
    60→			showReasonFor = null;
    61→		}
    62→	});
    63→
    64→	async function loadTask(ref: string) {
    65→		loading = true;
    66→		error = '';
    67→		try {
    68→			task = await fetchTask(ref);
    69→		} catch (err) {
    70→			error = err instanceof Error ? err.message : 'Failed to load task';
    71→		} finally {
    72→			loading = false;
    73→		}
    74→	}
    75→
    76→	async function reloadAndNotify() {
    77→		if (task) {
    78→			task = await fetchTask(task._ulid);
    79→		}
    80→		onTaskUpdated?.();
    81→	}
    82→
    83→	async function handleAction(action: () => Promise<void>) {
    84→		isSubmitting = true;
    85→		actionError = '';
    86→		try {
    87→			await action();
    88→			await reloadAndNotify();
    89→		} catch (err) {
    90→			if (err instanceof ReadOnlyModeError) {
    91→				actionError = err.message;
    92→			} else {
    93→				actionError = err instanceof Error ? err.message : 'Action failed';
    94→			}
    95→		} finally {
    96→			isSubmitting = false;
    97→		}
    98→	}
    99→
   100→	function handleStart() {
   101→		if (!task) return;
   102→		handleAction(() => startTask(task!._ulid));
   103→	}
   104→
   105→	function handleSubmit() {
   106→		if (!task) return;
   107→		handleAction(() => submitTask(task!._ulid));
   108→	}
   109→
   110→	function handleComplete() {
   111→		if (!task || !reasonInput.trim()) return;
   112→		const reason = reasonInput.trim();
   113→		handleAction(async () => {
   114→			await completeTask(task!._ulid, reason);
   115→			reasonInput = '';
   116→			showReasonFor = null;
   117→		});
   118→	}
   119→
   120→	function handleBlock() {
   121→		if (!task || !reasonInput.trim()) return;
   122→		const reason = reasonInput.trim();
   123→		handleAction(async () => {
   124→			await blockTask(task!._ulid, reason);
   125→			reasonInput = '';
   126→			showReasonFor = null;
   127→		});
   128→	}
   129→
   130→	function handleAddNote() {
   131→		if (!task || !noteContent.trim()) return;
   132→		const content = noteContent.trim();
   133→		handleAction(async () => {
   134→			await addTaskNote(task!._ulid, content);
   135→			noteContent = '';
   136→		});
   137→	}
   138→
   139→	function formatDate(dateStr: string): string {
   140→		return new Intl.DateTimeFormat('en-US', {
   141→			month: 'short',
   142→			day: 'numeric',
   143→			hour: '2-digit',
   144→			minute: '2-digit'
   145→		}).format(new Date(dateStr));
   146→	}
   147→
   148→	let statusInfo = $derived(task ? getStatusClasses(task.status) : null);
   149→	let slug = $derived(task?.slugs?.[0] ?? task?._ulid?.slice(0, 8) ?? '');
   150→</script>
   151→
   152→<Dialog.Root bind:open>
   153→	<Dialog.Content class="max-w-2xl max-h-[85vh] overflow-y-auto" data-testid="task-detail-modal">
   154→		{#if loading}
   155→			<div class="flex flex-col gap-4 py-4" data-testid="task-detail-skeleton">
   156→				<!-- Title skeleton -->
   157→				<Skeleton class="h-6 w-3/4 ds-shimmer" />
   158→				<Skeleton class="h-3 w-24 ds-shimmer" />
   159→
   160→				<!-- Status/priority badges skeleton -->
   161→				<div class="flex gap-2">
   162→					<Skeleton class="h-5 w-20 rounded-full ds-shimmer" />
   163→					<Skeleton class="h-5 w-24 rounded-full ds-shimmer" />
   164→				</div>
   165→
   166→				<!-- Spec ref skeleton -->
   167→				<div>
   168→					<Skeleton class="h-3 w-10 mb-1 ds-shimmer" />
   169→					<Skeleton class="h-4 w-32 ds-shimmer" />
   170→				</div>
   171→
   172→				<!-- Tags skeleton -->
   173→				<div class="flex gap-1">
   174→					<Skeleton class="h-5 w-12 rounded-full ds-shimmer" />
   175→					<Skeleton class="h-5 w-16 rounded-full ds-shimmer" />
   176→				</div>
   177→
   178→				<!-- Separator -->
   179→				<Skeleton class="h-px w-full ds-shimmer" />
   180→
   181→				<!-- Notes skeleton -->
   182→				<div>
   183→					<Skeleton class="h-3 w-16 mb-2 ds-shimmer" />
   184→					<Skeleton class="h-16 w-full rounded-md ds-shimmer" />
   185→				</div>
   186→			</div>
   187→		{:else if error}
   188→			<div class="bg-destructive/10 text-destructive p-4 rounded-lg" role="alert">
   189→				{error}
   190→			</div>
   191→		{:else if task && statusInfo}
   192→			<Dialog.Header>
   193→				<Dialog.Title data-testid="modal-task-title">{task.title}</Dialog.Title>
   194→				<Dialog.Description>
   195→					<span class="font-mono text-xs">@{slug}</span>
   196→				</Dialog.Description>
   197→			</Dialog.Header>
   198→
   199→			<div class="flex flex-col gap-4">
   200→				<!-- AC: @ui-task-board ac-3 — Description -->
   201→				{#if task.description}
   202→					<p class="text-sm text-muted-foreground" data-testid="modal-description">
   203→						{task.description}
   204→					</p>
   205→				{/if}
   206→
   207→				<!-- Status, priority, type -->
   208→				<div class="flex flex-wrap gap-2 items-center">
   209→					<Badge class="{statusInfo.bg} {statusInfo.fg}" data-testid="modal-status-badge">
   210→						{statusInfo.label}
   211→					</Badge>
   212→					<Badge variant="outline" data-testid="modal-priority">Priority {task.priority}</Badge>
   213→					{#if task.type !== 'task'}
   214→						<Badge variant="outline">{task.type}</Badge>
   215→					{/if}
   216→					{#if task.automation}
   217→						<Badge variant="secondary" data-testid="modal-automation">
   218→							{task.automation}
   219→						</Badge>
   220→					{/if}
   221→				</div>
   222→
   223→				<!-- Spec ref -->
   224→				{#if task.spec_ref}
   225→					<div data-testid="modal-spec-ref">
   226→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Spec</p>
   227→						<a
   228→							href="{base}/specs?ref={encodeURIComponent(task.spec_ref)}"
   229→							class="text-sm text-primary hover:underline font-mono"
   230→						>
   231→							{task.spec_ref}
   232→						</a>
   233→					</div>
   234→				{/if}
   235→
   236→				<!-- Tags -->
   237→				{#if task.tags?.length > 0}
   238→					<div>
   239→						<p class="text-xs font-medium text-muted-foreground mb-1">Tags</p>
   240→						<div class="flex flex-wrap gap-1">
   241→							{#each task.tags as tag}
   242→								<Badge variant="secondary">{tag}</Badge>
   243→							{/each}
   244→						</div>
   245→					</div>
   246→				{/if}
   247→
   248→				<!-- Dependencies -->
   249→				{#if task.depends_on?.length > 0}
   250→					<div data-testid="modal-dependencies">
   251→						<p class="text-xs font-medium text-muted-foreground mb-1">Dependencies</p>
   252→						<ul class="text-sm space-y-0.5">
   253→							{#each task.depends_on as dep}
   254→								<li>
   255→									<a
   256→										href="{base}/tasks/board?ref={encodeURIComponent(dep)}"
   257→										class="text-primary hover:underline font-mono text-xs"
   258→									>
   259→										{dep}
   260→									</a>
   261→								</li>
   262→							{/each}
   263→						</ul>
   264→					</div>
   265→				{/if}
   266→
   267→				<!-- Blocked by -->
   268→				{#if task.blocked_by?.length > 0}
   269→					<div data-testid="modal-blocked-by">
   270→						<p class="text-xs font-medium text-destructive mb-1">Blocked By</p>
   271→						<ul class="text-sm space-y-0.5">
   272→							{#each task.blocked_by as blocker}
   273→								<li class="text-muted-foreground font-mono text-xs">{blocker}</li>
   274→							{/each}
   275→						</ul>
   276→					</div>
   277→				{/if}
   278→
   279→				<!-- AC: @ui-task-board ac-3 — VCS info (branch, PR link) -->
   280→				{#if task.vcs_refs?.length > 0}
   281→					<div data-testid="modal-vcs">
   282→						<p class="text-xs font-medium text-muted-foreground mb-1">VCS</p>
   283→						<ul class="text-sm space-y-1">
   284→							{#each task.vcs_refs as ref}
   285→								{@const vcsInfo = formatVcsRef(ref)}
   286→								<li class="flex items-center gap-1.5">
   287→									<GitBranch class="size-3 text-muted-foreground flex-shrink-0" />
   288→									{#if vcsInfo.url}
   289→										<a
   290→											href={vcsInfo.url}
   291→											target="_blank"
   292→											rel="noopener noreferrer"
   293→											class="text-xs text-primary hover:underline font-mono inline-flex items-center gap-1"
   294→										>
   295→											{vcsInfo.label}
   296→											<ExternalLink class="size-3" />
   297→										</a>
   298→									{:else}
   299→										<span class="text-muted-foreground font-mono text-xs">{vcsInfo.label}</span>
   300→									{/if}
   301→								</li>
   302→							{/each}
   303→						</ul>
   304→					</div>
   305→				{/if}
   306→
   307→				<!-- AC: @ui-task-board ac-3 — Plan ref -->
   308→				{#if task.plan_ref}
   309→					<div data-testid="modal-plan-ref">
   310→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Plan</p>
   311→						<span class="text-sm text-primary font-mono">{task.plan_ref}</span>
   312→					</div>
   313→				{:else if task.derivation}
   314→					<div data-testid="modal-plan-ref">
   315→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Derivation</p>
   316→						<p class="text-sm text-muted-foreground">{task.derivation}</p>
   317→					</div>
   318→				{/if}
   319→
   320→				<!-- AC: @ui-task-board ac-3 — Session link -->
   321→				{#if task.session_ref}
   322→					<div data-testid="modal-session-link">
   323→						<p class="text-xs font-medium text-muted-foreground mb-0.5">Session</p>
   324→						<a
   325→							href="{base}/session?ref={encodeURIComponent(task.session_ref)}"
   326→							class="text-sm text-primary hover:underline font-mono"
   327→						>
   328→							{task.session_ref}
   329→						</a>
   330→					</div>
   331→				{/if}
   332→
   333→				<Separator />
   334→
   335→				<!-- AC: @ui-task-board ac-6 — Actions -->
   336→				{#if !isStaticMode()}
   337→					<div class="flex flex-wrap gap-2" data-testid="modal-actions">
   338→						{#if task.status === 'pending'}
   339→							<Button
   340→								size="sm"
   341→								onclick={handleStart}
   342→								disabled={isSubmitting}
   343→								data-testid="action-start"
   344→							>
   345→								{isSubmitting ? 'Starting...' : 'Start'}
   346→							</Button>
   347→						{/if}
   348→
   349→						{#if task.status === 'in_progress' || task.status === 'needs_work'}
   350→							<Button
   351→								size="sm"
   352→								onclick={handleSubmit}
   353→								disabled={isSubmitting}
   354→								data-testid="action-submit"
   355→							>
   356→								{isSubmitting ? 'Submitting...' : 'Submit for Review'}
   357→							</Button>
   358→						{/if}
   359→
   360→						{#if task.status === 'in_progress' || task.status === 'pending_review'}
   361→							<Button
   362→								size="sm"
   363→								variant="outline"
   364→								onclick={() => {
   365→									showReasonFor = 'complete';
   366→									reasonInput = '';
   367→								}}
   368→								disabled={isSubmitting}
   369→								data-testid="action-complete-toggle"
   370→							>
   371→								Complete
   372→							</Button>
   373→						{/if}
   374→
   375→						{#if task.status !== 'blocked' && task.status !== 'completed' && task.status !== 'cancelled'}
   376→							<Button
   377→								size="sm"
   378→								variant="destructive"
   379→								onclick={() => {
   380→									showReasonFor = 'block';
   381→									reasonInput = '';
   382→								}}
   383→								disabled={isSubmitting}
   384→								data-testid="action-block-toggle"
   385→							>
   386→								Block
   387→							</Button>
   388→						{/if}
   389→					</div>
   390→
   391→					<!-- Reason input for block/complete -->
   392→					{#if showReasonFor}
   393→						<div class="flex gap-2" data-testid="reason-input">
   394→							<Input
   395→								bind:value={reasonInput}
   396→								placeholder="{showReasonFor === 'block' ? 'Block' : 'Completion'} reason..."
   397→								class="flex-1"
   398→							/>
   399→							<Button
   400→								size="sm"
   401→								onclick={showReasonFor === 'block' ? handleBlock : handleComplete}
   402→								disabled={isSubmitting || !reasonInput.trim()}
   403→							>
   404→								Confirm
   405→							</Button>
   406→							<Button
   407→								size="sm"
   408→								variant="ghost"
   409→								onclick={() => {
   410→									showReasonFor = null;
   411→									reasonInput = '';
   412→								}}
   413→							>
   414→								Cancel
   415→							</Button>
   416→						</div>
   417→					{/if}
   418→				{/if}
   419→
   420→				{#if actionError}
   421→					<p class="text-sm text-destructive" data-testid="action-error">{actionError}</p>
   422→				{/if}
   423→
   424→				<Separator />
   425→
   426→				<!-- Todos -->
   427→				{#if task.todos && task.todos.length > 0}
   428→					<div data-testid="modal-todos">
   429→						<p class="text-xs font-medium text-muted-foreground mb-1">
   430→							Todos ({task.todos.length})
   431→						</p>
   432→						<ul class="space-y-1">
   433→							{#each task.todos as todo}
   434→								<li class="flex items-start gap-2 text-sm">
   435→									<span class="mt-0.5 text-xs">
   436→										{#if todo.status === 'completed'}
   437→											&#x2705;
   438→										{:else if todo.status === 'in_progress'}
   439→											&#x23F3;
   440→										{:else}
   441→											&#x23F8;&#xFE0F;
   442→										{/if}
   443→									</span>
   444→									<span class:line-through={todo.status === 'completed'}>
   445→										{todo.content}
   446→									</span>
   447→								</li>
   448→							{/each}
   449→						</ul>
   450→					</div>
   451→					<Separator />
   452→				{/if}
   453→
   454→				<!-- Notes -->
   455→				<div data-testid="modal-notes">
   456→					<p class="text-xs font-medium text-muted-foreground mb-2">
   457→						Notes ({task.notes?.length ?? 0})
   458→					</p>
   459→
   460→					<!-- Add Note form -->
   461→					{#if !isStaticMode()}
   462→						<div class="mb-3 space-y-2" data-testid="modal-add-note">
   463→							<Textarea
   464→								placeholder="Add a note..."
   465→								bind:value={noteContent}
   466→								disabled={isSubmitting}
   467→								rows={2}
   468→							/>
   469→							<Button
   470→								size="sm"
   471→								onclick={handleAddNote}
   472→								disabled={isSubmitting || !noteContent.trim()}
   473→								data-testid="action-add-note"
   474→							>
   475→								{isSubmitting ? 'Adding...' : 'Add Note'}
   476→							</Button>
   477→						</div>
   478→					{/if}
   479→
   480→					<!-- Notes list -->
   481→					<div class="space-y-3">
   482→						{#if (task.notes ?? []).length === 0}
   483→							<div class="text-center py-4 text-muted-foreground text-xs" data-testid="notes-empty">
   484→								{#if isStaticMode()}
   485→									No notes recorded. Use <code class="bg-muted px-1 rounded">kspec task note</code> to add context.
   486→								{:else}
   487→									Add a note above to document decisions, progress, or findings.
   488→								{/if}
   489→							</div>
   490→						{:else}
   491→							{#each task.notes ?? [] as note}
   492→								<div class="border rounded-md p-2.5" data-testid="note-item">
   493→									<div class="flex justify-between items-start mb-1">
   494→										<span class="text-[10px] text-muted-foreground">{note.author}</span>
   495→										<span class="text-[10px] text-muted-foreground">{formatDate(note.created_at)}</span>
   496→									</div>
   497→									<p class="text-sm whitespace-pre-wrap">{note.content}</p>
   498→								</div>
   499→							{/each}
   500→						{/if}
   501→					</div>
   502→				</div>
   503→			</div>
   504→		{/if}
   505→	</Dialog.Content>
   506→</Dialog.Root>
   507→
```