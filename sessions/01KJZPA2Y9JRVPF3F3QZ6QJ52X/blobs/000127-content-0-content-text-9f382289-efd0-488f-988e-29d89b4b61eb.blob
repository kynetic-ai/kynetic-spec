```
     1→/**
     2→ * Task API Routes
     3→ *
     4→ * REST endpoints for task operations:
     5→ * - GET /api/tasks - list with filters and pagination
     6→ * - GET /api/tasks/:ref - get single task
     7→ * - POST /api/tasks/:ref/start - start task
     8→ * - POST /api/tasks/:ref/note - add note
     9→ *
    10→ * AC Coverage:
    11→ * - ac-2: GET /api/tasks returns array with status, priority, spec_ref, notes count
    12→ * - ac-3: Status filter with multi-value support
    13→ * - ac-4: Pagination with {items, total, offset, limit} wrapper
    14→ * - ac-5: GET /api/tasks/:ref resolves via ReferenceIndex
    15→ * - ac-6: POST /api/tasks/:ref/start transitions state
    16→ * - ac-7: POST /api/tasks/:ref/note appends note
    17→ * - @ui-task-board ac-6: POST /api/tasks/:ref/submit transitions to pending_review
    18→ * - @ui-task-board ac-6: POST /api/tasks/:ref/complete transitions to completed
    19→ * - @ui-task-board ac-6: POST /api/tasks/:ref/block transitions to blocked
    20→ */
    21→
    22→import { Elysia, t } from 'elysia';
    23→import {
    24→  initContext,
    25→  loadAllTasks,
    26→  loadAllItems,
    27→  ReferenceIndex,
    28→  createNote,
    29→  saveTask,
    30→  getAuthor,
    31→  syncSpecImplementationStatus,
    32→  type LoadedTask,
    33→} from '../../parser/index.js';
    34→import { commitIfShadow } from '../../parser/shadow.js';
    35→import type { PubSubManager } from '../websocket/pubsub';
    36→
    37→interface TasksRouteOptions {
    38→  pubsub: PubSubManager;
    39→}
    40→
    41→export function createTasksRoutes(options: TasksRouteOptions) {
    42→  const { pubsub } = options;
    43→
    44→  return new Elysia({ prefix: '/api/tasks' })
    45→    // AC: @api-contract ac-2, ac-3, ac-4 - List tasks with filters and pagination
    46→    .get(
    47→      '/',
    48→      async ({ query, projectContext }) => {
    49→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
    50→        const ctx = await initContext(projectContext.path);
    51→        const tasks = await loadAllTasks(ctx);
    52→        const specItems = await loadAllItems(ctx);
    53→        const index = new ReferenceIndex(tasks, specItems);
    54→
    55→        // Apply filters
    56→        let filtered = tasks;
    57→
    58→        // AC: @api-contract ac-3 - Multi-value status filter
    59→        if (query.status) {
    60→          const statusFilters = Array.isArray(query.status) ? query.status : [query.status];
    61→          filtered = filtered.filter((task) => statusFilters.includes(task.status));
    62→        }
    63→
    64→        // Type filter (optional, not in ACs but useful)
    65→        if (query.type) {
    66→          const typeFilters = Array.isArray(query.type) ? query.type : [query.type];
    67→          filtered = filtered.filter((task) => task.type && typeFilters.includes(task.type));
    68→        }
    69→
    70→        // Tag filter (optional, not in ACs but useful)
    71→        if (query.tag) {
    72→          const tagFilters = Array.isArray(query.tag) ? query.tag : [query.tag];
    73→          filtered = filtered.filter((task) =>
    74→            task.tags?.some((t) => tagFilters.includes(t))
    75→          );
    76→        }
    77→
    78→        // AC: @api-contract ac-4 - Pagination
    79→        const total = filtered.length;
    80→        const offset = Number(query.offset) || 0;
    81→        const limit = Number(query.limit) || total;
    82→
    83→        const paginated = filtered.slice(offset, offset + limit);
    84→
    85→        // AC: @api-contract ac-2 - Return with status, priority, spec_ref, notes count
    86→        // AC: @web-dashboard ac-1 - Include depends_on for blocked task computation
    87→        const items = paginated.map((task) => ({
    88→          _ulid: task._ulid,
    89→          slugs: task.slugs,
    90→          title: task.title,
    91→          status: task.status,
    92→          priority: task.priority,
    93→          spec_ref: task.spec_ref,
    94→          meta_ref: task.meta_ref,
    95→          tags: task.tags,
    96→          depends_on: task.depends_on || [],
    97→          notes_count: task.notes?.length || 0,
    98→          todos_count: task.todos?.length || 0,
    99→          automation: task.automation,
   100→          started_at: task.started_at,
   101→          completed_at: task.completed_at,
   102→          created_at: task.created_at,
   103→        }));
   104→
   105→        // AC: @api-contract ac-4, @trait-api-endpoint ac-4 - Return pagination wrapper
   106→        return {
   107→          items,
   108→          total,
   109→          offset,
   110→          limit,
   111→        };
   112→      },
   113→      {
   114→        query: t.Object({
   115→          status: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   116→          type: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   117→          tag: t.Optional(t.Union([t.String(), t.Array(t.String())])),
   118→          limit: t.Optional(t.String()),
   119→          offset: t.Optional(t.String()),
   120→        }),
   121→      }
   122→    )
   123→
   124→    // AC: @api-contract ac-5 - Get single task by ref
   125→    .get(
   126→      '/:ref',
   127→      async ({ params, error: errorResponse, projectContext }) => {
   128→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   129→        const ctx = await initContext(projectContext.path);
   130→        const tasks = await loadAllTasks(ctx);
   131→        const items = await loadAllItems(ctx);
   132→        const index = new ReferenceIndex(tasks, items);
   133→
   134→        // AC: @api-contract ac-5, @trait-api-endpoint ac-2 - Resolve ref via ReferenceIndex
   135→        const result = index.resolve(params.ref);
   136→
   137→        if (!result.ok) {
   138→          // AC: @trait-api-endpoint ac-2 - Return 404 with error details
   139→          return errorResponse(404, {
   140→            error: 'not_found',
   141→            message: `Task reference "${params.ref}" not found`,
   142→            suggestion: 'Use kspec task list or kspec search to find valid task references',
   143→          });
   144→        }
   145→
   146→        // Find the task
   147→        const task = tasks.find((t) => t._ulid === result.ulid);
   148→        if (!task) {
   149→          return errorResponse(404, {
   150→            error: 'not_found',
   151→            message: `Reference "${params.ref}" is not a task`,
   152→            suggestion: 'This reference might point to a spec item instead',
   153→          });
   154→        }
   155→
   156→        // AC: @api-contract ac-5 - Return full task with notes, todos, dependencies
   157→        // AC: @ui-task-board ac-3 - Include description, blocked_by, vcs_refs, plan_ref, session_ref
   158→        return {
   159→          _ulid: task._ulid,
   160→          slugs: task.slugs,
   161→          title: task.title,
   162→          status: task.status,
   163→          priority: task.priority,
   164→          spec_ref: task.spec_ref,
   165→          meta_ref: task.meta_ref,
   166→          tags: task.tags,
   167→          description: task.description,
   168→          derivation: task.derivation,
   169→          depends_on: task.depends_on,
   170→          blocked_by: task.blocked_by || [],
   171→          context: task.context || [],
   172→          vcs_refs: task.vcs_refs || [],
   173→          plan_ref: task.plan_ref,
   174→          session_ref: task.session_id,
   175→          notes: task.notes,
   176→          todos: task.todos,
   177→          started_at: task.started_at,
   178→          completed_at: task.completed_at,
   179→          cancelled_at: task.cancelled_at,
   180→          closed_reason: task.closed_reason,
   181→          automation: task.automation,
   182→          created_at: task.created_at,
   183→        };
   184→      },
   185→      {
   186→        params: t.Object({
   187→          ref: t.String(),
   188→        }),
   189→      }
   190→    )
   191→
   192→    // AC: @api-contract ac-6 - Start task
   193→    .post(
   194→      '/:ref/start',
   195→      async ({ params, error: errorResponse, projectContext }) => {
   196→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   197→        const ctx = await initContext(projectContext.path);
   198→        const tasks = await loadAllTasks(ctx);
   199→        const items = await loadAllItems(ctx);
   200→        const index = new ReferenceIndex(tasks, items);
   201→
   202→        // Resolve ref
   203→        const result = index.resolve(params.ref);
   204→        if (!result.ok) {
   205→          return errorResponse(404, {
   206→            error: 'not_found',
   207→            message: `Task reference "${params.ref}" not found`,
   208→            suggestion: 'Use kspec task list to find valid task references',
   209→          });
   210→        }
   211→
   212→        const task = tasks.find((t) => t._ulid === result.ulid);
   213→        if (!task) {
   214→          return errorResponse(404, {
   215→            error: 'not_found',
   216→            message: `Reference "${params.ref}" is not a task`,
   217→          });
   218→        }
   219→
   220→        // AC: @api-contract ac-6 - Transition to in_progress
   221→        if (task.status === 'in_progress') {
   222→          return errorResponse(409, {
   223→            error: 'invalid_transition',
   224→            message: 'Task is already in_progress',
   225→            current: task.status,
   226→            valid_transitions: ['blocked', 'pending_review', 'completed', 'cancelled'],
   227→          });
   228→        }
   229→
   230→        // Update task status
   231→        const updatedTask: LoadedTask = {
   232→          ...task,
   233→          status: 'in_progress',
   234→          started_at: task.started_at || new Date().toISOString(),
   235→        };
   236→
   237→        // Save and commit
   238→        await saveTask(ctx, updatedTask);
   239→        await syncSpecImplementationStatus(ctx, updatedTask, tasks, items, index);
   240→        await commitIfShadow(ctx.shadow, `task: start ${params.ref}`);
   241→
   242→        // AC: @api-contract ac-6, @trait-api-endpoint ac-5 - WebSocket broadcast
   243→        // AC: @multi-directory-daemon ac-18 - Broadcast scoped to request project
   244→        pubsub.broadcast('tasks:updates', 'task_updated', {
   245→          ref: params.ref,
   246→          ulid: task._ulid,
   247→          action: 'start',
   248→          status: 'in_progress',
   249→        }, projectContext.path);
   250→
   251→        // AC: @api-contract ac-6 - Return updated task
   252→        return updatedTask;
   253→      },
   254→      {
   255→        params: t.Object({
   256→          ref: t.String(),
   257→        }),
   258→      }
   259→    )
   260→
   261→    // AC: @api-contract ac-7 - Add note to task
   262→    .post(
   263→      '/:ref/note',
   264→      async ({ params, body, error: errorResponse, projectContext }) => {
   265→        // AC: @multi-directory-daemon ac-1, ac-24 - Use project context from middleware
   266→        const ctx = await initContext(projectContext.path);
   267→        const tasks = await loadAllTasks(ctx);
   268→        const items = await loadAllItems(ctx);
   269→        const index = new ReferenceIndex(tasks, items);
   270→
   271→        // Resolve ref
   272→        const result = index.resolve(params.ref);
   273→        if (!result.ok) {
   274→          return errorResponse(404, {
   275→            error: 'not_found',
   276→            message: `Task reference "${params.ref}" not found`,
   277→          });
   278→        }
   279→
   280→        const task = tasks.find((t) => t._ulid === result.ulid);
   281→        if (!task) {
   282→          return errorResponse(404, {
   283→            error: 'not_found',
   284→            message: `Reference "${params.ref}" is not a task`,
   285→          });
   286→        }
   287→
   288→        // AC: @trait-api-endpoint ac-3 - Validate body
   289→        if (!body.content || typeof body.content !== 'string') {
   290→          return errorResponse(400, {
   291→            error: 'validation_error',
   292→            details: [
   293→              {
   294→                field: 'content',
   295→                message: 'Content is required and must be a string',
   296→              },
   297→            ],
   298→          });
   299→        }
   300→
   301→        // AC: @api-contract ac-7 - Append note
   302→        const author = getAuthor(ctx.config?.identity?.author);
   303→        const note = createNote(body.content, author);
   304→
   305→        const updatedTask: LoadedTask = {
   306→          ...task,
   307→          notes: [...(task.notes || []), note],
   308→        };
   309→
   310→        // AC: @api-contract ac-7, @trait-api-endpoint ac-5 - Shadow commit
   311→        await saveTask(ctx, updatedTask);
   312→        await commitIfShadow(ctx.shadow, `task: add note to ${params.ref}`);
   313→
   314→        // AC: @api-contract ac-7 - WebSocket broadcast
   315→        // AC: @multi-directory-daemon ac-18 - Broadcast scoped to request project
   316→        pubsub.broadcast('tasks:updates', 'task_updated', {
   317→          ref: params.ref,
   318→          ulid: task._ulid,
   319→          action: 'note_added',
   320→          note_ulid: note._ulid,
   321→        }, projectContext.path);
   322→
   323→        return {
   324→          success: true,
   325→          note,
   326→          task: updatedTask,
   327→        };
   328→      },
   329→      {
   330→        params: t.Object({
   331→          ref: t.String(),
   332→        }),
   333→        body: t.Object({
   334→          content: t.String(),
   335→        }),
   336→      }
   337→    )
   338→
   339→    // AC: @ui-task-board ac-6 - Submit task for review
   340→    .post(
   341→      '/:ref/submit',
   342→      async ({ params, error: errorResponse, projectContext }) => {
   343→        const ctx = await initContext(projectContext.path);
   344→        const tasks = await loadAllTasks(ctx);
   345→        const items = await loadAllItems(ctx);
   346→        const index = new ReferenceIndex(tasks, items);
   347→
   348→        const result = index.resolve(params.ref);
   349→        if (!result.ok) {
   350→          return errorResponse(404, {
   351→            error: 'not_found',
   352→            message: `Task reference "${params.ref}" not found`,
   353→          });
   354→        }
   355→
   356→        const task = tasks.find((t) => t._ulid === result.ulid);
   357→        if (!task) {
   358→          return errorResponse(404, {
   359→            error: 'not_found',
   360→            message: `Reference "${params.ref}" is not a task`,
   361→          });
   362→        }
   363→
   364→        if (task.status !== 'in_progress' && task.status !== 'needs_work') {
   365→          return errorResponse(409, {
   366→            error: 'invalid_transition',
   367→            message: `Cannot submit task with status "${task.status}". Must be in_progress or needs_work.`,
   368→            current: task.status,
   369→            valid_transitions: ['pending_review'],
   370→          });
   371→        }
   372→
   373→        const updatedTask: LoadedTask = { ...task, status: 'pending_review' };
   374→        await saveTask(ctx, updatedTask);
   375→        await syncSpecImplementationStatus(ctx, updatedTask, tasks, items, index);
   376→        await commitIfShadow(ctx.shadow, `task: submit ${params.ref}`);
   377→
   378→        pubsub.broadcast('tasks:updates', 'task_updated', {
   379→          ref: params.ref,
   380→          ulid: task._ulid,
   381→          action: 'submit',
   382→          status: 'pending_review',
   383→        }, projectContext.path);
   384→
   385→        return updatedTask;
   386→      },
   387→      { params: t.Object({ ref: t.String() }) }
   388→    )
   389→
   390→    // AC: @ui-task-board ac-6 - Complete task
   391→    .post(
   392→      '/:ref/complete',
   393→      async ({ params, body, error: errorResponse, projectContext }) => {
   394→        const ctx = await initContext(projectContext.path);
   395→        const tasks = await loadAllTasks(ctx);
   396→        const items = await loadAllItems(ctx);
   397→        const index = new ReferenceIndex(tasks, items);
   398→
   399→        const result = index.resolve(params.ref);
   400→        if (!result.ok) {
   401→          return errorResponse(404, {
   402→            error: 'not_found',
   403→            message: `Task reference "${params.ref}" not found`,
   404→          });
   405→        }
   406→
   407→        const task = tasks.find((t) => t._ulid === result.ulid);
   408→        if (!task) {
   409→          return errorResponse(404, {
   410→            error: 'not_found',
   411→            message: `Reference "${params.ref}" is not a task`,
   412→          });
   413→        }
   414→
   415→        const updatedTask: LoadedTask = {
   416→          ...task,
   417→          status: 'completed',
   418→          completed_at: new Date().toISOString(),
   419→          closed_reason: body.reason,
   420→        };
   421→        await saveTask(ctx, updatedTask);
   422→        await syncSpecImplementationStatus(ctx, updatedTask, tasks, items, index);
   423→        await commitIfShadow(ctx.shadow, `task: complete ${params.ref}`);
   424→
   425→        pubsub.broadcast('tasks:updates', 'task_updated', {
   426→          ref: params.ref,
   427→          ulid: task._ulid,
   428→          action: 'complete',
   429→          status: 'completed',
   430→        }, projectContext.path);
   431→
   432→        return updatedTask;
   433→      },
   434→      {
   435→        params: t.Object({ ref: t.String() }),
   436→        body: t.Object({ reason: t.String() }),
   437→      }
   438→    )
   439→
   440→    // AC: @ui-task-board ac-6 - Block task
   441→    .post(
   442→      '/:ref/block',
   443→      async ({ params, body, error: errorResponse, projectContext }) => {
   444→        const ctx = await initContext(projectContext.path);
   445→        const tasks = await loadAllTasks(ctx);
   446→        const items = await loadAllItems(ctx);
   447→        const index = new ReferenceIndex(tasks, items);
   448→
   449→        const result = index.resolve(params.ref);
   450→        if (!result.ok) {
   451→          return errorResponse(404, {
   452→            error: 'not_found',
   453→            message: `Task reference "${params.ref}" not found`,
   454→          });
   455→        }
   456→
   457→        const task = tasks.find((t) => t._ulid === result.ulid);
   458→        if (!task) {
   459→          return errorResponse(404, {
   460→            error: 'not_found',
   461→            message: `Reference "${params.ref}" is not a task`,
   462→          });
   463→        }
   464→
   465→        const author = getAuthor(ctx.config?.identity?.author);
   466→        const note = createNote(`Blocked: ${body.reason}`, author);
   467→
   468→        const updatedTask: LoadedTask = {
   469→          ...task,
   470→          status: 'blocked',
   471→          notes: [...(task.notes || []), note],
   472→        };
   473→        await saveTask(ctx, updatedTask);
   474→        await syncSpecImplementationStatus(ctx, updatedTask, tasks, items, index);
   475→        await commitIfShadow(ctx.shadow, `task: block ${params.ref}`);
   476→
   477→        pubsub.broadcast('tasks:updates', 'task_updated', {
   478→          ref: params.ref,
   479→          ulid: task._ulid,
   480→          action: 'block',
   481→          status: 'blocked',
   482→        }, projectContext.path);
   483→
   484→        return updatedTask;
   485→      },
   486→      {
   487→        params: t.Object({ ref: t.String() }),
   488→        body: t.Object({ reason: t.String() }),
   489→      }
   490→    );
   491→}
   492→
```