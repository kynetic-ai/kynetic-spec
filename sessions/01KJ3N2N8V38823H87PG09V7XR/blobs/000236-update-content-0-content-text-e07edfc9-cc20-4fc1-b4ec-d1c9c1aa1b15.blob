    33→// ─── Store Unit Tests ───────────────────────────────────────────────────────
    34→
    35→describe('computeSessionLogStats', () => {
    36→  // AC: @session-log-stats ac-1
    37→  it('should compute totals correctly', () => {
    38→    const summaries: SessionLogSummary[] = [
    39→      {
    40→        id: 'session-1',
    41→        status: 'completed',
    42→        agent_type: 'claude-code-acp',
    43→        started_at: '2026-01-20T10:00:00.000Z',
    44→        ended_at: '2026-01-20T11:00:00.000Z',
    45→        duration_ms: 3600000,
    46→        event_count: 100,
    47→        iteration_count: 3,
    48→        tasks_completed: 2,
    49→      },
    50→      {
    51→        id: 'session-2',
    52→        status: 'completed',
    53→        agent_type: 'claude-code-acp',
    54→        started_at: '2026-01-21T10:00:00.000Z',
    55→        ended_at: '2026-01-21T12:00:00.000Z',
    56→        duration_ms: 7200000,
    57→        event_count: 200,
    58→        iteration_count: 5,
    59→        tasks_completed: 3,
    60→      },
    61→    ];
    62→
    63→    const stats = computeSessionLogStats(summaries);
    64→
    65→    expect(stats.total_sessions).toBe(2);
    66→    expect(stats.total_events).toBe(300);
    67→    expect(stats.total_iterations).toBe(8);
    68→    expect(stats.total_tasks_completed).toBe(5);
    69→    expect(stats.total_duration_ms).toBe(10800000);
    70→  });
    71→
    72→  // AC: @session-log-stats ac-2
    73→  it('should compute averages correctly', () => {
    74→    const summaries: SessionLogSummary[] = [
    75→      {
    76→        id: 'session-1',
    77→        status: 'completed',
    78→        agent_type: 'claude-code-acp',
    79→        started_at: '2026-01-20T10:00:00.000Z',
    80→        ended_at: '2026-01-20T11:00:00.000Z',
    81→        duration_ms: 3600000, // 1 hour
    82→        event_count: 100,
    83→        iteration_count: 2,
    84→        tasks_completed: 4,
    85→      },
    86→      {
    87→        id: 'session-2',
    88→        status: 'completed',
    89→        agent_type: 'claude-code-acp',
    90→        started_at: '2026-01-21T10:00:00.000Z',
    91→        ended_at: '2026-01-21T12:00:00.000Z',
    92→        duration_ms: 7200000, // 2 hours
    93→        event_count: 200,
    94→        iteration_count: 4,
    95→        tasks_completed: 6,
    96→      },
    97→    ];
    98→
    99→    const stats = computeSessionLogStats(summaries);
   100→
   101→    expect(stats.avg_duration_ms).toBe(5400000); // 1.5 hours
   102→    expect(stats.avg_iterations_per_session).toBe(3); // (2+4)/2
   103→    expect(stats.avg_tasks_per_session).toBe(5); // (4+6)/2
   104→  });
   105→
   106→  // AC: @session-log-stats ac-3
   107→  it('should compute status breakdown correctly', () => {
   108→    const summaries: SessionLogSummary[] = [
   109→      {
   110→        id: 'session-1',
   111→        status: 'completed',
   112→        agent_type: 'claude-code-acp',
   113→        started_at: '2026-01-20T10:00:00.000Z',
   114→        ended_at: '2026-01-20T11:00:00.000Z',
   115→        duration_ms: 3600000,
   116→        event_count: 100,
   117→        iteration_count: 3,
   118→        tasks_completed: 2,
   119→      },
   120→      {
   121→        id: 'session-2',
   122→        status: 'completed',
   123→        agent_type: 'claude-code-acp',
   124→        started_at: '2026-01-21T10:00:00.000Z',
   125→        ended_at: '2026-01-21T12:00:00.000Z',
   126→        duration_ms: 7200000,
   127→        event_count: 200,
   128→        iteration_count: 5,
   129→        tasks_completed: 3,
   130→      },
   131→      {
   132→        id: 'session-3',
   133→        status: 'active',
   134→        agent_type: 'claude-code-acp',
   135→        started_at: '2026-01-22T10:00:00.000Z',
   136→        duration_ms: 1800000,
   137→        event_count: 50,
   138→        iteration_count: 1,
   139→        tasks_completed: 0,
   140→      },
   141→      {
   142→        id: 'session-4',
   143→        status: 'abandoned',
   144→        agent_type: 'claude-code-acp',
   145→        started_at: '2026-01-19T10:00:00.000Z',
   146→        duration_ms: 600000,
   147→        event_count: 10,
   148→        iteration_count: 1,
   149→        tasks_completed: 0,
   150→      },
   151→    ];
   152→
   153→    const stats = computeSessionLogStats(summaries);
   154→
   155→    expect(stats.status_breakdown).toHaveLength(3);
   156→    const completed = stats.status_breakdown.find((s) => s.status === 'completed');
   157→    const active = stats.status_breakdown.find((s) => s.status === 'active');
   158→    const abandoned = stats.status_breakdown.find((s) => s.status === 'abandoned');
   159→
   160→    expect(completed).toEqual({ status: 'completed', count: 2, percentage: 50 });
   161→    expect(active).toEqual({ status: 'active', count: 1, percentage: 25 });
   162→    expect(abandoned).toEqual({ status: 'abandoned', count: 1, percentage: 25 });
   163→  });
   164→
   165→  it('should return empty stats for empty input', () => {
   166→    const stats = computeSessionLogStats([]);
   167→
   168→    expect(stats.total_sessions).toBe(0);
   169→    expect(stats.total_events).toBe(0);
   170→    expect(stats.avg_duration_ms).toBe(0);
   171→    expect(stats.status_breakdown).toEqual([]);
   172→  });
   173→});
   174→
   175→describe('computeToolUsageStats', () => {
   176→  let testDir: string;
   177→
   178→  beforeEach(async () => {
   179→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-stats-'));
   180→  });
   181→
   182→  afterEach(async () => {
   183→    await fs.rm(testDir, { recursive: true });
   184→  });
   185→
   186→  // AC: @session-log-stats ac-6
   187→  it('should count tool calls and compute percentages', async () => {
   188→    const sessionId = testUlid('SESS');
   189→    await createSession(testDir, {
   190→      id: sessionId,
   191→      agent_type: 'claude-code-acp',
   192→    });
   193→
   194→    // Add tool call events
   195→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   196→    const events = [
   197→      { type: 'session.update', data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Bash' } } } } },
   198→      { type: 'session.update', data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Bash' } } } } },
   199→      { type: 'session.update', data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Read' } } } } },
   200→      { type: 'session.update', data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Edit' } } } } },
   201→    ].map((e, i) => JSON.stringify({ ts: Date.now(), seq: i, session_id: sessionId, ...e }));
   202→    await fs.writeFile(eventsPath, events.join('\n') + '\n');
   203→
   204→    const toolUsage = await computeToolUsageStats(testDir, [sessionId]);
   205→
   206→    expect(toolUsage).toHaveLength(3);
   207→    expect(toolUsage[0]).toEqual({ tool_name: 'Bash', count: 2, percentage: 50 });
   208→    expect(toolUsage[1]).toEqual({ tool_name: 'Read', count: 1, percentage: 25 });
   209→    expect(toolUsage[2]).toEqual({ tool_name: 'Edit', count: 1, percentage: 25 });
   210→  });
   211→
   212→  it('should limit to top N tools', async () => {
   213→    const sessionId = testUlid('SESS', 1);
   214→    await createSession(testDir, {
   215→      id: sessionId,
   216→      agent_type: 'test-agent',
   217→    });
   218→
   219→    // Add many different tools
   220→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   221→    const toolNames = ['Tool1', 'Tool2', 'Tool3', 'Tool4', 'Tool5', 'Tool6', 'Tool7', 'Tool8', 'Tool9', 'Tool10', 'Tool11', 'Tool12'];
   222→    const events = toolNames.map((name, i) =>
   223→      JSON.stringify({
   224→        ts: Date.now(),
   225→        seq: i,
   226→        type: 'session.update',
   227→        session_id: sessionId,
   228→        data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: name } } } },
   229→      })
   230→    );
   231→    await fs.writeFile(eventsPath, events.join('\n') + '\n');
   232→
   233→    // Default limit is 10
   234→    const toolUsage = await computeToolUsageStats(testDir, [sessionId]);
   235→    expect(toolUsage).toHaveLength(10);
   236→
   237→    // Custom limit
   238→    const limited = await computeToolUsageStats(testDir, [sessionId], 5);
   239→    expect(limited).toHaveLength(5);
   240→  });
   241→});
