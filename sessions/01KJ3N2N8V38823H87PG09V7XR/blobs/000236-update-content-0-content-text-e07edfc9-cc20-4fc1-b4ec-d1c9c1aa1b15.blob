   243→describe('computeTimePeriodStats', () => {
   244→  // AC: @session-log-stats ac-7
   245→  it('should group by day correctly', () => {
   246→    const summaries: SessionLogSummary[] = [
   247→      {
   248→        id: 'session-1',
   249→        status: 'completed',
   250→        agent_type: 'claude-code-acp',
   251→        started_at: '2026-01-20T10:00:00.000Z',
   252→        duration_ms: 3600000,
   253→        event_count: 100,
   254→        iteration_count: 3,
   255→        tasks_completed: 2,
   256→      },
   257→      {
   258→        id: 'session-2',
   259→        status: 'completed',
   260→        agent_type: 'claude-code-acp',
   261→        started_at: '2026-01-20T14:00:00.000Z',
   262→        duration_ms: 7200000,
   263→        event_count: 200,
   264→        iteration_count: 5,
   265→        tasks_completed: 3,
   266→      },
   267→      {
   268→        id: 'session-3',
   269→        status: 'completed',
   270→        agent_type: 'claude-code-acp',
   271→        started_at: '2026-01-21T10:00:00.000Z',
   272→        duration_ms: 1800000,
   273→        event_count: 50,
   274→        iteration_count: 1,
   275→        tasks_completed: 1,
   276→      },
   277→    ];
   278→
   279→    const periods = computeTimePeriodStats(summaries, 'day');
   280→
   281→    expect(periods).toHaveLength(2);
   282→    // Sorted newest first
   283→    expect(periods[0].period).toBe('2026-01-21');
   284→    expect(periods[0].sessions_count).toBe(1);
   285→    expect(periods[0].tasks_completed).toBe(1);
   286→    expect(periods[0].total_duration_ms).toBe(1800000);
   287→
   288→    expect(periods[1].period).toBe('2026-01-20');
   289→    expect(periods[1].sessions_count).toBe(2);
   290→    expect(periods[1].tasks_completed).toBe(5); // 2 + 3
   291→    expect(periods[1].total_duration_ms).toBe(10800000); // 3600000 + 7200000
   292→  });
   293→
   294→  it('should group by week correctly', () => {
   295→    const summaries: SessionLogSummary[] = [
   296→      {
   297→        id: 'session-1',
   298→        status: 'completed',
   299→        agent_type: 'claude-code-acp',
   300→        started_at: '2026-01-20T10:00:00.000Z', // 2026-01-20 is a Tuesday in week 4
   301→        duration_ms: 3600000,
   302→        event_count: 100,
   303→        iteration_count: 3,
   304→        tasks_completed: 2,
   305→      },
   306→      {
   307→        id: 'session-2',
   308→        status: 'completed',
   309→        agent_type: 'claude-code-acp',
   310→        started_at: '2026-01-27T10:00:00.000Z', // 2026-01-27 is a Tuesday in week 5
   311→        duration_ms: 7200000,
   312→        event_count: 200,
   313→        iteration_count: 5,
   314→        tasks_completed: 3,
   315→      },
   316→    ];
   317→
   318→    const periods = computeTimePeriodStats(summaries, 'week');
   319→
   320→    expect(periods).toHaveLength(2);
   321→    // Should have week numbers in format YYYY-Www
   322→    for (const p of periods) {
   323→      expect(p.period).toMatch(/^\d{4}-W\d{2}$/);
   324→    }
   325→    // Verify concrete week assignments
   326→    expect(periods[0].period).toBe('2026-W05');
   327→    expect(periods[1].period).toBe('2026-W04');
   328→  });
   329→
   330→  it('should handle year boundary week correctly (ISO-8601)', () => {
   331→    // Test ISO-8601 week rules at year boundaries:
   332→    // - 2025-12-29 (Monday) to 2026-01-04 (Sunday) is Week 1 of 2026
   333→    // - 2025-12-28 (Sunday) is Week 52 of 2025
   334→    const summaries: SessionLogSummary[] = [
   335→      {
   336→        id: 'session-1',
   337→        status: 'completed',
   338→        agent_type: 'claude-code-acp',
   339→        started_at: '2025-12-28T10:00:00.000Z', // Sunday - still week 52 of 2025
   340→        duration_ms: 1000,
   341→        event_count: 1,
   342→        iteration_count: 1,
   343→        tasks_completed: 0,
   344→      },
   345→      {
   346→        id: 'session-2',
   347→        status: 'completed',
   348→        agent_type: 'claude-code-acp',
   349→        started_at: '2025-12-29T00:00:00.000Z', // Monday - week 1 of 2026 per ISO-8601
   350→        duration_ms: 1000,
   351→        event_count: 1,
   352→        iteration_count: 1,
   353→        tasks_completed: 0,
   354→      },
   355→      {
   356→        id: 'session-3',
   357→        status: 'completed',
   358→        agent_type: 'claude-code-acp',
   359→        started_at: '2026-01-01T00:00:00.000Z', // Thursday - still week 1 of 2026
   360→        duration_ms: 1000,
   361→        event_count: 1,
   362→        iteration_count: 1,
   363→        tasks_completed: 0,
   364→      },
   365→      {
   366→        id: 'session-4',
   367→        status: 'completed',
   368→        agent_type: 'claude-code-acp',
   369→        started_at: '2026-01-05T00:00:00.000Z', // Monday - week 2 of 2026
   370→        duration_ms: 1000,
   371→        event_count: 1,
   372→        iteration_count: 1,
   373→        tasks_completed: 0,
   374→      },
   375→    ];
   376→
   377→    const periods = computeTimePeriodStats(summaries, 'week');
   378→
   379→    // Should have 3 distinct weeks: 2025-W52, 2026-W01, 2026-W02
   380→    expect(periods).toHaveLength(3);
   381→    const periodSet = new Set(periods.map((p) => p.period));
   382→    expect(periodSet.has('2025-W52')).toBe(true);
   383→    expect(periodSet.has('2026-W01')).toBe(true);
   384→    expect(periodSet.has('2026-W02')).toBe(true);
   385→
   386→    // Verify session counts per week
   387→    const week52 = periods.find((p) => p.period === '2025-W52');
   388→    const week01 = periods.find((p) => p.period === '2026-W01');
   389→    const week02 = periods.find((p) => p.period === '2026-W02');
   390→    expect(week52?.sessions_count).toBe(1);
   391→    expect(week01?.sessions_count).toBe(2); // Dec 29 and Jan 1
   392→    expect(week02?.sessions_count).toBe(1);
   393→  });
   394→});
