   396→// ─── CLI Integration Tests ──────────────────────────────────────────────────
   397→
   398→describe('kspec session log stats (CLI)', () => {
   399→  let tempDir: string;
   400→
   401→  beforeEach(async () => {
   402→    tempDir = await setupTempFixtures();
   403→
   404→    // Create sessions directory
   405→    const sessionsDir = path.join(tempDir, 'sessions');
   406→    await fs.mkdir(sessionsDir, { recursive: true });
   407→
   408→    // Session 1: completed, 2026-01-15
   409→    const s1 = testUlid('SESS', 1);
   410→    const s1Dir = path.join(sessionsDir, s1);
   411→    await fs.mkdir(s1Dir);
   412→    await fs.writeFile(path.join(s1Dir, 'session.yaml'), YAML.stringify({
   413→      id: s1,
   414→      agent_type: 'claude-code-acp',
   415→      status: 'completed',
   416→      started_at: '2026-01-15T10:00:00.000Z',
   417→      ended_at: '2026-01-15T11:30:00.000Z',
   418→    }));
   419→    await fs.writeFile(path.join(s1Dir, 'events.jsonl'), [
   420→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: s1, data: null }),
   421→      JSON.stringify({ ts: 2000, seq: 1, type: 'session.update', session_id: s1, data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Bash' } } } } }),
   422→      JSON.stringify({ ts: 3000, seq: 2, type: 'session.end', session_id: s1, data: null }),
   423→    ].join('\n') + '\n');
   424→    await fs.writeFile(path.join(s1Dir, 'context-iter-1.json'), '{}');
   425→
   426→    // Session 2: active, 2026-02-05
   427→    const s2 = testUlid('SESS', 2);
   428→    const s2Dir = path.join(sessionsDir, s2);
   429→    await fs.mkdir(s2Dir);
   430→    await fs.writeFile(path.join(s2Dir, 'session.yaml'), YAML.stringify({
   431→      id: s2,
   432→      agent_type: 'custom-agent',
   433→      status: 'active',
   434→      started_at: '2026-02-05T08:00:00.000Z',
   435→    }));
   436→    await fs.writeFile(path.join(s2Dir, 'events.jsonl'), [
   437→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: s2, data: null }),
   438→      JSON.stringify({ ts: 2000, seq: 1, type: 'session.update', session_id: s2, data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Read' } } } } }),
   439→      JSON.stringify({ ts: 3000, seq: 2, type: 'session.update', session_id: s2, data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Read' } } } } }),
   440→      JSON.stringify({ ts: 4000, seq: 3, type: 'session.update', session_id: s2, data: { update: { sessionUpdate: 'tool_call', _meta: { claudeCode: { toolName: 'Edit' } } } } }),
   441→      JSON.stringify({ ts: 5000, seq: 4, type: 'prompt.sent', session_id: s2, data: null }),
   442→    ].join('\n') + '\n');
   443→    await fs.writeFile(path.join(s2Dir, 'context-iter-1.json'), '{}');
   444→    await fs.writeFile(path.join(s2Dir, 'context-iter-2.json'), '{}');
   445→    await fs.writeFile(path.join(s2Dir, 'context-iter-3.json'), '{}');
   446→
   447→    // Session 3: completed, 2026-02-04 with task completion
   448→    const s3 = testUlid('SESS', 3);
   449→    const s3Dir = path.join(sessionsDir, s3);
   450→    await fs.mkdir(s3Dir);
   451→    await fs.writeFile(path.join(s3Dir, 'session.yaml'), YAML.stringify({
   452→      id: s3,
   453→      agent_type: 'claude-code-acp',
   454→      status: 'completed',
   455→      started_at: '2026-02-04T14:00:00.000Z',
   456→      ended_at: '2026-02-04T15:00:00.000Z',
   457→    }));
   458→    await fs.writeFile(path.join(s3Dir, 'events.jsonl'), [
   459→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: s3, data: null }),
   460→      JSON.stringify({
   461→        ts: 2000, seq: 1, type: 'session.update', session_id: s3,
   462→        data: {
   463→          iteration: 1,
   464→          update: {
   465→            _meta: { claudeCode: { toolName: 'Bash' } },
   466→            sessionUpdate: 'tool_call',
   467→            rawInput: { command: 'kspec task complete @task-1 --reason "Done"' },
   468→          },
   469→        },
   470→      }),
   471→    ].join('\n') + '\n');
   472→  });
   473→
   474→  afterEach(async () => {
   475→    await cleanupTempDir(tempDir);
   476→  });
   477→
   478→  // AC: @session-log-stats ac-1
   479→  it('should display totals', () => {
   480→    const result = kspec('session log stats', tempDir);
   481→    expect(result.exitCode).toBe(0);
   482→    expect(result.stdout).toContain('Total Sessions:');
   483→    expect(result.stdout).toContain('Total Events:');
   484→    expect(result.stdout).toContain('Total Iterations:');
   485→    expect(result.stdout).toContain('Tasks Completed:');
   486→    expect(result.stdout).toContain('Total Duration:');
   487→  });
   488→
   489→  // AC: @session-log-stats ac-1 (JSON)
   490→  it('should output totals in JSON mode', () => {
   491→    const output = kspecJson<{ stats: SessionLogStats }>('session log stats', tempDir);
   492→    expect(output.stats.total_sessions).toBe(3);
   493→    expect(output.stats.total_events).toBe(10);
   494→    expect(output.stats.total_iterations).toBe(4); // 1 + 3 + 0
   495→    expect(output.stats.total_tasks_completed).toBe(1);
   496→    expect(output.stats.total_duration_ms).toBeGreaterThan(0);
   497→  });
   498→
   499→  // AC: @session-log-stats ac-2
   500→  it('should display averages', () => {
   501→    const result = kspec('session log stats', tempDir);
   502→    expect(result.exitCode).toBe(0);
   503→    expect(result.stdout).toContain('Avg Duration/Session:');
