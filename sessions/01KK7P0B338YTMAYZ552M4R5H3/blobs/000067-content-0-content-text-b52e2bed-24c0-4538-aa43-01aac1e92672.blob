```
     1→<!--
     2→  AC: @web-dashboard ac-5 — Task detail content showing description, notes, todos, dependencies.
     3→  AC: @web-dashboard ac-6 — Spec reference is clickable link to spec item detail.
     4→  AC: @web-dashboard ac-7 — Start Task action button.
     5→  AC: @web-dashboard ac-8 — Add Note textarea and submit.
     6→  AC: @gh-pages-export ac-16 — Buttons disabled with tooltip in static mode.
     7→
     8→  Shared task detail content used by both TaskDetailModal (kanban board)
     9→  and the task list Sheet panel. Handles all task display, actions, and notes.
    10→-->
    11→<script lang="ts">
    12→	import type { TaskDetail } from '@kynetic-ai/shared';
    13→	import {
    14→		startTask,
    15→		submitTask,
    16→		completeTask,
    17→		blockTask,
    18→		addTaskNote
    19→	} from '$lib/api';
    20→	import { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';
    21→	import { Badge } from '$lib/components/ui/badge';
    22→	import { Button } from '$lib/components/ui/button';
    23→	import { Textarea } from '$lib/components/ui/textarea';
    24→	import { Input } from '$lib/components/ui/input';
    25→	import { Separator } from '$lib/components/ui/separator';
    26→	import { Skeleton } from '$lib/components/ui/skeleton';
    27→	import ReferenceLink from '$lib/components/ReferenceLink.svelte';
    28→	import * as Tooltip from '$lib/components/ui/tooltip';
    29→	import { getStatusClasses, formatVcsRef } from './board-utils';
    30→	import GitBranch from '@lucide/svelte/icons/git-branch';
    31→	import ExternalLink from '@lucide/svelte/icons/external-link';
    32→
    33→	interface Props {
    34→		/** The task detail to display, or null if not yet loaded. */
    35→		task: TaskDetail | null;
    36→		/** Whether the task is currently loading. */
    37→		loading: boolean;
    38→		/** Error message to display, if any. */
    39→		error: string;
    40→		/** Called after a task action succeeds (start, submit, complete, block, add note). */
    41→		onTaskUpdated?: (task: TaskDetail) => void;
    42→	}
    43→
    44→	let { task, loading, error, onTaskUpdated }: Props = $props();
    45→
    46→	let actionError = $state('');
    47→	let isSubmitting = $state(false);
    48→
    49→	// Note form
    50→	let noteContent = $state('');
    51→
    52→	// Block/Complete reason form
    53→	let reasonInput = $state('');
    54→	let showReasonFor = $state<'block' | 'complete' | null>(null);
    55→
    56→	// Reset local state when task changes
    57→	$effect(() => {
    58→		if (task) {
    59→			// Task changed, reset action-specific state
    60→			actionError = '';
    61→			noteContent = '';
    62→			reasonInput = '';
    63→			showReasonFor = null;
    64→		}
    65→	});
    66→
    67→	async function handleAction(action: () => Promise<void>) {
    68→		if (!task) return;
    69→		isSubmitting = true;
    70→		actionError = '';
    71→		try {
    72→			await action();
    73→			// Re-fetch is handled by the parent via onTaskUpdated
    74→			onTaskUpdated?.(task);
    75→		} catch (err) {
    76→			if (err instanceof ReadOnlyModeError) {
    77→				actionError = err.message;
    78→			} else {
    79→				actionError = err instanceof Error ? err.message : 'Action failed';
    80→			}
    81→		} finally {
    82→			isSubmitting = false;
    83→		}
    84→	}
    85→
    86→	function handleStart() {
    87→		if (!task) return;
    88→		handleAction(() => startTask(task!._ulid));
    89→	}
    90→
    91→	function handleSubmit() {
    92→		if (!task) return;
    93→		handleAction(() => submitTask(task!._ulid));
    94→	}
    95→
    96→	function handleComplete() {
    97→		if (!task || !reasonInput.trim()) return;
    98→		const reason = reasonInput.trim();
    99→		handleAction(async () => {
   100→			await completeTask(task!._ulid, reason);
   101→			reasonInput = '';
   102→			showReasonFor = null;
   103→		});
   104→	}
   105→
   106→	function handleBlock() {
   107→		if (!task || !reasonInput.trim()) return;
   108→		const reason = reasonInput.trim();
   109→		handleAction(async () => {
   110→			await blockTask(task!._ulid, reason);
   111→			reasonInput = '';
   112→			showReasonFor = null;
   113→		});
   114→	}
   115→
   116→	function handleAddNote() {
   117→		if (!task || !noteContent.trim()) return;
   118→		const content = noteContent.trim();
   119→		handleAction(async () => {
   120→			await addTaskNote(task!._ulid, content);
   121→			noteContent = '';
   122→		});
   123→	}
   124→
   125→	function formatDate(dateStr: string): string {
   126→		return new Intl.DateTimeFormat('en-US', {
   127→			month: 'short',
   128→			day: 'numeric',
   129→			hour: '2-digit',
   130→			minute: '2-digit'
   131→		}).format(new Date(dateStr));
   132→	}
   133→
   134→	let statusInfo = $derived(task ? getStatusClasses(task.status) : null);
   135→	let slug = $derived(task?.slugs?.[0] ?? task?._ulid?.slice(0, 8) ?? '');
   136→	let readOnly = $derived(isStaticMode());
   137→</script>
   138→
   139→{#if loading}
   140→	<div class="flex flex-col gap-4 py-4" data-testid="task-detail-skeleton">
   141→		<Skeleton class="h-6 w-3/4 ds-shimmer" />
   142→		<Skeleton class="h-3 w-24 ds-shimmer" />
   143→		<div class="flex gap-2">
   144→			<Skeleton class="h-5 w-20 rounded-full ds-shimmer" />
   145→			<Skeleton class="h-5 w-24 rounded-full ds-shimmer" />
   146→		</div>
   147→		<div>
   148→			<Skeleton class="h-3 w-10 mb-1 ds-shimmer" />
   149→			<Skeleton class="h-4 w-32 ds-shimmer" />
   150→		</div>
   151→		<div class="flex gap-1">
   152→			<Skeleton class="h-5 w-12 rounded-full ds-shimmer" />
   153→			<Skeleton class="h-5 w-16 rounded-full ds-shimmer" />
   154→		</div>
   155→		<Skeleton class="h-px w-full ds-shimmer" />
   156→		<div>
   157→			<Skeleton class="h-3 w-16 mb-2 ds-shimmer" />
   158→			<Skeleton class="h-16 w-full rounded-md ds-shimmer" />
   159→		</div>
   160→	</div>
   161→{:else if error}
   162→	<div class="bg-destructive/10 text-destructive p-4 rounded-lg" role="alert">
   163→		{error}
   164→	</div>
   165→{:else if task && statusInfo}
   166→	<div class="flex flex-col gap-4">
   167→		<!-- Description -->
   168→		{#if task.description}
   169→			<p class="text-sm text-muted-foreground" data-testid="task-description">
   170→				{task.description}
   171→			</p>
   172→		{/if}
   173→
   174→		<!-- Status, priority, type -->
   175→		<div class="flex flex-wrap gap-2 items-center">
   176→			<Badge class="{statusInfo.bg} {statusInfo.fg}" data-testid="task-status-badge">
   177→				{statusInfo.label}
   178→			</Badge>
   179→			<Badge variant="outline" data-testid="task-priority">Priority {task.priority}</Badge>
   180→			<Badge variant="outline" data-testid="task-type">{task.type}</Badge>
   181→			{#if task.automation}
   182→				<Badge variant="secondary" data-testid="task-automation">
   183→					{task.automation}
   184→				</Badge>
   185→			{/if}
   186→		</div>
   187→
   188→		<!-- Spec ref -->
   189→		<!-- AC: @web-dashboard ac-6 -->
   190→		{#if task.spec_ref}
   191→			<div data-testid="task-spec-ref">
   192→				<p class="text-xs font-medium text-muted-foreground mb-0.5">Spec</p>
   193→				<ReferenceLink ref={task.spec_ref} type="spec" />
   194→			</div>
   195→		{/if}
   196→
   197→		<!-- Tags -->
   198→		{#if task.tags?.length > 0}
   199→			<div data-testid="task-tags">
   200→				<p class="text-xs font-medium text-muted-foreground mb-1">Tags</p>
   201→				<div class="flex flex-wrap gap-1">
   202→					{#each task.tags as tag}
   203→						<Badge variant="secondary">{tag}</Badge>
   204→					{/each}
   205→				</div>
   206→			</div>
   207→		{/if}
   208→
   209→		<!-- Dependencies -->
   210→		<div data-testid="task-dependencies">
   211→			{#if task.depends_on?.length > 0}
   212→				<p class="text-xs font-medium text-muted-foreground mb-1">Dependencies</p>
   213→				<ul class="text-sm space-y-0.5">
   214→					{#each task.depends_on as dep}
   215→						<li>
   216→							<ReferenceLink ref={dep} type="task" class="text-xs" />
   217→						</li>
   218→					{/each}
   219→				</ul>
   220→			{:else}
   221→				<p class="text-sm text-muted-foreground">No dependencies</p>
   222→			{/if}
   223→		</div>
   224→
   225→		<!-- Blocked by -->
   226→		{#if task.blocked_by?.length > 0}
   227→			<div data-testid="task-blocked-by">
   228→				<p class="text-xs font-medium text-destructive mb-1">Blocked By</p>
   229→				<ul class="text-sm space-y-0.5">
   230→					{#each task.blocked_by as blocker}
   231→						<li>
   232→							<ReferenceLink ref={blocker} type="task" class="text-xs" />
   233→						</li>
   234→					{/each}
   235→				</ul>
   236→			</div>
   237→		{/if}
   238→
   239→		<!-- VCS info (branch, PR link) -->
   240→		{#if task.vcs_refs?.length > 0}
   241→			<div data-testid="task-vcs">
   242→				<p class="text-xs font-medium text-muted-foreground mb-1">VCS</p>
   243→				<ul class="text-sm space-y-1">
   244→					{#each task.vcs_refs as ref}
   245→						{@const vcsInfo = formatVcsRef(ref)}
   246→						<li class="flex items-center gap-1.5">
   247→							<GitBranch class="size-3 text-muted-foreground flex-shrink-0" />
   248→							{#if vcsInfo.url}
   249→								<a
   250→									href={vcsInfo.url}
   251→									target="_blank"
   252→									rel="noopener noreferrer"
   253→									class="text-xs text-primary hover:underline font-mono inline-flex items-center gap-1"
   254→								>
   255→									{vcsInfo.label}
   256→									<ExternalLink class="size-3" />
   257→								</a>
   258→							{:else}
   259→								<span class="text-muted-foreground font-mono text-xs">{vcsInfo.label}</span>
   260→							{/if}
   261→						</li>
   262→					{/each}
   263→				</ul>
   264→			</div>
   265→		{/if}
   266→
   267→		<!-- Plan ref -->
   268→		{#if task.plan_ref}
   269→			<div data-testid="task-plan-ref">
   270→				<p class="text-xs font-medium text-muted-foreground mb-0.5">Plan</p>
   271→				<ReferenceLink ref={task.plan_ref} type="plan" />
   272→			</div>
   273→		{:else if task.derivation}
   274→			<div data-testid="task-derivation">
   275→				<p class="text-xs font-medium text-muted-foreground mb-0.5">Derivation</p>
   276→				<p class="text-sm text-muted-foreground">{task.derivation}</p>
   277→			</div>
   278→		{/if}
   279→
   280→		<!-- Session link -->
   281→		{#if task.session_ref}
   282→			<div data-testid="task-session-ref">
   283→				<p class="text-xs font-medium text-muted-foreground mb-0.5">Session</p>
   284→				<ReferenceLink ref={task.session_ref} type="session" />
   285→			</div>
   286→		{/if}
   287→
   288→		<Separator />
   289→
   290→		<!-- Actions -->
   291→		<!-- AC: @web-dashboard ac-7 -->
   292→		<!-- AC: @gh-pages-export ac-16 — Buttons disabled with tooltip in static mode -->
   293→		<div class="flex flex-wrap gap-2" data-testid="task-actions">
   294→			{#if task.status === 'pending'}
   295→				{#if readOnly}
   296→					<Tooltip.Root>
   297→						<Tooltip.Trigger>
   298→							{#snippet child({ props })}
   299→								<Button {...props} size="sm" disabled={true} data-testid="action-start">
   300→									Start
   301→								</Button>
   302→							{/snippet}
   303→						</Tooltip.Trigger>
   304→						<Tooltip.Content><p>Read-only mode — use CLI to start task</p></Tooltip.Content>
   305→					</Tooltip.Root>
   306→				{:else}
   307→					<Button
   308→						size="sm"
   309→						onclick={handleStart}
   310→						disabled={isSubmitting}
   311→						data-testid="action-start"
   312→					>
   313→						{isSubmitting ? 'Starting...' : 'Start'}
   314→					</Button>
   315→				{/if}
   316→			{/if}
   317→
   318→			{#if task.status === 'in_progress' || task.status === 'needs_work'}
   319→				{#if readOnly}
   320→					<Tooltip.Root>
   321→						<Tooltip.Trigger>
   322→							{#snippet child({ props })}
   323→								<Button {...props} size="sm" disabled={true} data-testid="action-submit">
   324→									Submit for Review
   325→								</Button>
   326→							{/snippet}
   327→						</Tooltip.Trigger>
   328→						<Tooltip.Content><p>Read-only mode — use CLI to submit task</p></Tooltip.Content>
   329→					</Tooltip.Root>
   330→				{:else}
   331→					<Button
   332→						size="sm"
   333→						onclick={handleSubmit}
   334→						disabled={isSubmitting}
   335→						data-testid="action-submit"
   336→					>
   337→						{isSubmitting ? 'Submitting...' : 'Submit for Review'}
   338→					</Button>
   339→				{/if}
   340→			{/if}
   341→
   342→			{#if task.status === 'in_progress' || task.status === 'pending_review'}
   343→				{#if readOnly}
   344→					<Tooltip.Root>
   345→						<Tooltip.Trigger>
   346→							{#snippet child({ props })}
   347→								<Button {...props} size="sm" variant="outline" disabled={true} data-testid="action-complete-toggle">
   348→									Complete
   349→								</Button>
   350→							{/snippet}
   351→						</Tooltip.Trigger>
   352→						<Tooltip.Content><p>Read-only mode — use CLI to complete task</p></Tooltip.Content>
   353→					</Tooltip.Root>
   354→				{:else}
   355→					<Button
   356→						size="sm"
   357→						variant="outline"
   358→						onclick={() => {
   359→							showReasonFor = 'complete';
   360→							reasonInput = '';
   361→						}}
   362→						disabled={isSubmitting}
   363→						data-testid="action-complete-toggle"
   364→					>
   365→						Complete
   366→					</Button>
   367→				{/if}
   368→			{/if}
   369→
   370→			{#if task.status !== 'blocked' && task.status !== 'completed' && task.status !== 'cancelled'}
   371→				{#if readOnly}
   372→					<Tooltip.Root>
   373→						<Tooltip.Trigger>
   374→							{#snippet child({ props })}
   375→								<Button {...props} size="sm" variant="destructive" disabled={true} data-testid="action-block-toggle">
   376→									Block
   377→								</Button>
   378→							{/snippet}
   379→						</Tooltip.Trigger>
   380→						<Tooltip.Content><p>Read-only mode — use CLI to block task</p></Tooltip.Content>
   381→					</Tooltip.Root>
   382→				{:else}
   383→					<Button
   384→						size="sm"
   385→						variant="destructive"
   386→						onclick={() => {
   387→							showReasonFor = 'block';
   388→							reasonInput = '';
   389→						}}
   390→						disabled={isSubmitting}
   391→						data-testid="action-block-toggle"
   392→					>
   393→						Block
   394→					</Button>
   395→				{/if}
   396→			{/if}
   397→		</div>
   398→
   399→		<!-- Reason input for block/complete (only in daemon mode) -->
   400→		{#if !readOnly && showReasonFor}
   401→			<div class="flex gap-2" data-testid="reason-input">
   402→				<Input
   403→					bind:value={reasonInput}
   404→					placeholder="{showReasonFor === 'block' ? 'Block' : 'Completion'} reason..."
   405→					class="flex-1"
   406→				/>
   407→				<Button
   408→					size="sm"
   409→					onclick={showReasonFor === 'block' ? handleBlock : handleComplete}
   410→					disabled={isSubmitting || !reasonInput.trim()}
   411→				>
   412→					Confirm
   413→				</Button>
   414→				<Button
   415→					size="sm"
   416→					variant="ghost"
   417→					onclick={() => {
   418→						showReasonFor = null;
   419→						reasonInput = '';
   420→					}}
   421→				>
   422→					Cancel
   423→				</Button>
   424→			</div>
   425→		{/if}
   426→
   427→		{#if actionError}
   428→			<p class="text-sm text-destructive" data-testid="action-error">{actionError}</p>
   429→		{/if}
   430→
   431→		<Separator />
   432→
   433→		<!-- Todos -->
   434→		<div data-testid="task-todos">
   435→			{#if task.todos && task.todos.length > 0}
   436→				<p class="text-xs font-medium text-muted-foreground mb-1">
   437→					Todos ({task.todos.length})
   438→				</p>
   439→				<ul class="space-y-1">
   440→					{#each task.todos as todo}
   441→						<li class="flex items-start gap-2 text-sm">
   442→							<span class="mt-0.5 text-xs">
   443→								{#if todo.done}
   444→									&#x2705;
   445→								{:else}
   446→									&#x23F8;&#xFE0F;
   447→								{/if}
   448→							</span>
   449→							<span class:line-through={todo.done}>
   450→								{todo.text}
   451→							</span>
   452→						</li>
   453→					{/each}
   454→				</ul>
   455→			{:else}
   456→				<p class="text-sm text-muted-foreground">No todos</p>
   457→			{/if}
   458→		</div>
   459→		<Separator />
   460→
   461→		<!-- Notes -->
   462→		<!-- AC: @web-dashboard ac-8 -->
   463→		<div data-testid="task-notes">
   464→			<p class="text-xs font-medium text-muted-foreground mb-2">
   465→				Notes ({task.notes?.length ?? 0})
   466→			</p>
   467→
   468→			<!-- Add Note form -->
   469→			<!-- AC: @gh-pages-export ac-18 — Note form disabled in static mode -->
   470→			{#if readOnly}
   471→				<div class="mb-3 space-y-2" data-testid="task-add-note">
   472→					<Textarea
   473→						placeholder="Add a note..."
   474→						disabled={true}
   475→						rows={2}
   476→					/>
   477→					<Tooltip.Root>
   478→						<Tooltip.Trigger>
   479→							{#snippet child({ props })}
   480→								<Button {...props} size="sm" disabled={true} data-testid="action-add-note">
   481→									Add Note
   482→								</Button>
   483→							{/snippet}
   484→						</Tooltip.Trigger>
   485→						<Tooltip.Content><p>Read-only mode — use CLI to add notes</p></Tooltip.Content>
   486→					</Tooltip.Root>
   487→				</div>
   488→			{:else}
   489→				<div class="mb-3 space-y-2" data-testid="task-add-note">
   490→					<Textarea
   491→						placeholder="Add a note..."
   492→						bind:value={noteContent}
   493→						disabled={isSubmitting}
   494→						rows={2}
   495→					/>
   496→					<Button
   497→						size="sm"
   498→						onclick={handleAddNote}
   499→						disabled={isSubmitting || !noteContent.trim()}
   500→						data-testid="action-add-note"
   501→					>
   502→						{isSubmitting ? 'Adding...' : 'Add Note'}
   503→					</Button>
   504→				</div>
   505→			{/if}
   506→
   507→			<!-- Notes list -->
   508→			<div class="space-y-3">
   509→				{#if (task.notes ?? []).length === 0}
   510→					<div class="text-center py-4 text-muted-foreground text-xs" data-testid="notes-empty">
   511→						{#if readOnly}
   512→							No notes recorded. Use <code class="bg-muted px-1 rounded">kspec task note</code> to add context.
   513→						{:else}
   514→							Add a note above to document decisions, progress, or findings.
   515→						{/if}
   516→					</div>
   517→				{:else}
   518→					{#each task.notes ?? [] as note}
   519→						<div class="border rounded-md p-2.5" data-testid="note-item">
   520→							<div class="flex justify-between items-start mb-1">
   521→								<span class="text-[10px] text-muted-foreground">{note.author}</span>
   522→								<span class="text-[10px] text-muted-foreground" data-testid="note-timestamp">{formatDate(note.created_at)}</span>
   523→							</div>
   524→							<p class="text-sm whitespace-pre-wrap">{note.content}</p>
   525→						</div>
   526→					{/each}
   527→				{/if}
   528→			</div>
   529→		</div>
   530→	</div>
   531→{/if}
   532→
```