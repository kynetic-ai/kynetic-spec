```
     1→/**
     2→ * Project-level configuration for kspec.
     3→ *
     4→ * Loads kspec.config.yaml from the project root (main branch) before shadow
     5→ * branch detection. All fields are optional with backward-compatible defaults.
     6→ *
     7→ * Priority: env vars > config file > defaults
     8→ *
     9→ * @module
    10→ */
    11→
    12→import * as fs from "node:fs/promises";
    13→import * as path from "node:path";
    14→import { z } from "zod";
    15→import * as YAML from "yaml";
    16→import { getGitRoot } from "./shadow.js";
    17→
    18→// ── Schema ──────────────────────────────────────────────────────────────
    19→
    20→/**
    21→ * Schema for shadow branch configuration.
    22→ *
    23→ * AC: @config-shadow — shadow.branch, shadow.directory, shadow.remote configurable
    24→ */
    25→const ShadowConfigSchema = z
    26→  .object({
    27→    /** Branch name for shadow branch (default: kspec-meta) */
    28→    branch: z.string().optional(),
    29→    /** Worktree directory name (default: .kspec) */
    30→    directory: z.string().optional(),
    31→    /**
    32→     * Remote target for shadow branch. Can be:
    33→     * - Named remote (e.g., "origin", "specs-origin")
    34→     * - Local filesystem path (starts with /, ./, or ~)
    35→     * - Git URL (contains :// or starts with git@)
    36→     */
    37→    remote: z.string().optional(),
    38→  })
    39→  .strict()
    40→  .optional();
    41→
    42→/**
    43→ * Schema for identity configuration.
    44→ */
    45→const IdentityConfigSchema = z
    46→  .object({
    47→    /** Default author for notes/tasks (overridden by KSPEC_AUTHOR env var) */
    48→    author: z.string().optional(),
    49→  })
    50→  .strict()
    51→  .optional();
    52→
    53→/**
    54→ * Schema for validation configuration.
    55→ *
    56→ * AC: @config-validation — validation settings configurable in kspec.config.yaml
    57→ */
    58→const ValidationConfigSchema = z
    59→  .object({
    60→    /**
    61→     * When true, dangling references are treated as errors instead of warnings.
    62→     * AC: @config-validation ac-2 ac-3 — strict_refs configurable
    63→     */
    64→    strict_refs: z.boolean().optional(),
    65→    /**
    66→     * When true, specs missing acceptance criteria are reported as errors not warnings.
    67→     * AC: @config-validation ac-1 — require_acceptance configurable
    68→     */
    69→    require_acceptance: z.boolean().optional(),
    70→  })
    71→  .strict()
    72→  .optional();
    73→
    74→/**
    75→ * Schema for daemon configuration.
    76→ *
    77→ * AC: @config-daemon — daemon.port, daemon.auto_start configurable
    78→ */
    79→const DaemonConfigSchema = z
    80→  .object({
    81→    /** Default port for daemon (default: 3456) */
    82→    port: z.number().int().min(1).max(65535).optional(),
    83→    /** Host to bind to (default: localhost) */
    84→    host: z.string().optional(),
    85→    /**
    86→     * Whether to auto-start daemon when running kspec commands.
    87→     * AC: @config-daemon ac-3 — auto_start configurable
    88→     */
    89→    auto_start: z.boolean().optional(),
    90→  })
    91→  .strict()
    92→  .optional();
    93→
    94→/**
    95→ * Schema for ralph skill name overrides.
    96→ *
    97→ * Ralph prompts reference skills by invocation name. These default to
    98→ * kspec: namespace core skills but can be overridden per-project for
    99→ * projects that use project-specific skill names.
   100→ */
   101→const RalphSkillsSchema = z
   102→  .object({
   103→    /** Skill invocation for task-work (default: /kspec:task-work) */
   104→    task_work: z.string().optional(),
   105→    /** Skill invocation for reflect (default: /kspec:reflect) */
   106→    reflect: z.string().optional(),
   107→    /** Skill invocation for PR review (default: /kspec:review) */
   108→    pr_review: z.string().optional(),
   109→  })
   110→  .strict()
   111→  .optional();
   112→
   113→/**
   114→ * Schema for ralph configuration.
   115→ */
   116→const RalphConfigSchema = z
   117→  .object({
   118→    /** Skill invocation name overrides */
   119→    skills: RalphSkillsSchema,
   120→  })
   121→  .strict()
   122→  .optional();
   123→
   124→/**
   125→ * Complete schema for kspec.config.yaml.
   126→ *
   127→ * AC: @project-config ac-4 — unknown fields are ignored via passthrough
   128→ */
   129→export const KspecConfigSchema = z
   130→  .object({
   131→    /** Shadow branch configuration */
   132→    shadow: ShadowConfigSchema,
   133→    /** Identity configuration */
   134→    identity: IdentityConfigSchema,
   135→    /** Validation configuration */
   136→    validation: ValidationConfigSchema,
   137→    /** Daemon configuration */
   138→    daemon: DaemonConfigSchema,
   139→    /** Ralph automation configuration */
   140→    ralph: RalphConfigSchema,
   141→  })
   142→  .passthrough(); // AC: ac-4 — ignore unknown fields
   143→
   144→/**
   145→ * Raw config type as parsed from YAML file.
   146→ */
   147→export type KspecConfig = z.infer<typeof KspecConfigSchema>;
   148→
   149→/**
   150→ * Remote type for shadow branch configuration.
   151→ * - "named": Git remote name (e.g., "origin", "specs-origin")
   152→ * - "path": Local filesystem path
   153→ * - "url": Git URL (https://, git@, etc.)
   154→ */
   155→export type ShadowRemoteType = "named" | "path" | "url";
   156→
   157→/**
   158→ * Resolved shadow remote configuration.
   159→ */
   160→export interface ResolvedShadowRemote {
   161→  /** The remote value from config */
   162→  value: string;
   163→  /** Detected type of the remote */
   164→  type: ShadowRemoteType;
   165→}
   166→
   167→/**
   168→ * Detect the type of a shadow remote string.
   169→ *
   170→ * AC: @config-shadow ac-3 ac-4 ac-5 — remote type detection
   171→ *
   172→ * @param remote Remote string from config
   173→ * @returns Detected type: "path" for filesystem, "url" for git URLs, "named" for git remote names
   174→ */
   175→export function detectRemoteType(remote: string): ShadowRemoteType {
   176→  // AC: ac-4 — Local filesystem path (starts with /, ./, ../, or ~)
   177→  if (
   178→    remote.startsWith("/") ||
   179→    remote.startsWith("./") ||
   180→    remote.startsWith("../") ||
   181→    remote.startsWith("~")
   182→  ) {
   183→    return "path";
   184→  }
   185→  // AC: ac-5 — Git URL (contains :// or starts with git@)
   186→  if (remote.includes("://") || remote.startsWith("git@")) {
   187→    return "url";
   188→  }
   189→  // AC: ac-3 — Otherwise it's a named remote
   190→  return "named";
   191→}
   192→
   193→/**
   194→ * Resolved config with all values finalized (env vars applied, defaults filled).
   195→ */
   196→export interface ResolvedKspecConfig {
   197→  shadow: {
   198→    /** Branch name (default: kspec-meta) */
   199→    branch: string;
   200→    /** Worktree directory name (default: .kspec) */
   201→    directory: string;
   202→    /** Remote configuration, null if not specified */
   203→    remote: ResolvedShadowRemote | null;
   204→  };
   205→  identity: {
   206→    author: string | null;
   207→  };
   208→  validation: {
   209→    /**
   210→     * When true, dangling references are treated as errors instead of warnings.
   211→     * AC: @config-validation ac-2 ac-3
   212→     */
   213→    strict_refs: boolean;
   214→    /**
   215→     * When true, specs missing acceptance criteria are reported as errors not warnings.
   216→     * AC: @config-validation ac-1
   217→     */
   218→    require_acceptance: boolean;
   219→  };
   220→  daemon: {
   221→    port: number;
   222→    host: string;
   223→    /**
   224→     * Whether to auto-start daemon when running kspec commands.
   225→     * AC: @config-daemon ac-3
   226→     */
   227→    auto_start: boolean;
   228→  };
   229→  ralph: {
   230→    skills: {
   231→      /** Skill invocation for task-work (default: /kspec:task-work) */
   232→      task_work: string;
   233→      /** Skill invocation for reflect (default: /kspec:reflect) */
   234→      reflect: string;
   235→      /** Skill invocation for PR review (default: /kspec:review) */
   236→      pr_review: string;
   237→    };
   238→  };
   239→}
   240→
   241→// ── Defaults ────────────────────────────────────────────────────────────
   242→
   243→/**
   244→ * Default configuration values.
   245→ *
   246→ * AC: @project-config ac-1 — these are the current defaults
   247→ */
   248→const DEFAULT_CONFIG: ResolvedKspecConfig = {
   249→  shadow: {
   250→    branch: "kspec-meta",
   251→    directory: ".kspec",
   252→    remote: null,
   253→  },
   254→  identity: {
   255→    author: null,
   256→  },
   257→  validation: {
   258→    // AC: @config-validation — defaults preserve existing behavior
   259→    // strict_refs: true = dangling refs are errors (existing behavior)
   260→    // require_acceptance: false = missing AC is warning (existing behavior)
   261→    strict_refs: true,
   262→    require_acceptance: false,
   263→  },
   264→  daemon: {
   265→    port: 3456,
   266→    host: "localhost",
   267→    auto_start: true, // AC: @config-daemon — default auto-start enabled
   268→  },
   269→  ralph: {
   270→    skills: {
   271→      task_work: "/kspec:task-work",
   272→      reflect: "/kspec:reflect",
   273→      pr_review: "/kspec:review",
   274→    },
   275→  },
   276→};
   277→
   278→// ── Loading ─────────────────────────────────────────────────────────────
   279→
   280→const CONFIG_FILENAME = "kspec.config.yaml";
   281→
   282→/**
   283→ * Result of loading project config.
   284→ */
   285→export interface LoadConfigResult {
   286→  /** Resolved configuration with all values finalized */
   287→  config: ResolvedKspecConfig;
   288→  /** Path to config file if found, null otherwise */
   289→  configPath: string | null;
   290→  /** Warning message if config had issues but was recoverable */
   291→  warning: string | null;
   292→  /** The git root directory where config was loaded from */
   293→  gitRoot: string | null;
   294→}
   295→
   296→/**
   297→ * Find git root directory, handling KSPEC_SPEC_DIR batch mode.
   298→ *
   299→ * AC: @project-config ac-7 — in batch mode, we need the REAL project root
   300→ *
   301→ * When KSPEC_SPEC_DIR is set (batch atomic mode), the cwd might be the temp
   302→ * directory. We need to find the real project root by checking:
   303→ * 1. If KSPEC_BATCH_PROJECT_ROOT is set, use that (set by batch executor)
   304→ * 2. Otherwise, use git root from cwd
   305→ *
   306→ * AC: @project-config ac-6 — loads from git root, not cwd subdirectory
   307→ */
   308→export function findProjectRoot(startDir: string): string | null {
   309→  // In batch mode, the batch executor should set this to the real root
   310→  // before redirecting KSPEC_SPEC_DIR
   311→  const batchRoot = process.env.KSPEC_BATCH_PROJECT_ROOT;
   312→  if (batchRoot) {
   313→    return batchRoot;
   314→  }
   315→
   316→  // Normal mode: find git root
   317→  return getGitRoot(startDir);
   318→}
   319→
   320→/**
   321→ * Load project configuration from kspec.config.yaml.
   322→ *
   323→ * AC: @project-config ac-1 — no config = all defaults
   324→ * AC: @project-config ac-2 — config parsed and available before shadow detection
   325→ * AC: @project-config ac-3 — invalid YAML = defaults + warning
   326→ * AC: @project-config ac-4 — unknown fields ignored
   327→ * AC: @project-config ac-5 — env vars take precedence
   328→ * AC: @project-config ac-6 — loads from git root
   329→ * AC: @project-config ac-7 — batch mode uses real project root
   330→ *
   331→ * @param startDir Starting directory for git root detection
   332→ */
   333→export async function loadProjectConfig(
   334→  startDir: string = process.cwd(),
   335→): Promise<LoadConfigResult> {
   336→  const gitRoot = findProjectRoot(startDir);
   337→
   338→  if (!gitRoot) {
   339→    // Not in a git repo, use defaults
   340→    return {
   341→      config: resolveConfig(null),
   342→      configPath: null,
   343→      warning: null,
   344→      gitRoot: null,
   345→    };
   346→  }
   347→
   348→  const configPath = path.join(gitRoot, CONFIG_FILENAME);
   349→
   350→  // Check if config file exists
   351→  try {
   352→    await fs.access(configPath);
   353→  } catch {
   354→    // AC: ac-1 — no config file, use defaults
   355→    return {
   356→      config: resolveConfig(null),
   357→      configPath: null,
   358→      warning: null,
   359→      gitRoot,
   360→    };
   361→  }
   362→
   363→  // Try to load and parse config
   364→  try {
   365→    const content = await fs.readFile(configPath, "utf-8");
   366→    const raw = YAML.parse(content);
   367→
   368→    // Validate against schema
   369→    const result = KspecConfigSchema.safeParse(raw);
   370→
   371→    if (!result.success) {
   372→      // AC: ac-3 — validation error = defaults + warning
   373→      const issues = result.error.issues
   374→        .map((i) => `${i.path.join(".")}: ${i.message}`)
   375→        .join("; ");
   376→      return {
   377→        config: resolveConfig(null),
   378→        configPath,
   379→        warning: `Config validation failed: ${issues}. Using defaults.`,
   380→        gitRoot,
   381→      };
   382→    }
   383→
   384→    // AC: ac-5 — apply env var overrides during resolution
   385→    return {
   386→      config: resolveConfig(result.data),
   387→      configPath,
   388→      warning: null,
   389→      gitRoot,
   390→    };
   391→  } catch (err) {
   392→    // AC: ac-3 — parse error = defaults + warning
   393→    const message = err instanceof Error ? err.message : String(err);
   394→    return {
   395→      config: resolveConfig(null),
   396→      configPath,
   397→      warning: `Failed to parse ${CONFIG_FILENAME}: ${message}. Using defaults.`,
   398→      gitRoot,
   399→    };
   400→  }
   401→}
   402→
   403→/**
   404→ * Resolve configuration by merging file config with env vars and defaults.
   405→ *
   406→ * Priority: env vars > config file > defaults
   407→ *
   408→ * AC: @project-config ac-5 — env vars take precedence
   409→ */
   410→export function resolveConfig(fileConfig: KspecConfig | null): ResolvedKspecConfig {
   411→  const file = fileConfig || {};
   412→
   413→  // Get env var overrides
   414→  const envAuthor = process.env.KSPEC_AUTHOR;
   415→  const envPort = process.env.KSPEC_DAEMON_PORT
   416→    ? parseInt(process.env.KSPEC_DAEMON_PORT, 10)
   417→    : undefined;
   418→  const envHost = process.env.KSPEC_DAEMON_HOST;
   419→
   420→  // Resolve shadow remote if specified
   421→  const remoteValue = file.shadow?.remote;
   422→  const resolvedRemote: ResolvedShadowRemote | null = remoteValue
   423→    ? { value: remoteValue, type: detectRemoteType(remoteValue) }
   424→    : DEFAULT_CONFIG.shadow.remote;
   425→
   426→  return {
   427→    shadow: {
   428→      branch: file.shadow?.branch ?? DEFAULT_CONFIG.shadow.branch,
   429→      directory: file.shadow?.directory ?? DEFAULT_CONFIG.shadow.directory,
   430→      remote: resolvedRemote,
   431→    },
   432→    identity: {
   433→      // AC: ac-5 — env var takes precedence
   434→      author: envAuthor ?? file.identity?.author ?? DEFAULT_CONFIG.identity.author,
   435→    },
   436→    validation: {
   437→      // AC: @config-validation ac-2 ac-3 — strict_refs from config
   438→      strict_refs:
   439→        file.validation?.strict_refs ?? DEFAULT_CONFIG.validation.strict_refs,
   440→      // AC: @config-validation ac-1 — require_acceptance from config
   441→      require_acceptance:
   442→        file.validation?.require_acceptance ?? DEFAULT_CONFIG.validation.require_acceptance,
   443→    },
   444→    daemon: {
   445→      // AC: ac-5 — env vars take precedence
   446→      port:
   447→        (envPort && !isNaN(envPort) ? envPort : undefined) ??
   448→        file.daemon?.port ??
   449→        DEFAULT_CONFIG.daemon.port,
   450→      // AC: @config-daemon ac-5 ac-6 — host from config/env
   451→      host: envHost ?? file.daemon?.host ?? DEFAULT_CONFIG.daemon.host,
   452→      // AC: @config-daemon ac-3 — auto_start from config
   453→      auto_start: file.daemon?.auto_start ?? DEFAULT_CONFIG.daemon.auto_start,
   454→    },
   455→    ralph: {
   456→      skills: {
   457→        task_work: file.ralph?.skills?.task_work ?? DEFAULT_CONFIG.ralph.skills.task_work,
   458→        reflect: file.ralph?.skills?.reflect ?? DEFAULT_CONFIG.ralph.skills.reflect,
   459→        pr_review: file.ralph?.skills?.pr_review ?? DEFAULT_CONFIG.ralph.skills.pr_review,
   460→      },
   461→    },
   462→  };
   463→}
   464→
   465→/**
   466→ * Get the default configuration (no file, no env vars).
   467→ * Useful for testing or when config loading fails completely.
   468→ * Returns a deep copy to prevent mutation of shared defaults.
   469→ */
   470→export function getDefaultConfig(): ResolvedKspecConfig {
   471→  return {
   472→    shadow: {
   473→      branch: DEFAULT_CONFIG.shadow.branch,
   474→      directory: DEFAULT_CONFIG.shadow.directory,
   475→      remote: DEFAULT_CONFIG.shadow.remote,
   476→    },
   477→    identity: { ...DEFAULT_CONFIG.identity },
   478→    validation: {
   479→      strict_refs: DEFAULT_CONFIG.validation.strict_refs,
   480→      require_acceptance: DEFAULT_CONFIG.validation.require_acceptance,
   481→    },
   482→    daemon: {
   483→      port: DEFAULT_CONFIG.daemon.port,
   484→      host: DEFAULT_CONFIG.daemon.host,
   485→      auto_start: DEFAULT_CONFIG.daemon.auto_start,
   486→    },
   487→    ralph: {
   488→      skills: { ...DEFAULT_CONFIG.ralph.skills },
   489→    },
   490→  };
   491→}
   492→
```