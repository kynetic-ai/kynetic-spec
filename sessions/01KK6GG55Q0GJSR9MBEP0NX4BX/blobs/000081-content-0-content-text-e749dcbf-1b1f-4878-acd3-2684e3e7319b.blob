```
     1→/**
     2→ * Shadow branch utilities for transparent spec/task state tracking.
     3→ *
     4→ * Shadow branch concept:
     5→ * - Orphan branch (kspec-meta) stores kspec state
     6→ * - .kspec/ directory is a git worktree pointing to shadow branch
     7→ * - Main branch gitignores .kspec/
     8→ * - All kspec read/write operations target .kspec/
     9→ * - Changes auto-commit to shadow branch
    10→ */
    11→
    12→import { execFile, spawn, spawnSync } from "node:child_process";
    13→import * as fs from "node:fs/promises";
    14→import { tmpdir } from "node:os";
    15→import * as path from "node:path";
    16→import { promisify } from "node:util";
    17→import { fileURLToPath } from "node:url";
    18→import { isBatchMode } from "../cli/batch-context.js";
    19→
    20→const __filename = fileURLToPath(import.meta.url);
    21→const __dirname = path.dirname(__filename);
    22→
    23→const execFileAsync = promisify(execFile);
    24→
    25→interface RunCommandOptions {
    26→  cwd?: string;
    27→  env?: NodeJS.ProcessEnv;
    28→}
    29→
    30→function runCommandSync(
    31→  command: string,
    32→  args: string[],
    33→  options: RunCommandOptions = {},
    34→): { ok: boolean; stdout: string; stderr: string } {
    35→  const result = spawnSync(command, args, {
    36→    cwd: options.cwd,
    37→    env: options.env,
    38→    stdio: ["ignore", "pipe", "pipe"],
    39→    encoding: "utf-8",
    40→  });
    41→
    42→  return {
    43→    ok: !result.error && result.status === 0,
    44→    stdout: (result.stdout || "").toString(),
    45→    stderr: (result.stderr || "").toString(),
    46→  };
    47→}
    48→
    49→async function runGitAsync(
    50→  cwd: string,
    51→  args: string[],
    52→  env?: NodeJS.ProcessEnv,
    53→): Promise<{ stdout: string; stderr: string }> {
    54→  const { stdout = "", stderr = "" } = await execFileAsync("git", args, {
    55→    cwd,
    56→    env,
    57→    encoding: "utf-8",
    58→  });
    59→  return { stdout: stdout.toString(), stderr: stderr.toString() };
    60→}
    61→
    62→function runGitSync(
    63→  cwd: string,
    64→  args: string[],
    65→): { ok: boolean; stdout: string } {
    66→  const result = spawnSync("git", args, {
    67→    cwd,
    68→    stdio: ["ignore", "pipe", "pipe"],
    69→    encoding: "utf-8",
    70→  });
    71→
    72→  return {
    73→    ok: !result.error && result.status === 0,
    74→    stdout: (result.stdout || "").toString(),
    75→  };
    76→}
    77→
    78→/**
    79→ * Parse git version from `git --version` output.
    80→ * Returns [major, minor, patch] or null if unparseable.
    81→ */
    82→export function getGitVersion(
    83→  cwd?: string,
    84→): [number, number, number] | null {
    85→  const result = spawnSync("git", ["--version"], {
    86→    cwd,
    87→    stdio: ["ignore", "pipe", "pipe"],
    88→    encoding: "utf-8",
    89→  });
    90→  if (result.error || result.status !== 0) return null;
    91→  const match = (result.stdout || "").match(/(\d+)\.(\d+)\.(\d+)/);
    92→  if (!match) return null;
    93→  return [Number(match[1]), Number(match[2]), Number(match[3])];
    94→}
    95→
    96→/**
    97→ * Check if the installed git supports `git worktree add --orphan` (requires >= 2.42.0).
    98→ */
    99→export function gitSupportsOrphanWorktree(cwd?: string): boolean {
   100→  const version = getGitVersion(cwd);
   101→  if (!version) return false;
   102→  const [major, minor] = version;
   103→  return major > 2 || (major === 2 && minor >= 42);
   104→}
   105→
   106→/**
   107→ * Fallback for creating an orphan branch when git < 2.42.
   108→ *
   109→ * Strategy:
   110→ * 1. Create a temp bare repo in the OS temp directory
   111→ * 2. Create an orphan branch with an empty commit there
   112→ * 3. Push that branch to the project repo (via file:// protocol)
   113→ * 4. Clean up the temp repo
   114→ * 5. Attach using standard `git worktree add <dir> <branch>`
   115→ *
   116→ * This approach NEVER modifies the project's working tree.
   117→ *
   118→ * AC: @config-shadow ac-10
   119→ */
   120→export async function createOrphanBranchFallback(
   121→  projectRoot: string,
   122→  branchName: string,
   123→  directoryName: string,
   124→): Promise<void> {
   125→  const tmpDir = await fs.mkdtemp(path.join(tmpdir(), "kspec-orphan-"));
   126→
   127→  try {
   128→    // 1. Init a bare repo in the temp dir
   129→    await runGitAsync(tmpDir, ["init", "--bare"]);
   130→
   131→    // 2. Create the orphan branch using a temporary non-bare clone.
   132→    //    We need a working tree to make a commit, so clone the bare repo.
   133→    const workDir = await fs.mkdtemp(path.join(tmpdir(), "kspec-orphan-work-"));
   134→
   135→    try {
   136→      await runGitAsync(workDir, ["clone", tmpDir, "."]);
   137→      await runGitAsync(workDir, [
   138→        "config",
   139→        "user.email",
   140→        "kspec@localhost",
   141→      ]);
   142→      await runGitAsync(workDir, [
   143→        "config",
   144→        "user.name",
   145→        "kspec",
   146→      ]);
   147→
   148→      // Create an orphan branch (checkout --orphan works on all git versions)
   149→      await runGitAsync(workDir, [
   150→        "checkout",
   151→        "--orphan",
   152→        branchName,
   153→      ]);
   154→
   155→      // Remove any files that might have been staged
   156→      try {
   157→        await runGitAsync(workDir, ["rm", "-rf", "."]);
   158→      } catch {
   159→        // May fail if nothing to remove (empty repo) - that's fine
   160→      }
   161→
   162→      // Create an empty initial commit
   163→      await runGitAsync(workDir, [
   164→        "commit",
   165→        "--allow-empty",
   166→        "-m",
   167→        `Initialize ${branchName}`,
   168→      ]);
   169→
   170→      // Push the orphan branch back to the bare repo
   171→      await runGitAsync(workDir, [
   172→        "push",
   173→        "origin",
   174→        branchName,
   175→      ]);
   176→    } finally {
   177→      await fs.rm(workDir, { recursive: true, force: true });
   178→    }
   179→
   180→    // 3. Push from the temp bare repo to the project repo
   181→    //    Use file:// protocol to ensure git treats it as a proper remote
   182→    await runGitAsync(tmpDir, [
   183→      "push",
   184→      `file://${path.resolve(projectRoot)}`,
   185→      branchName,
   186→    ]);
   187→  } finally {
   188→    // 4. Clean up the temp bare repo
   189→    await fs.rm(tmpDir, { recursive: true, force: true });
   190→  }
   191→
   192→  // 5. Attach worktree using standard git worktree add (no --orphan flag)
   193→  await runGitAsync(projectRoot, [
   194→    "worktree",
   195→    "add",
   196→    directoryName,
   197→    branchName,
   198→  ]);
   199→
   200→  // 6. Remove all tracked files from the worktree since the fallback
   201→  //    created an empty commit but `git worktree add` may still populate
   202→  //    the index from the branch. Clear anything that appeared.
   203→  try {
   204→    const { stdout } = await runGitAsync(
   205→      path.join(projectRoot, directoryName),
   206→      ["ls-files"],
   207→    );
   208→    if (stdout.trim()) {
   209→      await runGitAsync(
   210→        path.join(projectRoot, directoryName),
   211→        ["rm", "-rf", "."],
   212→      );
   213→    }
   214→  } catch {
   215→    // Nothing to remove — expected for an empty commit
   216→  }
   217→}
   218→
   219→// Import getVerboseMode for checking CLI --debug-shadow flag
   220→// We use a getter function to avoid issues with circular dependencies
   221→let getVerboseModeFunc: (() => boolean) | null = null;
   222→
   223→export function setVerboseModeGetter(getter: () => boolean): void {
   224→  getVerboseModeFunc = getter;
   225→}
   226→
   227→/**
   228→ * Shadow branch configuration
   229→ */
   230→export interface ShadowConfig {
   231→  /** Whether shadow branch is enabled/detected */
   232→  enabled: boolean;
   233→  /** Path to .kspec/ worktree directory */
   234→  worktreeDir: string;
   235→  /** Shadow branch name (default: kspec-meta) */
   236→  branchName: string;
   237→  /** Project root (where .kspec/ lives) */
   238→  projectRoot: string;
   239→}
   240→
   241→/**
   242→ * Shadow branch status
   243→ */
   244→export interface ShadowStatus {
   245→  exists: boolean;
   246→  healthy: boolean;
   247→  branchExists: boolean;
   248→  worktreeExists: boolean;
   249→  worktreeLinked: boolean;
   250→  artifactsDirExists: boolean;
   251→  error?: string;
   252→}
   253→
   254→/**
   255→ * Error types for shadow branch issues
   256→ */
   257→export class ShadowError extends Error {
   258→  constructor(
   259→    message: string,
   260→    public code:
   261→      | "NOT_INITIALIZED"
   262→      | "WORKTREE_DISCONNECTED"
   263→      | "DIRECTORY_MISSING"
   264→      | "GIT_ERROR"
   265→      | "RUNNING_FROM_SHADOW",
   266→    public suggestion: string,
   267→  ) {
   268→    super(message);
   269→    this.name = "ShadowError";
   270→  }
   271→}
   272→
   273→/**
   274→ * Default shadow branch name
   275→ */
   276→export const SHADOW_BRANCH_NAME = "kspec-meta";
   277→
   278→/**
   279→ * Default shadow worktree directory
   280→ */
   281→export const SHADOW_WORKTREE_DIR = ".kspec";
   282→
   283→/**
   284→ * Options for shadow branch operations.
   285→ *
   286→ * AC: @config-shadow ac-7 — all fields optional for backward compatibility
   287→ *
   288→ * When not provided, functions use SHADOW_BRANCH_NAME and SHADOW_WORKTREE_DIR constants.
   289→ */
   290→export interface ShadowOptions {
   291→  /** Branch name (default: kspec-meta) */
   292→  branchName?: string;
   293→  /** Worktree directory name (default: .kspec) */
   294→  directory?: string;
   295→  /**
   296→   * Remote target for push/pull. Can be:
   297→   * - Named remote (e.g., "origin", "specs-origin")
   298→   * - Local filesystem path (starts with /, ./, or ~)
   299→   * - Git URL (contains :// or starts with git@)
   300→   */
   301→  remote?: string;
   302→  /** Type of remote (detected from remote string) */
   303→  remoteType?: "named" | "path" | "url";
   304→}
   305→
   306→/**
   307→ * Get effective branch name from options or default.
   308→ * AC: @config-shadow ac-7 — backward compat when called without config
   309→ */
   310→function getBranchName(options?: ShadowOptions): string {
   311→  return options?.branchName ?? SHADOW_BRANCH_NAME;
   312→}
   313→
   314→/**
   315→ * Get effective directory name from options or default.
   316→ * AC: @config-shadow ac-7 — backward compat when called without config
   317→ */
   318→function getDirectoryName(options?: ShadowOptions): string {
   319→  return options?.directory ?? SHADOW_WORKTREE_DIR;
   320→}
   321→
   322→/**
   323→ * Check if debug mode is enabled.
   324→ * Debug mode can be enabled via:
   325→ * - KSPEC_DEBUG=1 environment variable
   326→ * - Verbose flag (passed from CLI --debug-shadow option)
   327→ *
   328→ * When enabled, shadow branch operations output detailed information.
   329→ */
   330→export function isDebugMode(verboseFlag?: boolean): boolean {
   331→  if (process.env.KSPEC_DEBUG === "1") {
   332→    return true;
   333→  }
   334→  if (verboseFlag === true) {
   335→    return true;
   336→  }
   337→  // Check CLI --debug-shadow flag via getter
   338→  if (getVerboseModeFunc?.()) {
   339→    return true;
   340→  }
   341→  return false;
   342→}
   343→
   344→/**
   345→ * Check if we're in a git repository
   346→ */
   347→export async function isGitRepo(dir: string): Promise<boolean> {
   348→  return runGitSync(dir, ["rev-parse", "--git-dir"]).ok;
   349→}
   350→
   351→/**
   352→ * Get the git root directory
   353→ */
   354→export function getGitRoot(dir: string): string | null {
   355→  const result = runGitSync(dir, ["rev-parse", "--show-toplevel"]);
   356→  if (!result.ok) {
   357→    return null;
   358→  }
   359→  return result.stdout.trim();
   360→}
   361→
   362→/**
   363→ * Check if a branch exists
   364→ */
   365→export async function branchExists(
   366→  dir: string,
   367→  branchName: string,
   368→): Promise<boolean> {
   369→  return runGitSync(dir, [
   370→    "show-ref",
   371→    "--verify",
   372→    "--quiet",
   373→    `refs/heads/${branchName}`,
   374→  ]).ok;
   375→}
   376→
   377→/**
   378→ * Check if a directory is a valid git worktree
   379→ */
   380→export async function isValidWorktree(worktreeDir: string): Promise<boolean> {
   381→  try {
   382→    // Check if .git file exists (worktrees have a .git file, not directory)
   383→    const gitPath = path.join(worktreeDir, ".git");
   384→    const stat = await fs.stat(gitPath);
   385→
   386→    if (stat.isFile()) {
   387→      // Read the .git file to verify it points to a worktree
   388→      const content = await fs.readFile(gitPath, "utf-8");
   389→      return content.trim().startsWith("gitdir:");
   390→    }
   391→
   392→    return false;
   393→  } catch {
   394→    return false;
   395→  }
   396→}
   397→
   398→/**
   399→ * Detect if running from inside the shadow worktree directory.
   400→ * Returns the main project root if detected, null otherwise.
   401→ *
   402→ * AC: @config-shadow ac-8 — detects custom worktree directories using git metadata
   403→ *
   404→ * Detection logic:
   405→ * 1. Check if .git is a file (worktrees have .git files, not directories)
   406→ * 2. Read the gitdir reference from the .git file
   407→ * 3. Check if it points to a worktree for kspec (pattern: <project>/.git/worktrees/...)
   408→ *
   409→ * For custom directories, we detect ANY worktree that:
   410→ * - Has a kspec manifest in it (indicating it's a kspec shadow worktree)
   411→ * - Or has a worktree name containing "kspec" or the configured directory name
   412→ *
   413→ * @param cwd Current working directory
   414→ * @param configuredDirectory Optional configured directory name for matching
   415→ */
   416→export async function detectRunningFromShadowWorktree(
   417→  cwd: string,
   418→  configuredDirectory?: string,
   419→): Promise<string | null> {
   420→  try {
   421→    const gitPath = path.join(cwd, ".git");
   422→    const stat = await fs.stat(gitPath);
   423→
   424→    // Worktrees have a .git file, not directory
   425→    if (!stat.isFile()) {
   426→      return null;
   427→    }
   428→
   429→    const content = await fs.readFile(gitPath, "utf-8");
   430→    const match = content.trim().match(/^gitdir:\s*(.+)$/);
   431→    if (!match) {
   432→      return null;
   433→    }
   434→
   435→    const gitdir = match[1];
   436→
   437→    // Check if this is a worktree (pattern: <project>/.git/worktrees/<name>)
   438→    if (gitdir.includes(".git/worktrees/")) {
   439→      const worktreesMatch = gitdir.match(/^(.+)\/\.git\/worktrees\//);
   440→      if (worktreesMatch) {
   441→        const mainProjectRoot = worktreesMatch[1];
   442→        const cwdBase = path.basename(cwd);
   443→        const worktreeName = path.basename(gitdir);
   444→
   445→        // AC: ac-8 — check multiple patterns for shadow worktree detection
   446→        const directoryToCheck = configuredDirectory || SHADOW_WORKTREE_DIR;
   447→
   448→        // Check if directory name matches default, configured, or worktree contains "kspec"
   449→        if (
   450→          cwdBase === SHADOW_WORKTREE_DIR ||
   451→          cwdBase === directoryToCheck ||
   452→          worktreeName.includes("kspec")
   453→        ) {
   454→          return mainProjectRoot;
   455→        }
   456→
   457→        // Additional check: see if this directory has a kspec manifest
   458→        // This catches custom directories that don't have "kspec" in the name
   459→        try {
   460→          const files = await fs.readdir(cwd);
   461→          const hasKspecManifest = files.some(
   462→            (f) =>
   463→              (f.endsWith(".yaml") || f.endsWith(".yml")) &&
   464→              !f.includes(".tasks.") &&
   465→              !f.includes(".inbox."),
   466→          );
   467→          // Check for modules directory or tasks file as additional signals
   468→          const hasModules = files.includes("modules");
   469→          const hasTasksFile = files.some((f) => f.includes(".tasks."));
   470→
   471→          if (hasKspecManifest && (hasModules || hasTasksFile)) {
   472→            return mainProjectRoot;
   473→          }
   474→        } catch {
   475→          // Ignore read errors
   476→        }
   477→      }
   478→    }
   479→
   480→    return null;
   481→  } catch {
   482→    return null;
   483→  }
   484→}
   485→
   486→/**
   487→ * Detect shadow branch configuration from a directory.
   488→ * Returns shadow config if worktree directory exists and is valid.
   489→ *
   490→ * AC: @config-shadow ac-1 ac-2 — uses configured branch/directory names
   491→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
   492→ *
   493→ * @param startDir Directory to start detection from
   494→ * @param options Optional shadow configuration (branch name, directory)
   495→ */
   496→export async function detectShadow(
   497→  startDir: string,
   498→  options?: ShadowOptions,
   499→): Promise<ShadowConfig | null> {
   500→  const gitRoot = getGitRoot(startDir);
   501→  if (!gitRoot) {
   502→    return null;
   503→  }
   504→
   505→  const directoryName = getDirectoryName(options);
   506→  const branchName = getBranchName(options);
   507→  const worktreeDir = path.join(gitRoot, directoryName);
   508→
   509→  try {
   510→    await fs.access(worktreeDir);
   511→
   512→    // Verify it's a valid worktree
   513→    if (await isValidWorktree(worktreeDir)) {
   514→      return {
   515→        enabled: true,
   516→        worktreeDir,
   517→        branchName,
   518→        projectRoot: gitRoot,
   519→      };
   520→    }
   521→
   522→    // Directory exists but not a valid worktree
   523→    return null;
   524→  } catch {
   525→    // Worktree directory doesn't exist
   526→    return null;
   527→  }
   528→}
   529→
   530→/**
   531→ * Get detailed shadow branch status.
   532→ *
   533→ * AC: @config-shadow ac-1 ac-2 — uses configured branch/directory names
   534→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
   535→ *
   536→ * @param projectRoot Git repository root
   537→ * @param options Optional shadow configuration
   538→ */
   539→export async function getShadowStatus(
   540→  projectRoot: string,
   541→  options?: ShadowOptions,
   542→): Promise<ShadowStatus> {
   543→  const directoryName = getDirectoryName(options);
   544→  const branchName = getBranchName(options);
   545→  const worktreeDir = path.join(projectRoot, directoryName);
   546→
   547→  const status: ShadowStatus = {
   548→    exists: false,
   549→    healthy: false,
   550→    branchExists: false,
   551→    worktreeExists: false,
   552→    worktreeLinked: false,
   553→    artifactsDirExists: false,
   554→  };
   555→
   556→  // Check if we're in a git repo
   557→  if (!(await isGitRepo(projectRoot))) {
   558→    status.error = "Not a git repository";
   559→    return status;
   560→  }
   561→
   562→  // Check if branch exists
   563→  status.branchExists = await branchExists(projectRoot, branchName);
   564→
   565→  // Check if worktree directory exists
   566→  try {
   567→    await fs.access(worktreeDir);
   568→    status.worktreeExists = true;
   569→  } catch {
   570→    status.worktreeExists = false;
   571→  }
   572→
   573→  // Check if worktree is properly linked
   574→  if (status.worktreeExists) {
   575→    status.worktreeLinked = await isValidWorktree(worktreeDir);
   576→
   577→    // AC: @artifacts-directory ac-doctor-checks
   578→    try {
   579→      await fs.access(path.join(worktreeDir, "artifacts"));
   580→      status.artifactsDirExists = true;
   581→    } catch {
   582→      status.artifactsDirExists = false;
   583→    }
   584→  }
   585→
   586→  // Determine overall status
   587→  status.exists = status.branchExists || status.worktreeExists;
   588→  status.healthy =
   589→    status.branchExists && status.worktreeExists && status.worktreeLinked;
   590→
   591→  if (!status.healthy && status.exists) {
   592→    if (!status.branchExists) {
   593→      status.error = "Shadow branch missing but worktree exists";
   594→    } else if (!status.worktreeExists) {
   595→      status.error = "Shadow branch exists but worktree missing";
   596→    } else if (!status.worktreeLinked) {
   597→      status.error = "Worktree exists but not properly linked";
   598→    }
   599→  }
   600→
   601→  return status;
   602→}
   603→
   604→/**
   605→ * Result from checking config mismatch.
   606→ */
   607→export interface ShadowConfigMismatch {
   608→  /** Whether there is a mismatch */
   609→  hasMismatch: boolean;
   610→  /** Mismatched branch name (detected vs configured) */
   611→  branchMismatch?: { detected: string; configured: string };
   612→  /** Mismatched directory (detected vs configured) */
   613→  directoryMismatch?: { detected: string; configured: string };
   614→  /** Guidance message for the user */
   615→  guidance?: string;
   616→}
   617→
   618→/**
   619→ * Check if detected shadow branch settings match the configuration.
   620→ *
   621→ * AC: @config-shadow ac-9 — detect mismatch and guide user to migrate
   622→ *
   623→ * This function detects when:
   624→ * - A shadow branch exists with default settings (kspec-meta, .kspec)
   625→ * - But config specifies different settings
   626→ *
   627→ * @param projectRoot Git repository root
   628→ * @param configuredBranch Configured branch name
   629→ * @param configuredDirectory Configured directory name
   630→ */
   631→export async function checkConfigMismatch(
   632→  projectRoot: string,
   633→  configuredBranch: string,
   634→  configuredDirectory: string,
   635→): Promise<ShadowConfigMismatch> {
   636→  const result: ShadowConfigMismatch = { hasMismatch: false };
   637→
   638→  // First check if default shadow exists
   639→  const defaultStatus = await getShadowStatus(projectRoot, {
   640→    branchName: SHADOW_BRANCH_NAME,
   641→    directory: SHADOW_WORKTREE_DIR,
   642→  });
   643→
   644→  if (!defaultStatus.healthy) {
   645→    // No existing shadow with defaults - no mismatch possible
   646→    return result;
   647→  }
   648→
   649→  // Check if configured settings differ from defaults
   650→  const branchDiffers = configuredBranch !== SHADOW_BRANCH_NAME;
   651→  const directoryDiffers = configuredDirectory !== SHADOW_WORKTREE_DIR;
   652→
   653→  if (!branchDiffers && !directoryDiffers) {
   654→    // Config matches defaults - no mismatch
   655→    return result;
   656→  }
   657→
   658→  // There's a mismatch - existing shadow uses defaults but config specifies different values
   659→  result.hasMismatch = true;
   660→
   661→  if (branchDiffers) {
   662→    result.branchMismatch = {
   663→      detected: SHADOW_BRANCH_NAME,
   664→      configured: configuredBranch,
   665→    };
   666→  }
   667→
   668→  if (directoryDiffers) {
   669→    result.directoryMismatch = {
   670→      detected: SHADOW_WORKTREE_DIR,
   671→      configured: configuredDirectory,
   672→    };
   673→  }
   674→
   675→  // Build guidance message
   676→  const parts: string[] = [];
   677→  if (result.branchMismatch) {
   678→    parts.push(
   679→      `branch "${SHADOW_BRANCH_NAME}" (config wants "${configuredBranch}")`,
   680→    );
   681→  }
   682→  if (result.directoryMismatch) {
   683→    parts.push(
   684→      `directory "${SHADOW_WORKTREE_DIR}" (config wants "${configuredDirectory}")`,
   685→    );
   686→  }
   687→
   688→  result.guidance = [
   689→    `Shadow branch exists with ${parts.join(" and ")}.`,
   690→    "",
   691→    "To migrate to configured settings:",
   692→    "  1. Export your specs: kspec export --all > backup.yaml",
   693→    "  2. Remove existing shadow: rm -rf .kspec && git branch -D kspec-meta",
   694→    "  3. Re-initialize: kspec init",
   695→    "  4. Import specs: kspec import backup.yaml",
   696→    "",
   697→    "Or update kspec.config.yaml to match existing settings.",
   698→  ].join("\n");
   699→
   700→  return result;
   701→}
   702→
   703→/**
   704→ * Create an appropriate ShadowError based on status
   705→ */
   706→export function createShadowError(status: ShadowStatus): ShadowError {
   707→  if (!status.branchExists && !status.worktreeExists) {
   708→    return new ShadowError(
   709→      "Shadow branch not initialized",
   710→      "NOT_INITIALIZED",
   711→      "Run `kspec init` to create shadow branch and worktree.",
   712→    );
   713→  }
   714→
   715→  if (status.branchExists && !status.worktreeExists) {
   716→    return new ShadowError(
   717→      ".kspec/ directory missing",
   718→      "DIRECTORY_MISSING",
   719→      "Run `kspec shadow repair` to recreate the worktree.",
   720→    );
   721→  }
   722→
   723→  if (status.worktreeExists && !status.worktreeLinked) {
   724→    return new ShadowError(
   725→      "Worktree disconnected from git",
   726→      "WORKTREE_DISCONNECTED",
   727→      "Run `kspec shadow repair` to fix the worktree link.",
   728→    );
   729→  }
   730→
   731→  return new ShadowError(
   732→    status.error || "Unknown shadow branch error",
   733→    "GIT_ERROR",
   734→    "Check git status and try `kspec shadow repair`.",
   735→  );
   736→}
   737→
   738→/**
   739→ * Auto-commit changes to shadow branch.
   740→ * Called after write operations when shadow is enabled.
   741→ *
   742→ * @param worktreeDir Path to .kspec/ directory
   743→ * @param message Commit message
   744→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   745→ * @returns true if commit succeeded, false if nothing to commit
   746→ */
   747→export async function shadowAutoCommit(
   748→  worktreeDir: string,
   749→  message: string,
   750→  verbose?: boolean,
   751→): Promise<boolean> {
   752→  const debug = isDebugMode(verbose);
   753→
   754→  try {
   755→    if (debug) {
   756→      console.error(
   757→        `[DEBUG] Shadow auto-commit: git add -A (cwd: ${worktreeDir})`,
   758→      );
   759→    }
   760→
   761→    // Stage all changes
   762→    const addResult = runCommandSync("git", ["add", "-A"], { cwd: worktreeDir });
   763→    if (!addResult.ok) {
   764→      throw new Error(addResult.stderr || "git add failed");
   765→    }
   766→
   767→    // Check if there are staged changes
   768→    try {
   769→      if (debug) {
   770→        console.error(`[DEBUG] Shadow auto-commit: git diff --cached --quiet`);
   771→      }
   772→
   773→      const diffResult = runCommandSync(
   774→        "git",
   775→        ["diff", "--cached", "--quiet"],
   776→        { cwd: worktreeDir },
   777→      );
   778→      if (!diffResult.ok) {
   779→        throw new Error("changes staged");
   780→      }
   781→      // No error = no changes
   782→      if (debug) {
   783→        console.error(`[DEBUG] Shadow auto-commit: No changes to commit`);
   784→      }
   785→      return false;
   786→    } catch {
   787→      // Error = there are changes, proceed with commit
   788→    }
   789→
   790→    if (debug) {
   791→      console.error(`[DEBUG] Shadow auto-commit: git commit -m "${message}"`);
   792→    }
   793→
   794→    // Commit with message
   795→    // Set KSPEC_SHADOW_COMMIT=1 to signal authorized commit to git hooks
   796→    const commitResult = runCommandSync("git", ["commit", "-m", message], {
   797→      cwd: worktreeDir,
   798→      env: { ...process.env, KSPEC_SHADOW_COMMIT: "1" },
   799→    });
   800→    if (!commitResult.ok) {
   801→      throw new Error(commitResult.stderr || "git commit failed");
   802→    }
   803→
   804→    if (debug) {
   805→      console.error(`[DEBUG] Shadow auto-commit: Success`);
   806→    }
   807→
   808→    return true;
   809→  } catch (error) {
   810→    // AC: Only log error if debug mode enabled
   811→    if (debug) {
   812→      console.error("Shadow auto-commit failed:", error);
   813→    }
   814→    return false;
   815→  }
   816→}
   817→
   818→/**
   819→ * Generate commit message for a kspec operation.
   820→ */
   821→export function generateCommitMessage(
   822→  operation: string,
   823→  ref?: string,
   824→  detail?: string,
   825→): string {
   826→  const parts: string[] = [];
   827→
   828→  switch (operation) {
   829→    case "task-start":
   830→      parts.push(`Start @${ref}`);
   831→      break;
   832→    case "task-complete":
   833→      parts.push(`Complete @${ref}`);
   834→      if (detail) parts.push(`: ${detail}`);
   835→      break;
   836→    case "task-note":
   837→      parts.push(`Note on @${ref}`);
   838→      break;
   839→    case "task-add":
   840→      parts.push(`Add task: ${detail || ref}`);
   841→      break;
   842→    case "inbox-add":
   843→      parts.push(
   844→        `Inbox: ${detail?.slice(0, 50)}${(detail?.length || 0) > 50 ? "..." : ""}`,
   845→      );
   846→      break;
   847→    case "inbox-promote":
   848→      parts.push(`Promote to @${ref}`);
   849→      break;
   850→    case "item-add":
   851→      parts.push(`Add @${ref}`);
   852→      break;
   853→    case "item-set":
   854→      parts.push(`Update @${ref}`);
   855→      break;
   856→    case "item-delete":
   857→      parts.push(`Delete @${ref}`);
   858→      break;
   859→    case "derive":
   860→      parts.push(`Derive from @${ref}`);
   861→      break;
   862→    default:
   863→      parts.push(operation);
   864→      if (ref) parts.push(` @${ref}`);
   865→  }
   866→
   867→  return parts.join("");
   868→}
   869→
   870→/**
   871→ * Resolve a path relative to shadow worktree if enabled.
   872→ * Falls back to original path if shadow is not enabled.
   873→ *
   874→ * Uses the worktreeDir from shadowConfig for custom directory support.
   875→ */
   876→export function resolveShadowPath(
   877→  originalPath: string,
   878→  shadowConfig: ShadowConfig | null,
   879→  projectRoot: string,
   880→): string {
   881→  if (!shadowConfig?.enabled) {
   882→    return originalPath;
   883→  }
   884→
   885→  // If the path is within the project root, rewrite to shadow worktree
   886→  const relativePath = path.relative(projectRoot, originalPath);
   887→
   888→  // Get the directory name from the worktree path (supports custom directories)
   889→  const worktreeDirName = path.basename(shadowConfig.worktreeDir);
   890→
   891→  // Skip if path is outside project or already in shadow worktree
   892→  if (
   893→    relativePath.startsWith("..") ||
   894→    relativePath.startsWith(worktreeDirName)
   895→  ) {
   896→    return originalPath;
   897→  }
   898→
   899→  // Handle spec/ -> shadow worktree mapping
   900→  if (relativePath.startsWith("spec/") || relativePath.startsWith("spec\\")) {
   901→    const specRelative = relativePath.slice(5); // Remove 'spec/'
   902→    return path.join(shadowConfig.worktreeDir, specRelative);
   903→  }
   904→
   905→  // For task/inbox files at root, move to shadow worktree
   906→  if (
   907→    relativePath.endsWith(".tasks.yaml") ||
   908→    relativePath.endsWith(".inbox.yaml")
   909→  ) {
   910→    return path.join(shadowConfig.worktreeDir, relativePath);
   911→  }
   912→
   913→  return originalPath;
   914→}
   915→
   916→/**
   917→ * Commit changes to shadow branch if enabled.
   918→ * This is the primary interface for CLI commands to trigger auto-commit.
   919→ *
   920→ * @param shadowConfig Shadow configuration (from KspecContext.shadow)
   921→ * @param operation Operation type (e.g., 'task-start', 'task-complete')
   922→ * @param ref Reference slug or ULID (optional)
   923→ * @param detail Additional detail for commit message (optional)
   924→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   925→ * @returns true if committed, false if shadow not enabled or nothing to commit
   926→ */
   927→export async function commitIfShadow(
   928→  shadowConfig: ShadowConfig | null,
   929→  operation: string,
   930→  ref?: string,
   931→  detail?: string,
   932→  verbose?: boolean,
   933→): Promise<boolean> {
   934→  // Suppress auto-commits during atomic batch execution
   935→  if (isBatchMode()) {
   936→    return false;
   937→  }
   938→
   939→  if (!shadowConfig?.enabled) {
   940→    return false;
   941→  }
   942→
   943→  const message = generateCommitMessage(operation, ref, detail);
   944→  const committed = await shadowAutoCommit(
   945→    shadowConfig.worktreeDir,
   946→    message,
   947→    verbose,
   948→  );
   949→
   950→  // AC: @shadow-sync ac-1 - Fire-and-forget push after each commit
   951→  if (committed) {
   952→    shadowPushAsync(shadowConfig.worktreeDir, verbose);
   953→  }
   954→
   955→  return committed;
   956→}
   957→
   958→/**
   959→ * Check if shadow is required but not available, and throw appropriate error.
   960→ * Use this at the start of commands that require shadow mode.
   961→ *
   962→ * @param shadowConfig Shadow configuration from context
   963→ * @param projectRoot Project root for status check
   964→ * @throws ShadowError if shadow is not properly configured
   965→ */
   966→export async function requireShadow(
   967→  shadowConfig: ShadowConfig | null,
   968→  projectRoot: string,
   969→): Promise<void> {
   970→  if (shadowConfig?.enabled) {
   971→    return; // Shadow is available
   972→  }
   973→
   974→  const status = await getShadowStatus(projectRoot);
   975→  throw createShadowError(status);
   976→}
   977→
   978→/**
   979→ * Format a ShadowError for display in CLI.
   980→ * Returns a user-friendly message with suggestion.
   981→ */
   982→export function formatShadowError(error: ShadowError): string {
   983→  return `${error.message}\n\nSuggestion: ${error.suggestion}`;
   984→}
   985→
   986→/**
   987→ * Result from shadow initialization
   988→ */
   989→export interface ShadowInitResult {
   990→  success: boolean;
   991→  branchCreated: boolean;
   992→  worktreeCreated: boolean;
   993→  gitignoreUpdated: boolean;
   994→  initialCommit: boolean;
   995→  alreadyExists: boolean;
   996→  /** Whether shadow was created from existing remote branch */
   997→  createdFromRemote: boolean;
   998→  /** Whether new branch was pushed to remote to establish tracking */
   999→  pushedToRemote: boolean;
  1000→  error?: string;
  1001→}
  1002→
  1003→/**
  1004→ * Options for shadow initialization.
  1005→ *
  1006→ * AC: @config-shadow ac-1 ac-2 — branch and directory configurable
  1007→ */
  1008→export interface ShadowInitOptions {
  1009→  /** Project name for manifest */
  1010→  projectName?: string;
  1011→  /** Force reinitialize even if exists */
  1012→  force?: boolean;
  1013→  /** Shadow branch/directory/remote configuration */
  1014→  shadow?: ShadowOptions;
  1015→}
  1016→
  1017→/**
  1018→ * Check if a remote exists (default: origin)
  1019→ */
  1020→export async function hasRemote(
  1021→  projectRoot: string,
  1022→  remoteName = "origin",
  1023→): Promise<boolean> {
  1024→  try {
  1025→    const { stdout } = await runGitAsync(projectRoot, [
  1026→      "remote",
  1027→      "get-url",
  1028→      remoteName,
  1029→    ]);
  1030→    return stdout.trim().length > 0;
  1031→  } catch {
  1032→    return false;
  1033→  }
  1034→}
  1035→
  1036→/**
  1037→ * Check if a branch exists on a remote.
  1038→ * Uses git ls-remote to query the remote directly, which works in both
  1039→ * full and shallow clones.
  1040→ *
  1041→ * AC: @shadow-init-remote ac-5 — works in shallow clones
  1042→ */
  1043→export async function remoteBranchExists(
  1044→  projectRoot: string,
  1045→  branchName: string,
  1046→  remoteName = "origin",
  1047→): Promise<boolean> {
  1048→  try {
  1049→    const { stdout } = await runGitAsync(projectRoot, [
  1050→      "ls-remote",
  1051→      "--heads",
  1052→      remoteName,
  1053→      branchName,
  1054→    ]);
  1055→    return stdout.trim().length > 0;
  1056→  } catch {
  1057→    return false;
  1058→  }
  1059→}
  1060→
  1061→/**
  1062→ * Fetch from remote to ensure refs are up to date.
  1063→ * Returns true if fetch succeeded, false otherwise.
  1064→ */
  1065→export async function fetchRemote(
  1066→  projectRoot: string,
  1067→  remoteName = "origin",
  1068→): Promise<boolean> {
  1069→  try {
  1070→    await runGitAsync(projectRoot, ["fetch", remoteName]);
  1071→    return true;
  1072→  } catch {
  1073→    return false;
  1074→  }
  1075→}
  1076→
  1077→/**
  1078→ * Push shadow branch to remote with tracking.
  1079→ * Returns true if push succeeded, false otherwise.
  1080→ *
  1081→ * AC: @config-shadow ac-3 — uses configured remote name
  1082→ * AC: @config-shadow ac-7 — defaults to origin when not provided
  1083→ *
  1084→ * @param worktreeDir Path to shadow worktree
  1085→ * @param remoteName Remote name (default: origin)
  1086→ * @param options Optional shadow configuration
  1087→ */
  1088→export async function pushShadowBranch(
  1089→  worktreeDir: string,
  1090→  remoteName = "origin",
  1091→  options?: ShadowOptions,
  1092→): Promise<boolean> {
  1093→  const branchName = getBranchName(options);
  1094→  try {
  1095→    await runGitAsync(worktreeDir, ["push", "-u", remoteName, branchName]);
  1096→    return true;
  1097→  } catch {
  1098→    return false;
  1099→  }
  1100→}
  1101→
  1102→/**
  1103→ * Check if shadow branch has remote tracking configured.
  1104→ * AC-4: Used to determine whether sync should be attempted.
  1105→ *
  1106→ * AC: @config-shadow ac-7 — backward compat when called without config
  1107→ *
  1108→ * @param worktreeDir Path to shadow worktree
  1109→ * @param options Optional shadow configuration
  1110→ */
  1111→export async function hasRemoteTracking(
  1112→  worktreeDir: string,
  1113→  options?: ShadowOptions,
  1114→): Promise<boolean> {
  1115→  const branchName = getBranchName(options);
  1116→  try {
  1117→    const { stdout } = await runGitAsync(worktreeDir, [
  1118→      "config",
  1119→      `branch.${branchName}.remote`,
  1120→    ]);
  1121→    return stdout.trim().length > 0;
  1122→  } catch {
  1123→    return false;
  1124→  }
  1125→}
  1126→
  1127→/**
  1128→ * Ensure shadow branch has remote tracking configured.
  1129→ * AC-8: If shadow has no tracking but main branch has origin remote,
  1130→ * automatically configure tracking to origin/kspec-meta.
  1131→ *
  1132→ * AC: @config-shadow ac-3 ac-4 ac-5 — handles different remote types
  1133→ * AC: @config-shadow ac-6 — error with guidance if named remote doesn't exist
  1134→ * AC: @config-shadow ac-7 — backward compat when called without config
  1135→ *
  1136→ * @param worktreeDir Path to shadow worktree
  1137→ * @param projectRoot Git repository root
  1138→ * @param options Optional shadow configuration
  1139→ * @returns Result with success status and error details if applicable
  1140→ */
  1141→export async function ensureRemoteTracking(
  1142→  worktreeDir: string,
  1143→  projectRoot: string,
  1144→  options?: ShadowOptions,
  1145→): Promise<EnsureRemoteTrackingResult> {
  1146→  const branchName = getBranchName(options);
  1147→
  1148→  // Check if already has tracking
  1149→  if (await hasRemoteTracking(worktreeDir, options)) {
  1150→    return { success: true };
  1151→  }
  1152→
  1153→  // Determine remote name to use
  1154→  let remoteName = "origin";
  1155→
  1156→  if (options?.remote) {
  1157→    const remoteType = options.remoteType ?? "named";
  1158→
  1159→    if (remoteType === "named") {
  1160→      // AC: ac-3 — use the named remote directly
  1161→      remoteName = options.remote;
  1162→
  1163→      // AC: ac-6 — verify the named remote exists with guidance
  1164→      if (!(await hasRemote(projectRoot, remoteName))) {
  1165→        // Named remote doesn't exist - provide helpful guidance
  1166→        return {
  1167→          success: false,
  1168→          missingRemote: remoteName,
  1169→          guidance: `Remote '${remoteName}' does not exist. To fix this:\n` +
  1170→            `  1. Add the remote: git remote add ${remoteName} <url>\n` +
  1171→            `  2. Or update kspec.config.yaml to use an existing remote\n` +
  1172→            `  3. Or remove shadow.remote to use the default 'origin' remote`,
  1173→        };
  1174→      }
  1175→    } else if (remoteType === "path" || remoteType === "url") {
  1176→      // AC: ac-4 ac-5 — add a git remote for path/URL if not already present
  1177→      const specRemoteName = "kspec-specs";
  1178→      const hasSpecsRemote = await hasRemote(projectRoot, specRemoteName);
  1179→
  1180→      if (!hasSpecsRemote) {
  1181→        try {
  1182→          // Expand tilde for paths if needed
  1183→          let remoteTarget = options.remote;
  1184→          if (remoteType === "path" && remoteTarget.startsWith("~")) {
  1185→            remoteTarget = remoteTarget.replace(
  1186→              /^~/,
  1187→              process.env.HOME || process.env.USERPROFILE || "~",
  1188→            );
  1189→          }
  1190→
  1191→          await runGitAsync(projectRoot, [
  1192→            "remote",
  1193→            "add",
  1194→            specRemoteName,
  1195→            remoteTarget,
  1196→          ]);
  1197→        } catch {
  1198→          // Remote add failed - may already exist with different URL
  1199→          return { success: false };
  1200→        }
  1201→      }
  1202→
  1203→      remoteName = specRemoteName;
  1204→    }
  1205→  } else {
  1206→    // No remote configured - check if main branch has origin
  1207→    if (!(await hasRemote(projectRoot))) {
  1208→      return { success: false };
  1209→    }
  1210→  }
  1211→
  1212→  // Set up tracking for shadow branch
  1213→  try {
  1214→    await runGitAsync(worktreeDir, [
  1215→      "config",
  1216→      `branch.${branchName}.remote`,
  1217→      remoteName,
  1218→    ]);
  1219→    await runGitAsync(worktreeDir, [
  1220→      "config",
  1221→      `branch.${branchName}.merge`,
  1222→      `refs/heads/${branchName}`,
  1223→    ]);
  1224→    return { success: true };
  1225→  } catch {
  1226→    return { success: false };
  1227→  }
  1228→}
  1229→
  1230→/**
  1231→ * Result from ensuring remote tracking
  1232→ * AC: @config-shadow ac-6 — includes error details when named remote doesn't exist
  1233→ */
  1234→export interface EnsureRemoteTrackingResult {
  1235→  success: boolean;
  1236→  /** Error when remote doesn't exist (AC-6) */
  1237→  missingRemote?: string;
  1238→  /** Guidance message for user */
  1239→  guidance?: string;
  1240→}
  1241→
  1242→/**
  1243→ * Result from a sync operation
  1244→ */
  1245→export interface ShadowSyncResult {
  1246→  success: boolean;
  1247→  pulled: boolean;
  1248→  pushed: boolean;
  1249→  hadConflict: boolean;
  1250→  error?: string;
  1251→}
  1252→
  1253→const SHADOW_PUSH_FAILURE_ESCALATION_THRESHOLD = 3;
  1254→const shadowPushFailureCounts = new Map<string, number>();
  1255→
  1256→function summarizeShadowPushError(
  1257→  stderr: string,
  1258→  code: number | null,
  1259→  signal: NodeJS.Signals | null,
  1260→): string {
  1261→  const lines = stderr
  1262→    .split(/\r?\n/)
  1263→    .map((line) => line.trim())
  1264→    .filter(Boolean);
  1265→
  1266→  if (lines.length > 0) {
  1267→    const lastLine = lines[lines.length - 1];
  1268→    if (lastLine.length <= 240) {
  1269→      return lastLine;
  1270→    }
  1271→    return `${lastLine.slice(0, 237)}...`;
  1272→  }
  1273→
  1274→  if (code !== null) {
  1275→    return `git push exited with code ${code}`;
  1276→  }
  1277→  if (signal) {
  1278→    return `git push terminated by signal ${signal}`;
  1279→  }
  1280→  return "git push failed";
  1281→}
  1282→
  1283→function noteShadowPushFailure(worktreeDir: string, reason: string): void {
  1284→  const nextCount = (shadowPushFailureCounts.get(worktreeDir) ?? 0) + 1;
  1285→  shadowPushFailureCounts.set(worktreeDir, nextCount);
  1286→
  1287→  console.error(
  1288→    `[WARN] Shadow auto-push failed (consecutive: ${nextCount}). Local shadow commits were kept. ${reason}`,
  1289→  );
  1290→
  1291→  if (nextCount >= SHADOW_PUSH_FAILURE_ESCALATION_THRESHOLD) {
  1292→    console.error(
  1293→      `[WARN] Shadow auto-push has failed ${nextCount} times in a row. Remote shadow state is stale. Run \`kspec shadow sync\` (or \`kspec shadow resolve\` if conflicts are reported).`,
  1294→    );
  1295→  }
  1296→}
  1297→
  1298→function noteShadowPushSuccess(worktreeDir: string): void {
  1299→  shadowPushFailureCounts.delete(worktreeDir);
  1300→}
  1301→
  1302→/**
  1303→ * Fire-and-forget push to remote.
  1304→ * AC-1: Called after each auto-commit when tracking is configured.
  1305→ * AC-8: Automatically sets up tracking if main branch has remote.
  1306→ * Push failures are surfaced as warnings, but local commits still succeed.
  1307→ *
  1308→ * AC: @config-shadow ac-7 — backward compat when called without config
  1309→ *
  1310→ * @param worktreeDir Path to shadow worktree
  1311→ * @param verbose Enable debug output
  1312→ * @param options Optional shadow configuration
  1313→ */
  1314→export async function shadowPushAsync(
  1315→  worktreeDir: string,
  1316→  verbose?: boolean,
  1317→  options?: ShadowOptions,
  1318→): Promise<void> {
  1319→  const debug = isDebugMode(verbose);
  1320→
  1321→  // AC: @shadow-sync ac-8 - Auto-configure tracking if main has remote but shadow doesn't
  1322→  const projectRoot = path.dirname(worktreeDir);
  1323→  const trackingResult = await ensureRemoteTracking(worktreeDir, projectRoot, options);
  1324→
  1325→  // AC: @config-shadow ac-6 — log guidance if named remote doesn't exist
  1326→  if (!trackingResult.success && trackingResult.missingRemote) {
  1327→    if (debug) {
  1328→      console.error(`[DEBUG] Shadow push: ${trackingResult.guidance}`);
  1329→    }
  1330→    return;
  1331→  }
  1332→
  1333→  // Check if tracking is configured before attempting push
  1334→  if (!(await hasRemoteTracking(worktreeDir, options))) {
  1335→    if (debug) {
  1336→      console.error(
  1337→        "[DEBUG] Shadow push: No remote tracking configured, skipping",
  1338→      );
  1339→    }
  1340→    return; // AC: @shadow-sync ac-4 - silently skip if no tracking
  1341→  }
  1342→
  1343→  try {
  1344→    if (debug) {
  1345→      console.error(`[DEBUG] Shadow push: git push (cwd: ${worktreeDir})`);
  1346→    }
  1347→
  1348→    // Fire and forget: detached + unref allows CLI exit without waiting for push.
  1349→    // We still collect stderr and exit code while process is alive to surface failures.
  1350→    const child = spawn("git", ["push"], {
  1351→      cwd: worktreeDir,
  1352→      stdio: ["ignore", "ignore", "pipe"],
  1353→      detached: true,
  1354→    });
  1355→
  1356→    const stderrChunks: string[] = [];
  1357→    child.stderr?.setEncoding("utf-8");
  1358→    child.stderr?.on("data", (chunk) => {
  1359→      stderrChunks.push(chunk);
  1360→    });
  1361→    child.stderr?.resume();
  1362→
  1363→    (child.stderr as { unref?: () => void } | null)?.unref?.();
  1364→    child.unref();
  1365→    if (debug) {
  1366→      console.error("[DEBUG] Shadow push: spawned background git push");
  1367→    }
  1368→
  1369→    const exit = await new Promise<{
  1370→      code: number | null;
  1371→      signal: NodeJS.Signals | null;
  1372→      error?: Error;
  1373→    }>((resolve) => {
  1374→      let settled = false;
  1375→      const finish = (result: {
  1376→        code: number | null;
  1377→        signal: NodeJS.Signals | null;
  1378→        error?: Error;
  1379→      }) => {
  1380→        if (settled) {
  1381→          return;
  1382→        }
  1383→        settled = true;
  1384→        resolve(result);
  1385→      };
  1386→
  1387→      child.once("error", (error) => finish({ code: null, signal: null, error }));
  1388→      child.once("close", (code, signal) => finish({ code, signal }));
  1389→    });
  1390→
  1391→    if (exit.error) {
  1392→      noteShadowPushFailure(worktreeDir, exit.error.message);
  1393→      if (debug) {
  1394→        console.error("[DEBUG] Shadow push spawn error:", exit.error);
  1395→      }
  1396→      return;
  1397→    }
  1398→
  1399→    if (exit.code !== 0) {
  1400→      const reason = summarizeShadowPushError(
  1401→        stderrChunks.join(""),
  1402→        exit.code,
  1403→        exit.signal,
  1404→      );
  1405→      noteShadowPushFailure(worktreeDir, reason);
  1406→      return;
  1407→    }
  1408→
  1409→    noteShadowPushSuccess(worktreeDir);
  1410→  } catch (err) {
  1411→    const reason = err instanceof Error ? err.message : String(err);
  1412→    noteShadowPushFailure(worktreeDir, reason);
  1413→
  1414→    if (debug) {
  1415→      console.error("[DEBUG] Shadow push error:", err);
  1416→    }
  1417→  }
  1418→}
  1419→
  1420→/**
  1421→ * Pull remote changes to shadow branch.
  1422→ * AC-2: Called at session start to sync before operations.
  1423→ * AC-6: Uses --ff-only first, falls back to --rebase.
  1424→ * AC-3: On conflict, returns failure with suggestion.
  1425→ * AC-8: Automatically sets up tracking if main branch has remote.
  1426→ *
  1427→ * AC: @config-shadow ac-7 — backward compat when called without config
  1428→ *
  1429→ * @param worktreeDir Path to shadow worktree
  1430→ * @param options Optional shadow configuration
  1431→ */
  1432→export async function shadowPull(
  1433→  worktreeDir: string,
  1434→  options?: ShadowOptions,
  1435→): Promise<ShadowSyncResult> {
  1436→  const branchName = getBranchName(options);
  1437→  const result: ShadowSyncResult = {
  1438→    success: false,
  1439→    pulled: false,
  1440→    pushed: false,
  1441→    hadConflict: false,
  1442→  };
  1443→
  1444→  // AC: @shadow-sync ac-8 - Auto-configure tracking if main has remote but shadow doesn't
  1445→  const projectRoot = path.dirname(worktreeDir);
  1446→  const trackingResult = await ensureRemoteTracking(worktreeDir, projectRoot, options);
  1447→
  1448→  // AC: @config-shadow ac-6 — error with guidance if named remote doesn't exist
  1449→  if (!trackingResult.success && trackingResult.missingRemote) {
  1450→    result.error = trackingResult.guidance;
  1451→    return result;
  1452→  }
  1453→
  1454→  // AC: @shadow-sync ac-4 - Skip if no remote tracking
  1455→  if (!(await hasRemoteTracking(worktreeDir, options))) {
  1456→    result.success = true;
  1457→    return result;
  1458→  }
  1459→
  1460→  // Check if remote branch exists before attempting pull
  1461→  // Fetch first to ensure refs are up to date
  1462→  await fetchRemote(projectRoot);
  1463→  const remoteHasBranch = await remoteBranchExists(projectRoot, branchName);
  1464→  if (!remoteHasBranch) {
  1465→    // Remote branch doesn't exist yet - nothing to pull, but success
  1466→    result.success = true;
  1467→    return result;
  1468→  }
  1469→
  1470→  try {
  1471→    // Try fast-forward only first (cleanest)
  1472→    await runGitAsync(worktreeDir, ["pull", "--ff-only"]);
  1473→    result.success = true;
  1474→    result.pulled = true;
  1475→    return result;
  1476→  } catch {
  1477→    // Fast-forward failed, try rebase
  1478→  }
  1479→
  1480→  try {
  1481→    // AC: @shadow-sync ac-6 - Fall back to rebase
  1482→    await runGitAsync(worktreeDir, ["pull", "--rebase"]);
  1483→    result.success = true;
  1484→    result.pulled = true;
  1485→    return result;
  1486→  } catch {
  1487→    // Rebase failed - likely conflict
  1488→  }
  1489→
  1490→  // AC: @shadow-sync ac-3 - Conflict detected - abort rebase and report
  1491→  try {
  1492→    await runGitAsync(worktreeDir, ["rebase", "--abort"]);
  1493→  } catch {
  1494→    // May not be in rebase state, ignore
  1495→  }
  1496→
  1497→  result.hadConflict = true;
  1498→  result.error = "Sync conflict detected. Run `kspec shadow resolve` to fix.";
  1499→  return result;
  1500→}
  1501→
  1502→/**
  1503→ * Full sync operation: pull then push.
  1504→ * Used by session start and explicit sync commands.
  1505→ *
  1506→ * AC: @config-shadow ac-7 — backward compat when called without config
  1507→ *
  1508→ * @param worktreeDir Path to shadow worktree
  1509→ * @param options Optional shadow configuration
  1510→ */
  1511→export async function shadowSync(
  1512→  worktreeDir: string,
  1513→  options?: ShadowOptions,
  1514→): Promise<ShadowSyncResult> {
  1515→  // First pull
  1516→  const pullResult = await shadowPull(worktreeDir, options);
  1517→  if (!pullResult.success) {
  1518→    return pullResult;
  1519→  }
  1520→
  1521→  // Then push (only if tracking configured, checked inside)
  1522→  if (await hasRemoteTracking(worktreeDir, options)) {
  1523→    try {
  1524→      await runGitAsync(worktreeDir, ["push"]);
  1525→      pullResult.pushed = true;
  1526→    } catch {
  1527→      // Push failed - not a critical error, local state is correct
  1528→      // Could be permissions, network, etc.
  1529→    }
  1530→  }
  1531→
  1532→  return pullResult;
  1533→}
  1534→
  1535→/**
  1536→ * Check if .gitignore has uncommitted changes
  1537→ */
  1538→async function hasUncommittedGitignore(projectRoot: string): Promise<boolean> {
  1539→  try {
  1540→    // Check both staged and unstaged changes to .gitignore
  1541→    const { stdout } = await runGitAsync(projectRoot, [
  1542→      "status",
  1543→      "--porcelain",
  1544→      ".gitignore",
  1545→    ]);
  1546→    return stdout.trim().length > 0;
  1547→  } catch {
  1548→    return false;
  1549→  }
  1550→}
  1551→
  1552→/**
  1553→ * Commit only .gitignore with a message.
  1554→ *
  1555→ * @param projectRoot Git repository root
  1556→ * @param directoryName Shadow directory name (for commit message)
  1557→ */
  1558→async function commitGitignore(
  1559→  projectRoot: string,
  1560→  directoryName: string,
  1561→): Promise<void> {
  1562→  await runGitAsync(projectRoot, ["add", ".gitignore"]);
  1563→  await runGitAsync(projectRoot, [
  1564→    "commit",
  1565→    "-m",
  1566→    `chore: add ${directoryName}/ to .gitignore for shadow branch`,
  1567→  ]);
  1568→}
  1569→
  1570→/**
  1571→ * Add shadow directory to .gitignore if not already present.
  1572→ * Fails if .gitignore has uncommitted changes.
  1573→ * Commits the change after adding.
  1574→ *
  1575→ * AC: @config-shadow ac-2 — uses configured directory name
  1576→ * AC: @config-shadow ac-7 — defaults to .kspec when not provided
  1577→ *
  1578→ * @param projectRoot Git repository root
  1579→ * @param options Optional shadow configuration
  1580→ */
  1581→async function ensureGitignore(
  1582→  projectRoot: string,
  1583→  options?: ShadowOptions,
  1584→): Promise<boolean> {
  1585→  const directoryName = getDirectoryName(options);
  1586→  const gitignorePath = path.join(projectRoot, ".gitignore");
  1587→  const entry = `${directoryName}/`;
  1588→
  1589→  // Fail fast if .gitignore has uncommitted changes
  1590→  if (await hasUncommittedGitignore(projectRoot)) {
  1591→    throw new ShadowError(
  1592→      ".gitignore has uncommitted changes",
  1593→      "GIT_ERROR",
  1594→      "Commit or stash your .gitignore changes before running kspec init.",
  1595→    );
  1596→  }
  1597→
  1598→  try {
  1599→    let content = "";
  1600→    try {
  1601→      content = await fs.readFile(gitignorePath, "utf-8");
  1602→    } catch {
  1603→      // File doesn't exist, will create
  1604→    }
  1605→
  1606→    // Check if already present (handle various formats)
  1607→    const lines = content.split("\n");
  1608→    const patterns = [
  1609→      directoryName,
  1610→      `${directoryName}/`,
  1611→      `/${directoryName}`,
  1612→      `/${directoryName}/`,
  1613→    ];
  1614→
  1615→    for (const line of lines) {
  1616→      const trimmed = line.trim();
  1617→      if (patterns.includes(trimmed)) {
  1618→        return false; // Already present
  1619→      }
  1620→    }
  1621→
  1622→    // Add to gitignore
  1623→    const newContent =
  1624→      content.endsWith("\n") || content === ""
  1625→        ? `${content}${entry}\n`
  1626→        : `${content}\n${entry}\n`;
  1627→
  1628→    await fs.writeFile(gitignorePath, newContent, "utf-8");
  1629→
  1630→    // Commit the change
  1631→    await commitGitignore(projectRoot, directoryName);
  1632→
  1633→    return true;
  1634→  } catch (error) {
  1635→    if (error instanceof ShadowError) {
  1636→      throw error;
  1637→    }
  1638→    throw new ShadowError(
  1639→      `Failed to update .gitignore: ${error}`,
  1640→      "GIT_ERROR",
  1641→      "Check file permissions for .gitignore",
  1642→    );
  1643→  }
  1644→}
  1645→
  1646→/**
  1647→ * Generate initial manifest content for shadow branch
  1648→ */
  1649→function generateShadowManifest(projectName: string): string {
  1650→  return `# ${projectName} - Kynetic Spec
  1651→# Generated by kspec init
  1652→
  1653→kynetic: "1.0"
  1654→
  1655→project:
  1656→  name: "${projectName}"
  1657→  version: "0.1.0"
  1658→  status: draft
  1659→  description: |
  1660→    Add your project description here.
  1661→
  1662→# Module includes
  1663→includes:
  1664→  - modules/main.yaml
  1665→`;
  1666→}
  1667→
  1668→/**
  1669→ * Generate initial module content
  1670→ */
  1671→function generateShadowModule(projectName: string): string {
  1672→  return `# ${projectName} - Main Module
  1673→# Add your spec items here
  1674→
  1675→items: []
  1676→`;
  1677→}
  1678→
  1679→/**
  1680→ * Generate initial tasks file
  1681→ */
  1682→function generateShadowTasks(projectName: string): string {
  1683→  return `# ${projectName} - Tasks
  1684→# Track implementation work here
  1685→
  1686→tasks: []
  1687→`;
  1688→}
  1689→
  1690→/**
  1691→ * Generate initial inbox file
  1692→ */
  1693→function generateShadowInbox(): string {
  1694→  return `# Inbox - Quick Capture
  1695→# Ideas and notes that haven't been triaged yet
  1696→
  1697→items: []
  1698→`;
  1699→}
  1700→
  1701→/**
  1702→ * Get the kspec package root directory.
  1703→ * Navigates from dist/parser/ to package root.
  1704→ */
  1705→function getPackageRoot(): string {
  1706→  return path.resolve(__dirname, "..", "..");
  1707→}
  1708→
  1709→/**
  1710→ * Install pre-commit hook to protect kspec-meta branch.
  1711→ * Hook prevents direct commits to shadow branch unless KSPEC_SHADOW_COMMIT=1.
  1712→ *
  1713→ * Note: Git worktrees use hooks from the main .git/hooks directory (via commondir),
  1714→ * not from .git/worktrees/-kspec/hooks. So we install to main hooks directory.
  1715→ *
  1716→ * The hook source is located in the kspec package's templates/hooks/ directory.
  1717→ *
  1718→ * @param projectRoot Git repository root
  1719→ * @returns true if hook was installed, false if already exists
  1720→ */
  1721→async function installShadowHook(projectRoot: string): Promise<boolean> {
  1722→  const hooksDir = path.join(projectRoot, ".git", "hooks");
  1723→  const hookPath = path.join(hooksDir, "pre-commit");
  1724→
  1725→  // Look for hook in package templates directory
  1726→  const packageRoot = getPackageRoot();
  1727→  const sourceHookPath = path.join(packageRoot, "templates", "hooks", "pre-commit");
  1728→
  1729→  try {
  1730→    // Check if source hook exists in package templates
  1731→    try {
  1732→      await fs.access(sourceHookPath);
  1733→    } catch {
  1734→      // Source hook doesn't exist - skip installation
  1735→      return false;
  1736→    }
  1737→
  1738→    // Check if hook already exists
  1739→    try {
  1740→      await fs.access(hookPath);
  1741→      // Hook exists - don't overwrite (user may have custom hooks)
  1742→      return false;
  1743→    } catch {
  1744→      // Hook doesn't exist - install it
  1745→    }
  1746→
  1747→    // Copy hook from package templates
  1748→    const hookContent = await fs.readFile(sourceHookPath, "utf-8");
  1749→    await fs.writeFile(hookPath, hookContent, { mode: 0o755 });
  1750→    return true;
  1751→  } catch (_error) {
  1752→    // Silently fail - hook installation is optional
  1753→    return false;
  1754→  }
  1755→}
  1756→
  1757→/**
  1758→ * Convert project name to slug (kebab-case)
  1759→ */
  1760→function toSlug(projectName: string): string {
  1761→  return projectName
  1762→    .toLowerCase()
  1763→    .replace(/[^a-z0-9]+/g, "-")
  1764→    .replace(/^-|-$/g, "");
  1765→}
  1766→
  1767→/**
  1768→ * Configure git merge driver for kspec YAML files.
  1769→ * AC: @yaml-merge-driver ac-12
  1770→ *
  1771→ * Configures the merge driver in .git/config and adds .gitattributes in the shadow branch.
  1772→ *
  1773→ * @param projectRoot Git repository root
  1774→ * @param worktreeDir Path to shadow worktree directory
  1775→ * @returns true if configuration was successful
  1776→ */
  1777→async function configureMergeDriver(
  1778→  projectRoot: string,
  1779→  worktreeDir: string,
  1780→): Promise<boolean> {
  1781→  try {
  1782→    // Step 1: Configure merge driver in .git/config
  1783→    const kspecPathResult = runCommandSync("which", ["kspec"]);
  1784→    if (!kspecPathResult.ok) {
  1785→      throw new Error(kspecPathResult.stderr || "kspec executable not found");
  1786→    }
  1787→    const kspecPath = kspecPathResult.stdout.trim();
  1788→
  1789→    // Add merge driver configuration to git config
  1790→    try {
  1791→      const setNameResult = runCommandSync(
  1792→        "git",
  1793→        ["config", "merge.kspec.name", "Kspec YAML semantic merge driver"],
  1794→        { cwd: projectRoot },
  1795→      );
  1796→      if (!setNameResult.ok) {
  1797→        throw new Error(setNameResult.stderr || "failed to set merge.kspec.name");
  1798→      }
  1799→
  1800→      const setDriverResult = runCommandSync(
  1801→        "git",
  1802→        [
  1803→          "config",
  1804→          "merge.kspec.driver",
  1805→          `${kspecPath} merge-driver %O %A %B --non-interactive`,
  1806→        ],
  1807→        { cwd: projectRoot },
  1808→      );
  1809→      if (!setDriverResult.ok) {
  1810→        throw new Error(setDriverResult.stderr || "failed to set merge.kspec.driver");
  1811→      }
  1812→    } catch (error) {
  1813→      // Config may fail if already set - check if it's set correctly
  1814→      try {
  1815→        const existingDriverResult = runCommandSync(
  1816→          "git",
  1817→          ["config", "merge.kspec.driver"],
  1818→          { cwd: projectRoot },
  1819→        );
  1820→        if (!existingDriverResult.ok) {
  1821→          throw new Error(existingDriverResult.stderr || "failed to read merge.kspec.driver");
  1822→        }
  1823→        const existingDriver = existingDriverResult.stdout.trim();
  1824→
  1825→        if (!existingDriver.includes("kspec merge-driver")) {
  1826→          throw new Error("Merge driver config exists but is incorrect");
  1827→        }
  1828→
  1829→        // Ensure --non-interactive flag is present (older registrations may lack it)
  1830→        if (!existingDriver.includes("--non-interactive")) {
  1831→          const fixResult = runCommandSync(
  1832→            "git",
  1833→            [
  1834→              "config",
  1835→              "merge.kspec.driver",
  1836→              `${kspecPath} merge-driver %O %A %B --non-interactive`,
  1837→            ],
  1838→            { cwd: projectRoot },
  1839→          );
  1840→          if (!fixResult.ok) {
  1841→            throw new Error(
  1842→              fixResult.stderr || "failed to update merge.kspec.driver with --non-interactive",
  1843→            );
  1844→          }
  1845→        }
  1846→      } catch {
  1847→        throw error; // Re-throw original error
  1848→      }
  1849→    }
  1850→
  1851→    // Step 2: Create .gitattributes in shadow branch
  1852→    const gitattributesPath = path.join(worktreeDir, ".gitattributes");
  1853→
  1854→    // Check if .gitattributes exists
  1855→    let existingContent = "";
  1856→    try {
  1857→      existingContent = await fs.readFile(gitattributesPath, "utf-8");
  1858→    } catch {
  1859→      // File doesn't exist, that's fine
  1860→    }
  1861→
  1862→    // Check if merge driver is already configured
  1863→    if (!existingContent.includes("merge=kspec")) {
  1864→      const attributesContent = existingContent
  1865→        ? existingContent + "\n"
  1866→        : "# Git attributes for kspec\n\n";
  1867→
  1868→      await fs.writeFile(
  1869→        gitattributesPath,
  1870→        attributesContent + "*.yaml merge=kspec\n*.yml merge=kspec\n",
  1871→        "utf-8",
  1872→      );
  1873→
  1874→      // Commit .gitattributes to shadow branch
  1875→      await shadowAutoCommit(worktreeDir, "Configure kspec merge driver");
  1876→    }
  1877→
  1878→    return true;
  1879→  } catch (_error) {
  1880→    // Silently fail - merge driver configuration is optional
  1881→    return false;
  1882→  }
  1883→}
  1884→
  1885→/**
  1886→ * Initialize shadow branch and worktree.
  1887→ * Creates orphan branch, worktree, updates gitignore, and creates initial structure.
  1888→ *
  1889→ * AC: @config-shadow ac-1 — creates orphan branch with configured name
  1890→ * AC: @config-shadow ac-2 — creates worktree at configured directory
  1891→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
  1892→ *
  1893→ * @param projectRoot Git repository root
  1894→ * @param options Initialization options
  1895→ * @returns Result indicating what was created
  1896→ */
  1897→export async function initializeShadow(
  1898→  projectRoot: string,
  1899→  options: ShadowInitOptions = {},
  1900→): Promise<ShadowInitResult> {
  1901→  const result: ShadowInitResult = {
  1902→    success: false,
  1903→    branchCreated: false,
  1904→    worktreeCreated: false,
  1905→    gitignoreUpdated: false,
  1906→    initialCommit: false,
  1907→    alreadyExists: false,
  1908→    createdFromRemote: false,
  1909→    pushedToRemote: false,
  1910→  };
  1911→
  1912→  // Check if we're in a git repo
  1913→  if (!(await isGitRepo(projectRoot))) {
  1914→    result.error = "Not a git repository";
  1915→    return result;
  1916→  }
  1917→
  1918→  // AC: ac-1 ac-2 — use configured branch/directory or defaults
  1919→  const branchName = getBranchName(options.shadow);
  1920→  const directoryName = getDirectoryName(options.shadow);
  1921→  const worktreeDir = path.join(projectRoot, directoryName);
  1922→
  1923→  // Check current status with configured options
  1924→  const status = await getShadowStatus(projectRoot, options.shadow);
  1925→
  1926→  // Handle existing shadow branch
  1927→  if (status.healthy && !options.force) {
  1928→    result.alreadyExists = true;
  1929→    result.success = true;
  1930→    return result;
  1931→  }
  1932→
  1933→  // Derive project name if not provided
  1934→  const projectName =
  1935→    options.projectName ||
  1936→    path
  1937→      .basename(projectRoot)
  1938→      .replace(/[-_]/g, " ")
  1939→      .replace(/\b\w/g, (c) => c.toUpperCase());
  1940→
  1941→  const slug = toSlug(projectName);
  1942→
  1943→  // Determine remote name to use
  1944→  let remoteName = "origin";
  1945→  if (options.shadow?.remote && options.shadow.remoteType === "named") {
  1946→    remoteName = options.shadow.remote;
  1947→  }
  1948→
  1949→  // Check for remote shadow branch
  1950→  // AC: @shadow-init-remote ac-4 ac-5 — queries remote directly via ls-remote
  1951→  const remoteExists = await hasRemote(projectRoot, remoteName);
  1952→  let remoteHasShadow = false;
  1953→  if (remoteExists) {
  1954→    remoteHasShadow = await remoteBranchExists(projectRoot, branchName, remoteName);
  1955→  }
  1956→
  1957→  try {
  1958→    // Step 1: Update .gitignore first (before creating worktree)
  1959→    result.gitignoreUpdated = await ensureGitignore(projectRoot, options.shadow);
  1960→
  1961→    // Step 2: Create worktree with orphan branch (or attach to existing branch)
  1962→    if (!status.worktreeExists || !status.worktreeLinked) {
  1963→      // Remove existing directory if present but not linked
  1964→      if (status.worktreeExists && !status.worktreeLinked) {
  1965→        await fs.rm(worktreeDir, { recursive: true, force: true });
  1966→      }
  1967→
  1968→      // Remove stale worktree reference if any
  1969→      try {
  1970→        await runGitAsync(projectRoot, [
  1971→          "worktree",
  1972→          "remove",
  1973→          directoryName,
  1974→          "--force",
  1975→        ]);
  1976→      } catch {
  1977→        // Ignore - worktree may not exist in git's list
  1978→      }
  1979→
  1980→      if (remoteHasShadow) {
  1981→        // AC: @shadow-init-remote ac-1, ac-5 - Remote has shadow branch - fetch and create worktree
  1982→        // Fetch with refspec to create a local branch ref (required in shallow clones
  1983→        // where plain `git fetch origin kspec-meta` only populates FETCH_HEAD)
  1984→        await runGitAsync(projectRoot, [
  1985→          "fetch",
  1986→          remoteName,
  1987→          `${branchName}:${branchName}`,
  1988→        ]);
  1989→        await runGitAsync(projectRoot, [
  1990→          "worktree",
  1991→          "add",
  1992→          directoryName,
  1993→          branchName,
  1994→        ]);
  1995→        // Set up tracking for the branch
  1996→        // Use git config directly — `git branch --set-upstream-to` requires
  1997→        // the remote tracking ref to exist locally, which may not be the case
  1998→        // in shallow clones where we only fetched the branch itself
  1999→        await runGitAsync(projectRoot, [
  2000→          "config",
  2001→          `branch.${branchName}.remote`,
  2002→          remoteName,
  2003→        ]);
  2004→        await runGitAsync(projectRoot, [
  2005→          "config",
  2006→          `branch.${branchName}.merge`,
  2007→          `refs/heads/${branchName}`,
  2008→        ]);
  2009→        result.createdFromRemote = true;
  2010→      } else if (!status.branchExists) {
  2011→        // AC: @shadow-init-remote ac-2 ac-3 - No remote branch or no remote - create orphan branch
  2012→        // AC: @config-shadow ac-1 — use configured branch name
  2013→        // AC: @config-shadow ac-10 — fallback for git < 2.42
  2014→        if (gitSupportsOrphanWorktree(projectRoot)) {
  2015→          await runGitAsync(projectRoot, [
  2016→            "worktree",
  2017→            "add",
  2018→            "--orphan",
  2019→            "-b",
  2020→            branchName,
  2021→            directoryName,
  2022→          ]);
  2023→        } else {
  2024→          await createOrphanBranchFallback(
  2025→            projectRoot,
  2026→            branchName,
  2027→            directoryName,
  2028→          );
  2029→        }
  2030→        result.branchCreated = true;
  2031→      } else {
  2032→        // Attach to existing local branch
  2033→        await runGitAsync(projectRoot, [
  2034→          "worktree",
  2035→          "add",
  2036→          directoryName,
  2037→          branchName,
  2038→        ]);
  2039→      }
  2040→
  2041→      result.worktreeCreated = true;
  2042→    }
  2043→
  2044→    // Step 3: Create initial structure if empty (only for new branches, not remote)
  2045→    const manifestPath = path.join(worktreeDir, `${slug}.yaml`);
  2046→    const modulesDir = path.join(worktreeDir, "modules");
  2047→    const moduleFilePath = path.join(modulesDir, "main.yaml");
  2048→    const tasksPath = path.join(worktreeDir, `${slug}.tasks.yaml`);
  2049→    const inboxPath = path.join(worktreeDir, `${slug}.inbox.yaml`);
  2050→
  2051→    let filesCreated = false;
  2052→
  2053→    // Only create files if manifest doesn't exist (remote branches will have files)
  2054→    try {
  2055→      // Look for any .yaml manifest file (project name may differ)
  2056→      const files = await fs.readdir(worktreeDir);
  2057→      const hasManifest = files.some(
  2058→        (f) =>
  2059→          f.endsWith(".yaml") &&
  2060→          !f.includes(".tasks.") &&
  2061→          !f.includes(".inbox."),
  2062→      );
  2063→      if (!hasManifest) {
  2064→        throw new Error("No manifest found");
  2065→      }
  2066→    } catch {
  2067→      // Manifest doesn't exist, create initial structure
  2068→      await fs.mkdir(modulesDir, { recursive: true });
  2069→      await fs.writeFile(
  2070→        manifestPath,
  2071→        generateShadowManifest(projectName),
  2072→        "utf-8",
  2073→      );
  2074→      await fs.writeFile(
  2075→        moduleFilePath,
  2076→        generateShadowModule(projectName),
  2077→        "utf-8",
  2078→      );
  2079→      await fs.writeFile(tasksPath, generateShadowTasks(projectName), "utf-8");
  2080→      await fs.writeFile(inboxPath, generateShadowInbox(), "utf-8");
  2081→
  2082→      // AC: @artifacts-directory ac-init-creates, ac-gitignore-entry
  2083→      const artifactsDir = path.join(worktreeDir, "artifacts");
  2084→      await fs.mkdir(artifactsDir, { recursive: true });
  2085→      await fs.writeFile(
  2086→        path.join(worktreeDir, ".gitignore"),
  2087→        "# Ephemeral artifacts - reports, exports, generated files\n# Not tracked in shadow branch\nartifacts/\n",
  2088→        "utf-8",
  2089→      );
  2090→
  2091→      filesCreated = true;
  2092→    }
  2093→
  2094→    // Step 4: Initial commit if files were created
  2095→    if (filesCreated) {
  2096→      result.initialCommit = await shadowAutoCommit(
  2097→        worktreeDir,
  2098→        `Initialize ${projectName} spec`,
  2099→      );
  2100→    }
  2101→
  2102→    // Step 5: AC-2: Push new branch to remote to establish tracking
  2103→    if (result.branchCreated && remoteExists && !remoteHasShadow) {
  2104→      result.pushedToRemote = await pushShadowBranch(worktreeDir, remoteName, options.shadow);
  2105→    }
  2106→
  2107→    // Step 6: Install pre-commit hook to protect shadow branch
  2108→    await installShadowHook(projectRoot);
  2109→
  2110→    // Step 7: Configure merge driver for semantic YAML merging
  2111→    // AC: @yaml-merge-driver ac-12
  2112→    await configureMergeDriver(projectRoot, worktreeDir);
  2113→
  2114→    result.success = true;
  2115→    return result;
  2116→  } catch (error) {
  2117→    result.error = error instanceof Error ? error.message : String(error);
  2118→    return result;
  2119→  }
  2120→}
  2121→
  2122→/**
  2123→ * Repair a broken shadow branch setup.
  2124→ * Handles cases where worktree is disconnected or directory is missing.
  2125→ *
  2126→ * AC: @config-shadow ac-7 — backward compat when called without config
  2127→ *
  2128→ * @param projectRoot Git repository root
  2129→ * @param options Optional shadow configuration
  2130→ * @returns Result indicating what was repaired
  2131→ */
  2132→export async function repairShadow(
  2133→  projectRoot: string,
  2134→  options?: ShadowOptions,
  2135→): Promise<ShadowInitResult> {
  2136→  const branchName = getBranchName(options);
  2137→  const directoryName = getDirectoryName(options);
  2138→  const status = await getShadowStatus(projectRoot, options);
  2139→
  2140→  if (status.healthy) {
  2141→    return {
  2142→      success: true,
  2143→      branchCreated: false,
  2144→      worktreeCreated: false,
  2145→      gitignoreUpdated: false,
  2146→      initialCommit: false,
  2147→      alreadyExists: true,
  2148→      createdFromRemote: false,
  2149→      pushedToRemote: false,
  2150→    };
  2151→  }
  2152→
  2153→  if (!status.branchExists) {
  2154→    // Can't repair without a branch - need full init
  2155→    return {
  2156→      success: false,
  2157→      branchCreated: false,
  2158→      worktreeCreated: false,
  2159→      gitignoreUpdated: false,
  2160→      initialCommit: false,
  2161→      alreadyExists: false,
  2162→      createdFromRemote: false,
  2163→      pushedToRemote: false,
  2164→      error: "Shadow branch does not exist. Run `kspec init` instead.",
  2165→    };
  2166→  }
  2167→
  2168→  // Branch exists but worktree is broken - repair it
  2169→  const worktreeDir = path.join(projectRoot, directoryName);
  2170→
  2171→  try {
  2172→    // Remove stale worktree reference
  2173→    try {
  2174→      await runGitAsync(projectRoot, [
  2175→        "worktree",
  2176→        "remove",
  2177→        directoryName,
  2178→        "--force",
  2179→      ]);
  2180→    } catch {
  2181→      // Ignore - worktree may not be in git's list
  2182→    }
  2183→
  2184→    // Remove directory if exists (handles corrupted .git file case)
  2185→    await fs.rm(worktreeDir, { recursive: true, force: true });
  2186→
  2187→    // Prune stale worktree references (cleans up orphaned entries)
  2188→    try {
  2189→      await runGitAsync(projectRoot, ["worktree", "prune"]);
  2190→    } catch {
  2191→      // Ignore - prune is best-effort
  2192→    }
  2193→
  2194→    // Recreate worktree
  2195→    await runGitAsync(projectRoot, [
  2196→      "worktree",
  2197→      "add",
  2198→      directoryName,
  2199→      branchName,
  2200→    ]);
  2201→
  2202→    // Install pre-commit hook
  2203→    await installShadowHook(projectRoot);
  2204→
  2205→    // AC: @artifacts-directory ac-repair-recreates
  2206→    const artifactsDir = path.join(worktreeDir, "artifacts");
  2207→    await fs.mkdir(artifactsDir, { recursive: true });
  2208→
  2209→    return {
  2210→      success: true,
  2211→      branchCreated: false,
  2212→      worktreeCreated: true,
  2213→      gitignoreUpdated: false,
  2214→      initialCommit: false,
  2215→      alreadyExists: false,
  2216→      createdFromRemote: false,
  2217→      pushedToRemote: false,
  2218→    };
  2219→  } catch (error) {
  2220→    return {
  2221→      success: false,
  2222→      branchCreated: false,
  2223→      worktreeCreated: false,
  2224→      gitignoreUpdated: false,
  2225→      initialCommit: false,
  2226→      alreadyExists: false,
  2227→      createdFromRemote: false,
  2228→      pushedToRemote: false,
  2229→      error: error instanceof Error ? error.message : String(error),
  2230→    };
  2231→  }
  2232→}
  2233→
```