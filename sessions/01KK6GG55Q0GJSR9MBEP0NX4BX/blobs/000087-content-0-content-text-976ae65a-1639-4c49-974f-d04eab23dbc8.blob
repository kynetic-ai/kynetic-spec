```
     1→/**
     2→ * Git merge driver for kspec YAML files.
     3→ *
     4→ * This command is invoked by git during merge operations to semantically
     5→ * merge kspec YAML files based on their structure rather than line-by-line.
     6→ */
     7→
     8→import * as fs from "node:fs/promises";
     9→import type { Command } from "commander";
    10→import { stringify as yamlStringify } from "yaml";
    11→import {
    12→  parseYamlVersions,
    13→  mergeObjects,
    14→  mergeUlidArrays,
    15→  mergeSetArray,
    16→  resolveConflictsInteractive,
    17→  formatConflictComment,
    18→  detectFileType,
    19→  FileType,
    20→  type MergeResult,
    21→  type ConflictInfo,
    22→  type ObjectMergeResult,
    23→} from "../../merge/index.js";
    24→import {
    25→  initContext,
    26→  loadAllTasks,
    27→  loadAllItems,
    28→} from "../../parser/yaml.js";
    29→import { loadMetaContext } from "../../parser/meta.js";
    30→import { ReferenceIndex } from "../../parser/refs.js";
    31→
    32→/**
    33→ * Result type for root-level merges that can be either object or array.
    34→ */
    35→interface RootMergeResult {
    36→  merged: Record<string, unknown> | unknown[];
    37→  conflicts: ConflictInfo[];
    38→  isArray: boolean;
    39→}
    40→import { EXIT_CODES } from "../exit-codes.js";
    41→import { error } from "../output.js";
    42→
    43→/**
    44→ * Field names that contain kspec refs and should use normalized merging.
    45→ * AC: @merge-ref-normalization ac-1
    46→ */
    47→const REF_SET_FIELDS = [
    48→  "depends_on",
    49→  "blocked_by",
    50→  "implements",
    51→  "relates_to",
    52→  "tests",
    53→  "context",
    54→  "traits",
    55→];
    56→
    57→/**
    58→ * Check if a field name is a ref-containing set field.
    59→ */
    60→function isRefSetField(fieldName: string): boolean {
    61→  return REF_SET_FIELDS.includes(fieldName);
    62→}
    63→
    64→/**
    65→ * Lazily build a ReferenceIndex for ref normalization.
    66→ * Returns undefined if context can't be initialized (graceful degradation).
    67→ *
    68→ * AC: @merge-ref-normalization ac-2
    69→ * Graceful degradation when context unavailable.
    70→ */
    71→async function buildRefIndex(): Promise<ReferenceIndex | undefined> {
    72→  try {
    73→    // Initialize from current working directory
    74→    // The merge driver runs from the project root
    75→    const ctx = await initContext();
    76→
    77→    // Load all items needed for the index
    78→    const tasks = await loadAllTasks(ctx);
    79→    const items = await loadAllItems(ctx);
    80→    const metaContext = await loadMetaContext(ctx);
    81→    const metaItems = [
    82→      ...metaContext.agents,
    83→      ...metaContext.workflows,
    84→      ...metaContext.conventions,
    85→      ...metaContext.observations,
    86→    ];
    87→
    88→    return new ReferenceIndex(tasks, items, metaItems);
    89→  } catch {
    90→    // Failed to load context - return undefined for graceful degradation
    91→    return undefined;
    92→  }
    93→}
    94→
    95→/**
    96→ * Enhanced object merge that handles arrays with ULID items specially.
    97→ *
    98→ * For array fields containing objects with _ulid, uses ULID-based merging
    99→ * to first merge the array structure, then recursively merges each item.
   100→ *
   101→ * AC: @merge-ref-normalization ac-1
   102→ * For ref-containing set fields (depends_on, etc), uses normalized comparison.
   103→ */
   104→function mergeObjectsWithArrays(
   105→  base: Record<string, unknown> | undefined,
   106→  ours: Record<string, unknown> | undefined,
   107→  theirs: Record<string, unknown> | undefined,
   108→  path = "",
   109→  refIndex?: ReferenceIndex,
   110→): ObjectMergeResult {
   111→  const baseObj = base ?? {};
   112→  const oursObj = ours ?? {};
   113→  const theirsObj = theirs ?? {};
   114→
   115→  const merged: Record<string, unknown> = {};
   116→  const conflicts: ConflictInfo[] = [];
   117→
   118→  // Collect all keys
   119→  const allKeys = new Set([
   120→    ...Object.keys(baseObj),
   121→    ...Object.keys(oursObj),
   122→    ...Object.keys(theirsObj),
   123→  ]);
   124→
   125→  for (const key of allKeys) {
   126→    const fieldPath = path ? `${path}.${key}` : key;
   127→    const baseVal = baseObj[key];
   128→    const oursVal = oursObj[key];
   129→    const theirsVal = theirsObj[key];
   130→
   131→    // Check if this is a ref-containing set field (string arrays like depends_on)
   132→    // AC: @merge-ref-normalization ac-1
   133→    if (
   134→      isRefSetField(key) &&
   135→      (Array.isArray(baseVal) || Array.isArray(oursVal) || Array.isArray(theirsVal))
   136→    ) {
   137→      // Use ref-normalized set merge
   138→      const mergedSet = mergeSetArray(
   139→        baseVal as string[] | undefined,
   140→        oursVal as string[] | undefined,
   141→        theirsVal as string[] | undefined,
   142→        refIndex,
   143→      );
   144→      merged[key] = mergedSet;
   145→      continue;
   146→    }
   147→
   148→    // Check if this field is an array of ULID items
   149→    if (
   150→      Array.isArray(baseVal) &&
   151→      Array.isArray(oursVal) &&
   152→      Array.isArray(theirsVal) &&
   153→      hasUlidItems(oursVal as unknown[])
   154→    ) {
   155→      // Use ULID array merging
   156→      const mergedArray = mergeUlidArrays(
   157→        baseVal as Array<{ _ulid: string }>,
   158→        oursVal as Array<{ _ulid: string }>,
   159→        theirsVal as Array<{ _ulid: string }>,
   160→      );
   161→
   162→      // Now merge each item in the array recursively
   163→      const mergedItems: unknown[] = [];
   164→      for (const item of mergedArray) {
   165→        const itemUlid = (item as any)._ulid;
   166→        const baseItem = (baseVal as any[]).find((i: any) => i._ulid === itemUlid);
   167→        const oursItem = (oursVal as any[]).find((i: any) => i._ulid === itemUlid);
   168→        const theirsItem = (theirsVal as any[]).find((i: any) => i._ulid === itemUlid);
   169→
   170→        if (oursItem && theirsItem) {
   171→          // Item exists in both - merge fields
   172→          const itemMerge = mergeObjects(
   173→            baseItem as Record<string, unknown> | undefined,
   174→            oursItem as Record<string, unknown>,
   175→            theirsItem as Record<string, unknown>,
   176→            `${fieldPath}[${itemUlid}]`,
   177→          );
   178→          mergedItems.push(itemMerge.merged);
   179→          conflicts.push(...itemMerge.conflicts);
   180→        } else {
   181→          // Item only in one side - use it as-is
   182→          mergedItems.push(item);
   183→        }
   184→      }
   185→
   186→      merged[key] = mergedItems;
   187→    } else {
   188→      // Not a ULID array - use standard object merge for this field
   189→      const fieldMerge = mergeObjects(
   190→        { [key]: baseVal },
   191→        { [key]: oursVal },
   192→        { [key]: theirsVal },
   193→        path,
   194→      );
   195→      if (key in fieldMerge.merged) {
   196→        merged[key] = fieldMerge.merged[key];
   197→      }
   198→      conflicts.push(...fieldMerge.conflicts);
   199→    }
   200→  }
   201→
   202→  return { merged, conflicts };
   203→}
   204→
   205→/**
   206→ * Check if an array contains items with _ulid field.
   207→ */
   208→function hasUlidItems(arr: unknown[]): boolean {
   209→  if (arr.length === 0) return false;
   210→  const first = arr[0];
   211→  return (
   212→    typeof first === 'object' &&
   213→    first !== null &&
   214→    '_ulid' in first &&
   215→    typeof (first as any)._ulid === 'string'
   216→  );
   217→}
   218→
   219→/**
   220→ * Check if a value is a root-level array (not an object).
   221→ */
   222→function isRootArray(value: unknown): value is unknown[] {
   223→  return Array.isArray(value);
   224→}
   225→
   226→/**
   227→ * Merge root-level arrays with ULID-based deduplication and field-level conflict detection.
   228→ * AC: @merge-file-detection ac-7
   229→ */
   230→function mergeRootArrays(
   231→  base: unknown,
   232→  ours: unknown,
   233→  theirs: unknown,
   234→): RootMergeResult {
   235→  const baseArr = Array.isArray(base) ? base : [];
   236→  const oursArr = Array.isArray(ours) ? ours : [];
   237→  const theirsArr = Array.isArray(theirs) ? theirs : [];
   238→
   239→  const conflicts: ConflictInfo[] = [];
   240→
   241→  // Check if arrays contain ULID items
   242→  if (!hasUlidItems(oursArr) && !hasUlidItems(theirsArr)) {
   243→    // Non-ULID arrays: keep ours (fallback)
   244→    return { merged: oursArr, conflicts: [], isArray: true };
   245→  }
   246→
   247→  // Use ULID array merging
   248→  const mergedArray = mergeUlidArrays(
   249→    baseArr as Array<{ _ulid: string }>,
   250→    oursArr as Array<{ _ulid: string }>,
   251→    theirsArr as Array<{ _ulid: string }>,
   252→  );
   253→
   254→  // Merge each item recursively for field-level conflicts
   255→  const mergedItems: unknown[] = [];
   256→  for (const item of mergedArray) {
   257→    const itemUlid = (item as any)._ulid;
   258→    const baseItem = baseArr.find((i: any) => i._ulid === itemUlid);
   259→    const oursItem = oursArr.find((i: any) => i._ulid === itemUlid);
   260→    const theirsItem = theirsArr.find((i: any) => i._ulid === itemUlid);
   261→
   262→    if (oursItem && theirsItem) {
   263→      // Item exists in both - merge fields
   264→      const itemMerge = mergeObjects(
   265→        baseItem as Record<string, unknown> | undefined,
   266→        oursItem as Record<string, unknown>,
   267→        theirsItem as Record<string, unknown>,
   268→        `[${itemUlid}]`,
   269→      );
   270→      mergedItems.push(itemMerge.merged);
   271→      conflicts.push(...itemMerge.conflicts);
   272→    } else {
   273→      mergedItems.push(item);
   274→    }
   275→  }
   276→
   277→  return {
   278→    merged: mergedItems,
   279→    conflicts,
   280→    isArray: true,
   281→  };
   282→}
   283→
   284→/**
   285→ * Perform a semantic merge of three YAML files.
   286→ *
   287→ * AC: @merge-driver-cli ac-1
   288→ * Reads base (%O), ours (%A), theirs (%B) and writes merged result to %A path.
   289→ *
   290→ * @param basePath Path to base version (common ancestor)
   291→ * @param oursPath Path to ours version (current branch) - also output path
   292→ * @param theirsPath Path to theirs version (incoming branch)
   293→ * @param options Merge options
   294→ * @returns MergeResult with merged content and conflict info
   295→ */
   296→async function performSemanticMerge(
   297→  basePath: string,
   298→  oursPath: string,
   299→  theirsPath: string,
   300→  options: {
   301→    nonInteractive: boolean;
   302→    filePath?: string;
   303→  },
   304→): Promise<MergeResult> {
   305→  // Parse all three versions
   306→  const parseResult = await parseYamlVersions(basePath, oursPath, theirsPath);
   307→
   308→  if (!parseResult.success) {
   309→    return {
   310→      content: "",
   311→      hasConflicts: true,
   312→      conflicts: [],
   313→      parseFailed: true,
   314→      parseError: parseResult.error,
   315→    };
   316→  }
   317→
   318→  const { versions } = parseResult;
   319→  if (!versions) {
   320→    return {
   321→      content: "",
   322→      hasConflicts: true,
   323→      conflicts: [],
   324→      parseFailed: true,
   325→      parseError: "No versions parsed",
   326→    };
   327→  }
   328→
   329→  // Detect file type for future specialized merging
   330→  const _fileType = options.filePath
   331→    ? detectFileType(options.filePath)
   332→    : FileType.Unknown;
   333→
   334→  // For now, use generic object merging for all types
   335→  // Future: Specialized merging based on _fileType
   336→
   337→  // Build reference index for ref normalization (lazy, may fail gracefully)
   338→  // AC: @merge-ref-normalization ac-1, ac-2
   339→  const refIndex = await buildRefIndex();
   340→
   341→  // Check if root is array vs object (check all three versions)
   342→  // AC: @merge-file-detection ac-7
   343→  const isRootLevelArray = isRootArray(versions.base) || isRootArray(versions.ours) || isRootArray(versions.theirs);
   344→
   345→  let finalMerged: Record<string, unknown> | unknown[];
   346→  let conflicts: ConflictInfo[];
   347→
   348→  if (isRootLevelArray) {
   349→    const arrayResult = mergeRootArrays(versions.base, versions.ours, versions.theirs);
   350→    finalMerged = arrayResult.merged;
   351→    conflicts = arrayResult.conflicts;
   352→  } else {
   353→    const objectResult = mergeObjectsWithArrays(
   354→      versions.base as Record<string, unknown>,
   355→      versions.ours as Record<string, unknown>,
   356→      versions.theirs as Record<string, unknown>,
   357→      "",
   358→      refIndex,
   359→    );
   360→    finalMerged = objectResult.merged;
   361→    conflicts = objectResult.conflicts;
   362→  }
   363→
   364→  // Handle conflicts based on mode
   365→  if (conflicts.length > 0) {
   366→    if (options.nonInteractive) {
   367→      // AC: @merge-driver-cli ac-3
   368→      // Non-interactive: keep ours value and add conflict comments
   369→      // Conflicts are already in the conflicts array, merged object uses ours by default
   370→    } else {
   371→      // Interactive: prompt user for each conflict
   372→      const resolutions = await resolveConflictsInteractive(conflicts);
   373→
   374→      // Apply resolutions to merged object
   375→      for (const resolution of resolutions) {
   376→        if (resolution.choice !== "skip") {
   377→          applyResolution(finalMerged, resolution.conflict.path, resolution.value);
   378→        }
   379→      }
   380→    }
   381→  }
   382→
   383→  // Convert merged object back to YAML
   384→  let mergedYaml = yamlStringify(finalMerged, {
   385→    lineWidth: 0, // Disable line wrapping
   386→    indent: 2,
   387→  });
   388→
   389→  // In non-interactive mode, add conflict comments at the top
   390→  // AC: @merge-driver-cli ac-3
   391→  if (options.nonInteractive && conflicts.length > 0) {
   392→    const conflictComments: string[] = [];
   393→    for (const conflict of conflicts) {
   394→      conflictComments.push(...formatConflictComment(conflict));
   395→    }
   396→    mergedYaml = conflictComments.join("\n") + "\n\n" + mergedYaml;
   397→  }
   398→
   399→  return {
   400→    content: mergedYaml,
   401→    hasConflicts: conflicts.length > 0,
   402→    conflicts,
   403→    parseFailed: false,
   404→  };
   405→}
   406→
   407→/**
   408→ * Apply a resolution to a merged object or array at a given path.
   409→ * Path format: "field.nestedField", "array[0].field", or "[ulid].field" for root arrays
   410→ */
   411→function applyResolution(
   412→  obj: Record<string, unknown> | unknown[],
   413→  path: string,
   414→  value: unknown,
   415→): void {
   416→  const parts = path.split(/\.|\[|\]/).filter((p) => p.length > 0);
   417→  let current: any = obj;
   418→
   419→  // Handle root array: first part is ULID, find item by it
   420→  if (Array.isArray(obj) && parts.length > 0) {
   421→    const ulid = parts[0];
   422→    const itemIndex = obj.findIndex((item: any) => item._ulid === ulid);
   423→    if (itemIndex === -1) return;
   424→    if (parts.length === 1) {
   425→      // Replacing entire item - not typical
   426→      obj[itemIndex] = value;
   427→      return;
   428→    }
   429→    current = obj[itemIndex];
   430→    parts.shift(); // Remove ULID, continue with remaining path
   431→  }
   432→
   433→  for (let i = 0; i < parts.length - 1; i++) {
   434→    const part = parts[i];
   435→    if (!(part in current)) {
   436→      current[part] = {};
   437→    }
   438→    current = current[part];
   439→  }
   440→
   441→  const lastPart = parts[parts.length - 1];
   442→  if (value === undefined) {
   443→    delete current[lastPart];
   444→  } else {
   445→    current[lastPart] = value;
   446→  }
   447→}
   448→
   449→/**
   450→ * Format a summary message about the merge result.
   451→ *
   452→ * AC: @merge-driver-cli ac-2
   453→ * Shows summary of what was merged/conflicted on stderr.
   454→ */
   455→function formatMergeSummary(result: MergeResult): string {
   456→  const lines: string[] = [];
   457→
   458→  if (result.parseFailed) {
   459→    lines.push("Merge failed: Parse error");
   460→    if (result.parseError) {
   461→      lines.push(`  ${result.parseError}`);
   462→    }
   463→    lines.push("  Falling back to standard git merge");
   464→    return lines.join("\n");
   465→  }
   466→
   467→  if (result.hasConflicts) {
   468→    lines.push(`Merged with ${result.conflicts.length} conflict(s):`);
   469→    for (const conflict of result.conflicts) {
   470→      lines.push(`  - ${conflict.path}: ${conflict.description}`);
   471→    }
   472→  } else {
   473→    lines.push("Merged successfully (no conflicts)");
   474→  }
   475→
   476→  return lines.join("\n");
   477→}
   478→
   479→/**
   480→ * Register the 'merge-driver' command.
   481→ *
   482→ * Git invokes merge drivers with these positional arguments:
   483→ *   %O - base version (common ancestor)
   484→ *   %A - ours version (current branch) - also the output path
   485→ *   %B - theirs version (incoming branch)
   486→ *   %L - conflict marker size (optional, unused by semantic merge)
   487→ *   %P - file path (optional, for context)
   488→ */
   489→export function registerMergeDriverCommand(program: Command): void {
   490→  program
   491→    .command("merge-driver <base> <ours> <theirs> [markerSize] [path]")
   492→    .description("Git merge driver for semantic YAML merging")
   493→    .option(
   494→      "--non-interactive",
   495→      "Run in non-interactive mode (write conflicts as comments)",
   496→    )
   497→    .action(
   498→      async (
   499→        basePath: string,
   500→        oursPath: string,
   501→        theirsPath: string,
   502→        _markerSize: string | undefined,
   503→        filePath: string | undefined,
   504→        options: { nonInteractive?: boolean },
   505→      ) => {
   506→        try {
   507→          // AC: @merge-driver-cli ac-1
   508→          // Perform semantic merge
   509→          const result = await performSemanticMerge(
   510→            basePath,
   511→            oursPath,
   512→            theirsPath,
   513→            {
   514→              nonInteractive: options.nonInteractive || !process.stdin.isTTY,
   515→              filePath,
   516→            },
   517→          );
   518→
   519→          // If parse failed, exit with error code to trigger git's fallback
   520→          if (result.parseFailed) {
   521→            // AC: @merge-driver-cli ac-2
   522→            console.error(formatMergeSummary(result));
   523→            process.exit(EXIT_CODES.ERROR);
   524→          }
   525→
   526→          // Write merged result to ours path (git expects output at %A)
   527→          // AC: @merge-driver-cli ac-1
   528→          await fs.writeFile(oursPath, result.content, "utf-8");
   529→
   530→          // AC: @merge-driver-cli ac-2
   531→          // Write summary to stderr for user visibility
   532→          console.error(formatMergeSummary(result));
   533→
   534→          // AC: @yaml-merge-driver ac-9, ac-10
   535→          // Non-interactive: always exit 0 (conflicts are written as YAML comments,
   536→          // exit 1 would cause git to fall back to text merge, corrupting YAML)
   537→          // Interactive: exit 1 if unresolved conflicts remain
   538→          if (options.nonInteractive || !process.stdin.isTTY) {
   539→            process.exit(0);
   540→          }
   541→          process.exit(result.hasConflicts ? 1 : 0);
   542→        } catch (err) {
   543→          error("Merge driver failed", err);
   544→          process.exit(EXIT_CODES.ERROR);
   545→        }
   546→      },
   547→    );
   548→}
   549→
```