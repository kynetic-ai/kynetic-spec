   146→        title: Maturity States
   147→        type: requirement
   148→        status:
   149→          maturity: draft
   150→          implementation: verified
   151→        description: |-
   152→          status.maturity tracks spec content stability:
   153→
   154→          - draft: Initial capture, may change significantly
   155→          - proposed: Ready for review, seeking approval
   156→          - stable: Approved, changes require process
   157→          - deferred: Intentionally postponed, not abandoned
   158→          - deprecated: Superseded or no longer relevant
   159→
   160→          Lifecycle: draft -> proposed -> stable -> deprecated
   161→                      draft -> deferred (for stub specs)
   162→                      deferred -> draft (when resuming work)
   163→        implements:
   164→          - "@status-lifecycle"
   165→        acceptance_criteria:
   166→          - id: ac-1
   167→            given: "a spec item with maturity: deferred"
   168→            when: viewing or filtering items
   169→            then: the deferred status is recognized and displayed correctly
   170→          - id: ac-2
   171→            given: creating or updating a spec item
   172→            when: setting maturity to deferred
   173→            then: the value is accepted and persisted
