   395→        type: requirement
   396→        status:
   397→          maturity: draft
   398→          implementation: implemented
   399→        description: |
   400→          "A depends_on B" means A requires B to be completed/available.
   401→          Used for: ordering work, tracking prerequisites.
   402→
   403→          For tasks: Auto-blocks A until B is completed.
   404→        implements:
   405→          - '@relationship-types'
   406→      - _ulid: 01KEZCJPJ2MKTF1V4PCN9X6Y7K
   407→        slugs:
