   410→        type: requirement
   411→        status:
   412→          maturity: draft
   413→          implementation: implemented
   414→        description: |
   415→          "A implements B" means A is a realization of B.
   416→          Used for: requirement-to-task, feature-to-module.
   417→
   418→          Enables traceability from high-level to concrete.
   419→        implements:
   420→          - '@relationship-types'
   421→      - _ulid: 01KEZCJPJ2JS9T7PSR30RMDCFE
   422→        slugs:
