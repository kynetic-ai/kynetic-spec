   337→/**
   338→ * Format fix results for display
   339→ */
   340→function formatFixResult(result: FixResult): void {
   341→  if (result.fixesApplied.length === 0) {
   342→    console.log(chalk.gray('\nNo auto-fixable issues found.'));
   343→    return;
   344→  }
   345→
   346→  console.log(chalk.cyan(`\n✓ Applied ${result.fixesApplied.length} fix(es) to ${result.filesModified} file(s):`));
   347→
   348→  for (const fix of result.fixesApplied) {
   349→    const typeLabel = {
   350→      ulid_regenerated: 'ULID regenerated',
   351→      timestamp_added: 'Timestamp added',
   352→      status_added: 'Status added',
   353→    }[fix.type];
   354→
   355→    const shortFile = path.basename(fix.file);
   356→    console.log(chalk.cyan(`  ✓ ${shortFile}:${fix.path} - ${typeLabel}`));
   357→  }
   358→
   359→  if (result.errors.length > 0) {
   360→    console.log(chalk.yellow(`\nFix errors: ${result.errors.length}`));
   361→    for (const err of result.errors) {
   362→      console.log(chalk.yellow(`  ! ${err.file}: ${err.message}`));
   363→    }
   364→  }
   365→}
   366→
   367→/**
   368→ * Collect all files that can be fixed
   369→ */
   370→async function collectFixableFiles(ctx: { rootDir: string; specDir?: string; manifest?: { includes?: string[] } | null; manifestPath?: string | null }): Promise<string[]> {
   371→  const files: string[] = [];
   372→
   373→  // Task files (exclude test fixtures)
   374→  const taskFiles = await findTaskFiles(ctx.rootDir);
   375→  const specTaskFiles = await findTaskFiles(path.join(ctx.rootDir, 'spec'));
   376→  const allTaskFiles = [...new Set([...taskFiles, ...specTaskFiles])];
   377→  files.push(...allTaskFiles.filter(f => !f.includes('fixtures') && !f.includes('test')));
   378→
   379→  // Spec files from includes
   380→  if (ctx.manifest && ctx.manifestPath) {
   381→    const manifestDir = path.dirname(ctx.manifestPath);
   382→    const includes = ctx.manifest.includes || [];
   383→
   384→    for (const include of includes) {
   385→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   386→      files.push(...expandedPaths);
   387→    }
   388→  }
   389→
   390→  // Inbox file
   391→  const inboxPath = path.join(ctx.rootDir, 'spec', 'kynetic.inbox.yaml');
   392→  try {
   393→    await import('node:fs/promises').then(fs => fs.access(inboxPath));
   394→    files.push(inboxPath);
   395→  } catch {
   396→    // Inbox file doesn't exist, skip
   397→  }
   398→
   399→  return [...new Set(files)];
   400→}
   401→
   402→/**
   403→ * Format validation result for display
   404→ */
   405→function formatValidationResult(result: ValidationResult, verbose: boolean): void {
   406→  // Header
   407→  if (result.valid) {
   408→    console.log(chalk.green.bold('✓ Validation passed'));
   409→  } else {
   410→    console.log(chalk.red.bold('✗ Validation failed'));
   411→  }
   412→
   413→  console.log(chalk.gray('─'.repeat(40)));
   414→  console.log(`Files checked: ${result.stats.filesChecked}`);
   415→  console.log(`Items checked: ${result.stats.itemsChecked}`);
   416→  console.log(`Tasks checked: ${result.stats.tasksChecked}`);
   417→
   418→  // AC-meta-manifest-2: Display meta summary line
   419→  if (result.metaStats) {
   420→    console.log(`Meta: ${result.metaStats.agents} agents, ${result.metaStats.workflows} workflows, ${result.metaStats.conventions} conventions`);
   421→  }
   422→
   423→  // Schema errors
   424→  if (result.schemaErrors.length > 0) {
   425→    console.log(chalk.red(`\nSchema errors: ${result.schemaErrors.length}`));
   426→    for (const err of result.schemaErrors) {
   427→      const location = err.path ? `${err.file}:${err.path}` : err.file;
   428→      console.log(chalk.red(`  ✗ ${location}`));
   429→      console.log(chalk.gray(`    ${err.message}`));
   430→      if (verbose && err.details) {
   431→        console.log(chalk.gray(`    ${JSON.stringify(err.details)}`));
   432→      }
   433→    }
   434→  } else {
   435→    console.log(chalk.green('\nSchema: OK'));
   436→  }
   437→
   438→  // Reference errors
   439→  if (result.refErrors.length > 0) {
   440→    console.log(chalk.red(`\nReference errors: ${result.refErrors.length}`));
   441→    for (const err of result.refErrors) {
   442→      const location = err.sourceFile
   443→        ? `${err.sourceFile} (${err.field})`
   444→        : `${err.sourceUlid?.slice(0, 8)} (${err.field})`;
   445→      console.log(chalk.red(`  ✗ ${err.ref}`));
   446→      console.log(chalk.gray(`    ${err.message}`));
   447→      console.log(chalk.gray(`    in: ${location}`));
   448→    }
   449→  } else {
   450→    console.log(chalk.green('References: OK'));
   451→  }
   452→
   453→  // Reference warnings (deprecated targets)
   454→  if (result.refWarnings.length > 0) {
   455→    console.log(chalk.yellow(`\nReference warnings: ${result.refWarnings.length}`));
   456→    const shown = verbose ? result.refWarnings : result.refWarnings.slice(0, 5);
   457→    for (const warn of shown) {
   458→      const location = warn.sourceFile
   459→        ? `${warn.sourceFile} (${warn.field})`
   460→        : `${warn.sourceUlid?.slice(0, 8)} (${warn.field})`;
   461→      console.log(chalk.yellow(`  ⚠ ${warn.ref}`));
   462→      console.log(chalk.gray(`    ${warn.message}`));
   463→      console.log(chalk.gray(`    in: ${location}`));
   464→    }
   465→    if (!verbose && result.refWarnings.length > 5) {
   466→      console.log(chalk.gray(`  ... and ${result.refWarnings.length - 5} more (use -v to see all)`));
   467→    }
   468→  }
   469→
   470→  // AC: @trait-edge-cases ac-2
   471→  // Trait cycle errors
   472→  if (result.traitCycleErrors.length > 0) {
   473→    console.log(chalk.red(`\nTrait cycle errors: ${result.traitCycleErrors.length}`));
   474→    for (const err of result.traitCycleErrors) {
   475→      console.log(chalk.red(`  ✗ ${err.traitRef} - ${err.traitTitle}`));
   476→      console.log(chalk.gray(`    ${err.message}`));
   477→    }
   478→  }
   479→
   480→  // Orphans (warnings, not errors)
   481→  if (result.orphans.length > 0) {
   482→    console.log(chalk.yellow(`\nOrphans (not referenced): ${result.orphans.length}`));
   483→    if (verbose) {
   484→      for (const orphan of result.orphans) {
   485→        console.log(chalk.yellow(`  ○ ${orphan.ulid.slice(0, 8)} [${orphan.type}] ${orphan.title}`));
   486→      }
   487→    } else {
   488→      // Show first few
   489→      const shown = result.orphans.slice(0, 5);
   490→      for (const orphan of shown) {
   491→        console.log(chalk.yellow(`  ○ ${orphan.ulid.slice(0, 8)} [${orphan.type}] ${orphan.title}`));
   492→      }
   493→      if (result.orphans.length > 5) {
   494→        console.log(chalk.gray(`  ... and ${result.orphans.length - 5} more (use -v to see all)`));
   495→      }
   496→    }
   497→  }
   498→}
   499→
   500→/**
   501→ * Register validate command
   502→ */
   503→export function registerValidateCommand(program: Command): void {
   504→  program
   505→    .command('validate')
   506→    .description('Validate spec files')
   507→    .option('--schema', 'Check schema conformance only')
   508→    .option('--refs', 'Check reference resolution only')
   509→    .option('--orphans', 'Find orphaned items only')
   510→    .option('--alignment', 'Check spec-task alignment')
   511→    .option('--completeness', 'Check spec completeness (missing AC, descriptions, status inconsistencies)')
   512→    .option('--conventions', 'Validate conventions')
   513→    .option('--staleness', 'Check for stale status mismatches between specs and tasks')
   514→    .option('--fix', 'Auto-fix issues where possible (invalid ULIDs, missing timestamps)')
   515→    .option('-v, --verbose', 'Show detailed output')
   516→    .option('--strict', 'Treat orphans and staleness warnings as errors')
   517→    .action(async (options) => {
   518→      try {
   519→        const ctx = await initContext();
   520→
   521→        if (!ctx.manifestPath) {
   522→          error(validationStrings.noManifest);
   523→          console.log(validationStrings.initHint);
   524→          process.exit(EXIT_CODES.ERROR);
   525→        }
   526→
   527→        // Determine which checks to run
   528→        const runAll = !options.schema && !options.refs && !options.orphans && !options.alignment && !options.completeness && !options.conventions;
   529→        const validateOptions = {
   530→          schema: runAll || options.schema,
   531→          refs: runAll || options.refs,
   532→          orphans: runAll || options.orphans,
   533→          completeness: runAll || options.completeness,
   534→        };
   535→
   536→        const result = await validate(ctx, validateOptions);
   537→
   538→        // In strict mode, orphans are errors
   539→        if (options.strict && result.orphans.length > 0) {
   540→          result.valid = false;
   541→        }
   542→
   543→        output(result, () => formatValidationResult(result, options.verbose));
   544→
   545→        // Run auto-fix if requested
   546→        if (options.fix) {
   547→          const filesToFix = await collectFixableFiles(ctx);
   548→          const fixResult = await fixFiles(filesToFix);
   549→          formatFixResult(fixResult);
   550→
   551→          // Re-run validation after fixes to show updated status
   552→          if (fixResult.fixesApplied.length > 0) {
   553→            console.log(validationStrings.revalidating);
   554→            const revalidateResult = await validate(ctx, validateOptions);
   555→            if (revalidateResult.valid) {
   556→              console.log(validationStrings.nowPasses);
   557→            } else {
   558→              console.log(validationStrings.issuesRemain);
   559→            }
   560→            // Update result for exit code
   561→            result.valid = revalidateResult.valid;
   562→            result.schemaErrors = revalidateResult.schemaErrors;
   563→            result.refErrors = revalidateResult.refErrors;
   564→          }
   565→        }
   566→
   567→        // Run alignment check if requested or running all checks
   568→        if (options.alignment || runAll) {
   569→          const tasks = await loadAllTasks(ctx);
   570→          const items = await loadAllItems(ctx);
   571→          const refIndex = new ReferenceIndex(tasks, items);
   572→          const alignmentIndex = new AlignmentIndex(tasks, items);
   573→          alignmentIndex.buildLinks(refIndex);
   574→
   575→          const alignmentWarnings = alignmentIndex.findAlignmentWarnings();
   576→          formatAlignmentWarnings(alignmentWarnings, options.verbose);
   577→
   578→          // Show alignment stats
   579→          const stats = alignmentIndex.getStats();
   580→          console.log(
   581→            validationStrings.alignmentStats(stats.specsWithTasks, stats.totalSpecs, stats.alignedSpecs)
   582→          );
   583→        }
   584→
   585→        // Show completeness warnings if any
   586→        // AC: @spec-completeness ac-4
   587→        if (result.completenessWarnings.length > 0) {
   588→          formatCompletenessWarnings(result.completenessWarnings, options.verbose);
   589→        }
   590→
   591→        // Run convention validation if requested
   592→        // AC: @convention-definitions ac-3, ac-4
   593→        if (options.conventions) {
   594→          try {
   595→            const metaCtx = await loadMetaContext(ctx);
   596→            if (metaCtx && metaCtx.conventions.length > 0) {
   597→              // For now, we just validate that conventions are well-formed
   598→              // Full validation against actual content (commits, notes, etc.)
   599→              // would require additional content gathering logic
   600→              const conventionResult = validateConventions(metaCtx.conventions, {});
   601→              formatConventionValidationResult(conventionResult);
   602→
   603→              if (!conventionResult.valid) {
   604→                result.valid = false;
   605→              }
   606→            } else {
   607→              console.log(chalk.gray('No conventions defined in meta manifest'));
   608→            }
   609→          } catch (err) {
   610→            console.log(chalk.yellow('Warning: Could not load meta manifest for convention validation'));
   611→          }
   612→        }
   613→
   614→        // Run staleness checks if requested
   615→        // AC: @stale-status-detection ac-4, ac-5
   616→        if (options.staleness) {
   617→          const tasks = await loadAllTasks(ctx);
   618→          const items = await loadAllItems(ctx);
   619→          const refIndex = new ReferenceIndex(tasks, items);
   620→
   621→          const stalenessWarnings = checkStaleness(items, tasks, refIndex);
   622→          formatStalenessWarnings(stalenessWarnings, options.verbose);
   623→
   624→          // AC: @stale-status-detection ac-5 (staleness-exit-code)
   625→          // With --strict, staleness warnings cause validation failure
   626→          if (options.strict && stalenessWarnings.length > 0) {
   627→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   628→          }
   629→        }
   630→
   631→        if (!result.valid) {
   632→          process.exit(EXIT_CODES.ERROR);
   633→        }
   634→      } catch (err) {
   635→        error(validationStrings.failed, err);
   636→        process.exit(EXIT_CODES.ERROR);
   637→      }
   638→    });
   639→
   640→  // Alias: kspec lint
   641→  program
   642→    .command('lint')
   643→    .description('Alias for validate with style checks')
   644→    .option('--schema', 'Check schema conformance only')
   645→    .option('--refs', 'Check reference resolution only')
   646→    .option('--orphans', 'Find orphaned items only')
   647→    .option('--completeness', 'Check spec completeness (missing AC, descriptions, status inconsistencies)')
   648→    .option('--fix', 'Auto-fix issues where possible (invalid ULIDs, missing timestamps)')
   649→    .option('-v, --verbose', 'Show detailed output')
   650→    .option('--strict', 'Treat orphans as errors')
   651→    .action(async (options) => {
   652→      try {
   653→        const ctx = await initContext();
   654→
   655→        if (!ctx.manifestPath) {
   656→          error(validationStrings.noManifest);
   657→          process.exit(EXIT_CODES.ERROR);
   658→        }
   659→
   660→        const runAll = !options.schema && !options.refs && !options.orphans && !options.completeness;
   661→        const validateOptions = {
   662→          schema: runAll || options.schema,
   663→          refs: runAll || options.refs,
   664→          orphans: runAll || options.orphans,
   665→          completeness: runAll || options.completeness,
   666→        };
   667→
   668→        const result = await validate(ctx, validateOptions);
   669→
   670→        if (options.strict && result.orphans.length > 0) {
   671→          result.valid = false;
   672→        }
   673→
   674→        output(result, () => formatValidationResult(result, options.verbose));
   675→
   676→        // Run auto-fix if requested
   677→        if (options.fix) {
   678→          const filesToFix = await collectFixableFiles(ctx);
   679→          const fixResult = await fixFiles(filesToFix);
   680→          formatFixResult(fixResult);
   681→
   682→          // Re-run validation after fixes
   683→          if (fixResult.fixesApplied.length > 0) {
   684→            console.log(validationStrings.revalidating);
   685→            const revalidateResult = await validate(ctx, validateOptions);
   686→            if (revalidateResult.valid) {
   687→              console.log(validationStrings.nowPasses);
   688→            } else {
   689→              console.log(validationStrings.issuesRemain);
   690→            }
   691→            result.valid = revalidateResult.valid;
   692→          }
   693→        }
   694→
   695→        if (!result.valid) {
   696→          process.exit(EXIT_CODES.ERROR);
   697→        }
   698→      } catch (err) {
   699→        error(validationStrings.lintFailed, err);
   700→        process.exit(EXIT_CODES.ERROR);
   701→      }
   702→    });
   703→}
   704→

