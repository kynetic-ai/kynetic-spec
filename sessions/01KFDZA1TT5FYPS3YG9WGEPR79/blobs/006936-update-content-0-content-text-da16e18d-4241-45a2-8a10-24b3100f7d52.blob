```
     1→/**
     2→ * Validation module for kspec files.
     3→ *
     4→ * Provides schema validation, reference validation, and orphan detection.
     5→ */
     6→
     7→import * as fs from 'node:fs/promises';
     8→import * as path from 'node:path';
     9→import {
    10→  TaskSchema,
    11→  TasksFileSchema,
    12→  ManifestSchema,
    13→  SpecItemSchema,
    14→  MetaManifestSchema,
    15→  AgentSchema,
    16→  WorkflowSchema,
    17→  ConventionSchema,
    18→  ObservationSchema,
    19→  UlidSchema,
    20→} from '../schema/index.js';
    21→import type { KspecContext, LoadedTask, LoadedSpecItem } from './yaml.js';
    22→import {
    23→  readYamlFile,
    24→  findTaskFiles,
    25→  loadSpecFile,
    26→  expandIncludePattern,
    27→  extractItemsFromRaw,
    28→} from './yaml.js';
    29→import { ReferenceIndex, validateRefs, type RefValidationError, type RefValidationWarning } from './refs.js';
    30→import { findMetaManifest, loadMetaContext, type MetaContext } from './meta.js';
    31→import { TraitIndex } from './traits.js';
    32→
    33→// ============================================================
    34→// TYPES
    35→// ============================================================
    36→
    37→/**
    38→ * Schema validation error
    39→ */
    40→export interface SchemaValidationError {
    41→  file: string;
    42→  path?: string;
    43→  message: string;
    44→  details?: unknown;
    45→}
    46→
    47→/**
    48→ * Orphan item (not referenced by anything)
    49→ */
    50→export interface OrphanItem {
    51→  ulid: string;
    52→  title: string;
    53→  type: string;
    54→  file?: string;
    55→}
    56→
    57→/**
    58→ * Completeness warning types
    59→ */
    60→export type CompletenessWarningType =
    61→  | 'missing_acceptance_criteria'
    62→  | 'missing_description'
    63→  | 'status_inconsistency'
    64→  | 'missing_test_coverage';
    65→
    66→/**
    67→ * Trait cycle error
    68→ */
    69→export interface TraitCycleError {
    70→  traitRef: string;
    71→  traitTitle: string;
    72→  cycle: string[];
    73→  message: string;
    74→}
    75→
    76→/**
    77→ * Completeness warning
    78→ */
    79→export interface CompletenessWarning {
    80→  type: CompletenessWarningType;
    81→  itemRef: string;
    82→  itemTitle: string;
    83→  message: string;
    84→  details?: string;
    85→}
    86→
    87→/**
    88→ * Complete validation result
    89→ */
    90→export interface ValidationResult {
    91→  valid: boolean;
    92→  schemaErrors: SchemaValidationError[];
    93→  refErrors: RefValidationError[];
    94→  refWarnings: RefValidationWarning[];
    95→  orphans: OrphanItem[];
    96→  completenessWarnings: CompletenessWarning[];
    97→  traitCycleErrors: TraitCycleError[];
    98→  stats: {
    99→    filesChecked: number;
   100→    itemsChecked: number;
   101→    tasksChecked: number;
   102→  };
   103→  metaStats?: {
   104→    agents: number;
   105→    workflows: number;
   106→    conventions: number;
   107→    observations: number;
   108→  };
   109→}
   110→
   111→/**
   112→ * Validation options
   113→ */
   114→export interface ValidateOptions {
   115→  /** Check schema conformance */
   116→  schema?: boolean;
   117→  /** Check reference resolution */
   118→  refs?: boolean;
   119→  /** Find orphaned items */
   120→  orphans?: boolean;
   121→  /** Check spec completeness (missing AC, descriptions, status inconsistencies) */
   122→  completeness?: boolean;
   123→}
   124→
   125→// ============================================================
   126→// SCHEMA VALIDATION
   127→// ============================================================
   128→
   129→/**
   130→ * Validate a manifest file against schema
   131→ */
   132→async function validateManifestFile(filePath: string): Promise<SchemaValidationError[]> {
   133→  const errors: SchemaValidationError[] = [];
   134→
   135→  try {
   136→    const raw = await readYamlFile<unknown>(filePath);
   137→    const result = ManifestSchema.safeParse(raw);
   138→
   139→    if (!result.success) {
   140→      for (const issue of result.error.issues) {
   141→        errors.push({
   142→          file: filePath,
   143→          path: issue.path.join('.'),
   144→          message: issue.message,
   145→          details: issue,
   146→        });
   147→      }
   148→    }
   149→  } catch (err) {
   150→    errors.push({
   151→      file: filePath,
   152→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   153→    });
   154→  }
   155→
   156→  return errors;
   157→}
   158→
   159→/**
   160→ * Validate a tasks file against schema
   161→ */
   162→async function validateTasksFile(filePath: string): Promise<SchemaValidationError[]> {
   163→  const errors: SchemaValidationError[] = [];
   164→
   165→  try {
   166→    const raw = await readYamlFile<unknown>(filePath);
   167→
   168→    // Handle both formats: { tasks: [...] } and plain array
   169→    let taskList: unknown[];
   170→
   171→    if (Array.isArray(raw)) {
   172→      taskList = raw;
   173→    } else if (raw && typeof raw === 'object' && 'tasks' in raw) {
   174→      // Try full TasksFile schema first
   175→      const fileResult = TasksFileSchema.safeParse(raw);
   176→      if (!fileResult.success) {
   177→        // If TasksFile fails, just validate individual tasks
   178→        taskList = (raw as { tasks: unknown[] }).tasks || [];
   179→      } else {
   180→        // File schema passed, validate individual tasks for detailed errors
   181→        taskList = fileResult.data.tasks;
   182→      }
   183→    } else {
   184→      errors.push({
   185→        file: filePath,
   186→        message: 'Invalid tasks file format: expected array or { tasks: [...] }',
   187→      });
   188→      return errors;
   189→    }
   190→
   191→    // Validate each task
   192→    for (let i = 0; i < taskList.length; i++) {
   193→      const task = taskList[i];
   194→      const result = TaskSchema.safeParse(task);
   195→
   196→      if (!result.success) {
   197→        for (const issue of result.error.issues) {
   198→          errors.push({
   199→            file: filePath,
   200→            path: `tasks[${i}].${issue.path.join('.')}`,
   201→            message: issue.message,
   202→            details: issue,
   203→          });
   204→        }
   205→      }
   206→    }
   207→  } catch (err) {
   208→    errors.push({
   209→      file: filePath,
   210→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   211→    });
   212→  }
   213→
   214→  return errors;
   215→}
   216→
   217→/**
   218→ * Validate a spec module file against schema
   219→ */
   220→async function validateSpecFile(filePath: string): Promise<SchemaValidationError[]> {
   221→  const errors: SchemaValidationError[] = [];
   222→
   223→  try {
   224→    const raw = await readYamlFile<unknown>(filePath);
   225→
   226→    // Recursively validate spec items
   227→    validateSpecItemRecursive(raw, filePath, '', errors);
   228→  } catch (err) {
   229→    errors.push({
   230→      file: filePath,
   231→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   232→    });
   233→  }
   234→
   235→  return errors;
   236→}
   237→
   238→/**
   239→ * Validate meta manifest file with strict ULID validation
   240→ * AC-meta-manifest-3: Invalid schema exits with code 1 and shows field path + expected type
   241→ */
   242→async function validateMetaManifestFile(filePath: string): Promise<SchemaValidationError[]> {
   243→  const errors: SchemaValidationError[] = [];
   244→
   245→  try {
   246→    const raw = await readYamlFile<unknown>(filePath);
   247→
   248→    // Validate overall manifest structure
   249→    const manifestResult = MetaManifestSchema.safeParse(raw);
   250→    if (!manifestResult.success) {
   251→      for (const issue of manifestResult.error.issues) {
   252→        errors.push({
   253→          file: filePath,
   254→          path: issue.path.join('.'),
   255→          message: issue.message,
   256→          details: issue,
   257→        });
   258→      }
   259→      return errors;
   260→    }
   261→
   262→    // Validate each agent with strict ULID validation
   263→    if (raw && typeof raw === 'object' && 'agents' in raw && Array.isArray((raw as Record<string, unknown>).agents)) {
   264→      const agents = (raw as Record<string, unknown>).agents as unknown[];
   265→      for (let i = 0; i < agents.length; i++) {
   266→        const agent = agents[i];
   267→        const agentResult = AgentSchema.safeParse(agent);
   268→        if (!agentResult.success) {
   269→          for (const issue of agentResult.error.issues) {
   270→            errors.push({
   271→              file: filePath,
   272→              path: `agents[${i}].${issue.path.join('.')}`,
   273→              message: issue.message,
   274→              details: issue,
   275→            });
   276→          }
   277→        }
   278→
   279→        // Strict ULID validation
   280→        if (agent && typeof agent === 'object' && '_ulid' in agent) {
   281→          const ulidResult = UlidSchema.safeParse((agent as Record<string, unknown>)._ulid);
   282→          if (!ulidResult.success) {
   283→            errors.push({
   284→              file: filePath,
   285→              path: `agents[${i}]._ulid`,
   286→              message: 'Invalid ULID format (expected 26 characters)',
   287→            });
   288→          }
   289→        }
   290→      }
   291→    }
   292→
   293→    // Validate each workflow with strict ULID validation
   294→    if (raw && typeof raw === 'object' && 'workflows' in raw && Array.isArray((raw as Record<string, unknown>).workflows)) {
   295→      const workflows = (raw as Record<string, unknown>).workflows as unknown[];
   296→      for (let i = 0; i < workflows.length; i++) {
   297→        const workflow = workflows[i];
   298→        const workflowResult = WorkflowSchema.safeParse(workflow);
   299→        if (!workflowResult.success) {
   300→          for (const issue of workflowResult.error.issues) {
   301→            errors.push({
   302→              file: filePath,
   303→              path: `workflows[${i}].${issue.path.join('.')}`,
   304→              message: issue.message,
   305→              details: issue,
   306→            });
   307→          }
   308→        }
   309→
   310→        // Strict ULID validation
   311→        if (workflow && typeof workflow === 'object' && '_ulid' in workflow) {
   312→          const ulidResult = UlidSchema.safeParse((workflow as Record<string, unknown>)._ulid);
   313→          if (!ulidResult.success) {
   314→            errors.push({
   315→              file: filePath,
   316→              path: `workflows[${i}]._ulid`,
   317→              message: 'Invalid ULID format (expected 26 characters)',
   318→            });
   319→          }
   320→        }
   321→      }
   322→    }
   323→
   324→    // Validate each convention with strict ULID validation
   325→    if (raw && typeof raw === 'object' && 'conventions' in raw && Array.isArray((raw as Record<string, unknown>).conventions)) {
   326→      const conventions = (raw as Record<string, unknown>).conventions as unknown[];
   327→      for (let i = 0; i < conventions.length; i++) {
   328→        const convention = conventions[i];
   329→        const conventionResult = ConventionSchema.safeParse(convention);
   330→        if (!conventionResult.success) {
   331→          for (const issue of conventionResult.error.issues) {
   332→            errors.push({
   333→              file: filePath,
   334→              path: `conventions[${i}].${issue.path.join('.')}`,
   335→              message: issue.message,
   336→              details: issue,
   337→            });
   338→          }
   339→        }
   340→
   341→        // Strict ULID validation
   342→        if (convention && typeof convention === 'object' && '_ulid' in convention) {
   343→          const ulidResult = UlidSchema.safeParse((convention as Record<string, unknown>)._ulid);
   344→          if (!ulidResult.success) {
   345→            errors.push({
   346→              file: filePath,
   347→              path: `conventions[${i}]._ulid`,
   348→              message: 'Invalid ULID format (expected 26 characters)',
   349→            });
   350→          }
   351→        }
   352→      }
   353→    }
   354→
   355→    // Validate each observation with strict ULID validation
   356→    if (raw && typeof raw === 'object' && 'observations' in raw && Array.isArray((raw as Record<string, unknown>).observations)) {
   357→      const observations = (raw as Record<string, unknown>).observations as unknown[];
   358→      for (let i = 0; i < observations.length; i++) {
   359→        const observation = observations[i];
   360→        const observationResult = ObservationSchema.safeParse(observation);
   361→        if (!observationResult.success) {
   362→          for (const issue of observationResult.error.issues) {
   363→            errors.push({
   364→              file: filePath,
   365→              path: `observations[${i}].${issue.path.join('.')}`,
   366→              message: issue.message,
   367→              details: issue,
   368→            });
   369→          }
   370→        }
   371→
   372→        // Strict ULID validation
   373→        if (observation && typeof observation === 'object' && '_ulid' in observation) {
   374→          const ulidResult = UlidSchema.safeParse((observation as Record<string, unknown>)._ulid);
   375→          if (!ulidResult.success) {
   376→            errors.push({
   377→              file: filePath,
   378→              path: `observations[${i}]._ulid`,
   379→              message: 'Invalid ULID format (expected 26 characters)',
   380→            });
   381→          }
   382→        }
   383→      }
   384→    }
   385→  } catch (err) {
   386→    errors.push({
   387→      file: filePath,
   388→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   389→    });
   390→  }
   391→
   392→  return errors;
   393→}
   394→
   395→/**
   396→ * Recursively validate spec items in a structure
   397→ */
   398→function validateSpecItemRecursive(
   399→  raw: unknown,
   400→  file: string,
   401→  pathPrefix: string,
   402→  errors: SchemaValidationError[]
   403→): void {
   404→  if (!raw || typeof raw !== 'object') return;
   405→
   406→  // Check if this is a spec item (has _ulid)
   407→  if ('_ulid' in raw) {
   408→    const result = SpecItemSchema.safeParse(raw);
   409→    if (!result.success) {
   410→      for (const issue of result.error.issues) {
   411→        errors.push({
   412→          file,
   413→          path: pathPrefix ? `${pathPrefix}.${issue.path.join('.')}` : issue.path.join('.'),
   414→          message: issue.message,
   415→          details: issue,
   416→        });
   417→      }
   418→    }
   419→  }
   420→
   421→  // Recurse into nested structures
   422→  const nestedFields = ['modules', 'features', 'requirements', 'constraints', 'decisions', 'items'];
   423→  const obj = raw as Record<string, unknown>;
   424→
   425→  for (const field of nestedFields) {
   426→    if (field in obj && Array.isArray(obj[field])) {
   427→      const arr = obj[field] as unknown[];
   428→      for (let i = 0; i < arr.length; i++) {
   429→        const newPath = pathPrefix ? `${pathPrefix}.${field}[${i}]` : `${field}[${i}]`;
   430→        validateSpecItemRecursive(arr[i], file, newPath, errors);
   431→      }
   432→    }
   433→  }
   434→}
   435→
   436→// ============================================================
   437→// ORPHAN DETECTION
   438→// ============================================================
   439→
   440→/**
   441→ * Find items that are not referenced by any other item
   442→ */
   443→function findOrphans(
   444→  tasks: LoadedTask[],
   445→  items: LoadedSpecItem[],
   446→  index: ReferenceIndex
   447→): OrphanItem[] {
   448→  const orphans: OrphanItem[] = [];
   449→
   450→  // Build set of all referenced ULIDs
   451→  const referenced = new Set<string>();
   452→
   453→  const allItems = [...tasks, ...items];
   454→
   455→  // Fields that contain references
   456→  const refFields = [
   457→    'depends_on',
   458→    'blocked_by',
   459→    'implements',
   460→    'relates_to',
   461→    'tests',
   462→    'supersedes',
   463→    'spec_ref',
   464→    'context',
   465→  ];
   466→
   467→  for (const item of allItems) {
   468→    const obj = item as unknown as Record<string, unknown>;
   469→
   470→    for (const field of refFields) {
   471→      const value = obj[field];
   472→
   473→      if (typeof value === 'string' && value.startsWith('@')) {
   474→        const resolved = index.resolve(value);
   475→        if (resolved.ok) {
   476→          referenced.add(resolved.ulid);
   477→        }
   478→      } else if (Array.isArray(value)) {
   479→        for (const v of value) {
   480→          if (typeof v === 'string' && v.startsWith('@')) {
   481→            const resolved = index.resolve(v);
   482→            if (resolved.ok) {
   483→              referenced.add(resolved.ulid);
   484→            }
   485→          }
   486→        }
   487→      }
   488→    }
   489→  }
   490→
   491→  // Find items not in the referenced set
   492→  // Skip entry point types: modules are spec entry points, tasks are work items
   493→  const entryPointTypes = ['module', 'task', 'epic', 'bug', 'spike', 'infra'];
   494→
   495→  for (const item of items) {
   496→    // Only check spec items, not tasks
   497→    if (!referenced.has(item._ulid)) {
   498→      // Skip entry point types
   499→      if (entryPointTypes.includes(item.type || '')) continue;
   500→
   501→      // Skip nested items - they're implicitly referenced by their parent
   502→      // _path indicates nesting (e.g., "features[0].requirements[2]")
   503→      if (item._path) continue;
   504→
   505→      orphans.push({
   506→        ulid: item._ulid,
   507→        title: item.title,
   508→        type: item.type || 'unknown',
   509→        file: item._sourceFile,
   510→      });
   511→    }
   512→  }
   513→
   514→  return orphans;
   515→}
   516→
   517→// ============================================================
   518→// TRAIT CYCLE DETECTION
   519→// ============================================================
   520→
   521→/**
   522→ * Detect circular trait references
   523→ * AC: @trait-edge-cases ac-2
   524→ */
   525→function detectTraitCycles(
   526→  items: LoadedSpecItem[],
   527→  index: ReferenceIndex
   528→): TraitCycleError[] {
   529→  const errors: TraitCycleError[] = [];
   530→  const traits = items.filter(item => item.type === 'trait');
   531→
   532→  // Build adjacency list: trait ULID → trait ULIDs it references
   533→  const graph = new Map<string, string[]>();
   534→  const traitInfo = new Map<string, { ref: string; title: string }>();
   535→
   536→  for (const trait of traits) {
   537→    const ref = trait.slugs?.[0] ? `@${trait.slugs[0]}` : `@${trait._ulid.slice(0, 8)}`;
   538→    traitInfo.set(trait._ulid, { ref, title: trait.title });
   539→
   540→    const dependencies: string[] = [];
   541→    if (trait.traits && trait.traits.length > 0) {
   542→      for (const traitRef of trait.traits) {
   543→        const result = index.resolve(traitRef);
   544→        if (result.ok) {
   545→          dependencies.push(result.ulid);
   546→        }
   547→      }
   548→    }
   549→    graph.set(trait._ulid, dependencies);
   550→  }
   551→
   552→  // DFS-based cycle detection
   553→  const visiting = new Set<string>();
   554→  const visited = new Set<string>();
   555→
   556→  function dfs(ulid: string, path: string[]): string[] | null {
   557→    if (visiting.has(ulid)) {
   558→      // Found a cycle - return the cycle path
   559→      const cycleStart = path.indexOf(ulid);
   560→      return path.slice(cycleStart);
   561→    }
   562→
   563→    if (visited.has(ulid)) {
   564→      return null; // Already checked this path
   565→    }
   566→
   567→    visiting.add(ulid);
   568→    path.push(ulid);
   569→
   570→    const dependencies = graph.get(ulid) || [];
   571→    for (const depUlid of dependencies) {
   572→      const cycle = dfs(depUlid, path);
   573→      if (cycle) {
   574→        return cycle;
   575→      }
   576→    }
   577→
   578→    visiting.delete(ulid);
   579→    visited.add(ulid);
   580→    path.pop();
   581→
   582→    return null;
   583→  }
   584→
   585→  // Check each trait for cycles
   586→  for (const trait of traits) {
   587→    if (!visited.has(trait._ulid)) {
   588→      const cycle = dfs(trait._ulid, []);
   589→      if (cycle) {
   590→        const info = traitInfo.get(cycle[0]);
   591→        if (info) {
   592→          const cycleRefs = cycle.map(ulid => {
   593→            const cycleInfo = traitInfo.get(ulid);
   594→            return cycleInfo ? cycleInfo.ref : `@${ulid.slice(0, 8)}`;
   595→          });
   596→
   597→          errors.push({
   598→            traitRef: info.ref,
   599→            traitTitle: info.title,
   600→            cycle: cycleRefs,
   601→            message: `Circular trait reference: ${cycleRefs.join(' → ')} → ${cycleRefs[0]}`,
   602→          });
   603→        }
   604→
   605→        // Mark all traits in cycle as visited to avoid duplicate errors
   606→        for (const ulid of cycle) {
   607→          visited.add(ulid);
   608→        }
   609→      }
   610→    }
   611→  }
   612→
   613→  return errors;
   614→}
   615→
   616→// ============================================================
   617→// COMPLETENESS VALIDATION
   618→// ============================================================
   619→
   620→/**
   621→ * Scan test files for AC annotations to build coverage index
   622→ * Returns a Set of covered ACs in format "@spec-ref ac-N"
   623→ */
   624→async function scanTestCoverage(rootDir: string): Promise<Set<string>> {
   625→  const coveredACs = new Set<string>();
   626→  const testsDir = path.join(rootDir, 'tests');
   627→
   628→  try {
   629→    // Check if tests directory exists
   630→    await fs.access(testsDir);
   631→
   632→    // Read all test files
   633→    const files = await fs.readdir(testsDir);
   634→    const testFiles = files.filter(f => f.endsWith('.test.ts') || f.endsWith('.test.js'));
   635→
   636→    for (const file of testFiles) {
   637→      const filePath = path.join(testsDir, file);
   638→      const content = await fs.readFile(filePath, 'utf-8');
   639→
   640→      // Match AC annotations: // AC: @spec-ref ac-N
   641→      // Also handle multiple ACs on one line: // AC: @spec-ref ac-1, ac-2
   642→      const acPattern = /\/\/\s*AC:\s*(@[\w-]+)(?:\s+(ac-\d+(?:\s*,\s*ac-\d+)*))?/g;
   643→      let match;
   644→
   645→      while ((match = acPattern.exec(content)) !== null) {
   646→        const specRef = match[1]; // @spec-ref
   647→        const acList = match[2]; // "ac-1, ac-2" or just "ac-1" or undefined
   648→
   649→        if (acList) {
   650→          // Split by comma and trim
   651→          const acs = acList.split(',').map(ac => ac.trim());
   652→          for (const ac of acs) {
   653→            coveredACs.add(`${specRef} ${ac}`);
   654→          }
   655→        } else {
   656→          // No specific AC mentioned, just the spec ref
   657→          // We'll consider this as generic coverage
   658→          coveredACs.add(specRef);
   659→        }
   660→      }
   661→    }
   662→  } catch (err) {
   663→    // Tests directory doesn't exist or can't be read - that's ok
   664→  }
   665→
   666→  return coveredACs;
   667→}
   668→
   669→/**
   670→ * Check spec items for completeness
   671→ * AC: @spec-completeness ac-1, ac-2, ac-3
   672→ * AC: @trait-validation ac-1, ac-2, ac-3
   673→ */
   674→async function checkCompleteness(
   675→  items: LoadedSpecItem[],
   676→  index: ReferenceIndex,
   677→  rootDir: string,
   678→  traitIndex?: TraitIndex
   679→): Promise<CompletenessWarning[]> {
   680→  const warnings: CompletenessWarning[] = [];
   681→
   682→  // Scan test files for AC coverage
   683→  const coveredACs = await scanTestCoverage(rootDir);
   684→
   685→  for (const item of items) {
   686→    const itemRef = item.slugs?.[0] ? `@${item.slugs[0]}` : `@${item._ulid.slice(0, 8)}`;
   687→    const isTrait = item.type === 'trait';
   688→
   689→    // AC: @spec-completeness ac-1
   690→    // AC: @trait-type ac-2 - Traits should have acceptance criteria for completeness
   691→    // Check for missing acceptance criteria
   692→    if (!item.acceptance_criteria || item.acceptance_criteria.length === 0) {
   693→      warnings.push({
   694→        type: 'missing_acceptance_criteria',
   695→        itemRef,
   696→        itemTitle: item.title,
   697→        message: `${isTrait ? 'Trait' : 'Item'} ${itemRef} has no acceptance criteria`,
   698→      });
   699→    }
   700→
   701→    // AC: @spec-completeness ac-2
   702→    // AC: @trait-type ac-3 - Traits should have description for completeness
   703→    // Check for missing description
   704→    if (!item.description || item.description.trim() === '') {
   705→      warnings.push({
   706→        type: 'missing_description',
   707→        itemRef,
   708→        itemTitle: item.title,
   709→        message: `${isTrait ? 'Trait' : 'Item'} ${itemRef} has no description`,
   710→      });
   711→    }
   712→
   713→    // AC: @spec-completeness ac-3
   714→    // Check for status inconsistency between parent and children
   715→    if (item.status?.implementation === 'implemented') {
   716→      // Check if this item has children with not_started status
   717→      const childFields = [
   718→        'modules',
   719→        'features',
   720→        'requirements',
   721→        'constraints',
   722→        'epics',
   723→        'themes',
   724→        'capabilities',
   725→      ];
   726→
   727→      for (const field of childFields) {
   728→        const children = (item as any)[field];
   729→        if (Array.isArray(children)) {
   730→          for (const child of children) {
   731→            if (child.status?.implementation === 'not_started') {
   732→              const childRef = child.slugs?.[0]
   733→                ? `@${child.slugs[0]}`
   734→                : `@${child._ulid?.slice(0, 8) || 'unknown'}`;
   735→              warnings.push({
   736→                type: 'status_inconsistency',
   737→                itemRef,
   738→                itemTitle: item.title,
   739→                message: `Parent ${itemRef} is implemented but child ${childRef} is not_started`,
   740→                details: `Child: ${child.title}`,
   741→              });
   742→            }
   743→          }
   744→        }
   745→      }
   746→    }
   747→
   748→    // Check for test coverage of acceptance criteria
   749→    if (item.acceptance_criteria && item.acceptance_criteria.length > 0) {
   750→      const uncoveredACs: string[] = [];
   751→
   752→      for (const ac of item.acceptance_criteria) {
   753→        // Build all possible references for this AC
   754→        const possibleRefs: string[] = [];
   755→
   756→        // Try with primary slug
   757→        if (item.slugs && item.slugs.length > 0) {
   758→          possibleRefs.push(`@${item.slugs[0]} ${ac.id}`);
   759→          // Also check for just the slug without specific AC
   760→          possibleRefs.push(`@${item.slugs[0]}`);
   761→        }
   762→
   763→        // Try with ULID (short form)
   764→        possibleRefs.push(`@${item._ulid.slice(0, 8)} ${ac.id}`);
   765→        possibleRefs.push(`@${item._ulid.slice(0, 8)}`);
   766→
   767→        // Check if any of these references are covered
   768→        const isCovered = possibleRefs.some(ref => coveredACs.has(ref));
   769→
   770→        if (!isCovered) {
   771→          uncoveredACs.push(ac.id);
   772→        }
   773→      }
   774→
   775→      // Only warn if there are uncovered ACs
   776→      if (uncoveredACs.length > 0) {
   777→        warnings.push({
   778→          type: 'missing_test_coverage',
   779→          itemRef,
   780→          itemTitle: item.title,
   781→          message: `Item ${itemRef} has ${uncoveredACs.length} AC(s) without test coverage`,
   782→          details: `Uncovered: ${uncoveredACs.join(', ')}`,
   783→        });
   784→      }
   785→    }
   786→
   787→    // AC: @trait-validation ac-1, ac-2
   788→    // Check for test coverage of trait acceptance criteria
   789→    if (traitIndex && item.traits && item.traits.length > 0) {
   790→      const inheritedACs = traitIndex.getInheritedAC(item._ulid);
   791→      const uncoveredTraitACs: Array<{ traitSlug: string; acId: string }> = [];
   792→
   793→      for (const { trait, ac } of inheritedACs) {
   794→        // Build all possible references for this trait AC
   795→        const possibleRefs: string[] = [];
   796→
   797→        // Try with trait slug
   798→        possibleRefs.push(`@${trait.slug} ${ac.id}`);
   799→        possibleRefs.push(`@${trait.slug}`);
   800→
   801→        // Try with trait ULID (short form)
   802→        possibleRefs.push(`@${trait.ulid.slice(0, 8)} ${ac.id}`);
   803→        possibleRefs.push(`@${trait.ulid.slice(0, 8)}`);
   804→
   805→        // Check if any of these references are covered
   806→        const isCovered = possibleRefs.some(ref => coveredACs.has(ref));
   807→
   808→        if (!isCovered) {
   809→          uncoveredTraitACs.push({ traitSlug: trait.slug, acId: ac.id });
   810→        }
   811→      }
   812→
   813→      // Only warn if there are uncovered trait ACs
   814→      if (uncoveredTraitACs.length > 0) {
   815→        const details = uncoveredTraitACs
   816→          .map(({ traitSlug, acId }) => `@${traitSlug} ${acId}`)
   817→          .join(', ');
   818→        warnings.push({
   819→          type: 'missing_test_coverage',
   820→          itemRef,
   821→          itemTitle: item.title,
   822→          message: `Item ${itemRef} has ${uncoveredTraitACs.length} inherited trait AC(s) without test coverage`,
   823→          details: `Uncovered trait ACs: ${details}`,
   824→        });
   825→      }
   826→    }
   827→  }
   828→
   829→  return warnings;
   830→}
   831→
   832→// ============================================================
   833→// MAIN VALIDATION
   834→// ============================================================
   835→
   836→/**
   837→ * Run full validation on a kspec project
   838→ */
   839→export async function validate(
   840→  ctx: KspecContext,
   841→  options: ValidateOptions = {}
   842→): Promise<ValidationResult> {
   843→  // Default: run all checks
   844→  const runSchema = options.schema !== false;
   845→  const runRefs = options.refs !== false;
   846→  const runOrphans = options.orphans !== false;
   847→  const runCompleteness = options.completeness !== false;
   848→
   849→  const result: ValidationResult = {
   850→    valid: true,
   851→    schemaErrors: [],
   852→    refErrors: [],
   853→    refWarnings: [],
   854→    orphans: [],
   855→    completenessWarnings: [],
   856→    traitCycleErrors: [],
   857→    stats: {
   858→      filesChecked: 0,
   859→      itemsChecked: 0,
   860→      tasksChecked: 0,
   861→    },
   862→  };
   863→
   864→  const allTasks: LoadedTask[] = [];
   865→  const allItems: LoadedSpecItem[] = [];
   866→
   867→  // Validate manifest
   868→  if (ctx.manifestPath && runSchema) {
   869→    const manifestErrors = await validateManifestFile(ctx.manifestPath);
   870→    result.schemaErrors.push(...manifestErrors);
   871→    result.stats.filesChecked++;
   872→  }
   873→
   874→  // Load items from manifest (traits, inline modules, etc.)
   875→  if (ctx.manifest && ctx.manifestPath) {
   876→    const manifestItems = extractItemsFromRaw(ctx.manifest, ctx.manifestPath);
   877→    allItems.push(...manifestItems);
   878→    result.stats.itemsChecked += manifestItems.length;
   879→  }
   880→
   881→  // Find and validate task files
   882→  const taskFiles = await findTaskFiles(ctx.rootDir);
   883→  const specTaskFiles = await findTaskFiles(path.join(ctx.rootDir, 'spec'));
   884→  const allTaskFiles = [...new Set([...taskFiles, ...specTaskFiles])];
   885→
   886→  for (const taskFile of allTaskFiles) {
   887→    if (runSchema) {
   888→      const taskErrors = await validateTasksFile(taskFile);
   889→      result.schemaErrors.push(...taskErrors);
   890→    }
   891→    result.stats.filesChecked++;
   892→
   893→    // Load tasks for ref validation
   894→    try {
   895→      const raw = await readYamlFile<unknown>(taskFile);
   896→      let taskList: unknown[] = [];
   897→
   898→      if (Array.isArray(raw)) {
   899→        taskList = raw;
   900→      } else if (raw && typeof raw === 'object' && 'tasks' in raw) {
   901→        taskList = (raw as { tasks: unknown[] }).tasks || [];
   902→      }
   903→
   904→      for (const t of taskList) {
   905→        const parsed = TaskSchema.safeParse(t);
   906→        if (parsed.success) {
   907→          allTasks.push({ ...parsed.data, _sourceFile: taskFile });
   908→          result.stats.tasksChecked++;
   909→        }
   910→      }
   911→    } catch {
   912→      // Already reported in schema validation
   913→    }
   914→  }
   915→
   916→  // Validate spec files (from includes)
   917→  if (ctx.manifest && ctx.manifestPath) {
   918→    const manifestDir = path.dirname(ctx.manifestPath);
   919→    const includes = ctx.manifest.includes || [];
   920→
   921→    for (const include of includes) {
   922→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   923→
   924→      for (const filePath of expandedPaths) {
   925→        if (runSchema) {
   926→          const specErrors = await validateSpecFile(filePath);
   927→          result.schemaErrors.push(...specErrors);
   928→        }
   929→        result.stats.filesChecked++;
   930→
   931→        // Load items for ref validation
   932→        try {
   933→          const items = await loadSpecFile(filePath);
   934→          allItems.push(...items);
   935→          result.stats.itemsChecked += items.length;
   936→        } catch {
   937→          // Already reported in schema validation
   938→        }
   939→      }
   940→    }
   941→  }
   942→
   943→  // Load meta items for reference validation
   944→  // AC: @agent-definitions ac-agent-3
   945→  const metaCtx = await loadMetaContext(ctx);
   946→  const allMetaItems = [
   947→    ...metaCtx.agents,
   948→    ...metaCtx.workflows,
   949→    ...metaCtx.conventions,
   950→    ...metaCtx.observations,
   951→  ];
   952→
   953→  // Reference validation
   954→  if (runRefs && (allTasks.length > 0 || allItems.length > 0 || allMetaItems.length > 0)) {
   955→    const index = new ReferenceIndex(allTasks, allItems, allMetaItems);
   956→    const refResult = validateRefs(index, allTasks, allItems);
   957→    result.refErrors = refResult.errors;
   958→    result.refWarnings = refResult.warnings;
   959→
   960→    // AC: @trait-edge-cases ac-2
   961→    // Detect circular trait references
   962→    result.traitCycleErrors = detectTraitCycles(allItems, index);
   963→
   964→    // Orphan detection
   965→    if (runOrphans) {
   966→      result.orphans = findOrphans(allTasks, allItems, index);
   967→    }
   968→
   969→    // Completeness validation
   970→    // AC: @spec-completeness ac-1, ac-2, ac-3
   971→    // AC: @trait-validation ac-3
   972→    if (runCompleteness) {
   973→      // Build trait index for trait AC coverage validation
   974→      const traitIndex = new TraitIndex(allItems, index);
   975→      result.completenessWarnings = await checkCompleteness(allItems, index, ctx.rootDir, traitIndex);
   976→    }
   977→  }
   978→
   979→  // Meta manifest validation (AC-meta-manifest-2, AC-meta-manifest-3)
   980→  const metaManifestPath = await findMetaManifest(ctx.specDir);
   981→  if (metaManifestPath) {
   982→    // Use metaCtx already loaded above
   983→    result.metaStats = {
   984→      agents: metaCtx.agents.length,
   985→      workflows: metaCtx.workflows.length,
   986→      conventions: metaCtx.conventions.length,
   987→      observations: metaCtx.observations.length,
   988→    };
   989→
   990→    // Validate meta manifest schema with strict ULID validation
   991→    if (runSchema) {
   992→      const metaErrors = await validateMetaManifestFile(metaManifestPath);
   993→      // Prefix all meta errors with "meta:"
   994→      for (const err of metaErrors) {
   995→        err.path = err.path ? `meta:${err.path}` : 'meta:';
   996→      }
   997→      result.schemaErrors.push(...metaErrors);
   998→      result.stats.filesChecked++;
   999→    }
  1000→  }
  1001→
  1002→  // Set valid flag
  1003→  result.valid = result.schemaErrors.length === 0 && result.refErrors.length === 0 && result.traitCycleErrors.length === 0;
  1004→
  1005→  return result;
  1006→}
  1007→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
```