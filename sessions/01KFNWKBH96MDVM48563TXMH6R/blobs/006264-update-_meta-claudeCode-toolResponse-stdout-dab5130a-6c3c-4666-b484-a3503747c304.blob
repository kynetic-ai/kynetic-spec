:541:  // AC: @workflow-enforcement-modes ac-2, ac-3 - Check exit criteria for CURRENT step\nsrc/cli/commands/workflow.ts:547:    // AC: @workflow-enforcement-modes ac-3 - Strict mode requires --confirm\nsrc/cli/commands/workflow.ts:563:    // AC: @workflow-enforcement-modes ac-4 - Advisory mode shows criteria as guidance\nsrc/cli/commands/workflow.ts:572:  // AC: @workflow-enforcement-modes ac-1, ac-3 - Check entry criteria for NEXT step\nsrc/cli/commands/workflow.ts:578:      // AC: @workflow-enforcement-modes ac-3 - Strict mode requires --confirm\nsrc/cli/commands/workflow.ts:594:      // AC: @workflow-enforcement-modes ac-4 - Advisory mode shows criteria as guidance\nsrc/cli/commands/workflow.ts:608:  // AC: @workflow-step-navigation ac-1, ac-6 - Complete current step\nsrc/cli/commands/workflow.ts:614:  // AC: @workflow-enforcement-modes ac-3 - Record confirmations in StepResult\nsrc/cli/commands/workflow.ts:656:  // AC: @workflow-step-navigation ac-1 - Advance to next step or complete run\nsrc/cli/commands/workflow.ts:658:    // AC: @workflow-step-navigation ac-2 - Complete the run\nsrc/cli/commands/workflow.ts:699:    // AC: @workflow-enforcement-modes ac-3 - Record entry confirmation for the next step\nsrc/cli/commands/validate.ts:56:  // AC: @stale-status-detection ac-1 (parent-pending-children-done)\nsrc/cli/commands/validate.ts:98:  // AC: @stale-status-detection ac-2 (spec-implemented-no-task)\nsrc/cli/commands/validate.ts:103:    // AC: @trait-retrospective ac-1\nsrc/cli/commands/validate.ts:125:  // AC: @stale-status-detection ac-3 (task-done-spec-not-started)\nsrc/cli/commands/validate.ts:149:  // AC: @validation ac-1\nsrc/cli/commands/validate.ts:281:  // AC: @convention-definitions ac-4\nsrc/cli/commands/validate.ts:289:  // AC: @convention-definitions ac-3\nsrc/cli/commands/validate.ts:390:  // AC: @spec-completeness ac-4\nsrc/cli/commands/validate.ts:448:  // AC: @task-automation-eligibility ac-21, ac-23\nsrc/cli/commands/validate.ts:671:  // AC: @