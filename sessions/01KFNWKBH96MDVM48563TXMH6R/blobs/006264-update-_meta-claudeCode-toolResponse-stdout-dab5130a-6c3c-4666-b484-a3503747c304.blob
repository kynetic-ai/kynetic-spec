\" --meta-ref \"@task-start\"', tempDir);\ntests/meta.test.ts:747:    kspec('task add --title \"Task 2\" --meta-ref \"@test-agent\"', tempDir);\ntests/meta.test.ts:748:    kspec('task add --title \"Task 3\" --meta-ref \"@task-start\"', tempDir);\ntests/meta.test.ts:749:    kspec('task add --title \"Task 4\"', tempDir); // No meta_ref\n/home/chapel/Projects/kynetic-spec/tests/meta.test.ts-750-\ntests/meta.test.ts-751-    / AC-meta-ref-2: tasks list --meta-ref @workflow filters by meta_ref\ntests/meta.test.ts:752:    const tasks = kspecJson<any[]>('tasks list --meta-ref \"@task-start\"', tempDir);\n/home/chapel/Projects/kynetic-spec/tests/meta.test.ts-753-\n/home/chapel/Projects/kynetic-spec/tests/meta.test.ts-754-    // Should only include tasks with meta_ref = @task-start\n/home/chapel/Projects/kynetic-spec/tests/meta.test.ts-755-    const taskTitles = tasks.map(t => t.title);\n--\ntests/meta.test.ts-762-  / AC: @meta-ref ac-meta-ref-3\n/home/chapel/Projects/kynetic-spec/tests/meta.test.ts-763-  it('should error when meta_ref does not resolve', () => {\n/home/chapel/Projects/kynetic-spec/tests/meta.test.ts-764-    try {\ntests/meta.test.ts:765:      const output = kspec('task add --title \"Test task\" --meta-ref \"@invalid-ref-123456\"', tempDir);\ntests/meta.test.ts-766-      / AC-meta-ref-3: Should error with specific message\n/home/chapel/Projects/kynetic-spec/tests/meta.test.ts-767-      expect(output).toContain(\"meta_ref '@invalid-ref-123456' not found\");\ntests/meta.test.ts-768-    } catch (e: any) {\n--\n/home/chapel/Projects/kynetic-spec/tests/meta.test.ts-775-  it('should error when meta_ref points to spec item', () => {\n/home/chapel/Projects/kynetic-spec/tests/meta.test.ts-776-    try {\n/home/chapel/Projects/kynetic-spec/tests/meta.test.ts-777-      // test-feature is a spec item, not a meta item\ntests/meta.test.ts:778:      const output = kspec('task add --title \"Test task\" --meta-ref \"@test-feature\"', tempDir);\ntests/meta.test.ts-779-      / AC