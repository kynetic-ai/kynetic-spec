c items\ntests/daemon-api-items.test.ts:    // AC: @api-contract ac-9 - Type filter (multi-value)\ntests/daemon-api-meta.test.ts:  // AC: @api-contract ac-15\ntests/daemon-api-meta.test.ts:    // AC: @api-contract ac-15 - Load and return session context\ntests/daemon-api-meta.test.ts:    // AC: @api-contract ac-15 - Return focus, threads, questions\ntests/daemon-api-meta.test.ts:  // AC: @api-contract ac-16\ntests/daemon-api-meta.test.ts:    // AC: @api-contract ac-16 - Load meta context and use agents array\ntests/daemon-api-meta.test.ts:  // AC: @api-contract ac-17\ntests/daemon-api-meta.test.ts:    // AC: @api-contract ac-17 - Load meta context and use workflows array\ntests/daemon-api-meta.test.ts:  // AC: @api-contract ac-18\ntests/daemon-api-meta.test.ts:    // AC: @api-contract ac-18 - Filter by resolved status\ntests/daemon-api-meta.test.ts:    // AC: @api-contract ac-18 - Load observations\ntests/daemon-api-tasks.test.ts:    // AC: @api-contract ac-24, @trait-error-guidance ac-4 - Invalid transition error\ntests/daemon-api-tasks.test.ts:  // AC: @api-contract ac-2, ac-3, ac-4\ntests/daemon-api-tasks.test.ts:    // AC: @api-contract ac-2 - Return fields\ntests/daemon-api-tasks.test.ts:    // AC: @api-contract ac-3 - Status filter (multi-value)\ntests/daemon-api-tasks.test.ts:    // AC: @api-contract ac-4 - Pagination\ntests/daemon-api-tasks.test.ts:    // AC: @api-contract ac-4, @trait-api-endpoint ac-4 - Pagination wrapper\ntests/daemon-api-tasks.test.ts:  // AC: @api-contract ac-5\ntests/daemon-api-tasks.test.ts:    // AC: @api-contract ac-5 - Resolve via ReferenceIndex\ntests/daemon-api-tasks.test.ts:    // AC: @api-contract ac-5 - Return full task with notes, todos, dependencies\ntests/daemon-api-tasks.test.ts:  // AC: @api-contract ac-6\ntests/daemon-api-tasks.test.ts:    // AC: @api-contract ac-6, @trait-api-endpoint ac-5 - Save and commit\ntests/daemon-api-tasks.test.ts:    // AC: @api-contract ac-6 - Transition to in_progress\ntests/daemon-api-tasks.test.ts:    // AC: @api-contract ac-6 - WebSocket broadcast\ntests/daemon-api-tasks.test.ts:  // AC: @api-contract ac-7\ntests/daemon-api-tasks.test.ts:    // AC: @api-contract ac-7 - Append note\ntests/daemon-api-tasks.test.ts:    // AC: @api-contract ac-7, @trait-api-endpoint ac-5 - Save and commit\ntests/daemon-api-tasks.test.ts:    // AC: @api-contract ac-7 - WebSocket broadcast\ntests/daemon-api-validation.test.ts:  // AC: @api-contract ac-19\ntests/daemon-api-validation.test.ts:    // AC: @api-contract ac-19 - Filter options\ntests/daemon-api-validation.test.ts:    // AC: @api-contract ac-19 - Load all data sources\ntests/daemon-api-validation.test.ts:    // AC: @api-contract ac-19 - Return results with matched fields\ntests/daemon-api-validation.test.ts:    // AC: @api-contract ac-19 - Search across all entity types\ntests/daemon-api-validation.test.ts:  // AC: @api-contract ac-19 - Search filters\ntests/daemon-api-validation.test.ts:  // AC: @api-contract ac-20\ntests/daemon-api-validation.test.ts:    // AC: @api-contract ac-20 - Call validate function\ntests/daemon-api-validation.test.ts:    // AC: @api-contract ac-20 - Return ValidationResult fields\ntests/daemon-api-validation.test.ts:  // AC: @api-contract ac-21\ntests/daemon-api-validation.test.ts:    // AC: @api-contract ac-21 - Build indexes and create AlignmentIndex\ntests/daemon-api-validation.test.ts:    // AC: @api-contract ac-21 - Get stats and warnings\ntests/daemon-api-validation.test.ts:    // AC: @api-contract ac-21 - Return stats and warnings\ntests/daemon-websocket.test.ts:    // AC: @api-contract ac-25, @trait-websocket-protocol ac-1\ntests/daemon-websocket.test.ts:    // AC: @api-contract ac-26\ntests/daemon-websocket.test.ts:    // AC: @api-contract ac-26, ac-27\ntests/daemon-websocket.test.ts:    // AC: @api-contract ac-27\ntests/daemon-websocket.test.ts:    // AC: @api-contract ac-28\ntests/daemon-websocket.test.ts:    // AC: @api-contract ac-28, @trait-websocket-protocol ac-2\ntests/d