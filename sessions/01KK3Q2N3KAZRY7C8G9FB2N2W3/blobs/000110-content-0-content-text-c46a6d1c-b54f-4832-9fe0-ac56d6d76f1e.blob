   569→
   570→		<!-- AC: @ui-dashboard-overview ac-1 — Needs attention aggregation -->
   571→		<section data-testid="needs-attention-section">
   572→			<div class="mb-3 flex items-center gap-2">
   573→				<h2 class="text-sm font-medium text-muted-foreground">Needs Attention</h2>
   574→				{#if totalAttention > 0}
   575→					<Badge variant="secondary" class="text-[10px]">{totalAttention}</Badge>
   576→				{/if}
   577→			</div>
   578→
   579→			{#if totalAttention === 0}
   580→				<div
   581→					class="flex items-center gap-2 rounded-lg border border-dashed p-4 text-sm text-muted-foreground"
   582→					data-testid="no-attention-needed"
   583→				>
   584→					<span>Nothing needs attention right now</span>
   585→				</div>
   586→			{:else}
   587→				<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4" data-testid="attention-cards">
   588→					{#each attentionItems as item}
   589→						{#if item.count > 0}
   590→							<a href={item.href} class="block" data-testid="attention-{item.key}">
   591→								<Card class="transition-colors hover:bg-muted/50 cursor-pointer h-full">
   592→									<CardContent class="flex items-center gap-3 p-4">
   593→										<div class="rounded-md bg-muted p-2">
   594→											<item.icon class="size-4 {item.colorClass}" />
   595→										</div>
   596→										<div>
   597→											<p class="text-2xl font-bold tabular-nums">{item.count}</p>
   598→											<p class="text-xs text-muted-foreground">{item.label}</p>
   599→										</div>
   600→									</CardContent>
   601→								</Card>
   602→							</a>
   603→						{/if}
   604→					{/each}
   605→				</div>
   606→			{/if}
   607→		</section>
   608→	{/if}
   609→</div>
