```
     1→<!--
     2→  AC: @ui-dashboard-overview ac-1 — Dashboard home view
     3→  Active work section, status summary, needs-attention aggregation.
     4→-->
     5→<script lang="ts">
     6→	import { onMount, onDestroy } from 'svelte';
     7→	import { goto } from '$app/navigation';
     8→	import { base } from '$app/paths';
     9→	import type { BroadcastEvent } from '@kynetic-ai/shared';
    10→	import {
    11→		fetchTasks,
    12→		fetchInbox,
    13→		fetchObservations,
    14→		fetchValidation,
    15→		fetchAgentStatus,
    16→		type AgentDispatchStatus,
    17→		type ActiveInvocation
    18→	} from '$lib/api';
    19→	import {
    20→		createSessionState,
    21→		processTextChunk,
    22→		processToolCallStart,
    23→		processToolCallEnd,
    24→		type FleetSessionState,
    25→		type ToolCallIndicator,
    26→	} from '$lib/components/board/fleet-buffer';
    27→	import { Card, CardContent, CardHeader, CardTitle } from '$lib/components/ui/card';
    28→	import { Badge } from '$lib/components/ui/badge';
    29→	import { Skeleton } from '$lib/components/ui/skeleton';
    30→	import ReferenceLink from '$lib/components/ReferenceLink.svelte';
    31→	import { getProjectVersion } from '$lib/stores/project.svelte';
    32→	import { subscribe, unsubscribe, on, off } from '$lib/stores/connection.svelte';
    33→	import { isStaticMode } from '$lib/stores/mode.svelte';
    34→	import AlertTriangle from '@lucide/svelte/icons/triangle-alert';
    35→	import InboxIcon from '@lucide/svelte/icons/inbox';
    36→	import Eye from '@lucide/svelte/icons/eye';
    37→	import ShieldAlert from '@lucide/svelte/icons/shield-alert';
    38→	import Ban from '@lucide/svelte/icons/ban';
    39→	import Activity from '@lucide/svelte/icons/activity';
    40→	import Bot from '@lucide/svelte/icons/bot';
    41→	import ExternalLink from '@lucide/svelte/icons/external-link';
    42→	import Wrench from '@lucide/svelte/icons/wrench';
    43→	import TerminalIcon from '@lucide/svelte/icons/terminal';
    44→
    45→	// --- State ---
    46→	let loading = $state(true);
    47→	let error = $state<string | null>(null);
    48→
    49→	// Task counts
    50→	interface TaskCounts {
    51→		ready: number;
    52→		in_progress: number;
    53→		needs_work: number;
    54→		pending_review: number;
    55→		blocked: number;
    56→		completed: number;
    57→		cancelled: number;
    58→	}
    59→
    60→	let counts = $state<TaskCounts>({
    61→		ready: 0,
    62→		in_progress: 0,
    63→		needs_work: 0,
    64→		pending_review: 0,
    65→		blocked: 0,
    66→		completed: 0,
    67→		cancelled: 0
    68→	});
    69→
    70→	// Active work
    71→	let agentStatus = $state<AgentDispatchStatus | null>(null);
    72→	let taskTitles = $state<Record<string, string>>({});
    73→
    74→	// Buffered output state per agent session (same pattern as board)
    75→	let sessionStates = $state<Record<string, FleetSessionState>>({});
    76→
    77→	let hasActiveWork = $derived(
    78→		agentStatus?.dispatch_enabled && (agentStatus?.active_invocations?.length ?? 0) > 0
    79→	);
    80→
    81→	// Needs attention
    82→	let inboxUntriaged = $state(0);
    83→	let observationsUnresolved = $state(0);
    84→	let validationWarnings = $state(0);
    85→	let blockedTasks = $state(0);
    86→
    87→	let totalAttention = $derived(
    88→		inboxUntriaged + observationsUnresolved + validationWarnings + blockedTasks
    89→	);
    90→
    91→	// --- Status config with design system tokens ---
    92→	// AC: @ui-dashboard-overview ac-1 — clickable count cards per status
    93→	const statusConfig = [
    94→		{
    95→			key: 'ready' as const,
    96→			label: 'Ready',
    97→			dotClass: 'bg-status-pending',
    98→			filterStatus: 'pending'
    99→		},
   100→		{
   101→			key: 'in_progress' as const,
   102→			label: 'In Progress',
   103→			dotClass: 'bg-status-in-progress',
   104→			filterStatus: 'in_progress'
   105→		},
   106→		{
   107→			key: 'needs_work' as const,
   108→			label: 'Needs Work',
   109→			dotClass: 'bg-status-needs-work',
   110→			filterStatus: 'needs_work'
   111→		},
   112→		{
   113→			key: 'pending_review' as const,
   114→			label: 'Review',
   115→			dotClass: 'bg-status-pending-review',
   116→			filterStatus: 'pending_review'
   117→		},
   118→		{
   119→			key: 'blocked' as const,
   120→			label: 'Blocked',
   121→			dotClass: 'bg-status-blocked',
   122→			filterStatus: 'blocked'
   123→		},
   124→		{
   125→			key: 'completed' as const,
   126→			label: 'Completed',
   127→			dotClass: 'bg-status-completed',
   128→			filterStatus: 'completed'
   129→		},
   130→		{
   131→			key: 'cancelled' as const,
   132→			label: 'Cancelled',
   133→			dotClass: 'bg-status-cancelled',
   134→			filterStatus: 'cancelled'
   135→		}
   136→	];
   137→
   138→	// --- Needs attention items config ---
   139→	const attentionItems = $derived([
   140→		{
   141→			key: 'inbox',
   142→			label: 'Untriaged inbox',
   143→			count: inboxUntriaged,
   144→			icon: InboxIcon,
   145→			href: `${base}/inbox`,
   146→			colorClass: 'text-status-pending-review'
   147→		},
   148→		{
   149→			key: 'observations',
   150→			label: 'Unresolved observations',
   151→			count: observationsUnresolved,
   152→			icon: Eye,
   153→			href: `${base}/observations`,
   154→			colorClass: 'text-status-in-progress'
   155→		},
   156→		{
   157→			key: 'validation',
   158→			label: 'Validation warnings',
   159→			count: validationWarnings,
   160→			icon: ShieldAlert,
   161→			href: `${base}/validate`,
   162→			colorClass: 'text-status-needs-work'
   163→		},
   164→		{
   165→			key: 'blocked',
   166→			label: 'Blocked tasks',
   167→			count: blockedTasks,
   168→			icon: Ban,
   169→			href: `${base}/tasks?status=blocked`,
   170→			colorClass: 'text-status-blocked'
   171→		}
   172→	]);
   173→
   174→	// --- Elapsed time formatting ---
   175→	function formatElapsed(ms: number): string {
   176→		const secs = Math.floor(ms / 1000);
   177→		const mins = Math.floor(secs / 60);
   178→		const hours = Math.floor(mins / 60);
   179→		if (hours > 0) return `${hours}h ${mins % 60}m`;
   180→		if (mins > 0) return `${mins}m ${secs % 60}s`;
   181→		return `${secs}s`;
   182→	}
   183→
   184→	// --- Data loading ---
   185→	async function loadDashboard() {
   186→		loading = true;
   187→		error = null;
   188→
   189→		try {
   190→			const [tasksResponse, inboxResponse, obsResponse, validationResult, agentStatusResult] =
   191→				await Promise.all([
   192→					fetchTasks({ limit: 1000 }),
   193→					fetchInbox({ limit: 0 }),
   194→					fetchObservations({ resolved: false }),
   195→					fetchValidation().catch(() => null),
   196→					isStaticMode()
   197→						? Promise.resolve(null)
   198→						: fetchAgentStatus().catch(() => null)
   199→				]);
   200→
   201→			// Compute task counts
   202→			const tasks = tasksResponse.items;
   203→			const newCounts: TaskCounts = {
   204→				ready: 0,
   205→				in_progress: 0,
   206→				needs_work: 0,
   207→				pending_review: 0,
   208→				blocked: 0,
   209→				completed: 0,
   210→				cancelled: 0
   211→			};
   212→
   213→			const completedRefs = new Set(
   214→				tasks
   215→					.filter((t) => t.status === 'completed')
   216→					.flatMap((t) => [t._ulid, ...(t.slugs || [])])
   217→			);
   218→
   219→			const titles: Record<string, string> = {};
   220→
   221→			for (const task of tasks) {
   222→				// Build task titles for active fleet
   223→				if (task.slugs?.length) {
   224→					for (const slug of task.slugs) {
   225→						titles[`@${slug}`] = task.title;
   226→					}
   227→				}
   228→				titles[`@${task._ulid}`] = task.title;
   229→
   230→				switch (task.status) {
   231→					case 'completed':
   232→						newCounts.completed++;
   233→						break;
   234→					case 'in_progress':
   235→						newCounts.in_progress++;
   236→						break;
   237→					case 'pending_review':
   238→						newCounts.pending_review++;
   239→						break;
   240→					case 'blocked':
   241→						newCounts.blocked++;
   242→						break;
   243→					case 'needs_work':
   244→						newCounts.needs_work++;
   245→						break;
   246→					case 'cancelled':
   247→						newCounts.cancelled++;
   248→						break;
   249→					case 'pending': {
   250→						const deps = task.depends_on || [];
   251→						const hasUnmetDeps = deps.some((dep: string) => {
   252→							const ref = dep.startsWith('@') ? dep.slice(1) : dep;
   253→							return !completedRefs.has(ref);
   254→						});
   255→						if (hasUnmetDeps) {
   256→							// Pending tasks with unmet deps are not ready, but don't
   257→							// count as "blocked" (which is status=blocked only). They
   258→							// resolve naturally when predecessor tasks complete.
   259→						} else {
   260→							newCounts.ready++;
   261→						}
   262→						break;
   263→					}
   264→				}
   265→			}
   266→
   267→			counts = newCounts;
   268→			taskTitles = titles;
   269→			// Needs-attention blocked count only includes status=blocked tasks.
   270→			// Pending tasks with unmet deps are excluded — they resolve naturally
   271→			// when predecessor tasks complete, and don't require user intervention.
   272→			blockedTasks = newCounts.blocked;
   273→
   274→			// Inbox count
   275→			inboxUntriaged = inboxResponse.total;
   276→
   277→			// Observations: unresolved count
   278→			observationsUnresolved = obsResponse.total;
   279→
   280→			// Validation warnings
   281→			if (validationResult) {
   282→				validationWarnings =
   283→					validationResult.refWarnings.length +
   284→					validationResult.completenessWarnings.length +
   285→					validationResult.schemaErrors.length +
   286→					validationResult.refErrors.length;
   287→			}
   288→
   289→			// Agent status
   290→			if (agentStatusResult) {
   291→				agentStatus = agentStatusResult;
   292→			}
   293→		} catch (err) {
   294→			error = err instanceof Error ? err.message : 'Failed to load dashboard data';
   295→			console.error('Dashboard load error:', err);
   296→		} finally {
   297→			loading = false;
   298→		}
   299→	}
   300→
   301→	function navigateToTasks(status: string) {
   302→		goto(`${base}/tasks?status=${status}`);
   303→	}
   304→
   305→	// --- WebSocket real-time updates ---
   306→	function handleTaskUpdate() {
   307→		loadDashboard();
   308→	}
   309→
   310→	function handleAgentEvent(event: BroadcastEvent) {
   311→		// Buffer text chunks into complete lines
   312→		if (event.event === 'agent_text_chunk' && event.data?.session_id && event.data?.text) {
   313→			const sessionId = event.data.session_id as string;
   314→			const text = event.data.text as string;
   315→			const current = sessionStates[sessionId] ?? createSessionState();
   316→			sessionStates[sessionId] = processTextChunk(current, text);
   317→			return;
   318→		}
   319→
   320→		// Track tool call start for tool indicator
   321→		if (event.event === 'agent_tool_call' && event.data?.session_id) {
   322→			const sessionId = event.data.session_id as string;
   323→			const toolName = (event.data.tool ?? event.data.name ?? 'unknown') as string;
   324→			const input = event.data.input ?? event.data.rawInput;
   325→			const current = sessionStates[sessionId] ?? createSessionState();
   326→			sessionStates[sessionId] = processToolCallStart(current, toolName, input);
   327→			return;
   328→		}
   329→
   330→		// Clear tool indicator on tool completion
   331→		if (event.event === 'agent_tool_result' && event.data?.session_id) {
   332→			const sessionId = event.data.session_id as string;
   333→			const current = sessionStates[sessionId];
   334→			if (current) {
   335→				sessionStates[sessionId] = processToolCallEnd(current);
   336→			}
   337→			return;
   338→		}
   339→
   340→		// Invocation lifecycle events — refresh status and clean up stale state
   341→		fetchAgentStatus()
   342→			.then((s) => {
   343→				agentStatus = s;
   344→				const activeSessions = new Set(
   345→					s.active_invocations.map((inv) => inv.session_id)
   346→				);
   347→				for (const sessionId of Object.keys(sessionStates)) {
   348→					if (!activeSessions.has(sessionId)) {
   349→						delete sessionStates[sessionId];
   350→					}
   351→				}
   352→			})
   353→			.catch(() => {});
   354→	}
   355→
   356→	// --- Lifecycle ---
   357→	onMount(() => {
   358→		loadDashboard();
   359→
   360→		if (!isStaticMode()) {
   361→			subscribe(['tasks', 'agents']);
   362→			on('tasks', handleTaskUpdate);
   363→			on('agents', handleAgentEvent);
   364→		}
   365→	});
   366→
   367→	onDestroy(() => {
   368→		if (!isStaticMode()) {
   369→			off('tasks', handleTaskUpdate);
   370→			off('agents', handleAgentEvent);
   371→			unsubscribe(['tasks', 'agents']);
   372→		}
   373→	});
   374→
   375→	// Reload on project change
   376→	$effect(() => {
   377→		const version = getProjectVersion();
   378→		if (version > 0) {
   379→			loadDashboard();
   380→		}
   381→	});
   382→</script>
   383→
   384→<div class="flex flex-col gap-6 p-6" data-testid="dashboard">
   385→	<h1 class="text-2xl font-bold">Dashboard</h1>
   386→
   387→	{#if error}
   388→		<!-- Error state -->
   389→		<div
   390→			class="flex items-center gap-3 rounded-lg border border-destructive/50 bg-destructive/10 p-4"
   391→			role="alert"
   392→			data-testid="dashboard-error"
   393→		>
   394→			<AlertTriangle class="size-5 text-destructive" />
   395→			<div>
   396→				<p class="text-sm font-medium text-destructive">Failed to load dashboard</p>
   397→				<p class="text-xs text-muted-foreground">{error}</p>
   398→			</div>
   399→			<button
   400→				class="ml-auto text-xs text-muted-foreground underline hover:text-foreground"
   401→				onclick={loadDashboard}
   402→			>
   403→				Retry
   404→			</button>
   405→		</div>
   406→	{/if}
   407→
   408→	{#if loading}
   409→		<!-- Loading skeleton -->
   410→		<div data-testid="dashboard-skeleton">
   411→			<!-- Active work skeleton -->
   412→			<div class="mb-6">
   413→				<Skeleton class="mb-2 h-5 w-32 ds-shimmer" />
   414→				<div class="flex gap-3">
   415→					<Skeleton class="h-20 w-72 ds-shimmer" />
   416→				</div>
   417→			</div>
   418→
   419→			<!-- Status summary skeleton -->
   420→			<div class="mb-6">
   421→				<Skeleton class="mb-3 h-5 w-40 ds-shimmer" />
   422→				<div class="grid gap-4 md:grid-cols-4 lg:grid-cols-7">
   423→					{#each Array(7) as _}
   424→						<Skeleton class="h-24 ds-shimmer" />
   425→					{/each}
   426→				</div>
   427→			</div>
   428→
   429→			<!-- Needs attention skeleton -->
   430→			<div>
   431→				<Skeleton class="mb-3 h-5 w-40 ds-shimmer" />
   432→				<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">
   433→					{#each Array(4) as _}
   434→						<Skeleton class="h-20 ds-shimmer" />
   435→					{/each}
   436→				</div>
   437→			</div>
   438→		</div>
   439→	{:else}
   440→		<!-- AC: @ui-dashboard-overview ac-1 — Active work section -->
   441→		<section data-testid="active-work-section">
   442→			{#if hasActiveWork}
   443→				<div class="mb-4">
   444→					<div class="flex items-center gap-2 mb-2">
   445→						<Activity class="size-4 text-status-in-progress" />
   446→						<h2 class="text-sm font-medium">Active Fleet</h2>
   447→						<Badge variant="secondary" class="text-[10px]">
   448→							{agentStatus?.active_invocations.length} running
   449→						</Badge>
   450→					</div>
   451→					<div class="flex gap-3 overflow-x-auto pb-2" data-testid="active-fleet-row">
   452→						{#each agentStatus?.active_invocations ?? [] as invocation (invocation.session_id)}
   453→							{@const title = invocation.task_ref ? taskTitles[invocation.task_ref] : undefined}
   454→							{@const sessionState = sessionStates[invocation.session_id]}
   455→							{@const activeTool = sessionState?.activeTool ?? null}
   456→							{@const lines = sessionState?.lines ?? []}
   457→							<div
   458→								class="flex-shrink-0 w-72 rounded-lg border bg-card p-3 ds-breathe"
   459→								data-testid="fleet-card"
   460→							>
   461→								<div class="flex items-center gap-2 mb-1.5">
   462→									<Bot class="size-4 text-muted-foreground" />
   463→									<span class="text-xs font-medium truncate">{invocation.agent_id}</span>
   464→								</div>
   465→
   466→								{#if invocation.task_ref}
   467→									<div class="truncate mb-1">
   468→										<ReferenceLink ref={invocation.task_ref} type="task" title={title} class="text-xs" />
   469→									</div>
   470→								{/if}
   471→
   472→								<div class="flex items-center justify-between text-[10px] text-muted-foreground">
   473→									<div class="flex items-center gap-1.5">
   474→										<!-- Pulse indicator -->
   475→										<span class="relative flex size-2">
   476→											<span
   477→												class="absolute inline-flex h-full w-full rounded-full bg-status-in-progress opacity-75 ds-breathe"
   478→											></span>
   479→											<span
   480→												class="relative inline-flex size-2 rounded-full bg-status-in-progress"
   481→											></span>
   482→										</span>
   483→										<span>{formatElapsed(invocation.elapsed_ms)}</span>
   484→									</div>
   485→
   486→									<a
   487→										href="{base}/sessions/{invocation.session_id}"
   488→										class="inline-flex items-center gap-1 text-primary hover:underline"
   489→									>
   490→										Stream
   491→										<ExternalLink class="size-3" />
   492→									</a>
   493→								</div>
   494→
   495→								<!-- Buffered output / tool indicator -->
   496→								{#if activeTool}
   497→									<div
   498→										class="mt-1.5 flex items-center gap-1.5 rounded bg-muted/50 p-1.5 text-[10px] text-muted-foreground"
   499→										data-testid="fleet-tool-call"
   500→									>
   501→										<Wrench class="size-3 shrink-0 text-status-in-progress" />
   502→										<span class="font-medium shrink-0">{activeTool.toolName}</span>
   503→										{#if activeTool.preview}
   504→											<span class="truncate font-mono opacity-70">{activeTool.preview}</span>
   505→										{/if}
   506→									</div>
   507→								{:else if lines.length > 0}
   508→									<div
   509→										class="mt-1.5 rounded bg-muted/50 p-1.5 font-mono text-[10px] leading-tight text-muted-foreground overflow-hidden max-h-10"
   510→										data-testid="fleet-output"
   511→									>
   512→										{#each lines.slice(-2) as line}
   513→											<div class="truncate">{line}</div>
   514→										{/each}
   515→									</div>
   516→								{:else}
   517→									<div
   518→										class="mt-1.5 flex items-center gap-1 text-[10px] text-muted-foreground/50"
   519→										data-testid="fleet-output-empty"
   520→									>
   521→										<TerminalIcon class="size-3" />
   522→										<span>Awaiting output...</span>
   523→									</div>
   524→								{/if}
   525→							</div>
   526→						{/each}
   527→					</div>
   528→				</div>
   529→			{:else}
   530→				<div
   531→					class="flex items-center gap-2 rounded-lg border border-dashed p-4 text-sm text-muted-foreground"
   532→					data-testid="no-active-work"
   533→				>
   534→					<Activity class="size-4" />
   535→					<span>No agents currently running</span>
   536→				</div>
   537→			{/if}
   538→		</section>
   539→
   540→		<!-- AC: @ui-dashboard-overview ac-1 — Status summary with clickable count cards -->
   541→		<section data-testid="status-summary-section">
   542→			<h2 class="mb-3 text-sm font-medium text-muted-foreground">Status Summary</h2>
   543→			<div class="grid gap-3 md:grid-cols-4 lg:grid-cols-7" data-testid="dashboard-counts">
   544→				{#each statusConfig as status}
   545→					<button
   546→						class="text-left"
   547→						onclick={() => navigateToTasks(status.filterStatus)}
   548→						data-testid="task-count-{status.key}"
   549→					>
   550→						<Card class="transition-colors hover:bg-muted/50 cursor-pointer h-full">
   551→							<CardHeader
   552→								class="flex flex-row items-center justify-between pb-1 pt-3 px-3 space-y-0"
   553→							>
   554→								<CardTitle class="text-xs font-medium text-muted-foreground">
   555→									{status.label}
   556→								</CardTitle>
   557→								<span class="inline-block size-2.5 rounded-full {status.dotClass}"></span>
   558→							</CardHeader>
   559→							<CardContent class="px-3 pb-3">
   560→								<div class="text-2xl font-bold tabular-nums">
   561→									{counts[status.key]}
   562→								</div>
   563→							</CardContent>
