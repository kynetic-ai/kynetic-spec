   336→    // AC: @web-dashboard ac-33
   337→    test.skip('highlights task on WebSocket update', async ({ page, daemon }) => {
   338→      await page.goto('/tasks');
   339→
   340→      // Wait for WebSocket connection
   341→      await page.waitForTimeout(1000);
   342→
   343→      const taskList = page.getByTestId('task-list');
   344→      const firstTask = taskList.getByTestId('task-list-item').first();
   345→      await expect(firstTask).toBeVisible();
   346→
   347→      // Get task ref from first task
   348→      const taskRef = await firstTask.getAttribute('data-task-ref');
   349→
   350→      // Simulate external update via API (would trigger WebSocket event)
   351→      const response = await fetch(`http://localhost:3456/api/tasks/${taskRef}/note`, {
   352→        method: 'POST',
   353→        headers: {
   354→          'Content-Type': 'application/json',
   355→        },
   356→        body: JSON.stringify({
   357→          content: 'External note added',
   358→          author: '@external',
   359→        }),
   360→      });
   361→      expect(response.ok).toBe(true);
   362→
   363→      // Task should receive highlight class/animation
   364→      const highlightedTask = taskList.getByTestId('task-list-item').filter({
   365→        hasText: taskRef || '',
   366→      });
   367→
   368→      // Check for highlight class or animation (specific implementation may vary)
   369→      await expect(highlightedTask).toHaveClass(/highlight|animate/);
   370→
   371→      // Highlight should fade after animation completes
   372→      await page.waitForTimeout(2000);
   373→      await expect(highlightedTask).not.toHaveClass(/highlight/);
   374→    });
   375→  });
