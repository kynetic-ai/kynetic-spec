   268→  test.describe('Task Actions', () => {
   269→    // AC: @web-dashboard ac-7
   270→    test.skip('starts a pending task', async ({ page, daemon }) => {
   271→      await page.goto('/tasks?status=pending');
   272→
   273→      // Click pending task to open detail
   274→      const taskItem = page.getByTestId('task-list-item').first();
   275→      await taskItem.click();
   276→
   277→      const detailPanel = page.getByTestId('task-detail-panel');
   278→      const startButton = detailPanel.getByTestId('start-task-button');
   279→      await expect(startButton).toBeVisible();
   280→
   281→      // Set up request interception to verify API call
   282→      const requestPromise = page.waitForRequest((request) => {
   283→        return request.url().includes('/api/tasks/') && request.url().includes('/start');
   284→      });
   285→
   286→      // Click start button
   287→      await startButton.click();
   288→
   289→      // Verify API request was made
   290→      const request = await requestPromise;
   291→      expect(request.method()).toBe('POST');
   292→
   293→      // Status badge should update to "in_progress"
   294→      const statusBadge = detailPanel.getByTestId('task-status-badge');
   295→      await expect(statusBadge).toContainText(/in progress/i);
   296→    });
