   212→
   213→      if (count > 1) {
   214→        // Check first note timestamp is earlier than last note timestamp
   215→        const firstNoteTime = await noteItems.first().getByTestId('note-timestamp').textContent();
   216→        const lastNoteTime = await noteItems.last().getByTestId('note-timestamp').textContent();
   217→        // Both should be present (chronological order validation)
