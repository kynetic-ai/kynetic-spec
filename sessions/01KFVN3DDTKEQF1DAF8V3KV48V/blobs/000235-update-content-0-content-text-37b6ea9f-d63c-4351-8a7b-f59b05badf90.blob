   298→    // AC: @web-dashboard ac-8
   299→    test.skip('adds note to task', async ({ page, daemon }) => {
   300→      await page.goto('/tasks');
   301→
   302→      // Open task detail
   303→      const taskItem = page.getByTestId('task-list-item').first();
   304→      await taskItem.click();
   305→
   306→      const detailPanel = page.getByTestId('task-detail-panel');
   307→      const addNoteForm = detailPanel.getByTestId('add-note-form');
   308→      await expect(addNoteForm).toBeVisible();
   309→
   310→      // Type note content
   311→      const noteTextarea = addNoteForm.getByTestId('note-textarea');
   312→      const noteContent = 'Test note added via E2E test';
   313→      await noteTextarea.fill(noteContent);
   314→
   315→      // Set up request interception
   316→      const requestPromise = page.waitForRequest((request) => {
   317→        return request.url().includes('/api/tasks/') && request.url().includes('/note');
   318→      });
   319→
   320→      // Submit note
   321→      const submitButton = addNoteForm.getByTestId('add-note-button');
   322→      await submitButton.click();
   323→
   324→      // Verify API request
   325→      const request = await requestPromise;
   326→      expect(request.method()).toBe('POST');
   327→
   328→      // Note should appear in notes list
   329→      const notesSection = detailPanel.getByTestId('task-notes');
   330→      await expect(notesSection).toContainText(noteContent);
   331→
   332→      // Textarea should be cleared
   333→      await expect(noteTextarea).toHaveValue('');
   334→    });
