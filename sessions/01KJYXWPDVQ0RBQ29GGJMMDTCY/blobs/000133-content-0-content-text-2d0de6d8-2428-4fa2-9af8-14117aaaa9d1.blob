```
     1→/**
     2→ * Agent Invocation Lifecycle
     3→ *
     4→ * Per-invocation session creation, ACP agent spawn, prompt delivery,
     5→ * event logging, timeout handling, and structured completion tracking.
     6→ *
     7→ * This is the core building block used by both the dispatch engine and
     8→ * CLI one-shot mode. Each invocation creates an isolated session with
     9→ * its own event log and metadata.
    10→ *
    11→ * AC: @agent-invocation-lifecycle ac-1 through ac-11
    12→ */
    13→
    14→import * as path from "node:path";
    15→import { spawnSync } from "node:child_process";
    16→import { ulid } from "ulid";
    17→import type { Agent } from "../schema/meta.js";
    18→import { buildPromptWithSkills } from "./prompts.js";
    19→import { resolveAdapter } from "../agents/adapters.js";
    20→import { spawnAndInitialize } from "../agents/spawner.js";
    21→import type { SpawnedAgent } from "../agents/spawner.js";
    22→import type { RequestPermissionRequest, SessionUpdate } from "../acp/index.js";
    23→import {
    24→  createSession,
    25→  closeSession,
    26→  appendEvent,
    27→  injectEnvForAdapter,
    28→  removeEnvForAdapter,
    29→} from "../sessions/store.js";
    30→import type { SessionEventInput, SessionMetadata, SessionTrigger } from "../sessions/types.js";
    31→
    32→// ─── Constants ────────────────────────────────────────────────────────────────
    33→
    34→export const DEFAULT_KSPEC_CLI_PATH = path.resolve(
    35→  path.dirname(new URL(import.meta.url).pathname),
    36→  "../../bin/kspec.cjs",
    37→);
    38→
    39→// ─── Types ────────────────────────────────────────────────────────────────────
    40→
    41→/**
    42→ * Options for running a single agent invocation.
    43→ */
    44→export interface InvocationOptions {
    45→  /** The agent definition describing capabilities and configuration */
    46→  agent: Agent;
    47→  /** The spec directory (.kspec/) */
    48→  specDir: string;
    49→  /** Working directory for spawned agent */
    50→  cwd: string;
    51→  /** Task reference being worked on (e.g., "@01KJP277A"). Optional — omit for unbound invocations. */
    52→  taskRef?: string;
    53→  /** The prompt to send to the agent */
    54→  prompt: string;
    55→  /** Trigger source for this invocation */
    56→  trigger: SessionTrigger;
    57→  /** Timeout in minutes (overrides agent.budget.timeout_minutes if set) */
    58→  timeoutMinutes?: number;
    59→  /** Whether to use auto-approve (yolo) args for adapter */
    60→  autoApprove?: boolean;
    61→  /** Extra environment variables for the spawned agent */
    62→  env?: Record<string, string>;
    63→  /** Called for each streaming update from the agent */
    64→  onUpdate?: (update: SessionUpdate) => void;
    65→  /** Path to kspec CLI (defaults to resolved bin/kspec.cjs) */
    66→  kspecCliPath?: string;
    67→  /** Abort signal for graceful cancellation (AC-11) */
    68→  abortSignal?: AbortSignal;
    69→  /** Pre-assigned session ID (generated if not provided) */
    70→  sessionId?: string;
    71→}
    72→
    73→/**
    74→ * Result of a completed agent invocation.
    75→ */
    76→export interface InvocationResult {
    77→  /** Session that was created for this invocation */
    78→  session: SessionMetadata;
    79→  /** How the invocation ended */
    80→  outcome: "success" | "timed_out" | "failed";
    81→  /** Stop reason from ACP (e.g., "end_turn") if the invocation completed */
    82→  stopReason?: string;
    83→  /** Error message if the invocation failed */
    84→  error?: string;
    85→  /** Total duration in milliseconds */
    86→  durationMs: number;
    87→}
    88→
    89→/**
    90→ * Internal state tracked during invocation execution.
    91→ */
    92→interface InvocationState {
    93→  sessionId: string;
    94→  specDir: string;
    95→  taskRef: string | undefined;
    96→  adapterId: string;
    97→  previousEnvValue?: string | null;
    98→  agent: SpawnedAgent | null;
    99→  acpSessionId: string | null;
   100→}
   101→
   102→// ─── Helpers ──────────────────────────────────────────────────────────────────
   103→
   104→/**
   105→ * Run a kspec CLI command synchronously.
   106→ */
   107→function runKspecCli(args: string[], cwd: string, kspecCliPath: string): { stdout: string; stderr: string; status: number | null } {
   108→  const result = spawnSync(process.execPath, [kspecCliPath, ...args], {
   109→    encoding: "utf-8",
   110→    stdio: "pipe",
   111→    cwd,
   112→  });
   113→  return {
   114→    stdout: result.stdout ?? "",
   115→    stderr: result.stderr ?? "",
   116→    status: result.status,
   117→  };
   118→}
   119→
   120→/**
   121→ * Add a note to a task via kspec CLI.
   122→ */
   123→function addTaskNote(taskRef: string, note: string, cwd: string, kspecCliPath: string): void {
   124→  runKspecCli(["task", "note", taskRef, note], cwd, kspecCliPath);
   125→}
   126→
   127→/**
   128→ * Block a task via kspec CLI.
   129→ */
   130→function blockTask(taskRef: string, reason: string, cwd: string, kspecCliPath: string): void {
   131→  runKspecCli(["task", "block", taskRef, "--reason", reason], cwd, kspecCliPath);
   132→}
   133→
   134→/**
   135→ * Get the consecutive failure count for a task from its notes.
   136→ * Looks for AGENT-FAIL notes added by previous invocations.
   137→ */
   138→function getConsecutiveFailureCount(taskRef: string, cwd: string, kspecCliPath: string): number {
   139→  const result = runKspecCli(["task", "get", taskRef, "--json"], cwd, kspecCliPath);
   140→  if (result.status !== 0) return 0;
   141→
   142→  try {
   143→    const task = JSON.parse(result.stdout);
   144→    const notes: Array<{ content: string }> = task.notes ?? [];
   145→    // Count consecutive AGENT-FAIL notes from the end
   146→    let count = 0;
   147→    for (let i = notes.length - 1; i >= 0; i--) {
   148→      if (notes[i].content?.includes("[AGENT-FAIL]")) {
   149→        count++;
   150→      } else {
   151→        break;
   152→      }
   153→    }
   154→    return count;
   155→  } catch {
   156→    return 0;
   157→  }
   158→}
   159→
   160→/**
   161→ * Dispose a spawned agent, terminating the process if running.
   162→ * AC: @agent-invocation-lifecycle ac-8
   163→ */
   164→function disposeAgent(agent: SpawnedAgent | null): null {
   165→  if (agent) {
   166→    try {
   167→      agent.kill("SIGTERM");
   168→    } catch {
   169→      // Best-effort termination
   170→    }
   171→  }
   172→  return null;
   173→}
   174→
   175→// ─── Core Invocation ──────────────────────────────────────────────────────────
   176→
   177→/**
   178→ * Run a single agent invocation for a task.
   179→ *
   180→ * Creates a session, spawns the agent, injects KSPEC_SESSION_ID,
   181→ * sends the prompt, streams events, and closes the session on completion.
   182→ *
   183→ * AC: @agent-invocation-lifecycle ac-1 through ac-11
   184→ */
   185→export async function runInvocation(options: InvocationOptions): Promise<InvocationResult> {
   186→  const {
   187→    agent,
   188→    specDir,
   189→    cwd,
   190→    taskRef,
   191→    trigger,
   192→    autoApprove = agent.auto_approve,
   193→    env = {},
   194→    onUpdate,
   195→    kspecCliPath = DEFAULT_KSPEC_CLI_PATH,
   196→    abortSignal,
   197→  } = options;
   198→
   199→  const startTime = Date.now();
   200→  const sessionId = options.sessionId ?? ulid();
   201→
   202→  // Resolve adapter
   203→  const adapterId = agent.adapter ?? "claude-agent-acp";
   204→  const adapter = resolveAdapter(adapterId);
   205→
   206→  // Build extra args for auto-approve
   207→  const extraArgs = autoApprove ? (adapter.autoApproveArgs ?? []) : [];
   208→
   209→  // Resolve timeout: option overrides agent budget
   210→  const timeoutMinutes =
   211→    options.timeoutMinutes ??
   212→    agent.budget?.timeout_minutes ??
   213→    30;
   214→  const timeoutMs = timeoutMinutes * 60 * 1000;
   215→  // Keep ACP request timeout slightly above invocation timeout so the outer
   216→  // lifecycle controls timeout behavior (cancel + timeout note), not framing.
   217→  const promptRequestTimeoutMs = Math.max(1, Math.ceil(timeoutMs + 5_000));
   218→
   219→  // Resolve skill content for prompt
   220→  // AC: @agent-invocation-lifecycle ac-7
   221→  const fullPrompt = await buildPromptWithSkills({
   222→    basePrompt: options.prompt,
   223→    skillIds: agent.skills ?? [],
   224→    specDir,
   225→    adapterId,
   226→  });
   227→
   228→  // Capture the pre-existing KSPEC_SESSION_ID so we can restore it in finally.
   229→  // AC: @agent-invocation-lifecycle ac-8
   230→  const previousKspecSessionId = process.env.KSPEC_SESSION_ID;
   231→
   232→  const state: InvocationState = {
   233→    sessionId,
   234→    specDir,
   235→    taskRef,
   236→    adapterId,
   237→    previousEnvValue: undefined,
   238→    agent: null,
   239→    acpSessionId: null,
   240→  };
   241→
   242→  // Serialize all per-session event writes so seq assignment and append order
   243→  // are deterministic even when ACP update callbacks fire concurrently.
   244→  let eventWriteQueue: Promise<void> = Promise.resolve();
   245→  let nextEventSeq: number | undefined;
   246→
   247→  const queueEventWrite = <T>(write: () => Promise<T>): Promise<T> => {
   248→    const run = eventWriteQueue.then(write, write);
   249→    eventWriteQueue = run.then(
   250→      () => undefined,
   251→      () => undefined,
   252→    );
   253→    return run;
   254→  };
   255→
   256→  const appendSessionEvent = async (
   257→    input: Omit<SessionEventInput, "session_id" | "seq">,
   258→  ): Promise<void> => {
   259→    const event = await queueEventWrite(() =>
   260→      appendEvent(specDir, {
   261→        ...input,
   262→        session_id: sessionId,
   263→        seq: nextEventSeq,
   264→      }),
   265→    );
   266→    nextEventSeq = event.seq + 1;
   267→  };
   268→
   269→  // ─── Create session ───────────────────────────────────────────────────────
   270→  // AC: @agent-invocation-lifecycle ac-1
   271→  const session = await createSession(specDir, {
   272→    id: sessionId,
   273→    agent_type: adapterId,
   274→    agent_id: agent.id,
   275→    trigger,
   276→    task_id: taskRef,
   277→  });
   278→
   279→  // ─── Log agent.dispatched event ───────────────────────────────────────────
   280→  await appendSessionEvent({
   281→    type: "agent.dispatched",
   282→    data: {
   283→      task_id: taskRef,
   284→      agent_id: agent.id,
   285→      adapter: adapterId,
   286→      trigger,
   287→    },
   288→  });
   289→
   290→  try {
   291→    // ─── Inject KSPEC_SESSION_ID ──────────────────────────────────────────
   292→    // AC: @agent-invocation-lifecycle ac-2
   293→    const injectionResult = await injectEnvForAdapter(adapterId, sessionId);
   294→    state.previousEnvValue = injectionResult?.previousValue;
   295→    process.env.KSPEC_SESSION_ID = sessionId;
   296→
   297→    // ─── Spawn agent ──────────────────────────────────────────────────────
   298→    state.agent = await spawnAndInitialize(adapter, {
   299→      cwd,
   300→      env: {
   301→        ...env,
   302→        KSPEC_SESSION_ID: sessionId,
   303→      },
   304→      extraArgs,
   305→      clientOptions: {
   306→        methodTimeouts: {
   307→          "session/prompt": promptRequestTimeoutMs,
   308→        },
   309→      },
   310→    });
   311→
   312→    // ─── Create ACP session ───────────────────────────────────────────────
   313→    state.acpSessionId = await state.agent.client.newSession({
   314→      cwd,
   315→      mcpServers: [],
   316→    });
   317→
   318→    // ─── Log agent.started event ──────────────────────────────────────────
   319→    await appendSessionEvent({
   320→      type: "agent.started",
   321→      data: {
   322→        task_id: taskRef,
   323→        agent_id: agent.id,
   324→        acp_session_id: state.acpSessionId,
   325→      },
   326→    });
   327→
   328→    // ─── Register update handler ──────────────────────────────────────────
   329→    // AC: @agent-invocation-lifecycle ac-6
   330→    const updateHandler = async (acpSessionId: string, update: SessionUpdate) => {
   331→      if (acpSessionId !== state.acpSessionId) return;
   332→
   333→      // Log event to JSONL (with blob externalization from store.ts)
   334→      await appendSessionEvent({
   335→        type: "session.update",
   336→        data: update,
   337→      });
   338→
   339→      onUpdate?.(update);
   340→    };
   341→
   342→    state.agent.client.on("update", updateHandler);
   343→
   344→    // ─── Register permission request handler ──────────────────────────────
   345→    // AC: @agent-invocation-lifecycle ac-11
   346→    const requestHandler = (id: string | number, method: string, params: unknown) => {
   347→      if (method === "session/request_permission") {
   348→        if (autoApprove) {
   349→          // Auto-approve: prefer allow_always, fall back to allow_once
   350→          const permParams = params as RequestPermissionRequest;
   351→          const allowOption =
   352→            permParams.options?.find((o) => o.kind === "allow_always") ??
   353→            permParams.options?.find((o) => o.kind === "allow_once");
   354→
   355→          if (allowOption) {
   356→            state.agent!.client.respondPermission(id, {
   357→              outcome: { outcome: "selected", optionId: allowOption.optionId },
   358→            });
   359→          } else {
   360→            state.agent!.client.respondPermission(id, {
   361→              outcome: { outcome: "cancelled" },
   362→            });
   363→          }
   364→        } else {
   365→          // Non-auto-approve: deny the request
   366→          state.agent!.client.respondPermission(id, {
   367→            outcome: { outcome: "cancelled" },
   368→          });
   369→        }
   370→      }
   371→      // Other request types (ReadTextFile, WriteTextFile, etc.) are not handled here
   372→    };
   373→
   374→    state.agent.client.on("request", requestHandler);
   375→
   376→    // ─── Send prompt with timeout ─────────────────────────────────────────
   377→    // AC: @agent-invocation-lifecycle ac-3
   378→    let timeoutHandle: ReturnType<typeof setTimeout> | undefined;
   379→    const timeoutPromise = new Promise<never>((_, reject) => {
   380→      timeoutHandle = setTimeout(() => {
   381→        reject(new InvocationTimeoutError(timeoutMinutes));
   382→      }, timeoutMs);
   383→    });
   384→
   385→    // AC: @agent-dispatch-engine ac-11 - Abort signal for graceful cancellation
   386→    const abortPromise = abortSignal
   387→      ? new Promise<never>((_, reject) => {
   388→          if (abortSignal.aborted) {
   389→            reject(new InvocationAbortedError());
   390→          } else {
   391→            abortSignal.addEventListener("abort", () => reject(new InvocationAbortedError()), { once: true });
   392→          }
   393→        })
   394→      : null;
   395→
   396→    const promptPromise = state.agent.client.prompt({
   397→      sessionId: state.acpSessionId,
   398→      prompt: [{ type: "text", text: fullPrompt }],
   399→    });
   400→
   401→    let promptResult: Awaited<typeof promptPromise>;
   402→    try {
   403→      const racers: Array<Promise<typeof promptResult | never>> = [promptPromise, timeoutPromise];
   404→      if (abortPromise) racers.push(abortPromise);
   405→      promptResult = await Promise.race(racers);
   406→    } finally {
   407→      // Clear the timeout handle to prevent timer leaks whether prompt
   408→      // resolves normally or the timeout fires.
   409→      clearTimeout(timeoutHandle);
   410→    }
   411→
   412→    // ─── Log agent.completed event ────────────────────────────────────────
   413→    // AC: @agent-invocation-lifecycle ac-4
   414→    const durationMs = Date.now() - startTime;
   415→    await appendSessionEvent({
   416→      type: "agent.completed",
   417→      data: {
   418→        task_id: taskRef,
   419→        outcome: "success",
   420→        stop_reason: promptResult.stopReason,
   421→        duration_ms: durationMs,
   422→      },
   423→    });
   424→
   425→    // ─── Close session as completed ───────────────────────────────────────
   426→    const finalSession = await closeSession(specDir, sessionId, "completed", "Invocation completed normally");
   427→
   428→    // Add success note to reset consecutive failure streak (only when a task is bound)
   429→    // AC: @agent-invocation-lifecycle ac-9
   430→    if (taskRef) {
   431→      addTaskNote(
   432→        taskRef,
   433→        `[AGENT-SUCCESS] Invocation completed successfully`,
   434→        cwd,
   435→        kspecCliPath,
   436→      );
   437→    }
   438→
   439→    return {
   440→      session: finalSession ?? session,
   441→      outcome: "success",
   442→      stopReason: promptResult.stopReason,
   443→      durationMs,
   444→    };
   445→  } catch (err) {
   446→    const durationMs = Date.now() - startTime;
   447→
   448→    if (err instanceof InvocationTimeoutError) {
   449→      // ─── Handle timeout ──────────────────────────────────────────────
   450→      // AC: @agent-invocation-lifecycle ac-3
   451→      try {
   452→        if (state.acpSessionId && state.agent) {
   453→          await state.agent.client.cancel(state.acpSessionId);
   454→        }
   455→      } catch {
   456→        // Best-effort cancel
   457→      }
   458→
   459→      await appendSessionEvent({
   460→        type: "agent.timeout",
   461→        data: {
   462→          task_id: taskRef,
   463→          timeout_minutes: timeoutMinutes,
   464→          duration_ms: durationMs,
   465→        },
   466→      });
   467→
   468→      const finalSession = await closeSession(specDir, sessionId, "timed_out", `Timeout after ${timeoutMinutes} minutes`);
   469→
   470→      // Add timeout note to task (only when a task is bound)
   471→      if (taskRef) {
   472→        addTaskNote(
   473→          taskRef,
   474→          `[AGENT-TIMEOUT] Invocation timed out after ${timeoutMinutes} minutes`,
   475→          cwd,
   476→          kspecCliPath,
   477→        );
   478→      }
   479→
   480→      return {
   481→        session: finalSession ?? session,
   482→        outcome: "timed_out",
   483→        error: err.message,
   484→        durationMs,
   485→      };
   486→    }
   487→
   488→    if (err instanceof InvocationAbortedError) {
   489→      // ─── Handle graceful abort (shutdown signal) ──────────────────────
   490→      // AC: @agent-dispatch-engine ac-11
   491→      try {
   492→        if (state.acpSessionId && state.agent) {
   493→          await state.agent.client.cancel(state.acpSessionId);
   494→        }
   495→      } catch {
   496→        // Best-effort cancel
   497→      }
   498→
   499→      const finalSession = await closeSession(specDir, sessionId, "failed", "Invocation aborted by shutdown");
   500→
   501→      return {
   502→        session: finalSession ?? session,
   503→        outcome: "failed",
   504→        error: err.message,
   505→        durationMs,
   506→      };
   507→    }
   508→
   509→    // ─── Handle failure ──────────────────────────────────────────────────
   510→    // AC: @agent-invocation-lifecycle ac-5
   511→    const errorMessage = err instanceof Error ? err.message : String(err);
   512→
   513→    await appendSessionEvent({
   514→      type: "agent.failed",
   515→      data: {
   516→        task_id: taskRef,
   517→        error: errorMessage,
   518→        duration_ms: durationMs,
   519→      },
   520→    });
   521→
   522→    const finalSession = await closeSession(specDir, sessionId, "failed", `Invocation failed: ${errorMessage}`);
   523→
   524→    // Add failure note to task and check retry threshold (only when a task is bound)
   525→    if (taskRef) {
   526→      addTaskNote(
   527→        taskRef,
   528→        `[AGENT-FAIL] Invocation failed: ${errorMessage}`,
   529→        cwd,
   530→        kspecCliPath,
   531→      );
   532→
   533→      // ─── Check retry threshold ────────────────────────────────────────────
   534→      // AC: @agent-invocation-lifecycle ac-9
   535→      const retryLimit = agent.budget?.max_tasks ?? 3;
   536→      const consecutiveFailures = getConsecutiveFailureCount(taskRef, cwd, kspecCliPath);
   537→
   538→      if (consecutiveFailures >= retryLimit) {
   539→        blockTask(
   540→          taskRef,
   541→          `Agent ${agent.id} failed ${consecutiveFailures} consecutive times: ${errorMessage}`,
   542→          cwd,
   543→          kspecCliPath,
   544→        );
   545→      }
   546→    }
   547→
   548→    return {
   549→      session: finalSession ?? session,
   550→      outcome: "failed",
   551→      error: errorMessage,
   552→      durationMs,
   553→    };
   554→  } finally {
   555→    // ─── Cleanup ──────────────────────────────────────────────────────────
   556→    // AC: @agent-invocation-lifecycle ac-8
   557→
   558→    // End ACP session
   559→    if (state.acpSessionId && state.agent) {
   560→      try {
   561→        state.agent.client.endSession(state.acpSessionId);
   562→      } catch {
   563→        // Best-effort
   564→      }
   565→    }
   566→
   567→    // Terminate agent process
   568→    state.agent = disposeAgent(state.agent);
   569→
   570→    // Restore env injection
   571→    await removeEnvForAdapter(adapterId, state.previousEnvValue);
   572→
   573→    // Restore process.env.KSPEC_SESSION_ID to its pre-invocation value.
   574→    // AC: @agent-invocation-lifecycle ac-8
   575→    if (previousKspecSessionId === undefined) {
   576→      delete process.env.KSPEC_SESSION_ID;
   577→    } else {
   578→      process.env.KSPEC_SESSION_ID = previousKspecSessionId;
   579→    }
   580→  }
   581→}
   582→
   583→// ─── Error Types ──────────────────────────────────────────────────────────────
   584→
   585→/**
   586→ * Thrown when an invocation exceeds its configured timeout.
   587→ */
   588→export class InvocationTimeoutError extends Error {
   589→  constructor(public readonly timeoutMinutes: number) {
   590→    super(`Agent invocation timed out after ${timeoutMinutes} minutes`);
   591→    this.name = "InvocationTimeoutError";
   592→  }
   593→}
   594→
   595→/**
   596→ * Thrown when an invocation is aborted via AbortSignal (graceful shutdown).
   597→ * AC: @agent-dispatch-engine ac-11
   598→ */
   599→export class InvocationAbortedError extends Error {
   600→  constructor() {
   601→    super("Agent invocation aborted by shutdown signal");
   602→    this.name = "InvocationAbortedError";
   603→  }
   604→}
   605→
```