```
     1→<script lang="ts">
     2→import katex from 'katex';
     3→import * as smd from 'streaming-markdown';
     4→import { onMount } from 'svelte';
     5→import 'katex/dist/katex.min.css';
     6→import { highlightCode } from '$lib/utils/highlight.js';
     7→import { isMermaidLanguage, renderMermaid } from '$lib/utils/mermaid-loader.js';
     8→import { sanitizeHtml } from '$lib/utils/sanitize.js';
     9→
    10→interface Props {
    11→  /** The markdown content to render */
    12→  content: string;
    13→  /** Whether the content is still streaming */
    14→  isStreaming?: boolean;
    15→}
    16→
    17→const { content, isStreaming = false }: Props = $props();
    18→
    19→let containerEl: HTMLDivElement | undefined = $state();
    20→
    21→// Use regular variables (not $state) for internal tracking to avoid effect loops
    22→let parser: ReturnType<typeof smd.parser> | null = null;
    23→let lastContent = '';
    24→let hasFinalized = false;
    25→
    26→/**
    27→ * Custom renderer that extends default_renderer with our Tailwind classes.
    28→ * streaming-markdown's default renderer uses minimal inline styling.
    29→ * We customize element creation to apply our design system.
    30→ */
    31→function createStyledRenderer(element: HTMLElement) {
    32→  const baseRenderer = smd.default_renderer(element);
    33→
    34→  // Wrap add_token to add classes
    35→  const originalAddToken = baseRenderer.add_token;
    36→  baseRenderer.add_token = (data, token) => {
    37→    originalAddToken(data, token);
    38→
    39→    // Get the newly created element from the renderer's node stack
    40→    // data.nodes[data.index] is the element just created by add_token
    41→    const newElement = data.nodes[data.index];
    42→    if (!newElement || !(newElement instanceof HTMLElement)) return;
    43→
    44→    // Apply Tailwind classes based on token type
    45→    // Token names use underscores: Code_Block, Code_Inline, etc.
    46→    switch (token) {
    47→      case smd.Token.Code_Block:
    48→      case smd.Token.Code_Fence:
    49→        newElement.classList.add(
    50→          'my-2',
    51→          'rounded',
    52→          'bg-zinc-950',
    53→          'p-2',
    54→          'text-xs',
    55→          'overflow-x-auto',
    56→          'font-mono',
    57→          'text-zinc-300',
    58→          'code-block', // Marker class for highlighting
    59→        );
    60→        break;
    61→      case smd.Token.Code_Inline:
    62→        newElement.classList.add(
    63→          'rounded',
    64→          'bg-zinc-800',
    65→          'px-1',
    66→          'py-0.5',
    67→          'text-xs',
    68→          'font-mono',
    69→          'text-orange-300',
    70→        );
    71→        break;
    72→      case smd.Token.Strong_Ast:
    73→      case smd.Token.Strong_Und:
    74→        newElement.classList.add('font-semibold', 'text-zinc-200');
    75→        break;
    76→      case smd.Token.Italic_Ast:
    77→      case smd.Token.Italic_Und:
    78→        newElement.classList.add('italic');
    79→        break;
    80→      case smd.Token.Blockquote:
    81→        newElement.classList.add(
    82→          'border-l-2',
    83→          'border-zinc-600',
    84→          'pl-3',
    85→          'my-2',
    86→          'text-zinc-400',
    87→          'italic',
    88→        );
    89→        break;
    90→      case smd.Token.List_Ordered:
    91→      case smd.Token.List_Unordered:
    92→        newElement.classList.add('my-2', 'ml-4', 'list-inside');
    93→        if (token === smd.Token.List_Ordered) {
    94→          newElement.classList.add('list-decimal');
    95→        } else {
    96→          newElement.classList.add('list-disc');
    97→        }
    98→        break;
    99→      case smd.Token.Link:
   100→        newElement.classList.add('text-blue-400', 'hover:underline');
   101→        // Security: add target and rel for external links
   102→        (newElement as HTMLAnchorElement).target = '_blank';
   103→        (newElement as HTMLAnchorElement).rel = 'noopener noreferrer';
   104→        break;
   105→      case smd.Token.Heading_1:
   106→        newElement.classList.add('text-xl', 'font-bold', 'mt-4', 'mb-2', 'text-zinc-200');
   107→        break;
   108→      case smd.Token.Heading_2:
   109→        newElement.classList.add('text-lg', 'font-bold', 'mt-3', 'mb-2', 'text-zinc-200');
   110→        break;
   111→      case smd.Token.Heading_3:
   112→        newElement.classList.add('text-base', 'font-semibold', 'mt-2', 'mb-1', 'text-zinc-200');
   113→        break;
   114→      case smd.Token.Rule:
   115→        newElement.classList.add('my-4', 'border-zinc-700');
   116→        break;
   117→      case smd.Token.Strike:
   118→        newElement.classList.add('line-through', 'text-zinc-500');
   119→        break;
   120→      case smd.Token.Equation_Block:
   121→        newElement.classList.add('my-4', 'overflow-x-auto', 'text-center');
   122→        newElement.dataset.katex = 'block';
   123→        break;
   124→      case smd.Token.Equation_Inline:
   125→        newElement.dataset.katex = 'inline';
   126→        break;
   127→      case smd.Token.Table:
   128→        newElement.classList.add('my-4', 'w-full', 'border-collapse', 'text-sm');
   129→        break;
   130→      case smd.Token.Table_Row:
   131→        newElement.classList.add('border-b', 'border-zinc-700');
   132→        break;
   133→      case smd.Token.Table_Cell:
   134→        newElement.classList.add('px-3', 'py-2', 'text-left');
   135→        break;
   136→      case smd.Token.Checkbox:
   137→        newElement.classList.add(
   138→          'mr-2',
   139→          'h-4',
   140→          'w-4',
   141→          'rounded',
   142→          'border',
   143→          'border-zinc-600',
   144→          'bg-zinc-800',
   145→          'appearance-none',
   146→          'align-middle',
   147→          'relative',
   148→        );
   149→        // Make read-only (display only)
   150→        (newElement as HTMLInputElement).disabled = true;
   151→        break;
   152→    }
   153→  };
   154→
   155→  // Wrap set_attr to capture language for code blocks
   156→  const originalSetAttr = baseRenderer.set_attr;
   157→  baseRenderer.set_attr = (data, attr, value) => {
   158→    originalSetAttr(data, attr, value);
   159→
   160→    // When language attribute is set on a code fence, store it
   161→    if (attr === smd.Attr.Lang && value) {
   162→      const currentElement = data.nodes[data.index];
   163→      if (currentElement instanceof HTMLElement) {
   164→        currentElement.dataset.language = value;
   165→      }
   166→    }
   167→  };
   168→
   169→  return baseRenderer;
   170→}
   171→
   172→/**
   173→ * Apply syntax highlighting to all code blocks in the container.
   174→ * Called after parser finalization to avoid flickering during streaming.
   175→ * Skips mermaid blocks which are rendered separately.
   176→ */
   177→function applyHighlighting(container: HTMLElement) {
   178→  const codeBlocks = container.querySelectorAll('.code-block');
   179→  for (const block of codeBlocks) {
   180→    if (!(block instanceof HTMLElement)) continue;
   181→
   182→    // Get language hint from data attribute
   183→    const language = block.dataset.language;
   184→
   185→    // Skip mermaid blocks - they're rendered as diagrams, not code
   186→    if (isMermaidLanguage(language)) {
   187→      block.classList.add('mermaid-pending');
   188→      continue;
   189→    }
   190→
   191→    // Find the code element inside (usually <pre><code>)
   192→    const codeEl = block.querySelector('code') || block;
   193→    if (!(codeEl instanceof HTMLElement)) continue;
   194→
   195→    // Get original text content
   196→    const code = codeEl.textContent || '';
   197→    if (!code.trim()) continue;
   198→
   199→    // Apply highlighting
   200→    codeEl.innerHTML = highlightCode(code, language);
   201→
   202→    // Mark as highlighted to prevent re-processing
   203→    block.classList.add('highlighted');
   204→  }
   205→}
   206→
   207→/**
   208→ * Render math equations using KaTeX.
   209→ * Called after parser finalization and sanitization.
   210→ * Finds equations by data-katex attribute or by element name (equation-block, equation-inline).
   211→ */
   212→function renderMathEquations(container: HTMLElement) {
   213→  // Find by data attribute or by element tag name
   214→  const equations = container.querySelectorAll('[data-katex], equation-block, equation-inline');
   215→  for (const el of equations) {
   216→    if (!(el instanceof HTMLElement)) continue;
   217→    if (el.classList.contains('katex-rendered')) continue; // Already rendered
   218→
   219→    const isBlock = el.dataset.katex === 'block' || el.tagName.toLowerCase() === 'equation-block';
   220→    const latex = el.textContent || '';
   221→
   222→    if (!latex.trim()) continue;
   223→
   224→    try {
   225→      katex.render(latex, el, {
   226→        displayMode: isBlock,
   227→        throwOnError: false, // Show original text on error
   228→        output: 'html',
   229→      });
   230→      // Mark as rendered to prevent re-processing
   231→      el.classList.add('katex-rendered');
   232→    } catch (e) {
   233→      // Leave original text on error
   234→      console.warn('KaTeX render error:', e);
   235→    }
   236→  }
   237→}
   238→
   239→/**
   240→ * Render mermaid diagrams.
   241→ * Called after parser finalization. Mermaid is lazy-loaded only when diagrams are detected.
   242→ */
   243→async function renderMermaidDiagrams(container: HTMLElement) {
   244→  const mermaidBlocks = container.querySelectorAll('.mermaid-pending');
   245→  if (mermaidBlocks.length === 0) return;
   246→
   247→  for (const block of mermaidBlocks) {
   248→    if (!(block instanceof HTMLElement)) continue;
   249→    if (block.classList.contains('mermaid-rendered')) continue; // Already rendered
   250→
   251→    // Get the mermaid code from the block
   252→    const codeEl = block.querySelector('code') || block;
   253→    const code = codeEl.textContent || '';
   254→
   255→    if (!code.trim()) continue;
   256→
   257→    try {
   258→      await renderMermaid(block, code);
   259→      block.classList.remove('mermaid-pending');
   260→      block.classList.add('mermaid-rendered');
   261→    } catch (e) {
   262→      console.warn('Mermaid render error:', e);
   263→      // Mark as error but leave code visible
   264→      block.classList.remove('mermaid-pending');
   265→      block.classList.add('mermaid-error');
   266→    }
   267→  }
   268→}
   269→
   270→// Initialize parser when container element is available
   271→// Using $effect instead of onMount because bind:this may not be ready in onMount
   272→$effect(() => {
   273→  if (!containerEl || parser) return; // Already initialized or no container
   274→
   275→  const renderer = createStyledRenderer(containerEl);
   276→  parser = smd.parser(renderer);
   277→
   278→  // Render initial content
   279→  if (content) {
   280→    smd.parser_write(parser, content);
   281→    lastContent = content;
   282→  }
   283→
   284→  // If not streaming, finalize immediately
   285→  if (!isStreaming && content) {
   286→    smd.parser_end(parser);
   287→    hasFinalized = true;
   288→
   289→    // Sanitize and highlight
   290→    containerEl.innerHTML = sanitizeHtml(containerEl.innerHTML);
   291→    applyHighlighting(containerEl);
   292→    renderMathEquations(containerEl);
   293→    renderMermaidDiagrams(containerEl);
   294→  }
   295→});
   296→
   297→// Cleanup on unmount
   298→onMount(() => {
   299→  return () => {
   300→    if (parser) {
   301→      parser = null;
   302→    }
   303→  };
   304→});
   305→
   306→// Handle content updates (streaming)
   307→$effect(() => {
   308→  if (!parser || !containerEl) return;
   309→
   310→  // Only react to content changes
   311→  const currentContent = content;
   312→
   313→  if (currentContent.length > lastContent.length) {
   314→    // Content grew - write new chunk
   315→    const newChunk = currentContent.slice(lastContent.length);
   316→    smd.parser_write(parser, newChunk);
   317→    lastContent = currentContent;
   318→  } else if (currentContent !== lastContent) {
   319→    // Content changed completely - reset and re-render
   320→    containerEl.innerHTML = '';
   321→    const renderer = createStyledRenderer(containerEl);
   322→    parser = smd.parser(renderer);
   323→    smd.parser_write(parser, currentContent);
   324→    lastContent = currentContent;
   325→    hasFinalized = false;
   326→  }
   327→});
   328→
   329→// Handle streaming end
   330→$effect(() => {
   331→  // Only finalize once when streaming ends
   332→  if (parser && !isStreaming && lastContent.length > 0 && !hasFinalized) {
   333→    hasFinalized = true;
   334→    // Streaming ended - finalize
   335→    smd.parser_end(parser);
   336→
   337→    // Sanitize final output for security
   338→    if (containerEl) {
   339→      containerEl.innerHTML = sanitizeHtml(containerEl.innerHTML);
   340→
   341→      // Apply syntax highlighting after sanitization
   342→      applyHighlighting(containerEl);
   343→
   344→      // Render math equations after sanitization
   345→      renderMathEquations(containerEl);
   346→
   347→      // Render mermaid diagrams (lazy-loaded)
   348→      renderMermaidDiagrams(containerEl);
   349→    }
   350→  }
   351→});
   352→</script>
   353→
   354→<div bind:this={containerEl} class="streaming-markdown"></div>
   355→
   356→<style>
   357→	.streaming-markdown :global(p) {
   358→		margin-bottom: 0.5rem;
   359→	}
   360→
   361→	.streaming-markdown :global(p:last-child) {
   362→		margin-bottom: 0;
   363→	}
   364→
   365→	/* Bug 5 fix: Preserve whitespace in code blocks */
   366→	.streaming-markdown :global(pre),
   367→	.streaming-markdown :global(pre code) {
   368→		white-space: pre;
   369→	}
   370→
   371→	/* Nested list styling - ensure proper indentation even if structure is flat */
   372→	.streaming-markdown :global(ul ul),
   373→	.streaming-markdown :global(ol ol),
   374→	.streaming-markdown :global(ul ol),
   375→	.streaming-markdown :global(ol ul) {
   376→		margin-left: 1rem;
   377→		margin-top: 0.25rem;
   378→		margin-bottom: 0.25rem;
   379→	}
   380→
   381→	/* Nested blockquote styling */
   382→	.streaming-markdown :global(blockquote blockquote) {
   383→		margin-left: 0.5rem;
   384→		border-left-color: oklch(0.442 0 0); /* zinc-600 dimmed */
   385→	}
   386→
   387→	/* Table styling */
   388→	.streaming-markdown :global(table) {
   389→		border: 1px solid oklch(0.442 0 0); /* zinc-600 */
   390→		overflow-x: auto;
   391→		display: block;
   392→	}
   393→
   394→	.streaming-markdown :global(th) {
   395→		background-color: oklch(0.274 0 0); /* zinc-800 */
   396→		font-weight: 600;
   397→	}
   398→
   399→	/* Header row styling (first row in table) */
   400→	.streaming-markdown :global(tr:first-child td) {
   401→		background-color: oklch(0.274 0 0); /* zinc-800 */
   402→		font-weight: 600;
   403→	}
   404→
   405→	/* Checkbox styling for task lists */
   406→	.streaming-markdown :global(input[type='checkbox']) {
   407→		pointer-events: none; /* read-only */
   408→	}
   409→
   410→	.streaming-markdown :global(input[type='checkbox']:checked) {
   411→		background-color: oklch(0.623 0.214 259.815); /* blue-500 */
   412→		border-color: oklch(0.623 0.214 259.815);
   413→	}
   414→
   415→	/* Checkmark for checked state */
   416→	.streaming-markdown :global(input[type='checkbox']:checked::after) {
   417→		content: '✓';
   418→		position: absolute;
   419→		color: white;
   420→		font-size: 0.625rem;
   421→		font-weight: bold;
   422→		top: 50%;
   423→		left: 50%;
   424→		transform: translate(-50%, -50%);
   425→	}
   426→
   427→	/* KaTeX math styling for dark theme */
   428→	.streaming-markdown :global(.katex) {
   429→		color: oklch(0.871 0 0); /* zinc-300 - match text color */
   430→	}
   431→
   432→	.streaming-markdown :global(.katex-display) {
   433→		margin: 1rem 0;
   434→	}
   435→
   436→	/* Mermaid diagram styling */
   437→	.streaming-markdown :global(.mermaid-pending) {
   438→		min-height: 100px;
   439→		display: flex;
   440→		align-items: center;
   441→		justify-content: center;
   442→		background: oklch(0.21 0 0); /* zinc-900 */
   443→		border-radius: 0.5rem;
   444→		color: oklch(0.552 0 0); /* zinc-500 */
   445→	}
   446→
   447→	.streaming-markdown :global(.mermaid-pending)::before {
   448→		content: 'Loading diagram...';
   449→	}
   450→
   451→	.streaming-markdown :global(.mermaid-rendered) {
   452→		display: flex;
   453→		justify-content: center;
   454→		padding: 1rem;
   455→		background: oklch(0.21 0 0); /* zinc-900 */
   456→		border-radius: 0.5rem;
   457→		overflow-x: auto;
   458→	}
   459→
   460→	/* Mermaid generates SVGs - ensure they fit and use good colors */
   461→	.streaming-markdown :global(.mermaid-rendered svg) {
   462→		max-width: 100%;
   463→		height: auto;
   464→	}
   465→
   466→	.streaming-markdown :global(.mermaid-error) {
   467→		border: 1px solid oklch(0.704 0.191 22.216); /* red-400 */
   468→		background: oklch(0.21 0 0);
   469→	}
   470→
   471→	.streaming-markdown :global(.mermaid-error)::before {
   472→		content: 'Diagram error - ';
   473→		color: oklch(0.704 0.191 22.216); /* red-400 */
   474→		font-weight: 500;
   475→	}
   476→</style>
