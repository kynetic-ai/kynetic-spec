```
     1→import { z } from "zod";
     2→import { DateTimeSchema, RefSchema, UlidSchema } from "./common.js";
     3→
     4→/**
     5→ * ULID schema for meta items - uses the same strict validation as core items.
     6→ * All ULIDs must be exactly 26 characters in Crockford base32 format.
     7→ */
     8→const MetaUlidSchema = UlidSchema;
     9→
    10→/**
    11→ * Agent session protocol - commands to run at session lifecycle events
    12→ */
    13→export const SessionProtocolSchema = z.object({
    14→  start: z.string().nullable().optional(),
    15→  checkpoint: z.string().nullable().optional(),
    16→  end: z.string().nullable().optional(),
    17→});
    18→
    19→/**
    20→ * Agent dispatch event types - lifecycle events that can trigger agent spawning
    21→ * AC: @agent-definition-schema ac-2
    22→ */
    23→export const AgentDispatchEventSchema = z.enum([
    24→  "task.in_progress",
    25→  "task.ready",
    26→  "task.needs_work",
    27→  "task.pending_review",
    28→]);
    29→
    30→/**
    31→ * Agent dispatch filter - constraints for matching tasks during dispatch
    32→ * AC: @agent-definition-schema ac-3
    33→ */
    34→export const AgentDispatchFilterSchema = z.object({
    35→  automation: z.enum(["eligible", "ineligible"]).optional(),
    36→  tags: z.array(z.string()).optional(),
    37→  priority: z.number().optional(),
    38→});
    39→
    40→/**
    41→ * Agent dispatch rule - maps an event type to optional filters
    42→ * AC: @agent-definition-schema ac-2
    43→ */
    44→export const AgentDispatchRuleSchema = z.object({
    45→  on: AgentDispatchEventSchema,
    46→  filter: AgentDispatchFilterSchema.optional(),
    47→});
    48→
    49→/**
    50→ * Agent budget settings - limits on task count and time
    51→ * AC: @agent-definition-schema ac-4
    52→ */
    53→export const AgentBudgetSchema = z.object({
    54→  max_tasks: z.number().positive().optional(),
    55→  timeout_minutes: z.number().positive().optional(),
    56→});
    57→
    58→/**
    59→ * Agent concurrency settings
    60→ * AC: @agent-definition-schema ac-6
    61→ */
    62→export const AgentConcurrencySchema = z.object({
    63→  max_concurrent: z.number().int().positive().default(1),
    64→});
    65→
    66→/**
    67→ * Agent definition - describes an agent's role and capabilities
    68→ * AC: @agent-definition-schema ac-1 through ac-8
    69→ */
    70→export const AgentSchema = z.object({
    71→  _ulid: MetaUlidSchema,
    72→  id: z.string().min(1, "Agent ID is required"),
    73→  name: z.string().min(1, "Agent name is required"),
    74→  description: z.string().optional(),
    75→  capabilities: z.array(z.string()).default([]),
    76→  tools: z.array(z.string()).default([]),
    77→  session_protocol: SessionProtocolSchema.optional(),
    78→  conventions: z.array(z.string()).default([]),
    79→  // New dispatch/runtime fields (AC: @agent-definition-schema ac-1 through ac-8)
    80→  adapter: z.string().optional(),
    81→  dispatch: z.array(AgentDispatchRuleSchema).default([]),
    82→  skills: z.array(z.string()).default([]),
    83→  budget: AgentBudgetSchema.optional(),
    84→  concurrency: AgentConcurrencySchema.default({ max_concurrent: 1 }),
    85→  auto_approve: z.boolean().default(false),
    86→  prompt_template: z.string().optional(),
    87→  /** Automation eligibility for agent list filtering (eligible|ineligible) */
    88→  automation: z.enum(["eligible", "ineligible"]).optional(),
    89→  /** Tags for filtering and categorization */
    90→  tags: z.array(z.string()).default([]).optional(),
    91→});
    92→
    93→/**
    94→ * Workflow step types
    95→ */
    96→export const WorkflowStepTypeSchema = z.enum(["check", "action", "decision"]);
    97→
    98→/**
    99→ * Workflow step execution hints
   100→ */
   101→export const StepExecutionSchema = z.object({
   102→  mode: z.enum(["prompt", "silent", "skip"]).default("prompt"),
   103→  timeout: z.number().nullable().optional(),
   104→});
   105→
   106→/**
   107→ * Workflow step input definition
   108→ */
   109→export const StepInputSchema = z.object({
   110→  name: z.string().min(1, "Input name is required"),
   111→  description: z.string().optional(),
   112→  required: z.boolean().default(true).optional(),
   113→  type: z.enum(["string", "ref", "number"]).default("string").optional(),
   114→});
   115→
   116→/**
   117→ * Workflow step - a single step in a workflow
   118→ */
   119→export const WorkflowStepSchema = z.object({
   120→  type: WorkflowStepTypeSchema,
   121→  content: z.string(),
   122→  on_fail: z.string().optional(),
   123→  options: z.array(z.string()).optional(), // For decision type
   124→  execution: StepExecutionSchema.optional(),
   125→  entry_criteria: z.array(z.string()).optional(),
   126→  exit_criteria: z.array(z.string()).optional(),
   127→  inputs: z.array(StepInputSchema).optional(),
   128→});
   129→
   130→/**
   131→ * Workflow mode - interactive (default) for human-in-loop, loop for autonomous agents
   132→ */
   133→export const WorkflowModeSchema = z.enum(["interactive", "loop"]);
   134→
   135→/**
   136→ * Workflow definition - structured process definition
   137→ */
   138→export const WorkflowSchema = z.object({
   139→  _ulid: MetaUlidSchema,
   140→  id: z.string().min(1, "Workflow ID is required"),
   141→  trigger: z.string().min(1, "Workflow trigger is required"),
   142→  description: z.string().optional(),
   143→  steps: z.array(WorkflowStepSchema).default([]),
   144→  enforcement: z.enum(["advisory", "strict"]).default("advisory").optional(),
   145→  mode: WorkflowModeSchema.default("interactive").optional(),
   146→  based_on: RefSchema.optional(),
   147→  tags: z.array(z.string()).default([]).optional(),
   148→});
   149→
   150→/**
   151→ * Convention example (good/bad)
   152→ */
   153→export const ConventionExampleSchema = z.object({
   154→  good: z.string(),
   155→  bad: z.string(),
   156→});
   157→
   158→/**
   159→ * Convention validation configuration
   160→ */
   161→export const ConventionValidationSchema = z.object({
   162→  type: z.enum(["regex", "enum", "range", "prose"]),
   163→  // For regex
   164→  pattern: z.string().optional(),
   165→  message: z.string().optional(),
   166→  // For enum
   167→  allowed: z.array(z.string()).optional(),
   168→  // For range
   169→  min: z.number().optional(),
   170→  max: z.number().optional(),
   171→  unit: z.enum(["words", "chars", "lines"]).optional(),
   172→});
   173→
   174→/**
   175→ * Convention definition - project-specific rules and standards
   176→ */
   177→export const ConventionSchema = z.object({
   178→  _ulid: MetaUlidSchema,
   179→  domain: z.string().min(1, "Convention domain is required"),
   180→  rules: z.array(z.string()).default([]),
   181→  examples: z.array(ConventionExampleSchema).default([]),
   182→  validation: ConventionValidationSchema.optional(),
   183→});
   184→
   185→/**
   186→ * Observation types
   187→ */
   188→export const ObservationTypeSchema = z.enum([
   189→  "friction",
   190→  "success",
   191→  "question",
   192→  "idea",
   193→]);
   194→
   195→/**
   196→ * Observation - feedback about workflows and conventions
   197→ */
   198→export const ObservationSchema = z.object({
   199→  _ulid: MetaUlidSchema,
   200→  type: ObservationTypeSchema,
   201→  workflow_ref: RefSchema.optional(),
   202→  content: z.string().min(1, "Observation content is required"),
   203→  created_at: DateTimeSchema,
   204→  author: z.string().optional(),
   205→  resolved: z.boolean().default(false),
   206→  resolution: z.string().nullable().optional(),
   207→  resolved_at: DateTimeSchema.optional(),
   208→  resolved_by: z.string().optional(),
   209→  promoted_to: RefSchema.optional(),
   210→});
   211→
   212→/**
   213→ * Skill origin - where the skill comes from
   214→ */
   215→export const SkillOriginSchema = z.enum(["core", "project", "local"]);
   216→
   217→/**
   218→ * Claude Code platform config - settings specific to Claude Code
   219→ */
   220→export const ClaudeCodeConfigSchema = z
   221→  .object({
   222→    disable_model_invocation: z.boolean().optional(),
   223→    user_invocable: z.boolean().optional(),
   224→    context: z.string().optional(),
   225→    agent: z.string().optional(),
   226→    model: z.string().optional(),
   227→    argument_hint: z.string().optional(),
   228→  })
   229→  .strict();
   230→
   231→/**
   232→ * Codex platform config - settings specific to OpenAI Codex CLI
   233→ */
   234→export const CodexConfigSchema = z
   235→  .object({
   236→    allow_implicit_invocation: z.boolean().optional(),
   237→    display_name: z.string().optional(),
   238→    short_description: z.string().optional(),
   239→    icon_small: z.string().optional(),
   240→    icon_large: z.string().optional(),
   241→    brand_color: z.string().optional(),
   242→    default_prompt: z.string().optional(),
   243→  })
   244→  .strict();
   245→
   246→/**
   247→ * Platform config - container for platform-specific settings
   248→ * Uses passthrough for unknown platforms to support future extensibility
   249→ */
   250→export const PlatformConfigSchema = z
   251→  .object({
   252→    claude_code: ClaudeCodeConfigSchema.optional(),
   253→    codex: CodexConfigSchema.optional(),
   254→  })
   255→  .passthrough();
   256→
   257→/**
   258→ * Kebab-case regex for skill IDs - lowercase letters, numbers, and hyphens only
   259→ * Must start with a letter and not end with a hyphen
   260→ */
   261→const KEBAB_CASE_REGEX = /^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$/;
   262→
   263→/**
   264→ * Skill definition - reusable agent capabilities stored in files
   265→ * Content is stored in .kspec/skills/<id>/SKILL.md
   266→ *
   267→ * Extended with portable Agent Skills fields for multi-platform support:
   268→ * - license, compatibility, allowed_tools for portability
   269→ * - metadata for arbitrary key-value pairs
   270→ * - platform_config for platform-specific settings
   271→ */
   272→export const SkillSchema = z.object({
   273→  _ulid: MetaUlidSchema,
   274→  _type: z.literal("skill").default("skill"),
   275→  id: z
   276→    .string({ required_error: "Skill ID is required" })
   277→    .regex(
   278→      KEBAB_CASE_REGEX,
   279→      "Skill ID must be in kebab-case format (lowercase letters, numbers, and hyphens)",
   280→    ),
   281→  name: z.string().min(1, "Skill name is required"),
   282→  description: z.string().optional(),
   283→  origin: SkillOriginSchema,
   284→  version: z.string().optional(),
   285→  platforms: z.array(z.string()).default(["claude-code"]),
   286→  depends_on: z.array(RefSchema).default([]),
   287→  tags: z.array(z.string()).default([]),
   288→  // Portable Agent Skills fields
   289→  license: z.string().optional(),
   290→  compatibility: z.string().optional(),
   291→  allowed_tools: z.array(z.string()).default([]),
   292→  metadata: z.record(z.string(), z.unknown()).optional(),
   293→  platform_config: PlatformConfigSchema.optional(),
   294→});
   295→
   296→/**
   297→ * Session context schema - ephemeral session state
   298→ */
   299→export const SessionContextSchema = z.object({
   300→  focus: z.string().nullable(),
   301→  threads: z.array(z.string()).default([]),
   302→  open_questions: z.array(z.string()).default([]),
   303→  updated_at: DateTimeSchema,
   304→});
   305→
   306→/**
   307→ * Step result status
   308→ */
   309→export const StepResultStatusSchema = z.enum([
   310→  "completed",
   311→  "skipped",
   312→  "failed",
   313→]);
   314→
   315→/**
   316→ * Step result schema - result of executing a workflow step
   317→ */
   318→export const StepResultSchema = z.object({
   319→  step_index: z.number(),
   320→  status: StepResultStatusSchema,
   321→  started_at: DateTimeSchema,
   322→  completed_at: DateTimeSchema,
   323→  entry_confirmed: z.boolean().optional(),
   324→  exit_confirmed: z.boolean().optional(),
   325→  notes: z.string().optional(),
   326→  inputs: z.record(z.string()).optional(),
   327→});
   328→
   329→/**
   330→ * Workflow run status
   331→ */
   332→export const WorkflowRunStatusSchema = z.enum([
   333→  "active",
   334→  "paused",
   335→  "completed",
   336→  "aborted",
   337→]);
   338→
   339→/**
   340→ * Workflow run result - distinguishes between different completion types
   341→ */
   342→export const WorkflowRunResultSchema = z.enum([
   343→  "success", // Normal completion through all steps
   344→  "no_work_available", // Graceful exit - no eligible work to process
   345→  "early_exit", // Intentional exit before all steps (not an error)
   346→]);
   347→
   348→/**
   349→ * Workflow run schema - tracks execution of a workflow
   350→ */
   351→export const WorkflowRunSchema = z.object({
   352→  _ulid: UlidSchema,
   353→  workflow_ref: RefSchema,
   354→  status: WorkflowRunStatusSchema,
   355→  current_step: z.number(),
   356→  total_steps: z.number(),
   357→  started_at: DateTimeSchema,
   358→  paused_at: DateTimeSchema.optional(),
   359→  completed_at: DateTimeSchema.optional(),
   360→  step_results: z.array(StepResultSchema).default([]),
   361→  initiated_by: z.string().optional(),
   362→  abort_reason: z.string().optional(),
   363→  task_ref: RefSchema.optional(),
   364→  result: WorkflowRunResultSchema.optional(), // Only set for completed runs
   365→});
   366→
   367→/**
   368→ * Workflow runs file schema - container for all workflow runs
   369→ */
   370→export const WorkflowRunsFileSchema = z.object({
   371→  kynetic_runs: z.string().default("1.0"),
   372→  runs: z.array(WorkflowRunSchema).default([]),
   373→});
   374→
   375→/**
   376→ * Meta manifest schema - the root structure for kynetic.meta.yaml
   377→ */
   378→export const MetaManifestSchema = z.object({
   379→  kynetic_meta: z.string().default("1.0"),
   380→  agents: z.array(AgentSchema).default([]),
   381→  workflows: z.array(WorkflowSchema).default([]),
   382→  conventions: z.array(ConventionSchema).default([]),
   383→  observations: z.array(ObservationSchema).default([]),
   384→  skills: z.array(SkillSchema).default([]),
   385→  includes: z.array(z.string()).default([]),
   386→});
   387→
   388→// Type exports
   389→export type SessionProtocol = z.infer<typeof SessionProtocolSchema>;
   390→export type AgentDispatchEvent = z.infer<typeof AgentDispatchEventSchema>;
   391→export type AgentDispatchFilter = z.infer<typeof AgentDispatchFilterSchema>;
   392→export type AgentDispatchRule = z.infer<typeof AgentDispatchRuleSchema>;
   393→export type AgentBudget = z.infer<typeof AgentBudgetSchema>;
   394→export type AgentConcurrency = z.infer<typeof AgentConcurrencySchema>;
   395→export type Agent = z.infer<typeof AgentSchema>;
   396→export type WorkflowStepType = z.infer<typeof WorkflowStepTypeSchema>;
   397→export type StepExecution = z.infer<typeof StepExecutionSchema>;
   398→export type StepInput = z.infer<typeof StepInputSchema>;
   399→export type WorkflowStep = z.infer<typeof WorkflowStepSchema>;
   400→export type WorkflowMode = z.infer<typeof WorkflowModeSchema>;
   401→export type Workflow = z.infer<typeof WorkflowSchema>;
   402→export type ConventionExample = z.infer<typeof ConventionExampleSchema>;
   403→export type ConventionValidation = z.infer<typeof ConventionValidationSchema>;
   404→export type Convention = z.infer<typeof ConventionSchema>;
   405→export type ObservationType = z.infer<typeof ObservationTypeSchema>;
   406→export type Observation = z.infer<typeof ObservationSchema>;
   407→export type SkillOrigin = z.infer<typeof SkillOriginSchema>;
   408→export type ClaudeCodeConfig = z.infer<typeof ClaudeCodeConfigSchema>;
   409→export type CodexConfig = z.infer<typeof CodexConfigSchema>;
   410→export type PlatformConfig = z.infer<typeof PlatformConfigSchema>;
   411→export type Skill = z.infer<typeof SkillSchema>;
   412→export type SessionContext = z.infer<typeof SessionContextSchema>;
   413→export type MetaManifest = z.infer<typeof MetaManifestSchema>;
   414→export type StepResultStatus = z.infer<typeof StepResultStatusSchema>;
   415→export type StepResult = z.infer<typeof StepResultSchema>;
   416→export type WorkflowRunStatus = z.infer<typeof WorkflowRunStatusSchema>;
   417→export type WorkflowRunResult = z.infer<typeof WorkflowRunResultSchema>;
   418→export type WorkflowRun = z.infer<typeof WorkflowRunSchema>;
   419→export type WorkflowRunsFile = z.infer<typeof WorkflowRunsFileSchema>;
   420→
   421→/**
   422→ * Meta item type - union of all meta item types
   423→ */
   424→export type MetaItem = Agent | Workflow | Convention | Observation | Skill;
   425→
   426→/**
   427→ * Type guard for skill items
   428→ * Uses _type discriminant field for reliable discrimination
   429→ */
   430→export function isSkill(item: MetaItem | unknown): item is Skill {
   431→  return (
   432→    typeof item === "object" &&
   433→    item !== null &&
   434→    "_type" in item &&
   435→    (item as { _type: unknown })._type === "skill"
   436→  );
   437→}
   438→
   439→/**
   440→ * Determine the type of a meta item
   441→ * AC: @skill-meta-type ac-7 - skills discriminated by _type field
   442→ */
   443→export function getMetaItemType(
   444→  item: MetaItem,
   445→): "agent" | "workflow" | "convention" | "observation" | "skill" {
   446→  if (isSkill(item)) return "skill";
   447→  if ("capabilities" in item) return "agent";
   448→  if ("trigger" in item) return "workflow";
   449→  if ("domain" in item) return "convention";
   450→  return "observation";
   451→}
   452→
```