   419→        status: "failed",
   420→        durationMs: 1000,
   421→      });
   422→    });
   423→
   424→    // AC: @ui-session-stream ac-1
   425→    it("marks tool call as failed when isError flag is set", () => {
   426→      const events = [
   427→        {
   428→          ts: 1000,
   429→          seq: 0,
   430→          type: "session.update",
   431→          session_id: "s1",
   432→          data: {
   433→            update: {
