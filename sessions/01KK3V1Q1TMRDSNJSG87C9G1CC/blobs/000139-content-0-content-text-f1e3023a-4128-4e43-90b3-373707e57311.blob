  1745→// ─── Design tokens and accessibility ─────────────────────────────────────────
  1746→
  1747→describe("design tokens and accessibility", () => {
  1748→  it("no raw Tailwind color classes in session components", () => {
  1749→    // Read component sources and verify no raw emerald/red/blue/purple colors
  1750→    const { readFileSync } = require("node:fs");
  1751→    const componentFiles = [
  1752→      "SessionStream.svelte",
  1753→      "ToolCallView.svelte",
  1754→      "ThinkingBlock.svelte",
  1755→      "MessageBlock.svelte",
  1756→      "SystemBlock.svelte",
  1757→      "SessionContextPanel.svelte",
  1758→    ];
  1759→
  1760→    const rawColorPattern =
  1761→      /\b(?:text|bg|border(?:-[lrtb])?)-(?:emerald|red|blue|purple|green|amber|orange|yellow|pink|teal|cyan|indigo|violet|fuchsia|rose|lime|sky)-\d+\b/g;
  1762→
  1763→    for (const file of componentFiles) {
  1764→      const path = join(SESSION_COMPONENTS, file);
  1765→      if (existsSync(path)) {
  1766→        const src = readFileSync(path, "utf-8");
  1767→        const matches = src.match(rawColorPattern);
  1768→        expect(
  1769→          matches,
  1770→          `${file} contains raw Tailwind colors: ${matches?.join(", ")}`,
  1771→        ).toBeNull();
  1772→      }
  1773→    }
  1774→  });
  1775→
  1776→  it("no raw Tailwind color classes in session page", () => {
  1777→    const { readFileSync } = require("node:fs");
  1778→    const pagePath = join(WEB_UI_SRC, "routes", "sessions", "[id]", "+page.svelte");
  1779→    const src = readFileSync(pagePath, "utf-8");
  1780→    const rawColorPattern =
  1781→      /\b(?:text|bg|border(?:-[lrtb])?)-(?:emerald|red|blue|purple|green)-\d+\b/g;
  1782→    const matches = src.match(rawColorPattern);
  1783→    expect(
  1784→      matches,
  1785→      `Session page contains raw Tailwind colors: ${matches?.join(", ")}`,
  1786→    ).toBeNull();
  1787→  });
  1788→
  1789→  it("session stream has aria-live and role=log for screen readers", () => {
  1790→    const { readFileSync } = require("node:fs");
  1791→    const src = readFileSync(
  1792→      join(SESSION_COMPONENTS, "SessionStream.svelte"),
  1793→      "utf-8",
  1794→    );
  1795→    // Verify the stream container has accessibility attributes
  1796→    expect(src).toContain("aria-live");
  1797→    expect(src).toContain('role="log"');
  1798→  });
  1799→
  1800→  it("animations are gated behind prefers-reduced-motion", () => {
  1801→    const { readFileSync } = require("node:fs");
  1802→    const animatedFiles = [
  1803→      "SessionStream.svelte",
  1804→      "ToolCallView.svelte",
  1805→      "SessionContextPanel.svelte",
  1806→    ];
  1807→
  1808→    for (const file of animatedFiles) {
  1809→      const path = join(SESSION_COMPONENTS, file);
  1810→      if (existsSync(path)) {
  1811→        const src = readFileSync(path, "utf-8");
  1812→        // If file has @keyframes, it should also have prefers-reduced-motion
  1813→        if (src.includes("@keyframes")) {
  1814→          expect(
  1815→            src,
  1816→            `${file} has animations but missing prefers-reduced-motion media query`,
  1817→          ).toContain("prefers-reduced-motion");
  1818→        }
  1819→      }
  1820→    }
  1821→  });
  1822→});
