  1600→        ended_at: "2026-01-01T01:00:00Z",
  1601→        duration_ms: 3600000,
  1602→        event_count: 50,
  1603→        iteration_count: 3,
  1604→        tasks_completed: 1,
  1605→        spec_context: {
  1606→          spec_ref: "@ui-session-stream",
  1607→          title: "Session Stream View",
  1608→          acceptance_criteria: [
  1609→            { id: "ac-1", description: "Structured blocks" },
  1610→            { id: "ac-2", description: "Live streaming" },
