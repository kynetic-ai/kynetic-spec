   835→  describe("parseEventsToBlocks — complex multi-event sequences", () => {
   836→    // AC: @ui-session-stream ac-1
   837→    it("produces correct block sequence for a realistic agent session", () => {
   838→      const events = [
   839→        { ts: 1000, seq: 0, type: "session.start", session_id: "s1", data: { agent_type: "worker" } },
   840→        { ts: 1100, seq: 1, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "thinking", text: "Planning..." } } },
   841→        { ts: 1200, seq: 2, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "assistant_text", text: "I'll read the file." } } },
   842→        { ts: 1300, seq: 3, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_call", toolCallId: "r1", tool: "Read", rawInput: { file_path: "/src/main.ts" } } } },
   843→        { ts: 1800, seq: 4, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_result", toolCallId: "r1", output: "export function main() {}" } } },
   844→        { ts: 1900, seq: 5, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "assistant_text", text: "Now editing." } } },
   845→        { ts: 2000, seq: 6, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_call", toolCallId: "e1", tool: "Edit", rawInput: { file_path: "/src/main.ts", old_string: "main", new_string: "start" } } } },
   846→        { ts: 2500, seq: 7, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_result", toolCallId: "e1", output: "OK" } } },
   847→        { ts: 3000, seq: 8, type: "session.end", session_id: "s1", data: { reason: "completed" } },
   848→      ];
   849→
   850→      const blocks = parseEventsToBlocks(events);
   851→
   852→      // Expected sequence: system, thinking, message, tool_call(Read), message, tool_call(Edit), system
   853→      expect(blocks.map((b) => b.type)).toEqual([
   854→        "system",
   855→        "thinking",
   856→        "message",
   857→        "tool_call",
   858→        "message",
   859→        "tool_call",
   860→        "system",
   861→      ]);
   862→
   863→      // Verify tool calls resolved correctly
   864→      const toolCalls = blocks.filter((b) => b.type === "tool_call");
   865→      expect(toolCalls[0]).toMatchObject({
   866→        type: "tool_call",
   867→        toolName: "Read",
   868→        status: "completed",
   869→        durationMs: 500,
   870→      });
   871→      expect(toolCalls[1]).toMatchObject({
   872→        type: "tool_call",
   873→        toolName: "Edit",
   874→        status: "completed",
   875→        durationMs: 500,
   876→      });
   877→    });
   878→  });
   879→
   880→  describe("parseEventsToBlocks — ACP format multi-event sequence", () => {
   881→    // AC: @ui-session-stream ac-1
   882→    it("produces correct block sequence for an ACP-format agent session", () => {
   883→      const events = [
   884→        { ts: 1000, seq: 0, type: "session.start", session_id: "s1", data: { agent_type: "worker" } },
   885→        { ts: 1100, seq: 1, type: "session.update", session_id: "s1", data: { sessionUpdate: "agent_thought_chunk", content: { type: "text", text: "Planning..." } } },
   886→        { ts: 1200, seq: 2, type: "session.update", session_id: "s1", data: { sessionUpdate: "agent_message_chunk", content: { type: "text", text: "I'll read the file." } } },
   887→        { ts: 1300, seq: 3, type: "session.update", session_id: "s1", data: { sessionUpdate: "tool_call", toolCallId: "r1", title: "Read", rawInput: { file_path: "/src/main.ts" } } },
   888→        { ts: 1800, seq: 4, type: "session.update", session_id: "s1", data: { sessionUpdate: "tool_call_update", toolCallId: "r1", status: "completed", rawOutput: "export function main() {}" } },
   889→        { ts: 1900, seq: 5, type: "session.update", session_id: "s1", data: { sessionUpdate: "agent_message_chunk", content: { type: "text", text: "Now editing." } } },
   890→        { ts: 2000, seq: 6, type: "session.update", session_id: "s1", data: { sessionUpdate: "tool_call", toolCallId: "e1", title: "Edit", rawInput: { file_path: "/src/main.ts", old_string: "main", new_string: "start" } } },
   891→        { ts: 2500, seq: 7, type: "session.update", session_id: "s1", data: { sessionUpdate: "tool_call_update", toolCallId: "e1", status: "completed", rawOutput: "OK" } },
   892→        { ts: 3000, seq: 8, type: "session.end", session_id: "s1", data: { reason: "completed" } },
   893→      ];
   894→
   895→      const blocks = parseEventsToBlocks(events);
   896→
   897→      // Expected sequence: system, thinking, message, tool_call(Read), message, tool_call(Edit), system
   898→      expect(blocks.map((b) => b.type)).toEqual([
   899→        "system",
   900→        "thinking",
   901→        "message",
   902→        "tool_call",
   903→        "message",
   904→        "tool_call",
   905→        "system",
   906→      ]);
   907→
   908→      // Verify thinking block
   909→      if (blocks[1].type === "thinking") {
   910→        expect(blocks[1].content).toBe("Planning...");
   911→      }
   912→
   913→      // Verify message blocks
   914→      if (blocks[2].type === "message") {
   915→        expect(blocks[2].content).toBe("I'll read the file.");
   916→      }
   917→      if (blocks[4].type === "message") {
   918→        expect(blocks[4].content).toBe("Now editing.");
   919→      }
   920→
   921→      // Verify tool calls resolved correctly
   922→      const toolCalls = blocks.filter((b) => b.type === "tool_call");
   923→      expect(toolCalls[0]).toMatchObject({
   924→        type: "tool_call",
   925→        toolName: "Read",
   926→        status: "completed",
   927→        durationMs: 500,
   928→      });
   929→      expect(toolCalls[1]).toMatchObject({
   930→        type: "tool_call",
   931→        toolName: "Edit",
   932→        status: "completed",
   933→        durationMs: 500,
   934→      });
   935→    });
   936→  });
