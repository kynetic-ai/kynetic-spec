   398→            },
   399→          },
   400→        },
   401→        {
   402→          ts: 2000,
   403→          seq: 1,
   404→          type: "session.update",
   405→          session_id: "s1",
   406→          data: {
   407→            update: {
   408→              sessionUpdate: "tool_result",
   409→              toolCallId: "tc-err",
   410→              output: "exit code 1",
