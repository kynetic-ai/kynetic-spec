   622→  describe("parseEventsToBlocks — thinking blocks", () => {
   623→    // AC: @ui-session-stream ac-1
   624→    it("parses thinking events as thinking blocks", () => {
   625→      const events = [
   626→        {
   627→          ts: 1000,
   628→          seq: 0,
   629→          type: "session.update",
   630→          session_id: "s1",
   631→          data: {
   632→            update: { sessionUpdate: "thinking", text: "Let me think..." },
   633→          },
   634→        },
   635→      ];
   636→      const blocks = parseEventsToBlocks(events);
   637→      expect(blocks).toHaveLength(1);
   638→      expect(blocks[0]).toMatchObject({
   639→        type: "thinking",
   640→        content: "Let me think...",
   641→        timestamp: 1000,
   642→      });
   643→    });
   644→
   645→    // AC: @ui-session-stream ac-1
   646→    it("parses assistant_thinking variant", () => {
   647→      const events = [
   648→        {
   649→          ts: 1000,
   650→          seq: 0,
   651→          type: "session.update",
   652→          session_id: "s1",
   653→          data: {
   654→            update: { sessionUpdate: "assistant_thinking", text: "Considering..." },
   655→          },
