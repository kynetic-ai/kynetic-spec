   337→  describe("parseEventsToBlocks — tool call blocks", () => {
   338→    // AC: @ui-session-stream ac-1
   339→    it("creates tool call block with running status and resolves on result", () => {
   340→      const events = [
   341→        {
   342→          ts: 1000,
   343→          seq: 0,
   344→          type: "session.update",
   345→          session_id: "s1",
   346→          data: {
   347→            update: {
   348→              sessionUpdate: "tool_call",
   349→              toolCallId: "tc-1",
   350→              tool: "Bash",
   351→              rawInput: { command: "ls" },
   352→            },
   353→          },
   354→        },
   355→        {
   356→          ts: 2500,
   357→          seq: 1,
   358→          type: "session.update",
   359→          session_id: "s1",
   360→          data: {
   361→            update: {
   362→              sessionUpdate: "tool_result",
   363→              toolCallId: "tc-1",
   364→              output: "file.txt\ndir/",
   365→            },
   366→          },
   367→        },
   368→      ];
   369→      const blocks = parseEventsToBlocks(events);
   370→      expect(blocks).toHaveLength(1);
   371→      expect(blocks[0]).toMatchObject({
   372→        type: "tool_call",
   373→        toolName: "Bash",
   374→        toolCallId: "tc-1",
   375→        input: { command: "ls" },
   376→        output: "file.txt\ndir/",
   377→        status: "completed",
   378→        durationMs: 1500,
   379→        startedAt: 1000,
   380→        completedAt: 2500,
   381→      });
   382→    });
   383→
   384→    // AC: @ui-session-stream ac-1
   385→    it("marks tool call as failed when error flag is set", () => {
   386→      const events = [
   387→        {
   388→          ts: 1000,
   389→          seq: 0,
   390→          type: "session.update",
   391→          session_id: "s1",
   392→          data: {
   393→            update: {
   394→              sessionUpdate: "tool_call",
