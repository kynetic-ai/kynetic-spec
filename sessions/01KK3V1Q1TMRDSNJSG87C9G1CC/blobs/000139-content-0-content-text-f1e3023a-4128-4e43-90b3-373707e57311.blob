  1155→// ─── AC-2: Live streaming ────────────────────────────────────────────────────
  1156→
  1157→// AC: @ui-session-stream ac-2
  1158→describe("live streaming logic (@ui-session-stream ac-2)", () => {
  1159→  describe("incremental event loading via parseEventsToBlocks", () => {
  1160→    // AC: @ui-session-stream ac-2
  1161→    it("parseEventsToBlocks handles incremental event appending", () => {
  1162→      // Simulate first load
  1163→      const batch1 = [
  1164→        { ts: 1000, seq: 0, type: "session.start", session_id: "s1", data: { agent_type: "worker" } },
  1165→        { ts: 1100, seq: 1, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "assistant_text", text: "Hello" } } },
  1166→      ];
  1167→      let allEvents = [...batch1];
  1168→      let blocks = parseEventsToBlocks(allEvents);
  1169→      expect(blocks).toHaveLength(2);
  1170→      expect(blocks[1]).toMatchObject({ type: "message", content: "Hello" });
  1171→
  1172→      // Simulate incremental refresh (new events appended)
  1173→      const batch2 = [
  1174→        { ts: 1200, seq: 2, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_call", toolCallId: "tc1", tool: "Bash", rawInput: { command: "echo test" } } } },
  1175→        { ts: 1500, seq: 3, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_result", toolCallId: "tc1", output: "test" } } },
  1176→      ];
  1177→      allEvents = [...allEvents, ...batch2];
  1178→      blocks = parseEventsToBlocks(allEvents);
  1179→      expect(blocks).toHaveLength(3);
  1180→      expect(blocks.map((b) => b.type)).toEqual(["system", "message", "tool_call"]);
  1181→
  1182→      // Verify the tool call resolved
  1183→      if (blocks[2].type === "tool_call") {
  1184→        expect(blocks[2].status).toBe("completed");
  1185→        expect(blocks[2].durationMs).toBe(300);
  1186→      }
  1187→    });
  1188→  });
  1189→
