   282→    // AC: @ui-session-stream ac-1
   283→    it("parses ACP agent_message_chunk (direct data format) as message block", () => {
   284→      const events = [
   285→        {
   286→          ts: 1000,
   287→          seq: 0,
   288→          type: "session.update",
