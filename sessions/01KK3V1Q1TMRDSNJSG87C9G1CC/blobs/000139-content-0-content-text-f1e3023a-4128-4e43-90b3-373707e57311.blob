  1368→    });
  1369→
  1370→    // AC: @ui-session-stream ac-3
  1371→    it("hides button when not auto-scrolling but no content", () => {
  1372→      expect(shouldShowJumpButton(false, false, 0)).toBe(false);
  1373→    });
  1374→  });
  1375→});
