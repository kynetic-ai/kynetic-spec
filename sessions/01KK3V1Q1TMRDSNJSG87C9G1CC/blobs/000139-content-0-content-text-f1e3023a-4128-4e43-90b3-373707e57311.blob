  1569→  describe("extractFilesChanged integrated with parseEventsToBlocks", () => {
  1570→    // AC: @ui-session-stream ac-4
  1571→    it("end-to-end: parse events then extract files changed", () => {
  1572→      const events = [
  1573→        { ts: 1000, seq: 0, type: "session.start", session_id: "s1", data: { agent_type: "worker" } },
  1574→        { ts: 1100, seq: 1, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_call", toolCallId: "r1", tool: "Read", rawInput: { file_path: "/src/old.ts" } } } },
  1575→        { ts: 1200, seq: 2, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_result", toolCallId: "r1", output: "content" } } },
  1576→        { ts: 1300, seq: 3, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_call", toolCallId: "e1", tool: "Edit", rawInput: { file_path: "/src/old.ts", old_string: "a", new_string: "b" } } } },
  1577→        { ts: 1400, seq: 4, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_result", toolCallId: "e1", output: "OK" } } },
  1578→        { ts: 1500, seq: 5, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_call", toolCallId: "w1", tool: "Write", rawInput: { file_path: "/src/new.ts" } } } },
  1579→        { ts: 1600, seq: 6, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_result", toolCallId: "w1", output: "OK" } } },
  1580→      ];
  1581→
  1582→      const blocks = parseEventsToBlocks(events);
  1583→      const files = extractFilesChanged(blocks);
  1584→
  1585→      // Read should be excluded, Edit and Write should be included
  1586→      expect(files).toEqual(["/src/new.ts", "/src/old.ts"]);
  1587→    });
  1588→  });
