  1643→
  1644→    // AC: @ui-session-stream ac-4
  1645→    it("budget progress calculation is correct", () => {
  1646→      // The context panel displays a progress bar: (started / max) * 100
  1647→      const budget = { max_per_cycle: 10, started_this_cycle: 3 };
  1648→      const progress = Math.min(
  1649→        100,
  1650→        (budget.started_this_cycle / budget.max_per_cycle) * 100,
  1651→      );
  1652→      expect(progress).toBe(30);
  1653→
  1654→      // Capped at 100% even if over budget
  1655→      const overBudget = { max_per_cycle: 5, started_this_cycle: 8 };
  1656→      const cappedProgress = Math.min(
  1657→        100,
  1658→        (overBudget.started_this_cycle / overBudget.max_per_cycle) * 100,
  1659→      );
  1660→      expect(cappedProgress).toBe(100);
  1661→    });
  1662→  });
  1663→});
