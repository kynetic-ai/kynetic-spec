  1294→// AC: @ui-session-stream ac-3
  1295→describe("auto-scroll behavior (@ui-session-stream ac-3)", () => {
  1296→  describe("computeScrollDistance — distance from bottom calculation", () => {
  1297→    // AC: @ui-session-stream ac-3
  1298→    it("returns 0 when scrolled to bottom", () => {
  1299→      // scrollTop = scrollHeight - clientHeight means at bottom
  1300→      expect(computeScrollDistance(1000, 600, 400)).toBe(0);
  1301→    });
  1302→
  1303→    // AC: @ui-session-stream ac-3
  1304→    it("returns positive distance when scrolled up", () => {
  1305→      expect(computeScrollDistance(1000, 550, 400)).toBe(50);
  1306→      expect(computeScrollDistance(1000, 400, 400)).toBe(200);
  1307→    });
  1308→
  1309→    // AC: @ui-session-stream ac-3
  1310→    it("handles edge case of content shorter than viewport", () => {
  1311→      // scrollHeight <= clientHeight: can't scroll
  1312→      expect(computeScrollDistance(400, 0, 400)).toBe(0);
  1313→    });
  1314→  });
  1315→
  1316→  describe("shouldAutoScroll — threshold-based auto-scroll detection", () => {
  1317→    // AC: @ui-session-stream ac-3
  1318→    it("threshold is 100px", () => {
  1319→      expect(AUTO_SCROLL_THRESHOLD).toBe(100);
  1320→    });
  1321→
  1322→    // AC: @ui-session-stream ac-3
  1323→    it("returns true when at bottom (0px from bottom)", () => {
  1324→      expect(shouldAutoScrollFn(1000, 600, 400)).toBe(true);
  1325→    });
  1326→
  1327→    // AC: @ui-session-stream ac-3
  1328→    it("returns true when within threshold (50px from bottom)", () => {
  1329→      expect(shouldAutoScrollFn(1000, 550, 400)).toBe(true);
  1330→    });
  1331→
  1332→    // AC: @ui-session-stream ac-3
  1333→    it("returns true at exactly the threshold (100px from bottom — spec says >100px pauses)", () => {
  1334→      expect(shouldAutoScrollFn(1000, 500, 400)).toBe(true);
  1335→    });
  1336→
  1337→    // AC: @ui-session-stream ac-3
  1338→    it("returns false just beyond the threshold (101px from bottom)", () => {
  1339→      expect(shouldAutoScrollFn(1000, 499, 400)).toBe(false);
  1340→    });
  1341→
  1342→    // AC: @ui-session-stream ac-3
  1343→    it("returns false when scrolled well above threshold (200px from bottom)", () => {
  1344→      expect(shouldAutoScrollFn(1000, 400, 400)).toBe(false);
  1345→    });
  1346→
  1347→    // AC: @ui-session-stream ac-3
  1348→    it("returns true when content fits in viewport (no scrolling needed)", () => {
  1349→      expect(shouldAutoScrollFn(400, 0, 400)).toBe(true);
  1350→    });
  1351→  });
  1352→
  1353→  describe("shouldShowJumpButton — button visibility logic", () => {
  1354→    // AC: @ui-session-stream ac-3
  1355→    it("hides button when auto-scrolling (regardless of content)", () => {
