  1612→        },
  1613→        budget: {
  1614→          max_per_cycle: 10,
  1615→          started_this_cycle: 3,
  1616→        },
  1617→      };
  1618→
  1619→      // Verify spec context
  1620→      expect(session.spec_context).toBeDefined();
  1621→      expect(session.spec_context!.spec_ref).toBe("@ui-session-stream");
  1622→      expect(session.spec_context!.title).toBe("Session Stream View");
  1623→      expect(session.spec_context!.acceptance_criteria).toHaveLength(2);
  1624→      expect(session.spec_context!.acceptance_criteria[0].id).toBe("ac-1");
  1625→
  1626→      // Verify budget
  1627→      expect(session.budget).toBeDefined();
  1628→      expect(session.budget!.max_per_cycle).toBe(10);
  1629→      expect(session.budget!.started_this_cycle).toBe(3);
