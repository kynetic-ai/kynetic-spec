  1631→
  1632→    // AC: @ui-session-stream ac-4
  1633→    it("spec_context and budget can be null/undefined", () => {
  1634→      const session = {
  1635→        id: "s2",
  1636→        status: "active" as const,
  1637→        spec_context: null,
