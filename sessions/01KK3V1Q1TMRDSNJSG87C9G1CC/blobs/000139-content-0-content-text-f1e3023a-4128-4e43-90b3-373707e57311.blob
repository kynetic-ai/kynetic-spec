  1665→// ─── AC-5: Collapsed tool call row single-line layout ────────────────────────
  1666→
  1667→// AC: @ui-session-stream ac-5
  1668→describe("collapsed tool call row layout (@ui-session-stream ac-5)", () => {
  1669→  let toolCallSrc: string;
  1670→
  1671→  beforeAll(() => {
  1672→    const { readFileSync } = require("node:fs");
  1673→    toolCallSrc = readFileSync(
  1674→      join(SESSION_COMPONENTS, "ToolCallView.svelte"),
  1675→      "utf-8",
  1676→    );
  1677→  });
  1678→
  1679→  // AC: @ui-session-stream ac-5
  1680→  it("header button uses overflow-hidden to enforce single-line", () => {
  1681→    // The collapsed row button must clip overflow to prevent multi-line wrapping
  1682→    expect(toolCallSrc).toMatch(/class="[^"]*overflow-hidden[^"]*"/);
  1683→  });
  1684→
  1685→  // AC: @ui-session-stream ac-5
  1686→  it("chevron, timestamp, and duration are flex-shrink-0 (never hidden)", () => {
  1687→    // ChevronRight component has flex-shrink-0
  1688→    expect(toolCallSrc).toMatch(/ChevronRight[\s\S]*?flex-shrink-0/);
  1689→    // Timestamp span has flex-shrink-0
  1690→    expect(toolCallSrc).toMatch(/formatTime[\s\S]*?flex-shrink-0/);
  1691→    // Duration span has flex-shrink-0
  1692→    expect(toolCallSrc).toMatch(/formatDuration[\s\S]*?flex-shrink-0/);
  1693→  });
  1694→
  1695→  // AC: @ui-session-stream ac-5
  1696→  it("status icons are flex-shrink-0 (never hidden)", () => {
  1697→    // Each status icon (Loader, Check, X) must have flex-shrink-0
  1698→    expect(toolCallSrc).toMatch(/Loader[\s\S]*?flex-shrink-0/);
  1699→    expect(toolCallSrc).toMatch(/Check[\s\S]*?flex-shrink-0/);
  1700→    expect(toolCallSrc).toMatch(/<X[\s\S]*?flex-shrink-0/);
  1701→  });
  1702→
  1703→  // AC: @ui-session-stream ac-5
  1704→  it("tool name badge allows truncation (not flex-shrink-0)", () => {
  1705→    // The tool name badge must use min-w-0 to allow flex shrinking
  1706→    // and must NOT be flex-shrink-0 (which would prevent truncation)
  1707→    const badgeMatch = toolCallSrc.match(
  1708→      /class="[^"]*font-mono bg-secondary[^"]*"/,
  1709→    );
  1710→    expect(badgeMatch).not.toBeNull();
  1711→    const badgeClasses = badgeMatch![0];
  1712→    expect(badgeClasses).toContain("min-w-0");
  1713→    expect(badgeClasses).not.toContain("flex-shrink-0");
  1714→  });
  1715→
  1716→  // AC: @ui-session-stream ac-5
  1717→  it("tool name text inside badge uses truncate class", () => {
  1718→    // The inner span containing block.toolName must have truncate for ellipsis
  1719→    expect(toolCallSrc).toMatch(/class="truncate">\{block\.toolName\}/);
  1720→  });
  1721→
  1722→  // AC: @ui-session-stream ac-5
  1723→  it("preview span uses truncate with min-w-0", () => {
  1724→    // Parameter preview should truncate, not wrap
  1725→    expect(toolCallSrc).toMatch(/class="[^"]*truncate[^"]*min-w-0[^"]*"/);
  1726→  });
  1727→});
