   413→		test('dispatched filter shows only dispatched sessions', async ({ page, daemon }) => {
   414→			await page.route('**/api/sessions', (route) => {
   415→				route.fulfill({
   416→					status: 200,
   417→					contentType: 'application/json',
   418→					body: JSON.stringify(mockSessions()),
   419→				});
   420→			});
   421→
   422→			await page.goto('/sessions');
   423→			await expect(page.getByTestId('sessions-list')).toBeVisible();
   424→
   425→			await page.getByTestId('trigger-filter').getByText('Dispatched').click();
   426→
   427→			const rows = page.getByTestId('session-row');
   428→			await expect(rows).toHaveCount(2);
   429→			// Only dispatched sessions remain (task.ready and task.pending_review)
   430→			await expect(rows.nth(0)).toHaveAttribute('data-session-id', '01JTEST0000000000000000001');
   431→			await expect(rows.nth(1)).toHaveAttribute('data-session-id', '01JTEST0000000000000000002');
   432→		});
   433→
