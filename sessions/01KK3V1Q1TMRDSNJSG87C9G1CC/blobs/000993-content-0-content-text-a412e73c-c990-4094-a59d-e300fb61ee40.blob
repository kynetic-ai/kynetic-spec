   174→
   175→			await page.goto('/sessions');
   176→			await expect(page.getByTestId('sessions-list')).toBeVisible();
   177→
   178→			const durations = page.getByTestId('session-duration');
   179→			await expect(durations).toHaveCount(3);
   180→			// 5400000ms = 1h 30m
