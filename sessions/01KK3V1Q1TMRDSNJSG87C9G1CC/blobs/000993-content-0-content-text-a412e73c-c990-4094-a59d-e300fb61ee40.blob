   398→					contentType: 'application/json',
   399→					body: JSON.stringify(mockSessions()),
   400→				});
   401→			});
   402→
   403→			await page.goto('/sessions');
   404→			await expect(page.getByTestId('sessions-list')).toBeVisible();
   405→
   406→			const filter = page.getByTestId('trigger-filter');
   407→			await expect(filter).toBeVisible();
   408→			await expect(filter.getByText('All')).toBeVisible();
   409→			await expect(filter.getByText('Manual')).toBeVisible();
   410→			await expect(filter.getByText('Dispatched')).toBeVisible();
