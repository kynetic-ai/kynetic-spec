   203→		});
   204→
   205→		// AC: @ui-session-history ac-1 — Sorted by most recent first
   206→		test('sessions are sorted by most recent first', async ({ page, daemon }) => {
   207→			// Provide mock data in most-recent-first order (as daemon would return).
   208→			// Session 2 (Mar 5) > Session 1 (Mar 4) > Session 3 (Mar 3).
   209→			const sorted = mockSessions();
   210→			sorted.items = [sorted.items[1], sorted.items[0], sorted.items[2]];
   211→
   212→			await page.route('**/api/sessions', (route) => {
   213→				route.fulfill({
   214→					status: 200,
   215→					contentType: 'application/json',
   216→					body: JSON.stringify(sorted),
   217→				});
   218→			});
   219→
   220→			await page.goto('/sessions');
   221→			await expect(page.getByTestId('sessions-list')).toBeVisible();
   222→
   223→			// Verify rendered order matches daemon's most-recent-first sort:
   224→			// First row = session 2 (Mar 5), second = session 1 (Mar 4), third = session 3 (Mar 3)
   225→			const rows = page.getByTestId('session-row');
   226→			await expect(rows.nth(0)).toHaveAttribute('data-session-id', '01JTEST0000000000000000002');
   227→			await expect(rows.nth(1)).toHaveAttribute('data-session-id', '01JTEST0000000000000000001');
   228→			await expect(rows.nth(2)).toHaveAttribute('data-session-id', '01JTEST0000000000000000003');
   229→		});
   230→	});
