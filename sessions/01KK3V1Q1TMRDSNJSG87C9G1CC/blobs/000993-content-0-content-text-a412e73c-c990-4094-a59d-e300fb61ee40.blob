   164→
   165→		// AC: @ui-session-history ac-1 — Duration displayed
   166→		test('shows duration for each row', async ({ page, daemon }) => {
   167→			await page.route('**/api/sessions', (route) => {
   168→				route.fulfill({
   169→					status: 200,
   170→					contentType: 'application/json',
