   183→
   184→		// AC: @ui-session-history ac-1 — Age displayed
   185→		test('shows age for each row', async ({ page, daemon }) => {
   186→			await page.route('**/api/sessions', (route) => {
   187→				route.fulfill({
   188→					status: 200,
   189→					contentType: 'application/json',
   190→					body: JSON.stringify(mockSessions()),
   191→				});
