   232→	test.describe('Session Navigation (AC-2)', () => {
   233→		// AC: @ui-session-history ac-2
   234→		test('clicking a session navigates to /sessions/:id and shows stream view', async ({ page, daemon }) => {
   235→			const sessionDetail = mockSessions().items[0];
   236→
   237→			// Register routes from least-specific to most-specific.
   238→			// Playwright checks LIFO, so the last-registered (most specific) is checked first.
   239→
   240→			// 1. Session list: /api/sessions
   241→			await page.route('**/api/sessions', (route) => {
   242→				route.fulfill({
   243→					status: 200,
   244→					contentType: 'application/json',
   245→					body: JSON.stringify(mockSessions()),
   246→				});
   247→			});
   248→
   249→			// 2. Session detail: /api/sessions/:id
   250→			await page.route('**/api/sessions/01JTEST0000000000000000001', (route) => {
   251→				route.fulfill({
   252→					status: 200,
   253→					contentType: 'application/json',
   254→					body: JSON.stringify(sessionDetail),
   255→				});
   256→			});
   257→
   258→			// 3. Session events: /api/sessions/:id/events
   259→			await page.route('**/api/sessions/01JTEST0000000000000000001/events', (route) => {
   260→				route.fulfill({
   261→					status: 200,
   262→					contentType: 'application/json',
   263→					body: JSON.stringify({ events: [], total: 0 }),
   264→				});
   265→			});
   266→
   267→			await page.goto('/sessions');
   268→			await expect(page.getByTestId('sessions-list')).toBeVisible();
   269→
   270→			const firstRow = page.getByTestId('session-row').first();
   271→			await firstRow.click();
   272→
   273→			// Verify navigation to session detail URL
   274→			await expect(page).toHaveURL(/\/sessions\/01JTEST0000000000000000001/);
   275→
   276→			// Verify session stream view renders (not just URL change)
   277→			await expect(page.getByTestId('session-stream')).toBeVisible({ timeout: 5000 });
   278→		});
   279→
   280→		// AC: @ui-session-history ac-2
   281→		test('session row links point to correct detail URL', async ({ page, daemon }) => {
   282→			await page.route('**/api/sessions', (route) => {
   283→				route.fulfill({
   284→					status: 200,
   285→					contentType: 'application/json',
