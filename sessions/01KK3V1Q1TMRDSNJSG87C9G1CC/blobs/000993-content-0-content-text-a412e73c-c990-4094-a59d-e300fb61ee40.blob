   145→
   146→		// AC: @ui-session-history ac-1 — Task ref displayed when present
   147→		test('shows task ref when session has a task_id', async ({ page, daemon }) => {
   148→			await page.route('**/api/sessions', (route) => {
   149→				route.fulfill({
   150→					status: 200,
   151→					contentType: 'application/json',
   152→					body: JSON.stringify(mockSessions()),
   153→				});
   154→			});
   155→
   156→			await page.goto('/sessions');
   157→			await expect(page.getByTestId('sessions-list')).toBeVisible();
   158→
   159→			// Sessions with task_id should show task ref
