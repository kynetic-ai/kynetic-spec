     1→/**
     2→ * E2E Tests for Session History View
     3→ *
     4→ * Tests verify the /sessions page renders session list with required metadata
     5→ * and navigates to session detail on click.
     6→ *
     7→ * Covered ACs:
     8→ * - @ui-session-history ac-1: Session list shows ID, agent type, task ref, status, duration, age
     9→ * - @ui-session-history ac-2: Click navigates to /sessions/:id
    10→ */
    11→
    12→import { test, expect } from '../fixtures/test-base';
    13→
    14→/** Mock session data for API interception. */
    15→function mockSessions() {
    16→	return {
    17→		items: [
    18→			{
    19→				id: '01JTEST0000000000000000001',
    20→				status: 'completed',
    21→				agent_type: 'task-worker',
    22→				session_type: 'invocation',
    23→				trigger: 'task.ready',
    24→				task_id: '01JTASK0000000000000000001',
    25→				started_at: '2026-03-04T10:00:00.000Z',
    26→				ended_at: '2026-03-04T11:30:00.000Z',
    27→				duration_ms: 5400000,
    28→				event_count: 42,
    29→				iteration_count: 3,
    30→				tasks_completed: 1,
    31→			},
    32→			{
    33→				id: '01JTEST0000000000000000002',
    34→				status: 'active',
    35→				agent_type: 'pr-reviewer',
    36→				session_type: 'invocation',
    37→				trigger: 'task.pending_review',
    38→				task_id: '01JTASK0000000000000000002',
    39→				started_at: '2026-03-05T08:00:00.000Z',
    40→				duration_ms: 60000,
    41→				event_count: 10,
    42→				iteration_count: 1,
    43→				tasks_completed: 0,
    44→			},
    45→			{
    46→				id: '01JTEST0000000000000000003',
    47→				status: 'failed',
    48→				agent_type: 'task-worker',
    49→				session_type: 'loop',
    50→				trigger: 'manual',
    51→				started_at: '2026-03-03T14:00:00.000Z',
    52→				ended_at: '2026-03-03T14:05:00.000Z',
    53→				duration_ms: 300000,
    54→				event_count: 5,
    55→				iteration_count: 0,
    56→				tasks_completed: 0,
    57→			},
    58→		],
    59→		total: 3,
    60→	};
    61→}
    62→
    63→test.describe('Session History View', () => {
    64→	test.describe('Session List (AC-1)', () => {
    65→		// AC: @ui-session-history ac-1
    66→		test('shows session list with required metadata fields', async ({ page, daemon }) => {
    67→			await page.route('**/api/sessions', (route) => {
    68→				route.fulfill({
    69→					status: 200,
    70→					contentType: 'application/json',
    71→					body: JSON.stringify(mockSessions()),
    72→				});
    73→			});
    74→
    75→			await page.goto('/sessions');
    76→
    77→			const list = page.getByTestId('sessions-list');
    78→			await expect(list).toBeVisible();
    79→
    80→			const rows = page.getByTestId('session-row');
    81→			await expect(rows).toHaveCount(3);
    82→		});
    83→
    84→		// AC: @ui-session-history ac-1 — Status badge visible
    85→		test('shows status badge for each session', async ({ page, daemon }) => {
    86→			await page.route('**/api/sessions', (route) => {
    87→				route.fulfill({
    88→					status: 200,
    89→					contentType: 'application/json',
    90→					body: JSON.stringify(mockSessions()),
    91→				});
    92→			});
    93→
    94→			await page.goto('/sessions');
    95→			await expect(page.getByTestId('sessions-list')).toBeVisible();
    96→
    97→			// Check status badges are visible with correct text
    98→			const rows = page.getByTestId('session-row');
    99→			const firstRow = rows.nth(0);
   100→			await expect(firstRow).toContainText('completed');
   101→
   102→			const secondRow = rows.nth(1);
   103→			await expect(secondRow).toContainText('active');
   104→
   105→			const thirdRow = rows.nth(2);
   106→			await expect(thirdRow).toContainText('failed');
   107→		});
   108→
   109→		// AC: @ui-session-history ac-1 — Session ID displayed
   110→		test('shows session ID for each row', async ({ page, daemon }) => {
   111→			await page.route('**/api/sessions', (route) => {
   112→				route.fulfill({
   113→					status: 200,
   114→					contentType: 'application/json',
   115→					body: JSON.stringify(mockSessions()),
   116→				});
   117→			});
   118→
   119→			await page.goto('/sessions');
   120→			await expect(page.getByTestId('sessions-list')).toBeVisible();
   121→
   122→			const ids = page.getByTestId('session-id');
   123→			await expect(ids).toHaveCount(3);
   124→			// First 8 chars of the ULID
   125→			await expect(ids.nth(0)).toContainText('01JTEST0');
   126→		});
   127→
   128→		// AC: @ui-session-history ac-1 — Agent type displayed
   129→		test('shows agent type for each row', async ({ page, daemon }) => {
   130→			await page.route('**/api/sessions', (route) => {
   131→				route.fulfill({
   132→					status: 200,
   133→					contentType: 'application/json',
   134→					body: JSON.stringify(mockSessions()),
   135→				});
   136→			});
   137→
   138→			await page.goto('/sessions');
   139→			await expect(page.getByTestId('sessions-list')).toBeVisible();
