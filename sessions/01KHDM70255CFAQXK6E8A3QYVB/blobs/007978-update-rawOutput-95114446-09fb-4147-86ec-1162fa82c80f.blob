     1→import chalk from "chalk";
     2→import type { Command } from "commander";
     3→import { markMutating } from "../command-annotations.js";
     4→import {
     5→  type AnyLoadedItem,
     6→  buildIndexes,
     7→  initContext,
     8→  type LoadedMetaItem,
     9→  type LoadedSpecItem,
    10→  updateSpecItem,
    11→} from "../../parser/index.js";
    12→import { commitIfShadow } from "../../parser/shadow.js";
    13→import { errors } from "../../strings/errors.js";
    14→import { EXIT_CODES } from "../exit-codes.js";
    15→import { error, output, success, warn } from "../output.js";
    16→
    17→/**
    18→ * Valid relationship types
    19→ */
    20→const RELATIONSHIP_TYPES = ["depends_on", "implements", "relates_to"] as const;
    21→type RelationshipType = (typeof RELATIONSHIP_TYPES)[number];
    22→
    23→/**
    24→ * Get display name from any item type (spec items have 'title', meta items have 'name')
    25→ */
    26→function getDisplayName(item: AnyLoadedItem | LoadedMetaItem): string {
    27→  if ("title" in item) {
    28→    return item.title;
    29→  }
    30→  if ("name" in item) {
    31→    return item.name;
    32→  }
    33→  return "(unknown)";
    34→}
    35→
    36→/**
    37→ * Validate relationship type
    38→ */
    39→function isValidRelationshipType(type: string): type is RelationshipType {
    40→  return RELATIONSHIP_TYPES.includes(type as RelationshipType);
    41→}
    42→
    43→/**
    44→ * Register link commands
    45→ */
    46→export function registerLinkCommands(program: Command): void {
    47→  const link = program
    48→    .command("link")
    49→    .description("Manage relationships between spec items");
    50→
    51→  // kspec link create
    52→  markMutating(link.command("create"))
    53→    .description("Create a relationship from one item to another")
    54→    .argument("<from>", "Source item reference (e.g., @my-item)")
    55→    .argument("<to>", "Target item reference (e.g., @other-item)")
    56→    .option(
    57→      "-t, --type <type>",
    58→      "Relationship type (depends_on, implements, relates_to)",
    59→      "relates_to",
    60→    )
    61→    .action(async (fromRef: string, toRef: string, options) => {
    62→      try {
    63→        const ctx = await initContext();
    64→        const { refIndex, itemIndex } = await buildIndexes(ctx);
    65→
    66→        // Validate relationship type
    67→        if (!isValidRelationshipType(options.type)) {
    68→          error(
    69→            errors.relationship.invalidType(
    70→              options.type,
    71→              RELATIONSHIP_TYPES.join(", "),
    72→            ),
    73→          );
    74→          process.exit(EXIT_CODES.ERROR);
    75→        }
    76→
    77→        const relType = options.type as RelationshipType;
    78→
    79→        // Resolve references
    80→        const fromResult = refIndex.resolve(fromRef);
    81→        if (!fromResult.ok) {
    82→          error(errors.reference.itemNotFound(fromRef));
    83→          process.exit(EXIT_CODES.NOT_FOUND);
    84→        }
    85→
    86→        const toResult = refIndex.resolve(toRef);
    87→        if (!toResult.ok) {
    88→          error(errors.reference.itemNotFound(toRef));
    89→          process.exit(EXIT_CODES.NOT_FOUND);
    90→        }
    91→
    92→        const fromItem = fromResult.item;
    93→        const toItem = toResult.item;
    94→
    95→        // Ensure both are spec items (not tasks)
    96→        if ("status" in fromItem && typeof fromItem.status === "string") {
    97→          error(errors.reference.notSpecItem(fromRef));
    98→          process.exit(EXIT_CODES.ERROR);
    99→        }
   100→
   101→        if ("status" in toItem && typeof toItem.status === "string") {
   102→          error(errors.reference.notSpecItem(toRef));
   103→          process.exit(EXIT_CODES.ERROR);
   104→        }
   105→
   106→        const fromSpecItem = fromItem as LoadedSpecItem;
   107→
   108→        // Get existing relationships
   109→        const existingRels = (fromSpecItem[relType] || []) as string[];
   110→
   111→        // Check if relationship already exists
   112→        if (existingRels.includes(toRef)) {
   113→          warn(
   114→            `Relationship already exists: ${fromRef} --[${relType}]--> ${toRef}`,
   115→          );
   116→          output({ success: true, message: "Relationship already exists" });
   117→          return;
   118→        }
   119→
   120→        // Add the new relationship
   121→        const newRels = [...existingRels, toRef];
   122→        const updates = { [relType]: newRels };
   123→
   124→        await updateSpecItem(ctx, fromSpecItem, updates);
   125→        await commitIfShadow(
   126→          ctx.shadow,
   127→          `Add ${relType} link: ${fromRef} -> ${toRef}`,
   128→        );
   129→
   130→        success(`Created relationship: ${fromRef} --[${relType}]--> ${toRef}`, {
   131→          from: fromRef,
   132→          to: toRef,
   133→          type: relType,
   134→        });
   135→      } catch (err) {
   136→        error((err as Error).message);
   137→        process.exit(EXIT_CODES.ERROR);
   138→      }
   139→    });
   140→
   141→  // kspec link list
   142→  link
   143→    .command("list")
   144→    .description("List relationships")
   145→    .option("--from <ref>", "Show relationships from this item")
   146→    .option("--to <ref>", "Show relationships to this item (reverse lookup)")
   147→    .option("-t, --type <type>", "Filter by relationship type")
   148→    .action(async (options) => {
   149→      try {
   150→        const ctx = await initContext();
   151→        const { refIndex, itemIndex, items } = await buildIndexes(ctx);
   152→
   153→        // Validate type if provided
   154→        if (options.type && !isValidRelationshipType(options.type)) {
   155→          error(
   156→            errors.relationship.invalidType(
   157→              options.type,
   158→              RELATIONSHIP_TYPES.join(", "),
   159→            ),
   160→          );
   161→          process.exit(EXIT_CODES.ERROR);
   162→        }
   163→
   164→        const typeFilter = options.type as RelationshipType | undefined;
   165→
   166→        // Case 1: List relationships FROM an item
   167→        if (options.from) {
   168→          const result = refIndex.resolve(options.from);
   169→          if (!result.ok) {
   170→            error(errors.reference.itemNotFound(options.from));
   171→            process.exit(EXIT_CODES.NOT_FOUND);
   172→          }
   173→
   174→          const item = result.item;
   175→
   176→          // Ensure it's a spec item
   177→          if ("status" in item && typeof item.status === "string") {
   178→            error(errors.reference.notSpecItem(options.from));
   179→            process.exit(EXIT_CODES.ERROR);
   180→          }
   181→
   182→          const specItem = item as LoadedSpecItem;
   183→          const relationships: Array<{
   184→            type: RelationshipType;
   185→            target: string;
   186→          }> = [];
   187→
   188→          for (const relType of RELATIONSHIP_TYPES) {
   189→            if (typeFilter && relType !== typeFilter) continue;
   190→
   191→            const targets = (specItem[relType] || []) as string[];
   192→            for (const target of targets) {
   193→              relationships.push({ type: relType, target });
   194→            }
   195→          }
   196→
   197→          if (relationships.length === 0) {
   198→            console.log(
   199→              chalk.gray(`No relationships found from ${options.from}`),
   200→            );
   201→            output({ success: true, relationships: [] });
   202→            return;
   203→          }
   204→
   205→          console.log(chalk.bold(`Relationships from ${options.from}:\n`));
   206→          for (const rel of relationships) {
   207→            const targetResult = refIndex.resolve(rel.target);
   208→            const targetTitle = targetResult.ok
   209→              ? getDisplayName(targetResult.item)
   210→              : chalk.gray("(not found)");
   211→            console.log(
   212→              `  ${chalk.cyan(rel.type)}: ${chalk.yellow(rel.target)} - ${targetTitle}`,
   213→            );
   214→          }
   215→          console.log(chalk.gray(`\n${relationships.length} relationship(s)`));
   216→
   217→          output({ success: true, from: options.from, relationships });
   218→          return;
   219→        }
   220→
   221→        // Case 2: List relationships TO an item (reverse lookup)
   222→        if (options.to) {
   223→          const targetRef = options.to;
   224→          const targetResult = refIndex.resolve(targetRef);
   225→          if (!targetResult.ok) {
   226→            error(errors.reference.itemNotFound(targetRef));
   227→            process.exit(EXIT_CODES.NOT_FOUND);
   228→          }
   229→
   230→          const relationships: Array<{ type: RelationshipType; from: string }> =
   231→            [];
   232→
   233→          // Search all spec items for links to this target
   234→          for (const item of items) {
   235→            for (const relType of RELATIONSHIP_TYPES) {
   236→              if (typeFilter && relType !== typeFilter) continue;
   237→
   238→              const targets = (item[relType] || []) as string[];
   239→              if (targets.includes(targetRef)) {
   240→                const fromRef =
   241→                  item.slugs.length > 0 ? `@${item.slugs[0]}` : item._ulid;
   242→                relationships.push({ type: relType, from: fromRef });
   243→              }
   244→            }
   245→          }
   246→
   247→          if (relationships.length === 0) {
   248→            console.log(chalk.gray(`No relationships found to ${targetRef}`));
   249→            output({ success: true, relationships: [] });
   250→            return;
   251→          }
   252→
   253→          console.log(chalk.bold(`Relationships to ${targetRef}:\n`));
   254→          for (const rel of relationships) {
   255→            const fromResult = refIndex.resolve(rel.from);
   256→            const fromTitle = fromResult.ok
   257→              ? getDisplayName(fromResult.item)
   258→              : chalk.gray("(not found)");
   259→            console.log(
   260→              `  ${chalk.yellow(rel.from)} - ${fromTitle} ${chalk.cyan(`--[${rel.type}]-->`)}`,
   261→            );
   262→          }
   263→          console.log(chalk.gray(`\n${relationships.length} relationship(s)`));
   264→
   265→          output({ success: true, to: targetRef, relationships });
   266→          return;
   267→        }
   268→
   269→        // Case 3: No filters - show all relationships
   270→        const allRelationships: Array<{
   271→          from: string;
   272→          fromTitle: string;
   273→          type: RelationshipType;
   274→          to: string;
   275→          toTitle: string;
   276→        }> = [];
   277→
   278→        for (const item of items) {
   279→          const fromRef =
   280→            item.slugs.length > 0 ? `@${item.slugs[0]}` : item._ulid;
   281→
   282→          for (const relType of RELATIONSHIP_TYPES) {
   283→            if (typeFilter && relType !== typeFilter) continue;
   284→
   285→            const targets = (item[relType] || []) as string[];
   286→            for (const target of targets) {
   287→              const toResult = refIndex.resolve(target);
   288→              allRelationships.push({
   289→                from: fromRef,
   290→                fromTitle: getDisplayName(item),
   291→                type: relType,
   292→                to: target,
   293→                toTitle: toResult.ok
   294→                  ? getDisplayName(toResult.item)
   295→                  : "(not found)",
   296→              });
   297→            }
   298→          }
   299→        }
   300→
   301→        if (allRelationships.length === 0) {
   302→          console.log(chalk.gray("No relationships found"));
   303→          output({ success: true, relationships: [] });
   304→          return;
   305→        }
   306→
   307→        console.log(chalk.bold("All relationships:\n"));
   308→        for (const rel of allRelationships) {
   309→          console.log(
   310→            `  ${chalk.yellow(rel.from)} ${chalk.gray(rel.fromTitle)} ${chalk.cyan(`--[${rel.type}]-->`)} ${chalk.yellow(rel.to)} ${chalk.gray(rel.toTitle)}`,
   311→          );
   312→        }
   313→        console.log(chalk.gray(`\n${allRelationships.length} relationship(s)`));
   314→
   315→        output({ success: true, relationships: allRelationships });
   316→      } catch (err) {
   317→        error((err as Error).message);
   318→        process.exit(EXIT_CODES.ERROR);
   319→      }
   320→    });
   321→
   322→  // kspec link delete
   323→  markMutating(link.command("delete"))
   324→    .description("Remove a relationship between items")
   325→    .argument("<from>", "Source item reference")
   326→    .argument("<to>", "Target item reference")
   327→    .option(
   328→      "-t, --type <type>",
   329→      "Relationship type to remove (if not specified, removes from all types)",
   330→    )
   331→    .action(async (fromRef: string, toRef: string, options) => {
   332→      try {
   333→        const ctx = await initContext();
   334→        const { refIndex } = await buildIndexes(ctx);
   335→
   336→        // Validate type if provided
   337→        if (options.type && !isValidRelationshipType(options.type)) {
   338→          error(
   339→            errors.relationship.invalidType(
   340→              options.type,
   341→              RELATIONSHIP_TYPES.join(", "),
   342→            ),
   343→          );
   344→          process.exit(EXIT_CODES.ERROR);
   345→        }
   346→
   347→        const typeFilter = options.type as RelationshipType | undefined;
   348→
   349→        // Resolve references
   350→        const fromResult = refIndex.resolve(fromRef);
   351→        if (!fromResult.ok) {
   352→          error(errors.reference.itemNotFound(fromRef));
   353→          process.exit(EXIT_CODES.NOT_FOUND);
   354→        }
   355→
   356→        const toResult = refIndex.resolve(toRef);
   357→        if (!toResult.ok) {
   358→          error(errors.reference.itemNotFound(toRef));
   359→          process.exit(EXIT_CODES.NOT_FOUND);
   360→        }
   361→
   362→        const fromItem = fromResult.item;
   363→
   364→        // Ensure from is a spec item
   365→        if ("status" in fromItem && typeof fromItem.status === "string") {
   366→          error(errors.reference.notSpecItem(fromRef));
   367→          process.exit(EXIT_CODES.ERROR);
   368→        }
   369→
   370→        const fromSpecItem = fromItem as LoadedSpecItem;
   371→
   372→        // Track which relationships were removed
   373→        const removed: RelationshipType[] = [];
   374→        const updates: Partial<Record<RelationshipType, string[]>> = {};
   375→
   376→        // Remove from specified type or all types
   377→        for (const relType of RELATIONSHIP_TYPES) {
   378→          if (typeFilter && relType !== typeFilter) continue;
   379→
   380→          const existingRels = (fromSpecItem[relType] || []) as string[];
   381→          if (existingRels.includes(toRef)) {
   382→            updates[relType] = existingRels.filter((r) => r !== toRef);
   383→            removed.push(relType);
   384→          }
   385→        }
   386→
   387→        if (removed.length === 0) {
   388→          warn(`No relationship found: ${fromRef} --> ${toRef}`);
   389→          output({ success: true, message: "No relationship found" });
   390→          return;
   391→        }
   392→
   393→        await updateSpecItem(ctx, fromSpecItem, updates);
   394→        await commitIfShadow(
   395→          ctx.shadow,
   396→          `Remove ${removed.join(", ")} link: ${fromRef} -> ${toRef}`,
   397→        );
   398→
   399→        const typesStr = removed.join(", ");
   400→        success(
   401→          `Removed relationship(s): ${fromRef} --[${typesStr}]--> ${toRef}`,
   402→          { from: fromRef, to: toRef, types: removed },
   403→        );
   404→      } catch (err) {
   405→        error((err as Error).message);
   406→        process.exit(EXIT_CODES.ERROR);
   407→      }
   408→    });
   409→}
   410→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
