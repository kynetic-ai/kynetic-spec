   169→}
   170→
   171→export interface BlockedTaskSummary {
   172→  ref: string;
   173→  title: string;
   174→  blocked_by: string[];
   175→  unmet_deps: string[];
   176→}
   177→
   178→export interface CompletedTaskSummary {
   179→  ref: string;
   180→  title: string;
   181→  completed_at: string;
