   183→  origin?: "manual" | "derived" | "observation_promotion";
   184→}
   185→
   186→export interface CommitSummary {
   187→  hash: string;
   188→  full_hash: string;
   189→  date: string;
   190→  message: string;
   191→  author: string;
   192→}
   193→
   194→export interface SessionStats {
   195→  total_tasks: number;
   196→  in_progress: number;
   197→  pending_review: number;
   198→  ready: number;
   199→  blocked: number;
   200→  completed: number;
   201→  inbox_items: number;
   202→}
   203→
   204→export interface InboxSummary {
   205→  ref: string;
   206→  text: string;
   207→  created_at: string;
   208→  tags: string[];
   209→  added_by: string | null;
   210→}
   211→
   212→export interface SessionOptions {
   213→  brief?: boolean;
   214→  full?: boolean;
   215→  since?: string;
   216→  git?: boolean;
   217→  limit?: string;
   218→  eligible?: boolean; // Only include automation-eligible tasks in ready_tasks
   219→}
   220→
   221→// ─── Data Gathering ──────────────────────────────────────────────────────────
   222→
   223→function toActiveTaskSummary(
   224→  task: LoadedTask,
   225→  index: ReferenceIndex,
   226→): ActiveTaskSummary {
   227→  const lastNote =
   228→    task.notes.length > 0 ? task.notes[task.notes.length - 1] : null;
   229→  const incompleteTodos = task.todos.filter((t) => !t.done).length;
   230→  return {
   231→    ref: index.shortUlid(task._ulid),
   232→    title: task.title,
   233→    started_at: task.started_at || null,
   234→    priority: task.priority,
   235→    spec_ref: task.spec_ref || null,
   236→    note_count: task.notes.length,
   237→    last_note_at: lastNote ? lastNote.created_at : null,
   238→    todo_count: task.todos.length,
   239→    incomplete_todos: incompleteTodos,
   240→  };
   241→}
   242→
   243→function toReadyTaskSummary(
   244→  task: LoadedTask,
   245→  index: ReferenceIndex,
   246→): ReadyTaskSummary {
   247→  return {
   248→    ref: index.shortUlid(task._ulid),
   249→    title: task.title,
   250→    priority: task.priority,
   251→    spec_ref: task.spec_ref || null,
   252→    tags: task.tags,
   253→  };
   254→}
   255→
   256→function toBlockedTaskSummary(
   257→  task: LoadedTask,
   258→  _allTasks: LoadedTask[],
   259→  index: ReferenceIndex,
   260→): BlockedTaskSummary {
   261→  // Find unmet dependencies
   262→  const unmetDeps: string[] = [];
   263→  for (const depRef of task.depends_on) {
   264→    const result = index.resolve(depRef);
   265→    if (result.ok) {
   266→      const depItem = result.item;
   267→      if ("status" in depItem && depItem.status !== "completed") {
   268→        unmetDeps.push(depRef);
   269→      }
   270→    }
   271→  }
   272→
   273→  return {
   274→    ref: index.shortUlid(task._ulid),
   275→    title: task.title,
   276→    blocked_by: task.blocked_by,
   277→    unmet_deps: unmetDeps,
   278→  };
   279→}
   280→
   281→function toCompletedTaskSummary(
   282→  task: LoadedTask,
   283→  index: ReferenceIndex,
   284→): CompletedTaskSummary {
   285→  return {
   286→    ref: index.shortUlid(task._ulid),
   287→    title: task.title,
   288→    completed_at: task.completed_at || "",
   289→    closed_reason: task.closed_reason || null,
   290→    origin: task.origin,
   291→  };
   292→}
   293→
   294→function collectRecentNotes(
   295→  tasks: LoadedTask[],
   296→  index: ReferenceIndex,
   297→  options: { limit: number; since: Date | null },
   298→): NoteSummary[] {
   299→  const allNotes: NoteSummary[] = [];
   300→
   301→  for (const task of tasks) {
   302→    // Only include notes from in_progress, pending_review, or completed tasks
   303→    const taskStatus = task.status as "in_progress" | "pending_review" | "completed";
   304→    if (!["in_progress", "pending_review", "completed"].includes(taskStatus)) {
   305→      continue;
   306→    }
   307→
   308→    for (const note of task.notes) {
   309→      const noteDate = new Date(note.created_at);
   310→
   311→      // Filter by since date if provided
   312→      if (options.since && noteDate < options.since) {
   313→        continue;
   314→      }
   315→
   316→      // Filter out superseded notes
   317→      if (isNoteSuperseded(note, task.notes)) {
   318→        continue;
   319→      }
   320→
   321→      allNotes.push({
   322→        task_ref: index.shortUlid(task._ulid),
   323→        task_title: task.title,
   324→        task_status: taskStatus,
   325→        note_ulid: note._ulid.slice(0, 8),
   326→        created_at: note.created_at,
   327→        author: note.author || null,
   328→        content: note.content,
   329→      });
   330→    }
   331→  }
   332→
   333→  // Sort by date descending, take limit
   334→  return allNotes
   335→    .sort(
   336→      (a, b) =>
   337→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   338→    )
   339→    .slice(0, options.limit);
   340→}
   341→
   342→function collectIncompleteTodos(
   343→  tasks: LoadedTask[],
   344→  index: ReferenceIndex,
   345→  options: { limit: number },
   346→): TodoSummary[] {
   347→  const allTodos: TodoSummary[] = [];
   348→
   349→  for (const task of tasks) {
   350→    for (const todo of task.todos) {
   351→      // Only include incomplete todos
   352→      if (todo.done) continue;
   353→
   354→      allTodos.push({
   355→        task_ref: index.shortUlid(task._ulid),
   356→        task_title: task.title,
   357→        id: todo.id,
   358→        text: todo.text,
   359→        added_at: todo.added_at,
   360→        added_by: todo.added_by || null,
   361→      });
   362→    }
   363→  }
   364→
   365→  // Sort by added_at descending (most recent first), take limit
   366→  return allTodos
   367→    .sort(
   368→      (a, b) => new Date(b.added_at).getTime() - new Date(a.added_at).getTime(),
   369→    )
   370→    .slice(0, options.limit);
   371→}
   372→
   373→/**
   374→ * Gather session context data
   375→ */
   376→export async function gatherSessionContext(
   377→  ctx: KspecContext,
   378→  options: SessionOptions,
   379→): Promise<SessionContext> {
   380→  const limit = parseInt(options.limit || "10", 10);
   381→  const sinceDate = options.since ? parseTimeSpec(options.since) : null;
   382→  const showGit = options.git !== false; // default true
   383→
   384→  // Load all data
   385→  const allTasks = await loadAllTasks(ctx);
   386→  const items = await loadAllItems(ctx);
   387→  const inboxItems = await loadInboxItems(ctx);
   388→  const index = new ReferenceIndex(allTasks, items);
   389→
   390→  // Compute stats
   391→  const stats: SessionStats = {
   392→    total_tasks: allTasks.length,
   393→    in_progress: allTasks.filter((t) => t.status === "in_progress").length,
   394→    pending_review: allTasks.filter((t) => t.status === "pending_review")
   395→      .length,
   396→    ready: getReadyTasks(allTasks).length,
   397→    blocked: allTasks.filter((t) => t.status === "blocked").length,
   398→    completed: allTasks.filter((t) => t.status === "completed").length,
   399→    inbox_items: inboxItems.length,
   400→  };
   401→
   402→  // Get active tasks (optionally filtered to automation-eligible only)
   403→  // AC: @cli-ralph ac-16
   404→  const activeTasks = allTasks
   405→    .filter((t) => t.status === "in_progress")
   406→    .filter((t) => !options.eligible || t.automation === "eligible")
   407→    .sort((a, b) => a.priority - b.priority)
   408→    .slice(0, options.full ? undefined : limit)
   409→    .map((t) => toActiveTaskSummary(t, index));
   410→
   411→  // Get pending review tasks
   412→  const pendingReviewTasks = allTasks
   413→    .filter((t) => t.status === "pending_review")
   414→    .sort((a, b) => a.priority - b.priority)
   415→    .slice(0, options.full ? undefined : limit)
   416→    .map((t) => toActiveTaskSummary(t, index));
   417→
   418→  // Get recent notes from active, pending_review, and recently completed tasks
   419→  // AC: @cmd-session-start ac-1, ac-2
   420→  // Collect notes per-status first to prevent one status from starving others
   421→  const noteLimitPerStatus = options.full ? limit : Math.ceil(limit / 3);
   422→
   423→  const inProgressNotes = collectRecentNotes(
   424→    allTasks.filter((t) => t.status === "in_progress"),
   425→    index,
   426→    { limit: noteLimitPerStatus, since: sinceDate },
   427→  );
   428→
   429→  const pendingReviewNotes = collectRecentNotes(
   430→    allTasks.filter((t) => t.status === "pending_review"),
   431→    index,
   432→    { limit: noteLimitPerStatus, since: sinceDate },
   433→  );
   434→
   435→  const recentlyCompletedForNotes = allTasks
   436→    .filter((t) => t.status === "completed" && t.completed_at)
   437→    .sort((a, b) => {
   438→      const aDate = new Date(a.completed_at || 0);
   439→      const bDate = new Date(b.completed_at || 0);
   440→      return bDate.getTime() - aDate.getTime();
   441→    })
   442→    .slice(0, 5); // Last 3-5 completed tasks per AC-2
   443→
   444→  const completedNotes = collectRecentNotes(
   445→    recentlyCompletedForNotes,
   446→    index,
   447→    { limit: noteLimitPerStatus, since: sinceDate },
   448→  );
   449→
   450→  // Combine notes from all statuses, preserving representation from each
   451→  const recentNotes = [...inProgressNotes, ...pendingReviewNotes, ...completedNotes]
   452→    .sort(
   453→      (a, b) =>
   454→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   455→    );
   456→
   457→  // Get incomplete todos from active tasks
   458→  const activeTodos = collectIncompleteTodos(
   459→    allTasks.filter((t) => t.status === "in_progress"),
   460→    index,
   461→    { limit: options.full ? limit * 2 : limit },
   462→  );
   463→
   464→  // Get ready tasks (optionally filtered to automation-eligible only)
   465→  const readyTasks = getReadyTasks(allTasks)
   466→    .filter((t) => !options.eligible || t.automation === "eligible")
   467→    .slice(0, options.full ? undefined : limit)
   468→    .map((t) => toReadyTaskSummary(t, index));
   469→
   470→  // Get blocked tasks
   471→  const blockedTasks = allTasks
   472→    .filter((t) => t.status === "blocked")
   473→    .slice(0, options.full ? undefined : limit)
   474→    .map((t) => toBlockedTaskSummary(t, allTasks, index));
   475→
   476→  // Get recently completed tasks
   477→  const recentlyCompleted = allTasks
   478→    .filter((t) => {
   479→      if (t.status !== "completed" || !t.completed_at) return false;
   480→      const completedDate = new Date(t.completed_at);
   481→      if (sinceDate && completedDate < sinceDate) return false;
   482→      return true;
   483→    })
   484→    .sort((a, b) => {
   485→      // Sort by completed_at descending (most recent first)
   486→      const aDate = new Date(a.completed_at || 0);
   487→      const bDate = new Date(b.completed_at || 0);
   488→      return bDate.getTime() - aDate.getTime();
   489→    })
   490→    .slice(0, options.full ? undefined : limit)
   491→    .map((t) => toCompletedTaskSummary(t, index));
   492→
   493→  // Get git info
   494→  let branch: string | null = null;
   495→  let recentCommits: CommitSummary[] = [];
   496→  let workingTree: GitWorkingTree | null = null;
   497→
   498→  if (showGit && isGitRepo(ctx.rootDir)) {
   499→    branch = getCurrentBranch(ctx.rootDir);
   500→
   501→    const commits = getRecentCommits({
   502→      limit: options.full ? limit * 2 : limit,
   503→      since: sinceDate || undefined,
   504→      cwd: ctx.rootDir,
   505→    });
   506→
   507→    recentCommits = commits.map((c) => ({
   508→      hash: c.hash,
   509→      full_hash: c.fullHash,
   510→      date: c.date.toISOString(),
   511→      message: c.message,
   512→      author: c.author,
   513→    }));
   514→
   515→    workingTree = getWorkingTreeStatus(ctx.rootDir);
   516→  }
   517→
   518→  // Get inbox items (oldest first to encourage triage)
   519→  const inboxSummaries: InboxSummary[] = inboxItems
   520→    .sort(
   521→      (a, b) =>
   522→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
   523→    )
   524→    .slice(0, options.full ? undefined : limit)
   525→    .map((item) => ({
   526→      ref: item._ulid.slice(0, 8),
   527→      text: item.text,
   528→      created_at: item.created_at,
   529→      tags: item.tags,
   530→      added_by: item.added_by || null,
   531→    }));
   532→
   533→  // Load session context (focus, threads, questions)
   534→  const sessionContext = await loadSessionContext(ctx);
   535→
   536→  return {
   537→    generated_at: new Date().toISOString(),
   538→    branch,
   539→    context: sessionContext,
   540→    active_tasks: activeTasks,
   541→    pending_review_tasks: pendingReviewTasks,
   542→    recent_notes: recentNotes,
   543→    active_todos: activeTodos,
   544→    ready_tasks: readyTasks,
   545→    blocked_tasks: blockedTasks,
   546→    recently_completed: recentlyCompleted,
   547→    recent_commits: recentCommits,
   548→    working_tree: workingTree,
   549→    inbox_items: inboxSummaries,
   550→    stats,
   551→  };
   552→}
   553→
   554→// ─── Iteration Stats ─────────────────────────────────────────────────────────
   555→
   556→/**
   557→ * Stats for tasks completed/started within a time window.
   558→ * Used by ralph to track task completions per iteration.
   559→ */
   560→export interface IterationStats {
   561→  /** Number of tasks completed since the given time */
   562→  tasks_completed: number;
   563→  /** Number of tasks started since the given time */
   564→  tasks_started: number;
   565→  /** References of completed tasks */
   566→  completed_refs: string[];
   567→}
   568→
   569→/**
   570→ * Get iteration stats - tasks completed/started since a given time.
   571→ * AC: @ralph-task-limit ac-detection
   572→ */
   573→export async function getIterationStats(
   574→  ctx: KspecContext,
   575→  since: Date,
   576→): Promise<IterationStats> {
   577→  const allTasks = await loadAllTasks(ctx);
   578→
   579→  const completedSince = allTasks.filter((t) => {
   580→    if (t.status !== "completed" || !t.completed_at) return false;
   581→    return new Date(t.completed_at) >= since;
   582→  });
   583→
   584→  const startedSince = allTasks.filter((t) => {
   585→    if (!t.started_at) return false;
   586→    return new Date(t.started_at) >= since;
   587→  });
   588→
   589→  // Use first slug or ULID prefix as ref
   590→  const getRef = (t: LoadedTask) =>
   591→    t.slugs.length > 0 ? `@${t.slugs[0]}` : `@${t._ulid.slice(0, 8)}`;
   592→
   593→  return {
   594→    tasks_completed: completedSince.length,
   595→    tasks_started: startedSince.length,
   596→    completed_refs: completedSince.map(getRef),
   597→  };
   598→}
   599→
   600→// ─── Checkpoint ──────────────────────────────────────────────────────────────
   601→
   602→export interface CheckpointOptions {
   603→  force?: boolean;
   604→  /** Set when stop hook is already active (retry after previous block) */
   605→  stopHookActive?: boolean;
   606→}
   607→
   608→/** Claude Code hook input for Stop hooks */
   609→export interface StopHookInput {
   610→  session_id?: string;
   611→  transcript_path?: string;
   612→  hook_event_name?: string;
   613→  stop_hook_active?: boolean;
   614→}
   615→
   616→/**
   617→ * Perform session checkpoint - check for uncommitted work before ending session.
   618→ *
   619→ * This is designed for use as a Claude Code stop hook. It checks for:
   620→ * - Uncommitted git changes (staged, unstaged, untracked)
   621→ * - Tasks in in_progress status
   622→ * - Incomplete todos on active tasks
   623→ *
   624→ * Returns a structured result indicating whether the session can end cleanly.
   625→ */
   626→export async function performCheckpoint(
   627→  ctx: KspecContext,
   628→  options: CheckpointOptions,
   629→): Promise<CheckpointResult> {
   630→  const issues: CheckpointIssue[] = [];
   631→  const instructions: string[] = [];
   632→
   633→  // Load tasks
   634→  const allTasks = await loadAllTasks(ctx);
   635→
   636→  // Check for in-progress tasks
   637→  const inProgressTasks = allTasks.filter((t) => t.status === "in_progress");
   638→  for (const task of inProgressTasks) {
   639→    const ref = task.slugs[0]
   640→      ? `@${task.slugs[0]}`
   641→      : `@${task._ulid.slice(0, 8)}`;
   642→    issues.push({
   643→      type: "in_progress_task",
   644→      description: `Task ${ref} is still in progress: ${task.title}`,
   645→      details: {
   646→        ref,
   647→        title: task.title,
   648→        started_at: task.started_at,
   649→      },
   650→    });
   651→
   652→    // Check for incomplete todos on this task
   653→    const incompleteTodos = task.todos.filter((t) => !t.done);
   654→    for (const todo of incompleteTodos) {
   655→      issues.push({
   656→        type: "incomplete_todo",
   657→        description: `Incomplete todo on ${ref}: ${todo.text}`,
   658→        details: {
   659→          task_ref: ref,
   660→          todo_id: todo.id,
   661→          text: todo.text,
   662→        },
   663→      });
   664→    }
   665→  }
   666→
   667→  // Check for uncommitted git changes
   668→  if (isGitRepo(ctx.rootDir)) {
   669→    const workingTree = getWorkingTreeStatus(ctx.rootDir);
   670→    if (!workingTree.clean) {
   671→      const changeCount =
   672→        workingTree.staged.length +
   673→        workingTree.unstaged.length +
   674→        workingTree.untracked.length;
   675→
   676→      issues.push({
   677→        type: "uncommitted_changes",
   678→        description: `${changeCount} uncommitted changes in working tree`,
   679→        details: {
   680→          staged: workingTree.staged.length,
   681→          unstaged: workingTree.unstaged.length,
   682→          untracked: workingTree.untracked.length,
   683→        },
   684→      });
   685→    }
   686→  }
   687→
   688→  // Build instructions based on issues
   689→  if (issues.length > 0 && !options.force) {
   690→    instructions.push(
   691→      "If you've been instructed to ignore this message or are working on",
   692→    );
   693→    instructions.push(
   694→      "unrelated things to any in progress tasks then disregard this message,",
   695→    );
   696→    instructions.push("otherwise before ending this session, please:");
   697→
   698→    const hasInProgress = issues.some((i) => i.type === "in_progress_task");
   699→    const hasUncommitted = issues.some((i) => i.type === "uncommitted_changes");
   700→    const hasIncompleteTodos = issues.some((i) => i.type === "incomplete_todo");
   701→
   702→    let step = 1;
   703→
   704→    if (hasInProgress) {
   705→      instructions.push(
   706→        `${step++}. Read in-progress task notes to get full context of the current task status`,
   707→      );
   708→      instructions.push(
   709→        `${step++}. Add notes documenting current state if any context is missing from this session`,
   710→      );
   711→      instructions.push(
   712→        `${step++}. Complete the task if you've completed the objectives and no AC are left uncovered\notherwise leave it in progress for a future session`,
   713→      );
   714→    }
   715→
   716→    if (hasIncompleteTodos) {
   717→      instructions.push(
   718→        `${step++}. Complete or acknowledge incomplete todos on active tasks`,
   719→      );
   720→    }
   721→
   722→    if (hasUncommitted) {
   723→      instructions.push(
   724→        `${step++}. Commit your changes with a descriptive message`,
   725→      );
   726→
   727→      // Add WIP commit guidance if there are in-progress tasks
   728→      if (inProgressTasks.length > 0) {
   729→        const task = inProgressTasks[0];
   730→        const guidance = formatCommitGuidance(task, { wip: true });
   731→        instructions.push("");
   732→        instructions.push("Suggested WIP commit:");
   733→        instructions.push(`  ${guidance.message}`);
   734→        instructions.push("");
   735→        for (const trailer of guidance.trailers) {
   736→          instructions.push(`  ${trailer}`);
   737→        }
   738→      }
   739→    }
   740→
   741→    instructions.push("");
   742→    instructions.push("Use: kspec task @task to get current task state");
   743→    instructions.push(
   744→      'Use: kspec task note @task "Progress notes..." to document state',
   745→    );
   746→    instructions.push(
   747→      'Use: kspec task complete @task --reason "Summary" if task is done',
   748→    );
   749→  }
   750→
   751→  // Allow stop if:
   752→  // - No issues found
   753→  // - --force flag passed
   754→  // - This is a retry (stop_hook_active = true from previous block)
   755→  const isRetry = options.stopHookActive === true;
   756→  const ok = issues.length === 0 || options.force === true || isRetry;
   757→
   758→  let message: string;
   759→  if (isRetry && issues.length > 0) {
   760→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) acknowledged - allowing stop`;
   761→  } else if (ok) {
   762→    message = "[kspec] Session checkpoint passed - ready to end session";
   763→  } else {
   764→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) need attention`;
   765→  }
   766→
   767→  return {
   768→    ok,
   769→    message,
   770→    issues,
   771→    instructions,
   772→  };
   773→}
   774→
   775→// ─── Output Formatting ───────────────────────────────────────────────────────
   776→
   777→function formatCheckpointResult(result: CheckpointResult): void {
   778→  if (result.ok) {
   779→    console.log(chalk.green(result.message));
   780→  } else {
   781→    console.log(chalk.yellow(result.message));
   782→    console.log("");
   783→
   784→    for (const issue of result.issues) {
   785→      const icon =
   786→        issue.type === "uncommitted_changes"
   787→          ? chalk.yellow("⚠")
   788→          : issue.type === "in_progress_task"
   789→            ? chalk.blue("●")
   790→            : chalk.gray("○");
   791→      console.log(`  ${icon} ${issue.description}`);
   792→    }
   793→
   794→    if (result.instructions.length > 0) {
   795→      console.log("");
   796→      for (const instruction of result.instructions) {
   797→        console.log(chalk.gray(instruction));
   798→      }
   799→    }
   800→  }
   801→}
   802→
   803→function formatSessionContext(
   804→  ctx: SessionContext,
   805→  options: SessionOptions,
   806→): void {
   807→  const isBrief = !options.full;
   808→
   809→  // Header
   810→  console.log(`\n${sessionHeaders.title}`);
   811→  const age = formatRelativeTime(new Date(ctx.generated_at));
   812→  if (ctx.branch) {
   813→    console.log(chalk.gray(`Branch: ${ctx.branch} | Generated: ${age}`));
   814→  } else {
   815→    console.log(chalk.gray(`Generated: ${age}`));
   816→  }
   817→
   818→  // Stats summary
   819→  const pendingReviewNote =
   820→    ctx.stats.pending_review > 0
   821→      ? `${ctx.stats.pending_review} awaiting review, `
   822→      : "";
   823→  const inboxNote =
   824→    ctx.stats.inbox_items > 0 ? ` | Inbox: ${ctx.stats.inbox_items}` : "";
   825→  console.log(
   826→    chalk.gray(
   827→      `Tasks: ${ctx.stats.in_progress} active, ${pendingReviewNote}${ctx.stats.ready} ready, ` +
   828→        `${ctx.stats.blocked} blocked, ${ctx.stats.completed}/${ctx.stats.total_tasks} completed${inboxNote}`,
   829→    ),
   830→  );
   831→
   832→  // Session context section (focus, threads, questions)
   833→  if (
   834→    ctx.context &&
   835→    (ctx.context.focus ||
   836→      ctx.context.threads.length > 0 ||
   837→      ctx.context.open_questions.length > 0)
   838→  ) {
   839→    console.log("\n--- Session Context ---");
   840→
   841→    if (ctx.context.focus) {
   842→      console.log(`  ${chalk.cyan("Focus:")} ${ctx.context.focus}`);
   843→    }
   844→
   845→    if (ctx.context.threads.length > 0) {
   846→      console.log(`  ${chalk.cyan("Active Threads:")}`);
   847→      for (const thread of ctx.context.threads) {
   848→        console.log(`    - ${thread}`);
   849→      }
   850→    }
   851→
   852→    if (ctx.context.open_questions.length > 0) {
   853→      console.log(`  ${chalk.cyan("Open Questions:")}`);
   854→      for (const question of ctx.context.open_questions) {
   855→        console.log(`    - ${question}`);
   856→      }
   857→    }
   858→  }
   859→
   860→  // Active tasks section
   861→  if (ctx.active_tasks.length > 0) {
   862→    console.log(`\n${sessionHeaders.activeWork}`);
   863→    for (const task of ctx.active_tasks) {
   864→      const started = task.started_at
   865→        ? chalk.gray(
   866→            ` (started ${formatRelativeTime(new Date(task.started_at))})`,
   867→          )
   868→        : "";
   869→      const priority =
   870→        task.priority <= 2
   871→          ? chalk.red(`P${task.priority}`)
   872→          : chalk.gray(`P${task.priority}`);
   873→      console.log(
   874→        `  ${chalk.blue("[in_progress]")} ${priority} ${task.ref} ${task.title}${started}`,
   875→      );
   876→    }
   877→  } else {
   878→    console.log(`\n${sessionHeaders.noActiveWork}`);
   879→  }
   880→
   881→  // Awaiting review section
   882→  if (ctx.pending_review_tasks.length > 0) {
   883→    console.log(`\n${sessionHeaders.awaitingReview}`);
   884→    for (const task of ctx.pending_review_tasks) {
   885→      const priority =
   886→        task.priority <= 2
   887→          ? chalk.red(`P${task.priority}`)
   888→          : chalk.gray(`P${task.priority}`);
   889→      console.log(
   890→        `  ${chalk.yellow("[pending_review]")} ${priority} ${task.ref} ${task.title}`,
   891→      );
   892→    }
   893→  }
   894→
   895→  // Recently completed section
   896→  if (ctx.recently_completed.length > 0) {
   897→    console.log(`\n${sessionHeaders.recentlyCompleted}`);
   898→    const observationPromotedTasks: string[] = [];
   899→    for (const task of ctx.recently_completed) {
   900→      const completedAge = formatRelativeTime(new Date(task.completed_at));
   901→      let reason = "";
   902→      if (task.closed_reason) {
   903→        const maxLen = isBrief ? 60 : 120;
   904→        const truncated =
   905→          task.closed_reason.length > maxLen
   906→            ? `${task.closed_reason.slice(0, maxLen).trim()}...`
   907→            : task.closed_reason;
   908→        reason = chalk.gray(` - ${truncated}`);
   909→      }
   910→      console.log(
   911→        `  ${chalk.green("[completed]")} ${task.ref} ${task.title} ${chalk.gray(`(${completedAge})`)}${reason}`,
   912→      );
   913→
   914→      // Track tasks that came from observations
   915→      if (task.origin === "observation_promotion") {
   916→        observationPromotedTasks.push(task.ref);
   917→      }
   918→    }
   919→
   920→    // Show reminder about resolving observations
   921→    if (observationPromotedTasks.length > 0) {
   922→      console.log(
   923→        chalk.yellow(
   924→          `\n  ℹ Consider resolving linked observations: ${observationPromotedTasks.join(", ")}`,
   925→        ),
   926→      );
   927→      console.log(
   928→        chalk.gray(`    Run: kspec meta observations --pending-resolution`),
   929→      );
   930→    }
   931→  }
   932→
   933→  // Recent notes section - grouped by task status
   934→  // AC: @cmd-session-start ac-1, ac-2
   935→  if (ctx.recent_notes.length > 0) {
   936→    console.log(`\n${sessionHeaders.recentNotes}`);
   937→
   938→    // Group notes by task status
   939→    const inProgressNotes = ctx.recent_notes.filter(
   940→      (n) => n.task_status === "in_progress",
   941→    );
   942→    const pendingReviewNotes = ctx.recent_notes.filter(
   943→      (n) => n.task_status === "pending_review",
   944→    );
   945→    const completedNotes = ctx.recent_notes.filter(
   946→      (n) => n.task_status === "completed",
   947→    );
   948→
   949→    // Helper to format a single note
   950→    const formatNote = (note: NoteSummary) => {
   951→      const age = formatRelativeTime(new Date(note.created_at));
   952→      const author = note.author ? chalk.gray(` by ${note.author}`) : "";
   953→      console.log(`    ${chalk.yellow(age)} on ${note.task_ref}${author}:`);
   954→
   955→      // Truncate content in brief mode
   956→      let content = note.content.trim();
   957→      if (isBrief && content.length > 200) {
   958→        content = `${content.slice(0, 200).trim()}...`;
   959→      }
   960→
   961→      // Indent content, limit lines in brief mode
   962→      const lines = content.split("\n");
   963→      const maxLines = isBrief ? 3 : lines.length;
   964→      for (const line of lines.slice(0, maxLines)) {
   965→        console.log(`      ${chalk.white(line)}`);
   966→      }
   967→      if (isBrief && lines.length > maxLines) {
   968→        console.log(
   969→          chalk.gray(`      ... (${lines.length - maxLines} more lines)`),
   970→        );
   971→      }
   972→    };
   973→
   974→    // AC: @cmd-session-start ac-1 - In Progress notes
   975→    if (inProgressNotes.length > 0) {
   976→      console.log(`  ${chalk.blue("In Progress:")}`);
   977→      for (const note of inProgressNotes) {
   978→        formatNote(note);
   979→      }
   980→    }
   981→
   982→    // AC: @cmd-session-start ac-1 - Pending Review notes (grouped separately)
   983→    if (pendingReviewNotes.length > 0) {
   984→      console.log(`  ${chalk.yellow("Pending Review:")}`);
   985→      for (const note of pendingReviewNotes) {
   986→        formatNote(note);
   987→      }
   988→    }
   989→
   990→    // AC: @cmd-session-start ac-2 - Recently Completed notes
   991→    if (completedNotes.length > 0) {
   992→      console.log(`  ${chalk.green("Recently Completed:")}`);
   993→      for (const note of completedNotes) {
   994→        formatNote(note);
   995→      }
   996→    }
   997→  }
   998→
   999→  // Incomplete todos section
  1000→  if (ctx.active_todos.length > 0) {
  1001→    console.log(`\n${sessionHeaders.incompleteTodos}`);
  1002→    for (const todo of ctx.active_todos) {
  1003→      console.log(
  1004→        `  ${chalk.yellow("[ ]")} ${todo.task_ref}#${todo.id}: ${todo.text}`,
  1005→      );
  1006→    }
  1007→  }
  1008→
  1009→  // Ready tasks section
  1010→  if (ctx.ready_tasks.length > 0) {
  1011→    console.log(`\n${sessionHeaders.readyTasks}`);
  1012→    for (const task of ctx.ready_tasks) {
  1013→      const priority =
  1014→        task.priority <= 2
  1015→          ? chalk.red(`P${task.priority}`)
  1016→          : chalk.gray(`P${task.priority}`);
  1017→      const tags =
  1018→        task.tags.length > 0 ? chalk.cyan(` #${task.tags.join(" #")}`) : "";
  1019→      console.log(`  ${priority} ${task.ref} ${task.title}${tags}`);
  1020→    }
  1021→  }
  1022→
  1023→  // Blocked tasks section
  1024→  if (ctx.blocked_tasks.length > 0) {
  1025→    console.log(`\n${sessionHeaders.blocked}`);
  1026→    for (const task of ctx.blocked_tasks) {
  1027→      console.log(`  ${chalk.red("[blocked]")} ${task.ref} ${task.title}`);
  1028→      if (task.blocked_by.length > 0) {
  1029→        console.log(chalk.gray(`    Blockers: ${task.blocked_by.join(", ")}`));
  1030→      }
  1031→      if (task.unmet_deps.length > 0) {
  1032→        console.log(
  1033→          chalk.gray(`    Waiting on: ${task.unmet_deps.join(", ")}`),
  1034→        );
  1035→      }
  1036→    }
  1037→  }
  1038→
  1039→  // Git commits section
  1040→  if (ctx.recent_commits.length > 0) {
  1041→    console.log(`\n${sessionHeaders.recentCommits}`);
  1042→    for (const commit of ctx.recent_commits) {
  1043→      const age = formatRelativeTime(new Date(commit.date));
  1044→      console.log(
  1045→        `  ${chalk.yellow(commit.hash)} ${commit.message} ${chalk.gray(`(${age}, ${commit.author})`)}`,
  1046→      );
  1047→    }
  1048→  }
  1049→
  1050→  // Inbox section (oldest first to encourage triage)
  1051→  if (ctx.inbox_items.length > 0) {
  1052→    console.log(`\n${sessionHeaders.inbox}`);
  1053→    for (const item of ctx.inbox_items) {
  1054→      const age = formatRelativeTime(new Date(item.created_at));
  1055→      const author = item.added_by ? ` by ${item.added_by}` : "";
  1056→      const tags =
  1057→        item.tags.length > 0 ? chalk.cyan(` [${item.tags.join(", ")}]`) : "";
  1058→      // Truncate text in brief mode
  1059→      let text = item.text;
  1060→      if (isBrief && text.length > 60) {
  1061→        text = `${text.slice(0, 60).trim()}...`;
  1062→      }
  1063→      console.log(
  1064→        `  ${chalk.magenta(item.ref)} ${chalk.gray(`(${age}${author})`)}${tags}`,
  1065→      );
  1066→      console.log(`    ${text}`);
  1067→    }
  1068→    console.log(`  ${hints.inboxPromote}`);
  1069→  }
  1070→
  1071→  // Working tree section
  1072→  if (ctx.working_tree && !ctx.working_tree.clean) {
  1073→    console.log(`\n${sessionHeaders.workingTree}`);
  1074→
  1075→    if (ctx.working_tree.staged.length > 0) {
  1076→      console.log(chalk.green("  Staged:"));
  1077→      for (const file of ctx.working_tree.staged) {
  1078→        console.log(
  1079→          `    ${chalk.green(file.status[0].toUpperCase())} ${file.path}`,
  1080→        );
  1081→      }
  1082→    }
  1083→
  1084→    if (ctx.working_tree.unstaged.length > 0) {
  1085→      console.log(chalk.red("  Modified:"));
  1086→      for (const file of ctx.working_tree.unstaged) {
  1087→        console.log(
  1088→          `    ${chalk.red(file.status[0].toUpperCase())} ${file.path}`,
  1089→        );
  1090→      }
  1091→    }
  1092→
  1093→    if (ctx.working_tree.untracked.length > 0) {
  1094→      console.log(chalk.gray("  Untracked:"));
  1095→      const limit = isBrief ? 5 : ctx.working_tree.untracked.length;
  1096→      for (const path of ctx.working_tree.untracked.slice(0, limit)) {
  1097→        console.log(`    ${chalk.gray("?")} ${path}`);
  1098→      }
  1099→      if (isBrief && ctx.working_tree.untracked.length > limit) {
  1100→        console.log(
  1101→          chalk.gray(
  1102→            `    ... and ${ctx.working_tree.untracked.length - limit} more`,
  1103→          ),
  1104→        );
  1105→      }
  1106→    }
  1107→  } else if (ctx.working_tree?.clean) {
  1108→    console.log(`\n${sessionHeaders.workingTreeClean}`);
  1109→  }
  1110→
  1111→  // Quick Commands section - contextual hints based on state
  1112→  const quickCommands: string[] = [];
  1113→
  1114→  if (ctx.active_tasks.length > 0) {
  1115→    const ref = ctx.active_tasks[0].ref;
  1116→    quickCommands.push(
  1117→      `kspec task note @${ref} "Progress..."  ${chalk.gray("# document work")}`,
  1118→    );
  1119→    quickCommands.push(
  1120→      `kspec task complete @${ref} --reason "..."  ${chalk.gray("# finish task")}`,
  1121→    );
  1122→  } else if (ctx.ready_tasks.length > 0) {
  1123→    const ref = ctx.ready_tasks[0].ref;
  1124→    quickCommands.push(
  1125→      `kspec task start @${ref}  ${chalk.gray("# begin work")}`,
  1126→    );
  1127→  }
  1128→
  1129→  if (ctx.inbox_items.length > 0) {
  1130→    const ref = ctx.inbox_items[0].ref;
  1131→    quickCommands.push(
  1132→      `kspec inbox promote @${ref} --title "..."  ${chalk.gray("# convert to task")}`,
  1133→    );
  1134→  }
  1135→
  1136→  if (ctx.working_tree && !ctx.working_tree.clean) {
  1137→    quickCommands.push(
  1138→      `git add . && git commit -m "..."  ${chalk.gray("# commit changes")}`,
  1139→    );
  1140→  }
  1141→
  1142→  if (quickCommands.length > 0) {
  1143→    console.log(`\n${sessionHeaders.quickCommands}`);
  1144→    for (const hint of quickCommands) {
  1145→      console.log(`  ${hint}`);
  1146→    }
  1147→  }
  1148→
  1149→  console.log(""); // Final newline
  1150→}
  1151→
  1152→// ─── Command Registration ────────────────────────────────────────────────────
  1153→
  1154→async function sessionStartAction(options: SessionOptions): Promise<void> {
  1155→  try {
  1156→    const ctx = await initContext();
  1157→
  1158→    // AC: @shadow-sync ac-2 - Pull remote changes before showing session context
  1159→    let syncResult: ShadowSyncResult | null = null;
  1160→    if (ctx.shadow?.enabled) {
  1161→      syncResult = await shadowPull(ctx.shadow.worktreeDir);
  1162→      // AC: @shadow-sync ac-3 - Warn about conflicts but continue with local state
  1163→      if (syncResult.hadConflict) {
  1164→        console.log(
  1165→          chalk.yellow(
  1166→            "⚠ Shadow sync conflict detected. Run `kspec shadow resolve` to fix.",
  1167→          ),
  1168→        );
  1169→        console.log(chalk.gray("  Continuing with local state..."));
  1170→        console.log("");
  1171→      } else if (syncResult.pulled) {
  1172→        console.log(chalk.gray("ℹ Synced shadow branch from remote"));
  1173→      }
  1174→    }
  1175→
  1176→    const sessionCtx = await gatherSessionContext(ctx, options);
  1177→
  1178→    output(sessionCtx, () => formatSessionContext(sessionCtx, options));
  1179→  } catch (err) {
  1180→    error(errors.failures.gatherSessionContext, err);
  1181→    process.exit(EXIT_CODES.ERROR);
  1182→  }
  1183→}
  1184→
  1185→/**
  1186→ * Read stdin if available (non-blocking check for hook input)
  1187→ */
  1188→async function readStdinIfAvailable(): Promise<string | null> {
  1189→  // Check if stdin is a TTY (interactive) - if so, don't try to read
  1190→  if (process.stdin.isTTY) {
  1191→    return null;
  1192→  }
  1193→
  1194→  return new Promise((resolve) => {
  1195→    let data = "";
  1196→    const timeout = setTimeout(() => {
  1197→      process.stdin.removeAllListeners();
  1198→      resolve(data || null);
  1199→    }, 100); // 100ms timeout for stdin
  1200→
  1201→    process.stdin.setEncoding("utf8");
  1202→    process.stdin.on("data", (chunk) => {
  1203→      data += chunk;
  1204→    });
  1205→    process.stdin.on("end", () => {
  1206→      clearTimeout(timeout);
  1207→      resolve(data || null);
  1208→    });
  1209→    process.stdin.on("error", () => {
  1210→      clearTimeout(timeout);
  1211→      resolve(null);
  1212→    });
  1213→    process.stdin.resume();
  1214→  });
  1215→}
  1216→
  1217→/**
  1218→ * Parse Claude Code hook input from stdin
  1219→ */
  1220→function parseHookInput(stdin: string | null): StopHookInput | null {
  1221→  if (!stdin) return null;
  1222→  try {
  1223→    return JSON.parse(stdin.trim()) as StopHookInput;
  1224→  } catch {
  1225→    return null;
  1226→  }
  1227→}
  1228→
  1229→// ─── Prompt Check (UserPromptSubmit Hook) ────────────────────────────────────
  1230→
  1231→/**
  1232→ * Output spec-first reminder for UserPromptSubmit hook.
  1233→ *
  1234→ * This is a simple context injection - always outputs the reminder,
  1235→ * and Claude (Opus) is smart enough to apply it when relevant.
  1236→ */
  1237→async function sessionPromptCheckAction(): Promise<void> {
  1238→  // Lean, instructive reminder with kspec prefix
  1239→  console.log(sessionPrompt.specCheck);
  1240→}
  1241→
  1242→async function sessionCheckpointAction(
  1243→  options: CheckpointOptions,
  1244→): Promise<void> {
  1245→  try {
  1246→    // Read stdin for Claude Code hook input
  1247→    const stdin = await readStdinIfAvailable();
  1248→    const hookInput = parseHookInput(stdin);
  1249→
  1250→    // Check if this is a retry (stop hook already active)
  1251→    if (hookInput?.stop_hook_active) {
  1252→      options.stopHookActive = true;
  1253→    }
  1254→
  1255→    const ctx = await initContext();
  1256→    const result = await performCheckpoint(ctx, options);
  1257→
  1258→    // Output format depends on mode:
  1259→    // - JSON mode (--json): Output Claude Code hook format {"decision": "block", "reason": "..."}
  1260→    // - Human mode: Output formatted checkpoint result
  1261→    if (isJsonMode()) {
  1262→      if (!result.ok) {
  1263→        // Build reason message with issues and instructions
  1264→        const issueLines = result.issues
  1265→          .map((i) => `- ${i.description}`)
  1266→          .join("\n");
  1267→        const instructionLines = result.instructions
  1268→          .filter((i) => i.trim())
  1269→          .join("\n");
  1270→        const reason = `${result.message}\n\nIssues:\n${issueLines}\n\n${instructionLines}`;
  1271→        console.log(JSON.stringify({ decision: "block", reason }));
  1272→      }
  1273→      // If ok, exit silently (Claude Code expects no output when allowing stop)
  1274→    } else {
  1275→      formatCheckpointResult(result);
  1276→      if (!result.ok) {
  1277→        process.exit(EXIT_CODES.ERROR);
  1278→      }
  1279→    }
  1280→  } catch (err) {
  1281→    // Handle RUNNING_FROM_SHADOW gracefully - skip with warning instead of erroring
  1282→    // This happens when the stop hook runs while cwd is inside .kspec/ directory
  1283→    if (err instanceof ShadowError && err.code === "RUNNING_FROM_SHADOW") {
  1284→      if (!isJsonMode()) {
  1285→        console.log(
  1286→          chalk.yellow(
  1287→            "[kspec] Session checkpoint skipped - running from inside .kspec/ directory",
  1288→          ),
  1289→        );
  1290→      }
  1291→      // Allow stop to proceed (exit successfully, no JSON output blocks the stop)
  1292→      return;
  1293→    }
  1294→    error(errors.failures.runCheckpoint, err);
  1295→    process.exit(EXIT_CODES.ERROR);
  1296→  }
  1297→}
  1298→
  1299→// ─── Session Log List ─────────────────────────────────────────────────────────
  1300→
  1301→interface SessionLogListOptions {
  1302→  status?: string;
  1303→  agent?: string;
  1304→  since?: string;
  1305→  sort?: string;
  1306→  count?: boolean;
  1307→  limit?: string;
  1308→}
  1309→
  1310→type SortField =
  1311→  | "started_at"
  1312→  | "duration"
  1313→  | "events"
  1314→  | "iterations"
  1315→  | "tasks_completed";
  1316→
  1317→const VALID_SORT_FIELDS: SortField[] = [
  1318→  "started_at",
  1319→  "duration",
  1320→  "events",
  1321→  "iterations",
  1322→  "tasks_completed",
  1323→];
  1324→
  1325→/**
  1326→ * Format a duration in milliseconds to a human-readable string.
  1327→ */
  1328→function formatDuration(ms: number): string {
  1329→  if (ms < 0) return "—";
  1330→  const totalSec = Math.floor(ms / 1000);
  1331→  const hours = Math.floor(totalSec / 3600);
  1332→  const minutes = Math.floor((totalSec % 3600) / 60);
  1333→  if (hours > 0) {
  1334→    return `${hours}h ${minutes}m`;
  1335→  }
  1336→  if (minutes > 0) {
  1337→    return `${minutes}m`;
  1338→  }
  1339→  return `${totalSec}s`;
  1340→}
  1341→
  1342→/**
  1343→ * Sort session summaries by the specified field.
  1344→ * Default: started_at descending.
  1345→ *
  1346→ * AC: @session-log-list ac-5
  1347→ */
  1348→function sortSessions(
  1349→  sessions: SessionLogSummary[],
  1350→  sortField: SortField,
  1351→): SessionLogSummary[] {
  1352→  return [...sessions].sort((a, b) => {
  1353→    switch (sortField) {
  1354→      case "started_at":
  1355→        return (
  1356→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  1357→        );
  1358→      case "duration":
  1359→        return b.duration_ms - a.duration_ms;
  1360→      case "events":
  1361→        return b.event_count - a.event_count;
  1362→      case "iterations":
  1363→        return b.iteration_count - a.iteration_count;
  1364→      case "tasks_completed":
  1365→        return b.tasks_completed - a.tasks_completed;
  1366→      default:
  1367→        return (
  1368→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  1369→        );
  1370→    }
  1371→  });
  1372→}
  1373→
  1374→/**
  1375→ * Format the session log list as a table.
  1376→ *
  1377→ * AC: @session-log-list ac-1
  1378→ */
  1379→function formatSessionLogList(sessions: SessionLogSummary[]): void {
  1380→  if (sessions.length === 0) {
  1381→    // AC: @session-log-list ac-6
  1382→    console.log("No sessions found.");
  1383→    return;
  1384→  }
  1385→
  1386→  // Table header
  1387→  console.log(
  1388→    chalk.gray(
  1389→      `${"ID".padEnd(10)} ${"Status".padEnd(11)} ${"Agent".padEnd(20)} ${"Started".padEnd(16)} ${"Duration".padEnd(10)} ${"Events".padEnd(8)} ${"Iters".padEnd(7)} Tasks`,
  1390→    ),
  1391→  );
  1392→  console.log(chalk.gray("─".repeat(95)));
  1393→
  1394→  for (const s of sessions) {
  1395→    const id = s.id.slice(0, 8);
  1396→    const statusColor =
  1397→      s.status === "completed"
  1398→        ? chalk.green
  1399→        : s.status === "active"
  1400→          ? chalk.blue
  1401→          : chalk.yellow;
  1402→    const status = statusColor(s.status.padEnd(11));
  1403→    const agent = s.agent_type.slice(0, 20).padEnd(20);
  1404→    const started = formatRelativeTime(new Date(s.started_at)).padEnd(16);
  1405→    const duration = formatDuration(s.duration_ms).padEnd(10);
  1406→    const events = String(s.event_count).padEnd(8);
  1407→    const iters = String(s.iteration_count).padEnd(7);
  1408→    const tasks = String(s.tasks_completed);
  1409→
  1410→    console.log(
  1411→      `${chalk.yellow(id)} ${status} ${chalk.gray(agent)} ${chalk.gray(started)} ${duration} ${events} ${iters} ${tasks}`,
  1412→    );
  1413→  }
  1414→
  1415→  console.log(chalk.gray(`\n${sessions.length} session(s)`));
  1416→}
  1417→
  1418→/**
  1419→ * Session log list action handler.
  1420→ */
  1421→async function sessionLogListAction(
  1422→  options: SessionLogListOptions,
  1423→): Promise<void> {
  1424→  try {
  1425→    const ctx = await initContext();
  1426→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
  1427→
  1428→    // AC: @session-log-list ac-2 - Filter by status
  1429→    if (options.status) {
  1430→      const statusFilter = options.status as SessionStatus;
  1431→      sessions = sessions.filter((s) => s.status === statusFilter);
  1432→    }
  1433→
  1434→    // AC: @session-log-list ac-4 - Filter by agent type
  1435→    if (options.agent) {
  1436→      const agentFilter = options.agent;
  1437→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
  1438→    }
  1439→
  1440→    // AC: @session-log-list ac-3 - Filter by since date
  1441→    if (options.since) {
  1442→      const sinceDate = parseTimeSpec(options.since);
  1443→      if (sinceDate) {
  1444→        sessions = sessions.filter(
  1445→          (s) => new Date(s.started_at) >= sinceDate,
  1446→        );
  1447→      }
  1448→    }
  1449→
  1450→    // AC: @session-log-list ac-5 - Sort
  1451→    const sortField: SortField =
  1452→      options.sort && VALID_SORT_FIELDS.includes(options.sort as SortField)
  1453→        ? (options.sort as SortField)
  1454→        : "started_at";
  1455→    sessions = sortSessions(sessions, sortField);
  1456→
  1457→    // AC: @session-log-list ac-7 - Limit output count
  1458→    if (options.count) {
  1459→      // AC: @trait-filterable-list ac-8
  1460→      output({ count: sessions.length }, () => {
  1461→        console.log(sessions.length);
  1462→      });
  1463→      return;
  1464→    }
  1465→
  1466→    // Apply --limit (after filtering/sorting, before display)
  1467→    if (options.limit) {
  1468→      const limit = parseInt(options.limit, 10);
  1469→      if (!Number.isNaN(limit) && limit > 0) {
  1470→        sessions = sessions.slice(0, limit);
  1471→      }
  1472→    }
  1473→
  1474→    output(sessions, () => formatSessionLogList(sessions));
  1475→  } catch (err) {
  1476→    error("Failed to list session logs", err);
  1477→    process.exit(EXIT_CODES.ERROR);
  1478→  }
  1479→}
  1480→
  1481→// ─── Session Log Show ─────────────────────────────────────────────────────────
  1482→
  1483→interface SessionLogShowOptions {
  1484→  events?: boolean;
  1485→  type?: string;
  1486→  limit?: string;
  1487→  context?: string;
  1488→}
  1489→
  1490→/**
  1491→ * Format an event timestamp as relative time from session start.
  1492→ */
  1493→function formatEventTimestamp(
  1494→  eventTs: number,
  1495→  sessionStartTs: number,
  1496→): string {
  1497→  const relativeMs = eventTs - sessionStartTs;
  1498→  const totalSec = Math.floor(relativeMs / 1000);
  1499→  const minutes = Math.floor(totalSec / 60);
  1500→  const seconds = totalSec % 60;
  1501→  if (minutes > 0) {
  1502→    return `+${minutes}m${seconds}s`;
  1503→  }
  1504→  return `+${seconds}s`;
  1505→}
  1506→
  1507→/**
  1508→ * Summarize event data for display.
  1509→ * Returns a short string describing the event payload.
  1510→ */
  1511→function summarizeEventData(event: SessionEvent): string {
  1512→  const data = event.data as Record<string, unknown> | null;
  1513→  if (!data) return "";
  1514→
  1515→  // Handle tool_call events
  1516→  if (event.type === "session.update") {
  1517→    const update = data.update as {
  1518→      sessionUpdate?: string;
  1519→      rawInput?: { command?: string };
  1520→      _meta?: { claudeCode?: { toolName?: string } };
  1521→    } | null;
  1522→    if (update?.sessionUpdate === "tool_call") {
  1523→      const toolName = update._meta?.claudeCode?.toolName || "unknown";
  1524→      const command = update.rawInput?.command;
  1525→      if (command) {
  1526→        const truncated =
  1527→          command.length > 60 ? command.slice(0, 57) + "..." : command;
  1528→        return `${toolName}: ${truncated}`;
  1529→      }
  1530→      return toolName;
  1531→    }
  1532→  }
  1533→
  1534→  // Handle prompt.sent events
  1535→  if (event.type === "prompt.sent") {
  1536→    const prompt = data.prompt as string | null;
  1537→    if (prompt) {
  1538→      const truncated =
  1539→        prompt.length > 60 ? prompt.slice(0, 57) + "..." : prompt;
  1540→      return truncated;
  1541→    }
  1542→  }
  1543→
  1544→  // Handle session.start/end
  1545→  if (event.type === "session.start") {
  1546→    return "Session started";
  1547→  }
  1548→  if (event.type === "session.end") {
  1549→    const reason = data.reason as string | null;
  1550→    return reason ? `Session ended: ${reason}` : "Session ended";
  1551→  }
  1552→
  1553→  // Default: show first key
  1554→  const keys = Object.keys(data);
  1555→  if (keys.length > 0) {
  1556→    return `{${keys.slice(0, 3).join(", ")}${keys.length > 3 ? ", ..." : ""}}`;
  1557→  }
  1558→  return "";
  1559→}
  1560→
  1561→/**
  1562→ * Format the session log show output.
  1563→ *
  1564→ * AC: @session-log-show ac-1
  1565→ */
  1566→function formatSessionLogShow(
  1567→  detail: SessionLogDetail,
  1568→  events: SessionEvent[] | null,
  1569→  contextSnapshot: unknown | null,
  1570→  sessionStartTs: number,
  1571→): void {
  1572→  // AC: @session-log-show ac-1 - Session metadata
  1573→  console.log(chalk.bold(`Session ${detail.id.slice(0, 8)}`));
  1574→  console.log(chalk.gray("─".repeat(60)));
  1575→  console.log(`  ID:        ${detail.id}`);
  1576→
  1577→  const statusColor =
  1578→    detail.status === "completed"
  1579→      ? chalk.green
  1580→      : detail.status === "active"
  1581→        ? chalk.blue
  1582→        : chalk.yellow;
  1583→  console.log(`  Status:    ${statusColor(detail.status)}`);
  1584→  console.log(`  Agent:     ${detail.agent_type}`);
  1585→  if (detail.task_id) {
  1586→    console.log(`  Task:      ${detail.task_id}`);
  1587→  }
  1588→  console.log(`  Started:   ${detail.started_at}`);
  1589→  if (detail.ended_at) {
  1590→    console.log(`  Ended:     ${detail.ended_at}`);
  1591→  }
  1592→  console.log(`  Duration:  ${formatDuration(detail.duration_ms)}`);
  1593→  console.log(`  Events:    ${detail.event_count}`);
  1594→  console.log(`  Iterations: ${detail.iteration_count}`);
  1595→
  1596→  // AC: @session-log-show ac-2 - Per-iteration summary
  1597→  if (detail.iterations.length > 0) {
  1598→    console.log("\n" + chalk.bold("Iterations"));
  1599→    console.log(chalk.gray("─".repeat(60)));
  1600→    for (const iter of detail.iterations) {
  1601→      const taskInfo: string[] = [];
  1602→      if (iter.tasks_started.length > 0) {
  1603→        taskInfo.push(`started: ${iter.tasks_started.join(", ")}`);
  1604→      }
  1605→      if (iter.tasks_completed.length > 0) {
  1606→        taskInfo.push(`completed: ${iter.tasks_completed.join(", ")}`);
  1607→      }
  1608→      const taskStr = taskInfo.length > 0 ? ` | ${taskInfo.join(" | ")}` : "";
  1609→      console.log(
  1610→        `  ${chalk.cyan(`[${iter.iteration}]`)} ${iter.event_count} events${taskStr}`,
  1611→      );
  1612→    }
  1613→  }
  1614→
  1615→  // AC: @session-log-show ac-3 - Event timeline
  1616→  if (events !== null) {
  1617→    console.log("\n" + chalk.bold("Events"));
  1618→    console.log(chalk.gray("─".repeat(60)));
  1619→    if (events.length === 0) {
  1620→      console.log(chalk.gray("  No events to display."));
  1621→    } else {
  1622→      for (const event of events) {
  1623→        const timestamp = formatEventTimestamp(event.ts, sessionStartTs);
  1624→        const summary = summarizeEventData(event);
  1625→        const typeColor =
  1626→          event.type === "session.start" || event.type === "session.end"
  1627→            ? chalk.green
  1628→            : event.type === "session.update"
  1629→              ? chalk.blue
  1630→              : chalk.gray;
  1631→        console.log(
  1632→          `  ${chalk.yellow(timestamp.padEnd(10))} ${typeColor(event.type.padEnd(16))} ${chalk.gray(summary)}`,
  1633→        );
  1634→      }
  1635→    }
  1636→  }
  1637→
  1638→  // AC: @session-log-show ac-6 - Context snapshot
  1639→  if (contextSnapshot !== null) {
  1640→    console.log("\n" + chalk.bold("Context Snapshot"));
  1641→    console.log(chalk.gray("─".repeat(60)));
  1642→    console.log(JSON.stringify(contextSnapshot, null, 2));
  1643→  }
  1644→}
  1645→
  1646→/**
  1647→ * Session log show action handler.
  1648→ */
  1649→async function sessionLogShowAction(
  1650→  sessionRef: string,
  1651→  options: SessionLogShowOptions,
  1652→): Promise<void> {
  1653→  try {
  1654→    const ctx = await initContext();
  1655→
  1656→    // AC: @session-log-show ac-7, ac-8, ac-9 - Resolve session ID
  1657→    const resolution = await resolveSessionId(ctx.specDir, sessionRef);
  1658→
  1659→    if (!resolution.ok) {
  1660→      if (resolution.error === "not_found") {
  1661→        // AC: @session-log-show ac-9
  1662→        error(`Session not found: ${sessionRef}`);
  1663→        process.exit(EXIT_CODES.NOT_FOUND);
  1664→      } else {
  1665→        // AC: @session-log-show ac-8
  1666→        error(
  1667→          `Ambiguous session ID prefix. Matches:\n  ${resolution.matches.join("\n  ")}\nPlease provide a more specific prefix.`,
  1668→        );
  1669→        process.exit(EXIT_CODES.VALIDATION_FAILED);
  1670→      }
  1671→    }
  1672→
  1673→    const sessionId = resolution.id;
  1674→
  1675→    // Get session detail
  1676→    const detail = await getSessionLogDetail(ctx.specDir, sessionId);
  1677→    if (!detail) {
  1678→      error(`Session not found: ${sessionId}`);
  1679→      process.exit(EXIT_CODES.NOT_FOUND);
  1680→    }
  1681→
  1682→    // AC: @session-log-show ac-3, ac-4, ac-5 - Event timeline
  1683→    let events: SessionEvent[] | null = null;
  1684→    if (options.events) {
  1685→      let allEvents = await readEvents(ctx.specDir, sessionId);
  1686→
  1687→      // AC: @session-log-show ac-4 - Filter by type
  1688→      if (options.type) {
  1689→        const typeFilter = options.type;
  1690→        allEvents = allEvents.filter((e) => e.type === typeFilter);
  1691→      }
  1692→
  1693→      // AC: @session-log-show ac-5 - Limit to last N events
  1694→      if (options.limit) {
  1695→        const limit = parseInt(options.limit, 10);
  1696→        if (!Number.isNaN(limit) && limit > 0) {
  1697→          allEvents = allEvents.slice(-limit);
  1698→        }
  1699→      }
  1700→
  1701→      events = allEvents;
  1702→    }
  1703→
  1704→    // AC: @session-log-show ac-6 - Context snapshot
  1705→    let contextSnapshot: unknown | null = null;
  1706→    if (options.context) {
  1707→      const iterNum = parseInt(options.context, 10);
  1708→      if (!Number.isNaN(iterNum) && iterNum > 0) {
  1709→        contextSnapshot = await readSessionContext(
  1710→          ctx.specDir,
  1711→          sessionId,
  1712→          iterNum,
  1713→        );
  1714→        if (contextSnapshot === null) {
  1715→          error(`No context snapshot found for iteration ${iterNum}`);
  1716→          process.exit(EXIT_CODES.NOT_FOUND);
  1717→        }
  1718→      } else {
  1719→        error(`Invalid iteration number: ${options.context}`);
  1720→        process.exit(EXIT_CODES.USAGE_ERROR);
  1721→      }
  1722→    }
  1723→
  1724→    const sessionStartTs = new Date(detail.started_at).getTime();
  1725→
  1726→    // Build JSON output structure
  1727→    const jsonOutput = {
  1728→      ...detail,
  1729→      ...(events !== null ? { events } : {}),
  1730→      ...(contextSnapshot !== null ? { context: contextSnapshot } : {}),
  1731→    };
  1732→
  1733→    output(jsonOutput, () =>
  1734→      formatSessionLogShow(detail, events, contextSnapshot, sessionStartTs),
  1735→    );
  1736→  } catch (err) {
  1737→    error("Failed to show session log", err);
  1738→    process.exit(EXIT_CODES.ERROR);
  1739→  }
  1740→}
  1741→
  1742→// ─── Session Log Stats ─────────────────────────────────────────────────────────
  1743→
  1744→interface SessionLogStatsOptions {
  1745→  since?: string;
  1746→  agent?: string;
  1747→  toolUsage?: boolean;
  1748→  byDay?: boolean;
  1749→  byWeek?: boolean;
  1750→}
  1751→
  1752→/**
  1753→ * Full stats output including optional tool usage and time period data.
  1754→ */
  1755→interface SessionLogStatsOutput {
  1756→  stats: SessionLogStats;
  1757→  tool_usage?: ToolUsageStats[];
  1758→  time_periods?: TimePeriodStats[];
  1759→}
  1760→
  1761→/**
  1762→ * Format a duration in milliseconds to human-readable format.
  1763→ * Reuses formatDuration from session log list but handles hours/minutes/seconds.
  1764→ */
  1765→function formatDurationLong(ms: number): string {
  1766→  if (ms < 0) return "—";
  1767→  const totalSec = Math.floor(ms / 1000);
  1768→  const hours = Math.floor(totalSec / 3600);
  1769→  const minutes = Math.floor((totalSec % 3600) / 60);
  1770→  const seconds = totalSec % 60;
  1771→  if (hours > 0 && minutes > 0) {
  1772→    return `${hours}h ${minutes}m`;
  1773→  }
  1774→  if (hours > 0) {
  1775→    return `${hours}h`;
  1776→  }
  1777→  if (minutes > 0) {
  1778→    return `${minutes}m ${seconds}s`;
  1779→  }
  1780→  return `${seconds}s`;
  1781→}
  1782→
  1783→/**
  1784→ * Format the session log stats output.
  1785→ *
  1786→ * AC: @session-log-stats ac-1, ac-2, ac-3
  1787→ */
  1788→function formatSessionLogStats(
  1789→  stats: SessionLogStats,
  1790→  toolUsage: ToolUsageStats[] | null,
  1791→  timePeriods: TimePeriodStats[] | null,
  1792→  groupBy: "day" | "week" | null,
  1793→): void {
  1794→  // AC: @session-log-stats ac-1 - Totals
  1795→  console.log(chalk.bold("Session Statistics"));
  1796→  console.log(chalk.gray("─".repeat(50)));
  1797→  console.log(`  Total Sessions:     ${stats.total_sessions}`);
  1798→  console.log(`  Total Events:       ${stats.total_events}`);
  1799→  console.log(`  Total Iterations:   ${stats.total_iterations}`);
  1800→  console.log(`  Tasks Completed:    ${stats.total_tasks_completed}`);
  1801→  console.log(`  Total Duration:     ${formatDurationLong(stats.total_duration_ms)}`);
  1802→
  1803→  // AC: @session-log-stats ac-2 - Averages
  1804→  console.log("\n" + chalk.bold("Averages"));
  1805→  console.log(chalk.gray("─".repeat(50)));
  1806→  console.log(`  Avg Duration/Session:     ${formatDurationLong(stats.avg_duration_ms)}`);
  1807→  console.log(`  Avg Iterations/Session:   ${stats.avg_iterations_per_session}`);
  1808→  console.log(`  Avg Tasks/Session:        ${stats.avg_tasks_per_session}`);
  1809→
  1810→  // AC: @session-log-stats ac-3 - Status breakdown
  1811→  if (stats.status_breakdown.length > 0) {
  1812→    console.log("\n" + chalk.bold("Status Breakdown"));
  1813→    console.log(chalk.gray("─".repeat(50)));
  1814→    for (const item of stats.status_breakdown) {
  1815→      const statusColor =
  1816→        item.status === "completed"
  1817→          ? chalk.green
  1818→          : item.status === "active"
  1819→            ? chalk.blue
  1820→            : chalk.yellow;
  1821→      console.log(
  1822→        `  ${statusColor(item.status.padEnd(12))} ${String(item.count).padEnd(6)} ${item.percentage}%`,
  1823→      );
  1824→    }
  1825→  }
  1826→
  1827→  // AC: @session-log-stats ac-6 - Tool usage
  1828→  if (toolUsage !== null && toolUsage.length > 0) {
  1829→    console.log("\n" + chalk.bold("Top Tool Usage"));
  1830→    console.log(chalk.gray("─".repeat(50)));
  1831→    for (const tool of toolUsage) {
  1832→      console.log(
  1833→        `  ${tool.tool_name.padEnd(20)} ${String(tool.count).padEnd(8)} ${tool.percentage}%`,
  1834→      );
  1835→    }
  1836→  }
  1837→
  1838→  // AC: @session-log-stats ac-7 - Time periods
  1839→  if (timePeriods !== null && timePeriods.length > 0) {
  1840→    const label = groupBy === "week" ? "By Week" : "By Day";
  1841→    console.log("\n" + chalk.bold(label));
  1842→    console.log(chalk.gray("─".repeat(50)));
  1843→    console.log(
  1844→      chalk.gray(
  1845→        `  ${"Period".padEnd(14)} ${"Sessions".padEnd(10)} ${"Tasks".padEnd(8)} Duration`,
  1846→      ),
  1847→    );
  1848→    for (const period of timePeriods) {
  1849→      console.log(
  1850→        `  ${period.period.padEnd(14)} ${String(period.sessions_count).padEnd(10)} ${String(period.tasks_completed).padEnd(8)} ${formatDurationLong(period.total_duration_ms)}`,
  1851→      );
  1852→    }
  1853→  }
  1854→}
  1855→
  1856→/**
  1857→ * Session log stats action handler.
  1858→ */
  1859→async function sessionLogStatsAction(
  1860→  options: SessionLogStatsOptions,
  1861→): Promise<void> {
  1862→  try {
  1863→    const ctx = await initContext();
  1864→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
  1865→
  1866→    // AC: @session-log-stats ac-4 - Filter by since
  1867→    if (options.since) {
  1868→      const sinceDate = parseTimeSpec(options.since);
  1869→      if (sinceDate) {
  1870→        sessions = sessions.filter(
  1871→          (s) => new Date(s.started_at) >= sinceDate,
  1872→        );
  1873→      }
  1874→    }
  1875→
  1876→    // AC: @session-log-stats ac-5 - Filter by agent type
  1877→    if (options.agent) {
  1878→      const agentFilter = options.agent;
  1879→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
  1880→    }
  1881→
  1882→    // AC: @session-log-stats ac-8 - No sessions match criteria
  1883→    if (sessions.length === 0) {
  1884→      output({ message: "No sessions match criteria" }, () => {
  1885→        console.log("No sessions match criteria.");
  1886→      });
  1887→      return;
  1888→    }
  1889→
  1890→    // Compute base stats
  1891→    const stats = computeSessionLogStats(sessions);
  1892→
  1893→    // AC: @session-log-stats ac-6 - Tool usage (optional)
  1894→    let toolUsage: ToolUsageStats[] | null = null;
  1895→    if (options.toolUsage) {
  1896→      const sessionIds = sessions.map((s) => s.id);
  1897→      toolUsage = await computeToolUsageStats(ctx.specDir, sessionIds);
  1898→    }
  1899→
  1900→    // AC: @session-log-stats ac-7 - Time periods (optional)
  1901→    let timePeriods: TimePeriodStats[] | null = null;
  1902→    let groupBy: "day" | "week" | null = null;
  1903→    if (options.byDay) {
  1904→      groupBy = "day";
  1905→      timePeriods = computeTimePeriodStats(sessions, "day");
  1906→    } else if (options.byWeek) {
  1907→      groupBy = "week";
  1908→      timePeriods = computeTimePeriodStats(sessions, "week");
  1909→    }
  1910→
  1911→    // Build output structure
  1912→    const jsonOutput: SessionLogStatsOutput = { stats };
  1913→    if (toolUsage !== null) {
  1914→      jsonOutput.tool_usage = toolUsage;
  1915→    }
  1916→    if (timePeriods !== null) {
  1917→      jsonOutput.time_periods = timePeriods;
  1918→    }
  1919→
  1920→    output(jsonOutput, () =>
  1921→      formatSessionLogStats(stats, toolUsage, timePeriods, groupBy),
  1922→    );
  1923→  } catch (err) {
  1924→    error("Failed to compute session log stats", err);
  1925→    process.exit(EXIT_CODES.ERROR);
  1926→  }
  1927→}
  1928→
  1929→// ─── Session Log Search ─────────────────────────────────────────────────────────
  1930→
  1931→interface SessionLogSearchOptions {
  1932→  type?: string;
  1933→  since?: string;
  1934→  agent?: string;
  1935→  limit?: string;
  1936→}
  1937→
  1938→/**
  1939→ * Format relative timestamp from event timestamp (Unix ms) to session start.
  1940→ */
  1941→function formatSearchTimestamp(eventTs: number): string {
  1942→  return new Date(eventTs).toISOString();
  1943→}
  1944→
  1945→/**
  1946→ * Format the session log search output.
  1947→ *
  1948→ * AC: @session-log-search ac-1, ac-4
  1949→ */
  1950→function formatSessionLogSearch(results: SessionSearchResult[]): void {
  1951→  if (results.length === 0) {
  1952→    // AC: @session-log-search ac-6
  1953→    console.log("No matches found.");
  1954→    return;
  1955→  }
  1956→
  1957→  let totalMatches = 0;
  1958→  for (const session of results) {
  1959→    totalMatches += session.matches.length;
  1960→  }
  1961→
  1962→  console.log(chalk.bold(`Found ${totalMatches} match(es) in ${results.length} session(s)`));
  1963→  console.log(chalk.gray("─".repeat(60)));
  1964→
  1965→  for (const session of results) {
  1966→    // Session header
  1967→    console.log(
  1968→      `\n${chalk.cyan(`Session ${session.session_id.slice(0, 8)}`)} ` +
  1969→        `${chalk.gray(`(${session.agent_type}, started ${formatRelativeTime(new Date(session.started_at))})`)}`
  1970→    );
  1971→
  1972→    // AC: @session-log-search ac-4 - Show matches with session ID, timestamp, type, excerpt
  1973→    for (const match of session.matches) {
  1974→      const ts = formatSearchTimestamp(match.timestamp);
  1975→      const typeColor =
  1976→        match.event_type === "session.start" || match.event_type === "session.end"
  1977→          ? chalk.green
  1978→          : match.event_type === "session.update"
  1979→            ? chalk.blue
  1980→            : chalk.gray;
  1981→      console.log(
  1982→        `  ${chalk.yellow(ts)} ${typeColor(match.event_type.padEnd(16))}`,
  1983→      );
  1984→      // Content excerpt on next line, indented
  1985→      console.log(`    ${chalk.gray(match.content_excerpt)}`);
  1986→    }
  1987→  }
  1988→}
  1989→
  1990→/**
  1991→ * Session log search action handler.
  1992→ *
  1993→ * AC: @session-log-search ac-1 through ac-7
  1994→ */
  1995→async function sessionLogSearchAction(
  1996→  pattern: string,
  1997→  options: SessionLogSearchOptions,
  1998→): Promise<void> {
  1999→  try {
  2000→    const ctx = await initContext();
  2001→
  2002→    // Parse options - validate limit as positive integer
  2003→    let limit = 50;
  2004→    if (options.limit) {
  2005→      const parsed = parseInt(options.limit, 10);
  2006→      if (Number.isNaN(parsed) || parsed <= 0) {
  2007→        error(`Invalid limit: ${options.limit}. Must be a positive integer.`);
  2008→        process.exit(EXIT_CODES.USAGE_ERROR);
  2009→      }
  2010→      limit = parsed;
  2011→    }
  2012→    const sinceDate = options.since ? parseTimeSpec(options.since) : undefined;
  2013→
  2014→    // AC: @session-log-search ac-1, ac-2, ac-3, ac-5, ac-7
  2015→    const results = await searchSessionEvents(ctx.specDir, pattern, {
  2016→      eventType: options.type,
  2017→      sinceDate: sinceDate || undefined,
  2018→      agentType: options.agent,
  2019→      limit,
  2020→    });
  2021→
  2022→    // AC: @session-log-search ac-6 - No matches found message
  2023→    // exit code 0 regardless (per @trait-semantic-exit-codes ac-5)
  2024→
  2025→    output(results, () => formatSessionLogSearch(results));
  2026→  } catch (err) {
  2027→    error("Failed to search session logs", err);
  2028→    process.exit(EXIT_CODES.ERROR);
  2029→  }
  2030→}
  2031→
  2032→/**
  2033→ * Register the 'session' command group and aliases
  2034→ */
  2035→export function registerSessionCommands(program: Command): void {
  2036→  const session = program
  2037→    .command("session")
  2038→    .description("Session management and context");
  2039→
  2040→  session
  2041→    .command("start")
  2042→    .alias("resume")
  2043→    .description("Surface relevant context for starting a new working session")
  2044→    .option("--brief", "Compact summary (default)")
  2045→    .option("--full", "Comprehensive context dump")
  2046→    .option(
  2047→      "--since <time>",
  2048→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  2049→    )
  2050→    .option("--no-git", "Skip git commit information")
  2051→    .option("-n, --limit <n>", "Limit items per section", "10")
  2052→    .action(sessionStartAction);
  2053→
  2054→  // Session log subcommand group
  2055→  const log = session
  2056→    .command("log")
  2057→    .description("Session log analysis commands");
  2058→
  2059→  log
  2060→    .command("list")
  2061→    .description("List session logs with summary statistics")
  2062→    .option(
  2063→      "-s, --status <status>",
  2064→      "Filter by status (active, completed, abandoned)",
  2065→    )
  2066→    .option("--agent <type>", "Filter by agent type")
  2067→    .option(
  2068→      "--since <time>",
  2069→      "Only show sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2070→    )
  2071→    .option(
  2072→      "--sort <field>",
  2073→      "Sort by field (started_at, duration, events, iterations, tasks_completed)",
  2074→      "started_at",
  2075→    )
  2076→    .option("--count", "Show only the count of matching sessions")
  2077→    .option("-n, --limit <n>", "Limit number of sessions shown")
  2078→    .action(sessionLogListAction);
  2079→
  2080→  log
  2081→    .command("show <session-id>")
  2082→    .description("Show detailed view of a single session")
  2083→    .option("-e, --events", "Include chronological event timeline")
  2084→    .option("-t, --type <type>", "Filter events by type (e.g., tool.call)")
  2085→    .option("-n, --limit <n>", "Show only the last N events")
  2086→    .option("-c, --context <n>", "Show context snapshot for iteration N")
  2087→    .action(sessionLogShowAction);
  2088→
  2089→  log
  2090→    .command("stats")
  2091→    .description("Aggregate analytics across sessions")
  2092→    .option(
  2093→      "--since <time>",
  2094→      "Only include sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2095→    )
  2096→    .option("--agent <type>", "Only include sessions with this agent type")
  2097→    .option("--tool-usage", "Display top 10 tool calls by frequency")
  2098→    .option("--by-day", "Group stats by day")
  2099→    .option("--by-week", "Group stats by week")
  2100→    .action(sessionLogStatsAction);
  2101→
  2102→  log
  2103→    .command("search <pattern>")
  2104→    .description("Search across session events by content")
  2105→    .option("-t, --type <type>", "Only search events of this type (e.g., session.update)")
  2106→    .option(
  2107→      "--since <time>",
  2108→      "Only search sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2109→    )
  2110→    .option("--agent <type>", "Only search sessions with this agent type")
  2111→    .option("-n, --limit <n>", "Maximum matches to return (default: 50)")
  2112→    .action(sessionLogSearchAction);
  2113→
  2114→  session
  2115→    .command("checkpoint")
  2116→    .description(
  2117→      "Pre-stop hook: check for uncommitted work before ending session",
  2118→    )
  2119→    .option("--force", "Allow session end regardless of issues")
  2120→    .action(sessionCheckpointAction);
  2121→
  2122→  session
  2123→    .command("prompt-check")
  2124→    .description("UserPromptSubmit hook: inject spec-first reminder")
  2125→    .action(sessionPromptCheckAction);
  2126→
  2127→  // Top-level alias: kspec context
  2128→  program
  2129→    .command("context")
  2130→    .description("Alias for session start - surface session context")
  2131→    .option("--brief", "Compact summary (default)")
  2132→    .option("--full", "Comprehensive context dump")
  2133→    .option(
  2134→      "--since <time>",
  2135→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  2136→    )
  2137→    .option("--no-git", "Skip git commit information")
  2138→    .option("-n, --limit <n>", "Limit items per section", "10")
  2139→    .action(sessionStartAction);
  2140→}
  2141→

