   302→
   303→  // AC: @unified-cross-reference-lookup ac-task-spec-ref
   304→  it('should show tasks with spec_ref pointing to target', async () => {
   305→    const result = kspecJson<{ tasks_spec_ref?: { ref: string; title: string }[]; total: number }>(
   306→      'refs @test-core',
   307→      tempDir
   308→    );
   309→
   310→    expect(result.tasks_spec_ref).toBeDefined();
   311→    expect(result.tasks_spec_ref!.length).toBeGreaterThanOrEqual(2);
   312→    const titles = result.tasks_spec_ref!.map(r => r.title);
   313→    expect(titles).toContain('Task 1 (for test-core)');
   314→    expect(titles).toContain('Task 2 (for test-core)');
   315→  });
   316→
