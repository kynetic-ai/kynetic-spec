   451→  // AC: @unified-cross-reference-lookup ac-ref-resolution
   452→  it('should support ULID, slug, and short ULID reference formats', async () => {
   453→    // Test with slug
   454→    const bySlug = kspecJson<{ total: number }>('refs @spec-a', tempDir);
   455→    expect(bySlug.total).toBeGreaterThan(0);
