```
     1→import chalk from "chalk";
     2→import { stringify as yamlStringify } from "yaml";
     3→import type { ReferenceIndex } from "../parser/index.js";
     4→import type { Note, Task, TaskStatus } from "../schema/index.js";
     5→import { fieldLabels, sectionHeaders, summaries } from "../strings/labels.js";
     6→import { formatMatchedFields, grepItem } from "../utils/grep.js";
     7→
     8→/**
     9→ * Check if a note has been superseded by another note.
    10→ * A note is superseded if its ULID appears in any other note's `supersedes` field.
    11→ */
    12→export function isNoteSuperseded(note: Note, allNotes: Note[]): boolean {
    13→  return allNotes.some((n) => n.supersedes === note._ulid);
    14→}
    15→
    16→/**
    17→ * Filter notes to exclude superseded ones.
    18→ * Returns only notes that have not been superseded.
    19→ */
    20→export function filterSupersededNotes(notes: Note[]): Note[] {
    21→  return notes.filter((note) => !isNoteSuperseded(note, notes));
    22→}
    23→
    24→/**
    25→ * Annotate notes with superseded status for JSON output.
    26→ * Adds a computed `superseded` field to each note.
    27→ */
    28→export function annotateNotesWithSuperseded(
    29→  notes: Note[],
    30→): Array<Note & { superseded: boolean }> {
    31→  return notes.map((note) => ({
    32→    ...note,
    33→    superseded: isNoteSuperseded(note, notes),
    34→  }));
    35→}
    36→
    37→/**
    38→ * Output options
    39→ */
    40→export interface OutputOptions {
    41→  json?: boolean;
    42→}
    43→
    44→/**
    45→ * Output format types
    46→ * AC: @output-format-option
    47→ */
    48→export type OutputFormat = "text" | "json" | "yaml";
    49→
    50→/**
    51→ * Valid format values for --format option
    52→ */
    53→export const VALID_FORMATS = ["json", "yaml"] as const;
    54→
    55→/**
    56→ * Global output format (set by --json, --yaml, --raw, or --format flags)
    57→ * AC: @output-format-option ac-format-json, ac-format-yaml
    58→ */
    59→let globalOutputFormat: OutputFormat = "text";
    60→
    61→export function setOutputFormat(format: OutputFormat): void {
    62→  globalOutputFormat = format;
    63→}
    64→
    65→export function getOutputFormat(): OutputFormat {
    66→  return globalOutputFormat;
    67→}
    68→
    69→/**
    70→ * Set JSON mode (for backward compatibility)
    71→ * AC: @output-format-option ac-json-shorthand
    72→ */
    73→export function setJsonMode(enabled: boolean): void {
    74→  if (enabled) {
    75→    globalOutputFormat = "json";
    76→  } else if (globalOutputFormat === "json") {
    77→    globalOutputFormat = "text";
    78→  }
    79→}
    80→
    81→/**
    82→ * Check if JSON mode is active
    83→ * AC: @output-format-option ac-json-shorthand
    84→ */
    85→export function isJsonMode(): boolean {
    86→  return globalOutputFormat === "json";
    87→}
    88→
    89→/**
    90→ * Set YAML mode
    91→ * AC: @output-format-option ac-format-yaml, ac-yaml-shorthand
    92→ */
    93→export function setYamlMode(enabled: boolean): void {
    94→  if (enabled) {
    95→    globalOutputFormat = "yaml";
    96→  } else if (globalOutputFormat === "yaml") {
    97→    globalOutputFormat = "text";
    98→  }
    99→}
   100→
   101→/**
   102→ * Check if YAML mode is active
   103→ * AC: @output-format-option ac-format-yaml
   104→ */
   105→export function isYamlMode(): boolean {
   106→  return globalOutputFormat === "yaml";
   107→}
   108→
   109→/**
   110→ * Check if any structured output mode is active (JSON or YAML)
   111→ * AC: @output-format-option ac-yaml-no-ansi, ac-yaml-references
   112→ */
   113→export function isStructuredMode(): boolean {
   114→  return globalOutputFormat === "json" || globalOutputFormat === "yaml";
   115→}
   116→
   117→/**
   118→ * Global verbose mode (set by --verbose flag)
   119→ */
   120→let globalVerboseMode = false;
   121→
   122→export function setVerboseMode(enabled: boolean): void {
   123→  globalVerboseMode = enabled;
   124→}
   125→
   126→export function getVerboseMode(): boolean {
   127→  return globalVerboseMode;
   128→}
   129→
   130→/**
   131→ * Output data - JSON/YAML if structured mode, otherwise formatted
   132→ * AC: @output-format-option ac-format-json, ac-format-yaml
   133→ */
   134→export function output(data: unknown, formatter?: () => void): void {
   135→  if (globalOutputFormat === "json") {
   136→    console.log(JSON.stringify(data, null, 2));
   137→  } else if (globalOutputFormat === "yaml") {
   138→    console.log(yamlStringify(data, { indent: 2 }));
   139→  } else if (formatter) {
   140→    formatter();
   141→  } else {
   142→    console.log(data);
   143→  }
   144→}
   145→
   146→/**
   147→ * Output success message
   148→ * AC: @output-format-option ac-format-json, ac-format-yaml
   149→ */
   150→export function success(message: string, data?: Record<string, unknown>): void {
   151→  if (globalOutputFormat === "json") {
   152→    console.log(JSON.stringify({ success: true, message, ...data }));
   153→  } else if (globalOutputFormat === "yaml") {
   154→    console.log(yamlStringify({ success: true, message, ...data }, { indent: 2 }));
   155→  } else {
   156→    console.log(chalk.green("OK"), message);
   157→  }
   158→}
   159→
   160→/**
   161→ * Output error message
   162→ * AC: @output-format-option ac-format-json, ac-format-yaml
   163→ */
   164→export function error(message: string, details?: unknown): void {
   165→  if (globalOutputFormat === "json") {
   166→    console.error(JSON.stringify({ success: false, error: message, details }));
   167→  } else if (globalOutputFormat === "yaml") {
   168→    console.error(yamlStringify({ success: false, error: message, details }, { indent: 2 }));
   169→  } else {
   170→    console.error(chalk.red("✗"), message);
   171→    if (details) {
   172→      console.error(chalk.gray(String(details)));
   173→      // Show suggestion if it's a ShadowError with a suggestion
   174→      if (details && typeof details === "object" && "suggestion" in details) {
   175→        const suggestion = (details as { suggestion?: string }).suggestion;
   176→        if (suggestion) {
   177→          console.error(chalk.yellow("  Suggestion:"), suggestion);
   178→        }
   179→      }
   180→    }
   181→  }
   182→}
   183→
   184→/**
   185→ * Output warning message
   186→ * AC: @output-format-option ac-yaml-no-ansi
   187→ */
   188→export function warn(message: string): void {
   189→  if (isStructuredMode()) {
   190→    // Warnings are suppressed in structured output modes
   191→  } else {
   192→    console.warn(chalk.yellow("⚠"), message);
   193→  }
   194→}
   195→
   196→/**
   197→ * Output info message
   198→ * AC: @output-format-option ac-yaml-no-ansi
   199→ */
   200→export function info(message: string): void {
   201→  if (isStructuredMode()) {
   202→    // Info messages suppressed in structured output modes
   203→  } else {
   204→    console.log(chalk.blue("ℹ"), message);
   205→  }
   206→}
   207→
   208→/**
   209→ * Get color for task status
   210→ */
   211→function statusColor(status: TaskStatus): (text: string) => string {
   212→  switch (status) {
   213→    case "pending":
   214→      return (t: string) => chalk.gray(t);
   215→    case "in_progress":
   216→      return (t: string) => chalk.blue(t);
   217→    case "blocked":
   218→      return (t: string) => chalk.red(t);
   219→    case "completed":
   220→      return (t: string) => chalk.green(t);
   221→    case "cancelled":
   222→      return (t: string) => chalk.strikethrough.gray(t);
   223→    default:
   224→      return (t: string) => chalk.white(t);
   225→  }
   226→}
   227→
   228→/**
   229→ * Format a task reference (short ULID + slug if available)
   230→ * @param task The task to format
   231→ * @param index Optional ReferenceIndex for dynamic short ULID computation
   232→ */
   233→export function formatTaskRef(task: Task, index?: ReferenceIndex): string {
   234→  const shortId = index ? index.shortUlid(task._ulid) : task._ulid.slice(0, 8);
   235→  if (task.slugs.length > 0) {
   236→    return `${shortId} (${task.slugs[0]})`;
   237→  }
   238→  return shortId;
   239→}
   240→
   241→/**
   242→ * Format task for display
   243→ */
   244→export function formatTask(
   245→  task: Task,
   246→  verbose = false,
   247→  index?: ReferenceIndex,
   248→  full = false,
   249→): string {
   250→  const ref = formatTaskRef(task, index);
   251→  const status = statusColor(task.status)(`[${task.status}]`);
   252→  const priority =
   253→    task.priority <= 2
   254→      ? chalk.red(`P${task.priority}`)
   255→      : chalk.gray(`P${task.priority}`);
   256→
   257→  let line = `${ref} ${status} ${priority} ${task.title}`;
   258→
   259→  if (verbose && !full) {
   260→    // AC: @task-list-verbose ac-2 - Single verbose (-v) shows current behavior
   261→    if (task.spec_ref) {
   262→      line += chalk.gray(` (spec: ${task.spec_ref})`);
   263→    }
   264→    if (task.depends_on.length > 0) {
   265→      line += chalk.gray(` deps: [${task.depends_on.join(", ")}]`);
   266→    }
   267→    if (task.tags.length > 0) {
   268→      line += chalk.cyan(` #${task.tags.join(" #")}`);
   269→    }
   270→  }
   271→
   272→  return line;
   273→}
   274→
   275→/**
   276→ * Get first line of text, truncated to max length
   277→ */
   278→function getFirstLine(
   279→  text: string | undefined,
   280→  maxLength: number = 70,
   281→): string | undefined {
   282→  if (!text) return undefined;
   283→  const firstLine = text.split("\n")[0].trim();
   284→  if (firstLine.length <= maxLength) return firstLine;
   285→  return `${firstLine.slice(0, maxLength - 3)}...`;
   286→}
   287→
   288→/**
   289→ * Format full mode context for a task (AC-1, AC-3, AC-5)
   290→ */
   291→function formatFullModeContext(task: Task, index?: ReferenceIndex): void {
   292→  const indent = "    ";
   293→
   294→  // Show timestamps (AC-1)
   295→  console.log(chalk.gray(`${indent}Created: ${task.created_at}`));
   296→  if (task.started_at) {
   297→    console.log(chalk.gray(`${indent}Started: ${task.started_at}`));
   298→  }
   299→  if (task.completed_at) {
   300→    console.log(chalk.gray(`${indent}Completed: ${task.completed_at}`));
   301→  }
   302→
   303→  // Show notes count and most recent note (AC-1, AC-3)
   304→  if (task.notes && task.notes.length > 0) {
   305→    const mostRecent = task.notes[task.notes.length - 1];
   306→    const preview = getFirstLine(mostRecent.content, 50);
   307→    console.log(
   308→      chalk.gray(`${indent}Notes: ${task.notes.length} (latest: "${preview}")`),
   309→    );
   310→  }
   311→
   312→  // Show pending todos count (AC-1, AC-3)
   313→  if (task.todos && task.todos.length > 0) {
   314→    const pendingCount = task.todos.filter((t) => !t.done).length;
   315→    if (pendingCount > 0) {
   316→      console.log(chalk.gray(`${indent}Pending todos: ${pendingCount}`));
   317→    }
   318→  }
   319→
   320→  // Show spec context (AC-5)
   321→  if (task.spec_ref && index) {
   322→    const result = index.resolve(task.spec_ref);
   323→    if (result.ok) {
   324→      const spec = result.item;
   325→      const specName =
   326→        "title" in spec
   327→          ? spec.title
   328→          : "name" in spec
   329→            ? spec.name
   330→            : "id" in spec
   331→              ? spec.id
   332→              : task.spec_ref;
   333→      console.log(chalk.gray(`${indent}Spec: ${task.spec_ref}`));
   334→      console.log(chalk.cyan(`${indent}  ${specName}`));
   335→
   336→      // Show spec description if available
   337→      if ("description" in spec && spec.description) {
   338→        const descPreview = getFirstLine(spec.description as string, 70);
   339→        console.log(chalk.gray(`${indent}  ${descPreview}`));
   340→      }
   341→
   342→      // Show acceptance criteria if available
   343→      if (
   344→        "acceptance_criteria" in spec &&
   345→        Array.isArray(spec.acceptance_criteria)
   346→      ) {
   347→        const ac = spec.acceptance_criteria;
   348→        if (ac.length > 0) {
   349→          console.log(
   350→            chalk.gray(`${indent}  Acceptance Criteria: ${ac.length}`),
   351→          );
   352→          // Show first AC as preview
   353→          const firstAC = ac[0];
   354→          if (
   355→            typeof firstAC === "object" &&
   356→            firstAC !== null &&
   357→            "id" in firstAC
   358→          ) {
   359→            console.log(
   360→              chalk.gray(`${indent}    [${firstAC.id}] ${firstAC.then}`),
   361→            );
   362→          }
   363→        }
   364→      }
   365→    }
   366→  }
   367→
   368→  // Show tags and dependencies if present
   369→  if (task.tags && task.tags.length > 0) {
   370→    console.log(chalk.gray(`${indent}Tags: ${task.tags.join(", ")}`));
   371→  }
   372→  if (task.depends_on && task.depends_on.length > 0) {
   373→    console.log(
   374→      chalk.gray(`${indent}Depends on: ${task.depends_on.join(", ")}`),
   375→    );
   376→  }
   377→}
   378→
   379→/**
   380→ * Format automation status as a colored label
   381→ * AC: @task-automation-eligibility ac-14
   382→ */
   383→function formatAutomationStatus(automation: string | undefined): string {
   384→  if (!automation) {
   385→    return chalk.gray("[unassessed]");
   386→  }
   387→  switch (automation) {
   388→    case "eligible":
   389→      return chalk.green("[eligible]");
   390→    case "needs_review":
   391→      return chalk.yellow("[needs_review]");
   392→    case "manual_only":
   393→      return chalk.red("[manual_only]");
   394→    default:
   395→      return chalk.gray(`[${automation}]`);
   396→  }
   397→}
   398→
   399→/**
   400→ * Format a list of tasks with automation status
   401→ * AC: @task-automation-eligibility ac-14
   402→ */
   403→export function formatTaskListWithAutomation(
   404→  tasks: Task[],
   405→  verbose = false,
   406→  index?: ReferenceIndex,
   407→  grepPattern?: string,
   408→  full = false,
   409→): void {
   410→  if (tasks.length === 0) {
   411→    console.log(summaries.noTasks);
   412→    return;
   413→  }
   414→
   415→  for (const task of tasks) {
   416→    const ref = formatTaskRef(task, index);
   417→    const status = statusColor(task.status)(`[${task.status}]`);
   418→    const priority =
   419→      task.priority <= 2
   420→        ? chalk.red(`P${task.priority}`)
   421→        : chalk.gray(`P${task.priority}`);
   422→    const automationLabel = formatAutomationStatus(task.automation);
   423→
   424→    let line = `${ref} ${status} ${priority} ${automationLabel} ${task.title}`;
   425→
   426→    if (verbose && !full) {
   427→      if (task.spec_ref) {
   428→        line += chalk.gray(` (spec: ${task.spec_ref})`);
   429→      }
   430→      if (task.depends_on.length > 0) {
   431→        line += chalk.gray(` deps: [${task.depends_on.join(", ")}]`);
   432→      }
   433→      if (task.tags.length > 0) {
   434→        line += chalk.cyan(` #${task.tags.join(" #")}`);
   435→      }
   436→    }
   437→
   438→    console.log(line);
   439→
   440→    // Show matched fields if grep pattern provided
   441→    if (grepPattern) {
   442→      const match = grepItem(
   443→        task as unknown as Record<string, unknown>,
   444→        grepPattern,
   445→      );
   446→      if (match && match.matchedFields.length > 0) {
   447→        console.log(
   448→          chalk.gray(
   449→            `    matched: ${formatMatchedFields(match.matchedFields)}`,
   450→          ),
   451→        );
   452→      }
   453→    } else if (full) {
   454→      formatFullModeContext(task, index);
   455→    } else {
   456→      // Show context line: first line of description (if present)
   457→      const context = getFirstLine(task.description);
   458→      if (context) {
   459→        console.log(chalk.gray(`    ${context}`));
   460→      }
   461→    }
   462→  }
   463→
   464→  console.log(summaries.taskCount(tasks.length));
   465→}
   466→
   467→/**
   468→ * Format a list of tasks
   469→ */
   470→export function formatTaskList(
   471→  tasks: Task[],
   472→  verbose = false,
   473→  index?: ReferenceIndex,
   474→  grepPattern?: string,
   475→  full = false,
   476→): void {
   477→  if (tasks.length === 0) {
   478→    console.log(summaries.noTasks);
   479→    return;
   480→  }
   481→
   482→  for (const task of tasks) {
   483→    console.log(formatTask(task, verbose, index, full));
   484→
   485→    // Show matched fields if grep pattern provided
   486→    if (grepPattern) {
   487→      const match = grepItem(
   488→        task as unknown as Record<string, unknown>,
   489→        grepPattern,
   490→      );
   491→      if (match && match.matchedFields.length > 0) {
   492→        console.log(
   493→          chalk.gray(
   494→            `    matched: ${formatMatchedFields(match.matchedFields)}`,
   495→          ),
   496→        );
   497→      }
   498→    } else if (full) {
   499→      // AC: @task-list-verbose ac-1 - Full mode shows richer context
   500→      formatFullModeContext(task, index);
   501→    } else {
   502→      // Show context line: first line of description (if present)
   503→      const context = getFirstLine(task.description);
   504→      if (context) {
   505→        console.log(chalk.gray(`    ${context}`));
   506→      }
   507→    }
   508→  }
   509→
   510→  console.log(summaries.taskCount(tasks.length));
   511→}
   512→
   513→export interface FormatTaskDetailsOptions {
   514→  /** Show all notes including superseded ones (default: false) */
   515→  showAllNotes?: boolean;
   516→}
   517→
   518→/**
   519→ * Format task details
   520→ */
   521→export function formatTaskDetails(
   522→  task: Task,
   523→  index?: ReferenceIndex,
   524→  options: FormatTaskDetailsOptions = {},
   525→): void {
   526→  console.log(chalk.bold(task.title));
   527→  console.log(chalk.gray("─".repeat(40)));
   528→  console.log(`${fieldLabels.ulid}      ${task._ulid}`);
   529→  if (task.slugs.length > 0) {
   530→    console.log(`${fieldLabels.slugs}     ${task.slugs.join(", ")}`);
   531→  }
   532→  console.log(`${fieldLabels.type}      ${task.type}`);
   533→  console.log(
   534→    `${fieldLabels.status}    ${statusColor(task.status)(task.status)}`,
   535→  );
   536→  console.log(`${fieldLabels.priority}  ${task.priority}`);
   537→
   538→  // AC: @task-automation-eligibility ac-17 - show automation status
   539→  const automationDisplay = task.automation || "unassessed";
   540→  const automationColor =
   541→    task.automation === "eligible"
   542→      ? chalk.green
   543→      : task.automation === "needs_review"
   544→        ? chalk.yellow
   545→        : task.automation === "manual_only"
   546→          ? chalk.red
   547→          : chalk.gray;
   548→  console.log(
   549→    `${fieldLabels.automation} ${automationColor(automationDisplay)}`,
   550→  );
   551→
   552→  if (task.spec_ref) {
   553→    console.log(`${fieldLabels.specRef}  ${task.spec_ref}`);
   554→  }
   555→
   556→  // AC: @plan-derive ac-6 - display plan_ref
   557→  if (task.plan_ref) {
   558→    console.log(`Plan ref:  ${task.plan_ref}`);
   559→  }
   560→
   561→  if (task.depends_on.length > 0) {
   562→    if (index) {
   563→      console.log(fieldLabels.depends);
   564→      for (const ref of task.depends_on) {
   565→        const result = index.resolve(ref);
   566→        if (result.ok) {
   567→          const item = result.item;
   568→          const status =
   569→            "status" in item && typeof item.status === "string"
   570→              ? statusColor(item.status as TaskStatus)(`[${item.status}]`)
   571→              : chalk.gray("[spec]");
   572→          // Handle both spec items (with title) and meta items (with name or id)
   573→          const itemName =
   574→            "title" in item
   575→              ? item.title
   576→              : "name" in item
   577→                ? item.name
   578→                : "id" in item
   579→                  ? item.id
   580→                  : ref;
   581→          console.log(`  ${ref} ${chalk.gray("→")} ${itemName} ${status}`);
   582→        } else {
   583→          console.log(`  ${ref} ${chalk.red("(unresolved)")}`);
   584→        }
   585→      }
   586→    } else {
   587→      console.log(`${fieldLabels.depends}   ${task.depends_on.join(", ")}`);
   588→    }
   589→  }
   590→
   591→  if (task.blocked_by.length > 0) {
   592→    console.log(
   593→      chalk.red(`${fieldLabels.blocked}   ${task.blocked_by.join(", ")}`),
   594→    );
   595→  }
   596→
   597→  if (task.tags.length > 0) {
   598→    console.log(`${fieldLabels.tags}      ${task.tags.join(", ")}`);
   599→  }
   600→
   601→  console.log(`${fieldLabels.created}   ${task.created_at}`);
   602→  if (task.started_at) {
   603→    console.log(`${fieldLabels.started}   ${task.started_at}`);
   604→  }
   605→  if (task.completed_at) {
   606→    console.log(`${fieldLabels.completed} ${task.completed_at}`);
   607→  }
   608→
   609→  // Show resolved spec information
   610→  if (task.spec_ref && index) {
   611→    const result = index.resolve(task.spec_ref);
   612→    if (result.ok) {
   613→      const spec = result.item;
   614→      console.log(`\n${sectionHeaders.specContext}`);
   615→      // Handle both spec items (with title) and meta items (with name)
   616→      const specName =
   617→        "title" in spec
   618→          ? spec.title
   619→          : "name" in spec
   620→            ? spec.name
   621→            : "id" in spec
   622→              ? spec.id
   623→              : task.spec_ref;
   624→      console.log(chalk.cyan(specName));
   625→      if ("type" in spec && spec.type) {
   626→        console.log(chalk.gray(`${fieldLabels.type} ${spec.type}`));
   627→      }
   628→      // Show implementation status
   629→      if ("status" in spec && spec.status && typeof spec.status === "object") {
   630→        const status = spec.status as {
   631→          maturity?: string;
   632→          implementation?: string;
   633→        };
   634→        if (status.implementation) {
   635→          const implColor =
   636→            status.implementation === "verified"
   637→              ? chalk.green
   638→              : status.implementation === "implemented"
   639→                ? chalk.cyan
   640→                : status.implementation === "in_progress"
   641→                  ? chalk.yellow
   642→                  : chalk.gray;
   643→          console.log(
   644→            chalk.gray(fieldLabels.implementation) +
   645→              implColor(status.implementation),
   646→          );
   647→        }
   648→      }
   649→      if ("description" in spec && spec.description) {
   650→        console.log(chalk.gray(fieldLabels.description));
   651→        // Indent description lines
   652→        const desc = String(spec.description).trim();
   653→        for (const line of desc.split("\n")) {
   654→          console.log(chalk.gray(`  ${line}`));
   655→        }
   656→      }
   657→      if (
   658→        "acceptance_criteria" in spec &&
   659→        Array.isArray(spec.acceptance_criteria) &&
   660→        spec.acceptance_criteria.length > 0
   661→      ) {
   662→        console.log(chalk.gray(fieldLabels.acceptanceCriteria));
   663→        for (const ac of spec.acceptance_criteria) {
   664→          if (ac && typeof ac === "object" && "id" in ac) {
   665→            const acObj = ac as {
   666→              id: string;
   667→              given?: string;
   668→              when?: string;
   669→              then?: string;
   670→            };
   671→            console.log(chalk.gray(`  [${acObj.id}]`));
   672→            if (acObj.given)
   673→              console.log(chalk.gray(`    Given: ${acObj.given}`));
   674→            if (acObj.when) console.log(chalk.gray(`    When: ${acObj.when}`));
   675→            if (acObj.then) console.log(chalk.gray(`    Then: ${acObj.then}`));
   676→          }
   677→        }
   678→      }
   679→      // Show traceability if present
   680→      if (
   681→        "traceability" in spec &&
   682→        spec.traceability &&
   683→        typeof spec.traceability === "object"
   684→      ) {
   685→        const trace = spec.traceability as {
   686→          implementation?: Array<{
   687→            path: string;
   688→            function?: string;
   689→            lines?: string;
   690→          }>;
   691→          tests?: Array<{ path: string }>;
   692→          commits?: string[];
   693→          issues?: string[];
   694→        };
   695→        const hasTrace =
   696→          trace.implementation?.length ||
   697→          trace.tests?.length ||
   698→          trace.commits?.length ||
   699→          trace.issues?.length;
   700→        if (hasTrace) {
   701→          console.log(chalk.gray(fieldLabels.traceability));
   702→          if (trace.implementation?.length) {
   703→            for (const impl of trace.implementation) {
   704→              let loc = `  Code: ${impl.path}`;
   705→              if (impl.function) loc += `::${impl.function}`;
   706→              if (impl.lines) loc += `:${impl.lines}`;
   707→              console.log(chalk.gray(loc));
   708→            }
   709→          }
   710→          if (trace.tests?.length) {
   711→            for (const test of trace.tests) {
   712→              console.log(chalk.gray(`  Test: ${test.path}`));
   713→            }
   714→          }
   715→          if (trace.commits?.length) {
   716→            console.log(chalk.gray(`  Commits: ${trace.commits.join(", ")}`));
   717→          }
   718→          if (trace.issues?.length) {
   719→            console.log(chalk.gray(`  Issues: ${trace.issues.join(", ")}`));
   720→          }
   721→        }
   722→      }
   723→    }
   724→  }
   725→
   726→  if (task.notes.length > 0) {
   727→    // Filter superseded notes unless showAllNotes is true
   728→    const notesToShow = options.showAllNotes
   729→      ? task.notes
   730→      : filterSupersededNotes(task.notes);
   731→    const hiddenCount = task.notes.length - notesToShow.length;
   732→
   733→    console.log(`\n${sectionHeaders.notes}`);
   734→    for (const note of notesToShow) {
   735→      const author = note.author || "unknown";
   736→      // Mark if this note supersedes another
   737→      const supersededLabel = note.supersedes ? chalk.gray(" (supersedes earlier note)") : "";
   738→      console.log(chalk.gray(`[${note.created_at}] ${author}:`) + supersededLabel);
   739→      console.log(note.content);
   740→    }
   741→
   742→    // Show count of hidden notes if any
   743→    if (hiddenCount > 0) {
   744→      console.log(chalk.gray(`\n(${hiddenCount} superseded note${hiddenCount > 1 ? "s" : ""} hidden - use --all to show)`));
   745→    }
   746→  }
   747→
   748→  if (task.todos.length > 0) {
   749→    console.log(`\n${sectionHeaders.todos}`);
   750→    for (const todo of task.todos) {
   751→      const check = todo.done ? chalk.green("✓") : chalk.gray("○");
   752→      const text = todo.done ? chalk.strikethrough.gray(todo.text) : todo.text;
   753→      console.log(`${check} [${todo.id}] ${text}`);
   754→    }
   755→  }
   756→}
   757→

