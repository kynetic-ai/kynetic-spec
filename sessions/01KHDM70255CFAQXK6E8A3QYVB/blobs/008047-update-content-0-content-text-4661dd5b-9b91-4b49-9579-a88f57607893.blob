```
     1→/**
     2→ * Meta manifest loading and operations.
     3→ *
     4→ * The meta manifest (kynetic.meta.yaml) contains process definitions:
     5→ * - Agents: roles, capabilities, conventions
     6→ * - Workflows: structured processes with steps
     7→ * - Conventions: project rules and standards
     8→ * - Observations: feedback about processes
     9→ */
    10→
    11→import * as fs from "node:fs/promises";
    12→import * as path from "node:path";
    13→import { ulid } from "ulid";
    14→import {
    15→  type Agent,
    16→  AgentSchema,
    17→  type Convention,
    18→  ConventionSchema,
    19→  getMetaItemType,
    20→  type MetaItem,
    21→  type MetaManifest,
    22→  MetaManifestSchema,
    23→  type Observation,
    24→  ObservationSchema,
    25→  type ObservationType,
    26→  type SessionContext,
    27→  SessionContextSchema,
    28→  type Workflow,
    29→  type WorkflowRun,
    30→  type WorkflowRunsFile,
    31→  WorkflowRunsFileSchema,
    32→  WorkflowSchema,
    33→} from "../schema/index.js";
    34→import type { KspecContext } from "./yaml.js";
    35→import {
    36→  expandIncludePattern,
    37→  getAuthor,
    38→  readYamlFile,
    39→  writeYamlFilePreserveFormat,
    40→} from "./yaml.js";
    41→
    42→/**
    43→ * Loaded agent with runtime metadata
    44→ */
    45→export interface LoadedAgent extends Agent {
    46→  _sourceFile?: string;
    47→}
    48→
    49→/**
    50→ * Loaded workflow with runtime metadata
    51→ */
    52→export interface LoadedWorkflow extends Workflow {
    53→  _sourceFile?: string;
    54→}
    55→
    56→/**
    57→ * Loaded convention with runtime metadata
    58→ */
    59→export interface LoadedConvention extends Convention {
    60→  _sourceFile?: string;
    61→}
    62→
    63→/**
    64→ * Loaded observation with runtime metadata
    65→ */
    66→export interface LoadedObservation extends Observation {
    67→  _sourceFile?: string;
    68→}
    69→
    70→/**
    71→ * Any loaded meta item
    72→ */
    73→export type LoadedMetaItem =
    74→  | LoadedAgent
    75→  | LoadedWorkflow
    76→  | LoadedConvention
    77→  | LoadedObservation;
    78→
    79→/**
    80→ * Meta context containing all loaded meta items
    81→ */
    82→export interface MetaContext {
    83→  manifest: MetaManifest | null;
    84→  manifestPath: string | null;
    85→  agents: LoadedAgent[];
    86→  workflows: LoadedWorkflow[];
    87→  conventions: LoadedConvention[];
    88→  observations: LoadedObservation[];
    89→}
    90→
    91→/**
    92→ * Find the meta manifest file.
    93→ *
    94→ * Discovery algorithm:
    95→ * 1. Check for explicit name: kynetic.meta.yaml (backward compat)
    96→ * 2. If not found, scan directory for *.meta.yaml files
    97→ * 3. For each candidate, validate it contains a 'kynetic_meta:' version field
    98→ * 4. Return first valid match (alphabetically after explicit name)
    99→ *
   100→ * AC: @meta-manifest-discovery ac-1, ac-2, ac-3
   101→ */
   102→export async function findMetaManifest(
   103→  specDir: string,
   104→): Promise<string | null> {
   105→  // AC: @meta-manifest-discovery ac-1, ac-3 - explicit name has priority
   106→  const priorityPath = path.join(specDir, "kynetic.meta.yaml");
   107→  try {
   108→    await fs.access(priorityPath);
   109→    return priorityPath;
   110→  } catch {
   111→    // Continue to glob fallback
   112→  }
   113→
   114→  // AC: @meta-manifest-discovery ac-2, ac-3 - glob fallback with validation
   115→  try {
   116→    const entries = await fs.readdir(specDir);
   117→    // AC: @meta-manifest-discovery ac-3 - alphabetical order
   118→    const candidates = entries
   119→      .filter((f) => f.endsWith(".meta.yaml"))
   120→      .sort();
   121→
   122→    for (const candidate of candidates) {
   123→      const filePath = path.join(specDir, candidate);
   124→      try {
   125→        const raw = await readYamlFile<unknown>(filePath);
   126→        // AC: @meta-manifest-discovery ac-2 - validate kynetic_meta version field
   127→        if (raw && typeof raw === "object" && "kynetic_meta" in raw) {
   128→          return filePath;
   129→        }
   130→      } catch {
   131→        // Skip invalid files
   132→      }
   133→    }
   134→  } catch {
   135→    // Directory read failed
   136→  }
   137→
   138→  return null;
   139→}
   140→
   141→/**
   142→ * Get the base name (slug) from a manifest path.
   143→ * E.g., "kynetic.yaml" -> "kynetic", "myproject.spec.yaml" -> "myproject"
   144→ */
   145→function getManifestBaseName(manifestPath: string | null): string {
   146→  if (!manifestPath) return "kynetic";
   147→  const fileName = path.basename(manifestPath);
   148→  // Remove .yaml extension
   149→  let baseName = fileName.replace(/\.yaml$/, "");
   150→  // Remove .spec suffix if present
   151→  baseName = baseName.replace(/\.spec$/, "");
   152→  return baseName || "kynetic";
   153→}
   154→
   155→/**
   156→ * Get the meta manifest file path.
   157→ * Derives from main manifest name (e.g., myproject.yaml -> myproject.meta.yaml)
   158→ * Returns path even if file doesn't exist yet.
   159→ */
   160→export function getMetaManifestPath(ctx: KspecContext): string {
   161→  const baseName = getManifestBaseName(ctx.manifestPath);
   162→  return path.join(ctx.specDir, `${baseName}.meta.yaml`);
   163→}
   164→
   165→/**
   166→ * Load meta items from a single file.
   167→ */
   168→async function loadMetaFile(filePath: string): Promise<{
   169→  agents: LoadedAgent[];
   170→  workflows: LoadedWorkflow[];
   171→  conventions: LoadedConvention[];
   172→  observations: LoadedObservation[];
   173→}> {
   174→  const result: {
   175→    agents: LoadedAgent[];
   176→    workflows: LoadedWorkflow[];
   177→    conventions: LoadedConvention[];
   178→    observations: LoadedObservation[];
   179→  } = {
   180→    agents: [],
   181→    workflows: [],
   182→    conventions: [],
   183→    observations: [],
   184→  };
   185→
   186→  try {
   187→    const raw = await readYamlFile<unknown>(filePath);
   188→    if (!raw || typeof raw !== "object") {
   189→      return result;
   190→    }
   191→
   192→    const obj = raw as Record<string, unknown>;
   193→
   194→    // Parse agents
   195→    if (Array.isArray(obj.agents)) {
   196→      for (const agent of obj.agents) {
   197→        const parsed = AgentSchema.safeParse(agent);
   198→        if (parsed.success) {
   199→          result.agents.push({ ...parsed.data, _sourceFile: filePath });
   200→        }
   201→      }
   202→    }
   203→
   204→    // Parse workflows
   205→    if (Array.isArray(obj.workflows)) {
   206→      for (const workflow of obj.workflows) {
   207→        const parsed = WorkflowSchema.safeParse(workflow);
   208→        if (parsed.success) {
   209→          result.workflows.push({ ...parsed.data, _sourceFile: filePath });
   210→        }
   211→      }
   212→    }
   213→
   214→    // Parse conventions
   215→    if (Array.isArray(obj.conventions)) {
   216→      for (const convention of obj.conventions) {
   217→        const parsed = ConventionSchema.safeParse(convention);
   218→        if (parsed.success) {
   219→          result.conventions.push({ ...parsed.data, _sourceFile: filePath });
   220→        }
   221→      }
   222→    }
   223→
   224→    // Parse observations
   225→    if (Array.isArray(obj.observations)) {
   226→      for (const observation of obj.observations) {
   227→        const parsed = ObservationSchema.safeParse(observation);
   228→        if (parsed.success) {
   229→          result.observations.push({ ...parsed.data, _sourceFile: filePath });
   230→        }
   231→      }
   232→    }
   233→  } catch {
   234→    // File doesn't exist or parse error
   235→  }
   236→
   237→  return result;
   238→}
   239→
   240→/**
   241→ * Load the meta context from a kspec context.
   242→ * Loads meta manifest and follows includes.
   243→ */
   244→export async function loadMetaContext(ctx: KspecContext): Promise<MetaContext> {
   245→  const result: MetaContext = {
   246→    manifest: null,
   247→    manifestPath: null,
   248→    agents: [],
   249→    workflows: [],
   250→    conventions: [],
   251→    observations: [],
   252→  };
   253→
   254→  const manifestPath = await findMetaManifest(ctx.specDir);
   255→  if (!manifestPath) {
   256→    return result;
   257→  }
   258→
   259→  result.manifestPath = manifestPath;
   260→
   261→  try {
   262→    const raw = await readYamlFile<unknown>(manifestPath);
   263→    const parsed = MetaManifestSchema.safeParse(raw);
   264→    if (!parsed.success) {
   265→      // Invalid manifest, but we can still try to extract items
   266→      const items = await loadMetaFile(manifestPath);
   267→      result.agents.push(...items.agents);
   268→      result.workflows.push(...items.workflows);
   269→      result.conventions.push(...items.conventions);
   270→      result.observations.push(...items.observations);
   271→      return result;
   272→    }
   273→
   274→    result.manifest = parsed.data;
   275→
   276→    // Load items from manifest
   277→    const manifestItems = await loadMetaFile(manifestPath);
   278→    result.agents.push(...manifestItems.agents);
   279→    result.workflows.push(...manifestItems.workflows);
   280→    result.conventions.push(...manifestItems.conventions);
   281→    result.observations.push(...manifestItems.observations);
   282→
   283→    // Process includes
   284→    const includes = parsed.data.includes || [];
   285→    const manifestDir = path.dirname(manifestPath);
   286→
   287→    for (const include of includes) {
   288→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   289→
   290→      for (const filePath of expandedPaths) {
   291→        const items = await loadMetaFile(filePath);
   292→        result.agents.push(...items.agents);
   293→        result.workflows.push(...items.workflows);
   294→        result.conventions.push(...items.conventions);
   295→        result.observations.push(...items.observations);
   296→      }
   297→    }
   298→  } catch {
   299→    // Manifest exists but may be invalid
   300→  }
   301→
   302→  return result;
   303→}
   304→
   305→/**
   306→ * Get meta stats summary
   307→ */
   308→export function getMetaStats(meta: MetaContext): {
   309→  agents: number;
   310→  workflows: number;
   311→  conventions: number;
   312→  observations: number;
   313→  unresolvedObservations: number;
   314→} {
   315→  return {
   316→    agents: meta.agents.length,
   317→    workflows: meta.workflows.length,
   318→    conventions: meta.conventions.length,
   319→    observations: meta.observations.length,
   320→    unresolvedObservations: meta.observations.filter((o) => !o.resolved).length,
   321→  };
   322→}
   323→
   324→/**
   325→ * Find a meta item by reference (ULID, short ULID, or id)
   326→ */
   327→export function findMetaItemByRef(
   328→  meta: MetaContext,
   329→  ref: string,
   330→): LoadedMetaItem | undefined {
   331→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
   332→
   333→  // Search all item types
   334→  const allItems: LoadedMetaItem[] = [
   335→    ...meta.agents,
   336→    ...meta.workflows,
   337→    ...meta.conventions,
   338→    ...meta.observations,
   339→  ];
   340→
   341→  for (const item of allItems) {
   342→    // Match full ULID
   343→    if (item._ulid === cleanRef) return item;
   344→
   345→    // Match short ULID (prefix)
   346→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
   347→      return item;
   348→
   349→    // Match by id (for agents and workflows)
   350→    if ("id" in item && item.id === cleanRef) return item;
   351→
   352→    // Match by domain (for conventions)
   353→    if ("domain" in item && item.domain === cleanRef) return item;
   354→  }
   355→
   356→  return undefined;
   357→}
   358→
   359→/**
   360→ * Determine if an item is a meta item type
   361→ */
   362→export function isMetaItemType(type: string): boolean {
   363→  return ["agent", "workflow", "convention", "observation"].includes(type);
   364→}
   365→
   366→// ============================================================
   367→// META ITEM CRUD
   368→// ============================================================
   369→
   370→/**
   371→ * Save the entire meta manifest to file
   372→ */
   373→async function saveMetaManifest(
   374→  manifestPath: string,
   375→  manifest: MetaManifest,
   376→): Promise<void> {
   377→  await writeYamlFilePreserveFormat(manifestPath, manifest);
   378→}
   379→
   380→/**
   381→ * Strip runtime metadata before serialization
   382→ */
   383→function stripMetaMetadata<T extends LoadedMetaItem>(
   384→  item: T,
   385→): Omit<T, "_sourceFile"> {
   386→  const { _sourceFile, ...cleanItem } = item;
   387→  return cleanItem as Omit<T, "_sourceFile">;
   388→}
   389→
   390→/**
   391→ * Create a new observation
   392→ */
   393→export function createObservation(
   394→  type: ObservationType,
   395→  content: string,
   396→  options: {
   397→    workflow_ref?: string;
   398→    author?: string;
   399→  } = {},
   400→): Observation {
   401→  return {
   402→    _ulid: ulid(),
   403→    type,
   404→    content,
   405→    workflow_ref: options.workflow_ref,
   406→    created_at: new Date().toISOString(),
   407→    author: options.author ?? getAuthor(),
   408→    resolved: false,
   409→    resolution: null,
   410→  };
   411→}
   412→
   413→/**
   414→ * Save an observation to the meta manifest
   415→ */
   416→export async function saveObservation(
   417→  ctx: KspecContext,
   418→  observation: LoadedObservation,
   419→): Promise<void> {
   420→  const manifestPath = getMetaManifestPath(ctx);
   421→
   422→  // Ensure directory exists
   423→  const dir = path.dirname(manifestPath);
   424→  await fs.mkdir(dir, { recursive: true });
   425→
   426→  // Load existing manifest
   427→  let manifest: MetaManifest = {
   428→    kynetic_meta: "1.0",
   429→    agents: [],
   430→    workflows: [],
   431→    conventions: [],
   432→    observations: [],
   433→    includes: [],
   434→  };
   435→
   436→  try {
   437→    const raw = await readYamlFile<unknown>(manifestPath);
   438→    const parsed = MetaManifestSchema.safeParse(raw);
   439→    if (parsed.success) {
   440→      manifest = parsed.data;
   441→    }
   442→  } catch {
   443→    // File doesn't exist, use defaults
   444→  }
   445→
   446→  // Strip runtime metadata
   447→  const cleanObs = stripMetaMetadata(observation);
   448→
   449→  // Update or add
   450→  const existingIndex = manifest.observations.findIndex(
   451→    (o) => o._ulid === observation._ulid,
   452→  );
   453→  if (existingIndex >= 0) {
   454→    manifest.observations[existingIndex] = cleanObs as Observation;
   455→  } else {
   456→    manifest.observations.push(cleanObs as Observation);
   457→  }
   458→
   459→  await saveMetaManifest(manifestPath, manifest);
   460→}
   461→
   462→/**
   463→ * Delete an observation from the meta manifest
   464→ */
   465→export async function deleteObservation(
   466→  ctx: KspecContext,
   467→  ulid: string,
   468→): Promise<boolean> {
   469→  const manifestPath = getMetaManifestPath(ctx);
   470→
   471→  try {
   472→    const raw = await readYamlFile<unknown>(manifestPath);
   473→    const parsed = MetaManifestSchema.safeParse(raw);
   474→    if (!parsed.success) {
   475→      return false;
   476→    }
   477→
   478→    const manifest = parsed.data;
   479→    const index = manifest.observations.findIndex((o) => o._ulid === ulid);
   480→    if (index < 0) {
   481→      return false;
   482→    }
   483→
   484→    manifest.observations.splice(index, 1);
   485→    await saveMetaManifest(manifestPath, manifest);
   486→    return true;
   487→  } catch {
   488→    return false;
   489→  }
   490→}
   491→
   492→// Re-export the getMetaItemType function
   493→export { getMetaItemType };
   494→export type { Agent, Workflow, Convention, Observation, MetaItem };
   495→
   496→// ============================================================
   497→// GENERIC META ITEM CRUD
   498→// ============================================================
   499→
   500→/**
   501→ * Save any meta item (agent, workflow, convention) to the manifest
   502→ */
   503→export async function saveMetaItem(
   504→  ctx: KspecContext,
   505→  item: LoadedMetaItem,
   506→  itemType: "agent" | "workflow" | "convention",
   507→): Promise<void> {
   508→  const manifestPath = getMetaManifestPath(ctx);
   509→
   510→  // Ensure directory exists
   511→  const dir = path.dirname(manifestPath);
   512→  await fs.mkdir(dir, { recursive: true });
   513→
   514→  // Load existing manifest
   515→  let manifest: MetaManifest = {
   516→    kynetic_meta: "1.0",
   517→    agents: [],
   518→    workflows: [],
   519→    conventions: [],
   520→    observations: [],
   521→    includes: [],
   522→  };
   523→
   524→  try {
   525→    const raw = await readYamlFile<unknown>(manifestPath);
   526→    const parsed = MetaManifestSchema.safeParse(raw);
   527→    if (parsed.success) {
   528→      manifest = parsed.data;
   529→    }
   530→  } catch {
   531→    // File doesn't exist, use defaults
   532→  }
   533→
   534→  // Strip runtime metadata
   535→  const cleanItem = stripMetaMetadata(item);
   536→
   537→  // Get the appropriate array
   538→  const getArray = () => {
   539→    switch (itemType) {
   540→      case "agent":
   541→        return manifest.agents;
   542→      case "workflow":
   543→        return manifest.workflows;
   544→      case "convention":
   545→        return manifest.conventions;
   546→    }
   547→  };
   548→
   549→  const array = getArray();
   550→
   551→  // Update or add
   552→  const existingIndex = array.findIndex((i) => i._ulid === item._ulid);
   553→  if (existingIndex >= 0) {
   554→    (array as unknown[])[existingIndex] = cleanItem;
   555→  } else {
   556→    (array as unknown[]).push(cleanItem);
   557→  }
   558→
   559→  await saveMetaManifest(manifestPath, manifest);
   560→}
   561→
   562→/**
   563→ * Delete any meta item from the manifest
   564→ */
   565→export async function deleteMetaItem(
   566→  ctx: KspecContext,
   567→  itemUlid: string,
   568→  itemType: "agent" | "workflow" | "convention" | "observation",
   569→): Promise<boolean> {
   570→  const manifestPath = getMetaManifestPath(ctx);
   571→
   572→  try {
   573→    const raw = await readYamlFile<unknown>(manifestPath);
   574→    const parsed = MetaManifestSchema.safeParse(raw);
   575→    if (!parsed.success) {
   576→      return false;
   577→    }
   578→
   579→    const manifest = parsed.data;
   580→
   581→    const getArray = () => {
   582→      switch (itemType) {
   583→        case "agent":
   584→          return manifest.agents;
   585→        case "workflow":
   586→          return manifest.workflows;
   587→        case "convention":
   588→          return manifest.conventions;
   589→        case "observation":
   590→          return manifest.observations;
   591→      }
   592→    };
   593→
   594→    const array = getArray();
   595→    const index = array.findIndex((i) => i._ulid === itemUlid);
   596→    if (index < 0) {
   597→      return false;
   598→    }
   599→
   600→    array.splice(index, 1);
   601→    await saveMetaManifest(manifestPath, manifest);
   602→    return true;
   603→  } catch {
   604→    return false;
   605→  }
   606→}
   607→
   608→// ============================================================
   609→// SESSION CONTEXT
   610→// ============================================================
   611→
   612→/**
   613→ * Get the session context file path
   614→ */
   615→export function getSessionContextPath(ctx: KspecContext): string {
   616→  return path.join(ctx.specDir, ".kspec-session");
   617→}
   618→
   619→/**
   620→ * Load session context (or return empty context if not exists)
   621→ */
   622→export async function loadSessionContext(
   623→  ctx: KspecContext,
   624→): Promise<SessionContext> {
   625→  const contextPath = getSessionContextPath(ctx);
   626→
   627→  try {
   628→    const raw = await readYamlFile<unknown>(contextPath);
   629→    if (!raw || typeof raw !== "object") {
   630→      return {
   631→        focus: null,
   632→        threads: [],
   633→        open_questions: [],
   634→        updated_at: new Date().toISOString(),
   635→      };
   636→    }
   637→
   638→    // Validate and parse using schema
   639→    const result = SessionContextSchema.safeParse(raw);
   640→    if (result.success) {
   641→      return result.data;
   642→    }
   643→
   644→    // If validation fails, return empty context
   645→    return {
   646→      focus: null,
   647→      threads: [],
   648→      open_questions: [],
   649→      updated_at: new Date().toISOString(),
   650→    };
   651→  } catch {
   652→    return {
   653→      focus: null,
   654→      threads: [],
   655→      open_questions: [],
   656→      updated_at: new Date().toISOString(),
   657→    };
   658→  }
   659→}
   660→
   661→/**
   662→ * Save session context
   663→ */
   664→export async function saveSessionContext(
   665→  ctx: KspecContext,
   666→  context: SessionContext,
   667→): Promise<void> {
   668→  const contextPath = getSessionContextPath(ctx);
   669→
   670→  // Update timestamp
   671→  context.updated_at = new Date().toISOString();
   672→
   673→  await writeYamlFilePreserveFormat(contextPath, context);
   674→}
   675→
   676→// ============================================================
   677→// WORKFLOW RUNS
   678→// ============================================================
   679→
   680→/**
   681→ * Get the workflow runs file path.
   682→ * Derives from main manifest name (e.g., myproject.yaml -> myproject.runs.yaml)
   683→ */
   684→export function getWorkflowRunsPath(ctx: KspecContext): string {
   685→  const baseName = getManifestBaseName(ctx.manifestPath);
   686→  return path.join(ctx.specDir, `${baseName}.runs.yaml`);
   687→}
   688→
   689→/**
   690→ * Load workflow runs from file
   691→ */
   692→export async function loadWorkflowRuns(
   693→  ctx: KspecContext,
   694→): Promise<WorkflowRun[]> {
   695→  const runsPath = getWorkflowRunsPath(ctx);
   696→
   697→  try {
   698→    const raw = await readYamlFile<unknown>(runsPath);
   699→    const parsed = WorkflowRunsFileSchema.safeParse(raw);
   700→
   701→    if (!parsed.success) {
   702→      return [];
   703→    }
   704→
   705→    return parsed.data.runs;
   706→  } catch {
   707→    // File doesn't exist
   708→    return [];
   709→  }
   710→}
   711→
   712→/**
   713→ * Save a workflow run (create or update)
   714→ */
   715→export async function saveWorkflowRun(
   716→  ctx: KspecContext,
   717→  run: WorkflowRun,
   718→): Promise<void> {
   719→  const runsPath = getWorkflowRunsPath(ctx);
   720→
   721→  // Load existing runs
   722→  const runs = await loadWorkflowRuns(ctx);
   723→
   724→  // Update or add
   725→  const existingIndex = runs.findIndex((r) => r._ulid === run._ulid);
   726→  if (existingIndex >= 0) {
   727→    runs[existingIndex] = run;
   728→  } else {
   729→    runs.push(run);
   730→  }
   731→
   732→  // Save back
   733→  const runsFile: WorkflowRunsFile = {
   734→    kynetic_runs: "1.0",
   735→    runs,
   736→  };
   737→
   738→  await writeYamlFilePreserveFormat(runsPath, runsFile);
   739→}
   740→
   741→/**
   742→ * Update an existing workflow run
   743→ */
   744→export async function updateWorkflowRun(
   745→  ctx: KspecContext,
   746→  run: WorkflowRun,
   747→): Promise<void> {
   748→  await saveWorkflowRun(ctx, run);
   749→}
   750→
   751→/**
   752→ * Find a workflow run by reference (ULID or ULID prefix)
   753→ */
   754→export async function findWorkflowRunByRef(
   755→  ctx: KspecContext,
   756→  ref: string,
   757→): Promise<WorkflowRun | undefined> {
   758→  const runs = await loadWorkflowRuns(ctx);
   759→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
   760→
   761→  return runs.find(
   762→    (r) =>
   763→      r._ulid === cleanRef ||
   764→      r._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   765→  );
   766→}
   767→
   768→/**
   769→ * Find active workflow runs
   770→ */
   771→export async function findActiveRuns(
   772→  ctx: KspecContext,
   773→): Promise<WorkflowRun[]> {
   774→  const runs = await loadWorkflowRuns(ctx);
   775→  return runs.filter((r) => r.status === "active");
   776→}
   777→
   778→/**
   779→ * Delete workflow runs by ULIDs
   780→ * AC: @workflow-prune ac-1, ac-2, ac-3, ac-4
   781→ */
   782→export async function deleteWorkflowRuns(
   783→  ctx: KspecContext,
   784→  ulidsToDelete: string[],
   785→): Promise<void> {
   786→  const runsPath = getWorkflowRunsPath(ctx);
   787→  const runs = await loadWorkflowRuns(ctx);
   788→
   789→  // Filter out runs to delete
   790→  const remainingRuns = runs.filter((r) => !ulidsToDelete.includes(r._ulid));
   791→
   792→  // Save back
   793→  const runsFile: WorkflowRunsFile = {
   794→    kynetic_runs: "1.0",
   795→    runs: remainingRuns,
   796→  };
   797→
   798→  await writeYamlFilePreserveFormat(runsPath, runsFile);
   799→}
