     1→/**
     2→ * Plan import CLI command
     3→ * AC: @plan-import ac-11 through ac-33
     4→ */
     5→
     6→import * as fs from "node:fs/promises";
     7→import * as path from "node:path";
     8→import type { Command } from "commander";
     9→import { markMutating } from "../command-annotations.js";
    10→import {
    11→  addChildItem,
    12→  buildIndexes,
    13→  createPlan,
    14→  createSpecItem,
    15→  createTask,
    16→  getAuthor,
    17→  initContext,
    18→  loadAllTasks,
    19→  loadPlans,
    20→  savePlan,
    21→  saveTask,
    22→  updateSpecItem,
    23→  type LoadedSpecItem,
    24→} from "../../parser/index.js";
    25→import {
    26→  parsePlanDocument,
    27→  topologicalSort,
    28→  validateParentRefs,
    29→  type PlanSpec,
    30→} from "../../parser/plan-document.js";
    31→import { commitIfShadow } from "../../parser/shadow.js";
    32→import type { PlanInput, SpecItemInput, TaskInput } from "../../schema/index.js";
    33→import { errors } from "../../strings/index.js";
    34→import { EXIT_CODES } from "../exit-codes.js";
    35→import { error, info, isJsonMode, output, success, warn } from "../output.js";
    36→import { ulid } from "ulid";
    37→
    38→/**
    39→ * Register plan import command
    40→ * AC: @plan-import ac-11, ac-15, ac-32
    41→ */
    42→export function registerPlanImportCommand(planCommand: Command): void {
    43→  markMutating(planCommand.command("import <path>"))
    44→    .description("Import plan document and auto-generate specs/tasks")
    45→    .requiredOption(
    46→      "--module <ref>",
    47→      "Module to add specs under (e.g., @core-module)",
    48→    )
    49→    .option("--dry-run", "Show what would be created without making changes")
    50→    .option("--update", "Update existing specs instead of skipping them")
    51→    .option("--json", "Output as JSON")
    52→    .addHelpText(
    53→      "after",
    54→      `
    55→Examples:
    56→  $ kspec plan import ./plan.md --module @core
    57→  $ kspec plan import ./plan.md --module @api --dry-run
    58→  $ kspec plan import ./plan.md --module @features --update --json`,
    59→    )
    60→    .action(async (planPath: string, options) => {
    61→      try {
    62→        await importPlan(planPath, options);
    63→      } catch (err) {
    64→        error("Failed to import plan", err);
    65→        process.exit(EXIT_CODES.ERROR);
    66→      }
    67→    });
    68→}
    69→
    70→/**
    71→ * Import operation result
    72→ */
    73→interface ImportResult {
    74→  createdSpecs: string[];
    75→  updatedSpecs: string[];
    76→  createdTasks: string[];
    77→  errors: Array<{ message: string; spec?: PlanSpec }>;
    78→  skipped: Array<{ slug: string; reason: string }>;
    79→  planRef: string;
    80→}
    81→
    82→/**
    83→ * Import plan document and create specs/tasks
    84→ * AC: @plan-import ac-11 through ac-33
    85→ */
    86→async function importPlan(
    87→  planPath: string,
    88→  options: { module: string; dryRun?: boolean; update?: boolean },
    89→): Promise<void> {
    90→  // JSON mode is set by global preAction hook
    91→
    92→  const ctx = await initContext();
    93→  const author = getAuthor();
    94→
    95→  // Read plan file
    96→  // AC: @plan-import ac-21 - Handle file read errors
    97→  const fullPath = path.resolve(process.cwd(), planPath);
    98→  let content: string;
    99→  try {
   100→    content = await fs.readFile(fullPath, "utf-8");
   101→  } catch (err) {
   102→    error(`Failed to read plan file: ${planPath}`, err);
   103→    process.exit(EXIT_CODES.USAGE_ERROR);
   104→  }
   105→
   106→  // Parse plan document
   107→  // AC: @plan-import ac-11, ac-12, ac-13, ac-21, ac-22
   108→  const parsed = parsePlanDocument(content);
   109→
   110→  // Report parsing errors
   111→  if (parsed.errors.length > 0) {
   112→    for (const err of parsed.errors) {
   113→      if (err.type === "yaml") {
   114→        // AC: @plan-import ac-21 - YAML parse errors (fatal)
   115→        error(err.message);
   116→        process.exit(EXIT_CODES.USAGE_ERROR);
   117→      } else if (err.type === "validation") {
   118→        // AC: @plan-import ac-22 - Validation errors (non-fatal, add to warnings)
   119→        warn(err.message);
   120→      }
   121→    }
   122→  }
   123→
   124→  // Load plans for cross-namespace slug safety
   125→  const plans = await loadPlans(ctx);
   126→
   127→  // Build indexes to check existing specs (include plans for cross-namespace slug safety)
   128→  const { refIndex, items } = await buildIndexes(ctx, plans);
   129→  const existingSpecRefs = new Set<string>();
   130→  for (const item of items) {
   131→    for (const slug of (item as LoadedSpecItem).slugs || []) {
   132→      existingSpecRefs.add(slug);
   133→    }
   134→    existingSpecRefs.add(item._ulid.slice(0, 8));
   135→  }
   136→
   137→  // Resolve module reference
   138→  const moduleResult = refIndex.resolve(options.module);
   139→  if (!moduleResult.ok) {
   140→    error(errors.reference.itemNotFound(options.module));
   141→    process.exit(EXIT_CODES.NOT_FOUND);
   142→  }
   143→
   144→  const moduleItem = moduleResult.item as LoadedSpecItem;
   145→
   146→  // Verify it's a module
   147→  if (moduleItem.type !== "module") {
   148→    error(`${options.module} is not a module (type: ${moduleItem.type})`);
   149→    process.exit(EXIT_CODES.USAGE_ERROR);
   150→  }
   151→
   152→  // Validate parent references
   153→  // AC: @plan-import ac-17, ac-33
   154→  const parentErrors = validateParentRefs(parsed.specs, existingSpecRefs);
   155→  parsed.errors.push(...parentErrors);
   156→
   157→  // Sort specs topologically
   158→  // AC: @plan-import ac-16, ac-18
   159→  const { sorted, error: sortError } = topologicalSort(parsed.specs);
   160→  if (sortError) {
   161→    // AC: @plan-import ac-18 - Circular dependency detection
   162→    error(sortError.message);
   163→    process.exit(EXIT_CODES.USAGE_ERROR);
   164→  }
   165→
   166→  // Create plan record
   167→  // AC: @plan-import ac-24, ac-28
   168→  // Auto-namespace plan slugs with "plan-" prefix to prevent collision with spec slugs
   169→  // Ensure uniqueness across all namespaces (plans + specs + tasks via refIndex)
   170→  let planSlug = `plan-${generateSlug(parsed.title)}`;
   171→  let counter = 1;
   172→  const baseSlug = planSlug;
   173→  while (!refIndex.isSlugAvailable(planSlug)) {
   174→    planSlug = `${baseSlug}-${counter}`;
   175→    counter++;
   176→  }
   177→
   178→  // Track all slugs created during this import (refIndex is stale after mutations)
   179→  const importReservedSlugs = new Set<string>([planSlug]);
   180→
   181→  const planInput: PlanInput = {
   182→    title: parsed.title,
   183→    content: parsed.content,
   184→    status: "active",
   185→    slugs: [planSlug],
   186→    source_path: fullPath,
   187→  };
   188→
   189→  const newPlan = createPlan(planInput);
   190→  const planRef = `@${planSlug}`;
   191→
   192→  // AC: @plan-import ac-13 - Attach global implementation notes to plan record
   193→  if (parsed.implementationNotes) {
   194→    newPlan.notes.push({
   195→      _ulid: ulid(),
   196→      created_at: new Date().toISOString(),
   197→      author,
   198→      content: `Implementation notes:\n\n${parsed.implementationNotes}`,
   199→    });
   200→  }
   201→
   202→  // Initialize result
   203→  const result: ImportResult = {
   204→    createdSpecs: [],
   205→    updatedSpecs: [],
   206→    createdTasks: [],
   207→    errors: [],
   208→    skipped: [],
   209→    planRef,
   210→  };
   211→
   212→  // Add parser validation errors to result
   213→  // AC: @plan-import ac-22, ac-29 - Include parser validation errors in summary
   214→  for (const err of parsed.errors) {
   215→    if (err.type === "validation") {
   216→      result.errors.push({ message: err.message });
   217→    }
   218→  }
   219→
   220→  // Track newly created specs for parent resolution
   221→  // AC: @plan-import ac-16 - Resolve local references
   222→  const createdSpecsMap = new Map<string, LoadedSpecItem>();
   223→
   224→  // Process specs
   225→  // AC: @plan-import ac-14, ac-16, ac-17, ac-22, ac-23, ac-25, ac-26, ac-29
   226→  for (let i = 0; i < sorted.length; i++) {
   227→    const spec = sorted[i];
   228→    try {
   229→      // Validate required fields first
   230→      // AC: @plan-import ac-22
   231→      if (!spec.title) {
   232→        const errMsg = `Spec at index ${i} missing required field: title`;
   233→        warn(errMsg);
   234→        result.errors.push({ message: errMsg, spec });
   235→        continue;
   236→      }
   237→
   238→      const specSlug = spec.slug || generateSlug(spec.title);
   239→      const specRef = `@${specSlug}`;
   240→
   241→      // Check against slugs reserved during this import (plan slug, earlier specs)
   242→      if (importReservedSlugs.has(specSlug)) {
   243→        warn(`Spec slug "${specSlug}" collides with another item in this import, skipping`);
   244→        result.skipped.push({ slug: specSlug, reason: "Slug collision within import" });
   245→        continue;
   246→      }
   247→
   248→      // Check if spec already exists in pre-import state
   249→      const exists = refIndex.resolve(specRef);
   250→
   251→      if (exists.ok && !options.update) {
   252→        // AC: @plan-import ac-14, ac-25 - Skip existing specs
   253→        warn(`Skipping existing spec: ${specRef}`);
   254→        result.skipped.push({ slug: specSlug, reason: "Already exists" });
   255→        continue;
   256→      }
   257→
   258→      if (exists.ok && options.update) {
   259→        // AC: @plan-import ac-26 - Update existing spec
   260→        // Updates: description, type, tags, traits, and acceptance_criteria
   261→        const existingSpec = exists.item as LoadedSpecItem;
   262→
   263→        if (options.dryRun) {
   264→          info(`Would update spec: ${specRef}`);
   265→          result.updatedSpecs.push(specRef);
   266→        } else {
   267→          // Build updates from plan spec
   268→          const updates: Partial<SpecItemInput> = {};
   269→
   270→          if (spec.description !== undefined) {
   271→            updates.description = spec.description;
   272→          }
   273→          if (spec.type !== undefined) {
   274→            updates.type = spec.type as SpecItemInput["type"];
   275→          }
   276→          if (spec.traits !== undefined) {
   277→            updates.traits = spec.traits.map(t => t.startsWith('@') ? t : `@${t}`);
   278→          }
   279→          if (spec.acceptance_criteria !== undefined) {
   280→            updates.acceptance_criteria = spec.acceptance_criteria;
   281→          }
   282→
   283→          await updateSpecItem(ctx, existingSpec, updates);
   284→          info(`Updated spec: ${specRef}`);
   285→          result.updatedSpecs.push(specRef);
   286→        }
   287→        continue;
   288→      }
   289→
   290→      // Resolve parent reference
   291→      // AC: @plan-import ac-16, ac-17
   292→      let parent: LoadedSpecItem | null = null;
   293→      if (spec.parent) {
   294→        const parentRef = spec.parent.startsWith("@")
   295→          ? spec.parent
   296→          : `@${spec.parent}`;
   297→
   298→        // Check if parent was just created in this import
   299→        const parentSlug = parentRef.slice(1);
   300→        if (createdSpecsMap.has(parentSlug)) {
   301→          parent = createdSpecsMap.get(parentSlug)!;
   302→        } else {
   303→          // Check existing specs
   304→          const parentResult = refIndex.resolve(parentRef);
   305→
   306→          if (!parentResult.ok) {
   307→            // AC: @plan-import ac-17, ac-33 - Missing parent with hint
   308→            const errMsg = `Parent ${parentRef} not found. Check parent exists or define it earlier in plan`;
   309→            warn(errMsg);
   310→            result.errors.push({ message: errMsg, spec });
   311→            result.skipped.push({ slug: specSlug, reason: "Missing parent" });
   312→            continue;
   313→          }
   314→
   315→          parent = parentResult.item as LoadedSpecItem;
   316→        }
   317→      }
   318→
   319→      if (options.dryRun) {
   320→        // AC: @plan-import ac-15 - Dry run mode
   321→        info(
   322→          `Would create spec: ${specRef} ${spec.parent ? `under ${spec.parent}` : "(root)"}`,
   323→        );
   324→        result.createdSpecs.push(specRef);
   325→        importReservedSlugs.add(specSlug);
   326→
   327→        // Track would-be created spec for parent resolution in dry-run
   328→        const dryRunSpec = createSpecItem({
   329→          title: spec.title,
   330→          type: (spec.type as any) || "feature",
   331→          slugs: [specSlug],
   332→          description: spec.description,
   333→          ...(spec.acceptance_criteria ? { acceptance_criteria: spec.acceptance_criteria } : {}),
   334→          priority: undefined,
   335→          tags: [],
   336→          depends_on: [],
   337→          implements: [],
   338→          relates_to: [],
   339→          tests: [],
   340→          traits: (spec.traits || []).map(t => t.startsWith('@') ? t : `@${t}`),
   341→          notes: [],
   342→        }) as LoadedSpecItem;
   343→        createdSpecsMap.set(specSlug, dryRunSpec);
   344→      } else {
   345→        // Create spec item
   346→        const specInput: SpecItemInput = {
   347→          title: spec.title,
   348→          type: (spec.type as any) || "feature",
   349→          slugs: [specSlug],
   350→          description: spec.description,
   351→          priority: undefined,
   352→          tags: [],
   353→          depends_on: [],
   354→          implements: [],
   355→          relates_to: [],
   356→          tests: [],
   357→          traits: (spec.traits || []).map(t => t.startsWith('@') ? t : `@${t}`),
   358→          notes: [],
   359→        };
   360→
   361→        // Add acceptance criteria if present
   362→        if (spec.acceptance_criteria) {
   363→          specInput.acceptance_criteria = spec.acceptance_criteria;
   364→        }
   365→
   366→        const newSpec = createSpecItem(specInput);
   367→
   368→        // Add spec to parent (or module if no parent)
   369→        const actualParent = parent || moduleItem;
   370→        const addResult = await addChildItem(ctx, actualParent, newSpec);
   371→
   372→        // Track the created spec for parent resolution
   373→        // Need to construct LoadedSpecItem with _sourceFile and _path for nested specs
   374→        const createdSpec: LoadedSpecItem = {
   375→          ...(addResult.item as LoadedSpecItem),
   376→          _sourceFile: actualParent._sourceFile,
   377→          _path: addResult.path,
   378→        };
   379→        createdSpecsMap.set(specSlug, createdSpec);
   380→
   381→        result.createdSpecs.push(specRef);
   382→        importReservedSlugs.add(specSlug);
   383→        newPlan.derived_specs.push(specRef);
   384→
   385→        info(`Created spec: ${specRef}`);
   386→      }
   387→    } catch (err) {
   388→      const errMsg = `Failed to create spec "${spec.title}": ${err instanceof Error ? err.message : String(err)}`;
   389→      warn(errMsg);
   390→      result.errors.push({ message: errMsg, spec });
   391→    }
   392→  }
   393→
   394→  // Derive tasks from specs
   395→  // AC: @plan-import ac-12, ac-13, ac-19, ac-20
   396→  if (parsed.tasks.derive_from_specs && result.createdSpecs.length > 0) {
   397→    const tasks = await loadAllTasks(ctx);
   398→    // Combine existing task slugs + all slugs reserved during this import (plan + specs)
   399→    const importSlugs = new Set([
   400→      ...tasks.flatMap((t) => t.slugs),
   401→      ...importReservedSlugs,
   402→    ]);
   403→
   404→    for (const specRef of result.createdSpecs) {
   405→      // Get spec from createdSpecsMap (works in both dry-run and real mode)
   406→      const specSlug = specRef.slice(1);
   407→      const spec = createdSpecsMap.get(specSlug);
   408→      if (!spec) continue;
   409→
   410→      // AC: @plan-import ac-20 - Task title follows "Implement X" pattern
   411→      const taskTitle = `Implement ${spec.title}`;
   412→      const taskSlug = generateSlug(taskTitle);
   413→
   414→      // Ensure slug uniqueness across all namespaces + this import's slugs
   415→      let uniqueSlug = taskSlug;
   416→      let counter = 1;
   417→      while (importSlugs.has(uniqueSlug) || !refIndex.isSlugAvailable(uniqueSlug)) {
   418→        uniqueSlug = `${taskSlug}-${counter}`;
   419→        counter++;
   420→      }
   421→      importSlugs.add(uniqueSlug);
   422→      importReservedSlugs.add(uniqueSlug);
   423→
   424→      if (options.dryRun) {
   425→        info(`Would derive task: @${uniqueSlug} from ${specRef}`);
   426→        result.createdTasks.push(`@${uniqueSlug}`);
   427→      } else {
   428→        // AC: @plan-import ac-19 - Task has both spec_ref and plan_ref
   429→        const taskInput: TaskInput = {
   430→          title: taskTitle,
   431→          type: "task",
   432→          spec_ref: specRef,
   433→          plan_ref: planRef,
   434→          priority: 3,
   435→          slugs: [uniqueSlug],
   436→          tags: [],
   437→          depends_on: [],
   438→          notes: [],
   439→        };
   440→
   441→        const newTask = createTask(taskInput);
   442→
   443→        // AC: @plan-import ac-13 - Scoped implementation notes
   444→        const planSpec = parsed.specs.find(s =>
   445→          (s.slug || generateSlug(s.title)) === specSlug
   446→        );
   447→        if (planSpec?.implementation_notes) {
   448→          // Per-spec notes go directly to this task
   449→          newTask.notes.push({
   450→            _ulid: ulid(),
   451→            created_at: new Date().toISOString(),
   452→            author,
   453→            content: `Implementation notes:\n\n${planSpec.implementation_notes}`,
   454→          });
   455→        } else if (parsed.implementationNotes) {
   456→          // No per-spec notes — reference the plan
   457→          newTask.notes.push({
   458→            _ulid: ulid(),
   459→            created_at: new Date().toISOString(),
   460→            author,
   461→            content: `See plan ${planRef} for implementation notes`,
   462→          });
   463→        }
   464→
   465→        await saveTask(ctx, newTask);
   466→        result.createdTasks.push(`@${uniqueSlug}`);
   467→        newPlan.derived_tasks.push(`@${uniqueSlug}`);
   468→
   469→        info(`Derived task: @${uniqueSlug}`);
   470→      }
   471→    }
   472→  }
   473→
   474→  // Create manual tasks
   475→  // AC: @plan-import ac-27
   476→  if (parsed.tasks.additional_tasks) {
   477→    // Reload tasks to catch any created by derive loop above
   478→    // Combine with all slugs reserved during this import (plan + specs)
   479→    const manualTasks = await loadAllTasks(ctx);
   480→    const manualImportSlugs = new Set([
   481→      ...manualTasks.flatMap((t) => t.slugs),
   482→      ...importReservedSlugs,
   483→    ]);
   484→
   485→    for (const taskDef of parsed.tasks.additional_tasks) {
   486→      const taskSlug = taskDef.slug || generateSlug(taskDef.title);
   487→
   488→      // Ensure slug uniqueness across all namespaces + this import's slugs
   489→      let uniqueSlug = taskSlug;
   490→      let counter = 1;
   491→      while (manualImportSlugs.has(uniqueSlug) || !refIndex.isSlugAvailable(uniqueSlug)) {
   492→        uniqueSlug = `${taskSlug}-${counter}`;
   493→        counter++;
   494→      }
   495→      manualImportSlugs.add(uniqueSlug);
   496→
   497→      if (options.dryRun) {
   498→        info(`Would create manual task: @${uniqueSlug}`);
   499→        result.createdTasks.push(`@${uniqueSlug}`);
   500→      } else {
   501→        // AC: @plan-import ac-27 - Manual tasks have plan_ref but no spec_ref
   502→        const taskInput: TaskInput = {
   503→          title: taskDef.title,
   504→          type: "task",
   505→          plan_ref: planRef,
   506→          priority: taskDef.priority || 3,
   507→          slugs: [uniqueSlug],
   508→          tags: taskDef.tags || [],
   509→          depends_on: [],
   510→          notes: [],
   511→        };
   512→
   513→        if (taskDef.description) {
   514→          taskInput.notes = [
   515→            {
   516→              _ulid: ulid(),
   517→              created_at: new Date().toISOString(),
   518→              author,
   519→              content: taskDef.description,
   520→            },
   521→          ];
   522→        }
   523→
   524→        const newTask = createTask(taskInput);
   525→        await saveTask(ctx, newTask);
   526→        result.createdTasks.push(`@${uniqueSlug}`);
   527→        newPlan.derived_tasks.push(`@${uniqueSlug}`);
   528→
   529→        info(`Created manual task: @${uniqueSlug}`);
   530→      }
   531→    }
   532→  }
   533→
   534→  // Save plan record
   535→  // AC: @plan-import ac-24
   536→  if (!options.dryRun) {
   537→    await savePlan(ctx, newPlan);
   538→    await commitIfShadow(ctx.shadow, "plan-import", planSlug, parsed.title);
   539→  }
   540→
   541→  // AC: @plan-import ac-23, ac-29 - Summary output
   542→  const successCount =
   543→    result.createdSpecs.length +
   544→    result.updatedSpecs.length +
   545→    result.createdTasks.length;
   546→  const errorCount = result.errors.length + result.skipped.length;
   547→
   548→  // AC: @plan-import ac-32 - JSON output
   549→  if (isJsonMode()) {
   550→    output({
   551→      plan: planRef,
   552→      created_specs: result.createdSpecs,
   553→      updated_specs: result.updatedSpecs,
   554→      created_tasks: result.createdTasks,
   555→      errors: result.errors,
   556→      skipped: result.skipped,
   557→    });
   558→  } else {
   559→    // Human-readable output
   560→    if (options.dryRun) {
   561→      console.log("\nDry run - no changes made\n");
   562→    }
   563→
   564→    console.log(`Plan: ${planRef}`);
   565→    console.log(`Created ${result.createdSpecs.length} specs`);
   566→    if (result.updatedSpecs.length > 0) {
   567→      console.log(`Updated ${result.updatedSpecs.length} specs`);
   568→    }
   569→    console.log(`Created ${result.createdTasks.length} tasks`);
   570→
   571→    if (result.errors.length > 0) {
   572→      console.log(`\nErrors (${result.errors.length}):`);
   573→      for (const err of result.errors) {
   574→        console.log(`  - ${err.message}`);
   575→      }
   576→    }
   577→
   578→    if (result.skipped.length > 0) {
   579→      console.log(`\nSkipped (${result.skipped.length}):`);
   580→      for (const skip of result.skipped) {
   581→        console.log(`  - @${skip.slug}: ${skip.reason}`);
   582→      }
   583→    }
   584→
   585→    // AC: @plan-import ac-15, ac-23 - Exit code 0 on success
   586→    if (!options.dryRun && successCount > 0) {
   587→      success(
   588→        `\nImported plan: ${successCount} items created, ${errorCount} errors`,
   589→      );
   590→    }
   591→  }  // end of else block (non-JSON output)
   592→
   593→  // Exit code logic
   594→  // AC: @plan-import ac-15 - Dry run exits 0
   595→  // AC: @plan-import ac-23 - Success with some errors still exits 0
   596→  process.exit(EXIT_CODES.SUCCESS);
   597→}
   598→
   599→/**
   600→ * Generate URL-safe slug from title
   601→ */
   602→function generateSlug(title: string): string {
   603→  return title
   604→    .toLowerCase()
   605→    .replace(/[^a-z0-9]+/g, "-")
   606→    .replace(/^-|-$/g, "")
   607→    .slice(0, 50);
   608→}
   609→

