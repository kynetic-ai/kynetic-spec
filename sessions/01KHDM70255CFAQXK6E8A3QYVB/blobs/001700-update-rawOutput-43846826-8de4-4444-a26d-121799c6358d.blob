     1→/**
     2→ * Validation module for kspec files.
     3→ *
     4→ * Provides schema validation, reference validation, and orphan detection.
     5→ */
     6→
     7→import * as fs from "node:fs/promises";
     8→import * as path from "node:path";
     9→import {
    10→  AgentSchema,
    11→  ConventionSchema,
    12→  ManifestSchema,
    13→  MetaManifestSchema,
    14→  ObservationSchema,
    15→  SpecItemSchema,
    16→  TaskSchema,
    17→  TasksFileSchema,
    18→  UlidSchema,
    19→  WorkflowSchema,
    20→} from "../schema/index.js";
    21→import { findMetaManifest, loadMetaContext } from "./meta.js";
    22→import { loadPlans } from "./plans.js";
    23→import {
    24→  ReferenceIndex,
    25→  type RefValidationError,
    26→  type RefValidationWarning,
    27→  validateRefs,
    28→} from "./refs.js";
    29→import { TraitIndex } from "./traits.js";
    30→import type { KspecContext, LoadedSpecItem, LoadedTask } from "./yaml.js";
    31→import {
    32→  expandIncludePattern,
    33→  extractItemsFromRaw,
    34→  findTaskFiles,
    35→  loadSpecFile,
    36→  readYamlFile,
    37→} from "./yaml.js";
    38→
    39→// ============================================================
    40→// TYPES
    41→// ============================================================
    42→
    43→/**
    44→ * Schema validation error
    45→ */
    46→export interface SchemaValidationError {
    47→  file: string;
    48→  path?: string;
    49→  message: string;
    50→  details?: unknown;
    51→}
    52→
    53→/**
    54→ * Orphan item (not referenced by anything)
    55→ */
    56→export interface OrphanItem {
    57→  ulid: string;
    58→  title: string;
    59→  type: string;
    60→  file?: string;
    61→}
    62→
    63→/**
    64→ * Completeness warning types
    65→ */
    66→export type CompletenessWarningType =
    67→  | "missing_acceptance_criteria"
    68→  | "missing_description"
    69→  | "status_inconsistency"
    70→  | "missing_test_coverage"
    71→  | "automation_eligible_no_spec";
    72→
    73→/**
    74→ * Trait cycle error
    75→ */
    76→export interface TraitCycleError {
    77→  traitRef: string;
    78→  traitTitle: string;
    79→  cycle: string[];
    80→  message: string;
    81→}
    82→
    83→/**
    84→ * Completeness warning
    85→ */
    86→export interface CompletenessWarning {
    87→  type: CompletenessWarningType;
    88→  itemRef: string;
    89→  itemTitle: string;
    90→  message: string;
    91→  details?: string;
    92→}
    93→
    94→/**
    95→ * Complete validation result
    96→ */
    97→export interface ValidationResult {
    98→  valid: boolean;
    99→  schemaErrors: SchemaValidationError[];
   100→  refErrors: RefValidationError[];
   101→  refWarnings: RefValidationWarning[];
   102→  orphans: OrphanItem[];
   103→  completenessWarnings: CompletenessWarning[];
   104→  traitCycleErrors: TraitCycleError[];
   105→  stats: {
   106→    filesChecked: number;
   107→    itemsChecked: number;
   108→    tasksChecked: number;
   109→  };
   110→  metaStats?: {
   111→    agents: number;
   112→    workflows: number;
   113→    conventions: number;
   114→    observations: number;
   115→  };
   116→}
   117→
   118→/**
   119→ * Validation options
   120→ */
   121→export interface ValidateOptions {
   122→  /** Check schema conformance */
   123→  schema?: boolean;
   124→  /** Check reference resolution */
   125→  refs?: boolean;
   126→  /** Find orphaned items */
   127→  orphans?: boolean;
   128→  /** Check spec completeness (missing AC, descriptions, status inconsistencies) */
   129→  completeness?: boolean;
   130→}
   131→
   132→// ============================================================
   133→// SCHEMA VALIDATION
   134→// ============================================================
   135→
   136→/**
   137→ * Validate a manifest file against schema
   138→ */
   139→async function validateManifestFile(
   140→  filePath: string,
   141→): Promise<SchemaValidationError[]> {
   142→  const errors: SchemaValidationError[] = [];
   143→
   144→  try {
   145→    const raw = await readYamlFile<unknown>(filePath);
   146→    const result = ManifestSchema.safeParse(raw);
   147→
   148→    if (!result.success) {
   149→      for (const issue of result.error.issues) {
   150→        errors.push({
   151→          file: filePath,
   152→          path: issue.path.join("."),
   153→          message: issue.message,
   154→          details: issue,
   155→        });
   156→      }
   157→    }
   158→  } catch (err) {
   159→    errors.push({
   160→      file: filePath,
   161→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   162→    });
   163→  }
   164→
   165→  return errors;
   166→}
   167→
   168→/**
   169→ * Validate a tasks file against schema
   170→ */
   171→async function validateTasksFile(
   172→  filePath: string,
   173→): Promise<SchemaValidationError[]> {
   174→  const errors: SchemaValidationError[] = [];
   175→
   176→  try {
   177→    const raw = await readYamlFile<unknown>(filePath);
   178→
   179→    // Handle both formats: { tasks: [...] } and plain array
   180→    let taskList: unknown[];
   181→
   182→    if (Array.isArray(raw)) {
   183→      taskList = raw;
   184→    } else if (raw && typeof raw === "object" && "tasks" in raw) {
   185→      // Try full TasksFile schema first
   186→      const fileResult = TasksFileSchema.safeParse(raw);
   187→      if (!fileResult.success) {
   188→        // If TasksFile fails, just validate individual tasks
   189→        taskList = (raw as { tasks: unknown[] }).tasks || [];
   190→      } else {
   191→        // File schema passed, validate individual tasks for detailed errors
   192→        taskList = fileResult.data.tasks;
   193→      }
   194→    } else {
   195→      errors.push({
   196→        file: filePath,
   197→        message:
   198→          "Invalid tasks file format: expected array or { tasks: [...] }",
   199→      });
   200→      return errors;
   201→    }
   202→
   203→    // Validate each task
   204→    for (let i = 0; i < taskList.length; i++) {
   205→      const task = taskList[i];
   206→      const result = TaskSchema.safeParse(task);
   207→
   208→      if (!result.success) {
   209→        for (const issue of result.error.issues) {
   210→          errors.push({
   211→            file: filePath,
   212→            path: `tasks[${i}].${issue.path.join(".")}`,
   213→            message: issue.message,
   214→            details: issue,
   215→          });
   216→        }
   217→      }
   218→    }
   219→  } catch (err) {
   220→    errors.push({
   221→      file: filePath,
   222→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   223→    });
   224→  }
   225→
   226→  return errors;
   227→}
   228→
   229→/**
   230→ * Validate a spec module file against schema
   231→ */
   232→async function validateSpecFile(
   233→  filePath: string,
   234→): Promise<SchemaValidationError[]> {
   235→  const errors: SchemaValidationError[] = [];
   236→
   237→  try {
   238→    const raw = await readYamlFile<unknown>(filePath);
   239→
   240→    // Recursively validate spec items
   241→    validateSpecItemRecursive(raw, filePath, "", errors);
   242→  } catch (err) {
   243→    errors.push({
   244→      file: filePath,
   245→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   246→    });
   247→  }
   248→
   249→  return errors;
   250→}
   251→
   252→/**
   253→ * Validate meta manifest file with strict ULID validation
   254→ * AC-meta-manifest-3: Invalid schema exits with code 1 and shows field path + expected type
   255→ */
   256→async function validateMetaManifestFile(
   257→  filePath: string,
   258→): Promise<SchemaValidationError[]> {
   259→  const errors: SchemaValidationError[] = [];
   260→
   261→  try {
   262→    const raw = await readYamlFile<unknown>(filePath);
   263→
   264→    // Validate overall manifest structure
   265→    const manifestResult = MetaManifestSchema.safeParse(raw);
   266→    if (!manifestResult.success) {
   267→      for (const issue of manifestResult.error.issues) {
   268→        errors.push({
   269→          file: filePath,
   270→          path: issue.path.join("."),
   271→          message: issue.message,
   272→          details: issue,
   273→        });
   274→      }
   275→      return errors;
   276→    }
   277→
   278→    // Validate each agent with strict ULID validation
   279→    if (
   280→      raw &&
   281→      typeof raw === "object" &&
   282→      "agents" in raw &&
   283→      Array.isArray((raw as Record<string, unknown>).agents)
   284→    ) {
   285→      const agents = (raw as Record<string, unknown>).agents as unknown[];
   286→      for (let i = 0; i < agents.length; i++) {
   287→        const agent = agents[i];
   288→        const agentResult = AgentSchema.safeParse(agent);
   289→        if (!agentResult.success) {
   290→          for (const issue of agentResult.error.issues) {
   291→            errors.push({
   292→              file: filePath,
   293→              path: `agents[${i}].${issue.path.join(".")}`,
   294→              message: issue.message,
   295→              details: issue,
   296→            });
   297→          }
   298→        }
   299→
   300→        // Strict ULID validation
   301→        if (agent && typeof agent === "object" && "_ulid" in agent) {
   302→          const ulidResult = UlidSchema.safeParse(
   303→            (agent as Record<string, unknown>)._ulid,
   304→          );
   305→          if (!ulidResult.success) {
   306→            errors.push({
   307→              file: filePath,
   308→              path: `agents[${i}]._ulid`,
   309→              message: "Invalid ULID format (expected 26 characters)",
   310→            });
   311→          }
   312→        }
   313→      }
   314→    }
   315→
   316→    // Validate each workflow with strict ULID validation
   317→    if (
   318→      raw &&
   319→      typeof raw === "object" &&
   320→      "workflows" in raw &&
   321→      Array.isArray((raw as Record<string, unknown>).workflows)
   322→    ) {
   323→      const workflows = (raw as Record<string, unknown>).workflows as unknown[];
   324→      for (let i = 0; i < workflows.length; i++) {
   325→        const workflow = workflows[i];
   326→        const workflowResult = WorkflowSchema.safeParse(workflow);
   327→        if (!workflowResult.success) {
   328→          for (const issue of workflowResult.error.issues) {
   329→            errors.push({
   330→              file: filePath,
   331→              path: `workflows[${i}].${issue.path.join(".")}`,
   332→              message: issue.message,
   333→              details: issue,
   334→            });
   335→          }
   336→        }
   337→
   338→        // Strict ULID validation
   339→        if (workflow && typeof workflow === "object" && "_ulid" in workflow) {
   340→          const ulidResult = UlidSchema.safeParse(
   341→            (workflow as Record<string, unknown>)._ulid,
   342→          );
   343→          if (!ulidResult.success) {
   344→            errors.push({
   345→              file: filePath,
   346→              path: `workflows[${i}]._ulid`,
   347→              message: "Invalid ULID format (expected 26 characters)",
   348→            });
   349→          }
   350→        }
   351→      }
   352→    }
   353→
   354→    // Validate each convention with strict ULID validation
   355→    if (
   356→      raw &&
   357→      typeof raw === "object" &&
   358→      "conventions" in raw &&
   359→      Array.isArray((raw as Record<string, unknown>).conventions)
   360→    ) {
   361→      const conventions = (raw as Record<string, unknown>)
   362→        .conventions as unknown[];
   363→      for (let i = 0; i < conventions.length; i++) {
   364→        const convention = conventions[i];
   365→        const conventionResult = ConventionSchema.safeParse(convention);
   366→        if (!conventionResult.success) {
   367→          for (const issue of conventionResult.error.issues) {
   368→            errors.push({
   369→              file: filePath,
   370→              path: `conventions[${i}].${issue.path.join(".")}`,
   371→              message: issue.message,
   372→              details: issue,
   373→            });
   374→          }
   375→        }
   376→
   377→        // Strict ULID validation
   378→        if (
   379→          convention &&
   380→          typeof convention === "object" &&
   381→          "_ulid" in convention
   382→        ) {
   383→          const ulidResult = UlidSchema.safeParse(
   384→            (convention as Record<string, unknown>)._ulid,
   385→          );
   386→          if (!ulidResult.success) {
   387→            errors.push({
   388→              file: filePath,
   389→              path: `conventions[${i}]._ulid`,
   390→              message: "Invalid ULID format (expected 26 characters)",
   391→            });
   392→          }
   393→        }
   394→      }
   395→    }
   396→
   397→    // Validate each observation with strict ULID validation
   398→    if (
   399→      raw &&
   400→      typeof raw === "object" &&
   401→      "observations" in raw &&
   402→      Array.isArray((raw as Record<string, unknown>).observations)
   403→    ) {
   404→      const observations = (raw as Record<string, unknown>)
   405→        .observations as unknown[];
   406→      for (let i = 0; i < observations.length; i++) {
   407→        const observation = observations[i];
   408→        const observationResult = ObservationSchema.safeParse(observation);
   409→        if (!observationResult.success) {
   410→          for (const issue of observationResult.error.issues) {
   411→            errors.push({
   412→              file: filePath,
   413→              path: `observations[${i}].${issue.path.join(".")}`,
   414→              message: issue.message,
   415→              details: issue,
   416→            });
   417→          }
   418→        }
   419→
   420→        // Strict ULID validation
   421→        if (
   422→          observation &&
   423→          typeof observation === "object" &&
   424→          "_ulid" in observation
   425→        ) {
   426→          const ulidResult = UlidSchema.safeParse(
   427→            (observation as Record<string, unknown>)._ulid,
   428→          );
   429→          if (!ulidResult.success) {
   430→            errors.push({
   431→              file: filePath,
   432→              path: `observations[${i}]._ulid`,
   433→              message: "Invalid ULID format (expected 26 characters)",
   434→            });
   435→          }
   436→        }
   437→      }
   438→    }
   439→  } catch (err) {
   440→    errors.push({
   441→      file: filePath,
   442→      message: `Failed to parse YAML: ${err instanceof Error ? err.message : String(err)}`,
   443→    });
   444→  }
   445→
   446→  return errors;
   447→}
   448→
   449→/**
   450→ * Recursively validate spec items in a structure
   451→ */
   452→function validateSpecItemRecursive(
   453→  raw: unknown,
   454→  file: string,
   455→  pathPrefix: string,
   456→  errors: SchemaValidationError[],
   457→): void {
   458→  if (!raw || typeof raw !== "object") return;
   459→
   460→  // Check if this is a spec item (has _ulid)
   461→  if ("_ulid" in raw) {
   462→    const result = SpecItemSchema.safeParse(raw);
   463→    if (!result.success) {
   464→      for (const issue of result.error.issues) {
   465→        errors.push({
   466→          file,
   467→          path: pathPrefix
   468→            ? `${pathPrefix}.${issue.path.join(".")}`
   469→            : issue.path.join("."),
   470→          message: issue.message,
   471→          details: issue,
   472→        });
   473→      }
   474→    }
   475→  }
   476→
   477→  // Recurse into nested structures
   478→  const nestedFields = [
   479→    "modules",
   480→    "features",
   481→    "requirements",
   482→    "constraints",
   483→    "decisions",
   484→    "items",
   485→  ];
   486→  const obj = raw as Record<string, unknown>;
   487→
   488→  for (const field of nestedFields) {
   489→    if (field in obj && Array.isArray(obj[field])) {
   490→      const arr = obj[field] as unknown[];
   491→      for (let i = 0; i < arr.length; i++) {
   492→        const newPath = pathPrefix
   493→          ? `${pathPrefix}.${field}[${i}]`
   494→          : `${field}[${i}]`;
   495→        validateSpecItemRecursive(arr[i], file, newPath, errors);
   496→      }
   497→    }
   498→  }
   499→}
   500→
   501→// ============================================================
   502→// ORPHAN DETECTION
   503→// ============================================================
   504→
   505→/**
   506→ * Find items that are not referenced by any other item
   507→ */
   508→function findOrphans(
   509→  tasks: LoadedTask[],
   510→  items: LoadedSpecItem[],
   511→  index: ReferenceIndex,
   512→): OrphanItem[] {
   513→  const orphans: OrphanItem[] = [];
   514→
   515→  // Build set of all referenced ULIDs
   516→  const referenced = new Set<string>();
   517→
   518→  const allItems = [...tasks, ...items];
   519→
   520→  // Fields that contain references
   521→  const refFields = [
   522→    "depends_on",
   523→    "blocked_by",
   524→    "implements",
   525→    "relates_to",
   526→    "tests",
   527→    "supersedes",
   528→    "spec_ref",
   529→    "context",
   530→  ];
   531→
   532→  for (const item of allItems) {
   533→    const obj = item as unknown as Record<string, unknown>;
   534→
   535→    for (const field of refFields) {
   536→      const value = obj[field];
   537→
   538→      if (typeof value === "string" && value.startsWith("@")) {
   539→        const resolved = index.resolve(value);
   540→        if (resolved.ok) {
   541→          referenced.add(resolved.ulid);
   542→        }
   543→      } else if (Array.isArray(value)) {
   544→        for (const v of value) {
   545→          if (typeof v === "string" && v.startsWith("@")) {
   546→            const resolved = index.resolve(v);
   547→            if (resolved.ok) {
   548→              referenced.add(resolved.ulid);
   549→            }
   550→          }
   551→        }
   552→      }
   553→    }
   554→  }
   555→
   556→  // Find items not in the referenced set
   557→  // Skip entry point types: modules are spec entry points, tasks are work items
   558→  const entryPointTypes = ["module", "task", "epic", "bug", "spike", "infra"];
   559→
   560→  for (const item of items) {
   561→    // Only check spec items, not tasks
   562→    if (!referenced.has(item._ulid)) {
   563→      // Skip entry point types
   564→      if (entryPointTypes.includes(item.type || "")) continue;
   565→
   566→      // Skip nested items - they're implicitly referenced by their parent
   567→      // _path indicates nesting (e.g., "features[0].requirements[2]")
   568→      if (item._path) continue;
   569→
   570→      orphans.push({
   571→        ulid: item._ulid,
   572→        title: item.title,
   573→        type: item.type || "unknown",
   574→        file: item._sourceFile,
   575→      });
   576→    }
   577→  }
   578→
   579→  return orphans;
   580→}
   581→
   582→// ============================================================
   583→// TRAIT CYCLE DETECTION
   584→// ============================================================
   585→
   586→/**
   587→ * Detect circular trait references
   588→ * AC: @trait-edge-cases ac-2
   589→ */
   590→function detectTraitCycles(
   591→  items: LoadedSpecItem[],
   592→  index: ReferenceIndex,
   593→): TraitCycleError[] {
   594→  const errors: TraitCycleError[] = [];
   595→  const traits = items.filter((item) => item.type === "trait");
   596→
   597→  // Build adjacency list: trait ULID → trait ULIDs it references
   598→  const graph = new Map<string, string[]>();
   599→  const traitInfo = new Map<string, { ref: string; title: string }>();
   600→
   601→  for (const trait of traits) {
   602→    const ref = trait.slugs?.[0]
   603→      ? `@${trait.slugs[0]}`
   604→      : `@${trait._ulid.slice(0, 8)}`;
   605→    traitInfo.set(trait._ulid, { ref, title: trait.title });
   606→
   607→    const dependencies: string[] = [];
   608→    if (trait.traits && trait.traits.length > 0) {
   609→      for (const traitRef of trait.traits) {
   610→        const result = index.resolve(traitRef);
   611→        if (result.ok) {
   612→          dependencies.push(result.ulid);
   613→        }
   614→      }
   615→    }
   616→    graph.set(trait._ulid, dependencies);
   617→  }
   618→
   619→  // DFS-based cycle detection
   620→  const visiting = new Set<string>();
   621→  const visited = new Set<string>();
   622→
   623→  function dfs(ulid: string, path: string[]): string[] | null {
   624→    if (visiting.has(ulid)) {
   625→      // Found a cycle - return the cycle path
   626→      const cycleStart = path.indexOf(ulid);
   627→      return path.slice(cycleStart);
   628→    }
   629→
   630→    if (visited.has(ulid)) {
   631→      return null; // Already checked this path
   632→    }
   633→
   634→    visiting.add(ulid);
   635→    path.push(ulid);
   636→
   637→    const dependencies = graph.get(ulid) || [];
   638→    for (const depUlid of dependencies) {
   639→      const cycle = dfs(depUlid, path);
   640→      if (cycle) {
   641→        return cycle;
   642→      }
   643→    }
   644→
   645→    visiting.delete(ulid);
   646→    visited.add(ulid);
   647→    path.pop();
   648→
   649→    return null;
   650→  }
   651→
   652→  // Check each trait for cycles
   653→  for (const trait of traits) {
   654→    if (!visited.has(trait._ulid)) {
   655→      const cycle = dfs(trait._ulid, []);
   656→      if (cycle) {
   657→        const info = traitInfo.get(cycle[0]);
   658→        if (info) {
   659→          const cycleRefs = cycle.map((ulid) => {
   660→            const cycleInfo = traitInfo.get(ulid);
   661→            return cycleInfo ? cycleInfo.ref : `@${ulid.slice(0, 8)}`;
   662→          });
   663→
   664→          errors.push({
   665→            traitRef: info.ref,
   666→            traitTitle: info.title,
   667→            cycle: cycleRefs,
   668→            message: `Circular trait reference: ${cycleRefs.join(" → ")} → ${cycleRefs[0]}`,
   669→          });
   670→        }
   671→
   672→        // Mark all traits in cycle as visited to avoid duplicate errors
   673→        for (const ulid of cycle) {
   674→          visited.add(ulid);
   675→        }
   676→      }
   677→    }
   678→  }
   679→
   680→  return errors;
   681→}
   682→
   683→// ============================================================
   684→// COMPLETENESS VALIDATION
   685→// ============================================================
   686→
   687→/**
   688→ * Recursively find all test files in a directory
   689→ */
   690→async function findTestFilesRecursive(dir: string): Promise<string[]> {
   691→  const testFiles: string[] = [];
   692→
   693→  try {
   694→    const entries = await fs.readdir(dir, { withFileTypes: true });
   695→
   696→    for (const entry of entries) {
   697→      const fullPath = path.join(dir, entry.name);
   698→
   699→      if (entry.isDirectory()) {
   700→        // Recurse into subdirectories
   701→        const subFiles = await findTestFilesRecursive(fullPath);
   702→        testFiles.push(...subFiles);
   703→      } else if (
   704→        entry.isFile() &&
   705→        (entry.name.endsWith(".test.ts") || entry.name.endsWith(".test.js"))
   706→      ) {
   707→        testFiles.push(fullPath);
   708→      }
   709→    }
   710→  } catch {
   711→    // Directory doesn't exist or can't be read - return empty
   712→  }
   713→
   714→  return testFiles;
   715→}
   716→
   717→/**
   718→ * Scan test files for AC annotations to build coverage index.
   719→ * Recursively scans all subdirectories under tests/.
   720→ * Returns a Set of covered ACs in format "@spec-ref ac-N"
   721→ */
   722→export async function scanTestCoverage(rootDir: string): Promise<Set<string>> {
   723→  const coveredACs = new Set<string>();
   724→  const testsDir = path.join(rootDir, "tests");
   725→
   726→  try {
   727→    // Check if tests directory exists
   728→    await fs.access(testsDir);
   729→
   730→    // Recursively find all test files
   731→    const testFiles = await findTestFilesRecursive(testsDir);
   732→
   733→    for (const filePath of testFiles) {
   734→      const content = await fs.readFile(filePath, "utf-8");
   735→
   736→      // Match AC annotations: // AC: @spec-ref ac-N
   737→      // Also handle multiple ACs on one line: // AC: @spec-ref ac-1, ac-2
   738→      const acPattern =
   739→        /\/\/\s*AC:\s*(@[\w-]+)(?:\s+(ac-\d+(?:\s*,\s*ac-\d+)*))?/g;
   740→      let match;
   741→
   742→      while ((match = acPattern.exec(content)) !== null) {
   743→        const specRef = match[1]; // @spec-ref
   744→        const acList = match[2]; // "ac-1, ac-2" or just "ac-1" or undefined
   745→
   746→        if (acList) {
   747→          // Split by comma and trim
   748→          const acs = acList.split(",").map((ac) => ac.trim());
   749→          for (const ac of acs) {
   750→            coveredACs.add(`${specRef} ${ac}`);
   751→          }
   752→        } else {
   753→          // No specific AC mentioned, just the spec ref
   754→          // We'll consider this as generic coverage
   755→          coveredACs.add(specRef);
   756→        }
   757→      }
   758→    }
   759→  } catch (_err) {
   760→    // Tests directory doesn't exist or can't be read - that's ok
   761→  }
   762→
   763→  return coveredACs;
   764→}
   765→
   766→/**
   767→ * Compute coverage status for acceptance criteria of a spec item.
   768→ * Shared utility used by both daemon API and JSON export.
   769→ *
   770→ * @param item - The spec item containing acceptance_criteria
   771→ * @param coveredACs - Set of covered AC references from scanTestCoverage()
   772→ * @returns Array of ACs with covered field populated
   773→ */
   774→export function computeACCoverage<
   775→  T extends { id: string; given: string; when: string; then: string },
   776→>(
   777→  item: { _ulid: string; slugs?: string[]; acceptance_criteria?: T[] },
   778→  coveredACs: Set<string>,
   779→): Array<T & { covered: boolean }> {
   780→  if (!item.acceptance_criteria || item.acceptance_criteria.length === 0) {
   781→    return [];
   782→  }
   783→
   784→  return item.acceptance_criteria.map((ac, index) => {
   785→    const acId = `ac-${index + 1}`;
   786→    const possibleRefs: string[] = [];
   787→
   788→    // Try with primary slug
   789→    if (item.slugs && item.slugs.length > 0) {
   790→      possibleRefs.push(`@${item.slugs[0]} ${acId}`);
   791→      possibleRefs.push(`@${item.slugs[0]}`);
   792→    }
   793→
   794→    // Try with ULID (short form)
   795→    possibleRefs.push(`@${item._ulid.slice(0, 8)} ${acId}`);
   796→    possibleRefs.push(`@${item._ulid.slice(0, 8)}`);
   797→
   798→    const covered = possibleRefs.some((ref) => coveredACs.has(ref));
   799→    return { ...ac, covered };
   800→  });
   801→}
   802→
   803→/**
   804→ * Check spec items for completeness
   805→ * AC: @spec-completeness ac-1, ac-2, ac-3
   806→ * AC: @trait-validation ac-1, ac-2, ac-3
   807→ */
   808→async function checkCompleteness(
   809→  items: LoadedSpecItem[],
   810→  _index: ReferenceIndex,
   811→  rootDir: string,
   812→  traitIndex?: TraitIndex,
   813→): Promise<CompletenessWarning[]> {
   814→  const warnings: CompletenessWarning[] = [];
   815→
   816→  // Scan test files for AC coverage
   817→  const coveredACs = await scanTestCoverage(rootDir);
   818→
   819→  for (const item of items) {
   820→    const itemRef = item.slugs?.[0]
   821→      ? `@${item.slugs[0]}`
   822→      : `@${item._ulid.slice(0, 8)}`;
   823→    const isTrait = item.type === "trait";
   824→
   825→    // AC: @spec-completeness ac-1
   826→    // AC: @trait-type ac-2 - Traits should have acceptance criteria for completeness
   827→    // Check for missing acceptance criteria
   828→    if (!item.acceptance_criteria || item.acceptance_criteria.length === 0) {
   829→      warnings.push({
   830→        type: "missing_acceptance_criteria",
   831→        itemRef,
   832→        itemTitle: item.title,
   833→        message: `${isTrait ? "Trait" : "Item"} ${itemRef} has no acceptance criteria`,
   834→      });
   835→    }
   836→
   837→    // AC: @spec-completeness ac-2
   838→    // AC: @trait-type ac-3 - Traits should have description for completeness
   839→    // Check for missing description
   840→    if (!item.description || item.description.trim() === "") {
   841→      warnings.push({
   842→        type: "missing_description",
   843→        itemRef,
   844→        itemTitle: item.title,
   845→        message: `${isTrait ? "Trait" : "Item"} ${itemRef} has no description`,
   846→      });
   847→    }
   848→
   849→    // AC: @spec-completeness ac-3
   850→    // Check for status inconsistency between parent and children
   851→    if (item.status?.implementation === "implemented") {
   852→      // Check if this item has children with not_started status
   853→      const childFields = [
   854→        "modules",
   855→        "features",
   856→        "requirements",
   857→        "constraints",
   858→        "epics",
   859→        "themes",
   860→        "capabilities",
   861→      ];
   862→
   863→      for (const field of childFields) {
   864→        const children = (item as any)[field];
   865→        if (Array.isArray(children)) {
   866→          for (const child of children) {
   867→            if (child.status?.implementation === "not_started") {
   868→              const childRef = child.slugs?.[0]
   869→                ? `@${child.slugs[0]}`
   870→                : `@${child._ulid?.slice(0, 8) || "unknown"}`;
   871→              warnings.push({
   872→                type: "status_inconsistency",
   873→                itemRef,
   874→                itemTitle: item.title,
   875→                message: `Parent ${itemRef} is implemented but child ${childRef} is not_started`,
   876→                details: `Child: ${child.title}`,
   877→              });
   878→            }
   879→          }
   880→        }
   881→      }
   882→    }
   883→
   884→    // Check for test coverage of acceptance criteria
   885→    if (item.acceptance_criteria && item.acceptance_criteria.length > 0) {
   886→      const uncoveredACs: string[] = [];
   887→
   888→      for (const ac of item.acceptance_criteria) {
   889→        // Build all possible references for this AC
   890→        const possibleRefs: string[] = [];
   891→
   892→        // Try with primary slug
   893→        if (item.slugs && item.slugs.length > 0) {
   894→          possibleRefs.push(`@${item.slugs[0]} ${ac.id}`);
   895→          // Also check for just the slug without specific AC
   896→          possibleRefs.push(`@${item.slugs[0]}`);
   897→        }
   898→
   899→        // Try with ULID (short form)
   900→        possibleRefs.push(`@${item._ulid.slice(0, 8)} ${ac.id}`);
   901→        possibleRefs.push(`@${item._ulid.slice(0, 8)}`);
   902→
   903→        // Check if any of these references are covered
   904→        const isCovered = possibleRefs.some((ref) => coveredACs.has(ref));
   905→
   906→        if (!isCovered) {
   907→          uncoveredACs.push(ac.id);
   908→        }
   909→      }
   910→
   911→      // Only warn if there are uncovered ACs
   912→      if (uncoveredACs.length > 0) {
   913→        warnings.push({
   914→          type: "missing_test_coverage",
   915→          itemRef,
   916→          itemTitle: item.title,
   917→          message: `Item ${itemRef} has ${uncoveredACs.length} AC(s) without test coverage`,
   918→          details: `Uncovered: ${uncoveredACs.join(", ")}`,
   919→        });
   920→      }
   921→    }
   922→
   923→    // AC: @trait-validation ac-1, ac-2
   924→    // Check for test coverage of trait acceptance criteria
   925→    if (traitIndex && item.traits && item.traits.length > 0) {
   926→      const inheritedACs = traitIndex.getInheritedAC(item._ulid);
   927→      const uncoveredTraitACs: Array<{ traitSlug: string; acId: string }> = [];
   928→
   929→      for (const { trait, ac } of inheritedACs) {
   930→        // Build all possible references for this trait AC
   931→        const possibleRefs: string[] = [];
   932→
   933→        // Try with trait slug
   934→        possibleRefs.push(`@${trait.slug} ${ac.id}`);
   935→        possibleRefs.push(`@${trait.slug}`);
   936→
   937→        // Try with trait ULID (short form)
   938→        possibleRefs.push(`@${trait.ulid.slice(0, 8)} ${ac.id}`);
   939→        possibleRefs.push(`@${trait.ulid.slice(0, 8)}`);
   940→
   941→        // Check if any of these references are covered
   942→        const isCovered = possibleRefs.some((ref) => coveredACs.has(ref));
   943→
   944→        if (!isCovered) {
   945→          uncoveredTraitACs.push({ traitSlug: trait.slug, acId: ac.id });
   946→        }
   947→      }
   948→
   949→      // Only warn if there are uncovered trait ACs
   950→      if (uncoveredTraitACs.length > 0) {
   951→        const details = uncoveredTraitACs
   952→          .map(({ traitSlug, acId }) => `@${traitSlug} ${acId}`)
   953→          .join(", ");
   954→        warnings.push({
   955→          type: "missing_test_coverage",
   956→          itemRef,
   957→          itemTitle: item.title,
   958→          message: `Item ${itemRef} has ${uncoveredTraitACs.length} inherited trait AC(s) without test coverage`,
   959→          details: `Uncovered trait ACs: ${details}`,
   960→        });
   961→      }
   962→    }
   963→
   964→    // AC: @trait-retrospective ac-2, ac-3
   965→    // Check retrospective specs have required verification metadata
   966→    const isRetrospective = item.traits?.includes("@trait-retrospective");
   967→    if (isRetrospective) {
   968→      const isImplementedOrVerified =
   969→        item.status?.implementation === "implemented" ||
   970→        item.status?.implementation === "verified";
   971→
   972→      // AC: @trait-retrospective ac-2
   973→      // Retrospective specs with implemented/verified status must have verification metadata
   974→      if (isImplementedOrVerified) {
   975→        if (!item.verified_at || !item.verified_by) {
   976→          warnings.push({
   977→            type: "status_inconsistency",
   978→            itemRef,
   979→            itemTitle: item.title,
   980→            message: `Retrospective spec ${itemRef} is ${item.status?.implementation} but missing verified_at/verified_by`,
   981→            details:
   982→              "Specs using @trait-retrospective must have verified_at and verified_by fields when marked as implemented or verified",
   983→          });
   984→        }
   985→      }
   986→
   987→      // Inverse validation: If verification metadata exists, status should be implemented/verified
   988→      if ((item.verified_at || item.verified_by) && !isImplementedOrVerified) {
   989→        warnings.push({
   990→          type: "status_inconsistency",
   991→          itemRef,
   992→          itemTitle: item.title,
   993→          message: `Retrospective spec ${itemRef} has verification metadata but status is not implemented/verified`,
   994→          details:
   995→            "Retrospective specs with verified_at/verified_by should have implementation status set to 'implemented' or 'verified'",
   996→        });
   997→      }
   998→    }
   999→  }
  1000→
  1001→  return warnings;
  1002→}
  1003→
  1004→// ============================================================
  1005→// AUTOMATION VALIDATION
  1006→// ============================================================
  1007→
  1008→/**
  1009→ * Check task automation status for warnings
  1010→ * AC: @task-automation-eligibility ac-21, ac-23
  1011→ */
  1012→function checkAutomationEligibility(
  1013→  tasks: LoadedTask[],
  1014→  index: ReferenceIndex,
  1015→): CompletenessWarning[] {
  1016→  const warnings: CompletenessWarning[] = [];
  1017→
  1018→  for (const task of tasks) {
  1019→    const taskRef = task.slugs?.[0]
  1020→      ? `@${task.slugs[0]}`
  1021→      : `@${task._ulid.slice(0, 8)}`;
  1022→
  1023→    // AC: @task-automation-eligibility ac-21
  1024→    // Warn if eligible but no spec_ref
  1025→    if (task.automation === "eligible" && !task.spec_ref) {
  1026→      warnings.push({
  1027→        type: "automation_eligible_no_spec",
  1028→        itemRef: taskRef,
  1029→        itemTitle: task.title,
  1030→        message: `Task ${taskRef} is automation: eligible but has no spec_ref - eligible tasks should have linked specs`,
  1031→      });
  1032→    }
  1033→
  1034→    // AC: @task-automation-eligibility ac-23
  1035→    // Warn if eligible but spec_ref doesn't resolve
  1036→    if (task.automation === "eligible" && task.spec_ref) {
  1037→      const specResult = index.resolve(task.spec_ref);
  1038→      if (!specResult.ok) {
  1039→        warnings.push({
  1040→          type: "automation_eligible_no_spec",
  1041→          itemRef: taskRef,
  1042→          itemTitle: task.title,
  1043→          message: `Task ${taskRef} is automation: eligible but spec_ref ${task.spec_ref} cannot be resolved`,
  1044→        });
  1045→      }
  1046→    }
  1047→  }
  1048→
  1049→  return warnings;
  1050→}
  1051→
  1052→// ============================================================
  1053→// MAIN VALIDATION
  1054→// ============================================================
  1055→
  1056→/**
  1057→ * Run full validation on a kspec project
  1058→ */
  1059→export async function validate(
  1060→  ctx: KspecContext,
  1061→  options: ValidateOptions = {},
  1062→): Promise<ValidationResult> {
  1063→  // Default: run all checks
  1064→  const runSchema = options.schema !== false;
  1065→  const runRefs = options.refs !== false;
  1066→  const runOrphans = options.orphans !== false;
  1067→  const runCompleteness = options.completeness !== false;
  1068→
  1069→  const result: ValidationResult = {
  1070→    valid: true,
  1071→    schemaErrors: [],
  1072→    refErrors: [],
  1073→    refWarnings: [],
  1074→    orphans: [],
  1075→    completenessWarnings: [],
  1076→    traitCycleErrors: [],
  1077→    stats: {
  1078→      filesChecked: 0,
  1079→      itemsChecked: 0,
  1080→      tasksChecked: 0,
  1081→    },
  1082→  };
  1083→
  1084→  const allTasks: LoadedTask[] = [];
  1085→  const allItems: LoadedSpecItem[] = [];
  1086→
  1087→  // Validate manifest
  1088→  if (ctx.manifestPath && runSchema) {
  1089→    const manifestErrors = await validateManifestFile(ctx.manifestPath);
  1090→    result.schemaErrors.push(...manifestErrors);
  1091→    result.stats.filesChecked++;
  1092→  }
  1093→
  1094→  // Load items from manifest (traits, inline modules, etc.)
  1095→  if (ctx.manifest && ctx.manifestPath) {
  1096→    const manifestItems = extractItemsFromRaw(ctx.manifest, ctx.manifestPath);
  1097→    allItems.push(...manifestItems);
  1098→    result.stats.itemsChecked += manifestItems.length;
  1099→  }
  1100→
  1101→  // Find and validate task files
  1102→  const taskFiles = await findTaskFiles(ctx.rootDir);
  1103→  const specTaskFiles = await findTaskFiles(path.join(ctx.rootDir, "spec"));
  1104→  const allTaskFiles = [...new Set([...taskFiles, ...specTaskFiles])];
  1105→
  1106→  for (const taskFile of allTaskFiles) {
  1107→    if (runSchema) {
  1108→      const taskErrors = await validateTasksFile(taskFile);
  1109→      result.schemaErrors.push(...taskErrors);
  1110→    }
  1111→    result.stats.filesChecked++;
  1112→
  1113→    // Load tasks for ref validation
  1114→    try {
  1115→      const raw = await readYamlFile<unknown>(taskFile);
  1116→      let taskList: unknown[] = [];
  1117→
  1118→      if (Array.isArray(raw)) {
  1119→        taskList = raw;
  1120→      } else if (raw && typeof raw === "object" && "tasks" in raw) {
  1121→        taskList = (raw as { tasks: unknown[] }).tasks || [];
  1122→      }
  1123→
  1124→      for (const t of taskList) {
  1125→        const parsed = TaskSchema.safeParse(t);
  1126→        if (parsed.success) {
  1127→          allTasks.push({ ...parsed.data, _sourceFile: taskFile });
  1128→          result.stats.tasksChecked++;
  1129→        }
  1130→      }
  1131→    } catch {
  1132→      // Already reported in schema validation
  1133→    }
  1134→  }
  1135→
  1136→  // Validate spec files (from includes)
  1137→  if (ctx.manifest && ctx.manifestPath) {
  1138→    const manifestDir = path.dirname(ctx.manifestPath);
  1139→    const includes = ctx.manifest.includes || [];
  1140→
  1141→    for (const include of includes) {
  1142→      const expandedPaths = await expandIncludePattern(include, manifestDir);
  1143→
  1144→      for (const filePath of expandedPaths) {
  1145→        if (runSchema) {
  1146→          const specErrors = await validateSpecFile(filePath);
  1147→          result.schemaErrors.push(...specErrors);
  1148→        }
  1149→        result.stats.filesChecked++;
  1150→
  1151→        // Load items for ref validation
  1152→        try {
  1153→          const items = await loadSpecFile(filePath);
  1154→          allItems.push(...items);
  1155→          result.stats.itemsChecked += items.length;
  1156→        } catch {
  1157→          // Already reported in schema validation
  1158→        }
  1159→      }
  1160→    }
  1161→  }
  1162→
  1163→  // Load meta items for reference validation
  1164→  // AC: @agent-definitions ac-agent-3
  1165→  const metaCtx = await loadMetaContext(ctx);
  1166→  const allMetaItems = [
  1167→    ...metaCtx.agents,
  1168→    ...metaCtx.workflows,
  1169→    ...metaCtx.conventions,
  1170→    ...metaCtx.observations,
  1171→  ];
  1172→
  1173→  // Load plans for reference validation
  1174→  // AC: @plan-validation ac-10
  1175→  const allPlans = await loadPlans(ctx);
  1176→
  1177→  // Reference validation
  1178→  if (
  1179→    runRefs &&
  1180→    (allTasks.length > 0 ||
  1181→      allItems.length > 0 ||
  1182→      allMetaItems.length > 0 ||
  1183→      allPlans.length > 0)
  1184→  ) {
  1185→    const index = new ReferenceIndex(
  1186→      allTasks,
  1187→      allItems,
  1188→      allMetaItems,
  1189→      allPlans,
  1190→    );
  1191→    const refResult = validateRefs(index, allTasks, allItems);
  1192→    result.refErrors = refResult.errors;
  1193→    result.refWarnings = refResult.warnings;
  1194→
  1195→    // AC: @trait-edge-cases ac-2
  1196→    // Detect circular trait references
  1197→    result.traitCycleErrors = detectTraitCycles(allItems, index);
  1198→
  1199→    // Orphan detection
  1200→    if (runOrphans) {
  1201→      result.orphans = findOrphans(allTasks, allItems, index);
  1202→    }
  1203→
  1204→    // Completeness validation
  1205→    // AC: @spec-completeness ac-1, ac-2, ac-3
  1206→    // AC: @trait-validation ac-3
  1207→    if (runCompleteness) {
  1208→      // Build trait index for trait AC coverage validation
  1209→      const traitIndex = new TraitIndex(allItems, index);
  1210→      result.completenessWarnings = await checkCompleteness(
  1211→        allItems,
  1212→        index,
  1213→        ctx.rootDir,
  1214→        traitIndex,
  1215→      );
  1216→
  1217→      // AC: @task-automation-eligibility ac-21, ac-23
  1218→      // Check automation eligibility warnings for tasks
  1219→      const automationWarnings = checkAutomationEligibility(allTasks, index);
  1220→      result.completenessWarnings.push(...automationWarnings);
  1221→    }
  1222→  }
  1223→
  1224→  // Meta manifest validation (AC-meta-manifest-2, AC-meta-manifest-3)
  1225→  const metaManifestPath = await findMetaManifest(ctx.specDir);
  1226→  if (metaManifestPath) {
  1227→    // Use metaCtx already loaded above
  1228→    result.metaStats = {
  1229→      agents: metaCtx.agents.length,
  1230→      workflows: metaCtx.workflows.length,
  1231→      conventions: metaCtx.conventions.length,
  1232→      observations: metaCtx.observations.length,
  1233→    };
  1234→
  1235→    // Validate meta manifest schema with strict ULID validation
  1236→    if (runSchema) {
  1237→      const metaErrors = await validateMetaManifestFile(metaManifestPath);
  1238→      // Prefix all meta errors with "meta:"
  1239→      for (const err of metaErrors) {
  1240→        err.path = err.path ? `meta:${err.path}` : "meta:";
  1241→      }
  1242→      result.schemaErrors.push(...metaErrors);
  1243→      result.stats.filesChecked++;
  1244→    }
  1245→  }
  1246→
  1247→  // Set valid flag
  1248→  result.valid =
  1249→    result.schemaErrors.length === 0 &&
  1250→    result.refErrors.length === 0 &&
  1251→    result.traitCycleErrors.length === 0;
  1252→
  1253→  return result;
  1254→}
  1255→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
