     1→import { execSync } from "node:child_process";
     2→import * as fs from "node:fs/promises";
     3→import * as path from "node:path";
     4→import { ulid } from "ulid";
     5→import * as YAML from "yaml";
     6→import {
     7→  InboxFileSchema,
     8→  type InboxItem,
     9→  type InboxItemInput,
    10→  InboxItemSchema,
    11→  type Manifest,
    12→  ManifestSchema,
    13→  type Note,
    14→  type SpecItem,
    15→  type SpecItemInput,
    16→  SpecItemSchema,
    17→  type Task,
    18→  type TaskInput,
    19→  TaskSchema,
    20→  TasksFileSchema,
    21→  type Todo,
    22→} from "../schema/index.js";
    23→import { errors } from "../strings/index.js";
    24→import { ItemIndex } from "./items.js";
    25→import type { LoadedPlan } from "./plans.js";
    26→import { ReferenceIndex } from "./refs.js";
    27→import {
    28→  detectRunningFromShadowWorktree,
    29→  detectShadow,
    30→  type ShadowConfig,
    31→  ShadowError,
    32→} from "./shadow.js";
    33→import { TraitIndex } from "./traits.js";
    34→
    35→/**
    36→ * Spec item with runtime metadata for source tracking.
    37→ * _sourceFile is not serialized - it's used to know where to write updates.
    38→ * _path tracks location within the file for nested items (e.g., "features[0].requirements[2]")
    39→ */
    40→export interface LoadedSpecItem extends SpecItem {
    41→  _sourceFile?: string;
    42→  _path?: string;
    43→}
    44→
    45→/**
    46→ * Task with runtime metadata for source tracking.
    47→ * _sourceFile is not serialized - it's used to know where to write updates.
    48→ */
    49→export interface LoadedTask extends Task {
    50→  _sourceFile?: string;
    51→}
    52→
    53→/**
    54→ * Parse YAML content into an object
    55→ * Uses the modern yaml library which has consistent type handling
    56→ */
    57→export function parseYaml<T>(content: string): T {
    58→  return YAML.parse(content) as T;
    59→}
    60→
    61→/**
    62→ * Serialize object to YAML
    63→ * Uses the modern yaml library for consistent formatting.
    64→ *
    65→ * WORKAROUND: The 'yaml' library (v2.8.2+) has a known behavior where block scalars
    66→ * containing whitespace-only lines accumulate extra blank lines on each parse-stringify
    67→ * cycle. The library's blockString() function adds indentation after newlines, which
    68→ * causes lines containing only spaces to grow. We post-process the output to filter
    69→ * these whitespace-only lines. See: https://github.com/eemeli/yaml - stringifyString.ts
    70→ */
    71→export function toYaml(obj: unknown): string {
    72→  let yamlString = YAML.stringify(obj, {
    73→    indent: 2,
    74→    lineWidth: 100,
    75→    sortMapEntries: false,
    76→  });
    77→
    78→  // Post-process to fix yaml library blank line accumulation bug.
    79→  // Filter out lines that contain only spaces/tabs (not truly empty lines).
    80→  yamlString = yamlString
    81→    .split("\n")
    82→    .filter((line) => !/^[ \t]+$/.test(line))
    83→    .join("\n");
    84→
    85→  return yamlString;
    86→}
    87→
    88→/**
    89→ * Read and parse a YAML file
    90→ */
    91→export async function readYamlFile<T>(filePath: string): Promise<T> {
    92→  const content = await fs.readFile(filePath, "utf-8");
    93→  return parseYaml<T>(content);
    94→}
    95→
    96→/**
    97→ * Write object to YAML file
    98→ */
    99→export async function writeYamlFile(
   100→  filePath: string,
   101→  data: unknown,
   102→): Promise<void> {
   103→  const content = toYaml(data);
   104→  await fs.writeFile(filePath, content, "utf-8");
   105→}
   106→
   107→/**
   108→ * Write object to YAML file while preserving formatting and comments.
   109→ *
   110→ * Note: This function is now equivalent to writeYamlFile() - the "preserve format"
   111→ * naming is historical. Both use toYaml() which includes the whitespace-only line
   112→ * fix. Kept for backwards compatibility with existing callers.
   113→ */
   114→export async function writeYamlFilePreserveFormat(
   115→  filePath: string,
   116→  data: unknown,
   117→): Promise<void> {
   118→  const content = toYaml(data);
   119→  await fs.writeFile(filePath, content, "utf-8");
   120→}
   121→
   122→/**
   123→ * Find task files in a directory
   124→ */
   125→export async function findTaskFiles(dir: string): Promise<string[]> {
   126→  const files: string[] = [];
   127→
   128→  try {
   129→    const entries = await fs.readdir(dir, { withFileTypes: true });
   130→
   131→    for (const entry of entries) {
   132→      const fullPath = path.join(dir, entry.name);
   133→
   134→      if (entry.isDirectory()) {
   135→        // Recurse into subdirectories
   136→        const subFiles = await findTaskFiles(fullPath);
   137→        files.push(...subFiles);
   138→      } else if (entry.isFile() && entry.name.endsWith(".tasks.yaml")) {
   139→        files.push(fullPath);
   140→      }
   141→    }
   142→  } catch (_error) {
   143→    // Directory doesn't exist or not readable
   144→  }
   145→
   146→  return files;
   147→}
   148→
   149→/**
   150→ * Find the manifest file.
   151→ *
   152→ * Discovery algorithm per directory:
   153→ * 1. Check for explicit names: kynetic.yaml, kynetic.spec.yaml (backward compat)
   154→ * 2. If not found, scan for *.yaml files with 'kynetic:' version field
   155→ *
   156→ * Searches current dir, then spec/ subdir, then parent directories.
   157→ */
   158→export async function findManifest(startDir: string): Promise<string | null> {
   159→  let dir = startDir;
   160→
   161→  while (true) {
   162→    // Check current directory
   163→    const manifestInDir = await findManifestInDir(dir);
   164→    if (manifestInDir) {
   165→      return manifestInDir;
   166→    }
   167→
   168→    // Also check in spec/ subdirectory
   169→    const specDir = path.join(dir, "spec");
   170→    try {
   171→      const stat = await fs.stat(specDir);
   172→      if (stat.isDirectory()) {
   173→        const manifestInSpec = await findManifestInDir(specDir);
   174→        if (manifestInSpec) {
   175→          return manifestInSpec;
   176→        }
   177→      }
   178→    } catch {
   179→      // spec/ doesn't exist
   180→    }
   181→
   182→    const parentDir = path.dirname(dir);
   183→    if (parentDir === dir) {
   184→      // Reached root
   185→      return null;
   186→    }
   187→    dir = parentDir;
   188→  }
   189→}
   190→
   191→/**
   192→ * Context for working with spec/task files.
   193→ *
   194→ * When shadow branch is enabled:
   195→ * - rootDir points to the project root (where .kspec/ lives)
   196→ * - specDir points to .kspec/ (where spec files are read/written)
   197→ * - All file operations use specDir for resolution
   198→ *
   199→ * Without shadow branch:
   200→ * - rootDir is the project root
   201→ * - specDir is rootDir/spec/ (traditional layout)
   202→ */
   203→export interface KspecContext {
   204→  /** Project root directory */
   205→  rootDir: string;
   206→  /** Spec files directory (.kspec/ when shadow enabled, otherwise spec/) */
   207→  specDir: string;
   208→  /** Path to manifest file */
   209→  manifestPath: string | null;
   210→  /** Parsed manifest */
   211→  manifest: Manifest | null;
   212→  /** Shadow branch configuration (null if not using shadow) */
   213→  shadow: ShadowConfig | null;
   214→}
   215→
   216→/**
   217→ * Initialize context by finding manifest.
   218→ *
   219→ * Detection order:
   220→ * 1. Check for shadow branch (.kspec/ directory)
   221→ * 2. Fall back to traditional spec/ directory
   222→ *
   223→ * When shadow is detected, all operations use .kspec/ as specDir.
   224→ */
   225→export async function initContext(startDir?: string): Promise<KspecContext> {
   226→  // KSPEC_SPEC_DIR override: used by batch atomic mode to redirect to temp copy
   227→  const specDirOverride = process.env.KSPEC_SPEC_DIR;
   228→  if (specDirOverride) {
   229→    const specDir = path.resolve(specDirOverride);
   230→    const manifestPath = await findManifestInDir(specDir);
   231→
   232→    let manifest: Manifest | null = null;
   233→    if (manifestPath) {
   234→      try {
   235→        const rawManifest = await readYamlFile<unknown>(manifestPath);
   236→        manifest = ManifestSchema.parse(rawManifest);
   237→      } catch {
   238→        // Manifest exists but may be invalid
   239→      }
   240→    }
   241→
   242→    return {
   243→      rootDir: path.dirname(specDir),
   244→      specDir,
   245→      manifestPath,
   246→      manifest,
   247→      shadow: null, // No shadow in overridden context
   248→    };
   249→  }
   250→
   251→  const cwd = startDir || process.cwd();
   252→
   253→  // Check if running from inside the shadow worktree
   254→  const mainProjectRoot = await detectRunningFromShadowWorktree(cwd);
   255→  if (mainProjectRoot) {
   256→    throw new ShadowError(
   257→      errors.project.runningFromShadow,
   258→      "RUNNING_FROM_SHADOW",
   259→      `Run from project root: cd ${path.relative(cwd, mainProjectRoot) || mainProjectRoot}`,
   260→    );
   261→  }
   262→
   263→  // Try to detect shadow branch first
   264→  const shadow = await detectShadow(cwd);
   265→
   266→  if (shadow?.enabled) {
   267→    // Shadow mode: use .kspec/ for everything
   268→    const specDir = shadow.worktreeDir;
   269→    const manifestPath = await findManifestInDir(specDir);
   270→
   271→    let manifest: Manifest | null = null;
   272→    if (manifestPath) {
   273→      try {
   274→        const rawManifest = await readYamlFile<unknown>(manifestPath);
   275→        manifest = ManifestSchema.parse(rawManifest);
   276→      } catch {
   277→        // Manifest exists but may be invalid
   278→      }
   279→    }
   280→
   281→    return {
   282→      rootDir: shadow.projectRoot,
   283→      specDir,
   284→      manifestPath,
   285→      manifest,
   286→      shadow,
   287→    };
   288→  }
   289→
   290→  // Traditional mode: find manifest in spec/ or current directory
   291→  const manifestPath = await findManifest(cwd);
   292→
   293→  let manifest: Manifest | null = null;
   294→  let rootDir = cwd;
   295→  let specDir = cwd;
   296→
   297→  if (manifestPath) {
   298→    const manifestDir = path.dirname(manifestPath);
   299→    // Handle spec/ subdirectory
   300→    if (path.basename(manifestDir) === "spec") {
   301→      rootDir = path.dirname(manifestDir);
   302→      specDir = manifestDir;
   303→    } else {
   304→      rootDir = manifestDir;
   305→      specDir = manifestDir;
   306→    }
   307→
   308→    try {
   309→      const rawManifest = await readYamlFile<unknown>(manifestPath);
   310→      manifest = ManifestSchema.parse(rawManifest);
   311→    } catch {
   312→      // Manifest exists but may be invalid
   313→    }
   314→  }
   315→
   316→  return { rootDir, specDir, manifestPath, manifest, shadow: null };
   317→}
   318→
   319→/**
   320→ * Check if a filename is a potential manifest file.
   321→ * Excludes files with suffixes that indicate other kspec file types.
   322→ *
   323→ * AC: @manifest-discovery ac-5 (excludes task/inbox/meta/runs files)
   324→ */
   325→function isManifestCandidate(filename: string): boolean {
   326→  if (!filename.endsWith(".yaml")) return false;
   327→  const exclusions = [".tasks.yaml", ".inbox.yaml", ".meta.yaml", ".runs.yaml"];
   328→  return !exclusions.some((excl) => filename.endsWith(excl));
   329→}
   330→
   331→/**
   332→ * Find manifest file within a specific directory (no parent traversal).
   333→ * Used for shadow mode where we know exactly where to look.
   334→ *
   335→ * Discovery algorithm:
   336→ * 1. Check for explicit names: kynetic.yaml, kynetic.spec.yaml (backward compat)
   337→ * 2. If not found, scan directory for *.yaml files (excluding other kspec types)
   338→ * 3. For each candidate, validate it contains a 'kynetic:' version field
   339→ * 4. Return first valid match (alphabetically after explicit names)
   340→ *
   341→ * AC: @manifest-discovery ac-1, ac-2, ac-3, ac-4, ac-5
   342→ */
   343→async function findManifestInDir(dir: string): Promise<string | null> {
   344→  // AC: @manifest-discovery ac-1, ac-2 - explicit names have priority
   345→  const priorityCandidates = ["kynetic.yaml", "kynetic.spec.yaml"];
   346→
   347→  for (const candidate of priorityCandidates) {
   348→    const filePath = path.join(dir, candidate);
   349→    try {
   350→      await fs.access(filePath);
   351→      return filePath;
   352→    } catch {
   353→      // File doesn't exist, try next
   354→    }
   355→  }
   356→
   357→  // AC: @manifest-discovery ac-3, ac-4, ac-5 - glob fallback with validation
   358→  try {
   359→    const entries = await fs.readdir(dir);
   360→    // AC: @manifest-discovery ac-4 - alphabetical order
   361→    const candidates = entries.filter(isManifestCandidate).sort();
   362→
   363→    for (const candidate of candidates) {
   364→      const filePath = path.join(dir, candidate);
   365→      try {
   366→        const raw = await readYamlFile<unknown>(filePath);
   367→        // AC: @manifest-discovery ac-5 - validate kynetic version field
   368→        if (raw && typeof raw === "object" && "kynetic" in raw) {
   369→          return filePath;
   370→        }
   371→      } catch {
   372→        // Skip invalid files
   373→      }
   374→    }
   375→  } catch {
   376→    // Directory read failed
   377→  }
   378→
   379→  return null;
   380→}
   381→
   382→/**
   383→ * Load tasks from a single file.
   384→ * Helper function used by loadAllTasks.
   385→ */
   386→async function loadTasksFromFile(filePath: string): Promise<LoadedTask[]> {
   387→  const tasks: LoadedTask[] = [];
   388→
   389→  try {
   390→    const raw = await readYamlFile<unknown>(filePath);
   391→
   392→    // Handle both array format and object format
   393→    let taskList: unknown[];
   394→
   395→    if (Array.isArray(raw)) {
   396→      taskList = raw;
   397→    } else if (raw && typeof raw === "object" && "tasks" in raw) {
   398→      const parsed = TasksFileSchema.safeParse(raw);
   399→      if (parsed.success) {
   400→        // Add _sourceFile to each task from this file
   401→        for (const task of parsed.data.tasks) {
   402→          tasks.push({ ...task, _sourceFile: filePath });
   403→        }
   404→        return tasks;
   405→      }
   406→      taskList = (raw as { tasks: unknown[] }).tasks || [];
   407→    } else {
   408→      // Single task object
   409→      taskList = [raw];
   410→    }
   411→
   412→    for (const taskData of taskList) {
   413→      const result = TaskSchema.safeParse(taskData);
   414→      if (result.success) {
   415→        // Add _sourceFile metadata
   416→        tasks.push({ ...result.data, _sourceFile: filePath });
   417→      }
   418→    }
   419→  } catch {
   420→    // Skip invalid files
   421→  }
   422→
   423→  return tasks;
   424→}
   425→
   426→/**
   427→ * Load all tasks from the project.
   428→ * Each task includes _sourceFile metadata for write-back routing.
   429→ *
   430→ * When shadow is enabled, tasks are loaded from .kspec/ (ctx.specDir).
   431→ * Otherwise, searches in traditional locations (rootDir, spec/, tasks/).
   432→ */
   433→export async function loadAllTasks(ctx: KspecContext): Promise<LoadedTask[]> {
   434→  const tasks: LoadedTask[] = [];
   435→
   436→  // When shadow is enabled, look only in specDir
   437→  if (ctx.shadow?.enabled) {
   438→    const taskFiles = await findTaskFiles(ctx.specDir);
   439→
   440→    // Also check for standalone files in specDir
   441→    const standaloneLocations = [
   442→      path.join(ctx.specDir, "tasks.yaml"),
   443→      path.join(ctx.specDir, "project.tasks.yaml"),
   444→      path.join(ctx.specDir, "kynetic.tasks.yaml"),
   445→      path.join(ctx.specDir, "backlog.tasks.yaml"),
   446→      path.join(ctx.specDir, "active.tasks.yaml"),
   447→    ];
   448→
   449→    for (const loc of standaloneLocations) {
   450→      try {
   451→        await fs.access(loc);
   452→        if (!taskFiles.includes(loc)) {
   453→          taskFiles.push(loc);
   454→        }
   455→      } catch {
   456→        // File doesn't exist
   457→      }
   458→    }
   459→
   460→    // Deduplicate and load
   461→    const uniqueFiles = [...new Set(taskFiles)];
   462→    for (const filePath of uniqueFiles) {
   463→      const fileTasks = await loadTasksFromFile(filePath);
   464→      tasks.push(...fileTasks);
   465→    }
   466→
   467→    return tasks;
   468→  }
   469→
   470→  // Traditional mode: look in multiple locations
   471→  const taskFiles = await findTaskFiles(ctx.rootDir);
   472→
   473→  // Also check common locations
   474→  const additionalPaths = [
   475→    path.join(ctx.rootDir, "tasks"),
   476→    path.join(ctx.rootDir, "spec"),
   477→  ];
   478→
   479→  for (const additionalPath of additionalPaths) {
   480→    const files = await findTaskFiles(additionalPath);
   481→    taskFiles.push(...files);
   482→  }
   483→
   484→  // Also look for standalone tasks.yaml and project.tasks.yaml
   485→  const standaloneLocations = [
   486→    path.join(ctx.rootDir, "tasks.yaml"),
   487→    path.join(ctx.rootDir, "project.tasks.yaml"),
   488→    path.join(ctx.rootDir, "spec", "project.tasks.yaml"),
   489→    path.join(ctx.rootDir, "backlog.tasks.yaml"),
   490→    path.join(ctx.rootDir, "active.tasks.yaml"),
   491→  ];
   492→
   493→  for (const loc of standaloneLocations) {
   494→    try {
   495→      await fs.access(loc);
   496→      if (!taskFiles.includes(loc)) {
   497→        taskFiles.push(loc);
   498→      }
   499→    } catch {
   500→      // File doesn't exist
   501→    }
   502→  }
   503→
   504→  // Deduplicate and load
   505→  const uniqueFiles = [...new Set(taskFiles)];
   506→
   507→  for (const filePath of uniqueFiles) {
   508→    const fileTasks = await loadTasksFromFile(filePath);
   509→    tasks.push(...fileTasks);
   510→  }
   511→
   512→  return tasks;
   513→}
   514→
   515→/**
   516→ * Find a task by reference (ULID, slug, or short reference)
   517→ */
   518→export function findTaskByRef(
   519→  tasks: LoadedTask[],
   520→  ref: string,
   521→): LoadedTask | undefined {
   522→  // Remove @ prefix if present
   523→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
   524→
   525→  return tasks.find((task) => {
   526→    // Match full ULID
   527→    if (task._ulid === cleanRef) return true;
   528→
   529→    // Match short ULID (prefix)
   530→    if (task._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
   531→      return true;
   532→
   533→    // Match slug
   534→    if (task.slugs.includes(cleanRef)) return true;
   535→
   536→    return false;
   537→  });
   538→}
   539→
   540→/**
   541→ * Get the default task file path for new tasks without a spec_ref.
   542→ *
   543→ * When shadow enabled: .kspec/project.tasks.yaml
   544→ * Otherwise: spec/project.tasks.yaml
   545→ */
   546→export function getDefaultTaskFilePath(ctx: KspecContext): string {
   547→  return path.join(ctx.specDir, "project.tasks.yaml");
   548→}
   549→
   550→/**
   551→ * Strip runtime metadata before serialization
   552→ */
   553→function stripRuntimeMetadata(task: LoadedTask): Task {
   554→  const { _sourceFile, ...cleanTask } = task;
   555→  return cleanTask as Task;
   556→}
   557→
   558→/**
   559→ * Save a task to its source file (or default location for new tasks).
   560→ * Preserves file format (tasks: [...] wrapper vs plain array).
   561→ */
   562→export async function saveTask(
   563→  ctx: KspecContext,
   564→  task: LoadedTask,
   565→): Promise<void> {
   566→  // Determine target file: use _sourceFile if present, otherwise default
   567→  const taskFilePath = task._sourceFile || getDefaultTaskFilePath(ctx);
   568→
   569→  // Ensure directory exists
   570→  const dir = path.dirname(taskFilePath);
   571→  await fs.mkdir(dir, { recursive: true });
   572→
   573→  // Load existing tasks from the target file
   574→  let existingRaw: unknown = null;
   575→  let useTasksWrapper = false;
   576→
   577→  try {
   578→    existingRaw = await readYamlFile<unknown>(taskFilePath);
   579→    // Detect if file uses { tasks: [...] } format
   580→    if (
   581→      existingRaw &&
   582→      typeof existingRaw === "object" &&
   583→      "tasks" in existingRaw
   584→    ) {
   585→      useTasksWrapper = true;
   586→    }
   587→  } catch {
   588→    // File doesn't exist, start fresh
   589→  }
   590→
   591→  // Parse existing tasks from file
   592→  let fileTasks: Task[] = [];
   593→
   594→  if (existingRaw) {
   595→    if (Array.isArray(existingRaw)) {
   596→      for (const t of existingRaw) {
   597→        const result = TaskSchema.safeParse(t);
   598→        if (result.success) {
   599→          fileTasks.push(result.data);
   600→        }
   601→      }
   602→    } else if (useTasksWrapper) {
   603→      // Try TasksFileSchema first (has kynetic_tasks version)
   604→      const parsed = TasksFileSchema.safeParse(existingRaw);
   605→      if (parsed.success) {
   606→        fileTasks = parsed.data.tasks;
   607→      } else {
   608→        // Fall back to raw tasks array (common format without version field)
   609→        const rawTasks = (existingRaw as { tasks: unknown[] }).tasks;
   610→        if (Array.isArray(rawTasks)) {
   611→          for (const t of rawTasks) {
   612→            const result = TaskSchema.safeParse(t);
   613→            if (result.success) {
   614→              fileTasks.push(result.data);
   615→            }
   616→          }
   617→        }
   618→      }
   619→    }
   620→  }
   621→
   622→  // Strip runtime metadata before saving
   623→  const cleanTask = stripRuntimeMetadata(task);
   624→
   625→  // Update existing or add new
   626→  const existingIndex = fileTasks.findIndex((t) => t._ulid === task._ulid);
   627→  if (existingIndex >= 0) {
   628→    fileTasks[existingIndex] = cleanTask;
   629→  } else {
   630→    fileTasks.push(cleanTask);
   631→  }
   632→
   633→  // Save in the same format as original (or tasks: wrapper for new files)
   634→  // Use format-preserving write to maintain formatting and comments
   635→  if (useTasksWrapper) {
   636→    await writeYamlFilePreserveFormat(taskFilePath, { tasks: fileTasks });
   637→  } else {
   638→    await writeYamlFilePreserveFormat(taskFilePath, fileTasks);
   639→  }
   640→}
   641→
   642→/**
   643→ * Delete a task from its source file.
   644→ * Requires _sourceFile to know which file to modify.
   645→ */
   646→export async function deleteTask(
   647→  _ctx: KspecContext,
   648→  task: LoadedTask,
   649→): Promise<void> {
   650→  if (!task._sourceFile) {
   651→    throw new Error("Cannot delete task without _sourceFile metadata");
   652→  }
   653→
   654→  const taskFilePath = task._sourceFile;
   655→
   656→  // Load existing file
   657→  let existingRaw: unknown = null;
   658→  let useTasksWrapper = false;
   659→
   660→  try {
   661→    existingRaw = await readYamlFile<unknown>(taskFilePath);
   662→    if (
   663→      existingRaw &&
   664→      typeof existingRaw === "object" &&
   665→      "tasks" in existingRaw
   666→    ) {
   667→      useTasksWrapper = true;
   668→    }
   669→  } catch {
   670→    throw new Error(`Task file not found: ${taskFilePath}`);
   671→  }
   672→
   673→  // Parse existing tasks
   674→  let fileTasks: Task[] = [];
   675→
   676→  if (existingRaw) {
   677→    if (Array.isArray(existingRaw)) {
   678→      for (const t of existingRaw) {
   679→        const result = TaskSchema.safeParse(t);
   680→        if (result.success) {
   681→          fileTasks.push(result.data);
   682→        }
   683→      }
   684→    } else if (useTasksWrapper) {
   685→      const parsed = TasksFileSchema.safeParse(existingRaw);
   686→      if (parsed.success) {
   687→        fileTasks = parsed.data.tasks;
   688→      } else {
   689→        const rawTasks = (existingRaw as { tasks: unknown[] }).tasks;
   690→        if (Array.isArray(rawTasks)) {
   691→          for (const t of rawTasks) {
   692→            const result = TaskSchema.safeParse(t);
   693→            if (result.success) {
   694→              fileTasks.push(result.data);
   695→            }
   696→          }
   697→        }
   698→      }
   699→    }
   700→  }
   701→
   702→  // Remove the task
   703→  const originalCount = fileTasks.length;
   704→  fileTasks = fileTasks.filter((t) => t._ulid !== task._ulid);
   705→
   706→  if (fileTasks.length === originalCount) {
   707→    throw new Error(`Task not found in file: ${task._ulid}`);
   708→  }
   709→
   710→  // Save the modified file with format preservation
   711→  if (useTasksWrapper) {
   712→    await writeYamlFilePreserveFormat(taskFilePath, { tasks: fileTasks });
   713→  } else {
   714→    await writeYamlFilePreserveFormat(taskFilePath, fileTasks);
   715→  }
   716→}
   717→
   718→/**
   719→ * Create a new task with auto-generated fields
   720→ */
   721→export function createTask(input: TaskInput): Task {
   722→  const now = new Date().toISOString();
   723→
   724→  return {
   725→    ...input,
   726→    _ulid: input._ulid || ulid(),
   727→    slugs: input.slugs || [],
   728→    type: input.type || "task",
   729→    status: input.status || "pending",
   730→    blocked_by: input.blocked_by || [],
   731→    depends_on: input.depends_on || [],
   732→    context: input.context || [],
   733→    priority: input.priority || 3,
   734→    tags: input.tags || [],
   735→    vcs_refs: input.vcs_refs || [],
   736→    created_at: input.created_at || now,
   737→    notes: input.notes || [],
   738→    todos: input.todos || [],
   739→  };
   740→}
   741→
   742→/**
   743→ * Get author from environment with fallback chain.
   744→ * Priority:
   745→ *   1. KSPEC_AUTHOR env var (explicit config, agent-agnostic)
   746→ *   2. git user.name (developer identity)
   747→ *   3. USER/USERNAME env var (system user)
   748→ *   4. undefined (will show as 'unknown' in output)
   749→ *
   750→ * For Claude Code integration, add to ~/.claude/settings.json:
   751→ *   { "env": { "KSPEC_AUTHOR": "@claude" } }
   752→ */
   753→export function getAuthor(): string | undefined {
   754→  // 1. Explicit config (works for any agent)
   755→  if (process.env.KSPEC_AUTHOR) {
   756→    return process.env.KSPEC_AUTHOR;
   757→  }
   758→
   759→  // 2. Git user.name
   760→  try {
   761→    const gitUser = execSync("git config user.name", {
   762→      encoding: "utf-8",
   763→      stdio: ["pipe", "pipe", "ignore"],
   764→    }).trim();
   765→    if (gitUser) {
   766→      return gitUser;
   767→    }
   768→  } catch {
   769→    // git not available or not in a repo
   770→  }
   771→
   772→  // 3. System user
   773→  const systemUser = process.env.USER || process.env.USERNAME;
   774→  if (systemUser) {
   775→    return systemUser;
   776→  }
   777→
   778→  // 4. No author available
   779→  return undefined;
   780→}
   781→
   782→/**
   783→ * Create a new note entry.
   784→ * If author is not provided, attempts to auto-detect from environment.
   785→ */
   786→export function createNote(
   787→  content: string,
   788→  author?: string,
   789→  supersedes?: string,
   790→): Note {
   791→  return {
   792→    _ulid: ulid(),
   793→    created_at: new Date().toISOString(),
   794→    author: author ?? getAuthor(),
   795→    // Trim content to prevent whitespace-only lines from accumulating
   796→    // in block scalars during YAML parse-stringify cycles
   797→    content: content.trim(),
   798→    supersedes: supersedes || null,
   799→  };
   800→}
   801→
   802→/**
   803→ * Create a new todo item.
   804→ * The id should be the next available id for the task's todos array.
   805→ */
   806→export function createTodo(id: number, text: string, addedBy?: string): Todo {
   807→  return {
   808→    id,
   809→    // Trim text to prevent whitespace-only lines from accumulating
   810→    // in block scalars during YAML parse-stringify cycles
   811→    text: text.trim(),
   812→    done: false,
   813→    added_at: new Date().toISOString(),
   814→    added_by: addedBy ?? getAuthor(),
   815→  };
   816→}
   817→
   818→/**
   819→ * Check if task dependencies are met
   820→ */
   821→export function areDependenciesMet(
   822→  task: LoadedTask,
   823→  allTasks: LoadedTask[],
   824→): boolean {
   825→  if (task.depends_on.length === 0) return true;
   826→
   827→  for (const depRef of task.depends_on) {
   828→    const depTask = findTaskByRef(allTasks, depRef);
   829→    if (!depTask || depTask.status !== "completed") {
   830→      return false;
   831→    }
   832→  }
   833→
   834→  return true;
   835→}
   836→
   837→/**
   838→ * Check if task is ready (pending + deps met + not blocked)
   839→ */
   840→export function isTaskReady(task: LoadedTask, allTasks: LoadedTask[]): boolean {
   841→  if (task.status !== "pending") return false;
   842→  if (task.blocked_by.length > 0) return false;
   843→  return areDependenciesMet(task, allTasks);
   844→}
   845→
   846→/**
   847→ * Get ready tasks (pending + deps met + not blocked), sorted by priority then creation time.
   848→ * Within the same priority tier, older tasks come first (FIFO).
   849→ */
   850→export function getReadyTasks(tasks: LoadedTask[]): LoadedTask[] {
   851→  return tasks
   852→    .filter((task) => isTaskReady(task, tasks))
   853→    .sort((a, b) => {
   854→      // Primary: priority (lower number = higher priority)
   855→      if (a.priority !== b.priority) {
   856→        return a.priority - b.priority;
   857→      }
   858→      // Secondary: creation time (older first - FIFO within priority)
   859→      return (
   860→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime()
   861→      );
   862→    });
   863→}
   864→
   865→// ============================================================
   866→// SPEC ITEM LOADING
   867→// ============================================================
   868→
   869→/**
   870→ * Expand a glob-like include pattern to file paths.
   871→ * Supports simple patterns like "modules/*.yaml" or "**\/*.yaml"
   872→ */
   873→export async function expandIncludePattern(
   874→  pattern: string,
   875→  baseDir: string,
   876→): Promise<string[]> {
   877→  const fullPattern = path.isAbsolute(pattern)
   878→    ? pattern
   879→    : path.join(baseDir, pattern);
   880→
   881→  // If no glob characters, just return the path if it exists
   882→  if (!pattern.includes("*")) {
   883→    try {
   884→      await fs.access(fullPattern);
   885→      return [fullPattern];
   886→    } catch {
   887→      return [];
   888→    }
   889→  }
   890→
   891→  // Split pattern into directory part and file pattern
   892→  const parts = pattern.split("/");
   893→  let currentDir = baseDir;
   894→  const result: string[] = [];
   895→
   896→  // Find the first part with a glob
   897→  const globIndex = parts.findIndex((p) => p.includes("*"));
   898→
   899→  // Navigate to the directory before the glob
   900→  if (globIndex > 0) {
   901→    currentDir = path.join(baseDir, ...parts.slice(0, globIndex));
   902→  }
   903→
   904→  // Get the remaining pattern
   905→  const remainingPattern = parts.slice(globIndex).join("/");
   906→
   907→  await expandGlobRecursive(currentDir, remainingPattern, result);
   908→  return result;
   909→}
   910→
   911→/**
   912→ * Recursively expand glob patterns
   913→ */
   914→async function expandGlobRecursive(
   915→  dir: string,
   916→  pattern: string,
   917→  result: string[],
   918→): Promise<void> {
   919→  const parts = pattern.split("/");
   920→  const currentPattern = parts[0];
   921→  const remainingPattern = parts.slice(1).join("/");
   922→
   923→  try {
   924→    const entries = await fs.readdir(dir, { withFileTypes: true });
   925→
   926→    for (const entry of entries) {
   927→      const matches = matchGlobPart(entry.name, currentPattern);
   928→
   929→      if (matches) {
   930→        const fullPath = path.join(dir, entry.name);
   931→
   932→        if (remainingPattern) {
   933→          // More pattern parts to process
   934→          if (entry.isDirectory()) {
   935→            await expandGlobRecursive(fullPath, remainingPattern, result);
   936→          }
   937→        } else {
   938→          // This is the final pattern part
   939→          if (currentPattern === "**") {
   940→            // ** matches any depth - need special handling
   941→            if (entry.isDirectory()) {
   942→              await expandGlobRecursive(fullPath, "**", result);
   943→            }
   944→            // Also match files at this level
   945→            result.push(fullPath);
   946→          } else if (entry.isFile()) {
   947→            result.push(fullPath);
   948→          }
   949→        }
   950→      }
   951→
   952→      // Handle ** - also recurse into directories without consuming the pattern
   953→      if (currentPattern === "**" && entry.isDirectory()) {
   954→        const fullPath = path.join(dir, entry.name);
   955→        await expandGlobRecursive(fullPath, pattern, result);
   956→      }
   957→    }
   958→  } catch {
   959→    // Directory doesn't exist or not readable
   960→  }
   961→}
   962→
   963→/**
   964→ * Match a single path component against a glob pattern part
   965→ */
   966→function matchGlobPart(name: string, pattern: string): boolean {
   967→  if (pattern === "*") return true;
   968→  if (pattern === "**") return true;
   969→
   970→  // Convert glob pattern to regex
   971→  const regexPattern = pattern
   972→    .replace(/[.+^${}()|[\]\\]/g, "\\$&") // Escape special regex chars
   973→    .replace(/\*/g, ".*") // * matches anything
   974→    .replace(/\?/g, "."); // ? matches single char
   975→
   976→  const regex = new RegExp(`^${regexPattern}$`);
   977→  return regex.test(name);
   978→}
   979→
   980→/**
   981→ * Fields that may contain nested spec items
   982→ */
   983→const NESTED_ITEM_FIELDS = [
   984→  "modules",
   985→  "features",
   986→  "requirements",
   987→  "constraints",
   988→  "decisions",
   989→  "traits",
   990→  "acceptance_criteria",
   991→];
   992→
   993→/**
   994→ * Recursively extract all spec items from a raw YAML structure.
   995→ * Items can be nested under modules/features/requirements/etc.
   996→ * Tracks the path within the file for each item.
   997→ */
   998→export function extractItemsFromRaw(
   999→  raw: unknown,
  1000→  sourceFile: string,
  1001→  items: LoadedSpecItem[] = [],
  1002→  currentPath: string = "",
  1003→): LoadedSpecItem[] {
  1004→  if (!raw || typeof raw !== "object") {
  1005→    return items;
  1006→  }
  1007→
  1008→  // Check if this object is itself a spec item (has _ulid)
  1009→  if (
  1010→    "_ulid" in raw &&
  1011→    typeof (raw as Record<string, unknown>)._ulid === "string"
  1012→  ) {
  1013→    // Strip nested item arrays before validation since they're processed separately
  1014→    // and the SpecItemSchema expects refs (strings), not nested objects
  1015→    const rawObj = raw as Record<string, unknown>;
  1016→    const cleanedForValidation: Record<string, unknown> = { ...rawObj };
  1017→    for (const field of NESTED_ITEM_FIELDS) {
  1018→      if (field in cleanedForValidation && Array.isArray(cleanedForValidation[field])) {
  1019→        const arr = cleanedForValidation[field] as unknown[];
  1020→        // Check if array contains nested items (objects with _ulid) vs refs (strings)
  1021→        const hasNestedItems = arr.some(
  1022→          (item) =>
  1023→            item && typeof item === "object" && "_ulid" in (item as Record<string, unknown>)
  1024→        );
  1025→        if (hasNestedItems) {
  1026→          // Strip nested items - they'll be extracted recursively
  1027→          delete cleanedForValidation[field];
  1028→        }
  1029→      }
  1030→    }
  1031→
  1032→    const result = SpecItemSchema.safeParse(cleanedForValidation);
  1033→    if (result.success) {
  1034→      items.push({
  1035→        ...result.data,
  1036→        _sourceFile: sourceFile,
  1037→        _path: currentPath || undefined,
  1038→      });
  1039→    }
  1040→
  1041→    // Even if the item itself was added, also extract nested items
  1042→    for (const field of NESTED_ITEM_FIELDS) {
  1043→      if (field in rawObj && Array.isArray(rawObj[field])) {
  1044→        const arr = rawObj[field] as unknown[];
  1045→        for (let i = 0; i < arr.length; i++) {
  1046→          const nestedPath = currentPath
  1047→            ? `${currentPath}.${field}[${i}]`
  1048→            : `${field}[${i}]`;
  1049→          extractItemsFromRaw(arr[i], sourceFile, items, nestedPath);
  1050→        }
  1051→      }
  1052→    }
  1053→  } else if (Array.isArray(raw)) {
  1054→    // Array of items at root level
  1055→    for (let i = 0; i < raw.length; i++) {
  1056→      const itemPath = currentPath ? `${currentPath}[${i}]` : `[${i}]`;
  1057→      extractItemsFromRaw(raw[i], sourceFile, items, itemPath);
  1058→    }
  1059→  } else {
  1060→    // Object that might contain item arrays (like manifest with modules/features/etc)
  1061→    const rawObj = raw as Record<string, unknown>;
  1062→    for (const field of NESTED_ITEM_FIELDS) {
  1063→      if (field in rawObj && Array.isArray(rawObj[field])) {
  1064→        const arr = rawObj[field] as unknown[];
  1065→        for (let i = 0; i < arr.length; i++) {
  1066→          const nestedPath = currentPath
  1067→            ? `${currentPath}.${field}[${i}]`
  1068→            : `${field}[${i}]`;
  1069→          extractItemsFromRaw(arr[i], sourceFile, items, nestedPath);
  1070→        }
  1071→      }
  1072→    }
  1073→  }
  1074→
  1075→  return items;
  1076→}
  1077→
  1078→/**
  1079→ * Load spec items from a single file.
  1080→ * Handles module files (the file itself is an item with nested children).
  1081→ */
  1082→export async function loadSpecFile(
  1083→  filePath: string,
  1084→): Promise<LoadedSpecItem[]> {
  1085→  try {
  1086→    const content = await fs.readFile(filePath, "utf-8");
  1087→    const items: LoadedSpecItem[] = [];
  1088→
  1089→    // Parse all YAML documents in the file (handles files with ---)
  1090→    const documents = YAML.parseAllDocuments(content);
  1091→
  1092→    for (const doc of documents) {
  1093→      if (doc.errors.length > 0) {
  1094→        // Skip documents with parse errors
  1095→        continue;
  1096→      }
  1097→
  1098→      const raw = doc.toJS();
  1099→      if (raw) {
  1100→        const docItems = extractItemsFromRaw(raw, filePath);
  1101→        items.push(...docItems);
  1102→      }
  1103→    }
  1104→
  1105→    return items;
  1106→  } catch (_error) {
  1107→    // File doesn't exist or parse error
  1108→    return [];
  1109→  }
  1110→}
  1111→
  1112→/**
  1113→ * Load all spec items from the project.
  1114→ * Parses manifest, follows includes, and builds unified collection.
  1115→ */
  1116→export async function loadAllItems(
  1117→  ctx: KspecContext,
  1118→): Promise<LoadedSpecItem[]> {
  1119→  const items: LoadedSpecItem[] = [];
  1120→
  1121→  if (!ctx.manifest || !ctx.manifestPath) {
  1122→    return items;
  1123→  }
  1124→
  1125→  const manifestDir = path.dirname(ctx.manifestPath);
  1126→
  1127→  // Extract items from manifest itself (inline modules/features/etc)
  1128→  const manifestItems = extractItemsFromRaw(ctx.manifest, ctx.manifestPath);
  1129→  items.push(...manifestItems);
  1130→
  1131→  // Process includes
  1132→  const includes = ctx.manifest.includes || [];
  1133→
  1134→  for (const include of includes) {
  1135→    const expandedPaths = await expandIncludePattern(include, manifestDir);
  1136→
  1137→    for (const filePath of expandedPaths) {
  1138→      const fileItems = await loadSpecFile(filePath);
  1139→      items.push(...fileItems);
  1140→    }
  1141→  }
  1142→
  1143→  return items;
  1144→}
  1145→
  1146→/**
  1147→ * Find a spec item by reference (ULID, slug, or short reference)
  1148→ */
  1149→export function findItemByRef(
  1150→  items: LoadedSpecItem[],
  1151→  ref: string,
  1152→): LoadedSpecItem | undefined {
  1153→  // Remove @ prefix if present
  1154→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  1155→
  1156→  return items.find((item) => {
  1157→    // Match full ULID
  1158→    if (item._ulid === cleanRef) return true;
  1159→
  1160→    // Match short ULID (prefix)
  1161→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
  1162→      return true;
  1163→
  1164→    // Match slug
  1165→    if (item.slugs.includes(cleanRef)) return true;
  1166→
  1167→    return false;
  1168→  });
  1169→}
  1170→
  1171→/**
  1172→ * Combined item type for unified queries across tasks and spec items
  1173→ */
  1174→export type AnyLoadedItem = LoadedTask | LoadedSpecItem;
  1175→
  1176→/**
  1177→ * Find any item (task or spec item) by reference
  1178→ */
  1179→export function findAnyItemByRef(
  1180→  tasks: LoadedTask[],
  1181→  items: LoadedSpecItem[],
  1182→  ref: string,
  1183→): AnyLoadedItem | undefined {
  1184→  // Try tasks first (more commonly referenced)
  1185→  const task = findTaskByRef(tasks, ref);
  1186→  if (task) return task;
  1187→
  1188→  // Then try spec items
  1189→  return findItemByRef(items, ref);
  1190→}
  1191→
  1192→/**
  1193→ * Build a ReferenceIndex from context.
  1194→ * Loads all tasks and spec items, then builds the index.
  1195→ */
  1196→export async function buildReferenceIndex(ctx: KspecContext): Promise<{
  1197→  index: ReferenceIndex;
  1198→  tasks: LoadedTask[];
  1199→  items: LoadedSpecItem[];
  1200→}> {
  1201→  const tasks = await loadAllTasks(ctx);
  1202→  const items = await loadAllItems(ctx);
  1203→  const index = new ReferenceIndex(tasks, items);
  1204→  return { index, tasks, items };
  1205→}
  1206→
  1207→/**
  1208→ * Build both ReferenceIndex and ItemIndex from context.
  1209→ * Use this when you need query capabilities in addition to reference resolution.
  1210→ * Pass plans for cross-namespace slug collision detection (plans aren't loaded by default
  1211→ * to avoid circular dependency with plans.ts).
  1212→ */
  1213→export async function buildIndexes(ctx: KspecContext, plans: LoadedPlan[] = []): Promise<{
  1214→  refIndex: ReferenceIndex;
  1215→  itemIndex: ItemIndex;
  1216→  traitIndex: TraitIndex;
  1217→  tasks: LoadedTask[];
  1218→  items: LoadedSpecItem[];
  1219→}> {
  1220→  const tasks = await loadAllTasks(ctx);
  1221→  const items = await loadAllItems(ctx);
  1222→  const refIndex = new ReferenceIndex(tasks, items, [], plans);
  1223→  const itemIndex = new ItemIndex(tasks, items);
  1224→  const traitIndex = new TraitIndex(items, refIndex);
  1225→  return { refIndex, itemIndex, traitIndex, tasks, items };
  1226→}
  1227→
  1228→// ============================================================
  1229→// SPEC ITEM CRUD (supports nested structures)
  1230→// ============================================================
  1231→
  1232→/**
  1233→ * Strip runtime metadata from spec item before serialization
  1234→ */
  1235→function stripSpecItemMetadata(item: LoadedSpecItem): SpecItem {
  1236→  const { _sourceFile, _path, ...cleanItem } = item;
  1237→  return cleanItem as SpecItem;
  1238→}
  1239→
  1240→/**
  1241→ * Parse a path string into segments.
  1242→ * e.g., "features[0].requirements[2]" -> [["features", 0], ["requirements", 2]]
  1243→ */
  1244→function parsePath(pathStr: string): Array<[string, number]> {
  1245→  const segments: Array<[string, number]> = [];
  1246→  const regex = /(\w+)\[(\d+)\]/g;
  1247→  let match;
  1248→  while ((match = regex.exec(pathStr)) !== null) {
  1249→    segments.push([match[1], parseInt(match[2], 10)]);
  1250→  }
  1251→  return segments;
  1252→}
  1253→
  1254→/**
  1255→ * Navigate to a location in a YAML structure using a path.
  1256→ * Returns the parent object and the array containing the target item.
  1257→ */
  1258→function navigateToPath(
  1259→  root: unknown,
  1260→  pathStr: string,
  1261→): { parent: Record<string, unknown>; array: unknown[]; index: number } | null {
  1262→  if (!pathStr) return null;
  1263→
  1264→  const segments = parsePath(pathStr);
  1265→  if (segments.length === 0) return null;
  1266→
  1267→  let current: unknown = root;
  1268→
  1269→  // Navigate to the parent of the last segment
  1270→  for (let i = 0; i < segments.length - 1; i++) {
  1271→    const [field, index] = segments[i];
  1272→    if (typeof current !== "object" || current === null) return null;
  1273→    const obj = current as Record<string, unknown>;
  1274→    if (!Array.isArray(obj[field])) return null;
  1275→    current = (obj[field] as unknown[])[index];
  1276→  }
  1277→
  1278→  // Get the final array and index
  1279→  const [finalField, finalIndex] = segments[segments.length - 1];
  1280→  if (typeof current !== "object" || current === null) return null;
  1281→  const parent = current as Record<string, unknown>;
  1282→  if (!Array.isArray(parent[finalField])) return null;
  1283→
  1284→  return {
  1285→    parent,
  1286→    array: parent[finalField] as unknown[],
  1287→    index: finalIndex,
  1288→  };
  1289→}
  1290→
  1291→/**
  1292→ * Find an item by ULID in a nested YAML structure.
  1293→ * Returns the path segments to reach it.
  1294→ */
  1295→function findItemInStructure(
  1296→  root: unknown,
  1297→  ulid: string,
  1298→  currentPath: string = "",
  1299→): { path: string; item: Record<string, unknown> } | null {
  1300→  if (!root || typeof root !== "object") return null;
  1301→
  1302→  const obj = root as Record<string, unknown>;
  1303→
  1304→  // Check if this is the item we're looking for
  1305→  if (obj._ulid === ulid) {
  1306→    return { path: currentPath, item: obj };
  1307→  }
  1308→
  1309→  // Search nested item fields
  1310→  for (const field of NESTED_ITEM_FIELDS) {
  1311→    if (Array.isArray(obj[field])) {
  1312→      const arr = obj[field] as unknown[];
  1313→      for (let i = 0; i < arr.length; i++) {
  1314→        const nestedPath = currentPath
  1315→          ? `${currentPath}.${field}[${i}]`
  1316→          : `${field}[${i}]`;
  1317→        const result = findItemInStructure(arr[i], ulid, nestedPath);
  1318→        if (result) return result;
  1319→      }
  1320→    }
  1321→  }
  1322→
  1323→  return null;
  1324→}
  1325→
  1326→/**
  1327→ * Create a new spec item with auto-generated fields
  1328→ */
  1329→export function createSpecItem(input: SpecItemInput): SpecItem {
  1330→  return {
  1331→    _ulid: input._ulid || ulid(),
  1332→    slugs: input.slugs || [],
  1333→    title: input.title,
  1334→    type: input.type,
  1335→    status: input.status,
  1336→    priority: input.priority,
  1337→    tags: input.tags || [],
  1338→    description: input.description,
  1339→    acceptance_criteria: input.acceptance_criteria,
  1340→    depends_on: input.depends_on || [],
  1341→    implements: input.implements || [],
  1342→    relates_to: input.relates_to || [],
  1343→    tests: input.tests || [],
  1344→    traits: input.traits || [],
  1345→    notes: input.notes || [],
  1346→    created: input.created || new Date().toISOString(),
  1347→    created_by: input.created_by,
  1348→  };
  1349→}
  1350→
  1351→/**
  1352→ * Map from item type to the field name used to store children of that type.
  1353→ */
  1354→const TYPE_TO_CHILD_FIELD: Record<string, string> = {
  1355→  feature: "features",
  1356→  requirement: "requirements",
  1357→  constraint: "constraints",
  1358→  decision: "decisions",
  1359→  module: "modules",
  1360→  trait: "traits",
  1361→};
  1362→
  1363→/**
  1364→ * Add a spec item as a child of a parent item.
  1365→ * @param parent The parent item to add under
  1366→ * @param child The new child item to add
  1367→ * @param childField Optional field name override (defaults based on child.type)
  1368→ */
  1369→export async function addChildItem(
  1370→  _ctx: KspecContext,
  1371→  parent: LoadedSpecItem,
  1372→  child: SpecItem,
  1373→  childField?: string,
  1374→): Promise<{ item: SpecItem; path: string }> {
  1375→  if (!parent._sourceFile) {
  1376→    throw new Error("Parent item has no source file");
  1377→  }
  1378→
  1379→  const field =
  1380→    childField || TYPE_TO_CHILD_FIELD[child.type || "feature"] || "features";
  1381→
  1382→  // Load the raw YAML
  1383→  const raw = await readYamlFile<unknown>(parent._sourceFile);
  1384→
  1385→  // Find the parent in the structure
  1386→  let parentObj: Record<string, unknown>;
  1387→  let parentPath: string;
  1388→
  1389→  if (parent._path) {
  1390→    const nav = navigateToPath(raw, parent._path);
  1391→    if (!nav) {
  1392→      throw new Error(`Could not navigate to parent path: ${parent._path}`);
  1393→    }
  1394→    parentObj = nav.array[nav.index] as Record<string, unknown>;
  1395→    parentPath = parent._path;
  1396→  } else {
  1397→    // Parent is the root item
  1398→    parentObj = raw as Record<string, unknown>;
  1399→    parentPath = "";
  1400→  }
  1401→
  1402→  // Ensure the child field array exists
  1403→  if (!Array.isArray(parentObj[field])) {
  1404→    parentObj[field] = [];
  1405→  }
  1406→
  1407→  // Add the child
  1408→  const childArray = parentObj[field] as unknown[];
  1409→  const cleanChild = stripSpecItemMetadata(child as LoadedSpecItem);
  1410→  childArray.push(cleanChild);
  1411→
  1412→  // Calculate the new child's path
  1413→  const childIndex = childArray.length - 1;
  1414→  const childPath = parentPath
  1415→    ? `${parentPath}.${field}[${childIndex}]`
  1416→    : `${field}[${childIndex}]`;
  1417→
  1418→  // Write back with format preservation
  1419→  await writeYamlFilePreserveFormat(parent._sourceFile, raw);
  1420→
  1421→  return { item: cleanChild, path: childPath };
  1422→}
  1423→
  1424→/**
  1425→ * Update a spec item in place within its source file.
  1426→ * Works with nested structures using the _path field.
  1427→ */
  1428→export async function updateSpecItem(
  1429→  _ctx: KspecContext,
  1430→  item: LoadedSpecItem,
  1431→  updates: Partial<SpecItemInput>,
  1432→): Promise<SpecItem> {
  1433→  if (!item._sourceFile) {
  1434→    throw new Error("Item has no source file");
  1435→  }
  1436→
  1437→  // Load the raw YAML
  1438→  const raw = await readYamlFile<unknown>(item._sourceFile);
  1439→
  1440→  // Find the item in the structure (use stored path or search by ULID)
  1441→  let targetObj: Record<string, unknown>;
  1442→
  1443→  if (item._path) {
  1444→    const nav = navigateToPath(raw, item._path);
  1445→    if (!nav) {
  1446→      throw new Error(`Could not navigate to path: ${item._path}`);
  1447→    }
  1448→    targetObj = nav.array[nav.index] as Record<string, unknown>;
  1449→  } else {
  1450→    // Item might be the root, or we need to find it
  1451→    const found = findItemInStructure(raw, item._ulid);
  1452→    if (found) {
  1453→      targetObj = found.item;
  1454→    } else if ((raw as Record<string, unknown>)._ulid === item._ulid) {
  1455→      targetObj = raw as Record<string, unknown>;
  1456→    } else {
  1457→      throw new Error(`Could not find item ${item._ulid} in structure`);
  1458→    }
  1459→  }
  1460→
  1461→  // Apply updates (but never change _ulid)
  1462→  for (const [key, value] of Object.entries(updates)) {
  1463→    if (key !== "_ulid" && key !== "_sourceFile" && key !== "_path") {
  1464→      targetObj[key] = value;
  1465→    }
  1466→  }
  1467→
  1468→  // Write back with format preservation
  1469→  await writeYamlFilePreserveFormat(item._sourceFile, raw);
  1470→
  1471→  return { ...item, ...updates, _ulid: item._ulid } as SpecItem;
  1472→}
  1473→
  1474→/**
  1475→ * Check if an item is a trait with implementors.
  1476→ * Returns array of items that use this trait via the 'traits' field.
  1477→ */
  1478→export function findTraitImplementors(
  1479→  trait: LoadedSpecItem,
  1480→  allItems: LoadedSpecItem[],
  1481→): LoadedSpecItem[] {
  1482→  // Check if the item is actually a trait
  1483→  if (trait.type !== "trait") {
  1484→    return [];
  1485→  }
  1486→
  1487→  // Find all items that reference this trait in their 'traits' array
  1488→  const traitRefs = [`@${trait._ulid}`, ...trait.slugs.map((s) => `@${s}`)];
  1489→  return allItems.filter((item) => {
  1490→    if (!item.traits || item.traits.length === 0) return false;
  1491→    return item.traits.some((traitRef: string) => traitRefs.includes(traitRef));
  1492→  });
  1493→}
  1494→
  1495→/**
  1496→ * Delete a spec item from its source file.
  1497→ * Works with nested structures using the _path field.
  1498→ */
  1499→export async function deleteSpecItem(
  1500→  _ctx: KspecContext,
  1501→  item: LoadedSpecItem,
  1502→): Promise<boolean> {
  1503→  if (!item._sourceFile) {
  1504→    return false;
  1505→  }
  1506→
  1507→  try {
  1508→    const raw = await readYamlFile<unknown>(item._sourceFile);
  1509→
  1510→    // If item has a path, navigate to it and remove from parent array
  1511→    if (item._path) {
  1512→      const nav = navigateToPath(raw, item._path);
  1513→      if (!nav) {
  1514→        return false;
  1515→      }
  1516→      // Remove the item from the array
  1517→      nav.array.splice(nav.index, 1);
  1518→      await writeYamlFilePreserveFormat(item._sourceFile, raw);
  1519→      return true;
  1520→    }
  1521→
  1522→    // No path - try to find it by ULID
  1523→    const found = findItemInStructure(raw, item._ulid);
  1524→    if (found?.path) {
  1525→      const nav = navigateToPath(raw, found.path);
  1526→      if (nav) {
  1527→        nav.array.splice(nav.index, 1);
  1528→        await writeYamlFilePreserveFormat(item._sourceFile, raw);
  1529→        return true;
  1530→      }
  1531→    }
  1532→
  1533→    // Maybe it's a root-level array item
  1534→    if (Array.isArray(raw)) {
  1535→      const index = raw.findIndex(
  1536→        (i: unknown) =>
  1537→          typeof i === "object" &&
  1538→          i !== null &&
  1539→          (i as Record<string, unknown>)._ulid === item._ulid,
  1540→      );
  1541→      if (index >= 0) {
  1542→        raw.splice(index, 1);
  1543→        await writeYamlFilePreserveFormat(item._sourceFile, raw);
  1544→        return true;
  1545→      }
  1546→    }
  1547→
  1548→    return false;
  1549→  } catch {
  1550→    return false;
  1551→  }
  1552→}
  1553→
  1554→/**
  1555→ * Save a spec item - either updates existing or adds to parent.
  1556→ * For new items, use addChildItem instead.
  1557→ */
  1558→export async function saveSpecItem(
  1559→  ctx: KspecContext,
  1560→  item: LoadedSpecItem,
  1561→): Promise<void> {
  1562→  // If item has a source file and path, it's an update
  1563→  if (item._sourceFile && item._path) {
  1564→    await updateSpecItem(ctx, item, item);
  1565→    return;
  1566→  }
  1567→
  1568→  // Otherwise, this is more complex - would need a parent
  1569→  throw new Error(
  1570→    "Cannot save new item without parent. Use addChildItem instead.",
  1571→  );
  1572→}
  1573→
  1574→// ============================================================
  1575→// INBOX SYSTEM
  1576→// ============================================================
  1577→
  1578→/**
  1579→ * Inbox item with runtime metadata for source tracking.
  1580→ */
  1581→export interface LoadedInboxItem extends InboxItem {
  1582→  _sourceFile?: string;
  1583→}
  1584→
  1585→/**
  1586→ * Get the inbox file path.
  1587→ *
  1588→ * When shadow enabled: .kspec/project.inbox.yaml
  1589→ * Otherwise: spec/project.inbox.yaml
  1590→ */
  1591→export function getInboxFilePath(ctx: KspecContext): string {
  1592→  return path.join(ctx.specDir, "project.inbox.yaml");
  1593→}
  1594→
  1595→/**
  1596→ * Load all inbox items from the project.
  1597→ */
  1598→export async function loadInboxItems(
  1599→  ctx: KspecContext,
  1600→): Promise<LoadedInboxItem[]> {
  1601→  const inboxPath = getInboxFilePath(ctx);
  1602→
  1603→  try {
  1604→    const raw = await readYamlFile<unknown>(inboxPath);
  1605→
  1606→    // Handle { inbox: [...] } format
  1607→    if (raw && typeof raw === "object" && "inbox" in raw) {
  1608→      const parsed = InboxFileSchema.safeParse(raw);
  1609→      if (parsed.success) {
  1610→        return parsed.data.inbox.map((item) => ({
  1611→          ...item,
  1612→          _sourceFile: inboxPath,
  1613→        }));
  1614→      }
  1615→    }
  1616→
  1617→    // Handle plain array format
  1618→    if (Array.isArray(raw)) {
  1619→      const items: LoadedInboxItem[] = [];
  1620→      for (const item of raw) {
  1621→        const result = InboxItemSchema.safeParse(item);
  1622→        if (result.success) {
  1623→          items.push({ ...result.data, _sourceFile: inboxPath });
  1624→        }
  1625→      }
  1626→      return items;
  1627→    }
  1628→
  1629→    return [];
  1630→  } catch {
  1631→    // File doesn't exist or parse error
  1632→    return [];
  1633→  }
  1634→}
  1635→
  1636→/**
  1637→ * Create a new inbox item with auto-generated fields.
  1638→ */
  1639→export function createInboxItem(input: InboxItemInput): InboxItem {
  1640→  return {
  1641→    _ulid: input._ulid || ulid(),
  1642→    text: input.text,
  1643→    created_at: input.created_at || new Date().toISOString(),
  1644→    tags: input.tags || [],
  1645→    added_by: input.added_by ?? getAuthor(),
  1646→  };
  1647→}
  1648→
  1649→/**
  1650→ * Strip runtime metadata before serialization.
  1651→ */
  1652→function stripInboxMetadata(item: LoadedInboxItem): InboxItem {
  1653→  const { _sourceFile, ...cleanItem } = item;
  1654→  return cleanItem as InboxItem;
  1655→}
  1656→
  1657→/**
  1658→ * Save an inbox item (add or update).
  1659→ */
  1660→export async function saveInboxItem(
  1661→  ctx: KspecContext,
  1662→  item: LoadedInboxItem,
  1663→): Promise<void> {
  1664→  const inboxPath = getInboxFilePath(ctx);
  1665→
  1666→  // Ensure directory exists
  1667→  const dir = path.dirname(inboxPath);
  1668→  await fs.mkdir(dir, { recursive: true });
  1669→
  1670→  // Load existing items
  1671→  let existingItems: InboxItem[] = [];
  1672→
  1673→  try {
  1674→    const raw = await readYamlFile<unknown>(inboxPath);
  1675→    if (raw && typeof raw === "object" && "inbox" in raw) {
  1676→      const parsed = InboxFileSchema.safeParse(raw);
  1677→      if (parsed.success) {
  1678→        existingItems = parsed.data.inbox;
  1679→      }
  1680→    } else if (Array.isArray(raw)) {
  1681→      for (const i of raw) {
  1682→        const result = InboxItemSchema.safeParse(i);
  1683→        if (result.success) {
  1684→          existingItems.push(result.data);
  1685→        }
  1686→      }
  1687→    }
  1688→  } catch {
  1689→    // File doesn't exist, start fresh
  1690→  }
  1691→
  1692→  const cleanItem = stripInboxMetadata(item);
  1693→
  1694→  // Update existing or add new
  1695→  const existingIndex = existingItems.findIndex((i) => i._ulid === item._ulid);
  1696→  if (existingIndex >= 0) {
  1697→    existingItems[existingIndex] = cleanItem;
  1698→  } else {
  1699→    existingItems.push(cleanItem);
  1700→  }
  1701→
  1702→  // Save with { inbox: [...] } format and format preservation
  1703→  await writeYamlFilePreserveFormat(inboxPath, { inbox: existingItems });
  1704→}
  1705→
  1706→/**
  1707→ * Delete an inbox item by ULID.
  1708→ */
  1709→export async function deleteInboxItem(
  1710→  ctx: KspecContext,
  1711→  ulid: string,
  1712→): Promise<boolean> {
  1713→  const inboxPath = getInboxFilePath(ctx);
  1714→
  1715→  try {
  1716→    const raw = await readYamlFile<unknown>(inboxPath);
  1717→    let existingItems: InboxItem[] = [];
  1718→
  1719→    if (raw && typeof raw === "object" && "inbox" in raw) {
  1720→      const parsed = InboxFileSchema.safeParse(raw);
  1721→      if (parsed.success) {
  1722→        existingItems = parsed.data.inbox;
  1723→      }
  1724→    }
  1725→
  1726→    const index = existingItems.findIndex((i) => i._ulid === ulid);
  1727→    if (index < 0) {
  1728→      return false;
  1729→    }
  1730→
  1731→    existingItems.splice(index, 1);
  1732→    await writeYamlFilePreserveFormat(inboxPath, { inbox: existingItems });
  1733→    return true;
  1734→  } catch {
  1735→    return false;
  1736→  }
  1737→}
  1738→
  1739→/**
  1740→ * Find an inbox item by reference (ULID or short ULID).
  1741→ */
  1742→export function findInboxItemByRef(
  1743→  items: LoadedInboxItem[],
  1744→  ref: string,
  1745→): LoadedInboxItem | undefined {
  1746→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  1747→
  1748→  return items.find((item) => {
  1749→    // Match full ULID
  1750→    if (item._ulid === cleanRef) return true;
  1751→    // Match short ULID (prefix)
  1752→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
  1753→      return true;
  1754→    return false;
  1755→  });
  1756→}
  1757→
  1758→// ─── Patch Operations ────────────────────────────────────────────────────────
  1759→
  1760→/**
  1761→ * A single patch operation for bulk patching
  1762→ */
  1763→export interface PatchOperation {
  1764→  ref: string;
  1765→  data: Record<string, unknown>;
  1766→}
  1767→
  1768→/**
  1769→ * Result of a single patch operation
  1770→ */
  1771→export interface PatchResult {
  1772→  ref: string;
  1773→  status: "updated" | "skipped" | "error";
  1774→  ulid?: string;
  1775→  error?: string;
  1776→}
  1777→
  1778→/**
  1779→ * Result of a bulk patch operation
  1780→ */
  1781→export interface BulkPatchResult {
  1782→  results: PatchResult[];
  1783→  summary: {
  1784→    total: number;
  1785→    updated: number;
  1786→    failed: number;
  1787→    skipped: number;
  1788→  };
  1789→}
  1790→
  1791→/**
  1792→ * Options for patch operations
  1793→ */
  1794→export interface PatchOptions {
  1795→  allowUnknown?: boolean;
  1796→  dryRun?: boolean;
  1797→  failFast?: boolean;
  1798→}
  1799→
  1800→/**
  1801→ * Bulk patch spec items.
  1802→ * Resolves refs, validates data, applies patches.
  1803→ * Continues on error by default (use failFast to stop on first error).
  1804→ */
  1805→export async function patchSpecItems(
  1806→  ctx: KspecContext,
  1807→  refIndex: ReferenceIndex,
  1808→  items: LoadedSpecItem[],
  1809→  patches: PatchOperation[],
  1810→  options: PatchOptions = {},
  1811→): Promise<BulkPatchResult> {
  1812→  const results: PatchResult[] = [];
  1813→  let stopProcessing = false;
  1814→
  1815→  for (const patch of patches) {
  1816→    if (stopProcessing) {
  1817→      results.push({ ref: patch.ref, status: "skipped" });
  1818→      continue;
  1819→    }
  1820→
  1821→    // Resolve ref
  1822→    const resolved = refIndex.resolve(patch.ref);
  1823→    if (!resolved.ok) {
  1824→      const errorMsg =
  1825→        resolved.error === "not_found"
  1826→          ? `Item not found: ${patch.ref}`
  1827→          : resolved.error === "ambiguous"
  1828→            ? `Ambiguous ref: ${patch.ref}`
  1829→            : `Duplicate slug: ${patch.ref}`;
  1830→      results.push({ ref: patch.ref, status: "error", error: errorMsg });
  1831→      if (options.failFast) {
  1832→        stopProcessing = true;
  1833→      }
  1834→      continue;
  1835→    }
  1836→
  1837→    // Find the item
  1838→    const item = items.find((i) => i._ulid === resolved.ulid);
  1839→    if (!item) {
  1840→      // Ref resolved but it's not a spec item (might be a task)
  1841→      results.push({
  1842→        ref: patch.ref,
  1843→        status: "error",
  1844→        error: "Not a spec item",
  1845→      });
  1846→      if (options.failFast) {
  1847→        stopProcessing = true;
  1848→      }
  1849→      continue;
  1850→    }
  1851→
  1852→    // Dry run - just record what would happen
  1853→    if (options.dryRun) {
  1854→      results.push({ ref: patch.ref, status: "updated", ulid: item._ulid });
  1855→      continue;
  1856→    }
  1857→
  1858→    // Apply the patch
  1859→    try {
  1860→      await updateSpecItem(ctx, item, patch.data);
  1861→      results.push({ ref: patch.ref, status: "updated", ulid: item._ulid });
  1862→    } catch (err) {
  1863→      const errorMsg = err instanceof Error ? err.message : String(err);
  1864→      results.push({ ref: patch.ref, status: "error", error: errorMsg });
  1865→      if (options.failFast) {
  1866→        stopProcessing = true;
  1867→      }
  1868→    }
  1869→  }
  1870→
  1871→  return {
  1872→    results,
  1873→    summary: {
  1874→      total: patches.length,
  1875→      updated: results.filter((r) => r.status === "updated").length,
  1876→      failed: results.filter((r) => r.status === "error").length,
  1877→      skipped: results.filter((r) => r.status === "skipped").length,
  1878→    },
  1879→  };
  1880→}
  1881→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
