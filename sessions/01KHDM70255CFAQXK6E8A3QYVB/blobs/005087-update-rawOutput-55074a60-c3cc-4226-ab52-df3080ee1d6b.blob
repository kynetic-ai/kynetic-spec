     1→import chalk from "chalk";
     2→import type { ReferenceIndex } from "../parser/index.js";
     3→import type { Note, Task, TaskStatus } from "../schema/index.js";
     4→import { fieldLabels, sectionHeaders, summaries } from "../strings/labels.js";
     5→import { formatMatchedFields, grepItem } from "../utils/grep.js";
     6→
     7→/**
     8→ * Check if a note has been superseded by another note.
     9→ * A note is superseded if its ULID appears in any other note's `supersedes` field.
    10→ */
    11→export function isNoteSuperseded(note: Note, allNotes: Note[]): boolean {
    12→  return allNotes.some((n) => n.supersedes === note._ulid);
    13→}
    14→
    15→/**
    16→ * Filter notes to exclude superseded ones.
    17→ * Returns only notes that have not been superseded.
    18→ */
    19→export function filterSupersededNotes(notes: Note[]): Note[] {
    20→  return notes.filter((note) => !isNoteSuperseded(note, notes));
    21→}
    22→
    23→/**
    24→ * Annotate notes with superseded status for JSON output.
    25→ * Adds a computed `superseded` field to each note.
    26→ */
    27→export function annotateNotesWithSuperseded(
    28→  notes: Note[],
    29→): Array<Note & { superseded: boolean }> {
    30→  return notes.map((note) => ({
    31→    ...note,
    32→    superseded: isNoteSuperseded(note, notes),
    33→  }));
    34→}
    35→
    36→/**
    37→ * Output options
    38→ */
    39→export interface OutputOptions {
    40→  json?: boolean;
    41→}
    42→
    43→/**
    44→ * Global output format (set by --json flag)
    45→ */
    46→let globalJsonMode = false;
    47→
    48→export function setJsonMode(enabled: boolean): void {
    49→  globalJsonMode = enabled;
    50→}
    51→
    52→export function isJsonMode(): boolean {
    53→  return globalJsonMode;
    54→}
    55→
    56→/**
    57→ * Global verbose mode (set by --verbose flag)
    58→ */
    59→let globalVerboseMode = false;
    60→
    61→export function setVerboseMode(enabled: boolean): void {
    62→  globalVerboseMode = enabled;
    63→}
    64→
    65→export function getVerboseMode(): boolean {
    66→  return globalVerboseMode;
    67→}
    68→
    69→/**
    70→ * Output data - JSON if --json flag, otherwise formatted
    71→ */
    72→export function output(data: unknown, formatter?: () => void): void {
    73→  if (globalJsonMode) {
    74→    console.log(JSON.stringify(data, null, 2));
    75→  } else if (formatter) {
    76→    formatter();
    77→  } else {
    78→    console.log(data);
    79→  }
    80→}
    81→
    82→/**
    83→ * Output success message
    84→ */
    85→export function success(message: string, data?: Record<string, unknown>): void {
    86→  if (globalJsonMode) {
    87→    console.log(JSON.stringify({ success: true, message, ...data }));
    88→  } else {
    89→    console.log(chalk.green("OK"), message);
    90→  }
    91→}
    92→
    93→/**
    94→ * Output error message
    95→ */
    96→export function error(message: string, details?: unknown): void {
    97→  if (globalJsonMode) {
    98→    console.error(JSON.stringify({ success: false, error: message, details }));
    99→  } else {
   100→    console.error(chalk.red("✗"), message);
   101→    if (details) {
   102→      console.error(chalk.gray(String(details)));
   103→      // Show suggestion if it's a ShadowError with a suggestion
   104→      if (details && typeof details === "object" && "suggestion" in details) {
   105→        const suggestion = (details as { suggestion?: string }).suggestion;
   106→        if (suggestion) {
   107→          console.error(chalk.yellow("  Suggestion:"), suggestion);
   108→        }
   109→      }
   110→    }
   111→  }
   112→}
   113→
   114→/**
   115→ * Output warning message
   116→ */
   117→export function warn(message: string): void {
   118→  if (globalJsonMode) {
   119→    // Warnings are suppressed in JSON mode
   120→  } else {
   121→    console.warn(chalk.yellow("⚠"), message);
   122→  }
   123→}
   124→
   125→/**
   126→ * Output info message
   127→ */
   128→export function info(message: string): void {
   129→  if (globalJsonMode) {
   130→    // Info messages suppressed in JSON mode
   131→  } else {
   132→    console.log(chalk.blue("ℹ"), message);
   133→  }
   134→}
   135→
   136→/**
   137→ * Get color for task status
   138→ */
   139→function statusColor(status: TaskStatus): (text: string) => string {
   140→  switch (status) {
   141→    case "pending":
   142→      return (t: string) => chalk.gray(t);
   143→    case "in_progress":
   144→      return (t: string) => chalk.blue(t);
   145→    case "blocked":
   146→      return (t: string) => chalk.red(t);
   147→    case "completed":
   148→      return (t: string) => chalk.green(t);
   149→    case "cancelled":
   150→      return (t: string) => chalk.strikethrough.gray(t);
   151→    default:
   152→      return (t: string) => chalk.white(t);
   153→  }
   154→}
   155→
   156→/**
   157→ * Format a task reference (short ULID + slug if available)
   158→ * @param task The task to format
   159→ * @param index Optional ReferenceIndex for dynamic short ULID computation
   160→ */
   161→export function formatTaskRef(task: Task, index?: ReferenceIndex): string {
   162→  const shortId = index ? index.shortUlid(task._ulid) : task._ulid.slice(0, 8);
   163→  if (task.slugs.length > 0) {
   164→    return `${shortId} (${task.slugs[0]})`;
   165→  }
   166→  return shortId;
   167→}
   168→
   169→/**
   170→ * Format task for display
   171→ */
   172→export function formatTask(
   173→  task: Task,
   174→  verbose = false,
   175→  index?: ReferenceIndex,
   176→  full = false,
   177→): string {
   178→  const ref = formatTaskRef(task, index);
   179→  const status = statusColor(task.status)(`[${task.status}]`);
   180→  const priority =
   181→    task.priority <= 2
   182→      ? chalk.red(`P${task.priority}`)
   183→      : chalk.gray(`P${task.priority}`);
   184→
   185→  let line = `${ref} ${status} ${priority} ${task.title}`;
   186→
   187→  if (verbose && !full) {
   188→    // AC: @task-list-verbose ac-2 - Single verbose (-v) shows current behavior
   189→    if (task.spec_ref) {
   190→      line += chalk.gray(` (spec: ${task.spec_ref})`);
   191→    }
   192→    if (task.depends_on.length > 0) {
   193→      line += chalk.gray(` deps: [${task.depends_on.join(", ")}]`);
   194→    }
   195→    if (task.tags.length > 0) {
   196→      line += chalk.cyan(` #${task.tags.join(" #")}`);
   197→    }
   198→  }
   199→
   200→  return line;
   201→}
   202→
   203→/**
   204→ * Get first line of text, truncated to max length
   205→ */
   206→function getFirstLine(
   207→  text: string | undefined,
   208→  maxLength: number = 70,
   209→): string | undefined {
   210→  if (!text) return undefined;
   211→  const firstLine = text.split("\n")[0].trim();
   212→  if (firstLine.length <= maxLength) return firstLine;
   213→  return `${firstLine.slice(0, maxLength - 3)}...`;
   214→}
   215→
   216→/**
   217→ * Format full mode context for a task (AC-1, AC-3, AC-5)
   218→ */
   219→function formatFullModeContext(task: Task, index?: ReferenceIndex): void {
   220→  const indent = "    ";
   221→
   222→  // Show timestamps (AC-1)
   223→  console.log(chalk.gray(`${indent}Created: ${task.created_at}`));
   224→  if (task.started_at) {
   225→    console.log(chalk.gray(`${indent}Started: ${task.started_at}`));
   226→  }
   227→  if (task.completed_at) {
   228→    console.log(chalk.gray(`${indent}Completed: ${task.completed_at}`));
   229→  }
   230→
   231→  // Show notes count and most recent note (AC-1, AC-3)
   232→  if (task.notes && task.notes.length > 0) {
   233→    const mostRecent = task.notes[task.notes.length - 1];
   234→    const preview = getFirstLine(mostRecent.content, 50);
   235→    console.log(
   236→      chalk.gray(`${indent}Notes: ${task.notes.length} (latest: "${preview}")`),
   237→    );
   238→  }
   239→
   240→  // Show pending todos count (AC-1, AC-3)
   241→  if (task.todos && task.todos.length > 0) {
   242→    const pendingCount = task.todos.filter((t) => !t.done).length;
   243→    if (pendingCount > 0) {
   244→      console.log(chalk.gray(`${indent}Pending todos: ${pendingCount}`));
   245→    }
   246→  }
   247→
   248→  // Show spec context (AC-5)
   249→  if (task.spec_ref && index) {
   250→    const result = index.resolve(task.spec_ref);
   251→    if (result.ok) {
   252→      const spec = result.item;
   253→      const specName =
   254→        "title" in spec
   255→          ? spec.title
   256→          : "name" in spec
   257→            ? spec.name
   258→            : "id" in spec
   259→              ? spec.id
   260→              : task.spec_ref;
   261→      console.log(chalk.gray(`${indent}Spec: ${task.spec_ref}`));
   262→      console.log(chalk.cyan(`${indent}  ${specName}`));
   263→
   264→      // Show spec description if available
   265→      if ("description" in spec && spec.description) {
   266→        const descPreview = getFirstLine(spec.description as string, 70);
   267→        console.log(chalk.gray(`${indent}  ${descPreview}`));
   268→      }
   269→
   270→      // Show acceptance criteria if available
   271→      if (
   272→        "acceptance_criteria" in spec &&
   273→        Array.isArray(spec.acceptance_criteria)
   274→      ) {
   275→        const ac = spec.acceptance_criteria;
   276→        if (ac.length > 0) {
   277→          console.log(
   278→            chalk.gray(`${indent}  Acceptance Criteria: ${ac.length}`),
   279→          );
   280→          // Show first AC as preview
   281→          const firstAC = ac[0];
   282→          if (
   283→            typeof firstAC === "object" &&
   284→            firstAC !== null &&
   285→            "id" in firstAC
   286→          ) {
   287→            console.log(
   288→              chalk.gray(`${indent}    [${firstAC.id}] ${firstAC.then}`),
   289→            );
   290→          }
   291→        }
   292→      }
   293→    }
   294→  }
   295→
   296→  // Show tags and dependencies if present
   297→  if (task.tags && task.tags.length > 0) {
   298→    console.log(chalk.gray(`${indent}Tags: ${task.tags.join(", ")}`));
   299→  }
   300→  if (task.depends_on && task.depends_on.length > 0) {
   301→    console.log(
   302→      chalk.gray(`${indent}Depends on: ${task.depends_on.join(", ")}`),
   303→    );
   304→  }
   305→}
   306→
   307→/**
   308→ * Format automation status as a colored label
   309→ * AC: @task-automation-eligibility ac-14
   310→ */
   311→function formatAutomationStatus(automation: string | undefined): string {
   312→  if (!automation) {
   313→    return chalk.gray("[unassessed]");
   314→  }
   315→  switch (automation) {
   316→    case "eligible":
   317→      return chalk.green("[eligible]");
   318→    case "needs_review":
   319→      return chalk.yellow("[needs_review]");
   320→    case "manual_only":
   321→      return chalk.red("[manual_only]");
   322→    default:
   323→      return chalk.gray(`[${automation}]`);
   324→  }
   325→}
   326→
   327→/**
   328→ * Format a list of tasks with automation status
   329→ * AC: @task-automation-eligibility ac-14
   330→ */
   331→export function formatTaskListWithAutomation(
   332→  tasks: Task[],
   333→  verbose = false,
   334→  index?: ReferenceIndex,
   335→  grepPattern?: string,
   336→  full = false,
   337→): void {
   338→  if (tasks.length === 0) {
   339→    console.log(summaries.noTasks);
   340→    return;
   341→  }
   342→
   343→  for (const task of tasks) {
   344→    const ref = formatTaskRef(task, index);
   345→    const status = statusColor(task.status)(`[${task.status}]`);
   346→    const priority =
   347→      task.priority <= 2
   348→        ? chalk.red(`P${task.priority}`)
   349→        : chalk.gray(`P${task.priority}`);
   350→    const automationLabel = formatAutomationStatus(task.automation);
   351→
   352→    let line = `${ref} ${status} ${priority} ${automationLabel} ${task.title}`;
   353→
   354→    if (verbose && !full) {
   355→      if (task.spec_ref) {
   356→        line += chalk.gray(` (spec: ${task.spec_ref})`);
   357→      }
   358→      if (task.depends_on.length > 0) {
   359→        line += chalk.gray(` deps: [${task.depends_on.join(", ")}]`);
   360→      }
   361→      if (task.tags.length > 0) {
   362→        line += chalk.cyan(` #${task.tags.join(" #")}`);
   363→      }
   364→    }
   365→
   366→    console.log(line);
   367→
   368→    // Show matched fields if grep pattern provided
   369→    if (grepPattern) {
   370→      const match = grepItem(
   371→        task as unknown as Record<string, unknown>,
   372→        grepPattern,
   373→      );
   374→      if (match && match.matchedFields.length > 0) {
   375→        console.log(
   376→          chalk.gray(
   377→            `    matched: ${formatMatchedFields(match.matchedFields)}`,
   378→          ),
   379→        );
   380→      }
   381→    } else if (full) {
   382→      formatFullModeContext(task, index);
   383→    } else {
   384→      // Show context line: first line of description (if present)
   385→      const context = getFirstLine(task.description);
   386→      if (context) {
   387→        console.log(chalk.gray(`    ${context}`));
   388→      }
   389→    }
   390→  }
   391→
   392→  console.log(summaries.taskCount(tasks.length));
   393→}
   394→
   395→/**
   396→ * Format a list of tasks
   397→ */
   398→export function formatTaskList(
   399→  tasks: Task[],
   400→  verbose = false,
   401→  index?: ReferenceIndex,
   402→  grepPattern?: string,
   403→  full = false,
   404→): void {
   405→  if (tasks.length === 0) {
   406→    console.log(summaries.noTasks);
   407→    return;
   408→  }
   409→
   410→  for (const task of tasks) {
   411→    console.log(formatTask(task, verbose, index, full));
   412→
   413→    // Show matched fields if grep pattern provided
   414→    if (grepPattern) {
   415→      const match = grepItem(
   416→        task as unknown as Record<string, unknown>,
   417→        grepPattern,
   418→      );
   419→      if (match && match.matchedFields.length > 0) {
   420→        console.log(
   421→          chalk.gray(
   422→            `    matched: ${formatMatchedFields(match.matchedFields)}`,
   423→          ),
   424→        );
   425→      }
   426→    } else if (full) {
   427→      // AC: @task-list-verbose ac-1 - Full mode shows richer context
   428→      formatFullModeContext(task, index);
   429→    } else {
   430→      // Show context line: first line of description (if present)
   431→      const context = getFirstLine(task.description);
   432→      if (context) {
   433→        console.log(chalk.gray(`    ${context}`));
   434→      }
   435→    }
   436→  }
   437→
   438→  console.log(summaries.taskCount(tasks.length));
   439→}
   440→
   441→export interface FormatTaskDetailsOptions {
   442→  /** Show all notes including superseded ones (default: false) */
   443→  showAllNotes?: boolean;
   444→}
   445→
   446→/**
   447→ * Format task details
   448→ */
   449→export function formatTaskDetails(
   450→  task: Task,
   451→  index?: ReferenceIndex,
   452→  options: FormatTaskDetailsOptions = {},
   453→): void {
   454→  console.log(chalk.bold(task.title));
   455→  console.log(chalk.gray("─".repeat(40)));
   456→  console.log(`${fieldLabels.ulid}      ${task._ulid}`);
   457→  if (task.slugs.length > 0) {
   458→    console.log(`${fieldLabels.slugs}     ${task.slugs.join(", ")}`);
   459→  }
   460→  console.log(`${fieldLabels.type}      ${task.type}`);
   461→  console.log(
   462→    `${fieldLabels.status}    ${statusColor(task.status)(task.status)}`,
   463→  );
   464→  console.log(`${fieldLabels.priority}  ${task.priority}`);
   465→
   466→  // AC: @task-automation-eligibility ac-17 - show automation status
   467→  const automationDisplay = task.automation || "unassessed";
   468→  const automationColor =
   469→    task.automation === "eligible"
   470→      ? chalk.green
   471→      : task.automation === "needs_review"
   472→        ? chalk.yellow
   473→        : task.automation === "manual_only"
   474→          ? chalk.red
   475→          : chalk.gray;
   476→  console.log(
   477→    `${fieldLabels.automation} ${automationColor(automationDisplay)}`,
   478→  );
   479→
   480→  if (task.spec_ref) {
   481→    console.log(`${fieldLabels.specRef}  ${task.spec_ref}`);
   482→  }
   483→
   484→  // AC: @plan-derive ac-6 - display plan_ref
   485→  if (task.plan_ref) {
   486→    console.log(`Plan ref:  ${task.plan_ref}`);
   487→  }
   488→
   489→  if (task.depends_on.length > 0) {
   490→    if (index) {
   491→      console.log(fieldLabels.depends);
   492→      for (const ref of task.depends_on) {
   493→        const result = index.resolve(ref);
   494→        if (result.ok) {
   495→          const item = result.item;
   496→          const status =
   497→            "status" in item && typeof item.status === "string"
   498→              ? statusColor(item.status as TaskStatus)(`[${item.status}]`)
   499→              : chalk.gray("[spec]");
   500→          // Handle both spec items (with title) and meta items (with name or id)
   501→          const itemName =
   502→            "title" in item
   503→              ? item.title
   504→              : "name" in item
   505→                ? item.name
   506→                : "id" in item
   507→                  ? item.id
   508→                  : ref;
   509→          console.log(`  ${ref} ${chalk.gray("→")} ${itemName} ${status}`);
   510→        } else {
   511→          console.log(`  ${ref} ${chalk.red("(unresolved)")}`);
   512→        }
   513→      }
   514→    } else {
   515→      console.log(`${fieldLabels.depends}   ${task.depends_on.join(", ")}`);
   516→    }
   517→  }
   518→
   519→  if (task.blocked_by.length > 0) {
   520→    console.log(
   521→      chalk.red(`${fieldLabels.blocked}   ${task.blocked_by.join(", ")}`),
   522→    );
   523→  }
   524→
   525→  if (task.tags.length > 0) {
   526→    console.log(`${fieldLabels.tags}      ${task.tags.join(", ")}`);
   527→  }
   528→
   529→  console.log(`${fieldLabels.created}   ${task.created_at}`);
   530→  if (task.started_at) {
   531→    console.log(`${fieldLabels.started}   ${task.started_at}`);
   532→  }
   533→  if (task.completed_at) {
   534→    console.log(`${fieldLabels.completed} ${task.completed_at}`);
   535→  }
   536→
   537→  // Show resolved spec information
   538→  if (task.spec_ref && index) {
   539→    const result = index.resolve(task.spec_ref);
   540→    if (result.ok) {
   541→      const spec = result.item;
   542→      console.log(`\n${sectionHeaders.specContext}`);
   543→      // Handle both spec items (with title) and meta items (with name)
   544→      const specName =
   545→        "title" in spec
   546→          ? spec.title
   547→          : "name" in spec
   548→            ? spec.name
   549→            : "id" in spec
   550→              ? spec.id
   551→              : task.spec_ref;
   552→      console.log(chalk.cyan(specName));
   553→      if ("type" in spec && spec.type) {
   554→        console.log(chalk.gray(`${fieldLabels.type} ${spec.type}`));
   555→      }
   556→      // Show implementation status
   557→      if ("status" in spec && spec.status && typeof spec.status === "object") {
   558→        const status = spec.status as {
   559→          maturity?: string;
   560→          implementation?: string;
   561→        };
   562→        if (status.implementation) {
   563→          const implColor =
   564→            status.implementation === "verified"
   565→              ? chalk.green
   566→              : status.implementation === "implemented"
   567→                ? chalk.cyan
   568→                : status.implementation === "in_progress"
   569→                  ? chalk.yellow
   570→                  : chalk.gray;
   571→          console.log(
   572→            chalk.gray(fieldLabels.implementation) +
   573→              implColor(status.implementation),
   574→          );
   575→        }
   576→      }
   577→      if ("description" in spec && spec.description) {
   578→        console.log(chalk.gray(fieldLabels.description));
   579→        // Indent description lines
   580→        const desc = String(spec.description).trim();
   581→        for (const line of desc.split("\n")) {
   582→          console.log(chalk.gray(`  ${line}`));
   583→        }
   584→      }
   585→      if (
   586→        "acceptance_criteria" in spec &&
   587→        Array.isArray(spec.acceptance_criteria) &&
   588→        spec.acceptance_criteria.length > 0
   589→      ) {
   590→        console.log(chalk.gray(fieldLabels.acceptanceCriteria));
   591→        for (const ac of spec.acceptance_criteria) {
   592→          if (ac && typeof ac === "object" && "id" in ac) {
   593→            const acObj = ac as {
   594→              id: string;
   595→              given?: string;
   596→              when?: string;
   597→              then?: string;
   598→            };
   599→            console.log(chalk.gray(`  [${acObj.id}]`));
   600→            if (acObj.given)
   601→              console.log(chalk.gray(`    Given: ${acObj.given}`));
   602→            if (acObj.when) console.log(chalk.gray(`    When: ${acObj.when}`));
   603→            if (acObj.then) console.log(chalk.gray(`    Then: ${acObj.then}`));
   604→          }
   605→        }
   606→      }
   607→      // Show traceability if present
   608→      if (
   609→        "traceability" in spec &&
   610→        spec.traceability &&
   611→        typeof spec.traceability === "object"
   612→      ) {
   613→        const trace = spec.traceability as {
   614→          implementation?: Array<{
   615→            path: string;
   616→            function?: string;
   617→            lines?: string;
   618→          }>;
   619→          tests?: Array<{ path: string }>;
   620→          commits?: string[];
   621→          issues?: string[];
   622→        };
   623→        const hasTrace =
   624→          trace.implementation?.length ||
   625→          trace.tests?.length ||
   626→          trace.commits?.length ||
   627→          trace.issues?.length;
   628→        if (hasTrace) {
   629→          console.log(chalk.gray(fieldLabels.traceability));
   630→          if (trace.implementation?.length) {
   631→            for (const impl of trace.implementation) {
   632→              let loc = `  Code: ${impl.path}`;
   633→              if (impl.function) loc += `::${impl.function}`;
   634→              if (impl.lines) loc += `:${impl.lines}`;
   635→              console.log(chalk.gray(loc));
   636→            }
   637→          }
   638→          if (trace.tests?.length) {
   639→            for (const test of trace.tests) {
   640→              console.log(chalk.gray(`  Test: ${test.path}`));
   641→            }
   642→          }
   643→          if (trace.commits?.length) {
   644→            console.log(chalk.gray(`  Commits: ${trace.commits.join(", ")}`));
   645→          }
   646→          if (trace.issues?.length) {
   647→            console.log(chalk.gray(`  Issues: ${trace.issues.join(", ")}`));
   648→          }
   649→        }
   650→      }
   651→    }
   652→  }
   653→
   654→  if (task.notes.length > 0) {
   655→    // Filter superseded notes unless showAllNotes is true
   656→    const notesToShow = options.showAllNotes
   657→      ? task.notes
   658→      : filterSupersededNotes(task.notes);
   659→    const hiddenCount = task.notes.length - notesToShow.length;
   660→
   661→    console.log(`\n${sectionHeaders.notes}`);
   662→    for (const note of notesToShow) {
   663→      const author = note.author || "unknown";
   664→      // Mark if this note supersedes another
   665→      const supersededLabel = note.supersedes ? chalk.gray(" (supersedes earlier note)") : "";
   666→      console.log(chalk.gray(`[${note.created_at}] ${author}:`) + supersededLabel);
   667→      console.log(note.content);
   668→    }
   669→
   670→    // Show count of hidden notes if any
   671→    if (hiddenCount > 0) {
   672→      console.log(chalk.gray(`\n(${hiddenCount} superseded note${hiddenCount > 1 ? "s" : ""} hidden - use --all to show)`));
   673→    }
   674→  }
   675→
   676→  if (task.todos.length > 0) {
   677→    console.log(`\n${sectionHeaders.todos}`);
   678→    for (const todo of task.todos) {
   679→      const check = todo.done ? chalk.green("✓") : chalk.gray("○");
   680→      const text = todo.done ? chalk.strikethrough.gray(todo.text) : todo.text;
   681→      console.log(`${check} [${todo.id}] ${text}`);
   682→    }
   683→  }
   684→}
   685→

