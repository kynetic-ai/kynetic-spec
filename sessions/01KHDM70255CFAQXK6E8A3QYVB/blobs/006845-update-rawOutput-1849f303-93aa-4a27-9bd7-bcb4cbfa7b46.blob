     1→/**
     2→ * Item index for efficient queries across spec items and tasks.
     3→ *
     4→ * Provides filtering by type, tags, status, and field presence.
     5→ * Complements ReferenceIndex which handles @reference resolution.
     6→ */
     7→
     8→import type {
     9→  ImplementationStatus,
    10→  ItemType,
    11→  Maturity,
    12→  TaskStatus,
    13→} from "../schema/index.js";
    14→import { grepItem } from "../utils/grep.js";
    15→import type { AnyLoadedItem, LoadedSpecItem, LoadedTask } from "./yaml.js";
    16→
    17→// ============================================================
    18→// TYPES
    19→// ============================================================
    20→
    21→/**
    22→ * Filter criteria for item queries
    23→ */
    24→export interface ItemFilter {
    25→  /** Filter by item type (module, feature, requirement, etc.) */
    26→  type?: ItemType | ItemType[];
    27→  /** Filter by tags (matches if item has ANY of these tags) */
    28→  tags?: string[];
    29→  /** Filter by tags (matches if item has ALL of these tags) */
    30→  allTags?: string[];
    31→  /** Filter by task status (for tasks only) */
    32→  status?: TaskStatus | TaskStatus[];
    33→  /** Filter by maturity status (for spec items) */
    34→  maturity?: Maturity | Maturity[];
    35→  /** Filter by implementation status (for spec items) */
    36→  implementation?: ImplementationStatus | ImplementationStatus[];
    37→  /** Filter items that have these fields present (non-null/undefined) */
    38→  hasFields?: string[];
    39→  /** Filter items that have a specific field value */
    40→  fieldEquals?: { field: string; value: unknown }[];
    41→  /** Text search in title */
    42→  titleContains?: string;
    43→  /** Include only tasks */
    44→  tasksOnly?: boolean;
    45→  /** Include only spec items (non-tasks) */
    46→  specItemsOnly?: boolean;
    47→  /** Grep-like regex search across all text content */
    48→  grepSearch?: string;
    49→}
    50→
    51→/**
    52→ * Query result with pagination info
    53→ */
    54→export interface QueryResult<T> {
    55→  items: T[];
    56→  total: number;
    57→  offset: number;
    58→  limit: number;
    59→}
    60→
    61→// ============================================================
    62→// ITEM INDEX
    63→// ============================================================
    64→
    65→/**
    66→ * Index for efficient item queries.
    67→ * Build once when loading the spec, then query many times.
    68→ */
    69→export class ItemIndex {
    70→  /** All items (tasks + spec items) */
    71→  private allItems: AnyLoadedItem[] = [];
    72→
    73→  /** Tasks only */
    74→  private tasks: LoadedTask[] = [];
    75→
    76→  /** Spec items only (non-tasks) */
    77→  private specItems: LoadedSpecItem[] = [];
    78→
    79→  /** Index by type */
    80→  private typeIndex = new Map<string, AnyLoadedItem[]>();
    81→
    82→  /** Index by tag */
    83→  private tagIndex = new Map<string, AnyLoadedItem[]>();
    84→
    85→  /** Index by task status */
    86→  private statusIndex = new Map<TaskStatus, LoadedTask[]>();
    87→
    88→  /** Index by maturity */
    89→  private maturityIndex = new Map<Maturity, LoadedSpecItem[]>();
    90→
    91→  /** Index by implementation status */
    92→  private implementationIndex = new Map<
    93→    ImplementationStatus,
    94→    LoadedSpecItem[]
    95→  >();
    96→
    97→  /**
    98→   * Build index from loaded items
    99→   */
   100→  constructor(tasks: LoadedTask[], items: LoadedSpecItem[]) {
   101→    this.tasks = tasks;
   102→    this.specItems = items;
   103→    this.allItems = [...tasks, ...items];
   104→
   105→    // Build indexes
   106→    for (const item of this.allItems) {
   107→      this.indexItem(item);
   108→    }
   109→  }
   110→
   111→  private indexItem(item: AnyLoadedItem): void {
   112→    // Index by type
   113→    const type = item.type || "unknown";
   114→    const typeList = this.typeIndex.get(type) || [];
   115→    typeList.push(item);
   116→    this.typeIndex.set(type, typeList);
   117→
   118→    // Index by tags
   119→    const tags = "tags" in item ? (item.tags as string[]) : [];
   120→    for (const tag of tags) {
   121→      const tagList = this.tagIndex.get(tag) || [];
   122→      tagList.push(item);
   123→      this.tagIndex.set(tag, tagList);
   124→    }
   125→
   126→    // Index tasks by status
   127→    if ("status" in item && typeof item.status === "string") {
   128→      const task = item as LoadedTask;
   129→      const statusList = this.statusIndex.get(task.status) || [];
   130→      statusList.push(task);
   131→      this.statusIndex.set(task.status, statusList);
   132→    }
   133→
   134→    // Index spec items by maturity/implementation
   135→    if (
   136→      "status" in item &&
   137→      typeof item.status === "object" &&
   138→      item.status !== null
   139→    ) {
   140→      const specItem = item as LoadedSpecItem;
   141→      const status = specItem.status as {
   142→        maturity?: Maturity;
   143→        implementation?: ImplementationStatus;
   144→      };
   145→
   146→      if (status.maturity) {
   147→        const maturityList = this.maturityIndex.get(status.maturity) || [];
   148→        maturityList.push(specItem);
   149→        this.maturityIndex.set(status.maturity, maturityList);
   150→      }
   151→
   152→      if (status.implementation) {
   153→        const implList =
   154→          this.implementationIndex.get(status.implementation) || [];
   155→        implList.push(specItem);
   156→        this.implementationIndex.set(status.implementation, implList);
   157→      }
   158→    }
   159→  }
   160→
   161→  /**
   162→   * Query items with filters
   163→   */
   164→  query(filter: ItemFilter = {}): AnyLoadedItem[] {
   165→    let results: AnyLoadedItem[];
   166→
   167→    // Start with appropriate base set
   168→    if (filter.tasksOnly) {
   169→      results = [...this.tasks];
   170→    } else if (filter.specItemsOnly) {
   171→      results = [...this.specItems];
   172→    } else {
   173→      results = [...this.allItems];
   174→    }
   175→
   176→    // Apply type filter
   177→    if (filter.type) {
   178→      const types = Array.isArray(filter.type) ? filter.type : [filter.type];
   179→      results = results.filter((item) => types.includes(item.type as ItemType));
   180→    }
   181→
   182→    // Apply tag filter (ANY)
   183→    if (filter.tags && filter.tags.length > 0) {
   184→      results = results.filter((item) => {
   185→        const itemTags = "tags" in item ? (item.tags as string[]) : [];
   186→        return filter.tags?.some((tag) => itemTags.includes(tag));
   187→      });
   188→    }
   189→
   190→    // Apply tag filter (ALL)
   191→    if (filter.allTags && filter.allTags.length > 0) {
   192→      results = results.filter((item) => {
   193→        const itemTags = "tags" in item ? (item.tags as string[]) : [];
   194→        return filter.allTags?.every((tag) => itemTags.includes(tag));
   195→      });
   196→    }
   197→
   198→    // Apply task status filter
   199→    if (filter.status) {
   200→      const statuses = Array.isArray(filter.status)
   201→        ? filter.status
   202→        : [filter.status];
   203→      results = results.filter((item) => {
   204→        if (!("status" in item) || typeof item.status !== "string")
   205→          return false;
   206→        return statuses.includes(item.status as TaskStatus);
   207→      });
   208→    }
   209→
   210→    // Apply maturity filter
   211→    if (filter.maturity) {
   212→      const maturities = Array.isArray(filter.maturity)
   213→        ? filter.maturity
   214→        : [filter.maturity];
   215→      results = results.filter((item) => {
   216→        if (
   217→          !("status" in item) ||
   218→          typeof item.status !== "object" ||
   219→          !item.status
   220→        )
   221→          return false;
   222→        const status = item.status as { maturity?: Maturity };
   223→        return status.maturity && maturities.includes(status.maturity);
   224→      });
   225→    }
   226→
   227→    // Apply implementation filter
   228→    if (filter.implementation) {
   229→      const impls = Array.isArray(filter.implementation)
   230→        ? filter.implementation
   231→        : [filter.implementation];
   232→      results = results.filter((item) => {
   233→        if (
   234→          !("status" in item) ||
   235→          typeof item.status !== "object" ||
   236→          !item.status
   237→        )
   238→          return false;
   239→        const status = item.status as { implementation?: ImplementationStatus };
   240→        return status.implementation && impls.includes(status.implementation);
   241→      });
   242→    }
   243→
   244→    // Apply has-fields filter
   245→    if (filter.hasFields && filter.hasFields.length > 0) {
   246→      results = results.filter((item) => {
   247→        const obj = item as unknown as Record<string, unknown>;
   248→        return filter.hasFields?.every((field) => {
   249→          const value = getNestedField(obj, field);
   250→          return value !== undefined && value !== null;
   251→        });
   252→      });
   253→    }
   254→
   255→    // Apply field-equals filter
   256→    if (filter.fieldEquals && filter.fieldEquals.length > 0) {
   257→      results = results.filter((item) => {
   258→        const obj = item as unknown as Record<string, unknown>;
   259→        return filter.fieldEquals?.every(({ field, value }) => {
   260→          const itemValue = getNestedField(obj, field);
   261→          return itemValue === value;
   262→        });
   263→      });
   264→    }
   265→
   266→    // Apply title search
   267→    if (filter.titleContains) {
   268→      const search = filter.titleContains.toLowerCase();
   269→      results = results.filter((item) =>
   270→        item.title.toLowerCase().includes(search),
   271→      );
   272→    }
   273→
   274→    // Apply grep search (regex across all text content)
   275→    if (filter.grepSearch) {
   276→      results = results.filter((item) => {
   277→        const match = grepItem(
   278→          item as unknown as Record<string, unknown>,
   279→          filter.grepSearch!,
   280→        );
   281→        return match !== null;
   282→      });
   283→    }
   284→
   285→    return results;
   286→  }
   287→
   288→  /**
   289→   * Query with pagination
   290→   */
   291→  queryPaginated(
   292→    filter: ItemFilter = {},
   293→    offset = 0,
   294→    limit = 50,
   295→  ): QueryResult<AnyLoadedItem> {
   296→    const allResults = this.query(filter);
   297→    const items = allResults.slice(offset, offset + limit);
   298→
   299→    return {
   300→      items,
   301→      total: allResults.length,
   302→      offset,
   303→      limit,
   304→    };
   305→  }
   306→
   307→  /**
   308→   * Get items by type
   309→   */
   310→  getByType(type: ItemType): AnyLoadedItem[] {
   311→    return this.typeIndex.get(type) || [];
   312→  }
   313→
   314→  /**
   315→   * Get items by tag
   316→   */
   317→  getByTag(tag: string): AnyLoadedItem[] {
   318→    return this.tagIndex.get(tag) || [];
   319→  }
   320→
   321→  /**
   322→   * Get tasks by status
   323→   */
   324→  getTasksByStatus(status: TaskStatus): LoadedTask[] {
   325→    return this.statusIndex.get(status) || [];
   326→  }
   327→
   328→  /**
   329→   * Get spec items by maturity
   330→   */
   331→  getByMaturity(maturity: Maturity): LoadedSpecItem[] {
   332→    return this.maturityIndex.get(maturity) || [];
   333→  }
   334→
   335→  /**
   336→   * Get spec items by implementation status
   337→   */
   338→  getByImplementation(impl: ImplementationStatus): LoadedSpecItem[] {
   339→    return this.implementationIndex.get(impl) || [];
   340→  }
   341→
   342→  /**
   343→   * Get all unique types in the index
   344→   */
   345→  getTypes(): string[] {
   346→    return [...this.typeIndex.keys()].sort();
   347→  }
   348→
   349→  /**
   350→   * Get all unique tags in the index
   351→   */
   352→  getTags(): string[] {
   353→    return [...this.tagIndex.keys()].sort();
   354→  }
   355→
   356→  /**
   357→   * Get count by type
   358→   */
   359→  getTypeCounts(): Map<string, number> {
   360→    const counts = new Map<string, number>();
   361→    for (const [type, items] of this.typeIndex) {
   362→      counts.set(type, items.length);
   363→    }
   364→    return counts;
   365→  }
   366→
   367→  /**
   368→   * Get count by tag
   369→   */
   370→  getTagCounts(): Map<string, number> {
   371→    const counts = new Map<string, number>();
   372→    for (const [tag, items] of this.tagIndex) {
   373→      counts.set(tag, items.length);
   374→    }
   375→    return counts;
   376→  }
   377→
   378→  /**
   379→   * Get total item count
   380→   */
   381→  get size(): number {
   382→    return this.allItems.length;
   383→  }
   384→
   385→  /**
   386→   * Get task count
   387→   */
   388→  get taskCount(): number {
   389→    return this.tasks.length;
   390→  }
   391→
   392→  /**
   393→   * Get spec item count
   394→   */
   395→  get specItemCount(): number {
   396→    return this.specItems.length;
   397→  }
   398→}
   399→
   400→// ============================================================
   401→// HELPERS
   402→// ============================================================
   403→
   404→/**
   405→ * Get a nested field value using dot notation
   406→ * e.g., "status.maturity" -> item.status.maturity
   407→ */
   408→function getNestedField(obj: Record<string, unknown>, path: string): unknown {
   409→  const parts = path.split(".");
   410→  let current: unknown = obj;
   411→
   412→  for (const part of parts) {
   413→    if (current === null || current === undefined) return undefined;
   414→    if (typeof current !== "object") return undefined;
   415→    current = (current as Record<string, unknown>)[part];
   416→  }
   417→
   418→  return current;
   419→}
   420→
   421→/**
   422→ * Find direct child items of a parent item based on _path
   423→ * Children have paths like "parent_path.field[N]"
   424→ */
   425→export function findChildItems(
   426→  parent: LoadedSpecItem,
   427→  allItems: LoadedSpecItem[],
   428→): LoadedSpecItem[] {
   429→  // Handle both cases: parent at root and nested parent
   430→  const parentPath = parent._path || "";
   431→
   432→  // Look for items whose path starts with parent's path
   433→  return allItems.filter((item) => {
   434→    if (!item._path) return false;
   435→    if (item._ulid === parent._ulid) return false; // Skip self
   436→
   437→    // Child path should be: parentPath.field[N]
   438→    // Examples:
   439→    // - Parent: "features[0]", Child: "features[0].requirements[0]"
   440→    // - Parent: "", Child: "features[0]"
   441→    if (parentPath === "") {
   442→      // Root level parent - children are top-level items like "features[0]"
   443→      return !item._path.includes(".");
   444→    }
   445→
   446→    // Nested parent - children start with parent path + dot
   447→    if (!item._path.startsWith(`${parentPath}.`)) {
   448→      return false;
   449→    }
   450→
   451→    // Must be direct child (no additional nesting)
   452→    // Remove parent prefix and check for no more dots
   453→    const remainder = item._path.slice(parentPath.length + 1);
   454→    return !remainder.includes(".");
   455→  });
   456→}
   457→

