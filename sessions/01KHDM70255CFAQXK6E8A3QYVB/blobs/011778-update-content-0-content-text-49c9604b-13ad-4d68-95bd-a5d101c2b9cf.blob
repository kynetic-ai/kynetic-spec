    66→
    67→// ─── Task Limit Marker ──────────────────────────────────────────────────────
    68→
    69→/**
    70→ * Marker file schema for task limit enforcement.
    71→ * AC: @ralph-task-limit ac-marker-format
    72→ */
    73→interface TaskLimitMarker {
    74→  active: boolean;
    75→  since: string; // ISO8601
    76→  max: number;
    77→  completed: number;
    78→  sessionId: string;
    79→}
    80→
    81→const TASK_LIMIT_MARKER_PATH = ".claude/ralph-task-limit.json";
    82→const END_LOOP_MARKER_PATH = ".claude/ralph-end-loop.json";
    83→const STALE_MARKER_THRESHOLD_MS = 60 * 60 * 1000; // 1 hour
    84→
    85→// ─── End Loop Marker ────────────────────────────────────────────────────────
    86→
    87→/**
    88→ * Marker file schema for explicit end-loop signaling.
    89→ * AC: @ralph-end-loop ac-cmd
    90→ */
    91→interface EndLoopMarker {
    92→  requested: boolean;
    93→  timestamp: string; // ISO8601
    94→  reason?: string;
    95→}
    96→
    97→/**
    98→ * Write task limit marker file.
    99→ * AC: @ralph-task-limit ac-wrapup, ac-marker-format
   100→ */
   101→async function writeTaskLimitMarker(
   102→  rootDir: string,
   103→  marker: TaskLimitMarker,
   104→): Promise<void> {
   105→  const markerPath = path.join(rootDir, TASK_LIMIT_MARKER_PATH);
   106→  const dir = path.dirname(markerPath);
   107→  await fs.mkdir(dir, { recursive: true });
   108→  await fs.writeFile(markerPath, JSON.stringify(marker, null, 2));
   109→}
   110→
   111→/**
   112→ * Read task limit marker file if it exists.
   113→ */
   114→async function readTaskLimitMarker(
   115→  rootDir: string,
   116→): Promise<TaskLimitMarker | null> {
   117→  const markerPath = path.join(rootDir, TASK_LIMIT_MARKER_PATH);
   118→  try {
   119→    const content = await fs.readFile(markerPath, "utf-8");
   120→    return JSON.parse(content) as TaskLimitMarker;
   121→  } catch {
   122→    return null;
   123→  }
   124→}
   125→
   126→/**
   127→ * Clear task limit marker file.
   128→ * AC: @ralph-task-limit ac-reset
   129→ */
   130→async function clearTaskLimitMarker(rootDir: string): Promise<void> {
   131→  const markerPath = path.join(rootDir, TASK_LIMIT_MARKER_PATH);
   132→  try {
   133→    await fs.unlink(markerPath);
   134→  } catch {
   135→    // Ignore if file doesn't exist
   136→  }
   137→}
   138→
   139→/**
   140→ * Clear stale marker files (older than 1 hour).
   141→ * AC: @ralph-task-limit ac-reset
   142→ */
   143→async function clearStaleMarker(rootDir: string): Promise<boolean> {
   144→  const marker = await readTaskLimitMarker(rootDir);
   145→  if (!marker) return false;
   146→
   147→  const markerAge = Date.now() - new Date(marker.since).getTime();
   148→  if (markerAge > STALE_MARKER_THRESHOLD_MS) {
   149→    await clearTaskLimitMarker(rootDir);
   150→    return true;
   151→  }
   152→  return false;
   153→}
   154→
   155→/**
   156→ * Write end-loop marker file.
   157→ * AC: @ralph-end-loop ac-cmd
   158→ */
   159→async function writeEndLoopMarker(
   160→  rootDir: string,
   161→  reason?: string,
   162→): Promise<void> {
   163→  const markerPath = path.join(rootDir, END_LOOP_MARKER_PATH);
   164→  const dir = path.dirname(markerPath);
   165→  await fs.mkdir(dir, { recursive: true });
   166→  const marker: EndLoopMarker = {
   167→    requested: true,
   168→    timestamp: new Date().toISOString(),
   169→    reason,
   170→  };
   171→  await fs.writeFile(markerPath, JSON.stringify(marker, null, 2));
   172→}
   173→
   174→/**
   175→ * Read end-loop marker file if it exists.
   176→ * AC: @ralph-end-loop ac-detect
   177→ */
   178→async function readEndLoopMarker(
   179→  rootDir: string,
   180→): Promise<EndLoopMarker | null> {
   181→  const markerPath = path.join(rootDir, END_LOOP_MARKER_PATH);
   182→  try {
   183→    const content = await fs.readFile(markerPath, "utf-8");
   184→    return JSON.parse(content) as EndLoopMarker;
   185→  } catch {
   186→    return null;
   187→  }
   188→}
   189→
   190→/**
   191→ * Clear end-loop marker file.
   192→ * AC: @ralph-end-loop ac-cleanup
   193→ */
   194→async function clearEndLoopMarker(rootDir: string): Promise<void> {
   195→  const markerPath = path.join(rootDir, END_LOOP_MARKER_PATH);
   196→  try {
   197→    await fs.unlink(markerPath);
   198→  } catch {
   199→    // Ignore if file doesn't exist
   200→  }
   201→}
   202→
   203→/**
   204→ * Clear stale end-loop markers (older than 1 hour).
   205→ * AC: @ralph-end-loop ac-cleanup
   206→ */
   207→async function clearStaleEndLoopMarker(rootDir: string): Promise<boolean> {
   208→  const marker = await readEndLoopMarker(rootDir);
   209→  if (!marker) return false;
   210→
   211→  const markerAge = Date.now() - new Date(marker.timestamp).getTime();
   212→  if (markerAge > STALE_MARKER_THRESHOLD_MS) {
   213→    await clearEndLoopMarker(rootDir);
   214→    return true;
   215→  }
   216→  return false;
   217→}
   218→
   219→/**
   220→ * Detect if a Bash command is a task complete command.
   221→ * AC: @ralph-task-limit ac-detection
   222→ */
   223→function detectTaskCompleteCommand(command: string): boolean {
   224→  // Match variations of "kspec task complete"
   225→  // Don't match "kspec task submit" - that's just status change to pending_review
   226→  return /\bkspec\s+task\s+complete\b/.test(command);
   227→}
   228→
   229→/**
   230→ * Detect if a Bash command is an end-loop command.
   231→ * AC: @ralph-end-loop ac-detect
   232→ */
   233→function detectEndLoopCommand(command: string): boolean {
   234→  // Match "kspec ralph end-loop" with any arguments
   235→  return /\bkspec\s+ralph\s+end-loop\b/.test(command);
   236→}
   237→
   238→/**
   239→ * Extract Bash command from SessionUpdate if it's a tool_call or tool_call_update event.
   240→ * Returns null if not a Bash tool call.
   241→ */
   242→function extractBashCommand(update: SessionUpdate): string | null {
   243→  const u = update as Record<string, unknown>;
   244→
   245→  // Check if this is a tool call event
   246→  if (u.sessionUpdate !== "tool_call" && u.sessionUpdate !== "tool_call_update") {
   247→    return null;
   248→  }
   249→
   250→  // Extract tool name - check various locations Claude Code uses
   251→  let toolName: string | undefined;
   252→
   253→  // Try _meta.claudeCode.toolName first (Claude Code pattern)
   254→  const meta = u._meta as Record<string, unknown> | undefined;
   255→  if (meta) {
   256→    const claudeCode = meta.claudeCode as Record<string, unknown> | undefined;
   257→    if (claudeCode?.toolName) {
   258→      toolName = String(claudeCode.toolName);
   259→    } else if (meta.toolName) {
   260→      toolName = String(meta.toolName);
   261→    }
   262→  }
   263→
   264→  // Fall back to name or title field
   265→  if (!toolName && u.name) {
   266→    toolName = String(u.name);
   267→  }
   268→  if (!toolName && u.title) {
   269→    toolName = String(u.title);
   270→  }
   271→
   272→  // Check if it's a Bash tool (handle MCP prefix variations)
   273→  if (!toolName) return null;
   274→  const isBash = toolName === "Bash" || toolName.endsWith("__Bash");
   275→  if (!isBash) return null;
   276→
   277→  // Extract command from input
   278→  const input = (u.rawInput || u.input || u.params) as Record<string, unknown> | undefined;
   279→  if (!input) return null;
   280→
   281→  const command = input.command;
   282→  if (typeof command !== "string") return null;
   283→
   284→  return command;
   285→}
   286→
   287→// ─── Explicit Task Scope ─────────────────────────────────────────────────────
   288→
   289→/**
   290→ * Parsed explicit task scope for --tasks flag.
   291→ * AC: @cli-ralph ac-21
   292→ */
   293→interface ExplicitTaskScope {
   294→  /** Original refs as provided by user */
   295→  refs: string[];
   296→  /** Resolved ULIDs for the tasks */
   297→  ulids: string[];
   298→}
   299→
   300→/**
   301→ * Parse and validate --tasks flag value.
   302→ * Returns resolved ULIDs for the specified task refs.
   303→ * AC: @cli-ralph ac-21
   304→ *
   305→ * @throws Error if any ref cannot be resolved or is not a task
   306→ */
   307→async function parseExplicitTasks(
   308→  ctx: KspecContext,
   309→  tasksArg: string,
   310→): Promise<ExplicitTaskScope> {
   311→  const refs = tasksArg.split(",").map((r) => r.trim()).filter(Boolean);
   312→
   313→  if (refs.length === 0) {
   314→    throw new Error("--tasks requires at least one task reference");
   315→  }
   316→
   317→  // Load tasks and items for resolution
   318→  const tasks = await loadAllTasks(ctx);
   319→  const items = await loadAllItems(ctx);
   320→  const index = new ReferenceIndex(tasks, items);
   321→
   322→  const ulids: string[] = [];
   323→
   324→  for (const ref of refs) {
   325→    const result = index.resolve(ref);
   326→    if (!result.ok) {
   327→      throw new Error(`Cannot resolve task reference: ${ref}`);
   328→    }
   329→
   330→    // Verify it's a task (not a spec item)
   331→    const task = tasks.find((t) => t._ulid === result.ulid);
   332→    if (!task) {
   333→      throw new Error(`Reference ${ref} is not a task`);
   334→    }
   335→
   336→    ulids.push(result.ulid);
   337→  }
   338→
   339→  return { refs, ulids };
   340→}
   341→
   342→/**
   343→ * Filter session context to only include tasks from explicit scope.
   344→ * AC: @cli-ralph ac-21
   345→ */
   346→function filterByExplicitTasks(
   347→  ctx: SessionContext,
   348→  scope: ExplicitTaskScope,
   349→): SessionContext {
   350→  // Task refs in context are short ULIDs (variable length from shortUlid())
   351→  // Check if the context ref is a prefix of any explicit ULID
   352→  const matchesScope = (taskRef: string) => {
   353→    return scope.ulids.some((ulid) => ulid.startsWith(taskRef));
   354→  };
   355→
   356→  return {
   357→    ...ctx,
   358→    active_tasks: ctx.active_tasks.filter((t) => matchesScope(t.ref)),
   359→    pending_review_tasks: ctx.pending_review_tasks.filter((t) => matchesScope(t.ref)),
   360→    ready_tasks: ctx.ready_tasks.filter((t) => matchesScope(t.ref)),
   361→  };
   362→}
   363→
   364→/**
   365→ * Check if all explicit tasks are completed or blocked.
   366→ * AC: @cli-ralph ac-21
   367→ */
   368→async function allExplicitTasksDone(
   369→  ctx: KspecContext,
   370→  scope: ExplicitTaskScope,
   371→): Promise<{ done: boolean; statuses: Map<string, string> }> {
   372→  const tasks = await loadAllTasks(ctx);
   373→  const statuses = new Map<string, string>();
   374→
   375→  for (const ulid of scope.ulids) {
   376→    const task = tasks.find((t) => t._ulid === ulid);
   377→    if (task) {
   378→      statuses.set(ulid.slice(0, 8), task.status);
   379→    }
   380→  }
   381→
   382→  // Check if all are completed or blocked
   383→  const done = scope.ulids.every((ulid) => {
   384→    const status = statuses.get(ulid.slice(0, 8));
   385→    return status === "completed" || status === "blocked";
   386→  });
   387→
   388→  return { done, statuses };
   389→}
   390→
   391→// ─── Prompt Template ─────────────────────────────────────────────────────────
   392→
   393→// AC: @ralph-skill-delegation ac-1, ac-2, ac-3
   394→function buildTaskWorkPrompt(
   395→  sessionCtx: SessionContext,
   396→  iteration: number,
   397→  maxLoops: number,
   398→  sessionId: string,
   399→  focus?: string,
   400→  explicitTaskScope?: ExplicitTaskScope,
   401→): string {
   402→  const focusSection = focus
   403→    ? `
   404→## Session Focus (applies to ALL iterations)
   405→
   406→> **${focus}**
   407→
   408→Keep this focus in mind throughout your work. It takes priority over default task selection.
   409→`
   410→    : "";
   411→
   412→  // AC: @cli-ralph ac-21 - Explicit task scope indicator in prompt
   413→  const taskScopeSection = explicitTaskScope
   414→    ? `
   415→## Explicit Task Scope
   416→
   417→This session is scoped to specific tasks: ${explicitTaskScope.refs.join(", ")}
   418→
   419→**Only work on these tasks.** The loop will exit when all listed tasks are completed or blocked.
   420→`
   421→    : "";
   422→
   423→  const modeDescription = explicitTaskScope
   424→    ? "Loop mode means: no confirmations, auto-resolve decisions, explicit task scope (only the listed tasks)."
   425→    : "Loop mode means: no confirmations, auto-resolve decisions, automation-eligible tasks only.";
   426→
   427→  return `# Kspec Automation Session - Task Work
   428→
   429→**Session ID:** \`${sessionId}\`
   430→**Iteration:** ${iteration} of ${maxLoops}
   431→**Mode:** Automated (no human in the loop)
   432→${focusSection}${taskScopeSection}
   433→
   434→## Current State
   435→\`\`\`json
   436→${JSON.stringify(sessionCtx, null, 2)}
   437→\`\`\`
   438→
   439→## Instructions
   440→
   441→Run the task-work skill in loop mode:
   442→
   443→\`\`\`
   444→/task-work loop
   445→\`\`\`
   446→
   447→${modeDescription}
   448→
   449→**Normal flow:** Work on a task, create a PR, then stop responding. Ralph continues automatically —
   450→it checks for remaining eligible tasks at the start of each iteration and exits the loop itself when none remain.
   451→
   452→**Do NOT call \`end-loop\` after completing a task.** Simply stop responding.
   453→\`end-loop\` is a rare escape hatch for when work is stalling across multiple iterations with no progress — not a normal exit path.
   454→`;
   455→}
   456→
   457→/**
   458→ * Build the reflect prompt sent after task-work completes.
   459→ * Ralph sends this as a separate prompt to ensure reflection always happens.
   460→ */
   461→function buildReflectPrompt(
   462→  iteration: number,
   463→  maxLoops: number,
   464→  sessionId: string,
   465→): string {
   466→  const isFinal = iteration === maxLoops;
   467→
   468→  return `# Kspec Automation Session - Reflection
   469→
   470→**Session ID:** \`${sessionId}\`
   471→**Iteration:** ${iteration} of ${maxLoops}
   472→**Phase:** Post-task reflection
   473→
   474→## Instructions
   475→
   476→Run the reflect skill in loop mode:
   477→
   478→\`\`\`
   479→/reflect loop
   480→\`\`\`
   481→
   482→Loop mode means: high-confidence captures only, must search existing before capturing, no user prompts.
   483→${
   484→  isFinal
   485→    ? `
   486→**FINAL ITERATION** - This is the last chance to capture insights from this session.
   487→`
   488→    : ""
   489→}
   490→Exit when reflection is complete.
   491→`;
   492→}
   493→
   494→// ─── Streaming Output ────────────────────────────────────────────────────────
   495→
   496→// Translator and renderer are created per-session in the action handler.
   497→// This allows the architecture to be reused by future TUI renderers.
   498→
   499→// ─── Adapter Validation ──────────────────────────────────────────────────────
   500→
   501→// AC: @ralph-adapter-validation valid-adapter-proceeds, invalid-adapter-error, validation-before-spawn
   502→/**
   503→ * Validate that the specified ACP adapter package exists.
   504→ * Uses npx --no-install to check both global and local node_modules.
   505→ *
   506→ * @throws {Error} Never throws - exits process with code 3 if validation fails
   507→ */
   508→function validateAdapter(adapterPackage: string): void {
   509→  // Use npx --no-install with --version to check if package exists
   510→  // This checks both global and local node_modules, handles scoped packages
   511→  const result = spawnSync(
   512→    "npx",
   513→    ["--no-install", adapterPackage, "--version"],
   514→    {
   515→      encoding: "utf-8",
   516→      stdio: "pipe",
   517→    },
   518→  );
   519→
   520→  if (result.status !== 0) {
   521→    error(
   522→      `Adapter package not found: ${adapterPackage}. Install with: npm install -g ${adapterPackage}`,
   523→    );
   524→    process.exit(EXIT_CODES.NOT_FOUND);
   525→  }
   526→}
   527→
   528→// ─── Tool Request Handler ────────────────────────────────────────────────────
   529→
   530→/**
   531→ * Handle tool requests from ACP agent.
   532→ * Implements file operations, terminal commands, and permission handling.
   533→ */
   534→async function handleRequest(
   535→  client: ACPClient,
   536→  id: string | number,
   537→  method: string,
   538→  params: unknown,
   539→  yolo: boolean,
   540→): Promise<void> {
   541→  try {
   542→    switch (method) {
   543→      case "session/request_permission": {
   544→        const p = params as RequestPermissionRequest;
   545→        // In yolo mode, auto-approve all permissions
   546→        // In normal mode, would need to implement permission UI
   547→        const options = p.options || [];
   548→
   549→        if (yolo) {
   550→          // Find an "allow" option (prefer allow_always, then allow_once)
   551→          const allowOption =
   552→            options.find((o) => o.kind === "allow_always") ||
   553→            options.find((o) => o.kind === "allow_once");
   554→
   555→          if (allowOption) {
   556→            client.respondPermission(id, {
   557→              outcome: { outcome: "selected", optionId: allowOption.optionId },
   558→            });
   559→          } else {
   560→            // No allow option available - cancel
   561→            client.respondPermission(id, { outcome: { outcome: "cancelled" } });
   562→          }
   563→        } else {
   564→          // TODO: Implement permission prompting
   565→          client.respondPermission(id, { outcome: { outcome: "cancelled" } });
   566→        }
   567→        break;
   568→      }
   569→
   570→      case "file/read": {
   571→        const p = params as ReadTextFileRequest;
   572→        const content = await fs.readFile(p.path, "utf-8");
   573→        client.respondReadTextFile(id, { content });
   574→        break;
   575→      }
   576→
   577→      case "file/write": {
   578→        const p = params as WriteTextFileRequest;
   579→        await fs.mkdir(path.dirname(p.path), { recursive: true });
   580→        await fs.writeFile(p.path, p.content, "utf-8");
   581→        client.respondWriteTextFile(id, {});
   582→        break;
   583→      }
   584→
   585→      case "terminal/run": {
   586→        // Custom method (not part of ACP spec - ACP uses createTerminal instead)
   587→        // TODO: Consider migrating to standard ACP terminal methods
   588→        const p = params as {
   589→          command: string;
   590→          cwd?: string;
   591→          timeout?: number;
   592→        };
   593→        const command = p.command;
   594→        const cwd = p.cwd || process.cwd();
   595→        const timeout = p.timeout || 60000;
   596→
   597→        const result = await new Promise<{
   598→          stdout: string;
   599→          stderr: string;
   600→          exitCode: number;
   601→        }>((resolve) => {
   602→          const child = spawn(command, [], {
   603→            cwd,
   604→            shell: true,
   605→            timeout,
   606→          });
   607→
   608→          let stdout = "";
   609→          let stderr = "";
   610→
   611→          child.stdout?.on("data", (data) => {
   612→            stdout += data.toString();
   613→          });
   614→
   615→          child.stderr?.on("data", (data) => {
   616→            stderr += data.toString();
   617→          });
   618→
   619→          child.on("close", (code) => {
   620→            resolve({ stdout, stderr, exitCode: code ?? 1 });
   621→          });
   622→
   623→          child.on("error", (err) => {
   624→            resolve({ stdout, stderr: err.message, exitCode: 1 });
   625→          });
   626→        });
   627→
   628→        // Using generic respond() since this is a custom method
   629→        client.respond(id, result);
   630→        break;
   631→      }
   632→
   633→      default:
   634→        // Unknown method - return error
   635→        client.respondError(id, -32601, `Method not found: ${method}`);
   636→    }
   637→  } catch (err) {
   638→    const message = err instanceof Error ? err.message : String(err);
   639→    client.respondError(id, -32000, message);
   640→  }
   641→}
   642→
   643→// ─── Subagent Support ─────────────────────────────────────────────────────────
   644→
   645→/**
   646→ * Build context for a PR review subagent.
   647→ * AC: @ralph-subagent-spawning ac-10
   648→ */
   649→async function buildSubagentContext(
   650→  ctx: KspecContext,
   651→  taskRef: string,
   652→): Promise<SubagentContext> {
   653→  // Load all tasks and items
   654→  const tasks = await loadAllTasks(ctx);
   655→  const items = await loadAllItems(ctx);
   656→  const index = new ReferenceIndex(tasks, items);
   657→
   658→  // Resolve task reference
   659→  const taskResult = index.resolve(taskRef);
   660→  if (!taskResult.ok) {
   661→    throw new Error(`Task not found: ${taskRef}`);
   662→  }
   663→
   664→  const task = tasks.find((t) => t._ulid === taskResult.ulid);
   665→  if (!task) {
   666→    throw new Error(`Task not found by ULID: ${taskResult.ulid}`);
   667→  }
   668→
   669→  // Get linked spec with ACs if spec_ref exists
   670→  let specWithACs: Record<string, unknown> | null = null;
   671→  if (task.spec_ref) {
   672→    const specResult = index.resolve(task.spec_ref);
   673→    if (specResult.ok) {
   674→      const item = items.find((i) => i._ulid === specResult.ulid);
   675→      if (item) {
   676→        specWithACs = item as unknown as Record<string, unknown>;
   677→      }
   678→    }
   679→  }
   680→
   681→  // Get git branch
   682→  const gitBranch = getCurrentBranch(ctx.rootDir) || "unknown";
   683→
   684→  return {
   685→    taskRef,
   686→    taskDetails: task as unknown as Record<string, unknown>,
   687→    specWithACs,
   688→    gitBranch,
   689→  };
   690→}
   691→
   692→/**
   693→ * Check if a task was completed by the subagent.
   694→ * AC: @ralph-subagent-spawning ac-12
   695→ */
   696→async function verifyTaskCompleted(taskRef: string): Promise<boolean> {
   697→  const result = spawnSync("kspec", ["task", "get", taskRef, "--json"], {
   698→    encoding: "utf-8",
   699→    stdio: "pipe",
   700→  });
   701→
   702→  if (result.status !== 0) {
   703→    warn(`Failed to check task status for ${taskRef}: ${result.stderr}`);
   704→    return false;
   705→  }
   706→
   707→  try {
   708→    const task = JSON.parse(result.stdout);
   709→    return task.status === "completed";
   710→  } catch {
   711→    warn(`Failed to parse task status for ${taskRef}`);
   712→    return false;
   713→  }
   714→}
   715→
   716→/**
   717→ * Mark a task as needing review due to subagent timeout.
   718→ * AC: @ralph-subagent-spawning ac-9
   719→ */
   720→async function markTaskNeedsReview(
   721→  taskRef: string,
   722→  reason: string,
   723→): Promise<void> {
   724→  const { spawnSync } = await import("node:child_process");
   725→
   726→  // Use kspec CLI to set automation status
   727→  const result = spawnSync(
   728→    "kspec",
   729→    ["task", "set-automation", taskRef, "needs_review"],
   730→    {
   731→      encoding: "utf-8",
   732→      stdio: "pipe",
   733→    },
   734→  );
   735→
   736→  if (result.status !== 0) {
   737→    warn(`Failed to mark task ${taskRef} as needs_review: ${result.stderr}`);
   738→  }
   739→
   740→  // Add a note explaining the timeout
   741→  const noteResult = spawnSync(
   742→    "kspec",
   743→    ["task", "note", taskRef, `[RALPH SUBAGENT] ${reason}`],
   744→    {
   745→      encoding: "utf-8",
   746→      stdio: "pipe",
   747→    },
   748→  );
   749→
   750→  if (noteResult.status !== 0) {
   751→    warn(`Failed to add timeout note to task ${taskRef}: ${noteResult.stderr}`);
   752→  }
   753→}
   754→
   755→/**
   756→ * Handle failed iteration by tracking per-task failures and escalating at threshold.
   757→ * AC: @loop-mode-error-handling ac-1, ac-2, ac-3, ac-4, ac-5, ac-8
   758→ */
   759→async function handleIterationFailure(
   760→  ctx: KspecContext,
   761→  tasksInProgressAtStart: ActiveTaskSummary[],
   762→  iterationStartTime: Date,
   763→  errorDescription: string,
   764→): Promise<void> {
   765→  if (tasksInProgressAtStart.length === 0) {
   766→    return;
   767→  }
   768→
   769→  // Re-load current tasks to check progress
   770→  const currentTasks = await loadAllTasks(ctx);
   771→  const index = new ReferenceIndex(currentTasks, await loadAllItems(ctx));
   772→
   773→  // Convert ActiveTaskSummary to Task-like objects for processing
   774→  const tasksInProgressFull = tasksInProgressAtStart
   775→    .map((summary) => {
   776→      const resolved = index.resolve(summary.ref);
   777→      if (!resolved.ok) return undefined;
   778→      // Check if the resolved item is a task (not a spec item or meta item)
   779→      const item = resolved.item;
   780→      if (!("status" in item)) return undefined; // Spec items don't have status
   781→      return currentTasks.find((t) => t._ulid === resolved.ulid);
   782→    })
   783→    .filter((t): t is LoadedTask => t !== undefined && t.status === "in_progress");
   784→
   785→  if (tasksInProgressFull.length === 0) {
   786→    return;
   787→  }
   788→
   789→  // Process failures
   790→  const { processFailedIteration, createFailureNote, getTaskFailureCount } = await import("../../ralph/index.js");
   791→
   792→  const results = processFailedIteration(
   793→    tasksInProgressFull,
   794→    currentTasks,
   795→    iterationStartTime,
   796→    errorDescription,
   797→  );
   798→
   799→  // Add notes and escalate tasks
   800→  for (const result of results) {
   801→    const taskRef = result.taskRef;
   802→    const task = currentTasks.find((t) => t._ulid === taskRef);
   803→    if (!task) continue;
   804→
   805→    const priorCount = result.failureCount - 1;
   806→    const noteContent = createFailureNote(taskRef, errorDescription, priorCount);
   807→
   808→    // Add LOOP-FAIL note
   809→    const noteResult = spawnSync(
   810→      "kspec",
   811→      ["task", "note", `@${taskRef}`, noteContent],
   812→      {
   813→        encoding: "utf-8",
   814→        stdio: "pipe",
   815→        cwd: process.cwd(),
   816→      },
   817→    );
   818→
   819→    if (noteResult.status !== 0) {
   820→      warn(`Failed to add failure note to task ${taskRef}: ${noteResult.stderr}`);
   821→      continue;
   822→    }
   823→
   824→    // AC: @loop-mode-error-handling ac-5 - Escalate at threshold
   825→    if (result.escalated) {
   826→      const escalateResult = spawnSync(
   827→        "kspec",
   828→        [
   829→          "task",
   830→          "set",
   831→          `@${taskRef}`,
   832→          "--automation",
   833→          "needs_review",
   834→          "--reason",
   835→          `Loop mode: 3 consecutive failures without progress`,
   836→        ],
   837→        {
   838→          encoding: "utf-8",
   839→          stdio: "pipe",
   840→          cwd: process.cwd(),
   841→        },
   842→      );
   843→
   844→      if (escalateResult.status !== 0) {
   845→        warn(`Failed to escalate task ${taskRef}: ${escalateResult.stderr}`);
   846→      } else {
   847→        info(`Escalated task ${taskRef} to automation:needs_review after 3 failures`);
   848→      }
   849→    }
   850→  }
   851→}
   852→
   853→/**
   854→ * Process pending_review tasks by spawning subagents.
   855→ * AC: @ralph-subagent-spawning ac-6, ac-8
   856→ */
   857→async function processPendingReviewTasks(
   858→  ctx: KspecContext,
   859→  adapter: AgentAdapter,
   860→  pendingReviewTasks: ActiveTaskSummary[],
   861→  options: {
   862→    yolo: boolean;
   863→    maxRetries: number;
   864→    maxFailures: number;
   865→    cwd: string;
   866→  },
   867→  consecutiveFailures: { count: number },
   868→): Promise<boolean> {
   869→  if (pendingReviewTasks.length === 0) {
   870→    return true;
   871→  }
   872→
   873→  // Visual separator for subagent section
   874→  console.log("");
   875→  console.log(chalk.cyan(`${"═".repeat(60)}`));
   876→  console.log(chalk.cyan.bold(`${DEFAULT_SUBAGENT_PREFIX} Processing Pending Review Tasks`));
   877→  console.log(chalk.cyan(`${"═".repeat(60)}`));
   878→  console.log("");
   879→
   880→  info(
   881→    `${DEFAULT_SUBAGENT_PREFIX} Found ${pendingReviewTasks.length} pending_review task(s)`,
   882→  );
   883→
   884→  // AC: @ralph-subagent-spawning ac-6 - Process one at a time
   885→  for (const task of pendingReviewTasks) {
   886→    info(`${DEFAULT_SUBAGENT_PREFIX} Processing: ${task.ref} - ${task.title}`);
   887→
   888→    try {
   889→      // Build context for this task
   890→      const subagentCtx = await buildSubagentContext(ctx, task.ref);
   891→
   892→      // AC: @ralph-subagent-spawning ac-1, ac-3 - Spawn and wait
   893→      const result = await runSubagent(
   894→        adapter,
   895→        subagentCtx,
   896→        {
   897→          timeout: DEFAULT_SUBAGENT_TIMEOUT,
   898→          outputPrefix: DEFAULT_SUBAGENT_PREFIX,
   899→        },
   900→        {
   901→          yolo: options.yolo,
   902→          cwd: options.cwd,
   903→          handleRequest: (client, reqId, method, params) =>
   904→            handleRequest(client, reqId, method, params, options.yolo),
   905→        },
   906→      );
   907→
   908→      if (result.timedOut) {
   909→        // AC: @ralph-subagent-spawning ac-9
   910→        warn(
   911→          `${DEFAULT_SUBAGENT_PREFIX} Subagent timed out for ${task.ref}`,
   912→        );
   913→        await markTaskNeedsReview(
   914→          task.ref,
   915→          "Subagent timed out after 10 minutes",
   916→        );
   917→        consecutiveFailures.count++;
   918→      } else if (!result.success) {
   919→        // AC: @ralph-subagent-spawning ac-7
   920→        error(
   921→          `${DEFAULT_SUBAGENT_PREFIX} Subagent failed for ${task.ref}: ${result.error}`,
   922→        );
   923→        consecutiveFailures.count++;
   924→      } else {
   925→        // AC: @ralph-subagent-spawning ac-12 - Verify task was completed
   926→        const wasCompleted = await verifyTaskCompleted(task.ref);
   927→        if (wasCompleted) {
   928→          success(`${DEFAULT_SUBAGENT_PREFIX} Completed: ${task.ref}`);
   929→          consecutiveFailures.count = 0;
   930→        } else {
   931→          // Task wasn't completed - subagent likely exited early
   932→          warn(
   933→            `${DEFAULT_SUBAGENT_PREFIX} Subagent succeeded but task ${task.ref} is still pending_review`,
   934→          );
   935→          await markTaskNeedsReview(
   936→            task.ref,
   937→            "Subagent merged PR but did not complete the task. Review required to verify merge and complete task manually.",
   938→          );
   939→          consecutiveFailures.count++;
   940→        }
   941→      }
   942→
   943→      // Check if we've hit max failures
   944→      if (consecutiveFailures.count >= options.maxFailures) {
   945→        error(
   946→          `${DEFAULT_SUBAGENT_PREFIX} Reached max failures (${options.maxFailures})`,
   947→        );
   948→        return false;
   949→      }
   950→    } catch (err) {
   951→      const message = err instanceof Error ? err.message : String(err);
   952→      error(`${DEFAULT_SUBAGENT_PREFIX} Error processing ${task.ref}: ${message}`);
   953→      consecutiveFailures.count++;
   954→
   955→      if (consecutiveFailures.count >= options.maxFailures) {
   956→        error(
   957→          `${DEFAULT_SUBAGENT_PREFIX} Reached max failures (${options.maxFailures})`,
   958→        );
   959→        return false;
   960→      }
   961→    }
   962→  }
   963→
   964→  // Visual separator at end of subagent section
   965→  console.log("");
   966→  console.log(chalk.cyan(`${"═".repeat(60)}`));
   967→  console.log(chalk.cyan.bold(`${DEFAULT_SUBAGENT_PREFIX} Completed Review Processing`));
   968→  console.log(chalk.cyan(`${"═".repeat(60)}`));
   969→  console.log("");
   970→
   971→  return true;
   972→}
   973→
   974→// ─── Command Registration ────────────────────────────────────────────────────
   975→
   976→export function registerRalphCommand(program: Command): void {
   977→  const ralph = program
   978→    .command("ralph")
   979→    .description("Ralph automated task loop and agent control");
   980→
   981→  // end-loop subcommand - allows agent to signal loop termination
   982→  // AC: @ralph-end-loop ac-cmd, ac-reason, ac-noop-outside
   983→  ralph
   984→    .command("end-loop")
   985→    .description("End the ralph loop gracefully (stops all remaining iterations)")
   986→    .option("--reason <reason>", "Reason for ending the loop")
   987→    .action(async (options) => {
   988→      try {
   989→        const ctx = await initContext();
   990→
   991→        // Check if we're in a ralph session by looking for any ralph marker
   992→        const taskLimitMarker = await readTaskLimitMarker(ctx.rootDir);
   993→        const endLoopMarker = await readEndLoopMarker(ctx.rootDir);
   994→
   995→        // Write the marker with reason if provided
   996→        await writeEndLoopMarker(ctx.rootDir, options.reason);
   997→
   998→        // Determine if we're likely in a ralph session
   999→        const inRalphSession = taskLimitMarker !== null || endLoopMarker !== null;
  1000→
  1001→        if (!inRalphSession) {
  1002→          // AC: @ralph-end-loop ac-noop-outside
  1003→          warn("No active ralph session detected. Marker written but may have no effect.");
  1004→          info("This command is designed to be called by agents during a ralph loop.");
  1005→        } else {
  1006→          success("Loop end signal sent");
  1007→        }
  1008→
  1009→        if (options.reason) {
  1010→          info(`Reason: ${options.reason}`);
  1011→        }
  1012→      } catch (err) {
  1013→        error("Failed to signal end-loop", err);
  1014→        process.exit(EXIT_CODES.ERROR);
  1015→      }
  1016→    });
  1017→
  1018→  // Main ralph run command (default behavior when ralph is called directly)
  1019→  ralph
  1020→    .command("run", { isDefault: true })
  1021→    .description("Run ACP agent in a loop to process ready tasks")
  1022→    .argument("[args...]", "")
  1023→    .option("--max-loops <n>", "Maximum iterations", "5")
  1024→    .option("--max-retries <n>", "Max retries per iteration on error", "3")
  1025→    .option(
  1026→      "--max-failures <n>",
  1027→      "Max consecutive failed iterations before exit",
  1028→      "3",
  1029→    )
  1030→    .option("--dry-run", "Show prompt without executing")
  1031→    .option("--yolo", "Use dangerously-skip-permissions (default)", true)
  1032→    .option("--no-yolo", "Require normal permission prompts")
  1033→    .option("--adapter <id>", "Agent adapter to use", "claude-code-acp")
  1034→    .option("--adapter-cmd <cmd>", "Custom adapter command (for testing)")
  1035→    .option(
  1036→      "--restart-every <n>",
  1037→      "Restart agent every N iterations to prevent OOM (0 = never)",
  1038→      "10",
  1039→    )
  1040→    .option(
  1041→      "--focus <instructions>",
  1042→      "Focus instructions included in every iteration prompt",
  1043→    )
  1044→    .option(
  1045→      "--max-tasks <n>",
  1046→      "Max tasks per iteration (0 = unlimited)",
  1047→      "1",
  1048→    )
  1049→    .option(
  1050→      "--tasks <refs>",
  1051→      "Explicit task scope: only work on these tasks (comma-separated refs, e.g., @task1,@task2)",
  1052→    )
  1053→    .action(async (args: string[], options) => {
  1054→      // Check for unknown subcommands that fell through to default
  1055→      // Only check args that look like subcommand names (alphanumeric with hyphens, no quotes)
  1056→      if (args.length > 0) {
  1057→        const unknownCmd = args[0];
  1058→        // Skip if it looks like a malformed option or quoted argument
  1059→        const looksLikeSubcommand = /^[a-z][a-z0-9-]*$/i.test(unknownCmd);
  1060→        if (looksLikeSubcommand) {
  1061→          if (unknownCmd === "end-iteration") {
  1062→            error(`Unknown command: ${unknownCmd}. Did you mean 'end-loop'?`);
  1063→            info("The command was renamed from 'end-iteration' to 'end-loop' to clarify it ends the entire loop.");
  1064→          } else {
  1065→            error(`Unknown command: ${unknownCmd}`);
  1066→          }
  1067→          info("Run 'kspec ralph --help' to see available commands.");
  1068→          process.exit(EXIT_CODES.USAGE_ERROR);
  1069→        }
  1070→      }
  1071→      try {
  1072→        const maxLoops = parseInt(options.maxLoops, 10);
  1073→        const maxRetries = parseInt(options.maxRetries, 10);
  1074→        const maxFailures = parseInt(options.maxFailures, 10);
  1075→
  1076→        if (Number.isNaN(maxLoops) || maxLoops < 1) {
  1077→          error(errors.usage.maxLoopsPositive);
  1078→          process.exit(EXIT_CODES.ERROR);
  1079→        }
  1080→
  1081→        if (Number.isNaN(maxRetries) || maxRetries < 0) {
  1082→          error(errors.usage.maxRetriesNonNegative);
  1083→          process.exit(EXIT_CODES.ERROR);
  1084→        }
  1085→
  1086→        if (Number.isNaN(maxFailures) || maxFailures < 1) {
  1087→          error(errors.usage.maxFailuresPositive);
  1088→          process.exit(EXIT_CODES.ERROR);
  1089→        }
  1090→
  1091→        const restartEvery = parseInt(options.restartEvery, 10);
  1092→        if (Number.isNaN(restartEvery) || restartEvery < 0) {
  1093→          error("--restart-every must be a non-negative integer");
  1094→          process.exit(EXIT_CODES.ERROR);
  1095→        }
  1096→
  1097→        // AC: @ralph-task-limit ac-flag
  1098→        const maxTasks = parseInt(options.maxTasks, 10);
  1099→        if (Number.isNaN(maxTasks) || maxTasks < 0 || maxTasks > 999) {
  1100→          error("--max-tasks must be 0 (unlimited) or a positive integer up to 999");
  1101→          process.exit(EXIT_CODES.USAGE_ERROR);
  1102→        }
  1103→
  1104→        // Handle custom adapter command for testing
  1105→        if (options.adapterCmd) {
  1106→          const parts = options.adapterCmd.split(/\s+/);
  1107→          const customAdapter: AgentAdapter = {
  1108→            command: parts[0],
  1109→            args: parts.slice(1),
  1110→            description: "Custom adapter via --adapter-cmd",
  1111→          };
  1112→          registerAdapter("custom", customAdapter);
  1113→          options.adapter = "custom";
  1114→        }
  1115→
  1116→        // Resolve adapter
  1117→        const adapter = resolveAdapter(options.adapter);
  1118→
  1119→        // Validate adapter package exists before proceeding
  1120→        // Skip validation for:
  1121→        // - Custom adapters (--adapter-cmd)
  1122→        // - Non-npx adapters
  1123→        // - Dry-run mode with default adapter (doesn't spawn agent, default may not be installed in CI)
  1124→        // Note: If user explicitly specifies --adapter, validate even in dry-run to catch typos
  1125→        const isDefaultAdapter = options.adapter === "claude-code-acp";
  1126→        const skipValidation =
  1127→          options.adapterCmd ||
  1128→          adapter.command !== "npx" ||
  1129→          !adapter.args[0] ||
  1130→          (options.dryRun && isDefaultAdapter);
  1131→
  1132→        if (!skipValidation) {
  1133→          validateAdapter(adapter.args[0]);
  1134→        }
  1135→
  1136→        // Add yolo flag to adapter args if needed
  1137→        if (options.yolo && options.adapter === "claude-code-acp") {
  1138→          adapter.args = [...adapter.args, "--dangerously-skip-permissions"];
  1139→        }
  1140→
  1141→        const restartInfo =
  1142→          restartEvery > 0 ? `, restart every ${restartEvery}` : "";
  1143→        const maxTasksInfo =
  1144→          maxTasks === 0 ? "unlimited" : `${maxTasks}`;
  1145→
  1146→        // Initialize kspec context early to validate --tasks
  1147→        const ctx = await initContext();
  1148→
  1149→        // AC: @cli-ralph ac-21 - Parse explicit task scope
  1150→        let explicitTaskScope: ExplicitTaskScope | undefined;
  1151→        if (options.tasks) {
  1152→          try {
  1153→            explicitTaskScope = await parseExplicitTasks(ctx, options.tasks);
  1154→            info(`Explicit task scope: ${explicitTaskScope.refs.join(", ")}`);
  1155→          } catch (err) {
  1156→            error(`Invalid --tasks argument: ${(err as Error).message}`);
  1157→            process.exit(EXIT_CODES.VALIDATION_FAILED);
  1158→          }
  1159→        }
  1160→
  1161→        const taskScopeInfo = explicitTaskScope
  1162→          ? `, tasks=${explicitTaskScope.refs.join(",")}`
  1163→          : "";
  1164→        info(
  1165→          `Starting ralph loop (adapter=${options.adapter}, max ${maxLoops} iterations, ${maxRetries} retries, ${maxFailures} max failures${restartInfo}, max-tasks=${maxTasksInfo}${taskScopeInfo})`,
  1166→        );
  1167→        if (options.focus) {
  1168→          info(`Focus: ${options.focus}`);
  1169→        }
  1170→        const specDir = ctx.specDir;
  1171→
  1172→        // Create session for event tracking
  1173→        const sessionId = ulid();
  1174→        await createSession(specDir, {
  1175→          id: sessionId,
  1176→          agent_type: options.adapter,
  1177→          task_id: undefined, // Will be determined per iteration
  1178→        });
  1179→
  1180→        // Log session start
  1181→        await appendEvent(specDir, {
  1182→          session_id: sessionId,
  1183→          type: "session.start",
  1184→          data: {
  1185→            adapter: options.adapter,
  1186→            maxLoops,
  1187→            maxRetries,
  1188→            maxFailures,
  1189→            maxTasks,
  1190→            yolo: options.yolo,
  1191→            focus: options.focus,
  1192→            explicitTasks: explicitTaskScope?.refs,
  1193→          },
  1194→        });
  1195→
  1196→        let consecutiveFailures = 0;
  1197→        let agent: SpawnedAgent | null = null;
  1198→        let acpSessionId: string | null = null;
  1199→
  1200→        // AC: @ralph-end-loop ac-signal-cleanup, @ralph-task-limit ac-signal-cleanup
  1201→        // Signal handlers for cleanup on Ctrl+C or kill
  1202→        // Note: Signal handlers must be synchronous, so we use Promise.finally()
  1203→        // to ensure cleanup completes before exit
  1204→        const signalCleanup = (signal: string) => {
  1205→          info(`Received ${signal}, cleaning up...`);
  1206→          // Kill agent if running
  1207→          if (agent) {
  1208→            agent.kill();
  1209→          }
  1210→          // Clean up marker files, then exit after cleanup completes
  1211→          Promise.all([
  1212→            clearTaskLimitMarker(ctx.rootDir),
  1213→            clearEndLoopMarker(ctx.rootDir),
  1214→          ]).finally(() => {
  1215→            process.exit(0);
  1216→          });
  1217→        };
  1218→        const sigintHandler = () => { signalCleanup("SIGINT"); };
  1219→        const sigtermHandler = () => { signalCleanup("SIGTERM"); };
  1220→        process.on("SIGINT", sigintHandler);
  1221→        process.on("SIGTERM", sigtermHandler);
  1222→
  1223→        // Create translator and renderer for this session
  1224→        const translator = createTranslator();
  1225→        const renderer = createCliRenderer();
  1226→
  1227→        // Task limit state - tracks completions per iteration
  1228→        // AC: @ralph-task-limit ac-reset, ac-wrapup
  1229→        let taskLimitReached = false;
  1230→        let tasksCompletedThisIteration = 0;
  1231→
  1232→        // End-loop signal state
  1233→        // AC: @ralph-end-loop ac-detect, ac-graceful
  1234→        let endLoopRequested = false;
  1235→
  1236→        try {
  1237→          for (let iteration = 1; iteration <= maxLoops; iteration++) {
  1238→            renderer.newSection?.(`Iteration ${iteration}/${maxLoops}`);
  1239→
  1240→            // AC: @ralph-task-limit ac-reset - Reset counter and clear stale markers at iteration start
  1241→            taskLimitReached = false;
  1242→            tasksCompletedThisIteration = 0;
  1243→            const wasStale = await clearStaleMarker(ctx.rootDir);
  1244→            if (wasStale) {
  1245→              info("Cleared stale task limit marker from previous session");
  1246→            }
  1247→            // Also clear any marker from previous iteration of this session
  1248→            await clearTaskLimitMarker(ctx.rootDir);
  1249→
  1250→            // AC: @ralph-end-loop ac-cleanup - Reset end-loop state
  1251→            endLoopRequested = false;
  1252→            const wasStaleEndLoop = await clearStaleEndLoopMarker(ctx.rootDir);
  1253→            if (wasStaleEndLoop) {
  1254→              info("Cleared stale end-loop marker from previous session");
  1255→            }
  1256→            await clearEndLoopMarker(ctx.rootDir);
  1257→
  1258→            // Gather fresh context each iteration
  1259→            // AC: @cli-ralph ac-16 - Only automation-eligible tasks (unless explicit scope)
  1260→            // AC: @cli-ralph ac-21 - With explicit task scope, ignore automation eligibility
  1261→            let sessionCtx = await gatherSessionContext(ctx, {
  1262→              limit: "10",
  1263→              eligible: !explicitTaskScope, // Skip eligibility filter if explicit scope
  1264→            });
  1265→
  1266→            // AC: @cli-ralph ac-21 - Filter to explicit tasks if scope is set
  1267→            if (explicitTaskScope) {
  1268→              sessionCtx = filterByExplicitTasks(sessionCtx, explicitTaskScope);
  1269→            }
  1270→
  1271→            // AC: @ralph-subagent-spawning ac-8 - Process pending_review tasks BEFORE main iteration
  1272→            // This wraps consecutiveFailures in an object so it can be mutated by the helper
  1273→            const failureTracker = { count: consecutiveFailures };
  1274→            const continueLoop = await processPendingReviewTasks(
  1275→              ctx,
  1276→              adapter,
  1277→              sessionCtx.pending_review_tasks,
  1278→              {
  1279→                yolo: options.yolo,
  1280→                maxRetries,
  1281→                maxFailures,
  1282→                cwd: process.cwd(),
  1283→              },
  1284→              failureTracker,
  1285→            );
  1286→            consecutiveFailures = failureTracker.count;
  1287→
  1288→            if (!continueLoop) {
  1289→              break;
  1290→            }
  1291→
  1292→            // AC: @cli-ralph ac-20 - Refresh context after pending_review processing
  1293→            // If pending_review tasks were processed, they may have completed and unblocked
  1294→            // dependent tasks. Re-gather context to detect newly available tasks.
  1295→            let currentCtx = sessionCtx;
  1296→            if (sessionCtx.pending_review_tasks.length > 0) {
  1297→              currentCtx = await gatherSessionContext(ctx, {
  1298→                limit: "10",
  1299→                eligible: !explicitTaskScope,
  1300→              });
  1301→              if (explicitTaskScope) {
  1302→                currentCtx = filterByExplicitTasks(currentCtx, explicitTaskScope);
  1303→              }
  1304→            }
  1305→
  1306→            // AC: @cli-ralph ac-21 - Check explicit task completion
  1307→            if (explicitTaskScope) {
  1308→              const { done, statuses } = await allExplicitTasksDone(ctx, explicitTaskScope);
  1309→              if (done) {
  1310→                const statusList = Array.from(statuses.entries())
  1311→                  .map(([ref, status]) => `${ref}: ${status}`)
  1312→                  .join(", ");
  1313→                info(`All explicit tasks completed or blocked (${statusList}). Exiting loop.`);
  1314→                break;
  1315→              }
  1316→            }
  1317→
  1318→            // Check for automation-eligible tasks (ready or in_progress)
  1319→            // AC: @cli-ralph ac-19
  1320→            const hasActiveTasks = currentCtx.active_tasks.length > 0;
  1321→            const hasReadyTasks = currentCtx.ready_tasks.length > 0;
  1322→
  1323→            if (!hasActiveTasks && !hasReadyTasks) {
  1324→              if (explicitTaskScope) {
  1325→                info("No explicit tasks available (ready or in_progress). Exiting loop.");
  1326→              } else {
  1327→                info("No automation-eligible tasks (ready or in_progress). Exiting loop.");
  1328→              }
  1329→              break;
  1330→            }
  1331→
  1332→            // AC: @loop-mode-error-handling - Track tasks in progress for failure handling
  1333→            const tasksInProgressAtStart = sessionCtx.active_tasks;
  1334→            const iterationStartTime = new Date();
  1335→
  1336→            // Build prompts - task-work first, then reflect
  1337→            // AC: @cli-ralph ac-21 - Include explicit task scope in prompt
  1338→            const taskWorkPrompt = buildTaskWorkPrompt(
  1339→              currentCtx,
  1340→              iteration,
  1341→              maxLoops,
  1342→              sessionId,
  1343→              options.focus,
  1344→              explicitTaskScope,
  1345→            );
  1346→            const reflectPrompt = buildReflectPrompt(
  1347→              iteration,
  1348→              maxLoops,
  1349→              sessionId,
  1350→            );
  1351→
  1352→            // AC: @ralph-task-limit ac-dryrun, @cli-ralph ac-21
  1353→            if (options.dryRun) {
  1354→              console.log(
  1355→                chalk.yellow("=== DRY RUN - Configuration ===\n"),
  1356→              );
  1357→              console.log(`  max-loops: ${maxLoops}`);
  1358→              console.log(`  max-tasks: ${maxTasks === 0 ? "unlimited" : maxTasks}`);
  1359→              console.log(`  max-retries: ${maxRetries}`);
  1360→              console.log(`  max-failures: ${maxFailures}`);
  1361→              console.log(`  restart-every: ${restartEvery === 0 ? "never" : restartEvery}`);
  1362→              if (explicitTaskScope) {
  1363→                console.log(`  explicit-tasks: ${explicitTaskScope.refs.join(", ")}`);
  1364→              }
  1365→              console.log(
  1366→                chalk.yellow("\n=== Task Work Prompt ===\n"),
  1367→              );
  1368→              console.log(taskWorkPrompt);
  1369→              console.log(chalk.yellow("\n=== Reflect Prompt ===\n"));
  1370→              console.log(reflectPrompt);
  1371→              console.log(chalk.yellow("\n=== END DRY RUN ==="));
  1372→              break;
  1373→            }
  1374→
  1375→            // Log task-work prompt
  1376→            await appendEvent(specDir, {
  1377→              session_id: sessionId,
  1378→              type: "prompt.sent",
  1379→              data: {
  1380→                iteration,
  1381→                phase: "task-work",
  1382→                prompt: taskWorkPrompt,
  1383→                tasks: {
  1384→                  active: currentCtx.active_tasks.map((t) => t.ref),
  1385→                  ready: currentCtx.ready_tasks.map((t) => t.ref),
  1386→                },
  1387→              },
  1388→            });
  1389→
  1390→            // Retry loop for this iteration
  1391→            let lastError: Error | null = null;
  1392→            let succeeded = false;
  1393→
  1394→            for (let attempt = 1; attempt <= maxRetries + 1; attempt++) {
  1395→              if (attempt > 1) {
  1396→                console.log(
  1397→                  chalk.yellow(
  1398→                    `\nRetry attempt ${attempt - 1}/${maxRetries}...`,
  1399→                  ),
  1400→                );
  1401→              }
  1402→
  1403→              try {
  1404→                // Spawn agent if not already running
  1405→                if (!agent) {
  1406→                  info("Spawning ACP agent...");
  1407→                  agent = await spawnAndInitialize(adapter, {
  1408→                    cwd: process.cwd(),
  1409→                    clientOptions: {
  1410→                      clientInfo: {
  1411→                        name: "kspec-ralph",
  1412→                        version: packageVersion,
  1413→                      },
  1414→                      methodTimeouts: {
  1415→                        "session/prompt": RALPH_PROMPT_TIMEOUT,
  1416→                        "session/resume": RALPH_PROMPT_TIMEOUT,
  1417→                      },
  1418→                    },
  1419→                  });
  1420→
  1421→                  // Set up streaming update handler with translator + renderer
  1422→                  agent.client.on(
  1423→                    "update",
  1424→                    (_sid: string, update: SessionUpdate) => {
  1425→                      // Translate ACP event to RalphEvent and render
  1426→                      const event = translator.translate(update);
  1427→                      if (event) {
  1428→                        renderer.render(event);
  1429→                      }
  1430→
  1431→                      // AC: @ralph-task-limit ac-detection, ac-wrapup
  1432→                      // Detect task completions for limit enforcement
  1433→                      if (maxTasks > 0 && !taskLimitReached) {
  1434→                        const bashCmd = extractBashCommand(update);
  1435→                        if (bashCmd && detectTaskCompleteCommand(bashCmd)) {
  1436→                          // Pattern matched - verify via kspec query
  1437→                          getIterationStats(ctx, iterationStartTime)
  1438→                            .then(async (stats) => {
  1439→                              if (stats.tasks_completed >= maxTasks && !taskLimitReached) {
  1440→                                taskLimitReached = true;
  1441→                                tasksCompletedThisIteration = stats.tasks_completed;
  1442→                                info(`Task limit reached (${stats.tasks_completed}/${maxTasks})`);
  1443→
  1444→                                // AC: @ralph-task-limit ac-marker-format, ac-wrapup
  1445→                                // Write marker file for hook enforcement
  1446→                                const marker: TaskLimitMarker = {
  1447→                                  active: true,
  1448→                                  since: iterationStartTime.toISOString(),
  1449→                                  max: maxTasks,
  1450→                                  completed: stats.tasks_completed,
  1451→                                  sessionId,
  1452→                                };
  1453→                                await writeTaskLimitMarker(ctx.rootDir, marker);
  1454→
  1455→                                // Inject wrap-up message to agent
  1456→                                if (agent && acpSessionId) {
  1457→                                  const wrapUpMsg = `\n\n**TASK LIMIT REACHED** - ${stats.tasks_completed} task(s) completed this iteration (limit: ${maxTasks}).\n\nPlease wrap up your current work and exit cleanly. Do not start new tasks.\n\nCompleted tasks this iteration: ${stats.completed_refs.join(", ")}`;
  1458→                                  agent.client.prompt({
  1459→                                    sessionId: acpSessionId,
  1460→                                    prompt: [{ type: "text", text: wrapUpMsg }],
  1461→                                  }).catch(() => {
  1462→                                    // Ignore if message injection fails
  1463→                                  });
  1464→                                }
  1465→                              }
  1466→                            })
  1467→                            .catch(() => {
  1468→                              // Ignore query failures - detection is best-effort
  1469→                            });
  1470→                        }
  1471→                      }
  1472→
  1473→                      // AC: @ralph-end-loop ac-detect
  1474→                      // Detect explicit end-loop command
  1475→                      if (!endLoopRequested) {
  1476→                        const bashCmd = extractBashCommand(update);
  1477→                        if (bashCmd && detectEndLoopCommand(bashCmd)) {
  1478→                          endLoopRequested = true;
  1479→                          // Read marker to get reason if present
  1480→                          readEndLoopMarker(ctx.rootDir)
  1481→                            .then((marker) => {
  1482→                              const reason = marker?.reason
  1483→                                ? ` (${marker.reason})`
  1484→                                : "";
  1485→                              info(`End-loop signal received${reason}`);
  1486→                            })
  1487→                            .catch(() => {
  1488→                              info("End-loop signal received");
  1489→                            });
  1490→                        }
  1491→                      }
  1492→
  1493→                      // Log raw update event (async, non-blocking)
  1494→                      appendEvent(specDir, {
  1495→                        session_id: sessionId,
  1496→                        type: "session.update",
  1497→                        data: { iteration, update },
  1498→                      }).catch(() => {
  1499→                        // Ignore logging errors during streaming
  1500→                      });
  1501→                    },
  1502→                  );
  1503→
  1504→                  // Set up tool request handler
  1505→                  agent.client.on(
  1506→                    "request",
  1507→                    (
  1508→                      reqId: string | number,
  1509→                      method: string,
  1510→                      params: unknown,
  1511→                    ) => {
  1512→                      // biome-ignore lint/style/noNonNullAssertion: agent is guaranteed to exist when callback is registered
  1513→                      handleRequest(
  1514→                        agent!.client,
  1515→                        reqId,
  1516→                        method,
  1517→                        params,
  1518→                        options.yolo,
  1519→                      ).catch((err) => {
  1520→                        // biome-ignore lint/style/noNonNullAssertion: agent is guaranteed to exist when callback is registered
  1521→                        agent!.client.respondError(reqId, -32000, err.message);
  1522→                      });
  1523→                    },
  1524→                  );
  1525→                }
  1526→
  1527→                // Create fresh ACP session per iteration to keep context clean
  1528→                info("Creating ACP session...");
  1529→                acpSessionId = await agent.client.newSession({
  1530→                  cwd: process.cwd(),
  1531→                  mcpServers: [], // No MCP servers for now
  1532→                });
  1533→
  1534→                // Phase 1: Task Work
  1535→                info("Sending task-work prompt to agent...");
  1536→                const taskWorkResponse = await agent.client.prompt({
  1537→                  sessionId: acpSessionId!,
  1538→                  prompt: [{ type: "text", text: taskWorkPrompt }],
  1539→                });
  1540→
  1541→                // Log task-work completion
  1542→                await appendEvent(specDir, {
  1543→                  session_id: sessionId,
  1544→                  type: "session.update",
  1545→                  data: {
  1546→                    iteration,
  1547→                    phase: "task-work",
  1548→                    stopReason: taskWorkResponse.stopReason,
  1549→                    completed: true,
  1550→                  },
  1551→                });
  1552→
  1553→                if (taskWorkResponse.stopReason === "cancelled") {
  1554→                  throw new Error(errors.usage.agentPromptCancelled);
  1555→                }
  1556→
  1557→                // Phase 2: Reflect (always sent after task-work completes)
  1558→                info("Sending reflect prompt to agent...");
  1559→                await appendEvent(specDir, {
  1560→                  session_id: sessionId,
  1561→                  type: "prompt.sent",
  1562→                  data: {
  1563→                    iteration,
  1564→                    phase: "reflect",
  1565→                    prompt: reflectPrompt,
  1566→                  },
  1567→                });
  1568→
  1569→                const reflectResponse = await agent.client.prompt({
  1570→                  sessionId: acpSessionId!,
  1571→                  prompt: [{ type: "text", text: reflectPrompt }],
  1572→                });
  1573→
  1574→                // Log reflect completion
  1575→                await appendEvent(specDir, {
  1576→                  session_id: sessionId,
  1577→                  type: "session.update",
  1578→                  data: {
  1579→                    iteration,
  1580→                    phase: "reflect",
  1581→                    stopReason: reflectResponse.stopReason,
  1582→                    completed: true,
  1583→                  },
  1584→                });
  1585→
  1586→                if (reflectResponse.stopReason === "cancelled") {
  1587→                  throw new Error(errors.usage.agentPromptCancelled);
  1588→                }
  1589→
  1590→                succeeded = true;
  1591→                break;
  1592→              } catch (err) {
  1593→                lastError = err as Error;
  1594→                error(errors.failures.iterationFailed(lastError.message));
  1595→
  1596→                // Clean up agent on error - will respawn next attempt
  1597→                if (agent) {
  1598→                  agent.kill();
  1599→                  agent = null;
  1600→                  acpSessionId = null;
  1601→                }
  1602→              }
  1603→            }
  1604→
  1605→            if (succeeded) {
  1606→              console.log(); // Newline after streaming output
  1607→
  1608→              // Save session context snapshot for audit trail
  1609→              await saveSessionContext(
  1610→                specDir,
  1611→                sessionId,
  1612→                iteration,
  1613→                sessionCtx,
  1614→              );
  1615→
  1616→              success(`Completed iteration ${iteration}`);
  1617→              consecutiveFailures = 0;
  1618→
  1619→              // AC: @ralph-end-loop ac-graceful - Check for end-loop signal
  1620→              if (endLoopRequested) {
  1621→                info("Agent requested end of loop. Exiting gracefully.");
  1622→                break;
  1623→              }
  1624→
  1625→              // Periodic agent restart to prevent OOM
  1626→              // AC: @cli-ralph ac-restart-periodic
  1627→              if (
  1628→                restartEvery > 0 &&
  1629→                iteration % restartEvery === 0 &&
  1630→                iteration < maxLoops
  1631→              ) {
  1632→                info(
  1633→                  `Restarting agent to prevent memory buildup (every ${restartEvery} iterations)...`,
  1634→                );
  1635→                if (agent) {
  1636→                  agent.kill();
  1637→                  agent = null;
  1638→                  acpSessionId = null;
  1639→                }
  1640→              }
  1641→            } else {
  1642→              consecutiveFailures++;
  1643→              error(
  1644→                errors.failures.iterationFailedAfterRetries(
  1645→                  iteration,
  1646→                  maxRetries,
  1647→                  consecutiveFailures,
  1648→                  maxFailures,
  1649→                ),
  1650→              );
  1651→              if (lastError) {
  1652→                error(errors.failures.lastError(lastError.message));
  1653→              }
  1654→
  1655→              // AC: @loop-mode-error-handling - Track per-task failures
  1656→              const errorDesc = lastError?.message || "Iteration failed after retries";
  1657→              await handleIterationFailure(
  1658→                ctx,
  1659→                tasksInProgressAtStart,
  1660→                iterationStartTime,
  1661→                errorDesc,
  1662→              );
  1663→
  1664→              if (consecutiveFailures >= maxFailures) {
  1665→                error(errors.failures.reachedMaxFailures(maxFailures));
  1666→                break;
  1667→              }
  1668→
  1669→              info("Continuing to next iteration...");
  1670→            }
  1671→          }
  1672→        } finally {
  1673→          // Remove signal handlers to avoid double cleanup
  1674→          process.off("SIGINT", sigintHandler);
  1675→          process.off("SIGTERM", sigtermHandler);
  1676→
  1677→          // Clean up agent
  1678→          if (agent) {
  1679→            agent.kill();
  1680→          }
  1681→
  1682→          // AC: @ralph-task-limit ac-reset - Clear marker file when session ends
  1683→          await clearTaskLimitMarker(ctx.rootDir);
  1684→
  1685→          // AC: @ralph-end-loop ac-cleanup - Clear end-loop marker when session ends
  1686→          await clearEndLoopMarker(ctx.rootDir);
  1687→
  1688→          // Log session end
  1689→          const status =
  1690→            consecutiveFailures >= maxFailures ? "abandoned" : "completed";
  1691→          await appendEvent(specDir, {
  1692→            session_id: sessionId,
  1693→            type: "session.end",
  1694→            data: {
  1695→              status,
  1696→              consecutiveFailures,
  1697→            },
  1698→          });
  1699→          await updateSessionStatus(specDir, sessionId, status);
  1700→        }
  1701→
  1702→        console.log(chalk.green(`\n${"─".repeat(60)}`));
  1703→        success("Ralph loop completed");
  1704→        console.log(chalk.green(`${"─".repeat(60)}\n`));
  1705→      } catch (err) {
  1706→        error(errors.failures.ralphLoop, err);
  1707→        process.exit(EXIT_CODES.ERROR);
  1708→      }
  1709→    });
  1710→}
  1711→

