    40→
    41→/**
    42→ * Format a spec item for display
    43→ */
    44→function formatItem(
    45→  item: LoadedSpecItem,
    46→  verbose = false,
    47→  grepPattern?: string,
    48→): string {
    49→  const shortId = item._ulid.slice(0, 8);
    50→  const slugStr = item.slugs.length > 0 ? chalk.cyan(`@${item.slugs[0]}`) : "";
    51→  const typeStr = chalk.gray(`[${item.type}]`);
    52→
    53→  let status = "";
    54→  if (item.status && typeof item.status === "object") {
    55→    const s = item.status as { maturity?: string; implementation?: string };
    56→    if (s.implementation) {
    57→      const implColor =
    58→        s.implementation === "verified"
    59→          ? chalk.green
    60→          : s.implementation === "implemented"
    61→            ? chalk.cyan
    62→            : s.implementation === "in_progress"
    63→              ? chalk.yellow
    64→              : chalk.gray;
    65→      status = implColor(s.implementation);
    66→    } else if (s.maturity) {
    67→      status = chalk.gray(s.maturity);
    68→    }
    69→  }
    70→
    71→  let line = `${chalk.gray(shortId)} ${typeStr} ${item.title}`;
    72→  if (slugStr) line += ` ${slugStr}`;
    73→  if (status) line += ` ${status}`;
    74→
    75→  if (verbose) {
    76→    const tags = "tags" in item && Array.isArray(item.tags) ? item.tags : [];
    77→    if (tags.length > 0) {
    78→      line += chalk.blue(` #${tags.join(" #")}`);
    79→    }
    80→  }
    81→
    82→  // Show matched fields if grep pattern provided
    83→  if (grepPattern) {
    84→    const match = grepItem(
    85→      item as unknown as Record<string, unknown>,
    86→      grepPattern,
    87→    );
    88→    if (match && match.matchedFields.length > 0) {
    89→      line +=
    90→        "\n  " +
    91→        chalk.gray(`matched: ${formatMatchedFields(match.matchedFields)}`);
    92→    }
    93→  }
    94→
    95→  return line;
    96→}
    97→
    98→/**
    99→ * Format item list for display
   100→ */
   101→function formatItemList(
   102→  items: LoadedSpecItem[],
   103→  verbose = false,
   104→  grepPattern?: string,
   105→): void {
   106→  if (items.length === 0) {
   107→    console.log(chalk.gray("No items found"));
   108→    return;
   109→  }
   110→
   111→  for (const item of items) {
   112→    console.log(formatItem(item, verbose, grepPattern));
   113→  }
   114→
   115→  console.log(chalk.gray(`\n${items.length} item(s)`));
   116→}
   117→
   118→/**
   119→ * Format item list as a tree showing parent/child hierarchy
   120→ */
   121→function formatItemTree(
   122→  items: LoadedSpecItem[],
   123→  verbose = false,
   124→  grepPattern?: string,
   125→): void {
   126→  if (items.length === 0) {
   127→    console.log(chalk.gray("No items found"));
   128→    return;
   129→  }
   130→
   131→  // Build parent-child map
   132→  const childrenMap = new Map<string, LoadedSpecItem[]>();
   133→  const rootItems: LoadedSpecItem[] = [];
   134→
   135→  for (const item of items) {
   136→    const path = item._path || "";
   137→
   138→    // Determine parent path
   139→    let parentPath = "";
   140→    if (path) {
   141→      // Extract parent path from current path
   142→      // e.g., "features[0].requirements[1]" -> "features[0]"
   143→      const lastDotIndex = path.lastIndexOf(".");
   144→      if (lastDotIndex !== -1) {
   145→        parentPath = path.substring(0, lastDotIndex);
   146→      }
   147→    }
   148→
   149→    if (parentPath === "") {
   150→      // Root level item
   151→      rootItems.push(item);
   152→    } else {
   153→      // Find parent by path
   154→      const parent = items.find((i) => i._path === parentPath);
   155→      if (parent) {
   156→        const parentUlid = parent._ulid;
   157→        if (!childrenMap.has(parentUlid)) {
   158→          childrenMap.set(parentUlid, []);
   159→        }
   160→        childrenMap.get(parentUlid)?.push(item);
   161→      } else {
   162→        // Parent not in filtered list, show at root
   163→        rootItems.push(item);
   164→      }
   165→    }
   166→  }
   167→
   168→  // Recursive function to print tree
   169→  function printTree(item: LoadedSpecItem, prefix = "", isLast = true): void {
   170→    // Print current item with tree prefix
   171→    const connector = isLast ? "└── " : "├── ";
   172→    const itemLine = formatItem(item, verbose, grepPattern);
   173→    console.log(prefix + connector + itemLine);
   174→
   175→    // Print children
   176→    const children = childrenMap.get(item._ulid) || [];
   177→    const childPrefix = prefix + (isLast ? "    " : "│   ");
   178→
   179→    children.forEach((child, index) => {
   180→      const isLastChild = index === children.length - 1;
   181→      printTree(child, childPrefix, isLastChild);
   182→    });
   183→  }
   184→
   185→  // Print all root items
   186→  rootItems.forEach((item, index) => {
   187→    const isLast = index === rootItems.length - 1;
   188→    printTree(item, "", isLast);
   189→  });
   190→
   191→  console.log(chalk.gray(`\n${items.length} item(s)`));
   192→}
   193→
   194→/**
   195→ * Handle cascading status updates to child items
   196→ * Returns array of updated child items
   197→ */
   198→async function handleStatusCascade(
   199→  ctx: Awaited<ReturnType<typeof initContext>>,
   200→  parent: LoadedSpecItem,
   201→  newStatus: string,
   202→  allItems: LoadedSpecItem[],
   203→  refIndex: ReferenceIndex,
   204→): Promise<LoadedSpecItem[]> {
   205→  // Find direct children
   206→  const children = findChildItems(parent, allItems);
   207→
   208→  if (children.length === 0) {
   209→    return [];
   210→  }
   211→
   212→  // Skip prompt in JSON mode
   213→  if (isJsonMode()) {
   214→    return [];
   215→  }
   216→
   217→  // Prompt user for cascade
   218→  const readline = await import("node:readline");
   219→  const rl = readline.createInterface({
   220→    input: process.stdin,
   221→    output: process.stdout,
   222→  });
   223→
   224→  const answer = await new Promise<string>((resolve) => {
   225→    rl.question(
   226→      `Update ${children.length} child item(s) to ${newStatus}? [y/n] `,
   227→      resolve,
   228→    );
   229→  });
   230→  rl.close();
   231→
   232→  if (answer.toLowerCase() !== "y") {
   233→    return [];
   234→  }
   235→
   236→  // Update children
   237→  const updatedChildren: LoadedSpecItem[] = [];
   238→  for (const child of children) {
   239→    const currentStatus =
   240→      child.status && typeof child.status === "object"
   241→        ? child.status
   242→        : {
   243→            maturity: "draft" as const,
   244→            implementation: "not_started" as const,
   245→          };
   246→
   247→    const updates = {
   248→      status: {
   249→        maturity: currentStatus.maturity || ("draft" as const),
   250→        implementation: newStatus as ImplementationStatus,
   251→      },
   252→    };
   253→
   254→    const updated = await updateSpecItem(ctx, child, updates);
   255→    updatedChildren.push(updated);
   256→
   257→    // Log each child update (non-JSON mode only)
   258→    const childRef = child.slugs[0] || refIndex.shortUlid(child._ulid);
   259→    console.log(chalk.gray(`  ✓ Updated @${childRef}`));
   260→  }
   261→
   262→  return updatedChildren;
   263→}
   264→
   265→/**
   266→ * Register item commands
   267→ */
   268→export function registerItemCommands(program: Command): void {
   269→  const item = program.command("item").description("Spec item commands");
   270→
   271→  // kspec item list
   272→  item
   273→    .command("list")
   274→    .description("List spec items with optional filters")
   275→    .option(
   276→      "-t, --type <type>",
   277→      "Filter by item type (module, feature, requirement, constraint, decision)",
   278→    )
   279→    .option(
   280→      "-s, --status <status>",
   281→      "Filter by implementation status (not_started, in_progress, implemented, verified)",
   282→    )
   283→    .option(
   284→      "-m, --maturity <maturity>",
   285→      "Filter by maturity (draft, proposed, stable, deferred, deprecated)",
   286→    )
   287→    .option(
   288→      "--tag <tag>",
   289→      "Filter by tag (can specify multiple)",
   290→      (val, prev: string[]) => [...prev, val],
   291→      [],
   292→    )
   293→    .option(
   294→      "--has <field>",
   295→      "Filter items that have field present",
   296→      (val, prev: string[]) => [...prev, val],
   297→      [],
   298→    )
   299→    .option("-q, --search <text>", "Search in title")
   300→    .option("-g, --grep <pattern>", "Search content with regex pattern")
   301→    .option("-v, --verbose", "Show more details")
   302→    .option("--tree", "Show parent/child hierarchy")
   303→    .option("--limit <n>", "Limit results", "50")
   304→    .option("--count", "Show only the count of matching items")
   305→    .action(async (options) => {
   306→      try {
   307→        const ctx = await initContext();
   308→        const { itemIndex, items } = await buildIndexes(ctx);
   309→
   310→        // Build filter from options
   311→        const filter: ItemFilter = {
   312→          specItemsOnly: true, // Only spec items, not tasks
   313→        };
   314→
   315→        if (options.type) {
   316→          filter.type = options.type as ItemType;
   317→        }
   318→
   319→        // AC: @multi-value-status-filter ac-item-list-parity, ac-invalid-item-status
   320→        if (options.status) {
   321→          const { parseMultiStatus } = await import("./tasks.js");
   322→          const { ImplementationStatusSchema } = await import("../../schema/common.js");
   323→          const statuses = parseMultiStatus(
   324→            options.status,
   325→            ImplementationStatusSchema.options,
   326→            "implementation status",
   327→          );
   328→          if (statuses) {
   329→            filter.implementation = statuses.length === 1 ? statuses[0] : statuses;
   330→          }
   331→        }
   332→
   333→        if (options.maturity) {
   334→          filter.maturity = options.maturity as Maturity;
   335→        }
   336→
   337→        if (options.tag && options.tag.length > 0) {
   338→          filter.tags = parseTagsArray(options.tag);
   339→        }
   340→
   341→        if (options.has && options.has.length > 0) {
   342→          filter.hasFields = options.has;
   343→        }
   344→
   345→        if (options.search) {
   346→          filter.titleContains = options.search;
   347→        }
   348→
   349→        if (options.grep) {
   350→          filter.grepSearch = options.grep;
   351→        }
   352→
   353→        const limit = parseInt(options.limit, 10) || 50;
   354→        const result = itemIndex.queryPaginated(filter, 0, limit);
   355→
   356→        // Filter to only LoadedSpecItem (not tasks)
   357→        const specItems = result.items.filter(
   358→          (item): item is LoadedSpecItem =>
   359→            !("status" in item && typeof item.status === "string"),
   360→        );
   361→
   362→        // AC: @trait-filterable-list ac-8
   363→        if (options.count) {
   364→          output({ count: result.total }, () => {
   365→            console.log(result.total);
   366→          });
   367→          return;
   368→        }
   369→
   370→        output(
   371→          {
   372→            items: specItems,
   373→            total: result.total,
   374→            showing: specItems.length,
   375→            grepPattern: options.grep,
   376→            tree: options.tree,
   377→          },
   378→          () => {
   379→            if (options.tree) {
   380→              formatItemTree(specItems, options.verbose, options.grep);
   381→            } else {
   382→              formatItemList(specItems, options.verbose, options.grep);
   383→            }
   384→          },
   385→        );
   386→      } catch (err) {
   387→        error(errors.failures.listItems, err);
   388→        process.exit(EXIT_CODES.ERROR);
   389→      }
   390→    });
   391→
   392→  // kspec item get <ref>
   393→  item
   394→    .command("get <ref>")
   395→    .description("Get details for a specific item")
   396→    .action(async (ref) => {
   397→      try {
   398→        const ctx = await initContext();
   399→        const { refIndex, traitIndex, items } = await buildIndexes(ctx);
   400→
   401→        const result = refIndex.resolve(ref);
   402→
   403→        if (!result.ok) {
   404→          error(errors.reference.itemNotFound(ref));
   405→          process.exit(EXIT_CODES.ERROR);
   406→        }
   407→
   408→        const item = result.item as LoadedSpecItem;
   409→
   410→        // AC: @trait-display ac-2 - JSON mode includes inherited_traits array
   411→        const inheritedTraits = traitIndex.getInheritedAC(item._ulid);
   412→        const traitsByTrait = new Map<
   413→          string,
   414→          {
   415→            trait: (typeof inheritedTraits)[0]["trait"];
   416→            acs: AcceptanceCriterion[];
   417→          }
   418→        >();
   419→        for (const { trait, ac } of inheritedTraits) {
   420→          if (!traitsByTrait.has(trait.ulid)) {
   421→            traitsByTrait.set(trait.ulid, { trait, acs: [] });
   422→          }
   423→          traitsByTrait.get(trait.ulid)?.acs.push(ac);
   424→        }
   425→
   426→        // Build JSON output with inherited traits
   427→        const jsonOutput = {
   428→          ...item,
   429→          inherited_traits: Array.from(traitsByTrait.values()).map(
   430→            ({ trait, acs }) => ({
   431→              ref: `@${trait.slug}`,
   432→              title: trait.title,
   433→              acceptance_criteria: acs,
   434→            }),
   435→          ),
   436→        };
   437→
   438→        output(jsonOutput, () => {
   439→          console.log(chalk.bold(item.title));
   440→          console.log(chalk.gray("─".repeat(40)));
   441→          console.log(`${fieldLabels.ulid}      ${item._ulid}`);
   442→          if (item.slugs.length > 0) {
   443→            console.log(`${fieldLabels.slugs}     ${item.slugs.join(", ")}`);
   444→          }
   445→          console.log(`${fieldLabels.type}      ${item.type}`);
   446→
   447→          if (item.status && typeof item.status === "object") {
   448→            const s = item.status as {
   449→              maturity?: string;
   450→              implementation?: string;
   451→            };
   452→            if (s.maturity)
   453→              console.log(`${fieldLabels.maturity}  ${s.maturity}`);
   454→            if (s.implementation) {
   455→              // AC: @trait-retrospective ac-4
   456→              // Show retrospective verification source
   457→              const isRetrospective = item.traits?.includes(
   458→                "@trait-retrospective",
   459→              );
   460→              const statusLabel = isRetrospective
   461→                ? `${s.implementation} (retrospective)`
   462→                : s.implementation;
   463→              console.log(`${fieldLabels.implementation}${statusLabel}`);
   464→            }
   465→          }
   466→
   467→          // AC: @trait-retrospective ac-4
   468→          // Show verification metadata for retrospective specs
   469→          const isRetrospective = item.traits?.includes("@trait-retrospective");
   470→          if (isRetrospective && (item.verified_at || item.verified_by)) {
   471→            const verifiedDate = item.verified_at
   472→              ? new Date(item.verified_at).toISOString().split("T")[0]
   473→              : "unknown";
   474→            const verifiedBy = item.verified_by || "unknown";
   475→            console.log(`Verified:   ${verifiedDate} by ${verifiedBy}`);
   476→          }
   477→
   478→          if (
   479→            "tags" in item &&
   480→            Array.isArray(item.tags) &&
   481→            item.tags.length > 0
   482→          ) {
   483→            console.log(`${fieldLabels.tags}      ${item.tags.join(", ")}`);
   484→          }
   485→
   486→          // AC: @item-get ac-4
   487→          if (Array.isArray(item.depends_on) && item.depends_on.length > 0) {
   488→            console.log(`${fieldLabels.dependsOn} ${item.depends_on.join(", ")}`);
   489→          }
   490→          if (Array.isArray(item.implements) && item.implements.length > 0) {
   491→            console.log(`${fieldLabels.implements} ${item.implements.join(", ")}`);
   492→          }
   493→          if (Array.isArray(item.relates_to) && item.relates_to.length > 0) {
   494→            console.log(`${fieldLabels.relatesTo} ${item.relates_to.join(", ")}`);
   495→          }
   496→
   497→          if (item.description) {
   498→            console.log(`\n${sectionHeaders.description}`);
   499→            console.log(item.description);
   500→          }
   501→
   502→          // AC: @trait-display ac-1 - Show own AC first
   503→          if (
   504→            "acceptance_criteria" in item &&
   505→            Array.isArray(item.acceptance_criteria) &&
   506→            item.acceptance_criteria.length > 0
   507→          ) {
   508→            console.log(`\n${sectionHeaders.acceptanceCriteria}`);
   509→            for (const ac of item.acceptance_criteria) {
   510→              if (ac && typeof ac === "object" && "id" in ac) {
   511→                const acObj = ac as AcceptanceCriterion;
   512→                console.log(chalk.cyan(`  [${acObj.id}]`));
   513→                if (acObj.given) console.log(`    Given: ${acObj.given}`);
   514→                if (acObj.when) console.log(`    When: ${acObj.when}`);
   515→                if (acObj.then) console.log(`    Then: ${acObj.then}`);
   516→              }
   517→            }
   518→          }
   519→
   520→          // AC: @trait-display ac-1, ac-4, ac-5 - Show inherited AC per trait in labeled sections
   521→          if (traitsByTrait.size > 0) {
   522→            for (const { trait, acs } of traitsByTrait.values()) {
   523→              console.log(
   524→                chalk.gray(`\n─── Inherited from @${trait.slug} ───`),
   525→              );
   526→              for (const ac of acs) {
   527→                console.log(
   528→                  chalk.cyan(`  [${ac.id}]`) +
   529→                    chalk.gray(` (from @${trait.slug})`),
   530→                );
   531→                if (ac.given) console.log(`    Given: ${ac.given}`);
   532→                if (ac.when) console.log(`    When: ${ac.when}`);
   533→                if (ac.then) console.log(`    Then: ${ac.then}`);
   534→              }
   535→            }
   536→          }
   537→        });
   538→      } catch (err) {
   539→        error(errors.failures.getItem, err);
   540→        process.exit(EXIT_CODES.ERROR);
   541→      }
   542→    });
   543→
   544→  // kspec item types - show available types and counts
   545→  item
   546→    .command("types")
   547→    .description("Show item types and counts")
   548→    .action(async () => {
   549→      try {
   550→        const ctx = await initContext();
   551→        const { itemIndex } = await buildIndexes(ctx);
   552→
   553→        const typeCounts = itemIndex.getTypeCounts();
   554→
   555→        output(Object.fromEntries(typeCounts), () => {
   556→          console.log(chalk.bold("Item Types"));
   557→          console.log(chalk.gray("─".repeat(30)));
   558→          for (const [type, count] of typeCounts) {
   559→            console.log(`  ${type}: ${count}`);
   560→          }
   561→          console.log(chalk.gray(`\nTotal: ${itemIndex.size} items`));
   562→        });
   563→      } catch (err) {
   564→        error(errors.failures.getTypes, err);
   565→        process.exit(EXIT_CODES.ERROR);
   566→      }
   567→    });
   568→
   569→  // kspec item tags - show available tags and counts
   570→  item
   571→    .command("tags")
   572→    .description("Show tags and counts")
   573→    .action(async () => {
   574→      try {
   575→        const ctx = await initContext();
   576→        const { itemIndex } = await buildIndexes(ctx);
   577→
   578→        const tagCounts = itemIndex.getTagCounts();
   579→
   580→        output(Object.fromEntries(tagCounts), () => {
   581→          console.log(chalk.bold("Tags"));
   582→          console.log(chalk.gray("─".repeat(30)));
   583→          for (const [tag, count] of tagCounts) {
   584→            console.log(`  #${tag}: ${count}`);
   585→          }
   586→        });
   587→      } catch (err) {
   588→        error(errors.failures.getTags, err);
   589→        process.exit(EXIT_CODES.ERROR);
   590→      }
   591→    });
   592→
   593→  // kspec item add - create a new spec item under a parent
   594→  markMutating(item.command("add"))
   595→    .description("Create a new spec item under a parent")
   596→    .requiredOption(
   597→      "--under <ref>",
   598→      "Parent item reference (e.g., @core-primitives)",
   599→    )
   600→    .requiredOption("--title <title>", "Item title")
   601→    .option(
   602→      "--type <type>",
   603→      "Item type (feature, requirement, constraint, decision)",
   604→      "feature",
   605→    )
   606→    .option("--slug <slug>", "Human-friendly slug")
   607→    .option("--priority <priority>", "Priority (high, medium, low)")
   608→    .option("--tag <tag...>", "Tags")
   609→    .option("--trait <trait...>", "Traits to apply (e.g., @trait-testable)")
   610→    .option("--description <desc>", "Description")
   611→    .option(
   612→      "--as <field>",
   613→      "Child field override (e.g., requirements, constraints)",
   614→    )
   615→    .addHelpText(
   616→      "after",
   617→      `
   618→Examples:
   619→  $ kspec item add --under @parent --title "Feature name" --type feature
   620→  $ kspec item add --under @parent --title "Multi-tag" --tag api public
   621→  $ kspec item add --under @parent --title "API endpoint" --trait @trait-api-endpoint`,
   622→    )
   623→    .action(async (options) => {
   624→      try {
   625→        const ctx = await initContext();
   626→        const { refIndex, items } = await buildIndexes(ctx);
   627→
   628→        // Find the parent item
   629→        const parentResult = refIndex.resolve(options.under);
   630→        if (!parentResult.ok) {
   631→          error(errors.reference.itemNotFound(options.under));
   632→          process.exit(EXIT_CODES.ERROR);
   633→        }
   634→
   635→        const parent = parentResult.item as LoadedSpecItem;
   636→
   637→        // Check it's not a task
   638→        if ("status" in parent && typeof parent.status === "string") {
   639→          error(errors.reference.parentIsTask(options.under));
   640→          process.exit(EXIT_CODES.ERROR);
   641→        }
   642→
   643→        // Check slug uniqueness if provided
   644→        if (options.slug) {
   645→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   646→          if (!slugCheck.ok) {
   647→            error(
   648→              errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid),
   649→            );
   650→            process.exit(EXIT_CODES.CONFLICT);
   651→          }
   652→        }
   653→
   654→        // Validate and canonicalize traits
   655→        const validatedTraits: string[] = [];
   656→        const seenTraitUlids = new Set<string>();
   657→        let hasTraitErrors = false;
   658→
   659→        if (options.trait) {
   660→          for (const traitRef of options.trait) {
   661→            const traitResult = refIndex.resolve(traitRef);
   662→            if (!traitResult.ok) {
   663→              error(`Trait not found: ${traitRef}`);
   664→              hasTraitErrors = true;
   665→              continue;
   666→            }
   667→
   668→            const traitItem = traitResult.item as LoadedSpecItem;
   669→            if (traitItem.type !== "trait") {
   670→              error(`${traitRef} is not a trait (type: ${traitItem.type})`);
   671→              hasTraitErrors = true;
   672→              continue;
   673→            }
   674→
   675→            // Deduplicate by ULID
   676→            if (seenTraitUlids.has(traitItem._ulid)) {
   677→              continue;
   678→            }
   679→            seenTraitUlids.add(traitItem._ulid);
   680→
   681→            // Store canonical ref (prefer slug over ULID)
   682→            const canonicalRef = `@${traitItem.slugs[0] || traitItem._ulid}`;
   683→            validatedTraits.push(canonicalRef);
   684→          }
   685→        }
   686→
   687→        if (hasTraitErrors) {
   688→          process.exit(EXIT_CODES.NOT_FOUND);
   689→        }
   690→
   691→        const input: SpecItemInput = {
   692→          title: options.title,
   693→          type: options.type as ItemType,
   694→          slugs: options.slug ? [options.slug] : [],
   695→          priority: options.priority,
   696→          tags: parseTagsArray(options.tag),
   697→          description: options.description,
   698→          depends_on: [],
   699→          implements: [],
   700→          relates_to: [],
   701→          tests: [],
   702→          traits: validatedTraits,
   703→          notes: [],
   704→        };
   705→
   706→        const newItem = createSpecItem(input);
   707→        const result = await addChildItem(ctx, parent, newItem, options.as);
   708→
   709→        // Build index including the new item for accurate short ULID
   710→        const index = new ReferenceIndex(
   711→          [],
   712→          [...items, result.item as LoadedSpecItem],
   713→        );
   714→        const itemSlug =
   715→          (result.item as LoadedSpecItem).slugs?.[0] ||
   716→          index.shortUlid(result.item._ulid);
   717→        await commitIfShadow(ctx.shadow, "item-add", itemSlug);
   718→        success(
   719→          `Created item: ${index.shortUlid(result.item._ulid)} under @${parent.slugs[0] || parent._ulid.slice(0, 8)}`,
   720→          {
   721→            item: result.item,
   722→            path: result.path,
   723→          },
   724→        );
   725→
   726→        // Derive hint
   727→        if (!isJsonMode()) {
   728→          const refSlug =
   729→            (result.item as LoadedSpecItem).slugs?.[0] ||
   730→            index.shortUlid(result.item._ulid);
   731→          console.log(
   732→            chalk.gray(
   733→              `\nDerive implementation task? kspec derive @${refSlug}`,
   734→            ),
   735→          );
   736→        }
   737→      } catch (err) {
   738→        error(errors.failures.createItem, err);
   739→        process.exit(EXIT_CODES.ERROR);
   740→      }
   741→    });
   742→
   743→  // kspec item set - update a spec item field
   744→  markMutating(item.command("set <ref>"))
   745→    .description("Update a spec item field")
   746→    .option("--title <title>", "Set title")
   747→    .option("--type <type>", "Set type")
   748→    .option("--slug <slug>", "Add a slug")
   749→    .option("--remove-slug <slug>", "Remove a slug")
   750→    .option("--priority <priority>", "Set priority")
   751→    .option("--tag <tag...>", "Set tags (replaces existing)")
   752→    .option("--description <desc>", "Set description")
   753→    .option(
   754→      "--status <status>",
   755→      "Set implementation status (not_started, in_progress, implemented, verified)",
   756→    )
   757→    .option(
   758→      "--maturity <maturity>",
   759→      "Set maturity (draft, proposed, stable, deferred, deprecated)",
   760→    )
   761→    .option(
   762→      "--verified-by <agent-ref>",
   763→      "Set verified_by (for retrospective specs)",
   764→    )
   765→    .option(
   766→      "--verified-at <iso-timestamp>",
   767→      "Set verified_at (defaults to now if --verified-by provided)",
   768→    )
   769→    .option("--trait <trait...>", "Set traits (replaces existing)")
   770→    .option("--relates-to <ref>", "Add a relates_to reference")
   771→    .option("--implements <ref>", "Add an implements reference")
   772→    .option("--depends-on <ref>", "Add a depends_on reference")
   773→    .option("--clear-relates-to", "Clear all relates_to references")
   774→    .option("--clear-implements", "Clear all implements references")
   775→    .option("--clear-depends-on", "Clear all depends_on references")
   776→    .addHelpText(
   777→      "after",
   778→      `
   779→Examples:
   780→  $ kspec item set @item-ref --title "New title"
   781→  $ kspec item set @item-ref --tag api internal security
   782→  $ kspec item set @item-ref --trait reusable testable
   783→  $ kspec item set @item-ref --relates-to @other-item
   784→  $ kspec item set @item-ref --implements @feature-spec
   785→  $ kspec item set @item-ref --depends-on @prereq-spec`,
   786→    )
   787→    .action(async (ref, options) => {
   788→      try {
   789→        const ctx = await initContext();
   790→        const { refIndex, items, tasks } = await buildIndexes(ctx);
   791→
   792→        const result = refIndex.resolve(ref);
   793→        if (!result.ok) {
   794→          error(errors.reference.itemNotFound(ref));
   795→          process.exit(EXIT_CODES.ERROR);
   796→        }
   797→
   798→        const foundItem = result.item as LoadedSpecItem;
   799→
   800→        // Check if it's a task (tasks should use task commands)
   801→        if ("status" in foundItem && typeof foundItem.status === "string") {
   802→          error(errors.reference.taskUseTaskCommands(ref));
   803→          process.exit(EXIT_CODES.ERROR);
   804→        }
   805→
   806→        // Check slug uniqueness if adding a new slug
   807→        if (options.slug) {
   808→          const slugCheck = checkSlugUniqueness(
   809→            refIndex,
   810→            [options.slug],
   811→            foundItem._ulid,
   812→          );
   813→          if (!slugCheck.ok) {
   814→            error(
   815→              errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid),
   816→            );
   817→            process.exit(EXIT_CODES.CONFLICT);
   818→          }
   819→        }
   820→
   821→        // Validate --remove-slug
   822→        if (options.removeSlug) {
   823→          const currentSlugs = foundItem.slugs || [];
   824→          if (!currentSlugs.includes(options.removeSlug)) {
   825→            error(errors.slug.notFound(options.removeSlug));
   826→            process.exit(EXIT_CODES.ERROR);
   827→          }
   828→          if (currentSlugs.length === 1) {
   829→            error(errors.slug.cannotRemoveLast(options.removeSlug));
   830→            process.exit(EXIT_CODES.ERROR);
   831→          }
   832→        }
   833→
   834→        // Mutual exclusivity: cannot add and clear same field
   835→        // Check this before ref resolution so usage errors take precedence
   836→        if (options.relatesTo && options.clearRelatesTo) {
   837→          error("Cannot use --relates-to and --clear-relates-to together");
   838→          process.exit(EXIT_CODES.USAGE_ERROR);
   839→        }
   840→        if (options.implements && options.clearImplements) {
   841→          error("Cannot use --implements and --clear-implements together");
   842→          process.exit(EXIT_CODES.USAGE_ERROR);
   843→        }
   844→        if (options.dependsOn && options.clearDependsOn) {
   845→          error("Cannot use --depends-on and --clear-depends-on together");
   846→          process.exit(EXIT_CODES.USAGE_ERROR);
   847→        }
   848→
   849→        // Helper to validate relationship refs (must exist and be a spec item, not a task)
   850→        // Returns { ulid, canonicalRef } for deduplication and user-friendly storage
   851→        const validateRelationshipRef = (refStr: string, flagName: string): { ulid: string; canonicalRef: string } => {
   852→          const refResult = refIndex.resolve(refStr);
   853→          if (!refResult.ok) {
   854→            error(errors.reference.itemNotFound(refStr));
   855→            process.exit(EXIT_CODES.NOT_FOUND);
   856→          }
   857→          // Ensure it's a spec item, not a task
   858→          const isTask = tasks.some((t) => t._ulid === refResult.ulid);
   859→          if (isTask) {
   860→            error(`${flagName} reference must be a spec item, not a task: ${refStr}`);
   861→            process.exit(EXIT_CODES.USAGE_ERROR);
   862→          }
   863→          // Use primary slug if available for user-friendly storage, otherwise ULID
   864→          const item = refResult.item as LoadedSpecItem;
   865→          const canonicalRef = item.slugs?.[0] ? `@${item.slugs[0]}` : `@${refResult.ulid}`;
   866→          return { ulid: refResult.ulid, canonicalRef };
   867→        };
   868→
   869→        // Helper to resolve existing refs to ULIDs for deduplication
   870→        const resolveRefsToUlids = (refs: string[]): Set<string> => {
   871→          const ulids = new Set<string>();
   872→          for (const ref of refs) {
   873→            const result = refIndex.resolve(ref);
   874→            if (result.ok) {
   875→              ulids.add(result.ulid);
   876→            }
   877→          }
   878→          return ulids;
   879→        };
   880→
   881→        // AC: @item-set ac-5 - --relates-to validation
   882→        // Store resolved ULID for deduplication and canonical ref for storage
   883→        let relatesToResolved: { ulid: string; canonicalRef: string } | undefined;
   884→        if (options.relatesTo) {
   885→          relatesToResolved = validateRelationshipRef(options.relatesTo, "--relates-to");
   886→        }
   887→
   888→        // AC: @item-set ac-6 - --implements validation
   889→        let implementsResolved: { ulid: string; canonicalRef: string } | undefined;
   890→        if (options.implements) {
   891→          implementsResolved = validateRelationshipRef(options.implements, "--implements");
   892→        }
   893→
   894→        // AC: @item-set ac-7 - --depends-on validation
   895→        let dependsOnResolved: { ulid: string; canonicalRef: string } | undefined;
   896→        if (options.dependsOn) {
   897→          dependsOnResolved = validateRelationshipRef(options.dependsOn, "--depends-on");
   898→        }
   899→
   900→        // Build updates object
   901→        const updates: Partial<SpecItemInput> = {};
   902→
   903→        if (options.title) updates.title = options.title;
   904→        if (options.type) updates.type = options.type as ItemType;
   905→        if (options.slug || options.removeSlug) {
   906→          let slugs = [...(foundItem.slugs || [])];
   907→          if (options.removeSlug) {
   908→            slugs = slugs.filter((s) => s !== options.removeSlug);
   909→          }
   910→          if (options.slug) {
   911→            slugs.push(options.slug);
   912→          }
   913→          updates.slugs = slugs;
   914→        }
   915→        if (options.priority) updates.priority = options.priority;
   916→        if (options.tag) updates.tags = parseTagsArray(options.tag);
   917→        if (options.trait) updates.traits = options.trait;
   918→        if (options.description) updates.description = options.description;
   919→
   920→        // Handle status updates
   921→        if (options.status || options.maturity) {
   922→          const currentStatus =
   923→            foundItem.status && typeof foundItem.status === "object"
   924→              ? foundItem.status
   925→              : {};
   926→          updates.status = {
   927→            ...currentStatus,
   928→            ...(options.status && { implementation: options.status }),
   929→            ...(options.maturity && { maturity: options.maturity }),
   930→          };
   931→        }
   932→
   933→        // Handle verification metadata (for retrospective specs)
   934→        if (options.verifiedBy) {
   935→          updates.verified_by = options.verifiedBy;
   936→          // Default verified_at to now if not specified
   937→          updates.verified_at = options.verifiedAt || new Date().toISOString();
   938→        } else if (options.verifiedAt) {
   939→          updates.verified_at = options.verifiedAt;
   940→        }
   941→
   942→        // AC: @item-set ac-5 - Handle relates_to (append semantics)
   943→        // Uses resolved ULIDs for deduplication and stores canonical slug format
   944→        if (relatesToResolved) {
   945→          const current = foundItem.relates_to || [];
   946→          const existingUlids = resolveRefsToUlids(current);
   947→          if (!existingUlids.has(relatesToResolved.ulid)) {
   948→            updates.relates_to = [...current, relatesToResolved.canonicalRef];
   949→          }
   950→        }
   951→        if (options.clearRelatesTo) {
   952→          updates.relates_to = [];
   953→        }
   954→
   955→        // AC: @item-set ac-6 - Handle implements (append semantics)
   956→        // Uses resolved ULIDs for deduplication and stores canonical slug format
   957→        if (implementsResolved) {
   958→          const current = foundItem.implements || [];
   959→          const existingUlids = resolveRefsToUlids(current);
   960→          if (!existingUlids.has(implementsResolved.ulid)) {
   961→            updates.implements = [...current, implementsResolved.canonicalRef];
   962→          }
   963→        }
   964→        if (options.clearImplements) {
   965→          updates.implements = [];
   966→        }
   967→
   968→        // AC: @item-set ac-7 - Handle depends_on (append semantics)
   969→        // Uses resolved ULIDs for deduplication and stores canonical slug format
   970→        if (dependsOnResolved) {
   971→          const current = foundItem.depends_on || [];
   972→          const existingUlids = resolveRefsToUlids(current);
   973→          if (!existingUlids.has(dependsOnResolved.ulid)) {
   974→            updates.depends_on = [...current, dependsOnResolved.canonicalRef];
   975→          }
   976→        }
   977→        if (options.clearDependsOn) {
   978→          updates.depends_on = [];
   979→        }
   980→
   981→        if (Object.keys(updates).length === 0) {
   982→          warn("No updates specified");
   983→          return;
   984→        }
   985→
   986→        const updated = await updateSpecItem(ctx, foundItem, updates);
   987→        const itemSlug =
   988→          foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
   989→
   990→        // Handle cascade for implementation status updates
   991→        const updatedItems: LoadedSpecItem[] = [updated];
   992→        if (options.status) {
   993→          const cascadeResult = await handleStatusCascade(
   994→            ctx,
   995→            updated,
   996→            options.status,
   997→            items,
   998→            refIndex,
   999→          );
  1000→          updatedItems.push(...cascadeResult);
  1001→        }
  1002→
  1003→        await commitIfShadow(ctx.shadow, "item-set", itemSlug);
  1004→        success(`Updated item: ${refIndex.shortUlid(updated._ulid)}`, {
  1005→          item: updated,
  1006→        });
  1007→
  1008→        // Derive hint
  1009→        if (!isJsonMode()) {
  1010→          const refSlug =
  1011→            updated.slugs?.[0] || refIndex.shortUlid(updated._ulid);
  1012→          console.log(
  1013→            chalk.gray(
  1014→              `\nDerive implementation task? kspec derive @${refSlug}`,
  1015→            ),
  1016→          );
  1017→        }
  1018→      } catch (err) {
  1019→        error(errors.failures.updateItem, err);
  1020→        process.exit(EXIT_CODES.ERROR);
  1021→      }
  1022→    });
  1023→
  1024→  // kspec item delete - delete a spec item
  1025→  markMutating(item.command("delete <ref>"))
  1026→    .description("Delete a spec item (including nested items)")
  1027→    .option("--force", "Skip confirmation")
  1028→    .option("--cascade", "Delete item and all descendants")
  1029→    .action(async (ref, options) => {
  1030→      try {
  1031→        const ctx = await initContext();
  1032→        const { refIndex, items } = await buildIndexes(ctx);
  1033→
  1034→        const result = refIndex.resolve(ref);
  1035→        if (!result.ok) {
  1036→          error(errors.reference.itemNotFound(ref));
  1037→          process.exit(EXIT_CODES.ERROR);
  1038→        }
  1039→
  1040→        const foundItem = result.item as LoadedSpecItem;
  1041→
  1042→        // Check if it's a task
  1043→        if ("status" in foundItem && typeof foundItem.status === "string") {
  1044→          error(errors.reference.itemUseTaskCancel(ref));
  1045→          process.exit(EXIT_CODES.ERROR);
  1046→        }
  1047→
  1048→        if (!foundItem._sourceFile) {
  1049→          error(errors.operation.cannotDeleteNoSource);
  1050→          process.exit(EXIT_CODES.ERROR);
  1051→        }
  1052→
  1053→        // AC: @spec-item-delete-children ac-7 - Check if this is a trait with implementors
  1054→        const implementors = findTraitImplementors(foundItem, items);
  1055→        if (implementors.length > 0) {
  1056→          const implementorRefs = implementors
  1057→            .map((i) => `@${i.slugs[0] || i._ulid.slice(0, 8)}`)
  1058→            .join(", ");
  1059→          const errorMsg = `Cannot delete: trait is used by ${implementors.length} specs. Remove trait from specs first: ${implementorRefs}`;
  1060→
  1061→          if (isJsonMode()) {
  1062→            error(errorMsg, {
  1063→              error: "trait_in_use",
  1064→              implementors: implementors.map((i) => ({
  1065→                ulid: i._ulid,
  1066→                slug: i.slugs[0],
  1067→                title: i.title,
  1068→              })),
  1069→            });
  1070→          } else {
  1071→            error(errorMsg);
  1072→          }
  1073→          process.exit(EXIT_CODES.ERROR);
  1074→        }
  1075→
  1076→        // AC: @spec-item-delete-children ac-1 ac-8 - Check for child items (nested YAML items, not relates_to refs)
  1077→        const children = findChildItems(foundItem, items);
  1078→
  1079→        if (children.length > 0 && !options.cascade) {
  1080→          // AC: @spec-item-delete-children ac-1 - Block deletion if children exist without --cascade
  1081→          const errorMsg = `Cannot delete: item has ${children.length} children. Use --cascade to delete recursively`;
  1082→
  1083→          if (isJsonMode()) {
  1084→            // AC: @spec-item-delete-children ac-10 - JSON error includes children array
  1085→            error(errorMsg, {
  1086→              error: "has_children",
  1087→              children: children.map((c) => ({
  1088→                ulid: c._ulid,
  1089→                slug: c.slugs[0],
  1090→                title: c.title,
  1091→                ref: `@${c.slugs[0] || c._ulid.slice(0, 8)}`,
  1092→              })),
  1093→            });
  1094→          } else {
  1095→            error(errorMsg);
  1096→          }
  1097→          process.exit(EXIT_CODES.ERROR);
  1098→        }
  1099→
  1100→        // AC: @spec-item-delete-children ac-9 - Custom confirmation prompt for cascade
  1101→        if (children.length > 0 && options.cascade && !options.force) {
  1102→          const itemRef = `@${foundItem.slugs[0] || foundItem._ulid.slice(0, 8)}`;
  1103→
  1104→          // Check for JSON mode - requires --force
  1105→          if (isJsonMode()) {
  1106→            error("Confirmation required. Use --force with --json");
  1107→            process.exit(EXIT_CODES.ERROR);
  1108→          }
  1109→
  1110→          // Check for non-interactive environment
  1111→          const isTTY =
  1112→            process.env.KSPEC_TEST_TTY === "true" || process.stdin.isTTY;
  1113→          if (!isTTY) {
  1114→            error("Non-interactive environment. Use --force to proceed");
  1115→            process.exit(EXIT_CODES.ERROR);
  1116→          }
  1117→
  1118→          // Show confirmation prompt
  1119→          const readline = await import("node:readline");
  1120→          const rl = readline.createInterface({
  1121→            input: process.stdin,
  1122→            output: process.stdout,
  1123→          });
  1124→
  1125→          const response = await new Promise<string>((resolve) => {
  1126→            rl.question(
  1127→              chalk.yellow(
  1128→                `Delete ${itemRef} and ${children.length} descendant items? [y/N] `,
  1129→              ),
  1130→              (answer) => {
  1131→                rl.close();
  1132→                resolve(answer);
  1133→              },
  1134→            );
  1135→          });
  1136→
  1137→          if (response.toLowerCase() !== "y") {
  1138→            console.log(chalk.gray("Operation cancelled"));
  1139→            process.exit(EXIT_CODES.USAGE_ERROR);
  1140→          }
  1141→        }
  1142→
  1143→        // AC: @spec-item-delete-children ac-2 ac-3 - Delete item and all descendants with cascade
  1144→        const itemsToDelete = options.cascade
  1145→          ? [foundItem, ...children]
  1146→          : [foundItem];
  1147→        let deletedCount = 0;
  1148→
  1149→        // Delete in reverse order (deepest first) to avoid path issues
  1150→        const sortedItems = [...itemsToDelete].sort((a, b) => {
  1151→          const aDepth = a._path ? a._path.split(".").length : 0;
  1152→          const bDepth = b._path ? b._path.split(".").length : 0;
  1153→          return bDepth - aDepth;
  1154→        });
  1155→
  1156→        for (const itemToDelete of sortedItems) {
  1157→          const deleted = await deleteSpecItem(ctx, itemToDelete);
  1158→          if (deleted) {
  1159→            deletedCount++;
  1160→          }
  1161→        }
  1162→
  1163→        if (deletedCount > 0) {
  1164→          // AC: @spec-item-delete-children ac-6 - Single shadow commit with all deletions
  1165→          const itemSlug =
  1166→            foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
  1167→          const commitMsg =
  1168→            deletedCount > 1 ? `${deletedCount} items` : itemSlug;
  1169→          await commitIfShadow(ctx.shadow, "item-delete", commitMsg);
  1170→
  1171→          if (deletedCount > 1) {
  1172→            success(`Deleted ${deletedCount} items`, {
  1173→              deleted: deletedCount,
  1174→              root_ulid: foundItem._ulid,
  1175→            });
  1176→          } else {
  1177→            success(`Deleted item: ${foundItem.title}`, {
  1178→              deleted: true,
  1179→              ulid: foundItem._ulid,
  1180→            });
  1181→          }
  1182→        } else {
  1183→          error(errors.failures.deleteItem);
  1184→          console.log(
  1185→            chalk.gray(
  1186→              `Edit the source file directly: ${foundItem._sourceFile}`,
  1187→            ),
  1188→          );
  1189→          process.exit(EXIT_CODES.ERROR);
  1190→        }
  1191→      } catch (err) {
  1192→        error(errors.failures.deleteItem, err);
  1193→        process.exit(EXIT_CODES.ERROR);
  1194→      }
  1195→    });
  1196→
  1197→  // kspec item patch - update item fields via JSON
  1198→  markMutating(item.command("patch [ref]"))
  1199→    .description("Update spec item fields via JSON patch")
  1200→    .option("--data <json>", "JSON data to patch")
  1201→    .option("--bulk", "Read patches from stdin (JSONL or JSON array)")
  1202→    .option("--allow-unknown", "Allow fields not in schema")
  1203→    .option("--dry-run", "Preview changes without applying")
  1204→    .option("--fail-fast", "Stop on first error (bulk mode)")
  1205→    .action(async (ref: string | undefined, options) => {
  1206→      try {
  1207→        const ctx = await initContext();
  1208→
  1209→        if (options.bulk) {
  1210→          // Bulk mode: read from stdin
  1211→          const stdin = await readStdinFully();
  1212→          if (!stdin) {
  1213→            error(errors.validation.noInputProvided);
  1214→            process.exit(EXIT_CODES.ERROR);
  1215→          }
  1216→
  1217→          let patches: PatchOperation[];
  1218→          try {
  1219→            patches = parseBulkInput(stdin);
  1220→          } catch (err) {
  1221→            error(
  1222→              errors.validation.failedToParseBulk(
  1223→                err instanceof Error ? err.message : String(err),
  1224→              ),
  1225→            );
  1226→            process.exit(EXIT_CODES.ERROR);
  1227→          }
  1228→
  1229→          if (patches.length === 0) {
  1230→            error(errors.validation.noPatchesProvided);
  1231→            process.exit(EXIT_CODES.ERROR);
  1232→          }
  1233→
  1234→          const { refIndex, items } = await buildIndexes(ctx);
  1235→          const result = await patchSpecItems(ctx, refIndex, items, patches, {
  1236→            allowUnknown: options.allowUnknown,
  1237→            failFast: options.failFast,
  1238→            dryRun: options.dryRun,
  1239→          });
  1240→
  1241→          // Shadow commit if any updates
  1242→          if (!options.dryRun && result.summary.updated > 0) {
  1243→            await commitIfShadow(
  1244→              ctx.shadow,
  1245→              "item-patch",
  1246→              `${result.summary.updated} items`,
  1247→            );
  1248→          }
  1249→
  1250→          output(result, () => formatBulkPatchResult(result, options.dryRun));
  1251→
  1252→          if (result.summary.failed > 0) {
  1253→            process.exit(EXIT_CODES.ERROR);
  1254→          }
  1255→        } else {
  1256→          // Single item mode
  1257→          if (!ref) {
  1258→            error(errors.usage.patchNeedRef);
  1259→            process.exit(EXIT_CODES.ERROR);
  1260→          }
  1261→
  1262→          let data: Record<string, unknown>;
  1263→
  1264→          // Get data from --data option or stdin
  1265→          if (options.data) {
  1266→            try {
  1267→              data = JSON.parse(options.data);
  1268→            } catch (err) {
  1269→              error(
  1270→                errors.validation.invalidJsonInData(
  1271→                  err instanceof Error ? err.message : "",
  1272→                ),
  1273→              );
  1274→              process.exit(EXIT_CODES.ERROR);
  1275→            }
  1276→          } else {
  1277→            const stdin = await readStdinIfAvailable();
  1278→            if (stdin) {
  1279→              try {
  1280→                data = JSON.parse(stdin.trim());
  1281→              } catch (err) {
  1282→                error(
  1283→                  errors.validation.invalidJsonFromStdin(
  1284→                    err instanceof Error ? err.message : "",
  1285→                  ),
  1286→                );
  1287→                process.exit(EXIT_CODES.ERROR);
  1288→              }
  1289→            } else {
  1290→              error(errors.validation.noPatchData);
  1291→              process.exit(EXIT_CODES.ERROR);
  1292→            }
  1293→          }
  1294→
  1295→          // Validate against schema (unless --allow-unknown)
  1296→          if (!options.allowUnknown) {
  1297→            // Use strict schema (no passthrough)
  1298→            const strictSchema = SpecItemPatchSchema.strict();
  1299→            const parseResult = strictSchema.safeParse(data);
  1300→            if (!parseResult.success) {
  1301→              const issues = parseResult.error.issues
  1302→                .map((i) => `${i.path.join(".")}: ${i.message}`)
  1303→                .join("; ");
  1304→              error(errors.validation.invalidPatchDataWithIssues(issues));
  1305→              process.exit(EXIT_CODES.ERROR);
  1306→            }
  1307→          }
  1308→
  1309→          const { refIndex, items } = await buildIndexes(ctx);
  1310→
  1311→          // Resolve ref
  1312→          const resolved = refIndex.resolve(ref);
  1313→          if (!resolved.ok) {
  1314→            error(errors.reference.itemNotFound(ref));
  1315→            process.exit(EXIT_CODES.ERROR);
  1316→          }
  1317→
  1318→          // Find the item
  1319→          const foundItem = items.find((i) => i._ulid === resolved.ulid);
  1320→          if (!foundItem) {
  1321→            error(errors.reference.notItem(ref));
  1322→            process.exit(EXIT_CODES.ERROR);
  1323→          }
  1324→
  1325→          if (options.dryRun) {
  1326→            output(
  1327→              {
  1328→                ref,
  1329→                data,
  1330→                wouldApplyTo: foundItem.title,
  1331→                ulid: foundItem._ulid,
  1332→              },
  1333→              () => {
  1334→                console.log(chalk.yellow("Would patch:"), foundItem.title);
  1335→                console.log(chalk.gray("ULID:"), foundItem._ulid.slice(0, 8));
  1336→                console.log(chalk.gray("Changes:"));
  1337→                console.log(JSON.stringify(data, null, 2));
  1338→              },
  1339→            );
  1340→            return;
  1341→          }
  1342→
  1343→          const updated = await updateSpecItem(ctx, foundItem, data);
  1344→          const itemSlug =
  1345→            foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
  1346→          await commitIfShadow(ctx.shadow, "item-patch", itemSlug);
  1347→
  1348→          success(`Patched item: ${itemSlug}`, { item: updated });
  1349→        }
  1350→      } catch (err) {
  1351→        error(errors.failures.patchItems, err);
  1352→        process.exit(EXIT_CODES.ERROR);
  1353→      }
  1354→    });
  1355→
  1356→  // kspec item status - show implementation status with linked tasks
  1357→  item
  1358→    .command("status <ref>")
  1359→    .description("Show implementation status and linked tasks for a spec item")
  1360→    .action(async (ref) => {
  1361→      try {
  1362→        const ctx = await initContext();
  1363→        const tasks = await loadAllTasks(ctx);
  1364→        const items = await loadAllItems(ctx);
  1365→        const refIndex = new ReferenceIndex(tasks, items);
  1366→
  1367→        const result = refIndex.resolve(ref);
  1368→        if (!result.ok) {
  1369→          error(errors.reference.itemNotFound(ref));
  1370→          process.exit(EXIT_CODES.ERROR);
  1371→        }
  1372→
  1373→        const foundItem = result.item as LoadedSpecItem;
  1374→
  1375→        // Check if it's a task
  1376→        if ("status" in foundItem && typeof foundItem.status === "string") {
  1377→          error(errors.reference.notItem(ref));
  1378→          process.exit(EXIT_CODES.ERROR);
  1379→        }
  1380→
  1381→        // Build alignment index
  1382→        const alignmentIndex = new AlignmentIndex(tasks, items);
  1383→        alignmentIndex.buildLinks(refIndex);
  1384→
  1385→        const summary = alignmentIndex.getImplementationSummary(
  1386→          foundItem._ulid,
  1387→        );
  1388→
  1389→        if (!summary) {
  1390→          error(errors.project.couldNotGetImplSummary);
  1391→          process.exit(EXIT_CODES.ERROR);
  1392→        }
  1393→
  1394→        output(summary, () => {
  1395→          console.log(chalk.bold(foundItem.title));
  1396→          console.log(chalk.gray("─".repeat(40)));
  1397→
  1398→          // Status
  1399→          const currentColor =
  1400→            summary.currentStatus === "implemented"
  1401→              ? chalk.green
  1402→              : summary.currentStatus === "in_progress"
  1403→                ? chalk.yellow
  1404→                : chalk.gray;
  1405→          const expectedColor =
  1406→            summary.expectedStatus === "implemented"
  1407→              ? chalk.green
  1408→              : summary.expectedStatus === "in_progress"
  1409→                ? chalk.yellow
  1410→                : chalk.gray;
  1411→
  1412→          console.log(
  1413→            `Current status:  ${currentColor(summary.currentStatus)}`,
  1414→          );
  1415→          console.log(
  1416→            `Expected status: ${expectedColor(summary.expectedStatus)}`,
  1417→          );
  1418→
  1419→          if (!summary.isAligned) {
  1420→            console.log(
  1421→              chalk.yellow("\n⚠ Status mismatch - run task complete to sync"),
  1422→            );
  1423→          } else {
  1424→            console.log(chalk.green("\n✓ Aligned"));
  1425→          }
  1426→
  1427→          // Linked tasks
  1428→          console.log(chalk.bold("\nLinked Tasks:"));
  1429→          if (summary.linkedTasks.length === 0) {
  1430→            console.log(chalk.gray("  No tasks reference this spec item"));
  1431→          } else {
  1432→            for (const task of summary.linkedTasks) {
  1433→              const statusColor =
  1434→                task.taskStatus === "completed"
  1435→                  ? chalk.green
  1436→                  : task.taskStatus === "in_progress"
  1437→                    ? chalk.blue
  1438→                    : chalk.gray;
  1439→              const shortId = task.taskUlid.slice(0, 8);
  1440→              const notes = task.hasNotes ? chalk.gray(" (has notes)") : "";
  1441→              console.log(
  1442→                `  ${statusColor(`[${task.taskStatus}]`)} ${shortId} ${task.taskTitle}${notes}`,
  1443→              );
  1444→            }
  1445→          }
  1446→        });
  1447→      } catch (err) {
  1448→        error(errors.failures.getItemStatus, err);
  1449→        process.exit(EXIT_CODES.ERROR);
  1450→      }
  1451→    });
  1452→
  1453→  // kspec item note <ref> <message>
  1454→  markMutating(item.command("note <ref> <message>"))
  1455→    .description("Add a note to a spec item")
  1456→    .option("--author <author>", "Note author")
  1457→    .option("--supersedes <ulid>", "ULID of note this supersedes")
  1458→    .action(async (ref: string, message: string, options) => {
  1459→      try {
  1460→        const ctx = await initContext();
  1461→        const items = await loadAllItems(ctx);
  1462→        const tasks = await loadAllTasks(ctx);
  1463→        const refIndex = new ReferenceIndex(tasks, items);
  1464→
  1465→        const result = refIndex.resolve(ref);
  1466→        if (!result.ok) {
  1467→          error(errors.reference.itemNotFound(ref));
  1468→          process.exit(EXIT_CODES.ERROR);
  1469→        }
  1470→
  1471→        const foundItem = items.find((i) => i._ulid === result.ulid);
  1472→        if (!foundItem) {
  1473→          error(errors.reference.itemNotFound(ref));
  1474→          process.exit(EXIT_CODES.ERROR);
  1475→        }
  1476→
  1477→        const note = createNote(message, options.author, options.supersedes);
  1478→
  1479→        const updatedNotes = [...(foundItem.notes || []), note];
  1480→        await updateSpecItem(ctx, foundItem, { notes: updatedNotes });
  1481→
  1482→        const itemSlug =
  1483→          foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
  1484→        await commitIfShadow(ctx.shadow, "item-note", itemSlug);
  1485→        success(
  1486→          `Added note to spec item: ${refIndex.shortUlid(foundItem._ulid)}`,
  1487→          { note },
  1488→        );
  1489→      } catch (err) {
  1490→        error(errors.failures.addNote, err);
  1491→        process.exit(EXIT_CODES.ERROR);
  1492→      }
  1493→    });
  1494→
  1495→  // kspec item notes <ref>
  1496→  item
  1497→    .command("notes <ref>")
  1498→    .description("Show notes for a spec item")
  1499→    .action(async (ref: string) => {
  1500→      try {
  1501→        const ctx = await initContext();
  1502→        const items = await loadAllItems(ctx);
  1503→        const tasks = await loadAllTasks(ctx);
  1504→        const refIndex = new ReferenceIndex(tasks, items);
  1505→
  1506→        const result = refIndex.resolve(ref);
  1507→        if (!result.ok) {
  1508→          error(errors.reference.itemNotFound(ref));
  1509→          process.exit(EXIT_CODES.ERROR);
  1510→        }
  1511→
  1512→        const foundItem = items.find((i) => i._ulid === result.ulid);
  1513→        if (!foundItem) {
  1514→          error(errors.reference.itemNotFound(ref));
  1515→          process.exit(EXIT_CODES.ERROR);
  1516→        }
  1517→
  1518→        const notes = foundItem.notes || [];
  1519→        output(notes, () => {
  1520→          if (notes.length === 0) {
  1521→            console.log("No notes");
  1522→          } else {
  1523→            for (const note of notes) {
  1524→              const author = note.author || "unknown";
  1525→              console.log(`[${note.created_at}] ${author}:`);
  1526→              console.log(note.content);
  1527→              console.log("");
  1528→            }
  1529→          }
  1530→        });
  1531→      } catch (err) {
  1532→        error(errors.failures.getNotes, err);
  1533→        process.exit(EXIT_CODES.ERROR);
  1534→      }
  1535→    });
  1536→
  1537→  // Create subcommand group for acceptance criteria operations
  1538→  const acCmd = item
  1539→    .command("ac")
  1540→    .description("Manage acceptance criteria on spec items");
  1541→
  1542→  // Helper: Generate next AC ID based on existing AC
  1543→  function generateNextAcId(
  1544→    existingAc: AcceptanceCriterion[] | undefined,
  1545→  ): string {
  1546→    if (!existingAc || existingAc.length === 0) return "ac-1";
  1547→
  1548→    const numericIds = existingAc
  1549→      .map((ac) => ac.id.match(/^ac-(\d+)$/)?.[1])
  1550→      .filter((id): id is string => id !== null && id !== undefined)
  1551→      .map(Number);
  1552→
  1553→    const maxId = numericIds.length > 0 ? Math.max(...numericIds) : 0;
  1554→    return `ac-${maxId + 1}`;
  1555→  }
  1556→
  1557→  // Helper: Resolve ref to spec item (not task)
  1558→  async function resolveSpecItem(ref: string): Promise<{
  1559→    ctx: Awaited<ReturnType<typeof initContext>>;
  1560→    item: LoadedSpecItem;
  1561→    refIndex: ReferenceIndex;
  1562→  }> {
  1563→    const ctx = await initContext();
  1564→    const { refIndex, items } = await buildIndexes(ctx);
  1565→
  1566→    const result = refIndex.resolve(ref);
  1567→    if (!result.ok) {
  1568→      error(errors.reference.itemNotFound(ref));
  1569→      process.exit(EXIT_CODES.NOT_FOUND);
  1570→    }
  1571→
  1572→    const foundItem = result.item as LoadedSpecItem;
  1573→
  1574→    // Check if it's a task
  1575→    if ("status" in foundItem && typeof foundItem.status === "string") {
  1576→      error(errors.operation.tasksNoAcceptanceCriteria(ref));
  1577→      process.exit(EXIT_CODES.NOT_FOUND);
  1578→    }
  1579→
  1580→    return { ctx, item: foundItem, refIndex };
  1581→  }
  1582→
  1583→  // kspec item ac list <ref>
  1584→  acCmd
  1585→    .command("list <ref>")
  1586→    .description("List acceptance criteria for a spec item")
  1587→    .action(async (ref: string) => {
  1588→      try {
  1589→        const { item, refIndex } = await resolveSpecItem(ref);
  1590→        const ac = item.acceptance_criteria || [];
  1591→
  1592→        output(ac, () => {
  1593→          console.log(
  1594→            chalk.bold(
  1595→              `Acceptance Criteria for: ${item.title} (@${item.slugs[0] || refIndex.shortUlid(item._ulid)})`,
  1596→            ),
  1597→          );
  1598→          console.log();
  1599→
  1600→          if (ac.length === 0) {
  1601→            console.log(chalk.gray("No acceptance criteria"));
  1602→          } else {
  1603→            for (const criterion of ac) {
  1604→              console.log(chalk.cyan(`  [${criterion.id}]`));
  1605→              console.log(chalk.gray(`    Given: ${criterion.given}`));
  1606→              console.log(chalk.gray(`    When:  ${criterion.when}`));
  1607→              console.log(chalk.gray(`    Then:  ${criterion.then}`));
  1608→              console.log();
  1609→            }
  1610→          }
  1611→
  1612→          console.log(chalk.gray(`${ac.length} acceptance criteria`));
  1613→        });
  1614→      } catch (err) {
  1615→        error(errors.failures.listAc, err);
  1616→        process.exit(EXIT_CODES.ERROR);
  1617→      }
  1618→    });
  1619→
  1620→  // kspec item ac add <ref>
  1621→  markMutating(acCmd.command("add <ref>"))
  1622→    .description("Add an acceptance criterion to a spec item")
  1623→    .option("--id <id>", "AC identifier (auto-generated if not provided)")
  1624→    .requiredOption("--given <text>", "The precondition (Given...)")
  1625→    .requiredOption("--when <text>", "The action/trigger (When...)")
  1626→    .requiredOption("--then <text>", "The expected outcome (Then...)")
  1627→    .action(async (ref: string, options) => {
  1628→      try {
  1629→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
  1630→        const existingAc = item.acceptance_criteria || [];
  1631→
  1632→        // Determine ID
  1633→        const acId = options.id || generateNextAcId(existingAc);
  1634→
  1635→        // Check for duplicate ID
  1636→        if (existingAc.some((ac) => ac.id === acId)) {
  1637→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1638→          error(errors.conflict.acAlreadyExists(acId, itemRef));
  1639→          process.exit(EXIT_CODES.CONFLICT);
  1640→        }
  1641→
  1642→        // Create new AC
  1643→        const newAc: AcceptanceCriterion = {
  1644→          id: acId,
  1645→          given: options.given,
  1646→          when: options.when,
  1647→          then: options.then,
  1648→        };
  1649→
  1650→        // Update item with new AC
  1651→        const updatedAc = [...existingAc, newAc];
  1652→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
  1653→
  1654→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1655→        await commitIfShadow(ctx.shadow, "item-ac-add", itemSlug);
  1656→        success(`Added acceptance criterion: ${acId} to @${itemSlug}`, {
  1657→          ac: newAc,
  1658→        });
  1659→      } catch (err) {
  1660→        error(errors.failures.addAc, err);
  1661→        process.exit(EXIT_CODES.ERROR);
  1662→      }
  1663→    });
  1664→
  1665→  // kspec item ac set <ref> <ac-id>
  1666→  markMutating(acCmd.command("set <ref> <acId>"))
  1667→    .description("Update an acceptance criterion")
  1668→    .option("--id <newId>", "Rename the AC ID")
  1669→    .option("--given <text>", "Update the precondition")
  1670→    .option("--when <text>", "Update the action/trigger")
  1671→    .option("--then <text>", "Update the expected outcome")
  1672→    .action(async (ref: string, acId: string, options) => {
  1673→      try {
  1674→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
  1675→        const existingAc = item.acceptance_criteria || [];
  1676→
  1677→        // Find the AC
  1678→        const acIndex = existingAc.findIndex((ac) => ac.id === acId);
  1679→        if (acIndex === -1) {
  1680→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1681→          error(errors.reference.acNotFound(acId, itemRef));
  1682→          process.exit(EXIT_CODES.NOT_FOUND);
  1683→        }
  1684→
  1685→        // Check for no updates
  1686→        if (!options.id && !options.given && !options.when && !options.then) {
  1687→          warn("No updates specified");
  1688→          return;
  1689→        }
  1690→
  1691→        // Check for duplicate ID if renaming
  1692→        if (
  1693→          options.id &&
  1694→          options.id !== acId &&
  1695→          existingAc.some((ac) => ac.id === options.id)
  1696→        ) {
  1697→          error(errors.conflict.acIdAlreadyExists(options.id));
  1698→          process.exit(EXIT_CODES.CONFLICT);
  1699→        }
  1700→
  1701→        // Build updated AC
  1702→        const updatedAc = [...existingAc];
  1703→        const updatedFields: string[] = [];
  1704→
  1705→        updatedAc[acIndex] = {
  1706→          ...updatedAc[acIndex],
  1707→          ...(options.id && { id: options.id }),
  1708→          ...(options.given && { given: options.given }),
  1709→          ...(options.when && { when: options.when }),
  1710→          ...(options.then && { then: options.then }),
  1711→        };
  1712→
  1713→        if (options.id) updatedFields.push("id");
  1714→        if (options.given) updatedFields.push("given");
  1715→        if (options.when) updatedFields.push("when");
  1716→        if (options.then) updatedFields.push("then");
  1717→
  1718→        // Update item
  1719→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
  1720→
  1721→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1722→        await commitIfShadow(ctx.shadow, "item-ac-set", itemSlug);
  1723→        success(
  1724→          `Updated acceptance criterion: ${acId} on @${itemSlug} (${updatedFields.join(", ")})`,
  1725→          { ac: updatedAc[acIndex] },
  1726→        );
  1727→      } catch (err) {
  1728→        error(errors.failures.updateAc, err);
  1729→        process.exit(EXIT_CODES.ERROR);
  1730→      }
  1731→    });
  1732→
  1733→  // kspec item ac remove <ref> <ac-id>
  1734→  markMutating(acCmd.command("remove <ref> <acId>"))
  1735→    .description("Remove an acceptance criterion")
  1736→    .option("--force", "Skip confirmation")
  1737→    .action(async (ref: string, acId: string, options) => {
  1738→      try {
  1739→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
  1740→        const existingAc = item.acceptance_criteria || [];
  1741→
  1742→        // Find the AC
  1743→        const acIndex = existingAc.findIndex((ac) => ac.id === acId);
  1744→        if (acIndex === -1) {
  1745→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1746→          error(errors.reference.acNotFound(acId, itemRef));
  1747→          process.exit(EXIT_CODES.NOT_FOUND);
  1748→        }
  1749→
  1750→        // Confirmation required unless --force
  1751→        if (!options.force) {
  1752→          // AC: @spec-item-delete-children ac-5 - JSON mode requires --force
  1753→          if (isJsonMode()) {
  1754→            error("Confirmation required. Use --force with --json");
  1755→            process.exit(EXIT_CODES.ERROR);
  1756→          }
  1757→
  1758→          // AC: @spec-item-delete-children ac-6 - Non-interactive environment requires --force
  1759→          // Allow KSPEC_TEST_TTY for testing interactive prompts
  1760→          const isTTY =
  1761→            process.env.KSPEC_TEST_TTY === "1" || process.stdin.isTTY;
  1762→          if (!isTTY) {
  1763→            error("Non-interactive environment. Use --force to proceed");
  1764→            process.exit(EXIT_CODES.ERROR);
  1765→          }
  1766→
  1767→          // AC: @spec-item-delete-children ac-1 - Prompt for confirmation
  1768→          const readline = await import("node:readline");
  1769→          const rl = readline.createInterface({
  1770→            input: process.stdin,
  1771→            output: process.stdout,
  1772→          });
  1773→
  1774→          const answer = await new Promise<string>((resolve) => {
  1775→            rl.question(`Remove acceptance criterion ${acId}? [y/N] `, resolve);
  1776→          });
  1777→          rl.close();
  1778→
  1779→          // AC: @spec-item-delete-children ac-3 - User declines (n, N, or empty)
  1780→          if (answer.toLowerCase() !== "y") {
  1781→            error("Operation cancelled");
  1782→            process.exit(EXIT_CODES.USAGE_ERROR);
  1783→          }
  1784→        }
  1785→
  1786→        // AC: @spec-item-delete-children ac-4 - With --force, proceed immediately without prompt
  1787→        // AC: @spec-item-delete-children ac-2 - User confirmed, proceed with removal
  1788→        const updatedAc = existingAc.filter((ac) => ac.id !== acId);
  1789→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
  1790→
  1791→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1792→        await commitIfShadow(ctx.shadow, "item-ac-remove", itemSlug);
  1793→        success(`Removed acceptance criterion: ${acId} from @${itemSlug}`, {
  1794→          removed: acId,
  1795→        });
  1796→      } catch (err) {
  1797→        error(errors.failures.removeAc, err);
  1798→        process.exit(EXIT_CODES.ERROR);
  1799→      }
  1800→    });
  1801→}
  1802→
  1803→// ─── Patch Helpers ───────────────────────────────────────────────────────────
  1804→
  1805→/**
  1806→ * Read stdin fully with timeout (for bulk input).
  1807→ * Returns null if stdin is a TTY or empty.
  1808→ */
  1809→async function readStdinFully(): Promise<string | null> {
  1810→  if (process.stdin.isTTY) {
  1811→    return null;
  1812→  }
  1813→
  1814→  return new Promise((resolve) => {
  1815→    let data = "";
  1816→    const timeout = setTimeout(() => {
  1817→      process.stdin.removeAllListeners();
  1818→      resolve(data || null);
  1819→    }, 5000); // 5 second timeout for bulk input
  1820→
  1821→    process.stdin.setEncoding("utf8");
  1822→    process.stdin.on("data", (chunk) => {
  1823→      data += chunk;
  1824→    });
  1825→    process.stdin.on("end", () => {
  1826→      clearTimeout(timeout);
  1827→      resolve(data || null);
  1828→    });
  1829→    process.stdin.on("error", () => {
  1830→      clearTimeout(timeout);
  1831→      resolve(null);
  1832→    });
  1833→    process.stdin.resume();
  1834→  });
  1835→}
  1836→
  1837→/**
  1838→ * Read stdin if available (non-blocking for single item mode).
  1839→ * Returns null quickly if no data available.
  1840→ */
  1841→async function readStdinIfAvailable(): Promise<string | null> {
  1842→  if (process.stdin.isTTY) {
  1843→    return null;
  1844→  }
  1845→
  1846→  return new Promise((resolve) => {
  1847→    let data = "";
  1848→    const timeout = setTimeout(() => {
  1849→      process.stdin.removeAllListeners();
  1850→      resolve(data || null);
  1851→    }, 100); // 100ms timeout for quick check
  1852→
  1853→    process.stdin.setEncoding("utf8");
  1854→    process.stdin.on("data", (chunk) => {
  1855→      data += chunk;
  1856→    });
  1857→    process.stdin.on("end", () => {
  1858→      clearTimeout(timeout);
  1859→      resolve(data || null);
  1860→    });
  1861→    process.stdin.on("error", () => {
  1862→      clearTimeout(timeout);
  1863→      resolve(null);
  1864→    });
  1865→    process.stdin.resume();
  1866→  });
  1867→}
  1868→
  1869→/**
  1870→ * Parse bulk input (JSONL or JSON array)
  1871→ */
  1872→function parseBulkInput(input: string): PatchOperation[] {
  1873→  const trimmed = input.trim();
  1874→
  1875→  // Try JSON array first
  1876→  if (trimmed.startsWith("[")) {
  1877→    const parsed = JSON.parse(trimmed);
  1878→    if (!Array.isArray(parsed)) {
  1879→      throw new Error(errors.validation.expectedJsonArray);
  1880→    }
  1881→    return parsed.map((item, i) => validatePatchOperation(item, i));
  1882→  }
  1883→
  1884→  // Parse as JSONL (one JSON object per line)
  1885→  const lines = trimmed.split("\n").filter((line) => line.trim());
  1886→  return lines.map((line, i) => {
  1887→    try {
  1888→      return validatePatchOperation(JSON.parse(line), i);
  1889→    } catch (err) {
  1890→      throw new Error(
  1891→        errors.validation.jsonLineError(
  1892→          i + 1,
  1893→          err instanceof Error ? err.message : "Invalid JSON",
  1894→        ),
  1895→      );
  1896→    }
  1897→  });
  1898→}
  1899→
  1900→/**
  1901→ * Validate a patch operation object
  1902→ */
  1903→function validatePatchOperation(obj: unknown, index: number): PatchOperation {
  1904→  if (!obj || typeof obj !== "object") {
  1905→    throw new Error(errors.validation.patchMustBeObject(index));
  1906→  }
  1907→  const op = obj as Record<string, unknown>;
  1908→  if (typeof op.ref !== "string" || !op.ref) {
  1909→    throw new Error(errors.validation.patchMustHaveRef(index));
  1910→  }
  1911→  if (!op.data || typeof op.data !== "object") {
  1912→    throw new Error(errors.validation.patchMustHaveData(index));
  1913→  }
  1914→  return { ref: op.ref, data: op.data as Record<string, unknown> };
  1915→}
  1916→
  1917→/**
  1918→ * Format bulk patch result for human output
  1919→ */
  1920→function formatBulkPatchResult(
  1921→  result: BulkPatchResult,
  1922→  isDryRun = false,
  1923→): void {
  1924→  const prefix = isDryRun ? "Would patch" : "Patched";
  1925→
  1926→  for (const r of result.results) {
  1927→    if (r.status === "updated") {
  1928→      console.log(
  1929→        chalk.green("OK"),
  1930→        `${prefix}: ${r.ref} (${r.ulid?.slice(0, 8)})`,
  1931→      );
  1932→    } else if (r.status === "error") {
  1933→      console.log(chalk.red("ERR"), `${r.ref}: ${r.error}`);
  1934→    } else {
  1935→      console.log(chalk.gray("SKIP"), r.ref);
  1936→    }
  1937→  }
  1938→
  1939→  console.log("");
  1940→  console.log(chalk.bold("Summary:"));
  1941→  console.log(`  Total: ${result.summary.total}`);
  1942→  console.log(chalk.green(`  Updated: ${result.summary.updated}`));
  1943→  if (result.summary.failed > 0) {
  1944→    console.log(chalk.red(`  Failed: ${result.summary.failed}`));
  1945→  }
  1946→  if (result.summary.skipped > 0) {
  1947→    console.log(chalk.gray(`  Skipped: ${result.summary.skipped}`));
  1948→  }
  1949→}
  1950→

