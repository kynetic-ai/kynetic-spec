   360→/**
   361→ * Format completeness warnings for display
   362→ * AC: @spec-completeness ac-4
   363→ */
   364→function formatCompletenessWarnings(
   365→  warnings: CompletenessWarning[],
   366→  verbose: boolean,
   367→): void {
   368→  if (warnings.length === 0) {
   369→    console.log(chalk.green("Completeness: OK"));
   370→    return;
   371→  }
   372→
   373→  console.log(chalk.yellow(`\nCompleteness warnings: ${warnings.length}`));
   374→
   375→  // Group by type
   376→  const missingAC = warnings.filter(
   377→    (w) => w.type === "missing_acceptance_criteria",
   378→  );
   379→  const missingDesc = warnings.filter((w) => w.type === "missing_description");
   380→  const statusMismatch = warnings.filter(
   381→    (w) => w.type === "status_inconsistency",
   382→  );
   383→  const missingTestCoverage = warnings.filter(
   384→    (w) => w.type === "missing_test_coverage",
   385→  );
   386→  const automationNoSpec = warnings.filter(
   387→    (w) => w.type === "automation_eligible_no_spec",
   388→  );
   389→
   390→  // AC: @spec-completeness ac-4
   391→  // Show summary with counts by issue type
   392→  if (missingAC.length > 0) {
   393→    console.log(
   394→      chalk.yellow(`  Missing acceptance criteria: ${missingAC.length}`),
   395→    );
   396→    const shown = verbose ? missingAC : missingAC.slice(0, 3);
   397→    for (const w of shown) {
   398→      console.log(chalk.gray(`    ○ ${w.itemRef} - ${w.itemTitle}`));
   399→    }
   400→    if (!verbose && missingAC.length > 3) {
   401→      console.log(chalk.gray(`    ... and ${missingAC.length - 3} more`));
   402→    }
   403→  }
   404→
   405→  if (missingDesc.length > 0) {
   406→    console.log(chalk.yellow(`  Missing descriptions: ${missingDesc.length}`));
   407→    const shown = verbose ? missingDesc : missingDesc.slice(0, 3);
   408→    for (const w of shown) {
   409→      console.log(chalk.gray(`    ○ ${w.itemRef} - ${w.itemTitle}`));
   410→    }
   411→    if (!verbose && missingDesc.length > 3) {
   412→      console.log(chalk.gray(`    ... and ${missingDesc.length - 3} more`));
   413→    }
   414→  }
   415→
   416→  if (statusMismatch.length > 0) {
   417→    console.log(
   418→      chalk.yellow(`  Status inconsistencies: ${statusMismatch.length}`),
   419→    );
   420→    for (const w of statusMismatch) {
   421→      console.log(chalk.yellow(`    ! ${w.message}`));
   422→      if (w.details) {
   423→        console.log(chalk.gray(`      ${w.details}`));
   424→      }
   425→    }
   426→  }
   427→
   428→  if (missingTestCoverage.length > 0) {
   429→    console.log(
   430→      chalk.yellow(`  Missing test coverage: ${missingTestCoverage.length}`),
   431→    );
   432→    const shown = verbose
   433→      ? missingTestCoverage
   434→      : missingTestCoverage.slice(0, 3);
   435→    for (const w of shown) {
   436→      console.log(chalk.yellow(`    ! ${w.itemRef} - ${w.itemTitle}`));
   437→      if (w.details) {
   438→        console.log(chalk.gray(`      ${w.details}`));
   439→      }
   440→    }
   441→    if (!verbose && missingTestCoverage.length > 3) {
   442→      console.log(
   443→        chalk.gray(`    ... and ${missingTestCoverage.length - 3} more`),
   444→      );
   445→    }
   446→  }
   447→
   448→  // AC: @task-automation-eligibility ac-21, ac-23
   449→  if (automationNoSpec.length > 0) {
   450→    console.log(
   451→      chalk.yellow(`  Automation without spec: ${automationNoSpec.length}`),
   452→    );
   453→    const shown = verbose ? automationNoSpec : automationNoSpec.slice(0, 3);
   454→    for (const w of shown) {
   455→      console.log(chalk.yellow(`    ! ${w.itemRef} - ${w.itemTitle}`));
   456→      console.log(chalk.gray(`      ${w.message}`));
   457→    }
   458→    if (!verbose && automationNoSpec.length > 3) {
   459→      console.log(
   460→        chalk.gray(`    ... and ${automationNoSpec.length - 3} more`),
   461→      );
   462→    }
   463→  }
   464→}
