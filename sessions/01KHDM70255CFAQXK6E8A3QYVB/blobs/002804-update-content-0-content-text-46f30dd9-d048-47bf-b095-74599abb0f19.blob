   514→/**
   515→ * Format fix results for display
   516→ */
   517→function formatFixResult(result: FixResult): void {
   518→  if (result.fixesApplied.length === 0) {
   519→    console.log(chalk.gray("\nNo auto-fixable issues found."));
   520→    return;
   521→  }
   522→
   523→  console.log(
   524→    chalk.cyan(
   525→      `\n✓ Applied ${result.fixesApplied.length} fix(es) to ${result.filesModified} file(s):`,
   526→    ),
   527→  );
   528→
   529→  for (const fix of result.fixesApplied) {
   530→    const typeLabel = {
   531→      ulid_regenerated: "ULID regenerated",
   532→      timestamp_added: "Timestamp added",
   533→      status_added: "Status added",
   534→    }[fix.type];
   535→
   536→    const shortFile = path.basename(fix.file);
   537→    console.log(chalk.cyan(`  ✓ ${shortFile}:${fix.path} - ${typeLabel}`));
   538→  }
   539→
   540→  if (result.errors.length > 0) {
   541→    console.log(chalk.yellow(`\nFix errors: ${result.errors.length}`));
   542→    for (const err of result.errors) {
   543→      console.log(chalk.yellow(`  ! ${err.file}: ${err.message}`));
   544→    }
   545→  }
   546→}
   547→
   548→/**
   549→ * Collect all files that can be fixed
   550→ */
   551→async function collectFixableFiles(ctx: {
   552→  rootDir: string;
   553→  specDir?: string;
   554→  manifest?: { includes?: string[] } | null;
   555→  manifestPath?: string | null;
   556→}): Promise<string[]> {
   557→  const files: string[] = [];
   558→
   559→  // Task files (exclude test fixtures)
   560→  const taskFiles = await findTaskFiles(ctx.rootDir);
   561→  const specTaskFiles = await findTaskFiles(path.join(ctx.rootDir, "spec"));
   562→  const allTaskFiles = [...new Set([...taskFiles, ...specTaskFiles])];
   563→  files.push(
   564→    ...allTaskFiles.filter(
   565→      (f) => !f.includes("fixtures") && !f.includes("test"),
   566→    ),
   567→  );
   568→
   569→  // Spec files from includes
   570→  if (ctx.manifest && ctx.manifestPath) {
   571→    const manifestDir = path.dirname(ctx.manifestPath);
   572→    const includes = ctx.manifest.includes || [];
   573→
   574→    for (const include of includes) {
   575→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   576→      files.push(...expandedPaths);
   577→    }
   578→  }
   579→
   580→  // Inbox file
   581→  const inboxPath = path.join(ctx.rootDir, "spec", "kynetic.inbox.yaml");
   582→  try {
   583→    await import("node:fs/promises").then((fs) => fs.access(inboxPath));
   584→    files.push(inboxPath);
   585→  } catch {
   586→    // Inbox file doesn't exist, skip
   587→  }
   588→
   589→  return [...new Set(files)];
   590→}
   591→
   592→/**
   593→ * Format validation result for display
   594→ */
   595→function formatValidationResult(
   596→  result: ValidationResult,
   597→  verbose: boolean,
   598→): void {
   599→  // Header
   600→  if (result.valid) {
   601→    console.log(chalk.green.bold("✓ Validation passed"));
   602→  } else {
   603→    console.log(chalk.red.bold("✗ Validation failed"));
   604→  }
   605→
   606→  console.log(chalk.gray("─".repeat(40)));
   607→  console.log(`Files checked: ${result.stats.filesChecked}`);
   608→  console.log(`Items checked: ${result.stats.itemsChecked}`);
   609→  console.log(`Tasks checked: ${result.stats.tasksChecked}`);
   610→
   611→  // AC-meta-manifest-2: Display meta summary line
   612→  if (result.metaStats) {
   613→    console.log(
   614→      `Meta: ${result.metaStats.agents} agents, ${result.metaStats.workflows} workflows, ${result.metaStats.conventions} conventions`,
   615→    );
   616→  }
   617→
   618→  // Schema errors
   619→  if (result.schemaErrors.length > 0) {
   620→    console.log(chalk.red(`\nSchema errors: ${result.schemaErrors.length}`));
   621→    for (const err of result.schemaErrors) {
   622→      const location = err.path ? `${err.file}:${err.path}` : err.file;
   623→      console.log(chalk.red(`  ✗ ${location}`));
   624→      console.log(chalk.gray(`    ${err.message}`));
   625→      if (verbose && err.details) {
   626→        console.log(chalk.gray(`    ${JSON.stringify(err.details)}`));
   627→      }
   628→    }
   629→  } else {
   630→    console.log(chalk.green("\nSchema: OK"));
   631→  }
   632→
   633→  // Reference errors
   634→  if (result.refErrors.length > 0) {
   635→    console.log(chalk.red(`\nReference errors: ${result.refErrors.length}`));
   636→    for (const err of result.refErrors) {
   637→      const location = err.sourceFile
   638→        ? `${err.sourceFile} (${err.field})`
   639→        : `${err.sourceUlid?.slice(0, 8)} (${err.field})`;
   640→      console.log(chalk.red(`  ✗ ${err.ref}`));
   641→      console.log(chalk.gray(`    ${err.message}`));
   642→      console.log(chalk.gray(`    in: ${location}`));
   643→    }
   644→  } else {
   645→    console.log(chalk.green("References: OK"));
   646→  }
   647→
   648→  // Reference warnings (deprecated targets)
   649→  if (result.refWarnings.length > 0) {
   650→    console.log(
   651→      chalk.yellow(`\nReference warnings: ${result.refWarnings.length}`),
   652→    );
   653→    const shown = verbose ? result.refWarnings : result.refWarnings.slice(0, 5);
   654→    for (const warn of shown) {
   655→      const location = warn.sourceFile
   656→        ? `${warn.sourceFile} (${warn.field})`
   657→        : `${warn.sourceUlid?.slice(0, 8)} (${warn.field})`;
   658→      console.log(chalk.yellow(`  ⚠ ${warn.ref}`));
   659→      console.log(chalk.gray(`    ${warn.message}`));
   660→      console.log(chalk.gray(`    in: ${location}`));
   661→    }
   662→    if (!verbose && result.refWarnings.length > 5) {
   663→      console.log(
   664→        chalk.gray(
   665→          `  ... and ${result.refWarnings.length - 5} more (use -v to see all)`,
   666→        ),
   667→      );
   668→    }
   669→  }
   670→
   671→  // AC: @trait-edge-cases ac-2
   672→  // Trait cycle errors
   673→  if (result.traitCycleErrors.length > 0) {
   674→    console.log(
   675→      chalk.red(`\nTrait cycle errors: ${result.traitCycleErrors.length}`),
   676→    );
   677→    for (const err of result.traitCycleErrors) {
   678→      console.log(chalk.red(`  ✗ ${err.traitRef} - ${err.traitTitle}`));
   679→      console.log(chalk.gray(`    ${err.message}`));
   680→    }
   681→  }
   682→
   683→  // Orphans (warnings, not errors)
   684→  if (result.orphans.length > 0) {
   685→    console.log(
   686→      chalk.yellow(`\nOrphans (not referenced): ${result.orphans.length}`),
   687→    );
   688→    if (verbose) {
   689→      for (const orphan of result.orphans) {
   690→        console.log(
   691→          chalk.yellow(
   692→            `  ○ ${orphan.ulid.slice(0, 8)} [${orphan.type}] ${orphan.title}`,
   693→          ),
   694→        );
   695→      }
   696→    } else {
   697→      // Show first few
   698→      const shown = result.orphans.slice(0, 5);
   699→      for (const orphan of shown) {
   700→        console.log(
   701→          chalk.yellow(
   702→            `  ○ ${orphan.ulid.slice(0, 8)} [${orphan.type}] ${orphan.title}`,
   703→          ),
   704→        );
   705→      }
   706→      if (result.orphans.length > 5) {
   707→        console.log(
   708→          chalk.gray(
   709→            `  ... and ${result.orphans.length - 5} more (use -v to see all)`,
   710→          ),
   711→        );
   712→      }
   713→    }
   714→  }
   715→}
   716→
   717→/**
   718→ * Register validate command
   719→ */
   720→export function registerValidateCommand(program: Command): void {
   721→  program
   722→    .command("validate")
   723→    .description("Validate spec files")
   724→    .option("--schema", "Check schema conformance only")
   725→    .option("--refs", "Check reference resolution only")
   726→    .option("--orphans", "Find orphaned items only")
   727→    .option("--alignment", "Check spec-task alignment")
   728→    .option(
   729→      "--completeness",
   730→      "Check spec completeness (missing AC, descriptions, status inconsistencies)",
   731→    )
   732→    .option("--conventions", "Validate conventions")
   733→    .option(
   734→      "--staleness",
   735→      "Check for stale status mismatches between specs and tasks",
   736→    )
   737→    .option("--skills", "Validate skill files (.claude/skills/*/SKILL.md)")
   738→    .option(
   739→      "--fix",
   740→      "Auto-fix issues where possible (invalid ULIDs, missing timestamps)",
   741→    )
   742→    .option("-v, --verbose", "Show detailed output")
   743→    .option("--strict", "Treat orphans and staleness warnings as errors")
   744→    .action(async (options) => {
   745→      try {
   746→        const ctx = await initContext();
   747→
   748→        if (!ctx.manifestPath) {
   749→          error(validationStrings.noManifest);
   750→          console.log(validationStrings.initHint);
   751→          process.exit(EXIT_CODES.ERROR);
   752→        }
   753→
   754→        // Track warnings from all sources for exit code determination
   755→        let additionalWarningCount = 0;
   756→
   757→        // Determine which checks to run
   758→        const runAll =
   759→          !options.schema &&
   760→          !options.refs &&
   761→          !options.orphans &&
   762→          !options.alignment &&
   763→          !options.completeness &&
   764→          !options.conventions &&
   765→          !options.skills;
   766→        const validateOptions = {
   767→          schema: runAll || options.schema,
   768→          refs: runAll || options.refs,
   769→          orphans: runAll || options.orphans,
   770→          completeness: runAll || options.completeness,
   771→        };
   772→
   773→        const result = await validate(ctx, validateOptions);
   774→
   775→        // In strict mode, orphans are errors
   776→        if (options.strict && result.orphans.length > 0) {
   777→          result.valid = false;
   778→        }
   779→
   780→        output(result, () => formatValidationResult(result, options.verbose));
   781→
   782→        // Run auto-fix if requested
   783→        if (options.fix) {
   784→          const filesToFix = await collectFixableFiles(ctx);
   785→          const fixResult = await fixFiles(filesToFix);
   786→          formatFixResult(fixResult);
   787→
   788→          // Re-run validation after fixes to show updated status
   789→          if (fixResult.fixesApplied.length > 0) {
   790→            console.log(validationStrings.revalidating);
   791→            const revalidateResult = await validate(ctx, validateOptions);
   792→            if (revalidateResult.valid) {
   793→              console.log(validationStrings.nowPasses);
   794→            } else {
   795→              console.log(validationStrings.issuesRemain);
   796→            }
   797→            // Update result for exit code
   798→            result.valid = revalidateResult.valid;
   799→            result.schemaErrors = revalidateResult.schemaErrors;
   800→            result.refErrors = revalidateResult.refErrors;
   801→          }
   802→        }
   803→
   804→        // Run alignment check if requested or running all checks
   805→        if (options.alignment || runAll) {
   806→          const tasks = await loadAllTasks(ctx);
   807→          const items = await loadAllItems(ctx);
   808→          const refIndex = new ReferenceIndex(tasks, items);
   809→          const alignmentIndex = new AlignmentIndex(tasks, items);
   810→          alignmentIndex.buildLinks(refIndex);
   811→
   812→          const alignmentWarnings = alignmentIndex.findAlignmentWarnings();
   813→          formatAlignmentWarnings(alignmentWarnings, options.verbose);
   814→          additionalWarningCount += alignmentWarnings.length;
   815→
   816→          // Show alignment stats
   817→          const stats = alignmentIndex.getStats();
   818→          console.log(
   819→            validationStrings.alignmentStats(
   820→              stats.specsWithTasks,
   821→              stats.totalSpecs,
   822→              stats.alignedSpecs,
   823→            ),
   824→          );
   825→        }
   826→
   827→        // Show completeness warnings if any
   828→        // AC: @spec-completeness ac-4
   829→        if (result.completenessWarnings.length > 0) {
   830→          formatCompletenessWarnings(
   831→            result.completenessWarnings,
   832→            options.verbose,
   833→          );
   834→        }
   835→
   836→        // Run convention validation if requested
   837→        // AC: @convention-definitions ac-3, ac-4
   838→        if (options.conventions) {
   839→          try {
   840→            const metaCtx = await loadMetaContext(ctx);
   841→            if (metaCtx && metaCtx.conventions.length > 0) {
   842→              // For now, we just validate that conventions are well-formed
   843→              // Full validation against actual content (commits, notes, etc.)
   844→              // would require additional content gathering logic
   845→              const conventionResult = validateConventions(
   846→                metaCtx.conventions,
   847→                {},
   848→              );
   849→              formatConventionValidationResult(conventionResult);
   850→
   851→              if (!conventionResult.valid) {
   852→                result.valid = false;
   853→              }
   854→            } else {
   855→              console.log(
   856→                chalk.gray("No conventions defined in meta manifest"),
   857→              );
   858→            }
   859→          } catch (_err) {
   860→            console.log(
   861→              chalk.yellow(
   862→                "Warning: Could not load meta manifest for convention validation",
   863→              ),
   864→            );
   865→          }
   866→        }
   867→
   868→        // Run staleness checks if requested
   869→        // AC: @stale-status-detection ac-4, ac-5
   870→        let stalenessWarningCount = 0;
   871→        if (options.staleness) {
   872→          const tasks = await loadAllTasks(ctx);
   873→          const items = await loadAllItems(ctx);
   874→          const refIndex = new ReferenceIndex(tasks, items);
   875→
   876→          const stalenessWarnings = checkStaleness(items, tasks, refIndex);
   877→          formatStalenessWarnings(stalenessWarnings, options.verbose);
   878→          stalenessWarningCount = stalenessWarnings.length;
   879→
   880→          // AC: @stale-status-detection ac-5 (staleness-exit-code)
   881→          // With --strict, staleness warnings cause validation failure
   882→          if (options.strict && stalenessWarnings.length > 0) {
   883→            result.valid = false;
   884→          }
   885→        }
   886→
   887→        // Run skill file validation if requested or running all checks
   888→        if (runAll || options.skills) {
   889→          const skillResult = await validateSkills(ctx.rootDir);
   890→          formatSkillValidationResult(skillResult, options.verbose);
   891→
   892→          if (!skillResult.valid) {
   893→            result.valid = false;
   894→          }
   895→        }
   896→
   897→        // Determine exit code based on errors vs warnings
   898→        // Errors: schema, refs, trait cycles, conventions, skills (result.valid = false)
   899→        // Warnings: orphans, alignment, completeness, staleness, ref warnings
   900→        const hasErrors = !result.valid;
   901→        const hasWarnings =
   902→          result.orphans.length > 0 ||
   903→          result.refWarnings.length > 0 ||
   904→          result.completenessWarnings.length > 0 ||
   905→          additionalWarningCount > 0 ||
   906→          stalenessWarningCount > 0;
   907→
   908→        if (hasErrors) {
   909→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   910→        } else if (hasWarnings) {
   911→          process.exit(EXIT_CODES.VALIDATION_WARNINGS);
   912→        }
   913→        // Otherwise exit 0 (success)
   914→      } catch (err) {
   915→        error(validationStrings.failed, err);
   916→        process.exit(EXIT_CODES.ERROR);
   917→      }
   918→    });
   919→
   920→  // Alias: kspec lint
   921→  program
   922→    .command("lint")
   923→    .description("Alias for validate with style checks")
   924→    .option("--schema", "Check schema conformance only")
   925→    .option("--refs", "Check reference resolution only")
   926→    .option("--orphans", "Find orphaned items only")
   927→    .option(
   928→      "--completeness",
   929→      "Check spec completeness (missing AC, descriptions, status inconsistencies)",
   930→    )
   931→    .option(
   932→      "--fix",
   933→      "Auto-fix issues where possible (invalid ULIDs, missing timestamps)",
   934→    )
   935→    .option("-v, --verbose", "Show detailed output")
   936→    .option("--strict", "Treat orphans as errors")
   937→    .action(async (options) => {
   938→      try {
   939→        const ctx = await initContext();
   940→
   941→        if (!ctx.manifestPath) {
   942→          error(validationStrings.noManifest);
   943→          process.exit(EXIT_CODES.ERROR);
   944→        }
   945→
   946→        const runAll =
   947→          !options.schema &&
   948→          !options.refs &&
   949→          !options.orphans &&
   950→          !options.completeness;
   951→        const validateOptions = {
   952→          schema: runAll || options.schema,
   953→          refs: runAll || options.refs,
   954→          orphans: runAll || options.orphans,
   955→          completeness: runAll || options.completeness,
   956→        };
   957→
   958→        const result = await validate(ctx, validateOptions);
   959→
   960→        if (options.strict && result.orphans.length > 0) {
   961→          result.valid = false;
   962→        }
   963→
   964→        output(result, () => formatValidationResult(result, options.verbose));
   965→
   966→        // Run auto-fix if requested
   967→        if (options.fix) {
   968→          const filesToFix = await collectFixableFiles(ctx);
   969→          const fixResult = await fixFiles(filesToFix);
   970→          formatFixResult(fixResult);
   971→
   972→          // Re-run validation after fixes
   973→          if (fixResult.fixesApplied.length > 0) {
   974→            console.log(validationStrings.revalidating);
   975→            const revalidateResult = await validate(ctx, validateOptions);
   976→            if (revalidateResult.valid) {
   977→              console.log(validationStrings.nowPasses);
   978→            } else {
   979→              console.log(validationStrings.issuesRemain);
   980→            }
   981→            result.valid = revalidateResult.valid;
   982→          }
   983→        }
   984→
   985→        // Determine exit code based on errors vs warnings
   986→        const hasErrors = !result.valid;
   987→        const hasWarnings =
   988→          result.orphans.length > 0 ||
   989→          result.refWarnings.length > 0 ||
   990→          result.completenessWarnings.length > 0;
   991→
   992→        if (hasErrors) {
   993→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   994→        } else if (hasWarnings) {
   995→          process.exit(EXIT_CODES.VALIDATION_WARNINGS);
   996→        }
   997→        // Otherwise exit 0 (success)
   998→      } catch (err) {
   999→        error(validationStrings.lintFailed, err);
  1000→        process.exit(EXIT_CODES.ERROR);
  1001→      }
  1002→    });
  1003→}
