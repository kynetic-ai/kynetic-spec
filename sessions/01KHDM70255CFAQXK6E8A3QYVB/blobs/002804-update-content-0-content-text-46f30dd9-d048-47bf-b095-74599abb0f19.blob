   466→/**
   467→ * Format alignment warnings for display
   468→ */
   469→function formatAlignmentWarnings(
   470→  warnings: AlignmentWarning[],
   471→  verbose: boolean,
   472→): void {
   473→  if (warnings.length === 0) {
   474→    console.log(chalk.green("Alignment: OK"));
   475→    return;
   476→  }
   477→
   478→  console.log(chalk.yellow(`\nAlignment warnings: ${warnings.length}`));
   479→
   480→  // Group by type
   481→  const orphaned = warnings.filter((w) => w.type === "orphaned_spec");
   482→  const mismatches = warnings.filter((w) => w.type === "status_mismatch");
   483→  const stale = warnings.filter((w) => w.type === "stale_implementation");
   484→
   485→  if (orphaned.length > 0) {
   486→    console.log(
   487→      chalk.yellow(`  Orphaned specs (no tasks): ${orphaned.length}`),
   488→    );
   489→    const shown = verbose ? orphaned : orphaned.slice(0, 3);
   490→    for (const w of shown) {
   491→      console.log(chalk.gray(`    ○ ${w.specTitle}`));
   492→    }
   493→    if (!verbose && orphaned.length > 3) {
   494→      console.log(chalk.gray(`    ... and ${orphaned.length - 3} more`));
   495→    }
   496→  }
   497→
   498→  if (mismatches.length > 0) {
   499→    console.log(chalk.yellow(`  Status mismatches: ${mismatches.length}`));
   500→    for (const w of mismatches) {
   501→      console.log(chalk.yellow(`    ! ${w.specTitle}`));
   502→      console.log(chalk.gray(`      ${w.message}`));
   503→    }
   504→  }
   505→
   506→  if (stale.length > 0) {
   507→    console.log(chalk.yellow(`  Stale implementation status: ${stale.length}`));
   508→    for (const w of stale) {
   509→      console.log(chalk.yellow(`    ! ${w.message}`));
   510→    }
   511→  }
   512→}
