    30→
    31→/**
    32→ * Staleness warning types
    33→ * AC: @stale-status-detection
    34→ */
    35→interface StalenessWarning {
    36→  type:
    37→    | "parent-pending-children-done"
    38→    | "spec-implemented-no-task"
    39→    | "task-done-spec-not-started"
    40→    | "automation-blocking";
    41→  message: string;
    42→  refs: string[];
    43→}
    44→
    45→/**
    46→ * Check for stale status mismatches between specs and tasks
    47→ * AC: @stale-status-detection ac-1, ac-2, ac-3
    48→ */
    49→function checkStaleness(
    50→  items: LoadedSpecItem[],
    51→  tasks: LoadedTask[],
    52→  refIndex: ReferenceIndex,
    53→): StalenessWarning[] {
    54→  const warnings: StalenessWarning[] = [];
    55→
    56→  // AC: @stale-status-detection ac-1 (parent-pending-children-done)
    57→  // Check if task with dependencies is pending but all dependencies are completed
    58→  for (const task of tasks) {
    59→    // Only check pending/in_progress tasks with dependencies
    60→    if (task.status !== "pending" && task.status !== "in_progress") continue;
    61→    if (!task.depends_on || task.depends_on.length === 0) continue;
    62→
    63→    // Resolve all dependency tasks
    64→    const depTasks = task.depends_on
    65→      .map((depRef) => {
    66→        const result = refIndex.resolve(depRef);
    67→        if (!result.ok) return null;
    68→        return tasks.find((t) => t._ulid === result.ulid);
    69→      })
    70→      .filter((t): t is LoadedTask => t !== null);
    71→
    72→    if (depTasks.length === 0) continue;
    73→
    74→    // Check if all dependencies are completed and their linked specs are implemented
    75→    const allDepsDone = depTasks.every((depTask) => {
    76→      if (depTask.status !== "completed") return false;
    77→
    78→      // If the dep task has a spec_ref, check if that spec is implemented
    79→      if (depTask.spec_ref) {
    80→        const result = refIndex.resolve(depTask.spec_ref);
    81→        if (!result.ok) return true; // Missing spec ref doesn't block
    82→        const spec = items.find((item) => item._ulid === result.ulid);
    83→        return spec?.status?.implementation === "implemented";
    84→      }
    85→      return true;
    86→    });
    87→
    88→    if (allDepsDone) {
    89→      const taskRef = task.slugs[0] || refIndex.shortUlid(task._ulid);
    90→      warnings.push({
    91→        type: "parent-pending-children-done",
    92→        message: `Task @${taskRef} is ${task.status} but all dependencies are completed. Consider completing or reviewing.`,
    93→        refs: [task._ulid],
    94→      });
    95→    }
    96→  }
    97→
    98→  // AC: @stale-status-detection ac-2 (spec-implemented-no-task)
    99→  // Check if spec is implemented but has no completed tasks
   100→  for (const item of items) {
   101→    if (item.status?.implementation !== "implemented") continue;
   102→
   103→    // AC: @trait-retrospective ac-1
   104→    // Skip retrospective specs from staleness warnings
   105→    const isRetrospective = item.traits?.includes("@trait-retrospective");
   106→    if (isRetrospective) continue;
   107→
   108→    // Find completed tasks that reference this spec
   109→    const completedTasks = tasks.filter((task) => {
   110→      if (task.status !== "completed" || !task.spec_ref) return false;
   111→      const result = refIndex.resolve(task.spec_ref);
   112→      return result.ok && result.ulid === item._ulid;
   113→    });
   114→
   115→    if (completedTasks.length === 0) {
   116→      const specRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
   117→      warnings.push({
   118→        type: "spec-implemented-no-task",
   119→        message: `Spec @${specRef} is implemented but has no completed tasks. Verify implementation or link existing task.`,
   120→        refs: [item._ulid],
   121→      });
   122→    }
   123→  }
   124→
   125→  // AC: @stale-status-detection ac-3 (task-done-spec-not-started)
   126→  // Check if task is completed but spec is still not_started
   127→  for (const task of tasks) {
   128→    if (task.status !== "completed") continue;
   129→    if (!task.spec_ref) continue;
   130→
   131→    // Resolve spec reference
   132→    const result = refIndex.resolve(task.spec_ref);
   133→    if (!result.ok) continue;
   134→
   135→    const spec = items.find((item) => item._ulid === result.ulid);
   136→    if (!spec) continue;
   137→
   138→    if (spec.status?.implementation === "not_started") {
   139→      const taskRef = task.slugs[0] || refIndex.shortUlid(task._ulid);
   140→      const specRef = spec.slugs[0] || refIndex.shortUlid(spec._ulid);
   141→      warnings.push({
   142→        type: "task-done-spec-not-started",
   143→        message: `Task @${taskRef} completed but spec @${specRef} is not_started. Update spec status.`,
   144→        refs: [task._ulid, spec._ulid],
   145→      });
   146→    }
   147→  }
   148→
   149→  // AC: @validation ac-1
   150→  // Check for manual_only parents blocking eligible children
   151→  for (const parentTask of tasks) {
   152→    if (parentTask.automation !== "manual_only") continue;
   153→
   154→    // Find tasks that depend on this parent
   155→    const dependentTasks = tasks.filter((t) =>
   156→      t.depends_on?.some((depRef) => {
   157→        const result = refIndex.resolve(depRef);
   158→        return result.ok && result.ulid === parentTask._ulid;
   159→      }),
   160→    );
   161→
   162→    // Filter for eligible children
   163→    const eligibleChildren = dependentTasks.filter(
   164→      (t) => t.automation === "eligible",
   165→    );
   166→
   167→    if (eligibleChildren.length > 0) {
   168→      const parentRef =
   169→        parentTask.slugs[0] || refIndex.shortUlid(parentTask._ulid);
   170→      const childRefs = eligibleChildren.map(
   171→        (c) => `@${c.slugs[0] || refIndex.shortUlid(c._ulid)}`,
   172→      );
   173→
   174→      warnings.push({
   175→        type: "automation-blocking",
   176→        message: `Task @${parentRef} is manual_only and blocks ${eligibleChildren.length} eligible child task(s): ${childRefs.join(", ")}`,
   177→        refs: [parentTask._ulid, ...eligibleChildren.map((c) => c._ulid)],
   178→      });
   179→    }
   180→  }
   181→
   182→  return warnings;
   183→}
   184→
   185→/**
   186→ * Format staleness warnings for display
   187→ * AC: @stale-status-detection ac-4
   188→ */
   189→function formatStalenessWarnings(
   190→  warnings: StalenessWarning[],
   191→  verbose: boolean,
   192→): void {
   193→  if (warnings.length === 0) {
   194→    console.log(chalk.green("Staleness: OK"));
   195→    return;
   196→  }
   197→
   198→  console.log(chalk.yellow(`\nStaleness warnings: ${warnings.length}`));
   199→
   200→  // Group by type
   201→  const parentPending = warnings.filter(
   202→    (w) => w.type === "parent-pending-children-done",
   203→  );
   204→  const specNoTask = warnings.filter(
   205→    (w) => w.type === "spec-implemented-no-task",
   206→  );
   207→  const taskDoneSpecNot = warnings.filter(
   208→    (w) => w.type === "task-done-spec-not-started",
   209→  );
   210→  const automationBlocking = warnings.filter(
   211→    (w) => w.type === "automation-blocking",
   212→  );
   213→
   214→  if (parentPending.length > 0) {
   215→    console.log(
   216→      chalk.yellow(`  Parent pending, children done: ${parentPending.length}`),
   217→    );
   218→    const shown = verbose ? parentPending : parentPending.slice(0, 3);
   219→    for (const w of shown) {
   220→      console.log(chalk.yellow(`    ! ${w.message}`));
   221→    }
   222→    if (!verbose && parentPending.length > 3) {
   223→      console.log(chalk.gray(`    ... and ${parentPending.length - 3} more`));
   224→    }
   225→  }
   226→
   227→  if (specNoTask.length > 0) {
   228→    console.log(
   229→      chalk.yellow(`  Spec implemented, no task: ${specNoTask.length}`),
   230→    );
   231→    const shown = verbose ? specNoTask : specNoTask.slice(0, 3);
   232→    for (const w of shown) {
   233→      console.log(chalk.yellow(`    ! ${w.message}`));
   234→    }
   235→    if (!verbose && specNoTask.length > 3) {
   236→      console.log(chalk.gray(`    ... and ${specNoTask.length - 3} more`));
   237→    }
   238→  }
   239→
   240→  if (taskDoneSpecNot.length > 0) {
   241→    console.log(
   242→      chalk.yellow(`  Task done, spec not started: ${taskDoneSpecNot.length}`),
   243→    );
   244→    const shown = verbose ? taskDoneSpecNot : taskDoneSpecNot.slice(0, 3);
   245→    for (const w of shown) {
   246→      console.log(chalk.yellow(`    ! ${w.message}`));
   247→    }
   248→    if (!verbose && taskDoneSpecNot.length > 3) {
   249→      console.log(chalk.gray(`    ... and ${taskDoneSpecNot.length - 3} more`));
   250→    }
   251→  }
   252→
   253→  if (automationBlocking.length > 0) {
   254→    console.log(
   255→      chalk.yellow(`  Automation blocking: ${automationBlocking.length}`),
   256→    );
   257→    const shown = verbose ? automationBlocking : automationBlocking.slice(0, 3);
   258→    for (const w of shown) {
   259→      console.log(chalk.yellow(`    ! ${w.message}`));
   260→    }
   261→    if (!verbose && automationBlocking.length > 3) {
   262→      console.log(
   263→        chalk.gray(`    ... and ${automationBlocking.length - 3} more`),
   264→      );
   265→    }
   266→  }
   267→}
