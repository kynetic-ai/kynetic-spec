   269→/**
   270→ * Format convention validation results for display
   271→ * AC: @convention-definitions ac-3, ac-4
   272→ */
   273→function formatConventionValidationResult(
   274→  result: ConventionValidationResult,
   275→): void {
   276→  if (result.valid && result.skipped.length === 0) {
   277→    console.log(chalk.green("Conventions: OK"));
   278→    return;
   279→  }
   280→
   281→  // AC: @convention-definitions ac-4
   282→  // Skipped prose conventions
   283→  if (result.skipped.length > 0) {
   284→    for (const domain of result.skipped) {
   285→      console.log(chalk.gray(`ℹ Skipping prose convention: ${domain}`));
   286→    }
   287→  }
   288→
   289→  // AC: @convention-definitions ac-3
   290→  // Validation errors
   291→  if (result.errors.length > 0) {
   292→    console.log(chalk.red(`\nConvention violations: ${result.errors.length}`));
   293→    for (const err of result.errors) {
   294→      console.log(chalk.red(`  ✗ ${err.domain}`));
   295→      console.log(chalk.gray(`    ${err.message}`));
   296→      if (err.expected) {
   297→        console.log(chalk.gray(`    Expected: ${err.expected}`));
   298→      }
   299→      if (err.location) {
   300→        console.log(chalk.gray(`    Location: ${err.location}`));
   301→      }
   302→    }
   303→  } else {
   304→    console.log(chalk.green("\nConventions: OK"));
   305→  }
   306→
   307→  // Stats
   308→  console.log(
   309→    chalk.gray(`\nConventions checked: ${result.stats.conventionsChecked}`),
   310→  );
   311→  console.log(
   312→    chalk.gray(`Conventions skipped: ${result.stats.conventionsSkipped}`),
   313→  );
   314→}
   315→
   316→/**
   317→ * Format skill validation results for display
   318→ */
   319→function formatSkillValidationResult(
   320→  result: SkillValidationResult,
   321→  verbose: boolean,
   322→): void {
   323→  if (result.filesChecked === 0) {
   324→    console.log(chalk.gray("Skills: No skill files found"));
   325→    return;
   326→  }
   327→
   328→  if (result.valid) {
   329→    console.log(
   330→      chalk.green(`Skills: OK (${result.filesChecked} files checked)`),
   331→    );
   332→    return;
   333→  }
   334→
   335→  console.log(chalk.red(`\nSkill validation errors: ${result.errors.length}`));
   336→  console.log(chalk.gray(`Files checked: ${result.filesChecked}`));
   337→
   338→  // Group errors by file
   339→  const errorsByFile = new Map<string, typeof result.errors>();
   340→  for (const err of result.errors) {
   341→    const existing = errorsByFile.get(err.file) || [];
   342→    existing.push(err);
   343→    errorsByFile.set(err.file, existing);
   344→  }
   345→
   346→  for (const [file, errors] of errorsByFile.entries()) {
   347→    console.log(chalk.yellow(`\n  ${file}:`));
   348→    const shown = verbose ? errors : errors.slice(0, 5);
   349→    for (const err of shown) {
   350→      const location = err.line ? `:${err.line}` : "";
   351→      console.log(chalk.red(`    ✗ ${err.type}${location}`));
   352→      console.log(chalk.gray(`      ${err.message}`));
   353→    }
   354→    if (!verbose && errors.length > 5) {
   355→      console.log(chalk.gray(`    ... and ${errors.length - 5} more`));
   356→    }
   357→  }
   358→}
