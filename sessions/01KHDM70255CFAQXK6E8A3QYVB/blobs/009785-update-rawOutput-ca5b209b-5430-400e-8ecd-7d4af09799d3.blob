    44→  type ObservationType,
    45→  type WorkflowStep,
    46→  WorkflowStepSchema,
    47→} from "../../schema/index.js";
    48→import { errors } from "../../strings/errors.js";
    49→import { executeBatchOperation, formatBatchOutput } from "../batch.js";
    50→import { EXIT_CODES } from "../exit-codes.js";
    51→import { error, isJsonMode, output, success } from "../output.js";
    52→import { parseTagsArray } from "../parse-utils.js";
    53→import { parseIntOption } from "../validators.js";
    54→
    55→/**
    56→ * Resolve a meta reference to its ULID
    57→ * Handles semantic IDs (agent.id, workflow.id, convention.domain) and ULID prefixes
    58→ */
    59→function resolveMetaRefToUlid(
    60→  ref: string,
    61→  metaCtx: MetaContext,
    62→): {
    63→  ulid: string;
    64→  type: "agent" | "workflow" | "convention" | "observation";
    65→} | null {
    66→  const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
    67→
    68→  // Check agents
    69→  const agent = (metaCtx.agents || []).find(
    70→    (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef),
    71→  );
    72→  if (agent) return { ulid: agent._ulid, type: "agent" };
    73→
    74→  // Check workflows
    75→  const workflow = (metaCtx.workflows || []).find(
    76→    (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef),
    77→  );
    78→  if (workflow) return { ulid: workflow._ulid, type: "workflow" };
    79→
    80→  // Check conventions
    81→  const convention = (metaCtx.conventions || []).find(
    82→    (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef),
    83→  );
    84→  if (convention) return { ulid: convention._ulid, type: "convention" };
    85→
    86→  // Check observations
    87→  const observation = (metaCtx.observations || []).find((o) =>
    88→    o._ulid.startsWith(normalizedRef),
    89→  );
    90→  if (observation) return { ulid: observation._ulid, type: "observation" };
    91→
    92→  return null;
    93→}
    94→
    95→/**
    96→ * Batch-compatible resolver for observations.
    97→ * Returns null instead of calling process.exit() to allow partial failure handling.
    98→ * AC: @trait-multi-ref-batch ac-2, ac-8 - Partial failure handling and ref resolution
    99→ */
   100→function resolveObservationRefForBatch(
   101→  ref: string,
   102→  observations: Observation[],
   103→): { item: Observation | null; error?: string } {
   104→  const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
   105→  const observation = observations.find((o) =>
   106→    o._ulid.startsWith(normalizedRef),
   107→  );
   108→
   109→  if (!observation) {
   110→    return { item: null, error: `Observation not found: ${ref}` };
   111→  }
   112→
   113→  return { item: observation };
   114→}
   115→
   116→/**
   117→ * Format meta show output
   118→ */
   119→function formatMetaShow(meta: MetaContext): void {
   120→  const stats = getMetaStats(meta);
   121→
   122→  if (!meta.manifest) {
   123→    console.log(chalk.yellow("No meta manifest found (kynetic.meta.yaml)"));
   124→    console.log(
   125→      chalk.gray(
   126→        "Create one to define agents, workflows, conventions, and observations",
   127→      ),
   128→    );
   129→    return;
   130→  }
   131→
   132→  console.log(chalk.bold("Meta-Spec Summary"));
   133→  console.log(chalk.gray("─".repeat(40)));
   134→  console.log(`Agents:       ${stats.agents}`);
   135→  console.log(`Workflows:    ${stats.workflows}`);
   136→  console.log(`Conventions:  ${stats.conventions}`);
   137→  console.log(
   138→    `Observations: ${stats.observations} (${stats.unresolvedObservations} unresolved)`,
   139→  );
   140→}
   141→
   142→/**
   143→ * Format agents table output
   144→ * AC-agent-1: outputs table with columns: ID, Name, Capabilities
   145→ */
   146→function formatAgents(agents: Agent[]): void {
   147→  if (agents.length === 0) {
   148→    console.log(chalk.yellow("No agents defined"));
   149→    return;
   150→  }
   151→
   152→  const table = new Table({
   153→    head: [chalk.bold("ID"), chalk.bold("Name"), chalk.bold("Capabilities")],
   154→    style: {
   155→      head: [],
   156→      border: [],
   157→    },
   158→  });
   159→
   160→  for (const agent of agents) {
   161→    table.push([agent.id, agent.name, agent.capabilities.join(", ")]);
   162→  }
   163→
   164→  console.log(table.toString());
   165→}
   166→
   167→/**
   168→ * Format workflows table output
   169→ * AC-workflow-1: outputs table with columns: ID, Trigger, Steps (count), Mode
   170→ */
   171→function formatWorkflows(workflows: Workflow[]): void {
   172→  if (workflows.length === 0) {
   173→    console.log(chalk.yellow("No workflows defined"));
   174→    return;
   175→  }
   176→
   177→  const table = new Table({
   178→    head: [
   179→      chalk.bold("ID"),
   180→      chalk.bold("Trigger"),
   181→      chalk.bold("Steps"),
   182→      chalk.bold("Mode"),
   183→    ],
   184→    style: {
   185→      head: [],
   186→      border: [],
   187→    },
   188→  });
   189→
   190→  for (const workflow of workflows) {
   191→    table.push([
   192→      workflow.id,
   193→      workflow.trigger,
   194→      workflow.steps.length.toString(),
   195→      workflow.mode || "interactive",
   196→    ]);
   197→  }
   198→
   199→  console.log(table.toString());
   200→}
   201→
   202→/**
   203→ * Format workflows verbose output
   204→ * AC-workflow-2: outputs each workflow with full step list
   205→ * AC: @loop-mode-workflows ac-3 (shows based_on field)
   206→ */
   207→function formatWorkflowsVerbose(workflows: Workflow[]): void {
   208→  if (workflows.length === 0) {
   209→    console.log(chalk.yellow("No workflows defined"));
   210→    return;
   211→  }
   212→
   213→  for (const workflow of workflows) {
   214→    console.log(chalk.bold(`${workflow.id} - ${workflow.trigger}`));
   215→    // Show mode if it's loop (skip for interactive as it's default)
   216→    if (workflow.mode === "loop") {
   217→      console.log(chalk.cyan(`Mode: ${workflow.mode}`));
   218→    }
   219→    // AC: @loop-mode-workflows ac-3 - Show based_on reference
   220→    if (workflow.based_on) {
   221→      console.log(chalk.cyan(`Based on: ${workflow.based_on}`));
   222→    }
   223→    if (workflow.description) {
   224→      console.log(chalk.gray(workflow.description));
   225→    }
   226→    console.log(chalk.gray("─".repeat(60)));
   227→
   228→    for (const step of workflow.steps) {
   229→      const prefix = {
   230→        check: chalk.yellow("[check]"),
   231→        action: chalk.blue("[action]"),
   232→        decision: chalk.magenta("[decision]"),
   233→      }[step.type];
   234→
   235→      console.log(`${prefix} ${step.content}`);
   236→
   237→      if (step.on_fail) {
   238→        console.log(chalk.gray(`  → on fail: ${step.on_fail}`));
   239→      }
   240→
   241→      if (step.options && step.options.length > 0) {
   242→        for (const option of step.options) {
   243→          console.log(chalk.gray(`  • ${option}`));
   244→        }
   245→      }
   246→    }
   247→
   248→    console.log("");
   249→  }
   250→}
   251→
   252→/**
   253→ * Format conventions table output
   254→ * AC-conv-1: outputs table with columns: Domain, Rules (count), Validation (yes/no)
   255→ */
   256→function formatConventions(conventions: Convention[]): void {
   257→  if (conventions.length === 0) {
   258→    console.log(chalk.yellow("No conventions defined"));
   259→    return;
   260→  }
   261→
   262→  const table = new Table({
   263→    head: [chalk.bold("Domain"), chalk.bold("Rules"), chalk.bold("Validation")],
   264→    style: {
   265→      head: [],
   266→      border: [],
   267→    },
   268→  });
   269→
   270→  for (const convention of conventions) {
   271→    table.push([
   272→      convention.domain,
   273→      convention.rules.length.toString(),
   274→      convention.validation ? "yes" : "no",
   275→    ]);
   276→  }
   277→
   278→  console.log(table.toString());
   279→}
   280→
   281→/**
   282→ * Format convention detail output
   283→ * AC-conv-2: outputs full rules list and examples
   284→ */
   285→function formatConventionDetail(convention: Convention): void {
   286→  console.log(chalk.bold(`${convention.domain} Convention`));
   287→  console.log(chalk.gray("─".repeat(60)));
   288→
   289→  console.log(chalk.bold("\nRules:"));
   290→  for (const rule of convention.rules) {
   291→    console.log(`  • ${rule}`);
   292→  }
   293→
   294→  if (convention.examples && convention.examples.length > 0) {
   295→    console.log(chalk.bold("\nExamples:"));
   296→    for (const example of convention.examples) {
   297→      console.log(chalk.green(`  ✓ ${example.good}`));
   298→      console.log(chalk.red(`  ✗ ${example.bad}`));
   299→    }
   300→  }
   301→
   302→  if (convention.validation) {
   303→    console.log(chalk.bold("\nValidation:"));
   304→    console.log(`  Type: ${convention.validation.type}`);
   305→    if (convention.validation.pattern) {
   306→      console.log(`  Pattern: ${convention.validation.pattern}`);
   307→    }
   308→    if (convention.validation.message) {
   309→      console.log(`  Message: ${convention.validation.message}`);
   310→    }
   311→  }
   312→
   313→  console.log("");
   314→}
   315→
   316→/**
   317→ * Format observations table output
   318→ * AC-obs-2: outputs table with columns: ID, Type, Workflow, Created, Content (truncated)
   319→ * AC: @obs-list-display ac-1 - When --all flag used, show Resolved column with ✓/✗
   320→ */
   321→function formatObservations(
   322→  observations: Observation[],
   323→  showResolved: boolean,
   324→): void {
   325→  const filtered = showResolved
   326→    ? observations
   327→    : observations.filter((o) => !o.resolved);
   328→
   329→  if (filtered.length === 0) {
   330→    console.log(
   331→      chalk.yellow(
   332→        showResolved ? "No observations found" : "No unresolved observations",
   333→      ),
   334→    );
   335→    return;
   336→  }
   337→
   338→  // AC: @obs-list-display ac-1 - Include Resolved column when showing all observations
   339→  const headers = showResolved
   340→    ? [
   341→        chalk.bold("ID"),
   342→        chalk.bold("Type"),
   343→        chalk.bold("Resolved"),
   344→        chalk.bold("Workflow"),
   345→        chalk.bold("Created"),
   346→        chalk.bold("Content"),
   347→      ]
   348→    : [
   349→        chalk.bold("ID"),
   350→        chalk.bold("Type"),
   351→        chalk.bold("Workflow"),
   352→        chalk.bold("Created"),
   353→        chalk.bold("Content"),
   354→      ];
   355→
   356→  const colWidths = showResolved
   357→    ? [10, 10, 10, 20, 12, 40]
   358→    : [10, 10, 20, 12, 50];
   359→
   360→  const table = new Table({
   361→    head: headers,
   362→    style: {
   363→      head: [],
   364→      border: [],
   365→    },
   366→    colWidths,
   367→    wordWrap: true,
   368→  });
   369→
   370→  for (const obs of filtered) {
   371→    const id = obs._ulid.substring(0, 8);
   372→    const workflow = obs.workflow_ref || "-";
   373→    const created = new Date(obs.created_at).toISOString().split("T")[0];
   374→    // Adjust content truncation based on available column width
   375→    const maxContentLen = showResolved ? 37 : 47;
   376→    const content =
   377→      obs.content.length > maxContentLen
   378→        ? `${obs.content.substring(0, maxContentLen)}...`
   379→        : obs.content;
   380→
   381→    // AC: @obs-list-display ac-1 - Show ✓ for resolved, ✗ for unresolved
   382→    if (showResolved) {
   383→      const resolvedIndicator = obs.resolved
   384→        ? chalk.green("✓")
   385→        : chalk.red("✗");
   386→      table.push([id, obs.type, resolvedIndicator, workflow, created, content]);
   387→    } else {
   388→      table.push([id, obs.type, workflow, created, content]);
   389→    }
   390→  }
   391→
   392→  console.log(table.toString());
   393→}
   394→
   395→/**
   396→ * Register meta commands
   397→ */
   398→export function registerMetaCommands(program: Command): void {
   399→  const meta = program
   400→    .command("meta")
   401→    .description(
   402→      "Meta-spec commands (agents, workflows, conventions, observations)",
   403→    );
   404→
   405→  // AC-meta-manifest-1: kspec meta show outputs summary with counts
   406→  meta
   407→    .command("show")
   408→    .description("Display meta-spec summary")
   409→    .action(async () => {
   410→      try {
   411→        const ctx = await initContext();
   412→
   413→        if (!ctx.manifestPath) {
   414→          error(errors.project.noKspecProject);
   415→          process.exit(EXIT_CODES.ERROR);
   416→        }
   417→
   418→        const metaCtx = await loadMetaContext(ctx);
   419→        const stats = getMetaStats(metaCtx);
   420→
   421→        output(
   422→          {
   423→            manifest: metaCtx.manifestPath,
   424→            stats,
   425→          },
   426→          () => formatMetaShow(metaCtx),
   427→        );
   428→      } catch (err) {
   429→        error(errors.failures.showMeta, err);
   430→        process.exit(EXIT_CODES.ERROR);
   431→      }
   432→    });
   433→
   434→  // AC-agent-1, AC-agent-2: kspec meta agents
   435→  meta
   436→    .command("agents")
   437→    .description("List agents defined in meta-spec")
   438→    .action(async () => {
   439→      try {
   440→        const ctx = await initContext();
   441→
   442→        if (!ctx.manifestPath) {
   443→          error(errors.project.noKspecProject);
   444→          process.exit(EXIT_CODES.ERROR);
   445→        }
   446→
   447→        const metaCtx = await loadMetaContext(ctx);
   448→        const agents = metaCtx.agents || [];
   449→
   450→        // AC-agent-2: JSON output includes full agent details
   451→        output(
   452→          agents.map((agent) => ({
   453→            id: agent.id,
   454→            name: agent.name,
   455→            description: agent.description,
   456→            capabilities: agent.capabilities,
   457→            tools: agent.tools,
   458→            session_protocol: agent.session_protocol,
   459→            conventions: agent.conventions,
   460→          })),
   461→          // AC-agent-1: Table output with ID, Name, Capabilities
   462→          () => formatAgents(agents),
   463→        );
   464→      } catch (err) {
   465→        error(errors.failures.listAgents, err);
   466→        process.exit(EXIT_CODES.ERROR);
   467→      }
   468→    });
   469→
   470→  // AC-workflow-1, AC-workflow-2, AC-workflow-4: kspec meta workflows
   471→  // AC: @loop-mode-workflows ac-1 (--tag loop filtering)
   472→  meta
   473→    .command("workflows")
   474→    .description("List workflows defined in meta-spec")
   475→    .option("--verbose", "Show full workflow details with all steps")
   476→    .option("--tag <tag>", "Filter workflows by tag (e.g., --tag loop)")
   477→    .action(async (options) => {
   478→      try {
   479→        const ctx = await initContext();
   480→
   481→        if (!ctx.manifestPath) {
   482→          error(errors.project.noKspecProject);
   483→          process.exit(EXIT_CODES.ERROR);
   484→        }
   485→
   486→        const metaCtx = await loadMetaContext(ctx);
   487→        let workflows = metaCtx.workflows || [];
   488→
   489→        // AC: @loop-mode-workflows ac-1 - Filter by tag
   490→        if (options.tag) {
   491→          workflows = workflows.filter((w) => {
   492→            // Match by explicit tags array or by mode field (for "loop" tag)
   493→            const tags = w.tags || [];
   494→            if (tags.includes(options.tag)) return true;
   495→            // Special case: --tag loop also matches mode: loop
   496→            if (options.tag === "loop" && w.mode === "loop") return true;
   497→            return false;
   498→          });
   499→        }
   500→
   501→        // AC-workflow-4: JSON output includes full workflow details
   502→        output(
   503→          workflows.map((workflow) => ({
   504→            id: workflow.id,
   505→            trigger: workflow.trigger,
   506→            description: workflow.description,
   507→            steps: workflow.steps,
   508→            mode: workflow.mode || "interactive",
   509→            based_on: workflow.based_on,
   510→            tags: workflow.tags || [],
   511→          })),
   512→          // AC-workflow-1 (table) or AC-workflow-2 (verbose)
   513→          () => {
   514→            if (options.verbose) {
   515→              formatWorkflowsVerbose(workflows);
   516→            } else {
   517→              formatWorkflows(workflows);
   518→            }
   519→          },
   520→        );
   521→      } catch (err) {
   522→        error(errors.failures.listWorkflows, err);
   523→        process.exit(EXIT_CODES.ERROR);
   524→      }
   525→    });
   526→
   527→  // AC-conv-1, AC-conv-2, AC-conv-5: kspec meta conventions
   528→  meta
   529→    .command("conventions")
   530→    .description("List conventions defined in meta-spec")
   531→    .option("--domain <domain>", "Filter by specific domain")
   532→    .action(async (options) => {
   533→      try {
   534→        const ctx = await initContext();
   535→
   536→        if (!ctx.manifestPath) {
   537→          error(errors.project.noKspecProject);
   538→          process.exit(EXIT_CODES.ERROR);
   539→        }
   540→
   541→        const metaCtx = await loadMetaContext(ctx);
   542→        const conventions = metaCtx.conventions || [];
   543→
   544→        // AC-conv-2: Filter by domain if specified
   545→        const filtered = options.domain
   546→          ? conventions.filter((c) => c.domain === options.domain)
   547→          : conventions;
   548→
   549→        // AC-conv-5: JSON output includes full convention details
   550→        output(
   551→          filtered.map((convention) => ({
   552→            domain: convention.domain,
   553→            rules: convention.rules,
   554→            examples: convention.examples,
   555→            validation: convention.validation,
   556→          })),
   557→          // AC-conv-1 (table) or AC-conv-2 (detail for single domain)
   558→          () => {
   559→            if (options.domain && filtered.length === 1) {
   560→              formatConventionDetail(filtered[0]);
   561→            } else {
   562→              formatConventions(filtered);
   563→            }
   564→          },
   565→        );
   566→      } catch (err) {
   567→        error(errors.failures.listConventions, err);
   568→        process.exit(EXIT_CODES.ERROR);
   569→      }
   570→    });
   571→
   572→  // meta-get-cmd: kspec meta get <ref>
   573→  meta
   574→    .command("get <ref>")
   575→    .description(
   576→      "Get a meta item by reference (agent, workflow, convention, or observation)",
   577→    )
   578→    .action(async (ref: string) => {
   579→      try {
   580→        const ctx = await initContext();
   581→
   582→        if (!ctx.manifestPath) {
   583→          error(errors.project.noKspecProject);
   584→          process.exit(EXIT_CODES.ERROR);
   585→        }
   586→
   587→        const metaCtx = await loadMetaContext(ctx);
   588→
   589→        // Normalize reference
   590→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
   591→
   592→        // Search in all meta item types
   593→        const agents = metaCtx.agents || [];
   594→        const workflows = metaCtx.workflows || [];
   595→        const conventions = metaCtx.conventions || [];
   596→        const observations = metaCtx.observations || [];
   597→
   598→        // Try to find by ID or ULID prefix
   599→        let found: any = null;
   600→        let itemType: string = "";
   601→
   602→        // Check agents (by id or ULID)
   603→        const agent = agents.find(
   604→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef),
   605→        );
   606→        if (agent) {
   607→          found = agent;
   608→          itemType = "agent";
   609→        }
   610→
   611→        // Check workflows (by id or ULID)
   612→        if (!found) {
   613→          const workflow = workflows.find(
   614→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef),
   615→          );
   616→          if (workflow) {
   617→            found = workflow;
   618→            itemType = "workflow";
   619→          }
   620→        }
   621→
   622→        // Check conventions (by domain or ULID)
   623→        if (!found) {
   624→          const convention = conventions.find(
   625→            (c) =>
   626→              c.domain === normalizedRef || c._ulid.startsWith(normalizedRef),
   627→          );
   628→          if (convention) {
   629→            found = convention;
   630→            itemType = "convention";
   631→          }
   632→        }
   633→
   634→        // Check observations (by ULID)
   635→        if (!found) {
   636→          const observation = observations.find((o) =>
   637→            o._ulid.startsWith(normalizedRef),
   638→          );
   639→          if (observation) {
   640→            found = observation;
   641→            itemType = "observation";
   642→          }
   643→        }
   644→
   645→        if (!found) {
   646→          error(errors.reference.metaNotFound(ref));
   647→          process.exit(EXIT_CODES.ERROR);
   648→        }
   649→
   650→        // Output the item
   651→        output(found, () => {
   652→          console.log(
   653→            chalk.bold(
   654→              `${itemType.charAt(0).toUpperCase() + itemType.slice(1)}: ${ref}`,
   655→            ),
   656→          );
   657→          console.log(chalk.gray("─".repeat(60)));
   658→          console.log(JSON.stringify(found, null, 2));
   659→        });
   660→      } catch (err) {
   661→        error(errors.failures.getMetaItem, err);
   662→        process.exit(EXIT_CODES.ERROR);
   663→      }
   664→    });
   665→
   666→  // meta-list-cmd: kspec meta list
   667→  meta
   668→    .command("list")
   669→    .description("List all meta items")
   670→    .option(
   671→      "--type <type>",
   672→      "Filter by type (agent, workflow, convention, observation)",
   673→    )
   674→    .action(async (options) => {
   675→      try {
   676→        const ctx = await initContext();
   677→
   678→        if (!ctx.manifestPath) {
   679→          error(errors.project.noKspecProject);
   680→          process.exit(EXIT_CODES.ERROR);
   681→        }
   682→
   683→        const metaCtx = await loadMetaContext(ctx);
   684→
   685→        // Collect all meta items with type information
   686→        interface MetaListItem {
   687→          id: string;
   688→          type: string;
   689→          context: string;
   690→          ulid: string;
   691→        }
   692→
   693→        const items: MetaListItem[] = [];
   694→
   695→        // Add agents
   696→        if (!options.type || options.type === "agent") {
   697→          for (const agent of metaCtx.agents || []) {
   698→            items.push({
   699→              id: agent.id,
   700→              type: "agent",
   701→              context: agent.name,
   702→              ulid: agent._ulid,
   703→            });
   704→          }
   705→        }
   706→
   707→        // Add workflows
   708→        if (!options.type || options.type === "workflow") {
   709→          for (const workflow of metaCtx.workflows || []) {
   710→            items.push({
   711→              id: workflow.id,
   712→              type: "workflow",
   713→              context: workflow.trigger,
   714→              ulid: workflow._ulid,
   715→            });
   716→          }
   717→        }
   718→
   719→        // Add conventions
   720→        if (!options.type || options.type === "convention") {
   721→          for (const convention of metaCtx.conventions || []) {
   722→            items.push({
   723→              id: convention.domain,
   724→              type: "convention",
   725→              context: `${convention.rules.length} rules`,
   726→              ulid: convention._ulid,
   727→            });
   728→          }
   729→        }
   730→
   731→        // Add observations
   732→        if (!options.type || options.type === "observation") {
   733→          for (const observation of metaCtx.observations || []) {
   734→            const ulidPrefix = observation._ulid.substring(0, 8);
   735→            items.push({
   736→              id: ulidPrefix,
   737→              type: "observation",
   738→              context: `${observation.type} ${observation.resolved ? "(resolved)" : ""}`,
   739→              ulid: observation._ulid,
   740→            });
   741→          }
   742→        }
   743→
   744→        // Output
   745→        output(items, () => {
   746→          if (items.length === 0) {
   747→            console.log(chalk.yellow("No meta items found"));
   748→            return;
   749→          }
   750→
   751→          const table = new Table({
   752→            head: [chalk.bold("ID"), chalk.bold("Type"), chalk.bold("Context")],
   753→            style: {
   754→              head: [],
   755→              border: [],
   756→            },
   757→          });
   758→
   759→          for (const item of items) {
   760→            table.push([item.id, item.type, item.context]);
   761→          }
   762→
   763→          console.log(table.toString());
   764→        });
   765→      } catch (err) {
   766→        error(errors.failures.listMetaItems, err);
   767→        process.exit(EXIT_CODES.ERROR);
   768→      }
   769→    });
   770→
   771→  // AC-obs-1: kspec meta observe <type> <content>
   772→  // AC: @meta-observe-cmd from-inbox-conversion
   773→  markMutating(meta.command("observe [type] [content]"))
   774→    .description("Create an observation (friction, success, question, idea)")
   775→    .option(
   776→      "--workflow <ref>",
   777→      "Reference to workflow this observation relates to",
   778→    )
   779→    .option("--author <author>", "Author of the observation")
   780→    .option("--from-inbox <ref>", "Convert inbox item to observation")
   781→    .option(
   782→      "--type <type>",
   783→      "Override type when using --from-inbox (defaults to idea)",
   784→    )
   785→    .action(
   786→      async (
   787→        type: string | undefined,
   788→        content: string | undefined,
   789→        options,
   790→      ) => {
   791→        try {
   792→          const ctx = await initContext();
   793→
   794→          if (!ctx.manifestPath) {
   795→            error(errors.project.noKspecProject);
   796→            process.exit(EXIT_CODES.ERROR);
   797→          }
   798→
   799→          // AC: @meta-observe-cmd from-inbox-conversion
   800→          // Handle --from-inbox flag
   801→          if (options.fromInbox) {
   802→            // Load inbox items
   803→            const inboxItems = await loadInboxItems(ctx);
   804→            const item = findInboxItemByRef(inboxItems, options.fromInbox);
   805→
   806→            if (!item) {
   807→              error(errors.reference.inboxNotFound(options.fromInbox));
   808→              process.exit(EXIT_CODES.NOT_FOUND);
   809→            }
   810→
   811→            // Use inbox item content
   812→            const observationContent = item.text;
   813→
   814→            // Type defaults to 'idea' but can be overridden with --type flag
   815→            const observationType = (options.type || "idea") as ObservationType;
   816→
   817→            // Validate observation type
   818→            const validTypes: ObservationType[] = [
   819→              "friction",
   820→              "success",
   821→              "question",
   822→              "idea",
   823→            ];
   824→            if (!validTypes.includes(observationType)) {
   825→              error(errors.validation.invalidObservationType(observationType));
   826→              console.log(`Valid types: ${validTypes.join(", ")}`);
   827→              process.exit(EXIT_CODES.ERROR);
   828→            }
   829→
   830→            // Create observation
   831→            const observation = createObservation(
   832→              observationType,
   833→              observationContent,
   834→              {
   835→                workflow_ref: options.workflow,
   836→                author: options.author,
   837→              },
   838→            );
   839→
   840→            // Save observation
   841→            await saveObservation(ctx, observation);
   842→
   843→            // Delete inbox item
   844→            const deleted = await deleteInboxItem(ctx, item._ulid);
   845→            if (!deleted) {
   846→              error("Failed to delete inbox item after creating observation");
   847→              process.exit(EXIT_CODES.ERROR);
   848→            }
   849→
   850→            await commitIfShadow(
   851→              ctx.shadow,
   852→              "meta-observe-from-inbox",
   853→              observation._ulid.substring(0, 8),
   854→              `Convert inbox item to ${observationType} observation`,
   855→            );
   856→
   857→            // Return observation ref
   858→            output(observation, () =>
   859→              success(
   860→                `Created observation: ${observation._ulid.substring(0, 8)}`,
   861→              ),
   862→            );
   863→            return;
   864→          }
   865→
   866→          // Standard observe flow (without --from-inbox)
   867→          if (!type || !content) {
   868→            error("Type and content are required when not using --from-inbox");
   869→            process.exit(EXIT_CODES.ERROR);
   870→          }
   871→
   872→          // Validate observation type
   873→          const validTypes: ObservationType[] = [
   874→            "friction",
   875→            "success",
   876→            "question",
   877→            "idea",
   878→          ];
   879→          if (!validTypes.includes(type as ObservationType)) {
   880→            error(errors.validation.invalidObservationType(type));
   881→            console.log(`Valid types: ${validTypes.join(", ")}`);
   882→            process.exit(EXIT_CODES.ERROR);
   883→          }
   884→
   885→          // Create observation
   886→          const observation = createObservation(
   887→            type as ObservationType,
   888→            content,
   889→            {
   890→              workflow_ref: options.workflow,
   891→              author: options.author,
   892→            },
   893→          );
   894→
   895→          // Save to manifest
   896→          await saveObservation(ctx, observation);
   897→
   898→          // AC: @trait-shadow-commit ac-1
   899→          await commitIfShadow(
   900→            ctx.shadow,
   901→            "meta-observe",
   902→            observation._ulid.substring(0, 8),
   903→            type as string,
   904→          );
   905→
   906→          // AC-obs-1: outputs "OK Created observation: <ULID-prefix>"
   907→          // In JSON mode, return the created observation object
   908→          output(observation, () =>
   909→            success(
   910→              `Created observation: ${observation._ulid.substring(0, 8)}`,
   911→            ),
   912→          );
   913→        } catch (err) {
   914→          error(errors.failures.createObservation, err);
   915→          process.exit(EXIT_CODES.ERROR);
   916→        }
   917→      },
   918→    );
   919→
   920→  // AC-obs-2, AC-obs-5: kspec meta observations
   921→  meta
   922→    .command("observations")
   923→    .description("List observations (shows unresolved by default)")
   924→    .option(
   925→      "--type <type>",
   926→      "Filter by observation type (friction/success/question/idea)",
   927→    )
   928→    .option("--workflow <ref>", "Filter by workflow reference")
   929→    .option("--all", "Include resolved observations")
   930→    .option("--promoted", "Show only observations promoted to tasks")
   931→    .option(
   932→      "--pending-resolution",
   933→      "Show observations with completed tasks awaiting resolution",
   934→    )
   935→    .action(async (options) => {
   936→      try {
   937→        const ctx = await initContext();
   938→
   939→        if (!ctx.manifestPath) {
   940→          error(errors.project.noKspecProject);
   941→          process.exit(EXIT_CODES.ERROR);
   942→        }
   943→
   944→        const metaCtx = await loadMetaContext(ctx);
   945→        let observations = metaCtx.observations || [];
   946→
   947→        // Apply filters
   948→        if (options.type) {
   949→          observations = observations.filter(
   950→            (obs) => obs.type === options.type,
   951→          );
   952→        }
   953→
   954→        if (options.workflow) {
   955→          observations = observations.filter(
   956→            (obs) => obs.workflow_ref === options.workflow,
   957→          );
   958→        }
   959→
   960→        if (options.promoted) {
   961→          observations = observations.filter(
   962→            (obs) => obs.promoted_to !== undefined,
   963→          );
   964→        }
   965→
   966→        if (options.pendingResolution) {
   967→          // Load tasks to check if promoted tasks are completed
   968→          const tasks = await loadAllTasks(ctx);
   969→          const items = await loadAllItems(ctx);
   970→          const index = new ReferenceIndex(tasks, items);
   971→
   972→          observations = observations.filter((obs) => {
   973→            if (!obs.promoted_to || obs.resolved) return false;
   974→            const taskResult = index.resolve(obs.promoted_to);
   975→            if (!taskResult.ok) return false;
   976→            const item = taskResult.item;
   977→            // Type guard: check if item is a task (has status and depends_on properties)
   978→            return (
   979→              "status" in item &&
   980→              "depends_on" in item &&
   981→              item.status === "completed"
   982→            );
   983→          });
   984→        }
   985→
   986→        // AC-obs-5: JSON output includes full observation objects
   987→        output(
   988→          observations.map((obs) => ({
   989→            _ulid: obs._ulid,
   990→            type: obs.type,
   991→            content: obs.content,
   992→            workflow_ref: obs.workflow_ref ?? null,
   993→            created_at: obs.created_at,
   994→            author: obs.author ?? null,
   995→            resolved: obs.resolved,
   996→            resolution: obs.resolution ?? null,
   997→            resolved_at: obs.resolved_at ?? null,
   998→            resolved_by: obs.resolved_by ?? null,
   999→            promoted_to: obs.promoted_to ?? null,
  1000→          })),
  1001→          // AC-obs-2: Table output with ID, Type, Workflow, Created, Content
  1002→          () => formatObservations(observations, options.all),
  1003→        );
  1004→      } catch (err) {
  1005→        error(errors.failures.listObservations, err);
  1006→        process.exit(EXIT_CODES.ERROR);
  1007→      }
  1008→    });
  1009→
  1010→  // AC-obs-3, AC-obs-6, AC-obs-8: kspec meta promote
  1011→  markMutating(meta.command("promote <ref>"))
  1012→    .description("Promote observation to a task")
  1013→    .requiredOption("--title <title>", "Task title")
  1014→    .option("--priority <priority>", "Task priority (1-5)", "2")
  1015→    .option("--force", "Force promotion even if observation is resolved")
  1016→    .action(async (ref: string, options) => {
  1017→      try {
  1018→        const ctx = await initContext();
  1019→
  1020→        if (!ctx.manifestPath) {
  1021→          error(errors.project.noKspecProject);
  1022→          process.exit(EXIT_CODES.ERROR);
  1023→        }
  1024→
  1025→        const metaCtx = await loadMetaContext(ctx);
  1026→        const observations = metaCtx.observations || [];
  1027→
  1028→        // Find observation
  1029→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
  1030→        const observation = observations.find((o) =>
  1031→          o._ulid.startsWith(normalizedRef),
  1032→        );
  1033→
  1034→        if (!observation) {
  1035→          error(errors.reference.observationNotFound(ref));
  1036→          process.exit(EXIT_CODES.ERROR);
  1037→        }
  1038→
  1039→        // AC-obs-6: Check if already promoted
  1040→        if (observation.promoted_to) {
  1041→          error(
  1042→            errors.conflict.observationAlreadyPromoted(observation.promoted_to),
  1043→          );
  1044→          process.exit(EXIT_CODES.CONFLICT);
  1045→        }
  1046→
  1047→        // AC-obs-8: Check if resolved
  1048→        if (observation.resolved && !options.force) {
  1049→          error(errors.operation.cannotPromoteResolved);
  1050→          process.exit(EXIT_CODES.ERROR);
  1051→        }
  1052→
  1053→        // Validate priority
  1054→        const priorityResult = parseIntOption(options.priority, {
  1055→          min: 1,
  1056→          max: 5,
  1057→          name: "Priority",
  1058→        });
  1059→        if (!priorityResult.ok) {
  1060→          error(priorityResult.error);
  1061→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1062→        }
  1063→
  1064→        // AC-obs-3: Create task with title, description from observation, meta_ref, and origin
  1065→        const task = createTask({
  1066→          title: options.title,
  1067→          description: observation.content,
  1068→          priority: priorityResult.value,
  1069→          meta_ref: observation.workflow_ref,
  1070→          origin: "observation_promotion",
  1071→        });
  1072→
  1073→        // Save task
  1074→        await saveTask(ctx, task);
  1075→        await commitIfShadow(
  1076→          ctx.shadow,
  1077→          "task-add",
  1078→          task.slugs[0] || task._ulid.slice(0, 8),
  1079→          task.title,
  1080→        );
  1081→        const taskRef = `@${task._ulid.substring(0, 8)}`;
  1082→
  1083→        // Update observation with promoted_to field
  1084→        observation.promoted_to = taskRef;
  1085→        await saveObservation(ctx, observation);
  1086→
  1087→        // AC: @trait-shadow-commit ac-1
  1088→        await commitIfShadow(
  1089→          ctx.shadow,
  1090→          "observation-promote",
  1091→          observation._ulid.substring(0, 8),
  1092→        );
  1093→
  1094→        // AC-obs-3: outputs "OK Created task: <ULID-prefix>"
  1095→        // In JSON mode, return the created task object
  1096→        output(task, () => success(`Created task: ${taskRef.substring(0, 9)}`));
  1097→      } catch (err) {
  1098→        error(errors.failures.promoteObservation, err);
  1099→        process.exit(EXIT_CODES.ERROR);
  1100→      }
  1101→    });
  1102→
  1103→  // AC-obs-4, AC-obs-7, AC-obs-9: kspec meta resolve
  1104→  // AC: @trait-multi-ref-batch - Batch support with --refs flag
  1105→  markMutating(meta.command("resolve [ref] [resolution]"))
  1106→    .description("Resolve an observation (or multiple with --refs)")
  1107→    .option("--refs <refs...>", "Resolve multiple observations by ref")
  1108→    .option(
  1109→      "--resolution <text>",
  1110→      "Resolution text (required for batch mode unless observations have promoted tasks)",
  1111→    )
  1112→    .addHelpText(
  1113→      "after",
  1114→      `
  1115→Examples:
  1116→  $ kspec meta resolve @obs-ref "Fixed in PR #123"
  1117→  $ kspec meta resolve --refs @obs1 @obs2 --resolution "Resolved in batch"`,
  1118→    )
  1119→    .action(
  1120→      async (
  1121→        ref: string | undefined,
  1122→        resolutionArg: string | undefined,
  1123→        options,
  1124→      ) => {
  1125→        try {
  1126→          const ctx = await initContext();
  1127→
  1128→          if (!ctx.manifestPath) {
  1129→            error(errors.project.noKspecProject);
  1130→            process.exit(EXIT_CODES.ERROR);
  1131→          }
  1132→
  1133→          const metaCtx = await loadMetaContext(ctx);
  1134→          const observations = metaCtx.observations || [];
  1135→
  1136→          // Load tasks/items for auto-resolution from promoted tasks
  1137→          const tasks = await loadAllTasks(ctx);
  1138→          const items = await loadAllItems(ctx);
  1139→          const index = new ReferenceIndex(tasks, items);
  1140→
  1141→          // Resolution can come from positional arg or --resolution flag
  1142→          const resolution = resolutionArg || options.resolution;
  1143→
  1144→          // AC: @trait-multi-ref-batch ac-8 - Deduplicate refs
  1145→          const refsFlag = options.refs
  1146→            ? [...new Set(options.refs as string[])]
  1147→            : undefined;
  1148→
  1149→          // AC: @trait-multi-ref-batch ac-1, ac-2, ac-3, ac-4, ac-5
  1150→          const result = await executeBatchOperation({
  1151→            positionalRef: ref,
  1152→            refsFlag,
  1153→            context: { ctx, observations, tasks, items, index, resolution },
  1154→            items: observations,
  1155→            index: index,
  1156→            resolveRef: (refStr, obsList) => {
  1157→              return resolveObservationRefForBatch(
  1158→                refStr,
  1159→                obsList as Observation[],
  1160→              );
  1161→            },
  1162→            executeOperation: async (
  1163→              observation: Observation,
  1164→              { ctx, tasks, items, index, resolution },
  1165→            ) => {
  1166→              // AC-obs-7: Check if already resolved
  1167→              if (observation.resolved) {
  1168→                const resolvedDate = new Date(observation.resolved_at!)
  1169→                  .toISOString()
  1170→                  .split("T")[0];
  1171→                const resolutionText = observation.resolution || "";
  1172→                const truncated =
  1173→                  resolutionText.length > 50
  1174→                    ? `${resolutionText.substring(0, 50)}...`
  1175→                    : resolutionText;
  1176→                return {
  1177→                  success: false,
  1178→                  error: `Already resolved on ${resolvedDate}: ${truncated}`,
  1179→                };
  1180→              }
  1181→
  1182→              // AC-obs-9: Auto-populate resolution from task completion if promoted
  1183→              let finalResolution = resolution;
  1184→              if (!finalResolution && observation.promoted_to) {
  1185→                const taskResult = index.resolve(observation.promoted_to);
  1186→
  1187→                if (taskResult.ok) {
  1188→                  const item = taskResult.item;
  1189→                  // Type guard: ensure this is a task
  1190→                  if ("status" in item && "depends_on" in item) {
  1191→                    const task = item as LoadedTask;
  1192→                    if (task.status === "completed" && task.closed_reason) {
  1193→                      finalResolution = `Resolved via task ${observation.promoted_to}: ${task.closed_reason}`;
  1194→                    } else if (task.status === "completed") {
  1195→                      finalResolution = `Resolved via task ${observation.promoted_to}`;
  1196→                    } else {
  1197→                      return {
  1198→                        success: false,
  1199→                        error: `Task ${observation.promoted_to} is not completed yet`,
  1200→                      };
  1201→                    }
  1202→                  } else {
  1203→                    return {
  1204→                      success: false,
  1205→                      error: `Reference ${observation.promoted_to} is not a task`,
  1206→                    };
  1207→                  }
  1208→                } else {
  1209→                  return {
  1210→                    success: false,
  1211→                    error: `Task ${observation.promoted_to} not found`,
  1212→                  };
  1213→                }
  1214→              }
  1215→
  1216→              if (!finalResolution) {
  1217→                return {
  1218→                  success: false,
  1219→                  error: "Resolution text required",
  1220→                };
  1221→              }
  1222→
  1223→              // AC-obs-4: Update observation
  1224→              observation.resolved = true;
  1225→              observation.resolution = finalResolution;
  1226→              observation.resolved_at = new Date().toISOString();
  1227→              observation.resolved_by = observation.author;
  1228→
  1229→              await saveObservation(ctx, observation);
  1230→
  1231→              // AC: @trait-shadow-commit ac-1
  1232→              await commitIfShadow(
  1233→                ctx.shadow,
  1234→                "observation-resolve",
  1235→                observation._ulid.substring(0, 8),
  1236→              );
  1237→
  1238→              return {
  1239→                success: true,
  1240→                message: `Resolved: ${observation._ulid.substring(0, 8)}`,
  1241→              };
  1242→            },
  1243→            getUlid: (obs: Observation) => obs._ulid,
  1244→          });
  1245→
  1246→          // AC: @trait-multi-ref-batch ac-5, ac-7 - Output formatting
  1247→          formatBatchOutput(result, "Resolve");
  1248→        } catch (err) {
  1249→          error(errors.failures.resolveObservation, err);
  1250→          process.exit(EXIT_CODES.ERROR);
  1251→        }
  1252→      },
  1253→    );
  1254→
  1255→  // Meta add command - create new meta items
  1256→  markMutating(meta.command("add <type>"))
  1257→    .description("Create a new meta item (agent, workflow, or convention)")
  1258→    .option("--id <id>", "Semantic ID (required for agents and workflows)")
  1259→    .option("--domain <domain>", "Domain (required for conventions)")
  1260→    .option("--name <name>", "Name (for agents)")
  1261→    .option("--trigger <trigger>", "Trigger (for workflows)")
  1262→    .option("--description <desc>", "Description")
  1263→    .option("--capability <cap...>", "Capabilities (for agents)")
  1264→    .option("--tool <tool...>", "Tools (for agents)")
  1265→    .option("--convention <conv...>", "Convention references (for agents)")
  1266→    .option("--rule <rule...>", "Rules (for conventions)")
  1267→    .option("--steps <json>", "Workflow steps as JSON array (for workflows)")
  1268→    .option(
  1269→      "--mode <mode>",
  1270→      "Workflow mode: interactive (default) or loop (for workflows)",
  1271→    )
  1272→    .option("--based-on <ref>", "Base workflow reference (for loop workflows)")
  1273→    .option("--tag <tag...>", "Tags for the workflow (for workflows)")
  1274→    .addHelpText(
  1275→      "after",
  1276→      `
  1277→Examples:
  1278→  $ kspec meta add agent --id my-agent --name "My Agent" --capability search code
  1279→  $ kspec meta add convention --domain testing --rule "Always test" --rule "Use mocks"
  1280→  $ kspec meta add workflow --id my-flow --trigger manual --tag automation ci`,
  1281→    )
  1282→    .action(async (type: string, options) => {
  1283→      try {
  1284→        const ctx = await initContext();
  1285→
  1286→        // Validate type
  1287→        const validTypes = ["agent", "workflow", "convention"];
  1288→        if (!validTypes.includes(type)) {
  1289→          error(errors.validation.invalidType(type, validTypes));
  1290→          process.exit(EXIT_CODES.ERROR);
  1291→        }
  1292→
  1293→        // Generate ULID
  1294→        const itemUlid = ulid();
  1295→
  1296→        // Create the item based on type
  1297→        let item: Agent | Workflow | Convention;
  1298→
  1299→        if (type === "agent") {
  1300→          // Validate required fields
  1301→          if (!options.id) {
  1302→            error(errors.validation.agentRequiresId);
  1303→            process.exit(EXIT_CODES.ERROR);
  1304→          }
  1305→          if (!options.name) {
  1306→            error(errors.validation.agentRequiresName);
  1307→            process.exit(EXIT_CODES.ERROR);
  1308→          }
  1309→
  1310→          item = {
  1311→            _ulid: itemUlid,
  1312→            id: options.id,
  1313→            name: options.name,
  1314→            description: options.description || "",
  1315→            capabilities: options.capability || [],
  1316→            tools: options.tool || [],
  1317→            conventions: options.convention || [],
  1318→          };
  1319→        } else if (type === "workflow") {
  1320→          // Validate required fields
  1321→          if (!options.id) {
  1322→            error(errors.validation.workflowRequiresId);
  1323→            process.exit(EXIT_CODES.ERROR);
  1324→          }
  1325→          if (!options.trigger) {
  1326→            error(errors.validation.workflowRequiresTrigger);
  1327→            process.exit(EXIT_CODES.ERROR);
  1328→          }
  1329→
  1330→          // Parse and validate --steps if provided
  1331→          let steps: WorkflowStep[] = [];
  1332→          if (options.steps) {
  1333→            // AC: @meta-add-cmd ac-2 - Parse JSON
  1334→            let parsedSteps: unknown;
  1335→            try {
  1336→              parsedSteps = JSON.parse(options.steps);
  1337→            } catch (err) {
  1338→              const message = err instanceof Error ? err.message : String(err);
  1339→              error(errors.validation.invalidStepsJson(message));
  1340→              process.exit(EXIT_CODES.ERROR);
  1341→            }
  1342→
  1343→            // AC: @meta-add-cmd ac-3 - Verify it's an array
  1344→            if (!Array.isArray(parsedSteps)) {
  1345→              error(errors.validation.stepsNotArray);
  1346→              process.exit(EXIT_CODES.ERROR);
  1347→            }
  1348→
  1349→            // AC: @meta-add-cmd ac-4 - Validate with schema
  1350→            const result = z.array(WorkflowStepSchema).safeParse(parsedSteps);
  1351→            if (!result.success) {
  1352→              const issues = result.error.issues
  1353→                .map((i) => `${i.path.join(".")}: ${i.message}`)
  1354→                .join("; ");
  1355→              error(errors.validation.invalidStepsSchema(issues));
  1356→              process.exit(EXIT_CODES.ERROR);
  1357→            }
  1358→            steps = result.data;
  1359→          }
  1360→
  1361→          // Validate mode if provided
  1362→          const validModes = ["interactive", "loop"];
  1363→          if (options.mode && !validModes.includes(options.mode)) {
  1364→            error(
  1365→              `Invalid mode: ${options.mode}. Valid modes: ${validModes.join(", ")}`,
  1366→            );
  1367→            process.exit(EXIT_CODES.ERROR);
  1368→          }
  1369→
  1370→          item = {
  1371→            _ulid: itemUlid,
  1372→            id: options.id,
  1373→            trigger: options.trigger,
  1374→            description: options.description || "",
  1375→            steps,
  1376→            ...(options.mode && { mode: options.mode }),
  1377→            ...(options.basedOn && { based_on: options.basedOn }),
  1378→            ...(options.tag && options.tag.length > 0 && { tags: parseTagsArray(options.tag) }),
  1379→          };
  1380→        } else {
  1381→          // convention
  1382→          if (!options.domain) {
  1383→            error(errors.validation.conventionRequiresDomain);
  1384→            process.exit(EXIT_CODES.ERROR);
  1385→          }
  1386→
  1387→          item = {
  1388→            _ulid: itemUlid,
  1389→            domain: options.domain,
  1390→            rules: options.rule || [],
  1391→            examples: [],
  1392→          };
  1393→        }
  1394→
  1395→        // Save the item
  1396→        await saveMetaItem(
  1397→          ctx,
  1398→          item,
  1399→          type as "agent" | "workflow" | "convention",
  1400→        );
  1401→
  1402→        // AC: @trait-shadow-commit ac-1
  1403→        await commitIfShadow(
  1404→          ctx.shadow,
  1405→          `meta-add-${type}`,
  1406→          itemUlid.substring(0, 8),
  1407→          "id" in item ? item.id : "domain" in item ? item.domain : undefined,
  1408→        );
  1409→
  1410→        if (isJsonMode()) {
  1411→          // In JSON mode, output the item data directly
  1412→          console.log(JSON.stringify(item, null, 2));
  1413→        } else {
  1414→          const idOrDomain =
  1415→            "id" in item ? item.id : "domain" in item ? item.domain : itemUlid;
  1416→          success(
  1417→            `Created ${type}: ${idOrDomain} (@${itemUlid.substring(0, 8)})`,
  1418→          );
  1419→        }
  1420→      } catch (err) {
  1421→        error(errors.failures.createMeta(type), err);
  1422→        process.exit(EXIT_CODES.ERROR);
  1423→      }
  1424→    });
  1425→
  1426→  // Meta set command - update existing meta items
  1427→  markMutating(meta.command("set <ref>"))
  1428→    .description("Update an existing meta item")
  1429→    .option("--name <name>", "Update name (for agents)")
  1430→    .option("--description <desc>", "Update description")
  1431→    .option("--trigger <trigger>", "Update trigger (for workflows)")
  1432→    .option("--add-capability <cap>", "Add capability (for agents)")
  1433→    .option("--add-tool <tool>", "Add tool (for agents)")
  1434→    .option("--add-convention <conv>", "Add convention reference (for agents)")
  1435→    .option("--add-rule <rule>", "Add rule (for conventions)")
  1436→    .action(async (ref: string, options) => {
  1437→      try {
  1438→        const ctx = await initContext();
  1439→        const metaCtx = await loadMetaContext(ctx);
  1440→
  1441→        // Find the item using unified lookup
  1442→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
  1443→        let found: Agent | Workflow | Convention | null = null;
  1444→        let itemType: "agent" | "workflow" | "convention" | null = null;
  1445→
  1446→        // Search in agents
  1447→        const agents = metaCtx.manifest?.agents || [];
  1448→        const agent = agents.find(
  1449→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef),
  1450→        );
  1451→        if (agent) {
  1452→          found = agent;
  1453→          itemType = "agent";
  1454→        }
  1455→
  1456→        // Search in workflows
  1457→        if (!found) {
  1458→          const workflows = metaCtx.manifest?.workflows || [];
  1459→          const workflow = workflows.find(
  1460→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef),
  1461→          );
  1462→          if (workflow) {
  1463→            found = workflow;
  1464→            itemType = "workflow";
  1465→          }
  1466→        }
  1467→
  1468→        // Search in conventions
  1469→        if (!found) {
  1470→          const conventions = metaCtx.manifest?.conventions || [];
  1471→          const convention = conventions.find(
  1472→            (c) =>
  1473→              c.domain === normalizedRef || c._ulid.startsWith(normalizedRef),
  1474→          );
  1475→          if (convention) {
  1476→            found = convention;
  1477→            itemType = "convention";
  1478→          }
  1479→        }
  1480→
  1481→        if (!found || !itemType) {
  1482→          error(errors.reference.metaNotFound(ref));
  1483→          process.exit(EXIT_CODES.ERROR);
  1484→        }
  1485→
  1486→        // Update fields based on type
  1487→        if (itemType === "agent") {
  1488→          const item = found as Agent;
  1489→          if (options.name) item.name = options.name;
  1490→          if (options.description !== undefined)
  1491→            item.description = options.description;
  1492→          if (options.addCapability) {
  1493→            if (!item.capabilities.includes(options.addCapability)) {
  1494→              item.capabilities.push(options.addCapability);
  1495→            }
  1496→          }
  1497→          if (options.addTool) {
  1498→            if (!item.tools.includes(options.addTool)) {
  1499→              item.tools.push(options.addTool);
  1500→            }
  1501→          }
  1502→          if (options.addConvention) {
  1503→            if (!item.conventions.includes(options.addConvention)) {
  1504→              item.conventions.push(options.addConvention);
  1505→            }
  1506→          }
  1507→        } else if (itemType === "workflow") {
  1508→          const item = found as Workflow;
  1509→          if (options.trigger) item.trigger = options.trigger;
  1510→          if (options.description !== undefined)
  1511→            item.description = options.description;
  1512→        } else {
  1513→          const item = found as Convention;
  1514→          // Convention doesn't have a description field
  1515→          if (options.addRule) {
  1516→            if (!item.rules.includes(options.addRule)) {
  1517→              item.rules.push(options.addRule);
  1518→            }
  1519→          }
  1520→        }
  1521→
  1522→        // Save the updated item
  1523→        await saveMetaItem(ctx, found, itemType);
  1524→
  1525→        // AC: @trait-shadow-commit ac-1
  1526→        await commitIfShadow(
  1527→          ctx.shadow,
  1528→          `meta-set-${itemType}`,
  1529→          found._ulid.substring(0, 8),
  1530→        );
  1531→
  1532→        if (isJsonMode()) {
  1533→          // In JSON mode, output the item data directly
  1534→          console.log(JSON.stringify(found, null, 2));
  1535→        } else {
  1536→          const idOrDomain =
  1537→            itemType === "agent"
  1538→              ? (found as Agent).id
  1539→              : itemType === "workflow"
  1540→                ? (found as Workflow).id
  1541→                : (found as Convention).domain;
  1542→          success(`Updated ${itemType}: ${idOrDomain}`);
  1543→        }
  1544→      } catch (err) {
  1545→        error(errors.failures.updateMetaItem, err);
  1546→        process.exit(EXIT_CODES.ERROR);
  1547→      }
  1548→    });
  1549→
  1550→  // Meta delete command - delete meta items
  1551→  markMutating(meta.command("delete <ref>"))
  1552→    .description("Delete a meta item")
  1553→    .option("--confirm", "Skip confirmation prompt")
  1554→    .action(async (ref: string, options) => {
  1555→      try {
  1556→        const ctx = await initContext();
  1557→        const metaCtx = await loadMetaContext(ctx);
  1558→
  1559→        // Find the item to determine type
  1560→        const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
  1561→        let itemType:
  1562→          | "agent"
  1563→          | "workflow"
  1564→          | "convention"
  1565→          | "observation"
  1566→          | null = null;
  1567→        let itemUlid: string | null = null;
  1568→        let itemLabel: string | null = null;
  1569→
  1570→        // Search in agents
  1571→        const agents = metaCtx.manifest?.agents || [];
  1572→        const agent = agents.find(
  1573→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef),
  1574→        );
  1575→        if (agent) {
  1576→          itemType = "agent";
  1577→          itemUlid = agent._ulid;
  1578→          itemLabel = `agent ${agent.id}`;
  1579→        }
  1580→
  1581→        // Search in workflows
  1582→        if (!itemType) {
  1583→          const workflows = metaCtx.manifest?.workflows || [];
  1584→          const workflow = workflows.find(
  1585→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef),
  1586→          );
  1587→          if (workflow) {
  1588→            itemType = "workflow";
  1589→            itemUlid = workflow._ulid;
  1590→            itemLabel = `workflow ${workflow.id}`;
  1591→          }
  1592→        }
  1593→
  1594→        // Search in conventions
  1595→        if (!itemType) {
  1596→          const conventions = metaCtx.manifest?.conventions || [];
  1597→          const convention = conventions.find(
  1598→            (c) =>
  1599→              c.domain === normalizedRef || c._ulid.startsWith(normalizedRef),
  1600→          );
  1601→          if (convention) {
  1602→            itemType = "convention";
  1603→            itemUlid = convention._ulid;
  1604→            itemLabel = `convention ${convention.domain}`;
  1605→          }
  1606→        }
  1607→
  1608→        // Search in observations
  1609→        if (!itemType) {
  1610→          const observations = metaCtx.observations || [];
  1611→          const observation = observations.find((o) =>
  1612→            o._ulid.startsWith(normalizedRef),
  1613→          );
  1614→          if (observation) {
  1615→            itemType = "observation";
  1616→            itemUlid = observation._ulid;
  1617→            itemLabel = `observation ${observation._ulid.substring(0, 8)}`;
  1618→          }
  1619→        }
  1620→
  1621→        if (!itemType || !itemUlid || !itemLabel) {
  1622→          error(errors.reference.metaNotFound(ref));
  1623→          process.exit(EXIT_CODES.ERROR);
  1624→        }
  1625→
  1626→        // Check for dangling references (unless --confirm is used to override)
  1627→        if (!options.confirm) {
  1628→          // Check tasks with meta_ref
  1629→          const tasks = await loadAllTasks(ctx);
  1630→          const referencingTasks = tasks.filter((t) => {
  1631→            if (!t.meta_ref) return false;
  1632→            // Resolve the task's meta_ref to a ULID
  1633→            const taskMetaRef = resolveMetaRefToUlid(t.meta_ref, metaCtx);
  1634→            // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1635→            return taskMetaRef && taskMetaRef.ulid === itemUlid;
  1636→          });
  1637→
  1638→          if (referencingTasks.length > 0) {
  1639→            const taskRefs = referencingTasks
  1640→              .map((t) => `@${t.slugs?.[0] || t._ulid.substring(0, 8)}`)
  1641→              .join(", ");
  1642→            error(
  1643→              errors.operation.cannotDeleteReferencedByTasks(
  1644→                itemLabel,
  1645→                referencingTasks.length,
  1646→                taskRefs,
  1647→              ),
  1648→            );
  1649→            process.exit(EXIT_CODES.ERROR);
  1650→          }
  1651→
  1652→          // Check observations with workflow_ref (only for workflows)
  1653→          if (itemType === "workflow") {
  1654→            const observations = metaCtx.observations || [];
  1655→            const referencingObservations = observations.filter((o) => {
  1656→              if (!o.workflow_ref) return false;
  1657→              // Resolve the observation's workflow_ref to a ULID
  1658→              const obsWorkflowRef = resolveMetaRefToUlid(
  1659→                o.workflow_ref,
  1660→                metaCtx,
  1661→              );
  1662→              // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1663→              return obsWorkflowRef && obsWorkflowRef.ulid === itemUlid;
  1664→            });
  1665→
  1666→            if (referencingObservations.length > 0) {
  1667→              const obsRefs = referencingObservations
  1668→                .map((o) => `@${o._ulid.substring(0, 8)}`)
  1669→                .join(", ");
  1670→              error(
  1671→                errors.operation.cannotDeleteReferencedByObservations(
  1672→                  itemLabel,
  1673→                  referencingObservations.length,
  1674→                  obsRefs,
  1675→                ),
  1676→              );
  1677→              process.exit(EXIT_CODES.ERROR);
  1678→            }
  1679→          }
  1680→
  1681→          // Show confirmation prompt even if no references found
  1682→          error(errors.operation.confirmRequired(itemLabel));
  1683→          process.exit(EXIT_CODES.ERROR);
  1684→        }
  1685→
  1686→        // Delete the item
  1687→        const deleted = await deleteMetaItem(ctx, itemUlid, itemType);
  1688→
  1689→        if (!deleted) {
  1690→          error(errors.operation.deleteItemFailed(itemLabel));
  1691→          process.exit(EXIT_CODES.ERROR);
  1692→        }
  1693→
  1694→        // AC: @trait-shadow-commit ac-1
  1695→        await commitIfShadow(
  1696→          ctx.shadow,
  1697→          `meta-delete-${itemType}`,
  1698→          itemUlid.substring(0, 8),
  1699→        );
  1700→
  1701→        success(`Deleted ${itemLabel}`);
  1702→      } catch (err) {
  1703→        error(errors.failures.deleteMetaItem, err);
  1704→        process.exit(EXIT_CODES.ERROR);
  1705→      }
  1706→    });
  1707→
  1708→  // meta-focus-cmd: kspec meta focus [ref]
  1709→  markMutating(meta.command("focus [ref]"))
  1710→    .description("Get or set session focus")
  1711→    .option("--clear", "Clear current focus")
  1712→    .action(async (ref: string | undefined, options) => {
  1713→      try {
  1714→        const ctx = await initContext();
  1715→
  1716→        if (!ctx.manifestPath) {
  1717→          error(errors.project.noKspecProject);
  1718→          process.exit(EXIT_CODES.ERROR);
  1719→        }
  1720→
  1721→        const sessionCtx = await loadSessionContext(ctx);
  1722→
  1723→        // Clear focus
  1724→        if (options.clear) {
  1725→          sessionCtx.focus = null;
  1726→          await saveSessionContext(ctx, sessionCtx);
  1727→
  1728→          output({ focus: null }, () => success("Cleared session focus"));
  1729→          return;
  1730→        }
  1731→
  1732→        // Show current focus
  1733→        if (!ref) {
  1734→          output({ focus: sessionCtx.focus }, () => {
  1735→            if (sessionCtx.focus) {
  1736→              console.log(`Current focus: ${sessionCtx.focus}`);
  1737→            } else {
  1738→              console.log(chalk.yellow("No focus set"));
  1739→            }
  1740→          });
  1741→          return;
  1742→        }
  1743→
  1744→        // Set focus to ref
  1745→        sessionCtx.focus = ref.startsWith("@") ? ref : `@${ref}`;
  1746→        await saveSessionContext(ctx, sessionCtx);
  1747→
  1748→        output({ focus: sessionCtx.focus }, () =>
  1749→          success(`Set focus to: ${sessionCtx.focus}`),
  1750→        );
  1751→      } catch (err) {
  1752→        error(errors.failures.updateSessionContext, err);
  1753→        process.exit(EXIT_CODES.ERROR);
  1754→      }
  1755→    });
  1756→
  1757→  // meta-thread-cmd: kspec meta thread <action> [text]
  1758→  markMutating(meta.command("thread <action> [text]"))
  1759→    .description("Manage active threads")
  1760→    .action(async (action: string, text: string | undefined) => {
  1761→      try {
  1762→        const ctx = await initContext();
  1763→
  1764→        if (!ctx.manifestPath) {
  1765→          error(errors.project.noKspecProject);
  1766→          process.exit(EXIT_CODES.ERROR);
  1767→        }
  1768→
  1769→        const sessionCtx = await loadSessionContext(ctx);
  1770→
  1771→        // List threads
  1772→        if (action === "list") {
  1773→          output({ threads: sessionCtx.threads }, () => {
  1774→            if (sessionCtx.threads.length === 0) {
  1775→              console.log(chalk.yellow("No active threads"));
  1776→            } else {
  1777→              console.log("Active threads:");
  1778→              sessionCtx.threads.forEach((thread, idx) => {
  1779→                console.log(`  ${idx + 1}. ${thread}`);
  1780→              });
  1781→            }
  1782→          });
  1783→          return;
  1784→        }
  1785→
  1786→        // Clear all threads
  1787→        if (action === "clear") {
  1788→          sessionCtx.threads = [];
  1789→          await saveSessionContext(ctx, sessionCtx);
  1790→
  1791→          output({ threads: [] }, () => success("Cleared all threads"));
  1792→          return;
  1793→        }
  1794→
  1795→        // Add thread
  1796→        if (action === "add") {
  1797→          if (!text) {
  1798→            error("Thread text is required for add action");
  1799→            process.exit(EXIT_CODES.ERROR);
  1800→          }
  1801→
  1802→          sessionCtx.threads.push(text);
  1803→          await saveSessionContext(ctx, sessionCtx);
  1804→
  1805→          output({ threads: sessionCtx.threads, added: text }, () =>
  1806→            success(`Added thread: ${text}`),
  1807→          );
  1808→          return;
  1809→        }
  1810→
  1811→        // Remove thread by index (1-based)
  1812→        if (action === "remove") {
  1813→          if (!text) {
  1814→            error("Index is required for remove action");
  1815→            process.exit(EXIT_CODES.ERROR);
  1816→          }
  1817→
  1818→          const index = parseInt(text, 10);
  1819→          if (
  1820→            Number.isNaN(index) ||
  1821→            index < 1 ||
  1822→            index > sessionCtx.threads.length
  1823→          ) {
  1824→            error(
  1825→              `Invalid index: ${text}. Must be between 1 and ${sessionCtx.threads.length}`,
  1826→            );
  1827→            process.exit(EXIT_CODES.ERROR);
  1828→          }
  1829→
  1830→          const removed = sessionCtx.threads.splice(index - 1, 1)[0];
  1831→          await saveSessionContext(ctx, sessionCtx);
  1832→
  1833→          output({ threads: sessionCtx.threads, removed }, () =>
  1834→            success(`Removed thread: ${removed}`),
  1835→          );
  1836→          return;
  1837→        }
  1838→
  1839→        // Unknown action
  1840→        error(`Unknown action: ${action}. Use add, remove, list, or clear`);
  1841→        process.exit(EXIT_CODES.ERROR);
  1842→      } catch (err) {
  1843→        error(errors.failures.updateSessionContext, err);
  1844→        process.exit(EXIT_CODES.ERROR);
  1845→      }
  1846→    });
  1847→
  1848→  // meta-question-cmd: kspec meta question <action> [text]
  1849→  markMutating(meta.command("question <action> [text]"))
  1850→    .description("Manage open questions")
  1851→    .action(async (action: string, text: string | undefined) => {
  1852→      try {
  1853→        const ctx = await initContext();
  1854→
  1855→        if (!ctx.manifestPath) {
  1856→          error(errors.project.noKspecProject);
  1857→          process.exit(EXIT_CODES.ERROR);
  1858→        }
  1859→
  1860→        const sessionCtx = await loadSessionContext(ctx);
  1861→
  1862→        // List questions
  1863→        if (action === "list") {
  1864→          output({ questions: sessionCtx.open_questions }, () => {
  1865→            if (sessionCtx.open_questions.length === 0) {
  1866→              console.log(chalk.yellow("No open questions"));
  1867→            } else {
  1868→              console.log("Open questions:");
  1869→              sessionCtx.open_questions.forEach((question, idx) => {
  1870→                console.log(`  ${idx + 1}. ${question}`);
  1871→              });
  1872→            }
  1873→          });
  1874→          return;
  1875→        }
  1876→
  1877→        // Clear all questions
  1878→        if (action === "clear") {
  1879→          sessionCtx.open_questions = [];
  1880→          await saveSessionContext(ctx, sessionCtx);
  1881→
  1882→          output({ questions: [] }, () => success("Cleared all questions"));
  1883→          return;
  1884→        }
  1885→
  1886→        // Add question
  1887→        if (action === "add") {
  1888→          if (!text) {
  1889→            error("Question text is required for add action");
  1890→            process.exit(EXIT_CODES.ERROR);
  1891→          }
  1892→
  1893→          sessionCtx.open_questions.push(text);
  1894→          await saveSessionContext(ctx, sessionCtx);
  1895→
  1896→          output({ questions: sessionCtx.open_questions, added: text }, () =>
  1897→            success(`Added question: ${text}`),
  1898→          );
  1899→          return;
  1900→        }
  1901→
  1902→        // Remove question by index (1-based)
  1903→        if (action === "remove") {
  1904→          if (!text) {
  1905→            error("Index is required for remove action");
  1906→            process.exit(EXIT_CODES.ERROR);
  1907→          }
  1908→
  1909→          const index = parseInt(text, 10);
  1910→          if (
  1911→            Number.isNaN(index) ||
  1912→            index < 1 ||
  1913→            index > sessionCtx.open_questions.length
  1914→          ) {
  1915→            error(
  1916→              `Invalid index: ${text}. Must be between 1 and ${sessionCtx.open_questions.length}`,
  1917→            );
  1918→            process.exit(EXIT_CODES.ERROR);
  1919→          }
  1920→
  1921→          const removed = sessionCtx.open_questions.splice(index - 1, 1)[0];
  1922→          await saveSessionContext(ctx, sessionCtx);
  1923→
  1924→          output({ questions: sessionCtx.open_questions, removed }, () =>
  1925→            success(`Removed question: ${removed}`),
  1926→          );
  1927→          return;
  1928→        }
  1929→
  1930→        // Unknown action
  1931→        error(`Unknown action: ${action}. Use add, remove, list, or clear`);
  1932→        process.exit(EXIT_CODES.ERROR);
  1933→      } catch (err) {
  1934→        error(errors.failures.updateSessionContext, err);
  1935→        process.exit(EXIT_CODES.ERROR);
  1936→      }
  1937→    });
  1938→
  1939→  // meta-context-cmd: kspec meta context
  1940→  meta
  1941→    .command("context")
  1942→    .description("Show full session context")
  1943→    .option("--clear", "Clear all session context")
  1944→    .action(async (options) => {
  1945→      try {
  1946→        const ctx = await initContext();
  1947→
  1948→        if (!ctx.manifestPath) {
  1949→          error(errors.project.noKspecProject);
  1950→          process.exit(EXIT_CODES.ERROR);
  1951→        }
  1952→
  1953→        const sessionCtx = await loadSessionContext(ctx);
  1954→
  1955→        // Clear all context
  1956→        if (options.clear) {
  1957→          sessionCtx.focus = null;
  1958→          sessionCtx.threads = [];
  1959→          sessionCtx.open_questions = [];
  1960→          await saveSessionContext(ctx, sessionCtx);
  1961→
  1962→          output(
  1963→            {
  1964→              focus: null,
  1965→              threads: [],
  1966→              open_questions: [],
  1967→              updated_at: sessionCtx.updated_at,
  1968→            },
  1969→            () => success("Cleared all session context"),
  1970→          );
  1971→          return;
  1972→        }
  1973→
  1974→        // Show full session context
  1975→        output(
  1976→          {
  1977→            focus: sessionCtx.focus,
  1978→            threads: sessionCtx.threads,
  1979→            open_questions: sessionCtx.open_questions,
  1980→            updated_at: sessionCtx.updated_at,
  1981→          },
  1982→          () => {
  1983→            console.log(chalk.bold("Session Context"));
  1984→            console.log(chalk.gray("─".repeat(60)));
  1985→
  1986→            // Focus
  1987→            console.log(chalk.bold("\nFocus:"));
  1988→            if (sessionCtx.focus) {
  1989→              console.log(`  ${sessionCtx.focus}`);
  1990→            } else {
  1991→              console.log(chalk.gray("  (none)"));
  1992→            }
  1993→
  1994→            // Active threads
  1995→            console.log(chalk.bold("\nActive Threads:"));
  1996→            if (sessionCtx.threads.length > 0) {
  1997→              sessionCtx.threads.forEach((thread, idx) => {
  1998→                console.log(`  ${idx + 1}. ${thread}`);
  1999→              });
  2000→            } else {
  2001→              console.log(chalk.gray("  (none)"));
  2002→            }
  2003→
  2004→            // Open questions
  2005→            console.log(chalk.bold("\nOpen Questions:"));
  2006→            if (sessionCtx.open_questions.length > 0) {
  2007→              sessionCtx.open_questions.forEach((question, idx) => {
  2008→                console.log(`  ${idx + 1}. ${question}`);
  2009→              });
  2010→            } else {
  2011→              console.log(chalk.gray("  (none)"));
  2012→            }
  2013→
  2014→            // Last updated
  2015→            console.log(chalk.bold("\nLast Updated:"));
  2016→            const updatedDate = new Date(sessionCtx.updated_at);
  2017→            console.log(`  ${updatedDate.toISOString()}`);
  2018→            console.log(chalk.gray(`  (${updatedDate.toLocaleString()})`));
  2019→          },
  2020→        );
  2021→      } catch (err) {
  2022→        error(errors.failures.updateSessionContext, err);
  2023→        process.exit(EXIT_CODES.ERROR);
  2024→      }
  2025→    });
  2026→}
  2027→

