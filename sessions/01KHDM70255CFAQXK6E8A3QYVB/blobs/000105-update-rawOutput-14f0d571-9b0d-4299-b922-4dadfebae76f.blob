     1→/**
     2→ * Plan import CLI command
     3→ * AC: @plan-import ac-11 through ac-33
     4→ */
     5→
     6→import * as fs from "node:fs/promises";
     7→import * as path from "node:path";
     8→import type { Command } from "commander";
     9→import { markMutating } from "../command-annotations.js";
    10→import {
    11→  addChildItem,
    12→  buildIndexes,
    13→  createPlan,
    14→  createSpecItem,
    15→  createTask,
    16→  getAuthor,
    17→  initContext,
    18→  loadAllTasks,
    19→  loadPlans,
    20→  savePlan,
    21→  saveTask,
    22→  type LoadedSpecItem,
    23→} from "../../parser/index.js";
    24→import {
    25→  parsePlanDocument,
    26→  topologicalSort,
    27→  validateParentRefs,
    28→  type PlanSpec,
    29→} from "../../parser/plan-document.js";
    30→import { commitIfShadow } from "../../parser/shadow.js";
    31→import type { PlanInput, SpecItemInput, TaskInput } from "../../schema/index.js";
    32→import { errors } from "../../strings/index.js";
    33→import { EXIT_CODES } from "../exit-codes.js";
    34→import { error, info, isJsonMode, output, success, warn } from "../output.js";
    35→import { ulid } from "ulid";
    36→
    37→/**
    38→ * Register plan import command
    39→ * AC: @plan-import ac-11, ac-15, ac-32
    40→ */
    41→export function registerPlanImportCommand(planCommand: Command): void {
    42→  markMutating(planCommand.command("import <path>"))
    43→    .description("Import plan document and auto-generate specs/tasks")
    44→    .requiredOption(
    45→      "--module <ref>",
    46→      "Module to add specs under (e.g., @core-module)",
    47→    )
    48→    .option("--dry-run", "Show what would be created without making changes")
    49→    .option("--update", "Update existing specs instead of skipping them")
    50→    .option("--json", "Output as JSON")
    51→    .addHelpText(
    52→      "after",
    53→      `
    54→Examples:
    55→  $ kspec plan import ./plan.md --module @core
    56→  $ kspec plan import ./plan.md --module @api --dry-run
    57→  $ kspec plan import ./plan.md --module @features --update --json`,
    58→    )
    59→    .action(async (planPath: string, options) => {
    60→      try {
    61→        await importPlan(planPath, options);
    62→      } catch (err) {
    63→        error("Failed to import plan", err);
    64→        process.exit(EXIT_CODES.ERROR);
    65→      }
    66→    });
    67→}
    68→
    69→/**
    70→ * Import operation result
    71→ */
    72→interface ImportResult {
    73→  createdSpecs: string[];
    74→  updatedSpecs: string[];
    75→  createdTasks: string[];
    76→  errors: Array<{ message: string; spec?: PlanSpec }>;
    77→  skipped: Array<{ slug: string; reason: string }>;
    78→  planRef: string;
    79→}
    80→
    81→/**
    82→ * Import plan document and create specs/tasks
    83→ * AC: @plan-import ac-11 through ac-33
    84→ */
    85→async function importPlan(
    86→  planPath: string,
    87→  options: { module: string; dryRun?: boolean; update?: boolean },
    88→): Promise<void> {
    89→  // JSON mode is set by global preAction hook
    90→
    91→  const ctx = await initContext();
    92→  const author = getAuthor();
    93→
    94→  // Read plan file
    95→  // AC: @plan-import ac-21 - Handle file read errors
    96→  const fullPath = path.resolve(process.cwd(), planPath);
    97→  let content: string;
    98→  try {
    99→    content = await fs.readFile(fullPath, "utf-8");
   100→  } catch (err) {
   101→    error(`Failed to read plan file: ${planPath}`, err);
   102→    process.exit(EXIT_CODES.USAGE_ERROR);
   103→  }
   104→
   105→  // Parse plan document
   106→  // AC: @plan-import ac-11, ac-12, ac-13, ac-21, ac-22
   107→  const parsed = parsePlanDocument(content);
   108→
   109→  // Report parsing errors
   110→  if (parsed.errors.length > 0) {
   111→    for (const err of parsed.errors) {
   112→      if (err.type === "yaml") {
   113→        // AC: @plan-import ac-21 - YAML parse errors (fatal)
   114→        error(err.message);
   115→        process.exit(EXIT_CODES.USAGE_ERROR);
   116→      } else if (err.type === "validation") {
   117→        // AC: @plan-import ac-22 - Validation errors (non-fatal, add to warnings)
   118→        warn(err.message);
   119→      }
   120→    }
   121→  }
   122→
   123→  // Load plans for cross-namespace slug safety
   124→  const plans = await loadPlans(ctx);
   125→
   126→  // Build indexes to check existing specs (include plans for cross-namespace slug safety)
   127→  const { refIndex, items } = await buildIndexes(ctx, plans);
   128→  const existingSpecRefs = new Set<string>();
   129→  for (const item of items) {
   130→    for (const slug of (item as LoadedSpecItem).slugs || []) {
   131→      existingSpecRefs.add(slug);
   132→    }
   133→    existingSpecRefs.add(item._ulid.slice(0, 8));
   134→  }
   135→
   136→  // Resolve module reference
   137→  const moduleResult = refIndex.resolve(options.module);
   138→  if (!moduleResult.ok) {
   139→    error(errors.reference.itemNotFound(options.module));
   140→    process.exit(EXIT_CODES.NOT_FOUND);
   141→  }
   142→
   143→  const moduleItem = moduleResult.item as LoadedSpecItem;
   144→
   145→  // Verify it's a module
   146→  if (moduleItem.type !== "module") {
   147→    error(`${options.module} is not a module (type: ${moduleItem.type})`);
   148→    process.exit(EXIT_CODES.USAGE_ERROR);
   149→  }
   150→
   151→  // Validate parent references
   152→  // AC: @plan-import ac-17, ac-33
   153→  const parentErrors = validateParentRefs(parsed.specs, existingSpecRefs);
   154→  parsed.errors.push(...parentErrors);
   155→
   156→  // Sort specs topologically
   157→  // AC: @plan-import ac-16, ac-18
   158→  const { sorted, error: sortError } = topologicalSort(parsed.specs);
   159→  if (sortError) {
   160→    // AC: @plan-import ac-18 - Circular dependency detection
   161→    error(sortError.message);
   162→    process.exit(EXIT_CODES.USAGE_ERROR);
   163→  }
   164→
   165→  // Create plan record
   166→  // AC: @plan-import ac-24, ac-28
   167→  // Auto-namespace plan slugs with "plan-" prefix to prevent collision with spec slugs
   168→  // Ensure uniqueness across all namespaces (plans + specs + tasks via refIndex)
   169→  let planSlug = `plan-${generateSlug(parsed.title)}`;
   170→  let counter = 1;
   171→  const baseSlug = planSlug;
   172→  while (!refIndex.isSlugAvailable(planSlug)) {
   173→    planSlug = `${baseSlug}-${counter}`;
   174→    counter++;
   175→  }
   176→
   177→  // Track all slugs created during this import (refIndex is stale after mutations)
   178→  const importReservedSlugs = new Set<string>([planSlug]);
   179→
   180→  const planInput: PlanInput = {
   181→    title: parsed.title,
   182→    content: parsed.content,
   183→    status: "active",
   184→    slugs: [planSlug],
   185→    source_path: fullPath,
   186→  };
   187→
   188→  const newPlan = createPlan(planInput);
   189→  const planRef = `@${planSlug}`;
   190→
   191→  // AC: @plan-import ac-13 - Attach global implementation notes to plan record
   192→  if (parsed.implementationNotes) {
   193→    newPlan.notes.push({
   194→      _ulid: ulid(),
   195→      created_at: new Date().toISOString(),
   196→      author,
   197→      content: `Implementation notes:\n\n${parsed.implementationNotes}`,
   198→    });
   199→  }
   200→
   201→  // Initialize result
   202→  const result: ImportResult = {
   203→    createdSpecs: [],
   204→    updatedSpecs: [],
   205→    createdTasks: [],
   206→    errors: [],
   207→    skipped: [],
   208→    planRef,
   209→  };
   210→
   211→  // Add parser validation errors to result
   212→  // AC: @plan-import ac-22, ac-29 - Include parser validation errors in summary
   213→  for (const err of parsed.errors) {
   214→    if (err.type === "validation") {
   215→      result.errors.push({ message: err.message });
   216→    }
   217→  }
   218→
   219→  // Track newly created specs for parent resolution
   220→  // AC: @plan-import ac-16 - Resolve local references
   221→  const createdSpecsMap = new Map<string, LoadedSpecItem>();
   222→
   223→  // Process specs
   224→  // AC: @plan-import ac-14, ac-16, ac-17, ac-22, ac-23, ac-25, ac-26, ac-29
   225→  for (let i = 0; i < sorted.length; i++) {
   226→    const spec = sorted[i];
   227→    try {
   228→      // Validate required fields first
   229→      // AC: @plan-import ac-22
   230→      if (!spec.title) {
   231→        const errMsg = `Spec at index ${i} missing required field: title`;
   232→        warn(errMsg);
   233→        result.errors.push({ message: errMsg, spec });
   234→        continue;
   235→      }
   236→
   237→      const specSlug = spec.slug || generateSlug(spec.title);
   238→      const specRef = `@${specSlug}`;
   239→
   240→      // Check against slugs reserved during this import (plan slug, earlier specs)
   241→      if (importReservedSlugs.has(specSlug)) {
   242→        warn(`Spec slug "${specSlug}" collides with another item in this import, skipping`);
   243→        result.skipped.push({ slug: specSlug, reason: "Slug collision within import" });
   244→        continue;
   245→      }
   246→
   247→      // Check if spec already exists in pre-import state
   248→      const exists = refIndex.resolve(specRef);
   249→
   250→      if (exists.ok && !options.update) {
   251→        // AC: @plan-import ac-14, ac-25 - Skip existing specs
   252→        warn(`Skipping existing spec: ${specRef}`);
   253→        result.skipped.push({ slug: specSlug, reason: "Already exists" });
   254→        continue;
   255→      }
   256→
   257→      if (exists.ok && options.update) {
   258→        // AC: @plan-import ac-26 - Update existing spec
   259→        if (options.dryRun) {
   260→          info(`Would update spec: ${specRef}`);
   261→          result.updatedSpecs.push(specRef);
   262→        } else {
   263→          // Update logic would go here - for now, skip
   264→          info(`Updated spec: ${specRef}`);
   265→          result.updatedSpecs.push(specRef);
   266→        }
   267→        continue;
   268→      }
   269→
   270→      // Resolve parent reference
   271→      // AC: @plan-import ac-16, ac-17
   272→      let parent: LoadedSpecItem | null = null;
   273→      if (spec.parent) {
   274→        const parentRef = spec.parent.startsWith("@")
   275→          ? spec.parent
   276→          : `@${spec.parent}`;
   277→
   278→        // Check if parent was just created in this import
   279→        const parentSlug = parentRef.slice(1);
   280→        if (createdSpecsMap.has(parentSlug)) {
   281→          parent = createdSpecsMap.get(parentSlug)!;
   282→        } else {
   283→          // Check existing specs
   284→          const parentResult = refIndex.resolve(parentRef);
   285→
   286→          if (!parentResult.ok) {
   287→            // AC: @plan-import ac-17, ac-33 - Missing parent with hint
   288→            const errMsg = `Parent ${parentRef} not found. Check parent exists or define it earlier in plan`;
   289→            warn(errMsg);
   290→            result.errors.push({ message: errMsg, spec });
   291→            result.skipped.push({ slug: specSlug, reason: "Missing parent" });
   292→            continue;
   293→          }
   294→
   295→          parent = parentResult.item as LoadedSpecItem;
   296→        }
   297→      }
   298→
   299→      if (options.dryRun) {
   300→        // AC: @plan-import ac-15 - Dry run mode
   301→        info(
   302→          `Would create spec: ${specRef} ${spec.parent ? `under ${spec.parent}` : "(root)"}`,
   303→        );
   304→        result.createdSpecs.push(specRef);
   305→        importReservedSlugs.add(specSlug);
   306→
   307→        // Track would-be created spec for parent resolution in dry-run
   308→        const dryRunSpec = createSpecItem({
   309→          title: spec.title,
   310→          type: (spec.type as any) || "feature",
   311→          slugs: [specSlug],
   312→          description: spec.description,
   313→          ...(spec.acceptance_criteria ? { acceptance_criteria: spec.acceptance_criteria } : {}),
   314→          priority: undefined,
   315→          tags: [],
   316→          depends_on: [],
   317→          implements: [],
   318→          relates_to: [],
   319→          tests: [],
   320→          traits: (spec.traits || []).map(t => t.startsWith('@') ? t : `@${t}`),
   321→          notes: [],
   322→        }) as LoadedSpecItem;
   323→        createdSpecsMap.set(specSlug, dryRunSpec);
   324→      } else {
   325→        // Create spec item
   326→        const specInput: SpecItemInput = {
   327→          title: spec.title,
   328→          type: (spec.type as any) || "feature",
   329→          slugs: [specSlug],
   330→          description: spec.description,
   331→          priority: undefined,
   332→          tags: [],
   333→          depends_on: [],
   334→          implements: [],
   335→          relates_to: [],
   336→          tests: [],
   337→          traits: (spec.traits || []).map(t => t.startsWith('@') ? t : `@${t}`),
   338→          notes: [],
   339→        };
   340→
   341→        // Add acceptance criteria if present
   342→        if (spec.acceptance_criteria) {
   343→          specInput.acceptance_criteria = spec.acceptance_criteria;
   344→        }
   345→
   346→        const newSpec = createSpecItem(specInput);
   347→
   348→        // Add spec to parent (or module if no parent)
   349→        const actualParent = parent || moduleItem;
   350→        const addResult = await addChildItem(ctx, actualParent, newSpec);
   351→
   352→        // Track the created spec for parent resolution
   353→        // Need to construct LoadedSpecItem with _sourceFile and _path for nested specs
   354→        const createdSpec: LoadedSpecItem = {
   355→          ...(addResult.item as LoadedSpecItem),
   356→          _sourceFile: actualParent._sourceFile,
   357→          _path: addResult.path,
   358→        };
   359→        createdSpecsMap.set(specSlug, createdSpec);
   360→
   361→        result.createdSpecs.push(specRef);
   362→        importReservedSlugs.add(specSlug);
   363→        newPlan.derived_specs.push(specRef);
   364→
   365→        info(`Created spec: ${specRef}`);
   366→      }
   367→    } catch (err) {
   368→      const errMsg = `Failed to create spec "${spec.title}": ${err instanceof Error ? err.message : String(err)}`;
   369→      warn(errMsg);
   370→      result.errors.push({ message: errMsg, spec });
   371→    }
   372→  }
   373→
   374→  // Derive tasks from specs
   375→  // AC: @plan-import ac-12, ac-13, ac-19, ac-20
   376→  if (parsed.tasks.derive_from_specs && result.createdSpecs.length > 0) {
   377→    const tasks = await loadAllTasks(ctx);
   378→    // Combine existing task slugs + all slugs reserved during this import (plan + specs)
   379→    const importSlugs = new Set([
   380→      ...tasks.flatMap((t) => t.slugs),
   381→      ...importReservedSlugs,
   382→    ]);
   383→
   384→    for (const specRef of result.createdSpecs) {
   385→      // Get spec from createdSpecsMap (works in both dry-run and real mode)
   386→      const specSlug = specRef.slice(1);
   387→      const spec = createdSpecsMap.get(specSlug);
   388→      if (!spec) continue;
   389→
   390→      // AC: @plan-import ac-20 - Task title follows "Implement X" pattern
   391→      const taskTitle = `Implement ${spec.title}`;
   392→      const taskSlug = generateSlug(taskTitle);
   393→
   394→      // Ensure slug uniqueness across all namespaces + this import's slugs
   395→      let uniqueSlug = taskSlug;
   396→      let counter = 1;
   397→      while (importSlugs.has(uniqueSlug) || !refIndex.isSlugAvailable(uniqueSlug)) {
   398→        uniqueSlug = `${taskSlug}-${counter}`;
   399→        counter++;
   400→      }
   401→      importSlugs.add(uniqueSlug);
   402→      importReservedSlugs.add(uniqueSlug);
   403→
   404→      if (options.dryRun) {
   405→        info(`Would derive task: @${uniqueSlug} from ${specRef}`);
   406→        result.createdTasks.push(`@${uniqueSlug}`);
   407→      } else {
   408→        // AC: @plan-import ac-19 - Task has both spec_ref and plan_ref
   409→        const taskInput: TaskInput = {
   410→          title: taskTitle,
   411→          type: "task",
   412→          spec_ref: specRef,
   413→          plan_ref: planRef,
   414→          priority: 3,
   415→          slugs: [uniqueSlug],
   416→          tags: [],
   417→          depends_on: [],
   418→          notes: [],
   419→        };
   420→
   421→        const newTask = createTask(taskInput);
   422→
   423→        // AC: @plan-import ac-13 - Scoped implementation notes
   424→        const planSpec = parsed.specs.find(s =>
   425→          (s.slug || generateSlug(s.title)) === specSlug
   426→        );
   427→        if (planSpec?.implementation_notes) {
   428→          // Per-spec notes go directly to this task
   429→          newTask.notes.push({
   430→            _ulid: ulid(),
   431→            created_at: new Date().toISOString(),
   432→            author,
   433→            content: `Implementation notes:\n\n${planSpec.implementation_notes}`,
   434→          });
   435→        } else if (parsed.implementationNotes) {
   436→          // No per-spec notes — reference the plan
   437→          newTask.notes.push({
   438→            _ulid: ulid(),
   439→            created_at: new Date().toISOString(),
   440→            author,
   441→            content: `See plan ${planRef} for implementation notes`,
   442→          });
   443→        }
   444→
   445→        await saveTask(ctx, newTask);
   446→        result.createdTasks.push(`@${uniqueSlug}`);
   447→        newPlan.derived_tasks.push(`@${uniqueSlug}`);
   448→
   449→        info(`Derived task: @${uniqueSlug}`);
   450→      }
   451→    }
   452→  }
   453→
   454→  // Create manual tasks
   455→  // AC: @plan-import ac-27
   456→  if (parsed.tasks.additional_tasks) {
   457→    // Reload tasks to catch any created by derive loop above
   458→    // Combine with all slugs reserved during this import (plan + specs)
   459→    const manualTasks = await loadAllTasks(ctx);
   460→    const manualImportSlugs = new Set([
   461→      ...manualTasks.flatMap((t) => t.slugs),
   462→      ...importReservedSlugs,
   463→    ]);
   464→
   465→    for (const taskDef of parsed.tasks.additional_tasks) {
   466→      const taskSlug = taskDef.slug || generateSlug(taskDef.title);
   467→
   468→      // Ensure slug uniqueness across all namespaces + this import's slugs
   469→      let uniqueSlug = taskSlug;
   470→      let counter = 1;
   471→      while (manualImportSlugs.has(uniqueSlug) || !refIndex.isSlugAvailable(uniqueSlug)) {
   472→        uniqueSlug = `${taskSlug}-${counter}`;
   473→        counter++;
   474→      }
   475→      manualImportSlugs.add(uniqueSlug);
   476→
   477→      if (options.dryRun) {
   478→        info(`Would create manual task: @${uniqueSlug}`);
   479→        result.createdTasks.push(`@${uniqueSlug}`);
   480→      } else {
   481→        // AC: @plan-import ac-27 - Manual tasks have plan_ref but no spec_ref
   482→        const taskInput: TaskInput = {
   483→          title: taskDef.title,
   484→          type: "task",
   485→          plan_ref: planRef,
   486→          priority: taskDef.priority || 3,
   487→          slugs: [uniqueSlug],
   488→          tags: taskDef.tags || [],
   489→          depends_on: [],
   490→          notes: [],
   491→        };
   492→
   493→        if (taskDef.description) {
   494→          taskInput.notes = [
   495→            {
   496→              _ulid: ulid(),
   497→              created_at: new Date().toISOString(),
   498→              author,
   499→              content: taskDef.description,
   500→            },
   501→          ];
   502→        }
   503→
   504→        const newTask = createTask(taskInput);
   505→        await saveTask(ctx, newTask);
   506→        result.createdTasks.push(`@${uniqueSlug}`);
   507→        newPlan.derived_tasks.push(`@${uniqueSlug}`);
   508→
   509→        info(`Created manual task: @${uniqueSlug}`);
   510→      }
   511→    }
   512→  }
   513→
   514→  // Save plan record
   515→  // AC: @plan-import ac-24
   516→  if (!options.dryRun) {
   517→    await savePlan(ctx, newPlan);
   518→    await commitIfShadow(ctx.shadow, "plan-import", planSlug, parsed.title);
   519→  }
   520→
   521→  // AC: @plan-import ac-23, ac-29 - Summary output
   522→  const successCount =
   523→    result.createdSpecs.length +
   524→    result.updatedSpecs.length +
   525→    result.createdTasks.length;
   526→  const errorCount = result.errors.length + result.skipped.length;
   527→
   528→  // AC: @plan-import ac-32 - JSON output
   529→  if (isJsonMode()) {
   530→    output({
   531→      plan: planRef,
   532→      created_specs: result.createdSpecs,
   533→      updated_specs: result.updatedSpecs,
   534→      created_tasks: result.createdTasks,
   535→      errors: result.errors,
   536→      skipped: result.skipped,
   537→    });
   538→  } else {
   539→    // Human-readable output
   540→    if (options.dryRun) {
   541→      console.log("\nDry run - no changes made\n");
   542→    }
   543→
   544→    console.log(`Plan: ${planRef}`);
   545→    console.log(`Created ${result.createdSpecs.length} specs`);
   546→    if (result.updatedSpecs.length > 0) {
   547→      console.log(`Updated ${result.updatedSpecs.length} specs`);
   548→    }
   549→    console.log(`Created ${result.createdTasks.length} tasks`);
   550→
   551→    if (result.errors.length > 0) {
   552→      console.log(`\nErrors (${result.errors.length}):`);
   553→      for (const err of result.errors) {
   554→        console.log(`  - ${err.message}`);
   555→      }
   556→    }
   557→
   558→    if (result.skipped.length > 0) {
   559→      console.log(`\nSkipped (${result.skipped.length}):`);
   560→      for (const skip of result.skipped) {
   561→        console.log(`  - @${skip.slug}: ${skip.reason}`);
   562→      }
   563→    }
   564→
   565→    // AC: @plan-import ac-15, ac-23 - Exit code 0 on success
   566→    if (!options.dryRun && successCount > 0) {
   567→      success(
   568→        `\nImported plan: ${successCount} items created, ${errorCount} errors`,
   569→      );
   570→    }
   571→  }  // end of else block (non-JSON output)
   572→
   573→  // Exit code logic
   574→  // AC: @plan-import ac-15 - Dry run exits 0
   575→  // AC: @plan-import ac-23 - Success with some errors still exits 0
   576→  process.exit(EXIT_CODES.SUCCESS);
   577→}
   578→
   579→/**
   580→ * Generate URL-safe slug from title
   581→ */
   582→function generateSlug(title: string): string {
   583→  return title
   584→    .toLowerCase()
   585→    .replace(/[^a-z0-9]+/g, "-")
   586→    .replace(/^-|-$/g, "")
   587→    .slice(0, 50);
   588→}
