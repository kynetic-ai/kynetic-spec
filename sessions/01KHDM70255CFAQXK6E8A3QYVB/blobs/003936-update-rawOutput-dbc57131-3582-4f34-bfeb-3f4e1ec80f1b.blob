  1901→
  1902→  // kspec task review <ref>
  1903→  task
  1904→    .command("review <ref>")
  1905→    .description(
  1906→      "Get task context for review (task details, spec, ACs, git diff)",
  1907→    )
  1908→    .action(async (ref: string) => {
  1909→      try {
  1910→        const ctx = await initContext();
  1911→        const tasks = await loadAllTasks(ctx);
  1912→        const items = await loadAllItems(ctx);
  1913→        const index = new ReferenceIndex(tasks, items);
  1914→        const foundTask = resolveTaskRef(ref, tasks, index);
  1915→
  1916→        // Import getDiffSince from utils
  1917→        const { getDiffSince } = await import("../../utils/index.js");
  1918→
  1919→        // Gather review context
  1920→        const reviewContext: {
  1921→          task: typeof foundTask;
  1922→          spec: LoadedSpecItem | null;
  1923→          diff: string | null;
  1924→          started_at: string | null;
  1925→          testCoverage?: { covered: string[]; uncovered: string[] };
  1926→        } = {
  1927→          task: foundTask,
  1928→          spec: null,
  1929→          diff: null,
  1930→          started_at: foundTask.started_at || null,
  1931→        };
  1932→
  1933→        // Get spec item if task has spec_ref
  1934→        if (foundTask.spec_ref) {
  1935→          const specResult = index.resolve(foundTask.spec_ref);
  1936→          if (specResult.ok) {
  1937→            const specItem = items.find((i) => i._ulid === specResult.ulid);
  1938→            reviewContext.spec = specItem || null;
  1939→
  1940→            // Check test coverage for ACs if spec has them
  1941→            if (
  1942→              specItem?.acceptance_criteria &&
  1943→              specItem.acceptance_criteria.length > 0
  1944→            ) {
  1945→              const coveredACs = await scanTestCoverage(ctx.rootDir);
  1946→              const covered: string[] = [];
  1947→              const uncovered: string[] = [];
  1948→
  1949→              for (const ac of specItem.acceptance_criteria) {
  1950→                // Build possible references
  1951→                const possibleRefs: string[] = [];
  1952→                if (specItem.slugs && specItem.slugs.length > 0) {
  1953→                  possibleRefs.push(`@${specItem.slugs[0]} ${ac.id}`);
  1954→                  possibleRefs.push(`@${specItem.slugs[0]}`);
  1955→                }
  1956→                possibleRefs.push(`@${specItem._ulid.slice(0, 8)} ${ac.id}`);
  1957→                possibleRefs.push(`@${specItem._ulid.slice(0, 8)}`);
  1958→
  1959→                const isCovered = possibleRefs.some((ref) =>
  1960→                  coveredACs.has(ref),
  1961→                );
  1962→                if (isCovered) {
  1963→                  covered.push(ac.id);
  1964→                } else {
  1965→                  uncovered.push(ac.id);
  1966→                }
  1967→              }
  1968→
  1969→              reviewContext.testCoverage = { covered, uncovered };
  1970→            }
  1971→          }
  1972→        }
  1973→
  1974→        // Get git diff since task started
  1975→        if (foundTask.started_at) {
  1976→          const startedDate = new Date(foundTask.started_at);
  1977→          reviewContext.diff = getDiffSince(startedDate, ctx.rootDir);
  1978→        }
  1979→
  1980→        output(reviewContext, () => {
  1981→          console.log("=".repeat(60));
  1982→          console.log("Task Review Context");
  1983→          console.log("=".repeat(60));
  1984→          console.log();
  1985→
  1986→          // Task details
  1987→          console.log("TASK DETAILS");
  1988→          console.log("-".repeat(60));
  1989→          console.log(formatTaskDetails(foundTask, index));
  1990→          console.log();
  1991→
  1992→          // Spec details
  1993→          if (reviewContext.spec) {
  1994→            console.log("LINKED SPEC");
  1995→            console.log("-".repeat(60));
  1996→            console.log(`Title: ${reviewContext.spec.title}`);
  1997→            console.log(`Type: ${reviewContext.spec.type}`);
  1998→            if (reviewContext.spec.description) {
  1999→              console.log(`\nDescription:\n${reviewContext.spec.description}`);
  2000→            }
  2001→            if (
  2002→              reviewContext.spec.acceptance_criteria &&
  2003→              reviewContext.spec.acceptance_criteria.length > 0
  2004→            ) {
  2005→              console.log(
  2006→                `\nAcceptance Criteria (${reviewContext.spec.acceptance_criteria.length}):`,
  2007→              );
  2008→              for (const ac of reviewContext.spec.acceptance_criteria) {
  2009→                const isCovered = reviewContext.testCoverage?.covered.includes(
  2010→                  ac.id,
  2011→                );
  2012→                const coverageMarker = isCovered
  2013→                  ? chalk.green("✓")
  2014→                  : chalk.yellow("○");
  2015→                console.log(`  ${coverageMarker} [${ac.id}]`);
  2016→                console.log(`    Given: ${ac.given}`);
  2017→                console.log(`    When: ${ac.when}`);
  2018→                console.log(`    Then: ${ac.then}`);
  2019→              }
  2020→
  2021→              // Test coverage summary
  2022→              if (reviewContext.testCoverage) {
  2023→                const { covered, uncovered } = reviewContext.testCoverage;
  2024→                console.log();
  2025→                if (uncovered.length === 0) {
  2026→                  console.log(
  2027→                    chalk.green(
  2028→                      `  ✓ All ${covered.length} AC(s) have test coverage`,
  2029→                    ),
  2030→                  );
  2031→                } else {
  2032→                  console.log(
  2033→                    chalk.yellow(
  2034→                      `  Test coverage: ${covered.length}/${covered.length + uncovered.length} ACs covered`,
  2035→                    ),
  2036→                  );
  2037→                  console.log(
  2038→                    chalk.yellow(
  2039→                      `  Missing coverage for: ${uncovered.join(", ")}`,
  2040→                    ),
  2041→                  );
  2042→                }
  2043→              }
  2044→            }
  2045→            console.log();
  2046→          }
  2047→
  2048→          // Git diff
  2049→          if (reviewContext.diff) {
  2050→            console.log("CHANGES SINCE TASK STARTED");
  2051→            console.log("-".repeat(60));
  2052→            console.log(`Started at: ${foundTask.started_at}`);
  2053→            console.log();
  2054→            console.log(reviewContext.diff);
  2055→            console.log();
  2056→          } else if (foundTask.started_at) {
  2057→            console.log("CHANGES SINCE TASK STARTED");
  2058→            console.log("-".repeat(60));
  2059→            console.log(`Started at: ${foundTask.started_at}`);
  2060→            console.log("No changes detected");
  2061→            console.log();
  2062→          }
  2063→
  2064→          console.log("=".repeat(60));
  2065→          console.log("Review Checklist:");
  2066→          console.log("- Does the implementation match the task description?");
  2067→          if (reviewContext.spec) {
  2068→            console.log("- Are all acceptance criteria covered?");
  2069→            console.log("- Is test coverage adequate?");
  2070→          }
  2071→          console.log("- Are there any gaps or issues?");
  2072→          console.log("=".repeat(60));
  2073→        });
  2074→      } catch (err) {
  2075→        error("Failed to generate review context", err);
  2076→        process.exit(EXIT_CODES.ERROR);
  2077→      }
  2078→    });
  2079→
  2080→  // kspec task todos <ref>
  2081→  task
  2082→    .command("todos <ref>")
  2083→    .description("Show todos for a task")
  2084→    .action(async (ref: string) => {
  2085→      try {
  2086→        const ctx = await initContext();
