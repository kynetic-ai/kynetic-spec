    48→
    49→/**
    50→ * Find a task by reference with detailed error reporting.
    51→ * Returns the task or exits with appropriate error.
    52→ */
    53→function resolveTaskRef(
    54→  ref: string,
    55→  tasks: LoadedTask[],
    56→  index: ReferenceIndex,
    57→): LoadedTask {
    58→  const result = index.resolve(ref);
    59→
    60→  if (!result.ok) {
    61→    switch (result.error) {
    62→      case "not_found":
    63→        error(errors.reference.taskNotFound(ref));
    64→        break;
    65→      case "ambiguous":
    66→        error(errors.reference.ambiguous(ref));
    67→        for (const candidate of result.candidates) {
    68→          const task = tasks.find((t) => t._ulid === candidate);
    69→          const slug = task?.slugs[0] || "";
    70→          console.error(
    71→            `  - ${index.shortUlid(candidate)} ${slug ? `(${slug})` : ""}`,
    72→          );
    73→        }
    74→        break;
    75→      case "duplicate_slug":
    76→        error(errors.reference.slugMapsToMultiple(ref));
    77→        for (const candidate of result.candidates) {
    78→          console.error(`  - ${index.shortUlid(candidate)}`);
    79→        }
    80→        break;
    81→    }
    82→    // AC: @cli-exit-codes consistent-usage - NOT_FOUND for missing resources
    83→    process.exit(EXIT_CODES.NOT_FOUND);
    84→  }
    85→
    86→  // Check if it's actually a task
    87→  const task = tasks.find((t) => t._ulid === result.ulid);
    88→  if (!task) {
    89→    error(errors.reference.notTask(ref));
    90→    // AC: @cli-exit-codes consistent-usage - NOT_FOUND for missing resources
    91→    process.exit(EXIT_CODES.NOT_FOUND);
    92→  }
    93→
    94→  return task;
    95→}
    96→
    97→/**
    98→ * Batch-compatible resolver that returns null instead of calling process.exit().
    99→ * Used by executeBatchOperation to handle errors without terminating the process.
   100→ * AC: @multi-ref-batch ac-4, ac-8 - Partial failure handling and ref resolution
   101→ */
   102→function resolveTaskRefForBatch(
   103→  ref: string,
   104→  tasks: LoadedTask[],
   105→  index: ReferenceIndex,
   106→): { task: LoadedTask | null; error?: string } {
   107→  const result = index.resolve(ref);
   108→
   109→  if (!result.ok) {
   110→    let errorMsg: string;
   111→    switch (result.error) {
   112→      case "not_found":
   113→        errorMsg = `Reference "${ref}" not found`;
   114→        break;
   115→      case "ambiguous":
   116→        errorMsg = `Reference "${ref}" is ambiguous (matches ${result.candidates.length} items)`;
   117→        break;
   118→      case "duplicate_slug":
   119→        errorMsg = `Slug "${ref}" maps to multiple items`;
   120→        break;
   121→    }
   122→    return { task: null, error: errorMsg };
   123→  }
   124→
   125→  // Check if it's actually a task
   126→  const task = tasks.find((t) => t._ulid === result.ulid);
   127→  if (!task) {
   128→    return { task: null, error: `Reference "${ref}" is not a task` };
   129→  }
   130→
   131→  return { task };
   132→}
   133→
   134→/**
   135→ * Helper function to update task fields.
   136→ * Used by both single-ref and batch modes of task set.
   137→ * AC: @spec-task-set-batch ac-1, ac-2, ac-4, ac-5
   138→ */
   139→async function setTaskFields(
   140→  foundTask: LoadedTask,
   141→  ctx: any,
   142→  tasks: LoadedTask[],
   143→  items: LoadedSpecItem[],
   144→  _allMetaItems: any[],
   145→  index: ReferenceIndex,
   146→  options: any,
   147→): Promise<{
   148→  success: boolean;
   149→  message?: string;
   150→  error?: string;
   151→  data?: unknown;
   152→}> {
   153→  try {
   154→    // Check slug uniqueness if adding a new slug
   155→    if (options.slug) {
   156→      const slugCheck = checkSlugUniqueness(
   157→        index,
   158→        [options.slug],
   159→        foundTask._ulid,
   160→      );
   161→      if (!slugCheck.ok) {
   162→        return {
   163→          success: false,
   164→          error: `Slug "${slugCheck.slug}" already exists on ${slugCheck.existingUlid}`,
   165→        };
   166→      }
   167→    }
   168→
   169→    // Build updated task with only provided options
   170→    const updatedTask: Task = { ...foundTask };
   171→    const changes: string[] = [];
   172→
   173→    if (options.title) {
   174→      updatedTask.title = options.title;
   175→      changes.push("title");
   176→    }
   177→
   178→    if (options.specRef) {
   179→      // Validate the spec ref exists and is a spec item
   180→      const specResult = index.resolve(options.specRef);
   181→      if (!specResult.ok) {
   182→        return {
   183→          success: false,
   184→          error: errors.reference.specRefNotFound(options.specRef),
   185→        };
   186→      }
   187→      // Check it's not a task
   188→      const isTask = tasks.some((t) => t._ulid === specResult.ulid);
   189→      if (isTask) {
   190→        return {
   191→          success: false,
   192→          error: errors.reference.specRefIsTask(options.specRef),
   193→        };
   194→      }
   195→      updatedTask.spec_ref = options.specRef;
   196→      changes.push("spec_ref");
   197→    }
   198→
   199→    if (options.metaRef) {
   200→      // Validate the meta ref exists and is a meta item
   201→      const metaRefResult = index.resolve(options.metaRef);
   202→      if (!metaRefResult.ok) {
   203→        return {
   204→          success: false,
   205→          error: errors.reference.metaRefNotFound(options.metaRef),
   206→        };
   207→      }
   208→
   209→      // Check if the resolved item is a meta item (not a spec item or task)
   210→      const isTask = tasks.some((t) => t._ulid === metaRefResult.ulid);
   211→      const isSpecItem = items.some((i) => i._ulid === metaRefResult.ulid);
   212→
   213→      if (isTask || isSpecItem) {
   214→        return {
   215→          success: false,
   216→          error: errors.reference.metaRefPointsToSpec(options.metaRef),
   217→        };
   218→      }
   219→
   220→      updatedTask.meta_ref = options.metaRef;
   221→      changes.push("meta_ref");
   222→    }
   223→
   224→    if (options.planRef !== undefined) {
   225→      // Handle 'null' string to clear plan_ref
   226→      if (options.planRef === "null") {
   227→        updatedTask.plan_ref = null;
   228→        changes.push("plan_ref: cleared");
   229→      } else {
   230→        // First check if it's a task or spec item (wrong type)
   231→        const cleanRef = options.planRef.startsWith("@")
   232→          ? options.planRef.slice(1)
   233→          : options.planRef;
   234→
   235→        const isTask = tasks.some(
   236→          (t) =>
   237→            t.slugs.includes(cleanRef) ||
   238→            t._ulid === cleanRef ||
   239→            t._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   240→        );
   241→        const isSpecItem = items.some(
   242→          (i) =>
   243→            i.slugs.includes(cleanRef) ||
   244→            i._ulid === cleanRef ||
   245→            i._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   246→        );
   247→
   248→        if (isTask || isSpecItem) {
   249→          return {
   250→            success: false,
   251→            error: `Reference "${options.planRef}" is not a plan`,
   252→          };
   253→        }
   254→
   255→        // Now check if the plan exists
   256→        const { findPlanByRef } = await import("../../parser/plans.js");
   257→        const plan = await findPlanByRef(ctx, options.planRef);
   258→
   259→        if (!plan) {
   260→          return {
   261→            success: false,
   262→            error: `Plan reference not found: ${options.planRef}`,
   263→          };
   264→        }
   265→
   266→        updatedTask.plan_ref = options.planRef;
   267→        changes.push("plan_ref");
   268→      }
   269→    }
   270→
   271→    if (options.priority) {
   272→      const priorityResult = parseIntOption(options.priority, {
   273→        min: 1,
   274→        max: 5,
   275→        name: "Priority",
   276→      });
   277→      if (!priorityResult.ok) {
   278→        return { success: false, error: priorityResult.error };
   279→      }
   280→      updatedTask.priority = priorityResult.value;
   281→      changes.push("priority");
   282→    }
   283→
   284→    if (options.slug) {
   285→      if (!updatedTask.slugs.includes(options.slug)) {
   286→        updatedTask.slugs = [...updatedTask.slugs, options.slug];
   287→        changes.push("slug");
   288→      }
   289→    }
   290→
   291→    if (options.tag) {
   292→      const parsedTags = parseTagsArray(options.tag);
   293→      const newTags = parsedTags.filter(
   294→        (t: string) => !updatedTask.tags.includes(t),
   295→      );
   296→      if (newTags.length > 0) {
   297→        updatedTask.tags = [...updatedTask.tags, ...newTags];
   298→        changes.push("tags");
   299→      }
   300→    }
   301→
   302→    if (options.dependsOn) {
   303→      // Validate all dependency refs
   304→      for (const depRef of options.dependsOn) {
   305→        const depResult = index.resolve(depRef);
   306→        if (!depResult.ok) {
   307→          return {
   308→            success: false,
   309→            error: errors.reference.depNotFound(depRef),
   310→          };
   311→        }
   312→        // Ensure the dependency is a task, not a spec item
   313→        const isTask = tasks.some((t) => t._ulid === depResult.ulid);
   314→        if (!isTask) {
   315→          return {
   316→            success: false,
   317→            error: `Reference "${depRef}" is not a task`,
   318→          };
   319→        }
   320→      }
   321→      updatedTask.depends_on = options.dependsOn.map((ref: string) =>
   322→        ref.startsWith("@") ? ref : `@${ref}`,
   323→      );
   324→      changes.push("depends_on");
   325→    }
   326→
   327→    // AC: @spec-task-clear-deps ac-1, ac-2 - Clear all dependencies
   328→    if (options.clearDeps) {
   329→      if (foundTask.depends_on.length === 0) {
   330→        // AC: @spec-task-clear-deps ac-2 - No changes needed
   331→        return {
   332→          success: true,
   333→          message: "No changes: task has no dependencies to clear",
   334→        };
   335→      }
   336→      updatedTask.depends_on = [];
   337→      changes.push("depends_on");
   338→
   339→      // Add note documenting the change
   340→      // AC: @task-set ac-author
   341→      const note = createNote(
   342→        `Dependencies cleared (was: ${foundTask.depends_on.join(", ")})`,
   343→        getAuthor(),
   344→      );
   345→      updatedTask.notes = [...updatedTask.notes, note];
   346→    }
   347→
   348→    // AC: @task-automation-eligibility ac-5, ac-11, ac-12, ac-18
   349→    // Handle automation status changes
   350→    // Note: --no-automation sets options.automation to false, so check that first
   351→    if (options.automation === false) {
   352→      // --no-automation flag clears the automation status (AC: ac-12)
   353→      delete updatedTask.automation;
   354→      changes.push("automation");
   355→    } else if (options.automation !== undefined) {
   356→      const automationResult = validateEnumOption(
   357→        options.automation,
   358→        ["eligible", "needs_review", "manual_only"] as const,
   359→        "automation status",
   360→      );
   361→      if (!automationResult.ok) {
   362→        return { success: false, error: automationResult.error };
   363→      }
   364→
   365→      // AC: @task-automation-eligibility ac-18 - require reason for needs_review
   366→      if (options.automation === "needs_review" && !options.reason) {
   367→        return {
   368→          success: false,
   369→          error:
   370→            "Setting automation to needs_review requires --reason flag explaining why",
   371→        };
   372→      }
   373→
   374→      updatedTask.automation = automationResult.value;
   375→      changes.push("automation");
   376→
   377→      // If reason provided, add a note documenting the change
   378→      // AC: @task-set ac-author
   379→      if (options.reason) {
   380→        const note = createNote(
   381→          `Automation status set to ${automationResult.value}: ${options.reason}`,
   382→          getAuthor(),
   383→        );
   384→        updatedTask.notes = [...updatedTask.notes, note];
   385→        changes.push("note");
   386→      }
   387→    }
   388→
   389→    // AC: @spec-task-set-batch ac-4 - Warn on no changes, don't fail
   390→    if (changes.length === 0) {
   391→      return {
   392→        success: true,
   393→        message: "No changes specified",
   394→        data: { task: updatedTask },
   395→      };
   396→    }
   397→
   398→    await saveTask(ctx, updatedTask);
   399→    await commitIfShadow(
   400→      ctx.shadow,
   401→      "task-set",
   402→      foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
   403→      changes.join(", "),
   404→    );
   405→
   406→    return {
   407→      success: true,
   408→      message: `Updated task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(", ")})`,
   409→      data: { task: updatedTask },
   410→    };
   411→  } catch (err) {
   412→    return {
   413→      success: false,
   414→      error: err instanceof Error ? err.message : String(err),
   415→    };
   416→  }
   417→}
   418→
   419→/**
   420→ * Register the 'task' command group (singular - operations on individual tasks)
   421→ */
   422→export function registerTaskCommands(program: Command): void {
   423→  const task = program
   424→    .command("task")
   425→    .description("Operations on individual tasks")
   426→    .allowUnknownOption()
   427→    .allowExcessArguments();
   428→
   429→  // AC: @command-group-default-actions ac-bare-task, ac-unknown-subcommand
   430→  // Default action when no subcommand is given (e.g. `kspec task` or `kspec task --status pending`)
   431→  task.action(async (_options: Record<string, unknown>, cmd: Command) => {
   432→    const { Command: Cmd } = await import("commander");
   433→    const listCmd = addListOptions(new Cmd("_list"));
   434→    listCmd.exitOverride();
   435→    try {
   436→      listCmd.parse(cmd.args, { from: "user" });
   437→    } catch {
   438→      console.error(chalk.gray(`Run 'kspec task --help' to see available subcommands`));
   439→      process.exit(EXIT_CODES.ERROR);
   440→    }
   441→
   442→    // AC: @command-group-default-actions ac-unknown-subcommand
   443→    if (listCmd.args.length > 0) {
   444→      const unknownCmd = listCmd.args[0];
   445→      const subcommandNames = cmd.commands.map((c: Command) => c.name());
   446→      const suggestion = findClosestCommand(unknownCmd, subcommandNames);
   447→      console.error(chalk.red(`error: unknown command 'task ${unknownCmd}'`));
   448→      if (suggestion) {
   449→        console.error(chalk.yellow(`Did you mean: kspec task ${suggestion}?`));
   450→      } else {
   451→        console.error(chalk.gray(`Run 'kspec task --help' to see available subcommands`));
   452→      }
   453→      process.exit(EXIT_CODES.ERROR);
   454→    }
   455→
   456→    // AC: @command-group-default-actions ac-bare-with-options
   457→    await listTasksAction(listCmd.opts());
   458→  });
   459→
   460→  // kspec task list - alias for 'kspec tasks list'
   461→  task
   462→    .command("list")
   463→    .description("List all tasks (alias for 'kspec tasks list')")
   464→    .option("-s, --status <status>", "Filter by status")
   465→    .option("-t, --type <type>", "Filter by type")
   466→    .option("--tag <tag>", "Filter by tag")
   467→    .option("--meta-ref <ref>", "Filter by meta reference")
   468→    .option("-g, --grep <pattern>", "Search content with regex pattern")
   469→    .option("-v, --verbose", "Show more details")
   470→    .option("--full", "Show full details (notes, todos, timestamps)")
   471→    .option("--count", "Show only the count of matching tasks")
   472→    .action(async (options) => {
   473→      await listTasksAction(options);
   474→    });
   475→
   476→  // kspec task get <ref>
   477→  task
   478→    .command("get <ref>")
   479→    .description("Get task details")
   480→    .action(async (ref: string) => {
   481→      try {
   482→        const ctx = await initContext();
   483→        const tasks = await loadAllTasks(ctx);
   484→        const _items = await loadAllItems(ctx);
   485→
   486→        // Build all indexes including TraitIndex
   487→        const { refIndex: index, traitIndex } = await (async () => {
   488→          const { buildIndexes } = await import("../../parser/index.js");
   489→          return buildIndexes(ctx);
   490→        })();
   491→
   492→        const foundTask = resolveTaskRef(ref, tasks, index);
   493→
   494→        // AC: @trait-display ac-3 - task get shows inherited AC sections
   495→        // Get inherited traits if task has spec_ref
   496→        let inheritedTraits: Array<{
   497→          trait: {
   498→            ulid: string;
   499→            slug: string;
   500→            title: string;
   501→            description?: string;
   502→          };
   503→          acs: Array<{
   504→            id: string;
   505→            given?: string;
   506→            when?: string;
   507→            then?: string;
   508→          }>;
   509→        }> = [];
   510→        if (foundTask.spec_ref) {
   511→          const specResult = index.resolve(foundTask.spec_ref);
   512→          if (specResult.ok) {
   513→            const specUlid = specResult.ulid;
   514→            const inheritedAC = traitIndex.getInheritedAC(specUlid);
   515→            const traitsByTrait = new Map<
   516→              string,
   517→              {
   518→                trait: (typeof inheritedAC)[0]["trait"];
   519→                acs: Array<{
   520→                  id: string;
   521→                  given?: string;
   522→                  when?: string;
   523→                  then?: string;
   524→                }>;
   525→              }
   526→            >();
   527→            for (const { trait, ac } of inheritedAC) {
   528→              if (!traitsByTrait.has(trait.ulid)) {
   529→                traitsByTrait.set(trait.ulid, { trait, acs: [] });
   530→              }
   531→              traitsByTrait.get(trait.ulid)?.acs.push(ac);
   532→            }
   533→            inheritedTraits = Array.from(traitsByTrait.values());
   534→          }
   535→        }
   536→
   537→        // Build JSON output with inherited traits (AC: @trait-display ac-2)
   538→        const jsonOutput = {
   539→          ...foundTask,
   540→          ...(inheritedTraits.length > 0 && {
   541→            inherited_traits: inheritedTraits.map(({ trait, acs }) => ({
   542→              ref: `@${trait.slug}`,
   543→              title: trait.title,
   544→              acceptance_criteria: acs,
   545→            })),
   546→          }),
   547→        };
   548→
   549→        output(jsonOutput, () => {
   550→          formatTaskDetails(foundTask, index);
   551→
   552→          // AC: @trait-display ac-3, ac-4, ac-5 - Show inherited AC per trait in labeled sections
   553→          if (inheritedTraits.length > 0) {
   554→            for (const { trait, acs } of inheritedTraits) {
   555→              console.log(
   556→                chalk.gray(`\n─── Inherited from @${trait.slug} ───`),
   557→              );
   558→              for (const ac of acs) {
   559→                console.log(
   560→                  chalk.cyan(`  [${ac.id}]`) +
   561→                    chalk.gray(` (from @${trait.slug})`),
   562→                );
   563→                if (ac.given) console.log(`    Given: ${ac.given}`);
   564→                if (ac.when) console.log(`    When: ${ac.when}`);
   565→                if (ac.then) console.log(`    Then: ${ac.then}`);
   566→              }
   567→            }
   568→          }
   569→        });
   570→      } catch (err) {
   571→        error(errors.failures.getTask, err);
   572→        process.exit(EXIT_CODES.ERROR);
   573→      }
   574→    });
   575→
   576→  // kspec task add
   577→  markMutating(task.command("add"))
   578→    .description("Create a new task")
   579→    .requiredOption("--title <title>", "Task title")
   580→    .option("--description <description>", "Task description")
   581→    .option(
   582→      "--type <type>",
   583→      "Task type (task, epic, bug, spike, infra)",
   584→      "task",
   585→    )
   586→    .option("--spec-ref <ref>", "Reference to spec item")
   587→    .option(
   588→      "--meta-ref <ref>",
   589→      "Reference to meta item (workflow, agent, or convention)",
   590→    )
   591→    .option("--plan-ref <ref>", "Reference to plan this task is derived from")
   592→    .option("--priority <n>", "Priority (1-5)", "3")
   593→    .option("--slug <slug>", "Human-friendly slug")
   594→    .option("--tag <tag...>", "Tags")
   595→    .option("--depends-on <refs...>", "Set task dependencies")
   596→    .option(
   597→      "--automation <status>",
   598→      "Automation eligibility (eligible, needs_review, manual_only)",
   599→    )
   600→    .addHelpText(
   601→      "after",
   602→      `
   603→Examples:
   604→  $ kspec task add --title "Implement feature" --spec-ref @feature-spec
   605→  $ kspec task add --title "Fix bug" --type bug --priority 1
   606→  $ kspec task add --title "Multi-tag task" --tag cli urgent`,
   607→    )
   608→    .action(async (options) => {
   609→      try {
   610→        const ctx = await initContext();
   611→        const tasks = await loadAllTasks(ctx);
   612→        const items = await loadAllItems(ctx);
   613→
   614→        // Load meta items for validation
   615→        const { loadMetaContext } = await import("../../parser/meta.js");
   616→        const metaContext = await loadMetaContext(ctx);
   617→        const allMetaItems = [
   618→          ...metaContext.agents,
   619→          ...metaContext.workflows,
   620→          ...metaContext.conventions,
   621→          ...metaContext.observations,
   622→        ];
   623→
   624→        // Build index for reference validation
   625→        const refIndex = new ReferenceIndex(tasks, items, allMetaItems);
   626→
   627→        // Check slug uniqueness if provided
   628→        if (options.slug) {
   629→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   630→          if (!slugCheck.ok) {
   631→            error(
   632→              errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid),
   633→            );
   634→            process.exit(EXIT_CODES.CONFLICT);
   635→          }
   636→        }
   637→
   638→        // Validate meta_ref if provided (AC-meta-ref-3, AC-meta-ref-4)
   639→        if (options.metaRef) {
   640→          const metaRefResult = refIndex.resolve(options.metaRef);
   641→
   642→          if (!metaRefResult.ok) {
   643→            error(errors.reference.metaRefNotFound(options.metaRef));
   644→            process.exit(EXIT_CODES.NOT_FOUND);
   645→          }
   646→
   647→          // Check if the resolved item is a meta item (not a spec item or task)
   648→          const isTask = tasks.some((t) => t._ulid === metaRefResult.ulid);
   649→          const isSpecItem = items.some((i) => i._ulid === metaRefResult.ulid);
   650→
   651→          if (isTask || isSpecItem) {
   652→            error(errors.reference.metaRefPointsToSpec(options.metaRef));
   653→            process.exit(EXIT_CODES.NOT_FOUND);
   654→          }
   655→        }
   656→
   657→        // Validate spec_ref if provided — must point to a spec item, not a task or meta item
   658→        if (options.specRef) {
   659→          const specRefResult = validateSpecRef(
   660→            options.specRef,
   661→            refIndex,
   662→            tasks,
   663→            items,
   664→          );
   665→          if (!specRefResult.ok) {
   666→            error(specRefResult.error);
   667→            process.exit(EXIT_CODES.NOT_FOUND);
   668→          }
   669→        }
   670→
   671→        // AC: @task-automation-eligibility ac-13 - validate automation if provided
   672→        let automationValue:
   673→          | "eligible"
   674→          | "needs_review"
   675→          | "manual_only"
   676→          | undefined;
   677→        if (options.automation) {
   678→          const automationResult = validateEnumOption(
   679→            options.automation,
   680→            ["eligible", "needs_review", "manual_only"] as const,
   681→            "automation status",
   682→          );
   683→          if (!automationResult.ok) {
   684→            error(automationResult.error);
   685→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   686→          }
   687→          automationValue = automationResult.value;
   688→        }
   689→
   690→        // Validate plan_ref if provided (AC: @plan-derive ac-5, ac-6)
   691→        if (options.planRef) {
   692→          // First check if it's a task or spec item (wrong type)
   693→          const cleanRef = options.planRef.startsWith("@")
   694→            ? options.planRef.slice(1)
   695→            : options.planRef;
   696→
   697→          const isTask = tasks.some(
   698→            (t) =>
   699→              t.slugs.includes(cleanRef) ||
   700→              t._ulid === cleanRef ||
   701→              t._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   702→          );
   703→          const isSpecItem = items.some(
   704→            (i) =>
   705→              i.slugs.includes(cleanRef) ||
   706→              i._ulid === cleanRef ||
   707→              i._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   708→          );
   709→
   710→          if (isTask || isSpecItem) {
   711→            error(`Reference "${options.planRef}" is not a plan`);
   712→            process.exit(EXIT_CODES.NOT_FOUND);
   713→          }
   714→
   715→          // Now check if the plan exists
   716→          const { findPlanByRef } = await import("../../parser/plans.js");
   717→          const plan = await findPlanByRef(ctx, options.planRef);
   718→
   719→          if (!plan) {
   720→            error(`Plan reference not found: ${options.planRef}`);
   721→            process.exit(EXIT_CODES.NOT_FOUND);
   722→          }
   723→        }
   724→
   725→        // AC: @task-add-depends-on ac-2 - Validate dependency refs
   726→        if (options.dependsOn) {
   727→          for (const depRef of options.dependsOn) {
   728→            const depResult = refIndex.resolve(depRef);
   729→            if (!depResult.ok) {
   730→              error(errors.reference.depNotFound(depRef));
   731→              process.exit(EXIT_CODES.NOT_FOUND);
   732→            }
   733→            // Ensure the dependency is a task, not a spec item
   734→            const isTask = tasks.some((t) => t._ulid === depResult.ulid);
   735→            if (!isTask) {
   736→              error(`Reference "${depRef}" is not a task`);
   737→              process.exit(EXIT_CODES.NOT_FOUND);
   738→            }
   739→          }
   740→        }
   741→
   742→        // Validate priority
   743→        const priorityResult = parseIntOption(options.priority, {
   744→          min: 1,
   745→          max: 5,
   746→          name: "Priority",
   747→        });
   748→        if (!priorityResult.ok) {
   749→          error(priorityResult.error);
   750→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   751→        }
   752→
   753→        // AC: @spec-task-add-description ac-6 - Omit description if empty string
   754→        const descriptionValue =
   755→          options.description && options.description.trim() !== ""
   756→            ? options.description
   757→            : undefined;
   758→
   759→        const input: TaskInput = {
   760→          title: options.title,
   761→          description: descriptionValue,
   762→          type: options.type,
   763→          spec_ref: options.specRef || null,
   764→          meta_ref: options.metaRef || null,
   765→          plan_ref: options.planRef || null,
   766→          priority: priorityResult.value,
   767→          slugs: options.slug ? [options.slug] : [],
   768→          tags: parseTagsArray(options.tag),
   769→          depends_on: (options.dependsOn || []).map((ref: string) =>
   770→            ref.startsWith("@") ? ref : `@${ref}`,
   771→          ),
   772→          automation: automationValue,
   773→        };
   774→
   775→        const newTask = createTask(input);
   776→        await saveTask(ctx, newTask);
   777→        await commitIfShadow(
   778→          ctx.shadow,
   779→          "task-add",
   780→          newTask.slugs[0] || newTask._ulid.slice(0, 8),
   781→          newTask.title,
   782→        );
   783→
   784→        // Build index including the new task for accurate short ULID
   785→        const index = new ReferenceIndex(
   786→          [...tasks, newTask],
   787→          items,
   788→          allMetaItems,
   789→        );
   790→        success(`Created task: ${index.shortUlid(newTask._ulid)}`, {
   791→          task: newTask,
   792→        });
   793→      } catch (err) {
   794→        error(errors.failures.createTask, err);
   795→        process.exit(EXIT_CODES.ERROR);
   796→      }
   797→    });
   798→
   799→  // kspec task set <ref>
   800→  markMutating(task.command("set [ref]"))
   801→    .description("Update task fields")
   802→    .option(
   803→      "--refs <refs...>",
   804→      "Update multiple tasks (AC: @spec-task-set-batch ac-1)",
   805→    )
   806→    .option("--title <title>", "Update task title")
   807→    .option("--spec-ref <ref>", "Link to spec item")
   808→    .option(
   809→      "--meta-ref <ref>",
   810→      "Link to meta item (workflow, agent, or convention)",
   811→    )
   812→    .option("--plan-ref <ref>", "Link to plan (use 'null' to clear)")
   813→    .option("--priority <n>", "Set priority (1-5)")
   814→    .option("--slug <slug>", "Add a slug alias")
   815→    .option("--tag <tag...>", "Add tags")
   816→    .option("--depends-on <refs...>", "Set dependencies (replaces existing)")
   817→    .option("--clear-deps", "Clear all dependencies")
   818→    .option(
   819→      "--automation <status>",
   820→      "Set automation eligibility (eligible, needs_review, manual_only)",
   821→    )
   822→    .option("--no-automation", "Clear automation status (return to unassessed)")
   823→    .option(
   824→      "--reason <reason>",
   825→      "Reason for status change (required when setting needs_review)",
   826→    )
   827→    .option(
   828→      "--status <status>",
   829→      "Reject with error - use state transition commands instead",
   830→    )
   831→    .addHelpText(
   832→      "after",
   833→      `
   834→Examples:
   835→  $ kspec task set @task-slug --priority 2
   836→  $ kspec task set @task-slug --depends-on @dep1 @dep2
   837→  $ kspec task set @task-slug --tag cli urgent
   838→  $ kspec task set --refs @task1 @task2 --priority 3`,
   839→    )
   840→    .action(async (ref: string | undefined, options) => {
   841→      try {
   842→        // AC: @spec-task-set-batch ac-3 - Reject --status flag
   843→        if (options.status !== undefined) {
   844→          error(
   845→            "Use state transition commands (start, complete, block, etc.) to change status",
   846→          );
   847→          process.exit(EXIT_CODES.USAGE_ERROR);
   848→        }
   849→
   850→        // AC: @spec-task-clear-deps ac-3 - Mutual exclusivity check
   851→        if (options.clearDeps && options.dependsOn) {
   852→          error("Cannot use --clear-deps and --depends-on together");
   853→          process.exit(EXIT_CODES.USAGE_ERROR);
   854→        }
   855→
   856→        const ctx = await initContext();
   857→        const tasks = await loadAllTasks(ctx);
   858→        const items = await loadAllItems(ctx);
   859→
   860→        // Load meta items for validation
   861→        const { loadMetaContext } = await import("../../parser/meta.js");
   862→        const metaContext = await loadMetaContext(ctx);
   863→        const allMetaItems = [
   864→          ...metaContext.agents,
   865→          ...metaContext.workflows,
   866→          ...metaContext.conventions,
   867→          ...metaContext.observations,
   868→        ];
   869→
   870→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   871→
   872→        // AC: @trait-multi-ref-batch ac-8 - Deduplicate refs
   873→        const refsFlag = options.refs
   874→          ? [...new Set(options.refs as string[])]
   875→          : undefined;
   876→
   877→        // Batch mode or single mode?
   878→        if (refsFlag && refsFlag.length > 0) {
   879→          // Batch mode - AC: @spec-task-set-batch ac-1, ac-2, ac-5
   880→          const result = await executeBatchOperation({
   881→            positionalRef: ref,
   882→            refsFlag,
   883→            context: { ctx, tasks, items, allMetaItems, index, options },
   884→            items: tasks,
   885→            index,
   886→            resolveRef: (
   887→              refStr: string,
   888→              taskList: LoadedTask[],
   889→              idx: ReferenceIndex,
   890→            ) => {
   891→              const result = resolveTaskRefForBatch(refStr, taskList, idx);
   892→              return { item: result.task, error: result.error };
   893→            },
   894→            executeOperation: async (task: LoadedTask, context) => {
   895→              return await setTaskFields(
   896→                task,
   897→                context.ctx,
   898→                context.tasks,
   899→                context.items,
   900→                context.allMetaItems,
   901→                context.index,
   902→                context.options,
   903→              );
   904→            },
   905→            getUlid: (task: LoadedTask) => task._ulid,
   906→          });
   907→
   908→          formatBatchOutput(result, "Set");
   909→        } else {
   910→          // Single mode - existing behavior
   911→          if (!ref) {
   912→            error("Either provide a positional ref or use --refs flag");
   913→            process.exit(EXIT_CODES.USAGE_ERROR);
   914→          }
   915→
   916→          const foundTask = resolveTaskRef(ref, tasks, index);
   917→          const result = await setTaskFields(
   918→            foundTask,
   919→            ctx,
   920→            tasks,
   921→            items,
   922→            allMetaItems,
   923→            index,
   924→            options,
   925→          );
   926→
   927→          if (!result.success) {
   928→            error(result.error || "Failed to update task");
   929→            process.exit(EXIT_CODES.ERROR);
   930→          }
   931→
   932→          if (result.message) {
   933→            // AC: @spec-task-set-batch ac-4 - Warn on no changes
   934→            if (result.message.includes("No changes")) {
   935→              if (isJsonMode()) {
   936→                output({ success: true, message: result.message });
   937→              } else {
   938→                warn(result.message);
   939→              }
   940→            } else {
   941→              success(
   942→                result.message,
   943→                result.data as Record<string, unknown> | undefined,
   944→              );
   945→            }
   946→          }
   947→        }
   948→      } catch (err) {
   949→        error(errors.failures.updateTask, err);
   950→        process.exit(EXIT_CODES.ERROR);
   951→      }
   952→    });
   953→
   954→  // kspec task patch <ref>
   955→  markMutating(task.command("patch <ref>"))
   956→    .description("Update task with JSON data")
   957→    .option("--data <json>", "JSON object with fields to update")
   958→    .option("--dry-run", "Show what would change without writing")
   959→    .option("--allow-unknown", "Allow unknown fields (for extending format)")
   960→    .action(async (ref: string, options) => {
   961→      try {
   962→        const ctx = await initContext();
   963→        const tasks = await loadAllTasks(ctx);
   964→        const items = await loadAllItems(ctx);
   965→
   966→        // Load meta items for validation
   967→        const { loadMetaContext } = await import("../../parser/meta.js");
   968→        const metaContext = await loadMetaContext(ctx);
   969→        const allMetaItems = [
   970→          ...metaContext.agents,
   971→          ...metaContext.workflows,
   972→          ...metaContext.conventions,
   973→          ...metaContext.observations,
   974→        ];
   975→
   976→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   977→        const foundTask = resolveTaskRef(ref, tasks, index);
   978→
   979→        // Get JSON data from --data flag or stdin
   980→        let jsonData: string;
   981→        if (options.data) {
   982→          jsonData = options.data;
   983→        } else {
   984→          // Read from stdin
   985→          const chunks: Buffer[] = [];
   986→          for await (const chunk of process.stdin) {
   987→            chunks.push(chunk);
   988→          }
   989→          jsonData = Buffer.concat(chunks).toString("utf-8");
   990→        }
   991→
   992→        // Parse JSON
   993→        let patchData: Record<string, unknown>;
   994→        try {
   995→          patchData = JSON.parse(jsonData);
   996→        } catch (parseErr) {
   997→          error(errors.validation.invalidJson, parseErr);
   998→          process.exit(EXIT_CODES.ERROR);
   999→        }
  1000→
  1001→        // Validate against TaskInputSchema (partial)
  1002→        const { TaskInputSchema } = await import("../../schema/index.js");
  1003→
  1004→        // Create a partial schema for validation
  1005→        const partialSchema = options.allowUnknown
  1006→          ? TaskInputSchema.partial().passthrough()
  1007→          : TaskInputSchema.partial().strict();
  1008→
  1009→        let validatedPatch: Partial<TaskInput>;
  1010→        try {
  1011→          validatedPatch = partialSchema.parse(patchData);
  1012→        } catch (validationErr) {
  1013→          error(
  1014→            errors.validation.invalidPatchData(String(validationErr)),
  1015→            validationErr,
  1016→          );
  1017→          process.exit(EXIT_CODES.ERROR);
  1018→        }
  1019→
  1020→        // Check for unknown fields if strict mode
  1021→        if (!options.allowUnknown) {
  1022→          const knownFields = Object.keys(TaskInputSchema.shape);
  1023→          const providedFields = Object.keys(patchData);
  1024→          const unknownFields = providedFields.filter(
  1025→            (f) => !knownFields.includes(f),
  1026→          );
  1027→
  1028→          if (unknownFields.length > 0) {
  1029→            error(errors.validation.unknownFields(unknownFields));
  1030→            process.exit(EXIT_CODES.ERROR);
  1031→          }
  1032→        }
  1033→
  1034→        // Build updated task
  1035→        const updatedTask: Task = { ...foundTask, ...validatedPatch };
  1036→
  1037→        // Track changes for output
  1038→        const changes = Object.keys(validatedPatch);
  1039→
  1040→        if (options.dryRun) {
  1041→          info("Dry run - no changes will be written");
  1042→          info(`Would update: ${changes.join(", ")}`);
  1043→          output({ changes, updated: updatedTask }, () => {
  1044→            console.log(`\nChanges: ${changes.join(", ")}\n`);
  1045→            return formatTaskDetails(updatedTask, index);
  1046→          });
  1047→          return;
  1048→        }
  1049→
  1050→        await saveTask(ctx, updatedTask);
  1051→        await commitIfShadow(
  1052→          ctx.shadow,
  1053→          "task-patch",
  1054→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1055→          changes.join(", "),
  1056→        );
  1057→        success(
  1058→          `Patched task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(", ")})`,
  1059→          { task: updatedTask },
  1060→        );
  1061→      } catch (err) {
  1062→        error(errors.failures.patchTask, err);
  1063→        process.exit(EXIT_CODES.ERROR);
  1064→      }
  1065→    });
  1066→
  1067→  // kspec task start <ref>
  1068→  markMutating(task.command("start <ref>"))
  1069→    .description("Start working on a task (pending -> in_progress)")
  1070→    .option("--no-sync", "Skip syncing spec implementation status")
  1071→    .action(async (ref: string, options) => {
  1072→      try {
  1073→        const ctx = await initContext();
  1074→        const tasks = await loadAllTasks(ctx);
  1075→        const items = await loadAllItems(ctx);
  1076→        const index = new ReferenceIndex(tasks, items);
  1077→        const foundTask = resolveTaskRef(ref, tasks, index);
  1078→
  1079→        if (foundTask.status === "in_progress") {
  1080→          warn("Task is already in progress");
  1081→          output(foundTask, () => formatTaskDetails(foundTask));
  1082→          return;
  1083→        }
  1084→
  1085→        if (foundTask.status !== "pending") {
  1086→          error(errors.status.cannotStart(foundTask.status));
  1087→          process.exit(EXIT_CODES.VALIDATION_FAILED); // Exit code 4 = invalid state
  1088→        }
  1089→
  1090→        // Update status
  1091→        const updatedTask: Task = {
  1092→          ...foundTask,
  1093→          status: "in_progress",
  1094→          started_at: new Date().toISOString(),
  1095→        };
  1096→
  1097→        await saveTask(ctx, updatedTask);
  1098→        await commitIfShadow(
  1099→          ctx.shadow,
  1100→          "task-start",
  1101→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1102→        );
  1103→        success(`Started task: ${index.shortUlid(updatedTask._ulid)}`, {
  1104→          task: updatedTask,
  1105→        });
  1106→
  1107→        // Show spec context and AC guidance (suppressed in JSON mode)
  1108→        if (!isJsonMode() && foundTask.spec_ref) {
  1109→          const specResult = index.resolve(foundTask.spec_ref);
  1110→          if (specResult.ok) {
  1111→            const specItem = items.find((i) => i._ulid === specResult.ulid);
  1112→            if (specItem) {
  1113→              console.log("");
  1114→              console.log("--- Spec Context ---");
  1115→              console.log(`Implementing: ${specItem.title}`);
  1116→              if (specItem.description) {
  1117→                console.log(`\n${specItem.description}`);
  1118→              }
  1119→
  1120→              if (
  1121→                specItem.acceptance_criteria &&
  1122→                specItem.acceptance_criteria.length > 0
  1123→              ) {
  1124→                console.log(
  1125→                  `\nAcceptance Criteria (${specItem.acceptance_criteria.length}):`,
  1126→                );
  1127→                for (const ac of specItem.acceptance_criteria) {
  1128→                  console.log(`  [${ac.id}]`);
  1129→                  console.log(`    Given: ${ac.given}`);
  1130→                  console.log(`    When: ${ac.when}`);
  1131→                  console.log(`    Then: ${ac.then}`);
  1132→                }
  1133→                console.log("");
  1134→                console.log(
  1135→                  "Remember: Add test coverage for each AC and mark tests with // AC: @spec-ref ac-N",
  1136→                );
  1137→              }
  1138→              console.log("");
  1139→            }
  1140→          }
  1141→        }
  1142→
  1143→        // Sync spec implementation status (unless --no-sync)
  1144→        if (options.sync !== false && foundTask.spec_ref) {
  1145→          const updatedTasks = tasks.map((t) =>
  1146→            t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t,
  1147→          );
  1148→          const syncResult = await syncSpecImplementationStatus(
  1149→            ctx,
  1150→            updatedTask as LoadedTask,
  1151→            updatedTasks as LoadedTask[],
  1152→            items,
  1153→            index,
  1154→          );
  1155→          if (syncResult) {
  1156→            info(
  1157→              `Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1158→            );
  1159→            // Commit the spec status change
  1160→            await commitIfShadow(
  1161→              ctx.shadow,
  1162→              "spec-sync",
  1163→              syncResult.specUlid.slice(0, 8),
  1164→              `${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1165→            );
  1166→          }
  1167→        }
  1168→      } catch (err) {
  1169→        error(errors.failures.startTask, err);
  1170→        process.exit(EXIT_CODES.ERROR);
  1171→      }
  1172→    });
  1173→
  1174→  // kspec task complete <ref> | --refs <refs...>
  1175→  // AC: @multi-ref-batch ac-1 - Basic multi-ref syntax
  1176→  // AC: @multi-ref-batch ac-2 - Backward compatibility
  1177→  markMutating(task.command("complete [ref]"))
  1178→    .description("Complete a task (pending_review -> completed)")
  1179→    .option("--refs <refs...>", "Complete multiple tasks by ref")
  1180→    .option("--reason <reason>", "Completion reason/notes")
  1181→    .option("--skip-review", "Skip review requirement (requires --reason)")
  1182→    .option(
  1183→      "--force",
  1184→      "Force completion even if blocked (AC: @task-commands ac-1)",
  1185→    )
  1186→    .option("--no-sync", "Skip syncing spec implementation status")
  1187→    .addHelpText(
  1188→      "after",
  1189→      `
  1190→Examples:
  1191→  $ kspec task complete @task-slug --reason "Merged in PR #123"
  1192→  $ kspec task complete --refs @task1 @task2 --reason "Batch completion"`,
  1193→    )
  1194→    .action(async (ref: string | undefined, options) => {
  1195→      try {
  1196→        const ctx = await initContext();
  1197→        const tasks = await loadAllTasks(ctx);
  1198→        const items = await loadAllItems(ctx);
  1199→        const index = new ReferenceIndex(tasks, items);
  1200→
  1201→        // AC: @spec-completion-enforcement ac-8
  1202→        if (options.skipReview && !options.reason) {
  1203→          error(errors.status.skipReviewRequiresReason);
  1204→          process.exit(EXIT_CODES.ERROR);
  1205→        }
  1206→
  1207→        // AC: @multi-ref-batch ac-1, ac-2, ac-3, ac-4
  1208→        const result = await executeBatchOperation({
  1209→          positionalRef: ref,
  1210→          refsFlag: options.refs,
  1211→          context: { ctx, tasks, items, index, options },
  1212→          items: tasks,
  1213→          index,
  1214→          resolveRef: (refStr, taskList, idx) => {
  1215→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1216→            return { item: resolved.task, error: resolved.error };
  1217→          },
  1218→          executeOperation: async (
  1219→            foundTask,
  1220→            { ctx, tasks, items, index, options },
  1221→          ) => {
  1222→            try {
  1223→              // AC: @spec-completion-enforcement ac-6
  1224→              if (foundTask.status === "completed") {
  1225→                return {
  1226→                  success: false,
  1227→                  error: errors.status.completeAlreadyCompleted,
  1228→                };
  1229→              }
  1230→
  1231→              // AC: @task-commands ac-1 - Allow --force to bypass blocked state
  1232→              // Handle blocked task with --force before other checks
  1233→              const forcingBlockedTask =
  1234→                foundTask.status === "blocked" && options.force;
  1235→
  1236→              // AC: @spec-completion-enforcement ac-7 - Allow skip-review bypass
  1237→              if (!options.skipReview && !forcingBlockedTask) {
  1238→                // AC: @spec-completion-enforcement ac-2
  1239→                if (foundTask.status === "in_progress") {
  1240→                  return {
  1241→                    success: false,
  1242→                    error: errors.status.completeRequiresReview,
  1243→                  };
  1244→                }
  1245→
  1246→                // AC: @spec-completion-enforcement ac-3
  1247→                if (foundTask.status === "pending") {
  1248→                  return {
  1249→                    success: false,
  1250→                    error: errors.status.completeRequiresStart,
  1251→                  };
  1252→                }
  1253→
  1254→                // AC: @spec-completion-enforcement ac-4
  1255→                if (foundTask.status === "blocked") {
  1256→                  return {
  1257→                    success: false,
  1258→                    error: errors.status.completeBlockedTask,
  1259→                  };
  1260→                }
  1261→
  1262→                // AC: @spec-completion-enforcement ac-5
  1263→                if (foundTask.status === "cancelled") {
  1264→                  return {
  1265→                    success: false,
  1266→                    error: errors.status.completeCancelledTask,
  1267→                  };
  1268→                }
  1269→
  1270→                // AC: @spec-completion-enforcement ac-1 - Only pending_review allowed
  1271→                if (foundTask.status !== "pending_review") {
  1272→                  return {
  1273→                    success: false,
  1274→                    error: errors.status.cannotComplete(foundTask.status),
  1275→                  };
  1276→                }
  1277→              }
  1278→
  1279→              const now = new Date().toISOString();
  1280→
  1281→              // AC: @spec-completion-enforcement ac-7 - Document skip-review reason
  1282→              // AC: @spec-completion-enforcement ac-author
  1283→              let taskNotes = foundTask.notes;
  1284→              if (options.skipReview && options.reason) {
  1285→                const skipNote = createNote(
  1286→                  `Completed with --skip-review: ${options.reason}`,
  1287→                  getAuthor(),
  1288→                );
  1289→                taskNotes = [...taskNotes, skipNote];
  1290→              }
  1291→
  1292→              // AC: @task-commands ac-1 - Document force completion of blocked task
  1293→              if (forcingBlockedTask) {
  1294→                const blockedBy = foundTask.blocked_by.join("; ");
  1295→                const forceNote = createNote(
  1296→                  `Completed with --force despite blocked state. Was blocked by: ${blockedBy || "(dependency-blocked)"}${options.reason ? `. Reason: ${options.reason}` : ""}`,
  1297→                  getAuthor(),
  1298→                );
  1299→                taskNotes = [...taskNotes, forceNote];
  1300→              }
  1301→
  1302→              // Update status
  1303→              const updatedTask: Task = {
  1304→                ...foundTask,
  1305→                status: "completed",
  1306→                completed_at: now,
  1307→                closed_reason: options.reason || null,
  1308→                started_at: foundTask.started_at || now,
  1309→                notes: taskNotes,
  1310→              };
  1311→
  1312→              await saveTask(ctx, updatedTask);
  1313→              await commitIfShadow(
  1314→                ctx.shadow,
  1315→                "task-complete",
  1316→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1317→                options.reason,
  1318→              );
  1319→
  1320→              // Sync spec implementation status (unless --no-sync)
  1321→              if (options.sync !== false && foundTask.spec_ref) {
  1322→                const updatedTasks = tasks.map((t) =>
  1323→                  t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t,
  1324→                );
  1325→                const syncResult = await syncSpecImplementationStatus(
  1326→                  ctx,
  1327→                  updatedTask as LoadedTask,
  1328→                  updatedTasks as LoadedTask[],
  1329→                  items,
  1330→                  index,
  1331→                );
  1332→                if (syncResult && !isJsonMode()) {
  1333→                  info(
  1334→                    `Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1335→                  );
  1336→                  await commitIfShadow(
  1337→                    ctx.shadow,
  1338→                    "spec-sync",
  1339→                    syncResult.specUlid.slice(0, 8),
  1340→                    `${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1341→                  );
  1342→                }
  1343→              }
  1344→
  1345→              // Show AC reminder for single-ref mode only (not in batch)
  1346→              if (!options.refs && foundTask.spec_ref && !isJsonMode()) {
  1347→                const specResult = index.resolve(foundTask.spec_ref);
  1348→                if (specResult.ok && specResult.item) {
  1349→                  const specItem = items.find(
  1350→                    (i) => i._ulid === specResult.ulid,
  1351→                  );
  1352→                  if (
  1353→                    specItem?.acceptance_criteria &&
  1354→                    specItem.acceptance_criteria.length > 0
  1355→                  ) {
  1356→                    const count = specItem.acceptance_criteria.length;
  1357→                    console.log(
  1358→                      `\n⚠ Linked spec ${foundTask.spec_ref} has ${count} acceptance criteri${count === 1 ? "on" : "a"} - verify they are covered\n`,
  1359→                    );
  1360→                  }
  1361→                }
  1362→              }
  1363→
  1364→              // AC: @task-commands ac-1 - Show warning when force-completing blocked task
  1365→              let warningMsg: string | undefined;
  1366→              if (forcingBlockedTask) {
  1367→                const blockedBy = foundTask.blocked_by.join("; ");
  1368→                warningMsg = `Task was blocked by: ${blockedBy || "(dependency-blocked)"}`;
  1369→                if (!isJsonMode()) {
  1370→                  warn(warningMsg);
  1371→                }
  1372→              }
  1373→
  1374→              return {
  1375→                success: true,
  1376→                message: `Completed task: ${index.shortUlid(updatedTask._ulid)}`,
  1377→                data: updatedTask,
  1378→                ...(forcingBlockedTask && { warning: warningMsg }),
  1379→              };
  1380→            } catch (err) {
  1381→              return {
  1382→                success: false,
  1383→                error: err instanceof Error ? err.message : String(err),
  1384→              };
  1385→            }
  1386→          },
  1387→          getUlid: (task) => task._ulid,
  1388→        });
  1389→
  1390→        // AC: @multi-ref-batch ac-5, ac-6
  1391→        formatBatchOutput(result, "Complete");
  1392→
  1393→        // Show commit guidance for single-ref mode only
  1394→        if (
  1395→          !options.refs &&
  1396→          result.success &&
  1397→          result.results.length === 1 &&
  1398→          !isJsonMode()
  1399→        ) {
  1400→          const taskData = result.results[0].data as Task | undefined;
  1401→          if (taskData) {
  1402→            const guidance = formatCommitGuidance(taskData);
  1403→            printCommitGuidance(guidance);
  1404→          }
  1405→        }
  1406→      } catch (err) {
  1407→        error(errors.failures.completeTask, err);
  1408→        process.exit(EXIT_CODES.ERROR);
  1409→      }
  1410→    });
  1411→
  1412→  // kspec task submit <ref>
  1413→  // Transitions in_progress → pending_review (code done, awaiting merge)
  1414→  markMutating(task.command("submit <ref>"))
  1415→    .description("Submit task for review (transitions to pending_review)")
  1416→    .action(async (ref: string) => {
  1417→      try {
  1418→        const ctx = await initContext();
  1419→        const tasks = await loadAllTasks(ctx);
  1420→        const items = await loadAllItems(ctx);
  1421→        const index = new ReferenceIndex(tasks, items);
  1422→        const foundTask = resolveTaskRef(ref, tasks, index);
  1423→
  1424→        if (foundTask.status !== "in_progress") {
  1425→          error(
  1426→            `Cannot submit task with status: ${foundTask.status}. Task must be in_progress.`,
  1427→          );
  1428→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1429→        }
  1430→
  1431→        const updatedTask: Task = {
  1432→          ...foundTask,
  1433→          status: "pending_review",
  1434→        };
  1435→
  1436→        await saveTask(ctx, updatedTask);
  1437→        await commitIfShadow(
  1438→          ctx.shadow,
  1439→          "task-submit",
  1440→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1441→        );
  1442→        success(
  1443→          `Submitted task for review: ${index.shortUlid(updatedTask._ulid)}`,
  1444→          { task: updatedTask },
  1445→        );
  1446→      } catch (err) {
  1447→        error(errors.failures.updateTask, err);
  1448→        process.exit(EXIT_CODES.ERROR);
  1449→      }
  1450→    });
  1451→
  1452→  // kspec task block <ref>
  1453→  markMutating(task.command("block <ref>"))
  1454→    .description("Block a task")
  1455→    .requiredOption("--reason <reason>", "Reason for blocking")
  1456→    .action(async (ref: string, options) => {
  1457→      try {
  1458→        const ctx = await initContext();
  1459→        const tasks = await loadAllTasks(ctx);
  1460→        const items = await loadAllItems(ctx);
  1461→        const index = new ReferenceIndex(tasks, items);
  1462→        const foundTask = resolveTaskRef(ref, tasks, index);
  1463→
  1464→        if (
  1465→          foundTask.status === "completed" ||
  1466→          foundTask.status === "cancelled"
  1467→        ) {
  1468→          error(errors.status.cannotBlock(foundTask.status));
  1469→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1470→        }
  1471→
  1472→        const updatedTask: Task = {
  1473→          ...foundTask,
  1474→          status: "blocked",
  1475→          blocked_by: [...foundTask.blocked_by, options.reason],
  1476→        };
  1477→
  1478→        await saveTask(ctx, updatedTask);
  1479→        await commitIfShadow(
  1480→          ctx.shadow,
  1481→          "task-block",
  1482→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1483→        );
  1484→        success(`Blocked task: ${index.shortUlid(updatedTask._ulid)}`, {
  1485→          task: updatedTask,
  1486→        });
  1487→      } catch (err) {
  1488→        error(errors.failures.blockTask, err);
  1489→        process.exit(EXIT_CODES.ERROR);
  1490→      }
  1491→    });
  1492→
  1493→  // kspec task unblock <ref>
  1494→  markMutating(task.command("unblock <ref>"))
  1495→    .description("Unblock a task")
  1496→    .action(async (ref: string) => {
  1497→      try {
  1498→        const ctx = await initContext();
  1499→        const tasks = await loadAllTasks(ctx);
  1500→        const items = await loadAllItems(ctx);
  1501→        const index = new ReferenceIndex(tasks, items);
  1502→        const foundTask = resolveTaskRef(ref, tasks, index);
  1503→
  1504→        if (foundTask.status !== "blocked") {
  1505→          warn("Task is not blocked");
  1506→          return;
  1507→        }
  1508→
  1509→        const updatedTask: Task = {
  1510→          ...foundTask,
  1511→          status: "pending",
  1512→          blocked_by: [],
  1513→        };
  1514→
  1515→        await saveTask(ctx, updatedTask);
  1516→        await commitIfShadow(
  1517→          ctx.shadow,
  1518→          "task-unblock",
  1519→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1520→        );
  1521→        success(`Unblocked task: ${index.shortUlid(updatedTask._ulid)}`, {
  1522→          task: updatedTask,
  1523→        });
  1524→      } catch (err) {
  1525→        error(errors.failures.unblockTask, err);
  1526→        process.exit(EXIT_CODES.ERROR);
  1527→      }
  1528→    });
  1529→
  1530→  // kspec task cancel <ref> | --refs <refs...>
  1531→  // AC: @multi-ref-batch ac-1, ac-2
  1532→  markMutating(task.command("cancel [ref]"))
  1533→    .description("Cancel a task")
  1534→    .option("--refs <refs...>", "Cancel multiple tasks by ref")
  1535→    .option("--reason <reason>", "Cancellation reason")
  1536→    .addHelpText(
  1537→      "after",
  1538→      `
  1539→Examples:
  1540→  $ kspec task cancel @task-slug --reason "No longer needed"
  1541→  $ kspec task cancel --refs @task1 @task2 --reason "Superseded by @new-task"`,
  1542→    )
  1543→    .action(async (ref: string | undefined, options) => {
  1544→      try {
  1545→        const ctx = await initContext();
  1546→        const tasks = await loadAllTasks(ctx);
  1547→        const items = await loadAllItems(ctx);
  1548→        const index = new ReferenceIndex(tasks, items);
  1549→
  1550→        const result = await executeBatchOperation({
  1551→          positionalRef: ref,
  1552→          refsFlag: options.refs,
  1553→          context: { ctx, tasks, items, index, options },
  1554→          items: tasks,
  1555→          index,
  1556→          resolveRef: (refStr, taskList, idx) => {
  1557→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1558→            return { item: resolved.task, error: resolved.error };
  1559→          },
  1560→          executeOperation: async (foundTask, { ctx, index, options }) => {
  1561→            try {
  1562→              if (
  1563→                foundTask.status === "completed" ||
  1564→                foundTask.status === "cancelled"
  1565→              ) {
  1566→                return {
  1567→                  success: false,
  1568→                  error: `Task is already ${foundTask.status}`,
  1569→                };
  1570→              }
  1571→
  1572→              const updatedTask: Task = {
  1573→                ...foundTask,
  1574→                status: "cancelled",
  1575→                closed_reason: options.reason || null,
  1576→              };
  1577→
  1578→              await saveTask(ctx, updatedTask);
  1579→              await commitIfShadow(
  1580→                ctx.shadow,
  1581→                "task-cancel",
  1582→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1583→              );
  1584→
  1585→              return {
  1586→                success: true,
  1587→                message: `Cancelled task: ${index.shortUlid(updatedTask._ulid)}`,
  1588→                data: updatedTask,
  1589→              };
  1590→            } catch (err) {
  1591→              return {
  1592→                success: false,
  1593→                error: err instanceof Error ? err.message : String(err),
  1594→              };
  1595→            }
  1596→          },
  1597→          getUlid: (task) => task._ulid,
  1598→        });
  1599→
  1600→        formatBatchOutput(result, "Cancel");
  1601→      } catch (err) {
  1602→        error(errors.failures.cancelTask, err);
  1603→        process.exit(EXIT_CODES.ERROR);
  1604→      }
  1605→    });
  1606→
  1607→  // kspec task reset <ref>
  1608→  // AC: @spec-task-reset ac-1, ac-2, ac-3, ac-4, ac-5, ac-6
  1609→  markMutating(task.command("reset <ref>"))
  1610→    .description("Reset a task to pending state")
  1611→    .action(async (ref: string) => {
  1612→      try {
  1613→        const ctx = await initContext();
  1614→        const tasks = await loadAllTasks(ctx);
  1615→        const items = await loadAllItems(ctx);
  1616→        const index = new ReferenceIndex(tasks, items);
  1617→        const foundTask = resolveTaskRef(ref, tasks, index);
  1618→
  1619→        // AC: @spec-task-reset ac-2 - Error if already pending
  1620→        if (foundTask.status === "pending") {
  1621→          error("Task is already pending");
  1622→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1623→        }
  1624→
  1625→        // Track previous status and reason for note (AC-4)
  1626→        const previousStatus = foundTask.status;
  1627→        const hadCancelReason =
  1628→          foundTask.closed_reason && foundTask.status === "cancelled";
  1629→        const cancelReasonText = hadCancelReason
  1630→          ? ` (was cancelled: ${foundTask.closed_reason})`
  1631→          : "";
  1632→
  1633→        // AC: @spec-task-reset ac-1 - Reset to pending, clear completion-related fields
  1634→        const clearedFields: string[] = [];
  1635→        const updatedTask: Task = {
  1636→          ...foundTask,
  1637→          status: "pending",
  1638→        };
  1639→
  1640→        // Clear timestamps and reasons based on previous status
  1641→        if (
  1642→          foundTask.completed_at !== undefined &&
  1643→          foundTask.completed_at !== null
  1644→        ) {
  1645→          updatedTask.completed_at = null;
  1646→          clearedFields.push("completed_at");
  1647→        }
  1648→        if (
  1649→          foundTask.started_at !== undefined &&
  1650→          foundTask.started_at !== null
  1651→        ) {
  1652→          updatedTask.started_at = null;
  1653→          clearedFields.push("started_at");
  1654→        }
  1655→        if (
  1656→          foundTask.closed_reason !== undefined &&
  1657→          foundTask.closed_reason !== null
  1658→        ) {
  1659→          updatedTask.closed_reason = null;
  1660→          clearedFields.push("closed_reason");
  1661→        }
  1662→        if (foundTask.blocked_by.length > 0) {
  1663→          updatedTask.blocked_by = [];
  1664→          clearedFields.push("blocked_by");
  1665→        }
  1666→
  1667→        // AC: @spec-task-reset ac-4 - Add note documenting the reset
  1668→        // AC: @spec-task-reset ac-author
  1669→        const noteContent = `Reset from ${previousStatus} to pending${cancelReasonText}`;
  1670→        const note = createNote(noteContent, getAuthor());
  1671→        updatedTask.notes = [...updatedTask.notes, note];
  1672→
  1673→        await saveTask(ctx, updatedTask);
  1674→        // AC: @spec-task-reset ac-3 - Shadow commit with message task-reset
  1675→        await commitIfShadow(
  1676→          ctx.shadow,
  1677→          "task-reset",
  1678→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1679→          `from ${previousStatus}`,
  1680→        );
  1681→
  1682→        // AC: @spec-task-reset ac-6 - JSON output includes previous_status, new_status, cleared_fields
  1683→        const jsonOutput = {
  1684→          task: updatedTask,
  1685→          previous_status: previousStatus,
  1686→          new_status: "pending" as const,
  1687→          cleared_fields: clearedFields,
  1688→        };
  1689→
  1690→        output(jsonOutput, () => {
  1691→          success(
  1692→            `Reset task: ${index.shortUlid(updatedTask._ulid)} (${previousStatus} → pending)`,
  1693→            undefined,
  1694→          );
  1695→          if (clearedFields.length > 0) {
  1696→            info(`Cleared fields: ${clearedFields.join(", ")}`);
  1697→          }
  1698→        });
  1699→      } catch (err) {
  1700→        error("Failed to reset task", err);
  1701→        process.exit(EXIT_CODES.ERROR);
  1702→      }
  1703→    });
  1704→
  1705→  // kspec task delete <ref> | --refs <refs...>
  1706→  // AC: @multi-ref-batch ac-1, ac-2
  1707→  markMutating(task.command("delete [ref]"))
  1708→    .description("Delete a task permanently")
  1709→    .option("--refs <refs...>", "Delete multiple tasks by ref")
  1710→    .option("--force", "Skip confirmation (required for --refs)")
  1711→    .option("--dry-run", "Show what would be deleted without deleting")
  1712→    .addHelpText(
  1713→      "after",
  1714→      `
  1715→Examples:
  1716→  $ kspec task delete @task-slug
  1717→  $ kspec task delete --refs @task1 @task2 --force
  1718→  $ kspec task delete --refs @task1 @task2 --dry-run`,
  1719→    )
  1720→    .action(async (ref: string | undefined, options) => {
  1721→      try {
  1722→        const ctx = await initContext();
  1723→        const tasks = await loadAllTasks(ctx);
  1724→        const items = await loadAllItems(ctx);
  1725→        const index = new ReferenceIndex(tasks, items);
  1726→
  1727→        // For batch mode (--refs), require --force
  1728→        if (
  1729→          options.refs &&
  1730→          options.refs.length > 0 &&
  1731→          !options.force &&
  1732→          !options.dryRun
  1733→        ) {
  1734→          error("Batch delete requires --force flag");
  1735→          process.exit(EXIT_CODES.USAGE_ERROR);
  1736→        }
  1737→
  1738→        const result = await executeBatchOperation({
  1739→          positionalRef: ref,
  1740→          refsFlag: options.refs,
  1741→          context: { ctx, tasks, items, index, options },
  1742→          items: tasks,
  1743→          index,
  1744→          resolveRef: (refStr, taskList, idx) => {
  1745→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1746→            return { item: resolved.task, error: resolved.error };
  1747→          },
  1748→          executeOperation: async (foundTask, { ctx, index, options }) => {
  1749→            try {
  1750→              const taskDisplay = `${foundTask.title} (${index.shortUlid(foundTask._ulid)})`;
  1751→
  1752→              if (options.dryRun) {
  1753→                return {
  1754→                  success: true,
  1755→                  message: `Would delete: ${taskDisplay}`,
  1756→                };
  1757→              }
  1758→
  1759→              // For single-ref mode (not --refs), prompt for confirmation unless --force
  1760→              if (!options.refs && !options.force) {
  1761→                const readline = await import("node:readline");
  1762→                const rl = readline.createInterface({
  1763→                  input: process.stdin,
  1764→                  output: process.stdout,
  1765→                });
  1766→
  1767→                const answer = await new Promise<string>((resolve) => {
  1768→                  rl.question(`Delete task "${taskDisplay}"? [y/N] `, resolve);
  1769→                });
  1770→                rl.close();
  1771→
  1772→                if (answer.toLowerCase() !== "y") {
  1773→                  return {
  1774→                    success: false,
  1775→                    error: "Deletion cancelled by user",
  1776→                  };
  1777→                }
  1778→              }
  1779→
  1780→              await deleteTask(ctx, foundTask);
  1781→              await commitIfShadow(
  1782→                ctx.shadow,
  1783→                "task-delete",
  1784→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1785→                foundTask.title,
  1786→              );
  1787→
  1788→              return {
  1789→                success: true,
  1790→                message: `Deleted task: ${taskDisplay}`,
  1791→              };
  1792→            } catch (err) {
  1793→              return {
  1794→                success: false,
  1795→                error: err instanceof Error ? err.message : String(err),
  1796→              };
  1797→            }
  1798→          },
  1799→          getUlid: (task) => task._ulid,
  1800→        });
  1801→
  1802→        formatBatchOutput(result, "Delete");
  1803→      } catch (err) {
  1804→        error(errors.failures.deleteTask, err);
  1805→        process.exit(EXIT_CODES.ERROR);
  1806→      }
  1807→    });
  1808→
  1809→  // kspec task note <ref> <message>
  1810→  markMutating(task.command("note <ref> <message>"))
  1811→    .description("Add a note to a task")
  1812→    .option("--author <author>", "Note author")
  1813→    .option("--supersedes <ulid>", "ULID of note this supersedes")
  1814→    .action(async (ref: string, message: string, options) => {
  1815→      try {
  1816→        const ctx = await initContext();
  1817→        const tasks = await loadAllTasks(ctx);
  1818→        const items = await loadAllItems(ctx);
  1819→        const index = new ReferenceIndex(tasks, items);
  1820→        const foundTask = resolveTaskRef(ref, tasks, index);
  1821→
  1822→        const note = createNote(message, options.author, options.supersedes);
  1823→
  1824→        const updatedTask: Task = {
  1825→          ...foundTask,
  1826→          notes: [...foundTask.notes, note],
  1827→        };
  1828→
  1829→        await saveTask(ctx, updatedTask);
  1830→        await commitIfShadow(
  1831→          ctx.shadow,
  1832→          "task-note",
  1833→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1834→        );
  1835→        success(`Added note to task: ${index.shortUlid(updatedTask._ulid)}`, {
  1836→          note,
  1837→        });
  1838→
  1839→        // Proactive alignment guidance for tasks with spec_ref
  1840→        if (foundTask.spec_ref) {
  1841→          console.log("");
  1842→          console.log(alignmentCheck.header);
  1843→          console.log(alignmentCheck.beyondSpec);
  1844→          console.log(alignmentCheck.updateSpec(foundTask.spec_ref));
  1845→          console.log(alignmentCheck.addAC);
  1846→
  1847→          // Check if linked spec has acceptance criteria and remind about test coverage
  1848→          const specResult = index.resolve(foundTask.spec_ref);
  1849→          if (specResult.ok && specResult.item) {
  1850→            const specItem = specResult.item as {
  1851→              acceptance_criteria?: unknown[];
  1852→            };
  1853→            if (
  1854→              specItem.acceptance_criteria &&
  1855→              specItem.acceptance_criteria.length > 0
  1856→            ) {
  1857→              console.log("");
  1858→              console.log(
  1859→                alignmentCheck.testCoverage(
  1860→                  specItem.acceptance_criteria.length,
  1861→                ),
  1862→              );
  1863→            }
  1864→          }
  1865→        }
  1866→      } catch (err) {
  1867→        error(errors.failures.addNote, err);
  1868→        process.exit(EXIT_CODES.ERROR);
  1869→      }
  1870→    });
  1871→
  1872→  // kspec task notes <ref>
  1873→  task
  1874→    .command("notes <ref>")
