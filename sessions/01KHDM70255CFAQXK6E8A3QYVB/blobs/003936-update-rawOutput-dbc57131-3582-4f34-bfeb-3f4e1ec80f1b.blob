  2108→    });
  2109→
  2110→  // Create subcommand group for todo operations
  2111→  const todoCmd = task.command("todo").description("Manage task todos");
  2112→
  2113→  // kspec task todo add <ref> <text>
  2114→  markMutating(todoCmd.command("add <ref> <text>"))
  2115→    .description("Add a todo to a task")
  2116→    .option("--author <author>", "Todo author")
  2117→    .action(async (ref: string, text: string, options) => {
  2118→      try {
  2119→        const ctx = await initContext();
  2120→        const tasks = await loadAllTasks(ctx);
  2121→        const items = await loadAllItems(ctx);
  2122→        const index = new ReferenceIndex(tasks, items);
  2123→        const foundTask = resolveTaskRef(ref, tasks, index);
  2124→
  2125→        // Calculate next ID (max existing + 1, or 1 if none)
  2126→        const nextId =
  2127→          foundTask.todos.length > 0
  2128→            ? Math.max(...foundTask.todos.map((t) => t.id)) + 1
  2129→            : 1;
  2130→
  2131→        const todo = createTodo(nextId, text, options.author);
  2132→
  2133→        const updatedTask: Task = {
  2134→          ...foundTask,
  2135→          todos: [...foundTask.todos, todo],
  2136→        };
  2137→
  2138→        await saveTask(ctx, updatedTask);
  2139→        await commitIfShadow(
  2140→          ctx.shadow,
  2141→          "task-note",
  2142→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  2143→        );
  2144→        success(
  2145→          `Added todo #${todo.id} to task: ${index.shortUlid(updatedTask._ulid)}`,
  2146→          { todo },
  2147→        );
  2148→      } catch (err) {
  2149→        error(errors.failures.addTodo, err);
  2150→        process.exit(EXIT_CODES.ERROR);
  2151→      }
  2152→    });
  2153→
  2154→  // kspec task todo done <ref> <id>
  2155→  markMutating(todoCmd.command("done <ref> <id>"))
  2156→    .description("Mark a todo as done")
  2157→    .action(async (ref: string, idStr: string) => {
  2158→      try {
  2159→        const ctx = await initContext();
  2160→        const tasks = await loadAllTasks(ctx);
  2161→        const items = await loadAllItems(ctx);
  2162→        const index = new ReferenceIndex(tasks, items);
  2163→        const foundTask = resolveTaskRef(ref, tasks, index);
  2164→
  2165→        const id = parseInt(idStr, 10);
  2166→        if (Number.isNaN(id)) {
  2167→          error(errors.todo.invalidId(idStr));
  2168→          process.exit(EXIT_CODES.USAGE_ERROR);
  2169→        }
  2170→
  2171→        const todoIndex = foundTask.todos.findIndex((t) => t.id === id);
  2172→        if (todoIndex === -1) {
  2173→          error(errors.todo.notFound(id));
  2174→          process.exit(EXIT_CODES.NOT_FOUND);
  2175→        }
  2176→
  2177→        if (foundTask.todos[todoIndex].done) {
  2178→          warn(`Todo #${id} is already done`);
  2179→          return;
  2180→        }
  2181→
  2182→        const updatedTodos = [...foundTask.todos];
  2183→        updatedTodos[todoIndex] = {
  2184→          ...updatedTodos[todoIndex],
  2185→          done: true,
  2186→          done_at: new Date().toISOString(),
  2187→        };
  2188→
  2189→        const updatedTask: Task = {
  2190→          ...foundTask,
  2191→          todos: updatedTodos,
  2192→        };
  2193→
  2194→        await saveTask(ctx, updatedTask);
  2195→        await commitIfShadow(
  2196→          ctx.shadow,
  2197→          "task-note",
  2198→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  2199→        );
  2200→        success(`Marked todo #${id} as done`, {
  2201→          todo: updatedTodos[todoIndex],
  2202→        });
  2203→      } catch (err) {
  2204→        error(errors.failures.markTodoDone, err);
  2205→        process.exit(EXIT_CODES.ERROR);
  2206→      }
  2207→    });
  2208→
  2209→  // kspec task todo undone <ref> <id>
  2210→  markMutating(todoCmd.command("undone <ref> <id>"))
  2211→    .description("Mark a todo as not done")
  2212→    .action(async (ref: string, idStr: string) => {
  2213→      try {
  2214→        const ctx = await initContext();
  2215→        const tasks = await loadAllTasks(ctx);
  2216→        const items = await loadAllItems(ctx);
  2217→        const index = new ReferenceIndex(tasks, items);
  2218→        const foundTask = resolveTaskRef(ref, tasks, index);
  2219→
  2220→        const id = parseInt(idStr, 10);
  2221→        if (Number.isNaN(id)) {
  2222→          error(errors.todo.invalidId(idStr));
  2223→          process.exit(EXIT_CODES.USAGE_ERROR);
  2224→        }
  2225→
  2226→        const todoIndex = foundTask.todos.findIndex((t) => t.id === id);
  2227→        if (todoIndex === -1) {
  2228→          error(errors.todo.notFound(id));
  2229→          process.exit(EXIT_CODES.NOT_FOUND);
  2230→        }
  2231→
  2232→        if (!foundTask.todos[todoIndex].done) {
  2233→          warn(`Todo #${id} is not done`);
  2234→          return;
  2235→        }
  2236→
  2237→        const updatedTodos = [...foundTask.todos];
  2238→        updatedTodos[todoIndex] = {
  2239→          ...updatedTodos[todoIndex],
  2240→          done: false,
  2241→          done_at: undefined,
  2242→        };
  2243→
  2244→        const updatedTask: Task = {
  2245→          ...foundTask,
  2246→          todos: updatedTodos,
  2247→        };
  2248→
  2249→        await saveTask(ctx, updatedTask);
  2250→        await commitIfShadow(
  2251→          ctx.shadow,
  2252→          "task-note",
  2253→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  2254→        );
  2255→        success(`Marked todo #${id} as not done`, {
  2256→          todo: updatedTodos[todoIndex],
  2257→        });
  2258→      } catch (err) {
  2259→        error(errors.failures.markTodoNotDone, err);
  2260→        process.exit(EXIT_CODES.ERROR);
  2261→      }
  2262→    });
  2263→}
