     1→import chalk from "chalk";
     2→import type { ReferenceIndex } from "../parser/index.js";
     3→import type { Task, TaskStatus } from "../schema/index.js";
     4→import { fieldLabels, sectionHeaders, summaries } from "../strings/labels.js";
     5→import { formatMatchedFields, grepItem } from "../utils/grep.js";
     6→
     7→/**
     8→ * Output options
     9→ */
    10→export interface OutputOptions {
    11→  json?: boolean;
    12→}
    13→
    14→/**
    15→ * Global output format (set by --json flag)
    16→ */
    17→let globalJsonMode = false;
    18→
    19→export function setJsonMode(enabled: boolean): void {
    20→  globalJsonMode = enabled;
    21→}
    22→
    23→export function isJsonMode(): boolean {
    24→  return globalJsonMode;
    25→}
    26→
    27→/**
    28→ * Global verbose mode (set by --verbose flag)
    29→ */
    30→let globalVerboseMode = false;
    31→
    32→export function setVerboseMode(enabled: boolean): void {
    33→  globalVerboseMode = enabled;
    34→}
    35→
    36→export function getVerboseMode(): boolean {
    37→  return globalVerboseMode;
    38→}
    39→
    40→/**
    41→ * Output data - JSON if --json flag, otherwise formatted
    42→ */
    43→export function output(data: unknown, formatter?: () => void): void {
    44→  if (globalJsonMode) {
    45→    console.log(JSON.stringify(data, null, 2));
    46→  } else if (formatter) {
    47→    formatter();
    48→  } else {
    49→    console.log(data);
    50→  }
    51→}
    52→
    53→/**
    54→ * Output success message
    55→ */
    56→export function success(message: string, data?: Record<string, unknown>): void {
    57→  if (globalJsonMode) {
    58→    console.log(JSON.stringify({ success: true, message, ...data }));
    59→  } else {
    60→    console.log(chalk.green("OK"), message);
    61→  }
    62→}
    63→
    64→/**
    65→ * Output error message
    66→ */
    67→export function error(message: string, details?: unknown): void {
    68→  if (globalJsonMode) {
    69→    console.error(JSON.stringify({ success: false, error: message, details }));
    70→  } else {
    71→    console.error(chalk.red("✗"), message);
    72→    if (details) {
    73→      console.error(chalk.gray(String(details)));
    74→      // Show suggestion if it's a ShadowError with a suggestion
    75→      if (details && typeof details === "object" && "suggestion" in details) {
    76→        const suggestion = (details as { suggestion?: string }).suggestion;
    77→        if (suggestion) {
    78→          console.error(chalk.yellow("  Suggestion:"), suggestion);
    79→        }
    80→      }
    81→    }
    82→  }
    83→}
    84→
    85→/**
    86→ * Output warning message
    87→ */
    88→export function warn(message: string): void {
    89→  if (globalJsonMode) {
    90→    // Warnings are suppressed in JSON mode
    91→  } else {
    92→    console.warn(chalk.yellow("⚠"), message);
    93→  }
    94→}
    95→
    96→/**
    97→ * Output info message
    98→ */
    99→export function info(message: string): void {
   100→  if (globalJsonMode) {
   101→    // Info messages suppressed in JSON mode
   102→  } else {
   103→    console.log(chalk.blue("ℹ"), message);
   104→  }
   105→}
   106→
   107→/**
   108→ * Get color for task status
   109→ */
   110→function statusColor(status: TaskStatus): (text: string) => string {
   111→  switch (status) {
   112→    case "pending":
   113→      return (t: string) => chalk.gray(t);
   114→    case "in_progress":
   115→      return (t: string) => chalk.blue(t);
   116→    case "blocked":
   117→      return (t: string) => chalk.red(t);
   118→    case "completed":
   119→      return (t: string) => chalk.green(t);
   120→    case "cancelled":
   121→      return (t: string) => chalk.strikethrough.gray(t);
   122→    default:
   123→      return (t: string) => chalk.white(t);
   124→  }
   125→}
   126→
   127→/**
   128→ * Format a task reference (short ULID + slug if available)
   129→ * @param task The task to format
   130→ * @param index Optional ReferenceIndex for dynamic short ULID computation
   131→ */
   132→export function formatTaskRef(task: Task, index?: ReferenceIndex): string {
   133→  const shortId = index ? index.shortUlid(task._ulid) : task._ulid.slice(0, 8);
   134→  if (task.slugs.length > 0) {
   135→    return `${shortId} (${task.slugs[0]})`;
   136→  }
   137→  return shortId;
   138→}
   139→
   140→/**
   141→ * Format task for display
   142→ */
   143→export function formatTask(
   144→  task: Task,
   145→  verbose = false,
   146→  index?: ReferenceIndex,
   147→  full = false,
   148→): string {
   149→  const ref = formatTaskRef(task, index);
   150→  const status = statusColor(task.status)(`[${task.status}]`);
   151→  const priority =
   152→    task.priority <= 2
   153→      ? chalk.red(`P${task.priority}`)
   154→      : chalk.gray(`P${task.priority}`);
   155→
   156→  let line = `${ref} ${status} ${priority} ${task.title}`;
   157→
   158→  if (verbose && !full) {
   159→    // AC: @task-list-verbose ac-2 - Single verbose (-v) shows current behavior
   160→    if (task.spec_ref) {
   161→      line += chalk.gray(` (spec: ${task.spec_ref})`);
   162→    }
   163→    if (task.depends_on.length > 0) {
   164→      line += chalk.gray(` deps: [${task.depends_on.join(", ")}]`);
   165→    }
   166→    if (task.tags.length > 0) {
   167→      line += chalk.cyan(` #${task.tags.join(" #")}`);
   168→    }
   169→  }
   170→
   171→  return line;
   172→}
   173→
   174→/**
   175→ * Get first line of text, truncated to max length
   176→ */
   177→function getFirstLine(
   178→  text: string | undefined,
   179→  maxLength: number = 70,
   180→): string | undefined {
   181→  if (!text) return undefined;
   182→  const firstLine = text.split("\n")[0].trim();
   183→  if (firstLine.length <= maxLength) return firstLine;
   184→  return `${firstLine.slice(0, maxLength - 3)}...`;
   185→}
   186→
   187→/**
   188→ * Format full mode context for a task (AC-1, AC-3, AC-5)
   189→ */
   190→function formatFullModeContext(task: Task, index?: ReferenceIndex): void {
   191→  const indent = "    ";
   192→
   193→  // Show timestamps (AC-1)
   194→  console.log(chalk.gray(`${indent}Created: ${task.created_at}`));
   195→  if (task.started_at) {
   196→    console.log(chalk.gray(`${indent}Started: ${task.started_at}`));
   197→  }
   198→  if (task.completed_at) {
   199→    console.log(chalk.gray(`${indent}Completed: ${task.completed_at}`));
   200→  }
   201→
   202→  // Show notes count and most recent note (AC-1, AC-3)
   203→  if (task.notes && task.notes.length > 0) {
   204→    const mostRecent = task.notes[task.notes.length - 1];
   205→    const preview = getFirstLine(mostRecent.content, 50);
   206→    console.log(
   207→      chalk.gray(`${indent}Notes: ${task.notes.length} (latest: "${preview}")`),
   208→    );
   209→  }
   210→
   211→  // Show pending todos count (AC-1, AC-3)
   212→  if (task.todos && task.todos.length > 0) {
   213→    const pendingCount = task.todos.filter((t) => !t.done).length;
   214→    if (pendingCount > 0) {
   215→      console.log(chalk.gray(`${indent}Pending todos: ${pendingCount}`));
   216→    }
   217→  }
   218→
   219→  // Show spec context (AC-5)
   220→  if (task.spec_ref && index) {
   221→    const result = index.resolve(task.spec_ref);
   222→    if (result.ok) {
   223→      const spec = result.item;
   224→      const specName =
   225→        "title" in spec
   226→          ? spec.title
   227→          : "name" in spec
   228→            ? spec.name
   229→            : "id" in spec
   230→              ? spec.id
   231→              : task.spec_ref;
   232→      console.log(chalk.gray(`${indent}Spec: ${task.spec_ref}`));
   233→      console.log(chalk.cyan(`${indent}  ${specName}`));
   234→
   235→      // Show spec description if available
   236→      if ("description" in spec && spec.description) {
   237→        const descPreview = getFirstLine(spec.description as string, 70);
   238→        console.log(chalk.gray(`${indent}  ${descPreview}`));
   239→      }
   240→
   241→      // Show acceptance criteria if available
   242→      if (
   243→        "acceptance_criteria" in spec &&
   244→        Array.isArray(spec.acceptance_criteria)
   245→      ) {
   246→        const ac = spec.acceptance_criteria;
   247→        if (ac.length > 0) {
   248→          console.log(
   249→            chalk.gray(`${indent}  Acceptance Criteria: ${ac.length}`),
   250→          );
   251→          // Show first AC as preview
   252→          const firstAC = ac[0];
   253→          if (
   254→            typeof firstAC === "object" &&
   255→            firstAC !== null &&
   256→            "id" in firstAC
   257→          ) {
   258→            console.log(
   259→              chalk.gray(`${indent}    [${firstAC.id}] ${firstAC.then}`),
   260→            );
   261→          }
   262→        }
   263→      }
   264→    }
   265→  }
   266→
   267→  // Show tags and dependencies if present
   268→  if (task.tags && task.tags.length > 0) {
   269→    console.log(chalk.gray(`${indent}Tags: ${task.tags.join(", ")}`));
   270→  }
   271→  if (task.depends_on && task.depends_on.length > 0) {
   272→    console.log(
   273→      chalk.gray(`${indent}Depends on: ${task.depends_on.join(", ")}`),
   274→    );
   275→  }
   276→}
   277→
   278→/**
   279→ * Format automation status as a colored label
   280→ * AC: @task-automation-eligibility ac-14
   281→ */
   282→function formatAutomationStatus(automation: string | undefined): string {
   283→  if (!automation) {
   284→    return chalk.gray("[unassessed]");
   285→  }
   286→  switch (automation) {
   287→    case "eligible":
   288→      return chalk.green("[eligible]");
   289→    case "needs_review":
   290→      return chalk.yellow("[needs_review]");
   291→    case "manual_only":
   292→      return chalk.red("[manual_only]");
   293→    default:
   294→      return chalk.gray(`[${automation}]`);
   295→  }
   296→}
   297→
   298→/**
   299→ * Format a list of tasks with automation status
   300→ * AC: @task-automation-eligibility ac-14
   301→ */
   302→export function formatTaskListWithAutomation(
   303→  tasks: Task[],
   304→  verbose = false,
   305→  index?: ReferenceIndex,
   306→  grepPattern?: string,
   307→  full = false,
   308→): void {
   309→  if (tasks.length === 0) {
   310→    console.log(summaries.noTasks);
   311→    return;
   312→  }
   313→
   314→  for (const task of tasks) {
   315→    const ref = formatTaskRef(task, index);
   316→    const status = statusColor(task.status)(`[${task.status}]`);
   317→    const priority =
   318→      task.priority <= 2
   319→        ? chalk.red(`P${task.priority}`)
   320→        : chalk.gray(`P${task.priority}`);
   321→    const automationLabel = formatAutomationStatus(task.automation);
   322→
   323→    let line = `${ref} ${status} ${priority} ${automationLabel} ${task.title}`;
   324→
   325→    if (verbose && !full) {
   326→      if (task.spec_ref) {
   327→        line += chalk.gray(` (spec: ${task.spec_ref})`);
   328→      }
   329→      if (task.depends_on.length > 0) {
   330→        line += chalk.gray(` deps: [${task.depends_on.join(", ")}]`);
   331→      }
   332→      if (task.tags.length > 0) {
   333→        line += chalk.cyan(` #${task.tags.join(" #")}`);
   334→      }
   335→    }
   336→
   337→    console.log(line);
   338→
   339→    // Show matched fields if grep pattern provided
   340→    if (grepPattern) {
   341→      const match = grepItem(
   342→        task as unknown as Record<string, unknown>,
   343→        grepPattern,
   344→      );
   345→      if (match && match.matchedFields.length > 0) {
   346→        console.log(
   347→          chalk.gray(
   348→            `    matched: ${formatMatchedFields(match.matchedFields)}`,
   349→          ),
   350→        );
   351→      }
   352→    } else if (full) {
   353→      formatFullModeContext(task, index);
   354→    } else {
   355→      // Show context line: first line of description (if present)
   356→      const context = getFirstLine(task.description);
   357→      if (context) {
   358→        console.log(chalk.gray(`    ${context}`));
   359→      }
   360→    }
   361→  }
   362→
   363→  console.log(summaries.taskCount(tasks.length));
   364→}
   365→
   366→/**
   367→ * Format a list of tasks
   368→ */
   369→export function formatTaskList(
   370→  tasks: Task[],
   371→  verbose = false,
   372→  index?: ReferenceIndex,
   373→  grepPattern?: string,
   374→  full = false,
   375→): void {
   376→  if (tasks.length === 0) {
   377→    console.log(summaries.noTasks);
   378→    return;
   379→  }
   380→
   381→  for (const task of tasks) {
   382→    console.log(formatTask(task, verbose, index, full));
   383→
   384→    // Show matched fields if grep pattern provided
   385→    if (grepPattern) {
   386→      const match = grepItem(
   387→        task as unknown as Record<string, unknown>,
   388→        grepPattern,
   389→      );
   390→      if (match && match.matchedFields.length > 0) {
   391→        console.log(
   392→          chalk.gray(
   393→            `    matched: ${formatMatchedFields(match.matchedFields)}`,
   394→          ),
   395→        );
   396→      }
   397→    } else if (full) {
   398→      // AC: @task-list-verbose ac-1 - Full mode shows richer context
   399→      formatFullModeContext(task, index);
   400→    } else {
   401→      // Show context line: first line of description (if present)
   402→      const context = getFirstLine(task.description);
   403→      if (context) {
   404→        console.log(chalk.gray(`    ${context}`));
   405→      }
   406→    }
   407→  }
   408→
   409→  console.log(summaries.taskCount(tasks.length));
   410→}
   411→
   412→/**
   413→ * Format task details
   414→ */
   415→export function formatTaskDetails(task: Task, index?: ReferenceIndex): void {
   416→  console.log(chalk.bold(task.title));
   417→  console.log(chalk.gray("─".repeat(40)));
   418→  console.log(`${fieldLabels.ulid}      ${task._ulid}`);
   419→  if (task.slugs.length > 0) {
   420→    console.log(`${fieldLabels.slugs}     ${task.slugs.join(", ")}`);
   421→  }
   422→  console.log(`${fieldLabels.type}      ${task.type}`);
   423→  console.log(
   424→    `${fieldLabels.status}    ${statusColor(task.status)(task.status)}`,
   425→  );
   426→  console.log(`${fieldLabels.priority}  ${task.priority}`);
   427→
   428→  // AC: @task-automation-eligibility ac-17 - show automation status
   429→  const automationDisplay = task.automation || "unassessed";
   430→  const automationColor =
   431→    task.automation === "eligible"
   432→      ? chalk.green
   433→      : task.automation === "needs_review"
   434→        ? chalk.yellow
   435→        : task.automation === "manual_only"
   436→          ? chalk.red
   437→          : chalk.gray;
   438→  console.log(
   439→    `${fieldLabels.automation} ${automationColor(automationDisplay)}`,
   440→  );
   441→
   442→  if (task.spec_ref) {
   443→    console.log(`${fieldLabels.specRef}  ${task.spec_ref}`);
   444→  }
   445→
   446→  // AC: @plan-derive ac-6 - display plan_ref
   447→  if (task.plan_ref) {
   448→    console.log(`Plan ref:  ${task.plan_ref}`);
   449→  }
   450→
   451→  if (task.depends_on.length > 0) {
   452→    if (index) {
   453→      console.log(fieldLabels.depends);
   454→      for (const ref of task.depends_on) {
   455→        const result = index.resolve(ref);
   456→        if (result.ok) {
   457→          const item = result.item;
   458→          const status =
   459→            "status" in item && typeof item.status === "string"
   460→              ? statusColor(item.status as TaskStatus)(`[${item.status}]`)
   461→              : chalk.gray("[spec]");
   462→          // Handle both spec items (with title) and meta items (with name or id)
   463→          const itemName =
   464→            "title" in item
   465→              ? item.title
   466→              : "name" in item
   467→                ? item.name
   468→                : "id" in item
   469→                  ? item.id
   470→                  : ref;
   471→          console.log(`  ${ref} ${chalk.gray("→")} ${itemName} ${status}`);
   472→        } else {
   473→          console.log(`  ${ref} ${chalk.red("(unresolved)")}`);
   474→        }
   475→      }
   476→    } else {
   477→      console.log(`${fieldLabels.depends}   ${task.depends_on.join(", ")}`);
   478→    }
   479→  }
   480→
   481→  if (task.blocked_by.length > 0) {
   482→    console.log(
   483→      chalk.red(`${fieldLabels.blocked}   ${task.blocked_by.join(", ")}`),
   484→    );
   485→  }
   486→
   487→  if (task.tags.length > 0) {
   488→    console.log(`${fieldLabels.tags}      ${task.tags.join(", ")}`);
   489→  }
   490→
   491→  console.log(`${fieldLabels.created}   ${task.created_at}`);
   492→  if (task.started_at) {
   493→    console.log(`${fieldLabels.started}   ${task.started_at}`);
   494→  }
   495→  if (task.completed_at) {
   496→    console.log(`${fieldLabels.completed} ${task.completed_at}`);
   497→  }
   498→
   499→  // Show resolved spec information
   500→  if (task.spec_ref && index) {
   501→    const result = index.resolve(task.spec_ref);
   502→    if (result.ok) {
   503→      const spec = result.item;
   504→      console.log(`\n${sectionHeaders.specContext}`);
   505→      // Handle both spec items (with title) and meta items (with name)
   506→      const specName =
   507→        "title" in spec
   508→          ? spec.title
   509→          : "name" in spec
   510→            ? spec.name
   511→            : "id" in spec
   512→              ? spec.id
   513→              : task.spec_ref;
   514→      console.log(chalk.cyan(specName));
   515→      if ("type" in spec && spec.type) {
   516→        console.log(chalk.gray(`${fieldLabels.type} ${spec.type}`));
   517→      }
   518→      // Show implementation status
   519→      if ("status" in spec && spec.status && typeof spec.status === "object") {
   520→        const status = spec.status as {
   521→          maturity?: string;
   522→          implementation?: string;
   523→        };
   524→        if (status.implementation) {
   525→          const implColor =
   526→            status.implementation === "verified"
   527→              ? chalk.green
   528→              : status.implementation === "implemented"
   529→                ? chalk.cyan
   530→                : status.implementation === "in_progress"
   531→                  ? chalk.yellow
   532→                  : chalk.gray;
   533→          console.log(
   534→            chalk.gray(fieldLabels.implementation) +
   535→              implColor(status.implementation),
   536→          );
   537→        }
   538→      }
   539→      if ("description" in spec && spec.description) {
   540→        console.log(chalk.gray(fieldLabels.description));
   541→        // Indent description lines
   542→        const desc = String(spec.description).trim();
   543→        for (const line of desc.split("\n")) {
   544→          console.log(chalk.gray(`  ${line}`));
   545→        }
   546→      }
   547→      if (
   548→        "acceptance_criteria" in spec &&
   549→        Array.isArray(spec.acceptance_criteria) &&
   550→        spec.acceptance_criteria.length > 0
   551→      ) {
   552→        console.log(chalk.gray(fieldLabels.acceptanceCriteria));
   553→        for (const ac of spec.acceptance_criteria) {
   554→          if (ac && typeof ac === "object" && "id" in ac) {
   555→            const acObj = ac as {
   556→              id: string;
   557→              given?: string;
   558→              when?: string;
   559→              then?: string;
   560→            };
   561→            console.log(chalk.gray(`  [${acObj.id}]`));
   562→            if (acObj.given)
   563→              console.log(chalk.gray(`    Given: ${acObj.given}`));
   564→            if (acObj.when) console.log(chalk.gray(`    When: ${acObj.when}`));
   565→            if (acObj.then) console.log(chalk.gray(`    Then: ${acObj.then}`));
   566→          }
   567→        }
   568→      }
   569→      // Show traceability if present
   570→      if (
   571→        "traceability" in spec &&
   572→        spec.traceability &&
   573→        typeof spec.traceability === "object"
   574→      ) {
   575→        const trace = spec.traceability as {
   576→          implementation?: Array<{
   577→            path: string;
   578→            function?: string;
   579→            lines?: string;
   580→          }>;
   581→          tests?: Array<{ path: string }>;
   582→          commits?: string[];
   583→          issues?: string[];
   584→        };
   585→        const hasTrace =
   586→          trace.implementation?.length ||
   587→          trace.tests?.length ||
   588→          trace.commits?.length ||
   589→          trace.issues?.length;
   590→        if (hasTrace) {
   591→          console.log(chalk.gray(fieldLabels.traceability));
   592→          if (trace.implementation?.length) {
   593→            for (const impl of trace.implementation) {
   594→              let loc = `  Code: ${impl.path}`;
   595→              if (impl.function) loc += `::${impl.function}`;
   596→              if (impl.lines) loc += `:${impl.lines}`;
   597→              console.log(chalk.gray(loc));
   598→            }
   599→          }
   600→          if (trace.tests?.length) {
   601→            for (const test of trace.tests) {
   602→              console.log(chalk.gray(`  Test: ${test.path}`));
   603→            }
   604→          }
   605→          if (trace.commits?.length) {
   606→            console.log(chalk.gray(`  Commits: ${trace.commits.join(", ")}`));
   607→          }
   608→          if (trace.issues?.length) {
   609→            console.log(chalk.gray(`  Issues: ${trace.issues.join(", ")}`));
   610→          }
   611→        }
   612→      }
   613→    }
   614→  }
   615→
   616→  if (task.notes.length > 0) {
   617→    console.log(`\n${sectionHeaders.notes}`);
   618→    for (const note of task.notes) {
   619→      const author = note.author || "unknown";
   620→      console.log(chalk.gray(`[${note.created_at}] ${author}:`));
   621→      console.log(note.content);
   622→    }
   623→  }
   624→
   625→  if (task.todos.length > 0) {
   626→    console.log(`\n${sectionHeaders.todos}`);
   627→    for (const todo of task.todos) {
   628→      const check = todo.done ? chalk.green("✓") : chalk.gray("○");
   629→      const text = todo.done ? chalk.strikethrough.gray(todo.text) : todo.text;
   630→      console.log(`${check} [${todo.id}] ${text}`);
   631→    }
   632→  }
   633→}
