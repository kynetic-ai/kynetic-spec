```
     1→/**
     2→ * Session event storage.
     3→ *
     4→ * JSONL-based event storage for agent sessions with:
     5→ * - Atomic appends for crash safety (AC-3)
     6→ * - Auto-assigned timestamps and sequence numbers (AC-2)
     7→ * - Session metadata management
     8→ *
     9→ * Storage structure:
    10→ *   .kspec/sessions/{session-id}/
    11→ *     session.yaml      # Metadata
    12→ *     events.jsonl      # Append-only event log
    13→ */
    14→
    15→import * as fs from "node:fs";
    16→import * as fsPromises from "node:fs/promises";
    17→import * as path from "node:path";
    18→import * as YAML from "yaml";
    19→import {
    20→  type SessionEvent,
    21→  type SessionEventInput,
    22→  SessionEventSchema,
    23→  type SessionMetadata,
    24→  type SessionMetadataInput,
    25→  SessionMetadataSchema,
    26→  type SessionStatus,
    27→} from "./types.js";
    28→
    29→// ─── Constants ───────────────────────────────────────────────────────────────
    30→
    31→const SESSIONS_DIR = "sessions";
    32→const METADATA_FILE = "session.yaml";
    33→const EVENTS_FILE = "events.jsonl";
    34→
    35→// ─── Path Helpers ────────────────────────────────────────────────────────────
    36→
    37→/**
    38→ * Get the sessions directory path within a spec directory.
    39→ */
    40→export function getSessionsDir(specDir: string): string {
    41→  return path.join(specDir, SESSIONS_DIR);
    42→}
    43→
    44→/**
    45→ * Get the path to a specific session's directory.
    46→ */
    47→export function getSessionDir(specDir: string, sessionId: string): string {
    48→  return path.join(getSessionsDir(specDir), sessionId);
    49→}
    50→
    51→/**
    52→ * Get the path to a session's metadata file.
    53→ */
    54→export function getSessionMetadataPath(
    55→  specDir: string,
    56→  sessionId: string,
    57→): string {
    58→  return path.join(getSessionDir(specDir, sessionId), METADATA_FILE);
    59→}
    60→
    61→/**
    62→ * Get the path to a session's events file.
    63→ */
    64→export function getSessionEventsPath(
    65→  specDir: string,
    66→  sessionId: string,
    67→): string {
    68→  return path.join(getSessionDir(specDir, sessionId), EVENTS_FILE);
    69→}
    70→
    71→/**
    72→ * Get the path to a session's context snapshot file for a given iteration.
    73→ */
    74→export function getSessionContextPath(
    75→  specDir: string,
    76→  sessionId: string,
    77→  iteration: number,
    78→): string {
    79→  return path.join(
    80→    getSessionDir(specDir, sessionId),
    81→    `context-iter-${iteration}.json`,
    82→  );
    83→}
    84→
    85→// ─── Session CRUD ────────────────────────────────────────────────────────────
    86→
    87→/**
    88→ * Create a new session with metadata.
    89→ *
    90→ * AC-1: Creates .kspec/sessions/{id}/ directory with session.yaml metadata file.
    91→ * AC-5: Metadata includes task_id (optional), agent_type, status, started_at, ended_at.
    92→ *
    93→ * @param specDir - The .kspec directory path
    94→ * @param input - Session metadata input
    95→ * @returns The created session metadata
    96→ */
    97→export async function createSession(
    98→  specDir: string,
    99→  input: SessionMetadataInput,
   100→): Promise<SessionMetadata> {
   101→  const sessionDir = getSessionDir(specDir, input.id);
   102→  const metadataPath = getSessionMetadataPath(specDir, input.id);
   103→
   104→  // Create session directory
   105→  await fsPromises.mkdir(sessionDir, { recursive: true });
   106→
   107→  // Build full metadata
   108→  const metadata: SessionMetadata = {
   109→    id: input.id,
   110→    task_id: input.task_id,
   111→    agent_type: input.agent_type,
   112→    status: input.status ?? "active",
   113→    started_at: input.started_at ?? new Date().toISOString(),
   114→    ended_at: undefined,
   115→  };
   116→
   117→  // Validate and write metadata
   118→  const validated = SessionMetadataSchema.parse(metadata);
   119→  const content = YAML.stringify(validated, {
   120→    indent: 2,
   121→    lineWidth: 100,
   122→    sortMapEntries: false,
   123→  });
   124→  await fsPromises.writeFile(metadataPath, content, "utf-8");
   125→
   126→  return validated;
   127→}
   128→
   129→/**
   130→ * Read session metadata.
   131→ *
   132→ * @param specDir - The .kspec directory path
   133→ * @param sessionId - Session ID
   134→ * @returns Session metadata or null if not found
   135→ */
   136→export async function getSession(
   137→  specDir: string,
   138→  sessionId: string,
   139→): Promise<SessionMetadata | null> {
   140→  const metadataPath = getSessionMetadataPath(specDir, sessionId);
   141→
   142→  try {
   143→    const content = await fsPromises.readFile(metadataPath, "utf-8");
   144→    const raw = YAML.parse(content);
   145→    return SessionMetadataSchema.parse(raw);
   146→  } catch {
   147→    return null;
   148→  }
   149→}
   150→
   151→/**
   152→ * Update session status.
   153→ *
   154→ * AC-6: Updates metadata with status and ended_at timestamp when session ends.
   155→ *
   156→ * @param specDir - The .kspec directory path
   157→ * @param sessionId - Session ID
   158→ * @param status - New status
   159→ * @returns Updated metadata or null if session not found
   160→ */
   161→export async function updateSessionStatus(
   162→  specDir: string,
   163→  sessionId: string,
   164→  status: SessionStatus,
   165→): Promise<SessionMetadata | null> {
   166→  const metadata = await getSession(specDir, sessionId);
   167→  if (!metadata) {
   168→    return null;
   169→  }
   170→
   171→  // Update status and ended_at if transitioning away from active
   172→  const updated: SessionMetadata = {
   173→    ...metadata,
   174→    status,
   175→    ended_at:
   176→      status !== "active" ? new Date().toISOString() : metadata.ended_at,
   177→  };
   178→
   179→  const metadataPath = getSessionMetadataPath(specDir, sessionId);
   180→  const content = YAML.stringify(updated, {
   181→    indent: 2,
   182→    lineWidth: 100,
   183→    sortMapEntries: false,
   184→  });
   185→  await fsPromises.writeFile(metadataPath, content, "utf-8");
   186→
   187→  return updated;
   188→}
   189→
   190→/**
   191→ * List all sessions.
   192→ *
   193→ * @param specDir - The .kspec directory path
   194→ * @returns Array of session IDs
   195→ */
   196→export async function listSessions(specDir: string): Promise<string[]> {
   197→  const sessionsDir = getSessionsDir(specDir);
   198→
   199→  try {
   200→    const entries = await fsPromises.readdir(sessionsDir, {
   201→      withFileTypes: true,
   202→    });
   203→    return entries.filter((e) => e.isDirectory()).map((e) => e.name);
   204→  } catch {
   205→    return [];
   206→  }
   207→}
   208→
   209→/**
   210→ * Check if a session exists.
   211→ */
   212→export async function sessionExists(
   213→  specDir: string,
   214→  sessionId: string,
   215→): Promise<boolean> {
   216→  const metadataPath = getSessionMetadataPath(specDir, sessionId);
   217→  try {
   218→    await fsPromises.access(metadataPath);
   219→    return true;
   220→  } catch {
   221→    return false;
   222→  }
   223→}
   224→
   225→// ─── Event Storage ───────────────────────────────────────────────────────────
   226→
   227→/**
   228→ * Get the current event count for a session (for seq assignment).
   229→ *
   230→ * @param specDir - The .kspec directory path
   231→ * @param sessionId - Session ID
   232→ * @returns Number of events in the session
   233→ */
   234→async function getEventCount(
   235→  specDir: string,
   236→  sessionId: string,
   237→): Promise<number> {
   238→  const eventsPath = getSessionEventsPath(specDir, sessionId);
   239→
   240→  try {
   241→    const content = await fsPromises.readFile(eventsPath, "utf-8");
   242→    const lines = content
   243→      .trim()
   244→      .split("\n")
   245→      .filter((line) => line.length > 0);
   246→    return lines.length;
   247→  } catch {
   248→    return 0;
   249→  }
   250→}
   251→
   252→/**
   253→ * Append an event to a session's event log.
   254→ *
   255→ * AC-2: Appends JSON line to events.jsonl with auto-assigned ts and seq.
   256→ * AC-3: Uses atomic append (appendFileSync) for crash safety.
   257→ *
   258→ * Creates the session directory if it doesn't exist (lazy creation).
   259→ *
   260→ * Note: This function is not safe for concurrent access to the same session.
   261→ * The sequence number assignment has a race condition between reading the
   262→ * event count and appending the event. This is acceptable for CLI use
   263→ * (single-process, sequential event logging). If concurrent access is needed
   264→ * in the future, consider file locking or an in-memory counter per session.
   265→ *
   266→ * @param specDir - The .kspec directory path
   267→ * @param input - Event input (ts and seq are auto-assigned if not provided)
   268→ * @returns The appended event with auto-assigned fields
   269→ */
   270→export async function appendEvent(
   271→  specDir: string,
   272→  input: SessionEventInput,
   273→): Promise<SessionEvent> {
   274→  const sessionDir = getSessionDir(specDir, input.session_id);
   275→  const eventsPath = getSessionEventsPath(specDir, input.session_id);
   276→
   277→  // Ensure session directory exists (lazy creation)
   278→  await fsPromises.mkdir(sessionDir, { recursive: true });
   279→
   280→  // Get current event count for seq assignment
   281→  const seq = input.seq ?? (await getEventCount(specDir, input.session_id));
   282→
   283→  // Build full event
   284→  const event: SessionEvent = {
   285→    ts: input.ts ?? Date.now(),
   286→    seq,
   287→    type: input.type,
   288→    session_id: input.session_id,
   289→    trace_id: input.trace_id,
   290→    data: input.data,
   291→  };
   292→
   293→  // Validate event
   294→  const validated = SessionEventSchema.parse(event);
   295→
   296→  // AC: @session-events ac-3 - Use synchronous append for crash safety
   297→  // This ensures the line is fully written before returning
   298→  const line = `${JSON.stringify(validated)}\n`;
   299→  fs.appendFileSync(eventsPath, line, "utf-8");
   300→
   301→  return validated;
   302→}
   303→
   304→/**
   305→ * Read all events from a session.
   306→ *
   307→ * AC-4: Returns all events in sequence order.
   308→ *
   309→ * @param specDir - The .kspec directory path
   310→ * @param sessionId - Session ID
   311→ * @returns Array of events sorted by sequence number
   312→ */
   313→export async function readEvents(
   314→  specDir: string,
   315→  sessionId: string,
   316→): Promise<SessionEvent[]> {
   317→  const eventsPath = getSessionEventsPath(specDir, sessionId);
   318→
   319→  try {
   320→    const content = await fsPromises.readFile(eventsPath, "utf-8");
   321→    const lines = content
   322→      .trim()
   323→      .split("\n")
   324→      .filter((line) => line.length > 0);
   325→
   326→    const events: SessionEvent[] = [];
   327→    for (const line of lines) {
   328→      try {
   329→        const raw = JSON.parse(line);
   330→        const event = SessionEventSchema.parse(raw);
   331→        events.push(event);
   332→      } catch {
   333→        // Skip invalid lines
   334→      }
   335→    }
   336→
   337→    // AC: @session-events ac-4 - Sort by sequence number
   338→    return events.sort((a, b) => a.seq - b.seq);
   339→  } catch {
   340→    return [];
   341→  }
   342→}
   343→
   344→/**
   345→ * Read events within a time range.
   346→ *
   347→ * @param specDir - The .kspec directory path
   348→ * @param sessionId - Session ID
   349→ * @param since - Start timestamp (inclusive)
   350→ * @param until - End timestamp (inclusive)
   351→ * @returns Array of events within the time range
   352→ */
   353→export async function readEventsSince(
   354→  specDir: string,
   355→  sessionId: string,
   356→  since: number,
   357→  until?: number,
   358→): Promise<SessionEvent[]> {
   359→  const events = await readEvents(specDir, sessionId);
   360→  return events.filter((e) => {
   361→    if (e.ts < since) return false;
   362→    if (until !== undefined && e.ts > until) return false;
   363→    return true;
   364→  });
   365→}
   366→
   367→/**
   368→ * Get the last event in a session.
   369→ *
   370→ * @param specDir - The .kspec directory path
   371→ * @param sessionId - Session ID
   372→ * @returns The last event or null if no events
   373→ */
   374→export async function getLastEvent(
   375→  specDir: string,
   376→  sessionId: string,
   377→): Promise<SessionEvent | null> {
   378→  const events = await readEvents(specDir, sessionId);
   379→  if (events.length === 0) {
   380→    return null;
   381→  }
   382→  return events[events.length - 1];
   383→}
   384→
   385→// ─── Session Log Summaries ───────────────────────────────────────────────────
   386→
   387→/**
   388→ * Summary data for a session, used by `session log list`.
   389→ */
   390→export interface SessionLogSummary {
   391→  /** Session ID */
   392→  id: string;
   393→  /** Session status */
   394→  status: SessionStatus;
   395→  /** Agent type */
   396→  agent_type: string;
   397→  /** When session started (ISO 8601) */
   398→  started_at: string;
   399→  /** When session ended (ISO 8601), if completed */
   400→  ended_at?: string;
   401→  /** Duration in milliseconds (computed from started_at/ended_at or now) */
   402→  duration_ms: number;
   403→  /** Number of events in events.jsonl */
   404→  event_count: number;
   405→  /** Number of context-iter-*.json files (iteration count) */
   406→  iteration_count: number;
   407→  /** Number of tasks completed during the session */
   408→  tasks_completed: number;
   409→}
   410→
   411→/**
   412→ * Count lines in events.jsonl without parsing JSON.
   413→ * Much faster than readEvents() for large files.
   414→ */
   415→async function countEventLines(
   416→  specDir: string,
   417→  sessionId: string,
   418→): Promise<number> {
   419→  const eventsPath = getSessionEventsPath(specDir, sessionId);
   420→  try {
   421→    const content = await fsPromises.readFile(eventsPath, "utf-8");
   422→    if (!content.trim()) return 0;
   423→    return content.trim().split("\n").length;
   424→  } catch {
   425→    return 0;
   426→  }
   427→}
   428→
   429→/**
   430→ * Count context-iter-*.json files for a session (iteration count).
   431→ */
   432→async function countIterations(
   433→  specDir: string,
   434→  sessionId: string,
   435→): Promise<number> {
   436→  const sessionDir = getSessionDir(specDir, sessionId);
   437→  try {
   438→    const entries = await fsPromises.readdir(sessionDir);
   439→    return entries.filter(
   440→      (e) => e.startsWith("context-iter-") && e.endsWith(".json"),
   441→    ).length;
   442→  } catch {
   443→    return 0;
   444→  }
   445→}
   446→
   447→/**
   448→ * Count task completions by scanning events for tool calls that invoke
   449→ * `kspec task complete` or `npm run dev -- task complete`.
   450→ *
   451→ * Real sessions record task completions as session.update events with
   452→ * sessionUpdate: "tool_call" and rawInput.command containing the complete command.
   453→ * We use a fast substring check before JSON parsing for performance.
   454→ */
   455→async function countTaskCompletions(
   456→  specDir: string,
   457→  sessionId: string,
   458→): Promise<number> {
   459→  const eventsPath = getSessionEventsPath(specDir, sessionId);
   460→  try {
   461→    const content = await fsPromises.readFile(eventsPath, "utf-8");
   462→    if (!content.trim()) return 0;
   463→    const lines = content.trim().split("\n");
   464→    let count = 0;
   465→    for (const line of lines) {
   466→      // Quick substring pre-filter: only parse lines that might contain task complete commands
   467→      if (!line.includes("task complete")) continue;
   468→      // Must be a tool_call event (session.update with sessionUpdate: "tool_call")
   469→      if (!line.includes('"tool_call"')) continue;
   470→      try {
   471→        const event = JSON.parse(line);
   472→        const command = event?.data?.update?.rawInput?.command;
   473→        if (typeof command === "string" && /\btask complete\b/.test(command)) {
   474→          count++;
   475→        }
   476→      } catch {
   477→        // Skip unparseable lines
   478→      }
   479→    }
   480→    return count;
   481→  } catch {
   482→    return 0;
   483→  }
   484→}
   485→
   486→/**
   487→ * Get a summary of a single session for list display.
   488→ *
   489→ * Gathers metadata and computes metrics lazily (only parses what's needed).
   490→ *
   491→ * @param specDir - The .kspec directory path
   492→ * @param sessionId - Session ID
   493→ * @returns Session summary or null if session doesn't exist
   494→ */
   495→export async function getSessionLogSummary(
   496→  specDir: string,
   497→  sessionId: string,
   498→): Promise<SessionLogSummary | null> {
   499→  const metadata = await getSession(specDir, sessionId);
   500→  if (!metadata) return null;
   501→
   502→  const [eventCount, iterationCount, tasksCompleted] = await Promise.all([
   503→    countEventLines(specDir, sessionId),
   504→    countIterations(specDir, sessionId),
   505→    countTaskCompletions(specDir, sessionId),
   506→  ]);
   507→
   508→  const startMs = new Date(metadata.started_at).getTime();
   509→  const endMs = metadata.ended_at
   510→    ? new Date(metadata.ended_at).getTime()
   511→    : Date.now();
   512→  const durationMs = endMs - startMs;
   513→
   514→  return {
   515→    id: metadata.id,
   516→    status: metadata.status,
   517→    agent_type: metadata.agent_type,
   518→    started_at: metadata.started_at,
   519→    ended_at: metadata.ended_at,
   520→    duration_ms: durationMs,
   521→    event_count: eventCount,
   522→    iteration_count: iterationCount,
   523→    tasks_completed: tasksCompleted,
   524→  };
   525→}
   526→
   527→/**
   528→ * Get summaries for all sessions.
   529→ *
   530→ * @param specDir - The .kspec directory path
   531→ * @returns Array of session summaries
   532→ */
   533→export async function getAllSessionLogSummaries(
   534→  specDir: string,
   535→): Promise<SessionLogSummary[]> {
   536→  const sessionIds = await listSessions(specDir);
   537→  const summaries = await Promise.all(
   538→    sessionIds.map((id) => getSessionLogSummary(specDir, id)),
   539→  );
   540→  return summaries.filter((s): s is SessionLogSummary => s !== null);
   541→}
   542→
   543→// ─── Context Snapshots ───────────────────────────────────────────────────────
   544→
   545→/**
   546→ * Save session context snapshot for a given iteration.
   547→ *
   548→ * This creates an audit trail of what context the agent saw at each iteration,
   549→ * useful for debugging and reviewing agent behavior.
   550→ *
   551→ * @param specDir - The .kspec directory path
   552→ * @param sessionId - Session ID
   553→ * @param iteration - Iteration number
   554→ * @param context - The session context data
   555→ */
   556→export async function saveSessionContext(
   557→  specDir: string,
   558→  sessionId: string,
   559→  iteration: number,
   560→  context: unknown,
   561→): Promise<void> {
   562→  const sessionDir = getSessionDir(specDir, sessionId);
   563→  const contextPath = getSessionContextPath(specDir, sessionId, iteration);
   564→
   565→  // Ensure session directory exists
   566→  await fsPromises.mkdir(sessionDir, { recursive: true });
   567→
   568→  // Write context snapshot as pretty JSON
   569→  const content = JSON.stringify(context, null, 2);
   570→  await fsPromises.writeFile(contextPath, content, "utf-8");
   571→}
   572→
   573→/**
   574→ * Read session context snapshot for a given iteration.
   575→ *
   576→ * @param specDir - The .kspec directory path
   577→ * @param sessionId - Session ID
   578→ * @param iteration - Iteration number
   579→ * @returns The context snapshot or null if not found
   580→ */
   581→export async function readSessionContext(
   582→  specDir: string,
   583→  sessionId: string,
   584→  iteration: number,
   585→): Promise<unknown | null> {
   586→  const contextPath = getSessionContextPath(specDir, sessionId, iteration);
   587→
   588→  try {
   589→    const content = await fsPromises.readFile(contextPath, "utf-8");
   590→    return JSON.parse(content);
   591→  } catch {
   592→    return null;
   593→  }
   594→}
   595→
   596→// ─── Session ID Resolution ───────────────────────────────────────────────────
   597→
   598→/**
   599→ * Result of resolving a session ID prefix.
   600→ */
   601→export type SessionIdResolution =
   602→  | { ok: true; id: string }
   603→  | { ok: false; error: "not_found" }
   604→  | { ok: false; error: "ambiguous"; matches: string[] };
   605→
   606→/**
   607→ * Resolve a session ID or prefix to a full session ID.
   608→ *
   609→ * AC: @session-log-show ac-7, ac-8, ac-9
   610→ *
   611→ * @param specDir - The .kspec directory path
   612→ * @param idOrPrefix - Full session ID or prefix (e.g., first 8 chars)
   613→ * @returns Resolution result
   614→ */
   615→export async function resolveSessionId(
   616→  specDir: string,
   617→  idOrPrefix: string,
   618→): Promise<SessionIdResolution> {
   619→  const sessionIds = await listSessions(specDir);
   620→
   621→  // First, try exact match
   622→  if (sessionIds.includes(idOrPrefix)) {
   623→    return { ok: true, id: idOrPrefix };
   624→  }
   625→
   626→  // Try prefix match
   627→  const matches = sessionIds.filter((id) => id.startsWith(idOrPrefix));
   628→
   629→  if (matches.length === 0) {
   630→    return { ok: false, error: "not_found" };
   631→  }
   632→
   633→  if (matches.length === 1) {
   634→    return { ok: true, id: matches[0] };
   635→  }
   636→
   637→  // Ambiguous - multiple matches
   638→  return { ok: false, error: "ambiguous", matches };
   639→}
   640→
   641→// ─── Session Detail Data ─────────────────────────────────────────────────────
   642→
   643→/**
   644→ * Per-iteration summary for session log show.
   645→ */
   646→export interface IterationSummary {
   647→  /** Iteration number (1-indexed) */
   648→  iteration: number;
   649→  /** Number of events in this iteration */
   650→  event_count: number;
   651→  /** Tasks started in this iteration */
   652→  tasks_started: string[];
   653→  /** Tasks completed in this iteration */
   654→  tasks_completed: string[];
   655→}
   656→
   657→/**
   658→ * Full session detail data for session log show.
   659→ */
   660→export interface SessionLogDetail {
   661→  /** Session metadata */
   662→  id: string;
   663→  status: SessionStatus;
   664→  agent_type: string;
   665→  task_id?: string;
   666→  started_at: string;
   667→  ended_at?: string;
   668→  duration_ms: number;
   669→  /** Total event count */
   670→  event_count: number;
   671→  /** Total iteration count */
   672→  iteration_count: number;
   673→  /** Per-iteration summaries */
   674→  iterations: IterationSummary[];
   675→}
   676→
   677→/**
   678→ * Get iteration number from a context snapshot file.
   679→ */
   680→async function getIterationNumbers(
   681→  specDir: string,
   682→  sessionId: string,
   683→): Promise<number[]> {
   684→  const sessionDir = getSessionDir(specDir, sessionId);
   685→  try {
   686→    const entries = await fsPromises.readdir(sessionDir);
   687→    const iterations: number[] = [];
   688→    for (const entry of entries) {
   689→      const match = entry.match(/^context-iter-(\d+)\.json$/);
   690→      if (match) {
   691→        iterations.push(parseInt(match[1], 10));
   692→      }
   693→    }
   694→    return iterations.sort((a, b) => a - b);
   695→  } catch {
   696→    return [];
   697→  }
   698→}
   699→
   700→/**
   701→ * Extract task refs from task commands in event data.
   702→ */
   703→function extractTaskRef(command: string): string | null {
   704→  // Match patterns like: kspec task start @ref, kspec task complete @ref
   705→  const match = command.match(/@[\w-]+/);
   706→  return match ? match[0] : null;
   707→}
   708→
   709→/**
   710→ * Compute per-iteration summaries from events.
   711→ *
   712→ * Dynamically creates iteration buckets based on both context snapshot files
   713→ * AND event data to handle cases where events are logged before context
   714→ * snapshots exist (e.g., active sessions).
   715→ *
   716→ * AC: @session-log-show ac-2
   717→ */
   718→async function computeIterationSummaries(
   719→  specDir: string,
   720→  sessionId: string,
   721→): Promise<IterationSummary[]> {
   722→  const events = await readEvents(specDir, sessionId);
   723→  const snapshotIterations = await getIterationNumbers(specDir, sessionId);
   724→
   725→  // Collect all iteration numbers from both snapshots and events
   726→  const allIterations = new Set<number>(snapshotIterations);
   727→  for (const event of events) {
   728→    const data = event.data as { iteration?: number } | null;
   729→    if (typeof data?.iteration === "number") {
   730→      allIterations.add(data.iteration);
   731→    }
   732→  }
   733→
   734→  // If no iterations found anywhere, create a single iteration-0 summary
   735→  if (allIterations.size === 0) {
   736→    return [
   737→      {
   738→        iteration: 0,
   739→        event_count: events.length,
   740→        tasks_started: [],
   741→        tasks_completed: [],
   742→      },
   743→    ];
   744→  }
   745→
   746→  // Create buckets for all known iterations
   747→  const iterations = Array.from(allIterations).sort((a, b) => a - b);
   748→  const iterationMap = new Map<number, SessionEvent[]>();
   749→  for (const n of iterations) {
   750→    iterationMap.set(n, []);
   751→  }
   752→
   753→  for (const event of events) {
   754→    // Try to get iteration from event data
   755→    const data = event.data as { iteration?: number } | null;
   756→    const iter = data?.iteration;
   757→    if (typeof iter === "number" && iterationMap.has(iter)) {
   758→      iterationMap.get(iter)!.push(event);
   759→    } else {
   760→      // Events without iteration info (lifecycle events) go to iteration 0
   761→      // or the first known iteration if 0 doesn't exist
   762→      const fallbackIter = iterationMap.has(0) ? 0 : iterations[0];
   763→      iterationMap.get(fallbackIter)!.push(event);
   764→    }
   765→  }
   766→
   767→  const summaries: IterationSummary[] = [];
   768→  for (const [iterNum, iterEvents] of iterationMap) {
   769→    const tasksStarted: string[] = [];
   770→    const tasksCompleted: string[] = [];
   771→
   772→    for (const event of iterEvents) {
   773→      if (event.type === "session.update") {
   774→        const data = event.data as {
   775→          update?: {
   776→            sessionUpdate?: string;
   777→            rawInput?: { command?: string };
   778→          };
   779→        } | null;
   780→        const command = data?.update?.rawInput?.command;
   781→        if (typeof command === "string") {
   782→          if (/\btask start\b/.test(command)) {
   783→            const ref = extractTaskRef(command);
   784→            if (ref) tasksStarted.push(ref);
   785→          } else if (/\btask complete\b/.test(command)) {
   786→            const ref = extractTaskRef(command);
   787→            if (ref) tasksCompleted.push(ref);
   788→          }
   789→        }
   790→      }
   791→    }
   792→
   793→    summaries.push({
   794→      iteration: iterNum,
   795→      event_count: iterEvents.length,
   796→      tasks_started: tasksStarted,
   797→      tasks_completed: tasksCompleted,
   798→    });
   799→  }
   800→
   801→  return summaries.sort((a, b) => a.iteration - b.iteration);
   802→}
   803→
   804→/**
   805→ * Get full session detail for session log show.
   806→ *
   807→ * @param specDir - The .kspec directory path
   808→ * @param sessionId - Session ID (must be resolved first)
   809→ * @returns Session detail or null if not found
   810→ */
   811→export async function getSessionLogDetail(
   812→  specDir: string,
   813→  sessionId: string,
   814→): Promise<SessionLogDetail | null> {
   815→  const metadata = await getSession(specDir, sessionId);
   816→  if (!metadata) return null;
   817→
   818→  const [eventCount, iterationCount, iterations] = await Promise.all([
   819→    countEventLines(specDir, sessionId),
   820→    countIterations(specDir, sessionId),
   821→    computeIterationSummaries(specDir, sessionId),
   822→  ]);
   823→
   824→  const startMs = new Date(metadata.started_at).getTime();
   825→  const endMs = metadata.ended_at
   826→    ? new Date(metadata.ended_at).getTime()
   827→    : Date.now();
   828→  const durationMs = endMs - startMs;
   829→
   830→  return {
   831→    id: metadata.id,
   832→    status: metadata.status,
   833→    agent_type: metadata.agent_type,
   834→    task_id: metadata.task_id,
   835→    started_at: metadata.started_at,
   836→    ended_at: metadata.ended_at,
   837→    duration_ms: durationMs,
   838→    event_count: eventCount,
   839→    iteration_count: iterationCount,
   840→    iterations,
   841→  };
   842→}
   843→
   844→// ─── Session Log Stats ───────────────────────────────────────────────────────
   845→
   846→/**
   847→ * Aggregate session statistics.
   848→ *
   849→ * AC: @session-log-stats ac-1, ac-2, ac-3
   850→ */
   851→export interface SessionLogStats {
   852→  /** Total number of sessions */
   853→  total_sessions: number;
   854→  /** Total events across all sessions */
   855→  total_events: number;
   856→  /** Total iterations across all sessions */
   857→  total_iterations: number;
   858→  /** Total tasks completed across all sessions */
   859→  total_tasks_completed: number;
   860→  /** Total duration in milliseconds */
   861→  total_duration_ms: number;
   862→
   863→  /** Average duration per session in milliseconds */
   864→  avg_duration_ms: number;
   865→  /** Average iterations per session */
   866→  avg_iterations_per_session: number;
   867→  /** Average tasks completed per session */
   868→  avg_tasks_per_session: number;
   869→
   870→  /** Status breakdown with counts and percentages */
   871→  status_breakdown: {
   872→    status: SessionStatus;
   873→    count: number;
   874→    percentage: number;
   875→  }[];
   876→}
   877→
   878→/**
   879→ * Tool usage statistics.
   880→ *
   881→ * AC: @session-log-stats ac-6
   882→ */
   883→export interface ToolUsageStats {
   884→  tool_name: string;
   885→  count: number;
   886→  percentage: number;
   887→}
   888→
   889→/**
   890→ * Time period stats for --by-day or --by-week.
   891→ *
   892→ * AC: @session-log-stats ac-7
   893→ */
   894→export interface TimePeriodStats {
   895→  period: string;
   896→  sessions_count: number;
   897→  tasks_completed: number;
   898→  total_duration_ms: number;
   899→}
   900→
   901→/**
   902→ * Compute aggregate statistics from session summaries.
   903→ *
   904→ * @param summaries - Array of session log summaries
   905→ * @returns Aggregate statistics
   906→ */
   907→export function computeSessionLogStats(
   908→  summaries: SessionLogSummary[],
   909→): SessionLogStats {
   910→  if (summaries.length === 0) {
   911→    return {
   912→      total_sessions: 0,
   913→      total_events: 0,
   914→      total_iterations: 0,
   915→      total_tasks_completed: 0,
   916→      total_duration_ms: 0,
   917→      avg_duration_ms: 0,
   918→      avg_iterations_per_session: 0,
   919→      avg_tasks_per_session: 0,
   920→      status_breakdown: [],
   921→    };
   922→  }
   923→
   924→  // Compute totals
   925→  let totalEvents = 0;
   926→  let totalIterations = 0;
   927→  let totalTasksCompleted = 0;
   928→  let totalDuration = 0;
   929→  const statusCounts: Record<SessionStatus, number> = {
   930→    active: 0,
   931→    completed: 0,
   932→    abandoned: 0,
   933→  };
   934→
   935→  for (const s of summaries) {
   936→    totalEvents += s.event_count;
   937→    totalIterations += s.iteration_count;
   938→    totalTasksCompleted += s.tasks_completed;
   939→    totalDuration += s.duration_ms;
   940→    statusCounts[s.status] = (statusCounts[s.status] || 0) + 1;
   941→  }
   942→
   943→  const n = summaries.length;
   944→
   945→  // Build status breakdown
   946→  const statusBreakdown: { status: SessionStatus; count: number; percentage: number }[] = [];
   947→  for (const status of ["completed", "active", "abandoned"] as SessionStatus[]) {
   948→    const count = statusCounts[status] || 0;
   949→    if (count > 0) {
   950→      statusBreakdown.push({
   951→        status,
   952→        count,
   953→        percentage: Math.round((count / n) * 100 * 10) / 10, // 1 decimal place
   954→      });
   955→    }
   956→  }
   957→
   958→  return {
   959→    total_sessions: n,
   960→    total_events: totalEvents,
   961→    total_iterations: totalIterations,
   962→    total_tasks_completed: totalTasksCompleted,
   963→    total_duration_ms: totalDuration,
   964→    avg_duration_ms: Math.round(totalDuration / n),
   965→    avg_iterations_per_session: Math.round((totalIterations / n) * 10) / 10,
   966→    avg_tasks_per_session: Math.round((totalTasksCompleted / n) * 10) / 10,
   967→    status_breakdown: statusBreakdown,
   968→  };
   969→}
   970→
   971→/**
   972→ * Count tool calls by scanning events.jsonl for tool_call events.
   973→ *
   974→ * This is relatively expensive as it parses all events, so only call
   975→ * when --tool-usage is requested.
   976→ *
   977→ * AC: @session-log-stats ac-6
   978→ */
   979→export async function computeToolUsageStats(
   980→  specDir: string,
   981→  sessionIds: string[],
   982→  limit: number = 10,
   983→): Promise<ToolUsageStats[]> {
   984→  const toolCounts: Record<string, number> = {};
   985→  let totalToolCalls = 0;
   986→
   987→  for (const sessionId of sessionIds) {
   988→    const eventsPath = getSessionEventsPath(specDir, sessionId);
   989→    try {
   990→      const content = await fsPromises.readFile(eventsPath, "utf-8");
   991→      if (!content.trim()) continue;
   992→      const lines = content.trim().split("\n");
   993→      for (const line of lines) {
   994→        // Quick pre-filter: only parse lines that might be tool_call events
   995→        if (!line.includes('"tool_call"')) continue;
   996→        try {
   997→          const event = JSON.parse(line);
   998→          if (event?.type === "session.update") {
   999→            const update = event?.data?.update;
  1000→            if (update?.sessionUpdate === "tool_call") {
  1001→              const toolName = update?._meta?.claudeCode?.toolName || "unknown";
  1002→              toolCounts[toolName] = (toolCounts[toolName] || 0) + 1;
  1003→              totalToolCalls++;
  1004→            }
  1005→          }
  1006→        } catch {
  1007→          // Skip unparseable lines
  1008→        }
  1009→      }
  1010→    } catch {
  1011→      // Skip sessions without events
  1012→    }
  1013→  }
  1014→
  1015→  // Sort by count descending, take top N
  1016→  const sorted = Object.entries(toolCounts)
  1017→    .map(([tool_name, count]) => ({
  1018→      tool_name,
  1019→      count,
  1020→      percentage: totalToolCalls > 0
  1021→        ? Math.round((count / totalToolCalls) * 100 * 10) / 10
  1022→        : 0,
  1023→    }))
  1024→    .sort((a, b) => b.count - a.count)
  1025→    .slice(0, limit);
  1026→
  1027→  return sorted;
  1028→}
  1029→
  1030→/**
  1031→ * Compute ISO-8601 week number and week-year in UTC.
  1032→ *
  1033→ * ISO-8601 rules:
  1034→ * - Week 1 contains the first Thursday of the year
  1035→ * - Week starts on Monday
  1036→ * - Week-year may differ from calendar year at year boundaries
  1037→ *
  1038→ * Returns [weekYear, weekNumber] tuple.
  1039→ */
  1040→function getISOWeekUTC(date: Date): [number, number] {
  1041→  // Clone and normalize to UTC midnight
  1042→  const d = new Date(Date.UTC(
  1043→    date.getUTCFullYear(),
  1044→    date.getUTCMonth(),
  1045→    date.getUTCDate()
  1046→  ));
  1047→
  1048→  // Get day of week (ISO: Monday=1, Sunday=7)
  1049→  const dayOfWeek = d.getUTCDay() || 7;
  1050→
  1051→  // Set to nearest Thursday (determines week-year)
  1052→  d.setUTCDate(d.getUTCDate() + 4 - dayOfWeek);
  1053→
  1054→  // Week-year is the year of this Thursday
  1055→  const weekYear = d.getUTCFullYear();
  1056→
  1057→  // January 4 is always in week 1 (as it's in the first week with a Thursday)
  1058→  const jan4 = new Date(Date.UTC(weekYear, 0, 4));
  1059→  const jan4DayOfWeek = jan4.getUTCDay() || 7;
  1060→
  1061→  // Start of week 1 (Monday before or on Jan 4)
  1062→  const week1Start = new Date(jan4);
  1063→  week1Start.setUTCDate(jan4.getUTCDate() - (jan4DayOfWeek - 1));
  1064→
  1065→  // Week number = weeks between week 1 start and the Thursday we found
  1066→  const weekNum = Math.floor((d.getTime() - week1Start.getTime()) / (7 * 24 * 60 * 60 * 1000)) + 1;
  1067→
  1068→  return [weekYear, weekNum];
  1069→}
  1070→
  1071→/**
  1072→ * Group sessions by time period (day or week).
  1073→ *
  1074→ * AC: @session-log-stats ac-7
  1075→ */
  1076→export function computeTimePeriodStats(
  1077→  summaries: SessionLogSummary[],
  1078→  groupBy: "day" | "week",
  1079→): TimePeriodStats[] {
  1080→  const buckets: Record<string, { sessions: number; tasks: number; duration: number }> = {};
  1081→
  1082→  for (const s of summaries) {
  1083→    const date = new Date(s.started_at);
  1084→    let period: string;
  1085→
  1086→    if (groupBy === "day") {
  1087→      period = date.toISOString().split("T")[0]; // YYYY-MM-DD in UTC
  1088→    } else {
  1089→      // Week: use ISO-8601 week format (YYYY-Www) in UTC
  1090→      const [weekYear, weekNum] = getISOWeekUTC(date);
  1091→      period = `${weekYear}-W${weekNum.toString().padStart(2, "0")}`;
  1092→    }
  1093→
  1094→    if (!buckets[period]) {
  1095→      buckets[period] = { sessions: 0, tasks: 0, duration: 0 };
  1096→    }
  1097→    buckets[period].sessions += 1;
  1098→    buckets[period].tasks += s.tasks_completed;
  1099→    buckets[period].duration += s.duration_ms;
  1100→  }
  1101→
  1102→  // Convert to array and sort by period (newest first for display)
  1103→  const result: TimePeriodStats[] = Object.entries(buckets)
  1104→    .map(([period, data]) => ({
  1105→      period,
  1106→      sessions_count: data.sessions,
  1107→      tasks_completed: data.tasks,
  1108→      total_duration_ms: data.duration,
  1109→    }))
  1110→    .sort((a, b) => b.period.localeCompare(a.period));
  1111→
  1112→  return result;
  1113→}
  1114→
  1115→// ─── Session Log Search ───────────────────────────────────────────────────────
  1116→
  1117→/**
  1118→ * A single search match result.
  1119→ *
  1120→ * AC: @session-log-search ac-4
  1121→ */
  1122→export interface SearchMatch {
  1123→  /** Session ID */
  1124→  session_id: string;
  1125→  /** Event timestamp (Unix ms) */
  1126→  timestamp: number;
  1127→  /** Event type */
  1128→  event_type: string;
  1129→  /** Matching content excerpt (limited to 200 chars) */
  1130→  content_excerpt: string;
  1131→}
  1132→
  1133→/**
  1134→ * Search results grouped by session.
  1135→ */
  1136→export interface SessionSearchResult {
  1137→  /** Session ID */
  1138→  session_id: string;
  1139→  /** Agent type for this session */
  1140→  agent_type: string;
  1141→  /** When the session started */
  1142→  started_at: string;
  1143→  /** Matches found in this session */
  1144→  matches: SearchMatch[];
  1145→}
  1146→
  1147→/**
  1148→ * Search options for filtering sessions and events.
  1149→ */
  1150→export interface SearchOptions {
  1151→  /** Only search events of this type (e.g., 'session.update', 'prompt.sent') */
  1152→  eventType?: string;
  1153→  /** Only search sessions started after this date */
  1154→  sinceDate?: Date;
  1155→  /** Only search sessions with this agent type */
  1156→  agentType?: string;
  1157→  /** Maximum total matches to return (default: 50) */
  1158→  limit?: number;
  1159→}
  1160→
  1161→/**
  1162→ * Extract a content excerpt around a match, limited to maxLength chars.
  1163→ *
  1164→ * AC: @session-log-search ac-4
  1165→ */
  1166→function extractContentExcerpt(
  1167→  data: unknown,
  1168→  pattern: string,
  1169→  maxLength: number = 200,
  1170→): string {
  1171→  // Stringify the data for searching
  1172→  const str = JSON.stringify(data);
  1173→  const lowerStr = str.toLowerCase();
  1174→  const lowerPattern = pattern.toLowerCase();
  1175→
  1176→  const matchIndex = lowerStr.indexOf(lowerPattern);
  1177→  if (matchIndex === -1) {
  1178→    // Shouldn't happen since we pre-filtered, but return start of content
  1179→    return str.length > maxLength ? str.slice(0, maxLength - 3) + "..." : str;
  1180→  }
  1181→
  1182→  // Calculate excerpt window centered on match
  1183→  const matchLen = pattern.length;
  1184→  const contextBefore = Math.floor((maxLength - matchLen) / 2);
  1185→  const start = Math.max(0, matchIndex - contextBefore);
  1186→  const end = Math.min(str.length, start + maxLength);
  1187→
  1188→  let excerpt = str.slice(start, end);
  1189→
  1190→  // Add ellipsis indicators
  1191→  if (start > 0) {
  1192→    excerpt = "..." + excerpt.slice(3);
  1193→  }
  1194→  if (end < str.length) {
  1195→    excerpt = excerpt.slice(0, -3) + "...";
  1196→  }
  1197→
  1198→  return excerpt;
  1199→}
  1200→
  1201→/**
  1202→ * Search across session events for a pattern.
  1203→ *
  1204→ * This streams through events.jsonl files, applying filters as early as possible
  1205→ * for performance. Sessions are pre-filtered by metadata (--since, --agent) before
  1206→ * scanning events to reduce I/O.
  1207→ *
  1208→ * AC: @session-log-search ac-1, ac-2, ac-3, ac-5, ac-7
  1209→ *
  1210→ * @param specDir - The .kspec directory path
  1211→ * @param pattern - Case-insensitive substring to search for
  1212→ * @param options - Search filtering options
  1213→ * @returns Array of search results grouped by session
  1214→ */
  1215→export async function searchSessionEvents(
  1216→  specDir: string,
  1217→  pattern: string,
  1218→  options: SearchOptions = {},
  1219→): Promise<SessionSearchResult[]> {
  1220→  // Defense-in-depth: normalize limit to a valid positive integer
  1221→  const rawLimit = options.limit ?? 50;
  1222→  const limit = Number.isNaN(rawLimit) || rawLimit <= 0 ? 50 : rawLimit;
  1223→  const lowerPattern = pattern.toLowerCase();
  1224→
  1225→  // Get all session summaries for metadata filtering
  1226→  const allSummaries = await getAllSessionLogSummaries(specDir);
  1227→
  1228→  // AC: @session-log-search ac-3 - Pre-filter by --since
  1229→  let filteredSummaries = allSummaries;
  1230→  if (options.sinceDate) {
  1231→    filteredSummaries = filteredSummaries.filter(
  1232→      (s) => new Date(s.started_at) >= options.sinceDate!,
  1233→    );
  1234→  }
  1235→
  1236→  // AC: @session-log-search ac-7 - Pre-filter by --agent
  1237→  if (options.agentType) {
  1238→    filteredSummaries = filteredSummaries.filter(
  1239→      (s) => s.agent_type === options.agentType,
  1240→    );
  1241→  }
  1242→
  1243→  const results: SessionSearchResult[] = [];
  1244→  let totalMatches = 0;
  1245→
  1246→  for (const summary of filteredSummaries) {
  1247→    if (totalMatches >= limit) break;
  1248→
  1249→    const eventsPath = getSessionEventsPath(specDir, summary.id);
  1250→    let content: string;
  1251→    try {
  1252→      content = await fsPromises.readFile(eventsPath, "utf-8");
  1253→    } catch {
  1254→      continue; // Skip sessions without events
  1255→    }
  1256→
  1257→    if (!content.trim()) continue;
  1258→
  1259→    const matches: SearchMatch[] = [];
  1260→    const lines = content.trim().split("\n");
  1261→
  1262→    for (const line of lines) {
  1263→      if (totalMatches >= limit) break;
  1264→
  1265→      // Quick substring pre-filter before parsing JSON
  1266→      if (!line.toLowerCase().includes(lowerPattern)) continue;
  1267→
  1268→      try {
  1269→        const event = JSON.parse(line);
  1270→
  1271→        // AC: @session-log-search ac-2 - Filter by event type
  1272→        if (options.eventType && event.type !== options.eventType) continue;
  1273→
  1274→        // Verify match in stringified data (not just line, in case pattern appears in metadata)
  1275→        const dataStr = JSON.stringify(event.data);
  1276→        if (!dataStr.toLowerCase().includes(lowerPattern)) continue;
  1277→
  1278→        // AC: @session-log-search ac-4 - Create match with excerpt
  1279→        matches.push({
  1280→          session_id: summary.id,
  1281→          timestamp: event.ts,
  1282→          event_type: event.type,
  1283→          content_excerpt: extractContentExcerpt(event.data, pattern, 200),
  1284→        });
  1285→        totalMatches++;
  1286→      } catch {
  1287→        // Skip unparseable lines
  1288→      }
  1289→    }
  1290→
  1291→    if (matches.length > 0) {
  1292→      results.push({
  1293→        session_id: summary.id,
  1294→        agent_type: summary.agent_type,
  1295→        started_at: summary.started_at,
  1296→        matches,
  1297→      });
  1298→    }
  1299→  }
  1300→
  1301→  return results;
  1302→}
  1303→

