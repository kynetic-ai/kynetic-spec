   790→    const specDir = `${tempDir}/.kspec`;
   791→    // Use inbox list (read-only, always succeeds) to verify the env var works
   792→    const result = kspec("inbox list", tempDir, {
   793→      env: { KSPEC_SPEC_DIR: specDir },
   794→    });
   795→    expect(result.exitCode).toBe(0);
   796→  });
   797→});
