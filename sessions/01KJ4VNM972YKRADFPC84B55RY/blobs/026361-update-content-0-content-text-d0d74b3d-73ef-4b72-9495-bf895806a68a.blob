   743→    );
   744→    const taskRef = addResult.task._ulid;
   745→    expect(taskRef).toBeTruthy();
   746→
   747→    // Batch patch with nested data object — this was the bug:
   748→    // the data object got stringified as "[object Object]" instead of JSON
   749→    const patchData = { priority: 2, tags: ["batch-test"] };
   750→    const batchCmd = JSON.stringify([
   751→      {
   752→        command: "task patch",
   753→        args: { ref: `@${taskRef}`, data: patchData },
   754→      },
   755→    ]);
   756→    const result = kspecJson<BatchExecResult>(
   757→      `batch --commands '${batchCmd}'`,
   758→      tempDir,
   759→    );
   760→    expect(result.success).toBe(true);
   761→    expect(result.summary.succeeded).toBe(1);
   762→
   763→    // Verify the patch was applied correctly
   764→    const taskData = kspecJson<{ priority: number; tags: string[] }>(
   765→      `task get @${taskRef}`,
   766→      tempDir,
   767→    );
   768→    expect(taskData.priority).toBe(2);
   769→    expect(taskData.tags).toContain("batch-test");
   770→  });
   771→});
