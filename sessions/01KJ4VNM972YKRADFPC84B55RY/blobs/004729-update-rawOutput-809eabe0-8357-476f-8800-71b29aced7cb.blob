     1→/**
     2→ * Skill CRUD commands: list, add, get, set, delete, import
     3→ *
     4→ * AC: @skill-cli ac-1 - kspec skill list outputs table with ID, Name, Origin, Version, Platforms
     5→ * AC: @skill-cli ac-2 - kspec skill list --json outputs JSON array with full skill metadata
     6→ * AC: @skill-cli ac-3 - kspec skill add creates meta entry with origin custom
     7→ * AC: @skill-cli ac-4 - kspec skill add creates .kspec/skills/<id>/SKILL.md
     8→ * AC: @skill-cli ac-5 - kspec skill get outputs metadata including id, name, origin, platforms
     9→ * AC: @skill-cli ac-6 - kspec skill get outputs SKILL.md content
    10→ * AC: @skill-cli ac-7 - kspec skill delete --confirm removes meta entry
    11→ * AC: @skill-cli ac-8 - kspec skill delete removes .kspec/skills/<id>/ directory
    12→ */
    13→
    14→import * as fs from "node:fs/promises";
    15→import * as path from "node:path";
    16→import chalk from "chalk";
    17→import Table from "cli-table3";
    18→import type { Command } from "commander";
    19→import { ulid } from "ulid";
    20→import yaml from "yaml";
    21→import { markMutating } from "../command-annotations.js";
    22→import {
    23→  deleteMetaItem,
    24→  findMetaItemByRef,
    25→  getSkillContentPath,
    26→  initContext,
    27→  isSkill,
    28→  loadMetaContext,
    29→  loadSkillContent,
    30→  loadSkillDocs,
    31→  type LoadedSkill,
    32→  saveMetaItem,
    33→} from "../../parser/index.js";
    34→import { commitIfShadow } from "../../parser/shadow.js";
    35→import { copyDirectory } from "../../parser/skill-render.js";
    36→import {
    37→  SkillSchema,
    38→  ClaudeCodeConfigSchema,
    39→  CodexConfigSchema,
    40→  type SkillOrigin,
    41→  type PlatformConfig,
    42→} from "../../schema/index.js";
    43→import { errors } from "../../strings/errors.js";
    44→import { EXIT_CODES } from "../exit-codes.js";
    45→import { error, output, success } from "../output.js";
    46→import { parseTagsArray } from "../parse-utils.js";
    47→
    48→// ============================================================================
    49→// Frontmatter & Content Processing
    50→// ============================================================================
    51→
    52→/**
    53→ * Parsed frontmatter from Agent Skills SKILL.md
    54→ * AC: @import-frontmatter-strip ac-1 - All recognized Agent Skills fields
    55→ * AC: @import-frontmatter-strip ac-3 - Claude Code platform-specific fields
    56→ */
    57→export interface ParsedFrontmatter {
    58→  // Core metadata
    59→  name?: string;
    60→  description?: string;
    61→  // Portable Agent Skills fields (AC: ac-1)
    62→  license?: string;
    63→  compatibility?: string;
    64→  allowed_tools?: string[];
    65→  // Claude Code platform fields (AC: ac-3)
    66→  user_invocable?: boolean;
    67→  disable_model_invocation?: boolean;
    68→  context?: string;
    69→  agent?: string;
    70→  model?: string;
    71→  argument_hint?: string;
    72→}
    73→
    74→/**
    75→ * Parse YAML frontmatter from markdown content.
    76→ * Returns null if no valid frontmatter found.
    77→ *
    78→ * AC: @import-frontmatter-strip ac-1 - Parse all Agent Skills frontmatter fields
    79→ * AC: @import-frontmatter-strip ac-3 - Parse Claude Code platform frontmatter
    80→ */
    81→export function parseFrontmatter(content: string): ParsedFrontmatter | null {
    82→  const frontmatterRegex = /^---\r?\n([\s\S]*?)\r?\n---/;
    83→  const match = content.match(frontmatterRegex);
    84→
    85→  if (!match) {
    86→    return null;
    87→  }
    88→
    89→  try {
    90→    const parsed = yaml.parse(match[1]);
    91→
    92→    if (typeof parsed === "object" && parsed !== null) {
    93→      const result: ParsedFrontmatter = {};
    94→
    95→      // Core metadata
    96→      if (typeof parsed.name === "string") result.name = parsed.name;
    97→      if (typeof parsed.description === "string") result.description = parsed.description;
    98→
    99→      // Portable Agent Skills fields (AC: ac-1)
   100→      if (typeof parsed.license === "string") result.license = parsed.license;
   101→      if (typeof parsed.compatibility === "string") result.compatibility = parsed.compatibility;
   102→      if (Array.isArray(parsed.allowed_tools)) {
   103→        result.allowed_tools = parsed.allowed_tools.filter((t: unknown) => typeof t === "string");
   104→      }
   105→
   106→      // Claude Code platform fields (AC: ac-3)
   107→      // Support both underscore and hyphen naming for user-invocable
   108→      if (typeof parsed.user_invocable === "boolean") result.user_invocable = parsed.user_invocable;
   109→      if (typeof parsed["user-invocable"] === "boolean") result.user_invocable = parsed["user-invocable"];
   110→      if (typeof parsed.disable_model_invocation === "boolean") result.disable_model_invocation = parsed.disable_model_invocation;
   111→      if (typeof parsed["disable-model-invocation"] === "boolean") result.disable_model_invocation = parsed["disable-model-invocation"];
   112→      if (typeof parsed.context === "string") result.context = parsed.context;
   113→      if (typeof parsed.agent === "string") result.agent = parsed.agent;
   114→      if (typeof parsed.model === "string") result.model = parsed.model;
   115→      if (typeof parsed.argument_hint === "string") result.argument_hint = parsed.argument_hint;
   116→      if (typeof parsed["argument-hint"] === "string") result.argument_hint = parsed["argument-hint"];
   117→
   118→      return result;
   119→    }
   120→  } catch {
   121→    // Invalid YAML in frontmatter
   122→  }
   123→
   124→  return null;
   125→}
   126→
   127→/**
   128→ * Strip YAML frontmatter from markdown content.
   129→ * AC: @import-frontmatter-strip ac-2 - Remove frontmatter for body-only storage
   130→ */
   131→export function stripFrontmatter(content: string): string {
   132→  return content.replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n?/, "");
   133→}
   134→
   135→/**
   136→ * Normalize base-directory paths in skill content.
   137→ * AC: @skill-import ac-7 - Strip or convert absolute paths to relative.
   138→ *
   139→ * Matches patterns like:
   140→ * - "Base directory for this skill: /absolute/path/to/skill"
   141→ * - Lines starting with hardcoded paths
   142→ */
   143→export function normalizeBaseDirectory(content: string): string {
   144→  // Remove or normalize "Base directory for/of [this] skill:" lines with absolute paths
   145→  // Common pattern in Claude-generated skill files
   146→  // AC: @cross-platform-and-version-robustness ac-5 - case-insensitive with wording variations
   147→  const baseDirLineRegex = /^base\s+directory\s+(?:for|of)\s+(?:this\s+)?skill:.*$/gim;
   148→
   149→  return content.replace(baseDirLineRegex, "");
   150→}
   151→
   152→// ============================================================================
   153→// Formatting Helpers
   154→// ============================================================================
   155→
   156→/**
   157→ * Format skills as a table
   158→ * AC: @skill-cli ac-1 - table displays ID, Name, Origin, Version, Platforms
   159→ */
   160→function formatSkillsTable(skills: LoadedSkill[]): void {
   161→  if (skills.length === 0) {
   162→    console.log(chalk.yellow("No skills defined"));
   163→    return;
   164→  }
   165→
   166→  const table = new Table({
   167→    head: [
   168→      chalk.bold("ID"),
   169→      chalk.bold("Name"),
   170→      chalk.bold("Origin"),
   171→      chalk.bold("Version"),
   172→      chalk.bold("Platforms"),
   173→    ],
   174→    style: {
   175→      head: [],
   176→      border: [],
   177→    },
   178→  });
   179→
   180→  for (const skill of skills) {
   181→    table.push([
   182→      skill.id,
   183→      skill.name,
   184→      skill.origin,
   185→      skill.version || "-",
   186→      skill.platforms.join(", "),
   187→    ]);
   188→  }
   189→
   190→  console.log(table.toString());
   191→  console.log(chalk.gray(`\n${skills.length} skill(s)`));
   192→}
   193→
   194→/**
   195→ * Format skill details
   196→ * AC: @skill-cli ac-5 - outputs metadata including id, name, origin, platforms
   197→ */
   198→function formatSkillDetails(skill: LoadedSkill, content: string | null): void {
   199→  console.log(chalk.bold(skill.name));
   200→  console.log(chalk.gray("─".repeat(40)));
   201→  console.log(`ID:          ${skill.id}`);
   202→  console.log(`ULID:        ${skill._ulid}`);
   203→  console.log(`Origin:      ${skill.origin}`);
   204→  console.log(`Platforms:   ${skill.platforms.join(", ")}`);
   205→
   206→  if (skill.version) {
   207→    console.log(`Version:     ${skill.version}`);
   208→  }
   209→
   210→  if (skill.description) {
   211→    console.log(`\n─── Description ───`);
   212→    console.log(skill.description);
   213→  }
   214→
   215→  if (skill.depends_on && skill.depends_on.length > 0) {
   216→    console.log(`\n─── Dependencies ───`);
   217→    for (const dep of skill.depends_on) {
   218→      console.log(`  • ${dep}`);
   219→    }
   220→  }
   221→
   222→  if (skill.tags && skill.tags.length > 0) {
   223→    console.log(`\nTags:        ${skill.tags.join(", ")}`);
   224→  }
   225→
   226→  // AC: @skill-cli ac-6 - display SKILL.md content
   227→  if (content) {
   228→    console.log(`\n─── SKILL.md Content ───`);
   229→    console.log(content);
   230→  } else {
   231→    console.log(chalk.gray("\n(No SKILL.md content found)"));
   232→  }
   233→}
   234→
   235→// ============================================================================
   236→// Command Registration
   237→// ============================================================================
   238→
   239→/**
   240→ * Register CRUD skill commands (list, add, get, set, delete, import)
   241→ */
   242→export function registerSkillCrudCommands(skill: Command): void {
   243→  // AC: @skill-cli ac-1, ac-2 - kspec skill list
   244→  skill
   245→    .command("list")
   246→    .description("List all skills")
   247→    .option("--origin <origin>", "Filter by origin (core, project, local)")
   248→    .option("--tag <tag>", "Filter by tag")
   249→    .action(async (options) => {
   250→      try {
   251→        const ctx = await initContext();
   252→
   253→        if (!ctx.manifestPath) {
   254→          error(errors.project.noKspecProject);
   255→          process.exit(EXIT_CODES.ERROR);
   256→        }
   257→
   258→        const metaCtx = await loadMetaContext(ctx);
   259→        let skills = metaCtx.skills || [];
   260→
   261→        // Apply filters
   262→        if (options.origin) {
   263→          skills = skills.filter((s) => s.origin === options.origin);
   264→        }
   265→
   266→        if (options.tag) {
   267→          skills = skills.filter((s) => s.tags?.includes(options.tag));
   268→        }
   269→
   270→        // AC: @skill-cli ac-2 - JSON output includes full skill metadata
   271→        output(
   272→          skills.map((s) => ({
   273→            _ulid: s._ulid,
   274→            id: s.id,
   275→            name: s.name,
   276→            description: s.description,
   277→            origin: s.origin,
   278→            version: s.version,
   279→            platforms: s.platforms,
   280→            depends_on: s.depends_on,
   281→            tags: s.tags,
   282→          })),
   283→          // AC: @skill-cli ac-1 - Table output
   284→          () => formatSkillsTable(skills),
   285→        );
   286→      } catch (err) {
   287→        error("Failed to list skills", err);
   288→        process.exit(EXIT_CODES.ERROR);
   289→      }
   290→    });
   291→
   292→  // AC: @skill-cli ac-3, ac-4 - kspec skill add
   293→  // AC: @skill-add ac-3 - --content-file copies existing file to SKILL.md
   294→  markMutating(skill.command("add"))
   295→    .description("Create a new skill")
   296→    .requiredOption("--id <id>", "Skill ID (kebab-case)")
   297→    .requiredOption("--name <name>", "Skill name")
   298→    .option("--description <desc>", "Skill description")
   299→    .option(
   300→      "--origin <origin>",
   301→      "Skill origin (core, project, local)",
   302→      "project",
   303→    )
   304→    .option("--skill-version <version>", "Skill version")
   305→    .option("--platform <platform...>", "Target platforms")
   306→    .option("--tag <tag...>", "Tags for the skill")
   307→    .option("--depends-on <ref...>", "Skill dependencies")
   308→    .option("--content-file <path>", "Path to existing file to use as SKILL.md content")
   309→    .action(async (options) => {
   310→      try {
   311→        const ctx = await initContext();
   312→
   313→        if (!ctx.manifestPath) {
   314→          error(errors.project.noKspecProject);
   315→          process.exit(EXIT_CODES.ERROR);
   316→        }
   317→
   318→        // Validate origin
   319→        const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   320→        if (!validOrigins.includes(options.origin as SkillOrigin)) {
   321→          error(
   322→            `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   323→          );
   324→          process.exit(EXIT_CODES.ERROR);
   325→        }
   326→
   327→        // Check if skill with this ID already exists
   328→        const metaCtx = await loadMetaContext(ctx);
   329→        const existingSkill = metaCtx.skills.find((s) => s.id === options.id);
   330→        if (existingSkill) {
   331→          error(`Skill with ID '${options.id}' already exists`);
   332→          process.exit(EXIT_CODES.CONFLICT);
   333→        }
   334→
   335→        // Build skill object (schema provides defaults for platforms, depends_on, tags)
   336→        const skillData = {
   337→          _ulid: ulid(),
   338→          id: options.id,
   339→          name: options.name,
   340→          description: options.description,
   341→          origin: options.origin as SkillOrigin,
   342→          version: options.skillVersion,
   343→          ...(options.platform && options.platform.length > 0 && { platforms: options.platform }),
   344→          ...(options.dependsOn && options.dependsOn.length > 0 && { depends_on: options.dependsOn }),
   345→          allowed_tools: [],
   346→          ...(options.tag && options.tag.length > 0 && { tags: parseTagsArray(options.tag) }),
   347→        };
   348→
   349→        // Validate with schema
   350→        const parsed = SkillSchema.safeParse(skillData);
   351→        if (!parsed.success) {
   352→          const issues = parsed.error.issues
   353→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   354→            .join("; ");
   355→          error(`Invalid skill data: ${issues}`);
   356→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   357→        }
   358→
   359→        const skill: LoadedSkill = { ...parsed.data };
   360→
   361→        // AC: @skill-cli ac-3 - save meta entry (also creates directory per ac-4)
   362→        await saveMetaItem(ctx, skill, "skill");
   363→
   364→        // AC: @skill-cli ac-4 - create SKILL.md with placeholder content
   365→        // AC: @skill-add ac-3 - if --content-file provided, copy its contents
   366→        const skillMdPath = getSkillContentPath(ctx, skill.id);
   367→        let initialContent: string;
   368→
   369→        if (options.contentFile) {
   370→          // Read content from the specified file
   371→          const contentFilePath = path.isAbsolute(options.contentFile)
   372→            ? options.contentFile
   373→            : path.resolve(process.cwd(), options.contentFile);
   374→
   375→          try {
   376→            initialContent = await fs.readFile(contentFilePath, "utf-8");
   377→          } catch (err) {
   378→            // Clean up: remove the skill we just created
   379→            await deleteMetaItem(ctx, skill._ulid, "skill");
   380→            error(`Failed to read content file: ${contentFilePath}`);
   381→            process.exit(EXIT_CODES.ERROR);
   382→          }
   383→        } else {
   384→          initialContent = `# ${skill.name}\n\n${skill.description || "Add skill content here."}\n`;
   385→        }
   386→
   387→        await fs.writeFile(skillMdPath, initialContent, "utf-8");
   388→
   389→        // Commit changes
   390→        await commitIfShadow(ctx.shadow, "skill-add", skill.id, skill.name);
   391→
   392→        output(skill, () =>
   393→          success(`Created skill: ${skill.id}`, { skill }),
   394→        );
   395→      } catch (err) {
   396→        error("Failed to create skill", err);
   397→        process.exit(EXIT_CODES.ERROR);
   398→      }
   399→    });
   400→
   401→  // AC: @skill-cli ac-5, ac-6 - kspec skill get
   402→  skill
   403→    .command("get <ref>")
   404→    .description("Show skill details")
   405→    .action(async (ref: string) => {
   406→      try {
   407→        const ctx = await initContext();
   408→
   409→        if (!ctx.manifestPath) {
   410→          error(errors.project.noKspecProject);
   411→          process.exit(EXIT_CODES.ERROR);
   412→        }
   413→
   414→        const metaCtx = await loadMetaContext(ctx);
   415→        const item = findMetaItemByRef(metaCtx, ref);
   416→
   417→        if (!item) {
   418→          error(`Skill not found: ${ref}`);
   419→          console.log(chalk.gray("Try: kspec skill list"));
   420→          process.exit(EXIT_CODES.NOT_FOUND);
   421→        }
   422→
   423→        // Check it's a skill (uses _type discriminant)
   424→        if (!isSkill(item)) {
   425→          error(`Item ${ref} is not a skill`);
   426→          process.exit(EXIT_CODES.ERROR);
   427→        }
   428→
   429→        const skill = item as LoadedSkill;
   430→
   431→        // AC: @skill-cli ac-6 - load SKILL.md content
   432→        const content = await loadSkillContent(ctx, skill);
   433→        const docs = await loadSkillDocs(ctx, skill);
   434→
   435→        // AC: @skill-cli ac-5, ac-6 - output metadata and content
   436→        // Include extended skill schema fields (license, compatibility, allowed_tools, metadata, platform_config)
   437→        output(
   438→          {
   439→            _ulid: skill._ulid,
   440→            id: skill.id,
   441→            name: skill.name,
   442→            description: skill.description,
   443→            origin: skill.origin,
   444→            version: skill.version,
   445→            platforms: skill.platforms,
   446→            depends_on: skill.depends_on,
   447→            tags: skill.tags,
   448→            // Extended fields from @extended-skill-schema
   449→            license: skill.license,
   450→            compatibility: skill.compatibility,
   451→            allowed_tools: skill.allowed_tools,
   452→            metadata: skill.metadata,
   453→            platform_config: skill.platform_config,
   454→            content,
   455→            docs: docs.map((d) => ({ name: d.name, path: d.path })),
   456→          },
   457→          () => formatSkillDetails(skill, content),
   458→        );
   459→      } catch (err) {
   460→        error("Failed to get skill", err);
   461→        process.exit(EXIT_CODES.ERROR);
   462→      }
   463→    });
   464→
   465→  // AC: @skill-set ac-1, ac-2, ac-3 - kspec skill set
   466→  markMutating(skill.command("set <ref>"))
   467→    .description("Update skill metadata fields")
   468→    .option("--name <name>", "Update skill name")
   469→    .option("--description <desc>", "Update skill description")
   470→    .option("--origin <origin>", "Update skill origin (core, project, local)")
   471→    .option("--skill-version <version>", "Update skill version")
   472→    .option("--add-platform <platform>", "Add a platform to the platforms array")
   473→    .option("--remove-platform <platform>", "Remove a platform from the platforms array")
   474→    .option("--add-tag <tag>", "Add a tag to the tags array")
   475→    .option("--remove-tag <tag>", "Remove a tag from the tags array")
   476→    .option("--add-depends-on <ref>", "Add a dependency reference")
   477→    .option("--remove-depends-on <ref>", "Remove a dependency reference")
   478→    .option(
   479→      "--platform-config <config>",
   480→      "Set platform config (format: platform.key=value, e.g., claude_code.user_invocable=false)",
   481→      (value: string, previous: string[]) => {
   482→        // Collect multiple --platform-config options
   483→        return previous.concat([value]);
   484→      },
   485→      [] as string[],
   486→    )
   487→    .action(async (ref: string, options) => {
   488→      try {
   489→        const ctx = await initContext();
   490→
   491→        if (!ctx.manifestPath) {
   492→          error(errors.project.noKspecProject);
   493→          process.exit(EXIT_CODES.ERROR);
   494→        }
   495→
   496→        const metaCtx = await loadMetaContext(ctx);
   497→        const item = findMetaItemByRef(metaCtx, ref);
   498→
   499→        if (!item) {
   500→          error(`Skill not found: ${ref}`);
   501→          console.log(chalk.gray("Try: kspec skill list"));
   502→          process.exit(EXIT_CODES.NOT_FOUND);
   503→        }
   504→
   505→        // Check it's a skill (uses _type discriminant)
   506→        if (!isSkill(item)) {
   507→          error(`Item ${ref} is not a skill`);
   508→          process.exit(EXIT_CODES.ERROR);
   509→        }
   510→
   511→        // Clone before mutating to protect against partial save failure
   512→        const skill = structuredClone(item) as LoadedSkill;
   513→
   514→        // AC: @skill-set ac-1 - update description field
   515→        if (options.name !== undefined) {
   516→          skill.name = options.name;
   517→        }
   518→
   519→        if (options.description !== undefined) {
   520→          skill.description = options.description;
   521→        }
   522→
   523→        // Update origin
   524→        if (options.origin !== undefined) {
   525→          const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   526→          if (!validOrigins.includes(options.origin as SkillOrigin)) {
   527→            error(
   528→              `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   529→            );
   530→            process.exit(EXIT_CODES.ERROR);
   531→          }
   532→          skill.origin = options.origin as SkillOrigin;
   533→        }
   534→
   535→        // Update version
   536→        if (options.skillVersion !== undefined) {
   537→          skill.version = options.skillVersion;
   538→        }
   539→
   540→        // AC: @skill-set ac-2 - add platform to array
   541→        if (options.addPlatform) {
   542→          if (!skill.platforms.includes(options.addPlatform)) {
   543→            skill.platforms.push(options.addPlatform);
   544→          }
   545→        }
   546→
   547→        // Remove platform
   548→        if (options.removePlatform) {
   549→          const idx = skill.platforms.indexOf(options.removePlatform);
   550→          if (idx >= 0) {
   551→            skill.platforms.splice(idx, 1);
   552→          }
   553→        }
   554→
   555→        // AC: @skill-set ac-3 - add tag to array
   556→        if (options.addTag) {
   557→          if (!skill.tags) {
   558→            skill.tags = [];
   559→          }
   560→          if (!skill.tags.includes(options.addTag)) {
   561→            skill.tags.push(options.addTag);
   562→          }
   563→        }
   564→
   565→        // Remove tag
   566→        if (options.removeTag && skill.tags) {
   567→          const idx = skill.tags.indexOf(options.removeTag);
   568→          if (idx >= 0) {
   569→            skill.tags.splice(idx, 1);
   570→          }
   571→        }
   572→
   573→        // Add dependency
   574→        if (options.addDependsOn) {
   575→          if (!skill.depends_on) {
   576→            skill.depends_on = [];
   577→          }
   578→          if (!skill.depends_on.includes(options.addDependsOn)) {
   579→            skill.depends_on.push(options.addDependsOn);
   580→          }
   581→        }
   582→
   583→        // Remove dependency
   584→        if (options.removeDependsOn && skill.depends_on) {
   585→          const idx = skill.depends_on.indexOf(options.removeDependsOn);
   586→          if (idx >= 0) {
   587→            skill.depends_on.splice(idx, 1);
   588→          }
   589→        }
   590→
   591→        // AC: @skill-platform-config-cli ac-1, ac-2 - Handle platform config updates
   592→        if (options.platformConfig && options.platformConfig.length > 0) {
   593→          // Initialize platform_config if not present
   594→          if (!skill.platform_config) {
   595→            skill.platform_config = {};
   596→          }
   597→
   598→          for (const configStr of options.platformConfig as string[]) {
   599→            // Parse "platform.key=value" format
   600→            const match = configStr.match(/^([^.]+)\.([^=]+)=(.*)$/);
   601→            if (!match) {
   602→              error(
   603→                `Invalid platform config format: ${configStr}\n` +
   604→                  `Expected format: platform.key=value (e.g., claude_code.user_invocable=false)`,
   605→              );
   606→              process.exit(EXIT_CODES.VALIDATION_FAILED);
   607→            }
   608→
   609→            const [, platform, key, rawValue] = match;
   610→
   611→            // Parse value type: "true"/"false" → boolean, otherwise string
   612→            let value: boolean | string;
   613→            if (rawValue === "true") {
   614→              value = true;
   615→            } else if (rawValue === "false") {
   616→              value = false;
   617→            } else {
   618→              // Remove surrounding quotes if present
   619→              value = rawValue.replace(/^["']|["']$/g, "");
   620→            }
   621→
   622→            // Deep merge: initialize platform object if needed
   623→            if (!(platform in skill.platform_config)) {
   624→              (skill.platform_config as Record<string, Record<string, unknown>>)[
   625→                platform
   626→              ] = {};
   627→            }
   628→
   629→            // Set the value
   630→            (
   631→              skill.platform_config as Record<string, Record<string, unknown>>
   632→            )[platform][key] = value;
   633→          }
   634→        }
   635→
   636→        // Validate updated skill
   637→        // AC: @skill-platform-config-cli ac-4 - validation error with guidance on valid keys
   638→        const parsed = SkillSchema.safeParse(skill);
   639→        if (!parsed.success) {
   640→          const issues = parsed.error.issues
   641→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   642→            .join("; ");
   643→
   644→          // Check if any errors are related to platform_config and provide guidance
   645→          const hasPlatformConfigError = parsed.error.issues.some(
   646→            (i) => i.path[0] === "platform_config",
   647→          );
   648→
   649→          let errorMsg = `Invalid skill data: ${issues}`;
   650→          if (hasPlatformConfigError) {
   651→            // Get valid keys from schemas
   652→            const claudeCodeKeys = Object.keys(ClaudeCodeConfigSchema.shape).join(
   653→              ", ",
   654→            );
   655→            const codexKeys = Object.keys(CodexConfigSchema.shape).join(", ");
   656→            errorMsg +=
   657→              `\n\nValid platform config keys:` +
   658→              `\n  claude_code: ${claudeCodeKeys}` +
   659→              `\n  codex: ${codexKeys}`;
   660→          }
   661→
   662→          error(errorMsg);
   663→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   664→        }
   665→
   666→        // Save the updated skill
   667→        await saveMetaItem(ctx, skill, "skill");
   668→
   669→        // Commit changes
   670→        await commitIfShadow(ctx.shadow, "skill-set", skill.id, skill.name);
   671→
   672→        output(skill, () => success(`Updated skill: ${skill.id}`));
   673→      } catch (err) {
   674→        error("Failed to update skill", err);
   675→        process.exit(EXIT_CODES.ERROR);
   676→      }
   677→    });
   678→
   679→  // AC: @skill-cli ac-7, ac-8 - kspec skill delete
   680→  markMutating(skill.command("delete <ref>"))
   681→    .description("Delete a skill")
   682→    .option("--confirm", "Skip confirmation prompt")
   683→    .action(async (ref: string, options) => {
   684→      try {
   685→        const ctx = await initContext();
   686→
   687→        if (!ctx.manifestPath) {
   688→          error(errors.project.noKspecProject);
   689→          process.exit(EXIT_CODES.ERROR);
   690→        }
   691→
   692→        const metaCtx = await loadMetaContext(ctx);
   693→        const item = findMetaItemByRef(metaCtx, ref);
   694→
   695→        if (!item) {
   696→          error(`Skill not found: ${ref}`);
   697→          console.log(chalk.gray("Try: kspec skill list"));
   698→          process.exit(EXIT_CODES.NOT_FOUND);
   699→        }
   700→
   701→        // Check it's a skill (uses _type discriminant)
   702→        if (!isSkill(item)) {
   703→          error(`Item ${ref} is not a skill`);
   704→          process.exit(EXIT_CODES.ERROR);
   705→        }
   706→
   707→        const skill = item as LoadedSkill;
   708→
   709→        // Check for confirmation
   710→        if (!options.confirm) {
   711→          error(`Confirm deletion of skill '${skill.id}' with --confirm flag`);
   712→          process.exit(EXIT_CODES.ERROR);
   713→        }
   714→
   715→        // Check for dependencies from other skills
   716→        const dependentSkills = metaCtx.skills.filter(
   717→          (s) =>
   718→            s._ulid !== skill._ulid &&
   719→            s.depends_on?.some(
   720→              (dep) =>
   721→                dep === `@${skill.id}` ||
   722→                dep === skill.id ||
   723→                dep.startsWith(`@${skill._ulid.substring(0, 8)}`),
   724→            ),
   725→        );
   726→
   727→        if (dependentSkills.length > 0) {
   728→          const depRefs = dependentSkills.map((s) => `@${s.id}`).join(", ");
   729→          error(
   730→            `Cannot delete skill '${skill.id}': referenced by ${dependentSkills.length} skill(s): ${depRefs}`,
   731→          );
   732→          process.exit(EXIT_CODES.ERROR);
   733→        }
   734→
   735→        // AC: @skill-cli ac-7, ac-8 - delete meta entry and directory
   736→        const deleted = await deleteMetaItem(ctx, skill._ulid, "skill");
   737→
   738→        if (!deleted) {
   739→          error(`Failed to delete skill: ${skill.id}`);
   740→          process.exit(EXIT_CODES.ERROR);
   741→        }
   742→
   743→        // Commit changes
   744→        await commitIfShadow(ctx.shadow, "skill-delete", skill.id);
   745→
   746→        success(`Deleted skill: ${skill.id}`);
   747→      } catch (err) {
   748→        error("Failed to delete skill", err);
   749→        process.exit(EXIT_CODES.ERROR);
   750→      }
   751→    });
   752→
   753→  // AC: @skill-import ac-1 through ac-7 - kspec skill import
   754→  // AC: @import-frontmatter-strip ac-1 through ac-6 - Extended frontmatter parsing
   755→  markMutating(skill.command("import <file>"))
   756→    .description("Import an existing SKILL.md file into kspec")
   757→    .option("--id <id>", "Custom skill ID (defaults to directory name)")
   758→    .option("--name <name>", "Skill name (required if no frontmatter)")
   759→    .option("--description <desc>", "Skill description (required if no frontmatter)")
   760→    .option(
   761→      "--origin <origin>",
   762→      "Skill origin (core, project, local)",
   763→      "project",
   764→    )
   765→    .option("--skill-version <version>", "Skill version")
   766→    .action(async (file: string, options) => {
   767→      try {
   768→        const ctx = await initContext();
   769→
   770→        if (!ctx.manifestPath) {
   771→          error(errors.project.noKspecProject);
   772→          process.exit(EXIT_CODES.ERROR);
   773→        }
   774→
   775→        // Resolve file path
   776→        const filePath = path.isAbsolute(file)
   777→          ? file
   778→          : path.resolve(process.cwd(), file);
   779→
   780→        // Check file exists
   781→        try {
   782→          await fs.access(filePath);
   783→        } catch {
   784→          error(`File not found: ${filePath}`);
   785→          process.exit(EXIT_CODES.NOT_FOUND);
   786→        }
   787→
   788→        // Read file content
   789→        const content = await fs.readFile(filePath, "utf-8");
   790→
   791→        // AC: @skill-import ac-1, ac-6 - Parse YAML frontmatter
   792→        // AC: @import-frontmatter-strip ac-1, ac-3 - Parse all Agent Skills fields
   793→        const frontmatter = parseFrontmatter(content);
   794→
   795→        // Determine name and description from frontmatter or options
   796→        // AC: @import-frontmatter-strip ac-6 - CLI flags work when no frontmatter
   797→        const skillName = options.name || frontmatter?.name;
   798→        const skillDescription = options.description || frontmatter?.description;
   799→
   800→        // AC: @skill-import ac-6, @import-frontmatter-strip ac-6 - Error if no name/description and no frontmatter
   801→        if (!skillName) {
   802→          error("Name is required. Either add YAML frontmatter with 'name' field or use --name option.");
   803→          console.log(chalk.gray("Example frontmatter:\n---\nname: my-skill\ndescription: My skill description\n---"));
   804→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   805→        }
   806→
   807→        if (!skillDescription) {
   808→          error("Description is required. Either add YAML frontmatter with 'description' field or use --description option.");
   809→          console.log(chalk.gray("Example frontmatter:\n---\nname: my-skill\ndescription: My skill description\n---"));
   810→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   811→        }
   812→
   813→        // AC: @skill-import ac-5 - Derive ID from directory name or use custom
   814→        const sourceDir = path.dirname(filePath);
   815→        const derivedId = path.basename(sourceDir);
   816→        const skillId = options.id || derivedId;
   817→
   818→        // Validate origin
   819→        const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   820→        if (!validOrigins.includes(options.origin as SkillOrigin)) {
   821→          error(
   822→            `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   823→          );
   824→          process.exit(EXIT_CODES.ERROR);
   825→        }
   826→
   827→        // Check if skill with this ID already exists
   828→        const metaCtx = await loadMetaContext(ctx);
   829→        const existingSkill = metaCtx.skills.find((s) => s.id === skillId);
   830→        if (existingSkill) {
   831→          error(`Skill with ID '${skillId}' already exists. Use --id to specify a different ID.`);
   832→          process.exit(EXIT_CODES.CONFLICT);
   833→        }
   834→
   835→        // AC: @import-frontmatter-strip ac-3 - Build platform_config.claude_code from frontmatter
   836→        let platformConfig: PlatformConfig | undefined;
   837→        if (frontmatter) {
   838→          const claudeCodeConfig: import("../../schema/index.js").ClaudeCodeConfig = {};
   839→          if (frontmatter.user_invocable !== undefined) {
   840→            claudeCodeConfig.user_invocable = frontmatter.user_invocable;
   841→          }
   842→          if (frontmatter.disable_model_invocation !== undefined) {
   843→            claudeCodeConfig.disable_model_invocation = frontmatter.disable_model_invocation;
   844→          }
   845→          if (frontmatter.context !== undefined) {
   846→            claudeCodeConfig.context = frontmatter.context;
   847→          }
   848→          if (frontmatter.agent !== undefined) {
   849→            claudeCodeConfig.agent = frontmatter.agent;
   850→          }
   851→          if (frontmatter.model !== undefined) {
   852→            claudeCodeConfig.model = frontmatter.model;
   853→          }
   854→          if (frontmatter.argument_hint !== undefined) {
   855→            claudeCodeConfig.argument_hint = frontmatter.argument_hint;
   856→          }
   857→
   858→          // Only set platform_config if we have Claude Code config fields
   859→          if (Object.keys(claudeCodeConfig).length > 0) {
   860→            platformConfig = { claude_code: claudeCodeConfig };
   861→          }
   862→        }
   863→
   864→        // Build skill object
   865→        // AC: @import-frontmatter-strip ac-1 - All recognized fields populate meta.yaml
   866→        // Schema provides defaults for platforms, depends_on, tags
   867→        const skillData = {
   868→          _ulid: ulid(),
   869→          id: skillId,
   870→          name: skillName,
   871→          description: skillDescription,
   872→          origin: options.origin as SkillOrigin,
   873→          version: options.skillVersion,
   874→          // AC: @import-frontmatter-strip ac-1 - license, compatibility, allowed_tools from frontmatter
   875→          license: frontmatter?.license,
   876→          compatibility: frontmatter?.compatibility,
   877→          allowed_tools: frontmatter?.allowed_tools || [],
   878→          // AC: @import-frontmatter-strip ac-3 - platform_config.claude_code from frontmatter
   879→          platform_config: platformConfig,
   880→        };
   881→
   882→        // Validate with schema
   883→        const parsed = SkillSchema.safeParse(skillData);
   884→        if (!parsed.success) {
   885→          const issues = parsed.error.issues
   886→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   887→            .join("; ");
   888→          error(`Invalid skill data: ${issues}`);
   889→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   890→        }
   891→
   892→        const skill: LoadedSkill = { ...parsed.data };
   893→
   894→        // Save meta entry (also creates directory)
   895→        await saveMetaItem(ctx, skill, "skill");
   896→
   897→        // AC: @skill-import ac-7 - Strip/normalize base-directory paths
   898→        // AC: @import-frontmatter-strip ac-2 - Store body-only content (strip frontmatter)
   899→        const normalizedContent = normalizeBaseDirectory(content);
   900→        const bodyOnlyContent = stripFrontmatter(normalizedContent);
   901→
   902→        // AC: @skill-import ac-2 - Copy content to .kspec/skills/<id>/SKILL.md
   903→        const skillMdPath = getSkillContentPath(ctx, skill.id);
   904→        await fs.writeFile(skillMdPath, bodyOnlyContent, "utf-8");
   905→
   906→        // AC: @import-frontmatter-strip ac-4, ac-5 - Copy all supporting directories
   907→        const supportingDirs = ["references", "scripts", "assets", "docs"];
   908→        for (const dirName of supportingDirs) {
   909→          const sourceSubDir = path.join(sourceDir, dirName);
   910→          try {
   911→            const stats = await fs.stat(sourceSubDir);
   912→            if (stats.isDirectory()) {
   913→              const targetSubDir = path.join(ctx.specDir, "skills", skill.id, dirName);
   914→              await fs.mkdir(targetSubDir, { recursive: true });
   915→              await copyDirectory(sourceSubDir, targetSubDir);
   916→            }
   917→          } catch {
   918→            // Directory doesn't exist, that's fine
   919→          }
   920→        }
   921→
   922→        // Commit changes
   923→        await commitIfShadow(ctx.shadow, "skill-import", skill.id, skill.name);
   924→
   925→        output(skill, () =>
   926→          success(`Imported skill: ${skill.id}`, { skill }),
   927→        );
   928→      } catch (err) {
   929→        error("Failed to import skill", err);
   930→        process.exit(EXIT_CODES.ERROR);
   931→      }
   932→    });
   933→}
   934→