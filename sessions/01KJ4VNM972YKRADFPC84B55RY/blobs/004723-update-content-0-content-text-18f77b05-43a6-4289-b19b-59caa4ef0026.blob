```
     1→/**
     2→ * Enhanced setup command for kspec agent integration.
     3→ *
     4→ * Orchestrates the full onboarding pipeline:
     5→ * - Detect agent environment (Claude Code, Cline, etc.)
     6→ * - Install hooks (UserPromptSubmit, Stop, PreToolUse guards)
     7→ * - Render skills from .kspec/skills/ to .claude/skills/
     8→ * - Generate kspec-agents.md
     9→ *
    10→ * AC: @enhanced-setup ac-1 - summary displayed listing each step performed
    11→ * AC: @enhanced-setup ac-2 - all hook entries (UserPromptSubmit, Stop, PreToolUse) present
    12→ * AC: @enhanced-setup ac-3 - rendered skill files exist for each skill targeting claude-code
    13→ * AC: @enhanced-setup ac-4 - kspec-agents.md exists after setup
    14→ * AC: @enhanced-setup ac-5 - --skip-skills flag skips skill rendering
    15→ * AC: @enhanced-setup ac-6 - --dry-run displays planned actions without changes
    16→ * AC: @enhanced-setup ac-7 - --status reports current state including agent detected
    17→ * AC: @enhanced-setup ac-8 - --status shows hooks status, skills rendered count, agents.md freshness
    18→ * AC: @enhanced-setup ac-9 - skills referenced by ralph (task-work, reflect) are present
    19→ */
    20→
    21→import * as fs from "node:fs/promises";
    22→import * as os from "node:os";
    23→import * as path from "node:path";
    24→import * as readline from "node:readline/promises";
    25→import chalk from "chalk";
    26→import type { Command } from "commander";
    27→import {
    28→  getGitRoot,
    29→  getShadowStatus,
    30→  repairShadow,
    31→  SHADOW_BRANCH_NAME,
    32→} from "../../parser/shadow.js";
    33→import { errors } from "../../strings/index.js";
    34→import { EXIT_CODES } from "../exit-codes.js";
    35→import { error, output, success, warn } from "../output.js";
    36→
    37→/**
    38→ * Log a message at debug level (only when KSPEC_DEBUG=1)
    39→ * AC: @setup-pipeline-unification ac-4
    40→ */
    41→function debugLog(message: string, detail?: unknown): void {
    42→  if (process.env.KSPEC_DEBUG === "1") {
    43→    if (detail) {
    44→      console.error(`[DEBUG] setup: ${message}`, detail);
    45→    } else {
    46→      console.error(`[DEBUG] setup: ${message}`);
    47→    }
    48→  }
    49→}
    50→
    51→/**
    52→ * Supported agent types for auto-configuration
    53→ */
    54→export type AgentType =
    55→  | "claude-code"
    56→  | "cline"
    57→  | "roo-code"
    58→  | "copilot-cli"
    59→  | "gemini-cli"
    60→  | "codex-cli"
    61→  | "aider"
    62→  | "opencode"
    63→  | "amp"
    64→  | "unknown";
    65→
    66→/**
    67→ * Result of agent detection
    68→ */
    69→export interface DetectedAgent {
    70→  type: AgentType;
    71→  confidence: "high" | "medium" | "low";
    72→  configPath?: string;
    73→  envVars?: Record<string, string>;
    74→}
    75→
    76→/**
    77→ * Detect which agent environment we're running in.
    78→ * Returns the detected agent type and confidence level.
    79→ *
    80→ * Detection priority matters - more specific markers checked first.
    81→ */
    82→export function detectAgent(): DetectedAgent {
    83→  // Claude Code: Multiple possible markers
    84→  // CLAUDECODE=1 is set in CLI sessions
    85→  // CLAUDE_CODE_ENTRYPOINT indicates entry point (cli, etc.)
    86→  // CLAUDE_PROJECT_DIR is set in some contexts
    87→  if (
    88→    process.env.CLAUDECODE === "1" ||
    89→    process.env.CLAUDE_CODE_ENTRYPOINT ||
    90→    process.env.CLAUDE_PROJECT_DIR
    91→  ) {
    92→    return {
    93→      type: "claude-code",
    94→      confidence: "high",
    95→      configPath: path.join(os.homedir(), ".claude", "settings.json"),
    96→      envVars: {
    97→        ...(process.env.CLAUDECODE && { CLAUDECODE: process.env.CLAUDECODE }),
    98→        ...(process.env.CLAUDE_CODE_ENTRYPOINT && {
    99→          CLAUDE_CODE_ENTRYPOINT: process.env.CLAUDE_CODE_ENTRYPOINT,
   100→        }),
   101→        ...(process.env.CLAUDE_PROJECT_DIR && {
   102→          CLAUDE_PROJECT_DIR: process.env.CLAUDE_PROJECT_DIR,
   103→        }),
   104→      },
   105→    };
   106→  }
   107→
   108→  // Cline: CLINE_ACTIVE is set when running in Cline terminal
   109→  if (process.env.CLINE_ACTIVE) {
   110→    return {
   111→      type: "cline",
   112→      confidence: "high",
   113→      // Cline uses VS Code settings, but env vars should be in shell profile
   114→      configPath: undefined,
   115→      envVars: { CLINE_ACTIVE: process.env.CLINE_ACTIVE },
   116→    };
   117→  }
   118→
   119→  // GitHub Copilot CLI: Check for copilot-specific markers
   120→  if (process.env.COPILOT_MODEL || process.env.GH_TOKEN) {
   121→    return {
   122→      type: "copilot-cli",
   123→      confidence: "medium",
   124→      configPath: path.join(os.homedir(), ".copilot", "config.json"),
   125→    };
   126→  }
   127→
   128→  // Aider: Check for AIDER_* env vars
   129→  if (process.env.AIDER_MODEL || process.env.AIDER_DARK_MODE !== undefined) {
   130→    return {
   131→      type: "aider",
   132→      confidence: "high",
   133→      configPath: path.join(os.homedir(), ".aider.conf.yml"),
   134→    };
   135→  }
   136→
   137→  // OpenCode: Check for OPENCODE_* env vars
   138→  if (process.env.OPENCODE_CONFIG_DIR || process.env.OPENCODE_CONFIG) {
   139→    return {
   140→      type: "opencode",
   141→      confidence: "high",
   142→      configPath:
   143→        process.env.OPENCODE_CONFIG ||
   144→        path.join(os.homedir(), ".config", "opencode", "opencode.json"),
   145→    };
   146→  }
   147→
   148→  // Gemini CLI: GEMINI_CLI=1 is set when running in Gemini CLI
   149→  if (process.env.GEMINI_CLI === "1") {
   150→    return {
   151→      type: "gemini-cli",
   152→      confidence: "high",
   153→      configPath: path.join(os.homedir(), ".gemini", "settings.json"),
   154→      envVars: { GEMINI_CLI: "1" },
   155→    };
   156→  }
   157→
   158→  // Codex CLI: CODEX_SANDBOX is set when running in sandbox
   159→  if (process.env.CODEX_SANDBOX) {
   160→    return {
   161→      type: "codex-cli",
   162→      confidence: "high",
   163→      configPath: path.join(os.homedir(), ".codex", "config.toml"),
   164→      envVars: { CODEX_SANDBOX: process.env.CODEX_SANDBOX },
   165→    };
   166→  }
   167→
   168→  // Amp (Sourcegraph): Check for AMP_API_KEY or AMP_TOOLBOX
   169→  if (process.env.AMP_API_KEY || process.env.AMP_TOOLBOX) {
   170→    return {
   171→      type: "amp",
   172→      confidence: "medium",
   173→      configPath: path.join(os.homedir(), ".config", "amp", "settings.json"),
   174→    };
   175→  }
   176→
   177→  return {
   178→    type: "unknown",
   179→    confidence: "low",
   180→  };
   181→}
   182→
   183→/**
   184→ * Install KSPEC_AUTHOR config for Claude Code (global settings)
   185→ */
   186→async function installClaudeCodeConfig(author: string): Promise<boolean> {
   187→  const configPath = path.join(os.homedir(), ".claude", "settings.json");
   188→  const configDir = path.dirname(configPath);
   189→
   190→  try {
   191→    // Ensure directory exists
   192→    await fs.mkdir(configDir, { recursive: true });
   193→
   194→    // Read existing config or start fresh
   195→    let config: Record<string, unknown> = {};
   196→    try {
   197→      const existing = await fs.readFile(configPath, "utf-8");
   198→      config = JSON.parse(existing);
   199→    } catch (err) {
   200→      debugLog("No existing Claude Code config, starting fresh", err);
   201→    }
   202→
   203→    // Merge env settings
   204→    const env = (config.env as Record<string, string>) || {};
   205→    env.KSPEC_AUTHOR = author;
   206→    config.env = env;
   207→
   208→    // Write back
   209→    await fs.writeFile(
   210→      configPath,
   211→      `${JSON.stringify(config, null, 2)}\n`,
   212→      "utf-8",
   213→    );
   214→    return true;
   215→  } catch (err) {
   216→    debugLog("Failed to install Claude Code config", err);
   217→    return false;
   218→  }
   219→}
   220→
   221→/**
   222→ * Result of installing hooks
   223→ * AC: @enhanced-setup ac-2 - tracks all hook types
   224→ */
   225→export interface HooksInstallResult {
   226→  promptCheck: boolean;
   227→  stop: boolean;
   228→  preToolUse: boolean;
   229→  guardsCreated: string[];
   230→}
   231→
   232→/**
   233→ * PreToolUse guard hook scripts
   234→ * These are the shell scripts that will be installed to .claude/hooks/
   235→ */
   236→const GUARD_SCRIPTS: Record<string, string> = {
   237→  "kspec-worktree-guard.sh": `#!/bin/bash
   238→# Guard against dangerous git operations in .kspec worktree
   239→#
   240→# This hook prevents accidentally creating branches or switching
   241→# branches in the .kspec worktree, which should always stay on kspec-meta.
   242→
   243→# Read the tool input from stdin
   244→INPUT=$(cat)
   245→
   246→# Extract the command from the JSON input
   247→COMMAND=$(echo "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null)
   248→
   249→# If no command, allow (not a Bash tool call)
   250→if [ -z "$COMMAND" ]; then
   251→  echo '{"decision": "allow"}'
   252→  exit 0
   253→fi
   254→
   255→# Two views of the command for safe matching:
   256→# 1. UNQUOTED: remove quote chars (keeps content) to catch split-quote
   257→#    bypasses like: git "reset" --hard → git reset --hard
   258→# 2. STRIPPED: remove entire quoted strings to ignore patterns in args
   259→#    like: echo "git reset" → echo
   260→UNQUOTED=$(echo "$COMMAND" | sed 's/["\\x27]//g')
   261→STRIPPED=$(echo "$COMMAND" | sed -e "s/\\x27[^\\x27]*\\x27//g" -e 's/"[^"]*"//g')
   262→# First command word (handles leading whitespace)
   263→FIRST_CMD=$(echo "$COMMAND" | sed 's/^[[:space:]]*//' | cut -d' ' -f1)
   264→
   265→# Block deleting kspec-meta from anywhere (check unquoted to catch bypasses)
   266→if [[ "$UNQUOTED" == *"git branch -d kspec-meta"* || "$UNQUOTED" == *"git branch -D kspec-meta"* ]]; then
   267→  cat <<EOF
   268→{
   269→  "decision": "block",
   270→  "reason": "[kspec-worktree-guard] BLOCKED: Cannot delete kspec-meta branch. This is the main branch for the .kspec worktree."
   271→}
   272→EOF
   273→  exit 0
   274→fi
   275→
   276→# Get cwd from hook input (not pwd - hook runs in different context)
   277→CWD=$(echo "$INPUT" | jq -r '.cwd // empty' 2>/dev/null)
   278→IN_KSPEC=false
   279→
   280→if [[ "$CWD" == *"/.kspec"* || "$CWD" == *"/.kspec" ]]; then
   281→  IN_KSPEC=true
   282→fi
   283→
   284→# Also check if command contains cd to .kspec
   285→if [[ "$COMMAND" == *"cd "*".kspec"* || "$COMMAND" == *"cd .kspec"* ]]; then
   286→  IN_KSPEC=true
   287→fi
   288→
   289→if [ "$IN_KSPEC" = false ]; then
   290→  echo '{"decision": "allow"}'
   291→  exit 0
   292→fi
   293→
   294→# Dangerous patterns in .kspec (branch creation/modification/history rewriting)
   295→# Note: "git checkout kspec-meta" is safe and allowed
   296→DANGEROUS_PATTERNS=(
   297→  # Branch creation
   298→  "git checkout -b"
   299→  "git checkout -B"
   300→  "git branch -c"
   301→  "git branch -C"
   302→  "git branch -m"
   303→  "git branch -M"
   304→  "git switch -c"
   305→  "git switch -C"
   306→  "git switch --create"
   307→  # History rewriting - these can cause conflicts with active sessions
   308→  "git reset"
   309→  "git rebase"
   310→  "git cherry-pick"
   311→  "git commit --amend"
   312→  # Force push
   313→  "git push --force"
   314→  "git push -f"
   315→  # Discarding changes
   316→  "git stash"
   317→  "git clean"
   318→  "git checkout -- "
   319→  "git restore"
   320→)
   321→
   322→for pattern in "\${DANGEROUS_PATTERNS[@]}"; do
   323→  # Block if:
   324→  # - Pattern matches UNQUOTED AND first command is "git" (catches split-quote bypasses), OR
   325→  # - Pattern matches STRIPPED (actual command outside any quotes)
   326→  # This allows: echo "git reset", grep "git stash" (first cmd is echo/grep, pattern not in STRIPPED)
   327→  # This blocks: git reset, git "reset" --hard, git st'ash' (first cmd is git OR pattern in STRIPPED)
   328→  if [[ "$STRIPPED" == *"$pattern"* ]] || { [[ "$UNQUOTED" == *"$pattern"* ]] && [[ "$FIRST_CMD" == "git" ]]; }; then
   329→    cat <<EOF
   330→{
   331→  "decision": "block",
   332→  "reason": "[kspec-worktree-guard] BLOCKED: Dangerous git operation in .kspec worktree. This worktree contains active session data and must stay on kspec-meta. Operations like reset, rebase, stash, and clean can corrupt session files."
   333→}
   334→EOF
   335→    exit 0
   336→  fi
   337→done
   338→
   339→# Allow all other commands
   340→echo '{"decision": "allow"}'
   341→`,
   342→
   343→  "ralph-task-limit-guard.sh": `#!/bin/bash
   344→# Ralph task limit guard - blocks task start when limit reached
   345→#
   346→# This hook provides hard enforcement of the --max-tasks limit.
   347→# Ralph writes a marker file when the limit is reached; this hook
   348→# blocks 'kspec task start' commands when that marker exists.
   349→
   350→# Marker file location (relative to project root)
   351→MARKER_FILE=".claude/ralph-task-limit.json"
   352→
   353→# Read the tool input from stdin
   354→INPUT=$(cat)
   355→
   356→# Extract the command from the JSON input
   357→COMMAND=$(echo "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null)
   358→
   359→# If no command, allow (not a Bash tool call)
   360→if [ -z "$COMMAND" ]; then
   361→  echo '{"decision": "allow"}'
   362→  exit 0
   363→fi
   364→
   365→# Only check commands that match "kspec task start"
   366→if [[ ! "$COMMAND" =~ kspec[[:space:]]+task[[:space:]]+start ]]; then
   367→  echo '{"decision": "allow"}'
   368→  exit 0
   369→fi
   370→
   371→# Get cwd from hook input to find marker file
   372→CWD=$(echo "$INPUT" | jq -r '.cwd // empty' 2>/dev/null)
   373→if [ -z "$CWD" ]; then
   374→  CWD="$PWD"
   375→fi
   376→
   377→# Find project root by walking up looking for .claude directory
   378→PROJECT_ROOT="$CWD"
   379→while [ "$PROJECT_ROOT" != "/" ]; do
   380→  if [ -d "$PROJECT_ROOT/.claude" ]; then
   381→    break
   382→  fi
   383→  PROJECT_ROOT=$(dirname "$PROJECT_ROOT")
   384→done
   385→
   386→if [ "$PROJECT_ROOT" = "/" ]; then
   387→  # No .claude directory found, allow
   388→  echo '{"decision": "allow"}'
   389→  exit 0
   390→fi
   391→
   392→MARKER_PATH="$PROJECT_ROOT/$MARKER_FILE"
   393→
   394→# Check if marker file exists
   395→if [ ! -f "$MARKER_PATH" ]; then
   396→  echo '{"decision": "allow"}'
   397→  exit 0
   398→fi
   399→
   400→# Read marker file and check if active
   401→ACTIVE=$(jq -r '.active // false' "$MARKER_PATH" 2>/dev/null)
   402→if [ "$ACTIVE" != "true" ]; then
   403→  echo '{"decision": "allow"}'
   404→  exit 0
   405→fi
   406→
   407→# Extract limit info for error message
   408→MAX=$(jq -r '.max // "?"' "$MARKER_PATH" 2>/dev/null)
   409→COMPLETED=$(jq -r '.completed // "?"' "$MARKER_PATH" 2>/dev/null)
   410→
   411→# Block the command
   412→cat <<EOF
   413→{
   414→  "decision": "block",
   415→  "reason": "[ralph-task-limit-guard] BLOCKED: Task limit reached (\${COMPLETED}/\${MAX} tasks completed this iteration). This limit was set by --max-tasks. Please wrap up current work and let the iteration end naturally. Do not attempt to start new tasks."
   416→}
   417→EOF
   418→exit 0
   419→`,
   420→};
   421→
   422→/**
   423→ * Install hooks to project-level Claude Code settings (.claude/settings.json)
   424→ * AC: @enhanced-setup ac-2 - all hook entries present
   425→ */
   426→async function installClaudeCodeHooks(
   427→  projectDir: string,
   428→  dryRun = false,
   429→): Promise<HooksInstallResult> {
   430→  const configPath = path.join(projectDir, ".claude", "settings.json");
   431→  const configDir = path.dirname(configPath);
   432→  const hooksDir = path.join(projectDir, ".claude", "hooks");
   433→
   434→  const result: HooksInstallResult = {
   435→    promptCheck: false,
   436→    stop: false,
   437→    preToolUse: false,
   438→    guardsCreated: [],
   439→  };
   440→
   441→  try {
   442→    // Ensure directories exist
   443→    if (!dryRun) {
   444→      await fs.mkdir(configDir, { recursive: true });
   445→      await fs.mkdir(hooksDir, { recursive: true });
   446→    }
   447→
   448→    // Read existing config or start fresh
   449→    let config: Record<string, unknown> = {};
   450→    try {
   451→      const existing = await fs.readFile(configPath, "utf-8");
   452→      config = JSON.parse(existing);
   453→    } catch (err) {
   454→      debugLog("No existing hooks config, starting fresh", err);
   455→    }
   456→
   457→    // Get or create hooks object
   458→    const hooks = (config.hooks as Record<string, unknown[]>) || {};
   459→
   460→    // Install UserPromptSubmit hook (spec-first reminder)
   461→    const promptCheckCommand = "kspec session prompt-check";
   462→    const existingPromptHooks = hooks.UserPromptSubmit as
   463→      | Array<{ hooks?: Array<{ command?: string }> }>
   464→      | undefined;
   465→    const promptAlreadyInstalled = existingPromptHooks?.some((entry) =>
   466→      entry.hooks?.some((hook) =>
   467→        hook.command?.includes("session prompt-check"),
   468→      ),
   469→    );
   470→
   471→    if (!promptAlreadyInstalled) {
   472→      hooks.UserPromptSubmit = [
   473→        ...(existingPromptHooks || []),
   474→        {
   475→          hooks: [
   476→            {
   477→              type: "command",
   478→              command: promptCheckCommand,
   479→            },
   480→          ],
   481→        },
   482→      ];
   483→      result.promptCheck = true;
   484→    } else {
   485→      result.promptCheck = true; // Already configured
   486→    }
   487→
   488→    // Install Stop hook (checkpoint)
   489→    const stopHookCommand = "kspec session checkpoint --json";
   490→    const existingStopHooks = hooks.Stop as
   491→      | Array<{ matcher?: string; hooks?: Array<{ command?: string }> }>
   492→      | undefined;
   493→    const stopAlreadyInstalled = existingStopHooks?.some((entry) =>
   494→      entry.hooks?.some((hook) => hook.command?.includes("session checkpoint")),
   495→    );
   496→
   497→    if (!stopAlreadyInstalled) {
   498→      hooks.Stop = [
   499→        ...(existingStopHooks || []),
   500→        {
   501→          matcher: "",
   502→          hooks: [
   503→            {
   504→              type: "command",
   505→              command: stopHookCommand,
   506→            },
   507→          ],
   508→        },
   509→      ];
   510→      result.stop = true;
   511→    } else {
   512→      result.stop = true; // Already configured
   513→    }
   514→
   515→    // AC: @enhanced-setup ac-2 - Install PreToolUse hooks with guards
   516→    const existingPreToolUseHooks = hooks.PreToolUse as
   517→      | Array<{ matcher?: string; hooks?: Array<{ command?: string }> }>
   518→      | undefined;
   519→
   520→    // Check if our guards are already installed
   521→    const guardHookCommands = Object.keys(GUARD_SCRIPTS).map(
   522→      (name) => `.claude/hooks/${name}`,
   523→    );
   524→    const guardsAlreadyInstalled = existingPreToolUseHooks?.some((entry) =>
   525→      entry.hooks?.some((hook) =>
   526→        guardHookCommands.some((cmd) => hook.command?.includes(cmd)),
   527→      ),
   528→    );
   529→
   530→    if (!guardsAlreadyInstalled) {
   531→      // Create guard script files
   532→      for (const [name, content] of Object.entries(GUARD_SCRIPTS)) {
   533→        const scriptPath = path.join(hooksDir, name);
   534→        if (!dryRun) {
   535→          await fs.writeFile(scriptPath, content, { mode: 0o755 });
   536→        }
   537→        result.guardsCreated.push(name);
   538→      }
   539→
   540→      // Add PreToolUse hook entry
   541→      hooks.PreToolUse = [
   542→        ...(existingPreToolUseHooks || []),
   543→        {
   544→          matcher: "Bash",
   545→          hooks: Object.keys(GUARD_SCRIPTS).map((name) => ({
   546→            type: "command",
   547→            command: `.claude/hooks/${name}`,
   548→          })),
   549→        },
   550→      ];
   551→      result.preToolUse = true;
   552→    } else {
   553→      result.preToolUse = true; // Already configured
   554→    }
   555→
   556→    config.hooks = hooks;
   557→
   558→    // Write back
   559→    if (!dryRun) {
   560→      await fs.writeFile(
   561→        configPath,
   562→        `${JSON.stringify(config, null, 2)}\n`,
   563→        "utf-8",
   564→      );
   565→    }
   566→    return result;
   567→  } catch (err) {
   568→    debugLog("installClaudeCodeHooks failed", err);
   569→    return result;
   570→  }
   571→}
   572→
   573→/**
   574→ * Install KSPEC_AUTHOR config for Aider (.aider.conf.yml)
   575→ * Aider uses `set-env:` for environment variables in list format
   576→ */
   577→async function installAiderConfig(author: string): Promise<boolean> {
   578→  const configPath = path.join(os.homedir(), ".aider.conf.yml");
   579→
   580→  try {
   581→    let content = "";
   582→    try {
   583→      content = await fs.readFile(configPath, "utf-8");
   584→    } catch (err) {
   585→      debugLog("No existing Aider config, starting fresh", err);
   586→    }
   587→
   588→    // Check if KSPEC_AUTHOR is already set
   589→    if (content.includes("KSPEC_AUTHOR")) {
   590→      // Replace existing value (handles both old and new format)
   591→      content = content.replace(
   592→        /^(\s*-?\s*KSPEC_AUTHOR\s*[=:]\s*).*$/m,
   593→        `  - KSPEC_AUTHOR=${author}`,
   594→      );
   595→    } else {
   596→      // Add to set-env section or create it
   597→      if (content.includes("set-env:")) {
   598→        // Append to existing set-env section
   599→        content = content.replace(
   600→          /(set-env:\s*\n)/m,
   601→          `$1  - KSPEC_AUTHOR=${author}\n`,
   602→        );
   603→      } else {
   604→        // Add new set-env section
   605→        content += `\n# kspec author for note attribution\nset-env:\n  - KSPEC_AUTHOR=${author}\n`;
   606→      }
   607→    }
   608→
   609→    await fs.writeFile(configPath, content, "utf-8");
   610→    return true;
   611→  } catch (err) {
   612→    debugLog("installAiderConfig failed", err);
   613→    return false;
   614→  }
   615→}
   616→
   617→/**
   618→ * Install KSPEC_AUTHOR for generic JSON config files
   619→ */
   620→async function installGenericJsonConfig(
   621→  configPath: string,
   622→  author: string,
   623→): Promise<boolean> {
   624→  try {
   625→    const configDir = path.dirname(configPath);
   626→    await fs.mkdir(configDir, { recursive: true });
   627→
   628→    let config: Record<string, unknown> = {};
   629→    try {
   630→      const existing = await fs.readFile(configPath, "utf-8");
   631→      config = JSON.parse(existing);
   632→    } catch (err) {
   633→      debugLog(`No existing config at ${configPath}, starting fresh`, err);
   634→    }
   635→
   636→    const env = (config.env as Record<string, string>) || {};
   637→    env.KSPEC_AUTHOR = author;
   638→    config.env = env;
   639→
   640→    await fs.writeFile(
   641→      configPath,
   642→      `${JSON.stringify(config, null, 2)}\n`,
   643→      "utf-8",
   644→    );
   645→    return true;
   646→  } catch (err) {
   647→    debugLog(`installGenericJsonConfig failed for ${configPath}`, err);
   648→    return false;
   649→  }
   650→}
   651→
   652→/**
   653→ * Get default author value for an agent type
   654→ */
   655→function getDefaultAuthor(agentType: AgentType): string {
   656→  switch (agentType) {
   657→    case "claude-code":
   658→      return "@claude";
   659→    case "cline":
   660→      return "@cline";
   661→    case "roo-code":
   662→      return "@roo";
   663→    case "copilot-cli":
   664→      return "@copilot";
   665→    case "gemini-cli":
   666→      return "@gemini";
   667→    case "codex-cli":
   668→      return "@codex";
   669→    case "aider":
   670→      return "@aider";
   671→    case "opencode":
   672→      return "@opencode";
   673→    case "amp":
   674→      return "@amp";
   675→    default:
   676→      return "@agent";
   677→  }
   678→}
   679→
   680→/**
   681→ * Prompt user for input with Y/N answer
   682→ */
   683→async function promptYesNo(question: string): Promise<boolean> {
   684→  const rl = readline.createInterface({
   685→    input: process.stdin,
   686→    output: process.stdout,
   687→  });
   688→
   689→  try {
   690→    const answer = await rl.question(`${question} `);
   691→    return answer.toLowerCase() === "y";
   692→  } finally {
   693→    rl.close();
   694→  }
   695→}
   696→
   697→/**
   698→ * Ensure .kspec worktree exists if kspec-meta branch is present.
   699→ * AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
   700→ *
   701→ * @param autoWorktree If true, automatically create worktree without prompting
   702→ * @returns true if worktree is ready to use
   703→ */
   704→async function ensureWorktree(autoWorktree: boolean): Promise<boolean> {
   705→  const projectRoot = getGitRoot(process.cwd());
   706→  if (!projectRoot) {
   707→    // Not in a git repo, skip worktree check
   708→    return true;
   709→  }
   710→
   711→  const status = await getShadowStatus(projectRoot);
   712→
   713→  // AC: worktree-already-exists - if already valid, skip
   714→  if (status.healthy) {
   715→    return true;
   716→  }
   717→
   718→  // AC: detect-existing-repo - branch exists but worktree doesn't
   719→  if (status.branchExists && !status.worktreeExists) {
   720→    // AC: auto-worktree-flag - auto-create if flag set
   721→    if (autoWorktree) {
   722→      console.log(
   723→        `Detected ${SHADOW_BRANCH_NAME} branch without .kspec worktree. Creating...`,
   724→      );
   725→      const result = await repairShadow(projectRoot);
   726→      if (result.success) {
   727→        success("Created .kspec worktree");
   728→        return true;
   729→      } else {
   730→        error(`Failed to create worktree: ${result.error}`);
   731→        return false;
   732→      }
   733→    }
   734→
   735→    // AC: detect-existing-repo - prompt user
   736→    const shouldCreate = await promptYesNo(
   737→      `${SHADOW_BRANCH_NAME} branch exists but .kspec worktree is missing. Create it? (y/N)`,
   738→    );
   739→
   740→    if (shouldCreate) {
   741→      console.log("Creating .kspec worktree...");
   742→      const result = await repairShadow(projectRoot);
   743→      if (result.success) {
   744→        success("Created .kspec worktree");
   745→        return true;
   746→      } else {
   747→        error(`Failed to create worktree: ${result.error}`);
   748→        return false;
   749→      }
   750→    } else {
   751→      warn("Skipping worktree creation");
   752→      return false;
   753→    }
   754→  }
   755→
   756→  // No kspec-meta branch, or already healthy
   757→  return true;
   758→}
   759→
   760→/**
   761→ * Print manual setup instructions
   762→ */
   763→function printManualInstructions(agentType: AgentType): void {
   764→  const author = getDefaultAuthor(agentType);
   765→
   766→  console.log("\nManual setup instructions:\n");
   767→
   768→  switch (agentType) {
   769→    case "claude-code":
   770→      console.log("Add to ~/.claude/settings.json:");
   771→      console.log("```json");
   772→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   773→      console.log("```");
   774→      break;
   775→
   776→    case "cline":
   777→    case "roo-code":
   778→      console.log("Add to your shell profile (~/.bashrc, ~/.zshrc):");
   779→      console.log("```bash");
   780→      console.log(`export KSPEC_AUTHOR="${author}"`);
   781→      console.log("```");
   782→      console.log(
   783→        "\nThis will be inherited by terminals spawned by the VS Code extension.",
   784→      );
   785→      break;
   786→
   787→    case "copilot-cli":
   788→      console.log("Add to ~/.copilot/config.json:");
   789→      console.log("```json");
   790→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   791→      console.log("```");
   792→      break;
   793→
   794→    case "aider":
   795→      console.log("Add to ~/.aider.conf.yml:");
   796→      console.log("```yaml");
   797→      console.log("set-env:");
   798→      console.log(`  - KSPEC_AUTHOR=${author}`);
   799→      console.log("```");
   800→      break;
   801→
   802→    case "codex-cli":
   803→      console.log("Add to ~/.codex/config.toml:");
   804→      console.log("```toml");
   805→      console.log("[shell_environment_policy]");
   806→      console.log(`set = { KSPEC_AUTHOR = "${author}" }`);
   807→      console.log("```");
   808→      break;
   809→
   810→    case "opencode":
   811→      console.log("Add to ~/.config/opencode/opencode.json:");
   812→      console.log("```json");
   813→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   814→      console.log("```");
   815→      break;
   816→
   817→    case "amp":
   818→      console.log("Add to ~/.config/amp/settings.json:");
   819→      console.log("```json");
   820→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   821→      console.log("```");
   822→      break;
   823→
   824→    default:
   825→      console.log("Set the KSPEC_AUTHOR environment variable:");
   826→      console.log("```bash");
   827→      console.log(`export KSPEC_AUTHOR="${author}"`);
   828→      console.log("```");
   829→      console.log("\nOr add to your shell profile (~/.bashrc, ~/.zshrc, etc.)");
   830→  }
   831→}
   832→
   833→/**
   834→ * Result of a setup step
   835→ */
   836→interface SetupStepResult {
   837→  name: string;
   838→  status: "done" | "skipped" | "failed";
   839→  message?: string;
   840→  details?: Record<string, unknown>;
   841→}
   842→
   843→/**
   844→ * Result of running the setup pipeline
   845→ * Used by both the setup command and init --setup
   846→ * AC: @init-setup-integration ac-2, ac-3
   847→ */
   848→export interface SetupPipelineResult {
   849→  success: boolean;
   850→  steps: SetupStepResult[];
   851→  coreSkillsInstalled: number;
   852→  skillsRendered: number;
   853→  hooksInstalled: boolean;
   854→  agentsMdGenerated: boolean;
   855→  permissionsSeeded: boolean;
   856→  memorySeeded: boolean;
   857→}
   858→
   859→/**
   860→ * Options for running the setup pipeline
   861→ */
   862→export interface SetupPipelineOptions {
   863→  dryRun?: boolean;
   864→  skipSkills?: boolean;
   865→  installHooks?: boolean;
   866→  force?: boolean;
   867→  /** Custom author string (overrides auto-detected default) */
   868→  author?: string;
   869→  /** Whether to configure author (only in command handler, not init) */
   870→  configureAuthor?: boolean;
   871→}
   872→
   873→/**
   874→ * Status of the setup state
   875→ * AC: @enhanced-setup ac-7, ac-8 - status reporting
   876→ */
   877→interface SetupStatus {
   878→  agent: {
   879→    detected: AgentType;
   880→    confidence: "high" | "medium" | "low";
   881→  };
   882→  hooks: {
   883→    promptCheck: boolean;
   884→    stop: boolean;
   885→    preToolUse: boolean;
   886→    guardsPresent: string[];
   887→  };
   888→  skills: {
   889→    total: number;
   890→    rendered: number;
   891→    drifted: number;
   892→  };
   893→  plugin: {
   894→    marketplaceRegistered: boolean;
   895→    marketplaceHealthy: boolean;
   896→    pluginEnabled: boolean;
   897→    registeredPath?: string;
   898→    healthMessage?: string;
   899→  };
   900→  agentsMd: {
   901→    exists: boolean;
   902→    // AC: @doctor-command ac-staleness-unknown — includes "unknown" for indeterminate cases
   903→    status: "current" | "stale" | "missing" | "unknown";
   904→    generatedAt?: string;
   905→  };
   906→  seeding: {
   907→    permissionsSeeded: boolean;
   908→    memorySeeded: boolean;
   909→    memoryPath?: string;
   910→  };
   911→}
   912→
   913→/**
   914→ * Check the current setup status
   915→ * AC: @enhanced-setup ac-7, ac-8
   916→ */
   917→async function getSetupStatus(projectDir: string): Promise<SetupStatus> {
   918→  const detected = detectAgent();
   919→  const configPath = path.join(projectDir, ".claude", "settings.json");
   920→  const hooksDir = path.join(projectDir, ".claude", "hooks");
   921→  const agentsMdPath = path.join(projectDir, "kspec-agents.md");
   922→  const hashPath = path.join(projectDir, ".kspec", ".kspec-agents-hash");
   923→  const skillsDir = path.join(projectDir, ".claude", "skills");
   924→
   925→  // Check hooks
   926→  const hooks = {
   927→    promptCheck: false,
   928→    stop: false,
   929→    preToolUse: false,
   930→    guardsPresent: [] as string[],
   931→  };
   932→
   933→  try {
   934→    const configContent = await fs.readFile(configPath, "utf-8");
   935→    const config = JSON.parse(configContent);
   936→    const hooksConfig = config.hooks || {};
   937→
   938→    // Check UserPromptSubmit
   939→    const promptHooks = hooksConfig.UserPromptSubmit as Array<{
   940→      hooks?: Array<{ command?: string }>;
   941→    }> | undefined;
   942→    hooks.promptCheck = promptHooks?.some((entry) =>
   943→      entry.hooks?.some((h) => h.command?.includes("prompt-check")),
   944→    ) ?? false;
   945→
   946→    // Check Stop
   947→    const stopHooks = hooksConfig.Stop as Array<{
   948→      hooks?: Array<{ command?: string }>;
   949→    }> | undefined;
   950→    hooks.stop = stopHooks?.some((entry) =>
   951→      entry.hooks?.some((h) => h.command?.includes("checkpoint")),
   952→    ) ?? false;
   953→
   954→    // Check PreToolUse
   955→    const preToolUseHooks = hooksConfig.PreToolUse as Array<{
   956→      hooks?: Array<{ command?: string }>;
   957→    }> | undefined;
   958→    hooks.preToolUse = preToolUseHooks?.some((entry) =>
   959→      entry.hooks?.some((h) => h.command?.includes(".claude/hooks/")),
   960→    ) ?? false;
   961→  } catch (err) {
   962→    debugLog("Failed to read hooks config for status", err);
   963→  }
   964→
   965→  // Check guard scripts
   966→  try {
   967→    const guardFiles = await fs.readdir(hooksDir);
   968→    for (const name of Object.keys(GUARD_SCRIPTS)) {
   969→      if (guardFiles.includes(name)) {
   970→        hooks.guardsPresent.push(name);
   971→      }
   972→    }
   973→  } catch (err) {
   974→    debugLog("Hooks dir doesn't exist", err);
   975→  }
   976→
   977→  // Check skills
   978→  const skills = {
   979→    total: 0,
   980→    rendered: 0,
   981→    drifted: 0,
   982→  };
   983→
   984→  // Helper to scan a directory for skill subdirs with kspec-managed SKILL.md
   985→  async function scanForSkills(baseDir: string): Promise<void> {
   986→    try {
   987→      const dirs = await fs.readdir(baseDir, { withFileTypes: true });
   988→      for (const dir of dirs) {
   989→        if (dir.isDirectory()) {
   990→          const skillMdPath = path.join(baseDir, dir.name, "SKILL.md");
   991→          try {
   992→            const content = await fs.readFile(skillMdPath, "utf-8");
   993→            if (content.includes("<!-- kspec-managed -->")) {
   994→              skills.total++;
   995→              skills.rendered++;
   996→            }
   997→          } catch (_noSkillMd) {
   998→            // No SKILL.md
   999→          }
  1000→        }
  1001→      }
  1002→    } catch (_notReadable) {
  1003→      // Directory doesn't exist
  1004→    }
  1005→  }
  1006→
  1007→  // Scan .claude/skills/ (project/local skills)
  1008→  await scanForSkills(skillsDir);
  1009→
  1010→  // Check plugin marketplace health
  1011→  // AC: @enhanced-setup ac-7, ac-8
  1012→  const plugin: SetupStatus["plugin"] = {
  1013→    marketplaceRegistered: false,
  1014→    marketplaceHealthy: false,
  1015→    pluginEnabled: false,
  1016→  };
  1017→
  1018→  try {
  1019→    const { checkMarketplaceHealth } = await import(
  1020→      "../../lib/claude-plugin-registry.js"
  1021→    );
  1022→    const health = await checkMarketplaceHealth();
  1023→    plugin.marketplaceRegistered = health.status !== "missing";
  1024→    plugin.marketplaceHealthy = health.status === "healthy";
  1025→    plugin.registeredPath = health.registeredPath;
  1026→    plugin.healthMessage = health.message;
  1027→  } catch (err) {
  1028→    debugLog("Could not check marketplace health", err);
  1029→    plugin.healthMessage = "Health check unavailable";
  1030→  }
  1031→
  1032→  // Check if plugin is enabled in project settings
  1033→  try {
  1034→    const configContent = await fs.readFile(configPath, "utf-8");
  1035→    const config = JSON.parse(configContent);
  1036→    plugin.pluginEnabled = config.enabledPlugins?.["kspec@kspec-plugins"] === true;
  1037→  } catch (err) {
  1038→    debugLog("Could not check plugin enablement", err);
  1039→  }
  1040→
  1041→  // Check agents.md
  1042→  const agentsMd: SetupStatus["agentsMd"] = {
  1043→    exists: false,
  1044→    status: "missing",
  1045→  };
  1046→
  1047→  try {
  1048→    await fs.access(agentsMdPath);
  1049→    agentsMd.exists = true;
  1050→
  1051→    try {
  1052→      const hashContent = await fs.readFile(hashPath, "utf-8");
  1053→      const hashData = JSON.parse(hashContent);
  1054→      agentsMd.generatedAt = hashData.generatedAt;
  1055→
  1056→      // AC: @cross-platform-and-version-robustness ac-4
  1057→      // Compare stored hash against current meta to detect staleness
  1058→      try {
  1059→        const { initContext, loadMetaContext } = await import(
  1060→          "../../parser/index.js"
  1061→        );
  1062→        const { computeMetaHash, loadTemplateSections, getPackageRoot } = await import("./agents.js");
  1063→        const ctx = await initContext();
  1064→        if (ctx.manifestPath) {
  1065→          const metaCtx = await loadMetaContext(ctx);
  1066→          let templateSections: string[] = [];
  1067→          try {
  1068→            templateSections = await loadTemplateSections(getPackageRoot());
  1069→          } catch (err) {
  1070→            debugLog("Templates not available for staleness check", err);
  1071→          }
  1072→          const currentHash = computeMetaHash(
  1073→            metaCtx.skills,
  1074→            metaCtx.conventions,
  1075→            metaCtx.workflows,
  1076→            templateSections,
  1077→          );
  1078→          agentsMd.status = hashData.metaHash === currentHash ? "current" : "stale";
  1079→        } else {
  1080→          // AC: @doctor-command ac-staleness-unknown — no manifest means we can't determine staleness
  1081→          agentsMd.status = "unknown";
  1082→        }
  1083→      } catch (err) {
  1084→        // AC: @doctor-command ac-staleness-unknown — hash computation failed
  1085→        debugLog("Could not compute meta hash for staleness check", err);
  1086→        agentsMd.status = "unknown";
  1087→      }
  1088→    } catch (err) {
  1089→      debugLog("Hash file missing or invalid, marking stale", err);
  1090→      agentsMd.status = "stale";
  1091→    }
  1092→  } catch (err) {
  1093→    debugLog("kspec-agents.md doesn't exist", err);
  1094→  }
  1095→
  1096→  // Check seeding state
  1097→  const seeding: SetupStatus["seeding"] = {
  1098→    permissionsSeeded: false,
  1099→    memorySeeded: false,
  1100→  };
  1101→
  1102→  try {
  1103→    const configContent = await fs.readFile(
  1104→      path.join(projectDir, ".claude", "settings.json"),
  1105→      "utf-8",
  1106→    );
  1107→    const config = JSON.parse(configContent);
  1108→    seeding.permissionsSeeded = !!config.permissions;
  1109→  } catch (err) {
  1110→    debugLog("Could not check permissions seeding state", err);
  1111→  }
  1112→
  1113→  if (detected.type === "claude-code") {
  1114→    try {
  1115→      const { claudeCodeMemoryWriter } = await import("./setup-seeding.js");
  1116→      const memoryExists = await claudeCodeMemoryWriter.exists(projectDir);
  1117→      seeding.memorySeeded = memoryExists;
  1118→      if (memoryExists) {
  1119→        seeding.memoryPath = claudeCodeMemoryWriter.getMemoryPath(projectDir);
  1120→      }
  1121→    } catch (err) {
  1122→      debugLog("Could not check memory seeding state", err);
  1123→    }
  1124→  }
  1125→
  1126→  return {
  1127→    agent: {
  1128→      detected: detected.type,
  1129→      confidence: detected.confidence,
  1130→    },
  1131→    hooks,
  1132→    skills,
  1133→    plugin,
  1134→    agentsMd,
  1135→    seeding,
  1136→  };
  1137→}
  1138→
  1139→/**
  1140→ * Render skills using the platform renderer registry
  1141→ * AC: @setup-pipeline-unification ac-2 - uses getRenderer/getAllRenderers, not legacy renderClaudeCodeSkill
  1142→ * AC: @setup-pipeline-unification ac-4 - errors logged at debug level
  1143→ */
  1144→async function renderSkillsForSetup(
  1145→  projectDir: string,
  1146→  dryRun: boolean,
  1147→): Promise<{ rendered: number; skipped: number; pluginProvided: number; skillIds: string[] }> {
  1148→  // Dynamically import to avoid circular dependencies
  1149→  const { initContext, loadMetaContext } = await import(
  1150→    "../../parser/index.js"
  1151→  );
  1152→  const { getRenderer } = await import("../../parser/skill-render.js");
  1153→
  1154→  try {
  1155→    const ctx = await initContext();
  1156→
  1157→    if (!ctx.manifestPath) {
  1158→      return { rendered: 0, skipped: 0, pluginProvided: 0, skillIds: [] };
  1159→    }
  1160→
  1161→    const metaCtx = await loadMetaContext(ctx);
  1162→
  1163→    // Collect all skills that have a registered renderer for their platform
  1164→    const skillsToRender: Array<{ skill: typeof metaCtx.skills[0]; platform: string }> = [];
  1165→    for (const skill of metaCtx.skills) {
  1166→      for (const platform of skill.platforms) {
  1167→        const renderer = getRenderer(platform);
  1168→        if (renderer) {
  1169→          skillsToRender.push({ skill, platform });
  1170→        }
  1171→      }
  1172→    }
  1173→
  1174→    if (skillsToRender.length === 0) {
  1175→      return { rendered: 0, skipped: 0, pluginProvided: 0, skillIds: [] };
  1176→    }
  1177→
  1178→    let rendered = 0;
  1179→    let skipped = 0;
  1180→    let pluginProvided = 0;
  1181→    const skillIds: string[] = [];
  1182→
  1183→    for (const { skill, platform } of skillsToRender) {
  1184→      const renderer = getRenderer(platform)!;
  1185→      try {
  1186→        const result = await renderer.render(ctx, projectDir, skill, {
  1187→          dryRun,
  1188→        });
  1189→        if (result.action === "created" || result.action === "updated") {
  1190→          rendered++;
  1191→          if (!skillIds.includes(skill.id)) {
  1192→            skillIds.push(skill.id);
  1193→          }
  1194→        } else if (result.action === "skipped" && result.skipCode === "plugin-provided") {
  1195→          pluginProvided++;
  1196→        } else {
  1197→          skipped++;
  1198→        }
  1199→      } catch (err) {
  1200→        debugLog(`Failed to render skill ${skill.id} for ${platform}`, err);
  1201→        skipped++;
  1202→      }
  1203→    }
  1204→
  1205→    return { rendered, skipped, pluginProvided, skillIds };
  1206→  } catch (err) {
  1207→    debugLog("renderSkillsForSetup failed", err);
  1208→    return { rendered: 0, skipped: 0, pluginProvided: 0, skillIds: [] };
  1209→  }
  1210→}
  1211→
  1212→/**
  1213→ * Generate kspec-agents.md using the canonical implementation from agents.ts
  1214→ * AC: @setup-pipeline-unification ac-1 - calls generateAgentsContent() from agents.ts
  1215→ * AC: @setup-pipeline-unification ac-4 - errors logged at debug level
  1216→ */
  1217→async function generateAgentInstructions(
  1218→  projectDir: string,
  1219→  dryRun: boolean,
  1220→): Promise<{ success: boolean; path: string }> {
  1221→  const outputPath = path.join(projectDir, "kspec-agents.md");
  1222→  const hashPath = path.join(projectDir, ".kspec", ".kspec-agents-hash");
  1223→
  1224→  // Dynamically import to avoid circular dependencies
  1225→  const { initContext, loadMetaContext } = await import(
  1226→    "../../parser/index.js"
  1227→  );
  1228→  const {
  1229→    generateAgentsContent,
  1230→    loadTemplateSections,
  1231→    getPackageRoot,
  1232→    computeMetaHash,
  1233→  } = await import("./agents.js");
  1234→
  1235→  try {
  1236→    const ctx = await initContext();
  1237→
  1238→    if (!ctx.manifestPath) {
  1239→      return { success: false, path: outputPath };
  1240→    }
  1241→
  1242→    const metaCtx = await loadMetaContext(ctx);
  1243→    const timestamp = new Date().toISOString();
  1244→
  1245→    // Load templates using the canonical implementation
  1246→    let templateSections: string[] = [];
  1247→    try {
  1248→      templateSections = await loadTemplateSections(getPackageRoot());
  1249→    } catch (err) {
  1250→      debugLog("Failed to load template sections", err);
  1251→    }
  1252→
  1253→    // Generate content using the canonical implementation from agents.ts
  1254→    const content = await generateAgentsContent(
  1255→      metaCtx.skills,
  1256→      metaCtx.conventions,
  1257→      metaCtx.workflows,
  1258→      timestamp,
  1259→      templateSections,
  1260→    );
  1261→
  1262→    if (!dryRun) {
  1263→      await fs.writeFile(outputPath, content, "utf-8");
  1264→
  1265→      // Write hash for freshness tracking using the canonical hash function
  1266→      const metaHash = computeMetaHash(
  1267→        metaCtx.skills,
  1268→        metaCtx.conventions,
  1269→        metaCtx.workflows,
  1270→        templateSections,
  1271→      );
  1272→
  1273→      await fs.mkdir(path.dirname(hashPath), { recursive: true });
  1274→      // Dynamically import version to avoid top-level require
  1275→      const { createRequire } = await import("node:module");
  1276→      const req = createRequire(import.meta.url);
  1277→      const { version } = req("../../../package.json");
  1278→
  1279→      await fs.writeFile(
  1280→        hashPath,
  1281→        JSON.stringify(
  1282→          {
  1283→            metaHash,
  1284→            generatedAt: timestamp,
  1285→            version,
  1286→          },
  1287→          null,
  1288→          2,
  1289→        ),
  1290→        "utf-8",
  1291→      );
  1292→    }
  1293→
  1294→    return { success: true, path: outputPath };
  1295→  } catch (err) {
  1296→    debugLog("generateAgentInstructions failed", err);
  1297→    return { success: false, path: outputPath };
  1298→  }
  1299→}
  1300→
  1301→/**
  1302→ * Install core skills for the setup pipeline
  1303→ * AC: @init-setup-integration ac-2 - core skills installed
  1304→ */
  1305→async function installCoreSkillsForSetup(
  1306→  projectDir: string,
  1307→  dryRun: boolean
  1308→): Promise<{
  1309→  installed: number;
  1310→  skipped: number;
  1311→  marketplaceRegistered?: boolean;
  1312→  pluginEnabled?: boolean;
  1313→  marketplaceMessage?: string;
  1314→  enableMessage?: string;
  1315→}> {
  1316→  // Dynamically import to avoid circular dependencies
  1317→  const {
  1318→    initContext,
  1319→    loadMetaContext,
  1320→    saveMetaItem,
  1321→    getSkillContentPath,
  1322→  } = await import("../../parser/index.js");
  1323→  const { commitIfShadow } = await import("../../parser/shadow.js");
  1324→  const { SkillSchema } = await import("../../schema/index.js");
  1325→  const {
  1326→    loadCoreSkillsManifest,
  1327→    copyCoreSkillFiles,
  1328→    getKspecPackageVersion,
  1329→  } = await import("./skill.js");
  1330→  const { ulid } = await import("ulid");
  1331→
  1332→  let installed = 0;
  1333→  let skipped = 0;
  1334→
  1335→  try {
  1336→    const ctx = await initContext();
  1337→
  1338→    if (!ctx.manifestPath) {
  1339→      return { installed: 0, skipped: 0 };
  1340→    }
  1341→
  1342→    const metaCtx = await loadMetaContext(ctx);
  1343→    const coreSkills = await loadCoreSkillsManifest();
  1344→    // AC: @cross-platform-and-version-robustness ac-3
  1345→    const kspecVersion = await getKspecPackageVersion();
  1346→    if (!kspecVersion) {
  1347→      debugLog("Could not determine kspec version — skills installed without version tracking");
  1348→    }
  1349→
  1350→    for (const coreSkill of coreSkills) {
  1351→      // Check if skill exists
  1352→      const existingSkill = metaCtx.skills.find((s) => s.id === coreSkill.id);
  1353→
  1354→      if (existingSkill && existingSkill.origin !== "core") {
  1355→        // Custom/project skill exists, skip
  1356→        skipped++;
  1357→        continue;
  1358→      }
  1359→
  1360→      // Build skill data
  1361→      const skillData = {
  1362→        _ulid: existingSkill?._ulid || ulid(),
  1363→        id: coreSkill.id,
  1364→        name: coreSkill.name,
  1365→        description: coreSkill.description,
  1366→        origin: "core" as const,
  1367→        ...(kspecVersion && { version: kspecVersion }),
  1368→        platforms: coreSkill.platforms || ["claude-code"],
  1369→        depends_on: [],
  1370→        tags: ["core"],
  1371→      };
  1372→
  1373→      const parsed = SkillSchema.safeParse(skillData);
  1374→      if (!parsed.success) {
  1375→        skipped++;
  1376→        continue;
  1377→      }
  1378→
  1379→      if (!dryRun) {
  1380→        await saveMetaItem(ctx, parsed.data, "skill");
  1381→
  1382→        // Copy skill files (SKILL.md + supporting dirs)
  1383→        const targetDir = path.dirname(getSkillContentPath(ctx, parsed.data.id));
  1384→        await copyCoreSkillFiles(coreSkill.id, targetDir);
  1385→      }
  1386→
  1387→      installed++;
  1388→    }
  1389→
  1390→    // Commit changes
  1391→    if (!dryRun && installed > 0) {
  1392→      const ctx2 = await initContext();
  1393→      await commitIfShadow(
  1394→        ctx2.shadow,
  1395→        "skill-install-core",
  1396→        `${installed} core skills`
  1397→      );
  1398→    }
  1399→
  1400→    // AC: @core-skill-install ac-6, ac-7 - Register marketplace and enable plugin
  1401→    let marketplaceResult;
  1402→    let enableResult;
  1403→    if (!dryRun) {
  1404→      const {
  1405→        registerCorePluginMarketplace,
  1406→        enablePluginInProject,
  1407→      } = await import("../../lib/claude-plugin-registry.js");
  1408→      marketplaceResult = await registerCorePluginMarketplace();
  1409→      enableResult = await enablePluginInProject(projectDir);
  1410→    }
  1411→
  1412→    return {
  1413→      installed,
  1414→      skipped,
  1415→      marketplaceRegistered: marketplaceResult?.success ?? false,
  1416→      pluginEnabled: enableResult?.success ?? false,
  1417→      marketplaceMessage: marketplaceResult?.message,
  1418→      enableMessage: enableResult?.message,
  1419→    };
  1420→  } catch (err) {
  1421→    debugLog("installCoreSkillsForSetup failed", err);
  1422→    return { installed: 0, skipped: 0 };
  1423→  }
  1424→}
  1425→
  1426→/**
  1427→ * Run the full setup pipeline programmatically.
  1428→ * Used by both 'kspec setup' command and 'kspec init --setup'.
  1429→ * AC: @init-setup-integration ac-2, ac-3
  1430→ */
  1431→export async function runSetupPipeline(
  1432→  projectDir: string,
  1433→  options: SetupPipelineOptions
  1434→): Promise<SetupPipelineResult> {
  1435→  const dryRun = options.dryRun ?? false;
  1436→  const skipSkills = options.skipSkills ?? false;
  1437→  const installHooksFlag = options.installHooks ?? true;
  1438→
  1439→  const steps: SetupStepResult[] = [];
  1440→  let coreSkillsInstalled = 0;
  1441→  let skillsRendered = 0;
  1442→  let hooksInstalled = false;
  1443→  let agentsMdGenerated = false;
  1444→  let permissionsSeeded = false;
  1445→  let memorySeeded = false;
  1446→
  1447→  try {
  1448→    const detected = detectAgent();
  1449→
  1450→    // Step 1: Agent detection
  1451→    steps.push({
  1452→      name: "Agent detection",
  1453→      status: "done",
  1454→      message: `${detected.type} (${detected.confidence} confidence)`,
  1455→    });
  1456→
  1457→    // Step 2: Install core skills
  1458→    // AC: @init-setup-integration ac-2 - core skills installed in .kspec/skills/
  1459→    const coreResult = await installCoreSkillsForSetup(projectDir, dryRun);
  1460→    coreSkillsInstalled = coreResult.installed;
  1461→
  1462→    if (coreResult.installed > 0 || coreResult.skipped > 0) {
  1463→      steps.push({
  1464→        name: "Install core skills",
  1465→        status: "done",
  1466→        message: `${coreResult.installed} installed, ${coreResult.skipped} skipped`,
  1467→      });
  1468→    } else {
  1469→      steps.push({
  1470→        name: "Install core skills",
  1471→        status: "skipped",
  1472→        message: "No core skills found in package",
  1473→      });
  1474→    }
  1475→
  1476→    // Step 2b: Register plugin marketplace (reports result from installCoreSkillsForSetup)
  1477→    // AC: @core-skill-install ac-6, ac-7
  1478→    if (!dryRun && (coreResult.installed > 0 || coreResult.skipped > 0)) {
  1479→      const bothOk = coreResult.marketplaceRegistered && coreResult.pluginEnabled;
  1480→      if (bothOk) {
  1481→        steps.push({
  1482→          name: "Register plugin marketplace",
  1483→          status: "done",
  1484→          message: "marketplace registered, plugin enabled",
  1485→        });
  1486→      } else {
  1487→        const failures: string[] = [];
  1488→        if (!coreResult.marketplaceRegistered) {
  1489→          failures.push(coreResult.marketplaceMessage || "marketplace registration failed");
  1490→        }
  1491→        if (!coreResult.pluginEnabled) {
  1492→          failures.push(coreResult.enableMessage || "plugin enablement failed");
  1493→        }
  1494→        steps.push({
  1495→          name: "Register plugin marketplace",
  1496→          status: "failed",
  1497→          message: failures.join("; "),
  1498→        });
  1499→      }
  1500→    }
  1501→
  1502→    // Step 3: Install hooks (Claude Code only)
  1503→    // AC: @init-setup-integration ac-3 - hooks present
  1504→    if (detected.type === "claude-code" && installHooksFlag) {
  1505→      const hooksResult = await installClaudeCodeHooks(projectDir, dryRun);
  1506→      const installedHooks: string[] = [];
  1507→      if (hooksResult.promptCheck) installedHooks.push("UserPromptSubmit");
  1508→      if (hooksResult.stop) installedHooks.push("Stop");
  1509→      if (hooksResult.preToolUse) installedHooks.push("PreToolUse");
  1510→
  1511→      hooksInstalled =
  1512→        hooksResult.promptCheck || hooksResult.stop || hooksResult.preToolUse;
  1513→
  1514→      steps.push({
  1515→        name: "Install hooks",
  1516→        status: "done",
  1517→        message: installedHooks.join(", "),
  1518→        details: {
  1519→          guards: hooksResult.guardsCreated,
  1520→        },
  1521→      });
  1522→    } else if (!installHooksFlag) {
  1523→      steps.push({
  1524→        name: "Install hooks",
  1525→        status: "skipped",
  1526→        message: "--no-hooks flag",
  1527→      });
  1528→    } else {
  1529→      steps.push({
  1530→        name: "Install hooks",
  1531→        status: "skipped",
  1532→        message: `not applicable for ${detected.type}`,
  1533→      });
  1534→    }
  1535→
  1536→    // Step 3a: Ensure artifacts directory exists
  1537→    // AC: @artifacts-directory ac-setup-ensures
  1538→    {
  1539→      const artifactsDir = path.join(projectDir, ".kspec", "artifacts");
  1540→      let artifactsCreated = false;
  1541→      try {
  1542→        await fs.access(artifactsDir);
  1543→      } catch (_e) {
  1544→        if (!dryRun) {
  1545→          await fs.mkdir(artifactsDir, { recursive: true });
  1546→        }
  1547→        artifactsCreated = true;
  1548→      }
  1549→      steps.push({
  1550→        name: "Ensure artifacts directory",
  1551→        status: artifactsCreated ? "done" : "skipped",
  1552→        message: artifactsCreated ? "created .kspec/artifacts/" : "already exists",
  1553→      });
  1554→    }
  1555→
  1556→    // Step 3b: Seed permissions (Claude Code only)
  1557→    // AC: @new-project-bootstrapping ac-1
  1558→    {
  1559→      const { seedPermissions } = await import("./setup-seeding.js");
  1560→      const permResult = await seedPermissions(projectDir, detected.type, {
  1561→        dryRun,
  1562→        force: options.force,
  1563→      });
  1564→      permissionsSeeded = permResult.seeded;
  1565→
  1566→      steps.push({
  1567→        name: "Seed permissions",
  1568→        status: permResult.seeded ? "done" : "skipped",
  1569→        message: permResult.message,
  1570→      });
  1571→    }
  1572→
  1573→    // Step 3c: Seed memory (platform-extensible)
  1574→    // AC: @new-project-bootstrapping ac-2
  1575→    {
  1576→      const { seedMemory } = await import("./setup-seeding.js");
  1577→      const memResult = await seedMemory(projectDir, detected.type, {
  1578→        dryRun,
  1579→        force: options.force,
  1580→      });
  1581→      memorySeeded = memResult.seeded;
  1582→
  1583→      steps.push({
  1584→        name: "Seed memory",
  1585→        status: memResult.seeded ? "done" : "skipped",
  1586→        message: memResult.seeded ? memResult.path : memResult.message,
  1587→      });
  1588→    }
  1589→
  1590→    // Step 4: Render skills
  1591→    // AC: @init-setup-integration ac-3 - rendered skill files present
  1592→    if (!skipSkills) {
  1593→      const skillsResult = await renderSkillsForSetup(projectDir, dryRun);
  1594→      skillsRendered = skillsResult.rendered;
  1595→
  1596→      if (skillsResult.rendered > 0 || skillsResult.skipped > 0 || skillsResult.pluginProvided > 0) {
  1597→        const parts = [];
  1598→        if (skillsResult.rendered > 0) parts.push(`${skillsResult.rendered} rendered`);
  1599→        if (skillsResult.pluginProvided > 0) parts.push(`${skillsResult.pluginProvided} plugin-provided`);
  1600→        if (skillsResult.skipped > 0) parts.push(`${skillsResult.skipped} unchanged`);
  1601→        steps.push({
  1602→          name: "Render skills",
  1603→          status: "done",
  1604→          message: parts.join(", "),
  1605→          details: {
  1606→            skillIds: skillsResult.skillIds,
  1607→          },
  1608→        });
  1609→      } else {
  1610→        steps.push({
  1611→          name: "Render skills",
  1612→          status: "skipped",
  1613→          message: "No claude-code skills in meta",
  1614→        });
  1615→      }
  1616→    } else {
  1617→      steps.push({
  1618→        name: "Render skills",
  1619→        status: "skipped",
  1620→        message: "--skip-skills flag",
  1621→      });
  1622→    }
  1623→
  1624→    // Step 5: Generate kspec-agents.md
  1625→    // AC: @init-setup-integration ac-3 - kspec-agents.md present
  1626→    const agentsResult = await generateAgentInstructions(projectDir, dryRun);
  1627→    agentsMdGenerated = agentsResult.success;
  1628→
  1629→    if (agentsResult.success) {
  1630→      steps.push({
  1631→        name: "Generate kspec-agents.md",
  1632→        status: "done",
  1633→        message: agentsResult.path,
  1634→      });
  1635→    } else {
  1636→      steps.push({
  1637→        name: "Generate kspec-agents.md",
  1638→        status: "failed",
  1639→        message: "No kspec project found",
  1640→      });
  1641→    }
  1642→
  1643→    // Step 6: Configure author (optional, used by setup command)
  1644→    if (options.configureAuthor) {
  1645→      const author = options.author || getDefaultAuthor(detected.type);
  1646→      if (!options.force && process.env.KSPEC_AUTHOR) {
  1647→        steps.push({
  1648→          name: "Configure author",
  1649→          status: "skipped",
  1650→          message: `KSPEC_AUTHOR already set to "${process.env.KSPEC_AUTHOR}"`,
  1651→        });
  1652→      } else {
  1653→        let authorInstalled = false;
  1654→        switch (detected.type) {
  1655→          case "claude-code":
  1656→            if (!dryRun) {
  1657→              authorInstalled = await installClaudeCodeConfig(author);
  1658→            } else {
  1659→              authorInstalled = true;
  1660→            }
  1661→            break;
  1662→          case "aider":
  1663→            if (!dryRun) {
  1664→              authorInstalled = await installAiderConfig(author);
  1665→            } else {
  1666→              authorInstalled = true;
  1667→            }
  1668→            break;
  1669→          default:
  1670→            break;
  1671→        }
  1672→
  1673→        if (authorInstalled) {
  1674→          steps.push({
  1675→            name: "Configure author",
  1676→            status: "done",
  1677→            message: `KSPEC_AUTHOR="${author}"`,
  1678→          });
  1679→        }
  1680→      }
  1681→    }
  1682→
  1683→    // Output summary
  1684→    if (!dryRun) {
  1685→      console.log(chalk.bold("kspec Setup Summary\n"));
  1686→
  1687→      for (const step of steps) {
  1688→        const icon =
  1689→          step.status === "done"
  1690→            ? chalk.green("✓")
  1691→            : step.status === "skipped"
  1692→              ? chalk.gray("○")
  1693→              : chalk.red("✗");
  1694→        const statusText =
  1695→          step.status === "done"
  1696→            ? ""
  1697→            : step.status === "skipped"
  1698→              ? chalk.gray(" (skipped)")
  1699→              : chalk.red(" (failed)");
  1700→
  1701→        console.log(`${icon} ${step.name}${statusText}`);
  1702→        if (step.message) {
  1703→          console.log(chalk.gray(`  ${step.message}`));
  1704→        }
  1705→      }
  1706→    }
  1707→
  1708→    const success = steps.every((s) => s.status !== "failed");
  1709→
  1710→    return {
  1711→      success,
  1712→      steps,
  1713→      coreSkillsInstalled,
  1714→      skillsRendered,
  1715→      hooksInstalled,
  1716→      agentsMdGenerated,
  1717→      permissionsSeeded,
  1718→      memorySeeded,
  1719→    };
  1720→  } catch (err) {
  1721→    debugLog("runSetupPipeline failed", err);
  1722→    return {
  1723→      success: false,
  1724→      steps,
  1725→      coreSkillsInstalled,
  1726→      skillsRendered,
  1727→      hooksInstalled,
  1728→      agentsMdGenerated,
  1729→      permissionsSeeded,
  1730→      memorySeeded,
  1731→    };
  1732→  }
  1733→}
  1734→
  1735→/**
  1736→ * Register the 'setup' command
  1737→ * AC: @enhanced-setup ac-1 through ac-9
  1738→ */
  1739→export function registerSetupCommand(program: Command): void {
  1740→  program
  1741→    .command("setup")
  1742→    .description("Configure agent environment for kspec (orchestrated pipeline)")
  1743→    .option("--dry-run", "Show what would be done without making changes")
  1744→    .option(
  1745→      "--author <author>",
  1746→      "Custom author string (default: auto-detected based on agent)",
  1747→    )
  1748→    .option("--no-hooks", "Skip installing hooks")
  1749→    .option("--skip-skills", "Skip rendering skills")
  1750→    .option("--status", "Report current setup state without making changes")
  1751→    .option("--force", "Overwrite existing configuration")
  1752→    .option(
  1753→      "--auto-worktree",
  1754→      "Automatically create .kspec worktree if kspec-meta branch exists",
  1755→    )
  1756→    .action(async (options) => {
  1757→      try {
  1758→        const projectDir = process.cwd();
  1759→
  1760→        // AC: @enhanced-setup ac-7, ac-8 - --status mode
  1761→        if (options.status) {
  1762→          const status = await getSetupStatus(projectDir);
  1763→
  1764→          output(status, () => {
  1765→            console.log(chalk.bold("kspec Setup Status\n"));
  1766→
  1767→            // Agent detection
  1768→            console.log(chalk.gray("Agent:"));
  1769→            console.log(
  1770→              `  Detected: ${status.agent.detected} (${status.agent.confidence} confidence)`,
  1771→            );
  1772→            console.log();
  1773→
  1774→            // Hooks status
  1775→            console.log(chalk.gray("Hooks:"));
  1776→            console.log(
  1777→              `  UserPromptSubmit: ${status.hooks.promptCheck ? chalk.green("✓") : chalk.red("✗")}`,
  1778→            );
  1779→            console.log(
  1780→              `  Stop:             ${status.hooks.stop ? chalk.green("✓") : chalk.red("✗")}`,
  1781→            );
  1782→            console.log(
  1783→              `  PreToolUse:       ${status.hooks.preToolUse ? chalk.green("✓") : chalk.red("✗")}`,
  1784→            );
  1785→            if (status.hooks.guardsPresent.length > 0) {
  1786→              console.log(
  1787→                `  Guards:           ${status.hooks.guardsPresent.join(", ")}`,
  1788→              );
  1789→            }
  1790→            console.log();
  1791→
  1792→            // Skills status
  1793→            console.log(chalk.gray("Skills:"));
  1794→            console.log(`  Rendered: ${status.skills.rendered}`);
  1795→            if (status.skills.drifted > 0) {
  1796→              console.log(
  1797→                `  Drifted:  ${chalk.yellow(status.skills.drifted.toString())}`,
  1798→              );
  1799→            }
  1800→            console.log();
  1801→
  1802→            // Plugin marketplace status
  1803→            // AC: @enhanced-setup ac-7, ac-8
  1804→            console.log(chalk.gray("Plugin:"));
  1805→            console.log(
  1806→              `  Marketplace: ${status.plugin.marketplaceRegistered ? (status.plugin.marketplaceHealthy ? chalk.green("healthy") : chalk.yellow("registered")) : chalk.red("not registered")}`,
  1807→            );
  1808→            console.log(
  1809→              `  Enabled:     ${status.plugin.pluginEnabled ? chalk.green("✓") : chalk.red("✗")}`,
  1810→            );
  1811→            if (status.plugin.registeredPath) {
  1812→              console.log(chalk.gray(`  Path: ${status.plugin.registeredPath}`));
  1813→            }
  1814→            if (status.plugin.healthMessage && !status.plugin.marketplaceHealthy) {
  1815→              console.log(chalk.yellow(`  ${status.plugin.healthMessage}`));
  1816→            }
  1817→            console.log();
  1818→
  1819→            // Agents.md status
  1820→            console.log(chalk.gray("kspec-agents.md:"));
  1821→            if (status.agentsMd.exists) {
  1822→              // AC: @doctor-command ac-staleness-unknown — show appropriate color for unknown status
  1823→              const statusColor =
  1824→                status.agentsMd.status === "current"
  1825→                  ? chalk.green
  1826→                  : status.agentsMd.status === "unknown"
  1827→                    ? chalk.yellow
  1828→                    : chalk.yellow;
  1829→              console.log(`  Status: ${statusColor(status.agentsMd.status)}`);
  1830→              if (status.agentsMd.status === "unknown") {
  1831→                console.log(chalk.gray("  Could not determine staleness (no manifest or hash unavailable)"));
  1832→              }
  1833→              if (status.agentsMd.generatedAt) {
  1834→                console.log(`  Generated: ${status.agentsMd.generatedAt}`);
  1835→              }
  1836→            } else {
  1837→              console.log(`  Status: ${chalk.red("missing")}`);
  1838→              console.log(
  1839→                chalk.gray("  Run 'kspec setup' to generate"),
  1840→              );
  1841→            }
  1842→            console.log();
  1843→
  1844→            // Seeding status
  1845→            console.log(chalk.gray("Seeding:"));
  1846→            console.log(
  1847→              `  Permissions: ${status.seeding.permissionsSeeded ? chalk.green("✓") : chalk.gray("○")}`,
  1848→            );
  1849→            console.log(
  1850→              `  Memory:      ${status.seeding.memorySeeded ? chalk.green("✓") : chalk.gray("○")}`,
  1851→            );
  1852→            if (status.seeding.memoryPath) {
  1853→              console.log(
  1854→                chalk.gray(`  Path: ${status.seeding.memoryPath}`),
  1855→              );
  1856→            }
  1857→          });
  1858→          return;
  1859→        }
  1860→
  1861→        // AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
  1862→        const worktreeReady = await ensureWorktree(
  1863→          options.autoWorktree || false,
  1864→        );
  1865→        if (!worktreeReady) {
  1866→          // User declined worktree creation or it failed
  1867→          process.exit(EXIT_CODES.ERROR);
  1868→        }
  1869→
  1870→        const detected = detectAgent();
  1871→        const dryRun = options.dryRun || false;
  1872→
  1873→        if (detected.type === "unknown") {
  1874→          warn("Could not auto-detect agent environment");
  1875→          printManualInstructions("unknown");
  1876→          return;
  1877→        }
  1878→
  1879→        // AC: @setup-pipeline-unification ac-3 - delegate to runSetupPipeline()
  1880→        // One code path for both 'kspec setup' and 'kspec init --setup'
  1881→        const result = await runSetupPipeline(projectDir, {
  1882→          dryRun,
  1883→          skipSkills: options.skipSkills || false,
  1884→          installHooks: options.hooks !== false,
  1885→          force: options.force || false,
  1886→          author: options.author,
  1887→          configureAuthor: true,
  1888→        });
  1889→
  1890→        // AC: @enhanced-setup ac-1 - Display summary
  1891→        // AC: @enhanced-setup ac-6 - dry-run displays planned actions
  1892→        output(
  1893→          {
  1894→            dry_run: dryRun,
  1895→            steps: result.steps.map((s) => ({
  1896→              name: s.name,
  1897→              status: s.status,
  1898→              message: s.message,
  1899→              details: s.details,
  1900→            })),
  1901→          },
  1902→          () => {
  1903→            if (dryRun) {
  1904→              console.log(chalk.yellow("DRY RUN - No changes made\n"));
  1905→            }
  1906→
  1907→            // Pipeline already prints the summary when not dry-run
  1908→            // For dry-run, print it here since the pipeline skips output
  1909→            if (dryRun) {
  1910→              console.log(chalk.bold("kspec Setup Summary\n"));
  1911→
  1912→              for (const step of result.steps) {
  1913→                const icon =
  1914→                  step.status === "done"
  1915→                    ? chalk.green("✓")
  1916→                    : step.status === "skipped"
  1917→                      ? chalk.gray("○")
  1918→                      : chalk.red("✗");
  1919→                const statusText =
  1920→                  step.status === "done"
  1921→                    ? ""
  1922→                    : step.status === "skipped"
  1923→                      ? chalk.gray(" (skipped)")
  1924→                      : chalk.red(" (failed)");
  1925→
  1926→                console.log(`${icon} ${step.name}${statusText}`);
  1927→                if (step.message) {
  1928→                  console.log(chalk.gray(`  ${step.message}`));
  1929→                }
  1930→              }
  1931→            }
  1932→
  1933→            console.log();
  1934→
  1935→            if (dryRun) {
  1936→              console.log(
  1937→                chalk.yellow("Run without --dry-run to apply changes."),
  1938→              );
  1939→            } else {
  1940→              console.log(
  1941→                chalk.green("Setup complete."),
  1942→              );
  1943→              console.log(
  1944→                chalk.gray("Restart your agent session for changes to take effect."),
  1945→              );
  1946→            }
  1947→          },
  1948→        );
  1949→      } catch (err) {
  1950→        error(errors.failures.setupFailed, err);
  1951→        process.exit(EXIT_CODES.ERROR);
  1952→      }
  1953→    });
  1954→}
  1955→
```