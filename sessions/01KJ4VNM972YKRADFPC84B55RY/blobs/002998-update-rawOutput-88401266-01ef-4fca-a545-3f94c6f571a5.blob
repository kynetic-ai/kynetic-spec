     1→/**
     2→ * Project-level configuration for kspec.
     3→ *
     4→ * Loads kspec.config.yaml from the project root (main branch) before shadow
     5→ * branch detection. All fields are optional with backward-compatible defaults.
     6→ *
     7→ * Priority: env vars > config file > defaults
     8→ *
     9→ * @module
    10→ */
    11→
    12→import * as fs from "node:fs/promises";
    13→import * as path from "node:path";
    14→import { z } from "zod";
    15→import * as YAML from "yaml";
    16→import { getGitRoot } from "./shadow.js";
    17→
    18→// ── Schema ──────────────────────────────────────────────────────────────
    19→
    20→/**
    21→ * Schema for shadow branch configuration.
    22→ *
    23→ * AC: @config-shadow — shadow.branch, shadow.directory, shadow.remote configurable
    24→ */
    25→const ShadowConfigSchema = z
    26→  .object({
    27→    /** Branch name for shadow branch (default: kspec-meta) */
    28→    branch: z.string().optional(),
    29→    /** Worktree directory name (default: .kspec) */
    30→    directory: z.string().optional(),
    31→    /**
    32→     * Remote target for shadow branch. Can be:
    33→     * - Named remote (e.g., "origin", "specs-origin")
    34→     * - Local filesystem path (starts with /, ./, or ~)
    35→     * - Git URL (contains :// or starts with git@)
    36→     */
    37→    remote: z.string().optional(),
    38→  })
    39→  .strict()
    40→  .optional();
    41→
    42→/**
    43→ * Schema for identity configuration.
    44→ */
    45→const IdentityConfigSchema = z
    46→  .object({
    47→    /** Default author for notes/tasks (overridden by KSPEC_AUTHOR env var) */
    48→    author: z.string().optional(),
    49→  })
    50→  .strict()
    51→  .optional();
    52→
    53→/**
    54→ * Schema for validation configuration.
    55→ *
    56→ * AC: @config-validation — validation settings configurable in kspec.config.yaml
    57→ */
    58→const ValidationConfigSchema = z
    59→  .object({
    60→    /**
    61→     * When true, dangling references are treated as errors instead of warnings.
    62→     * AC: @config-validation ac-2 ac-3 — strict_refs configurable
    63→     */
    64→    strict_refs: z.boolean().optional(),
    65→    /**
    66→     * When true, specs missing acceptance criteria are reported as errors not warnings.
    67→     * AC: @config-validation ac-1 — require_acceptance configurable
    68→     */
    69→    require_acceptance: z.boolean().optional(),
    70→  })
    71→  .strict()
    72→  .optional();
    73→
    74→/**
    75→ * Schema for daemon configuration.
    76→ *
    77→ * AC: @config-daemon — daemon.port, daemon.auto_start configurable
    78→ */
    79→const DaemonConfigSchema = z
    80→  .object({
    81→    /** Default port for daemon (default: 3456) */
    82→    port: z.number().int().min(1).max(65535).optional(),
    83→    /** Host to bind to (default: localhost) */
    84→    host: z.string().optional(),
    85→    /**
    86→     * Whether to auto-start daemon when running kspec commands.
    87→     * AC: @config-daemon ac-3 — auto_start configurable
    88→     */
    89→    auto_start: z.boolean().optional(),
    90→  })
    91→  .strict()
    92→  .optional();
    93→
    94→/**
    95→ * Complete schema for kspec.config.yaml.
    96→ *
    97→ * AC: @project-config ac-4 — unknown fields are ignored via passthrough
    98→ */
    99→export const KspecConfigSchema = z
   100→  .object({
   101→    /** Shadow branch configuration */
   102→    shadow: ShadowConfigSchema,
   103→    /** Identity configuration */
   104→    identity: IdentityConfigSchema,
   105→    /** Validation configuration */
   106→    validation: ValidationConfigSchema,
   107→    /** Daemon configuration */
   108→    daemon: DaemonConfigSchema,
   109→  })
   110→  .passthrough(); // AC: ac-4 — ignore unknown fields
   111→
   112→/**
   113→ * Raw config type as parsed from YAML file.
   114→ */
   115→export type KspecConfig = z.infer<typeof KspecConfigSchema>;
   116→
   117→/**
   118→ * Remote type for shadow branch configuration.
   119→ * - "named": Git remote name (e.g., "origin", "specs-origin")
   120→ * - "path": Local filesystem path
   121→ * - "url": Git URL (https://, git@, etc.)
   122→ */
   123→export type ShadowRemoteType = "named" | "path" | "url";
   124→
   125→/**
   126→ * Resolved shadow remote configuration.
   127→ */
   128→export interface ResolvedShadowRemote {
   129→  /** The remote value from config */
   130→  value: string;
   131→  /** Detected type of the remote */
   132→  type: ShadowRemoteType;
   133→}
   134→
   135→/**
   136→ * Detect the type of a shadow remote string.
   137→ *
   138→ * AC: @config-shadow ac-3 ac-4 ac-5 — remote type detection
   139→ *
   140→ * @param remote Remote string from config
   141→ * @returns Detected type: "path" for filesystem, "url" for git URLs, "named" for git remote names
   142→ */
   143→export function detectRemoteType(remote: string): ShadowRemoteType {
   144→  // AC: ac-4 — Local filesystem path (starts with /, ./, ../, or ~)
   145→  if (
   146→    remote.startsWith("/") ||
   147→    remote.startsWith("./") ||
   148→    remote.startsWith("../") ||
   149→    remote.startsWith("~")
   150→  ) {
   151→    return "path";
   152→  }
   153→  // AC: ac-5 — Git URL (contains :// or starts with git@)
   154→  if (remote.includes("://") || remote.startsWith("git@")) {
   155→    return "url";
   156→  }
   157→  // AC: ac-3 — Otherwise it's a named remote
   158→  return "named";
   159→}
   160→
   161→/**
   162→ * Resolved config with all values finalized (env vars applied, defaults filled).
   163→ */
   164→export interface ResolvedKspecConfig {
   165→  shadow: {
   166→    /** Branch name (default: kspec-meta) */
   167→    branch: string;
   168→    /** Worktree directory name (default: .kspec) */
   169→    directory: string;
   170→    /** Remote configuration, null if not specified */
   171→    remote: ResolvedShadowRemote | null;
   172→  };
   173→  identity: {
   174→    author: string | null;
   175→  };
   176→  validation: {
   177→    /**
   178→     * When true, dangling references are treated as errors instead of warnings.
   179→     * AC: @config-validation ac-2 ac-3
   180→     */
   181→    strict_refs: boolean;
   182→    /**
   183→     * When true, specs missing acceptance criteria are reported as errors not warnings.
   184→     * AC: @config-validation ac-1
   185→     */
   186→    require_acceptance: boolean;
   187→  };
   188→  daemon: {
   189→    port: number;
   190→    host: string;
   191→    /**
   192→     * Whether to auto-start daemon when running kspec commands.
   193→     * AC: @config-daemon ac-3
   194→     */
   195→    auto_start: boolean;
   196→  };
   197→}
   198→
   199→// ── Defaults ────────────────────────────────────────────────────────────
   200→
   201→/**
   202→ * Default configuration values.
   203→ *
   204→ * AC: @project-config ac-1 — these are the current defaults
   205→ */
   206→const DEFAULT_CONFIG: ResolvedKspecConfig = {
   207→  shadow: {
   208→    branch: "kspec-meta",
   209→    directory: ".kspec",
   210→    remote: null,
   211→  },
   212→  identity: {
   213→    author: null,
   214→  },
   215→  validation: {
   216→    // AC: @config-validation — defaults preserve existing behavior
   217→    // strict_refs: true = dangling refs are errors (existing behavior)
   218→    // require_acceptance: false = missing AC is warning (existing behavior)
   219→    strict_refs: true,
   220→    require_acceptance: false,
   221→  },
   222→  daemon: {
   223→    port: 3456,
   224→    host: "localhost",
   225→    auto_start: true, // AC: @config-daemon — default auto-start enabled
   226→  },
   227→};
   228→
   229→// ── Loading ─────────────────────────────────────────────────────────────
   230→
   231→const CONFIG_FILENAME = "kspec.config.yaml";
   232→
   233→/**
   234→ * Result of loading project config.
   235→ */
   236→export interface LoadConfigResult {
   237→  /** Resolved configuration with all values finalized */
   238→  config: ResolvedKspecConfig;
   239→  /** Path to config file if found, null otherwise */
   240→  configPath: string | null;
   241→  /** Warning message if config had issues but was recoverable */
   242→  warning: string | null;
   243→  /** The git root directory where config was loaded from */
   244→  gitRoot: string | null;
   245→}
   246→
   247→/**
   248→ * Find git root directory, handling KSPEC_SPEC_DIR batch mode.
   249→ *
   250→ * AC: @project-config ac-7 — in batch mode, we need the REAL project root
   251→ *
   252→ * When KSPEC_SPEC_DIR is set (batch atomic mode), the cwd might be the temp
   253→ * directory. We need to find the real project root by checking:
   254→ * 1. If KSPEC_BATCH_PROJECT_ROOT is set, use that (set by batch executor)
   255→ * 2. Otherwise, use git root from cwd
   256→ *
   257→ * AC: @project-config ac-6 — loads from git root, not cwd subdirectory
   258→ */
   259→export function findProjectRoot(startDir: string): string | null {
   260→  // In batch mode, the batch executor should set this to the real root
   261→  // before redirecting KSPEC_SPEC_DIR
   262→  const batchRoot = process.env.KSPEC_BATCH_PROJECT_ROOT;
   263→  if (batchRoot) {
   264→    return batchRoot;
   265→  }
   266→
   267→  // Normal mode: find git root
   268→  return getGitRoot(startDir);
   269→}
   270→
   271→/**
   272→ * Load project configuration from kspec.config.yaml.
   273→ *
   274→ * AC: @project-config ac-1 — no config = all defaults
   275→ * AC: @project-config ac-2 — config parsed and available before shadow detection
   276→ * AC: @project-config ac-3 — invalid YAML = defaults + warning
   277→ * AC: @project-config ac-4 — unknown fields ignored
   278→ * AC: @project-config ac-5 — env vars take precedence
   279→ * AC: @project-config ac-6 — loads from git root
   280→ * AC: @project-config ac-7 — batch mode uses real project root
   281→ *
   282→ * @param startDir Starting directory for git root detection
   283→ */
   284→export async function loadProjectConfig(
   285→  startDir: string = process.cwd(),
   286→): Promise<LoadConfigResult> {
   287→  const gitRoot = findProjectRoot(startDir);
   288→
   289→  if (!gitRoot) {
   290→    // Not in a git repo, use defaults
   291→    return {
   292→      config: resolveConfig(null),
   293→      configPath: null,
   294→      warning: null,
   295→      gitRoot: null,
   296→    };
   297→  }
   298→
   299→  const configPath = path.join(gitRoot, CONFIG_FILENAME);
   300→
   301→  // Check if config file exists
   302→  try {
   303→    await fs.access(configPath);
   304→  } catch {
   305→    // AC: ac-1 — no config file, use defaults
   306→    return {
   307→      config: resolveConfig(null),
   308→      configPath: null,
   309→      warning: null,
   310→      gitRoot,
   311→    };
   312→  }
   313→
   314→  // Try to load and parse config
   315→  try {
   316→    const content = await fs.readFile(configPath, "utf-8");
   317→    const raw = YAML.parse(content);
   318→
   319→    // Validate against schema
   320→    const result = KspecConfigSchema.safeParse(raw);
   321→
   322→    if (!result.success) {
   323→      // AC: ac-3 — validation error = defaults + warning
   324→      const issues = result.error.issues
   325→        .map((i) => `${i.path.join(".")}: ${i.message}`)
   326→        .join("; ");
   327→      return {
   328→        config: resolveConfig(null),
   329→        configPath,
   330→        warning: `Config validation failed: ${issues}. Using defaults.`,
   331→        gitRoot,
   332→      };
   333→    }
   334→
   335→    // AC: ac-5 — apply env var overrides during resolution
   336→    return {
   337→      config: resolveConfig(result.data),
   338→      configPath,
   339→      warning: null,
   340→      gitRoot,
   341→    };
   342→  } catch (err) {
   343→    // AC: ac-3 — parse error = defaults + warning
   344→    const message = err instanceof Error ? err.message : String(err);
   345→    return {
   346→      config: resolveConfig(null),
   347→      configPath,
   348→      warning: `Failed to parse ${CONFIG_FILENAME}: ${message}. Using defaults.`,
   349→      gitRoot,
   350→    };
   351→  }
   352→}
   353→
   354→/**
   355→ * Resolve configuration by merging file config with env vars and defaults.
   356→ *
   357→ * Priority: env vars > config file > defaults
   358→ *
   359→ * AC: @project-config ac-5 — env vars take precedence
   360→ */
   361→export function resolveConfig(fileConfig: KspecConfig | null): ResolvedKspecConfig {
   362→  const file = fileConfig || {};
   363→
   364→  // Get env var overrides
   365→  const envAuthor = process.env.KSPEC_AUTHOR;
   366→  const envPort = process.env.KSPEC_DAEMON_PORT
   367→    ? parseInt(process.env.KSPEC_DAEMON_PORT, 10)
   368→    : undefined;
   369→  const envHost = process.env.KSPEC_DAEMON_HOST;
   370→
   371→  // Resolve shadow remote if specified
   372→  const remoteValue = file.shadow?.remote;
   373→  const resolvedRemote: ResolvedShadowRemote | null = remoteValue
   374→    ? { value: remoteValue, type: detectRemoteType(remoteValue) }
   375→    : DEFAULT_CONFIG.shadow.remote;
   376→
   377→  return {
   378→    shadow: {
   379→      branch: file.shadow?.branch ?? DEFAULT_CONFIG.shadow.branch,
   380→      directory: file.shadow?.directory ?? DEFAULT_CONFIG.shadow.directory,
   381→      remote: resolvedRemote,
   382→    },
   383→    identity: {
   384→      // AC: ac-5 — env var takes precedence
   385→      author: envAuthor ?? file.identity?.author ?? DEFAULT_CONFIG.identity.author,
   386→    },
   387→    validation: {
   388→      // AC: @config-validation ac-2 ac-3 — strict_refs from config
   389→      strict_refs:
   390→        file.validation?.strict_refs ?? DEFAULT_CONFIG.validation.strict_refs,
   391→      // AC: @config-validation ac-1 — require_acceptance from config
   392→      require_acceptance:
   393→        file.validation?.require_acceptance ?? DEFAULT_CONFIG.validation.require_acceptance,
   394→    },
   395→    daemon: {
   396→      // AC: ac-5 — env vars take precedence
   397→      port:
   398→        (envPort && !isNaN(envPort) ? envPort : undefined) ??
   399→        file.daemon?.port ??
   400→        DEFAULT_CONFIG.daemon.port,
   401→      // AC: @config-daemon ac-5 ac-6 — host from config/env
   402→      host: envHost ?? file.daemon?.host ?? DEFAULT_CONFIG.daemon.host,
   403→      // AC: @config-daemon ac-3 — auto_start from config
   404→      auto_start: file.daemon?.auto_start ?? DEFAULT_CONFIG.daemon.auto_start,
   405→    },
   406→  };
   407→}
   408→
   409→/**
   410→ * Get the default configuration (no file, no env vars).
   411→ * Useful for testing or when config loading fails completely.
   412→ * Returns a deep copy to prevent mutation of shared defaults.
   413→ */
   414→export function getDefaultConfig(): ResolvedKspecConfig {
   415→  return {
   416→    shadow: {
   417→      branch: DEFAULT_CONFIG.shadow.branch,
   418→      directory: DEFAULT_CONFIG.shadow.directory,
   419→      remote: DEFAULT_CONFIG.shadow.remote,
   420→    },
   421→    identity: { ...DEFAULT_CONFIG.identity },
   422→    validation: {
   423→      strict_refs: DEFAULT_CONFIG.validation.strict_refs,
   424→      require_acceptance: DEFAULT_CONFIG.validation.require_acceptance,
   425→    },
   426→    daemon: {
   427→      port: DEFAULT_CONFIG.daemon.port,
   428→      host: DEFAULT_CONFIG.daemon.host,
   429→      auto_start: DEFAULT_CONFIG.daemon.auto_start,
   430→    },
   431→  };
   432→}
   433→