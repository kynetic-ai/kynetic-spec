    70→
    71→// ─── Task Limit Marker ──────────────────────────────────────────────────────
    72→
    73→/**
    74→ * Marker file schema for task limit enforcement.
    75→ * AC: @ralph-task-limit ac-marker-format
    76→ */
    77→interface TaskLimitMarker {
    78→  active: boolean;
    79→  since: string; // ISO8601
    80→  max: number;
    81→  completed: number;
    82→  sessionId: string;
    83→}
    84→
    85→const TASK_LIMIT_MARKER_PATH = ".claude/ralph-task-limit.json";
    86→const END_LOOP_MARKER_PATH = ".claude/ralph-end-loop.json";
    87→const STALE_MARKER_THRESHOLD_MS = 60 * 60 * 1000; // 1 hour
    88→
    89→// ─── End Loop Marker ────────────────────────────────────────────────────────
    90→
    91→/**
    92→ * Marker file schema for explicit end-loop signaling.
    93→ * AC: @ralph-end-loop ac-cmd
    94→ */
    95→interface EndLoopMarker {
    96→  requested: boolean;
    97→  timestamp: string; // ISO8601
    98→  reason?: string;
    99→}
   100→
   101→/**
   102→ * Write task limit marker file.
   103→ * AC: @ralph-task-limit ac-wrapup, ac-marker-format
   104→ */
   105→async function writeTaskLimitMarker(
   106→  rootDir: string,
   107→  marker: TaskLimitMarker,
   108→): Promise<void> {
   109→  const markerPath = path.join(rootDir, TASK_LIMIT_MARKER_PATH);
   110→  const dir = path.dirname(markerPath);
   111→  await fs.mkdir(dir, { recursive: true });
   112→  await fs.writeFile(markerPath, JSON.stringify(marker, null, 2));
   113→}
   114→
   115→/**
   116→ * Read task limit marker file if it exists.
   117→ */
   118→async function readTaskLimitMarker(
   119→  rootDir: string,
   120→): Promise<TaskLimitMarker | null> {
   121→  const markerPath = path.join(rootDir, TASK_LIMIT_MARKER_PATH);
   122→  try {
   123→    const content = await fs.readFile(markerPath, "utf-8");
   124→    return JSON.parse(content) as TaskLimitMarker;
   125→  } catch {
   126→    return null;
   127→  }
   128→}
   129→
   130→/**
   131→ * Clear task limit marker file.
   132→ * AC: @ralph-task-limit ac-reset
   133→ */
   134→async function clearTaskLimitMarker(rootDir: string): Promise<void> {
   135→  const markerPath = path.join(rootDir, TASK_LIMIT_MARKER_PATH);
   136→  try {
   137→    await fs.unlink(markerPath);
   138→  } catch {
   139→    // Ignore if file doesn't exist
   140→  }
   141→}
   142→
   143→/**
   144→ * Clear stale marker files (older than 1 hour).
   145→ * AC: @ralph-task-limit ac-reset
   146→ */
   147→async function clearStaleMarker(rootDir: string): Promise<boolean> {
   148→  const marker = await readTaskLimitMarker(rootDir);
   149→  if (!marker) return false;
   150→
   151→  const markerAge = Date.now() - new Date(marker.since).getTime();
   152→  if (markerAge > STALE_MARKER_THRESHOLD_MS) {
   153→    await clearTaskLimitMarker(rootDir);
   154→    return true;
   155→  }
   156→  return false;
   157→}
   158→
   159→/**
   160→ * Write end-loop marker file.
   161→ * AC: @ralph-end-loop ac-cmd
   162→ */
   163→async function writeEndLoopMarker(
   164→  rootDir: string,
   165→  reason?: string,
   166→): Promise<void> {
   167→  const markerPath = path.join(rootDir, END_LOOP_MARKER_PATH);
   168→  const dir = path.dirname(markerPath);
   169→  await fs.mkdir(dir, { recursive: true });
   170→  const marker: EndLoopMarker = {
   171→    requested: true,
   172→    timestamp: new Date().toISOString(),
   173→    reason,
   174→  };
   175→  await fs.writeFile(markerPath, JSON.stringify(marker, null, 2));
   176→}
   177→
   178→/**
   179→ * Read end-loop marker file if it exists.
   180→ * AC: @ralph-end-loop ac-detect
   181→ */
   182→async function readEndLoopMarker(
   183→  rootDir: string,
   184→): Promise<EndLoopMarker | null> {
   185→  const markerPath = path.join(rootDir, END_LOOP_MARKER_PATH);
   186→  try {
   187→    const content = await fs.readFile(markerPath, "utf-8");
   188→    return JSON.parse(content) as EndLoopMarker;
   189→  } catch {
   190→    return null;
   191→  }
   192→}
   193→
   194→/**
   195→ * Clear end-loop marker file.
   196→ * AC: @ralph-end-loop ac-cleanup
   197→ */
   198→async function clearEndLoopMarker(rootDir: string): Promise<void> {
   199→  const markerPath = path.join(rootDir, END_LOOP_MARKER_PATH);
   200→  try {
   201→    await fs.unlink(markerPath);
   202→  } catch {
   203→    // Ignore if file doesn't exist
   204→  }
   205→}
   206→
   207→/**
   208→ * Clear stale end-loop markers (older than 1 hour).
   209→ * AC: @ralph-end-loop ac-cleanup
   210→ */
   211→async function clearStaleEndLoopMarker(rootDir: string): Promise<boolean> {
   212→  const marker = await readEndLoopMarker(rootDir);
   213→  if (!marker) return false;
   214→
   215→  const markerAge = Date.now() - new Date(marker.timestamp).getTime();
   216→  if (markerAge > STALE_MARKER_THRESHOLD_MS) {
   217→    await clearEndLoopMarker(rootDir);
   218→    return true;
   219→  }
   220→  return false;
   221→}
   222→
   223→/**
   224→ * Detect if a Bash command is a task complete command.
   225→ * AC: @ralph-task-limit ac-detection
   226→ */
   227→function detectTaskCompleteCommand(command: string): boolean {
   228→  // Match variations of "kspec task complete"
   229→  // Don't match "kspec task submit" - that's just status change to pending_review
   230→  return /\bkspec\s+task\s+complete\b/.test(command);
   231→}
   232→
   233→/**
   234→ * Detect if a Bash command is an end-loop command.
   235→ * AC: @ralph-end-loop ac-detect
   236→ */
   237→function detectEndLoopCommand(command: string): boolean {
   238→  // Match "kspec ralph end-loop" with any arguments
   239→  return /\bkspec\s+ralph\s+end-loop\b/.test(command);
   240→}
   241→
   242→/**
   243→ * Extract Bash command from SessionUpdate if it's a tool_call or tool_call_update event.
   244→ * Returns null if not a Bash tool call.
   245→ */
   246→function extractBashCommand(update: SessionUpdate): string | null {
   247→  const u = update as Record<string, unknown>;
   248→
   249→  // Check if this is a tool call event
   250→  if (u.sessionUpdate !== "tool_call" && u.sessionUpdate !== "tool_call_update") {
   251→    return null;
   252→  }
   253→
   254→  // Extract tool name - check various locations Claude Code uses
   255→  let toolName: string | undefined;
   256→
   257→  // Try _meta.claudeCode.toolName first (Claude Code pattern)
   258→  const meta = u._meta as Record<string, unknown> | undefined;
   259→  if (meta) {
   260→    const claudeCode = meta.claudeCode as Record<string, unknown> | undefined;
   261→    if (claudeCode?.toolName) {
   262→      toolName = String(claudeCode.toolName);
   263→    } else if (meta.toolName) {
   264→      toolName = String(meta.toolName);
   265→    }
   266→  }
   267→
   268→  // Fall back to name or title field
   269→  if (!toolName && u.name) {
   270→    toolName = String(u.name);
   271→  }
   272→  if (!toolName && u.title) {
   273→    toolName = String(u.title);
   274→  }
   275→
   276→  // Check if it's a Bash tool (handle MCP prefix variations)
   277→  if (!toolName) return null;
   278→  const isBash = toolName === "Bash" || toolName.endsWith("__Bash");
   279→  if (!isBash) return null;
   280→
   281→  // Extract command from input
   282→  const input = (u.rawInput || u.input || u.params) as Record<string, unknown> | undefined;
   283→  if (!input) return null;
   284→
   285→  const command = input.command;
   286→  if (typeof command !== "string") return null;
   287→
   288→  return command;
   289→}
   290→
   291→// ─── Explicit Task Scope ─────────────────────────────────────────────────────
   292→
   293→/**
   294→ * Parsed explicit task scope for --tasks flag.
   295→ * AC: @cli-ralph ac-21
   296→ */
   297→interface ExplicitTaskScope {
   298→  /** Original refs as provided by user */
   299→  refs: string[];
   300→  /** Resolved ULIDs for the tasks */
   301→  ulids: string[];
   302→}
   303→
   304→/**
   305→ * Parse and validate --tasks flag value.
   306→ * Returns resolved ULIDs for the specified task refs.
   307→ * AC: @cli-ralph ac-21
   308→ *
   309→ * @throws Error if any ref cannot be resolved or is not a task
   310→ */
   311→async function parseExplicitTasks(
   312→  ctx: KspecContext,
   313→  tasksArg: string,
   314→): Promise<ExplicitTaskScope> {
   315→  const refs = tasksArg.split(",").map((r) => r.trim()).filter(Boolean);
   316→
   317→  if (refs.length === 0) {
   318→    throw new Error("--tasks requires at least one task reference");
   319→  }
   320→
   321→  // Load tasks and items for resolution
   322→  const tasks = await loadAllTasks(ctx);
   323→  const items = await loadAllItems(ctx);
   324→  const index = new ReferenceIndex(tasks, items);
   325→
   326→  const ulids: string[] = [];
   327→
   328→  for (const ref of refs) {
   329→    const result = index.resolve(ref);
   330→    if (!result.ok) {
   331→      throw new Error(`Cannot resolve task reference: ${ref}`);
   332→    }
   333→
   334→    // Verify it's a task (not a spec item)
   335→    const task = tasks.find((t) => t._ulid === result.ulid);
   336→    if (!task) {
   337→      throw new Error(`Reference ${ref} is not a task`);
   338→    }
   339→
   340→    ulids.push(result.ulid);
   341→  }
   342→
   343→  return { refs, ulids };
   344→}
   345→
   346→/**
   347→ * Filter session context to only include tasks from explicit scope.
   348→ * AC: @cli-ralph ac-21
   349→ */
   350→function filterByExplicitTasks(
   351→  ctx: SessionContext,
   352→  scope: ExplicitTaskScope,
   353→): SessionContext {
   354→  // Task refs in context are short ULIDs (variable length from shortUlid())
   355→  // Check if the context ref is a prefix of any explicit ULID
   356→  const matchesScope = (taskRef: string) => {
   357→    return scope.ulids.some((ulid) => ulid.startsWith(taskRef));
   358→  };
   359→
   360→  return {
   361→    ...ctx,
   362→    active_tasks: ctx.active_tasks.filter((t) => matchesScope(t.ref)),
   363→    pending_review_tasks: ctx.pending_review_tasks.filter((t) => matchesScope(t.ref)),
   364→    ready_tasks: ctx.ready_tasks.filter((t) => matchesScope(t.ref)),
   365→  };
   366→}
   367→
   368→/**
   369→ * Check if all explicit tasks are completed or blocked.
   370→ * AC: @cli-ralph ac-21
   371→ */
   372→async function allExplicitTasksDone(
   373→  ctx: KspecContext,
   374→  scope: ExplicitTaskScope,
   375→): Promise<{ done: boolean; statuses: Map<string, string> }> {
   376→  const tasks = await loadAllTasks(ctx);
   377→  const statuses = new Map<string, string>();
   378→
   379→  for (const ulid of scope.ulids) {
   380→    const task = tasks.find((t) => t._ulid === ulid);
   381→    if (task) {
   382→      statuses.set(ulid.slice(0, 8), task.status);
   383→    }
   384→  }
   385→
   386→  // Check if all are completed or blocked
   387→  const done = scope.ulids.every((ulid) => {
   388→    const status = statuses.get(ulid.slice(0, 8));
   389→    return status === "completed" || status === "blocked";
   390→  });
   391→
   392→  return { done, statuses };
   393→}
   394→
   395→// ─── Prompt Template ─────────────────────────────────────────────────────────
   396→
   397→// AC: @ralph-skill-delegation ac-1, ac-2, ac-3
   398→function buildTaskWorkPrompt(
   399→  sessionCtx: SessionContext,
   400→  iteration: number,
   401→  maxLoops: number,
   402→  sessionId: string,
   403→  focus?: string,
   404→  explicitTaskScope?: ExplicitTaskScope,
   405→): string {
   406→  const focusSection = focus
   407→    ? `
   408→## Session Focus (applies to ALL iterations)
   409→
   410→> **${focus}**
   411→
   412→Keep this focus in mind throughout your work. It takes priority over default task selection.
   413→`
   414→    : "";
   415→
   416→  // AC: @cli-ralph ac-21 - Explicit task scope indicator in prompt
   417→  const taskScopeSection = explicitTaskScope
   418→    ? `
   419→## Explicit Task Scope
   420→
   421→This session is scoped to specific tasks: ${explicitTaskScope.refs.join(", ")}
   422→
   423→**Only work on these tasks.** The loop will exit when all listed tasks are completed or blocked.
   424→`
   425→    : "";
   426→
   427→  const modeDescription = explicitTaskScope
   428→    ? "Loop mode means: no confirmations, auto-resolve decisions, explicit task scope (only the listed tasks)."
   429→    : "Loop mode means: no confirmations, auto-resolve decisions, automation-eligible tasks only.";
   430→
   431→  return `# Kspec Automation Session - Task Work
   432→
   433→**Session ID:** \`${sessionId}\`
   434→**Iteration:** ${iteration} of ${maxLoops}
   435→**Mode:** Automated (no human in the loop)
   436→${focusSection}${taskScopeSection}
   437→
   438→## Current State
   439→\`\`\`json
   440→${JSON.stringify(sessionCtx, null, 2)}
   441→\`\`\`
   442→
   443→## Instructions
   444→
   445→Run the task-work skill in loop mode:
   446→
   447→\`\`\`
   448→/task-work loop
   449→\`\`\`
   450→
   451→${modeDescription}
   452→
   453→**Normal flow:** Work on a task, create a PR, then stop responding. Ralph continues automatically —
   454→it checks for remaining eligible tasks at the start of each iteration and exits the loop itself when none remain.
   455→
   456→**Do NOT call \`end-loop\` after completing a task.** Simply stop responding.
   457→\`end-loop\` is a rare escape hatch for when work is stalling across multiple iterations with no progress — not a normal exit path.
   458→`;
   459→}
   460→
   461→/**
   462→ * Build the reflect prompt sent after task-work completes.
   463→ * Ralph sends this as a separate prompt to ensure reflection always happens.
   464→ */
   465→function buildReflectPrompt(
   466→  iteration: number,
   467→  maxLoops: number,
   468→  sessionId: string,
   469→): string {
   470→  const isFinal = iteration === maxLoops;
   471→
   472→  return `# Kspec Automation Session - Reflection
   473→
   474→**Session ID:** \`${sessionId}\`
   475→**Iteration:** ${iteration} of ${maxLoops}
   476→**Phase:** Post-task reflection
   477→
   478→## Instructions
   479→
   480→Run the reflect skill in loop mode:
   481→
   482→\`\`\`
   483→/reflect loop
   484→\`\`\`
   485→
   486→Loop mode means: high-confidence captures only, must search existing before capturing, no user prompts.
   487→${
   488→  isFinal
   489→    ? `
   490→**FINAL ITERATION** - This is the last chance to capture insights from this session.
   491→`
   492→    : ""
   493→}
   494→Exit when reflection is complete.
   495→`;
   496→}
   497→
   498→// ─── Streaming Output ────────────────────────────────────────────────────────
   499→
   500→// Translator and renderer are created per-session in the action handler.
   501→// This allows the architecture to be reused by future TUI renderers.
   502→
   503→// ─── Adapter Validation ──────────────────────────────────────────────────────
   504→
   505→// AC: @ralph-adapter-validation valid-adapter-proceeds, invalid-adapter-error, validation-before-spawn
   506→/**
   507→ * Validate that the specified ACP adapter package exists.
   508→ * Uses npx --no-install to check both global and local node_modules.
   509→ *
   510→ * @throws {Error} Never throws - exits process with code 3 if validation fails
   511→ */
   512→function validateAdapter(adapterPackage: string): void {
   513→  // Use npx --no-install with --version to check if package exists
   514→  // This checks both global and local node_modules, handles scoped packages
   515→  const result = spawnSync(
   516→    "npx",
   517→    ["--no-install", adapterPackage, "--version"],
   518→    {
   519→      encoding: "utf-8",
   520→      stdio: "pipe",
   521→    },
   522→  );
   523→
   524→  if (result.status !== 0) {
   525→    error(
   526→      `Adapter package not found: ${adapterPackage}. Install with: npm install -g ${adapterPackage}`,
   527→    );
   528→    process.exit(EXIT_CODES.NOT_FOUND);
   529→  }
   530→}
   531→
   532→// ─── Tool Request Handler ────────────────────────────────────────────────────
   533→
   534→/**
   535→ * Handle tool requests from ACP agent.
   536→ * Implements file operations, terminal commands, and permission handling.
   537→ */
   538→async function handleRequest(
   539→  client: ACPClient,
   540→  id: string | number,
   541→  method: string,
   542→  params: unknown,
   543→  yolo: boolean,
   544→): Promise<void> {
   545→  try {
   546→    switch (method) {
   547→      case "session/request_permission": {
   548→        const p = params as RequestPermissionRequest;
   549→        // In yolo mode, auto-approve all permissions
   550→        // In normal mode, would need to implement permission UI
   551→        const options = p.options || [];
   552→
   553→        if (yolo) {
   554→          // Find an "allow" option (prefer allow_always, then allow_once)
   555→          const allowOption =
   556→            options.find((o) => o.kind === "allow_always") ||
   557→            options.find((o) => o.kind === "allow_once");
   558→
   559→          if (allowOption) {
   560→            client.respondPermission(id, {
   561→              outcome: { outcome: "selected", optionId: allowOption.optionId },
   562→            });
   563→          } else {
   564→            // No allow option available - cancel
   565→            client.respondPermission(id, { outcome: { outcome: "cancelled" } });
   566→          }
   567→        } else {
   568→          // TODO: Implement permission prompting
   569→          client.respondPermission(id, { outcome: { outcome: "cancelled" } });
   570→        }
   571→        break;
   572→      }
   573→
   574→      case "file/read": {
   575→        const p = params as ReadTextFileRequest;
   576→        const content = await fs.readFile(p.path, "utf-8");
   577→        client.respondReadTextFile(id, { content });
   578→        break;
   579→      }
   580→
   581→      case "file/write": {
   582→        const p = params as WriteTextFileRequest;
   583→        await fs.mkdir(path.dirname(p.path), { recursive: true });
   584→        await fs.writeFile(p.path, p.content, "utf-8");
   585→        client.respondWriteTextFile(id, {});
   586→        break;
   587→      }
   588→
   589→      case "terminal/run": {
   590→        // Custom method (not part of ACP spec - ACP uses createTerminal instead)
   591→        // TODO: Consider migrating to standard ACP terminal methods
   592→        const p = params as {
   593→          command: string;
   594→          cwd?: string;
   595→          timeout?: number;
   596→        };
   597→        const command = p.command;
   598→        const cwd = p.cwd || process.cwd();
   599→        const timeout = p.timeout || 60000;
   600→
   601→        const result = await new Promise<{
   602→          stdout: string;
   603→          stderr: string;
   604→          exitCode: number;
   605→        }>((resolve) => {
   606→          const child = spawn(command, [], {
   607→            cwd,
   608→            shell: true,
   609→            timeout,
   610→          });
   611→
   612→          let stdout = "";
   613→          let stderr = "";
   614→
   615→          child.stdout?.on("data", (data) => {
   616→            stdout += data.toString();
   617→          });
   618→
   619→          child.stderr?.on("data", (data) => {
   620→            stderr += data.toString();
   621→          });
   622→
   623→          child.on("close", (code) => {
   624→            resolve({ stdout, stderr, exitCode: code ?? 1 });
   625→          });
   626→
   627→          child.on("error", (err) => {
   628→            resolve({ stdout, stderr: err.message, exitCode: 1 });
   629→          });
   630→        });
   631→
   632→        // Using generic respond() since this is a custom method
   633→        client.respond(id, result);
   634→        break;
   635→      }
   636→
   637→      default:
   638→        // Unknown method - return error
   639→        client.respondError(id, -32601, `Method not found: ${method}`);
   640→    }
   641→  } catch (err) {
   642→    const message = err instanceof Error ? err.message : String(err);
   643→    client.respondError(id, -32000, message);
   644→  }
   645→}
   646→
   647→// ─── Subagent Support ─────────────────────────────────────────────────────────
   648→
   649→/**
   650→ * Build context for a PR review subagent.
   651→ * AC: @ralph-subagent-spawning ac-10
   652→ */
   653→async function buildSubagentContext(
   654→  ctx: KspecContext,
   655→  taskRef: string,
   656→): Promise<SubagentContext> {
   657→  // Load all tasks and items
   658→  const tasks = await loadAllTasks(ctx);
   659→  const items = await loadAllItems(ctx);
   660→  const index = new ReferenceIndex(tasks, items);
   661→
   662→  // Resolve task reference
   663→  const taskResult = index.resolve(taskRef);
   664→  if (!taskResult.ok) {
   665→    throw new Error(`Task not found: ${taskRef}`);
   666→  }
   667→
   668→  const task = tasks.find((t) => t._ulid === taskResult.ulid);
   669→  if (!task) {
   670→    throw new Error(`Task not found by ULID: ${taskResult.ulid}`);
   671→  }
   672→
   673→  // Get linked spec with ACs if spec_ref exists
   674→  let specWithACs: Record<string, unknown> | null = null;
   675→  if (task.spec_ref) {
   676→    const specResult = index.resolve(task.spec_ref);
   677→    if (specResult.ok) {
   678→      const item = items.find((i) => i._ulid === specResult.ulid);
   679→      if (item) {
   680→        specWithACs = item as unknown as Record<string, unknown>;
   681→      }
   682→    }
   683→  }
   684→
   685→  // Get git branch
   686→  const gitBranch = getCurrentBranch(ctx.rootDir) || "unknown";
   687→
   688→  return {
   689→    taskRef,
   690→    taskDetails: task as unknown as Record<string, unknown>,
   691→    specWithACs,
   692→    gitBranch,
   693→  };
   694→}
   695→
   696→/**
   697→ * Get the current status of a task.
   698→ * AC: @ralph-subagent-spawning ac-12
   699→ */
   700→function getTaskStatus(taskRef: string): string | null {
   701→  const result = spawnSync("kspec", ["task", "get", taskRef, "--json"], {
   702→    encoding: "utf-8",
   703→    stdio: "pipe",
   704→  });
   705→
   706→  if (result.status !== 0) {
   707→    warn(`Failed to check task status for ${taskRef}: ${result.stderr}`);
   708→    return null;
   709→  }
   710→
   711→  try {
   712→    return JSON.parse(result.stdout).status;
   713→  } catch {
   714→    warn(`Failed to parse task status for ${taskRef}`);
   715→    return null;
   716→  }
   717→}
   718→
   719→/**
   720→ * Mark a task as needing review due to subagent timeout.
   721→ * AC: @ralph-subagent-spawning ac-9
   722→ */
   723→async function markTaskNeedsReview(
   724→  taskRef: string,
   725→  reason: string,
   726→): Promise<void> {
   727→  const { spawnSync } = await import("node:child_process");
   728→
   729→  // Use kspec CLI to set automation status
   730→  const result = spawnSync(
   731→    "kspec",
   732→    ["task", "set-automation", taskRef, "needs_review"],
   733→    {
   734→      encoding: "utf-8",
   735→      stdio: "pipe",
   736→    },
   737→  );
   738→
   739→  if (result.status !== 0) {
   740→    warn(`Failed to mark task ${taskRef} as needs_review: ${result.stderr}`);
   741→  }
   742→
   743→  // Add a note explaining the timeout
   744→  const noteResult = spawnSync(
   745→    "kspec",
   746→    ["task", "note", taskRef, `[RALPH SUBAGENT] ${reason}`],
   747→    {
   748→      encoding: "utf-8",
   749→      stdio: "pipe",
   750→    },
   751→  );
   752→
   753→  if (noteResult.status !== 0) {
   754→    warn(`Failed to add timeout note to task ${taskRef}: ${noteResult.stderr}`);
   755→  }
   756→}
   757→
   758→/**
   759→ * Post a comment on the open PR for a task's branch, noting incomplete review.
   760→ * Uses `gh pr list --head <branch>` to find the PR and add a warning.
   761→ */
   762→async function commentOnPRReviewIncomplete(branch: string, reason: string): Promise<void> {
   763→  if (!branch || branch === "unknown") {
   764→    return;
   765→  }
   766→
   767→  const prListResult = spawnSync(
   768→    "gh",
   769→    ["pr", "list", "--state", "open", "--head", branch, "--json", "number", "--jq", ".[0].number"],
   770→    { encoding: "utf-8", stdio: "pipe" },
   771→  );
   772→
   773→  const prNumber = prListResult.stdout?.trim();
   774→  if (!prNumber || prListResult.status !== 0) {
   775→    // No open PR found — may already be merged or branch has no PR
   776→    return;
   777→  }
   778→
   779→  const body = `⚠️ **Review incomplete**: ${reason}\n\nThis PR was not fully reviewed by the ralph review subagent. Manual review recommended before merging.`;
   780→  const commentResult = spawnSync(
   781→    "gh",
   782→    ["pr", "comment", prNumber, "--body", body],
   783→    { encoding: "utf-8", stdio: "pipe" },
   784→  );
   785→
   786→  if (commentResult.status !== 0) {
   787→    warn(`Failed to comment on PR #${prNumber}: ${commentResult.stderr}`);
   788→  } else {
   789→    info(`${DEFAULT_SUBAGENT_PREFIX} Posted review-incomplete comment on PR #${prNumber}`);
   790→  }
   791→}
   792→
   793→/**
   794→ * Handle failed iteration by tracking per-task failures and escalating at threshold.
   795→ * AC: @loop-mode-error-handling ac-1, ac-2, ac-3, ac-4, ac-5, ac-8
   796→ */
   797→async function handleIterationFailure(
   798→  ctx: KspecContext,
   799→  tasksInProgressAtStart: ActiveTaskSummary[],
   800→  iterationStartTime: Date,
   801→  errorDescription: string,
   802→): Promise<void> {
   803→  if (tasksInProgressAtStart.length === 0) {
   804→    return;
   805→  }
   806→
   807→  // Re-load current tasks to check progress
   808→  const currentTasks = await loadAllTasks(ctx);
   809→  const index = new ReferenceIndex(currentTasks, await loadAllItems(ctx));
   810→
   811→  // Convert ActiveTaskSummary to Task-like objects for processing
   812→  const tasksInProgressFull = tasksInProgressAtStart
   813→    .map((summary) => {
   814→      const resolved = index.resolve(summary.ref);
   815→      if (!resolved.ok) return undefined;
   816→      // Check if the resolved item is a task (not a spec item or meta item)
   817→      const item = resolved.item;
   818→      if (!("status" in item)) return undefined; // Spec items don't have status
   819→      return currentTasks.find((t) => t._ulid === resolved.ulid);
   820→    })
   821→    .filter((t): t is LoadedTask => t !== undefined && t.status === "in_progress");
   822→
   823→  if (tasksInProgressFull.length === 0) {
   824→    return;
   825→  }
   826→
   827→  // Process failures
   828→  const { processFailedIteration, createFailureNote, getTaskFailureCount } = await import("../../ralph/index.js");
   829→
   830→  const results = processFailedIteration(
   831→    tasksInProgressFull,
   832→    currentTasks,
   833→    iterationStartTime,
   834→    errorDescription,
   835→  );
   836→
   837→  // Add notes and escalate tasks
   838→  for (const result of results) {
   839→    const taskRef = result.taskRef;
   840→    const task = currentTasks.find((t) => t._ulid === taskRef);
   841→    if (!task) continue;
   842→
   843→    const priorCount = result.failureCount - 1;
   844→    const noteContent = createFailureNote(taskRef, errorDescription, priorCount);
   845→
   846→    // Add LOOP-FAIL note
   847→    const noteResult = spawnSync(
   848→      "kspec",
   849→      ["task", "note", `@${taskRef}`, noteContent],
   850→      {
   851→        encoding: "utf-8",
   852→        stdio: "pipe",
   853→        cwd: process.cwd(),
   854→      },
   855→    );
   856→
   857→    if (noteResult.status !== 0) {
   858→      warn(`Failed to add failure note to task ${taskRef}: ${noteResult.stderr}`);
   859→      continue;
   860→    }
   861→
   862→    // AC: @loop-mode-error-handling ac-5 - Escalate at threshold
   863→    if (result.escalated) {
   864→      const escalateResult = spawnSync(
   865→        "kspec",
   866→        [
   867→          "task",
   868→          "set",
   869→          `@${taskRef}`,
   870→          "--automation",
   871→          "needs_review",
   872→          "--reason",
   873→          `Loop mode: 3 consecutive failures without progress`,
   874→        ],
   875→        {
   876→          encoding: "utf-8",
   877→          stdio: "pipe",
   878→          cwd: process.cwd(),
   879→        },
   880→      );
   881→
   882→      if (escalateResult.status !== 0) {
   883→        warn(`Failed to escalate task ${taskRef}: ${escalateResult.stderr}`);
   884→      } else {
   885→        info(`Escalated task ${taskRef} to automation:needs_review after 3 failures`);
   886→      }
   887→    }
   888→  }
   889→}
   890→
   891→/**
   892→ * Process pending_review tasks by spawning subagents.
   893→ * AC: @ralph-subagent-spawning ac-6, ac-8
   894→ */
   895→async function processPendingReviewTasks(
   896→  ctx: KspecContext,
   897→  adapter: AgentAdapter,
   898→  pendingReviewTasks: ActiveTaskSummary[],
   899→  options: {
   900→    yolo: boolean;
   901→    maxRetries: number;
   902→    maxFailures: number;
   903→    cwd: string;
   904→    subagentTimeout: number;
   905→  },
   906→  consecutiveFailures: { count: number },
   907→): Promise<boolean> {
   908→  if (pendingReviewTasks.length === 0) {
   909→    return true;
   910→  }
   911→
   912→  // Visual separator for subagent section
   913→  console.log("");
   914→  console.log(chalk.cyan(`${"═".repeat(60)}`));
   915→  console.log(chalk.cyan.bold(`${DEFAULT_SUBAGENT_PREFIX} Processing Pending Review Tasks`));
   916→  console.log(chalk.cyan(`${"═".repeat(60)}`));
   917→  console.log("");
   918→
   919→  info(
   920→    `${DEFAULT_SUBAGENT_PREFIX} Found ${pendingReviewTasks.length} pending_review task(s)`,
   921→  );
   922→
   923→  // AC: @ralph-subagent-spawning ac-6 - Process one at a time
   924→  for (const task of pendingReviewTasks) {
   925→    info(`${DEFAULT_SUBAGENT_PREFIX} Processing: ${task.ref} - ${task.title}`);
   926→
   927→    try {
   928→      // Build context for this task
   929→      const subagentCtx = await buildSubagentContext(ctx, task.ref);
   930→
   931→      // AC: @ralph-subagent-spawning ac-1, ac-3 - Spawn and wait
   932→      const result = await runSubagent(
   933→        adapter,
   934→        subagentCtx,
   935→        {
   936→          timeout: options.subagentTimeout,
   937→          outputPrefix: DEFAULT_SUBAGENT_PREFIX,
   938→        },
   939→        {
   940→          yolo: options.yolo,
   941→          cwd: options.cwd,
   942→          handleRequest: (client, reqId, method, params) =>
   943→            handleRequest(client, reqId, method, params, options.yolo),
   944→        },
   945→      );
   946→
   947→      if (result.timedOut) {
   948→        // AC: @ralph-subagent-spawning ac-9
   949→        warn(
   950→          `${DEFAULT_SUBAGENT_PREFIX} Subagent timed out for ${task.ref}`,
   951→        );
   952→        const timeoutMinutes = Math.round(options.subagentTimeout / 60000);
   953→        await markTaskNeedsReview(
   954→          task.ref,
   955→          `Subagent timed out after ${timeoutMinutes} minutes`,
   956→        );
   957→        await commentOnPRReviewIncomplete(subagentCtx.gitBranch, `Review subagent timed out after ${timeoutMinutes} minutes for task ${task.ref}.`);
   958→        consecutiveFailures.count++;
   959→      } else if (!result.success) {
   960→        // AC: @ralph-subagent-spawning ac-7
   961→        error(
   962→          `${DEFAULT_SUBAGENT_PREFIX} Subagent failed for ${task.ref}: ${result.error}`,
   963→        );
   964→        await commentOnPRReviewIncomplete(subagentCtx.gitBranch, `Review subagent failed for task ${task.ref}: ${result.error}`);
   965→        consecutiveFailures.count++;
   966→      } else {
   967→        // AC: @ralph-subagent-spawning ac-12 - Verify task outcome
   968→        const currentStatus = getTaskStatus(task.ref);
   969→
   970→        if (currentStatus === "completed") {
   971→          success(`${DEFAULT_SUBAGENT_PREFIX} Completed: ${task.ref}`);
   972→          consecutiveFailures.count = 0;
   973→        } else if (currentStatus === "needs_work") {
   974→          // Expected: reviewer found issues, kicked back to worker
   975→          info(`${DEFAULT_SUBAGENT_PREFIX} Review completed for ${task.ref} — issues found, kicked back to worker`);
   976→          // NOT a failure — the review worked correctly
   977→          consecutiveFailures.count = 0;
   978→        } else if (currentStatus === "pending_review") {
   979→          // Subagent didn't transition or merge — count as soft failure
   980→          warn(
   981→            `${DEFAULT_SUBAGENT_PREFIX} Subagent completed but task ${task.ref} unchanged`,
   982→          );
   983→          await markTaskNeedsReview(
   984→            task.ref,
   985→            "Subagent completed but did not merge or kick back. Review required.",
   986→          );
   987→          consecutiveFailures.count++;
   988→        } else {
   989→          warn(`${DEFAULT_SUBAGENT_PREFIX} Task ${task.ref} in unexpected state: ${currentStatus}`);
   990→          consecutiveFailures.count++;
   991→        }
   992→      }
   993→
   994→      // Check if we've hit max failures
   995→      if (consecutiveFailures.count >= options.maxFailures) {
   996→        error(
   997→          `${DEFAULT_SUBAGENT_PREFIX} Reached max failures (${options.maxFailures})`,
   998→        );
   999→        return false;
  1000→      }
  1001→    } catch (err) {
  1002→      const message = err instanceof Error ? err.message : String(err);
  1003→      error(`${DEFAULT_SUBAGENT_PREFIX} Error processing ${task.ref}: ${message}`);
  1004→      consecutiveFailures.count++;
  1005→
  1006→      if (consecutiveFailures.count >= options.maxFailures) {
  1007→        error(
  1008→          `${DEFAULT_SUBAGENT_PREFIX} Reached max failures (${options.maxFailures})`,
  1009→        );
  1010→        return false;
  1011→      }
  1012→    }
  1013→  }
  1014→
  1015→  // Visual separator at end of subagent section
  1016→  console.log("");
  1017→  console.log(chalk.cyan(`${"═".repeat(60)}`));
  1018→  console.log(chalk.cyan.bold(`${DEFAULT_SUBAGENT_PREFIX} Completed Review Processing`));
  1019→  console.log(chalk.cyan(`${"═".repeat(60)}`));
  1020→  console.log("");
  1021→
  1022→  return true;
  1023→}
  1024→
  1025→// ─── Command Registration ────────────────────────────────────────────────────
  1026→
  1027→export function registerRalphCommand(program: Command): void {
  1028→  const ralph = program
  1029→    .command("ralph")
  1030→    .description("Ralph automated task loop and agent control");
  1031→
  1032→  // end-loop subcommand - allows agent to signal loop termination
  1033→  // AC: @ralph-end-loop ac-cmd, ac-reason, ac-noop-outside
  1034→  ralph
  1035→    .command("end-loop")
  1036→    .description("End the ralph loop gracefully (stops all remaining iterations)")
  1037→    .option("--reason <reason>", "Reason for ending the loop")
  1038→    .action(async (options) => {
  1039→      try {
  1040→        const ctx = await initContext();
  1041→
  1042→        // Check if we're in a ralph session by looking for any ralph marker
  1043→        const taskLimitMarker = await readTaskLimitMarker(ctx.rootDir);
  1044→        const endLoopMarker = await readEndLoopMarker(ctx.rootDir);
  1045→
  1046→        // Write the marker with reason if provided
  1047→        await writeEndLoopMarker(ctx.rootDir, options.reason);
  1048→
  1049→        // Determine if we're likely in a ralph session
  1050→        const inRalphSession = taskLimitMarker !== null || endLoopMarker !== null;
  1051→
  1052→        if (!inRalphSession) {
  1053→          // AC: @ralph-end-loop ac-noop-outside
  1054→          warn("No active ralph session detected. Marker written but may have no effect.");
  1055→          info("This command is designed to be called by agents during a ralph loop.");
  1056→        } else {
  1057→          success("Loop end signal sent");
  1058→        }
  1059→
  1060→        if (options.reason) {
  1061→          info(`Reason: ${options.reason}`);
  1062→        }
  1063→      } catch (err) {
  1064→        error("Failed to signal end-loop", err);
  1065→        process.exit(EXIT_CODES.ERROR);
  1066→      }
  1067→    });
  1068→
  1069→  // Main ralph run command (default behavior when ralph is called directly)
  1070→  ralph
  1071→    .command("run", { isDefault: true })
  1072→    .description("Run ACP agent in a loop to process ready tasks")
  1073→    .argument("[args...]", "")
  1074→    .option("--max-loops <n>", "Maximum iterations", "5")
  1075→    .option("--max-retries <n>", "Max retries per iteration on error", "3")
  1076→    .option(
  1077→      "--max-failures <n>",
  1078→      "Max consecutive failed iterations before exit",
  1079→      "3",
  1080→    )
  1081→    .option("--dry-run", "Show prompt without executing")
  1082→    .option("--yolo", "Use dangerously-skip-permissions (default)", true)
  1083→    .option("--no-yolo", "Require normal permission prompts")
  1084→    .option("--subagent-timeout <minutes>", "Review subagent timeout in minutes", "20")
  1085→    .option("--adapter <id>", "Agent adapter to use", "claude-agent-acp")
  1086→    .option("--adapter-cmd <cmd>", "Custom adapter command (for testing)")
  1087→    .option(
  1088→      "--restart-every <n>",
  1089→      "Restart agent every N iterations to prevent OOM (0 = never)",
  1090→      "10",
  1091→    )
  1092→    .option(
  1093→      "--focus <instructions>",
  1094→      "Focus instructions included in every iteration prompt",
  1095→    )
  1096→    .option(
  1097→      "--max-tasks <n>",
  1098→      "Max tasks per iteration (0 = unlimited)",
  1099→      "1",
  1100→    )
  1101→    .option(
  1102→      "--tasks <refs>",
  1103→      "Explicit task scope: only work on these tasks (comma-separated refs, e.g., @task1,@task2)",
  1104→    )
  1105→    .action(async (args: string[], options) => {
  1106→      // Check for unknown subcommands that fell through to default
  1107→      // Only check args that look like subcommand names (alphanumeric with hyphens, no quotes)
  1108→      if (args.length > 0) {
  1109→        const unknownCmd = args[0];
  1110→        // Skip if it looks like a malformed option or quoted argument
  1111→        const looksLikeSubcommand = /^[a-z][a-z0-9-]*$/i.test(unknownCmd);
  1112→        if (looksLikeSubcommand) {
  1113→          if (unknownCmd === "end-iteration") {
  1114→            error(`Unknown command: ${unknownCmd}. Did you mean 'end-loop'?`);
  1115→            info("The command was renamed from 'end-iteration' to 'end-loop' to clarify it ends the entire loop.");
  1116→          } else {
  1117→            error(`Unknown command: ${unknownCmd}`);
  1118→          }
  1119→          info("Run 'kspec ralph --help' to see available commands.");
  1120→          process.exit(EXIT_CODES.USAGE_ERROR);
  1121→        }
  1122→      }
  1123→      try {
  1124→        const maxLoops = parseInt(options.maxLoops, 10);
  1125→        const maxRetries = parseInt(options.maxRetries, 10);
  1126→        const maxFailures = parseInt(options.maxFailures, 10);
  1127→
  1128→        if (Number.isNaN(maxLoops) || maxLoops < 1) {
  1129→          error(errors.usage.maxLoopsPositive);
  1130→          process.exit(EXIT_CODES.ERROR);
  1131→        }
  1132→
  1133→        if (Number.isNaN(maxRetries) || maxRetries < 0) {
  1134→          error(errors.usage.maxRetriesNonNegative);
  1135→          process.exit(EXIT_CODES.ERROR);
  1136→        }
  1137→
  1138→        if (Number.isNaN(maxFailures) || maxFailures < 1) {
  1139→          error(errors.usage.maxFailuresPositive);
  1140→          process.exit(EXIT_CODES.ERROR);
  1141→        }
  1142→
  1143→        const subagentTimeout = parseInt(options.subagentTimeout, 10);
  1144→        if (Number.isNaN(subagentTimeout) || subagentTimeout < 1) {
  1145→          error("--subagent-timeout must be a positive integer (minutes)");
  1146→          process.exit(EXIT_CODES.ERROR);
  1147→        }
  1148→
  1149→        const restartEvery = parseInt(options.restartEvery, 10);
  1150→        if (Number.isNaN(restartEvery) || restartEvery < 0) {
  1151→          error("--restart-every must be a non-negative integer");
  1152→          process.exit(EXIT_CODES.ERROR);
  1153→        }
  1154→
  1155→        // AC: @ralph-task-limit ac-flag
  1156→        const maxTasks = parseInt(options.maxTasks, 10);
  1157→        if (Number.isNaN(maxTasks) || maxTasks < 0 || maxTasks > 999) {
  1158→          error("--max-tasks must be 0 (unlimited) or a positive integer up to 999");
  1159→          process.exit(EXIT_CODES.USAGE_ERROR);
  1160→        }
  1161→
  1162→        // Handle custom adapter command for testing
  1163→        if (options.adapterCmd) {
  1164→          const parts = options.adapterCmd.split(/\s+/);
  1165→          const customAdapter: AgentAdapter = {
  1166→            command: parts[0],
  1167→            args: parts.slice(1),
  1168→            description: "Custom adapter via --adapter-cmd",
  1169→          };
  1170→          registerAdapter("custom", customAdapter);
  1171→          options.adapter = "custom";
  1172→        }
  1173→
  1174→        // Resolve adapter
  1175→        const adapter = resolveAdapter(options.adapter);
  1176→
  1177→        // Validate adapter package exists before proceeding
  1178→        // Skip validation for:
  1179→        // - Custom adapters (--adapter-cmd)
  1180→        // - Non-npx adapters
  1181→        // - Dry-run mode with default adapter (doesn't spawn agent, default may not be installed in CI)
  1182→        // Note: If user explicitly specifies --adapter, validate even in dry-run to catch typos
  1183→        // Accept both new and deprecated adapter names
  1184→        const isDefaultAdapter =
  1185→          options.adapter === "claude-agent-acp" ||
  1186→          options.adapter === "claude-code-acp";
  1187→        const skipValidation =
  1188→          options.adapterCmd ||
  1189→          adapter.command !== "npx" ||
  1190→          !adapter.args[0] ||
  1191→          (options.dryRun && isDefaultAdapter);
  1192→
  1193→        if (!skipValidation) {
  1194→          validateAdapter(adapter.args[0]);
  1195→        }
  1196→
  1197→        // Add yolo flag to adapter args if needed (accept both new and deprecated names)
  1198→        if (options.yolo && isDefaultAdapter) {
  1199→          adapter.args = [...adapter.args, "--dangerously-skip-permissions"];
  1200→        }
  1201→
  1202→        const restartInfo =
  1203→          restartEvery > 0 ? `, restart every ${restartEvery}` : "";
  1204→        const maxTasksInfo =
  1205→          maxTasks === 0 ? "unlimited" : `${maxTasks}`;
  1206→
  1207→        // Initialize kspec context early to validate --tasks
  1208→        const ctx = await initContext();
  1209→
  1210→        // AC: @cli-ralph ac-21 - Parse explicit task scope
  1211→        let explicitTaskScope: ExplicitTaskScope | undefined;
  1212→        if (options.tasks) {
  1213→          try {
  1214→            explicitTaskScope = await parseExplicitTasks(ctx, options.tasks);
  1215→            info(`Explicit task scope: ${explicitTaskScope.refs.join(", ")}`);
  1216→          } catch (err) {
  1217→            error(`Invalid --tasks argument: ${(err as Error).message}`);
  1218→            process.exit(EXIT_CODES.VALIDATION_FAILED);
  1219→          }
  1220→        }
  1221→
  1222→        const taskScopeInfo = explicitTaskScope
  1223→          ? `, tasks=${explicitTaskScope.refs.join(",")}`
  1224→          : "";
  1225→        info(
  1226→          `Starting ralph loop (adapter=${options.adapter}, max ${maxLoops} iterations, ${maxRetries} retries, ${maxFailures} max failures${restartInfo}, max-tasks=${maxTasksInfo}${taskScopeInfo})`,
  1227→        );
  1228→        if (options.focus) {
  1229→          info(`Focus: ${options.focus}`);
  1230→        }
  1231→        const specDir = ctx.specDir;
  1232→
  1233→        // Create session for event tracking
  1234→        const sessionId = ulid();
  1235→        await createSession(specDir, {
  1236→          id: sessionId,
  1237→          agent_type: options.adapter,
  1238→          task_id: undefined, // Will be determined per iteration
  1239→        });
  1240→
  1241→        // Log session start
  1242→        await appendEvent(specDir, {
  1243→          session_id: sessionId,
  1244→          type: "session.start",
  1245→          data: {
  1246→            adapter: options.adapter,
  1247→            maxLoops,
  1248→            maxRetries,
  1249→            maxFailures,
  1250→            maxTasks,
  1251→            yolo: options.yolo,
  1252→            focus: options.focus,
  1253→            explicitTasks: explicitTaskScope?.refs,
  1254→          },
  1255→        });
  1256→
  1257→        let consecutiveFailures = 0;
  1258→        let agent: SpawnedAgent | null = null;
  1259→        let acpSessionId: string | null = null;
  1260→
  1261→        // AC: @ralph-end-loop ac-signal-cleanup, @ralph-task-limit ac-signal-cleanup
  1262→        // Signal handlers for cleanup on Ctrl+C or kill
  1263→        // Note: Signal handlers must be synchronous, so we use Promise.finally()
  1264→        // to ensure cleanup completes before exit
  1265→        const signalCleanup = (signal: string) => {
  1266→          info(`Received ${signal}, cleaning up...`);
  1267→          // Kill agent if running
  1268→          if (agent) {
  1269→            agent.kill();
  1270→          }
  1271→          // Clean up marker files, then exit after cleanup completes
  1272→          Promise.all([
  1273→            clearTaskLimitMarker(ctx.rootDir),
  1274→            clearEndLoopMarker(ctx.rootDir),
  1275→          ]).finally(() => {
  1276→            process.exit(0);
  1277→          });
  1278→        };
  1279→        const sigintHandler = () => { signalCleanup("SIGINT"); };
  1280→        const sigtermHandler = () => { signalCleanup("SIGTERM"); };
  1281→        process.on("SIGINT", sigintHandler);
  1282→        process.on("SIGTERM", sigtermHandler);
  1283→
  1284→        // Create translator and renderer for this session
  1285→        const translator = createTranslator();
  1286→        const renderer = createCliRenderer();
  1287→
  1288→        // Task limit state - tracks completions per iteration
  1289→        // AC: @ralph-task-limit ac-reset, ac-wrapup
  1290→        let taskLimitReached = false;
  1291→        let tasksCompletedThisIteration = 0;
  1292→
  1293→        // End-loop signal state
  1294→        // AC: @ralph-end-loop ac-detect, ac-graceful
  1295→        let endLoopRequested = false;
  1296→
  1297→        // AC: @ralph-wrap-up-agent-on-loop-exit ac-1 - Track exit reason for wrap-up
  1298→        let exitReason: ExitReason | null = null;
  1299→        let lastIterationCtx: SessionContext | null = null;
  1300→        let lastErrorMessage: string | undefined;
  1301→        const recentTaskRefs: string[] = [];
  1302→
  1303→        try {
  1304→          for (let iteration = 1; iteration <= maxLoops; iteration++) {
  1305→            renderer.newSection?.(`Iteration ${iteration}/${maxLoops}`);
  1306→
  1307→            // AC: @ralph-task-limit ac-reset - Reset counter and clear stale markers at iteration start
  1308→            taskLimitReached = false;
  1309→            tasksCompletedThisIteration = 0;
  1310→            const wasStale = await clearStaleMarker(ctx.rootDir);
  1311→            if (wasStale) {
  1312→              info("Cleared stale task limit marker from previous session");
  1313→            }
  1314→            // Also clear any marker from previous iteration of this session
  1315→            await clearTaskLimitMarker(ctx.rootDir);
  1316→
  1317→            // AC: @ralph-end-loop ac-cleanup - Reset end-loop state
  1318→            endLoopRequested = false;
  1319→            const wasStaleEndLoop = await clearStaleEndLoopMarker(ctx.rootDir);
  1320→            if (wasStaleEndLoop) {
  1321→              info("Cleared stale end-loop marker from previous session");
  1322→            }
  1323→            await clearEndLoopMarker(ctx.rootDir);
  1324→
  1325→            // Gather fresh context each iteration
  1326→            // AC: @cli-ralph ac-16 - Only automation-eligible tasks (unless explicit scope)
  1327→            // AC: @cli-ralph ac-21 - With explicit task scope, ignore automation eligibility
  1328→            let sessionCtx = await gatherSessionContext(ctx, {
  1329→              limit: "10",
  1330→              eligible: !explicitTaskScope, // Skip eligibility filter if explicit scope
  1331→            });
  1332→
  1333→            // AC: @cli-ralph ac-21 - Filter to explicit tasks if scope is set
  1334→            if (explicitTaskScope) {
  1335→              sessionCtx = filterByExplicitTasks(sessionCtx, explicitTaskScope);
  1336→            }
  1337→
  1338→            // AC: @ralph-subagent-spawning ac-8 - Process pending_review tasks BEFORE main iteration
  1339→            // This wraps consecutiveFailures in an object so it can be mutated by the helper
  1340→            const failureTracker = { count: consecutiveFailures };
  1341→            const continueLoop = await processPendingReviewTasks(
  1342→              ctx,
  1343→              adapter,
  1344→              sessionCtx.pending_review_tasks,
  1345→              {
  1346→                yolo: options.yolo,
  1347→                maxRetries,
  1348→                maxFailures,
  1349→                cwd: process.cwd(),
  1350→                subagentTimeout: subagentTimeout * 60 * 1000,
  1351→              },
  1352→              failureTracker,
  1353→            );
  1354→            consecutiveFailures = failureTracker.count;
  1355→
  1356→            if (!continueLoop) {
  1357→              exitReason = "max_failures";
  1358→              lastIterationCtx = sessionCtx;
  1359→              break;
  1360→            }
  1361→
  1362→            // AC: @cli-ralph ac-20 - Refresh context after pending_review processing
  1363→            // If pending_review tasks were processed, they may have completed and unblocked
  1364→            // dependent tasks. Re-gather context to detect newly available tasks.
  1365→            let currentCtx = sessionCtx;
  1366→            if (sessionCtx.pending_review_tasks.length > 0) {
  1367→              currentCtx = await gatherSessionContext(ctx, {
  1368→                limit: "10",
  1369→                eligible: !explicitTaskScope,
  1370→              });
  1371→              if (explicitTaskScope) {
  1372→                currentCtx = filterByExplicitTasks(currentCtx, explicitTaskScope);
  1373→              }
  1374→            }
  1375→
  1376→            // AC: @cli-ralph ac-21 - Check explicit task completion
  1377→            if (explicitTaskScope) {
  1378→              const { done, statuses } = await allExplicitTasksDone(ctx, explicitTaskScope);
  1379→              if (done) {
  1380→                const statusList = Array.from(statuses.entries())
  1381→                  .map(([ref, status]) => `${ref}: ${status}`)
  1382→                  .join(", ");
  1383→                info(`All explicit tasks completed or blocked (${statusList}). Exiting loop.`);
  1384→                exitReason = "explicit_tasks_done";
  1385→                lastIterationCtx = currentCtx;
  1386→                break;
  1387→              }
  1388→            }
  1389→
  1390→            // Check for automation-eligible tasks (ready or in_progress)
  1391→            // AC: @cli-ralph ac-19
  1392→            const hasActiveTasks = currentCtx.active_tasks.length > 0;
  1393→            const hasReadyTasks = currentCtx.ready_tasks.length > 0;
  1394→
  1395→            if (!hasActiveTasks && !hasReadyTasks) {
  1396→              if (explicitTaskScope) {
  1397→                info("No explicit tasks available (ready or in_progress). Exiting loop.");
  1398→              } else {
  1399→                info("No automation-eligible tasks (ready or in_progress). Exiting loop.");
  1400→              }
  1401→              exitReason = "no_tasks";
  1402→              lastIterationCtx = currentCtx;
  1403→              break;
  1404→            }
  1405→
  1406→            // AC: @loop-mode-error-handling - Track tasks in progress for failure handling
  1407→            const tasksInProgressAtStart = sessionCtx.active_tasks;
  1408→            const iterationStartTime = new Date();
  1409→
  1410→            // Build prompts - task-work first, then reflect
  1411→            // AC: @cli-ralph ac-21 - Include explicit task scope in prompt
  1412→            const taskWorkPrompt = buildTaskWorkPrompt(
  1413→              currentCtx,
  1414→              iteration,
  1415→              maxLoops,
  1416→              sessionId,
  1417→              options.focus,
  1418→              explicitTaskScope,
  1419→            );
  1420→            const reflectPrompt = buildReflectPrompt(
  1421→              iteration,
  1422→              maxLoops,
  1423→              sessionId,
  1424→            );
  1425→
  1426→            // AC: @ralph-task-limit ac-dryrun, @cli-ralph ac-21
  1427→            if (options.dryRun) {
  1428→              console.log(
  1429→                chalk.yellow("=== DRY RUN - Configuration ===\n"),
  1430→              );
  1431→              console.log(`  max-loops: ${maxLoops}`);
  1432→              console.log(`  max-tasks: ${maxTasks === 0 ? "unlimited" : maxTasks}`);
  1433→              console.log(`  max-retries: ${maxRetries}`);
  1434→              console.log(`  max-failures: ${maxFailures}`);
  1435→              console.log(`  restart-every: ${restartEvery === 0 ? "never" : restartEvery}`);
  1436→              if (explicitTaskScope) {
  1437→                console.log(`  explicit-tasks: ${explicitTaskScope.refs.join(", ")}`);
  1438→              }
  1439→              console.log(
  1440→                chalk.yellow("\n=== Task Work Prompt ===\n"),
  1441→              );
  1442→              console.log(taskWorkPrompt);
  1443→              console.log(chalk.yellow("\n=== Reflect Prompt ===\n"));
  1444→              console.log(reflectPrompt);
  1445→              console.log(chalk.yellow("\n=== END DRY RUN ==="));
  1446→              break;
  1447→            }
  1448→
  1449→            // Log task-work prompt
  1450→            await appendEvent(specDir, {
  1451→              session_id: sessionId,
  1452→              type: "prompt.sent",
  1453→              data: {
  1454→                iteration,
  1455→                phase: "task-work",
  1456→                prompt: taskWorkPrompt,
  1457→                tasks: {
  1458→                  active: currentCtx.active_tasks.map((t) => t.ref),
  1459→                  ready: currentCtx.ready_tasks.map((t) => t.ref),
  1460→                },
  1461→              },
  1462→            });
  1463→
  1464→            // Retry loop for this iteration
  1465→            let lastError: Error | null = null;
  1466→            let succeeded = false;
  1467→
  1468→            for (let attempt = 1; attempt <= maxRetries + 1; attempt++) {
  1469→              if (attempt > 1) {
  1470→                console.log(
  1471→                  chalk.yellow(
  1472→                    `\nRetry attempt ${attempt - 1}/${maxRetries}...`,
  1473→                  ),
  1474→                );
  1475→              }
  1476→
  1477→              try {
  1478→                // Spawn agent if not already running
  1479→                if (!agent) {
  1480→                  info("Spawning ACP agent...");
  1481→                  agent = await spawnAndInitialize(adapter, {
  1482→                    cwd: process.cwd(),
  1483→                    clientOptions: {
  1484→                      clientInfo: {
  1485→                        name: "kspec-ralph",
  1486→                        version: packageVersion,
  1487→                      },
  1488→                      methodTimeouts: {
  1489→                        "session/prompt": RALPH_PROMPT_TIMEOUT,
  1490→                        "session/resume": RALPH_PROMPT_TIMEOUT,
  1491→                      },
  1492→                    },
  1493→                  });
  1494→
  1495→                  // Set up streaming update handler with translator + renderer
  1496→                  agent.client.on(
  1497→                    "update",
  1498→                    (_sid: string, update: SessionUpdate) => {
  1499→                      // Translate ACP event to RalphEvent and render
  1500→                      const event = translator.translate(update);
  1501→                      if (event) {
  1502→                        renderer.render(event);
  1503→                      }
  1504→
  1505→                      // AC: @ralph-task-limit ac-detection, ac-wrapup
  1506→                      // Detect task completions for limit enforcement
  1507→                      if (maxTasks > 0 && !taskLimitReached) {
  1508→                        const bashCmd = extractBashCommand(update);
  1509→                        if (bashCmd && detectTaskCompleteCommand(bashCmd)) {
  1510→                          // Pattern matched - verify via kspec query
  1511→                          getIterationStats(ctx, iterationStartTime)
  1512→                            .then(async (stats) => {
  1513→                              if (stats.tasks_completed >= maxTasks && !taskLimitReached) {
  1514→                                taskLimitReached = true;
  1515→                                tasksCompletedThisIteration = stats.tasks_completed;
  1516→                                info(`Task limit reached (${stats.tasks_completed}/${maxTasks})`);
  1517→
  1518→                                // AC: @ralph-task-limit ac-marker-format, ac-wrapup
  1519→                                // Write marker file for hook enforcement
  1520→                                const marker: TaskLimitMarker = {
  1521→                                  active: true,
  1522→                                  since: iterationStartTime.toISOString(),
  1523→                                  max: maxTasks,
  1524→                                  completed: stats.tasks_completed,
  1525→                                  sessionId,
  1526→                                };
  1527→                                await writeTaskLimitMarker(ctx.rootDir, marker);
  1528→
  1529→                                // Inject wrap-up message to agent
  1530→                                if (agent && acpSessionId) {
  1531→                                  const wrapUpMsg = `\n\n**TASK LIMIT REACHED** - ${stats.tasks_completed} task(s) completed this iteration (limit: ${maxTasks}).\n\nPlease wrap up your current work and exit cleanly. Do not start new tasks.\n\nCompleted tasks this iteration: ${stats.completed_refs.join(", ")}`;
  1532→                                  agent.client.prompt({
  1533→                                    sessionId: acpSessionId,
  1534→                                    prompt: [{ type: "text", text: wrapUpMsg }],
  1535→                                  }).catch(() => {
  1536→                                    // Ignore if message injection fails
  1537→                                  });
  1538→                                }
  1539→                              }
  1540→                            })
  1541→                            .catch(() => {
  1542→                              // Ignore query failures - detection is best-effort
  1543→                            });
  1544→                        }
  1545→                      }
  1546→
  1547→                      // AC: @ralph-end-loop ac-detect
  1548→                      // Detect explicit end-loop command
  1549→                      if (!endLoopRequested) {
  1550→                        const bashCmd = extractBashCommand(update);
  1551→                        if (bashCmd && detectEndLoopCommand(bashCmd)) {
  1552→                          endLoopRequested = true;
  1553→                          // Read marker to get reason if present
  1554→                          readEndLoopMarker(ctx.rootDir)
  1555→                            .then((marker) => {
  1556→                              const reason = marker?.reason
  1557→                                ? ` (${marker.reason})`
  1558→                                : "";
  1559→                              info(`End-loop signal received${reason}`);
  1560→                            })
  1561→                            .catch(() => {
  1562→                              info("End-loop signal received");
  1563→                            });
  1564→                        }
  1565→                      }
  1566→
  1567→                      // Log raw update event (async, non-blocking)
  1568→                      appendEvent(specDir, {
  1569→                        session_id: sessionId,
  1570→                        type: "session.update",
  1571→                        data: { iteration, update },
  1572→                      }).catch(() => {
  1573→                        // Ignore logging errors during streaming
  1574→                      });
  1575→                    },
  1576→                  );
  1577→
  1578→                  // Set up tool request handler
  1579→                  agent.client.on(
  1580→                    "request",
  1581→                    (
  1582→                      reqId: string | number,
  1583→                      method: string,
  1584→                      params: unknown,
  1585→                    ) => {
  1586→                      // biome-ignore lint/style/noNonNullAssertion: agent is guaranteed to exist when callback is registered
  1587→                      handleRequest(
  1588→                        agent!.client,
  1589→                        reqId,
  1590→                        method,
  1591→                        params,
  1592→                        options.yolo,
  1593→                      ).catch((err) => {
  1594→                        // biome-ignore lint/style/noNonNullAssertion: agent is guaranteed to exist when callback is registered
  1595→                        agent!.client.respondError(reqId, -32000, err.message);
  1596→                      });
  1597→                    },
  1598→                  );
  1599→                }
  1600→
  1601→                // Create fresh ACP session per iteration to keep context clean
  1602→                info("Creating ACP session...");
  1603→                acpSessionId = await agent.client.newSession({
  1604→                  cwd: process.cwd(),
  1605→                  mcpServers: [], // No MCP servers for now
  1606→                });
  1607→
  1608→                // Phase 1: Task Work
  1609→                info("Sending task-work prompt to agent...");
  1610→                const taskWorkResponse = await agent.client.prompt({
  1611→                  sessionId: acpSessionId!,
  1612→                  prompt: [{ type: "text", text: taskWorkPrompt }],
  1613→                });
  1614→
  1615→                // Log task-work completion
  1616→                await appendEvent(specDir, {
  1617→                  session_id: sessionId,
  1618→                  type: "session.update",
  1619→                  data: {
  1620→                    iteration,
  1621→                    phase: "task-work",
  1622→                    stopReason: taskWorkResponse.stopReason,
  1623→                    completed: true,
  1624→                  },
  1625→                });
  1626→
  1627→                if (taskWorkResponse.stopReason === "cancelled") {
  1628→                  throw new Error(errors.usage.agentPromptCancelled);
  1629→                }
  1630→
  1631→                // Phase 2: Reflect (always sent after task-work completes)
  1632→                info("Sending reflect prompt to agent...");
  1633→                await appendEvent(specDir, {
  1634→                  session_id: sessionId,
  1635→                  type: "prompt.sent",
  1636→                  data: {
  1637→                    iteration,
  1638→                    phase: "reflect",
  1639→                    prompt: reflectPrompt,
  1640→                  },
  1641→                });
  1642→
  1643→                const reflectResponse = await agent.client.prompt({
  1644→                  sessionId: acpSessionId!,
  1645→                  prompt: [{ type: "text", text: reflectPrompt }],
  1646→                });
  1647→
  1648→                // Log reflect completion
  1649→                await appendEvent(specDir, {
  1650→                  session_id: sessionId,
  1651→                  type: "session.update",
  1652→                  data: {
  1653→                    iteration,
  1654→                    phase: "reflect",
  1655→                    stopReason: reflectResponse.stopReason,
  1656→                    completed: true,
  1657→                  },
  1658→                });
  1659→
  1660→                if (reflectResponse.stopReason === "cancelled") {
  1661→                  throw new Error(errors.usage.agentPromptCancelled);
  1662→                }
  1663→
  1664→                succeeded = true;
  1665→                break;
  1666→              } catch (err) {
  1667→                lastError = err as Error;
  1668→                error(errors.failures.iterationFailed(lastError.message));
  1669→
  1670→                // Clean up agent on error - will respawn next attempt
  1671→                if (agent) {
  1672→                  agent.kill();
  1673→                  agent = null;
  1674→                  acpSessionId = null;
  1675→                }
  1676→              }
  1677→            }
  1678→
  1679→            if (succeeded) {
  1680→              console.log(); // Newline after streaming output
  1681→
  1682→              // Save session context snapshot for audit trail
  1683→              await saveSessionContext(
  1684→                specDir,
  1685→                sessionId,
  1686→                iteration,
  1687→                sessionCtx,
  1688→              );
  1689→
  1690→              success(`Completed iteration ${iteration}`);
  1691→              consecutiveFailures = 0;
  1692→
  1693→              // Track task refs from this iteration for wrap-up context
  1694→              for (const t of sessionCtx.active_tasks) {
  1695→                if (!recentTaskRefs.includes(t.ref)) {
  1696→                  recentTaskRefs.push(t.ref);
  1697→                }
  1698→              }
  1699→              lastIterationCtx = sessionCtx;
  1700→
  1701→              // AC: @ralph-end-loop ac-graceful - Check for end-loop signal
  1702→              if (endLoopRequested) {
  1703→                info("Agent requested end of loop. Exiting gracefully.");
  1704→                exitReason = "end_loop_signal";
  1705→                break;
  1706→              }
  1707→
  1708→              // Periodic agent restart to prevent OOM
  1709→              // AC: @cli-ralph ac-restart-periodic
  1710→              if (
  1711→                restartEvery > 0 &&
  1712→                iteration % restartEvery === 0 &&
  1713→                iteration < maxLoops
  1714→              ) {
  1715→                info(
  1716→                  `Restarting agent to prevent memory buildup (every ${restartEvery} iterations)...`,
  1717→                );
  1718→                if (agent) {
  1719→                  agent.kill();
  1720→                  agent = null;
  1721→                  acpSessionId = null;
  1722→                }
  1723→              }
  1724→            } else {
  1725→              consecutiveFailures++;
  1726→              error(
  1727→                errors.failures.iterationFailedAfterRetries(
  1728→                  iteration,
  1729→                  maxRetries,
  1730→                  consecutiveFailures,
  1731→                  maxFailures,
  1732→                ),
  1733→              );
  1734→              if (lastError) {
  1735→                error(errors.failures.lastError(lastError.message));
  1736→              }
  1737→
  1738→              // AC: @loop-mode-error-handling - Track per-task failures
  1739→              const errorDesc = lastError?.message || "Iteration failed after retries";
  1740→              await handleIterationFailure(
  1741→                ctx,
  1742→                tasksInProgressAtStart,
  1743→                iterationStartTime,
  1744→                errorDesc,
  1745→              );
  1746→
  1747→              if (consecutiveFailures >= maxFailures) {
  1748→                error(errors.failures.reachedMaxFailures(maxFailures));
  1749→                exitReason = "max_failures";
  1750→                lastErrorMessage = lastError?.message;
  1751→                lastIterationCtx = sessionCtx;
  1752→                break;
  1753→              }
  1754→
  1755→              info("Continuing to next iteration...");
  1756→            }
  1757→          }
  1758→
  1759→          // If loop completed all iterations without breaking
  1760→          if (exitReason === null) {
  1761→            exitReason = "max_iterations";
  1762→          }
  1763→        } finally {
  1764→          // Remove signal handlers to avoid double cleanup
  1765→          process.off("SIGINT", sigintHandler);
  1766→          process.off("SIGTERM", sigtermHandler);
  1767→
  1768→          // Clean up agent
  1769→          if (agent) {
  1770→            agent.kill();
  1771→            agent = null;
  1772→          }
  1773→
  1774→          // AC: @ralph-task-limit ac-reset - Clear marker file when session ends
  1775→          await clearTaskLimitMarker(ctx.rootDir);
  1776→
  1777→          // AC: @ralph-end-loop ac-cleanup - Clear end-loop marker when session ends
  1778→          await clearEndLoopMarker(ctx.rootDir);
  1779→
  1780→          // AC: @ralph-wrap-up-agent-on-loop-exit ac-1, ac-2, ac-3, ac-4, ac-5
  1781→          // Spawn wrap-up agent if not dry-run and we have an exit reason
  1782→          if (!options.dryRun && exitReason) {
  1783→            console.log("");
  1784→            console.log(chalk.cyan(`${"═".repeat(60)}`));
  1785→            console.log(chalk.cyan.bold(`${WRAPUP_AGENT_PREFIX} Starting Wrap-Up`));
  1786→            console.log(chalk.cyan(`${"═".repeat(60)}`));
  1787→            console.log("");
  1788→
  1789→            const inProgressTasks = lastIterationCtx?.active_tasks || [];
  1790→            const pendingReviewTasks = lastIterationCtx?.pending_review_tasks || [];
  1791→
  1792→            const wrapUpCtx = buildWrapUpContext(
  1793→              exitReason,
  1794→              sessionId,
  1795→              maxLoops, // Use maxLoops as iteration (we're at the end)
  1796→              maxLoops,
  1797→              inProgressTasks,
  1798→              pendingReviewTasks,
  1799→              recentTaskRefs,
  1800→              process.cwd(),
  1801→              lastErrorMessage,
  1802→            );
  1803→
  1804→            info(`Exit reason: ${exitReason}`);
  1805→            info(`Working tree: ${wrapUpCtx.workingTree.clean ? "clean" : "has uncommitted changes"}`);
  1806→
  1807→            const wrapUpResult = await runWrapUpAgent(
  1808→              adapter,
  1809→              wrapUpCtx,
  1810→              {
  1811→                yolo: options.yolo,
  1812→                cwd: process.cwd(),
  1813→                handleRequest: (client, reqId, method, params) =>
  1814→                  handleRequest(client, reqId, method, params, options.yolo),
  1815→              },
  1816→              DEFAULT_WRAPUP_TIMEOUT,
  1817→            );
  1818→
  1819→            // Log wrap-up result
  1820→            await appendEvent(specDir, {
  1821→              session_id: sessionId,
  1822→              type: "session.wrapup",
  1823→              data: {
  1824→                exitReason,
  1825→                result: wrapUpResult,
  1826→              },
  1827→            });
  1828→
  1829→            if (wrapUpResult.skipped) {
  1830→              info(`${WRAPUP_AGENT_PREFIX} Skipped: ${wrapUpResult.skipReason}`);
  1831→            } else if (wrapUpResult.timedOut) {
  1832→              warn(`${WRAPUP_AGENT_PREFIX} Timed out after ${DEFAULT_WRAPUP_TIMEOUT / 1000}s`);
  1833→            } else if (!wrapUpResult.success) {
  1834→              warn(`${WRAPUP_AGENT_PREFIX} Failed: ${wrapUpResult.error}`);
  1835→            } else {
  1836→              success(`${WRAPUP_AGENT_PREFIX} Completed`);
  1837→            }
  1838→
  1839→            console.log("");
  1840→            console.log(chalk.cyan(`${"═".repeat(60)}`));
  1841→            console.log(chalk.cyan.bold(`${WRAPUP_AGENT_PREFIX} Wrap-Up Complete`));
  1842→            console.log(chalk.cyan(`${"═".repeat(60)}`));
  1843→            console.log("");
  1844→          }
  1845→
  1846→          // Log session end
  1847→          const status =
  1848→            consecutiveFailures >= maxFailures ? "abandoned" : "completed";
  1849→          await appendEvent(specDir, {
  1850→            session_id: sessionId,
  1851→            type: "session.end",
  1852→            data: {
  1853→              status,
  1854→              consecutiveFailures,
  1855→              exitReason,
  1856→            },
  1857→          });
  1858→          await updateSessionStatus(specDir, sessionId, status);
  1859→        }
  1860→
  1861→        console.log(chalk.green(`\n${"─".repeat(60)}`));
  1862→        success("Ralph loop completed");
  1863→        console.log(chalk.green(`${"─".repeat(60)}\n`));
  1864→      } catch (err) {
  1865→        error(errors.failures.ralphLoop, err);
  1866→        process.exit(EXIT_CODES.ERROR);
  1867→      }
  1868→    });
  1869→}
  1870→