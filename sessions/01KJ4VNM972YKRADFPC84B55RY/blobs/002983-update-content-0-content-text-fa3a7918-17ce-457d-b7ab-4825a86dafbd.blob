   188→  try {
   189→    const content = await fs.readFile(markerPath, "utf-8");
   190→    return JSON.parse(content) as EndLoopMarker;
   191→  } catch {
   192→    return null;
   193→  }
   194→}
   195→
   196→/**
   197→ * Clear end-loop marker file.
   198→ * AC: @ralph-end-loop ac-cleanup
   199→ */
   200→async function clearEndLoopMarker(rootDir: string): Promise<void> {
   201→  const markerPath = path.join(rootDir, END_LOOP_MARKER_PATH);
   202→  try {
   203→    await fs.unlink(markerPath);
   204→  } catch {
