    73→// ─── Task Limit Marker ──────────────────────────────────────────────────────
    74→
    75→/**
    76→ * Marker file schema for task limit enforcement.
    77→ * AC: @ralph-task-limit ac-marker-format
    78→ */
    79→interface TaskLimitMarker {
    80→  active: boolean;
    81→  since: string; // ISO8601
    82→  max: number;
    83→  completed: number;
    84→  sessionId: string;
    85→}
    86→
    87→const TASK_LIMIT_MARKER_PATH = ".claude/ralph-task-limit.json";
    88→const END_LOOP_MARKER_PATH = ".claude/ralph-end-loop.json";
    89→const STALE_MARKER_THRESHOLD_MS = 60 * 60 * 1000; // 1 hour
    90→
    91→// ─── End Loop Marker ────────────────────────────────────────────────────────
    92→
    93→/**
    94→ * Marker file schema for explicit end-loop signaling.
    95→ * AC: @ralph-end-loop ac-cmd
    96→ */
    97→interface EndLoopMarker {
    98→  requested: boolean;
    99→  timestamp: string; // ISO8601
   100→  reason?: string;
   101→}
   102→
   103→/**
   104→ * Write task limit marker file.
   105→ * AC: @ralph-task-limit ac-wrapup, ac-marker-format
   106→ */
   107→async function writeTaskLimitMarker(
   108→  rootDir: string,
   109→  marker: TaskLimitMarker,
   110→): Promise<void> {
   111→  const markerPath = path.join(rootDir, TASK_LIMIT_MARKER_PATH);
   112→  const dir = path.dirname(markerPath);
   113→  await fs.mkdir(dir, { recursive: true });
   114→  await fs.writeFile(markerPath, JSON.stringify(marker, null, 2));
   115→}
   116→
   117→/**
   118→ * Read task limit marker file if it exists.
   119→ */
   120→async function readTaskLimitMarker(
   121→  rootDir: string,
   122→): Promise<TaskLimitMarker | null> {
   123→  const markerPath = path.join(rootDir, TASK_LIMIT_MARKER_PATH);
   124→  try {
   125→    const content = await fs.readFile(markerPath, "utf-8");
   126→    return JSON.parse(content) as TaskLimitMarker;
   127→  } catch {
   128→    return null;
   129→  }
   130→}
   131→
   132→/**
   133→ * Clear task limit marker file.
   134→ * AC: @ralph-task-limit ac-reset
   135→ */
   136→async function clearTaskLimitMarker(rootDir: string): Promise<void> {
   137→  const markerPath = path.join(rootDir, TASK_LIMIT_MARKER_PATH);
   138→  try {
   139→    await fs.unlink(markerPath);
   140→  } catch {
   141→    // Ignore if file doesn't exist
   142→  }
   143→}
   144→
   145→/**
   146→ * Clear stale marker files (older than 1 hour).
   147→ * AC: @ralph-task-limit ac-reset
   148→ */
   149→async function clearStaleMarker(rootDir: string): Promise<boolean> {
   150→  const marker = await readTaskLimitMarker(rootDir);
   151→  if (!marker) return false;
   152→
   153→  const markerAge = Date.now() - new Date(marker.since).getTime();
   154→  if (markerAge > STALE_MARKER_THRESHOLD_MS) {
   155→    await clearTaskLimitMarker(rootDir);
   156→    return true;
   157→  }
   158→  return false;
   159→}
   160→
   161→/**
   162→ * Write end-loop marker file.
   163→ * AC: @ralph-end-loop ac-cmd
   164→ */
   165→async function writeEndLoopMarker(
   166→  rootDir: string,
   167→  reason?: string,
   168→): Promise<void> {
   169→  const markerPath = path.join(rootDir, END_LOOP_MARKER_PATH);
   170→  const dir = path.dirname(markerPath);
   171→  await fs.mkdir(dir, { recursive: true });
   172→  const marker: EndLoopMarker = {
   173→    requested: true,
   174→    timestamp: new Date().toISOString(),
   175→    reason,
   176→  };
   177→  await fs.writeFile(markerPath, JSON.stringify(marker, null, 2));
   178→}
   179→
   180→/**
   181→ * Read end-loop marker file if it exists.
   182→ * AC: @ralph-end-loop ac-detect
