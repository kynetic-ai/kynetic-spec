   206→  }
   207→}
   208→
   209→/**
   210→ * Clear stale end-loop markers (older than 1 hour).
   211→ * AC: @ralph-end-loop ac-cleanup
   212→ */
   213→async function clearStaleEndLoopMarker(rootDir: string): Promise<boolean> {
   214→  const marker = await readEndLoopMarker(rootDir);
   215→  if (!marker) return false;
   216→
   217→  const markerAge = Date.now() - new Date(marker.timestamp).getTime();
   218→  if (markerAge > STALE_MARKER_THRESHOLD_MS) {
   219→    await clearEndLoopMarker(rootDir);
   220→    return true;
   221→  }
   222→  return false;
   223→}
   224→
   225→/**
   226→ * Detect if a Bash command is a task complete command.
   227→ * AC: @ralph-task-limit ac-detection
   228→ */
   229→function detectTaskCompleteCommand(command: string): boolean {
   230→  // Match variations of "kspec task complete"
   231→  // Don't match "kspec task submit" - that's just status change to pending_review
   232→  return /\bkspec\s+task\s+complete\b/.test(command);
   233→}
   234→
   235→/**
   236→ * Detect if a Bash command is an end-loop command.
   237→ * AC: @ralph-end-loop ac-detect
   238→ */
   239→function detectEndLoopCommand(command: string): boolean {
   240→  // Match "kspec ralph end-loop" with any arguments
   241→  return /\bkspec\s+ralph\s+end-loop\b/.test(command);
   242→}
   243→
   244→/**
   245→ * Extract Bash command from SessionUpdate if it's a tool_call or tool_call_update event.
   246→ * Returns null if not a Bash tool call.
   247→ */
   248→function extractBashCommand(update: SessionUpdate): string | null {
   249→  const u = update as Record<string, unknown>;
   250→
   251→  // Check if this is a tool call event
   252→  if (u.sessionUpdate !== "tool_call" && u.sessionUpdate !== "tool_call_update") {
   253→    return null;
   254→  }
   255→
   256→  // Extract tool name - check various locations Claude Code uses
   257→  let toolName: string | undefined;
   258→
   259→  // Try _meta.claudeCode.toolName first (Claude Code pattern)
   260→  const meta = u._meta as Record<string, unknown> | undefined;
   261→  if (meta) {
   262→    const claudeCode = meta.claudeCode as Record<string, unknown> | undefined;
   263→    if (claudeCode?.toolName) {
   264→      toolName = String(claudeCode.toolName);
   265→    } else if (meta.toolName) {
   266→      toolName = String(meta.toolName);
   267→    }
   268→  }
   269→
   270→  // Fall back to name or title field
   271→  if (!toolName && u.name) {
   272→    toolName = String(u.name);
   273→  }
   274→  if (!toolName && u.title) {
   275→    toolName = String(u.title);
   276→  }
   277→
   278→  // Check if it's a Bash tool (handle MCP prefix variations)
   279→  if (!toolName) return null;
   280→  const isBash = toolName === "Bash" || toolName.endsWith("__Bash");
   281→  if (!isBash) return null;
   282→
   283→  // Extract command from input
   284→  const input = (u.rawInput || u.input || u.params) as Record<string, unknown> | undefined;
   285→  if (!input) return null;
   286→
   287→  const command = input.command;
   288→  if (typeof command !== "string") return null;
   289→
   290→  return command;
   291→}
   292→
   293→// ─── Explicit Task Scope ─────────────────────────────────────────────────────
   294→
   295→/**
   296→ * Parsed explicit task scope for --tasks flag.
   297→ * AC: @cli-ralph ac-21
   298→ */
   299→interface ExplicitTaskScope {
   300→  /** Original refs as provided by user */
   301→  refs: string[];
   302→  /** Resolved ULIDs for the tasks */
   303→  ulids: string[];
   304→}
   305→
   306→/**
   307→ * Parse and validate --tasks flag value.
   308→ * Returns resolved ULIDs for the specified task refs.
   309→ * AC: @cli-ralph ac-21
   310→ *
   311→ * @throws Error if any ref cannot be resolved or is not a task
   312→ */
   313→async function parseExplicitTasks(
   314→  ctx: KspecContext,
   315→  tasksArg: string,
   316→): Promise<ExplicitTaskScope> {
   317→  const refs = tasksArg.split(",").map((r) => r.trim()).filter(Boolean);
   318→
   319→  if (refs.length === 0) {
   320→    throw new Error("--tasks requires at least one task reference");
   321→  }
   322→
   323→  // Load tasks and items for resolution
   324→  const tasks = await loadAllTasks(ctx);
   325→  const items = await loadAllItems(ctx);
   326→  const index = new ReferenceIndex(tasks, items);
   327→
   328→  const ulids: string[] = [];
   329→
   330→  for (const ref of refs) {
   331→    const result = index.resolve(ref);
   332→    if (!result.ok) {
   333→      throw new Error(`Cannot resolve task reference: ${ref}`);
   334→    }
   335→
   336→    // Verify it's a task (not a spec item)
   337→    const task = tasks.find((t) => t._ulid === result.ulid);
   338→    if (!task) {
   339→      throw new Error(`Reference ${ref} is not a task`);
   340→    }
   341→
   342→    ulids.push(result.ulid);
   343→  }
   344→
   345→  return { refs, ulids };
   346→}
   347→
   348→/**
   349→ * Filter session context to only include tasks from explicit scope.
   350→ * AC: @cli-ralph ac-21
   351→ */
   352→function filterByExplicitTasks(
   353→  ctx: SessionContext,
   354→  scope: ExplicitTaskScope,
   355→): SessionContext {
   356→  // Task refs in context are short ULIDs (variable length from shortUlid())
   357→  // Check if the context ref is a prefix of any explicit ULID
   358→  const matchesScope = (taskRef: string) => {
   359→    return scope.ulids.some((ulid) => ulid.startsWith(taskRef));
   360→  };
   361→
   362→  return {
   363→    ...ctx,
   364→    active_tasks: ctx.active_tasks.filter((t) => matchesScope(t.ref)),
   365→    pending_review_tasks: ctx.pending_review_tasks.filter((t) => matchesScope(t.ref)),
   366→    ready_tasks: ctx.ready_tasks.filter((t) => matchesScope(t.ref)),
   367→  };
   368→}
   369→
   370→/**
   371→ * Check if all explicit tasks are completed or blocked.
   372→ * AC: @cli-ralph ac-21
   373→ */
   374→async function allExplicitTasksDone(
   375→  ctx: KspecContext,
   376→  scope: ExplicitTaskScope,
   377→): Promise<{ done: boolean; statuses: Map<string, string> }> {
   378→  const tasks = await loadAllTasks(ctx);
   379→  const statuses = new Map<string, string>();
   380→
   381→  for (const ulid of scope.ulids) {
   382→    const task = tasks.find((t) => t._ulid === ulid);
   383→    if (task) {
   384→      statuses.set(ulid.slice(0, 8), task.status);
   385→    }
   386→  }
   387→
   388→  // Check if all are completed or blocked
   389→  const done = scope.ulids.every((ulid) => {
   390→    const status = statuses.get(ulid.slice(0, 8));
   391→    return status === "completed" || status === "blocked";
   392→  });
   393→
   394→  return { done, statuses };
   395→}
   396→
   397→// ─── Prompt Template ─────────────────────────────────────────────────────────
   398→
   399→// AC: @ralph-skill-delegation ac-1, ac-2, ac-3
   400→function buildTaskWorkPrompt(
   401→  sessionCtx: SessionContext,
   402→  iteration: number,
   403→  maxLoops: number,
   404→  sessionId: string,
   405→  focus?: string,
   406→  explicitTaskScope?: ExplicitTaskScope,
   407→): string {
   408→  const focusSection = focus
   409→    ? `
   410→## Session Focus (applies to ALL iterations)
   411→
   412→> **${focus}**
   413→
   414→Keep this focus in mind throughout your work. It takes priority over default task selection.
   415→`
   416→    : "";
   417→
   418→  // AC: @cli-ralph ac-21 - Explicit task scope indicator in prompt
   419→  const taskScopeSection = explicitTaskScope
   420→    ? `
   421→## Explicit Task Scope
   422→
   423→This session is scoped to specific tasks: ${explicitTaskScope.refs.join(", ")}
   424→
   425→**Only work on these tasks.** The loop will exit when all listed tasks are completed or blocked.
   426→`
   427→    : "";
   428→
   429→  const modeDescription = explicitTaskScope
   430→    ? "Loop mode means: no confirmations, auto-resolve decisions, explicit task scope (only the listed tasks)."
   431→    : "Loop mode means: no confirmations, auto-resolve decisions, automation-eligible tasks only.";
   432→
   433→  return `# Kspec Automation Session - Task Work
   434→
   435→**Session ID:** \`${sessionId}\`
   436→**Iteration:** ${iteration} of ${maxLoops}
   437→**Mode:** Automated (no human in the loop)
   438→${focusSection}${taskScopeSection}
   439→
   440→## Current State
   441→\`\`\`json
   442→${JSON.stringify(sessionCtx, null, 2)}
   443→\`\`\`
   444→
   445→## Instructions
   446→
   447→Run the task-work skill in loop mode:
   448→
   449→\`\`\`
   450→${SKILL_TASK_WORK} loop
   451→\`\`\`
   452→
   453→${modeDescription}
   454→
   455→**Normal flow:** Work on a task, create a PR, then stop responding. Ralph continues automatically —
   456→it checks for remaining eligible tasks at the start of each iteration and exits the loop itself when none remain.
   457→
   458→**Do NOT call \`end-loop\` after completing a task.** Simply stop responding.
   459→\`end-loop\` is a rare escape hatch for when work is stalling across multiple iterations with no progress — not a normal exit path.
   460→`;
   461→}
   462→
   463→/**
   464→ * Build the reflect prompt sent after task-work completes.
   465→ * Ralph sends this as a separate prompt to ensure reflection always happens.
   466→ */
   467→function buildReflectPrompt(
   468→  iteration: number,
   469→  maxLoops: number,
   470→  sessionId: string,
   471→): string {
   472→  const isFinal = iteration === maxLoops;
   473→
   474→  return `# Kspec Automation Session - Reflection
   475→
   476→**Session ID:** \`${sessionId}\`
   477→**Iteration:** ${iteration} of ${maxLoops}
   478→**Phase:** Post-task reflection
   479→
   480→## Instructions
   481→
   482→Run the reflect skill in loop mode:
   483→
   484→\`\`\`
   485→${SKILL_REFLECT} loop
   486→\`\`\`
   487→
   488→Loop mode means: high-confidence captures only, must search existing before capturing, no user prompts.
   489→${
   490→  isFinal
   491→    ? `
   492→**FINAL ITERATION** - This is the last chance to capture insights from this session.
   493→`
   494→    : ""
   495→}
   496→Exit when reflection is complete.
   497→`;
   498→}
   499→
   500→// ─── Streaming Output ────────────────────────────────────────────────────────
   501→
   502→// Translator and renderer are created per-session in the action handler.
   503→// This allows the architecture to be reused by future TUI renderers.
   504→
   505→// ─── Adapter Validation ──────────────────────────────────────────────────────
   506→
   507→// AC: @ralph-adapter-validation valid-adapter-proceeds, invalid-adapter-error, validation-before-spawn
   508→/**
   509→ * Validate that the specified ACP adapter package exists.
   510→ * Uses npx --no-install to check both global and local node_modules.
   511→ *
   512→ * @throws {Error} Never throws - exits process with code 3 if validation fails
   513→ */
   514→function validateAdapter(adapterPackage: string): void {
   515→  // Use npx --no-install with --version to check if package exists
   516→  // This checks both global and local node_modules, handles scoped packages
   517→  const result = spawnSync(
   518→    "npx",
   519→    ["--no-install", adapterPackage, "--version"],
   520→    {
   521→      encoding: "utf-8",
   522→      stdio: "pipe",
   523→    },
   524→  );
   525→
   526→  if (result.status !== 0) {
   527→    error(
   528→      `Adapter package not found: ${adapterPackage}. Install with: npm install -g ${adapterPackage}`,
   529→    );
   530→    process.exit(EXIT_CODES.NOT_FOUND);
   531→  }
   532→}
   533→
   534→// ─── Tool Request Handler ────────────────────────────────────────────────────
   535→
   536→/**
   537→ * Handle tool requests from ACP agent.
   538→ * Implements file operations, terminal commands, and permission handling.
   539→ */
   540→async function handleRequest(
   541→  client: ACPClient,
   542→  id: string | number,
   543→  method: string,
   544→  params: unknown,
   545→  yolo: boolean,
   546→): Promise<void> {
   547→  try {
   548→    switch (method) {
   549→      case "session/request_permission": {
   550→        const p = params as RequestPermissionRequest;
   551→        // In yolo mode, auto-approve all permissions
   552→        // In normal mode, would need to implement permission UI
   553→        const options = p.options || [];
   554→
   555→        if (yolo) {
   556→          // Find an "allow" option (prefer allow_always, then allow_once)
   557→          const allowOption =
   558→            options.find((o) => o.kind === "allow_always") ||
   559→            options.find((o) => o.kind === "allow_once");
   560→
   561→          if (allowOption) {
   562→            client.respondPermission(id, {
   563→              outcome: { outcome: "selected", optionId: allowOption.optionId },
   564→            });
   565→          } else {
   566→            // No allow option available - cancel
   567→            client.respondPermission(id, { outcome: { outcome: "cancelled" } });
   568→          }
   569→        } else {
   570→          // TODO: Implement permission prompting
   571→          client.respondPermission(id, { outcome: { outcome: "cancelled" } });
   572→        }
   573→        break;
   574→      }
   575→
   576→      case "file/read": {
   577→        const p = params as ReadTextFileRequest;
   578→        const content = await fs.readFile(p.path, "utf-8");
   579→        client.respondReadTextFile(id, { content });
   580→        break;
   581→      }
   582→
   583→      case "file/write": {
   584→        const p = params as WriteTextFileRequest;
   585→        await fs.mkdir(path.dirname(p.path), { recursive: true });
   586→        await fs.writeFile(p.path, p.content, "utf-8");
   587→        client.respondWriteTextFile(id, {});
   588→        break;
   589→      }
   590→
   591→      case "terminal/run": {
   592→        // Custom method (not part of ACP spec - ACP uses createTerminal instead)
   593→        // TODO: Consider migrating to standard ACP terminal methods
   594→        const p = params as {
   595→          command: string;
   596→          cwd?: string;
   597→          timeout?: number;
   598→        };
   599→        const command = p.command;
   600→        const cwd = p.cwd || process.cwd();
   601→        const timeout = p.timeout || 60000;
   602→
   603→        const result = await new Promise<{
   604→          stdout: string;
   605→          stderr: string;
   606→          exitCode: number;
   607→        }>((resolve) => {
   608→          const child = spawn(command, [], {
   609→            cwd,
   610→            shell: true,
   611→            timeout,
   612→          });
   613→
   614→          let stdout = "";
   615→          let stderr = "";
   616→
   617→          child.stdout?.on("data", (data) => {
   618→            stdout += data.toString();
   619→          });
   620→
   621→          child.stderr?.on("data", (data) => {
   622→            stderr += data.toString();
   623→          });
   624→
   625→          child.on("close", (code) => {
   626→            resolve({ stdout, stderr, exitCode: code ?? 1 });
   627→          });
   628→
   629→          child.on("error", (err) => {
   630→            resolve({ stdout, stderr: err.message, exitCode: 1 });
   631→          });
   632→        });
   633→
   634→        // Using generic respond() since this is a custom method
   635→        client.respond(id, result);
   636→        break;
   637→      }
   638→
   639→      default:
   640→        // Unknown method - return error
   641→        client.respondError(id, -32601, `Method not found: ${method}`);
   642→    }
   643→  } catch (err) {
   644→    const message = err instanceof Error ? err.message : String(err);
   645→    client.respondError(id, -32000, message);
   646→  }
   647→}
   648→
   649→// ─── Subagent Support ─────────────────────────────────────────────────────────
   650→
   651→/**
   652→ * Build context for a PR review subagent.
   653→ * AC: @ralph-subagent-spawning ac-10
   654→ */
   655→async function buildSubagentContext(
   656→  ctx: KspecContext,
   657→  taskRef: string,
   658→): Promise<SubagentContext> {
   659→  // Load all tasks and items
   660→  const tasks = await loadAllTasks(ctx);
   661→  const items = await loadAllItems(ctx);
   662→  const index = new ReferenceIndex(tasks, items);
   663→
   664→  // Resolve task reference
   665→  const taskResult = index.resolve(taskRef);
   666→  if (!taskResult.ok) {
   667→    throw new Error(`Task not found: ${taskRef}`);
   668→  }
   669→
   670→  const task = tasks.find((t) => t._ulid === taskResult.ulid);
   671→  if (!task) {
   672→    throw new Error(`Task not found by ULID: ${taskResult.ulid}`);
   673→  }
   674→
   675→  // Get linked spec with ACs if spec_ref exists
   676→  let specWithACs: Record<string, unknown> | null = null;
   677→  if (task.spec_ref) {
   678→    const specResult = index.resolve(task.spec_ref);
   679→    if (specResult.ok) {
   680→      const item = items.find((i) => i._ulid === specResult.ulid);
   681→      if (item) {
   682→        specWithACs = item as unknown as Record<string, unknown>;
   683→      }
   684→    }
   685→  }
   686→
   687→  // Get git branch
   688→  const gitBranch = getCurrentBranch(ctx.rootDir) || "unknown";
   689→
   690→  return {
   691→    taskRef,
   692→    taskDetails: task as unknown as Record<string, unknown>,
   693→    specWithACs,
   694→    gitBranch,
   695→  };
   696→}
   697→
   698→/**
   699→ * Get the current status of a task.
   700→ * AC: @ralph-subagent-spawning ac-12
   701→ */
   702→function getTaskStatus(taskRef: string): string | null {
   703→  const result = spawnSync("kspec", ["task", "get", taskRef, "--json"], {
   704→    encoding: "utf-8",
   705→    stdio: "pipe",
   706→  });
   707→
   708→  if (result.status !== 0) {
   709→    warn(`Failed to check task status for ${taskRef}: ${result.stderr}`);
   710→    return null;
   711→  }
   712→
   713→  try {
   714→    return JSON.parse(result.stdout).status;
   715→  } catch {
   716→    warn(`Failed to parse task status for ${taskRef}`);
   717→    return null;
   718→  }
   719→}
   720→
   721→/**
   722→ * Mark a task as needing review due to subagent timeout.
   723→ * AC: @ralph-subagent-spawning ac-9
   724→ */
   725→async function markTaskNeedsReview(
   726→  taskRef: string,
   727→  reason: string,
   728→): Promise<void> {
   729→  const { spawnSync } = await import("node:child_process");
   730→
   731→  // Use kspec CLI to set automation status
   732→  const result = spawnSync(
   733→    "kspec",
   734→    ["task", "set-automation", taskRef, "needs_review"],
   735→    {
   736→      encoding: "utf-8",
   737→      stdio: "pipe",
   738→    },
   739→  );
   740→
   741→  if (result.status !== 0) {
   742→    warn(`Failed to mark task ${taskRef} as needs_review: ${result.stderr}`);
   743→  }
   744→
   745→  // Add a note explaining the timeout
   746→  const noteResult = spawnSync(
   747→    "kspec",
   748→    ["task", "note", taskRef, `[RALPH SUBAGENT] ${reason}`],
   749→    {
   750→      encoding: "utf-8",
   751→      stdio: "pipe",
   752→    },
   753→  );
   754→
   755→  if (noteResult.status !== 0) {
   756→    warn(`Failed to add timeout note to task ${taskRef}: ${noteResult.stderr}`);
   757→  }
   758→}
   759→
   760→/**
   761→ * Post a comment on the open PR for a task's branch, noting incomplete review.
   762→ * Uses `gh pr list --head <branch>` to find the PR and add a warning.
   763→ */
   764→async function commentOnPRReviewIncomplete(branch: string, reason: string): Promise<void> {
   765→  if (!branch || branch === "unknown") {
   766→    return;
   767→  }
   768→
   769→  const prListResult = spawnSync(
   770→    "gh",
   771→    ["pr", "list", "--state", "open", "--head", branch, "--json", "number", "--jq", ".[0].number"],
   772→    { encoding: "utf-8", stdio: "pipe" },
   773→  );
   774→
   775→  const prNumber = prListResult.stdout?.trim();
   776→  if (!prNumber || prListResult.status !== 0) {
   777→    // No open PR found — may already be merged or branch has no PR
   778→    return;
   779→  }
   780→
   781→  const body = `⚠️ **Review incomplete**: ${reason}\n\nThis PR was not fully reviewed by the ralph review subagent. Manual review recommended before merging.`;
   782→  const commentResult = spawnSync(
   783→    "gh",
   784→    ["pr", "comment", prNumber, "--body", body],
   785→    { encoding: "utf-8", stdio: "pipe" },
   786→  );
   787→
   788→  if (commentResult.status !== 0) {
   789→    warn(`Failed to comment on PR #${prNumber}: ${commentResult.stderr}`);
   790→  } else {
   791→    info(`${DEFAULT_SUBAGENT_PREFIX} Posted review-incomplete comment on PR #${prNumber}`);
   792→  }
   793→}
   794→
   795→/**
   796→ * Handle failed iteration by tracking per-task failures and escalating at threshold.
   797→ * AC: @loop-mode-error-handling ac-1, ac-2, ac-3, ac-4, ac-5, ac-8
   798→ */
   799→async function handleIterationFailure(
   800→  ctx: KspecContext,
   801→  tasksInProgressAtStart: ActiveTaskSummary[],
   802→  iterationStartTime: Date,
   803→  errorDescription: string,
   804→): Promise<void> {
   805→  if (tasksInProgressAtStart.length === 0) {
   806→    return;
   807→  }
   808→
   809→  // Re-load current tasks to check progress
   810→  const currentTasks = await loadAllTasks(ctx);
   811→  const index = new ReferenceIndex(currentTasks, await loadAllItems(ctx));
   812→
   813→  // Convert ActiveTaskSummary to Task-like objects for processing
   814→  const tasksInProgressFull = tasksInProgressAtStart
   815→    .map((summary) => {
   816→      const resolved = index.resolve(summary.ref);
   817→      if (!resolved.ok) return undefined;
   818→      // Check if the resolved item is a task (not a spec item or meta item)
   819→      const item = resolved.item;
   820→      if (!("status" in item)) return undefined; // Spec items don't have status
   821→      return currentTasks.find((t) => t._ulid === resolved.ulid);
   822→    })
   823→    .filter((t): t is LoadedTask => t !== undefined && t.status === "in_progress");
   824→
   825→  if (tasksInProgressFull.length === 0) {
   826→    return;
   827→  }
   828→
   829→  // Process failures
   830→  const { processFailedIteration, createFailureNote, getTaskFailureCount } = await import("../../ralph/index.js");
   831→
   832→  const results = processFailedIteration(
   833→    tasksInProgressFull,
   834→    currentTasks,
   835→    iterationStartTime,
   836→    errorDescription,
   837→  );
   838→
   839→  // Add notes and escalate tasks
   840→  for (const result of results) {
   841→    const taskRef = result.taskRef;
   842→    const task = currentTasks.find((t) => t._ulid === taskRef);
   843→    if (!task) continue;
   844→
   845→    const priorCount = result.failureCount - 1;
   846→    const noteContent = createFailureNote(taskRef, errorDescription, priorCount);
   847→
   848→    // Add LOOP-FAIL note
   849→    const noteResult = spawnSync(
   850→      "kspec",
   851→      ["task", "note", `@${taskRef}`, noteContent],
   852→      {
   853→        encoding: "utf-8",
   854→        stdio: "pipe",
   855→        cwd: process.cwd(),
   856→      },
   857→    );
   858→
   859→    if (noteResult.status !== 0) {
   860→      warn(`Failed to add failure note to task ${taskRef}: ${noteResult.stderr}`);
   861→      continue;
   862→    }
   863→
   864→    // AC: @loop-mode-error-handling ac-5 - Escalate at threshold
   865→    if (result.escalated) {
   866→      const escalateResult = spawnSync(
   867→        "kspec",
   868→        [
   869→          "task",
   870→          "set",
   871→          `@${taskRef}`,
   872→          "--automation",
   873→          "needs_review",
   874→          "--reason",
   875→          `Loop mode: 3 consecutive failures without progress`,
   876→        ],
   877→        {
   878→          encoding: "utf-8",
   879→          stdio: "pipe",
   880→          cwd: process.cwd(),
   881→        },
   882→      );
   883→
   884→      if (escalateResult.status !== 0) {
   885→        warn(`Failed to escalate task ${taskRef}: ${escalateResult.stderr}`);
   886→      } else {
   887→        info(`Escalated task ${taskRef} to automation:needs_review after 3 failures`);
   888→      }
   889→    }
   890→  }
   891→}
   892→
   893→/**
   894→ * Process pending_review tasks by spawning subagents.
   895→ * AC: @ralph-subagent-spawning ac-6, ac-8
   896→ */
   897→async function processPendingReviewTasks(
   898→  ctx: KspecContext,
   899→  adapter: AgentAdapter,
   900→  pendingReviewTasks: ActiveTaskSummary[],
   901→  options: {
   902→    yolo: boolean;
   903→    maxRetries: number;
   904→    maxFailures: number;
   905→    cwd: string;
   906→    subagentTimeout: number;
   907→  },
   908→  consecutiveFailures: { count: number },
   909→): Promise<boolean> {
   910→  if (pendingReviewTasks.length === 0) {
   911→    return true;
   912→  }
   913→
   914→  // Visual separator for subagent section
   915→  console.log("");
   916→  console.log(chalk.cyan(`${"═".repeat(60)}`));
   917→  console.log(chalk.cyan.bold(`${DEFAULT_SUBAGENT_PREFIX} Processing Pending Review Tasks`));
   918→  console.log(chalk.cyan(`${"═".repeat(60)}`));
   919→  console.log("");
   920→
   921→  info(
   922→    `${DEFAULT_SUBAGENT_PREFIX} Found ${pendingReviewTasks.length} pending_review task(s)`,
   923→  );
   924→
   925→  // AC: @ralph-subagent-spawning ac-6 - Process one at a time
   926→  for (const task of pendingReviewTasks) {
   927→    info(`${DEFAULT_SUBAGENT_PREFIX} Processing: ${task.ref} - ${task.title}`);
   928→
   929→    try {
   930→      // Build context for this task
   931→      const subagentCtx = await buildSubagentContext(ctx, task.ref);
   932→
   933→      // AC: @ralph-subagent-spawning ac-1, ac-3 - Spawn and wait
   934→      const result = await runSubagent(
   935→        adapter,
   936→        subagentCtx,
   937→        {
   938→          timeout: options.subagentTimeout,
   939→          outputPrefix: DEFAULT_SUBAGENT_PREFIX,
   940→        },
   941→        {
   942→          yolo: options.yolo,
   943→          cwd: options.cwd,
   944→          handleRequest: (client, reqId, method, params) =>
   945→            handleRequest(client, reqId, method, params, options.yolo),
   946→        },
   947→      );
   948→
   949→      if (result.timedOut) {
   950→        // AC: @ralph-subagent-spawning ac-9
   951→        warn(
   952→          `${DEFAULT_SUBAGENT_PREFIX} Subagent timed out for ${task.ref}`,
   953→        );
   954→        const timeoutMinutes = Math.round(options.subagentTimeout / 60000);
   955→        await markTaskNeedsReview(
   956→          task.ref,
   957→          `Subagent timed out after ${timeoutMinutes} minutes`,
   958→        );
   959→        await commentOnPRReviewIncomplete(subagentCtx.gitBranch, `Review subagent timed out after ${timeoutMinutes} minutes for task ${task.ref}.`);
   960→        consecutiveFailures.count++;
   961→      } else if (!result.success) {
   962→        // AC: @ralph-subagent-spawning ac-7
   963→        error(
   964→          `${DEFAULT_SUBAGENT_PREFIX} Subagent failed for ${task.ref}: ${result.error}`,
   965→        );
   966→        await commentOnPRReviewIncomplete(subagentCtx.gitBranch, `Review subagent failed for task ${task.ref}: ${result.error}`);
   967→        consecutiveFailures.count++;
   968→      } else {
   969→        // AC: @ralph-subagent-spawning ac-12 - Verify task outcome
   970→        const currentStatus = getTaskStatus(task.ref);
   971→
   972→        if (currentStatus === "completed") {
   973→          success(`${DEFAULT_SUBAGENT_PREFIX} Completed: ${task.ref}`);
   974→          consecutiveFailures.count = 0;
   975→        } else if (currentStatus === "needs_work") {
   976→          // Expected: reviewer found issues, kicked back to worker
   977→          info(`${DEFAULT_SUBAGENT_PREFIX} Review completed for ${task.ref} — issues found, kicked back to worker`);
   978→          // NOT a failure — the review worked correctly
   979→          consecutiveFailures.count = 0;
   980→        } else if (currentStatus === "pending_review") {
   981→          // Subagent didn't transition or merge — count as soft failure
   982→          warn(
   983→            `${DEFAULT_SUBAGENT_PREFIX} Subagent completed but task ${task.ref} unchanged`,
   984→          );
   985→          await markTaskNeedsReview(
   986→            task.ref,
   987→            "Subagent completed but did not merge or kick back. Review required.",
   988→          );
   989→          consecutiveFailures.count++;
   990→        } else {
   991→          warn(`${DEFAULT_SUBAGENT_PREFIX} Task ${task.ref} in unexpected state: ${currentStatus}`);
   992→          consecutiveFailures.count++;
   993→        }
   994→      }
   995→
   996→      // Check if we've hit max failures
   997→      if (consecutiveFailures.count >= options.maxFailures) {
   998→        error(
   999→          `${DEFAULT_SUBAGENT_PREFIX} Reached max failures (${options.maxFailures})`,
  1000→        );
  1001→        return false;
  1002→      }
  1003→    } catch (err) {
  1004→      const message = err instanceof Error ? err.message : String(err);
  1005→      error(`${DEFAULT_SUBAGENT_PREFIX} Error processing ${task.ref}: ${message}`);
  1006→      consecutiveFailures.count++;
  1007→
  1008→      if (consecutiveFailures.count >= options.maxFailures) {
  1009→        error(
  1010→          `${DEFAULT_SUBAGENT_PREFIX} Reached max failures (${options.maxFailures})`,
  1011→        );
  1012→        return false;
  1013→      }
  1014→    }
  1015→  }
  1016→
  1017→  // Visual separator at end of subagent section
  1018→  console.log("");
  1019→  console.log(chalk.cyan(`${"═".repeat(60)}`));
  1020→  console.log(chalk.cyan.bold(`${DEFAULT_SUBAGENT_PREFIX} Completed Review Processing`));
  1021→  console.log(chalk.cyan(`${"═".repeat(60)}`));
  1022→  console.log("");
  1023→
  1024→  return true;
  1025→}
  1026→
  1027→// ─── Command Registration ────────────────────────────────────────────────────
  1028→
  1029→export function registerRalphCommand(program: Command): void {
  1030→  const ralph = program
  1031→    .command("ralph")
  1032→    .description("Ralph automated task loop and agent control");
  1033→
  1034→  // end-loop subcommand - allows agent to signal loop termination
  1035→  // AC: @ralph-end-loop ac-cmd, ac-reason, ac-noop-outside
  1036→  ralph
  1037→    .command("end-loop")
  1038→    .description("End the ralph loop gracefully (stops all remaining iterations)")
  1039→    .option("--reason <reason>", "Reason for ending the loop")
  1040→    .action(async (options) => {
  1041→      try {
  1042→        const ctx = await initContext();
  1043→
  1044→        // Check if we're in a ralph session by looking for any ralph marker
  1045→        const taskLimitMarker = await readTaskLimitMarker(ctx.rootDir);
  1046→        const endLoopMarker = await readEndLoopMarker(ctx.rootDir);
  1047→
  1048→        // Write the marker with reason if provided
  1049→        await writeEndLoopMarker(ctx.rootDir, options.reason);
  1050→
  1051→        // Determine if we're likely in a ralph session
  1052→        const inRalphSession = taskLimitMarker !== null || endLoopMarker !== null;
  1053→
  1054→        if (!inRalphSession) {
  1055→          // AC: @ralph-end-loop ac-noop-outside
  1056→          warn("No active ralph session detected. Marker written but may have no effect.");
  1057→          info("This command is designed to be called by agents during a ralph loop.");
  1058→        } else {
  1059→          success("Loop end signal sent");
  1060→        }
  1061→
  1062→        if (options.reason) {
  1063→          info(`Reason: ${options.reason}`);
  1064→        }
  1065→      } catch (err) {
  1066→        error("Failed to signal end-loop", err);
  1067→        process.exit(EXIT_CODES.ERROR);
  1068→      }
  1069→    });
  1070→
  1071→  // Main ralph run command (default behavior when ralph is called directly)
  1072→  ralph
  1073→    .command("run", { isDefault: true })
  1074→    .description("Run ACP agent in a loop to process ready tasks")
  1075→    .argument("[args...]", "")
  1076→    .option("--max-loops <n>", "Maximum iterations", "5")
  1077→    .option("--max-retries <n>", "Max retries per iteration on error", "3")
  1078→    .option(
  1079→      "--max-failures <n>",
  1080→      "Max consecutive failed iterations before exit",
  1081→      "3",
  1082→    )
  1083→    .option("--dry-run", "Show prompt without executing")
  1084→    .option("--yolo", "Use dangerously-skip-permissions (default)", true)
  1085→    .option("--no-yolo", "Require normal permission prompts")
  1086→    .option("--subagent-timeout <minutes>", "Review subagent timeout in minutes", "20")
  1087→    .option("--adapter <id>", "Agent adapter to use", "claude-agent-acp")
  1088→    .option("--adapter-cmd <cmd>", "Custom adapter command (for testing)")
  1089→    .option(
  1090→      "--restart-every <n>",
  1091→      "Restart agent every N iterations to prevent OOM (0 = never)",
  1092→      "10",
  1093→    )
  1094→    .option(
  1095→      "--focus <instructions>",
  1096→      "Focus instructions included in every iteration prompt",
  1097→    )
  1098→    .option(
  1099→      "--max-tasks <n>",
  1100→      "Max tasks per iteration (0 = unlimited)",
  1101→      "1",
  1102→    )
  1103→    .option(
  1104→      "--tasks <refs>",
  1105→      "Explicit task scope: only work on these tasks (comma-separated refs, e.g., @task1,@task2)",
  1106→    )
  1107→    .action(async (args: string[], options) => {
  1108→      // Check for unknown subcommands that fell through to default
  1109→      // Only check args that look like subcommand names (alphanumeric with hyphens, no quotes)
  1110→      if (args.length > 0) {
  1111→        const unknownCmd = args[0];
  1112→        // Skip if it looks like a malformed option or quoted argument
  1113→        const looksLikeSubcommand = /^[a-z][a-z0-9-]*$/i.test(unknownCmd);
  1114→        if (looksLikeSubcommand) {
  1115→          if (unknownCmd === "end-iteration") {
  1116→            error(`Unknown command: ${unknownCmd}. Did you mean 'end-loop'?`);
  1117→            info("The command was renamed from 'end-iteration' to 'end-loop' to clarify it ends the entire loop.");
  1118→          } else {
  1119→            error(`Unknown command: ${unknownCmd}`);
  1120→          }
  1121→          info("Run 'kspec ralph --help' to see available commands.");
  1122→          process.exit(EXIT_CODES.USAGE_ERROR);
  1123→        }
  1124→      }
  1125→      try {
  1126→        const maxLoops = parseInt(options.maxLoops, 10);
  1127→        const maxRetries = parseInt(options.maxRetries, 10);
  1128→        const maxFailures = parseInt(options.maxFailures, 10);
  1129→
  1130→        if (Number.isNaN(maxLoops) || maxLoops < 1) {
  1131→          error(errors.usage.maxLoopsPositive);
  1132→          process.exit(EXIT_CODES.ERROR);
  1133→        }
  1134→
  1135→        if (Number.isNaN(maxRetries) || maxRetries < 0) {
  1136→          error(errors.usage.maxRetriesNonNegative);
  1137→          process.exit(EXIT_CODES.ERROR);
  1138→        }
  1139→
  1140→        if (Number.isNaN(maxFailures) || maxFailures < 1) {
  1141→          error(errors.usage.maxFailuresPositive);
  1142→          process.exit(EXIT_CODES.ERROR);
  1143→        }
  1144→
  1145→        const subagentTimeout = parseInt(options.subagentTimeout, 10);
  1146→        if (Number.isNaN(subagentTimeout) || subagentTimeout < 1) {
  1147→          error("--subagent-timeout must be a positive integer (minutes)");
  1148→          process.exit(EXIT_CODES.ERROR);
  1149→        }
  1150→
  1151→        const restartEvery = parseInt(options.restartEvery, 10);
  1152→        if (Number.isNaN(restartEvery) || restartEvery < 0) {
  1153→          error("--restart-every must be a non-negative integer");
  1154→          process.exit(EXIT_CODES.ERROR);
  1155→        }
  1156→
  1157→        // AC: @ralph-task-limit ac-flag
  1158→        const maxTasks = parseInt(options.maxTasks, 10);
  1159→        if (Number.isNaN(maxTasks) || maxTasks < 0 || maxTasks > 999) {
  1160→          error("--max-tasks must be 0 (unlimited) or a positive integer up to 999");
  1161→          process.exit(EXIT_CODES.USAGE_ERROR);
  1162→        }
  1163→
  1164→        // Handle custom adapter command for testing
  1165→        if (options.adapterCmd) {
  1166→          const parts = options.adapterCmd.split(/\s+/);
  1167→          const customAdapter: AgentAdapter = {
  1168→            command: parts[0],
  1169→            args: parts.slice(1),
  1170→            description: "Custom adapter via --adapter-cmd",
  1171→          };
  1172→          registerAdapter("custom", customAdapter);
  1173→          options.adapter = "custom";
  1174→        }
  1175→
  1176→        // Resolve adapter
  1177→        const adapter = resolveAdapter(options.adapter);
  1178→
  1179→        // Validate adapter package exists before proceeding
  1180→        // Skip validation for:
  1181→        // - Custom adapters (--adapter-cmd)
  1182→        // - Non-npx adapters
  1183→        // - Dry-run mode with default adapter (doesn't spawn agent, default may not be installed in CI)
  1184→        // Note: If user explicitly specifies --adapter, validate even in dry-run to catch typos
  1185→        // Accept both new and deprecated adapter names
  1186→        const isDefaultAdapter =
  1187→          options.adapter === "claude-agent-acp" ||
  1188→          options.adapter === "claude-code-acp";
  1189→        const skipValidation =
  1190→          options.adapterCmd ||
  1191→          adapter.command !== "npx" ||
  1192→          !adapter.args[0] ||
  1193→          (options.dryRun && isDefaultAdapter);
  1194→
  1195→        if (!skipValidation) {
  1196→          validateAdapter(adapter.args[0]);
  1197→        }
  1198→
  1199→        // Add yolo flag to adapter args if needed (accept both new and deprecated names)
  1200→        if (options.yolo && isDefaultAdapter) {
  1201→          adapter.args = [...adapter.args, "--dangerously-skip-permissions"];
  1202→        }
  1203→
  1204→        const restartInfo =
  1205→          restartEvery > 0 ? `, restart every ${restartEvery}` : "";
  1206→        const maxTasksInfo =
  1207→          maxTasks === 0 ? "unlimited" : `${maxTasks}`;
  1208→
  1209→        // Initialize kspec context early to validate --tasks
  1210→        const ctx = await initContext();
  1211→
  1212→        // AC: @cli-ralph ac-21 - Parse explicit task scope
  1213→        let explicitTaskScope: ExplicitTaskScope | undefined;
  1214→        if (options.tasks) {
  1215→          try {
  1216→            explicitTaskScope = await parseExplicitTasks(ctx, options.tasks);
  1217→            info(`Explicit task scope: ${explicitTaskScope.refs.join(", ")}`);
  1218→          } catch (err) {
  1219→            error(`Invalid --tasks argument: ${(err as Error).message}`);
  1220→            process.exit(EXIT_CODES.VALIDATION_FAILED);
  1221→          }
  1222→        }
  1223→
  1224→        const taskScopeInfo = explicitTaskScope
  1225→          ? `, tasks=${explicitTaskScope.refs.join(",")}`
  1226→          : "";
  1227→        info(
  1228→          `Starting ralph loop (adapter=${options.adapter}, max ${maxLoops} iterations, ${maxRetries} retries, ${maxFailures} max failures${restartInfo}, max-tasks=${maxTasksInfo}${taskScopeInfo})`,
  1229→        );
  1230→        if (options.focus) {
  1231→          info(`Focus: ${options.focus}`);
  1232→        }
  1233→        const specDir = ctx.specDir;
  1234→
  1235→        // Create session for event tracking
  1236→        const sessionId = ulid();
  1237→        await createSession(specDir, {
  1238→          id: sessionId,
  1239→          agent_type: options.adapter,
  1240→          task_id: undefined, // Will be determined per iteration
  1241→        });
  1242→
  1243→        // Log session start
  1244→        await appendEvent(specDir, {
  1245→          session_id: sessionId,
  1246→          type: "session.start",
  1247→          data: {
  1248→            adapter: options.adapter,
  1249→            maxLoops,
  1250→            maxRetries,
  1251→            maxFailures,
  1252→            maxTasks,
  1253→            yolo: options.yolo,
  1254→            focus: options.focus,
  1255→            explicitTasks: explicitTaskScope?.refs,
  1256→          },
  1257→        });
  1258→
  1259→        let consecutiveFailures = 0;
  1260→        let agent: SpawnedAgent | null = null;
  1261→        let acpSessionId: string | null = null;
  1262→
  1263→        // AC: @ralph-end-loop ac-signal-cleanup, @ralph-task-limit ac-signal-cleanup
  1264→        // Signal handlers for cleanup on Ctrl+C or kill
  1265→        // Note: Signal handlers must be synchronous, so we use Promise.finally()
  1266→        // to ensure cleanup completes before exit
  1267→        const signalCleanup = (signal: string) => {
  1268→          info(`Received ${signal}, cleaning up...`);
  1269→          // Kill agent if running
  1270→          if (agent) {
  1271→            agent.kill();
  1272→          }
  1273→          // Clean up marker files, then exit after cleanup completes
  1274→          Promise.all([
  1275→            clearTaskLimitMarker(ctx.rootDir),
  1276→            clearEndLoopMarker(ctx.rootDir),
  1277→          ]).finally(() => {
  1278→            process.exit(0);
  1279→          });
  1280→        };
  1281→        const sigintHandler = () => { signalCleanup("SIGINT"); };
  1282→        const sigtermHandler = () => { signalCleanup("SIGTERM"); };
  1283→        process.on("SIGINT", sigintHandler);
  1284→        process.on("SIGTERM", sigtermHandler);
  1285→
  1286→        // Create translator and renderer for this session
  1287→        const translator = createTranslator();
  1288→        const renderer = createCliRenderer();
  1289→
  1290→        // Task limit state - tracks completions per iteration
  1291→        // AC: @ralph-task-limit ac-reset, ac-wrapup
  1292→        let taskLimitReached = false;
  1293→        let tasksCompletedThisIteration = 0;
  1294→
  1295→        // End-loop signal state
  1296→        // AC: @ralph-end-loop ac-detect, ac-graceful
  1297→        let endLoopRequested = false;
  1298→
  1299→        // AC: @ralph-wrap-up-agent-on-loop-exit ac-1 - Track exit reason for wrap-up
  1300→        let exitReason: ExitReason | null = null;
  1301→        let lastIterationCtx: SessionContext | null = null;
  1302→        let lastErrorMessage: string | undefined;
  1303→        const recentTaskRefs: string[] = [];
  1304→
  1305→        try {
  1306→          for (let iteration = 1; iteration <= maxLoops; iteration++) {
  1307→            renderer.newSection?.(`Iteration ${iteration}/${maxLoops}`);
  1308→
  1309→            // AC: @ralph-task-limit ac-reset - Reset counter and clear stale markers at iteration start
  1310→            taskLimitReached = false;
  1311→            tasksCompletedThisIteration = 0;
  1312→            const wasStale = await clearStaleMarker(ctx.rootDir);
  1313→            if (wasStale) {
  1314→              info("Cleared stale task limit marker from previous session");
  1315→            }
  1316→            // Also clear any marker from previous iteration of this session
  1317→            await clearTaskLimitMarker(ctx.rootDir);
  1318→
  1319→            // AC: @ralph-end-loop ac-cleanup - Reset end-loop state
  1320→            endLoopRequested = false;
  1321→            const wasStaleEndLoop = await clearStaleEndLoopMarker(ctx.rootDir);
  1322→            if (wasStaleEndLoop) {
  1323→              info("Cleared stale end-loop marker from previous session");
  1324→            }
  1325→            await clearEndLoopMarker(ctx.rootDir);
  1326→
  1327→            // Gather fresh context each iteration
  1328→            // AC: @cli-ralph ac-16 - Only automation-eligible tasks (unless explicit scope)
  1329→            // AC: @cli-ralph ac-21 - With explicit task scope, ignore automation eligibility
  1330→            let sessionCtx = await gatherSessionContext(ctx, {
  1331→              limit: "10",
  1332→              eligible: !explicitTaskScope, // Skip eligibility filter if explicit scope
  1333→            });
  1334→
  1335→            // AC: @cli-ralph ac-21 - Filter to explicit tasks if scope is set
  1336→            if (explicitTaskScope) {
  1337→              sessionCtx = filterByExplicitTasks(sessionCtx, explicitTaskScope);
  1338→            }
  1339→
  1340→            // AC: @ralph-subagent-spawning ac-8 - Process pending_review tasks BEFORE main iteration
  1341→            // This wraps consecutiveFailures in an object so it can be mutated by the helper
  1342→            const failureTracker = { count: consecutiveFailures };
  1343→            const continueLoop = await processPendingReviewTasks(
  1344→              ctx,
  1345→              adapter,
  1346→              sessionCtx.pending_review_tasks,
  1347→              {
  1348→                yolo: options.yolo,
  1349→                maxRetries,
  1350→                maxFailures,
  1351→                cwd: process.cwd(),
  1352→                subagentTimeout: subagentTimeout * 60 * 1000,
  1353→              },
  1354→              failureTracker,
  1355→            );
  1356→            consecutiveFailures = failureTracker.count;
  1357→
  1358→            if (!continueLoop) {
  1359→              exitReason = "max_failures";
  1360→              lastIterationCtx = sessionCtx;
  1361→              break;
  1362→            }
  1363→
  1364→            // AC: @cli-ralph ac-20 - Refresh context after pending_review processing
  1365→            // If pending_review tasks were processed, they may have completed and unblocked
  1366→            // dependent tasks. Re-gather context to detect newly available tasks.
  1367→            let currentCtx = sessionCtx;
  1368→            if (sessionCtx.pending_review_tasks.length > 0) {
  1369→              currentCtx = await gatherSessionContext(ctx, {
  1370→                limit: "10",
  1371→                eligible: !explicitTaskScope,
  1372→              });
  1373→              if (explicitTaskScope) {
  1374→                currentCtx = filterByExplicitTasks(currentCtx, explicitTaskScope);
  1375→              }
  1376→            }
  1377→
  1378→            // AC: @cli-ralph ac-21 - Check explicit task completion
  1379→            if (explicitTaskScope) {
  1380→              const { done, statuses } = await allExplicitTasksDone(ctx, explicitTaskScope);
  1381→              if (done) {
  1382→                const statusList = Array.from(statuses.entries())
  1383→                  .map(([ref, status]) => `${ref}: ${status}`)
  1384→                  .join(", ");
  1385→                info(`All explicit tasks completed or blocked (${statusList}). Exiting loop.`);
  1386→                exitReason = "explicit_tasks_done";
  1387→                lastIterationCtx = currentCtx;
  1388→                break;
  1389→              }
  1390→            }
  1391→
  1392→            // Check for automation-eligible tasks (ready or in_progress)
  1393→            // AC: @cli-ralph ac-19
  1394→            const hasActiveTasks = currentCtx.active_tasks.length > 0;
  1395→            const hasReadyTasks = currentCtx.ready_tasks.length > 0;
  1396→
  1397→            if (!hasActiveTasks && !hasReadyTasks) {
  1398→              if (explicitTaskScope) {
  1399→                info("No explicit tasks available (ready or in_progress). Exiting loop.");
  1400→              } else {
  1401→                info("No automation-eligible tasks (ready or in_progress). Exiting loop.");
  1402→              }
  1403→              exitReason = "no_tasks";
  1404→              lastIterationCtx = currentCtx;
  1405→              break;
  1406→            }
  1407→
  1408→            // AC: @loop-mode-error-handling - Track tasks in progress for failure handling
  1409→            const tasksInProgressAtStart = sessionCtx.active_tasks;
  1410→            const iterationStartTime = new Date();
  1411→
  1412→            // Build prompts - task-work first, then reflect
  1413→            // AC: @cli-ralph ac-21 - Include explicit task scope in prompt
  1414→            const taskWorkPrompt = buildTaskWorkPrompt(
  1415→              currentCtx,
  1416→              iteration,
  1417→              maxLoops,
  1418→              sessionId,
  1419→              options.focus,
  1420→              explicitTaskScope,
  1421→            );
  1422→            const reflectPrompt = buildReflectPrompt(
  1423→              iteration,
  1424→              maxLoops,
  1425→              sessionId,
  1426→            );
  1427→
  1428→            // AC: @ralph-task-limit ac-dryrun, @cli-ralph ac-21
  1429→            if (options.dryRun) {
  1430→              console.log(
  1431→                chalk.yellow("=== DRY RUN - Configuration ===\n"),
  1432→              );
  1433→              console.log(`  max-loops: ${maxLoops}`);
  1434→              console.log(`  max-tasks: ${maxTasks === 0 ? "unlimited" : maxTasks}`);
  1435→              console.log(`  max-retries: ${maxRetries}`);
  1436→              console.log(`  max-failures: ${maxFailures}`);
  1437→              console.log(`  restart-every: ${restartEvery === 0 ? "never" : restartEvery}`);
  1438→              if (explicitTaskScope) {
  1439→                console.log(`  explicit-tasks: ${explicitTaskScope.refs.join(", ")}`);
  1440→              }
  1441→              console.log(
  1442→                chalk.yellow("\n=== Task Work Prompt ===\n"),
  1443→              );
  1444→              console.log(taskWorkPrompt);
  1445→              console.log(chalk.yellow("\n=== Reflect Prompt ===\n"));
  1446→              console.log(reflectPrompt);
  1447→              console.log(chalk.yellow("\n=== END DRY RUN ==="));
  1448→              break;
  1449→            }
  1450→
  1451→            // Log task-work prompt
  1452→            await appendEvent(specDir, {
  1453→              session_id: sessionId,
  1454→              type: "prompt.sent",
  1455→              data: {
  1456→                iteration,
  1457→                phase: "task-work",
  1458→                prompt: taskWorkPrompt,
  1459→                tasks: {
  1460→                  active: currentCtx.active_tasks.map((t) => t.ref),
  1461→                  ready: currentCtx.ready_tasks.map((t) => t.ref),
  1462→                },
  1463→              },
  1464→            });
  1465→
  1466→            // Retry loop for this iteration
  1467→            let lastError: Error | null = null;
  1468→            let succeeded = false;
  1469→
  1470→            for (let attempt = 1; attempt <= maxRetries + 1; attempt++) {
  1471→              if (attempt > 1) {
  1472→                console.log(
  1473→                  chalk.yellow(
  1474→                    `\nRetry attempt ${attempt - 1}/${maxRetries}...`,
  1475→                  ),
  1476→                );
  1477→              }
  1478→
  1479→              try {
  1480→                // Spawn agent if not already running
  1481→                if (!agent) {
  1482→                  info("Spawning ACP agent...");
  1483→                  agent = await spawnAndInitialize(adapter, {
  1484→                    cwd: process.cwd(),
  1485→                    clientOptions: {
  1486→                      clientInfo: {
  1487→                        name: "kspec-ralph",
  1488→                        version: packageVersion,
  1489→                      },
  1490→                      methodTimeouts: {
  1491→                        "session/prompt": RALPH_PROMPT_TIMEOUT,
  1492→                        "session/resume": RALPH_PROMPT_TIMEOUT,
  1493→                      },
  1494→                    },
  1495→                  });
  1496→
  1497→                  // Set up streaming update handler with translator + renderer
  1498→                  agent.client.on(
  1499→                    "update",
  1500→                    (_sid: string, update: SessionUpdate) => {
  1501→                      // Translate ACP event to RalphEvent and render
  1502→                      const event = translator.translate(update);
  1503→                      if (event) {
  1504→                        renderer.render(event);
  1505→                      }
  1506→
  1507→                      // AC: @ralph-task-limit ac-detection, ac-wrapup
  1508→                      // Detect task completions for limit enforcement
  1509→                      if (maxTasks > 0 && !taskLimitReached) {
  1510→                        const bashCmd = extractBashCommand(update);
  1511→                        if (bashCmd && detectTaskCompleteCommand(bashCmd)) {
  1512→                          // Pattern matched - verify via kspec query
  1513→                          getIterationStats(ctx, iterationStartTime)
  1514→                            .then(async (stats) => {
  1515→                              if (stats.tasks_completed >= maxTasks && !taskLimitReached) {
  1516→                                taskLimitReached = true;
  1517→                                tasksCompletedThisIteration = stats.tasks_completed;
  1518→                                info(`Task limit reached (${stats.tasks_completed}/${maxTasks})`);
  1519→
  1520→                                // AC: @ralph-task-limit ac-marker-format, ac-wrapup
  1521→                                // Write marker file for hook enforcement
  1522→                                const marker: TaskLimitMarker = {
  1523→                                  active: true,
  1524→                                  since: iterationStartTime.toISOString(),
  1525→                                  max: maxTasks,
  1526→                                  completed: stats.tasks_completed,
  1527→                                  sessionId,
  1528→                                };
  1529→                                await writeTaskLimitMarker(ctx.rootDir, marker);
  1530→
  1531→                                // Inject wrap-up message to agent
  1532→                                if (agent && acpSessionId) {
  1533→                                  const wrapUpMsg = `\n\n**TASK LIMIT REACHED** - ${stats.tasks_completed} task(s) completed this iteration (limit: ${maxTasks}).\n\nPlease wrap up your current work and exit cleanly. Do not start new tasks.\n\nCompleted tasks this iteration: ${stats.completed_refs.join(", ")}`;
  1534→                                  agent.client.prompt({
  1535→                                    sessionId: acpSessionId,
  1536→                                    prompt: [{ type: "text", text: wrapUpMsg }],
  1537→                                  }).catch(() => {
  1538→                                    // Ignore if message injection fails
  1539→                                  });
  1540→                                }
  1541→                              }
  1542→                            })
  1543→                            .catch(() => {
  1544→                              // Ignore query failures - detection is best-effort
  1545→                            });
  1546→                        }
  1547→                      }
  1548→
  1549→                      // AC: @ralph-end-loop ac-detect
  1550→                      // Detect explicit end-loop command
  1551→                      if (!endLoopRequested) {
  1552→                        const bashCmd = extractBashCommand(update);
  1553→                        if (bashCmd && detectEndLoopCommand(bashCmd)) {
  1554→                          endLoopRequested = true;
  1555→                          // Read marker to get reason if present
  1556→                          readEndLoopMarker(ctx.rootDir)
  1557→                            .then((marker) => {
  1558→                              const reason = marker?.reason
  1559→                                ? ` (${marker.reason})`
  1560→                                : "";
  1561→                              info(`End-loop signal received${reason}`);
  1562→                            })
  1563→                            .catch(() => {
  1564→                              info("End-loop signal received");
  1565→                            });
  1566→                        }
  1567→                      }
  1568→
  1569→                      // Log raw update event (async, non-blocking)
  1570→                      appendEvent(specDir, {
  1571→                        session_id: sessionId,
  1572→                        type: "session.update",
  1573→                        data: { iteration, update },
  1574→                      }).catch(() => {
  1575→                        // Ignore logging errors during streaming
  1576→                      });
  1577→                    },
  1578→                  );
  1579→
  1580→                  // Set up tool request handler
  1581→                  agent.client.on(
  1582→                    "request",
  1583→                    (
  1584→                      reqId: string | number,
  1585→                      method: string,
  1586→                      params: unknown,
  1587→                    ) => {
  1588→                      // biome-ignore lint/style/noNonNullAssertion: agent is guaranteed to exist when callback is registered
  1589→                      handleRequest(
  1590→                        agent!.client,
  1591→                        reqId,
  1592→                        method,
  1593→                        params,
  1594→                        options.yolo,
  1595→                      ).catch((err) => {
  1596→                        // biome-ignore lint/style/noNonNullAssertion: agent is guaranteed to exist when callback is registered
  1597→                        agent!.client.respondError(reqId, -32000, err.message);
  1598→                      });
  1599→                    },
  1600→                  );
  1601→                }
  1602→
  1603→                // Create fresh ACP session per iteration to keep context clean
  1604→                info("Creating ACP session...");
  1605→                acpSessionId = await agent.client.newSession({
  1606→                  cwd: process.cwd(),
  1607→                  mcpServers: [], // No MCP servers for now
  1608→                });
  1609→
  1610→                // Phase 1: Task Work
  1611→                info("Sending task-work prompt to agent...");
  1612→                const taskWorkResponse = await agent.client.prompt({
  1613→                  sessionId: acpSessionId!,
  1614→                  prompt: [{ type: "text", text: taskWorkPrompt }],
  1615→                });
  1616→
  1617→                // Log task-work completion
  1618→                await appendEvent(specDir, {
  1619→                  session_id: sessionId,
  1620→                  type: "session.update",
  1621→                  data: {
  1622→                    iteration,
  1623→                    phase: "task-work",
  1624→                    stopReason: taskWorkResponse.stopReason,
  1625→                    completed: true,
  1626→                  },
  1627→                });
  1628→
  1629→                if (taskWorkResponse.stopReason === "cancelled") {
  1630→                  throw new Error(errors.usage.agentPromptCancelled);
  1631→                }
  1632→
  1633→                // Phase 2: Reflect (always sent after task-work completes)
  1634→                info("Sending reflect prompt to agent...");
  1635→                await appendEvent(specDir, {
  1636→                  session_id: sessionId,
  1637→                  type: "prompt.sent",
  1638→                  data: {
  1639→                    iteration,
  1640→                    phase: "reflect",
  1641→                    prompt: reflectPrompt,
  1642→                  },
  1643→                });
  1644→
  1645→                const reflectResponse = await agent.client.prompt({
  1646→                  sessionId: acpSessionId!,
  1647→                  prompt: [{ type: "text", text: reflectPrompt }],
  1648→                });
  1649→
  1650→                // Log reflect completion
  1651→                await appendEvent(specDir, {
  1652→                  session_id: sessionId,
  1653→                  type: "session.update",
  1654→                  data: {
  1655→                    iteration,
  1656→                    phase: "reflect",
  1657→                    stopReason: reflectResponse.stopReason,
  1658→                    completed: true,
  1659→                  },
  1660→                });
  1661→
  1662→                if (reflectResponse.stopReason === "cancelled") {
  1663→                  throw new Error(errors.usage.agentPromptCancelled);
  1664→                }
  1665→
  1666→                succeeded = true;
  1667→                break;
  1668→              } catch (err) {
  1669→                lastError = err as Error;
  1670→                error(errors.failures.iterationFailed(lastError.message));
  1671→
  1672→                // Clean up agent on error - will respawn next attempt
  1673→                if (agent) {
  1674→                  agent.kill();
  1675→                  agent = null;
  1676→                  acpSessionId = null;
  1677→                }
  1678→              }
  1679→            }
  1680→
  1681→            if (succeeded) {
  1682→              console.log(); // Newline after streaming output
  1683→
  1684→              // Save session context snapshot for audit trail
  1685→              await saveSessionContext(
  1686→                specDir,
  1687→                sessionId,
  1688→                iteration,
  1689→                sessionCtx,
  1690→              );
  1691→
  1692→              success(`Completed iteration ${iteration}`);
  1693→              consecutiveFailures = 0;
  1694→
  1695→              // Track task refs from this iteration for wrap-up context
  1696→              for (const t of sessionCtx.active_tasks) {
  1697→                if (!recentTaskRefs.includes(t.ref)) {
  1698→                  recentTaskRefs.push(t.ref);
  1699→                }
  1700→              }
  1701→              lastIterationCtx = sessionCtx;
  1702→
  1703→              // AC: @ralph-end-loop ac-graceful - Check for end-loop signal
  1704→              if (endLoopRequested) {
  1705→                info("Agent requested end of loop. Exiting gracefully.");
  1706→                exitReason = "end_loop_signal";
  1707→                break;
  1708→              }
  1709→
  1710→              // Periodic agent restart to prevent OOM
  1711→              // AC: @cli-ralph ac-restart-periodic
  1712→              if (
  1713→                restartEvery > 0 &&
  1714→                iteration % restartEvery === 0 &&
  1715→                iteration < maxLoops
  1716→              ) {
  1717→                info(
  1718→                  `Restarting agent to prevent memory buildup (every ${restartEvery} iterations)...`,
  1719→                );
  1720→                if (agent) {
  1721→                  agent.kill();
  1722→                  agent = null;
  1723→                  acpSessionId = null;
  1724→                }
  1725→              }
  1726→            } else {
  1727→              consecutiveFailures++;
  1728→              error(
  1729→                errors.failures.iterationFailedAfterRetries(
  1730→                  iteration,
  1731→                  maxRetries,
  1732→                  consecutiveFailures,
  1733→                  maxFailures,
  1734→                ),
  1735→              );
  1736→              if (lastError) {
  1737→                error(errors.failures.lastError(lastError.message));
  1738→              }
  1739→
  1740→              // AC: @loop-mode-error-handling - Track per-task failures
  1741→              const errorDesc = lastError?.message || "Iteration failed after retries";
  1742→              await handleIterationFailure(
  1743→                ctx,
  1744→                tasksInProgressAtStart,
  1745→                iterationStartTime,
  1746→                errorDesc,
  1747→              );
  1748→
  1749→              if (consecutiveFailures >= maxFailures) {
  1750→                error(errors.failures.reachedMaxFailures(maxFailures));
  1751→                exitReason = "max_failures";
  1752→                lastErrorMessage = lastError?.message;
  1753→                lastIterationCtx = sessionCtx;
  1754→                break;
  1755→              }
  1756→
  1757→              info("Continuing to next iteration...");
  1758→            }
  1759→          }
  1760→
  1761→          // If loop completed all iterations without breaking
  1762→          if (exitReason === null) {
  1763→            exitReason = "max_iterations";
  1764→          }
  1765→        } finally {
  1766→          // Remove signal handlers to avoid double cleanup
  1767→          process.off("SIGINT", sigintHandler);
  1768→          process.off("SIGTERM", sigtermHandler);
  1769→
  1770→          // Clean up agent
  1771→          if (agent) {
  1772→            agent.kill();
  1773→            agent = null;
  1774→          }
  1775→
  1776→          // AC: @ralph-task-limit ac-reset - Clear marker file when session ends
  1777→          await clearTaskLimitMarker(ctx.rootDir);
  1778→
  1779→          // AC: @ralph-end-loop ac-cleanup - Clear end-loop marker when session ends
  1780→          await clearEndLoopMarker(ctx.rootDir);
  1781→
  1782→          // AC: @ralph-wrap-up-agent-on-loop-exit ac-1, ac-2, ac-3, ac-4, ac-5
  1783→          // Spawn wrap-up agent if not dry-run and we have an exit reason
  1784→          if (!options.dryRun && exitReason) {
  1785→            console.log("");
  1786→            console.log(chalk.cyan(`${"═".repeat(60)}`));
  1787→            console.log(chalk.cyan.bold(`${WRAPUP_AGENT_PREFIX} Starting Wrap-Up`));
  1788→            console.log(chalk.cyan(`${"═".repeat(60)}`));
  1789→            console.log("");
  1790→
  1791→            const inProgressTasks = lastIterationCtx?.active_tasks || [];
  1792→            const pendingReviewTasks = lastIterationCtx?.pending_review_tasks || [];
  1793→
  1794→            const wrapUpCtx = buildWrapUpContext(
  1795→              exitReason,
  1796→              sessionId,
  1797→              maxLoops, // Use maxLoops as iteration (we're at the end)
  1798→              maxLoops,
  1799→              inProgressTasks,
  1800→              pendingReviewTasks,
  1801→              recentTaskRefs,
  1802→              process.cwd(),
  1803→              lastErrorMessage,
  1804→            );
  1805→
  1806→            info(`Exit reason: ${exitReason}`);
  1807→            info(`Working tree: ${wrapUpCtx.workingTree.clean ? "clean" : "has uncommitted changes"}`);
  1808→
  1809→            const wrapUpResult = await runWrapUpAgent(
  1810→              adapter,
  1811→              wrapUpCtx,
  1812→              {
  1813→                yolo: options.yolo,
  1814→                cwd: process.cwd(),
  1815→                handleRequest: (client, reqId, method, params) =>
  1816→                  handleRequest(client, reqId, method, params, options.yolo),
  1817→              },
  1818→              DEFAULT_WRAPUP_TIMEOUT,
  1819→            );
  1820→
  1821→            // Log wrap-up result
  1822→            await appendEvent(specDir, {
  1823→              session_id: sessionId,
  1824→              type: "session.wrapup",
  1825→              data: {
  1826→                exitReason,
  1827→                result: wrapUpResult,
  1828→              },
  1829→            });
  1830→
  1831→            if (wrapUpResult.skipped) {
  1832→              info(`${WRAPUP_AGENT_PREFIX} Skipped: ${wrapUpResult.skipReason}`);
  1833→            } else if (wrapUpResult.timedOut) {
  1834→              warn(`${WRAPUP_AGENT_PREFIX} Timed out after ${DEFAULT_WRAPUP_TIMEOUT / 1000}s`);
  1835→            } else if (!wrapUpResult.success) {
  1836→              warn(`${WRAPUP_AGENT_PREFIX} Failed: ${wrapUpResult.error}`);
  1837→            } else {
  1838→              success(`${WRAPUP_AGENT_PREFIX} Completed`);
  1839→            }
  1840→
  1841→            console.log("");
  1842→            console.log(chalk.cyan(`${"═".repeat(60)}`));
  1843→            console.log(chalk.cyan.bold(`${WRAPUP_AGENT_PREFIX} Wrap-Up Complete`));
  1844→            console.log(chalk.cyan(`${"═".repeat(60)}`));
  1845→            console.log("");
  1846→          }
  1847→
  1848→          // Log session end
  1849→          const status =
  1850→            consecutiveFailures >= maxFailures ? "abandoned" : "completed";
  1851→          await appendEvent(specDir, {
  1852→            session_id: sessionId,
  1853→            type: "session.end",
  1854→            data: {
  1855→              status,
  1856→              consecutiveFailures,
  1857→              exitReason,
  1858→            },
  1859→          });
  1860→          await updateSessionStatus(specDir, sessionId, status);
  1861→        }
  1862→
  1863→        console.log(chalk.green(`\n${"─".repeat(60)}`));
  1864→        success("Ralph loop completed");
  1865→        console.log(chalk.green(`${"─".repeat(60)}\n`));
  1866→      } catch (err) {
  1867→        error(errors.failures.ralphLoop, err);
  1868→        process.exit(EXIT_CODES.ERROR);
  1869→      }
  1870→    });
  1871→}
  1872→
```