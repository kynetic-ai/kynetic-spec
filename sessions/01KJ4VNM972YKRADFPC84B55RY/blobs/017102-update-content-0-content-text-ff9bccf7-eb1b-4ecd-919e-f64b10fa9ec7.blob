    10→    title: JSON Output Mode
    11→    type: trait
    12→    description: Commands support --json flag for structured JSON output with consistent formatting
    13→    acceptance_criteria:
    14→      - id: ac-1
    15→        given: command supports JSON mode
    16→        when: --json flag is provided
    17→        then: output is valid JSON with no ANSI color codes
    18→      - id: ac-2
    19→        given: JSON mode is active
    20→        when: command completes successfully
    21→        then: output includes all data available in human-readable mode
    22→      - id: ac-3
    23→        given: JSON mode is active
    24→        when: command encounters an error
    25→        then: error is returned as JSON object with error field
    26→      - id: ac-4
