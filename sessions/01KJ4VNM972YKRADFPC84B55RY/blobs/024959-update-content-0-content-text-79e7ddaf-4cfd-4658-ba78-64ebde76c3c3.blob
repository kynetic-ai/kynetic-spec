```
     1→/**
     2→ * Batch command parsing, validation, execution, and error reporting.
     3→ *
     4→ * Parses JSON batch input from stdin/file/inline, validates command paths
     5→ * against the CLI's introspection tree, executes in atomic or immediate
     6→ * mode, and produces helpful error messages.
     7→ */
     8→
     9→import * as fs from "node:fs/promises";
    10→import * as path from "node:path";
    11→import * as os from "node:os";
    12→import chalk from "chalk";
    13→import type { Command, CommanderError } from "commander";
    14→import { ZodError } from "zod";
    15→import {
    16→  BatchInputSchema,
    17→  type BatchCommand,
    18→  type BatchCommandResult,
    19→  type BatchExecMode,
    20→  type BatchExecResult,
    21→  type BatchInput,
    22→} from "../schema/batch.js";
    23→import { initContext } from "../parser/yaml.js";
    24→import { shadowAutoCommit, shadowPushAsync } from "../parser/shadow.js";
    25→import type { CommandMeta } from "./introspection.js";
    26→import { extractCommandTree, findCommand, flattenCommandTree } from "./introspection.js";
    27→import { findClosestCommand } from "./suggest.js";
    28→import { createBatchCommandFilter } from "./command-annotations.js";
    29→import { setJsonMode, setVerboseMode } from "./output.js";
    30→import {
    31→  BatchExitError,
    32→  OutputCapture,
    33→  installExitInterceptor,
    34→  uninstallExitInterceptor,
    35→  setBatchMode,
    36→  isBatchMode,
    37→} from "./batch-context.js";
    38→
    39→// ── Input Source Types ───────────────────────────────────────────────
    40→
    41→export type BatchInputSource =
    42→  | { type: "stdin" }
    43→  | { type: "file"; path: string }
    44→  | { type: "inline"; json: string };
    45→
    46→// ── Error Types ─────────────────────────────────────────────────────
    47→
    48→export class BatchParseError extends Error {
    49→  constructor(message: string) {
    50→    super(message);
    51→    this.name = "BatchParseError";
    52→  }
    53→}
    54→
    55→export type BatchValidationErrorType =
    56→  | "unknown_command"
    57→  | "missing_required"
    58→  | "unknown_arg"
    59→  | "rejected_command";
    60→
    61→export interface BatchValidationError {
    62→  /** Index in the batch array */
    63→  index: number;
    64→  /** Correlation ID if provided */
    65→  id?: string;
    66→  /** The command string from input */
    67→  command: string;
    68→  /** Error classification */
    69→  type: BatchValidationErrorType;
    70→  /** Human-readable error message */
    71→  message: string;
    72→  /** Suggested correction (e.g. closest command name) */
    73→  suggestion?: string;
    74→}
    75→
    76→export interface BatchValidationResult {
    77→  /** Whether all commands passed validation */
    78→  valid: boolean;
    79→  /** Validated commands (only present when valid) */
    80→  commands: BatchCommand[];
    81→  /** Validation errors */
    82→  errors: BatchValidationError[];
    83→}
    84→
    85→export interface ValidateBatchOptions {
    86→  /**
    87→   * Optional predicate to filter which commands are allowed.
    88→   * Extension point for allowed-commands task (@01KGR05NE).
    89→   * When provided, commands that don't pass the filter are rejected
    90→   * with a "rejected_command" error.
    91→   */
    92→  commandFilter?: (cmd: CommandMeta) => boolean;
    93→}
    94→
    95→// ── Parsing ─────────────────────────────────────────────────────────
    96→
    97→/**
    98→ * Read raw text from a batch input source.
    99→ */
   100→async function readSource(source: BatchInputSource): Promise<string> {
   101→  switch (source.type) {
   102→    case "inline":
   103→      return source.json;
   104→
   105→    case "file":
   106→      try {
   107→        return await fs.readFile(source.path, "utf-8");
   108→      } catch (err) {
   109→        throw new BatchParseError(
   110→          `Failed to read batch file: ${(err as Error).message}`,
   111→        );
   112→      }
   113→
   114→    case "stdin": {
   115→      const chunks: Buffer[] = [];
   116→      for await (const chunk of process.stdin) {
   117→        chunks.push(chunk as Buffer);
   118→      }
   119→      const text = Buffer.concat(chunks).toString("utf-8");
   120→      if (!text.trim()) {
   121→        throw new BatchParseError("No input received on stdin");
   122→      }
   123→      return text;
   124→    }
   125→  }
   126→}
   127→
   128→/**
   129→ * Parse batch input from a source, returning validated commands.
   130→ *
   131→ * @throws {BatchParseError} on invalid JSON, empty array, or schema violations
   132→ */
   133→export async function parseBatchInput(
   134→  source: BatchInputSource,
   135→): Promise<BatchInput> {
   136→  const raw = await readSource(source);
   137→
   138→  // Parse JSON — preserve the native error message which includes position
   139→  let parsed: unknown;
   140→  try {
   141→    parsed = JSON.parse(raw);
   142→  } catch (err) {
   143→    throw new BatchParseError(
   144→      `Invalid JSON: ${(err as SyntaxError).message}`,
   145→    );
   146→  }
   147→
   148→  // Validate against schema
   149→  try {
   150→    return BatchInputSchema.parse(parsed);
   151→  } catch (err) {
   152→    if (err instanceof ZodError) {
   153→      const messages = err.errors.map((e) => {
   154→        const path = e.path.length > 0 ? ` at ${e.path.join(".")}` : "";
   155→        return `${e.message}${path}`;
   156→      });
   157→      throw new BatchParseError(
   158→        `Batch validation failed: ${messages.join("; ")}`,
   159→      );
   160→    }
   161→    throw err;
   162→  }
   163→}
   164→
   165→// ── Validation ──────────────────────────────────────────────────────
   166→
   167→/**
   168→ * Extract the option name from Commander flag syntax.
   169→ * e.g. "-f, --force" → "force", "--spec-ref <value>" → "spec-ref"
   170→ */
   171→function extractOptionName(flags: string): string | null {
   172→  const match = flags.match(/--([a-zA-Z0-9-]+)/);
   173→  return match ? match[1] : null;
   174→}
   175→
   176→/**
   177→ * Convert a kebab-case string to camelCase.
   178→ * e.g. "spec-ref" → "specRef"
   179→ */
   180→function kebabToCamel(s: string): string {
   181→  return s.replace(/-([a-z])/g, (_, c) => c.toUpperCase());
   182→}
   183→
   184→/**
   185→ * Get all known argument and option names for a command, returning both
   186→ * kebab-case and camelCase variants.
   187→ */
   188→function getKnownArgNames(
   189→  cmd: CommandMeta,
   190→): { names: Set<string>; required: string[] } {
   191→  const names = new Set<string>();
   192→  const required: string[] = [];
   193→
   194→  // Positional arguments
   195→  for (const arg of cmd.arguments) {
   196→    names.add(arg.name);
   197→    names.add(kebabToCamel(arg.name));
   198→    if (arg.required) {
   199→      required.push(arg.name);
   200→    }
   201→  }
   202→
   203→  // Options
   204→  for (const opt of cmd.options) {
   205→    const optName = extractOptionName(opt.flags);
   206→    if (optName) {
   207→      names.add(optName);
   208→      names.add(kebabToCamel(optName));
   209→      if (opt.mandatory) {
   210→        required.push(optName);
   211→      }
   212→    }
   213→  }
   214→
   215→  return { names, required };
   216→}
   217→
   218→/**
   219→ * Collect all leaf command paths from a command tree as space-joined strings.
   220→ */
   221→function collectLeafCommandPaths(tree: CommandMeta): string[] {
   222→  const flat = flattenCommandTree(tree);
   223→  return flat
   224→    .filter((cmd) => cmd.subcommands.length === 0)
   225→    .map((cmd) => cmd.fullPath.slice(1).join(" ")) // skip root name
   226→    .filter((path) => path.length > 0);
   227→}
   228→
   229→/**
   230→ * Validate batch commands against the CLI's command tree.
   231→ *
   232→ * AC: @batch-command-schema ac-command-field — validates command paths
   233→ * AC: @batch-command-schema ac-args-mapping — validates arg names
   234→ * AC: @batch-command-schema ac-unknown-command — suggests similar commands
   235→ * AC: @batch-command-schema ac-missing-required — identifies missing args
   236→ * AC: @batch-command-schema ac-id-field — preserves id in errors
   237→ */
   238→export function validateBatchCommands(
   239→  commands: BatchCommand[],
   240→  program: CommandMeta,
   241→  options?: ValidateBatchOptions,
   242→): BatchValidationResult {
   243→  const errors: BatchValidationError[] = [];
   244→  const validLeafPaths = collectLeafCommandPaths(program);
   245→
   246→  for (let i = 0; i < commands.length; i++) {
   247→    const cmd = commands[i];
   248→    const parts = cmd.command.trim().split(/\s+/);
   249→
   250→    // 1. Resolve command path
   251→    const found = findCommand(program, parts);
   252→
   253→    if (!found) {
   254→      // Unknown command — suggest closest
   255→      const suggestion = findClosestCommand(cmd.command, validLeafPaths);
   256→      errors.push({
   257→        index: i,
   258→        id: cmd.id,
   259→        command: cmd.command,
   260→        type: "unknown_command",
   261→        message: `Unknown command: "${cmd.command}"`,
   262→        suggestion: suggestion ?? undefined,
   263→      });
   264→      continue;
   265→    }
   266→
   267→    // Reject command groups (non-leaf nodes)
   268→    if (found.subcommands.length > 0) {
   269→      const suggestion = findClosestCommand(cmd.command, validLeafPaths);
   270→      errors.push({
   271→        index: i,
   272→        id: cmd.id,
   273→        command: cmd.command,
   274→        type: "unknown_command",
   275→        message: `"${cmd.command}" is a command group, not an executable command`,
   276→        suggestion: suggestion ?? undefined,
   277→      });
   278→      continue;
   279→    }
   280→
   281→    // 2. Reject nested batch commands (batch or any subcommands like batch commands)
   282→    // AC: @batch-allowed-commands ac-batch-itself
   283→    if (found.fullPath[1] === "batch") {
   284→      errors.push({
   285→        index: i,
   286→        id: cmd.id,
   287→        command: cmd.command,
   288→        type: "rejected_command",
   289→        message: "Nested batch commands are not allowed",
   290→      });
   291→      continue;
   292→    }
   293→
   294→    // 3. Apply command filter if provided
   295→    // AC: @batch-allowed-commands ac-denylist
   296→    if (options?.commandFilter && !options.commandFilter(found)) {
   297→      errors.push({
   298→        index: i,
   299→        id: cmd.id,
   300→        command: cmd.command,
   301→        type: "rejected_command",
   302→        message: `Command "${cmd.command}" is not allowed in batch mode. Only mutating commands can be used in batch.`,
   303→      });
   304→      continue;
   305→    }
   306→
   307→    // 4. Check for unknown args
   308→    const { names: knownNames, required: requiredNames } =
   309→      getKnownArgNames(found);
   310→
   311→    // Collect all known names as flat array for suggestion matching
   312→    const knownNamesArray = Array.from(knownNames);
   313→
   314→    for (const argKey of Object.keys(cmd.args)) {
   315→      // Accept both kebab-case and camelCase
   316→      if (!knownNames.has(argKey)) {
   317→        const suggestion = findClosestCommand(argKey, knownNamesArray);
   318→        errors.push({
   319→          index: i,
   320→          id: cmd.id,
   321→          command: cmd.command,
   322→          type: "unknown_arg",
   323→          message: `Unknown argument "${argKey}" for command "${cmd.command}"`,
   324→          suggestion: suggestion ?? undefined,
   325→        });
   326→      }
   327→    }
   328→
   329→    // 5. Check for missing required args
   330→    for (const reqName of requiredNames) {
   331→      const camelName = kebabToCamel(reqName);
   332→      if (
   333→        !(reqName in cmd.args) &&
   334→        !(camelName in cmd.args) &&
   335→        // Skip if provided via positional alias
   336→        !Object.keys(cmd.args).some(
   337→          (k) => kebabToCamel(k) === camelName,
   338→        )
   339→      ) {
   340→        errors.push({
   341→          index: i,
   342→          id: cmd.id,
   343→          command: cmd.command,
   344→          type: "missing_required",
   345→          message: `Missing required argument "${reqName}" for command "${cmd.command}"`,
   346→        });
   347→      }
   348→    }
   349→  }
   350→
   351→  return {
   352→    valid: errors.length === 0,
   353→    commands,
   354→    errors,
   355→  };
   356→}
   357→
   358→// ── Error Reporting ─────────────────────────────────────────────────
   359→
   360→/**
   361→ * Format validation errors for human or JSON output.
   362→ *
   363→ * @param result - Validation result containing errors
   364→ * @param json - If true, return JSON string; otherwise human-readable lines
   365→ * @returns Formatted error string
   366→ */
   367→export function reportBatchValidationErrors(
   368→  result: BatchValidationResult,
   369→  json: boolean = false,
   370→): string {
   371→  if (result.valid) {
   372→    return json ? JSON.stringify({ valid: true, errors: [] }) : "";
   373→  }
   374→
   375→  if (json) {
   376→    return JSON.stringify(
   377→      {
   378→        valid: false,
   379→        errors: result.errors,
   380→      },
   381→      null,
   382→      2,
   383→    );
   384→  }
   385→
   386→  // Human-readable format
   387→  const lines: string[] = [];
   388→  for (const err of result.errors) {
   389→    const label = err.id ?? `#${err.index}`;
   390→    lines.push(`[${label}] ${err.message}`);
   391→    if (err.suggestion) {
   392→      lines.push(`  Did you mean: ${err.suggestion}?`);
   393→    }
   394→  }
   395→  // Add helpful hint for discoverability
   396→  lines.push("");
   397→  lines.push("Run 'kspec batch commands' for a list of available commands.");
   398→  return lines.join("\n");
   399→}
   400→
   401→// ── Execution Engine ─────────────────────────────────────────────────
   402→
   403→export interface ExecuteBatchOptions {
   404→  /** Use atomic mode (default true) */
   405→  atomic: boolean;
   406→  /** Continue on error (implies immediate mode) */
   407→  continueOnError: boolean;
   408→  /** Validate-only mode */
   409→  dryRun: boolean;
   410→  /** JSON output */
   411→  json: boolean;
   412→}
   413→
   414→/**
   415→ * Build Commander argv from a BatchCommand and its CommandMeta.
   416→ *
   417→ * Translates { command: "inbox add", args: { content: "hello", tag: ["a","b"] } }
   418→ * into ["inbox", "add", "hello", "--tag", "a", "--tag", "b"]
   419→ *
   420→ * Positional args are emitted in Commander definition order (not JSON key order)
   421→ * to ensure correct argument mapping regardless of how the JSON was serialized.
   422→ */
   423→export function buildCommandArgv(cmd: BatchCommand, cmdMeta: CommandMeta): string[] {
   424→  const argv: string[] = [...cmd.command.trim().split(/\s+/)];
   425→
   426→  // Build sets for classification
   427→  const positionalDefs = cmdMeta.arguments; // ordered by Commander definition
   428→  const positionalNameSet = new Set<string>();
   429→  for (const arg of positionalDefs) {
   430→    positionalNameSet.add(arg.name);
   431→    positionalNameSet.add(kebabToCamel(arg.name));
   432→  }
   433→
   434→  const optionMap = new Map<string, { flags: string; variadic: boolean }>();
   435→  for (const opt of cmdMeta.options) {
   436→    const name = extractOptionName(opt.flags);
   437→    if (name) {
   438→      optionMap.set(name, { flags: opt.flags, variadic: opt.variadic });
   439→      optionMap.set(kebabToCamel(name), { flags: opt.flags, variadic: opt.variadic });
   440→    }
   441→  }
   442→
   443→  // Phase 1: Emit positional args in Commander definition order
   444→  for (const argDef of positionalDefs) {
   445→    const name = argDef.name;
   446→    const camelName = kebabToCamel(name);
   447→    const value = cmd.args[name] ?? cmd.args[camelName];
   448→    if (value === undefined) continue;
   449→
   450→    if (Array.isArray(value)) {
   451→      for (const v of value) argv.push(String(v));
   452→    } else {
   453→      argv.push(String(value));
   454→    }
   455→  }
   456→
   457→  // Phase 2: Emit options from remaining keys
   458→  for (const [key, value] of Object.entries(cmd.args)) {
   459→    const camelKey = kebabToCamel(key);
   460→    // Skip positional args (already emitted)
   461→    if (positionalNameSet.has(key) || positionalNameSet.has(camelKey)) {
   462→      continue;
   463→    }
   464→
   465→    // Convert camelCase key back to kebab-case for CLI
   466→    const kebabKey = key.replace(/[A-Z]/g, (m) => `-${m.toLowerCase()}`);
   467→    const flagName = `--${kebabKey}`;
   468→
   469→    if (typeof value === "boolean") {
   470→      if (value) {
   471→        argv.push(flagName);
   472→      }
   473→      // false booleans: omit (Commander treats absence as false)
   474→    } else if (Array.isArray(value)) {
   475→      // Variadic or repeated options
   476→      for (const v of value) {
   477→        argv.push(flagName, String(v));
   478→      }
   479→    } else if (value !== null && value !== undefined) {
   480→      argv.push(flagName, String(value));
   481→    }
   482→  }
   483→
   484→  return argv;
   485→}
   486→
   487→/**
   488→ * Reset Commander command tree state between dispatches.
   489→ * Commander retains _optionValues between parseAsync calls.
   490→ */
   491→export function resetCommandTree(cmd: Command): void {
   492→  (cmd as any)._optionValues = {};
   493→  (cmd as any)._optionValueSources = {};
   494→  (cmd as any).processedArgs = [];
   495→  for (const sub of cmd.commands) {
   496→    resetCommandTree(sub);
   497→  }
   498→}
   499→
   500→/**
   501→ * Check if a CommandMeta supports the --force option.
   502→ */
   503→function commandHasForce(cmdMeta: CommandMeta): boolean {
   504→  return cmdMeta.options.some((opt) => {
   505→    const name = extractOptionName(opt.flags);
   506→    return name === "force";
   507→  });
   508→}
   509→
   510→/**
   511→ * Execute a batch of commands.
   512→ *
   513→ * AC: @batch-exec ac-default-atomic — atomic mode by default
   514→ * AC: @batch-exec ac-no-atomic-flag — immediate mode with --no-atomic
   515→ * AC: @batch-exec ac-stop-on-error — stop on first failure (default)
   516→ * AC: @batch-exec ac-continue — continue on error with --continue
   517→ * AC: @batch-exec ac-dry-run — validate without executing
   518→ * AC: @batch-exec ac-prevalidate — validation before any execution
   519→ * AC: @batch-exec ac-confirmation-suppressed — auto-append --force
   520→ */
   521→export async function executeBatch(
   522→  commands: BatchCommand[],
   523→  program: Command,
   524→  options: ExecuteBatchOptions,
   525→): Promise<BatchExecResult> {
   526→  const mode: BatchExecMode = options.atomic ? "atomic" : "immediate";
   527→
   528→  // Build command tree for validation
   529→  const tree = extractCommandTree(program);
   530→  const commandFilter = createBatchCommandFilter();
   531→
   532→  // AC: ac-prevalidate — validate all commands before executing any
   533→  const validation = validateBatchCommands(commands, tree, { commandFilter });
   534→  if (!validation.valid) {
   535→    return {
   536→      success: false,
   537→      mode,
   538→      summary: {
   539→        total: commands.length,
   540→        succeeded: 0,
   541→        failed: validation.errors.length,
   542→      },
   543→      results: validation.errors.map((err) => ({
   544→        index: err.index,
   545→        id: err.id,
   546→        command: err.command,
   547→        success: false,
   548→        error: err.message,
   549→        suggestion: err.suggestion,
   550→      })),
   551→      validationFailed: true,
   552→    };
   553→  }
   554→
   555→  // AC: ac-dry-run — validate without executing
   556→  if (options.dryRun) {
   557→    return {
   558→      success: true,
   559→      mode,
   560→      summary: { total: commands.length, succeeded: commands.length, failed: 0 },
   561→      results: commands.map((cmd, i) => ({
   562→        index: i,
   563→        id: cmd.id,
   564→        command: cmd.command,
   565→        success: true,
   566→        output: "dry-run: would execute",
   567→      })),
   568→    };
   569→  }
   570→
   571→  if (options.atomic) {
   572→    return executeAtomic(commands, program, tree, options);
   573→  } else {
   574→    return executeImmediate(commands, program, tree, options);
   575→  }
   576→}
   577→
   578→/**
   579→ * Atomic execution: copy specDir to temp, run all, copy back on success.
   580→ *
   581→ * AC: @batch-exec ac-default-atomic
   582→ * AC: @batch-exec ac-atomic-rollback
   583→ * AC: @batch-exec ac-atomic-isolation
   584→ * AC: @batch-exec ac-single-commit
   585→ */
   586→async function executeAtomic(
   587→  commands: BatchCommand[],
   588→  program: Command,
   589→  tree: CommandMeta,
   590→  options: ExecuteBatchOptions,
   591→): Promise<BatchExecResult> {
   592→  // Get the real context for copy-back
   593→  const ctx = await initContext();
   594→  const realSpecDir = ctx.specDir;
   595→
   596→  // Create temp copy using mkdtemp for safe, collision-free naming
   597→  const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), "kspec-batch-"));
   598→  await fs.cp(realSpecDir, tempDir, { recursive: true });
   599→
   600→  // Remove .git from temp copy to prevent worktree pointer leaks
   601→  await fs.rm(path.join(tempDir, ".git"), { force: true, recursive: true });
   602→
   603→  // Set up atomic context
   604→  const savedChalkLevel = chalk.level;
   605→  const savedSpecDir = process.env.KSPEC_SPEC_DIR;
   606→  const savedBatchProjectRoot = process.env.KSPEC_BATCH_PROJECT_ROOT;
   607→  // AC: @project-config ac-7 — set real project root before redirecting spec dir
   608→  process.env.KSPEC_BATCH_PROJECT_ROOT = ctx.rootDir;
   609→  process.env.KSPEC_SPEC_DIR = tempDir;
   610→  setBatchMode(true);
   611→  chalk.level = 0;
   612→
   613→  const results: BatchCommandResult[] = [];
   614→  let allSucceeded = true;
   615→  let copyBackFailed = false;
   616→
   617→  try {
   618→    for (let i = 0; i < commands.length; i++) {
   619→      const cmd = commands[i];
   620→      const result = await dispatchCommand(cmd, i, program, tree);
   621→      results.push(result);
   622→
   623→      if (!result.success) {
   624→        allSucceeded = false;
   625→        // Atomic mode: stop on first failure, discard everything
   626→        // Fill remaining as not-executed
   627→        for (let j = i + 1; j < commands.length; j++) {
   628→          results.push({
   629→            index: j,
   630→            id: commands[j].id,
   631→            command: commands[j].command,
   632→            success: false,
   633→            error: "Not executed (prior command failed in atomic mode)",
   634→          });
   635→        }
   636→        break;
   637→      }
   638→    }
   639→
   640→    // Copy back on success
   641→    if (allSucceeded) {
   642→      try {
   643→        // Clear real specDir contents (except .git and .gitattributes) before copy-back
   644→        const entries = await fs.readdir(realSpecDir);
   645→        for (const entry of entries) {
   646→          if (entry === ".git" || entry === ".gitattributes") continue;
   647→          await fs.rm(path.join(realSpecDir, entry), { recursive: true, force: true });
   648→        }
   649→        // Copy temp contents back
   650→        const tempEntries = await fs.readdir(tempDir);
   651→        for (const entry of tempEntries) {
   652→          await fs.cp(
   653→            path.join(tempDir, entry),
   654→            path.join(realSpecDir, entry),
   655→            { recursive: true },
   656→          );
   657→        }
   658→
   659→        // Single shadow commit for all changes
   660→        if (ctx.shadow?.enabled) {
   661→          const successCount = results.filter((r) => r.success).length;
   662→          await shadowAutoCommit(
   663→            ctx.shadow.worktreeDir,
   664→            `batch: ${successCount} command${successCount !== 1 ? "s" : ""}`,
   665→          );
   666→          shadowPushAsync(ctx.shadow.worktreeDir);
   667→        }
   668→      } catch (copyErr) {
   669→        // Copy-back failed — preserve tempDir for manual recovery
   670→        copyBackFailed = true;
   671→        allSucceeded = false;
   672→        console.error(
   673→          `Batch copy-back failed: ${copyErr instanceof Error ? copyErr.message : copyErr}`,
   674→        );
   675→        console.error(`Temp dir preserved for recovery: ${tempDir}`);
   676→      }
   677→    }
   678→  } finally {
   679→    // Clean up
   680→    setBatchMode(false);
   681→    chalk.level = savedChalkLevel;
   682→    if (savedSpecDir !== undefined) {
   683→      process.env.KSPEC_SPEC_DIR = savedSpecDir;
   684→    } else {
   685→      delete process.env.KSPEC_SPEC_DIR;
   686→    }
   687→    // AC: @project-config ac-7 — restore batch project root env var
   688→    if (savedBatchProjectRoot !== undefined) {
   689→      process.env.KSPEC_BATCH_PROJECT_ROOT = savedBatchProjectRoot;
   690→    } else {
   691→      delete process.env.KSPEC_BATCH_PROJECT_ROOT;
   692→    }
   693→    // Only remove temp dir if copy-back succeeded (or commands failed)
   694→    if (!copyBackFailed) {
   695→      await fs.rm(tempDir, { recursive: true, force: true }).catch(() => {});
   696→    }
   697→  }
   698→
   699→  const succeeded = results.filter((r) => r.success).length;
   700→  const failed = results.filter((r) => !r.success).length;
   701→
   702→  return {
   703→    success: allSucceeded,
   704→    mode: "atomic",
   705→    summary: { total: commands.length, succeeded, failed },
   706→    results,
   707→  };
   708→}
   709→
   710→/**
   711→ * Immediate execution: execute against real state, per-command commits.
   712→ *
   713→ * AC: @batch-exec ac-no-atomic-flag
   714→ * AC: @batch-exec ac-immediate-per-commit
   715→ * AC: @batch-exec ac-immediate-no-rollback
   716→ */
   717→async function executeImmediate(
   718→  commands: BatchCommand[],
   719→  program: Command,
   720→  tree: CommandMeta,
   721→  options: ExecuteBatchOptions,
   722→): Promise<BatchExecResult> {
   723→  const savedChalkLevel = chalk.level;
   724→  chalk.level = 0;
   725→
   726→  const results: BatchCommandResult[] = [];
   727→
   728→  try {
   729→    for (let i = 0; i < commands.length; i++) {
   730→      const cmd = commands[i];
   731→      const result = await dispatchCommand(cmd, i, program, tree);
   732→      results.push(result);
   733→
   734→      if (!result.success && !options.continueOnError) {
   735→        // Stop on first failure, remaining not executed
   736→        for (let j = i + 1; j < commands.length; j++) {
   737→          results.push({
   738→            index: j,
   739→            id: commands[j].id,
   740→            command: commands[j].command,
   741→            success: false,
   742→            error: "Not executed (prior command failed)",
   743→          });
   744→        }
   745→        break;
   746→      }
   747→    }
   748→  } finally {
   749→    chalk.level = savedChalkLevel;
   750→  }
   751→
   752→  const succeeded = results.filter((r) => r.success).length;
   753→  const failed = results.filter((r) => !r.success).length;
   754→
   755→  return {
   756→    success: failed === 0,
   757→    mode: "immediate",
   758→    summary: { total: commands.length, succeeded, failed },
   759→    results,
   760→  };
   761→}
   762→
   763→/**
   764→ * Dispatch a single command through Commander's parseAsync.
   765→ */
   766→async function dispatchCommand(
   767→  cmd: BatchCommand,
   768→  index: number,
   769→  program: Command,
   770→  tree: CommandMeta,
   771→): Promise<BatchCommandResult> {
   772→  const parts = cmd.command.trim().split(/\s+/);
   773→  const cmdMeta = findCommand(tree, parts);
   774→  if (!cmdMeta) {
   775→    return {
   776→      index,
   777→      id: cmd.id,
   778→      command: cmd.command,
   779→      success: false,
   780→      error: `Command not found: ${cmd.command}`,
   781→    };
   782→  }
   783→
   784→  // Build argv, auto-appending --force if supported
   785→  // AC: ac-confirmation-suppressed
   786→  const enrichedCmd = { ...cmd, args: { ...cmd.args } };
   787→  if (commandHasForce(cmdMeta) && !("force" in enrichedCmd.args)) {
   788→    enrichedCmd.args.force = true;
   789→  }
   790→  const argv = buildCommandArgv(enrichedCmd, cmdMeta);
   791→
   792→  // Reset Commander state
   793→  resetCommandTree(program);
   794→  setJsonMode(false);
   795→  setVerboseMode(false);
   796→
   797→  const capture = new OutputCapture();
   798→  capture.start();
   799→  installExitInterceptor();
   800→
   801→  let caughtError: unknown = undefined;
   802→  let succeeded = false;
   803→
   804→  try {
   805→    await program.parseAsync(argv, { from: "user" });
   806→    succeeded = true;
   807→  } catch (err) {
   808→    caughtError = err;
   809→  } finally {
   810→    capture.stop();
   811→    uninstallExitInterceptor();
   812→  }
   813→
   814→  if (succeeded) {
   815→    const output = capture.getOutput();
   816→    // Try to parse output as JSON for structured results
   817→    let parsedOutput: unknown = output;
   818→    try {
   819→      parsedOutput = JSON.parse(output);
   820→    } catch {
   821→      // Not JSON, keep as string
   822→    }
   823→
   824→    return {
   825→      index,
   826→      id: cmd.id,
   827→      command: cmd.command,
   828→      success: true,
   829→      output: parsedOutput,
   830→    };
   831→  }
   832→
   833→  // Handle errors
   834→  const err = caughtError;
   835→
   836→  if (err instanceof BatchExitError) {
   837→    // Filter out BatchExitError noise from captured output (handlers may
   838→    // catch and re-log the error before calling process.exit again)
   839→    const capturedOutput = capture
   840→      .getOutput()
   841→      .split("\n")
   842→      .filter((line) => !line.includes("BatchExitError"))
   843→      .join("\n")
   844→      .trim();
   845→
   846→    if (err.code === 0) {
   847→      return {
   848→        index,
   849→        id: cmd.id,
   850→        command: cmd.command,
   851→        success: true,
   852→        output: capturedOutput,
   853→      };
   854→    }
   855→    return {
   856→      index,
   857→      id: cmd.id,
   858→      command: cmd.command,
   859→      success: false,
   860→      error: capturedOutput || `Command exited with code ${err.code}`,
   861→    };
   862→  }
   863→
   864→  // Commander errors (e.g., missing required arg at runtime)
   865→  const isCommanderError =
   866→    err && typeof err === "object" && "code" in err && "exitCode" in err;
   867→  if (isCommanderError) {
   868→    const cmdErr = err as unknown as { message: string; exitCode: number };
   869→    return {
   870→      index,
   871→      id: cmd.id,
   872→      command: cmd.command,
   873→      success: false,
   874→      error: cmdErr.message || capture.getOutput(),
   875→    };
   876→  }
   877→
   878→  // Generic errors
   879→  return {
   880→    index,
   881→    id: cmd.id,
   882→    command: cmd.command,
   883→    success: false,
   884→    error: err instanceof Error ? err.message : String(err),
   885→  };
   886→}
   887→
```