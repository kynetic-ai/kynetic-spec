   679→      description: string;
   680→      acceptance_criteria: Array<{ id: string; given: string; when: string; then: string }>;
   681→    }>("item get @ac-feature --json", tempDir);
   682→
   683→    expect(afterSpec.description).toBe("Updated with new ACs");
   684→    expect(afterSpec.acceptance_criteria).toHaveLength(2);
   685→    expect(afterSpec.acceptance_criteria[0].id).toBe("ac-new-1");
   686→    expect(afterSpec.acceptance_criteria[0].given).toBe("A user is logged in");
   687→    expect(afterSpec.acceptance_criteria[1].id).toBe("ac-new-2");
   688→    expect(afterSpec.acceptance_criteria[1].given).toBe("A user is on the dashboard");
   689→  });
