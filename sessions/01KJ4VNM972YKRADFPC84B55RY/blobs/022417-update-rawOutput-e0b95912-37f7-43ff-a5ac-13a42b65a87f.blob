   413→  });
   414→
   415→  // AC: @plan-import ac-18
   416→  it("should detect circular parent references", async () => {
   417→    const planPath = path.join(tempDir, "test-plan.md");
   418→    await fs.writeFile(
   419→      planPath,
   420→      `# Test Plan
   421→
   422→## Specs
   423→
   424→\`\`\`yaml
   425→- title: Feature A
   426→  slug: feature-a
   427→  parent: feature-b
   428→
   429→- title: Feature B
   430→  slug: feature-b
   431→  parent: feature-a
   432→\`\`\`
   433→`,
   434→    );
   435→
   436→    const result = kspecRun(`plan import "${planPath}" --module @test-core`, tempDir, { expectFail: true });
   437→    expect(result.exitCode).toBe(2); // USAGE_ERROR
   438→    expect(result.stderr).toContain("Circular parent reference");
