   606→
   607→  // AC: @plan-import ac-26
   608→  it("should update existing specs with --update flag", async () => {
   609→    // Create initial spec
   610→    kspec('item add --under @test-core --title "Feature" --slug my-feature', tempDir);
   611→
   612→    const planPath = path.join(tempDir, "test-plan.md");
   613→    await fs.writeFile(
   614→      planPath,
   615→      `# Test Plan
   616→
   617→## Specs
   618→
   619→\`\`\`yaml
   620→- title: Feature Updated
   621→  slug: my-feature
   622→  description: New description
   623→\`\`\`
   624→`,
   625→    );
   626→
   627→    const output = kspec(
   628→      `plan import "${planPath}" --module @test-core --update`,
   629→      tempDir,
   630→    );
   631→    expect(output).toContain("Updated spec: @my-feature");
   632→  });
   633→
   634→  // AC: @plan-import ac-26 - Verify acceptance criteria are updated
   635→  it("should update acceptance criteria on existing specs with --update flag", async () => {
   636→    // Create initial spec with ACs
   637→    kspec('item add --under @test-core --title "Feature" --slug ac-feature', tempDir);
   638→    kspec('item ac add @ac-feature --given "initial" --when "test" --then "pass"', tempDir);
   639→
   640→    // Verify initial AC exists
   641→    const beforeSpec = kspecJson<{
   642→      acceptance_criteria: Array<{ id: string; given: string; when: string; then: string }>;
   643→    }>("item get @ac-feature --json", tempDir);
   644→    expect(beforeSpec.acceptance_criteria).toHaveLength(1);
   645→    expect(beforeSpec.acceptance_criteria[0].given).toBe("initial");
