   833→  // Integration test: Full workflow
   834→  it("should import complete plan with specs, tasks, and notes", async () => {
   835→    const planPath = path.join(tempDir, "complete-plan.md");
   836→    await fs.writeFile(
   837→      planPath,
   838→      `# Complete Feature Plan
   839→
   840→## Specs
   841→
   842→\`\`\`yaml
   843→- title: Parent Feature
   844→  slug: parent-feature
   845→  type: feature
   846→  description: Top-level feature
   847→
   848→- title: Child Feature
   849→  slug: child-feature
   850→  type: feature
   851→  parent: parent-feature
   852→  description: Nested feature
   853→\`\`\`
   854→
   855→## Tasks
   856→
   857→derive_from_specs: true
   858→
   859→\`\`\`yaml
   860→- title: Extra Manual Task
   861→  slug: extra-task
   862→  priority: 2
   863→\`\`\`
   864→
   865→## Implementation Notes
   866→
   867→Follow existing patterns in the codebase.
   868→Ensure backward compatibility.
   869→`,
   870→    );
   871→
   872→    const output = kspec(
   873→      `plan import "${planPath}" --module @test-core`,
   874→      tempDir,
   875→    );
   876→
   877→    expect(output).toContain("Created 2 specs");
   878→    expect(output).toContain("Created 3 tasks"); // 2 derived + 1 manual
   879→
   880→    // Verify plan record
   881→    const plan = kspecJson<{
   882→      derived_specs: string[];
   883→      derived_tasks: string[];
   884→    }>("plan get @plan-complete-feature-plan --json", tempDir);
   885→    expect(plan.derived_specs).toHaveLength(2);
   886→    expect(plan.derived_tasks).toHaveLength(3);
   887→
   888→    // Verify plan record has global implementation notes
   889→    const planRecord = kspecJson<{ notes: Array<{ content: string }> }>(
   890→      "plan get @plan-complete-feature-plan --json",
   891→      tempDir,
   892→    );
   893→    expect(planRecord.notes).toHaveLength(1);
   894→    expect(planRecord.notes[0].content).toContain("Follow existing patterns");
   895→
   896→    // Verify derived tasks reference the plan (no per-spec notes in this plan)
   897→    const tasks = kspecJson<Array<{ notes: Array<{ content: string }>; plan_ref: string }>>(
   898→      "task list --json",
   899→      tempDir,
   900→    );
   901→    const derivedTasks = tasks.filter(
   902→      (t) => t.plan_ref === "@plan-complete-feature-plan" && t.notes.length > 0 && t.notes[0].content.includes("See plan"),
   903→    );
   904→    expect(derivedTasks).toHaveLength(2); // Both derived tasks should reference the plan
   905→  });
