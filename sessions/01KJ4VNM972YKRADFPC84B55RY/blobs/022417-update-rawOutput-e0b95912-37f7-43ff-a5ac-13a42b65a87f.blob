   440→
   441→  // AC: @plan-import ac-19
   442→  it("should set both spec_ref and plan_ref on derived tasks", async () => {
   443→    const planPath = path.join(tempDir, "test-plan.md");
   444→    await fs.writeFile(
   445→      planPath,
