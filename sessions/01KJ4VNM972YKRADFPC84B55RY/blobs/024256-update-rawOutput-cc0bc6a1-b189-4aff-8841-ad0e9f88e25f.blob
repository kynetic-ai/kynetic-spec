     1→/**
     2→ * Integration tests for kspec task complete state enforcement
     3→ * AC: @spec-completion-enforcement
     4→ */
     5→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     6→import * as fs from 'node:fs/promises';
     7→import * as path from 'node:path';
     8→import {
     9→  kspecOutput as kspec,
    10→  kspecJson,
    11→  kspecWithStatus,
    12→  setupTempFixtures,
    13→  cleanupTempDir,
    14→  initGitRepo,
    15→} from './helpers/cli';
    16→
    17→describe('Integration: task completion enforcement', () => {
    18→  let tempDir: string;
    19→
    20→  beforeEach(async () => {
    21→    tempDir = await setupTempFixtures();
    22→    initGitRepo(tempDir); // Shadow commands require git repo
    23→  });
    24→
    25→  afterEach(async () => {
    26→    await cleanupTempDir(tempDir);
    27→  });
    28→
    29→  // AC: @spec-completion-enforcement ac-1
    30→  it('should complete task successfully when status is pending_review', () => {
    31→    // Start and submit a task
    32→    kspec('task start @test-task-pending', tempDir);
    33→    kspec('task submit @test-task-pending', tempDir);
    34→
    35→    // Verify it's in pending_review
    36→    const beforeComplete = kspecJson<{ status: string }>(
    37→      'task get @test-task-pending',
    38→      tempDir
    39→    );
    40→    expect(beforeComplete.status).toBe('pending_review');
    41→
    42→    // Complete should succeed
    43→    const output = kspec('task complete @test-task-pending --reason "All tests pass"', tempDir);
    44→    expect(output).toContain('Completed task');
    45→
    46→    // Verify it's completed
    47→    const afterComplete = kspecJson<{ status: string; closed_reason: string | null }>(
    48→      'task get @test-task-pending',
    49→      tempDir
    50→    );
    51→    expect(afterComplete.status).toBe('completed');
    52→    expect(afterComplete.closed_reason).toBe('All tests pass');
    53→  });
    54→
    55→  // AC: @spec-completion-enforcement ac-2
    56→  it('should error when trying to complete in_progress task', () => {
    57→    // Start a task (in_progress)
    58→    kspec('task start @test-task-pending', tempDir);
    59→
    60→    // Verify it's in_progress
    61→    const taskData = kspecJson<{ status: string }>(
    62→      'task get @test-task-pending',
    63→      tempDir
    64→    );
    65→    expect(taskData.status).toBe('in_progress');
    66→
    67→    // Complete should fail with specific error
    68→    const { stdout, stderr, exitCode } = kspecWithStatus('task complete @test-task-pending --reason "Done"', tempDir);
    69→    expect(exitCode).toBe(1);
    70→    expect(stdout + stderr).toContain('Task must be submitted for review first');
    71→    expect(stdout + stderr).toContain('kspec task submit');
    72→  });
    73→
    74→  // AC: @spec-completion-enforcement ac-3
    75→  it('should error when trying to complete pending task', () => {
    76→    // Task starts in pending state
    77→    const taskData = kspecJson<{ status: string }>(
    78→      'task get @test-task-pending',
    79→      tempDir
    80→    );
    81→    expect(taskData.status).toBe('pending');
    82→
    83→    // Complete should fail with specific error
    84→    const { stdout, stderr, exitCode } = kspecWithStatus('task complete @test-task-pending --reason "Done"', tempDir);
    85→    expect(exitCode).toBe(1);
    86→    expect(stdout + stderr).toContain('Task must be started and submitted first');
    87→  });
    88→
    89→  // AC: @spec-completion-enforcement ac-4
    90→  it('should error when trying to complete blocked task', () => {
    91→    // Block a task
    92→    kspec('task block @test-task-pending --reason "Waiting for API"', tempDir);
    93→
    94→    // Verify it's blocked
    95→    const taskData = kspecJson<{ status: string }>(
    96→      'task get @test-task-pending',
    97→      tempDir
    98→    );
    99→    expect(taskData.status).toBe('blocked');
   100→
   101→    // Complete should fail with specific error
   102→    const { stdout, stderr, exitCode } = kspecWithStatus('task complete @test-task-pending --reason "Done"', tempDir);
   103→    expect(exitCode).toBe(1);
   104→    expect(stdout + stderr).toContain('Cannot complete blocked task');
   105→  });
   106→
   107→  // AC: @task-commands ac-1
   108→  it('should complete blocked task with --force flag and show warning', () => {
   109→    // Block a task
   110→    kspec('task block @test-task-pending --reason "Waiting for API"', tempDir);
   111→
   112→    // Verify it's blocked
   113→    const taskData = kspecJson<{ status: string }>(
   114→      'task get @test-task-pending',
   115→      tempDir
   116→    );
   117→    expect(taskData.status).toBe('blocked');
   118→
   119→    // Complete with --force should succeed with warning
   120→    const { stdout, stderr, exitCode } = kspecWithStatus(
   121→      'task complete @test-task-pending --force --reason "Work done by other task"',
   122→      tempDir
   123→    );
   124→    expect(exitCode).toBe(0);
   125→    const output = stdout + stderr;
   126→    expect(output).toContain('Completed task');
   127→    expect(output).toContain('Waiting for API'); // Warning shows what it was blocked by
   128→
   129→    // Verify it's completed
   130→    const afterComplete = kspecJson<{
   131→      status: string;
   132→      closed_reason: string | null;
   133→      notes: Array<{ content: string; author: string }>;
   134→    }>('task get @test-task-pending', tempDir);
   135→    expect(afterComplete.status).toBe('completed');
   136→    expect(afterComplete.closed_reason).toBe('Work done by other task');
   137→
   138→    // Check that a note was added documenting the forced completion
   139→    const forceNote = afterComplete.notes.find((n) =>
   140→      n.content.includes('--force')
   141→    );
   142→    expect(forceNote).toBeTruthy();
   143→    expect(forceNote?.content).toContain('blocked state');
   144→    expect(forceNote?.content).toContain('Waiting for API');
   145→  });
   146→
   147→  // AC: @task-commands ac-1 - JSON output includes warning
   148→  it('should include warning in JSON output when force-completing blocked task', () => {
   149→    // Block a task
   150→    kspec('task block @test-task-pending --reason "Dependency missing"', tempDir);
   151→
   152→    // Complete with --force and --json
   153→    const result = kspecJson<{
   154→      success: boolean;
   155→      summary: { total: number; succeeded: number };
   156→      results: Array<{
   157→        status: string;
   158→        warning?: string;
   159→      }>;
   160→    }>(
   161→      'task complete @test-task-pending --force --reason "Covered elsewhere"',
   162→      tempDir
   163→    );
   164→
   165→    expect(result.success).toBe(true);
   166→    expect(result.results[0].status).toBe('success');
   167→    expect(result.results[0].warning).toContain('Dependency missing');
   168→  });
   169→
   170→  // AC: @task-commands ac-1 - Force from in_progress bypasses submit requirement
   171→  it('should complete in_progress task with --force flag', () => {
   172→    // Start a task (in_progress)
   173→    kspec('task start @test-task-pending', tempDir);
   174→
   175→    const taskData = kspecJson<{ status: string }>(
   176→      'task get @test-task-pending',
   177→      tempDir
   178→    );
   179→    expect(taskData.status).toBe('in_progress');
   180→
   181→    // Complete with --force should succeed
   182→    const { stdout, stderr, exitCode } = kspecWithStatus(
   183→      'task complete @test-task-pending --force --reason "Design task, no code to review"',
   184→      tempDir
   185→    );
   186→    expect(exitCode).toBe(0);
   187→    const output = stdout + stderr;
   188→    expect(output).toContain('Completed task');
   189→    expect(output).toContain('in_progress'); // Warning about prior state
   190→
   191→    // Verify completed and note documents force
   192→    const afterComplete = kspecJson<{
   193→      status: string;
   194→      closed_reason: string | null;
   195→      notes: Array<{ content: string }>;
   196→    }>('task get @test-task-pending', tempDir);
   197→    expect(afterComplete.status).toBe('completed');
   198→    expect(afterComplete.closed_reason).toBe('Design task, no code to review');
   199→
   200→    const forceNote = afterComplete.notes.find((n) =>
   201→      n.content.includes('--force')
   202→    );
   203→    expect(forceNote).toBeTruthy();
   204→    expect(forceNote?.content).toContain('in_progress state');
   205→  });
   206→
   207→  // AC: @task-commands ac-1 - Force from pending bypasses start+submit requirement
   208→  it('should complete pending task with --force flag', () => {
   209→    // Task starts in pending
   210→    const taskData = kspecJson<{ status: string }>(
   211→      'task get @test-task-pending',
   212→      tempDir
   213→    );
   214→    expect(taskData.status).toBe('pending');
   215→
   216→    // Complete with --force should succeed
   217→    const { stdout, stderr, exitCode } = kspecWithStatus(
   218→      'task complete @test-task-pending --force --reason "Already implemented elsewhere"',
   219→      tempDir
   220→    );
   221→    expect(exitCode).toBe(0);
   222→    expect(stdout + stderr).toContain('Completed task');
   223→
   224→    // Verify completed
   225→    const afterComplete = kspecJson<{
   226→      status: string;
   227→      closed_reason: string | null;
   228→      notes: Array<{ content: string }>;
   229→    }>('task get @test-task-pending', tempDir);
   230→    expect(afterComplete.status).toBe('completed');
   231→
   232→    const forceNote = afterComplete.notes.find((n) =>
   233→      n.content.includes('--force')
   234→    );
   235→    expect(forceNote).toBeTruthy();
   236→    expect(forceNote?.content).toContain('pending state');
   237→  });
   238→
   239→  // AC: @task-commands ac-1 - Force from cancelled bypasses reset requirement
   240→  it('should complete cancelled task with --force flag', () => {
   241→    kspec('task cancel @test-task-pending --reason "No longer needed"', tempDir);
   242→
   243→    const taskData = kspecJson<{ status: string }>(
   244→      'task get @test-task-pending',
   245→      tempDir
   246→    );
   247→    expect(taskData.status).toBe('cancelled');
   248→
   249→    // Complete with --force should succeed
   250→    const { stdout, stderr, exitCode } = kspecWithStatus(
   251→      'task complete @test-task-pending --force --reason "Actually done"',
   252→      tempDir
   253→    );
   254→    expect(exitCode).toBe(0);
   255→    expect(stdout + stderr).toContain('Completed task');
   256→
   257→    // Verify completed
   258→    const afterComplete = kspecJson<{
   259→      status: string;
   260→      notes: Array<{ content: string }>;
   261→    }>('task get @test-task-pending', tempDir);
   262→    expect(afterComplete.status).toBe('completed');
   263→
   264→    const forceNote = afterComplete.notes.find((n) =>
   265→      n.content.includes('--force')
   266→    );
   267→    expect(forceNote).toBeTruthy();
   268→    expect(forceNote?.content).toContain('cancelled state');
   269→  });
   270→
   271→  // AC: @task-commands ac-1 - Force does NOT bypass already-completed check
   272→  it('should still error when force-completing already completed task', () => {
   273→    kspec('task start @test-task-pending', tempDir);
   274→    kspec('task submit @test-task-pending', tempDir);
   275→    kspec('task complete @test-task-pending --reason "Done"', tempDir);
   276→
   277→    const taskData = kspecJson<{ status: string }>(
   278→      'task get @test-task-pending',
   279→      tempDir
   280→    );
   281→    expect(taskData.status).toBe('completed');
   282→
   283→    // --force should NOT bypass already-completed
   284→    const { stdout, stderr, exitCode } = kspecWithStatus(
   285→      'task complete @test-task-pending --force --reason "Done again"',
   286→      tempDir
   287→    );
   288→    expect(exitCode).toBe(1);
   289→    expect(stdout + stderr).toContain('Task is already completed');
   290→  });
   291→
   292→  // AC: @task-commands ac-1 - Force from pending_review adds no extra note
   293→  it('should not add force note when --force used on pending_review task', () => {
   294→    kspec('task start @test-task-pending', tempDir);
   295→    kspec('task submit @test-task-pending', tempDir);
   296→
   297→    const taskData = kspecJson<{ status: string }>(
   298→      'task get @test-task-pending',
   299→      tempDir
   300→    );
   301→    expect(taskData.status).toBe('pending_review');
   302→
   303→    // --force on pending_review is a no-op (already valid state)
   304→    const { exitCode } = kspecWithStatus(
   305→      'task complete @test-task-pending --force --reason "Reviewed and merged"',
   306→      tempDir
   307→    );
   308→    expect(exitCode).toBe(0);
   309→
   310→    const afterComplete = kspecJson<{
   311→      status: string;
   312→      notes: Array<{ content: string }>;
   313→    }>('task get @test-task-pending', tempDir);
   314→    expect(afterComplete.status).toBe('completed');
   315→
   316→    // Should NOT have a force note since pending_review is the normal path
   317→    const forceNote = afterComplete.notes.find((n) =>
   318→      n.content.includes('--force')
   319→    );
   320→    expect(forceNote).toBeFalsy();
   321→  });
   322→
   323→  // AC: @spec-completion-enforcement ac-5
   324→  it('should error when trying to complete cancelled task', () => {
   325→    // Cancel a task
   326→    kspec('task cancel @test-task-pending --reason "No longer needed"', tempDir);
   327→
   328→    // Verify it's cancelled
   329→    const taskData = kspecJson<{ status: string }>(
   330→      'task get @test-task-pending',
   331→      tempDir
   332→    );
   333→    expect(taskData.status).toBe('cancelled');
   334→
   335→    // Complete should fail with specific error and suggest reset
   336→    const { stdout, stderr, exitCode } = kspecWithStatus('task complete @test-task-pending --reason "Done"', tempDir);
   337→    expect(exitCode).toBe(1);
   338→    expect(stdout + stderr).toContain('Cannot complete cancelled task');
   339→    expect(stdout + stderr).toContain('kspec task reset');
   340→  });
   341→
   342→  // AC: @spec-completion-enforcement ac-6
   343→  it('should error when trying to complete already completed task', () => {
   344→    // Start, submit, and complete a task
   345→    kspec('task start @test-task-pending', tempDir);
   346→    kspec('task submit @test-task-pending', tempDir);
   347→    kspec('task complete @test-task-pending --reason "Done"', tempDir);
   348→
   349→    // Verify it's completed
   350→    const taskData = kspecJson<{ status: string }>(
   351→      'task get @test-task-pending',
   352→      tempDir
   353→    );
   354→    expect(taskData.status).toBe('completed');
   355→
   356→    // Complete should fail with specific error
   357→    const { stdout, stderr, exitCode } = kspecWithStatus('task complete @test-task-pending --reason "Done again"', tempDir);
   358→    expect(exitCode).toBe(1);
   359→    expect(stdout + stderr).toContain('Task is already completed');
   360→  });
   361→
   362→  // AC: @spec-completion-enforcement ac-7
   363→  it('should allow skip-review to bypass enforcement and document reason', () => {
   364→    // Start a task (in_progress, not submitted)
   365→    kspec('task start @test-task-pending', tempDir);
   366→
   367→    const beforeComplete = kspecJson<{ status: string }>(
   368→      'task get @test-task-pending',
   369→      tempDir
   370→    );
   371→    expect(beforeComplete.status).toBe('in_progress');
   372→
   373→    // Complete with skip-review should succeed
   374→    const output = kspec('task complete @test-task-pending --skip-review --reason "Hotfix, no review needed"', tempDir);
   375→    expect(output).toContain('Completed task');
   376→
   377→    // Verify it's completed and reason is documented
   378→    const afterComplete = kspecJson<{
   379→      status: string;
   380→      closed_reason: string | null;
   381→      notes: Array<{ content: string; author: string }>;
   382→    }>(
   383→      'task get @test-task-pending',
   384→      tempDir
   385→    );
   386→    expect(afterComplete.status).toBe('completed');
   387→    expect(afterComplete.closed_reason).toBe('Hotfix, no review needed');
   388→
   389→    // Check that a note was added documenting the skip-review
   390→    const skipNote = afterComplete.notes.find(n => n.content.includes('skip-review'));
   391→    expect(skipNote).toBeTruthy();
   392→    expect(skipNote?.content).toContain('Hotfix, no review needed');
   393→  });
   394→
   395→  // AC: @spec-completion-enforcement ac-8
   396→  it('should error when skip-review provided without reason', () => {
   397→    // Start a task
   398→    kspec('task start @test-task-pending', tempDir);
   399→
   400→    // Complete with skip-review but no reason should fail
   401→    const { stdout, stderr, exitCode } = kspecWithStatus('task complete @test-task-pending --skip-review', tempDir);
   402→    expect(exitCode).toBe(1);
   403→    expect(stdout + stderr).toContain('--skip-review requires --reason to document why');
   404→  });
   405→
   406→  // AC: @spec-completion-enforcement ac-9
   407→  it('should handle batch mode with mixed states correctly', () => {
   408→    // Prepare first task: pending_review (can complete)
   409→    kspec('task start @test-task-pending', tempDir);
   410→    kspec('task submit @test-task-pending', tempDir);
   411→
   412→    // Prepare second task: in_progress (cannot complete)
   413→    kspec('task start @test-task-blocked', tempDir);
   414→
   415→    // Verify states
   416→    const task1 = kspecJson<{ status: string }>(
   417→      'task get @test-task-pending',
   418→      tempDir
   419→    );
   420→    const task2 = kspecJson<{ status: string }>(
   421→      'task get @test-task-blocked',
   422→      tempDir
   423→    );
   424→    expect(task1.status).toBe('pending_review');
   425→    expect(task2.status).toBe('in_progress');
   426→
   427→    // Batch complete with mixed states
   428→    const { stdout, stderr, exitCode } = kspecWithStatus(
   429→      'task complete --refs @test-task-pending @test-task-blocked --reason "Done"',
   430→      tempDir
   431→    );
   432→
   433→    // Should exit with error (at least one failed)
   434→    expect(exitCode).toBe(1);
   435→
   436→    // Output should show both success and failure
   437→    const output = stdout + stderr;
   438→    expect(output).toContain('Completed 1 of 2');
   439→    expect(output).toContain('✓'); // Success indicator
   440→    expect(output).toContain('✗'); // Failure indicator
   441→
   442→    // First task should be completed
   443→    const task1After = kspecJson<{ status: string }>(
   444→      'task get @test-task-pending',
   445→      tempDir
   446→    );
   447→    expect(task1After.status).toBe('completed');
   448→
   449→    // Second task should still be in_progress
   450→    const task2After = kspecJson<{ status: string }>(
   451→      'task get @test-task-blocked',
   452→      tempDir
   453→    );
   454→    expect(task2After.status).toBe('in_progress');
   455→
   456→    // Error should provide guidance
   457→    expect(output).toContain('Task must be submitted for review first');
   458→  });
   459→
   460→  // Additional test: Verify skip-review works from pending state too
   461→  it('should allow skip-review from pending state', () => {
   462→    // Task starts in pending
   463→    const taskData = kspecJson<{ status: string }>(
   464→      'task get @test-task-pending',
   465→      tempDir
   466→    );
   467→    expect(taskData.status).toBe('pending');
   468→
   469→    // Complete with skip-review should succeed
   470→    const output = kspec('task complete @test-task-pending --skip-review --reason "Trivial change"', tempDir);
   471→    expect(output).toContain('Completed task');
   472→
   473→    // Verify it's completed
   474→    const afterComplete = kspecJson<{ status: string }>(
   475→      'task get @test-task-pending',
   476→      tempDir
   477→    );
   478→    expect(afterComplete.status).toBe('completed');
   479→  });
   480→});
   481→