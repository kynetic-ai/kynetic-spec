```
     1→/**
     2→ * Plan CLI commands
     3→ * AC: @plan-crud ac-1, ac-2, ac-3, ac-4, ac-7, ac-8, ac-9, ac-30, ac-31
     4→ */
     5→
     6→import * as fs from "node:fs/promises";
     7→import * as path from "node:path";
     8→import type { Command } from "commander";
     9→import { markMutating } from "../command-annotations.js";
    10→import {
    11→  buildIndexes,
    12→  createPlan,
    13→  createTask,
    14→  findPlanByRef,
    15→  filterPlansByStatus,
    16→  getAuthor,
    17→  initContext,
    18→  type LoadedPlan,
    19→  loadAllTasks,
    20→  loadPlans,
    21→  savePlan,
    22→  saveTask,
    23→} from "../../parser/index.js";
    24→import { commitIfShadow } from "../../parser/shadow.js";
    25→import type { PlanInput, TaskInput } from "../../schema/index.js";
    26→import { errors } from "../../strings/index.js";
    27→import { fieldLabels } from "../../strings/labels.js";
    28→import { formatRelativeTime as formatRelativeTimeUtil } from "../../utils/time.js";
    29→import { EXIT_CODES } from "../exit-codes.js";
    30→import { error, info, output, success } from "../output.js";
    31→import { ulid } from "ulid";
    32→import { registerPlanImportCommand } from "./plan-import.js";
    33→import { parseIntOption } from "../validators.js";
    34→
    35→/**
    36→ * Format relative time for display
    37→ */
    38→function formatRelativeTime(dateStr: string): string {
    39→  return formatRelativeTimeUtil(new Date(dateStr));
    40→}
    41→
    42→/**
    43→ * Resolve plan ref with error handling
    44→ * AC: @plan-crud ac-8 - get plan by reference
    45→ */
    46→function resolvePlanRef(ref: string, plans: LoadedPlan[]): LoadedPlan {
    47→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
    48→  const plan = plans.find(
    49→    (p) =>
    50→      p._ulid === cleanRef ||
    51→      p._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()) ||
    52→      p.slugs.includes(cleanRef),
    53→  );
    54→
    55→  if (!plan) {
    56→    error(errors.reference.planNotFound(ref));
    57→    process.exit(EXIT_CODES.NOT_FOUND);
    58→  }
    59→
    60→  return plan;
    61→}
    62→
    63→/**
    64→ * Register the 'plan' command group
    65→ */
    66→export function registerPlanCommands(program: Command): void {
    67→  const plan = program
    68→    .command("plan")
    69→    .description("Manage implementation plans");
    70→
    71→  // Register plan import subcommand
    72→  registerPlanImportCommand(plan);
    73→
    74→  // kspec plan add
    75→  // AC: @plan-crud ac-1, ac-2
    76→  markMutating(plan.command("add"))
    77→    .description("Create a new plan")
    78→    .requiredOption("--title <title>", "Plan title")
    79→    .option("--content <text>", "Plan content (markdown)")
    80→    .option("--content-file <path>", "Read content from markdown file")
    81→    .option("--status <status>", "Initial status (default: draft)")
    82→    .option("--slug <slug>", "Optional slug for the plan")
    83→    .addHelpText(
    84→      "after",
    85→      `
    86→Examples:
    87→  $ kspec plan add --title "User Auth" --content "Implement JWT auth..."
    88→  $ kspec plan add --title "API Refactor" --content-file ./plan.md`,
    89→    )
    90→    .action(async (options) => {
    91→      try {
    92→        const ctx = await initContext();
    93→
    94→        // Validate content options
    95→        if (options.content && options.contentFile) {
    96→          error(
    97→            "Cannot specify both --content and --content-file. Choose one.",
    98→          );
    99→          process.exit(EXIT_CODES.USAGE_ERROR);
   100→        }
   101→
   102→        // Read content from file if specified
   103→        // AC: @plan-crud ac-2
   104→        let content = options.content || "";
   105→        if (options.contentFile) {
   106→          const contentPath = path.resolve(process.cwd(), options.contentFile);
   107→          try {
   108→            content = await fs.readFile(contentPath, "utf-8");
   109→          } catch (err) {
   110→            error(`Failed to read content file: ${options.contentFile}`, err);
   111→            process.exit(EXIT_CODES.ERROR);
   112→          }
   113→        }
   114→
   115→        // Validate title is non-empty
   116→        if (!options.title || options.title.trim().length === 0) {
   117→          error("Plan title cannot be empty.");
   118→          process.exit(EXIT_CODES.USAGE_ERROR);
   119→        }
   120→
   121→        // Generate URL-safe slug from title
   122→        const generateSlug = (title: string): string => {
   123→          return title
   124→            .toLowerCase()
   125→            .replace(/[^a-z0-9]+/g, "-")
   126→            .replace(/^-|-$/g, "")
   127→            .slice(0, 50);
   128→        };
   129→
   130→        // Auto-namespace plan slugs with "plan-" prefix to prevent collision with spec slugs
   131→        // If user provides a slug, check for collision with spec items and plans
   132→        // If no slug provided, auto-generate with "plan-" prefix and ensure uniqueness
   133→        const plans = await loadPlans(ctx);
   134→        let planSlug = options.slug || `plan-${generateSlug(options.title)}`;
   135→
   136→        // Check for collision with spec items and plans
   137→        const { refIndex } = await buildIndexes(ctx, plans);
   138→        if (options.slug) {
   139→          // Manual slug: check for collision across all namespaces (specs/tasks/plans)
   140→          if (!refIndex.isSlugAvailable(options.slug)) {
   141→            error(`Slug "${options.slug}" collides with existing item. Use a different slug or omit --slug for auto-namespaced slug.`);
   142→            process.exit(EXIT_CODES.CONFLICT);
   143→          }
   144→        } else {
   145→          // Auto-generated slug: ensure uniqueness across all namespaces
   146→          let counter = 1;
   147→          const baseSlug = planSlug;
   148→          while (!refIndex.isSlugAvailable(planSlug)) {
   149→            planSlug = `${baseSlug}-${counter}`;
   150→            counter++;
   151→          }
   152→        }
   153→
   154→        const input: PlanInput = {
   155→          title: options.title,
   156→          content,
   157→          status: options.status || "draft",
   158→          slugs: [planSlug],
   159→        };
   160→
   161→        const newPlan = createPlan(input);
   162→        await savePlan(ctx, newPlan);
   163→
   164→        // AC: @plan-crud ac-1 - auto-commit to shadow branch
   165→        await commitIfShadow(ctx.shadow, "plan-add", newPlan.slugs[0] || newPlan._ulid.slice(0, 8), options.title);
   166→
   167→        success(`Created plan: ${newPlan._ulid.slice(0, 8)} - ${newPlan.title}`, {
   168→          plan: newPlan,
   169→        });
   170→      } catch (err) {
   171→        error(errors.failures.createPlan, err);
   172→        process.exit(EXIT_CODES.ERROR);
   173→      }
   174→    });
   175→
   176→  // kspec plan get <ref>
   177→  // AC: @plan-crud ac-8, ac-30
   178→  plan
   179→    .command("get <ref>")
   180→    .description("Show plan details")
   181→    .option("--json", "Output as JSON")
   182→    .action(async (ref: string, options) => {
   183→      try {
   184→        const ctx = await initContext();
   185→        const plans = await loadPlans(ctx);
   186→        const foundPlan = resolvePlanRef(ref, plans);
   187→
   188→        // AC: @plan-crud ac-30 - JSON output
   189→        output(foundPlan, () => {
   190→          // AC: @plan-crud ac-8 - full plan display
   191→          console.log(`${fieldLabels.ulid}     ${foundPlan._ulid}`);
   192→          console.log(`${fieldLabels.title}    ${foundPlan.title}`);
   193→          console.log(`${fieldLabels.status}   ${foundPlan.status}`);
   194→
   195→          if (foundPlan.slugs.length > 0) {
   196→            console.log(`Slugs:    ${foundPlan.slugs.join(", ")}`);
   197→          }
   198→
   199→          console.log(
   200→            `${fieldLabels.created}  ${foundPlan.created_at} (${formatRelativeTime(foundPlan.created_at)})`,
   201→          );
   202→
   203→          if (foundPlan.approved_at) {
   204→            console.log(
   205→              `Approved: ${foundPlan.approved_at} (${formatRelativeTime(foundPlan.approved_at)})`,
   206→            );
   207→          }
   208→
   209→          if (foundPlan.completed_at) {
   210→            console.log(
   211→              `Completed: ${foundPlan.completed_at} (${formatRelativeTime(foundPlan.completed_at)})`,
   212→            );
   213→          }
   214→
   215→          // Show derived work
   216→          if (
   217→            foundPlan.derived_tasks.length > 0 ||
   218→            foundPlan.derived_specs.length > 0
   219→          ) {
   220→            console.log("\nDerived Work:");
   221→            if (foundPlan.derived_specs.length > 0) {
   222→              console.log(
   223→                `  Specs: ${foundPlan.derived_specs.join(", ")}`,
   224→              );
   225→            }
   226→            if (foundPlan.derived_tasks.length > 0) {
   227→              console.log(
   228→                `  Tasks: ${foundPlan.derived_tasks.join(", ")}`,
   229→              );
   230→            }
   231→          }
   232→
   233→          // Show content
   234→          if (foundPlan.content) {
   235→            console.log("\n─── Content ───");
   236→            console.log(foundPlan.content);
   237→          }
   238→
   239→          // Show notes
   240→          if (foundPlan.notes.length > 0) {
   241→            console.log("\n─── Notes ───");
   242→            for (const note of foundPlan.notes) {
   243→              const age = formatRelativeTime(note.created_at);
   244→              const author = note.author ? ` by ${note.author}` : "";
   245→              console.log(`\n[${age}${author}]`);
   246→              console.log(note.content);
   247→            }
   248→          }
   249→        });
   250→      } catch (err) {
   251→        error(errors.failures.getPlan, err);
   252→        process.exit(EXIT_CODES.ERROR);
   253→      }
   254→    });
   255→
   256→  // kspec plan set <ref>
   257→  // AC: @plan-crud ac-3, ac-4
   258→  markMutating(plan.command("set <ref>"))
   259→    .description("Update plan fields")
   260→    .option("--title <title>", "Update title")
   261→    .option("--status <status>", "Update status")
   262→    .option("--slug <slug>", "Add a slug")
   263→    .action(async (ref: string, options) => {
   264→      try {
   265→        const ctx = await initContext();
   266→        const plans = await loadPlans(ctx);
   267→        const foundPlan = resolvePlanRef(ref, plans);
   268→
   269→        // AC: @plan-crud ac-4 - prevent transitions from terminal states
   270→        if (
   271→          options.status &&
   272→          (foundPlan.status === "completed" || foundPlan.status === "rejected")
   273→        ) {
   274→          error("Cannot transition from terminal status");
   275→          process.exit(EXIT_CODES.CONFLICT);
   276→        }
   277→
   278→        const changes: string[] = [];
   279→
   280→        if (options.title) {
   281→          foundPlan.title = options.title;
   282→          changes.push("title");
   283→        }
   284→
   285→        if (options.status) {
   286→          const oldStatus = foundPlan.status;
   287→          foundPlan.status = options.status;
   288→          changes.push(`status: ${oldStatus} → ${options.status}`);
   289→
   290→          // AC: @plan-crud ac-3 - set approved_at timestamp when transitioning to approved
   291→          if (options.status === "approved" && !foundPlan.approved_at) {
   292→            foundPlan.approved_at = new Date().toISOString();
   293→          }
   294→        }
   295→
   296→        if (options.slug) {
   297→          if (!foundPlan.slugs.includes(options.slug)) {
   298→            // Check for collision with specs/tasks/plans
   299→            const { refIndex } = await buildIndexes(ctx, plans);
   300→            if (!refIndex.isSlugAvailable(options.slug)) {
   301→              error(`Slug "${options.slug}" collides with existing item. Use a different slug.`);
   302→              process.exit(EXIT_CODES.CONFLICT);
   303→            }
   304→            foundPlan.slugs.push(options.slug);
   305→            changes.push(`slug: +${options.slug}`);
   306→          }
   307→        }
   308→
   309→        if (changes.length === 0) {
   310→          info("No changes specified");
   311→          return;
   312→        }
   313→
   314→        await savePlan(ctx, foundPlan);
   315→        await commitIfShadow(
   316→          ctx.shadow,
   317→          "plan-set",
   318→          foundPlan.slugs[0] || foundPlan._ulid.slice(0, 8),
   319→          changes.join(", "),
   320→        );
   321→
   322→        success(`Updated plan: ${foundPlan._ulid.slice(0, 8)}`, {
   323→          changes,
   324→          plan: foundPlan,
   325→        });
   326→      } catch (err) {
   327→        error(errors.failures.updatePlan, err);
   328→        process.exit(EXIT_CODES.ERROR);
   329→      }
   330→    });
   331→
   332→  // kspec plan list
   333→  // AC: @plan-crud ac-7, ac-31
   334→  plan
   335→    .command("list")
   336→    .description("List plans")
   337→    .option("--status <status>", "Filter by status")
   338→    .option("--json", "Output as JSON array")
   339→    .action(async (options) => {
   340→      try {
   341→        const ctx = await initContext();
   342→        let plans = await loadPlans(ctx);
   343→
   344→        // AC: @plan-crud ac-7 - status filter
   345→        if (options.status) {
   346→          plans = filterPlansByStatus(plans, options.status);
   347→        }
   348→
   349→        // Sort by created date (newest first)
   350→        plans.sort(
   351→          (a, b) =>
   352→            new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   353→        );
   354→
   355→        // AC: @plan-crud ac-31 - JSON output
   356→        output(plans, () => {
   357→          if (plans.length === 0) {
   358→            console.log("No plans found");
   359→            return;
   360→          }
   361→
   362→          console.log(`Plans (${plans.length}):\n`);
   363→
   364→          for (const p of plans) {
   365→            const ref = p._ulid.slice(0, 8);
   366→            const age = formatRelativeTime(p.created_at);
   367→            const taskCount = p.derived_tasks.length;
   368→            const tasks =
   369→              taskCount > 0 ? ` [${taskCount} task${taskCount > 1 ? "s" : ""}]` : "";
   370→
   371→            console.log(
   372→              `  ${ref} [${p.status}]${tasks} ${p.title}`,
   373→            );
   374→            console.log(`         Created ${age}`);
   375→
   376→            if (p.approved_at) {
   377→              console.log(
   378→                `         Approved ${formatRelativeTime(p.approved_at)}`,
   379→              );
   380→            }
   381→
   382→            console.log("");
   383→          }
   384→        });
   385→      } catch (err) {
   386→        error(errors.failures.listPlans, err);
   387→        process.exit(EXIT_CODES.ERROR);
   388→      }
   389→    });
   390→
   391→  // kspec plan note <ref> <text>
   392→  // AC: @plan-crud ac-9
   393→  markMutating(plan.command("note <ref> <text>"))
   394→    .description("Add a note to a plan")
   395→    .action(async (ref: string, text: string) => {
   396→      try {
   397→        const ctx = await initContext();
   398→        const author = getAuthor(ctx.config?.identity?.author);
   399→        const plans = await loadPlans(ctx);
   400→        const foundPlan = resolvePlanRef(ref, plans);
   401→
   402→        // AC: @plan-crud ac-9 - append note with ULID, timestamp, author
   403→        const note = {
   404→          _ulid: ulid(),
   405→          created_at: new Date().toISOString(),
   406→          author,
   407→          content: text,
   408→        };
   409→
   410→        foundPlan.notes.push(note);
   411→        await savePlan(ctx, foundPlan);
   412→        await commitIfShadow(
   413→          ctx.shadow,
   414→          "plan-note",
   415→          foundPlan.slugs[0] || foundPlan._ulid.slice(0, 8),
   416→        );
   417→
   418→        success(`Added note to plan: ${foundPlan._ulid.slice(0, 8)}`, {
   419→          note,
   420→        });
   421→      } catch (err) {
   422→        error(errors.failures.addPlanNote, err);
   423→        process.exit(EXIT_CODES.ERROR);
   424→      }
   425→    });
   426→
   427→  // kspec plan derive <ref>
   428→  // AC: @plan-derive ac-5, ac-6
   429→  markMutating(plan.command("derive <ref>"))
   430→    .description("Create a task from a plan")
   431→    .option("--title <title>", "Override task title")
   432→    .option("--priority <n>", "Set task priority (1-5)")
   433→    .addHelpText(
   434→      "after",
   435→      `
   436→Examples:
   437→  $ kspec plan derive @plan-ref
   438→  $ kspec plan derive @plan-ref --title "Custom title"
   439→  $ kspec plan derive @plan-ref --priority 1`,
   440→    )
   441→    .action(async (ref: string, options) => {
   442→      try {
   443→        const ctx = await initContext();
   444→        const plans = await loadPlans(ctx);
   445→        const tasks = await loadAllTasks(ctx);
   446→        const foundPlan = resolvePlanRef(ref, plans);
   447→
   448→        // AC: @plan-derive ac-5 - check plan status
   449→        if (foundPlan.status !== "approved" && foundPlan.status !== "active") {
   450→          error(
   451→            `Plan must be in 'approved' or 'active' status to derive tasks (current: ${foundPlan.status})`,
   452→          );
   453→          process.exit(EXIT_CODES.USAGE_ERROR);
   454→        }
   455→
   456→        // Validate priority if provided
   457→        if (options.priority !== undefined) {
   458→          const priorityResult = parseIntOption(options.priority, {
   459→            min: 1,
   460→            max: 5,
   461→            name: "Priority",
   462→          });
   463→          if (!priorityResult.ok) {
   464→            error(priorityResult.error);
   465→            process.exit(EXIT_CODES.USAGE_ERROR);
   466→          }
   467→          // Replace raw string with validated number for downstream use
   468→          options.priority = priorityResult.value;
   469→        }
   470→
   471→        // Generate task slug from plan title
   472→        const generateSlug = (title: string): string => {
   473→          return title
   474→            .toLowerCase()
   475→            .replace(/[^a-z0-9]+/g, "-")
   476→            .replace(/^-|-$/g, "")
   477→            .slice(0, 50);
   478→        };
   479→
   480→        // Generate task title and slug
   481→        const taskTitle = options.title || `Implement: ${foundPlan.title}`;
   482→        let taskSlug = generateSlug(taskTitle);
   483→
   484→        // Ensure slug uniqueness
   485→        let slugSuffix = 1;
   486→        const originalSlug = taskSlug;
   487→        while (tasks.some((t) => t.slugs.includes(taskSlug))) {
   488→          taskSlug = `${originalSlug}-${slugSuffix}`;
   489→          slugSuffix++;
   490→        }
   491→
   492→        // AC: @plan-derive ac-5 - create task with plan_ref
   493→        const planRef = foundPlan.slugs[0]
   494→          ? `@${foundPlan.slugs[0]}`
   495→          : `@${foundPlan._ulid.slice(0, 8)}`;
   496→
   497→        const taskInput: TaskInput = {
   498→          title: taskTitle,
   499→          type: "task",
   500→          plan_ref: planRef,
   501→          priority: options.priority ?? 3,
   502→          slugs: [taskSlug],
   503→          tags: [],
   504→          depends_on: [],
   505→          notes: [],
   506→        };
   507→
   508→        const newTask = createTask(taskInput);
   509→        await saveTask(ctx, newTask);
   510→
   511→        // AC: @plan-derive ac-5 - update plan's derived_tasks array
   512→        const taskRef = `@${taskSlug}`;
   513→        if (!foundPlan.derived_tasks.includes(taskRef)) {
   514→          foundPlan.derived_tasks.push(taskRef);
   515→        }
   516→
   517→        // AC: @plan-derive ac-5 - transition plan to active if not already
   518→        if (foundPlan.status === "approved") {
   519→          foundPlan.status = "active";
   520→        }
   521→
   522→        await savePlan(ctx, foundPlan);
   523→
   524→        await commitIfShadow(
   525→          ctx.shadow,
   526→          "plan-derive",
   527→          foundPlan.slugs[0] || foundPlan._ulid.slice(0, 8),
   528→          taskTitle,
   529→        );
   530→
   531→        success(`Created task from plan: ${taskRef}`, {
   532→          task: newTask,
   533→          plan: foundPlan,
   534→        });
   535→      } catch (err) {
   536→        error("Failed to derive task from plan", err);
   537→        process.exit(EXIT_CODES.ERROR);
   538→      }
   539→    });
   540→}
   541→
```