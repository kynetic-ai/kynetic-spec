     1→import chalk from "chalk";
     2→import { Command } from "commander";
     3→import {
     4→  type AssessmentSummary,
     5→  assessTask,
     6→  computeAutoModeChanges,
     7→  computeSummary,
     8→  createNote,
     9→  filterTasksForAssessment,
    10→  getReadyTasks,
    11→  initContext,
    12→  loadAllItems,
    13→  loadAllTasks,
    14→  ReferenceIndex,
    15→  saveTask,
    16→  type TaskAssessment,
    17→} from "../../parser/index.js";
    18→import { commitIfShadow } from "../../parser/shadow.js";
    19→import { errors } from "../../strings/index.js";
    20→import { grepItem } from "../../utils/grep.js";
    21→import { EXIT_CODES } from "../exit-codes.js";
    22→import {
    23→  error,
    24→  formatTaskList,
    25→  formatTaskListWithAutomation,
    26→  info,
    27→  output,
    28→  success,
    29→} from "../output.js";
    30→import { findClosestCommand } from "../suggest.js";
    31→import {
    32→  TaskStatusSchema,
    33→} from "../../schema/common.js";
    34→
    35→/** List options shared between tasks list subcommand and default action */
    36→interface ListTasksOptions {
    37→  status?: string | string[];
    38→  type?: string;
    39→  tag?: string;
    40→  metaRef?: string;
    41→  grep?: string;
    42→  verbose?: boolean;
    43→  full?: boolean;
    44→  count?: boolean;
    45→}
    46→
    47→/**
    48→ * Parse multi-value status filter: supports comma-separated and repeated flags.
    49→ * AC: @multi-value-status-filter ac-comma-separated, ac-repeated-flag, ac-trailing-comma
    50→ */
    51→export function parseMultiStatus<T extends string>(
    52→  input: string | string[] | undefined,
    53→  validValues: readonly T[],
    54→  typeName: string,
    55→): T[] | null {
    56→  if (!input) return null;
    57→
    58→  // Normalize: repeated flags produce string[], single flag produces string
    59→  const raw = Array.isArray(input) ? input : [input];
    60→
    61→  // Split on commas, trim whitespace, filter empty strings
    62→  // AC: @multi-value-status-filter ac-trailing-comma
    63→  const values = raw
    64→    .flatMap((v) => v.split(","))
    65→    .map((v) => v.trim())
    66→    .filter((v) => v.length > 0);
    67→
    68→  if (values.length === 0) return null;
    69→
    70→  // Validate each value
    71→  // AC: @multi-value-status-filter ac-invalid-task-status, ac-invalid-item-status
    72→  for (const v of values) {
    73→    if (!(validValues as readonly string[]).includes(v)) {
    74→      error(`Invalid ${typeName}: ${v}. Must be one of: ${validValues.join(", ")}`);
    75→      process.exit(EXIT_CODES.ERROR);
    76→    }
    77→  }
    78→
    79→  return values as T[];
    80→}
    81→
    82→/**
    83→ * Shared task list logic used by both 'tasks list' and 'task list' subcommands,
    84→ * and as the default action when no subcommand is given.
    85→ * AC: @command-group-default-actions ac-bare-tasks, ac-bare-task, ac-bare-with-options
    86→ */
    87→export async function listTasksAction(options: ListTasksOptions): Promise<void> {
    88→  try {
    89→    const ctx = await initContext();
    90→    const allTasks = await loadAllTasks(ctx);
    91→    const items = await loadAllItems(ctx);
    92→
    93→    // Load meta items if filtering by meta-ref
    94→    const { loadMetaContext } = await import("../../parser/meta.js");
    95→    const metaContext = await loadMetaContext(ctx);
    96→    const allMetaItems = [
    97→      ...metaContext.agents,
    98→      ...metaContext.workflows,
    99→      ...metaContext.conventions,
   100→      ...metaContext.observations,
   101→    ];
   102→
   103→    const index = new ReferenceIndex(allTasks, items, allMetaItems);
   104→
   105→    let taskList = allTasks;
   106→
   107→    // Apply filters
   108→    // AC: @multi-value-status-filter ac-comma-separated, ac-repeated-flag, ac-single-value-unchanged
   109→    if (options.status) {
   110→      const statuses = parseMultiStatus(
   111→        options.status,
   112→        TaskStatusSchema.options,
   113→        "task status",
   114→      );
   115→      if (statuses) {
   116→        taskList = taskList.filter((t) => statuses.includes(t.status as any));
   117→      }
   118→    }
   119→    if (options.type) {
   120→      taskList = taskList.filter((t) => t.type === options.type);
   121→    }
   122→    if (options.tag) {
   123→      const tag = options.tag;
   124→      taskList = taskList.filter((t) => t.tags.includes(tag));
   125→    }
   126→    if (options.metaRef) {
   127→      // AC-meta-ref-2: Filter tasks by meta_ref
   128→      const metaRefResult = index.resolve(options.metaRef);
   129→      if (!metaRefResult.ok) {
   130→        error(errors.reference.metaRefNotFound(options.metaRef));
   131→        process.exit(EXIT_CODES.NOT_FOUND);
   132→      }
   133→      const targetRef = options.metaRef.startsWith("@")
   134→        ? options.metaRef
   135→        : `@${options.metaRef}`;
   136→      taskList = taskList.filter(
   137→        (t) => t.meta_ref === targetRef || t.meta_ref === options.metaRef,
   138→      );
   139→    }
   140→    if (options.grep) {
   141→      const pattern = options.grep;
   142→      taskList = taskList.filter((t) => {
   143→        const match = grepItem(
   144→          t as unknown as Record<string, unknown>,
   145→          pattern,
   146→        );
   147→        return match !== null;
   148→      });
   149→    }
   150→
   151→    // AC: @trait-filterable-list ac-8
   152→    if (options.count) {
   153→      output({ count: taskList.length }, () => {
   154→        console.log(taskList.length);
   155→      });
   156→      return;
   157→    }
   158→
   159→    output(taskList, () =>
   160→      formatTaskList(
   161→        taskList,
   162→        options.verbose,
   163→        index,
   164→        options.grep,
   165→        options.full,
   166→      ),
   167→    );
   168→  } catch (err) {
   169→    error(errors.failures.listTasks, err);
   170→    process.exit(EXIT_CODES.ERROR);
   171→  }
   172→}
   173→
   174→/** Add list filter options to a command */
   175→export function addListOptions(cmd: Command): Command {
   176→  return cmd
   177→    .option("-s, --status <status>", "Filter by status")
   178→    .option("-t, --type <type>", "Filter by type")
   179→    .option("--tag <tag>", "Filter by tag")
   180→    .option("--meta-ref <ref>", "Filter by meta reference")
   181→    .option("-g, --grep <pattern>", "Search content with regex pattern")
   182→    .option("-v, --verbose", "Show more details")
   183→    .option("--full", "Show full details (notes, todos, timestamps)")
   184→    .option("--count", "Show only the count of matching tasks");
   185→}
   186→
   187→/**
   188→ * Register the 'tasks' command group
   189→ */
   190→export function registerTasksCommands(program: Command): void {
   191→  const tasks = program.command("tasks").description("Query and list tasks")
   192→    .allowUnknownOption()
   193→    .allowExcessArguments();
   194→
   195→  // AC: @command-group-default-actions ac-bare-tasks, ac-bare-with-options, ac-unknown-subcommand
   196→  // Default action when no subcommand is given (e.g. `kspec tasks` or `kspec tasks --status pending`)
   197→  tasks.action(async (_options: Record<string, unknown>, cmd: Command) => {
   198→    // Re-parse remaining args to extract list options.
   199→    // Commander passes all unrecognized tokens (options + excess args) via cmd.args.
   200→    const listCmd = addListOptions(new Command("_list"));
   201→    listCmd.exitOverride();
   202→    try {
   203→      listCmd.parse(cmd.args, { from: "user" });
   204→    } catch {
   205→      // Parse error — likely unknown option. Show help.
   206→      console.error(chalk.gray(`Run 'kspec tasks --help' to see available subcommands`));
   207→      process.exit(EXIT_CODES.ERROR);
   208→    }
   209→
   210→    // AC: @command-group-default-actions ac-unknown-subcommand
   211→    // After parsing known options, any remaining positional args are unknown subcommands.
   212→    if (listCmd.args.length > 0) {
   213→      const unknownCmd = listCmd.args[0];
   214→      const subcommandNames = cmd.commands.map((c: Command) => c.name());
   215→      const suggestion = findClosestCommand(unknownCmd, subcommandNames);
   216→      console.error(chalk.red(`error: unknown command 'tasks ${unknownCmd}'`));
   217→      if (suggestion) {
   218→        console.error(chalk.yellow(`Did you mean: kspec tasks ${suggestion}?`));
   219→      } else {
   220→        console.error(chalk.gray(`Run 'kspec tasks --help' to see available subcommands`));
   221→      }
   222→      process.exit(EXIT_CODES.ERROR);
   223→    }
   224→
   225→    // AC: @command-group-default-actions ac-bare-with-options
   226→    await listTasksAction(listCmd.opts() as ListTasksOptions);
   227→  });
   228→
   229→  // kspec tasks list
   230→  addListOptions(tasks.command("list").description("List all tasks"))
   231→    .action(async (options: ListTasksOptions) => {
   232→      await listTasksAction(options);
   233→    });
   234→
   235→  // kspec tasks ready
   236→  // AC: @task-automation-eligibility ac-14, ac-19, ac-20, ac-24
   237→  tasks
   238→    .command("ready")
   239→    .description("List tasks that are ready to work on")
   240→    .option("-v, --verbose", "Show more details")
   241→    .option("--full", "Show full details (notes, todos, timestamps)")
   242→    .option("--eligible", "Show only tasks with automation: eligible")
   243→    .option("--unassessed", "Show only tasks without automation status")
   244→    .option("--needs-review", "Show only tasks with automation: needs_review")
   245→    .action(async (options) => {
   246→      try {
   247→        const ctx = await initContext();
   248→        const allTasks = await loadAllTasks(ctx);
   249→        const items = await loadAllItems(ctx);
   250→        const index = new ReferenceIndex(allTasks, items);
   251→        let readyTasks = getReadyTasks(allTasks);
   252→
   253→        // AC: @task-automation-eligibility ac-19 - filter by --eligible
   254→        if (options.eligible) {
   255→          readyTasks = readyTasks.filter((t) => t.automation === "eligible");
   256→        }
   257→
   258→        // AC: @task-automation-eligibility ac-20 - filter by --unassessed
   259→        if (options.unassessed) {
   260→          readyTasks = readyTasks.filter((t) => !t.automation);
   261→        }
   262→
   263→        // AC: @task-automation-eligibility ac-24 - filter by --needs-review
   264→        if (options.needsReview) {
   265→          readyTasks = readyTasks.filter(
   266→            (t) => t.automation === "needs_review",
   267→          );
   268→        }
   269→
   270→        output(readyTasks, () => {
   271→          if (readyTasks.length === 0) {
   272→            if (options.eligible) {
   273→              info(
   274→                "No eligible tasks ready - no tasks with automation: eligible",
   275→              );
   276→            } else if (options.unassessed) {
   277→              info("No unassessed tasks ready");
   278→            } else if (options.needsReview) {
   279→              info("No tasks need review");
   280→            } else {
   281→              info(
   282→                "No tasks ready - all pending tasks are blocked or have unmet dependencies",
   283→              );
   284→            }
   285→          } else {
   286→            // AC: @task-automation-eligibility ac-14 - formatTaskListWithAutomation shows automation status
   287→            formatTaskListWithAutomation(
   288→              readyTasks,
   289→              options.verbose,
   290→              index,
   291→              undefined,
   292→              options.full,
   293→            );
   294→          }
   295→        });
   296→      } catch (err) {
   297→        error(errors.failures.getReadyTasks, err);
   298→        process.exit(EXIT_CODES.ERROR);
   299→      }
   300→    });
   301→
   302→  // kspec tasks next
   303→  tasks
   304→    .command("next")
   305→    .description("Show the highest-priority ready task")
   306→    .action(async () => {
   307→      try {
   308→        const ctx = await initContext();
   309→        const allTasks = await loadAllTasks(ctx);
   310→        const items = await loadAllItems(ctx);
   311→        const index = new ReferenceIndex(allTasks, items);
   312→        const readyTasks = getReadyTasks(allTasks);
   313→
   314→        if (readyTasks.length === 0) {
   315→          output(null, () => info("No tasks ready"));
   316→        } else {
   317→          const next = readyTasks[0];
   318→          output(next, () => {
   319→            console.log(`${index.shortUlid(next._ulid)} ${next.title}`);
   320→          });
   321→        }
   322→      } catch (err) {
   323→        error(errors.failures.getNextTask, err);
   324→        process.exit(EXIT_CODES.ERROR);
   325→      }
   326→    });
   327→
   328→  // kspec tasks blocked
   329→  tasks
   330→    .command("blocked")
   331→    .description("Show blocked tasks")
   332→    .option("-v, --verbose", "Show more details")
   333→    .option("--full", "Show full details (notes, todos, timestamps)")
   334→    .action(async (options) => {
   335→      try {
   336→        const ctx = await initContext();
   337→        const allTasks = await loadAllTasks(ctx);
   338→        const items = await loadAllItems(ctx);
   339→        const index = new ReferenceIndex(allTasks, items);
   340→        const blockedTasks = allTasks.filter((t) => t.status === "blocked");
   341→
   342→        output(blockedTasks, () =>
   343→          formatTaskList(
   344→            blockedTasks,
   345→            options.verbose,
   346→            index,
   347→            undefined,
   348→            options.full,
   349→          ),
   350→        );
   351→      } catch (err) {
   352→        error(errors.failures.getBlockedTasks, err);
   353→        process.exit(EXIT_CODES.ERROR);
   354→      }
   355→    });
   356→
   357→  // kspec tasks in-progress
   358→  tasks
   359→    .command("in-progress")
   360→    .alias("active")
   361→    .description("Show tasks in progress")
   362→    .option("-v, --verbose", "Show more details")
   363→    .option("--full", "Show full details (notes, todos, timestamps)")
   364→    .action(async (options) => {
   365→      try {
   366→        const ctx = await initContext();
   367→        const allTasks = await loadAllTasks(ctx);
   368→        const items = await loadAllItems(ctx);
   369→        const index = new ReferenceIndex(allTasks, items);
   370→        const activeTasks = allTasks.filter(
   371→          (t) => t.status === "in_progress" || t.status === "needs_work",
   372→        );
   373→
   374→        output(activeTasks, () =>
   375→          formatTaskList(
   376→            activeTasks,
   377→            options.verbose,
   378→            index,
   379→            undefined,
   380→            options.full,
   381→          ),
   382→        );
   383→      } catch (err) {
   384→        error(errors.failures.getActiveTasks, err);
   385→        process.exit(EXIT_CODES.ERROR);
   386→      }
   387→    });
   388→
   389→  // kspec tasks assess - assess command group
   390→  // AC: @tasks-assess-automation
   391→  const assess = tasks
   392→    .command("assess")
   393→    .description("Assess tasks for various criteria");
   394→
   395→  // kspec tasks assess automation [taskRef]
   396→  // AC: @tasks-assess-automation ac-1 through ac-28
   397→  assess
   398→    .command("automation [taskRef]")
   399→    .description("Assess task automation eligibility based on criteria")
   400→    .option("--all", "Include already-assessed tasks")
   401→    .option(
   402→      "--auto",
   403→      "Auto-mark obvious cases (spikes -> manual_only, missing criteria -> needs_review)",
   404→    )
   405→    .option("--dry-run", "Show what would change without modifying tasks")
   406→    .action(async (taskRef: string | undefined, options) => {
   407→      try {
   408→        const ctx = await initContext();
   409→        const allTasks = await loadAllTasks(ctx);
   410→        const items = await loadAllItems(ctx);
   411→        const index = new ReferenceIndex(allTasks, items);
   412→
   413→        // AC: @tasks-assess-automation ac-6, ac-7 - Single task assessment
   414→        if (taskRef) {
   415→          const resolved = index.resolve(taskRef);
   416→          if (!resolved.ok) {
   417→            error(`Task not found: ${taskRef}`);
   418→            process.exit(EXIT_CODES.NOT_FOUND);
   419→          }
   420→        }
   421→
   422→        // AC: @tasks-assess-automation ac-1, ac-2, ac-27, ac-28 - Filter tasks
   423→        const tasksToAssess = filterTasksForAssessment(
   424→          allTasks,
   425→          { all: options.all, taskRef },
   426→          index,
   427→        );
   428→
   429→        // AC: @tasks-assess-automation ac-26 - No unassessed tasks
   430→        if (tasksToAssess.length === 0) {
   431→          output(
   432→            {
   433→              tasks: [],
   434→              summary: {
   435→                review_for_eligible: 0,
   436→                needs_review: 0,
   437→                manual_only: 0,
   438→                total: 0,
   439→              },
   440→            },
   441→            () => {
   442→              if (taskRef) {
   443→                info(
   444→                  `Task ${taskRef} is not pending or already assessed (use --all to include)`,
   445→                );
   446→              } else {
   447→                info("No unassessed pending tasks");
   448→              }
   449→            },
   450→          );
   451→          return;
   452→        }
   453→
   454→        // Assess each task
   455→        // AC: @tasks-assess-automation ac-3, ac-4, ac-8-16
   456→        const assessments: TaskAssessment[] = tasksToAssess.map((task) =>
   457→          assessTask(task, index, items),
   458→        );
   459→
   460→        // AC: @tasks-assess-automation ac-5, ac-25 - Compute summary
   461→        const summary = computeSummary(assessments);
   462→
   463→        // Handle auto mode
   464→        // AC: @tasks-assess-automation ac-17-21
   465→        if (options.auto) {
   466→          const changes = computeAutoModeChanges(assessments);
   467→          const actualChanges = changes.filter((c) => c.action !== "no_change");
   468→
   469→          // AC: @tasks-assess-automation ac-22, ac-23 - Dry run
   470→          if (options.dryRun) {
   471→            output({ assessments, summary, changes, dryRun: true }, () => {
   472→              formatAssessmentOutput(assessments, summary, index);
   473→              console.log("");
   474→              console.log(chalk.yellow("Dry run - would make these changes:"));
   475→              for (const change of actualChanges) {
   476→                console.log(
   477→                  `  ${change.taskRef}: set automation=${change.newStatus} (${change.reason})`,
   478→                );
   479→              }
   480→              if (actualChanges.length === 0) {
   481→                console.log(
   482→                  "  (no changes - all tasks need agent/human review)",
   483→                );
   484→              }
   485→            });
   486→            return;
   487→          }
   488→
   489→          // Apply changes
   490→          // AC: @tasks-assess-automation ac-17, ac-19, ac-20
   491→          let changeCount = 0;
   492→          for (const change of actualChanges) {
   493→            const task = allTasks.find((t) => t._ulid === change.taskUlid);
   494→            if (!task) continue;
   495→
   496→            // Set automation status
   497→            task.automation = change.newStatus;
   498→
   499→            // AC: @tasks-assess-automation ac-19, ac-20 - Add note explaining assessment
   500→            const noteContent = `Automation assessment: set to ${change.newStatus}. ${change.reason}`;
   501→            const note = createNote(noteContent, "@automation-assess");
   502→            task.notes = [...task.notes, note];
   503→
   504→            await saveTask(ctx, task);
   505→            changeCount++;
   506→          }
   507→
   508→          if (changeCount > 0) {
   509→            await commitIfShadow(
   510→              ctx.shadow,
   511→              "tasks-assess",
   512→              "automation",
   513→              `${changeCount} task(s)`,
   514→            );
   515→          }
   516→
   517→          output({ assessments, summary, changes, applied: true }, () => {
   518→            formatAssessmentOutput(assessments, summary, index);
   519→            console.log("");
   520→            if (changeCount > 0) {
   521→              success(`Applied ${changeCount} change(s)`);
   522→            } else {
   523→              info(
   524→                "No changes applied - all tasks need agent/human review to mark eligible",
   525→              );
   526→            }
   527→          });
   528→          return;
   529→        }
   530→
   531→        // Default: just show assessment output
   532→        // AC: @tasks-assess-automation ac-24, ac-25 - JSON output handled by output()
   533→        output({ assessments, summary }, () => {
   534→          formatAssessmentOutput(assessments, summary, index);
   535→        });
   536→      } catch (err) {
   537→        error("Failed to assess tasks", err);
   538→        process.exit(EXIT_CODES.ERROR);
   539→      }
   540→    });
   541→}
   542→
   543→/**
   544→ * Format assessment output for human-readable display
   545→ * AC: @tasks-assess-automation ac-3, ac-4, ac-5
   546→ */
   547→function formatAssessmentOutput(
   548→  assessments: TaskAssessment[],
   549→  summary: AssessmentSummary,
   550→  _index: ReferenceIndex,
   551→): void {
   552→  for (const assessment of assessments) {
   553→    // Task header
   554→    console.log(`${assessment.taskRef}  "${assessment.taskTitle}"`);
   555→
   556→    // Criteria results
   557→    // AC: @tasks-assess-automation ac-3
   558→    const specRefResult = assessment.criteria.has_spec_ref;
   559→    const specRefIcon = specRefResult.pass ? chalk.green("✓") : chalk.red("✗");
   560→    const specRefDetail = specRefResult.pass
   561→      ? specRefResult.spec_ref
   562→      : specRefResult.detail || "missing";
   563→    console.log(`  spec_ref:     ${specRefIcon} ${specRefDetail}`);
   564→
   565→    const acsResult = assessment.criteria.spec_has_acs;
   566→    const acsIcon = acsResult.skipped
   567→      ? chalk.gray("-")
   568→      : acsResult.pass
   569→        ? chalk.green("✓")
   570→        : chalk.red("✗");
   571→    const acsDetail = acsResult.skipped
   572→      ? `(${acsResult.detail})`
   573→      : acsResult.pass
   574→        ? `${acsResult.ac_count} acceptance criteria`
   575→        : acsResult.detail || "no ACs";
   576→    console.log(`  has_acs:      ${acsIcon} ${acsDetail}`);
   577→
   578→    const spikeResult = assessment.criteria.not_spike;
   579→    const spikeIcon = spikeResult.pass ? chalk.green("✓") : chalk.red("✗");
   580→    console.log(`  not_spike:    ${spikeIcon} ${spikeResult.detail}`);
   581→
   582→    // Recommendation
   583→    // AC: @tasks-assess-automation ac-4
   584→    const recColor =
   585→      assessment.recommendation === "review_for_eligible"
   586→        ? chalk.cyan
   587→        : assessment.recommendation === "needs_review"
   588→          ? chalk.yellow
   589→          : chalk.red;
   590→    console.log(
   591→      `  → ${recColor(assessment.recommendation)} (${assessment.reason})`,
   592→    );
   593→    console.log("");
   594→  }
   595→
   596→  // Summary
   597→  // AC: @tasks-assess-automation ac-5
   598→  console.log(chalk.bold("Summary:"));
   599→  console.log(`  review_for_eligible: ${summary.review_for_eligible}`);
