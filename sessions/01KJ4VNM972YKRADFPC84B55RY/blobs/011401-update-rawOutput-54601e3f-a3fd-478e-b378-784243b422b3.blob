     1→import * as readline from "node:readline";
     2→import type { Command } from "commander";
     3→import { markMutating } from "../command-annotations.js";
     4→import {
     5→  createInboxItem,
     6→  createNote,
     7→  createTask,
     8→  deleteInboxItem,
     9→  findInboxItemByRef,
    10→  getAuthor,
    11→  initContext,
    12→  type LoadedInboxItem,
    13→  loadAllItems,
    14→  loadAllTasks,
    15→  loadInboxItems,
    16→  ReferenceIndex,
    17→  saveInboxItem,
    18→  saveTask,
    19→} from "../../parser/index.js";
    20→import { commitIfShadow } from "../../parser/shadow.js";
    21→import type { InboxItemInput, TaskInput } from "../../schema/index.js";
    22→import { errors } from "../../strings/index.js";
    23→import { fieldLabels } from "../../strings/labels.js";
    24→import { formatRelativeTime as formatRelativeTimeUtil } from "../../utils/time.js";
    25→import { EXIT_CODES } from "../exit-codes.js";
    26→import { error, info, output, success } from "../output.js";
    27→import { parseTagsArray } from "../parse-utils.js";
    28→import { parseIntOption, validateSpecRef } from "../validators.js";
    29→
    30→/**
    31→ * Format relative time for display (wrapper for utils function)
    32→ */
    33→function formatRelativeTime(dateStr: string): string {
    34→  return formatRelativeTimeUtil(new Date(dateStr));
    35→}
    36→
    37→/**
    38→ * Resolve inbox item ref with error handling
    39→ */
    40→function resolveInboxRef(
    41→  ref: string,
    42→  items: LoadedInboxItem[],
    43→): LoadedInboxItem {
    44→  const item = findInboxItemByRef(items, ref);
    45→  if (!item) {
    46→    error(errors.reference.inboxNotFound(ref));
    47→    process.exit(EXIT_CODES.NOT_FOUND);
    48→  }
    49→  return item;
    50→}
    51→
    52→/**
    53→ * Simple prompt for user input
    54→ */
    55→async function prompt(question: string): Promise<string> {
    56→  const rl = readline.createInterface({
    57→    input: process.stdin,
    58→    output: process.stdout,
    59→  });
    60→
    61→  return new Promise((resolve) => {
    62→    rl.question(question, (answer) => {
    63→      rl.close();
    64→      resolve(answer.trim());
    65→    });
    66→  });
    67→}
    68→
    69→/**
    70→ * Register the 'inbox' command group
    71→ */
    72→export function registerInboxCommands(program: Command): void {
    73→  const inbox = program
    74→    .command("inbox")
    75→    .description("Low-friction capture for ideas (not yet tasks)");
    76→
    77→  // kspec inbox add <text>
    78→  markMutating(inbox.command("add <text>"))
    79→    .description("Capture an idea quickly")
    80→    .option("--tag <tag...>", "Add tags for categorization")
    81→    .addHelpText(
    82→      "after",
    83→      `
    84→Examples:
    85→  $ kspec inbox add "Idea for new feature"
    86→  $ kspec inbox add "Consider refactoring X" --tag refactor tech-debt`,
    87→    )
    88→    .action(async (text: string, options) => {
    89→      try {
    90→        const ctx = await initContext();
    91→
    92→        const input: InboxItemInput = {
    93→          text,
    94→          tags: parseTagsArray(options.tag),
    95→        };
    96→
    97→        const item = createInboxItem(input, ctx.config?.identity?.author);
    98→        await saveInboxItem(ctx, item);
    99→        await commitIfShadow(ctx.shadow, "inbox-add", undefined, text);
   100→
   101→        success(`Captured: ${item._ulid.slice(0, 8)}`, { item });
   102→      } catch (err) {
   103→        error(errors.failures.addInboxItem, err);
   104→        process.exit(EXIT_CODES.ERROR);
   105→      }
   106→    });
   107→
   108→  // kspec inbox list
   109→  inbox
   110→    .command("list")
   111→    .description("Show inbox items (oldest first for triage)")
   112→    .option("--tag <tag>", "Filter by tag")
   113→    .option("--limit <n>", "Limit results")
   114→    .option("--newest", "Sort newest first (default is oldest first)")
   115→    .option("--count", "Show only the count of matching items")
   116→    .action(async (options) => {
   117→      try {
   118→        const ctx = await initContext();
   119→        let items = await loadInboxItems(ctx);
   120→
   121→        // Filter by tag
   122→        if (options.tag) {
   123→          items = items.filter((i) => i.tags.includes(options.tag));
   124→        }
   125→
   126→        // Sort: oldest first by default (for triage), newest if requested
   127→        items.sort((a, b) => {
   128→          const dateA = new Date(a.created_at).getTime();
   129→          const dateB = new Date(b.created_at).getTime();
   130→          return options.newest ? dateB - dateA : dateA - dateB;
   131→        });
   132→
   133→        // AC: @trait-filterable-list ac-8
   134→        if (options.count) {
   135→          output({ count: items.length }, () => {
   136→            console.log(items.length);
   137→          });
   138→          return;
   139→        }
   140→
   141→        // Limit
   142→        if (options.limit) {
   143→          const limit = parseInt(options.limit, 10);
   144→          items = items.slice(0, limit);
   145→        }
   146→
   147→        output(items, () => {
   148→          if (items.length === 0) {
   149→            console.log("Inbox is empty");
   150→            return;
   151→          }
   152→
   153→          console.log(
   154→            `Inbox (${items.length} item${items.length === 1 ? "" : "s"}):\n`,
   155→          );
   156→
   157→          for (const item of items) {
   158→            const tags =
   159→              item.tags.length > 0 ? ` [${item.tags.join(", ")}]` : "";
   160→            const age = formatRelativeTime(item.created_at);
   161→            const author = item.added_by ? ` by ${item.added_by}` : "";
   162→            console.log(`  ${item._ulid.slice(0, 8)} (${age}${author})${tags}`);
   163→            console.log(`    ${item.text}`);
   164→            console.log("");
   165→          }
   166→        });
   167→      } catch (err) {
   168→        error(errors.failures.listInboxItems, err);
   169→        process.exit(EXIT_CODES.ERROR);
   170→      }
   171→    });
   172→
   173→  // kspec inbox promote <ref>
   174→  markMutating(inbox.command("promote <ref>"))
   175→    .description("Convert inbox item to task")
   176→    .option("--title <title>", "Task title (prompts if not provided)")
   177→    .option(
   178→      "--description <text>",
   179→      "Task description (defaults to inbox item text)",
   180→    )
   181→    .option("--priority <n>", "Priority (1-5)", "3")
   182→    .option("--type <type>", "Task type (task, bug, spike, etc.)", "task")
   183→    .option("--spec-ref <ref>", "Link to spec item")
   184→    .option("--tag <tag...>", "Tags for the task")
   185→    .option("--note <text>", "Add initial note to the created task")
   186→    .option("--keep", "Keep inbox item after promoting")
   187→    .addHelpText(
   188→      "after",
   189→      `
   190→Examples:
   191→  $ kspec inbox promote @ref --title "New task from idea"
   192→  $ kspec inbox promote @ref --title "Tagged task" --tag cli urgent`,
   193→    )
   194→    .action(async (ref: string, options) => {
   195→      try {
   196→        const ctx = await initContext();
   197→        const inboxItems = await loadInboxItems(ctx);
   198→        const item = resolveInboxRef(ref, inboxItems);
   199→
   200→        // Validate priority
   201→        const priorityResult = parseIntOption(options.priority, {
   202→          min: 1,
   203→          max: 5,
   204→          name: "Priority",
   205→        });
   206→        if (!priorityResult.ok) {
   207→          error(priorityResult.error);
   208→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   209→        }
   210→
   211→        // Validate spec_ref if provided — must point to a spec item
   212→        if (options.specRef) {
   213→          const allTasks = await loadAllTasks(ctx);
   214→          const allItems = await loadAllItems(ctx);
   215→          const refIndex = new ReferenceIndex(allTasks, allItems);
   216→          const specRefResult = validateSpecRef(
   217→            options.specRef,
   218→            refIndex,
   219→            allTasks,
   220→            allItems,
   221→          );
   222→          if (!specRefResult.ok) {
   223→            error(specRefResult.error);
   224→            process.exit(EXIT_CODES.NOT_FOUND);
   225→          }
   226→        }
   227→
   228→        // Determine task title
   229→        let title = options.title;
   230→        if (!title) {
   231→          // Interactive prompt
   232→          console.log(`Promoting: "${item.text}"`);
   233→          console.log("");
   234→          title = await prompt("Task title: ");
   235→          if (!title) {
   236→            error(errors.validation.titleRequired);
   237→            process.exit(EXIT_CODES.USAGE_ERROR);
   238→          }
   239→        }
   240→
   241→        // Create the task
   242→        const taskInput: TaskInput = {
   243→          title,
   244→          type: options.type,
   245→          priority: priorityResult.value,
   246→          spec_ref: options.specRef || null,
   247→          tags: options.tag ? parseTagsArray(options.tag) : item.tags, // Inherit tags from inbox item if not specified
   248→          description:
   249→            options.description !== undefined ? options.description : item.text, // Use provided description (even if empty) or fall back to inbox item text
   250→        };
   251→
   252→        const task = createTask(taskInput);
   253→
   254→        // AC: @cmd-inbox-promote ac-2
   255→        if (options.note) {
   256→          const note = createNote(options.note, getAuthor(ctx.config?.identity?.author));
   257→          task.notes = [...(task.notes || []), note];
   258→        }
   259→
   260→        await saveTask(ctx, task);
   261→
   262→        // Load for index to get short ULID
   263→        const tasks = await loadAllTasks(ctx);
   264→        const items = await loadAllItems(ctx);
   265→        const index = new ReferenceIndex(tasks, items);
   266→
   267→        // Delete inbox item unless --keep
   268→        if (!options.keep) {
   269→          await deleteInboxItem(ctx, item._ulid);
   270→          info(`Removed from inbox: ${item._ulid.slice(0, 8)}`);
   271→        }
   272→
   273→        await commitIfShadow(
   274→          ctx.shadow,
   275→          "inbox-promote",
   276→          task.slugs[0] || index.shortUlid(task._ulid),
   277→        );
   278→        success(`Created task: ${index.shortUlid(task._ulid)} - ${title}`, {
   279→          task,
   280→        });
   281→      } catch (err) {
   282→        error(errors.failures.promoteInboxItem, err);
   283→        process.exit(EXIT_CODES.ERROR);
   284→      }
   285→    });
   286→
   287→  // kspec inbox delete <ref>
   288→  markMutating(inbox.command("delete <ref>"))
   289→    .description("Remove an inbox item")
   290→    .option("--force", "Skip confirmation")
   291→    .action(async (ref: string, options) => {
   292→      try {
   293→        const ctx = await initContext();
   294→        const items = await loadInboxItems(ctx);
   295→        const item = resolveInboxRef(ref, items);
   296→
   297→        // Confirm unless --force
   298→        if (!options.force) {
   299→          console.log(`Delete: "${item.text}"`);
   300→          const confirm = await prompt("Are you sure? (y/N): ");
   301→          if (confirm.toLowerCase() !== "y") {
   302→            console.log("Cancelled");
   303→            return;
   304→          }
   305→        }
   306→
   307→        const deleted = await deleteInboxItem(ctx, item._ulid);
   308→        if (deleted) {
   309→          await commitIfShadow(
   310→            ctx.shadow,
   311→            "inbox-delete",
   312→            item._ulid.slice(0, 8),
   313→          );
   314→          success(`Deleted inbox item: ${item._ulid.slice(0, 8)}`);
   315→        } else {
   316→          error(errors.failures.deleteInboxItem);
   317→          process.exit(EXIT_CODES.ERROR);
   318→        }
   319→      } catch (err) {
   320→        error(errors.failures.deleteInboxItem, err);
   321→        process.exit(EXIT_CODES.ERROR);
   322→      }
   323→    });
   324→
   325→  // kspec inbox get <ref>
   326→  inbox
   327→    .command("get <ref>")
   328→    .description("Show details of an inbox item")
   329→    .action(async (ref: string) => {
   330→      try {
   331→        const ctx = await initContext();
   332→        const items = await loadInboxItems(ctx);
   333→        const item = resolveInboxRef(ref, items);
   334→
   335→        output(item, () => {
   336→          console.log(`${fieldLabels.ulid}     ${item._ulid}`);
   337→          console.log(
   338→            `${fieldLabels.created}  ${item.created_at} (${formatRelativeTime(item.created_at)})`,
   339→          );
   340→          if (item.added_by) {
   341→            console.log(`Added by: ${item.added_by}`);
   342→          }
   343→          if (item.tags.length > 0) {
   344→            console.log(`${fieldLabels.tags}     ${item.tags.join(", ")}`);
   345→          }
   346→          console.log("");
   347→          console.log(item.text);
   348→        });
   349→      } catch (err) {
   350→        error(errors.failures.getInboxItem, err);
   351→        process.exit(EXIT_CODES.ERROR);
   352→      }
   353→    });
   354→
   355→  // kspec inbox set <ref>
   356→  // AC: @inbox-set ac-1, ac-2
   357→  markMutating(inbox.command("set <ref>"))
   358→    .description("Update an inbox item")
   359→    .option("--content <text>", "Replace item content")
   360→    .option("--tag <tag...>", "Add tags to item")
   361→    .option("--clear-tags", "Clear all tags before adding new ones")
   362→    .addHelpText(
   363→      "after",
   364→      `
   365→Examples:
   366→  $ kspec inbox set @ref --content "Updated text"
   367→  $ kspec inbox set @ref --tag newtag
   368→  $ kspec inbox set @ref --clear-tags --tag fresh-start`,
   369→    )
   370→    .action(async (ref: string, options) => {
   371→      try {
   372→        const ctx = await initContext();
   373→        const items = await loadInboxItems(ctx);
   374→        const item = resolveInboxRef(ref, items);
   375→
   376→        // Track what was updated
   377→        const updates: string[] = [];
   378→
   379→        // AC: @inbox-set ac-1 - Update content if provided
   380→        if (options.content !== undefined) {
   381→          item.text = options.content;
   382→          updates.push("content");
   383→        }
   384→
   385→        // AC: @inbox-set ac-2 - Update tags if provided
   386→        if (options.clearTags) {
   387→          item.tags = [];
   388→          updates.push("cleared tags");
   389→        }
   390→        if (options.tag) {
   391→          const newTags = parseTagsArray(options.tag);
   392→          // Append new tags, avoiding duplicates
   393→          for (const tag of newTags) {
   394→            if (!item.tags.includes(tag)) {
   395→              item.tags.push(tag);
   396→            }
   397→          }
   398→          updates.push("tags");
   399→        }
   400→
   401→        if (updates.length === 0) {
   402→          info("No updates specified. Use --content or --tag to update.");
   403→          return;
   404→        }
   405→
   406→        await saveInboxItem(ctx, item);
   407→        await commitIfShadow(
   408→          ctx.shadow,
   409→          "inbox-set",
   410→          item._ulid.slice(0, 8),
   411→          updates.join(", "),
   412→        );
   413→
   414→        success(`Updated inbox item: ${item._ulid.slice(0, 8)}`, { item });
   415→      } catch (err) {
   416→        error(errors.failures.updateInboxItem, err);
   417→        process.exit(EXIT_CODES.ERROR);
   418→      }
   419→    });
   420→
   421→  // kspec inbox note <ref> <text>
   422→  // AC: @inbox-note ac-1
   423→  markMutating(inbox.command("note <ref> <text>"))
   424→    .description("Append a note to an inbox item")
   425→    .addHelpText(
   426→      "after",
   427→      `
   428→Examples:
   429→  $ kspec inbox note @ref "Additional context for this idea"
   430→  $ kspec inbox note @ref "Update: decided to defer this"`,
   431→    )
   432→    .action(async (ref: string, text: string) => {
   433→      try {
   434→        const ctx = await initContext();
   435→        const items = await loadInboxItems(ctx);
   436→        const item = resolveInboxRef(ref, items);
   437→
   438→        // Append note with separator
   439→        const separator = "\n\n---\n\n";
   440→        item.text = item.text + separator + text;
   441→
   442→        await saveInboxItem(ctx, item);
   443→        await commitIfShadow(ctx.shadow, "inbox-note", item._ulid.slice(0, 8));
   444→
   445→        success(`Added note to inbox item: ${item._ulid.slice(0, 8)}`, { item });
   446→      } catch (err) {
   447→        error(errors.failures.addInboxNote, err);
   448→        process.exit(EXIT_CODES.ERROR);
   449→      }
   450→    });
   451→}
   452→