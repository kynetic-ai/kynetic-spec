     1→/**
     2→ * Platform Skill Renderers
     3→ *
     4→ * Defines the contract for platform-specific skill renderers and provides
     5→ * the Claude Code implementation. Each renderer writes platform-specific output
     6→ * (SKILL.md with frontmatter, sidecar config files, supporting directories)
     7→ * to a configurable output directory.
     8→ *
     9→ * AC: @claude-code-renderer ac-1 - renderClaudeCodeSkill creates .claude/skills/<id>/SKILL.md with YAML frontmatter
    10→ * AC: @claude-code-renderer ac-2 - rendered output has YAML frontmatter delimiters with name and description fields
    11→ * AC: @claude-code-renderer ac-3 - skill body content appears verbatim below frontmatter
    12→ * AC: @claude-code-renderer ac-4 - rendered files appear as unstaged changes on main branch
    13→ *
    14→ * AC: @skill-drift-detection ac-1 - Skill shows as in-sync when not manually edited
    15→ * AC: @skill-drift-detection ac-2 - Skill shows as drifted when manually edited
    16→ * AC: @skill-drift-detection ac-5 - Render hash stored in .kspec/skills/<id>/.render-hash
    17→ *
    18→ * AC: @consolidate-skill-render ac-3 - hash/drift functions exported from this module
    19→ *
    20→ * AC: @platform-renderer-trait ac-1 - platform-specific output files written to configured output directory
    21→ * AC: @platform-renderer-trait ac-2 - PlatformRenderResult returned with id, platform, action, paths
    22→ * AC: @platform-renderer-trait ac-3 - supporting directories (references/, scripts/, assets/) copied
    23→ * AC: @platform-renderer-trait ac-4 - dryRun mode: no files written, result reflects what would happen
    24→ * AC: @platform-renderer-trait ac-5 - custom outputDir goes to custom path instead of platform default
    25→ * AC: @platform-renderer-trait ac-6 - per-platform render hash written to .render-hash-<platform>
    26→ *
    27→ * AC: @codex-renderer ac-1 - .agents/skills/<id>/SKILL.md with only name and description in frontmatter
    28→ * AC: @codex-renderer ac-2 - .agents/skills/<id>/agents/openai.yaml sidecar with platform_config.codex fields
    29→ * AC: @codex-renderer ac-3 - no sidecar created when no platform_config.codex
    30→ * AC: @codex-renderer ac-4 - rendered file contains <!-- kspec-managed --> marker
    31→ * AC: @codex-renderer ac-5 - supporting directories (references/, scripts/, assets/) copied
    32→ * AC: @codex-renderer ac-6 - hash written to .render-hash-codex
    33→ */
    34→
    35→import * as crypto from "node:crypto";
    36→import * as fs from "node:fs/promises";
    37→import * as path from "node:path";
    38→import yaml from "yaml";
    39→import type { KspecContext } from "./yaml.js";
    40→import { loadSkillContent, type LoadedSkill } from "./meta.js";
    41→
    42→// ============================================================================
    43→// Platform Renderer Contract (AC: @platform-renderer-trait)
    44→// ============================================================================
    45→
    46→/**
    47→ * Status of drift detection for a rendered skill
    48→ * AC: @platform-renderer-trait ac-2
    49→ */
    50→export type DriftStatus = "not-rendered" | "in-sync" | "drifted" | "no-hash" | "plugin-provided";
    51→
    52→/**
    53→ * Result of rendering a skill to a specific platform
    54→ * AC: @platform-renderer-trait ac-2
    55→ */
    56→export interface PlatformRenderResult {
    57→  /** Skill ID */
    58→  id: string;
    59→  /** Platform this result is for */
    60→  platform: string;
    61→  /** Action taken: created, updated, unchanged, or skipped */
    62→  action: "created" | "updated" | "unchanged" | "skipped";
    63→  /** Paths to all output files */
    64→  paths: string[];
    65→  /** Actions taken on supporting directories (references/, scripts/, assets/, docs/) */
    66→  supportingDirsAction?: Record<string, "created" | "updated" | "unchanged" | "skipped">;
    67→  /** Reason if action is skipped */
    68→  skipReason?: string;
    69→  /** Structured code for skip reason (avoids string matching) */
    70→  skipCode?: "plugin-provided";
    71→}
    72→
    73→/**
    74→ * Options for rendering a skill to a platform
    75→ * AC: @platform-renderer-trait ac-4, ac-5
    76→ */
    77→export interface PlatformRenderOptions {
    78→  /** If true, don't write files, just return what would be done */
    79→  dryRun?: boolean;
    80→  /** If true, store a hash of the rendered content for drift detection */
    81→  storeHash?: boolean;
    82→  /** Custom output directory (overrides platform default) */
    83→  outputDir?: string;
    84→}
    85→
    86→/**
    87→ * Contract for platform-specific skill renderers
    88→ * AC: @platform-renderer-trait ac-1, ac-2
    89→ */
    90→export interface PlatformRenderer {
    91→  /** Platform identifier (e.g., "claude-code", "codex") */
    92→  platform: string;
    93→  /** Default output directory relative to project root (e.g., ".claude/skills") */
    94→  defaultOutputDir: string;
    95→  /**
    96→   * Render a skill to platform-specific output
    97→   * AC: @platform-renderer-trait ac-1, ac-2, ac-3, ac-4, ac-5
    98→   */
    99→  render(
   100→    ctx: KspecContext,
   101→    projectRoot: string,
   102→    skill: LoadedSkill,
   103→    options?: PlatformRenderOptions
   104→  ): Promise<PlatformRenderResult>;
   105→  /**
   106→   * Check if a rendered skill has drifted from its source
   107→   * AC: @platform-renderer-trait ac-6
   108→   */
   109→  checkDrift(
   110→    specDir: string,
   111→    projectRoot: string,
   112→    skillId: string,
   113→    options?: { outputDir?: string; origin?: string }
   114→  ): Promise<DriftStatus>;
   115→}
   116→
   117→// ============================================================================
   118→// Backward Compatibility Types
   119→// ============================================================================
   120→
   121→/**
   122→ * Result of rendering a skill to Claude Code format
   123→ * @deprecated Use PlatformRenderResult instead
   124→ */
   125→export interface ClaudeCodeRenderResult {
   126→  /** Skill ID */
   127→  id: string;
   128→  /** Action taken: created, updated, unchanged, or skipped (plugin-provided) */
   129→  action: "created" | "updated" | "unchanged" | "skipped";
   130→  /** Path to the rendered SKILL.md file */
   131→  path: string;
   132→  /** Action taken on docs directory */
   133→  docsAction?: "created" | "updated" | "unchanged" | "skipped";
   134→}
   135→
   136→/**
   137→ * Options for rendering a skill
   138→ * @deprecated Use PlatformRenderOptions instead
   139→ */
   140→export interface RenderSkillOptions {
   141→  /** If true, don't write files, just return what would be done */
   142→  dryRun?: boolean;
   143→  /** If true, store a hash of the rendered content for drift detection */
   144→  storeHash?: boolean;
   145→  /** Custom output directory (overrides platform default) */
   146→  outputDir?: string;
   147→}
   148→
   149→/**
   150→ * Marker comment that identifies skill directories managed by kspec
   151→ */
   152→export const KSPEC_MANAGED_MARKER = "<!-- kspec-managed -->";
   153→
   154→/**
   155→ * Generate YAML frontmatter for a skill.
   156→ * AC: @claude-code-renderer ac-2 - YAML frontmatter with name and description fields
   157→ * AC: @claude-code-renderer-extended ac-1 - portable fields (license, allowed-tools)
   158→ * AC: @claude-code-renderer-extended ac-2 - user-invocable from platform_config
   159→ * AC: @claude-code-renderer-extended ac-3 - context and agent from platform_config
   160→ * AC: @claude-code-renderer-extended ac-4 - disable-model-invocation from platform_config
   161→ * AC: @claude-code-renderer-extended ac-5 - only portable fields when no platform_config
   162→ * AC: @claude-code-renderer-extended ac-8 - snake_case to kebab-case conversion
   163→ */
   164→export function generateFrontmatter(skill: LoadedSkill): string {
   165→  const frontmatter: Record<string, unknown> = {
   166→    name: skill.id,
   167→    description: skill.description || skill.name,
   168→  };
   169→
   170→  // AC: @claude-code-renderer-extended ac-1 - Add portable fields
   171→  if (skill.license) {
   172→    frontmatter.license = skill.license;
   173→  }
   174→  if (skill.allowed_tools && skill.allowed_tools.length > 0) {
   175→    frontmatter["allowed-tools"] = skill.allowed_tools;
   176→  }
   177→  if (skill.compatibility) {
   178→    frontmatter.compatibility = skill.compatibility;
   179→  }
   180→
   181→  // AC: @claude-code-renderer-extended ac-2, ac-3, ac-4 - Add Claude Code platform fields
   182→  const claudeCodeConfig = skill.platform_config?.claude_code;
   183→  if (claudeCodeConfig) {
   184→    // AC: @claude-code-renderer-extended ac-2 - user_invocable
   185→    if (claudeCodeConfig.user_invocable !== undefined) {
   186→      frontmatter["user-invocable"] = claudeCodeConfig.user_invocable;
   187→    }
   188→    // AC: @claude-code-renderer-extended ac-4 - disable_model_invocation
   189→    if (claudeCodeConfig.disable_model_invocation !== undefined) {
   190→      frontmatter["disable-model-invocation"] = claudeCodeConfig.disable_model_invocation;
   191→    }
   192→    // AC: @claude-code-renderer-extended ac-3 - context and agent
   193→    if (claudeCodeConfig.context) {
   194→      frontmatter.context = claudeCodeConfig.context;
   195→    }
   196→    if (claudeCodeConfig.agent) {
   197→      frontmatter.agent = claudeCodeConfig.agent;
   198→    }
   199→    // Other Claude Code fields
   200→    if (claudeCodeConfig.model) {
   201→      frontmatter.model = claudeCodeConfig.model;
   202→    }
   203→    if (claudeCodeConfig.argument_hint) {
   204→      frontmatter["argument-hint"] = claudeCodeConfig.argument_hint;
   205→    }
   206→  }
   207→
   208→  return `---\n${yaml.stringify(frontmatter).trim()}\n---`;
   209→}
   210→
   211→/**
   212→ * Plugin system constants for Claude Code core skill rendering.
   213→ * Core skills render into the plugin directory so Claude Code discovers
   214→ * them as /kspec:<id> commands.
   215→ * AC: @skill-rendering ac-7
   216→ */
   217→export const PLUGIN_DIR = ".claude/plugins/kspec";
   218→export const PLUGIN_SKILLS_DIR = ".claude/plugins/kspec/skills";
   219→
   220→/**
   221→ * Get the rendered skill subdirectory segment for a given platform.
   222→ * Core skills on codex are prefixed with kspec- for namespace clarity.
   223→ * Core skills on claude-code just use the skill id (plugin path provides namespace).
   224→ * All other combinations use the skill id directly.
   225→ * AC: @skill-rendering ac-7
   226→ */
   227→export function getSkillSubdir(skillId: string, origin?: string, platform?: string): string {
   228→  if (origin === "core" && platform === "codex") {
   229→    return `kspec-${skillId}`;
   230→  }
   231→  // Core+claude-code: just ID (plugin path provides namespace)
   232→  // Project/local: just ID (flat under .claude/skills/)
   233→  return skillId;
   234→}
   235→
   236→/**
   237→ * Convenience wrapper for LoadedSkill objects (Claude Code platform).
   238→ */
   239→export function getClaudeCodeSkillSubdir(skill: LoadedSkill): string {
   240→  return getSkillSubdir(skill.id, skill.origin, "claude-code");
   241→}
   242→
   243→/**
   244→ * Get the target directory for rendered skills on main branch.
   245→ * Core skills on claude-code are plugin-provided (returns null).
   246→ * Project/local skills go to .claude/skills/.
   247→ * AC: @skill-rendering ac-7
   248→ */
   249→function getRenderedSkillPath(projectRoot: string, skillId: string, origin?: string): string | null {
   250→  if (origin === "core") {
   251→    // Core skills are plugin-provided, not locally rendered
   252→    return null;
   253→  }
   254→  return path.join(projectRoot, ".claude", "skills", skillId);
   255→}
   256→
   257→/**
   258→ * Check if two contents are equal (for idempotency check)
   259→ */
   260→export function contentsEqual(a: string, b: string): boolean {
   261→  return a.trim() === b.trim();
   262→}
   263→
   264→/**
   265→ * Recursively copy a directory
   266→ */
   267→export async function copyDirectory(src: string, dest: string): Promise<void> {
   268→  const entries = await fs.readdir(src, { withFileTypes: true });
   269→
   270→  for (const entry of entries) {
   271→    const srcPath = path.join(src, entry.name);
   272→    const destPath = path.join(dest, entry.name);
   273→
   274→    if (entry.isDirectory()) {
   275→      await fs.mkdir(destPath, { recursive: true });
   276→      await copyDirectory(srcPath, destPath);
   277→    } else {
   278→      await fs.copyFile(srcPath, destPath);
   279→    }
   280→  }
   281→}
   282→
   283→/**
   284→ * Compute SHA256 hash of content
   285→ * AC: @skill-drift-detection ac-5 - Hash computation for render tracking
   286→ */
   287→export function computeContentHash(content: string): string {
   288→  return crypto.createHash("sha256").update(content, "utf-8").digest("hex");
   289→}
   290→
   291→/**
   292→ * Get the path to the render hash file for a skill
   293→ * AC: @skill-drift-detection ac-5 - Hash stored in .kspec/skills/<id>/.render-hash
   294→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   295→ */
   296→export function getRenderHashPath(specDir: string, skillId: string): string {
   297→  return path.join(specDir, "skills", skillId, ".render-hash");
   298→}
   299→
   300→/**
   301→ * Read the stored render hash for a skill
   302→ * AC: @skill-drift-detection ac-5 - Read hash from .kspec/skills/<id>/.render-hash
   303→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   304→ */
   305→export async function readRenderHash(specDir: string, skillId: string): Promise<string | null> {
   306→  try {
   307→    const hashPath = getRenderHashPath(specDir, skillId);
   308→    const content = await fs.readFile(hashPath, "utf-8");
   309→    return content.trim();
   310→  } catch {
   311→    return null;
   312→  }
   313→}
   314→
   315→/**
   316→ * Write the render hash for a skill
   317→ * AC: @skill-drift-detection ac-5 - Store hash in .kspec/skills/<id>/.render-hash
   318→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   319→ */
   320→export async function writeRenderHash(specDir: string, skillId: string, hash: string): Promise<void> {
   321→  const hashPath = getRenderHashPath(specDir, skillId);
   322→  await fs.mkdir(path.dirname(hashPath), { recursive: true });
   323→  await fs.writeFile(hashPath, hash + "\n", "utf-8");
   324→}
   325→
   326→/**
   327→ * Check if a rendered skill has drifted from its last render
   328→ * AC: @skill-drift-detection ac-1, ac-2 - Drift detection via hash comparison
   329→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   330→ *
   331→ * Returns:
   332→ * - "not-rendered": Rendered file doesn't exist
   333→ * - "in-sync": Rendered file matches stored hash
   334→ * - "drifted": Rendered file differs from stored hash (manually edited)
   335→ * - "no-hash": Rendered file exists but no stored hash (first render or hash deleted)
   336→ */
   337→export async function checkSkillDrift(
   338→  specDir: string,
   339→  projectRoot: string,
   340→  skillId: string,
   341→  origin?: string
   342→): Promise<DriftStatus> {
   343→  const basePath = getRenderedSkillPath(projectRoot, skillId, origin);
   344→  if (!basePath) {
   345→    return "plugin-provided"; // Core skills are provided by npm package plugin
   346→  }
   347→  const renderedPath = path.join(basePath, "SKILL.md");
   348→
   349→  // Check if rendered file exists
   350→  let renderedContent: string;
   351→  try {
   352→    renderedContent = await fs.readFile(renderedPath, "utf-8");
   353→  } catch {
   354→    return "not-rendered";
   355→  }
   356→
   357→  // Get stored hash
   358→  const storedHash = await readRenderHash(specDir, skillId);
   359→  if (!storedHash) {
   360→    return "no-hash";
   361→  }
   362→
   363→  // Compare hashes
   364→  const currentHash = computeContentHash(renderedContent);
   365→  return currentHash === storedHash ? "in-sync" : "drifted";
   366→}
   367→
   368→/**
   369→ * Recursively check if two directories have the same contents
   370→ */
   371→export async function directoriesEqual(src: string, dest: string): Promise<boolean> {
   372→  try {
   373→    const srcEntries = await fs.readdir(src, { withFileTypes: true });
   374→    const destEntries = await fs.readdir(dest, { withFileTypes: true });
   375→
   376→    // Different number of entries = not equal
   377→    if (srcEntries.length !== destEntries.length) {
   378→      return false;
   379→    }
   380→
   381→    // Create a map of dest entries for quick lookup
   382→    const destMap = new Map(destEntries.map((e) => [e.name, e]));
   383→
   384→    for (const srcEntry of srcEntries) {
   385→      const destEntry = destMap.get(srcEntry.name);
   386→      if (!destEntry) {
   387→        return false;
   388→      }
   389→
   390→      const srcPath = path.join(src, srcEntry.name);
   391→      const destPath = path.join(dest, srcEntry.name);
   392→
   393→      if (srcEntry.isDirectory() && destEntry.isDirectory()) {
   394→        if (!(await directoriesEqual(srcPath, destPath))) {
   395→          return false;
   396→        }
   397→      } else if (srcEntry.isFile() && destEntry.isFile()) {
   398→        const srcContent = await fs.readFile(srcPath, "utf-8");
   399→        const destContent = await fs.readFile(destPath, "utf-8");
   400→        if (!contentsEqual(srcContent, destContent)) {
   401→          return false;
   402→        }
   403→      } else {
   404→        // Type mismatch
   405→        return false;
   406→      }
   407→    }
   408→
   409→    return true;
   410→  } catch {
   411→    return false;
   412→  }
   413→}
   414→
   415→// ============================================================================
   416→// Supporting Directories (AC: @platform-renderer-trait ac-3, @claude-code-renderer-extended ac-7)
   417→// ============================================================================
   418→
   419→/** Known supporting directory names */
   420→const SUPPORTING_DIRS = ["references", "scripts", "assets", "docs"] as const;
   421→
   422→/**
   423→ * Copy supporting directories from source skill to rendered output
   424→ * AC: @platform-renderer-trait ac-3 - Supporting directories copied to platform output
   425→ * AC: @claude-code-renderer-extended ac-7 - references/, scripts/, assets/ copied
   426→ */
   427→async function copySupportingDirectories(
   428→  sourceSkillDir: string,
   429→  targetSkillDir: string,
   430→  dryRun: boolean
   431→): Promise<Record<string, "created" | "updated" | "unchanged" | "skipped">> {
   432→  const results: Record<string, "created" | "updated" | "unchanged" | "skipped"> = {};
   433→
   434→  for (const dirName of SUPPORTING_DIRS) {
   435→    const sourceDir = path.join(sourceSkillDir, dirName);
   436→    const targetDir = path.join(targetSkillDir, dirName);
   437→
   438→    try {
   439→      const stats = await fs.stat(sourceDir);
   440→      if (!stats.isDirectory()) {
   441→        results[dirName] = "skipped";
   442→        continue;
   443→      }
   444→
   445→      // Check if target exists
   446→      let targetExists = false;
   447→      try {
   448→        await fs.stat(targetDir);
   449→        targetExists = true;
   450→      } catch {
   451→        // Target doesn't exist
   452→      }
   453→
   454→      if (!targetExists) {
   455→        results[dirName] = "created";
   456→      } else {
   457→        // Compare directories
   458→        const equal = await directoriesEqual(sourceDir, targetDir);
   459→        results[dirName] = equal ? "unchanged" : "updated";
   460→      }
   461→
   462→      // Apply changes
   463→      if (!dryRun && results[dirName] !== "unchanged") {
   464→        if (targetExists) {
   465→          await fs.rm(targetDir, { recursive: true, force: true });
   466→        }
   467→        await fs.mkdir(targetDir, { recursive: true });
   468→        await copyDirectory(sourceDir, targetDir);
   469→      }
   470→    } catch {
   471→      // Source directory doesn't exist
   472→      results[dirName] = "skipped";
   473→    }
   474→  }
   475→
   476→  return results;
   477→}
   478→
   479→/**
   480→ * Render a skill to Claude Code format.
   481→ *
   482→ * Reads skill content from .kspec/skills/<id>/SKILL.md and writes to
   483→ * .claude/skills/<id>/SKILL.md with YAML frontmatter containing name and description.
   484→ *
   485→ * AC: @claude-code-renderer ac-1 - Creates .claude/skills/<id>/SKILL.md with YAML frontmatter
   486→ * AC: @claude-code-renderer ac-2 - YAML frontmatter has name and description fields
   487→ * AC: @claude-code-renderer ac-3 - Skill body content appears verbatim below frontmatter
   488→ * AC: @claude-code-renderer ac-4 - Files are written to disk as unstaged changes (no git commit)
   489→ *
   490→ * @param ctx - Kspec context with specDir pointing to .kspec/
   491→ * @param projectRoot - Root directory of the project (where .claude/ will be created)
   492→ * @param skill - The skill to render
   493→ * @param options - Render options (dryRun, etc.)
   494→ * @returns Result indicating what action was taken
   495→ */
   496→export async function renderClaudeCodeSkill(
   497→  ctx: KspecContext,
   498→  projectRoot: string,
   499→  skill: LoadedSkill,
   500→  options: RenderSkillOptions = {},
   501→): Promise<ClaudeCodeRenderResult> {
   502→  const dryRun = options.dryRun ?? false;
   503→  const storeHash = options.storeHash ?? false;
   504→  const targetDir = getRenderedSkillPath(projectRoot, skill.id, skill.origin);
   505→
   506→  // Core skills are plugin-provided; skip local render
   507→  if (!targetDir) {
   508→    return {
   509→      id: skill.id,
   510→      action: "skipped",
   511→      path: "",
   512→    };
   513→  }
   514→
   515→  const targetSkillMd = path.join(targetDir, "SKILL.md");
   516→
   517→  // AC: @claude-code-renderer ac-3 - Load source content verbatim
   518→  const sourceContent = await loadSkillContent(ctx, skill);
   519→
   520→  if (!sourceContent) {
   521→    // No source content, but skill exists in meta - create placeholder
   522→    const frontmatter = generateFrontmatter(skill);
   523→    const renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
   524→
   525→    // AC: @claude-code-renderer ac-4 - Write to disk (unstaged)
   526→    if (!dryRun) {
   527→      await fs.mkdir(targetDir, { recursive: true });
   528→      await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
   529→      // AC: @skill-drift-detection ac-5 - Store hash of rendered output
   530→      if (storeHash) {
   531→        const hash = computeContentHash(renderedContent);
   532→        await writeRenderHash(ctx.specDir, skill.id, hash);
   533→      }
   534→    }
   535→
   536→    return {
   537→      id: skill.id,
   538→      action: "created",
   539→      path: targetSkillMd,
   540→    };
   541→  }
   542→
   543→  // AC: @claude-code-renderer ac-2 - Generate frontmatter with name and description
   544→  const frontmatter = generateFrontmatter(skill);
   545→
   546→  // Check if source already has frontmatter - if so, strip it
   547→  const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
   548→  const contentWithoutFrontmatter = frontmatterMatch
   549→    ? sourceContent.slice(frontmatterMatch[0].length)
   550→    : sourceContent;
   551→
   552→  // AC: @claude-code-renderer ac-1, ac-3 - Build rendered content with frontmatter + verbatim body
   553→  const renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
   554→
   555→  // Check if target exists and compare for idempotency
   556→  let targetExists = false;
   557→  let targetContent = "";
   558→  try {
   559→    targetContent = await fs.readFile(targetSkillMd, "utf-8");
   560→    targetExists = true;
   561→  } catch {
   562→    // Target doesn't exist
   563→  }
   564→
   565→  // Determine action based on comparison
   566→  let action: "created" | "updated" | "unchanged";
   567→
   568→  if (!targetExists) {
   569→    action = "created";
   570→  } else if (contentsEqual(renderedContent, targetContent)) {
   571→    action = "unchanged";
   572→  } else {
   573→    action = "updated";
   574→  }
   575→
   576→  // AC: @claude-code-renderer ac-4 - Apply changes to disk (no git commit)
   577→  if (!dryRun && action !== "unchanged") {
   578→    await fs.mkdir(targetDir, { recursive: true });
   579→    await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
   580→    // AC: @skill-drift-detection ac-5 - Store hash of rendered output
   581→    if (storeHash) {
   582→      const hash = computeContentHash(renderedContent);
   583→      await writeRenderHash(ctx.specDir, skill.id, hash);
   584→    }
   585→  }
   586→
   587→  // AC: @claude-code-renderer-extended ac-7 - Copy supporting directories (references/, scripts/, assets/, docs/)
   588→  const sourceSkillDir = path.join(ctx.specDir, "skills", skill.id);
   589→  const supportingDirsAction = await copySupportingDirectories(
   590→    sourceSkillDir,
   591→    targetDir,
   592→    dryRun
   593→  );
   594→
   595→  // For backward compatibility, also expose docsAction
   596→  const docsAction = supportingDirsAction.docs || "skipped";
   597→
   598→  return {
   599→    id: skill.id,
   600→    action,
   601→    path: targetSkillMd,
   602→    docsAction,
   603→  };
   604→}
   605→
   606→/**
   607→ * Check if a skill directory is managed by kspec.
   608→ * Looks for the KSPEC_MANAGED_MARKER in the SKILL.md file.
   609→ */
   610→export async function isKspecManagedSkill(skillMdPath: string): Promise<boolean> {
   611→  try {
   612→    const content = await fs.readFile(skillMdPath, "utf-8");
   613→    return content.includes(KSPEC_MANAGED_MARKER);
   614→  } catch {
   615→    return false;
   616→  }
   617→}
   618→
   619→// ============================================================================
   620→// Per-Platform Hash Functions (AC: @platform-renderer-trait ac-6)
   621→// ============================================================================
   622→
   623→/**
   624→ * Get the path to the per-platform render hash file for a skill
   625→ * AC: @platform-renderer-trait ac-6 - Per-platform hash stored in .render-hash-<platform>
   626→ */
   627→export function getPlatformRenderHashPath(specDir: string, skillId: string, platform: string): string {
   628→  return path.join(specDir, "skills", skillId, `.render-hash-${platform}`);
   629→}
   630→
   631→/**
   632→ * Read the stored render hash for a skill on a specific platform
   633→ * AC: @platform-renderer-trait ac-6 - Read per-platform hash
   634→ * AC: @claude-code-renderer-extended ac-6 - fallback to legacy hash
   635→ */
   636→export async function readPlatformRenderHash(
   637→  specDir: string,
   638→  skillId: string,
   639→  platform: string
   640→): Promise<string | null> {
   641→  try {
   642→    const hashPath = getPlatformRenderHashPath(specDir, skillId, platform);
   643→    const content = await fs.readFile(hashPath, "utf-8");
   644→    return content.trim();
   645→  } catch {
   646→    // Fall back to legacy hash (non-platform-specific)
   647→    return readRenderHash(specDir, skillId);
   648→  }
   649→}
   650→
   651→/**
   652→ * Migrate legacy .render-hash to platform-specific .render-hash-<platform>
   653→ * AC: @claude-code-renderer-extended ac-6 - hash migration
   654→ */
   655→export async function migrateLegacyRenderHash(
   656→  specDir: string,
   657→  skillId: string,
   658→  platform: string
   659→): Promise<boolean> {
   660→  const legacyHashPath = getRenderHashPath(specDir, skillId);
   661→  const platformHashPath = getPlatformRenderHashPath(specDir, skillId, platform);
   662→
   663→  try {
   664→    // Check if platform-specific hash already exists
   665→    await fs.access(platformHashPath);
   666→    return false; // Already migrated
   667→  } catch {
   668→    // Platform-specific doesn't exist, check for legacy
   669→  }
   670→
   671→  try {
   672→    const legacyHash = await fs.readFile(legacyHashPath, "utf-8");
   673→    // Write to platform-specific location
   674→    await writePlatformRenderHash(specDir, skillId, platform, legacyHash.trim());
   675→    return true; // Migrated successfully
   676→  } catch {
   677→    return false; // No legacy hash to migrate
   678→  }
   679→}
   680→
   681→/**
   682→ * Write the render hash for a skill on a specific platform
   683→ * AC: @platform-renderer-trait ac-6 - Store per-platform hash in .render-hash-<platform>
   684→ */
   685→export async function writePlatformRenderHash(
   686→  specDir: string,
   687→  skillId: string,
   688→  platform: string,
   689→  hash: string
   690→): Promise<void> {
   691→  const hashPath = getPlatformRenderHashPath(specDir, skillId, platform);
   692→  await fs.mkdir(path.dirname(hashPath), { recursive: true });
   693→  await fs.writeFile(hashPath, hash + "\n", "utf-8");
   694→}
   695→
   696→/**
   697→ * Check if a rendered skill has drifted from its last render for a specific platform
   698→ * AC: @platform-renderer-trait ac-6 - Platform-specific drift detection
   699→ */
   700→export async function checkPlatformSkillDrift(
   701→  specDir: string,
   702→  projectRoot: string,
   703→  skillId: string,
   704→  platform: string,
   705→  outputDir?: string,
   706→  origin?: string
   707→): Promise<DriftStatus> {
   708→  // Core skills on claude-code are plugin-provided, not locally rendered
   709→  if (origin === "core" && platform === "claude-code" && !outputDir) {
   710→    return "plugin-provided";
   711→  }
   712→
   713→  // Determine the rendered path
   714→  let renderedPath: string;
   715→  if (outputDir) {
   716→    const subdir = getSkillSubdir(skillId, origin, platform);
   717→    renderedPath = path.join(projectRoot, outputDir, subdir, "SKILL.md");
   718→  } else {
   719→    const platformOutputDir = getPlatformDefaultOutputDir(platform);
   720→    const subdir = getSkillSubdir(skillId, origin, platform);
   721→    renderedPath = path.join(projectRoot, platformOutputDir, subdir, "SKILL.md");
   722→  }
   723→
   724→  // Check if rendered file exists
   725→  let renderedContent: string;
   726→  try {
   727→    renderedContent = await fs.readFile(renderedPath, "utf-8");
   728→  } catch {
   729→    return "not-rendered";
   730→  }
   731→
   732→  // AC: @claude-code-renderer-extended ac-6 - Migrate legacy hash if needed
   733→  await migrateLegacyRenderHash(specDir, skillId, platform);
   734→
   735→  // Get stored hash (try platform-specific first, then fall back to legacy)
   736→  const storedHash = await readPlatformRenderHash(specDir, skillId, platform);
   737→  if (!storedHash) {
   738→    return "no-hash";
   739→  }
   740→
   741→  // Compare hashes
   742→  const currentHash = computeContentHash(renderedContent);
   743→  return currentHash === storedHash ? "in-sync" : "drifted";
   744→}
   745→
   746→/**
   747→ * Get the default output directory for a platform
   748→ */
   749→function getPlatformDefaultOutputDir(platform: string): string {
   750→  switch (platform) {
   751→    case "claude-code":
   752→      return ".claude/skills";
   753→    case "codex":
   754→      return ".agents/skills";
   755→    default:
   756→      return `.${platform}/skills`;
   757→  }
   758→}
   759→
   760→// ============================================================================
   761→// Base Render Function
   762→// AC: @skill-module-split ac-2 - Shared render logic extracted into base function
   763→// ============================================================================
   764→
   765→/**
   766→ * Options for the base render function
   767→ */
   768→interface BaseRenderConfig {
   769→  /** Platform name (e.g., "claude-code", "codex") */
   770→  platform: string;
   771→  /** Generate the YAML frontmatter for this skill */
   772→  generateFrontmatter: (skill: LoadedSkill) => string;
   773→  /** Optional: generate additional hash content (e.g., sidecar files) */
   774→  getAdditionalHashContent?: (renderedContent: string) => string | null;
   775→  /** Optional: write additional files after SKILL.md (e.g., sidecar) */
   776→  writeAdditionalFiles?: (
   777→    ctx: KspecContext,
   778→    skill: LoadedSkill,
   779→    targetDir: string,
   780→    dryRun: boolean
   781→  ) => Promise<{ paths: string[]; contentChanged: boolean }>;
   782→  /** Optional: additional hash computation for drift check */
   783→  getAdditionalDriftContent?: (skillDir: string) => Promise<string | null>;
   784→  /** If true, also write legacy .render-hash for backward compatibility */
   785→  writeLegacyHash?: boolean;
   786→}
   787→
   788→/**
   789→ * Base render function that handles shared logic across all platform renderers:
   790→ * content loading, frontmatter stripping, idempotency check, file write,
   791→ * hash storage, and supporting directory copy.
   792→ *
   793→ * AC: @skill-module-split ac-2 - Shared render logic in base function
   794→ * AC: @platform-renderer-trait ac-1 through ac-6
   795→ */
   796→export async function renderSkillBase(
   797→  ctx: KspecContext,
   798→  projectRoot: string,
   799→  skill: LoadedSkill,
   800→  options: PlatformRenderOptions,
   801→  config: BaseRenderConfig,
   802→  defaultOutputDir: string,
   803→  skillSubdir?: string
   804→): Promise<PlatformRenderResult> {
   805→  const dryRun = options.dryRun ?? false;
   806→  const storeHash = options.storeHash ?? false;
   807→  const outputDir = options.outputDir || defaultOutputDir;
   808→
   809→  const targetDir = path.join(projectRoot, outputDir, skillSubdir || skill.id);
   810→  const targetSkillMd = path.join(targetDir, "SKILL.md");
   811→  const paths: string[] = [];
   812→
   813→  // Load source content
   814→  const sourceContent = await loadSkillContent(ctx, skill);
   815→
   816→  // Generate platform-specific frontmatter
   817→  const frontmatter = config.generateFrontmatter(skill);
   818→
   819→  // Build rendered content: frontmatter + marker + body
   820→  let renderedContent: string;
   821→  if (!sourceContent) {
   822→    renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
   823→  } else {
   824→    const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
   825→    const contentWithoutFrontmatter = frontmatterMatch
   826→      ? sourceContent.slice(frontmatterMatch[0].length)
   827→      : sourceContent;
   828→    renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
   829→  }
   830→
   831→  // Idempotency check
   832→  let targetExists = false;
   833→  let targetContent = "";
   834→  try {
   835→    targetContent = await fs.readFile(targetSkillMd, "utf-8");
   836→    targetExists = true;
   837→  } catch {
   838→    // Target doesn't exist
   839→  }
   840→
   841→  let action: "created" | "updated" | "unchanged" | "skipped";
   842→  if (!targetExists) {
   843→    action = "created";
   844→  } else if (contentsEqual(renderedContent, targetContent)) {
   845→    action = "unchanged";
   846→  } else {
   847→    action = "updated";
   848→  }
   849→
   850→  // Write SKILL.md
   851→  if (!dryRun && action !== "unchanged") {
   852→    await fs.mkdir(targetDir, { recursive: true });
   853→    await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
   854→  }
   855→  paths.push(targetSkillMd);
   856→
   857→  // Write additional files (e.g., sidecar for codex)
   858→  let additionalContentChanged = false;
   859→  if (config.writeAdditionalFiles) {
   860→    const additional = await config.writeAdditionalFiles(ctx, skill, targetDir, dryRun);
   861→    paths.push(...additional.paths);
   862→    additionalContentChanged = additional.contentChanged;
   863→  }
   864→
   865→  // Store per-platform hash
   866→  const contentChanged = action !== "unchanged" || additionalContentChanged;
   867→  if (!dryRun && storeHash && contentChanged) {
   868→    // Get additional content for hash (e.g., sidecar content)
   869→    const additionalHashContent = config.getAdditionalHashContent?.(renderedContent);
   870→    const hashContent = additionalHashContent
   871→      ? renderedContent + "\n" + additionalHashContent
   872→      : renderedContent;
   873→    const hash = computeContentHash(hashContent);
   874→    await writePlatformRenderHash(ctx.specDir, skill.id, config.platform, hash);
   875→    if (config.writeLegacyHash) {
   876→      await writeRenderHash(ctx.specDir, skill.id, hash);
   877→    }
   878→  }
   879→
   880→  // Copy supporting directories
   881→  const sourceSkillDir = path.join(ctx.specDir, "skills", skill.id);
   882→  const supportingDirsAction = await copySupportingDirectories(
   883→    sourceSkillDir,
   884→    targetDir,
   885→    dryRun
   886→  );
   887→
   888→  for (const [dirName, dirAction] of Object.entries(supportingDirsAction)) {
   889→    if (dirAction !== "skipped") {
   890→      paths.push(path.join(targetDir, dirName));
   891→    }
   892→  }
   893→
   894→  return {
   895→    id: skill.id,
   896→    platform: config.platform,
   897→    action,
   898→    paths,
   899→    supportingDirsAction,
   900→  };
   901→}
   902→
   903→// ============================================================================
   904→// Claude Code Renderer (implements PlatformRenderer)
   905→// ============================================================================
   906→
   907→/**
   908→ * Migrate old plugin paths for core skills.
   909→ * Cleans up old render targets (.claude/skills/<id>/, .claude/skills/kspec/<id>/,
   910→ * .claude/plugins/kspec/) when kspec-managed marker is present.
   911→ * Called from renderer and from CLI after marketplace registration.
   912→ */
   913→export async function migrateOldPluginPaths(projectRoot: string, skillId: string): Promise<void> {
   914→  const defaultOutputDir = ".claude/skills";
   915→
   916→  // Old flat path: .claude/skills/<id>/ (pre-#440)
   917→  const oldFlatPath = path.join(projectRoot, defaultOutputDir, skillId, "SKILL.md");
   918→  try {
   919→    const content = await fs.readFile(oldFlatPath, "utf-8");
   920→    if (content.includes(KSPEC_MANAGED_MARKER)) {
   921→      await fs.rm(path.join(projectRoot, defaultOutputDir, skillId), { recursive: true, force: true });
   922→    }
   923→  } catch {
   924→    // Old path doesn't exist
   925→  }
   926→
   927→  // Old namespaced path: .claude/skills/kspec/<id>/ (PR #440)
   928→  const oldNamespacedPath = path.join(projectRoot, defaultOutputDir, "kspec", skillId, "SKILL.md");
   929→  try {
   930→    const content = await fs.readFile(oldNamespacedPath, "utf-8");
   931→    if (content.includes(KSPEC_MANAGED_MARKER)) {
   932→      await fs.rm(path.join(projectRoot, defaultOutputDir, "kspec", skillId), { recursive: true, force: true });
   933→    }
   934→  } catch {
   935→    // Old path doesn't exist
   936→  }
   937→
   938→  // Old monolithic: .claude/skills/kspec/SKILL.md
   939→  const oldMonolithicPath = path.join(projectRoot, defaultOutputDir, "kspec", "SKILL.md");
   940→  try {
   941→    const content = await fs.readFile(oldMonolithicPath, "utf-8");
   942→    if (content.includes(KSPEC_MANAGED_MARKER)) {
   943→      await fs.rm(oldMonolithicPath, { force: true });
   944→    }
   945→  } catch {
   946→    // Old path doesn't exist
   947→  }
   948→
   949→  // Old plugin render target: .claude/plugins/kspec/skills/<id>/
   950→  const oldPluginPath = path.join(projectRoot, PLUGIN_SKILLS_DIR, skillId, "SKILL.md");
   951→  try {
   952→    const content = await fs.readFile(oldPluginPath, "utf-8");
   953→    if (content.includes(KSPEC_MANAGED_MARKER)) {
   954→      await fs.rm(path.join(projectRoot, PLUGIN_SKILLS_DIR, skillId), { recursive: true, force: true });
   955→    }
   956→  } catch {
   957→    // Old path doesn't exist
   958→  }
   959→
   960→  // Clean up empty parent directories
   961→  for (const dir of [
   962→    path.join(projectRoot, defaultOutputDir, "kspec"),
   963→    path.join(projectRoot, PLUGIN_SKILLS_DIR),
   964→    path.join(projectRoot, PLUGIN_DIR),
   965→  ]) {
   966→    try {
   967→      const entries = await fs.readdir(dir);
   968→      if (entries.length === 0) {
   969→        await fs.rm(dir, { recursive: true, force: true });
   970→      }
   971→    } catch {
   972→      // Dir doesn't exist or not empty
   973→    }
   974→  }
   975→}
   976→
   977→/**
   978→ * Claude Code platform renderer implementation
   979→ * AC: @platform-renderer-trait ac-1 through ac-6
   980→ */
   981→export const claudeCodeRenderer: PlatformRenderer = {
   982→  platform: "claude-code",
   983→  defaultOutputDir: ".claude/skills",
   984→
   985→  async render(
   986→    ctx: KspecContext,
   987→    projectRoot: string,
   988→    skill: LoadedSkill,
   989→    options: PlatformRenderOptions = {}
   990→  ): Promise<PlatformRenderResult> {
   991→    const dryRun = options.dryRun ?? false;
   992→
   993→    // AC: @skill-rendering ac-7 - Core skills are provided by the npm package plugin
   994→    // directory. Skip local rendering; migration cleanup is handled separately.
   995→    if (skill.origin === "core" && !options.outputDir) {
   996→      // Run migration cleanup for old paths
   997→      if (!dryRun) {
   998→        await migrateOldPluginPaths(projectRoot, skill.id);
   999→      }
  1000→
  1001→      return {
  1002→        id: skill.id,
  1003→        platform: this.platform,
  1004→        action: "skipped",
  1005→        paths: [],
  1006→        skipReason: "core skill provided by npm package plugin",
  1007→        skipCode: "plugin-provided",
  1008→      };
  1009→    }
  1010→
  1011→    // Project/local skills render to .claude/skills/
  1012→    const result = await renderSkillBase(ctx, projectRoot, skill, options, {
  1013→      platform: this.platform,
  1014→      generateFrontmatter,
  1015→      writeLegacyHash: true,
  1016→    }, this.defaultOutputDir, skill.id);
  1017→
  1018→    return result;
  1019→  },
  1020→
  1021→  async checkDrift(
  1022→    specDir: string,
  1023→    projectRoot: string,
  1024→    skillId: string,
  1025→    options?: { outputDir?: string; origin?: string }
  1026→  ): Promise<DriftStatus> {
  1027→    return checkPlatformSkillDrift(
  1028→      specDir,
  1029→      projectRoot,
  1030→      skillId,
  1031→      this.platform,
  1032→      options?.outputDir,
  1033→      options?.origin
  1034→    );
  1035→  },
  1036→};
  1037→
  1038→// ============================================================================
  1039→// Codex Renderer (implements PlatformRenderer)
  1040→// AC: @codex-renderer ac-1 through ac-6
  1041→// ============================================================================
  1042→
  1043→/**
  1044→ * Generate minimal YAML frontmatter for Codex (name + description only)
  1045→ * AC: @codex-renderer ac-1 - Codex frontmatter contains only name and description
  1046→ */
  1047→function generateCodexFrontmatter(skill: LoadedSkill): string {
  1048→  const frontmatter: Record<string, unknown> = {
  1049→    name: skill.id,
  1050→    description: skill.description || skill.name,
  1051→  };
  1052→  return `---\n${yaml.stringify(frontmatter).trim()}\n---`;
  1053→}
  1054→
  1055→/**
  1056→ * Generate Codex sidecar openai.yaml content from platform_config.codex
  1057→ * AC: @codex-renderer ac-2 - sidecar agents/openai.yaml with Codex config fields
  1058→ */
  1059→function generateCodexSidecarYaml(skill: LoadedSkill): string | null {
  1060→  const codexConfig = skill.platform_config?.codex;
  1061→  if (!codexConfig) {
  1062→    return null;
  1063→  }
  1064→
  1065→  // Build the sidecar structure per Codex docs
  1066→  const sidecar: Record<string, unknown> = {};
  1067→
  1068→  // Interface section (display_name, short_description, icons, colors)
  1069→  const interfaceSection: Record<string, unknown> = {};
  1070→  if (codexConfig.display_name) {
  1071→    interfaceSection.display_name = codexConfig.display_name;
  1072→  }
  1073→  if (codexConfig.short_description) {
  1074→    interfaceSection.short_description = codexConfig.short_description;
  1075→  }
  1076→  if (codexConfig.icon_small) {
  1077→    interfaceSection.icon_small = codexConfig.icon_small;
  1078→  }
  1079→  if (codexConfig.icon_large) {
  1080→    interfaceSection.icon_large = codexConfig.icon_large;
  1081→  }
  1082→  if (codexConfig.brand_color) {
  1083→    interfaceSection.brand_color = codexConfig.brand_color;
  1084→  }
  1085→  if (codexConfig.default_prompt) {
  1086→    interfaceSection.default_prompt = codexConfig.default_prompt;
  1087→  }
  1088→  if (Object.keys(interfaceSection).length > 0) {
  1089→    sidecar.interface = interfaceSection;
  1090→  }
  1091→
  1092→  // Policy section (allow_implicit_invocation)
  1093→  if (codexConfig.allow_implicit_invocation !== undefined) {
  1094→    sidecar.policy = {
  1095→      allow_implicit_invocation: codexConfig.allow_implicit_invocation,
  1096→    };
  1097→  }
  1098→
  1099→  // Only return content if there's something to write
  1100→  if (Object.keys(sidecar).length === 0) {
  1101→    return null;
  1102→  }
  1103→
  1104→  return yaml.stringify(sidecar);
  1105→}
  1106→
  1107→/**
  1108→ * Codex platform renderer implementation
  1109→ * AC: @codex-renderer ac-1 - Creates .agents/skills/<id>/SKILL.md with minimal frontmatter
  1110→ * AC: @codex-renderer ac-2 - Creates sidecar agents/openai.yaml when platform_config.codex exists
  1111→ * AC: @codex-renderer ac-3 - No sidecar created when no platform_config.codex
  1112→ * AC: @codex-renderer ac-4 - Rendered file contains <!-- kspec-managed --> marker
  1113→ * AC: @codex-renderer ac-5 - Supporting directories copied to output
  1114→ * AC: @codex-renderer ac-6 - Hash written to .render-hash-codex
  1115→ */
  1116→export const codexRenderer: PlatformRenderer = {
  1117→  platform: "codex",
  1118→  defaultOutputDir: ".agents/skills",
  1119→
  1120→  async render(
  1121→    ctx: KspecContext,
  1122→    projectRoot: string,
  1123→    skill: LoadedSkill,
  1124→    options: PlatformRenderOptions = {}
  1125→  ): Promise<PlatformRenderResult> {
  1126→    // Pre-compute sidecar content so it's available for both hash and write
  1127→    const sidecarContent = generateCodexSidecarYaml(skill);
  1128→
  1129→    const codexSubdir = getSkillSubdir(skill.id, skill.origin, "codex");
  1130→
  1131→    return renderSkillBase(ctx, projectRoot, skill, options, {
  1132→      platform: this.platform,
  1133→      generateFrontmatter: generateCodexFrontmatter,
  1134→
  1135→      // AC: @skill-drift-detection-improvements ac-1 - Include sidecar in hash
  1136→      getAdditionalHashContent: () => sidecarContent,
  1137→
  1138→      // AC: @codex-renderer ac-2, ac-3 - Write sidecar agents/openai.yaml
  1139→      writeAdditionalFiles: async (_ctx, _skill, targetDir, dryRun) => {
  1140→        const paths: string[] = [];
  1141→        let contentChanged = false;
  1142→
  1143→        if (sidecarContent) {
  1144→          const sidecarDir = path.join(targetDir, "agents");
  1145→          const sidecarPath = path.join(sidecarDir, "openai.yaml");
  1146→
  1147→          // Check existing sidecar
  1148→          let sidecarExists = false;
  1149→          let existingSidecar = "";
  1150→          try {
  1151→            existingSidecar = await fs.readFile(sidecarPath, "utf-8");
  1152→            sidecarExists = true;
  1153→          } catch {
  1154→            // Doesn't exist
  1155→          }
  1156→
  1157→          const sidecarAction = !sidecarExists
  1158→            ? "created"
  1159→            : contentsEqual(sidecarContent, existingSidecar)
  1160→              ? "unchanged"
  1161→              : "updated";
  1162→
  1163→          if (!dryRun && sidecarAction !== "unchanged") {
  1164→            await fs.mkdir(sidecarDir, { recursive: true });
  1165→            await fs.writeFile(sidecarPath, sidecarContent, "utf-8");
  1166→          }
  1167→
  1168→          paths.push(sidecarPath);
  1169→          contentChanged = sidecarAction !== "unchanged";
  1170→        }
  1171→
  1172→        return { paths, contentChanged };
  1173→      },
  1174→    }, this.defaultOutputDir, codexSubdir);
  1175→  },
  1176→
  1177→  // AC: @skill-drift-detection-improvements ac-1 - Include sidecar content in drift hash
  1178→  async checkDrift(
  1179→    specDir: string,
  1180→    projectRoot: string,
  1181→    skillId: string,
  1182→    options?: { outputDir?: string; origin?: string }
  1183→  ): Promise<DriftStatus> {
  1184→    const codexSubdir = getSkillSubdir(skillId, options?.origin, "codex");
  1185→    const platformOutputDir = options?.outputDir || this.defaultOutputDir;
  1186→    const skillDir = path.join(projectRoot, platformOutputDir, codexSubdir);
  1187→    const renderedPath = path.join(skillDir, "SKILL.md");
  1188→
  1189→    // Check if rendered file exists
  1190→    let renderedContent: string;
  1191→    try {
  1192→      renderedContent = await fs.readFile(renderedPath, "utf-8");
  1193→    } catch {
  1194→      return "not-rendered";
  1195→    }
  1196→
  1197→    // Migrate legacy hash if needed
  1198→    await migrateLegacyRenderHash(specDir, skillId, this.platform);
  1199→
  1200→    // Get stored hash
  1201→    const storedHash = await readPlatformRenderHash(specDir, skillId, this.platform);
  1202→    if (!storedHash) {
  1203→      return "no-hash";
  1204→    }
  1205→
  1206→    // Read sidecar content if it exists
  1207→    const sidecarPath = path.join(skillDir, "agents", "openai.yaml");
  1208→    let sidecarContent: string | null = null;
  1209→    try {
  1210→      sidecarContent = await fs.readFile(sidecarPath, "utf-8");
  1211→    } catch {
  1212→      // No sidecar file
  1213→    }
  1214→
  1215→    // Combine content for hash (must match render-time computation)
  1216→    const combinedContent = sidecarContent
  1217→      ? renderedContent + "\n" + sidecarContent
  1218→      : renderedContent;
  1219→    const currentHash = computeContentHash(combinedContent);
  1220→    return currentHash === storedHash ? "in-sync" : "drifted";
  1221→  },
  1222→};
  1223→
  1224→// ============================================================================
  1225→// Renderer Registry
  1226→// ============================================================================
  1227→
  1228→/** Map of platform name to renderer implementation */
  1229→const rendererRegistry: Map<string, PlatformRenderer> = new Map([
  1230→  ["claude-code", claudeCodeRenderer],
  1231→  ["codex", codexRenderer],
  1232→]);
  1233→
  1234→/**
  1235→ * Get the renderer for a specific platform
  1236→ */
  1237→export function getRenderer(platform: string): PlatformRenderer | undefined {
  1238→  return rendererRegistry.get(platform);
  1239→}
  1240→
  1241→/**
  1242→ * Get all registered renderers
  1243→ */
  1244→export function getAllRenderers(): PlatformRenderer[] {
  1245→  return Array.from(rendererRegistry.values());
  1246→}
  1247→
  1248→/**
  1249→ * Register a new platform renderer
  1250→ */
  1251→export function registerRenderer(renderer: PlatformRenderer): void {
  1252→  rendererRegistry.set(renderer.platform, renderer);
  1253→}
  1254→