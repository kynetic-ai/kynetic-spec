  1961→
  1962→  // kspec task review <ref>
  1963→  task
  1964→    .command("review <ref>")
  1965→    .description(
  1966→      "Get task context for review (task details, spec, ACs, git diff)",
  1967→    )
  1968→    .action(async (ref: string) => {
  1969→      try {
  1970→        const ctx = await initContext();
  1971→        const tasks = await loadAllTasks(ctx);
  1972→        const items = await loadAllItems(ctx);
  1973→        const index = new ReferenceIndex(tasks, items);
  1974→        const foundTask = resolveTaskRef(ref, tasks, index);
  1975→
  1976→        // Import getDiffSince from utils
  1977→        const { getDiffSince } = await import("../../utils/index.js");
  1978→
  1979→        // Gather review context
  1980→        const reviewContext: {
  1981→          task: typeof foundTask;
  1982→          spec: LoadedSpecItem | null;
  1983→          diff: string | null;
  1984→          started_at: string | null;
  1985→          testCoverage?: { covered: string[]; uncovered: string[] };
  1986→        } = {
  1987→          task: foundTask,
  1988→          spec: null,
  1989→          diff: null,
  1990→          started_at: foundTask.started_at || null,
  1991→        };
  1992→
  1993→        // Get spec item if task has spec_ref
  1994→        if (foundTask.spec_ref) {
  1995→          const specResult = index.resolve(foundTask.spec_ref);
  1996→          if (specResult.ok) {
  1997→            const specItem = items.find((i) => i._ulid === specResult.ulid);
  1998→            reviewContext.spec = specItem || null;
  1999→
  2000→            // Check test coverage for ACs if spec has them
  2001→            if (
  2002→              specItem?.acceptance_criteria &&
  2003→              specItem.acceptance_criteria.length > 0
  2004→            ) {
  2005→              const coveredACs = await scanTestCoverage(ctx.rootDir);
  2006→              const covered: string[] = [];
  2007→              const uncovered: string[] = [];
  2008→
  2009→              for (const ac of specItem.acceptance_criteria) {
  2010→                // Build possible references
  2011→                const possibleRefs: string[] = [];
  2012→                if (specItem.slugs && specItem.slugs.length > 0) {
  2013→                  possibleRefs.push(`@${specItem.slugs[0]} ${ac.id}`);
  2014→                  possibleRefs.push(`@${specItem.slugs[0]}`);
  2015→                }
  2016→                possibleRefs.push(`@${specItem._ulid.slice(0, 8)} ${ac.id}`);
  2017→                possibleRefs.push(`@${specItem._ulid.slice(0, 8)}`);
  2018→
  2019→                const isCovered = possibleRefs.some((ref) =>
  2020→                  coveredACs.has(ref),
  2021→                );
  2022→                if (isCovered) {
  2023→                  covered.push(ac.id);
  2024→                } else {
  2025→                  uncovered.push(ac.id);
  2026→                }
  2027→              }
  2028→
  2029→              reviewContext.testCoverage = { covered, uncovered };
  2030→            }
  2031→          }
  2032→        }
  2033→
  2034→        // Get git diff since task started
  2035→        if (foundTask.started_at) {
  2036→          const startedDate = new Date(foundTask.started_at);
  2037→          reviewContext.diff = getDiffSince(startedDate, ctx.rootDir);
  2038→        }
  2039→
  2040→        output(reviewContext, () => {
  2041→          console.log("=".repeat(60));
  2042→          console.log("Task Review Context");
  2043→          console.log("=".repeat(60));
  2044→          console.log();
  2045→
  2046→          // Task details
  2047→          console.log("TASK DETAILS");
  2048→          console.log("-".repeat(60));
  2049→          console.log(formatTaskDetails(foundTask, index));
  2050→          console.log();
  2051→
  2052→          // Spec details
  2053→          if (reviewContext.spec) {
  2054→            console.log("LINKED SPEC");
  2055→            console.log("-".repeat(60));
  2056→            console.log(`Title: ${reviewContext.spec.title}`);
  2057→            console.log(`Type: ${reviewContext.spec.type}`);
  2058→            if (reviewContext.spec.description) {
  2059→              console.log(`\nDescription:\n${reviewContext.spec.description}`);
  2060→            }
  2061→            if (
  2062→              reviewContext.spec.acceptance_criteria &&
  2063→              reviewContext.spec.acceptance_criteria.length > 0
  2064→            ) {
  2065→              console.log(
  2066→                `\nAcceptance Criteria (${reviewContext.spec.acceptance_criteria.length}):`,
  2067→              );
  2068→              for (const ac of reviewContext.spec.acceptance_criteria) {
  2069→                const isCovered = reviewContext.testCoverage?.covered.includes(
  2070→                  ac.id,
  2071→                );
  2072→                const coverageMarker = isCovered
  2073→                  ? chalk.green("✓")
  2074→                  : chalk.yellow("○");
  2075→                console.log(`  ${coverageMarker} [${ac.id}]`);
  2076→                console.log(`    Given: ${ac.given}`);
  2077→                console.log(`    When: ${ac.when}`);
  2078→                console.log(`    Then: ${ac.then}`);
  2079→              }
  2080→
  2081→              // Test coverage summary
  2082→              if (reviewContext.testCoverage) {
  2083→                const { covered, uncovered } = reviewContext.testCoverage;
  2084→                console.log();
  2085→                if (uncovered.length === 0) {
  2086→                  console.log(
  2087→                    chalk.green(
  2088→                      `  ✓ All ${covered.length} AC(s) have test coverage`,
  2089→                    ),
  2090→                  );
  2091→                } else {
  2092→                  console.log(
  2093→                    chalk.yellow(
  2094→                      `  Test coverage: ${covered.length}/${covered.length + uncovered.length} ACs covered`,
  2095→                    ),
  2096→                  );
  2097→                  console.log(
  2098→                    chalk.yellow(
  2099→                      `  Missing coverage for: ${uncovered.join(", ")}`,
  2100→                    ),
  2101→                  );
  2102→                }
  2103→              }
  2104→            }
  2105→            console.log();
  2106→          }
  2107→
  2108→          // Git diff
  2109→          if (reviewContext.diff) {
  2110→            console.log("CHANGES SINCE TASK STARTED");
  2111→            console.log("-".repeat(60));
  2112→            console.log(`Started at: ${foundTask.started_at}`);
  2113→            console.log();
  2114→            console.log(reviewContext.diff);
  2115→            console.log();
  2116→          } else if (foundTask.started_at) {
  2117→            console.log("CHANGES SINCE TASK STARTED");
  2118→            console.log("-".repeat(60));
  2119→            console.log(`Started at: ${foundTask.started_at}`);
  2120→            console.log("No changes detected");
  2121→            console.log();
  2122→          }
  2123→
  2124→          console.log("=".repeat(60));
  2125→          console.log("Review Checklist:");
  2126→          console.log("- Does the implementation match the task description?");
  2127→          if (reviewContext.spec) {
  2128→            console.log("- Are all acceptance criteria covered?");
  2129→            console.log("- Is test coverage adequate?");
  2130→          }
  2131→          console.log("- Are there any gaps or issues?");
  2132→          console.log("=".repeat(60));
  2133→        });
  2134→      } catch (err) {
  2135→        error("Failed to generate review context", err);
  2136→        process.exit(EXIT_CODES.ERROR);
  2137→      }
  2138→    });
  2139→
  2140→  // kspec task todos <ref>
  2141→  task
