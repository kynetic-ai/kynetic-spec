     1→import * as path from "node:path";
     2→import chalk from "chalk";
     3→import type { Command } from "commander";
     4→import { markMutating } from "../command-annotations.js";
     5→import {
     6→  checkSlugUniqueness,
     7→  createNote,
     8→  createTask,
     9→  createTodo,
    10→  deleteTask,
    11→  getAuthor,
    12→  initContext,
    13→  type LoadedSpecItem,
    14→  type LoadedTask,
    15→  loadAllItems,
    16→  loadAllTasks,
    17→  ReferenceIndex,
    18→  saveTask,
    19→  scanTestCoverage,
    20→  syncSpecImplementationStatus,
    21→} from "../../parser/index.js";
    22→import { commitIfShadow } from "../../parser/shadow.js";
    23→import type { Task, TaskInput } from "../../schema/index.js";
    24→import { alignmentCheck, errors } from "../../strings/index.js";
    25→import {
    26→  formatCommitGuidance,
    27→  printCommitGuidance,
    28→} from "../../utils/commit.js";
    29→import { executeBatchOperation, formatBatchOutput } from "../batch.js";
    30→import { EXIT_CODES } from "../exit-codes.js";
    31→import { parseTagsArray } from "../parse-utils.js";
    32→import {
    33→  annotateNotesWithSuperseded,
    34→  error,
    35→  formatTaskDetails,
    36→  info,
    37→  isJsonMode,
    38→  output,
    39→  success,
    40→  warn,
