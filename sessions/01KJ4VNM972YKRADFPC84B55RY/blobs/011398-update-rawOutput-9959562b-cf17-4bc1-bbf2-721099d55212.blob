  1894→        );
  1895→        success(`Added note to task: ${index.shortUlid(updatedTask._ulid)}`, {
  1896→          note,
  1897→        });
  1898→
  1899→        // Proactive alignment guidance for tasks with spec_ref
  1900→        if (foundTask.spec_ref) {
  1901→          console.log("");
  1902→          console.log(alignmentCheck.header);
  1903→          console.log(alignmentCheck.beyondSpec);
  1904→          console.log(alignmentCheck.updateSpec(foundTask.spec_ref));
  1905→          console.log(alignmentCheck.addAC);
  1906→
  1907→          // Check if linked spec has acceptance criteria and remind about test coverage
  1908→          const specResult = index.resolve(foundTask.spec_ref);
  1909→          if (specResult.ok && specResult.item) {
  1910→            const specItem = specResult.item as {
  1911→              acceptance_criteria?: unknown[];
  1912→            };
  1913→            if (
  1914→              specItem.acceptance_criteria &&
  1915→              specItem.acceptance_criteria.length > 0
  1916→            ) {
  1917→              console.log("");
  1918→              console.log(
  1919→                alignmentCheck.testCoverage(
  1920→                  specItem.acceptance_criteria.length,
  1921→                ),
  1922→              );
  1923→            }
  1924→          }
  1925→        }
  1926→      } catch (err) {
  1927→        error(errors.failures.addNote, err);
  1928→        process.exit(EXIT_CODES.ERROR);
  1929→      }
  1930→    });
