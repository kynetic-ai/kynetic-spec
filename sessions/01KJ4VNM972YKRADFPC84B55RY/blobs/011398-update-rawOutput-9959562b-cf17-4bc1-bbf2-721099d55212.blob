  2170→  // Create subcommand group for todo operations
  2171→  const todoCmd = task.command("todo").description("Manage task todos");
  2172→
  2173→  // kspec task todo add <ref> <text>
  2174→  markMutating(todoCmd.command("add <ref> <text>"))
  2175→    .description("Add a todo to a task")
  2176→    .option("--author <author>", "Todo author")
  2177→    .action(async (ref: string, text: string, options) => {
  2178→      try {
  2179→        const ctx = await initContext();
  2180→        const tasks = await loadAllTasks(ctx);
  2181→        const items = await loadAllItems(ctx);
  2182→        const index = new ReferenceIndex(tasks, items);
  2183→        const foundTask = resolveTaskRef(ref, tasks, index);
  2184→
  2185→        // Calculate next ID (max existing + 1, or 1 if none)
  2186→        const nextId =
  2187→          foundTask.todos.length > 0
  2188→            ? Math.max(...foundTask.todos.map((t) => t.id)) + 1
  2189→            : 1;
  2190→
  2191→        const todo = createTodo(nextId, text, options.author);
  2192→
  2193→        const updatedTask: Task = {
  2194→          ...foundTask,
  2195→          todos: [...foundTask.todos, todo],
  2196→        };
  2197→
  2198→        await saveTask(ctx, updatedTask);
  2199→        await commitIfShadow(
  2200→          ctx.shadow,
  2201→          "task-note",
  2202→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  2203→        );
  2204→        success(
  2205→          `Added todo #${todo.id} to task: ${index.shortUlid(updatedTask._ulid)}`,
  2206→          { todo },
  2207→        );
  2208→      } catch (err) {
  2209→        error(errors.failures.addTodo, err);
  2210→        process.exit(EXIT_CODES.ERROR);
  2211→      }
  2212→    });
  2213→
  2214→  // kspec task todo done <ref> <id>
  2215→  markMutating(todoCmd.command("done <ref> <id>"))
  2216→    .description("Mark a todo as done")
  2217→    .action(async (ref: string, idStr: string) => {
  2218→      try {
  2219→        const ctx = await initContext();
  2220→        const tasks = await loadAllTasks(ctx);
  2221→        const items = await loadAllItems(ctx);
  2222→        const index = new ReferenceIndex(tasks, items);
  2223→        const foundTask = resolveTaskRef(ref, tasks, index);
  2224→
  2225→        const id = parseInt(idStr, 10);
  2226→        if (Number.isNaN(id)) {
  2227→          error(errors.todo.invalidId(idStr));
  2228→          process.exit(EXIT_CODES.USAGE_ERROR);
  2229→        }
  2230→
  2231→        const todoIndex = foundTask.todos.findIndex((t) => t.id === id);
  2232→        if (todoIndex === -1) {
  2233→          error(errors.todo.notFound(id));
  2234→          process.exit(EXIT_CODES.NOT_FOUND);
  2235→        }
  2236→
  2237→        if (foundTask.todos[todoIndex].done) {
  2238→          warn(`Todo #${id} is already done`);
  2239→          return;
  2240→        }
  2241→
  2242→        const updatedTodos = [...foundTask.todos];
  2243→        updatedTodos[todoIndex] = {
  2244→          ...updatedTodos[todoIndex],
  2245→          done: true,
  2246→          done_at: new Date().toISOString(),
  2247→        };
  2248→
  2249→        const updatedTask: Task = {
  2250→          ...foundTask,
  2251→          todos: updatedTodos,
  2252→        };
  2253→
  2254→        await saveTask(ctx, updatedTask);
  2255→        await commitIfShadow(
  2256→          ctx.shadow,
  2257→          "task-note",
  2258→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  2259→        );
  2260→        success(`Marked todo #${id} as done`, {
  2261→          todo: updatedTodos[todoIndex],
  2262→        });
  2263→      } catch (err) {
  2264→        error(errors.failures.markTodoDone, err);
  2265→        process.exit(EXIT_CODES.ERROR);
  2266→      }
  2267→    });
  2268→
  2269→  // kspec task todo undone <ref> <id>
  2270→  markMutating(todoCmd.command("undone <ref> <id>"))
  2271→    .description("Mark a todo as not done")
  2272→    .action(async (ref: string, idStr: string) => {
  2273→      try {
  2274→        const ctx = await initContext();
  2275→        const tasks = await loadAllTasks(ctx);
  2276→        const items = await loadAllItems(ctx);
  2277→        const index = new ReferenceIndex(tasks, items);
  2278→        const foundTask = resolveTaskRef(ref, tasks, index);
  2279→
  2280→        const id = parseInt(idStr, 10);
  2281→        if (Number.isNaN(id)) {
  2282→          error(errors.todo.invalidId(idStr));
  2283→          process.exit(EXIT_CODES.USAGE_ERROR);
  2284→        }
  2285→
  2286→        const todoIndex = foundTask.todos.findIndex((t) => t.id === id);
  2287→        if (todoIndex === -1) {
  2288→          error(errors.todo.notFound(id));
  2289→          process.exit(EXIT_CODES.NOT_FOUND);
  2290→        }
  2291→
  2292→        if (!foundTask.todos[todoIndex].done) {
  2293→          warn(`Todo #${id} is not done`);
  2294→          return;
  2295→        }
  2296→
  2297→        const updatedTodos = [...foundTask.todos];
  2298→        updatedTodos[todoIndex] = {
  2299→          ...updatedTodos[todoIndex],
  2300→          done: false,
  2301→          done_at: undefined,
  2302→        };
  2303→
  2304→        const updatedTask: Task = {
  2305→          ...foundTask,
  2306→          todos: updatedTodos,
  2307→        };
  2308→
  2309→        await saveTask(ctx, updatedTask);
  2310→        await commitIfShadow(
  2311→          ctx.shadow,
  2312→          "task-note",
  2313→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  2314→        );
  2315→        success(`Marked todo #${id} as not done`, {
  2316→          todo: updatedTodos[todoIndex],
  2317→        });
  2318→      } catch (err) {
  2319→        error(errors.failures.markTodoNotDone, err);
