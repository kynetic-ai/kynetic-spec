    49→
    50→/**
    51→ * Find a task by reference with detailed error reporting.
    52→ * Returns the task or exits with appropriate error.
    53→ */
    54→function resolveTaskRef(
    55→  ref: string,
    56→  tasks: LoadedTask[],
    57→  index: ReferenceIndex,
    58→): LoadedTask {
    59→  const result = index.resolve(ref);
    60→
    61→  if (!result.ok) {
    62→    switch (result.error) {
    63→      case "not_found":
    64→        error(errors.reference.taskNotFound(ref));
    65→        break;
    66→      case "ambiguous":
    67→        error(errors.reference.ambiguous(ref));
    68→        for (const candidate of result.candidates) {
    69→          const task = tasks.find((t) => t._ulid === candidate);
    70→          const slug = task?.slugs[0] || "";
    71→          console.error(
    72→            `  - ${index.shortUlid(candidate)} ${slug ? `(${slug})` : ""}`,
    73→          );
    74→        }
    75→        break;
    76→      case "duplicate_slug":
    77→        error(errors.reference.slugMapsToMultiple(ref));
    78→        for (const candidate of result.candidates) {
    79→          console.error(`  - ${index.shortUlid(candidate)}`);
    80→        }
    81→        break;
    82→    }
    83→    // AC: @cli-exit-codes consistent-usage - NOT_FOUND for missing resources
    84→    process.exit(EXIT_CODES.NOT_FOUND);
    85→  }
    86→
    87→  // Check if it's actually a task
    88→  const task = tasks.find((t) => t._ulid === result.ulid);
    89→  if (!task) {
    90→    error(errors.reference.notTask(ref));
    91→    // AC: @cli-exit-codes consistent-usage - NOT_FOUND for missing resources
    92→    process.exit(EXIT_CODES.NOT_FOUND);
    93→  }
    94→
    95→  return task;
    96→}
    97→
    98→/**
    99→ * Batch-compatible resolver that returns null instead of calling process.exit().
   100→ * Used by executeBatchOperation to handle errors without terminating the process.
   101→ * AC: @multi-ref-batch ac-4, ac-8 - Partial failure handling and ref resolution
   102→ */
   103→function resolveTaskRefForBatch(
   104→  ref: string,
   105→  tasks: LoadedTask[],
   106→  index: ReferenceIndex,
   107→): { task: LoadedTask | null; error?: string } {
   108→  const result = index.resolve(ref);
   109→
   110→  if (!result.ok) {
   111→    let errorMsg: string;
   112→    switch (result.error) {
   113→      case "not_found":
   114→        errorMsg = `Reference "${ref}" not found`;
   115→        break;
   116→      case "ambiguous":
   117→        errorMsg = `Reference "${ref}" is ambiguous (matches ${result.candidates.length} items)`;
   118→        break;
   119→      case "duplicate_slug":
   120→        errorMsg = `Slug "${ref}" maps to multiple items`;
   121→        break;
   122→    }
   123→    return { task: null, error: errorMsg };
   124→  }
   125→
   126→  // Check if it's actually a task
   127→  const task = tasks.find((t) => t._ulid === result.ulid);
   128→  if (!task) {
   129→    return { task: null, error: `Reference "${ref}" is not a task` };
   130→  }
   131→
   132→  return { task };
   133→}
   134→
   135→/**
   136→ * Helper function to update task fields.
   137→ * Used by both single-ref and batch modes of task set.
   138→ * AC: @spec-task-set-batch ac-1, ac-2, ac-4, ac-5
   139→ */
   140→async function setTaskFields(
   141→  foundTask: LoadedTask,
   142→  ctx: any,
   143→  tasks: LoadedTask[],
   144→  items: LoadedSpecItem[],
   145→  _allMetaItems: any[],
   146→  index: ReferenceIndex,
   147→  options: any,
   148→): Promise<{
   149→  success: boolean;
   150→  message?: string;
   151→  error?: string;
   152→  data?: unknown;
   153→}> {
   154→  try {
   155→    // Check slug uniqueness if adding a new slug
   156→    if (options.slug) {
   157→      const slugCheck = checkSlugUniqueness(
   158→        index,
   159→        [options.slug],
   160→        foundTask._ulid,
   161→      );
   162→      if (!slugCheck.ok) {
   163→        return {
   164→          success: false,
   165→          error: `Slug "${slugCheck.slug}" already exists on ${slugCheck.existingUlid}`,
   166→        };
   167→      }
   168→    }
   169→
   170→    // Build updated task with only provided options
   171→    const updatedTask: Task = { ...foundTask };
   172→    const changes: string[] = [];
   173→
   174→    if (options.title) {
   175→      updatedTask.title = options.title;
   176→      changes.push("title");
   177→    }
   178→
   179→    if (options.specRef) {
   180→      // Validate the spec ref exists and is a spec item
   181→      const specResult = index.resolve(options.specRef);
   182→      if (!specResult.ok) {
   183→        return {
   184→          success: false,
   185→          error: errors.reference.specRefNotFound(options.specRef),
   186→        };
   187→      }
   188→      // Check it's not a task
   189→      const isTask = tasks.some((t) => t._ulid === specResult.ulid);
   190→      if (isTask) {
   191→        return {
   192→          success: false,
   193→          error: errors.reference.specRefIsTask(options.specRef),
   194→        };
   195→      }
   196→      updatedTask.spec_ref = options.specRef;
   197→      changes.push("spec_ref");
   198→    }
   199→
   200→    if (options.metaRef) {
   201→      // Validate the meta ref exists and is a meta item
   202→      const metaRefResult = index.resolve(options.metaRef);
   203→      if (!metaRefResult.ok) {
   204→        return {
   205→          success: false,
   206→          error: errors.reference.metaRefNotFound(options.metaRef),
   207→        };
   208→      }
   209→
   210→      // Check if the resolved item is a meta item (not a spec item or task)
   211→      const isTask = tasks.some((t) => t._ulid === metaRefResult.ulid);
   212→      const isSpecItem = items.some((i) => i._ulid === metaRefResult.ulid);
   213→
   214→      if (isTask || isSpecItem) {
   215→        return {
   216→          success: false,
   217→          error: errors.reference.metaRefPointsToSpec(options.metaRef),
   218→        };
   219→      }
   220→
   221→      updatedTask.meta_ref = options.metaRef;
   222→      changes.push("meta_ref");
   223→    }
   224→
   225→    if (options.planRef !== undefined) {
   226→      // Handle 'null' string to clear plan_ref
   227→      if (options.planRef === "null") {
   228→        updatedTask.plan_ref = null;
   229→        changes.push("plan_ref: cleared");
   230→      } else {
   231→        // First check if it's a task or spec item (wrong type)
   232→        const cleanRef = options.planRef.startsWith("@")
   233→          ? options.planRef.slice(1)
   234→          : options.planRef;
   235→
   236→        const isTask = tasks.some(
   237→          (t) =>
   238→            t.slugs.includes(cleanRef) ||
   239→            t._ulid === cleanRef ||
   240→            t._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   241→        );
   242→        const isSpecItem = items.some(
   243→          (i) =>
   244→            i.slugs.includes(cleanRef) ||
   245→            i._ulid === cleanRef ||
   246→            i._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   247→        );
   248→
   249→        if (isTask || isSpecItem) {
   250→          return {
   251→            success: false,
   252→            error: `Reference "${options.planRef}" is not a plan`,
   253→          };
   254→        }
   255→
   256→        // Now check if the plan exists
   257→        const { findPlanByRef } = await import("../../parser/plans.js");
   258→        const plan = await findPlanByRef(ctx, options.planRef);
   259→
   260→        if (!plan) {
   261→          return {
   262→            success: false,
   263→            error: `Plan reference not found: ${options.planRef}`,
   264→          };
   265→        }
   266→
   267→        updatedTask.plan_ref = options.planRef;
   268→        changes.push("plan_ref");
   269→      }
   270→    }
   271→
   272→    if (options.priority) {
   273→      const priorityResult = parseIntOption(options.priority, {
   274→        min: 1,
   275→        max: 5,
   276→        name: "Priority",
   277→      });
   278→      if (!priorityResult.ok) {
   279→        return { success: false, error: priorityResult.error };
   280→      }
   281→      updatedTask.priority = priorityResult.value;
   282→      changes.push("priority");
   283→    }
   284→
   285→    if (options.slug) {
   286→      if (!updatedTask.slugs.includes(options.slug)) {
   287→        updatedTask.slugs = [...updatedTask.slugs, options.slug];
   288→        changes.push("slug");
   289→      }
   290→    }
   291→
   292→    if (options.tag) {
   293→      const parsedTags = parseTagsArray(options.tag);
   294→      const newTags = parsedTags.filter(
   295→        (t: string) => !updatedTask.tags.includes(t),
   296→      );
   297→      if (newTags.length > 0) {
   298→        updatedTask.tags = [...updatedTask.tags, ...newTags];
   299→        changes.push("tags");
   300→      }
   301→    }
   302→
   303→    if (options.dependsOn) {
   304→      // Validate all dependency refs
   305→      for (const depRef of options.dependsOn) {
   306→        const depResult = index.resolve(depRef);
   307→        if (!depResult.ok) {
   308→          return {
   309→            success: false,
   310→            error: errors.reference.depNotFound(depRef),
   311→          };
   312→        }
   313→        // Ensure the dependency is a task, not a spec item
   314→        const isTask = tasks.some((t) => t._ulid === depResult.ulid);
   315→        if (!isTask) {
   316→          return {
   317→            success: false,
   318→            error: `Reference "${depRef}" is not a task`,
   319→          };
   320→        }
   321→      }
   322→      updatedTask.depends_on = options.dependsOn.map((ref: string) =>
   323→        ref.startsWith("@") ? ref : `@${ref}`,
   324→      );
   325→      changes.push("depends_on");
   326→    }
   327→
   328→    // AC: @spec-task-clear-deps ac-1, ac-2 - Clear all dependencies
   329→    if (options.clearDeps) {
   330→      if (foundTask.depends_on.length === 0) {
   331→        // AC: @spec-task-clear-deps ac-2 - No changes needed
   332→        return {
   333→          success: true,
   334→          message: "No changes: task has no dependencies to clear",
   335→        };
   336→      }
   337→      updatedTask.depends_on = [];
   338→      changes.push("depends_on");
   339→
   340→      // Add note documenting the change
   341→      // AC: @task-set ac-author
   342→      const note = createNote(
   343→        `Dependencies cleared (was: ${foundTask.depends_on.join(", ")})`,
   344→        getAuthor(ctx.config?.identity?.author),
   345→      );
   346→      updatedTask.notes = [...updatedTask.notes, note];
   347→    }
   348→
   349→    // AC: @task-automation-eligibility ac-5, ac-11, ac-12, ac-18
   350→    // Handle automation status changes
   351→    // Note: --no-automation sets options.automation to false, so check that first
   352→    if (options.automation === false) {
   353→      // --no-automation flag clears the automation status (AC: ac-12)
   354→      delete updatedTask.automation;
   355→      changes.push("automation");
   356→    } else if (options.automation !== undefined) {
   357→      const automationResult = validateEnumOption(
   358→        options.automation,
   359→        ["eligible", "needs_review", "manual_only"] as const,
   360→        "automation status",
   361→      );
   362→      if (!automationResult.ok) {
   363→        return { success: false, error: automationResult.error };
   364→      }
   365→
   366→      // AC: @task-automation-eligibility ac-18 - require reason for needs_review
   367→      if (options.automation === "needs_review" && !options.reason) {
   368→        return {
   369→          success: false,
   370→          error:
   371→            "Setting automation to needs_review requires --reason flag explaining why",
   372→        };
   373→      }
   374→
   375→      updatedTask.automation = automationResult.value;
   376→      changes.push("automation");
   377→
   378→      // If reason provided, add a note documenting the change
   379→      // AC: @task-set ac-author
   380→      if (options.reason) {
   381→        const note = createNote(
   382→          `Automation status set to ${automationResult.value}: ${options.reason}`,
   383→          getAuthor(ctx.config?.identity?.author),
   384→        );
   385→        updatedTask.notes = [...updatedTask.notes, note];
   386→        changes.push("note");
   387→      }
   388→    }
   389→
   390→    // AC: @spec-task-set-batch ac-4 - Warn on no changes, don't fail
   391→    if (changes.length === 0) {
   392→      return {
   393→        success: true,
   394→        message: "No changes specified",
   395→        data: { task: updatedTask },
   396→      };
   397→    }
   398→
   399→    await saveTask(ctx, updatedTask);
   400→    await commitIfShadow(
   401→      ctx.shadow,
   402→      "task-set",
   403→      foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
   404→      changes.join(", "),
   405→    );
   406→
   407→    return {
   408→      success: true,
   409→      message: `Updated task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(", ")})`,
   410→      data: { task: updatedTask },
   411→    };
   412→  } catch (err) {
   413→    return {
   414→      success: false,
   415→      error: err instanceof Error ? err.message : String(err),
   416→    };
   417→  }
   418→}
   419→
   420→/**
   421→ * Register the 'task' command group (singular - operations on individual tasks)
   422→ */
   423→export function registerTaskCommands(program: Command): void {
   424→  const task = program
   425→    .command("task")
   426→    .description("Operations on individual tasks")
   427→    .allowUnknownOption()
   428→    .allowExcessArguments();
   429→
   430→  // AC: @command-group-default-actions ac-bare-task, ac-unknown-subcommand
   431→  // Default action when no subcommand is given (e.g. `kspec task` or `kspec task --status pending`)
   432→  task.action(async (_options: Record<string, unknown>, cmd: Command) => {
   433→    const { Command: Cmd } = await import("commander");
   434→    const listCmd = addListOptions(new Cmd("_list"));
   435→    listCmd.exitOverride();
   436→    try {
   437→      listCmd.parse(cmd.args, { from: "user" });
   438→    } catch {
   439→      console.error(chalk.gray(`Run 'kspec task --help' to see available subcommands`));
   440→      process.exit(EXIT_CODES.ERROR);
   441→    }
   442→
   443→    // AC: @command-group-default-actions ac-unknown-subcommand
   444→    if (listCmd.args.length > 0) {
   445→      const unknownCmd = listCmd.args[0];
   446→      const subcommandNames = cmd.commands.map((c: Command) => c.name());
   447→      const suggestion = findClosestCommand(unknownCmd, subcommandNames);
   448→      console.error(chalk.red(`error: unknown command 'task ${unknownCmd}'`));
   449→      if (suggestion) {
   450→        console.error(chalk.yellow(`Did you mean: kspec task ${suggestion}?`));
   451→      } else {
   452→        console.error(chalk.gray(`Run 'kspec task --help' to see available subcommands`));
   453→      }
   454→      process.exit(EXIT_CODES.ERROR);
   455→    }
   456→
   457→    // AC: @command-group-default-actions ac-bare-with-options
   458→    await listTasksAction(listCmd.opts());
   459→  });
   460→
   461→  // kspec task list - alias for 'kspec tasks list'
   462→  task
   463→    .command("list")
   464→    .description("List all tasks (alias for 'kspec tasks list')")
   465→    .option("-s, --status <status>", "Filter by status")
   466→    .option("-t, --type <type>", "Filter by type")
   467→    .option("--tag <tag>", "Filter by tag")
   468→    .option("--meta-ref <ref>", "Filter by meta reference")
   469→    .option("-g, --grep <pattern>", "Search content with regex pattern")
   470→    .option("-v, --verbose", "Show more details")
   471→    .option("--full", "Show full details (notes, todos, timestamps)")
   472→    .option("--count", "Show only the count of matching tasks")
   473→    .action(async (options) => {
   474→      await listTasksAction(options);
   475→    });
   476→
   477→  // kspec task get <ref>
   478→  task
   479→    .command("get <ref>")
   480→    .description("Get task details")
   481→    .option("--all", "Show all notes including superseded ones")
   482→    .action(async (ref: string, options: { all?: boolean }) => {
   483→      try {
   484→        const ctx = await initContext();
   485→        const tasks = await loadAllTasks(ctx);
   486→        const _items = await loadAllItems(ctx);
   487→
   488→        // Build all indexes including TraitIndex
   489→        const { refIndex: index, traitIndex } = await (async () => {
   490→          const { buildIndexes } = await import("../../parser/index.js");
   491→          return buildIndexes(ctx);
   492→        })();
   493→
   494→        const foundTask = resolveTaskRef(ref, tasks, index);
   495→
   496→        // AC: @trait-display ac-3 - task get shows inherited AC sections
   497→        // Get inherited traits if task has spec_ref
   498→        let inheritedTraits: Array<{
   499→          trait: {
   500→            ulid: string;
   501→            slug: string;
   502→            title: string;
   503→            description?: string;
   504→          };
   505→          acs: Array<{
   506→            id: string;
   507→            given?: string;
   508→            when?: string;
   509→            then?: string;
   510→          }>;
   511→        }> = [];
   512→        if (foundTask.spec_ref) {
   513→          const specResult = index.resolve(foundTask.spec_ref);
   514→          if (specResult.ok) {
   515→            const specUlid = specResult.ulid;
   516→            const inheritedAC = traitIndex.getInheritedAC(specUlid);
   517→            const traitsByTrait = new Map<
   518→              string,
   519→              {
   520→                trait: (typeof inheritedAC)[0]["trait"];
   521→                acs: Array<{
   522→                  id: string;
   523→                  given?: string;
   524→                  when?: string;
   525→                  then?: string;
   526→                }>;
   527→              }
   528→            >();
   529→            for (const { trait, ac } of inheritedAC) {
   530→              if (!traitsByTrait.has(trait.ulid)) {
   531→                traitsByTrait.set(trait.ulid, { trait, acs: [] });
   532→              }
   533→              traitsByTrait.get(trait.ulid)?.acs.push(ac);
   534→            }
   535→            inheritedTraits = Array.from(traitsByTrait.values());
   536→          }
   537→        }
   538→
   539→        // Build JSON output with inherited traits (AC: @trait-display ac-2)
   540→        // Always include all notes in JSON output with superseded computed field
   541→        const jsonOutput = {
   542→          ...foundTask,
   543→          notes: annotateNotesWithSuperseded(foundTask.notes),
   544→          ...(inheritedTraits.length > 0 && {
   545→            inherited_traits: inheritedTraits.map(({ trait, acs }) => ({
   546→              ref: `@${trait.slug}`,
   547→              title: trait.title,
   548→              acceptance_criteria: acs,
   549→            })),
   550→          }),
   551→        };
   552→
   553→        output(jsonOutput, () => {
   554→          formatTaskDetails(foundTask, index, { showAllNotes: options.all });
   555→
   556→          // AC: @trait-display ac-3, ac-4, ac-5 - Show inherited AC per trait in labeled sections
   557→          if (inheritedTraits.length > 0) {
   558→            for (const { trait, acs } of inheritedTraits) {
   559→              console.log(
   560→                chalk.gray(`\n─── Inherited from @${trait.slug} ───`),
   561→              );
   562→              for (const ac of acs) {
   563→                console.log(
   564→                  chalk.cyan(`  [${ac.id}]`) +
   565→                    chalk.gray(` (from @${trait.slug})`),
   566→                );
   567→                if (ac.given) console.log(`    Given: ${ac.given}`);
   568→                if (ac.when) console.log(`    When: ${ac.when}`);
   569→                if (ac.then) console.log(`    Then: ${ac.then}`);
   570→              }
   571→            }
   572→          }
   573→        });
   574→      } catch (err) {
   575→        error(errors.failures.getTask, err);
   576→        process.exit(EXIT_CODES.ERROR);
   577→      }
   578→    });
   579→
   580→  // kspec task add
   581→  markMutating(task.command("add"))
   582→    .description("Create a new task")
   583→    .requiredOption("--title <title>", "Task title")
   584→    .option("--description <description>", "Task description")
   585→    .option(
   586→      "--type <type>",
   587→      "Task type (task, epic, bug, spike, infra)",
   588→      "task",
   589→    )
   590→    .option("--spec-ref <ref>", "Reference to spec item")
   591→    .option(
   592→      "--meta-ref <ref>",
   593→      "Reference to meta item (workflow, agent, or convention)",
   594→    )
   595→    .option("--plan-ref <ref>", "Reference to plan this task is derived from")
   596→    .option("--priority <n>", "Priority (1-5)", "3")
   597→    .option("--slug <slug>", "Human-friendly slug")
   598→    .option("--tag <tag...>", "Tags")
   599→    .option("--depends-on <refs...>", "Set task dependencies")
   600→    .option(
   601→      "--automation <status>",
   602→      "Automation eligibility (eligible, needs_review, manual_only)",
   603→    )
   604→    .addHelpText(
   605→      "after",
   606→      `
   607→Examples:
   608→  $ kspec task add --title "Implement feature" --spec-ref @feature-spec
   609→  $ kspec task add --title "Fix bug" --type bug --priority 1
   610→  $ kspec task add --title "Multi-tag task" --tag cli urgent`,
   611→    )
   612→    .action(async (options) => {
   613→      try {
   614→        const ctx = await initContext();
   615→        const tasks = await loadAllTasks(ctx);
   616→        const items = await loadAllItems(ctx);
   617→
   618→        // Load meta items for validation
   619→        const { loadMetaContext } = await import("../../parser/meta.js");
   620→        const metaContext = await loadMetaContext(ctx);
   621→        const allMetaItems = [
   622→          ...metaContext.agents,
   623→          ...metaContext.workflows,
   624→          ...metaContext.conventions,
   625→          ...metaContext.observations,
   626→        ];
   627→
   628→        // Build index for reference validation
   629→        const refIndex = new ReferenceIndex(tasks, items, allMetaItems);
   630→
   631→        // Check slug uniqueness if provided
   632→        if (options.slug) {
   633→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   634→          if (!slugCheck.ok) {
   635→            error(
   636→              errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid),
   637→            );
   638→            process.exit(EXIT_CODES.CONFLICT);
   639→          }
   640→        }
   641→
   642→        // Validate meta_ref if provided (AC-meta-ref-3, AC-meta-ref-4)
   643→        if (options.metaRef) {
   644→          const metaRefResult = refIndex.resolve(options.metaRef);
   645→
   646→          if (!metaRefResult.ok) {
   647→            error(errors.reference.metaRefNotFound(options.metaRef));
   648→            process.exit(EXIT_CODES.NOT_FOUND);
   649→          }
   650→
   651→          // Check if the resolved item is a meta item (not a spec item or task)
   652→          const isTask = tasks.some((t) => t._ulid === metaRefResult.ulid);
   653→          const isSpecItem = items.some((i) => i._ulid === metaRefResult.ulid);
   654→
   655→          if (isTask || isSpecItem) {
   656→            error(errors.reference.metaRefPointsToSpec(options.metaRef));
   657→            process.exit(EXIT_CODES.NOT_FOUND);
   658→          }
   659→        }
   660→
   661→        // Validate spec_ref if provided — must point to a spec item, not a task or meta item
   662→        if (options.specRef) {
   663→          const specRefResult = validateSpecRef(
   664→            options.specRef,
   665→            refIndex,
   666→            tasks,
   667→            items,
   668→          );
   669→          if (!specRefResult.ok) {
   670→            error(specRefResult.error);
   671→            process.exit(EXIT_CODES.NOT_FOUND);
   672→          }
   673→        }
   674→
   675→        // AC: @task-automation-eligibility ac-13 - validate automation if provided
   676→        let automationValue:
   677→          | "eligible"
   678→          | "needs_review"
   679→          | "manual_only"
   680→          | undefined;
   681→        if (options.automation) {
   682→          const automationResult = validateEnumOption(
   683→            options.automation,
   684→            ["eligible", "needs_review", "manual_only"] as const,
   685→            "automation status",
   686→          );
   687→          if (!automationResult.ok) {
   688→            error(automationResult.error);
   689→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   690→          }
   691→          automationValue = automationResult.value;
   692→        }
   693→
   694→        // Validate plan_ref if provided (AC: @plan-derive ac-5, ac-6)
   695→        if (options.planRef) {
   696→          // First check if it's a task or spec item (wrong type)
   697→          const cleanRef = options.planRef.startsWith("@")
   698→            ? options.planRef.slice(1)
   699→            : options.planRef;
   700→
   701→          const isTask = tasks.some(
   702→            (t) =>
   703→              t.slugs.includes(cleanRef) ||
   704→              t._ulid === cleanRef ||
   705→              t._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   706→          );
   707→          const isSpecItem = items.some(
   708→            (i) =>
   709→              i.slugs.includes(cleanRef) ||
   710→              i._ulid === cleanRef ||
   711→              i._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
   712→          );
   713→
   714→          if (isTask || isSpecItem) {
   715→            error(`Reference "${options.planRef}" is not a plan`);
   716→            process.exit(EXIT_CODES.NOT_FOUND);
   717→          }
   718→
   719→          // Now check if the plan exists
   720→          const { findPlanByRef } = await import("../../parser/plans.js");
   721→          const plan = await findPlanByRef(ctx, options.planRef);
   722→
   723→          if (!plan) {
   724→            error(`Plan reference not found: ${options.planRef}`);
   725→            process.exit(EXIT_CODES.NOT_FOUND);
   726→          }
   727→        }
   728→
   729→        // AC: @task-add-depends-on ac-2 - Validate dependency refs
   730→        if (options.dependsOn) {
   731→          for (const depRef of options.dependsOn) {
   732→            const depResult = refIndex.resolve(depRef);
   733→            if (!depResult.ok) {
   734→              error(errors.reference.depNotFound(depRef));
   735→              process.exit(EXIT_CODES.NOT_FOUND);
   736→            }
   737→            // Ensure the dependency is a task, not a spec item
   738→            const isTask = tasks.some((t) => t._ulid === depResult.ulid);
   739→            if (!isTask) {
   740→              error(`Reference "${depRef}" is not a task`);
   741→              process.exit(EXIT_CODES.NOT_FOUND);
   742→            }
   743→          }
   744→        }
   745→
   746→        // Validate priority
   747→        const priorityResult = parseIntOption(options.priority, {
   748→          min: 1,
   749→          max: 5,
   750→          name: "Priority",
   751→        });
   752→        if (!priorityResult.ok) {
   753→          error(priorityResult.error);
   754→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   755→        }
   756→
   757→        // AC: @spec-task-add-description ac-6 - Omit description if empty string
   758→        const descriptionValue =
   759→          options.description && options.description.trim() !== ""
   760→            ? options.description
   761→            : undefined;
   762→
   763→        const input: TaskInput = {
   764→          title: options.title,
   765→          description: descriptionValue,
   766→          type: options.type,
   767→          spec_ref: options.specRef || null,
   768→          meta_ref: options.metaRef || null,
   769→          plan_ref: options.planRef || null,
   770→          priority: priorityResult.value,
   771→          slugs: options.slug ? [options.slug] : [],
   772→          tags: parseTagsArray(options.tag),
   773→          depends_on: (options.dependsOn || []).map((ref: string) =>
   774→            ref.startsWith("@") ? ref : `@${ref}`,
   775→          ),
   776→          automation: automationValue,
   777→        };
   778→
   779→        const newTask = createTask(input);
   780→        await saveTask(ctx, newTask);
   781→        await commitIfShadow(
   782→          ctx.shadow,
   783→          "task-add",
   784→          newTask.slugs[0] || newTask._ulid.slice(0, 8),
   785→          newTask.title,
   786→        );
   787→
   788→        // Build index including the new task for accurate short ULID
   789→        const index = new ReferenceIndex(
   790→          [...tasks, newTask],
   791→          items,
   792→          allMetaItems,
   793→        );
   794→        success(`Created task: ${index.shortUlid(newTask._ulid)}`, {
   795→          task: newTask,
   796→        });
   797→      } catch (err) {
   798→        error(errors.failures.createTask, err);
   799→        process.exit(EXIT_CODES.ERROR);
   800→      }
   801→    });
   802→
   803→  // kspec task set <ref>
   804→  markMutating(task.command("set [ref]"))
   805→    .description("Update task fields")
   806→    .option(
   807→      "--refs <refs...>",
   808→      "Update multiple tasks (AC: @spec-task-set-batch ac-1)",
   809→    )
   810→    .option("--title <title>", "Update task title")
   811→    .option("--spec-ref <ref>", "Link to spec item")
   812→    .option(
   813→      "--meta-ref <ref>",
   814→      "Link to meta item (workflow, agent, or convention)",
   815→    )
   816→    .option("--plan-ref <ref>", "Link to plan (use 'null' to clear)")
   817→    .option("--priority <n>", "Set priority (1-5)")
   818→    .option("--slug <slug>", "Add a slug alias")
   819→    .option("--tag <tag...>", "Add tags")
   820→    .option("--depends-on <refs...>", "Set dependencies (replaces existing)")
   821→    .option("--clear-deps", "Clear all dependencies")
   822→    .option(
   823→      "--automation <status>",
   824→      "Set automation eligibility (eligible, needs_review, manual_only)",
   825→    )
   826→    .option("--no-automation", "Clear automation status (return to unassessed)")
   827→    .option(
   828→      "--reason <reason>",
   829→      "Reason for status change (required when setting needs_review)",
   830→    )
   831→    .option(
   832→      "--status <status>",
   833→      "Reject with error - use state transition commands instead",
   834→    )
   835→    .addHelpText(
   836→      "after",
   837→      `
   838→Examples:
   839→  $ kspec task set @task-slug --priority 2
   840→  $ kspec task set @task-slug --depends-on @dep1 @dep2
   841→  $ kspec task set @task-slug --tag cli urgent
   842→  $ kspec task set --refs @task1 @task2 --priority 3`,
   843→    )
   844→    .action(async (ref: string | undefined, options) => {
   845→      try {
   846→        // AC: @spec-task-set-batch ac-3 - Reject --status flag
   847→        if (options.status !== undefined) {
   848→          error(
   849→            "Use state transition commands (start, complete, block, etc.) to change status",
   850→          );
   851→          process.exit(EXIT_CODES.USAGE_ERROR);
   852→        }
   853→
   854→        // AC: @spec-task-clear-deps ac-3 - Mutual exclusivity check
   855→        if (options.clearDeps && options.dependsOn) {
   856→          error("Cannot use --clear-deps and --depends-on together");
   857→          process.exit(EXIT_CODES.USAGE_ERROR);
   858→        }
   859→
   860→        const ctx = await initContext();
   861→        const tasks = await loadAllTasks(ctx);
   862→        const items = await loadAllItems(ctx);
   863→
   864→        // Load meta items for validation
   865→        const { loadMetaContext } = await import("../../parser/meta.js");
   866→        const metaContext = await loadMetaContext(ctx);
   867→        const allMetaItems = [
   868→          ...metaContext.agents,
   869→          ...metaContext.workflows,
   870→          ...metaContext.conventions,
   871→          ...metaContext.observations,
   872→        ];
   873→
   874→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   875→
   876→        // AC: @trait-multi-ref-batch ac-8 - Deduplicate refs
   877→        const refsFlag = options.refs
   878→          ? [...new Set(options.refs as string[])]
   879→          : undefined;
   880→
   881→        // Batch mode or single mode?
   882→        if (refsFlag && refsFlag.length > 0) {
   883→          // Batch mode - AC: @spec-task-set-batch ac-1, ac-2, ac-5
   884→          const result = await executeBatchOperation({
   885→            positionalRef: ref,
   886→            refsFlag,
   887→            context: { ctx, tasks, items, allMetaItems, index, options },
   888→            items: tasks,
   889→            index,
   890→            resolveRef: (
   891→              refStr: string,
   892→              taskList: LoadedTask[],
   893→              idx: ReferenceIndex,
   894→            ) => {
   895→              const result = resolveTaskRefForBatch(refStr, taskList, idx);
   896→              return { item: result.task, error: result.error };
   897→            },
   898→            executeOperation: async (task: LoadedTask, context) => {
   899→              return await setTaskFields(
   900→                task,
   901→                context.ctx,
   902→                context.tasks,
   903→                context.items,
   904→                context.allMetaItems,
   905→                context.index,
   906→                context.options,
   907→              );
   908→            },
   909→            getUlid: (task: LoadedTask) => task._ulid,
   910→          });
   911→
   912→          formatBatchOutput(result, "Set");
   913→        } else {
   914→          // Single mode - existing behavior
   915→          if (!ref) {
   916→            error("Either provide a positional ref or use --refs flag");
   917→            process.exit(EXIT_CODES.USAGE_ERROR);
   918→          }
   919→
   920→          const foundTask = resolveTaskRef(ref, tasks, index);
   921→          const result = await setTaskFields(
   922→            foundTask,
   923→            ctx,
   924→            tasks,
   925→            items,
   926→            allMetaItems,
   927→            index,
   928→            options,
   929→          );
   930→
   931→          if (!result.success) {
   932→            error(result.error || "Failed to update task");
   933→            process.exit(EXIT_CODES.ERROR);
   934→          }
   935→
   936→          if (result.message) {
   937→            // AC: @spec-task-set-batch ac-4 - Warn on no changes
   938→            if (result.message.includes("No changes")) {
   939→              if (isJsonMode()) {
   940→                output({ success: true, message: result.message });
   941→              } else {
   942→                warn(result.message);
   943→              }
   944→            } else {
   945→              success(
   946→                result.message,
   947→                result.data as Record<string, unknown> | undefined,
   948→              );
   949→            }
   950→          }
   951→        }
   952→      } catch (err) {
   953→        error(errors.failures.updateTask, err);
   954→        process.exit(EXIT_CODES.ERROR);
   955→      }
   956→    });
   957→
   958→  // kspec task patch <ref>
   959→  markMutating(task.command("patch <ref>"))
   960→    .description("Update task with JSON data")
   961→    .option("--data <json>", "JSON object with fields to update")
   962→    .option("--dry-run", "Show what would change without writing")
   963→    .option("--allow-unknown", "Allow unknown fields (for extending format)")
   964→    .action(async (ref: string, options) => {
   965→      try {
   966→        const ctx = await initContext();
   967→        const tasks = await loadAllTasks(ctx);
   968→        const items = await loadAllItems(ctx);
   969→
   970→        // Load meta items for validation
   971→        const { loadMetaContext } = await import("../../parser/meta.js");
   972→        const metaContext = await loadMetaContext(ctx);
   973→        const allMetaItems = [
   974→          ...metaContext.agents,
   975→          ...metaContext.workflows,
   976→          ...metaContext.conventions,
   977→          ...metaContext.observations,
   978→        ];
   979→
   980→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   981→        const foundTask = resolveTaskRef(ref, tasks, index);
   982→
   983→        // Get JSON data from --data flag or stdin
   984→        let jsonData: string;
   985→        if (options.data) {
   986→          jsonData = options.data;
   987→        } else {
   988→          // Read from stdin
   989→          const chunks: Buffer[] = [];
   990→          for await (const chunk of process.stdin) {
   991→            chunks.push(chunk);
   992→          }
   993→          jsonData = Buffer.concat(chunks).toString("utf-8");
   994→        }
   995→
   996→        // Parse JSON
   997→        let patchData: Record<string, unknown>;
   998→        try {
   999→          patchData = JSON.parse(jsonData);
  1000→        } catch (parseErr) {
  1001→          error(errors.validation.invalidJson, parseErr);
  1002→          process.exit(EXIT_CODES.ERROR);
  1003→        }
  1004→
  1005→        // Validate against TaskInputSchema (partial)
  1006→        const { TaskInputSchema } = await import("../../schema/index.js");
  1007→
  1008→        // Create a partial schema for validation
  1009→        const partialSchema = options.allowUnknown
  1010→          ? TaskInputSchema.partial().passthrough()
  1011→          : TaskInputSchema.partial().strict();
  1012→
  1013→        let validatedPatch: Partial<TaskInput>;
  1014→        try {
  1015→          validatedPatch = partialSchema.parse(patchData);
  1016→        } catch (validationErr) {
  1017→          error(
  1018→            errors.validation.invalidPatchData(String(validationErr)),
  1019→            validationErr,
  1020→          );
  1021→          process.exit(EXIT_CODES.ERROR);
  1022→        }
  1023→
  1024→        // Check for unknown fields if strict mode
  1025→        if (!options.allowUnknown) {
  1026→          const knownFields = Object.keys(TaskInputSchema.shape);
  1027→          const providedFields = Object.keys(patchData);
  1028→          const unknownFields = providedFields.filter(
  1029→            (f) => !knownFields.includes(f),
  1030→          );
  1031→
  1032→          if (unknownFields.length > 0) {
  1033→            error(errors.validation.unknownFields(unknownFields));
  1034→            process.exit(EXIT_CODES.ERROR);
  1035→          }
  1036→        }
  1037→
  1038→        // Build updated task
  1039→        const updatedTask: Task = { ...foundTask, ...validatedPatch };
  1040→
  1041→        // Track changes for output
  1042→        const changes = Object.keys(validatedPatch);
  1043→
  1044→        if (options.dryRun) {
  1045→          info("Dry run - no changes will be written");
  1046→          info(`Would update: ${changes.join(", ")}`);
  1047→          output({ changes, updated: updatedTask }, () => {
  1048→            console.log(`\nChanges: ${changes.join(", ")}\n`);
  1049→            return formatTaskDetails(updatedTask, index);
  1050→          });
  1051→          return;
  1052→        }
  1053→
  1054→        await saveTask(ctx, updatedTask);
  1055→        await commitIfShadow(
  1056→          ctx.shadow,
  1057→          "task-patch",
  1058→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1059→          changes.join(", "),
  1060→        );
  1061→        success(
  1062→          `Patched task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(", ")})`,
  1063→          { task: updatedTask },
  1064→        );
  1065→      } catch (err) {
  1066→        error(errors.failures.patchTask, err);
  1067→        process.exit(EXIT_CODES.ERROR);
  1068→      }
  1069→    });
  1070→
  1071→  // kspec task start <ref>
  1072→  markMutating(task.command("start <ref>"))
  1073→    .description("Start working on a task (pending|needs_work -> in_progress)")
  1074→    .option("--no-sync", "Skip syncing spec implementation status")
  1075→    .action(async (ref: string, options) => {
  1076→      try {
  1077→        const ctx = await initContext();
  1078→        const tasks = await loadAllTasks(ctx);
  1079→        const items = await loadAllItems(ctx);
  1080→        const index = new ReferenceIndex(tasks, items);
  1081→        const foundTask = resolveTaskRef(ref, tasks, index);
  1082→
  1083→        if (foundTask.status === "in_progress") {
  1084→          warn("Task is already in progress");
  1085→          output(foundTask, () => formatTaskDetails(foundTask));
  1086→          return;
  1087→        }
  1088→
  1089→        if (foundTask.status !== "pending" && foundTask.status !== "needs_work") {
  1090→          error(errors.status.cannotStart(foundTask.status));
  1091→          process.exit(EXIT_CODES.VALIDATION_FAILED); // Exit code 4 = invalid state
  1092→        }
  1093→
  1094→        // Update status
  1095→        const updatedTask: Task = {
  1096→          ...foundTask,
  1097→          status: "in_progress",
  1098→          started_at: new Date().toISOString(),
  1099→        };
  1100→
  1101→        await saveTask(ctx, updatedTask);
  1102→        await commitIfShadow(
  1103→          ctx.shadow,
  1104→          "task-start",
  1105→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1106→        );
  1107→        success(`Started task: ${index.shortUlid(updatedTask._ulid)}`, {
  1108→          task: updatedTask,
  1109→        });
  1110→
  1111→        // Show spec context and AC guidance (suppressed in JSON mode)
  1112→        if (!isJsonMode() && foundTask.spec_ref) {
  1113→          const specResult = index.resolve(foundTask.spec_ref);
  1114→          if (specResult.ok) {
  1115→            const specItem = items.find((i) => i._ulid === specResult.ulid);
  1116→            if (specItem) {
  1117→              console.log("");
  1118→              console.log("--- Spec Context ---");
  1119→              console.log(`Implementing: ${specItem.title}`);
  1120→              if (specItem.description) {
  1121→                console.log(`\n${specItem.description}`);
  1122→              }
  1123→
  1124→              if (
  1125→                specItem.acceptance_criteria &&
  1126→                specItem.acceptance_criteria.length > 0
  1127→              ) {
  1128→                console.log(
  1129→                  `\nAcceptance Criteria (${specItem.acceptance_criteria.length}):`,
  1130→                );
  1131→                for (const ac of specItem.acceptance_criteria) {
  1132→                  console.log(`  [${ac.id}]`);
  1133→                  console.log(`    Given: ${ac.given}`);
  1134→                  console.log(`    When: ${ac.when}`);
  1135→                  console.log(`    Then: ${ac.then}`);
  1136→                }
  1137→                console.log("");
  1138→                console.log(
  1139→                  "Remember: Add test coverage for each AC and mark tests with // AC: @spec-ref ac-N",
  1140→                );
  1141→              }
  1142→              console.log("");
  1143→            }
  1144→          }
  1145→        }
  1146→
  1147→        // Sync spec implementation status (unless --no-sync)
  1148→        if (options.sync !== false && foundTask.spec_ref) {
  1149→          const updatedTasks = tasks.map((t) =>
  1150→            t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t,
  1151→          );
  1152→          const syncResult = await syncSpecImplementationStatus(
  1153→            ctx,
  1154→            updatedTask as LoadedTask,
  1155→            updatedTasks as LoadedTask[],
  1156→            items,
  1157→            index,
  1158→          );
  1159→          if (syncResult) {
  1160→            info(
  1161→              `Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1162→            );
  1163→            // Commit the spec status change
  1164→            await commitIfShadow(
  1165→              ctx.shadow,
  1166→              "spec-sync",
  1167→              syncResult.specUlid.slice(0, 8),
  1168→              `${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1169→            );
  1170→          }
  1171→        }
  1172→      } catch (err) {
  1173→        error(errors.failures.startTask, err);
  1174→        process.exit(EXIT_CODES.ERROR);
  1175→      }
  1176→    });
  1177→
  1178→  // kspec task complete <ref> | --refs <refs...>
  1179→  // AC: @multi-ref-batch ac-1 - Basic multi-ref syntax
  1180→  // AC: @multi-ref-batch ac-2 - Backward compatibility
  1181→  markMutating(task.command("complete [ref]"))
  1182→    .description("Complete a task (pending_review -> completed)")
  1183→    .option("--refs <refs...>", "Complete multiple tasks by ref")
  1184→    .option("--reason <reason>", "Completion reason/notes")
  1185→    .option("--skip-review", "Skip review requirement (requires --reason)")
  1186→    .option(
  1187→      "--force",
  1188→      "Force completion even if blocked (AC: @task-commands ac-1)",
  1189→    )
  1190→    .option("--no-sync", "Skip syncing spec implementation status")
  1191→    .addHelpText(
  1192→      "after",
  1193→      `
  1194→Examples:
  1195→  $ kspec task complete @task-slug --reason "Merged in PR #123"
  1196→  $ kspec task complete --refs @task1 @task2 --reason "Batch completion"`,
  1197→    )
  1198→    .action(async (ref: string | undefined, options) => {
  1199→      try {
  1200→        const ctx = await initContext();
  1201→        const tasks = await loadAllTasks(ctx);
  1202→        const items = await loadAllItems(ctx);
  1203→        const index = new ReferenceIndex(tasks, items);
  1204→
  1205→        // AC: @spec-completion-enforcement ac-8
  1206→        if (options.skipReview && !options.reason) {
  1207→          error(errors.status.skipReviewRequiresReason);
  1208→          process.exit(EXIT_CODES.ERROR);
  1209→        }
  1210→
  1211→        // AC: @multi-ref-batch ac-1, ac-2, ac-3, ac-4
  1212→        const result = await executeBatchOperation({
  1213→          positionalRef: ref,
  1214→          refsFlag: options.refs,
  1215→          context: { ctx, tasks, items, index, options },
  1216→          items: tasks,
  1217→          index,
  1218→          resolveRef: (refStr, taskList, idx) => {
  1219→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1220→            return { item: resolved.task, error: resolved.error };
  1221→          },
  1222→          executeOperation: async (
  1223→            foundTask,
  1224→            { ctx, tasks, items, index, options },
  1225→          ) => {
  1226→            try {
  1227→              // AC: @spec-completion-enforcement ac-6
  1228→              if (foundTask.status === "completed") {
  1229→                return {
  1230→                  success: false,
  1231→                  error: errors.status.completeAlreadyCompleted,
  1232→                };
  1233→              }
  1234→
  1235→              // AC: @task-commands ac-1 - Allow --force to bypass blocked state
  1236→              // Handle blocked task with --force before other checks
  1237→              const forcingBlockedTask =
  1238→                foundTask.status === "blocked" && options.force;
  1239→
  1240→              // AC: @spec-completion-enforcement ac-7 - Allow skip-review bypass
  1241→              if (!options.skipReview && !forcingBlockedTask) {
  1242→                // AC: @spec-completion-enforcement ac-2
  1243→                if (foundTask.status === "in_progress") {
  1244→                  return {
  1245→                    success: false,
  1246→                    error: errors.status.completeRequiresReview,
  1247→                  };
  1248→                }
  1249→
  1250→                // AC: @spec-completion-enforcement ac-3
  1251→                if (foundTask.status === "pending") {
  1252→                  return {
  1253→                    success: false,
  1254→                    error: errors.status.completeRequiresStart,
  1255→                  };
  1256→                }
  1257→
  1258→                // AC: @spec-completion-enforcement ac-4
  1259→                if (foundTask.status === "blocked") {
  1260→                  return {
  1261→                    success: false,
  1262→                    error: errors.status.completeBlockedTask,
  1263→                  };
  1264→                }
  1265→
  1266→                // AC: @spec-completion-enforcement ac-5
  1267→                if (foundTask.status === "cancelled") {
  1268→                  return {
  1269→                    success: false,
  1270→                    error: errors.status.completeCancelledTask,
  1271→                  };
  1272→                }
  1273→
  1274→                // AC: @spec-completion-enforcement ac-1 - Only pending_review allowed
  1275→                if (foundTask.status !== "pending_review") {
  1276→                  return {
  1277→                    success: false,
  1278→                    error: errors.status.cannotComplete(foundTask.status),
  1279→                  };
  1280→                }
  1281→              }
  1282→
  1283→              const now = new Date().toISOString();
  1284→
  1285→              // AC: @spec-completion-enforcement ac-7 - Document skip-review reason
  1286→              // AC: @spec-completion-enforcement ac-author
  1287→              let taskNotes = foundTask.notes;
  1288→              if (options.skipReview && options.reason) {
  1289→                const skipNote = createNote(
  1290→                  `Completed with --skip-review: ${options.reason}`,
  1291→                  getAuthor(ctx.config?.identity?.author),
  1292→                );
  1293→                taskNotes = [...taskNotes, skipNote];
  1294→              }
  1295→
  1296→              // AC: @task-commands ac-1 - Document force completion of blocked task
  1297→              if (forcingBlockedTask) {
  1298→                const blockedBy = foundTask.blocked_by.join("; ");
  1299→                const forceNote = createNote(
  1300→                  `Completed with --force despite blocked state. Was blocked by: ${blockedBy || "(dependency-blocked)"}${options.reason ? `. Reason: ${options.reason}` : ""}`,
  1301→                  getAuthor(ctx.config?.identity?.author),
  1302→                );
  1303→                taskNotes = [...taskNotes, forceNote];
  1304→              }
  1305→
  1306→              // Update status
  1307→              const updatedTask: Task = {
  1308→                ...foundTask,
  1309→                status: "completed",
  1310→                completed_at: now,
  1311→                closed_reason: options.reason || null,
  1312→                started_at: foundTask.started_at || now,
  1313→                notes: taskNotes,
  1314→              };
  1315→
  1316→              await saveTask(ctx, updatedTask);
  1317→              await commitIfShadow(
  1318→                ctx.shadow,
  1319→                "task-complete",
  1320→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1321→                options.reason,
  1322→              );
  1323→
  1324→              // Sync spec implementation status (unless --no-sync)
  1325→              if (options.sync !== false && foundTask.spec_ref) {
  1326→                const updatedTasks = tasks.map((t) =>
  1327→                  t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t,
  1328→                );
  1329→                const syncResult = await syncSpecImplementationStatus(
  1330→                  ctx,
  1331→                  updatedTask as LoadedTask,
  1332→                  updatedTasks as LoadedTask[],
  1333→                  items,
  1334→                  index,
  1335→                );
  1336→                if (syncResult && !isJsonMode()) {
  1337→                  info(
  1338→                    `Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1339→                  );
  1340→                  await commitIfShadow(
  1341→                    ctx.shadow,
  1342→                    "spec-sync",
  1343→                    syncResult.specUlid.slice(0, 8),
  1344→                    `${syncResult.previousStatus} -> ${syncResult.newStatus}`,
  1345→                  );
  1346→                }
  1347→              }
  1348→
  1349→              // Show AC reminder for single-ref mode only (not in batch)
  1350→              if (!options.refs && foundTask.spec_ref && !isJsonMode()) {
  1351→                const specResult = index.resolve(foundTask.spec_ref);
  1352→                if (specResult.ok && specResult.item) {
  1353→                  const specItem = items.find(
  1354→                    (i) => i._ulid === specResult.ulid,
  1355→                  );
  1356→                  if (
  1357→                    specItem?.acceptance_criteria &&
  1358→                    specItem.acceptance_criteria.length > 0
  1359→                  ) {
  1360→                    const count = specItem.acceptance_criteria.length;
  1361→                    console.log(
  1362→                      `\n⚠ Linked spec ${foundTask.spec_ref} has ${count} acceptance criteri${count === 1 ? "on" : "a"} - verify they are covered\n`,
  1363→                    );
  1364→                  }
  1365→                }
  1366→              }
  1367→
  1368→              // AC: @task-commands ac-1 - Show warning when force-completing blocked task
  1369→              let warningMsg: string | undefined;
  1370→              if (forcingBlockedTask) {
  1371→                const blockedBy = foundTask.blocked_by.join("; ");
  1372→                warningMsg = `Task was blocked by: ${blockedBy || "(dependency-blocked)"}`;
  1373→                if (!isJsonMode()) {
  1374→                  warn(warningMsg);
  1375→                }
  1376→              }
  1377→
  1378→              return {
  1379→                success: true,
  1380→                message: `Completed task: ${index.shortUlid(updatedTask._ulid)}`,
  1381→                data: updatedTask,
  1382→                ...(forcingBlockedTask && { warning: warningMsg }),
  1383→              };
  1384→            } catch (err) {
  1385→              return {
  1386→                success: false,
  1387→                error: err instanceof Error ? err.message : String(err),
  1388→              };
  1389→            }
  1390→          },
  1391→          getUlid: (task) => task._ulid,
  1392→        });
  1393→
  1394→        // AC: @multi-ref-batch ac-5, ac-6
  1395→        formatBatchOutput(result, "Complete");
  1396→
  1397→        // Show commit guidance for single-ref mode only
  1398→        if (
  1399→          !options.refs &&
  1400→          result.success &&
  1401→          result.results.length === 1 &&
  1402→          !isJsonMode()
  1403→        ) {
  1404→          const taskData = result.results[0].data as Task | undefined;
  1405→          if (taskData) {
  1406→            const guidance = formatCommitGuidance(taskData);
  1407→            printCommitGuidance(guidance);
  1408→          }
  1409→        }
  1410→      } catch (err) {
  1411→        error(errors.failures.completeTask, err);
  1412→        process.exit(EXIT_CODES.ERROR);
  1413→      }
  1414→    });
  1415→
  1416→  // kspec task submit <ref>
  1417→  // Transitions in_progress → pending_review (code done, awaiting merge)
  1418→  markMutating(task.command("submit <ref>"))
  1419→    .description("Submit task for review (transitions to pending_review)")
  1420→    .action(async (ref: string) => {
  1421→      try {
  1422→        const ctx = await initContext();
  1423→        const tasks = await loadAllTasks(ctx);
  1424→        const items = await loadAllItems(ctx);
  1425→        const index = new ReferenceIndex(tasks, items);
  1426→        const foundTask = resolveTaskRef(ref, tasks, index);
  1427→
  1428→        if (foundTask.status !== "in_progress") {
  1429→          error(
  1430→            `Cannot submit task with status: ${foundTask.status}. Task must be in_progress.`,
  1431→          );
  1432→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1433→        }
  1434→
  1435→        const updatedTask: Task = {
  1436→          ...foundTask,
  1437→          status: "pending_review",
  1438→        };
  1439→
  1440→        await saveTask(ctx, updatedTask);
  1441→        await commitIfShadow(
  1442→          ctx.shadow,
  1443→          "task-submit",
  1444→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1445→        );
  1446→        success(
  1447→          `Submitted task for review: ${index.shortUlid(updatedTask._ulid)}`,
  1448→          { task: updatedTask },
  1449→        );
  1450→      } catch (err) {
  1451→        error(errors.failures.updateTask, err);
  1452→        process.exit(EXIT_CODES.ERROR);
  1453→      }
  1454→    });
  1455→
  1456→  // kspec task needs-work <ref>
  1457→  // Reviewer kicks back a task for worker to fix
  1458→  markMutating(task.command("needs-work <ref>"))
  1459→    .description(
  1460→      "Kick task back to worker for fixes (pending_review -> needs_work)",
  1461→    )
  1462→    .requiredOption("--reason <reason>", "Description of issues found")
  1463→    .action(async (ref: string, options) => {
  1464→      try {
  1465→        const ctx = await initContext();
  1466→        const tasks = await loadAllTasks(ctx);
  1467→        const items = await loadAllItems(ctx);
  1468→        const index = new ReferenceIndex(tasks, items);
  1469→        const foundTask = resolveTaskRef(ref, tasks, index);
  1470→
  1471→        if (foundTask.status !== "pending_review") {
  1472→          error(
  1473→            `Cannot transition task to needs_work from status: ${foundTask.status}. Task must be pending_review.`,
  1474→          );
  1475→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1476→        }
  1477→
  1478→        // Track fix cycle count from existing kickback notes
  1479→        const existingKickbacks = foundTask.notes.filter((n) =>
  1480→          n.content.includes("[FIX_CYCLE:"),
  1481→        ).length;
  1482→        const cycleNumber = existingKickbacks + 1;
  1483→
  1484→        const note = createNote(
  1485→          `[FIX_CYCLE: ${cycleNumber}] Review findings: ${options.reason}`,
  1486→          getAuthor(ctx.config?.identity?.author),
  1487→        );
  1488→
  1489→        const updatedTask: Task = {
  1490→          ...foundTask,
  1491→          status: "needs_work",
  1492→          notes: [...foundTask.notes, note],
  1493→        };
  1494→
  1495→        await saveTask(ctx, updatedTask);
  1496→        await commitIfShadow(
  1497→          ctx.shadow,
  1498→          "task-needs-work",
  1499→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1500→          `cycle ${cycleNumber}`,
  1501→        );
  1502→        success(
  1503→          `Kicked back task: ${index.shortUlid(updatedTask._ulid)} (fix cycle ${cycleNumber})`,
  1504→          { task: updatedTask },
  1505→        );
  1506→      } catch (err) {
  1507→        error("Failed to transition task to needs_work", err);
  1508→        process.exit(EXIT_CODES.ERROR);
  1509→      }
  1510→    });
  1511→
  1512→  // kspec task block <ref>
  1513→  markMutating(task.command("block <ref>"))
  1514→    .description("Block a task")
  1515→    .requiredOption("--reason <reason>", "Reason for blocking")
  1516→    .action(async (ref: string, options) => {
  1517→      try {
  1518→        const ctx = await initContext();
  1519→        const tasks = await loadAllTasks(ctx);
  1520→        const items = await loadAllItems(ctx);
  1521→        const index = new ReferenceIndex(tasks, items);
  1522→        const foundTask = resolveTaskRef(ref, tasks, index);
  1523→
  1524→        if (
  1525→          foundTask.status === "completed" ||
  1526→          foundTask.status === "cancelled"
  1527→        ) {
  1528→          error(errors.status.cannotBlock(foundTask.status));
  1529→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1530→        }
  1531→
  1532→        const updatedTask: Task = {
  1533→          ...foundTask,
  1534→          status: "blocked",
  1535→          blocked_by: [...foundTask.blocked_by, options.reason],
  1536→        };
  1537→
  1538→        await saveTask(ctx, updatedTask);
  1539→        await commitIfShadow(
  1540→          ctx.shadow,
  1541→          "task-block",
  1542→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1543→        );
  1544→        success(`Blocked task: ${index.shortUlid(updatedTask._ulid)}`, {
  1545→          task: updatedTask,
  1546→        });
  1547→      } catch (err) {
  1548→        error(errors.failures.blockTask, err);
  1549→        process.exit(EXIT_CODES.ERROR);
  1550→      }
  1551→    });
  1552→
  1553→  // kspec task unblock <ref>
  1554→  markMutating(task.command("unblock <ref>"))
  1555→    .description("Unblock a task")
  1556→    .action(async (ref: string) => {
  1557→      try {
  1558→        const ctx = await initContext();
  1559→        const tasks = await loadAllTasks(ctx);
  1560→        const items = await loadAllItems(ctx);
  1561→        const index = new ReferenceIndex(tasks, items);
  1562→        const foundTask = resolveTaskRef(ref, tasks, index);
  1563→
  1564→        if (foundTask.status !== "blocked") {
  1565→          warn("Task is not blocked");
  1566→          return;
  1567→        }
  1568→
  1569→        const updatedTask: Task = {
  1570→          ...foundTask,
  1571→          status: "pending",
  1572→          blocked_by: [],
  1573→        };
  1574→
  1575→        await saveTask(ctx, updatedTask);
  1576→        await commitIfShadow(
  1577→          ctx.shadow,
  1578→          "task-unblock",
  1579→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1580→        );
  1581→        success(`Unblocked task: ${index.shortUlid(updatedTask._ulid)}`, {
  1582→          task: updatedTask,
  1583→        });
  1584→      } catch (err) {
  1585→        error(errors.failures.unblockTask, err);
  1586→        process.exit(EXIT_CODES.ERROR);
  1587→      }
  1588→    });
  1589→
  1590→  // kspec task cancel <ref> | --refs <refs...>
  1591→  // AC: @multi-ref-batch ac-1, ac-2
  1592→  markMutating(task.command("cancel [ref]"))
  1593→    .description("Cancel a task")
  1594→    .option("--refs <refs...>", "Cancel multiple tasks by ref")
  1595→    .option("--reason <reason>", "Cancellation reason")
  1596→    .addHelpText(
  1597→      "after",
  1598→      `
  1599→Examples:
  1600→  $ kspec task cancel @task-slug --reason "No longer needed"
  1601→  $ kspec task cancel --refs @task1 @task2 --reason "Superseded by @new-task"`,
  1602→    )
  1603→    .action(async (ref: string | undefined, options) => {
  1604→      try {
  1605→        const ctx = await initContext();
  1606→        const tasks = await loadAllTasks(ctx);
  1607→        const items = await loadAllItems(ctx);
  1608→        const index = new ReferenceIndex(tasks, items);
  1609→
  1610→        const result = await executeBatchOperation({
  1611→          positionalRef: ref,
  1612→          refsFlag: options.refs,
  1613→          context: { ctx, tasks, items, index, options },
  1614→          items: tasks,
  1615→          index,
  1616→          resolveRef: (refStr, taskList, idx) => {
  1617→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1618→            return { item: resolved.task, error: resolved.error };
  1619→          },
  1620→          executeOperation: async (foundTask, { ctx, index, options }) => {
  1621→            try {
  1622→              if (
  1623→                foundTask.status === "completed" ||
  1624→                foundTask.status === "cancelled"
  1625→              ) {
  1626→                return {
  1627→                  success: false,
  1628→                  error: `Task is already ${foundTask.status}`,
  1629→                };
  1630→              }
  1631→
  1632→              const updatedTask: Task = {
  1633→                ...foundTask,
  1634→                status: "cancelled",
  1635→                closed_reason: options.reason || null,
  1636→              };
  1637→
  1638→              await saveTask(ctx, updatedTask);
  1639→              await commitIfShadow(
  1640→                ctx.shadow,
  1641→                "task-cancel",
  1642→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1643→              );
  1644→
  1645→              return {
  1646→                success: true,
  1647→                message: `Cancelled task: ${index.shortUlid(updatedTask._ulid)}`,
  1648→                data: updatedTask,
  1649→              };
  1650→            } catch (err) {
  1651→              return {
  1652→                success: false,
  1653→                error: err instanceof Error ? err.message : String(err),
  1654→              };
  1655→            }
  1656→          },
  1657→          getUlid: (task) => task._ulid,
  1658→        });
  1659→
  1660→        formatBatchOutput(result, "Cancel");
  1661→      } catch (err) {
  1662→        error(errors.failures.cancelTask, err);
  1663→        process.exit(EXIT_CODES.ERROR);
  1664→      }
  1665→    });
  1666→
  1667→  // kspec task reset <ref>
  1668→  // AC: @spec-task-reset ac-1, ac-2, ac-3, ac-4, ac-5, ac-6
  1669→  markMutating(task.command("reset <ref>"))
  1670→    .description("Reset a task to pending state")
  1671→    .action(async (ref: string) => {
  1672→      try {
  1673→        const ctx = await initContext();
  1674→        const tasks = await loadAllTasks(ctx);
  1675→        const items = await loadAllItems(ctx);
  1676→        const index = new ReferenceIndex(tasks, items);
  1677→        const foundTask = resolveTaskRef(ref, tasks, index);
  1678→
  1679→        // AC: @spec-task-reset ac-2 - Error if already pending
  1680→        if (foundTask.status === "pending") {
  1681→          error("Task is already pending");
  1682→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1683→        }
  1684→
  1685→        // Track previous status and reason for note (AC-4)
  1686→        const previousStatus = foundTask.status;
  1687→        const hadCancelReason =
  1688→          foundTask.closed_reason && foundTask.status === "cancelled";
  1689→        const cancelReasonText = hadCancelReason
  1690→          ? ` (was cancelled: ${foundTask.closed_reason})`
  1691→          : "";
  1692→
  1693→        // AC: @spec-task-reset ac-1 - Reset to pending, clear completion-related fields
  1694→        const clearedFields: string[] = [];
  1695→        const updatedTask: Task = {
  1696→          ...foundTask,
  1697→          status: "pending",
  1698→        };
  1699→
  1700→        // Clear timestamps and reasons based on previous status
  1701→        if (
  1702→          foundTask.completed_at !== undefined &&
  1703→          foundTask.completed_at !== null
  1704→        ) {
  1705→          updatedTask.completed_at = null;
  1706→          clearedFields.push("completed_at");
  1707→        }
  1708→        if (
  1709→          foundTask.started_at !== undefined &&
  1710→          foundTask.started_at !== null
  1711→        ) {
  1712→          updatedTask.started_at = null;
  1713→          clearedFields.push("started_at");
  1714→        }
  1715→        if (
  1716→          foundTask.closed_reason !== undefined &&
  1717→          foundTask.closed_reason !== null
  1718→        ) {
  1719→          updatedTask.closed_reason = null;
  1720→          clearedFields.push("closed_reason");
  1721→        }
  1722→        if (foundTask.blocked_by.length > 0) {
  1723→          updatedTask.blocked_by = [];
  1724→          clearedFields.push("blocked_by");
  1725→        }
  1726→
  1727→        // AC: @spec-task-reset ac-4 - Add note documenting the reset
  1728→        // AC: @spec-task-reset ac-author
  1729→        const noteContent = `Reset from ${previousStatus} to pending${cancelReasonText}`;
  1730→        const note = createNote(noteContent, getAuthor(ctx.config?.identity?.author));
  1731→        updatedTask.notes = [...updatedTask.notes, note];
  1732→
  1733→        await saveTask(ctx, updatedTask);
  1734→        // AC: @spec-task-reset ac-3 - Shadow commit with message task-reset
  1735→        await commitIfShadow(
  1736→          ctx.shadow,
  1737→          "task-reset",
  1738→          foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1739→          `from ${previousStatus}`,
  1740→        );
  1741→
  1742→        // AC: @spec-task-reset ac-6 - JSON output includes previous_status, new_status, cleared_fields
  1743→        const jsonOutput = {
  1744→          task: updatedTask,
  1745→          previous_status: previousStatus,
  1746→          new_status: "pending" as const,
  1747→          cleared_fields: clearedFields,
  1748→        };
  1749→
  1750→        output(jsonOutput, () => {
  1751→          success(
  1752→            `Reset task: ${index.shortUlid(updatedTask._ulid)} (${previousStatus} → pending)`,
  1753→            undefined,
  1754→          );
  1755→          if (clearedFields.length > 0) {
  1756→            info(`Cleared fields: ${clearedFields.join(", ")}`);
  1757→          }
  1758→        });
  1759→      } catch (err) {
  1760→        error("Failed to reset task", err);
  1761→        process.exit(EXIT_CODES.ERROR);
  1762→      }
  1763→    });
  1764→
  1765→  // kspec task delete <ref> | --refs <refs...>
  1766→  // AC: @multi-ref-batch ac-1, ac-2
  1767→  markMutating(task.command("delete [ref]"))
  1768→    .description("Delete a task permanently")
  1769→    .option("--refs <refs...>", "Delete multiple tasks by ref")
  1770→    .option("--force", "Skip confirmation (required for --refs)")
  1771→    .option("--dry-run", "Show what would be deleted without deleting")
  1772→    .addHelpText(
  1773→      "after",
  1774→      `
  1775→Examples:
  1776→  $ kspec task delete @task-slug
  1777→  $ kspec task delete --refs @task1 @task2 --force
  1778→  $ kspec task delete --refs @task1 @task2 --dry-run`,
  1779→    )
  1780→    .action(async (ref: string | undefined, options) => {
  1781→      try {
  1782→        const ctx = await initContext();
  1783→        const tasks = await loadAllTasks(ctx);
  1784→        const items = await loadAllItems(ctx);
  1785→        const index = new ReferenceIndex(tasks, items);
  1786→
  1787→        // For batch mode (--refs), require --force
  1788→        if (
  1789→          options.refs &&
  1790→          options.refs.length > 0 &&
  1791→          !options.force &&
  1792→          !options.dryRun
  1793→        ) {
  1794→          error("Batch delete requires --force flag");
  1795→          process.exit(EXIT_CODES.USAGE_ERROR);
  1796→        }
  1797→
  1798→        const result = await executeBatchOperation({
  1799→          positionalRef: ref,
  1800→          refsFlag: options.refs,
  1801→          context: { ctx, tasks, items, index, options },
  1802→          items: tasks,
  1803→          index,
  1804→          resolveRef: (refStr, taskList, idx) => {
  1805→            const resolved = resolveTaskRefForBatch(refStr, taskList, idx);
  1806→            return { item: resolved.task, error: resolved.error };
  1807→          },
  1808→          executeOperation: async (foundTask, { ctx, index, options }) => {
  1809→            try {
  1810→              const taskDisplay = `${foundTask.title} (${index.shortUlid(foundTask._ulid)})`;
  1811→
  1812→              if (options.dryRun) {
  1813→                return {
  1814→                  success: true,
  1815→                  message: `Would delete: ${taskDisplay}`,
  1816→                };
  1817→              }
  1818→
  1819→              // For single-ref mode (not --refs), prompt for confirmation unless --force
  1820→              if (!options.refs && !options.force) {
  1821→                const readline = await import("node:readline");
  1822→                const rl = readline.createInterface({
  1823→                  input: process.stdin,
  1824→                  output: process.stdout,
  1825→                });
  1826→
  1827→                const answer = await new Promise<string>((resolve) => {
  1828→                  rl.question(`Delete task "${taskDisplay}"? [y/N] `, resolve);
  1829→                });
  1830→                rl.close();
  1831→
  1832→                if (answer.toLowerCase() !== "y") {
  1833→                  return {
  1834→                    success: false,
  1835→                    error: "Deletion cancelled by user",
  1836→                  };
  1837→                }
  1838→              }
  1839→
  1840→              await deleteTask(ctx, foundTask);
  1841→              await commitIfShadow(
  1842→                ctx.shadow,
  1843→                "task-delete",
  1844→                foundTask.slugs[0] || index.shortUlid(foundTask._ulid),
  1845→                foundTask.title,
  1846→              );
  1847→
  1848→              return {
  1849→                success: true,
  1850→                message: `Deleted task: ${taskDisplay}`,
  1851→              };
  1852→            } catch (err) {
  1853→              return {
  1854→                success: false,
  1855→                error: err instanceof Error ? err.message : String(err),
  1856→              };
  1857→            }
  1858→          },
  1859→          getUlid: (task) => task._ulid,
  1860→        });
  1861→
  1862→        formatBatchOutput(result, "Delete");
  1863→      } catch (err) {
  1864→        error(errors.failures.deleteTask, err);
  1865→        process.exit(EXIT_CODES.ERROR);
  1866→      }
  1867→    });
  1868→
  1869→  // kspec task note <ref> <message>
  1870→  markMutating(task.command("note <ref> <message>"))
  1871→    .description("Add a note to a task")
  1872→    .option("--author <author>", "Note author")
  1873→    .option("--supersedes <ulid>", "ULID of note this supersedes")
  1874→    .action(async (ref: string, message: string, options) => {
  1875→      try {
  1876→        const ctx = await initContext();
  1877→        const tasks = await loadAllTasks(ctx);
  1878→        const items = await loadAllItems(ctx);
  1879→        const index = new ReferenceIndex(tasks, items);
  1880→        const foundTask = resolveTaskRef(ref, tasks, index);
