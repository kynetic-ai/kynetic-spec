     1→/**
     2→ * Tests for Auto-Generated Data Sections library functions.
     3→ *
     4→ * AC: @agent-data-sections ac-1 - generateSkillsTable
     5→ * AC: @agent-data-sections ac-2 - generateConventionsSummary
     6→ * AC: @agent-data-sections ac-3 - generateWorkflowsSummary
     7→ */
     8→
     9→import { describe, it, expect } from "vitest";
    10→import {
    11→  generateSkillsTable,
    12→  generateConventionsSummary,
    13→  generateWorkflowsSummary,
    14→  CONVENTIONS_INTRO,
    15→} from "../src/parser/agent-data-sections.js";
    16→import { computeMetaHash } from "../src/cli/commands/agents.js";
    17→import type {
    18→  LoadedSkill,
    19→  LoadedConvention,
    20→  LoadedWorkflow,
    21→} from "../src/parser/meta.js";
    22→
    23→// AC: @agent-data-sections ac-1
    24→describe("generateSkillsTable", () => {
    25→  describe("ac-1: markdown table with skill name, description, and invocation", () => {
    26→    it("should return empty string when no skills provided", () => {
    27→      const result = generateSkillsTable([]);
    28→      expect(result).toBe("");
    29→    });
    30→
    31→    it("should return markdown table with header", () => {
    32→      const skills: LoadedSkill[] = [
    33→        {
    34→          id: "task-work",
    35→          name: "Task Work",
    36→          description: "Work on tasks with proper lifecycle",
    37→          _sourceFile: "skills.yaml",
    38→        },
    39→      ];
    40→
    41→      const result = generateSkillsTable(skills);
    42→
    43→      expect(result).toContain("## Finding Information");
    44→      expect(result).toContain("| Need | Where to look |");
    45→      expect(result).toContain("|------|---------------|");
    46→    });
    47→
    48→    it("should include skill description and invocation columns", () => {
    49→      const skills: LoadedSkill[] = [
    50→        {
    51→          id: "task-work",
    52→          name: "Task Work",
    53→          description: "Work on tasks with proper lifecycle",
    54→          _sourceFile: "skills.yaml",
    55→        },
    56→      ];
    57→
    58→      const result = generateSkillsTable(skills);
    59→
    60→      // Description appears in Need column
    61→      expect(result).toContain("Work on tasks with proper lifecycle");
    62→      // Invocation format /id appears in Where to look column
    63→      expect(result).toContain("`/task-work` skill");
    64→    });
    65→
    66→    it("should include one row per skill", () => {
    67→      const skills: LoadedSkill[] = [
    68→        {
    69→          id: "task-work",
    70→          name: "Task Work",
    71→          description: "Work on tasks",
    72→          _sourceFile: "skills.yaml",
    73→        },
    74→        {
    75→          id: "pr-review",
    76→          name: "PR Review",
    77→          description: "Review pull requests",
    78→          _sourceFile: "skills.yaml",
    79→        },
    80→        {
    81→          id: "spec-plan",
    82→          name: "Spec Plan",
    83→          description: "Plan to spec translation",
    84→          _sourceFile: "skills.yaml",
    85→        },
    86→      ];
    87→
    88→      const result = generateSkillsTable(skills);
    89→
    90→      expect(result).toContain("Work on tasks");
    91→      expect(result).toContain("`/task-work` skill");
    92→      expect(result).toContain("Review pull requests");
    93→      expect(result).toContain("`/pr-review` skill");
    94→      expect(result).toContain("Plan to spec translation");
    95→      expect(result).toContain("`/spec-plan` skill");
    96→    });
    97→
    98→    it("should use skill name as fallback when description is missing", () => {
    99→      const skills: LoadedSkill[] = [
   100→        {
   101→          id: "my-skill",
   102→          name: "My Skill",
   103→          _sourceFile: "skills.yaml",
   104→        },
   105→      ];
   106→
   107→      const result = generateSkillsTable(skills);
   108→
   109→      // Uses name as description
   110→      expect(result).toContain("My Skill");
   111→      expect(result).toContain("`/my-skill` skill");
   112→    });
   113→
   114→    it("should use /kspec:<id> invocation for core skills", () => {
   115→      const skills: LoadedSkill[] = [
   116→        {
   117→          id: "help",
   118→          name: "Kspec Help",
   119→          description: "Get help with kspec commands",
   120→          origin: "core",
   121→          _sourceFile: "skills.yaml",
   122→        },
   123→      ];
   124→
   125→      const result = generateSkillsTable(skills);
   126→
   127→      expect(result).toContain("`/kspec:help` skill");
   128→      expect(result).not.toContain("`/help` skill");
   129→    });
   130→
   131→    it("should use /<id> invocation for project skills (no prefix)", () => {
   132→      const skills: LoadedSkill[] = [
   133→        {
   134→          id: "task-work",
   135→          name: "Task Work",
   136→          description: "Work on tasks",
   137→          origin: "project",
   138→          _sourceFile: "skills.yaml",
   139→        },
   140→      ];
   141→
   142→      const result = generateSkillsTable(skills);
   143→
   144→      expect(result).toContain("`/task-work` skill");
   145→      expect(result).not.toContain("`/kspec:task-work` skill");
   146→    });
   147→
   148→    it("should include helpful footer text", () => {
   149→      const skills: LoadedSkill[] = [
   150→        {
   151→          id: "test",
   152→          name: "Test",
   153→          description: "Test skill",
   154→          _sourceFile: "skills.yaml",
   155→        },
   156→      ];
   157→
   158→      const result = generateSkillsTable(skills);
   159→
   160→      expect(result).toContain(
   161→        "Skills inject their full documentation when invoked",
   162→      );
   163→    });
   164→  });
   165→});
   166→
   167→// AC: @agent-data-sections ac-2
   168→describe("generateConventionsSummary", () => {
   169→  describe("ac-2: markdown section listing each domain with its rules", () => {
   170→    it("should return empty string when no conventions provided", () => {
   171→      const result = generateConventionsSummary([]);
   172→      expect(result).toBe("");
   173→    });
   174→
   175→    it("should return markdown section with Conventions header", () => {
   176→      const conventions: LoadedConvention[] = [
   177→        {
   178→          domain: "commits",
   179→          rules: ["Use conventional commits"],
   180→          _sourceFile: "conventions.yaml",
   181→        },
   182→      ];
   183→
   184→      const result = generateConventionsSummary(conventions);
   185→
   186→      expect(result).toContain("## Conventions");
   187→    });
   188→
   189→    it("should include domain as subsection header", () => {
   190→      const conventions: LoadedConvention[] = [
   191→        {
   192→          domain: "commits",
   193→          rules: ["Use conventional commits"],
   194→          _sourceFile: "conventions.yaml",
   195→        },
   196→      ];
   197→
   198→      const result = generateConventionsSummary(conventions);
   199→
   200→      expect(result).toContain("### commits");
   201→    });
   202→
   203→    it("should list rules as markdown list items", () => {
   204→      const conventions: LoadedConvention[] = [
   205→        {
   206→          domain: "commits",
   207→          rules: [
   208→            "Use conventional commits",
   209→            "Include task trailer",
   210→            "Sign commits with GPG",
   211→          ],
   212→          _sourceFile: "conventions.yaml",
   213→        },
   214→      ];
   215→
   216→      const result = generateConventionsSummary(conventions);
   217→
   218→      expect(result).toContain("- Use conventional commits");
   219→      expect(result).toContain("- Include task trailer");
   220→      expect(result).toContain("- Sign commits with GPG");
   221→    });
   222→
   223→    it("should include multiple domains", () => {
   224→      const conventions: LoadedConvention[] = [
   225→        {
   226→          domain: "commits",
   227→          rules: ["Use conventional commits"],
   228→          _sourceFile: "conventions.yaml",
   229→        },
   230→        {
   231→          domain: "testing",
   232→          rules: ["All ACs must have tests", "Run tests before committing"],
   233→          _sourceFile: "conventions.yaml",
   234→        },
   235→        {
   236→          domain: "code-style",
   237→          rules: ["Use 2-space indentation"],
   238→          _sourceFile: "conventions.yaml",
   239→        },
   240→      ];
   241→
   242→      const result = generateConventionsSummary(conventions);
   243→
   244→      expect(result).toContain("### commits");
   245→      expect(result).toContain("### testing");
   246→      expect(result).toContain("### code-style");
   247→      expect(result).toContain("- Use conventional commits");
   248→      expect(result).toContain("- All ACs must have tests");
   249→      expect(result).toContain("- Run tests before committing");
   250→      expect(result).toContain("- Use 2-space indentation");
   251→    });
   252→
   253→    it("should handle domain with empty rules array", () => {
   254→      const conventions: LoadedConvention[] = [
   255→        {
   256→          domain: "empty-domain",
   257→          rules: [],
   258→          _sourceFile: "conventions.yaml",
   259→        },
   260→      ];
   261→
   262→      const result = generateConventionsSummary(conventions);
   263→
   264→      expect(result).toContain("### empty-domain");
   265→      // Should not crash, just have header with no rules
   266→    });
   267→  });
   268→
   269→  describe("context intro paragraph", () => {
   270→    it("should include intro paragraph between header and first domain", () => {
   271→      const conventions: LoadedConvention[] = [
   272→        {
   273→          domain: "commits",
   274→          rules: ["Use conventional commits"],
   275→          examples: [],
   276→          _sourceFile: "conventions.yaml",
   277→        },
   278→      ];
   279→
   280→      const result = generateConventionsSummary(conventions);
   281→
   282→      const headerPos = result.indexOf("## Conventions");
   283→      const introPos = result.indexOf(CONVENTIONS_INTRO);
   284→      const domainPos = result.indexOf("### commits");
   285→
   286→      expect(introPos).toBeGreaterThan(headerPos);
   287→      expect(introPos).toBeLessThan(domainPos);
   288→    });
   289→  });
   290→
   291→  describe("examples rendering", () => {
   292→    it("should render short examples as inline code with em-dash separator", () => {
   293→      const conventions: LoadedConvention[] = [
   294→        {
   295→          domain: "commits",
   296→          rules: ["Use conventional commits"],
   297→          examples: [
   298→            { good: "feat: add login", bad: "Added login" },
   299→          ],
   300→          _sourceFile: "conventions.yaml",
   301→        },
   302→      ];
   303→
   304→      const result = generateConventionsSummary(conventions);
   305→
   306→      expect(result).toContain("**Examples:**");
   307→      expect(result).toContain(
   308→        "- Good: `feat: add login` — Bad: `Added login`",
   309→      );
   310→    });
   311→
   312→    it("should render long examples as quoted multi-line format", () => {
   313→      const longGood =
   314→        "Implemented retry logic with exponential backoff. Chose 3 retries max based on API rate limits.";
   315→      const longBad = "Done";
   316→      const conventions: LoadedConvention[] = [
   317→        {
   318→          domain: "notes",
   319→          rules: ["Be descriptive"],
   320→          examples: [{ good: longGood, bad: longBad }],
   321→          _sourceFile: "conventions.yaml",
   322→        },
   323→      ];
   324→
   325→      const result = generateConventionsSummary(conventions);
   326→
   327→      expect(result).toContain("**Examples:**");
   328→      expect(result).toContain(`- Good: "${longGood}"`);
   329→      expect(result).toContain(`- Bad: "${longBad}"`);
   330→      // Should NOT use backtick format
   331→      expect(result).not.toContain(`\`${longGood}\``);
   332→    });
   333→
   334→    it("should render multiple example pairs correctly", () => {
   335→      const conventions: LoadedConvention[] = [
   336→        {
   337→          domain: "commits",
   338→          rules: ["Use conventional commits"],
   339→          examples: [
   340→            { good: "feat: add login", bad: "Added login" },
   341→            { good: "fix(auth): handle expired tokens", bad: "fixed bug" },
   342→          ],
   343→          _sourceFile: "conventions.yaml",
   344→        },
   345→      ];
   346→
   347→      const result = generateConventionsSummary(conventions);
   348→
   349→      expect(result).toContain(
   350→        "- Good: `feat: add login` — Bad: `Added login`",
   351→      );
   352→      expect(result).toContain(
   353→        "- Good: `fix(auth): handle expired tokens` — Bad: `fixed bug`",
   354→      );
   355→    });
   356→
   357→    it("should not include Examples section when examples array is empty", () => {
   358→      const conventions: LoadedConvention[] = [
   359→        {
   360→          domain: "commits",
   361→          rules: ["Use conventional commits"],
   362→          examples: [],
   363→          _sourceFile: "conventions.yaml",
   364→        },
   365→      ];
   366→
   367→      const result = generateConventionsSummary(conventions);
   368→
   369→      expect(result).not.toContain("**Examples:**");
   370→    });
   371→
   372→    it("should only show examples for conventions that have them", () => {
   373→      const conventions: LoadedConvention[] = [
   374→        {
   375→          domain: "commits",
   376→          rules: ["Use conventional commits"],
   377→          examples: [
   378→            { good: "feat: add login", bad: "Added login" },
   379→          ],
   380→          _sourceFile: "conventions.yaml",
   381→        },
   382→        {
   383→          domain: "naming",
   384→          rules: ["Use camelCase"],
   385→          examples: [],
   386→          _sourceFile: "conventions.yaml",
   387→        },
   388→      ];
   389→
   390→      const result = generateConventionsSummary(conventions);
   391→
   392→      // Split by domain sections
   393→      const commitsSection = result.slice(
   394→        result.indexOf("### commits"),
   395→        result.indexOf("### naming"),
   396→      );
   397→      const namingSection = result.slice(result.indexOf("### naming"));
   398→
   399→      expect(commitsSection).toContain("**Examples:**");
   400→      expect(namingSection).not.toContain("**Examples:**");
   401→    });
   402→
   403→    it("should render examples after rules, not before", () => {
   404→      const conventions: LoadedConvention[] = [
   405→        {
   406→          domain: "commits",
   407→          rules: ["Use conventional commits"],
   408→          examples: [
   409→            { good: "feat: add login", bad: "Added login" },
   410→          ],
   411→          _sourceFile: "conventions.yaml",
   412→        },
   413→      ];
   414→
   415→      const result = generateConventionsSummary(conventions);
   416→
   417→      const rulePos = result.indexOf("- Use conventional commits");
   418→      const examplesPos = result.indexOf("**Examples:**");
   419→
   420→      expect(examplesPos).toBeGreaterThan(rulePos);
   421→    });
   422→  });
   423→});
   424→
   425→// AC: @agent-data-sections ac-3
   426→describe("generateWorkflowsSummary", () => {
   427→  describe("ac-3: markdown section listing each workflow with its trigger", () => {
   428→    it("should return empty string when no workflows provided", () => {
   429→      const result = generateWorkflowsSummary([]);
   430→      expect(result).toBe("");
   431→    });
   432→
   433→    it("should return markdown section with Workflows header", () => {
   434→      const workflows: LoadedWorkflow[] = [
   435→        {
   436→          id: "pr-review-merge",
   437→          trigger: "When PR needs review",
   438→          _sourceFile: "workflows.yaml",
   439→        },
   440→      ];
   441→
   442→      const result = generateWorkflowsSummary(workflows);
   443→
   444→      expect(result).toContain("## Workflows");
   445→      expect(result).toContain("Available workflows:");
   446→    });
   447→
   448→    it("should list workflow with id and description/trigger", () => {
   449→      const workflows: LoadedWorkflow[] = [
   450→        {
   451→          id: "pr-review-merge",
   452→          trigger: "When PR needs review",
   453→          description: "Review and merge a pull request",
   454→          _sourceFile: "workflows.yaml",
   455→        },
   456→      ];
   457→
   458→      const result = generateWorkflowsSummary(workflows);
   459→
   460→      expect(result).toContain("**pr-review-merge**");
   461→      expect(result).toContain("Review and merge a pull request");
   462→    });
   463→
   464→    it("should use trigger as fallback when description is missing", () => {
   465→      const workflows: LoadedWorkflow[] = [
   466→        {
   467→          id: "task-work-session",
   468→          trigger: "When starting task work",
   469→          _sourceFile: "workflows.yaml",
   470→        },
   471→      ];
   472→
   473→      const result = generateWorkflowsSummary(workflows);
   474→
   475→      expect(result).toContain("**task-work-session**");
   476→      expect(result).toContain("When starting task work");
   477→    });
   478→
   479→    it("should list multiple workflows", () => {
   480→      const workflows: LoadedWorkflow[] = [
   481→        {
   482→          id: "pr-review-merge",
   483→          trigger: "When PR needs review",
   484→          description: "Review and merge a PR",
   485→          _sourceFile: "workflows.yaml",
   486→        },
   487→        {
   488→          id: "task-work-session",
   489→          trigger: "When starting task work",
   490→          description: "Full task lifecycle workflow",
   491→          _sourceFile: "workflows.yaml",
   492→        },
   493→        {
   494→          id: "release",
   495→          trigger: "When releasing a version",
   496→          description: "Create versioned release",
   497→          _sourceFile: "workflows.yaml",
   498→        },
   499→      ];
   500→
   501→      const result = generateWorkflowsSummary(workflows);
   502→
   503→      expect(result).toContain("**pr-review-merge**");
   504→      expect(result).toContain("Review and merge a PR");
   505→      expect(result).toContain("**task-work-session**");
   506→      expect(result).toContain("Full task lifecycle workflow");
   507→      expect(result).toContain("**release**");
   508→      expect(result).toContain("Create versioned release");
   509→    });
   510→
   511→    it("should include usage hint", () => {
   512→      const workflows: LoadedWorkflow[] = [
   513→        {
   514→          id: "test",
   515→          trigger: "test",
   516→          _sourceFile: "workflows.yaml",
   517→        },
   518→      ];
   519→
   520→      const result = generateWorkflowsSummary(workflows);
   521→
   522→      expect(result).toContain(
   523→        "Use `kspec workflow start @workflow-id` to start a workflow.",
   524→      );
   525→    });
   526→  });
   527→});
   528→
   529→// AC: @cross-platform-and-version-robustness ac-4
   530→describe("computeMetaHash", () => {
   531→  it("should produce different hashes when conventions differ only in examples", () => {
   532→    const skills: LoadedSkill[] = [];
   533→    const workflows: LoadedWorkflow[] = [];
   534→
   535→    const conventionsWithoutExamples: LoadedConvention[] = [
   536→      {
   537→        domain: "commits",
   538→        rules: ["Use conventional commits"],
   539→        examples: [],
   540→        _sourceFile: "conventions.yaml",
   541→      },
   542→    ];
   543→
   544→    const conventionsWithExamples: LoadedConvention[] = [
   545→      {
   546→        domain: "commits",
   547→        rules: ["Use conventional commits"],
   548→        examples: [{ good: "feat: add login", bad: "Added login" }],
   549→        _sourceFile: "conventions.yaml",
   550→      },
   551→    ];
   552→
   553→    const hashWithout = computeMetaHash(skills, conventionsWithoutExamples, workflows);
   554→    const hashWith = computeMetaHash(skills, conventionsWithExamples, workflows);
   555→
   556→    expect(hashWithout).not.toBe(hashWith);
   557→  });
   558→});
   559→