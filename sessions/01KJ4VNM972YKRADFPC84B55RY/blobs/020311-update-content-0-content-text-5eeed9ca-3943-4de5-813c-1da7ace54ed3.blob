```
     1→import type { Command } from "commander";
     2→import { markMutating } from "../command-annotations.js";
     3→import {
     4→  AlignmentIndex,
     5→  createNote,
     6→  createTask,
     7→  getAuthor,
     8→  initContext,
     9→  type KspecContext,
    10→  type LoadedSpecItem,
    11→  type LoadedTask,
    12→  loadAllItems,
    13→  loadAllTasks,
    14→  ReferenceIndex,
    15→  saveTask,
    16→} from "../../parser/index.js";
    17→import { commitIfShadow } from "../../parser/shadow.js";
    18→import type { TaskInput } from "../../schema/index.js";
    19→import { errors } from "../../strings/index.js";
    20→import { EXIT_CODES } from "../exit-codes.js";
    21→import { error, info, isJsonMode, output, warn } from "../output.js";
    22→import { parseIntOption } from "../validators.js";
    23→
    24→/**
    25→ * Fields that contain nested spec items (mirrors yaml.ts)
    26→ */
    27→const _NESTED_ITEM_FIELDS = [
    28→  "modules",
    29→  "features",
    30→  "requirements",
    31→  "constraints",
    32→  "decisions",
    33→];
    34→
    35→/**
    36→ * Get the parent path from a child's _path.
    37→ * e.g., "features[0].requirements[1]" -> "features[0]"
    38→ * Returns empty string for top-level items.
    39→ */
    40→function getParentPath(childPath: string | undefined): string {
    41→  if (!childPath) return "";
    42→  const lastDotIndex = childPath.lastIndexOf(".");
    43→  if (lastDotIndex === -1) return "";
    44→  return childPath.slice(0, lastDotIndex);
    45→}
    46→
    47→/**
    48→ * Check if an item is a direct child of another item based on _path.
    49→ * Direct children have a path that extends the parent's path by exactly one field[index].
    50→ */
    51→function isDirectChildOf(
    52→  child: LoadedSpecItem,
    53→  parent: LoadedSpecItem,
    54→): boolean {
    55→  const childPath = child._path || "";
    56→  const parentPath = parent._path || "";
    57→
    58→  // If paths are equal, not a child
    59→  if (childPath === parentPath) return false;
    60→
    61→  // Child path must start with parent path
    62→  if (parentPath && !childPath.startsWith(`${parentPath}.`)) return false;
    63→
    64→  // For root parent (empty path), child must be a top-level path like "features[0]"
    65→  if (!parentPath) {
    66→    // Direct child of root has no '.' in its path
    67→    return !childPath.includes(".");
    68→  }
    69→
    70→  // Get the remaining path after parent
    71→  const remaining = childPath.slice(parentPath.length + 1);
    72→
    73→  // Direct child has no additional '.' (e.g., "requirements[0]" not "requirements[0].something")
    74→  return !remaining.includes(".");
    75→}
    76→
    77→/**
    78→ * Find the parent spec item of a given item.
    79→ * Returns undefined for root-level items.
    80→ */
    81→function findParentItem(
    82→  item: LoadedSpecItem,
    83→  allItems: LoadedSpecItem[],
    84→): LoadedSpecItem | undefined {
    85→  const parentPath = getParentPath(item._path);
    86→
    87→  // Root-level item or no path
    88→  if (!parentPath && !item._path) return undefined;
    89→  if (!parentPath) return undefined;
    90→
    91→  // Find item with matching path in the same source file
    92→  return allItems.find(
    93→    (i) => i._path === parentPath && i._sourceFile === item._sourceFile,
    94→  );
    95→}
    96→
    97→/**
    98→ * Get direct children of a spec item.
    99→ * Only returns immediate children, not grandchildren.
   100→ */
   101→function getDirectChildren(
   102→  parent: LoadedSpecItem,
   103→  allItems: LoadedSpecItem[],
   104→): LoadedSpecItem[] {
   105→  return allItems.filter(
   106→    (item) =>
   107→      item._sourceFile === parent._sourceFile && isDirectChildOf(item, parent),
   108→  );
   109→}
   110→
   111→/**
   112→ * Collect an item and all its descendants in topological order (parent first).
   113→ * This ensures parent tasks are created before child tasks.
   114→ */
   115→function collectItemsRecursively(
   116→  root: LoadedSpecItem,
   117→  allItems: LoadedSpecItem[],
   118→): LoadedSpecItem[] {
   119→  const result: LoadedSpecItem[] = [root];
   120→  const children = getDirectChildren(root, allItems);
   121→
   122→  for (const child of children) {
   123→    const descendants = collectItemsRecursively(child, allItems);
   124→    result.push(...descendants);
   125→  }
   126→
   127→  return result;
   128→}
   129→
   130→/**
   131→ * Resolve a spec item reference.
   132→ * Returns the spec item or exits with error.
   133→ */
   134→function resolveSpecRef(
   135→  ref: string,
   136→  items: LoadedSpecItem[],
   137→  tasks: LoadedTask[],
   138→  index: ReferenceIndex,
   139→): LoadedSpecItem {
   140→  const result = index.resolve(ref);
   141→
   142→  if (!result.ok) {
   143→    switch (result.error) {
   144→      case "not_found":
   145→        error(errors.reference.specNotFound(ref));
   146→        break;
   147→      case "ambiguous":
   148→        error(errors.reference.ambiguous(ref));
   149→        for (const candidate of result.candidates) {
   150→          const item = items.find((i) => i._ulid === candidate);
   151→          const slug = item?.slugs[0] || "";
   152→          console.error(
   153→            `  - ${index.shortUlid(candidate)} ${slug ? `(${slug})` : ""}`,
   154→          );
   155→        }
   156→        break;
   157→      case "duplicate_slug":
   158→        error(errors.reference.slugMapsToMultiple(ref));
   159→        for (const candidate of result.candidates) {
   160→          console.error(`  - ${index.shortUlid(candidate)}`);
   161→        }
   162→        break;
   163→    }
   164→    process.exit(EXIT_CODES.NOT_FOUND);
   165→  }
   166→
   167→  // Check if it's actually a spec item (not a task)
   168→  const item = items.find((i) => i._ulid === result.ulid);
   169→  if (!item) {
   170→    // Check if it's a task
   171→    const task = tasks.find((t) => t._ulid === result.ulid);
   172→    if (task) {
   173→      error(errors.reference.notSpecItem(ref));
   174→    } else {
   175→      error(errors.reference.specNotFound(ref));
   176→    }
   177→    process.exit(EXIT_CODES.NOT_FOUND);
   178→  }
   179→
   180→  return item;
   181→}
   182→
   183→/**
   184→ * Generate a slug from a spec item title.
   185→ * Converts "My Feature Title" -> "task-my-feature-title"
   186→ */
   187→function generateSlugFromTitle(title: string): string {
   188→  return (
   189→    "task-" +
   190→    title
   191→      .toLowerCase()
   192→      .replace(/[^a-z0-9]+/g, "-")
   193→      .replace(/^-|-$/g, "")
   194→      .slice(0, 50)
   195→  );
   196→}
   197→
   198→/**
   199→ * Convert spec priority to task priority (number).
   200→ * Spec can use 'high', 'medium', 'low' or numeric 1-5.
   201→ */
   202→function normalizePriority(priority: string | number | undefined): number {
   203→  if (priority === undefined) return 3;
   204→  if (typeof priority === "number") return priority;
   205→  switch (priority) {
   206→    case "high":
   207→      return 1;
   208→    case "medium":
   209→      return 3;
   210→    case "low":
   211→      return 5;
   212→    default:
   213→      return 3;
   214→  }
   215→}
   216→
   217→/**
   218→ * Result of deriving a task from a spec item
   219→ */
   220→interface DeriveResult {
   221→  specItem: LoadedSpecItem;
   222→  action: "created" | "skipped" | "would_create";
   223→  task?: LoadedTask;
   224→  reason?: string;
   225→  /** Task ref that was used for depends_on (if any) */
   226→  dependsOn?: string[];
   227→  /** Number of acceptance criteria on the spec item */
   228→  acCount: number;
   229→}
   230→
   231→/**
   232→ * Generate implementation notes from spec item for newly derived task.
   233→ * Includes description and acceptance criteria summary.
   234→ */
   235→function generateImplementationNotes(
   236→  specItem: LoadedSpecItem,
   237→): string | undefined {
   238→  const parts: string[] = [];
   239→
   240→  // Add description if present
   241→  if (specItem.description) {
   242→    parts.push(specItem.description.trim());
   243→  }
   244→
   245→  // Add acceptance criteria summary if present
   246→  if (specItem.acceptance_criteria && specItem.acceptance_criteria.length > 0) {
   247→    const acSection = ["", "Acceptance Criteria:"];
   248→    for (const ac of specItem.acceptance_criteria) {
   249→      const summary = `${ac.given ? `Given ${ac.given}, ` : ""}when ${ac.when}, then ${ac.then}`;
   250→      acSection.push(`- ${ac.id}: ${summary}`);
   251→    }
   252→    parts.push(acSection.join("\n"));
   253→  }
   254→
   255→  // Return combined content, or undefined if nothing to add
   256→  return parts.length > 0 ? parts.join("\n\n") : undefined;
   257→}
   258→
   259→/**
   260→ * Derive a task from a spec item.
   261→ * Returns result describing what happened.
   262→ *
   263→ * @param dependsOn - Task references to add as dependencies (for hierarchy-based deps)
   264→ * @param priority - Priority override (1-5), if not provided uses spec's priority
   265→ */
   266→async function deriveTaskFromSpec(
   267→  ctx: KspecContext,
   268→  specItem: LoadedSpecItem,
   269→  existingTasks: LoadedTask[],
   270→  _items: LoadedSpecItem[],
   271→  index: ReferenceIndex,
   272→  alignmentIndex: AlignmentIndex,
   273→  options: {
   274→    force: boolean;
   275→    dryRun: boolean;
   276→    dependsOn?: string[];
   277→    priority?: number;
   278→    title?: string;
   279→  },
   280→): Promise<DeriveResult> {
   281→  // Count acceptance criteria for display
   282→  const acCount = specItem.acceptance_criteria?.length ?? 0;
   283→
   284→  // Check if a task already exists for this spec
   285→  // AC: @cmd-derive ac-15 - skip cancelled tasks
   286→  const linkedTasks = alignmentIndex.getTasksForSpec(specItem._ulid);
   287→  const activeTasks = linkedTasks.filter((task) => task.status !== "cancelled");
   288→
   289→  if (activeTasks.length > 0 && !options.force) {
   290→    const taskRef = activeTasks[0].slugs[0]
   291→      ? `@${activeTasks[0].slugs[0]}`
   292→      : `@${index.shortUlid(activeTasks[0]._ulid)}`;
   293→    return {
   294→      specItem,
   295→      action: "skipped",
   296→      task: activeTasks[0],
   297→      reason: `task exists: ${taskRef}`,
   298→      acCount,
   299→    };
   300→  }
   301→
   302→  // Check if slug would collide with existing task
   303→  const baseSlug = generateSlugFromTitle(specItem.title);
   304→  let slug = baseSlug;
   305→  let slugSuffix = 1;
   306→
   307→  // Find unique slug if needed
   308→  while (existingTasks.some((t) => t.slugs.includes(slug))) {
   309→    slug = `${baseSlug}-${slugSuffix}`;
   310→    slugSuffix++;
   311→  }
   312→
   313→  // Generate implementation notes from spec
   314→  // AC: @cmd-derive ac-author
   315→  const noteContent = generateImplementationNotes(specItem);
   316→  const initialNotes = noteContent
   317→    ? [
   318→        createNote(
   319→          `Implementation notes (auto-generated from spec):\n\n${noteContent}`,
   320→          getAuthor(ctx.config?.identity?.author),
   321→        ),
   322→      ]
   323→    : [];
   324→
   325→  // Build task input with depends_on and initial notes
   326→  // AC: @derive-title-override ac-1 - use provided title if specified
   327→  const taskInput: TaskInput = {
   328→    title: options.title ?? `Implement: ${specItem.title}`,
   329→    type: "task",
   330→    spec_ref: `@${specItem.slugs[0] || specItem._ulid}`,
   331→    derivation: "auto",
   332→    priority: options.priority ?? normalizePriority(specItem.priority),
   333→    slugs: [slug],
   334→    tags: [...(specItem.tags || [])],
   335→    depends_on: (options.dependsOn || []).map((ref: string) =>
   336→      ref.startsWith("@") ? ref : `@${ref}`,
   337→    ),
   338→    notes: initialNotes,
   339→  };
   340→
   341→  // Dry run - don't actually create
   342→  if (options.dryRun) {
   343→    const previewTask = createTask(taskInput) as LoadedTask;
   344→    return {
   345→      specItem,
   346→      action: "would_create",
   347→      task: previewTask,
   348→      dependsOn: options.dependsOn,
   349→      acCount,
   350→    };
   351→  }
   352→
   353→  // Create and save the task
   354→  const newTask = createTask(taskInput);
   355→  await saveTask(ctx, newTask);
   356→  const specSlug = specItem.slugs[0] || specItem._ulid.slice(0, 8);
   357→  await commitIfShadow(ctx.shadow, "derive", specSlug);
   358→
   359→  // Add to existing tasks list for slug collision checks
   360→  existingTasks.push(newTask as LoadedTask);
   361→
   362→  return {
   363→    specItem,
   364→    action: "created",
   365→    task: newTask as LoadedTask,
   366→    dependsOn: options.dependsOn,
   367→    acCount,
   368→  };
   369→}
   370→
   371→/**
   372→ * Get a task reference string for use in depends_on.
   373→ * Prefers slug over ULID for readability.
   374→ */
   375→function getTaskRef(task: LoadedTask, index: ReferenceIndex): string {
   376→  return task.slugs[0]
   377→    ? `@${task.slugs[0]}`
   378→    : `@${index.shortUlid(task._ulid)}`;
   379→}
   380→
   381→/**
   382→ * Find or get the task for a parent spec item.
   383→ * Looks in:
   384→ * 1. Tasks created in this derive session (specToTaskMap)
   385→ * 2. Existing tasks linked to the parent spec (alignmentIndex)
   386→ *
   387→ * Only returns tasks that are NOT in 'cancelled' state (AC-15).
   388→ */
   389→function getParentTaskRef(
   390→  parentSpec: LoadedSpecItem,
   391→  specToTaskMap: Map<string, LoadedTask>,
   392→  alignmentIndex: AlignmentIndex,
   393→  index: ReferenceIndex,
   394→): string | undefined {
   395→  // Check if we created a task for this parent in this session
   396→  const sessionTask = specToTaskMap.get(parentSpec._ulid);
   397→  if (sessionTask && sessionTask.status !== "cancelled") {
   398→    return getTaskRef(sessionTask, index);
   399→  }
   400→
   401→  // Check if an existing task is linked to this parent spec
   402→  // AC: @cmd-derive ac-15 - skip cancelled tasks
   403→  const linkedTasks = alignmentIndex.getTasksForSpec(parentSpec._ulid);
   404→  const activeTask = linkedTasks.find((task) => task.status !== "cancelled");
   405→  if (activeTask) {
   406→    return getTaskRef(activeTask, index);
   407→  }
   408→
   409→  return undefined;
   410→}
   411→
   412→/**
   413→ * Register the 'derive' command
   414→ */
   415→export function registerDeriveCommand(program: Command): void {
   416→  markMutating(program.command("derive [ref]"))
   417→    .description("Create task(s) from spec item(s)")
   418→    .option("--all", "Derive tasks for all spec items without linked tasks")
   419→    .option(
   420→      "--flat",
   421→      "Only derive for the specified item, not children (default: recursive)",
   422→    )
   423→    .option("--force", "Create task even if one already exists for the spec")
   424→    .option("--dry-run", "Show what would be created without making changes")
   425→    .option("--priority <n>", "Set priority for created task(s) (1-5)")
   426→    .option("--title <title>", "Override task title (default: 'Implement: {spec title}')")
   427→    .action(async (ref: string | undefined, options) => {
   428→      try {
   429→        // Validate arguments
   430→        if (!ref && !options.all) {
   431→          error(errors.usage.deriveNoRef);
   432→          console.error("Usage:");
   433→          console.error("  kspec derive @spec-ref");
   434→          console.error("  kspec derive @spec-ref --flat");
   435→          console.error("  kspec derive --all");
   436→          process.exit(EXIT_CODES.USAGE_ERROR);
   437→        }
   438→
   439→        if (ref && options.all) {
   440→          error(errors.usage.deriveRefAndAll);
   441→          process.exit(EXIT_CODES.USAGE_ERROR);
   442→        }
   443→
   444→        // Validate priority if provided
   445→        if (options.priority !== undefined) {
   446→          const priorityResult = parseIntOption(options.priority, {
   447→            min: 1,
   448→            max: 5,
   449→            name: "Priority",
   450→          });
   451→          if (!priorityResult.ok) {
   452→            error(priorityResult.error);
   453→            process.exit(EXIT_CODES.USAGE_ERROR);
   454→          }
   455→          // Replace raw string with validated number for downstream use
   456→          options.priority = priorityResult.value;
   457→        }
   458→
   459→        const ctx = await initContext();
   460→        const tasks = await loadAllTasks(ctx);
   461→        const items = await loadAllItems(ctx);
   462→        const index = new ReferenceIndex(tasks, items);
   463→
   464→        // Build alignment index
   465→        const alignmentIndex = new AlignmentIndex(tasks, items);
   466→        alignmentIndex.buildLinks(index);
   467→
   468→        // Collect spec items to process
   469→        let specsToDerive: LoadedSpecItem[];
   470→
   471→        if (options.all) {
   472→          // Get all spec items without linked tasks
   473→          specsToDerive = items.filter((item) => {
   474→            const linkedTasks = alignmentIndex.getTasksForSpec(item._ulid);
   475→            return linkedTasks.length === 0 || options.force;
   476→          });
   477→
   478→          if (specsToDerive.length === 0) {
   479→            if (isJsonMode()) {
   480→              console.log(JSON.stringify([]));
   481→            } else {
   482→              info("Nothing to derive (all items have tasks)");
   483→            }
   484→            return;
   485→          }
   486→        } else {
   487→          // Single spec item - recursive by default, flat if --flat
   488→          const specItem = resolveSpecRef(ref!, items, tasks, index);
   489→
   490→          if (options.flat) {
   491→            specsToDerive = [specItem];
   492→          } else {
   493→            // Recursive: collect item and all descendants
   494→            specsToDerive = collectItemsRecursively(specItem, items);
   495→          }
   496→        }
   497→
   498→        // Track spec ULID -> created task for dependency resolution
   499→        const specToTaskMap = new Map<string, LoadedTask>();
   500→
   501→        // Process each spec item in order (parents before children due to topological sort)
   502→        const results: DeriveResult[] = [];
   503→
   504→        for (const specItem of specsToDerive) {
   505→          // Determine depends_on based on parent spec's task
   506→          let dependsOn: string[] | undefined;
   507→
   508→          if (!options.flat && !options.all) {
   509→            // Find the parent spec item
   510→            const parentSpec = findParentItem(specItem, items);
   511→
   512→            if (parentSpec) {
   513→              const parentTaskRef = getParentTaskRef(
   514→                parentSpec,
   515→                specToTaskMap,
   516→                alignmentIndex,
   517→                index,
   518→              );
   519→              if (parentTaskRef) {
   520→                dependsOn = [parentTaskRef];
   521→              }
   522→            }
   523→          }
   524→
   525→          const result = await deriveTaskFromSpec(
   526→            ctx,
   527→            specItem,
   528→            tasks,
   529→            items,
   530→            index,
   531→            alignmentIndex,
   532→            {
   533→              force: options.force || false,
   534→              dryRun: options.dryRun || false,
   535→              dependsOn,
   536→              priority: options.priority,
   537→              title: options.title,
   538→            },
   539→          );
   540→
   541→          // Track created/would_create tasks for dependency resolution
   542→          if (
   543→            result.task &&
   544→            (result.action === "created" || result.action === "would_create")
   545→          ) {
   546→            specToTaskMap.set(specItem._ulid, result.task);
   547→          }
   548→          // Also track skipped tasks (existing) for dependency resolution
   549→          if (result.action === "skipped" && result.task) {
   550→            specToTaskMap.set(specItem._ulid, result.task);
   551→          }
   552→
   553→          results.push(result);
   554→        }
   555→
   556→        // Output results
   557→        if (isJsonMode()) {
   558→          // JSON output format - simplified per AC
   559→          const jsonOutput = results.map((r) => ({
   560→            ulid: r.task?._ulid || null,
   561→            slug: r.task?.slugs[0] || null,
   562→            spec_ref: `@${r.specItem.slugs[0] || r.specItem._ulid}`,
   563→            depends_on: r.task?.depends_on || [],
   564→            action: r.action,
   565→            ac_count: r.acCount,
   566→          }));
   567→          console.log(JSON.stringify(jsonOutput, null, 2));
   568→          return; // Don't call output() which would output full results in global JSON mode
   569→        } else {
   570→          // Human-readable output
   571→          output(results, () => {
   572→            const created = results.filter((r) => r.action === "created");
   573→            const skipped = results.filter((r) => r.action === "skipped");
   574→            const wouldCreate = results.filter(
   575→              (r) => r.action === "would_create",
   576→            );
   577→
   578→            if (options.dryRun) {
   579→              console.log("Would create:");
   580→              for (const r of wouldCreate) {
   581→                const taskSlug = r.task?.slugs[0] || "";
   582→                const deps = r.dependsOn?.length
   583→                  ? ` (depends: ${r.dependsOn.join(", ")})`
   584→                  : "";
   585→                const acInfo = r.acCount > 0 ? ` (${r.acCount} ACs)` : "";
   586→                console.log(`  + ${r.specItem.title}${acInfo}`);
   587→                console.log(`    -> ${taskSlug}${deps}`);
   588→                // Complexity warning for specs with many ACs
   589→                if (r.acCount > 5) {
   590→                  warn(
   591→                    `This spec has ${r.acCount} ACs — consider splitting before implementing.`,
   592→                  );
   593→                }
   594→              }
   595→              if (skipped.length > 0) {
   596→                console.log("\nSkipped:");
   597→                for (const r of skipped) {
   598→                  const specRef = r.specItem.slugs[0]
   599→                    ? `@${r.specItem.slugs[0]}`
   600→                    : `@${index.shortUlid(r.specItem._ulid)}`;
   601→                  console.log(`  - ${specRef} (${r.reason})`);
   602→                }
   603→              }
   604→              console.log(`\nWould create ${wouldCreate.length} task(s)`);
   605→              if (skipped.length > 0) {
   606→                console.log(`Skipped ${skipped.length} (already have tasks)`);
   607→              }
   608→              return;
   609→            }
   610→
   611→            if (created.length > 0) {
   612→              for (const r of created) {
   613→                const taskSlug = r.task?.slugs[0] || "";
   614→                const deps = r.dependsOn?.length
   615→                  ? ` (depends: ${r.dependsOn.join(", ")})`
   616→                  : "";
   617→                const acInfo = r.acCount > 0 ? ` (${r.acCount} ACs)` : "";
   618→                console.log(`OK Created task: ${taskSlug}${acInfo}${deps}`);
   619→                // Complexity warning for specs with many ACs
   620→                if (r.acCount > 5) {
   621→                  warn(
   622→                    `This spec has ${r.acCount} ACs — consider splitting before implementing.`,
   623→                  );
   624→                }
   625→              }
   626→            }
   627→
   628→            if (skipped.length > 0 && !options.all) {
   629→              // Show skipped for explicit derive (not --all)
   630→              for (const r of skipped) {
   631→                const specRef = r.specItem.slugs[0]
   632→                  ? `@${r.specItem.slugs[0]}`
   633→                  : `@${index.shortUlid(r.specItem._ulid)}`;
   634→                console.log(`Skipped ${specRef} (${r.reason})`);
   635→              }
   636→            }
   637→
   638→            // Summary
   639→            if (created.length > 0 || skipped.length > 0) {
   640→              console.log("");
   641→              if (created.length > 0) {
   642→                console.log(`Created ${created.length} task(s)`);
   643→              }
   644→              if (skipped.length > 0) {
   645→                console.log(`Skipped ${skipped.length} (already have tasks)`);
   646→              }
   647→            }
   648→          });
   649→        }
   650→      } catch (err) {
   651→        error(errors.failures.deriveTasks, err);
   652→        process.exit(EXIT_CODES.ERROR);
   653→      }
   654→    });
   655→}
   656→
```