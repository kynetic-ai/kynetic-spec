     1→/**
     2→ * Reference resolution system for @references.
     3→ *
     4→ * Handles resolution of @slug and @ulid references to actual items,
     5→ * with proper error handling for not-found and ambiguous cases.
     6→ */
     7→
     8→import type { LoadedMetaItem } from "./meta.js";
     9→import type { LoadedPlan } from "./plans.js";
    10→import type { AnyLoadedItem, LoadedSpecItem, LoadedTask } from "./yaml.js";
    11→
    12→// ============================================================
    13→// TYPES
    14→// ============================================================
    15→
    16→/**
    17→ * Successful resolution result
    18→ * AC: @agent-definitions ac-agent-3
    19→ */
    20→export interface ResolveSuccess {
    21→  ok: true;
    22→  ulid: string;
    23→  item: AnyLoadedItem | LoadedMetaItem;
    24→  /** How the reference was matched */
    25→  matchType: "slug" | "ulid-full" | "ulid-prefix";
    26→}
    27→
    28→/**
    29→ * Failed resolution - reference not found
    30→ */
    31→export interface ResolveNotFound {
    32→  ok: false;
    33→  error: "not_found";
    34→  ref: string;
    35→}
    36→
    37→/**
    38→ * Failed resolution - ambiguous ULID prefix
    39→ */
    40→export interface ResolveAmbiguous {
    41→  ok: false;
    42→  error: "ambiguous";
    43→  ref: string;
    44→  /** The matching ULIDs */
    45→  candidates: string[];
    46→}
    47→
    48→/**
    49→ * Failed resolution - duplicate slug
    50→ */
    51→export interface ResolveDuplicateSlug {
    52→  ok: false;
    53→  error: "duplicate_slug";
    54→  ref: string;
    55→  /** The ULIDs that share this slug */
    56→  candidates: string[];
    57→}
    58→
    59→export type ResolveResult =
    60→  | ResolveSuccess
    61→  | ResolveNotFound
    62→  | ResolveAmbiguous
    63→  | ResolveDuplicateSlug;
    64→
    65→/**
    66→ * Validation error for a single reference
    67→ */
    68→export interface RefValidationError {
    69→  /** The reference string that failed */
    70→  ref: string;
    71→  /** Where this reference was found */
    72→  sourceFile?: string;
    73→  /** The item containing this reference */
    74→  sourceUlid?: string;
    75→  /** The field containing this reference */
    76→  field: string;
    77→  /** Error type */
    78→  error: "not_found" | "ambiguous" | "duplicate_slug";
    79→  /** Additional context */
    80→  message: string;
    81→}
    82→
    83→/**
    84→ * Validation warning for a single reference
    85→ */
    86→export interface RefValidationWarning {
    87→  /** The reference string */
    88→  ref: string;
    89→  /** Where this reference was found */
    90→  sourceFile?: string;
    91→  /** The item containing this reference */
    92→  sourceUlid?: string;
    93→  /** The field containing this reference */
    94→  field: string;
    95→  /** Warning type */
    96→  warning: "deprecated_target";
    97→  /** Additional context */
    98→  message: string;
    99→}
   100→
   101→// ============================================================
   102→// REFERENCE INDEX
   103→// ============================================================
   104→
   105→/**
   106→ * Index for efficient reference resolution.
   107→ * Build once when loading the spec, then resolve many times.
   108→ * AC: @agent-definitions ac-agent-3
   109→ */
   110→export class ReferenceIndex {
   111→  /** slug → ULID mapping */
   112→  private slugIndex = new Map<string, string[]>();
   113→
   114→  /** ULID → item mapping */
   115→  private ulidIndex = new Map<string, AnyLoadedItem | LoadedMetaItem>();
   116→
   117→  /** All ULIDs for prefix matching */
   118→  private allUlids: string[] = [];
   119→
   120→  /**
   121→   * Build index from loaded items and meta items
   122→   * AC: @agent-definitions ac-agent-3
   123→   * AC: @plan-validation ac-10
   124→   */
   125→  constructor(
   126→    tasks: LoadedTask[],
   127→    items: LoadedSpecItem[],
   128→    metaItems: LoadedMetaItem[] = [],
   129→    plans: LoadedPlan[] = [],
   130→  ) {
   131→    // Index tasks
   132→    for (const task of tasks) {
   133→      this.indexItem(task);
   134→    }
   135→
   136→    // Index spec items
   137→    for (const item of items) {
   138→      this.indexItem(item);
   139→    }
   140→
   141→    // Index plans
   142→    // AC: @plan-validation ac-10
   143→    for (const plan of plans) {
   144→      this.indexPlan(plan);
   145→    }
   146→
   147→    // Index meta items (agents, workflows, conventions, observations)
   148→    // AC: @agent-definitions ac-agent-3
   149→    for (const metaItem of metaItems) {
   150→      this.indexMetaItem(metaItem);
   151→    }
   152→
   153→    // Sort ULIDs for consistent ordering
   154→    this.allUlids.sort();
   155→  }
   156→
   157→  private indexItem(item: AnyLoadedItem): void {
   158→    const ulid = item._ulid;
   159→
   160→    // Index by ULID
   161→    this.ulidIndex.set(ulid, item);
   162→    this.allUlids.push(ulid);
   163→
   164→    // Index by slugs
   165→    for (const slug of item.slugs) {
   166→      const existing = this.slugIndex.get(slug);
   167→      if (existing) {
   168→        existing.push(ulid);
   169→      } else {
   170→        this.slugIndex.set(slug, [ulid]);
   171→      }
   172→    }
   173→  }
   174→
   175→  /**
   176→   * Index a plan
   177→   * AC: @plan-validation ac-10
   178→   */
   179→  private indexPlan(plan: LoadedPlan): void {
   180→    const ulid = plan._ulid;
   181→
   182→    // Index by ULID
   183→    this.ulidIndex.set(ulid, plan as unknown as AnyLoadedItem);
   184→    this.allUlids.push(ulid);
   185→
   186→    // Index by slugs
   187→    for (const slug of plan.slugs) {
   188→      const existing = this.slugIndex.get(slug);
   189→      if (existing) {
   190→        existing.push(ulid);
   191→      } else {
   192→        this.slugIndex.set(slug, [ulid]);
   193→      }
   194→    }
   195→  }
   196→
   197→  /**
   198→   * Index a meta item (agent, workflow, convention, observation)
   199→   * Meta items use 'id' field as their slug
   200→   * AC: @agent-definitions ac-agent-3
   201→   */
   202→  private indexMetaItem(item: LoadedMetaItem): void {
   203→    const ulid = item._ulid;
   204→
   205→    // Index by ULID
   206→    this.ulidIndex.set(ulid, item);
   207→    this.allUlids.push(ulid);
   208→
   209→    // Index by id (acts like a slug for meta items)
   210→    const metaItem = item as { id?: string };
   211→    if (metaItem.id) {
   212→      const existing = this.slugIndex.get(metaItem.id);
   213→      if (existing) {
   214→        existing.push(ulid);
   215→      } else {
   216→        this.slugIndex.set(metaItem.id, [ulid]);
   217→      }
   218→    }
   219→  }
   220→
   221→  /**
   222→   * Resolve a reference to an item.
   223→   *
   224→   * Resolution order:
   225→   * 1. Exact slug match
   226→   * 2. Full ULID match
   227→   * 3. ULID prefix match (must be unique)
   228→   */
   229→  resolve(ref: string): ResolveResult {
   230→    // Strip @ prefix if present
   231→    const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
   232→    const cleanRefLower = cleanRef.toLowerCase();
   233→
   234→    // 1. Try slug match first
   235→    const slugMatches = this.slugIndex.get(cleanRef);
   236→    if (slugMatches) {
   237→      if (slugMatches.length > 1) {
   238→        return {
   239→          ok: false,
   240→          error: "duplicate_slug",
   241→          ref,
   242→          candidates: slugMatches,
   243→        };
   244→      }
   245→      const ulid = slugMatches[0];
   246→      const item = this.ulidIndex.get(ulid)!;
   247→      return { ok: true, ulid, item, matchType: "slug" };
   248→    }
   249→
   250→    // 2. Try full ULID match
   251→    const exactMatch = this.ulidIndex.get(cleanRef.toUpperCase());
   252→    if (exactMatch) {
   253→      return {
   254→        ok: true,
   255→        ulid: exactMatch._ulid,
   256→        item: exactMatch,
   257→        matchType: "ulid-full",
   258→      };
   259→    }
   260→
   261→    // 3. Try ULID prefix match
   262→    const prefixMatches = this.allUlids.filter((ulid) =>
   263→      ulid.toLowerCase().startsWith(cleanRefLower),
   264→    );
   265→
   266→    if (prefixMatches.length === 0) {
   267→      return { ok: false, error: "not_found", ref };
   268→    }
   269→
   270→    if (prefixMatches.length > 1) {
   271→      return {
   272→        ok: false,
   273→        error: "ambiguous",
   274→        ref,
   275→        candidates: prefixMatches,
   276→      };
   277→    }
   278→
   279→    const ulid = prefixMatches[0];
   280→    const item = this.ulidIndex.get(ulid)!;
   281→    return { ok: true, ulid, item, matchType: "ulid-prefix" };
   282→  }
   283→
   284→  /**
   285→   * Check if a slug is available (not used by any indexed item).
   286→   * Returns true only when the slug is completely unused.
   287→   * A slug is unavailable if it resolves to an item, is ambiguous, or is duplicated.
   288→   */
   289→  isSlugAvailable(slug: string): boolean {
   290→    const result = this.resolve(slug.startsWith("@") ? slug : `@${slug}`);
   291→    return !result.ok && result.error === "not_found";
   292→  }
   293→
   294→  /**
   295→   * Get an item by exact ULID (no resolution, direct lookup)
   296→   */
   297→  getByUlid(ulid: string): AnyLoadedItem | LoadedMetaItem | undefined {
   298→    return this.ulidIndex.get(ulid);
   299→  }
   300→
   301→  /**
   302→   * Get the minimum unique prefix for a ULID.
   303→   * Returns the shortest prefix that uniquely identifies this ULID
   304→   * among all indexed items.
   305→   *
   306→   * @param ulid The full ULID to shorten
   307→   * @param minLength Minimum prefix length (default 8)
   308→   * @returns Shortest unique prefix
   309→   */
   310→  shortUlid(ulid: string, minLength = 8): string {
   311→    // Start with minimum length
   312→    let length = minLength;
   313→
   314→    while (length < ulid.length) {
   315→      const prefix = ulid.slice(0, length);
   316→      const matches = this.allUlids.filter((u) =>
   317→        u.toUpperCase().startsWith(prefix.toUpperCase()),
   318→      );
   319→
   320→      if (matches.length === 1) {
   321→        return prefix;
   322→      }
   323→
   324→      length++;
   325→    }
   326→
   327→    // Return full ULID if no shorter unique prefix found
   328→    return ulid;
   329→  }
   330→
   331→  /**
   332→   * Get all indexed ULIDs
   333→   */
   334→  getAllUlids(): string[] {
   335→    return [...this.allUlids];
   336→  }
   337→
   338→  /**
   339→   * Get all slugs and their mappings
   340→   */
   341→  getAllSlugs(): Map<string, string[]> {
   342→    return new Map(this.slugIndex);
   343→  }
   344→
   345→  /**
   346→   * Check if a slug exists
   347→   */
   348→  hasSlug(slug: string): boolean {
   349→    return this.slugIndex.has(slug);
   350→  }
   351→
   352→  /**
   353→   * Get count of indexed items
   354→   */
   355→  get size(): number {
   356→    return this.ulidIndex.size;
   357→  }
   358→}
   359→
   360→// ============================================================
   361→// VALIDATION
   362→// ============================================================
   363→
   364→/**
   365→ * Fields that contain references
   366→ * AC: @agent-definitions ac-agent-3 - added_by for agent references
   367→ * AC: @workflow-definitions ac-workflow-3 - meta_ref for workflow references
   368→ * AC: @traits-field ac-1 - traits field contains refs to trait-type items
   369→ */
   370→const REF_FIELDS = [
   371→  "depends_on",
   372→  "blocked_by",
   373→  "implements",
   374→  "relates_to",
   375→  "tests",
   376→  "supersedes",
   377→  "spec_ref",
   378→  "plan_ref", // AC: @plan-validation ac-10 - Plan reference
   379→  "context",
   380→  "added_by", // Agent reference
   381→  "author", // Agent reference
   382→  "resolved_by", // Agent reference
   383→  "workflow_ref", // Workflow reference
   384→  "meta_ref", // Meta reference (workflow, agent, convention)
   385→  "traits", // Trait references (AC: @traits-field ac-1)
   386→];
   387→
   388→/**
   389→ * Check if an item is deprecated
   390→ */
   391→function isDeprecated(item: AnyLoadedItem | LoadedMetaItem): boolean {
   392→  const obj = item as unknown as Record<string, unknown>;
   393→
   394→  // Check for deprecated_in field (truthy value means deprecated)
   395→  if ("deprecated_in" in obj && obj.deprecated_in) {
   396→    return true;
   397→  }
   398→
   399→  // Check for maturity: deprecated status
   400→  if ("status" in obj && obj.status && typeof obj.status === "object") {
   401→    const status = obj.status as Record<string, unknown>;
   402→    if ("maturity" in status && status.maturity === "deprecated") {
   403→      return true;
   404→    }
   405→  }
   406→
   407→  // Also check top-level maturity field (some items may have it there)
   408→  if ("maturity" in obj && obj.maturity === "deprecated") {
   409→    return true;
   410→  }
   411→
   412→  return false;
   413→}
   414→
   415→/**
   416→ * Extract all references from an item
   417→ * AC: @agent-definitions ac-agent-3 - also checks nested notes for author refs
   418→ */
   419→function extractRefs(
   420→  item: AnyLoadedItem,
   421→): Array<{ field: string; ref: string }> {
   422→  const refs: Array<{ field: string; ref: string }> = [];
   423→  const obj = item as unknown as Record<string, unknown>;
   424→
   425→  for (const field of REF_FIELDS) {
   426→    const value = obj[field];
   427→
   428→    if (typeof value === "string" && value.startsWith("@")) {
   429→      refs.push({ field, ref: value });
   430→    } else if (Array.isArray(value)) {
   431→      for (const v of value) {
   432→        if (typeof v === "string" && v.startsWith("@")) {
   433→          refs.push({ field, ref: v });
   434→        }
   435→      }
   436→    }
   437→  }
   438→
   439→  // Check nested notes for author references
   440→  // AC: @agent-definitions ac-agent-3
   441→  if ("notes" in obj && Array.isArray(obj.notes)) {
   442→    for (const note of obj.notes) {
   443→      if (note && typeof note === "object" && "author" in note) {
   444→        const author = (note as { author?: string }).author;
   445→        if (typeof author === "string" && author.startsWith("@")) {
   446→          refs.push({ field: "notes[].author", ref: author });
   447→        }
   448→      }
   449→    }
   450→  }
   451→
   452→  // Check nested todos for added_by references
   453→  if ("todos" in obj && Array.isArray(obj.todos)) {
   454→    for (const todo of obj.todos) {
   455→      if (todo && typeof todo === "object" && "added_by" in todo) {
   456→        const addedBy = (todo as { added_by?: string }).added_by;
   457→        if (typeof addedBy === "string" && addedBy.startsWith("@")) {
   458→          refs.push({ field: "todos[].added_by", ref: addedBy });
   459→        }
   460→      }
   461→    }
   462→  }
   463→
   464→  return refs;
   465→}
   466→
   467→/**
   468→ * Validation result with errors and warnings
   469→ */
   470→export interface RefValidationResult {
   471→  errors: RefValidationError[];
   472→  warnings: RefValidationWarning[];
   473→}
   474→
   475→/**
   476→ * Validate all references in the spec.
   477→ * Returns list of validation errors and warnings.
   478→ */
   479→export function validateRefs(
   480→  index: ReferenceIndex,
   481→  tasks: LoadedTask[],
   482→  items: LoadedSpecItem[],
   483→): RefValidationResult {
   484→  const errors: RefValidationError[] = [];
   485→  const warnings: RefValidationWarning[] = [];
   486→
   487→  const allItems: AnyLoadedItem[] = [...tasks, ...items];
   488→
   489→  for (const item of allItems) {
   490→    const refs = extractRefs(item);
   491→    const sourceFile = (item as LoadedTask | LoadedSpecItem)._sourceFile;
   492→
   493→    // Track traits for duplicate detection (AC: @traits-field ac-5)
   494→    const seenTraits = new Set<string>();
   495→
   496→    for (const { field, ref } of refs) {
   497→      const result = index.resolve(ref);
   498→
   499→      if (!result.ok) {
   500→        let message: string;
   501→
   502→        switch (result.error) {
   503→          case "not_found":
   504→            message = `Reference "${ref}" not found`;
   505→            break;
   506→          case "ambiguous":
   507→            message = `Reference "${ref}" is ambiguous, matches: ${result.candidates.join(", ")}`;
   508→            break;
   509→          case "duplicate_slug":
   510→            message = `Slug "${ref}" maps to multiple items: ${result.candidates.join(", ")}`;
   511→            break;
   512→        }
   513→
   514→        errors.push({
   515→          ref,
   516→          sourceFile,
   517→          sourceUlid: item._ulid,
   518→          field,
   519→          error: result.error,
   520→          message,
   521→        });
   522→      } else {
   523→        // Check if resolved target is deprecated
   524→        if (isDeprecated(result.item)) {
   525→          const targetTitle =
   526→            (result.item as { title?: string }).title || result.ulid;
   527→          warnings.push({
   528→            ref,
   529→            sourceFile,
   530→            sourceUlid: item._ulid,
   531→            field,
   532→            warning: "deprecated_target",
   533→            message: `Reference "${ref}" points to deprecated item: ${targetTitle}`,
   534→          });
   535→        }
   536→
   537→        // AC: @traits-field ac-3 - traits ref must point to trait-type item
   538→        if (field === "traits") {
   539→          const targetItem = result.item as { type?: string };
   540→          if (targetItem.type !== "trait") {
   541→            errors.push({
   542→              ref,
   543→              sourceFile,
   544→              sourceUlid: item._ulid,
   545→              field,
   546→              error: "not_found", // Reuse error type
   547→              message: `Trait reference "${ref}" points to non-trait item (type: ${targetItem.type || "unknown"})`,
   548→            });
   549→          }
   550→
   551→          // AC: @traits-field ac-5 - warn on duplicate traits
   552→          if (seenTraits.has(result.ulid)) {
   553→            const targetTitle =
   554→              (result.item as { title?: string }).title || result.ulid;
   555→            warnings.push({
   556→              ref,
   557→              sourceFile,
   558→              sourceUlid: item._ulid,
   559→              field,
   560→              warning: "deprecated_target", // Reuse warning type for now
   561→              message: `Duplicate trait reference "${ref}" (${targetTitle})`,
   562→            });
   563→          }
   564→          seenTraits.add(result.ulid);
   565→        }
   566→
   567→        // AC: @plan-validation ac-10 - plan_ref must point to a plan
   568→        if (field === "plan_ref") {
   569→          const targetItem = result.item as {
   570→            derived_tasks?: unknown[];
   571→            derived_specs?: unknown[];
   572→          };
   573→          // Plans have derived_tasks and derived_specs fields that tasks don't have
   574→          const isPlan =
   575→            "derived_tasks" in targetItem || "derived_specs" in targetItem;
   576→
   577→          if (!isPlan) {
   578→            warnings.push({
   579→              ref,
   580→              sourceFile,
   581→              sourceUlid: item._ulid,
   582→              field,
   583→              warning: "deprecated_target", // Reuse warning type
   584→              message: `Plan reference "${ref}" points to non-plan item`,
   585→            });
   586→          }
   587→        }
   588→      }
   589→    }
   590→  }
   591→
   592→  return { errors, warnings };
   593→}
   594→
   595→/**
   596→ * Find duplicate slugs in the index.
   597→ * Returns map of slug → ULIDs for slugs with multiple items.
   598→ */
   599→export function findDuplicateSlugs(
   600→  index: ReferenceIndex,
   601→): Map<string, string[]> {
   602→  const duplicates = new Map<string, string[]>();
   603→
   604→  for (const [slug, ulids] of index.getAllSlugs()) {
   605→    if (ulids.length > 1) {
   606→      duplicates.set(slug, ulids);
   607→    }
   608→  }
   609→
   610→  return duplicates;
   611→}
   612→
   613→// ============================================================
   614→// SLUG UNIQUENESS CHECK
   615→// ============================================================
   616→
   617→/**
   618→ * Result of checking slug uniqueness
   619→ */
   620→export interface SlugCheckSuccess {
   621→  ok: true;
   622→}
   623→
   624→export interface SlugCheckConflict {
   625→  ok: false;
   626→  slug: string;
   627→  existingUlid: string;
   628→}
   629→
   630→export type SlugCheckResult = SlugCheckSuccess | SlugCheckConflict;
   631→
   632→/**
   633→ * Check if proposed slugs are unique (don't conflict with existing items).
   634→ *
   635→ * @param index The reference index to check against
   636→ * @param slugs Array of proposed slugs to check
   637→ * @param excludeUlid Optional ULID to exclude from conflict check (for updates)
   638→ * @returns Success if all slugs are available, or conflict info if one exists
   639→ */
   640→export function checkSlugUniqueness(
   641→  index: ReferenceIndex,
   642→  slugs: string[],
   643→  excludeUlid?: string,
   644→): SlugCheckResult {
   645→  const allSlugs = index.getAllSlugs();
   646→
   647→  for (const slug of slugs) {
   648→    const existingUlids = allSlugs.get(slug);
   649→    if (existingUlids) {
   650→      // Filter out the item being updated (if provided)
   651→      const conflictingUlids = excludeUlid
   652→        ? existingUlids.filter((ulid) => ulid !== excludeUlid)
   653→        : existingUlids;
   654→
   655→      if (conflictingUlids.length > 0) {
   656→        return {
   657→          ok: false,
   658→          slug,
   659→          existingUlid: conflictingUlids[0],
   660→        };
   661→      }
   662→    }
   663→  }
   664→
   665→  return { ok: true };
   666→}
   667→
```