```
     1→/**
     2→ * Plan import CLI command
     3→ * AC: @plan-import ac-11 through ac-33
     4→ */
     5→
     6→import * as fs from "node:fs/promises";
     7→import * as path from "node:path";
     8→import type { Command } from "commander";
     9→import { markMutating } from "../command-annotations.js";
    10→import {
    11→  addChildItem,
    12→  buildIndexes,
    13→  createPlan,
    14→  createSpecItem,
    15→  createTask,
    16→  getAuthor,
    17→  initContext,
    18→  loadAllTasks,
    19→  loadPlans,
    20→  savePlan,
    21→  saveTask,
    22→  updateSpecItem,
    23→  type LoadedSpecItem,
    24→} from "../../parser/index.js";
    25→import {
    26→  parsePlanDocument,
    27→  topologicalSort,
    28→  validateParentRefs,
    29→  type PlanSpec,
    30→} from "../../parser/plan-document.js";
    31→import { commitIfShadow } from "../../parser/shadow.js";
    32→import { normalizeRefInput } from "../../schema/index.js";
    33→import type { PlanInput, SpecItemInput, TaskInput } from "../../schema/index.js";
    34→import { errors } from "../../strings/index.js";
    35→import { EXIT_CODES } from "../exit-codes.js";
    36→import { error, info, isJsonMode, output, success, warn } from "../output.js";
    37→import { ulid } from "ulid";
    38→
    39→/**
    40→ * Register plan import command
    41→ * AC: @plan-import ac-11, ac-15, ac-32
    42→ */
    43→export function registerPlanImportCommand(planCommand: Command): void {
    44→  markMutating(planCommand.command("import <path>"))
    45→    .description("Import plan document and auto-generate specs/tasks")
    46→    .requiredOption(
    47→      "--module <ref>",
    48→      "Module to add specs under (e.g., @core-module)",
    49→    )
    50→    .option("--dry-run", "Show what would be created without making changes")
    51→    .option("--update", "Update existing specs instead of skipping them")
    52→    .option("--json", "Output as JSON")
    53→    .addHelpText(
    54→      "after",
    55→      `
    56→Format:
    57→  Plan documents use markdown with a ## Specs section containing a fenced
    58→  YAML code block. The YAML must be wrapped in triple-backtick yaml markers:
    59→
    60→    ## Specs
    61→    \`\`\`yaml
    62→    - title: My Feature
    63→      type: feature
    64→    \`\`\`
    65→
    66→  Without the fenced code block, specs will not be detected.
    67→
    68→Examples:
    69→  $ kspec plan import ./plan.md --module @core
    70→  $ kspec plan import ./plan.md --module @api --dry-run
    71→  $ kspec plan import ./plan.md --module @features --update --json`,
    72→    )
    73→    .action(async (planPath: string, options) => {
    74→      try {
    75→        await importPlan(planPath, options);
    76→      } catch (err) {
    77→        error("Failed to import plan", err);
    78→        process.exit(EXIT_CODES.ERROR);
    79→      }
    80→    });
    81→}
    82→
    83→/**
    84→ * Import operation result
    85→ */
    86→interface ImportResult {
    87→  createdSpecs: string[];
    88→  updatedSpecs: string[];
    89→  createdTasks: string[];
    90→  errors: Array<{ message: string; spec?: PlanSpec }>;
    91→  skipped: Array<{ slug: string; reason: string }>;
    92→  planRef: string;
    93→}
    94→
    95→/**
    96→ * Import plan document and create specs/tasks
    97→ * AC: @plan-import ac-11 through ac-33
    98→ */
    99→async function importPlan(
   100→  planPath: string,
   101→  options: { module: string; dryRun?: boolean; update?: boolean },
   102→): Promise<void> {
   103→  // JSON mode is set by global preAction hook
   104→
   105→  const ctx = await initContext();
   106→  const author = getAuthor(ctx.config?.identity?.author);
   107→
   108→  // Read plan file
   109→  // AC: @plan-import ac-21 - Handle file read errors
   110→  const fullPath = path.resolve(process.cwd(), planPath);
   111→  let content: string;
   112→  try {
   113→    content = await fs.readFile(fullPath, "utf-8");
   114→  } catch (err) {
   115→    error(`Failed to read plan file: ${planPath}`, err);
   116→    process.exit(EXIT_CODES.USAGE_ERROR);
   117→  }
   118→
   119→  // Parse plan document
   120→  // AC: @plan-import ac-11, ac-12, ac-13, ac-21, ac-22
   121→  const parsed = parsePlanDocument(content);
   122→
   123→  // Report parsing errors
   124→  if (parsed.errors.length > 0) {
   125→    for (const err of parsed.errors) {
   126→      if (err.type === "yaml") {
   127→        // AC: @plan-import ac-21 - YAML parse errors (fatal)
   128→        error(err.message);
   129→        process.exit(EXIT_CODES.USAGE_ERROR);
   130→      } else if (err.type === "validation") {
   131→        // AC: @plan-import ac-22 - Validation errors (non-fatal, add to warnings)
   132→        warn(err.message);
   133→      }
   134→    }
   135→  }
   136→
   137→  // Load plans for cross-namespace slug safety
   138→  const plans = await loadPlans(ctx);
   139→
   140→  // Build indexes to check existing specs (include plans for cross-namespace slug safety)
   141→  const { refIndex, items } = await buildIndexes(ctx, plans);
   142→  const existingSpecRefs = new Set<string>();
   143→  for (const item of items) {
   144→    for (const slug of (item as LoadedSpecItem).slugs || []) {
   145→      existingSpecRefs.add(slug);
   146→    }
   147→    existingSpecRefs.add(item._ulid.slice(0, 8));
   148→  }
   149→
   150→  // Resolve module reference
   151→  const moduleResult = refIndex.resolve(options.module);
   152→  if (!moduleResult.ok) {
   153→    error(errors.reference.itemNotFound(options.module));
   154→    process.exit(EXIT_CODES.NOT_FOUND);
   155→  }
   156→
   157→  const moduleItem = moduleResult.item as LoadedSpecItem;
   158→
   159→  // Verify it's a module
   160→  if (moduleItem.type !== "module") {
   161→    error(`${options.module} is not a module (type: ${moduleItem.type})`);
   162→    process.exit(EXIT_CODES.USAGE_ERROR);
   163→  }
   164→
   165→  // Validate parent references
   166→  // AC: @plan-import ac-17, ac-33
   167→  const parentErrors = validateParentRefs(parsed.specs, existingSpecRefs);
   168→  parsed.errors.push(...parentErrors);
   169→
   170→  // Sort specs topologically
   171→  // AC: @plan-import ac-16, ac-18
   172→  const { sorted, error: sortError } = topologicalSort(parsed.specs);
   173→  if (sortError) {
   174→    // AC: @plan-import ac-18 - Circular dependency detection
   175→    error(sortError.message);
   176→    process.exit(EXIT_CODES.USAGE_ERROR);
   177→  }
   178→
   179→  // Create plan record
   180→  // AC: @plan-import ac-24, ac-28
   181→  // Auto-namespace plan slugs with "plan-" prefix to prevent collision with spec slugs
   182→  // Ensure uniqueness across all namespaces (plans + specs + tasks via refIndex)
   183→  let planSlug = `plan-${generateSlug(parsed.title)}`;
   184→  let counter = 1;
   185→  const baseSlug = planSlug;
   186→  while (!refIndex.isSlugAvailable(planSlug)) {
   187→    planSlug = `${baseSlug}-${counter}`;
   188→    counter++;
   189→  }
   190→
   191→  // Track all slugs created during this import (refIndex is stale after mutations)
   192→  const importReservedSlugs = new Set<string>([planSlug]);
   193→
   194→  const planInput: PlanInput = {
   195→    title: parsed.title,
   196→    content: parsed.content,
   197→    status: "active",
   198→    slugs: [planSlug],
   199→    source_path: fullPath,
   200→  };
   201→
   202→  const newPlan = createPlan(planInput);
   203→  const planRef = `@${planSlug}`;
   204→
   205→  // AC: @plan-import ac-13 - Attach global implementation notes to plan record
   206→  if (parsed.implementationNotes) {
   207→    newPlan.notes.push({
   208→      _ulid: ulid(),
   209→      created_at: new Date().toISOString(),
   210→      author,
   211→      content: `Implementation notes:\n\n${parsed.implementationNotes}`,
   212→    });
   213→  }
   214→
   215→  // Initialize result
   216→  const result: ImportResult = {
   217→    createdSpecs: [],
   218→    updatedSpecs: [],
   219→    createdTasks: [],
   220→    errors: [],
   221→    skipped: [],
   222→    planRef,
   223→  };
   224→
   225→  // Add parser validation errors to result
   226→  // AC: @plan-import ac-22, ac-29 - Include parser validation errors in summary
   227→  for (const err of parsed.errors) {
   228→    if (err.type === "validation") {
   229→      result.errors.push({ message: err.message });
   230→    }
   231→  }
   232→
   233→  // Track newly created specs for parent resolution
   234→  // AC: @plan-import ac-16 - Resolve local references
   235→  const createdSpecsMap = new Map<string, LoadedSpecItem>();
   236→
   237→  // Process specs
   238→  // AC: @plan-import ac-14, ac-16, ac-17, ac-22, ac-23, ac-25, ac-26, ac-29
   239→  for (let i = 0; i < sorted.length; i++) {
   240→    const spec = sorted[i];
   241→    try {
   242→      // Validate required fields first
   243→      // AC: @plan-import ac-22
   244→      if (!spec.title) {
   245→        const errMsg = `Spec at index ${i} missing required field: title`;
   246→        warn(errMsg);
   247→        result.errors.push({ message: errMsg, spec });
   248→        continue;
   249→      }
   250→
   251→      const specSlug = spec.slug || generateSlug(spec.title);
   252→      const specRef = `@${specSlug}`;
   253→
   254→      // Check against slugs reserved during this import (plan slug, earlier specs)
   255→      if (importReservedSlugs.has(specSlug)) {
   256→        warn(`Spec slug "${specSlug}" collides with another item in this import, skipping`);
   257→        result.skipped.push({ slug: specSlug, reason: "Slug collision within import" });
   258→        continue;
   259→      }
   260→
   261→      // Check if spec already exists in pre-import state
   262→      const exists = refIndex.resolve(specRef);
   263→
   264→      if (exists.ok && !options.update) {
   265→        // AC: @plan-import ac-14, ac-25 - Skip existing specs
   266→        warn(`Skipping existing spec: ${specRef}`);
   267→        result.skipped.push({ slug: specSlug, reason: "Already exists" });
   268→        continue;
   269→      }
   270→
   271→      if (exists.ok && options.update) {
   272→        // AC: @plan-import ac-26 - Update existing spec
   273→        // Updates: description, type, tags, traits, and acceptance_criteria
   274→        const existingSpec = exists.item as LoadedSpecItem;
   275→
   276→        if (options.dryRun) {
   277→          info(`Would update spec: ${specRef}`);
   278→          result.updatedSpecs.push(specRef);
   279→        } else {
   280→          // Build updates from plan spec
   281→          const updates: Partial<SpecItemInput> = {};
   282→
   283→          if (spec.description !== undefined) {
   284→            updates.description = spec.description;
   285→          }
   286→          if (spec.type !== undefined) {
   287→            updates.type = spec.type as SpecItemInput["type"];
   288→          }
   289→          if (spec.traits !== undefined) {
   290→            updates.traits = spec.traits.map(normalizeRefInput);
   291→          }
   292→          if (spec.acceptance_criteria !== undefined) {
   293→            updates.acceptance_criteria = spec.acceptance_criteria;
   294→          }
   295→
   296→          await updateSpecItem(ctx, existingSpec, updates);
   297→          info(`Updated spec: ${specRef}`);
   298→          result.updatedSpecs.push(specRef);
   299→        }
   300→        continue;
   301→      }
   302→
   303→      // Resolve parent reference
   304→      // AC: @plan-import ac-16, ac-17
   305→      let parent: LoadedSpecItem | null = null;
   306→      if (spec.parent) {
   307→        const parentRef = normalizeRefInput(spec.parent);
   308→
   309→        // Check if parent was just created in this import
   310→        const parentSlug = parentRef.slice(1);
   311→        if (createdSpecsMap.has(parentSlug)) {
   312→          parent = createdSpecsMap.get(parentSlug)!;
   313→        } else {
   314→          // Check existing specs
   315→          const parentResult = refIndex.resolve(parentRef);
   316→
   317→          if (!parentResult.ok) {
   318→            // AC: @plan-import ac-17, ac-33 - Missing parent with hint
   319→            const errMsg = `Parent ${parentRef} not found. Check parent exists or define it earlier in plan`;
   320→            warn(errMsg);
   321→            result.errors.push({ message: errMsg, spec });
   322→            result.skipped.push({ slug: specSlug, reason: "Missing parent" });
   323→            continue;
   324→          }
   325→
   326→          parent = parentResult.item as LoadedSpecItem;
   327→        }
   328→      }
   329→
   330→      if (options.dryRun) {
   331→        // AC: @plan-import ac-15 - Dry run mode
   332→        info(
   333→          `Would create spec: ${specRef} ${spec.parent ? `under ${spec.parent}` : "(root)"}`,
   334→        );
   335→        result.createdSpecs.push(specRef);
   336→        importReservedSlugs.add(specSlug);
   337→
   338→        // Track would-be created spec for parent resolution in dry-run
   339→        const dryRunSpec = createSpecItem({
   340→          title: spec.title,
   341→          type: (spec.type as any) || "feature",
   342→          slugs: [specSlug],
   343→          description: spec.description,
   344→          ...(spec.acceptance_criteria ? { acceptance_criteria: spec.acceptance_criteria } : {}),
   345→          priority: undefined,
   346→          tags: [],
   347→          depends_on: [],
   348→          implements: [],
   349→          relates_to: [],
   350→          tests: [],
   351→          traits: (spec.traits || []).map(normalizeRefInput),
   352→          notes: [],
   353→        }) as LoadedSpecItem;
   354→        createdSpecsMap.set(specSlug, dryRunSpec);
   355→      } else {
   356→        // Create spec item
   357→        const specInput: SpecItemInput = {
   358→          title: spec.title,
   359→          type: (spec.type as any) || "feature",
   360→          slugs: [specSlug],
   361→          description: spec.description,
   362→          priority: undefined,
   363→          tags: [],
   364→          depends_on: [],
   365→          implements: [],
   366→          relates_to: [],
   367→          tests: [],
   368→          traits: (spec.traits || []).map(normalizeRefInput),
   369→          notes: [],
   370→        };
   371→
   372→        // Add acceptance criteria if present
   373→        if (spec.acceptance_criteria) {
   374→          specInput.acceptance_criteria = spec.acceptance_criteria;
   375→        }
   376→
   377→        const newSpec = createSpecItem(specInput);
   378→
   379→        // Add spec to parent (or module if no parent)
   380→        const actualParent = parent || moduleItem;
   381→        const addResult = await addChildItem(ctx, actualParent, newSpec);
   382→
   383→        // Track the created spec for parent resolution
   384→        // Need to construct LoadedSpecItem with _sourceFile and _path for nested specs
   385→        const createdSpec: LoadedSpecItem = {
   386→          ...(addResult.item as LoadedSpecItem),
   387→          _sourceFile: actualParent._sourceFile,
   388→          _path: addResult.path,
   389→        };
   390→        createdSpecsMap.set(specSlug, createdSpec);
   391→
   392→        result.createdSpecs.push(specRef);
   393→        importReservedSlugs.add(specSlug);
   394→        newPlan.derived_specs.push(specRef);
   395→
   396→        info(`Created spec: ${specRef}`);
   397→      }
   398→    } catch (err) {
   399→      const errMsg = `Failed to create spec "${spec.title}": ${err instanceof Error ? err.message : String(err)}`;
   400→      warn(errMsg);
   401→      result.errors.push({ message: errMsg, spec });
   402→    }
   403→  }
   404→
   405→  // Derive tasks from specs
   406→  // AC: @plan-import ac-12, ac-13, ac-19, ac-20
   407→  if (parsed.tasks.derive_from_specs && result.createdSpecs.length > 0) {
   408→    const tasks = await loadAllTasks(ctx);
   409→    // Combine existing task slugs + all slugs reserved during this import (plan + specs)
   410→    const importSlugs = new Set([
   411→      ...tasks.flatMap((t) => t.slugs),
   412→      ...importReservedSlugs,
   413→    ]);
   414→
   415→    for (const specRef of result.createdSpecs) {
   416→      // Get spec from createdSpecsMap (works in both dry-run and real mode)
   417→      const specSlug = specRef.slice(1);
   418→      const spec = createdSpecsMap.get(specSlug);
   419→      if (!spec) continue;
   420→
   421→      // AC: @plan-import ac-20 - Task title follows "Implement X" pattern
   422→      const taskTitle = `Implement ${spec.title}`;
   423→      const taskSlug = generateSlug(taskTitle);
   424→
   425→      // Ensure slug uniqueness across all namespaces + this import's slugs
   426→      let uniqueSlug = taskSlug;
   427→      let counter = 1;
   428→      while (importSlugs.has(uniqueSlug) || !refIndex.isSlugAvailable(uniqueSlug)) {
   429→        uniqueSlug = `${taskSlug}-${counter}`;
   430→        counter++;
   431→      }
   432→      importSlugs.add(uniqueSlug);
   433→      importReservedSlugs.add(uniqueSlug);
   434→
   435→      if (options.dryRun) {
   436→        info(`Would derive task: @${uniqueSlug} from ${specRef}`);
   437→        result.createdTasks.push(`@${uniqueSlug}`);
   438→      } else {
   439→        // AC: @plan-import ac-19 - Task has both spec_ref and plan_ref
   440→        const taskInput: TaskInput = {
   441→          title: taskTitle,
   442→          type: "task",
   443→          spec_ref: specRef,
   444→          plan_ref: planRef,
   445→          priority: 3,
   446→          slugs: [uniqueSlug],
   447→          tags: [],
   448→          depends_on: [],
   449→          notes: [],
   450→        };
   451→
   452→        const newTask = createTask(taskInput);
   453→
   454→        // AC: @plan-import ac-13 - Scoped implementation notes
   455→        const planSpec = parsed.specs.find(s =>
   456→          (s.slug || generateSlug(s.title)) === specSlug
   457→        );
   458→        if (planSpec?.implementation_notes) {
   459→          // Per-spec notes go directly to this task
   460→          newTask.notes.push({
   461→            _ulid: ulid(),
   462→            created_at: new Date().toISOString(),
   463→            author,
   464→            content: `Implementation notes:\n\n${planSpec.implementation_notes}`,
   465→          });
   466→        } else if (parsed.implementationNotes) {
   467→          // No per-spec notes — reference the plan
   468→          newTask.notes.push({
   469→            _ulid: ulid(),
   470→            created_at: new Date().toISOString(),
   471→            author,
   472→            content: `See plan ${planRef} for implementation notes`,
   473→          });
   474→        }
   475→
   476→        await saveTask(ctx, newTask);
   477→        result.createdTasks.push(`@${uniqueSlug}`);
   478→        newPlan.derived_tasks.push(`@${uniqueSlug}`);
   479→
   480→        info(`Derived task: @${uniqueSlug}`);
   481→      }
   482→    }
   483→  }
   484→
   485→  // Create manual tasks
   486→  // AC: @plan-import ac-27
   487→  if (parsed.tasks.additional_tasks) {
   488→    // Reload tasks to catch any created by derive loop above
   489→    // Combine with all slugs reserved during this import (plan + specs)
   490→    const manualTasks = await loadAllTasks(ctx);
   491→    const manualImportSlugs = new Set([
   492→      ...manualTasks.flatMap((t) => t.slugs),
   493→      ...importReservedSlugs,
   494→    ]);
   495→
   496→    for (const taskDef of parsed.tasks.additional_tasks) {
   497→      const taskSlug = taskDef.slug || generateSlug(taskDef.title);
   498→
   499→      // Ensure slug uniqueness across all namespaces + this import's slugs
   500→      let uniqueSlug = taskSlug;
   501→      let counter = 1;
   502→      while (manualImportSlugs.has(uniqueSlug) || !refIndex.isSlugAvailable(uniqueSlug)) {
   503→        uniqueSlug = `${taskSlug}-${counter}`;
   504→        counter++;
   505→      }
   506→      manualImportSlugs.add(uniqueSlug);
   507→
   508→      if (options.dryRun) {
   509→        info(`Would create manual task: @${uniqueSlug}`);
   510→        result.createdTasks.push(`@${uniqueSlug}`);
   511→      } else {
   512→        // AC: @plan-import ac-27 - Manual tasks have plan_ref but no spec_ref
   513→        const taskInput: TaskInput = {
   514→          title: taskDef.title,
   515→          type: "task",
   516→          plan_ref: planRef,
   517→          priority: taskDef.priority || 3,
   518→          slugs: [uniqueSlug],
   519→          tags: taskDef.tags || [],
   520→          depends_on: [],
   521→          notes: [],
   522→        };
   523→
   524→        if (taskDef.description) {
   525→          taskInput.notes = [
   526→            {
   527→              _ulid: ulid(),
   528→              created_at: new Date().toISOString(),
   529→              author,
   530→              content: taskDef.description,
   531→            },
   532→          ];
   533→        }
   534→
   535→        const newTask = createTask(taskInput);
   536→        await saveTask(ctx, newTask);
   537→        result.createdTasks.push(`@${uniqueSlug}`);
   538→        newPlan.derived_tasks.push(`@${uniqueSlug}`);
   539→
   540→        info(`Created manual task: @${uniqueSlug}`);
   541→      }
   542→    }
   543→  }
   544→
   545→  // Save plan record
   546→  // AC: @plan-import ac-24
   547→  if (!options.dryRun) {
   548→    await savePlan(ctx, newPlan);
   549→    await commitIfShadow(ctx.shadow, "plan-import", planSlug, parsed.title);
   550→  }
   551→
   552→  // AC: @plan-import ac-23, ac-29 - Summary output
   553→  const successCount =
   554→    result.createdSpecs.length +
   555→    result.updatedSpecs.length +
   556→    result.createdTasks.length;
   557→  const errorCount = result.errors.length + result.skipped.length;
   558→
   559→  // AC: @plan-import ac-32 - JSON output
   560→  if (isJsonMode()) {
   561→    output({
   562→      plan: planRef,
   563→      created_specs: result.createdSpecs,
   564→      updated_specs: result.updatedSpecs,
   565→      created_tasks: result.createdTasks,
   566→      errors: result.errors,
   567→      skipped: result.skipped,
   568→    });
   569→  } else {
   570→    // Human-readable output
   571→    if (options.dryRun) {
   572→      console.log("\nDry run - no changes made\n");
   573→    }
   574→
   575→    console.log(`Plan: ${planRef}`);
   576→    console.log(`Created ${result.createdSpecs.length} specs`);
   577→    if (result.updatedSpecs.length > 0) {
   578→      console.log(`Updated ${result.updatedSpecs.length} specs`);
   579→    }
   580→    console.log(`Created ${result.createdTasks.length} tasks`);
   581→
   582→    if (result.errors.length > 0) {
   583→      console.log(`\nErrors (${result.errors.length}):`);
   584→      for (const err of result.errors) {
   585→        console.log(`  - ${err.message}`);
   586→      }
   587→    }
   588→
   589→    if (result.skipped.length > 0) {
   590→      console.log(`\nSkipped (${result.skipped.length}):`);
   591→      for (const skip of result.skipped) {
   592→        console.log(`  - @${skip.slug}: ${skip.reason}`);
   593→      }
   594→    }
   595→
   596→    // AC: @plan-import ac-15, ac-23 - Exit code 0 on success
   597→    if (!options.dryRun && successCount > 0) {
   598→      success(
   599→        `\nImported plan: ${successCount} items created, ${errorCount} errors`,
   600→      );
   601→    }
   602→  }  // end of else block (non-JSON output)
   603→
   604→  // Exit code logic
   605→  // AC: @plan-import ac-15 - Dry run exits 0
   606→  // AC: @plan-import ac-23 - Success with some errors still exits 0
   607→  process.exit(EXIT_CODES.SUCCESS);
   608→}
   609→
   610→/**
   611→ * Generate URL-safe slug from title
   612→ */
   613→function generateSlug(title: string): string {
   614→  return title
   615→    .toLowerCase()
   616→    .replace(/[^a-z0-9]+/g, "-")
   617→    .replace(/^-|-$/g, "")
   618→    .slice(0, 50);
   619→}
   620→
```