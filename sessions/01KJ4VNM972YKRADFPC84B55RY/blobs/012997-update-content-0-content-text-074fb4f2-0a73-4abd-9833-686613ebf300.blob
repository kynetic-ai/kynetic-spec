```
     1→import * as readline from "node:readline";
     2→import { ulid } from "ulid";
     3→import type { Command } from "commander";
     4→import { markMutating } from "../command-annotations.js";
     5→import {
     6→  createObservation,
     7→  createTask,
     8→  deleteInboxItem,
     9→  findInboxItemByRef,
    10→  getAuthor,
    11→  initContext,
    12→  type LoadedInboxItem,
    13→  type LoadedTriageRecord,
    14→  loadAllItems,
    15→  loadAllTasks,
    16→  loadInboxItems,
    17→  loadTriageRecords,
    18→  ReferenceIndex,
    19→  saveObservation,
    20→  saveTask,
    21→  saveTriageRecord,
    22→  findTriageRecordByRef,
    23→} from "../../parser/index.js";
    24→import { commitIfShadow } from "../../parser/shadow.js";
    25→import type { TriageAction, TriageRecord } from "../../schema/index.js";
    26→import { exportTriageAsContext, truncateText } from "../../export/triage.js";
    27→import { errors } from "../../strings/index.js";
    28→import { formatRelativeTime as formatRelativeTimeUtil } from "../../utils/time.js";
    29→import { EXIT_CODES } from "../exit-codes.js";
    30→import { error, info, output, success } from "../output.js";
    31→
    32→/**
    33→ * Format relative time for display
    34→ */
    35→function formatRelativeTime(dateStr: string): string {
    36→  return formatRelativeTimeUtil(new Date(dateStr));
    37→}
    38→
    39→/**
    40→ * Resolve triage record ref with error handling
    41→ */
    42→function resolveTriageRef(
    43→  ref: string,
    44→  records: LoadedTriageRecord[],
    45→): LoadedTriageRecord {
    46→  const record = findTriageRecordByRef(records, ref);
    47→  if (!record) {
    48→    error(`Triage record not found: ${ref}`);
    49→    process.exit(EXIT_CODES.NOT_FOUND);
    50→  }
    51→  return record;
    52→}
    53→
    54→// truncateText imported from shared export/triage.ts
    55→
    56→/**
    57→ * Execute a triage action
    58→ * AC: @triage-cli-commands ac-4, ac-5, ac-6, ac-7, ac-8
    59→ */
    60→async function executeTriageAction(
    61→  record: LoadedTriageRecord,
    62→  ctx: Awaited<ReturnType<typeof initContext>>,
    63→  dryRun: boolean = false,
    64→): Promise<{ resultRef?: string }> {
    65→  const action = record.action;
    66→  if (!action) {
    67→    error("Record has no action to execute");
    68→    process.exit(EXIT_CODES.VALIDATION_FAILED);
    69→  }
    70→
    71→  switch (action) {
    72→    case "promote": {
    73→      // AC: @triage-cli-commands ac-4
    74→      if (dryRun) {
    75→        info(`Would create task from inbox item snapshot: "${truncateText(record.item_snapshot)}"`);
    76→        return {};
    77→      }
    78→      const task = createTask({
    79→        title: record.item_snapshot.split("\n")[0].slice(0, 100),
    80→        type: "task",
    81→        priority: 3,
    82→        spec_ref: null,
    83→        tags: [],
    84→        description: record.item_snapshot,
    85→      });
    86→      await saveTask(ctx, task);
    87→      const tasks = await loadAllTasks(ctx);
    88→      const items = await loadAllItems(ctx);
    89→      const index = new ReferenceIndex(tasks, items);
    90→      const taskRef = `@${index.shortUlid(task._ulid)}`;
    91→      info(`Created task: ${taskRef} - ${task.title}`);
    92→      return { resultRef: taskRef };
    93→    }
    94→
    95→    case "delete": {
    96→      // AC: @triage-cli-commands ac-5
    97→      if (dryRun) {
    98→        info(`Would delete inbox item: ${record.inbox_ref.slice(0, 8)}`);
    99→        return {};
   100→      }
   101→      const inboxItems = await loadInboxItems(ctx);
   102→      const inboxItem = findInboxItemByRef(inboxItems, record.inbox_ref);
   103→      if (inboxItem) {
   104→        await deleteInboxItem(ctx, inboxItem._ulid);
   105→        info(`Deleted inbox item: ${record.inbox_ref.slice(0, 8)}`);
   106→      }
   107→      return {};
   108→    }
   109→
   110→    case "defer": {
   111→      // AC: @triage-cli-commands ac-6
   112→      if (dryRun) {
   113→        info(`Would defer: no side effects beyond recording the deferral`);
   114→        return {};
   115→      }
   116→      return {};
   117→    }
   118→
   119→    case "spec-gap": {
   120→      // AC: @triage-cli-commands ac-7
   121→      if (dryRun) {
   122→        info(`Would create spec-gap observation from: "${truncateText(record.item_snapshot)}"`);
   123→        return {};
   124→      }
   125→      const content = `[spec-gap] ${record.item_snapshot}\n\nReasoning: ${record.reasoning || ""}`;
   126→      const observation = createObservation("question", content, {
   127→        configAuthor: ctx.config?.identity?.author,
   128→      });
   129→      await saveObservation(ctx, observation);
   130→      const obsRef = `@${observation._ulid.slice(0, 8)}`;
   131→      info(`Created spec-gap observation: ${obsRef}`);
   132→      return { resultRef: obsRef };
   133→    }
   134→
   135→    case "duplicate": {
   136→      // AC: @triage-cli-commands ac-8
   137→      if (dryRun) {
   138→        info(`Would delete duplicate inbox item: ${record.inbox_ref.slice(0, 8)}`);
   139→        return {};
   140→      }
   141→      const dupItems = await loadInboxItems(ctx);
   142→      const dupItem = findInboxItemByRef(dupItems, record.inbox_ref);
   143→      if (dupItem) {
   144→        await deleteInboxItem(ctx, dupItem._ulid);
   145→        info(`Deleted duplicate inbox item: ${record.inbox_ref.slice(0, 8)}`);
   146→      }
   147→      return {};
   148→    }
   149→  }
   150→}
   151→
   152→// formatTriageContext moved to shared export/triage.ts (formatTriageRecordContext)
   153→
   154→/**
   155→ * Register the 'triage' command group
   156→ * AC: @triage-cli-commands ac-1 through ac-17
   157→ */
   158→export function registerTriageCommands(program: Command): void {
   159→  const triage = program
   160→    .command("triage")
   161→    .description("Record, review, and act on triage decisions");
   162→
   163→  // kspec triage record <inbox-ref>
   164→  // AC: @triage-cli-commands ac-1, ac-11
   165→  markMutating(triage.command("record <inbox-ref>"))
   166→    .description("Record a triage decision for an inbox item")
   167→    .requiredOption("--action <action>", "Triage action (promote, delete, defer, spec-gap, duplicate)")
   168→    .requiredOption("--reasoning <text>", "Reasoning for the decision")
   169→    .option("--decided-by <author>", "Who made the decision")
   170→    .option("--evidence <refs...>", "Evidence references")
   171→    .option("--dry-run", "Show what would happen without making changes")
   172→    .addHelpText(
   173→      "after",
   174→      `
   175→Examples:
   176→  $ kspec triage record @ref --action promote --reasoning "clear feature request"
   177→  $ kspec triage record @ref --action defer --reasoning "needs more discussion"`,
   178→    )
   179→    .action(async (inboxRef: string, options) => {
   180→      try {
   181→        const ctx = await initContext();
   182→
   183→        // Validate action
   184→        const validActions = ["promote", "delete", "defer", "spec-gap", "duplicate"];
   185→        if (!validActions.includes(options.action)) {
   186→          error(`Invalid action: ${options.action}. Must be one of: ${validActions.join(", ")}`);
   187→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   188→        }
   189→
   190→        // Resolve inbox item
   191→        const inboxItems = await loadInboxItems(ctx);
   192→        const item = findInboxItemByRef(inboxItems, inboxRef);
   193→        if (!item) {
   194→          error(errors.reference.inboxNotFound(inboxRef));
   195→          process.exit(EXIT_CODES.NOT_FOUND);
   196→        }
   197→
   198→        if (options.dryRun) {
   199→          info(`Would create triage record for inbox item ${item._ulid.slice(0, 8)} with action: ${options.action}`);
   200→          return;
   201→        }
   202→
   203→        const author = options.decidedBy || getAuthor(ctx.config?.identity?.author);
   204→        const evidenceRefs = options.evidence
   205→          ? options.evidence.map((r: string) => r.startsWith("@") ? r : `@${r}`)
   206→          : [];
   207→
   208→        const record: LoadedTriageRecord = {
   209→          _ulid: ulid(),
   210→          inbox_ref: item._ulid,
   211→          item_snapshot: item.text,
   212→          status: "triaged",
   213→          action: options.action as TriageAction,
   214→          reasoning: options.reasoning,
   215→          decided_by: author,
   216→          evidence_refs: evidenceRefs,
   217→          created_at: new Date().toISOString(),
   218→        };
   219→
   220→        await saveTriageRecord(ctx, record);
   221→        await commitIfShadow(
   222→          ctx.shadow,
   223→          "triage-record",
   224→          record._ulid.slice(0, 8),
   225→          options.action,
   226→        );
   227→
   228→        // AC: @triage-cli-commands ac-11 — JSON output
   229→        // AC: @trait-json-output ac-1, ac-2, ac-4, ac-5
   230→        success(`Recorded triage decision: ${record._ulid.slice(0, 8)}`, { record });
   231→      } catch (err) {
   232→        error("Failed to record triage decision", err);
   233→        process.exit(EXIT_CODES.ERROR);
   234→      }
   235→    });
   236→
   237→  // kspec triage list
   238→  // AC: @triage-cli-commands ac-2, ac-3
   239→  triage
   240→    .command("list")
   241→    .description("List triage records")
   242→    .option("--status <status>", "Filter by status (pending, triaged, acted_on)")
   243→    .option("--action <action>", "Filter by action")
   244→    .option("--decided-by <author>", "Filter by decision author")
   245→    .option("--limit <n>", "Limit results")
   246→    .option("--offset <n>", "Skip first N results")
   247→    .option("--count", "Show only the count")
   248→    .action(async (options) => {
   249→      try {
   250→        const ctx = await initContext();
   251→        let records = await loadTriageRecords(ctx);
   252→        const totalCount = records.length;
   253→        const activeFilters: string[] = [];
   254→        let filteredCount: number;
   255→
   256→        // AC: @triage-cli-commands ac-3 — status filter
   257→        // AC: @trait-filterable-list ac-1
   258→        if (options.status) {
   259→          records = records.filter((r) => r.status === options.status);
   260→          activeFilters.push(`status=${options.status}`);
   261→        }
   262→
   263→        // AC: @trait-filterable-list ac-5
   264→        if (options.action) {
   265→          records = records.filter((r) => r.action === options.action);
   266→          activeFilters.push(`action=${options.action}`);
   267→        }
   268→
   269→        if (options.decidedBy) {
   270→          records = records.filter((r) => r.decided_by === options.decidedBy);
   271→          activeFilters.push(`decided_by=${options.decidedBy}`);
   272→        }
   273→
   274→        // Sort by created_at desc (newest first)
   275→        records.sort((a, b) => {
   276→          return new Date(b.created_at).getTime() - new Date(a.created_at).getTime();
   277→        });
   278→
   279→        // Capture post-filter count before pagination
   280→        filteredCount = records.length;
   281→
   282→        // AC: @trait-filterable-list ac-8
   283→        if (options.count) {
   284→          output({ count: records.length }, () => {
   285→            console.log(records.length);
   286→          });
   287→          return;
   288→        }
   289→
   290→        // AC: @trait-filterable-list ac-4 — offset
   291→        if (options.offset) {
   292→          const offset = parseInt(options.offset, 10);
   293→          records = records.slice(offset);
   294→        }
   295→
   296→        // AC: @trait-filterable-list ac-3 — limit
   297→        if (options.limit) {
   298→          const limit = parseInt(options.limit, 10);
   299→          records = records.slice(0, limit);
   300→        }
   301→
   302→        // AC: @trait-json-output ac-1, ac-2
   303→        output(records, () => {
   304→          if (records.length === 0) {
   305→            // AC: @trait-filterable-list ac-6
   306→            console.log("No triage records");
   307→            return;
   308→          }
   309→
   310→          // AC: @trait-filterable-list ac-7 — summary with total matching items and filter state
   311→          const filterInfo = activeFilters.length > 0
   312→            ? ` (${activeFilters.join(", ")})`
   313→            : "";
   314→          const showing = filteredCount < totalCount
   315→            ? `${filteredCount} of ${totalCount}`
   316→            : `${filteredCount}`;
   317→          console.log(
   318→            `Triage records (${showing}${filterInfo}):\n`,
   319→          );
   320→
   321→          // AC: @triage-cli-commands ac-2
   322→          for (const record of records) {
   323→            const snapshot = truncateText(record.item_snapshot, 50);
   324→            const age = formatRelativeTime(record.created_at);
   325→            const action = record.action ? ` [${record.action}]` : "";
   326→            const decidedBy = record.decided_by ? ` by ${record.decided_by}` : "";
   327→            console.log(`  ${record._ulid.slice(0, 8)} (${age}${decidedBy}) ${record.status}${action}`);
   328→            console.log(`    ${snapshot}`);
   329→            console.log("");
   330→          }
   331→        });
   332→      } catch (err) {
   333→        error("Failed to list triage records", err);
   334→        process.exit(EXIT_CODES.ERROR);
   335→      }
   336→    });
   337→
   338→  // kspec triage act <triage-ref>
   339→  // AC: @triage-cli-commands ac-4, ac-5, ac-6, ac-7, ac-8, ac-15, ac-16, ac-17
   340→  markMutating(triage.command("act <triage-ref>"))
   341→    .description("Execute a triage decision")
   342→    .option("--dry-run", "Show what would happen without executing")
   343→    .action(async (triageRef: string, options) => {
   344→      try {
   345→        const ctx = await initContext();
   346→        const records = await loadTriageRecords(ctx);
   347→        const record = resolveTriageRef(triageRef, records);
   348→
   349→        // AC: @triage-cli-commands ac-15 — already acted on
   350→        // AC: @trait-error-guidance ac-1, ac-2
   351→        if (record.status === "acted_on") {
   352→          error(`Triage record ${record._ulid.slice(0, 8)} has already been acted on. No further action is possible.`);
   353→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   354→        }
   355→
   356→        // AC: @triage-cli-commands ac-16 — no decision yet
   357→        // AC: @trait-error-guidance ac-1, ac-2
   358→        if (record.status === "pending") {
   359→          error(`Triage record ${record._ulid.slice(0, 8)} has no decision yet. Record a decision first with: kspec triage record <inbox-ref> --action <action> --reasoning <text>`);
   360→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   361→        }
   362→
   363→        // AC: @triage-cli-commands ac-17 — dry run
   364→        if (options.dryRun) {
   365→          info(`Dry run for triage record ${record._ulid.slice(0, 8)}:`);
   366→          await executeTriageAction(record, ctx, true);
   367→          return;
   368→        }
   369→
   370→        // Execute the action
   371→        const result = await executeTriageAction(record, ctx, false);
   372→
   373→        // Transition to acted_on
   374→        record.status = "acted_on";
   375→        record.acted_at = new Date().toISOString();
   376→        if (result.resultRef) {
   377→          record.result_ref = result.resultRef;
   378→        }
   379→        record.updated_at = new Date().toISOString();
   380→
   381→        await saveTriageRecord(ctx, record);
   382→        await commitIfShadow(
   383→          ctx.shadow,
   384→          "triage-act",
   385→          record._ulid.slice(0, 8),
   386→          record.action,
   387→        );
   388→
   389→        success(`Acted on triage record: ${record._ulid.slice(0, 8)} (${record.action})`, { record });
   390→      } catch (err) {
   391→        error("Failed to act on triage record", err);
   392→        process.exit(EXIT_CODES.ERROR);
   393→      }
   394→    });
   395→
   396→  // kspec triage override <triage-ref>
   397→  // AC: @triage-cli-commands ac-12
   398→  markMutating(triage.command("override <triage-ref>"))
   399→    .description("Override an existing triage decision")
   400→    .requiredOption("--action <action>", "New action (promote, delete, defer, spec-gap, duplicate)")
   401→    .requiredOption("--reasoning <text>", "Reasoning for the override")
   402→    .option("--override-by <author>", "Who is overriding")
   403→    .action(async (triageRef: string, options) => {
   404→      try {
   405→        const ctx = await initContext();
   406→        const records = await loadTriageRecords(ctx);
   407→        const record = resolveTriageRef(triageRef, records);
   408→
   409→        // Validate action
   410→        const validActions = ["promote", "delete", "defer", "spec-gap", "duplicate"];
   411→        if (!validActions.includes(options.action)) {
   412→          error(`Invalid action: ${options.action}. Must be one of: ${validActions.join(", ")}`);
   413→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   414→        }
   415→
   416→        const overrideBy = options.overrideBy || getAuthor(ctx.config?.identity?.author);
   417→
   418→        // AC: @triage-cli-commands ac-12
   419→        record.override_reasoning = options.reasoning;
   420→        record.override_by = overrideBy;
   421→        record.override_at = new Date().toISOString();
   422→        record.action = options.action as TriageAction;
   423→
   424→        // Ensure status is triaged (for re-acting after override)
   425→        if (record.status === "acted_on") {
   426→          record.status = "triaged";
   427→        }
   428→
   429→        await saveTriageRecord(ctx, record);
   430→        await commitIfShadow(
   431→          ctx.shadow,
   432→          "triage-override",
   433→          record._ulid.slice(0, 8),
   434→          options.action,
   435→        );
   436→
   437→        success(`Overrode triage decision: ${record._ulid.slice(0, 8)} → ${options.action}`, { record });
   438→      } catch (err) {
   439→        error("Failed to override triage decision", err);
   440→        process.exit(EXIT_CODES.ERROR);
   441→      }
   442→    });
   443→
   444→  // kspec triage export
   445→  // AC: @triage-cli-commands ac-13, ac-14
   446→  triage
   447→    .command("export")
   448→    .description("Export triage decisions for agent handoff")
   449→    .requiredOption("--format <format>", "Export format (context, json)")
   450→    .option("--status <status>", "Filter by status")
   451→    .action(async (options) => {
   452→      try {
   453→        const ctx = await initContext();
   454→        let records = await loadTriageRecords(ctx);
   455→
   456→        if (options.status) {
   457→          records = records.filter((r) => r.status === options.status);
   458→        }
   459→
   460→        const validFormats = ["context", "json"];
   461→        if (!validFormats.includes(options.format)) {
   462→          error(`Invalid format: ${options.format}. Must be one of: ${validFormats.join(", ")}`);
   463→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   464→        }
   465→
   466→        // AC: @trait-json-output ac-6 — --json takes precedence over --format
   467→        // AC: @triage-cli-commands ac-13, ac-14
   468→        // AC: @triage-agent-export ac-1, ac-2, ac-3, ac-4 — shared formatter
   469→        output(records, () => {
   470→          if (options.format === "json") {
   471→            // AC: @triage-cli-commands ac-14
   472→            console.log(JSON.stringify(records, null, 2));
   473→          } else {
   474→            // AC: @triage-cli-commands ac-13 — context format via shared formatter
   475→            console.log(exportTriageAsContext(records));
   476→          }
   477→        });
   478→      } catch (err) {
   479→        error("Failed to export triage records", err);
   480→        process.exit(EXIT_CODES.ERROR);
   481→      }
   482→    });
   483→
   484→  // kspec triage start
   485→  // AC: @triage-cli-commands ac-9, ac-10
   486→  markMutating(triage.command("start"))
   487→    .description("Start interactive triage of inbox items")
   488→    .action(async () => {
   489→      try {
   490→        const ctx = await initContext();
   491→        const inboxItems = await loadInboxItems(ctx);
   492→        const existingRecords = await loadTriageRecords(ctx);
   493→
   494→        // Find untriaged items (no existing triage record)
   495→        const triagedInboxRefs = new Set(existingRecords.map((r) => r.inbox_ref));
   496→        const untriaged = inboxItems.filter((item) => !triagedInboxRefs.has(item._ulid));
   497→
   498→        if (untriaged.length === 0) {
   499→          info("No untriaged inbox items");
   500→          return;
   501→        }
   502→
   503→        console.log(`\nInteractive triage: ${untriaged.length} item(s) to review\n`);
   504→        console.log("Actions: promote, delete, defer, spec-gap, duplicate, skip\n");
   505→
   506→        const validActions = ["promote", "delete", "defer", "spec-gap", "duplicate", "skip"];
   507→        let triaged = 0;
   508→
   509→        // Use a line-buffering approach for interactive prompts.
   510→        // readline.question() has issues with piped stdin because the close
   511→        // event can fire before subsequent question() calls process buffered lines.
   512→        // Instead, we collect lines via the 'line' event and read from the buffer.
   513→        const lineBuffer: string[] = [];
   514→        let lineResolve: ((value: string | null) => void) | null = null;
   515→        let inputClosed = false;
   516→
   517→        const rl = readline.createInterface({
   518→          input: process.stdin,
   519→          output: process.stdout,
   520→          terminal: false,
   521→        });
   522→
   523→        rl.on("line", (line) => {
   524→          if (lineResolve) {
   525→            const resolve = lineResolve;
   526→            lineResolve = null;
   527→            resolve(line.trim());
   528→          } else {
   529→            lineBuffer.push(line.trim());
   530→          }
   531→        });
   532→
   533→        rl.on("close", () => {
   534→          inputClosed = true;
   535→          if (lineResolve) {
   536→            const resolve = lineResolve;
   537→            lineResolve = null;
   538→            resolve(null);
   539→          }
   540→        });
   541→
   542→        const askQuestion = (question: string): Promise<string | null> => {
   543→          process.stdout.write(question);
   544→          if (lineBuffer.length > 0) {
   545→            return Promise.resolve(lineBuffer.shift()!);
   546→          }
   547→          if (inputClosed) return Promise.resolve(null);
   548→          return new Promise((resolve) => {
   549→            lineResolve = resolve;
   550→          });
   551→        };
   552→
   553→        // AC: @triage-cli-commands ac-9 — present items one at a time
   554→        for (const item of untriaged) {
   555→          console.log("─".repeat(60));
   556→          console.log(`Item: ${item._ulid.slice(0, 8)} (${formatRelativeTime(item.created_at)})`);
   557→          if (item.tags.length > 0) {
   558→            console.log(`Tags: ${item.tags.join(", ")}`);
   559→          }
   560→          if (item.added_by) {
   561→            console.log(`Added by: ${item.added_by}`);
   562→          }
   563→          console.log("");
   564→          console.log(item.text);
   565→          console.log("");
   566→
   567→          // AC: @triage-cli-commands ac-10 — Ctrl+C preserves committed records
   568→          const action = await askQuestion("Action (promote/delete/defer/spec-gap/duplicate/skip): ");
   569→
   570→          if (action === null) {
   571→            // Ctrl+C or closed input
   572→            console.log(`\nTriage interrupted. ${triaged} record(s) saved.`);
   573→            rl.close();
   574→            return;
   575→          }
   576→
   577→          if (!action || action === "skip") {
   578→            console.log("Skipped\n");
   579→            continue;
   580→          }
   581→
   582→          if (!validActions.includes(action)) {
   583→            console.log(`Invalid action: ${action}. Skipping.\n`);
   584→            continue;
   585→          }
   586→
   587→          const reasoning = await askQuestion("Reasoning: ");
   588→
   589→          if (reasoning === null) {
   590→            console.log(`\nTriage interrupted. ${triaged} record(s) saved.`);
   591→            rl.close();
   592→            return;
   593→          }
   594→
   595→          if (!reasoning) {
   596→            console.log("Reasoning required. Skipping.\n");
   597→            continue;
   598→          }
   599→
   600→          const author = getAuthor(ctx.config?.identity?.author);
   601→
   602→          const record: LoadedTriageRecord = {
   603→            _ulid: ulid(),
   604→            inbox_ref: item._ulid,
   605→            item_snapshot: item.text,
   606→            status: "triaged",
   607→            action: action as TriageAction,
   608→            reasoning,
   609→            decided_by: author,
   610→            evidence_refs: [],
   611→            created_at: new Date().toISOString(),
   612→          };
   613→
   614→          await saveTriageRecord(ctx, record);
   615→          await commitIfShadow(
   616→            ctx.shadow,
   617→            "triage-record",
   618→            record._ulid.slice(0, 8),
   619→            action,
   620→          );
   621→
   622→          triaged++;
   623→          console.log(`Recorded: ${record._ulid.slice(0, 8)} → ${action}\n`);
   624→        }
   625→
   626→        rl.close();
   627→        console.log(`\nTriage complete. ${triaged} record(s) created.`);
   628→      } catch (err) {
   629→        error("Failed to start interactive triage", err);
   630→        process.exit(EXIT_CODES.ERROR);
   631→      }
   632→    });
   633→
   634→  // kspec triage get <triage-ref>
   635→  triage
   636→    .command("get <triage-ref>")
   637→    .description("Show details of a triage record")
   638→    .action(async (triageRef: string) => {
   639→      try {
   640→        const ctx = await initContext();
   641→        const records = await loadTriageRecords(ctx);
   642→        const record = resolveTriageRef(triageRef, records);
   643→
   644→        output(record, () => {
   645→          console.log(`ULID:        ${record._ulid}`);
   646→          console.log(`Inbox ref:   ${record.inbox_ref}`);
   647→          console.log(`Status:      ${record.status}`);
   648→          if (record.action) console.log(`Action:      ${record.action}`);
   649→          if (record.reasoning) console.log(`Reasoning:   ${record.reasoning}`);
   650→          if (record.decided_by) console.log(`Decided by:  ${record.decided_by}`);
   651→          if (record.evidence_refs.length > 0) {
   652→            console.log(`Evidence:    ${record.evidence_refs.join(", ")}`);
   653→          }
   654→          console.log(`Created:     ${record.created_at} (${formatRelativeTime(record.created_at)})`);
   655→          if (record.updated_at) {
   656→            console.log(`Updated:     ${record.updated_at}`);
   657→          }
   658→          if (record.override_reasoning) {
   659→            console.log("");
   660→            console.log("Override:");
   661→            console.log(`  Reasoning: ${record.override_reasoning}`);
   662→            if (record.override_by) console.log(`  By:        ${record.override_by}`);
   663→            if (record.override_at) console.log(`  At:        ${record.override_at}`);
   664→          }
   665→          if (record.acted_at) {
   666→            console.log("");
   667→            console.log(`Acted at:    ${record.acted_at}`);
   668→            if (record.result_ref) console.log(`Result ref:  ${record.result_ref}`);
   669→          }
   670→          console.log("");
   671→          console.log("Item snapshot:");
   672→          console.log(record.item_snapshot);
   673→        });
   674→      } catch (err) {
   675→        error("Failed to get triage record", err);
   676→        process.exit(EXIT_CODES.ERROR);
   677→      }
   678→    });
   679→}
   680→
```