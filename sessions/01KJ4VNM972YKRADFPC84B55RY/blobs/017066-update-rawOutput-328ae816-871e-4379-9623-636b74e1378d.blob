    66→// ─── Types ───────────────────────────────────────────────────────────────────
    67→
    68→export interface CheckpointResult {
    69→  /** Whether session can end cleanly */
    70→  ok: boolean;
    71→
    72→  /** Human-readable message for Claude Code */
    73→  message: string;
    74→
    75→  /** Issues that need attention before stopping */
    76→  issues: CheckpointIssue[];
    77→
    78→  /** Instructions for the agent */
    79→  instructions: string[];
    80→}
    81→
    82→export interface CheckpointIssue {
    83→  type: "uncommitted_changes" | "in_progress_task" | "incomplete_todo";
    84→  description: string;
    85→  details?: Record<string, unknown>;
    86→}
    87→
    88→export interface SessionContext {
    89→  /** When this context was generated */
    90→  generated_at: string;
    91→
    92→  /** Current git branch */
    93→  branch: string | null;
    94→
    95→  /** Session context (focus, threads, questions) */
    96→  context: StoredSessionContext | null;
    97→
    98→  /** Tasks currently in progress */
    99→  active_tasks: ActiveTaskSummary[];
   100→
   101→  /** Tasks awaiting review (code done, PR pending) */
   102→  pending_review_tasks: ActiveTaskSummary[];
   103→
   104→  /** Recent notes from active tasks */
   105→  recent_notes: NoteSummary[];
   106→
   107→  /** Incomplete todos from active tasks */
   108→  active_todos: TodoSummary[];
   109→
   110→  /** Tasks ready to be picked up */
   111→  ready_tasks: ReadyTaskSummary[];
   112→
   113→  /** Blocked tasks with blockers */
   114→  blocked_tasks: BlockedTaskSummary[];
   115→
   116→  /** Recently completed tasks */
   117→  recently_completed: CompletedTaskSummary[];
   118→
   119→  /** Recent git commits */
   120→  recent_commits: CommitSummary[];
   121→
   122→  /** Working tree status */
   123→  working_tree: GitWorkingTree | null;
   124→
   125→  /** Inbox items awaiting triage (oldest first) */
   126→  inbox_items: InboxSummary[];
   127→
   128→  /** Summary statistics */
   129→  stats: SessionStats;
   130→}
   131→
   132→export interface ActiveTaskSummary {
   133→  ref: string;
   134→  title: string;
   135→  started_at: string | null;
   136→  priority: number;
   137→  spec_ref: string | null;
   138→  note_count: number;
   139→  last_note_at: string | null;
   140→  todo_count: number;
   141→  incomplete_todos: number;
   142→}
   143→
   144→export interface NoteSummary {
   145→  task_ref: string;
   146→  task_title: string;
   147→  task_status: "in_progress" | "pending_review" | "needs_work" | "completed";
   148→  note_ulid: string;
   149→  created_at: string;
   150→  author: string | null;
   151→  content: string;
   152→}
   153→
   154→export interface TodoSummary {
   155→  task_ref: string;
   156→  task_title: string;
   157→  id: number;
   158→  text: string;
   159→  added_at: string;
   160→  added_by: string | null;
   161→}
   162→
   163→export interface ReadyTaskSummary {
   164→  ref: string;
   165→  title: string;
   166→  priority: number;
   167→  spec_ref: string | null;
   168→  tags: string[];
   169→}
   170→
   171→export interface BlockedTaskSummary {
   172→  ref: string;
   173→  title: string;
   174→  blocked_by: string[];
   175→  unmet_deps: string[];
   176→}
   177→
   178→export interface CompletedTaskSummary {
   179→  ref: string;
   180→  title: string;
   181→  completed_at: string;
   182→  closed_reason: string | null;
   183→  origin?: "manual" | "derived" | "observation_promotion";
   184→}
   185→
   186→export interface CommitSummary {
   187→  hash: string;
   188→  full_hash: string;
   189→  date: string;
   190→  message: string;
   191→  author: string;
   192→}
   193→
   194→export interface SessionStats {
   195→  total_tasks: number;
   196→  in_progress: number;
   197→  needs_work: number;
   198→  pending_review: number;
   199→  ready: number;
   200→  blocked: number;
   201→  completed: number;
   202→  inbox_items: number;
   203→}
   204→
   205→export interface InboxSummary {
   206→  ref: string;
   207→  text: string;
   208→  created_at: string;
   209→  tags: string[];
   210→  added_by: string | null;
   211→}
   212→
   213→export interface SessionOptions {
   214→  brief?: boolean;
   215→  full?: boolean;
   216→  since?: string;
   217→  git?: boolean;
   218→  limit?: string;
   219→  eligible?: boolean; // Only include automation-eligible tasks in ready_tasks
   220→}
   221→
   222→// ─── Data Gathering ──────────────────────────────────────────────────────────
   223→
   224→function toActiveTaskSummary(
   225→  task: LoadedTask,
   226→  index: ReferenceIndex,
   227→): ActiveTaskSummary {
   228→  const lastNote =
   229→    task.notes.length > 0 ? task.notes[task.notes.length - 1] : null;
   230→  const incompleteTodos = task.todos.filter((t) => !t.done).length;
   231→  return {
   232→    ref: index.shortUlid(task._ulid),
   233→    title: task.title,
   234→    started_at: task.started_at || null,
   235→    priority: task.priority,
   236→    spec_ref: task.spec_ref || null,
   237→    note_count: task.notes.length,
   238→    last_note_at: lastNote ? lastNote.created_at : null,
   239→    todo_count: task.todos.length,
   240→    incomplete_todos: incompleteTodos,
   241→  };
   242→}
   243→
   244→function toReadyTaskSummary(
   245→  task: LoadedTask,
   246→  index: ReferenceIndex,
   247→): ReadyTaskSummary {
   248→  return {
   249→    ref: index.shortUlid(task._ulid),
   250→    title: task.title,
   251→    priority: task.priority,
   252→    spec_ref: task.spec_ref || null,
   253→    tags: task.tags,
   254→  };
   255→}
   256→
   257→function toBlockedTaskSummary(
   258→  task: LoadedTask,
   259→  _allTasks: LoadedTask[],
   260→  index: ReferenceIndex,
   261→): BlockedTaskSummary {
   262→  // Find unmet dependencies
   263→  const unmetDeps: string[] = [];
   264→  for (const depRef of task.depends_on) {
   265→    const result = index.resolve(depRef);
   266→    if (result.ok) {
   267→      const depItem = result.item;
   268→      if ("status" in depItem && depItem.status !== "completed") {
   269→        unmetDeps.push(depRef);
   270→      }
   271→    }
   272→  }
   273→
   274→  return {
   275→    ref: index.shortUlid(task._ulid),
   276→    title: task.title,
   277→    blocked_by: task.blocked_by,
   278→    unmet_deps: unmetDeps,
   279→  };
   280→}
   281→
   282→function toCompletedTaskSummary(
   283→  task: LoadedTask,
   284→  index: ReferenceIndex,
   285→): CompletedTaskSummary {
   286→  return {
   287→    ref: index.shortUlid(task._ulid),
   288→    title: task.title,
   289→    completed_at: task.completed_at || "",
   290→    closed_reason: task.closed_reason || null,
   291→    origin: task.origin,
   292→  };
   293→}
   294→
   295→function collectRecentNotes(
   296→  tasks: LoadedTask[],
   297→  index: ReferenceIndex,
   298→  options: { limit: number; since: Date | null },
   299→): NoteSummary[] {
   300→  const allNotes: NoteSummary[] = [];
   301→
   302→  for (const task of tasks) {
   303→    // Only include notes from in_progress, pending_review, or completed tasks
   304→    const taskStatus = task.status as "in_progress" | "pending_review" | "needs_work" | "completed";
   305→    if (!["in_progress", "pending_review", "needs_work", "completed"].includes(taskStatus)) {
   306→      continue;
   307→    }
   308→
   309→    for (const note of task.notes) {
   310→      const noteDate = new Date(note.created_at);
   311→
   312→      // Filter by since date if provided
   313→      if (options.since && noteDate < options.since) {
   314→        continue;
   315→      }
   316→
   317→      // Filter out superseded notes
   318→      if (isNoteSuperseded(note, task.notes)) {
   319→        continue;
   320→      }
   321→
   322→      allNotes.push({
   323→        task_ref: index.shortUlid(task._ulid),
   324→        task_title: task.title,
   325→        task_status: taskStatus,
   326→        note_ulid: note._ulid.slice(0, 8),
   327→        created_at: note.created_at,
   328→        author: note.author || null,
   329→        content: note.content,
   330→      });
   331→    }
   332→  }
   333→
   334→  // Sort by date descending, take limit
   335→  return allNotes
   336→    .sort(
   337→      (a, b) =>
   338→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   339→    )
   340→    .slice(0, options.limit);
   341→}
   342→
   343→function collectIncompleteTodos(
   344→  tasks: LoadedTask[],
   345→  index: ReferenceIndex,
   346→  options: { limit: number },
   347→): TodoSummary[] {
   348→  const allTodos: TodoSummary[] = [];
   349→
   350→  for (const task of tasks) {
   351→    for (const todo of task.todos) {
   352→      // Only include incomplete todos
   353→      if (todo.done) continue;
   354→
   355→      allTodos.push({
   356→        task_ref: index.shortUlid(task._ulid),
   357→        task_title: task.title,
   358→        id: todo.id,
   359→        text: todo.text,
   360→        added_at: todo.added_at,
   361→        added_by: todo.added_by || null,
   362→      });
   363→    }
   364→  }
   365→
   366→  // Sort by added_at descending (most recent first), take limit
   367→  return allTodos
   368→    .sort(
   369→      (a, b) => new Date(b.added_at).getTime() - new Date(a.added_at).getTime(),
   370→    )
   371→    .slice(0, options.limit);
   372→}
   373→
   374→/**
   375→ * Gather session context data
   376→ */
   377→export async function gatherSessionContext(
   378→  ctx: KspecContext,
   379→  options: SessionOptions,
   380→): Promise<SessionContext> {
   381→  const limit = parseInt(options.limit || "10", 10);
   382→  const sinceDate = options.since ? parseTimeSpec(options.since) : null;
   383→  const showGit = options.git !== false; // default true
   384→
   385→  // Load all data
   386→  const allTasks = await loadAllTasks(ctx);
   387→  const items = await loadAllItems(ctx);
   388→  const inboxItems = await loadInboxItems(ctx);
   389→  const index = new ReferenceIndex(allTasks, items);
   390→
   391→  // Compute stats
   392→  const stats: SessionStats = {
   393→    total_tasks: allTasks.length,
   394→    in_progress: allTasks.filter((t) => t.status === "in_progress").length,
   395→    needs_work: allTasks.filter((t) => t.status === "needs_work").length,
   396→    pending_review: allTasks.filter((t) => t.status === "pending_review")
   397→      .length,
   398→    ready: getReadyTasks(allTasks).length,
   399→    blocked: allTasks.filter((t) => t.status === "blocked").length,
   400→    completed: allTasks.filter((t) => t.status === "completed").length,
   401→    inbox_items: inboxItems.length,
   402→  };
   403→
   404→  // Get active tasks (in_progress + needs_work, optionally filtered to automation-eligible only)
   405→  // AC: @cli-ralph ac-16
   406→  const activeTasks = allTasks
   407→    .filter((t) => t.status === "in_progress" || t.status === "needs_work")
   408→    .filter((t) => !options.eligible || t.automation === "eligible")
   409→    .sort((a, b) => a.priority - b.priority)
   410→    .slice(0, options.full ? undefined : limit)
   411→    .map((t) => toActiveTaskSummary(t, index));
   412→
   413→  // Get pending review tasks
   414→  const pendingReviewTasks = allTasks
   415→    .filter((t) => t.status === "pending_review")
   416→    .sort((a, b) => a.priority - b.priority)
   417→    .slice(0, options.full ? undefined : limit)
   418→    .map((t) => toActiveTaskSummary(t, index));
   419→
   420→  // Get recent notes from active, pending_review, and recently completed tasks
   421→  // AC: @cmd-session-start ac-1, ac-2
   422→  // Collect notes per-status first to prevent one status from starving others
   423→  const noteLimitPerStatus = options.full ? limit : Math.ceil(limit / 3);
   424→
   425→  const inProgressNotes = collectRecentNotes(
   426→    allTasks.filter((t) => t.status === "in_progress" || t.status === "needs_work"),
   427→    index,
   428→    { limit: noteLimitPerStatus, since: sinceDate },
   429→  );
   430→
   431→  const pendingReviewNotes = collectRecentNotes(
   432→    allTasks.filter((t) => t.status === "pending_review"),
   433→    index,
   434→    { limit: noteLimitPerStatus, since: sinceDate },
   435→  );
   436→
   437→  const recentlyCompletedForNotes = allTasks
   438→    .filter((t) => t.status === "completed" && t.completed_at)
   439→    .sort((a, b) => {
   440→      const aDate = new Date(a.completed_at || 0);
   441→      const bDate = new Date(b.completed_at || 0);
   442→      return bDate.getTime() - aDate.getTime();
   443→    })
   444→    .slice(0, 5); // Last 3-5 completed tasks per AC-2
   445→
   446→  const completedNotes = collectRecentNotes(
   447→    recentlyCompletedForNotes,
   448→    index,
   449→    { limit: noteLimitPerStatus, since: sinceDate },
   450→  );
   451→
   452→  // Combine notes from all statuses, preserving representation from each
   453→  const recentNotes = [...inProgressNotes, ...pendingReviewNotes, ...completedNotes]
   454→    .sort(
   455→      (a, b) =>
   456→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   457→    );
   458→
   459→  // Get incomplete todos from active tasks
   460→  const activeTodos = collectIncompleteTodos(
   461→    allTasks.filter((t) => t.status === "in_progress" || t.status === "needs_work"),
   462→    index,
   463→    { limit: options.full ? limit * 2 : limit },
   464→  );
   465→
   466→  // Get ready tasks (optionally filtered to automation-eligible only)
   467→  const readyTasks = getReadyTasks(allTasks)
   468→    .filter((t) => !options.eligible || t.automation === "eligible")
   469→    .slice(0, options.full ? undefined : limit)
   470→    .map((t) => toReadyTaskSummary(t, index));
   471→
   472→  // Get blocked tasks
   473→  const blockedTasks = allTasks
   474→    .filter((t) => t.status === "blocked")
   475→    .slice(0, options.full ? undefined : limit)
   476→    .map((t) => toBlockedTaskSummary(t, allTasks, index));
   477→
   478→  // Get recently completed tasks
   479→  const recentlyCompleted = allTasks
   480→    .filter((t) => {
   481→      if (t.status !== "completed" || !t.completed_at) return false;
   482→      const completedDate = new Date(t.completed_at);
   483→      if (sinceDate && completedDate < sinceDate) return false;
   484→      return true;
   485→    })
   486→    .sort((a, b) => {
   487→      // Sort by completed_at descending (most recent first)
   488→      const aDate = new Date(a.completed_at || 0);
   489→      const bDate = new Date(b.completed_at || 0);
   490→      return bDate.getTime() - aDate.getTime();
   491→    })
   492→    .slice(0, options.full ? undefined : limit)
   493→    .map((t) => toCompletedTaskSummary(t, index));
   494→
   495→  // Get git info
   496→  let branch: string | null = null;
   497→  let recentCommits: CommitSummary[] = [];
   498→  let workingTree: GitWorkingTree | null = null;
   499→
   500→  if (showGit && isGitRepo(ctx.rootDir)) {
   501→    branch = getCurrentBranch(ctx.rootDir);
   502→
   503→    const commits = getRecentCommits({
   504→      limit: options.full ? limit * 2 : limit,
   505→      since: sinceDate || undefined,
   506→      cwd: ctx.rootDir,
   507→    });
   508→
   509→    recentCommits = commits.map((c) => ({
   510→      hash: c.hash,
   511→      full_hash: c.fullHash,
   512→      date: c.date.toISOString(),
   513→      message: c.message,
   514→      author: c.author,
   515→    }));
   516→
   517→    workingTree = getWorkingTreeStatus(ctx.rootDir);
   518→  }
   519→
   520→  // Get inbox items (oldest first to encourage triage)
   521→  const inboxSummaries: InboxSummary[] = inboxItems
   522→    .sort(
   523→      (a, b) =>
   524→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
   525→    )
   526→    .slice(0, options.full ? undefined : limit)
   527→    .map((item) => ({
   528→      ref: item._ulid.slice(0, 8),
   529→      text: item.text,
   530→      created_at: item.created_at,
   531→      tags: item.tags,
   532→      added_by: item.added_by || null,
   533→    }));
   534→
   535→  // Load session context (focus, threads, questions)
   536→  const sessionContext = await loadSessionContext(ctx);
   537→
   538→  return {
   539→    generated_at: new Date().toISOString(),
   540→    branch,
   541→    context: sessionContext,
   542→    active_tasks: activeTasks,
   543→    pending_review_tasks: pendingReviewTasks,
   544→    recent_notes: recentNotes,
   545→    active_todos: activeTodos,
   546→    ready_tasks: readyTasks,
   547→    blocked_tasks: blockedTasks,
   548→    recently_completed: recentlyCompleted,
   549→    recent_commits: recentCommits,
   550→    working_tree: workingTree,
   551→    inbox_items: inboxSummaries,
   552→    stats,
   553→  };
   554→}
   555→
   556→// ─── Iteration Stats ─────────────────────────────────────────────────────────
   557→
   558→/**
   559→ * Stats for tasks completed/started within a time window.
   560→ * Used by ralph to track task completions per iteration.
   561→ */
   562→export interface IterationStats {
   563→  /** Number of tasks completed since the given time */
   564→  tasks_completed: number;
   565→  /** Number of tasks started since the given time */
   566→  tasks_started: number;
   567→  /** References of completed tasks */
   568→  completed_refs: string[];
   569→}
   570→
   571→/**
   572→ * Get iteration stats - tasks completed/started since a given time.
   573→ * AC: @ralph-task-limit ac-detection
   574→ */
   575→export async function getIterationStats(
   576→  ctx: KspecContext,
   577→  since: Date,
   578→): Promise<IterationStats> {
   579→  const allTasks = await loadAllTasks(ctx);
   580→
   581→  const completedSince = allTasks.filter((t) => {
   582→    if (t.status !== "completed" || !t.completed_at) return false;
   583→    return new Date(t.completed_at) >= since;
   584→  });
   585→
   586→  const startedSince = allTasks.filter((t) => {
   587→    if (!t.started_at) return false;
   588→    return new Date(t.started_at) >= since;
   589→  });
   590→
   591→  // Use first slug or ULID prefix as ref
   592→  const getRef = (t: LoadedTask) =>
   593→    t.slugs.length > 0 ? `@${t.slugs[0]}` : `@${t._ulid.slice(0, 8)}`;
   594→
   595→  return {
   596→    tasks_completed: completedSince.length,
   597→    tasks_started: startedSince.length,
   598→    completed_refs: completedSince.map(getRef),
   599→  };
   600→}
   601→
   602→// ─── Checkpoint ──────────────────────────────────────────────────────────────
   603→
   604→export interface CheckpointOptions {
   605→  force?: boolean;
   606→  /** Set when stop hook is already active (retry after previous block) */
   607→  stopHookActive?: boolean;
   608→}
   609→
   610→/** Claude Code hook input for Stop hooks */
   611→export interface StopHookInput {
   612→  session_id?: string;
   613→  transcript_path?: string;
   614→  hook_event_name?: string;
   615→  stop_hook_active?: boolean;
   616→}
   617→
   618→/**
   619→ * Perform session checkpoint - check for uncommitted work before ending session.
   620→ *
   621→ * This is designed for use as a Claude Code stop hook. It checks for:
   622→ * - Uncommitted git changes (staged, unstaged, untracked)
   623→ * - Tasks in in_progress status
   624→ * - Incomplete todos on active tasks
   625→ *
   626→ * Returns a structured result indicating whether the session can end cleanly.
   627→ */
   628→export async function performCheckpoint(
   629→  ctx: KspecContext,
   630→  options: CheckpointOptions,
   631→): Promise<CheckpointResult> {
   632→  const issues: CheckpointIssue[] = [];
   633→  const instructions: string[] = [];
   634→
   635→  // Load tasks
   636→  const allTasks = await loadAllTasks(ctx);
   637→
   638→  // Check for in-progress tasks
   639→  const inProgressTasks = allTasks.filter((t) => t.status === "in_progress");
   640→  for (const task of inProgressTasks) {
   641→    const ref = task.slugs[0]
   642→      ? `@${task.slugs[0]}`
   643→      : `@${task._ulid.slice(0, 8)}`;
   644→    issues.push({
   645→      type: "in_progress_task",
   646→      description: `Task ${ref} is still in progress: ${task.title}`,
   647→      details: {
   648→        ref,
   649→        title: task.title,
   650→        started_at: task.started_at,
   651→      },
   652→    });
   653→
   654→    // Check for incomplete todos on this task
   655→    const incompleteTodos = task.todos.filter((t) => !t.done);
   656→    for (const todo of incompleteTodos) {
   657→      issues.push({
   658→        type: "incomplete_todo",
   659→        description: `Incomplete todo on ${ref}: ${todo.text}`,
   660→        details: {
   661→          task_ref: ref,
   662→          todo_id: todo.id,
   663→          text: todo.text,
   664→        },
   665→      });
   666→    }
   667→  }
   668→
   669→  // Check for uncommitted git changes
   670→  if (isGitRepo(ctx.rootDir)) {
   671→    const workingTree = getWorkingTreeStatus(ctx.rootDir);
   672→    if (!workingTree.clean) {
   673→      const changeCount =
   674→        workingTree.staged.length +
   675→        workingTree.unstaged.length +
   676→        workingTree.untracked.length;
   677→
   678→      issues.push({
   679→        type: "uncommitted_changes",
   680→        description: `${changeCount} uncommitted changes in working tree`,
   681→        details: {
   682→          staged: workingTree.staged.length,
   683→          unstaged: workingTree.unstaged.length,
   684→          untracked: workingTree.untracked.length,
   685→        },
   686→      });
   687→    }
   688→  }
   689→
   690→  // Build instructions based on issues
   691→  if (issues.length > 0 && !options.force) {
   692→    instructions.push(
   693→      "If you've been instructed to ignore this message or are working on",
   694→    );
   695→    instructions.push(
   696→      "unrelated things to any in progress tasks then disregard this message,",
   697→    );
   698→    instructions.push("otherwise before ending this session, please:");
   699→
   700→    const hasInProgress = issues.some((i) => i.type === "in_progress_task");
   701→    const hasUncommitted = issues.some((i) => i.type === "uncommitted_changes");
   702→    const hasIncompleteTodos = issues.some((i) => i.type === "incomplete_todo");
   703→
   704→    let step = 1;
   705→
   706→    if (hasInProgress) {
   707→      instructions.push(
   708→        `${step++}. Read in-progress task notes to get full context of the current task status`,
   709→      );
   710→      instructions.push(
   711→        `${step++}. Add notes documenting current state if any context is missing from this session`,
   712→      );
   713→      instructions.push(
   714→        `${step++}. Complete the task if you've completed the objectives and no AC are left uncovered\notherwise leave it in progress for a future session`,
   715→      );
   716→    }
   717→
   718→    if (hasIncompleteTodos) {
   719→      instructions.push(
   720→        `${step++}. Complete or acknowledge incomplete todos on active tasks`,
   721→      );
   722→    }
   723→
   724→    if (hasUncommitted) {
   725→      instructions.push(
   726→        `${step++}. Commit your changes with a descriptive message`,
   727→      );
   728→
   729→      // Add WIP commit guidance if there are in-progress tasks
   730→      if (inProgressTasks.length > 0) {
   731→        const task = inProgressTasks[0];
   732→        const guidance = formatCommitGuidance(task, { wip: true });
   733→        instructions.push("");
   734→        instructions.push("Suggested WIP commit:");
   735→        instructions.push(`  ${guidance.message}`);
   736→        instructions.push("");
   737→        for (const trailer of guidance.trailers) {
   738→          instructions.push(`  ${trailer}`);
   739→        }
   740→      }
   741→    }
   742→
   743→    instructions.push("");
   744→    instructions.push("Use: kspec task @task to get current task state");
   745→    instructions.push(
   746→      'Use: kspec task note @task "Progress notes..." to document state',
   747→    );
   748→    instructions.push(
   749→      'Use: kspec task complete @task --reason "Summary" if task is done',
   750→    );
   751→  }
   752→
   753→  // Allow stop if:
   754→  // - No issues found
   755→  // - --force flag passed
   756→  // - This is a retry (stop_hook_active = true from previous block)
   757→  const isRetry = options.stopHookActive === true;
   758→  const ok = issues.length === 0 || options.force === true || isRetry;
   759→
   760→  let message: string;
   761→  if (isRetry && issues.length > 0) {
   762→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) acknowledged - allowing stop`;
   763→  } else if (ok) {
   764→    message = "[kspec] Session checkpoint passed - ready to end session";
   765→  } else {
   766→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) need attention`;
   767→  }
   768→
   769→  return {
   770→    ok,
   771→    message,
   772→    issues,
   773→    instructions,
   774→  };
   775→}
   776→
   777→// ─── Output Formatting ───────────────────────────────────────────────────────
   778→
   779→function formatCheckpointResult(result: CheckpointResult): void {
   780→  if (result.ok) {
   781→    console.log(chalk.green(result.message));
   782→  } else {
   783→    console.log(chalk.yellow(result.message));
   784→    console.log("");
   785→
   786→    for (const issue of result.issues) {
   787→      const icon =
   788→        issue.type === "uncommitted_changes"
   789→          ? chalk.yellow("⚠")
   790→          : issue.type === "in_progress_task"
   791→            ? chalk.blue("●")
   792→            : chalk.gray("○");
   793→      console.log(`  ${icon} ${issue.description}`);
   794→    }
   795→
   796→    if (result.instructions.length > 0) {
   797→      console.log("");
   798→      for (const instruction of result.instructions) {
   799→        console.log(chalk.gray(instruction));
   800→      }
   801→    }
   802→  }
   803→}
   804→
   805→function formatSessionContext(
   806→  ctx: SessionContext,
   807→  options: SessionOptions,
   808→): void {
   809→  const isBrief = !options.full;
   810→
   811→  // Header
   812→  console.log(`\n${sessionHeaders.title}`);
   813→  const age = formatRelativeTime(new Date(ctx.generated_at));
   814→  if (ctx.branch) {
   815→    console.log(chalk.gray(`Branch: ${ctx.branch} | Generated: ${age}`));
   816→  } else {
   817→    console.log(chalk.gray(`Generated: ${age}`));
   818→  }
   819→
   820→  // Stats summary
   821→  const pendingReviewNote =
   822→    ctx.stats.pending_review > 0
   823→      ? `${ctx.stats.pending_review} awaiting review, `
   824→      : "";
   825→  const inboxNote =
   826→    ctx.stats.inbox_items > 0 ? ` | Inbox: ${ctx.stats.inbox_items}` : "";
   827→  console.log(
   828→    chalk.gray(
   829→      `Tasks: ${ctx.stats.in_progress} active, ${pendingReviewNote}${ctx.stats.ready} ready, ` +
   830→        `${ctx.stats.blocked} blocked, ${ctx.stats.completed}/${ctx.stats.total_tasks} completed${inboxNote}`,
   831→    ),
   832→  );
   833→
   834→  // Session context section (focus, threads, questions)
   835→  if (
   836→    ctx.context &&
   837→    (ctx.context.focus ||
   838→      ctx.context.threads.length > 0 ||
   839→      ctx.context.open_questions.length > 0)
   840→  ) {
   841→    console.log("\n--- Session Context ---");
   842→
   843→    if (ctx.context.focus) {
   844→      console.log(`  ${chalk.cyan("Focus:")} ${ctx.context.focus}`);
   845→    }
   846→
   847→    if (ctx.context.threads.length > 0) {
   848→      console.log(`  ${chalk.cyan("Active Threads:")}`);
   849→      for (const thread of ctx.context.threads) {
   850→        console.log(`    - ${thread}`);
   851→      }
   852→    }
   853→
   854→    if (ctx.context.open_questions.length > 0) {
   855→      console.log(`  ${chalk.cyan("Open Questions:")}`);
   856→      for (const question of ctx.context.open_questions) {
   857→        console.log(`    - ${question}`);
   858→      }
   859→    }
   860→  }
   861→
   862→  // Active tasks section
   863→  if (ctx.active_tasks.length > 0) {
   864→    console.log(`\n${sessionHeaders.activeWork}`);
   865→    for (const task of ctx.active_tasks) {
   866→      const started = task.started_at
   867→        ? chalk.gray(
   868→            ` (started ${formatRelativeTime(new Date(task.started_at))})`,
   869→          )
   870→        : "";
   871→      const priority =
   872→        task.priority <= 2
   873→          ? chalk.red(`P${task.priority}`)
   874→          : chalk.gray(`P${task.priority}`);
   875→      console.log(
   876→        `  ${chalk.blue("[in_progress]")} ${priority} ${task.ref} ${task.title}${started}`,
   877→      );
   878→    }
   879→  } else {
   880→    console.log(`\n${sessionHeaders.noActiveWork}`);
   881→  }
   882→
   883→  // Awaiting review section
   884→  if (ctx.pending_review_tasks.length > 0) {
   885→    console.log(`\n${sessionHeaders.awaitingReview}`);
   886→    for (const task of ctx.pending_review_tasks) {
   887→      const priority =
   888→        task.priority <= 2
   889→          ? chalk.red(`P${task.priority}`)
   890→          : chalk.gray(`P${task.priority}`);
   891→      console.log(
   892→        `  ${chalk.yellow("[pending_review]")} ${priority} ${task.ref} ${task.title}`,
   893→      );
   894→    }
   895→  }
   896→
   897→  // Recently completed section
   898→  if (ctx.recently_completed.length > 0) {
   899→    console.log(`\n${sessionHeaders.recentlyCompleted}`);
   900→    const observationPromotedTasks: string[] = [];
   901→    for (const task of ctx.recently_completed) {
   902→      const completedAge = formatRelativeTime(new Date(task.completed_at));
   903→      let reason = "";
   904→      if (task.closed_reason) {
   905→        const maxLen = isBrief ? 60 : 120;
   906→        const truncated =
   907→          task.closed_reason.length > maxLen
   908→            ? `${task.closed_reason.slice(0, maxLen).trim()}...`
   909→            : task.closed_reason;
   910→        reason = chalk.gray(` - ${truncated}`);
   911→      }
   912→      console.log(
   913→        `  ${chalk.green("[completed]")} ${task.ref} ${task.title} ${chalk.gray(`(${completedAge})`)}${reason}`,
   914→      );
   915→
   916→      // Track tasks that came from observations
   917→      if (task.origin === "observation_promotion") {
   918→        observationPromotedTasks.push(task.ref);
   919→      }
   920→    }
   921→
   922→    // Show reminder about resolving observations
   923→    if (observationPromotedTasks.length > 0) {
   924→      console.log(
   925→        chalk.yellow(
   926→          `\n  ℹ Consider resolving linked observations: ${observationPromotedTasks.join(", ")}`,
   927→        ),
   928→      );
   929→      console.log(
   930→        chalk.gray(`    Run: kspec meta observations --pending-resolution`),
   931→      );
   932→    }
   933→  }
   934→
   935→  // Recent notes section - grouped by task status
   936→  // AC: @cmd-session-start ac-1, ac-2
   937→  if (ctx.recent_notes.length > 0) {
   938→    console.log(`\n${sessionHeaders.recentNotes}`);
   939→
   940→    // Group notes by task status
   941→    const inProgressNotes = ctx.recent_notes.filter(
   942→      (n) => n.task_status === "in_progress",
   943→    );
   944→    const pendingReviewNotes = ctx.recent_notes.filter(
   945→      (n) => n.task_status === "pending_review",
   946→    );
   947→    const completedNotes = ctx.recent_notes.filter(
   948→      (n) => n.task_status === "completed",
   949→    );
   950→
   951→    // Helper to format a single note
   952→    const formatNote = (note: NoteSummary) => {
   953→      const age = formatRelativeTime(new Date(note.created_at));
   954→      const author = note.author ? chalk.gray(` by ${note.author}`) : "";
   955→      console.log(`    ${chalk.yellow(age)} on ${note.task_ref}${author}:`);
   956→
   957→      // Truncate content in brief mode
   958→      let content = note.content.trim();
   959→      if (isBrief && content.length > 200) {
   960→        content = `${content.slice(0, 200).trim()}...`;
   961→      }
   962→
   963→      // Indent content, limit lines in brief mode
   964→      const lines = content.split("\n");
   965→      const maxLines = isBrief ? 3 : lines.length;
   966→      for (const line of lines.slice(0, maxLines)) {
   967→        console.log(`      ${chalk.white(line)}`);
   968→      }
   969→      if (isBrief && lines.length > maxLines) {
   970→        console.log(
   971→          chalk.gray(`      ... (${lines.length - maxLines} more lines)`),
   972→        );
   973→      }
   974→    };
   975→
   976→    // AC: @cmd-session-start ac-1 - In Progress notes
   977→    if (inProgressNotes.length > 0) {
   978→      console.log(`  ${chalk.blue("In Progress:")}`);
   979→      for (const note of inProgressNotes) {
   980→        formatNote(note);
   981→      }
   982→    }
   983→
   984→    // AC: @cmd-session-start ac-1 - Pending Review notes (grouped separately)
   985→    if (pendingReviewNotes.length > 0) {
   986→      console.log(`  ${chalk.yellow("Pending Review:")}`);
   987→      for (const note of pendingReviewNotes) {
   988→        formatNote(note);
   989→      }
   990→    }
   991→
   992→    // AC: @cmd-session-start ac-2 - Recently Completed notes
   993→    if (completedNotes.length > 0) {
   994→      console.log(`  ${chalk.green("Recently Completed:")}`);
   995→      for (const note of completedNotes) {
   996→        formatNote(note);
   997→      }
   998→    }
   999→  }
  1000→
  1001→  // Incomplete todos section
  1002→  if (ctx.active_todos.length > 0) {
  1003→    console.log(`\n${sessionHeaders.incompleteTodos}`);
  1004→    for (const todo of ctx.active_todos) {
  1005→      console.log(
  1006→        `  ${chalk.yellow("[ ]")} ${todo.task_ref}#${todo.id}: ${todo.text}`,
  1007→      );
  1008→    }
  1009→  }
  1010→
  1011→  // Ready tasks section
  1012→  if (ctx.ready_tasks.length > 0) {
  1013→    console.log(`\n${sessionHeaders.readyTasks}`);
  1014→    for (const task of ctx.ready_tasks) {
  1015→      const priority =
  1016→        task.priority <= 2
  1017→          ? chalk.red(`P${task.priority}`)
  1018→          : chalk.gray(`P${task.priority}`);
  1019→      const tags =
  1020→        task.tags.length > 0 ? chalk.cyan(` #${task.tags.join(" #")}`) : "";
  1021→      console.log(`  ${priority} ${task.ref} ${task.title}${tags}`);
  1022→    }
  1023→  }
  1024→
  1025→  // Blocked tasks section
  1026→  if (ctx.blocked_tasks.length > 0) {
  1027→    console.log(`\n${sessionHeaders.blocked}`);
  1028→    for (const task of ctx.blocked_tasks) {
  1029→      console.log(`  ${chalk.red("[blocked]")} ${task.ref} ${task.title}`);
  1030→      if (task.blocked_by.length > 0) {
  1031→        console.log(chalk.gray(`    Blockers: ${task.blocked_by.join(", ")}`));
  1032→      }
  1033→      if (task.unmet_deps.length > 0) {
  1034→        console.log(
  1035→          chalk.gray(`    Waiting on: ${task.unmet_deps.join(", ")}`),
  1036→        );
  1037→      }
  1038→    }
  1039→  }
  1040→
  1041→  // Git commits section
  1042→  if (ctx.recent_commits.length > 0) {
  1043→    console.log(`\n${sessionHeaders.recentCommits}`);
  1044→    for (const commit of ctx.recent_commits) {
  1045→      const age = formatRelativeTime(new Date(commit.date));
  1046→      console.log(
  1047→        `  ${chalk.yellow(commit.hash)} ${commit.message} ${chalk.gray(`(${age}, ${commit.author})`)}`,
  1048→      );
  1049→    }
  1050→  }
  1051→
  1052→  // Inbox section (oldest first to encourage triage)
  1053→  if (ctx.inbox_items.length > 0) {
  1054→    console.log(`\n${sessionHeaders.inbox}`);
  1055→    for (const item of ctx.inbox_items) {
  1056→      const age = formatRelativeTime(new Date(item.created_at));
  1057→      const author = item.added_by ? ` by ${item.added_by}` : "";
  1058→      const tags =
  1059→        item.tags.length > 0 ? chalk.cyan(` [${item.tags.join(", ")}]`) : "";
  1060→      // Truncate text in brief mode
  1061→      let text = item.text;
  1062→      if (isBrief && text.length > 60) {
  1063→        text = `${text.slice(0, 60).trim()}...`;
  1064→      }
  1065→      console.log(
  1066→        `  ${chalk.magenta(item.ref)} ${chalk.gray(`(${age}${author})`)}${tags}`,
  1067→      );
  1068→      console.log(`    ${text}`);
  1069→    }
  1070→    console.log(`  ${hints.inboxPromote}`);
  1071→  }
  1072→
  1073→  // Working tree section
  1074→  if (ctx.working_tree && !ctx.working_tree.clean) {
  1075→    console.log(`\n${sessionHeaders.workingTree}`);
  1076→
  1077→    if (ctx.working_tree.staged.length > 0) {
  1078→      console.log(chalk.green("  Staged:"));
  1079→      for (const file of ctx.working_tree.staged) {
  1080→        console.log(
  1081→          `    ${chalk.green(file.status[0].toUpperCase())} ${file.path}`,
  1082→        );
  1083→      }
  1084→    }
  1085→
  1086→    if (ctx.working_tree.unstaged.length > 0) {
  1087→      console.log(chalk.red("  Modified:"));
  1088→      for (const file of ctx.working_tree.unstaged) {
  1089→        console.log(
  1090→          `    ${chalk.red(file.status[0].toUpperCase())} ${file.path}`,
  1091→        );
  1092→      }
  1093→    }
  1094→
  1095→    if (ctx.working_tree.untracked.length > 0) {
  1096→      console.log(chalk.gray("  Untracked:"));
  1097→      const limit = isBrief ? 5 : ctx.working_tree.untracked.length;
  1098→      for (const path of ctx.working_tree.untracked.slice(0, limit)) {
  1099→        console.log(`    ${chalk.gray("?")} ${path}`);
  1100→      }
  1101→      if (isBrief && ctx.working_tree.untracked.length > limit) {
  1102→        console.log(
  1103→          chalk.gray(
  1104→            `    ... and ${ctx.working_tree.untracked.length - limit} more`,
  1105→          ),
  1106→        );
  1107→      }
  1108→    }
  1109→  } else if (ctx.working_tree?.clean) {
  1110→    console.log(`\n${sessionHeaders.workingTreeClean}`);
  1111→  }
  1112→
  1113→  // Quick Commands section - contextual hints based on state
  1114→  const quickCommands: string[] = [];
  1115→
  1116→  if (ctx.active_tasks.length > 0) {
  1117→    const ref = ctx.active_tasks[0].ref;
  1118→    quickCommands.push(
  1119→      `kspec task note @${ref} "Progress..."  ${chalk.gray("# document work")}`,
  1120→    );
  1121→    quickCommands.push(
  1122→      `kspec task complete @${ref} --reason "..."  ${chalk.gray("# finish task")}`,
  1123→    );
  1124→  } else if (ctx.ready_tasks.length > 0) {
  1125→    const ref = ctx.ready_tasks[0].ref;
  1126→    quickCommands.push(
  1127→      `kspec task start @${ref}  ${chalk.gray("# begin work")}`,
  1128→    );
  1129→  }
  1130→
  1131→  if (ctx.inbox_items.length > 0) {
  1132→    const ref = ctx.inbox_items[0].ref;
  1133→    quickCommands.push(
  1134→      `kspec inbox promote @${ref} --title "..."  ${chalk.gray("# convert to task")}`,
  1135→    );
  1136→  }
  1137→
  1138→  if (ctx.working_tree && !ctx.working_tree.clean) {
  1139→    quickCommands.push(
  1140→      `git add . && git commit -m "..."  ${chalk.gray("# commit changes")}`,
  1141→    );
  1142→  }
  1143→
  1144→  if (quickCommands.length > 0) {
  1145→    console.log(`\n${sessionHeaders.quickCommands}`);
  1146→    for (const hint of quickCommands) {
  1147→      console.log(`  ${hint}`);
  1148→    }
  1149→  }
  1150→
  1151→  console.log(""); // Final newline
  1152→}
  1153→
  1154→// ─── Command Registration ────────────────────────────────────────────────────
  1155→
  1156→async function sessionStartAction(options: SessionOptions): Promise<void> {
  1157→  try {
  1158→    const ctx = await initContext();
  1159→
  1160→    // AC: @shadow-sync ac-2 - Pull remote changes before showing session context
  1161→    let syncResult: ShadowSyncResult | null = null;
  1162→    if (ctx.shadow?.enabled) {
  1163→      syncResult = await shadowPull(ctx.shadow.worktreeDir);
  1164→      // AC: @shadow-sync ac-3 - Warn about conflicts but continue with local state
  1165→      if (syncResult.hadConflict) {
  1166→        console.log(
  1167→          chalk.yellow(
  1168→            "⚠ Shadow sync conflict detected. Run `kspec shadow resolve` to fix.",
  1169→          ),
  1170→        );
  1171→        console.log(chalk.gray("  Continuing with local state..."));
  1172→        console.log("");
  1173→      } else if (syncResult.pulled) {
  1174→        console.log(chalk.gray("ℹ Synced shadow branch from remote"));
  1175→      }
  1176→    }
  1177→
  1178→    const sessionCtx = await gatherSessionContext(ctx, options);
  1179→
  1180→    output(sessionCtx, () => formatSessionContext(sessionCtx, options));
  1181→  } catch (err) {
  1182→    error(errors.failures.gatherSessionContext, err);
  1183→    process.exit(EXIT_CODES.ERROR);
  1184→  }
  1185→}
  1186→
  1187→/**
  1188→ * Read stdin if available (non-blocking check for hook input)
  1189→ */
  1190→async function readStdinIfAvailable(): Promise<string | null> {
  1191→  // Check if stdin is a TTY (interactive) - if so, don't try to read
  1192→  if (process.stdin.isTTY) {
  1193→    return null;
  1194→  }
  1195→
  1196→  return new Promise((resolve) => {
  1197→    let data = "";
  1198→    const timeout = setTimeout(() => {
  1199→      process.stdin.removeAllListeners();
  1200→      resolve(data || null);
  1201→    }, 100); // 100ms timeout for stdin
  1202→
  1203→    process.stdin.setEncoding("utf8");
  1204→    process.stdin.on("data", (chunk) => {
  1205→      data += chunk;
  1206→    });
  1207→    process.stdin.on("end", () => {
  1208→      clearTimeout(timeout);
  1209→      resolve(data || null);
  1210→    });
  1211→    process.stdin.on("error", () => {
  1212→      clearTimeout(timeout);
  1213→      resolve(null);
  1214→    });
  1215→    process.stdin.resume();
  1216→  });
  1217→}
  1218→
  1219→/**
  1220→ * Parse Claude Code hook input from stdin
  1221→ */
  1222→function parseHookInput(stdin: string | null): StopHookInput | null {
  1223→  if (!stdin) return null;
  1224→  try {
  1225→    return JSON.parse(stdin.trim()) as StopHookInput;
  1226→  } catch {
  1227→    return null;
  1228→  }
  1229→}
  1230→
  1231→// ─── Prompt Check (UserPromptSubmit Hook) ────────────────────────────────────
  1232→
  1233→/**
  1234→ * Output spec-first reminder for UserPromptSubmit hook.
  1235→ *
  1236→ * This is a simple context injection - always outputs the reminder,
  1237→ * and Claude (Opus) is smart enough to apply it when relevant.
  1238→ */
  1239→async function sessionPromptCheckAction(): Promise<void> {
  1240→  // Lean, instructive reminder with kspec prefix
  1241→  console.log(sessionPrompt.specCheck);
  1242→}
  1243→
  1244→async function sessionCheckpointAction(
  1245→  options: CheckpointOptions,
  1246→): Promise<void> {
  1247→  try {
  1248→    // Read stdin for Claude Code hook input
  1249→    const stdin = await readStdinIfAvailable();
  1250→    const hookInput = parseHookInput(stdin);
  1251→
  1252→    // Check if this is a retry (stop hook already active)
  1253→    if (hookInput?.stop_hook_active) {
  1254→      options.stopHookActive = true;
  1255→    }
  1256→
  1257→    const ctx = await initContext();
  1258→    const result = await performCheckpoint(ctx, options);
  1259→
  1260→    // Output format depends on mode:
  1261→    // - JSON mode (--json): Output Claude Code hook format {"decision": "block", "reason": "..."}
  1262→    // - Human mode: Output formatted checkpoint result
  1263→    if (isJsonMode()) {
  1264→      if (!result.ok) {
  1265→        // Build reason message with issues and instructions
  1266→        const issueLines = result.issues
  1267→          .map((i) => `- ${i.description}`)
  1268→          .join("\n");
  1269→        const instructionLines = result.instructions
  1270→          .filter((i) => i.trim())
  1271→          .join("\n");
  1272→        const reason = `${result.message}\n\nIssues:\n${issueLines}\n\n${instructionLines}`;
  1273→        console.log(JSON.stringify({ decision: "block", reason }));
  1274→      }
  1275→      // If ok, exit silently (Claude Code expects no output when allowing stop)
  1276→    } else {
  1277→      formatCheckpointResult(result);
  1278→      if (!result.ok) {
  1279→        process.exit(EXIT_CODES.ERROR);
  1280→      }
  1281→    }
  1282→  } catch (err) {
  1283→    // Handle RUNNING_FROM_SHADOW gracefully - skip with warning instead of erroring
  1284→    // This happens when the stop hook runs while cwd is inside .kspec/ directory
  1285→    if (err instanceof ShadowError && err.code === "RUNNING_FROM_SHADOW") {
  1286→      if (!isJsonMode()) {
  1287→        console.log(
  1288→          chalk.yellow(
  1289→            "[kspec] Session checkpoint skipped - running from inside .kspec/ directory",
  1290→          ),
  1291→        );
  1292→      }
  1293→      // Allow stop to proceed (exit successfully, no JSON output blocks the stop)
  1294→      return;
  1295→    }
  1296→    error(errors.failures.runCheckpoint, err);
  1297→    process.exit(EXIT_CODES.ERROR);
  1298→  }
  1299→}
  1300→
  1301→// ─── Session Log List ─────────────────────────────────────────────────────────
  1302→
  1303→interface SessionLogListOptions {
  1304→  status?: string;
  1305→  agent?: string;
  1306→  since?: string;
  1307→  sort?: string;
  1308→  count?: boolean;
  1309→  limit?: string;
  1310→}
  1311→
  1312→type SortField =
  1313→  | "started_at"
  1314→  | "duration"
  1315→  | "events"
  1316→  | "iterations"
  1317→  | "tasks_completed";
  1318→
  1319→const VALID_SORT_FIELDS: SortField[] = [
  1320→  "started_at",
  1321→  "duration",
  1322→  "events",
  1323→  "iterations",
  1324→  "tasks_completed",
  1325→];
  1326→
  1327→/**
  1328→ * Format a duration in milliseconds to a human-readable string.
  1329→ */
  1330→function formatDuration(ms: number): string {
  1331→  if (ms < 0) return "—";
  1332→  const totalSec = Math.floor(ms / 1000);
  1333→  const hours = Math.floor(totalSec / 3600);
  1334→  const minutes = Math.floor((totalSec % 3600) / 60);
  1335→  if (hours > 0) {
  1336→    return `${hours}h ${minutes}m`;
  1337→  }
  1338→  if (minutes > 0) {
  1339→    return `${minutes}m`;
  1340→  }
  1341→  return `${totalSec}s`;
  1342→}
  1343→
  1344→/**
  1345→ * Sort session summaries by the specified field.
  1346→ * Default: started_at descending.
  1347→ *
  1348→ * AC: @session-log-list ac-5
  1349→ */
  1350→function sortSessions(
  1351→  sessions: SessionLogSummary[],
  1352→  sortField: SortField,
  1353→): SessionLogSummary[] {
  1354→  return [...sessions].sort((a, b) => {
  1355→    switch (sortField) {
  1356→      case "started_at":
  1357→        return (
  1358→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  1359→        );
  1360→      case "duration":
  1361→        return b.duration_ms - a.duration_ms;
  1362→      case "events":
  1363→        return b.event_count - a.event_count;
  1364→      case "iterations":
  1365→        return b.iteration_count - a.iteration_count;
  1366→      case "tasks_completed":
  1367→        return b.tasks_completed - a.tasks_completed;
  1368→      default:
  1369→        return (
  1370→          new Date(b.started_at).getTime() - new Date(a.started_at).getTime()
  1371→        );
  1372→    }
  1373→  });
  1374→}
  1375→
  1376→/**
  1377→ * Format the session log list as a table.
  1378→ *
  1379→ * AC: @session-log-list ac-1
  1380→ */
  1381→function formatSessionLogList(sessions: SessionLogSummary[]): void {
  1382→  if (sessions.length === 0) {
  1383→    // AC: @session-log-list ac-6
  1384→    console.log("No sessions found.");
  1385→    return;
  1386→  }
  1387→
  1388→  // Table header
  1389→  console.log(
  1390→    chalk.gray(
  1391→      `${"ID".padEnd(10)} ${"Status".padEnd(11)} ${"Agent".padEnd(20)} ${"Started".padEnd(16)} ${"Duration".padEnd(10)} ${"Events".padEnd(8)} ${"Iters".padEnd(7)} Tasks`,
  1392→    ),
  1393→  );
  1394→  console.log(chalk.gray("─".repeat(95)));
  1395→
  1396→  for (const s of sessions) {
  1397→    const id = s.id.slice(0, 8);
  1398→    const statusColor =
  1399→      s.status === "completed"
  1400→        ? chalk.green
  1401→        : s.status === "active"
  1402→          ? chalk.blue
  1403→          : chalk.yellow;
  1404→    const status = statusColor(s.status.padEnd(11));
  1405→    const agent = s.agent_type.slice(0, 20).padEnd(20);
  1406→    const started = formatRelativeTime(new Date(s.started_at)).padEnd(16);
  1407→    const duration = formatDuration(s.duration_ms).padEnd(10);
  1408→    const events = String(s.event_count).padEnd(8);
  1409→    const iters = String(s.iteration_count).padEnd(7);
  1410→    const tasks = String(s.tasks_completed);
  1411→
  1412→    console.log(
  1413→      `${chalk.yellow(id)} ${status} ${chalk.gray(agent)} ${chalk.gray(started)} ${duration} ${events} ${iters} ${tasks}`,
  1414→    );
  1415→  }
  1416→
  1417→  console.log(chalk.gray(`\n${sessions.length} session(s)`));
  1418→}
  1419→
  1420→/**
  1421→ * Session log list action handler.
  1422→ */
  1423→async function sessionLogListAction(
  1424→  options: SessionLogListOptions,
  1425→): Promise<void> {
  1426→  try {
  1427→    const ctx = await initContext();
  1428→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
  1429→
  1430→    // AC: @session-log-list ac-2 - Filter by status
  1431→    if (options.status) {
  1432→      const statusFilter = options.status as SessionStatus;
  1433→      sessions = sessions.filter((s) => s.status === statusFilter);
  1434→    }
  1435→
  1436→    // AC: @session-log-list ac-4 - Filter by agent type
  1437→    if (options.agent) {
  1438→      const agentFilter = options.agent;
  1439→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
  1440→    }
  1441→
  1442→    // AC: @session-log-list ac-3 - Filter by since date
  1443→    if (options.since) {
  1444→      const sinceDate = parseTimeSpec(options.since);
  1445→      if (sinceDate) {
  1446→        sessions = sessions.filter(
  1447→          (s) => new Date(s.started_at) >= sinceDate,
  1448→        );
  1449→      }
  1450→    }
  1451→
  1452→    // AC: @session-log-list ac-5 - Sort
  1453→    const sortField: SortField =
  1454→      options.sort && VALID_SORT_FIELDS.includes(options.sort as SortField)
  1455→        ? (options.sort as SortField)
  1456→        : "started_at";
  1457→    sessions = sortSessions(sessions, sortField);
  1458→
  1459→    // AC: @session-log-list ac-7 - Limit output count
  1460→    if (options.count) {
  1461→      // AC: @trait-filterable-list ac-8
  1462→      output({ count: sessions.length }, () => {
  1463→        console.log(sessions.length);
  1464→      });
  1465→      return;
  1466→    }
  1467→
  1468→    // Apply --limit (after filtering/sorting, before display)
  1469→    if (options.limit) {
  1470→      const limit = parseInt(options.limit, 10);
  1471→      if (!Number.isNaN(limit) && limit > 0) {
  1472→        sessions = sessions.slice(0, limit);
  1473→      }
  1474→    }
  1475→
  1476→    output(sessions, () => formatSessionLogList(sessions));
  1477→  } catch (err) {
  1478→    error("Failed to list session logs", err);
  1479→    process.exit(EXIT_CODES.ERROR);
  1480→  }
  1481→}
  1482→
  1483→// ─── Session Log Show ─────────────────────────────────────────────────────────
  1484→
  1485→interface SessionLogShowOptions {
  1486→  events?: boolean;
  1487→  type?: string;
  1488→  limit?: string;
  1489→  context?: string;
  1490→}
  1491→
  1492→/**
  1493→ * Format an event timestamp as relative time from session start.
  1494→ */
  1495→function formatEventTimestamp(
  1496→  eventTs: number,
  1497→  sessionStartTs: number,
  1498→): string {
  1499→  const relativeMs = eventTs - sessionStartTs;
  1500→  const totalSec = Math.floor(relativeMs / 1000);
  1501→  const minutes = Math.floor(totalSec / 60);
  1502→  const seconds = totalSec % 60;
  1503→  if (minutes > 0) {
  1504→    return `+${minutes}m${seconds}s`;
  1505→  }
  1506→  return `+${seconds}s`;
  1507→}
  1508→
  1509→/**
  1510→ * Summarize event data for display.
  1511→ * Returns a short string describing the event payload.
  1512→ */
  1513→function summarizeEventData(event: SessionEvent): string {
  1514→  const data = event.data as Record<string, unknown> | null;
  1515→  if (!data) return "";
  1516→
  1517→  // Handle tool_call events
  1518→  if (event.type === "session.update") {
  1519→    const update = data.update as {
  1520→      sessionUpdate?: string;
  1521→      rawInput?: { command?: string };
  1522→      _meta?: { claudeCode?: { toolName?: string } };
  1523→    } | null;
  1524→    if (update?.sessionUpdate === "tool_call") {
  1525→      const toolName = update._meta?.claudeCode?.toolName || "unknown";
  1526→      const command = update.rawInput?.command;
  1527→      if (command) {
  1528→        const truncated =
  1529→          command.length > 60 ? command.slice(0, 57) + "..." : command;
  1530→        return `${toolName}: ${truncated}`;
  1531→      }
  1532→      return toolName;
  1533→    }
  1534→  }
  1535→
  1536→  // Handle prompt.sent events
  1537→  if (event.type === "prompt.sent") {
  1538→    const prompt = data.prompt as string | null;
  1539→    if (prompt) {
  1540→      const truncated =
  1541→        prompt.length > 60 ? prompt.slice(0, 57) + "..." : prompt;
  1542→      return truncated;
  1543→    }
  1544→  }
  1545→
  1546→  // Handle session.start/end
  1547→  if (event.type === "session.start") {
  1548→    return "Session started";
  1549→  }
  1550→  if (event.type === "session.end") {
  1551→    const reason = data.reason as string | null;
  1552→    return reason ? `Session ended: ${reason}` : "Session ended";
  1553→  }
  1554→
  1555→  // Default: show first key
  1556→  const keys = Object.keys(data);
  1557→  if (keys.length > 0) {
  1558→    return `{${keys.slice(0, 3).join(", ")}${keys.length > 3 ? ", ..." : ""}}`;
  1559→  }
  1560→  return "";
  1561→}
  1562→
  1563→/**
  1564→ * Format the session log show output.
  1565→ *
  1566→ * AC: @session-log-show ac-1
  1567→ */
  1568→function formatSessionLogShow(
  1569→  detail: SessionLogDetail,
  1570→  events: SessionEvent[] | null,
  1571→  contextSnapshot: unknown | null,
  1572→  sessionStartTs: number,
  1573→): void {
  1574→  // AC: @session-log-show ac-1 - Session metadata
  1575→  console.log(chalk.bold(`Session ${detail.id.slice(0, 8)}`));
  1576→  console.log(chalk.gray("─".repeat(60)));
  1577→  console.log(`  ID:        ${detail.id}`);
  1578→
  1579→  const statusColor =
  1580→    detail.status === "completed"
  1581→      ? chalk.green
  1582→      : detail.status === "active"
  1583→        ? chalk.blue
  1584→        : chalk.yellow;
  1585→  console.log(`  Status:    ${statusColor(detail.status)}`);
  1586→  console.log(`  Agent:     ${detail.agent_type}`);
  1587→  if (detail.task_id) {
  1588→    console.log(`  Task:      ${detail.task_id}`);
  1589→  }
  1590→  console.log(`  Started:   ${detail.started_at}`);
  1591→  if (detail.ended_at) {
  1592→    console.log(`  Ended:     ${detail.ended_at}`);
  1593→  }
  1594→  console.log(`  Duration:  ${formatDuration(detail.duration_ms)}`);
  1595→  console.log(`  Events:    ${detail.event_count}`);
  1596→  console.log(`  Iterations: ${detail.iteration_count}`);
  1597→
  1598→  // AC: @session-log-show ac-2 - Per-iteration summary
  1599→  if (detail.iterations.length > 0) {
  1600→    console.log("\n" + chalk.bold("Iterations"));
  1601→    console.log(chalk.gray("─".repeat(60)));
  1602→    for (const iter of detail.iterations) {
  1603→      const taskInfo: string[] = [];
  1604→      if (iter.tasks_started.length > 0) {
  1605→        taskInfo.push(`started: ${iter.tasks_started.join(", ")}`);
  1606→      }
  1607→      if (iter.tasks_completed.length > 0) {
  1608→        taskInfo.push(`completed: ${iter.tasks_completed.join(", ")}`);
  1609→      }
  1610→      const taskStr = taskInfo.length > 0 ? ` | ${taskInfo.join(" | ")}` : "";
  1611→      console.log(
  1612→        `  ${chalk.cyan(`[${iter.iteration}]`)} ${iter.event_count} events${taskStr}`,
  1613→      );
  1614→    }
  1615→  }
  1616→
  1617→  // AC: @session-log-show ac-3 - Event timeline
  1618→  if (events !== null) {
  1619→    console.log("\n" + chalk.bold("Events"));
  1620→    console.log(chalk.gray("─".repeat(60)));
  1621→    if (events.length === 0) {
  1622→      console.log(chalk.gray("  No events to display."));
  1623→    } else {
  1624→      for (const event of events) {
  1625→        const timestamp = formatEventTimestamp(event.ts, sessionStartTs);
  1626→        const summary = summarizeEventData(event);
  1627→        const typeColor =
  1628→          event.type === "session.start" || event.type === "session.end"
  1629→            ? chalk.green
  1630→            : event.type === "session.update"
  1631→              ? chalk.blue
  1632→              : chalk.gray;
  1633→        console.log(
  1634→          `  ${chalk.yellow(timestamp.padEnd(10))} ${typeColor(event.type.padEnd(16))} ${chalk.gray(summary)}`,
  1635→        );
  1636→      }
  1637→    }
  1638→  }
  1639→
  1640→  // AC: @session-log-show ac-6 - Context snapshot
  1641→  if (contextSnapshot !== null) {
  1642→    console.log("\n" + chalk.bold("Context Snapshot"));
  1643→    console.log(chalk.gray("─".repeat(60)));
  1644→    console.log(JSON.stringify(contextSnapshot, null, 2));
  1645→  }
  1646→}
  1647→
  1648→/**
  1649→ * Session log show action handler.
  1650→ */
  1651→async function sessionLogShowAction(
  1652→  sessionRef: string,
  1653→  options: SessionLogShowOptions,
  1654→): Promise<void> {
  1655→  try {
  1656→    const ctx = await initContext();
  1657→
  1658→    // AC: @session-log-show ac-7, ac-8, ac-9 - Resolve session ID
  1659→    const resolution = await resolveSessionId(ctx.specDir, sessionRef);
  1660→
  1661→    if (!resolution.ok) {
  1662→      if (resolution.error === "not_found") {
  1663→        // AC: @session-log-show ac-9
  1664→        error(`Session not found: ${sessionRef}`);
  1665→        process.exit(EXIT_CODES.NOT_FOUND);
  1666→      } else {
  1667→        // AC: @session-log-show ac-8
  1668→        error(
  1669→          `Ambiguous session ID prefix. Matches:\n  ${resolution.matches.join("\n  ")}\nPlease provide a more specific prefix.`,
  1670→        );
  1671→        process.exit(EXIT_CODES.VALIDATION_FAILED);
  1672→      }
  1673→    }
  1674→
  1675→    const sessionId = resolution.id;
  1676→
  1677→    // Get session detail
  1678→    const detail = await getSessionLogDetail(ctx.specDir, sessionId);
  1679→    if (!detail) {
  1680→      error(`Session not found: ${sessionId}`);
  1681→      process.exit(EXIT_CODES.NOT_FOUND);
  1682→    }
  1683→
  1684→    // AC: @session-log-show ac-3, ac-4, ac-5 - Event timeline
  1685→    let events: SessionEvent[] | null = null;
  1686→    if (options.events) {
  1687→      let allEvents = await readEvents(ctx.specDir, sessionId);
  1688→
  1689→      // AC: @session-log-show ac-4 - Filter by type
  1690→      if (options.type) {
  1691→        const typeFilter = options.type;
  1692→        allEvents = allEvents.filter((e) => e.type === typeFilter);
  1693→      }
  1694→
  1695→      // AC: @session-log-show ac-5 - Limit to last N events
  1696→      if (options.limit) {
  1697→        const limit = parseInt(options.limit, 10);
  1698→        if (!Number.isNaN(limit) && limit > 0) {
  1699→          allEvents = allEvents.slice(-limit);
  1700→        }
  1701→      }
  1702→
  1703→      events = allEvents;
  1704→    }
  1705→
  1706→    // AC: @session-log-show ac-6 - Context snapshot
  1707→    let contextSnapshot: unknown | null = null;
  1708→    if (options.context) {
  1709→      const iterNum = parseInt(options.context, 10);
  1710→      if (!Number.isNaN(iterNum) && iterNum > 0) {
  1711→        contextSnapshot = await readSessionContext(
  1712→          ctx.specDir,
  1713→          sessionId,
  1714→          iterNum,
  1715→        );
  1716→        if (contextSnapshot === null) {
  1717→          error(`No context snapshot found for iteration ${iterNum}`);
  1718→          process.exit(EXIT_CODES.NOT_FOUND);
  1719→        }
  1720→      } else {
  1721→        error(`Invalid iteration number: ${options.context}`);
  1722→        process.exit(EXIT_CODES.USAGE_ERROR);
  1723→      }
  1724→    }
  1725→
  1726→    const sessionStartTs = new Date(detail.started_at).getTime();
  1727→
  1728→    // Build JSON output structure
  1729→    const jsonOutput = {
  1730→      ...detail,
  1731→      ...(events !== null ? { events } : {}),
  1732→      ...(contextSnapshot !== null ? { context: contextSnapshot } : {}),
  1733→    };
  1734→
  1735→    output(jsonOutput, () =>
  1736→      formatSessionLogShow(detail, events, contextSnapshot, sessionStartTs),
  1737→    );
  1738→  } catch (err) {
  1739→    error("Failed to show session log", err);
  1740→    process.exit(EXIT_CODES.ERROR);
  1741→  }
  1742→}
  1743→
  1744→// ─── Session Log Stats ─────────────────────────────────────────────────────────
  1745→
  1746→interface SessionLogStatsOptions {
  1747→  since?: string;
  1748→  agent?: string;
  1749→  toolUsage?: boolean;
  1750→  byDay?: boolean;
  1751→  byWeek?: boolean;
  1752→}
  1753→
  1754→/**
  1755→ * Full stats output including optional tool usage and time period data.
  1756→ */
  1757→interface SessionLogStatsOutput {
  1758→  stats: SessionLogStats;
  1759→  tool_usage?: ToolUsageStats[];
  1760→  time_periods?: TimePeriodStats[];
  1761→}
  1762→
  1763→/**
  1764→ * Format a duration in milliseconds to human-readable format.
  1765→ * Reuses formatDuration from session log list but handles hours/minutes/seconds.
  1766→ */
  1767→function formatDurationLong(ms: number): string {
  1768→  if (ms < 0) return "—";
  1769→  const totalSec = Math.floor(ms / 1000);
  1770→  const hours = Math.floor(totalSec / 3600);
  1771→  const minutes = Math.floor((totalSec % 3600) / 60);
  1772→  const seconds = totalSec % 60;
  1773→  if (hours > 0 && minutes > 0) {
  1774→    return `${hours}h ${minutes}m`;
  1775→  }
  1776→  if (hours > 0) {
  1777→    return `${hours}h`;
  1778→  }
  1779→  if (minutes > 0) {
  1780→    return `${minutes}m ${seconds}s`;
  1781→  }
  1782→  return `${seconds}s`;
  1783→}
  1784→
  1785→/**
  1786→ * Format the session log stats output.
  1787→ *
  1788→ * AC: @session-log-stats ac-1, ac-2, ac-3
  1789→ */
  1790→function formatSessionLogStats(
  1791→  stats: SessionLogStats,
  1792→  toolUsage: ToolUsageStats[] | null,
  1793→  timePeriods: TimePeriodStats[] | null,
  1794→  groupBy: "day" | "week" | null,
  1795→): void {
  1796→  // AC: @session-log-stats ac-1 - Totals
  1797→  console.log(chalk.bold("Session Statistics"));
  1798→  console.log(chalk.gray("─".repeat(50)));
  1799→  console.log(`  Total Sessions:     ${stats.total_sessions}`);
  1800→  console.log(`  Total Events:       ${stats.total_events}`);
  1801→  console.log(`  Total Iterations:   ${stats.total_iterations}`);
  1802→  console.log(`  Tasks Completed:    ${stats.total_tasks_completed}`);
  1803→  console.log(`  Total Duration:     ${formatDurationLong(stats.total_duration_ms)}`);
  1804→
  1805→  // AC: @session-log-stats ac-2 - Averages
  1806→  console.log("\n" + chalk.bold("Averages"));
  1807→  console.log(chalk.gray("─".repeat(50)));
  1808→  console.log(`  Avg Duration/Session:     ${formatDurationLong(stats.avg_duration_ms)}`);
  1809→  console.log(`  Avg Iterations/Session:   ${stats.avg_iterations_per_session}`);
  1810→  console.log(`  Avg Tasks/Session:        ${stats.avg_tasks_per_session}`);
  1811→
  1812→  // AC: @session-log-stats ac-3 - Status breakdown
  1813→  if (stats.status_breakdown.length > 0) {
  1814→    console.log("\n" + chalk.bold("Status Breakdown"));
  1815→    console.log(chalk.gray("─".repeat(50)));
  1816→    for (const item of stats.status_breakdown) {
  1817→      const statusColor =
  1818→        item.status === "completed"
  1819→          ? chalk.green
  1820→          : item.status === "active"
  1821→            ? chalk.blue
  1822→            : chalk.yellow;
  1823→      console.log(
  1824→        `  ${statusColor(item.status.padEnd(12))} ${String(item.count).padEnd(6)} ${item.percentage}%`,
  1825→      );
  1826→    }
  1827→  }
  1828→
  1829→  // AC: @session-log-stats ac-6 - Tool usage
  1830→  if (toolUsage !== null && toolUsage.length > 0) {
  1831→    console.log("\n" + chalk.bold("Top Tool Usage"));
  1832→    console.log(chalk.gray("─".repeat(50)));
  1833→    for (const tool of toolUsage) {
  1834→      console.log(
  1835→        `  ${tool.tool_name.padEnd(20)} ${String(tool.count).padEnd(8)} ${tool.percentage}%`,
  1836→      );
  1837→    }
  1838→  }
  1839→
  1840→  // AC: @session-log-stats ac-7 - Time periods
  1841→  if (timePeriods !== null && timePeriods.length > 0) {
  1842→    const label = groupBy === "week" ? "By Week" : "By Day";
  1843→    console.log("\n" + chalk.bold(label));
  1844→    console.log(chalk.gray("─".repeat(50)));
  1845→    console.log(
  1846→      chalk.gray(
  1847→        `  ${"Period".padEnd(14)} ${"Sessions".padEnd(10)} ${"Tasks".padEnd(8)} Duration`,
  1848→      ),
  1849→    );
  1850→    for (const period of timePeriods) {
  1851→      console.log(
  1852→        `  ${period.period.padEnd(14)} ${String(period.sessions_count).padEnd(10)} ${String(period.tasks_completed).padEnd(8)} ${formatDurationLong(period.total_duration_ms)}`,
  1853→      );
  1854→    }
  1855→  }
  1856→}
  1857→
  1858→/**
  1859→ * Session log stats action handler.
  1860→ */
  1861→async function sessionLogStatsAction(
  1862→  options: SessionLogStatsOptions,
  1863→): Promise<void> {
  1864→  try {
  1865→    const ctx = await initContext();
  1866→    let sessions = await getAllSessionLogSummaries(ctx.specDir);
  1867→
  1868→    // AC: @session-log-stats ac-4 - Filter by since
  1869→    if (options.since) {
  1870→      const sinceDate = parseTimeSpec(options.since);
  1871→      if (sinceDate) {
  1872→        sessions = sessions.filter(
  1873→          (s) => new Date(s.started_at) >= sinceDate,
  1874→        );
  1875→      }
  1876→    }
  1877→
  1878→    // AC: @session-log-stats ac-5 - Filter by agent type
  1879→    if (options.agent) {
  1880→      const agentFilter = options.agent;
  1881→      sessions = sessions.filter((s) => s.agent_type === agentFilter);
  1882→    }
  1883→
  1884→    // AC: @session-log-stats ac-8 - No sessions match criteria
  1885→    if (sessions.length === 0) {
  1886→      output({ message: "No sessions match criteria" }, () => {
  1887→        console.log("No sessions match criteria.");
  1888→      });
  1889→      return;
  1890→    }
  1891→
  1892→    // Compute base stats
  1893→    const stats = computeSessionLogStats(sessions);
  1894→
  1895→    // AC: @session-log-stats ac-6 - Tool usage (optional)
  1896→    let toolUsage: ToolUsageStats[] | null = null;
  1897→    if (options.toolUsage) {
  1898→      const sessionIds = sessions.map((s) => s.id);
  1899→      toolUsage = await computeToolUsageStats(ctx.specDir, sessionIds);
  1900→    }
  1901→
  1902→    // AC: @session-log-stats ac-7 - Time periods (optional)
  1903→    let timePeriods: TimePeriodStats[] | null = null;
  1904→    let groupBy: "day" | "week" | null = null;
  1905→    if (options.byDay) {
  1906→      groupBy = "day";
  1907→      timePeriods = computeTimePeriodStats(sessions, "day");
  1908→    } else if (options.byWeek) {
  1909→      groupBy = "week";
  1910→      timePeriods = computeTimePeriodStats(sessions, "week");
  1911→    }
  1912→
  1913→    // Build output structure
  1914→    const jsonOutput: SessionLogStatsOutput = { stats };
  1915→    if (toolUsage !== null) {
  1916→      jsonOutput.tool_usage = toolUsage;
  1917→    }
  1918→    if (timePeriods !== null) {
  1919→      jsonOutput.time_periods = timePeriods;
  1920→    }
  1921→
  1922→    output(jsonOutput, () =>
  1923→      formatSessionLogStats(stats, toolUsage, timePeriods, groupBy),
  1924→    );
  1925→  } catch (err) {
  1926→    error("Failed to compute session log stats", err);
  1927→    process.exit(EXIT_CODES.ERROR);
  1928→  }
  1929→}
  1930→
  1931→// ─── Session Log Search ─────────────────────────────────────────────────────────
  1932→
  1933→interface SessionLogSearchOptions {
  1934→  type?: string;
  1935→  since?: string;
  1936→  agent?: string;
  1937→  limit?: string;
  1938→}
  1939→
  1940→/**
  1941→ * Format relative timestamp from event timestamp (Unix ms) to session start.
  1942→ */
  1943→function formatSearchTimestamp(eventTs: number): string {
  1944→  return new Date(eventTs).toISOString();
  1945→}
  1946→
  1947→/**
  1948→ * Format the session log search output.
  1949→ *
  1950→ * AC: @session-log-search ac-1, ac-4
  1951→ */
  1952→function formatSessionLogSearch(results: SessionSearchResult[]): void {
  1953→  if (results.length === 0) {
  1954→    // AC: @session-log-search ac-6
  1955→    console.log("No matches found.");
  1956→    return;
  1957→  }
  1958→
  1959→  let totalMatches = 0;
  1960→  for (const session of results) {
  1961→    totalMatches += session.matches.length;
  1962→  }
  1963→
  1964→  console.log(chalk.bold(`Found ${totalMatches} match(es) in ${results.length} session(s)`));
  1965→  console.log(chalk.gray("─".repeat(60)));
  1966→
  1967→  for (const session of results) {
  1968→    // Session header
  1969→    console.log(
  1970→      `\n${chalk.cyan(`Session ${session.session_id.slice(0, 8)}`)} ` +
  1971→        `${chalk.gray(`(${session.agent_type}, started ${formatRelativeTime(new Date(session.started_at))})`)}`
  1972→    );
  1973→
  1974→    // AC: @session-log-search ac-4 - Show matches with session ID, timestamp, type, excerpt
  1975→    for (const match of session.matches) {
  1976→      const ts = formatSearchTimestamp(match.timestamp);
  1977→      const typeColor =
  1978→        match.event_type === "session.start" || match.event_type === "session.end"
  1979→          ? chalk.green
  1980→          : match.event_type === "session.update"
  1981→            ? chalk.blue
  1982→            : chalk.gray;
  1983→      console.log(
  1984→        `  ${chalk.yellow(ts)} ${typeColor(match.event_type.padEnd(16))}`,
  1985→      );
  1986→      // Content excerpt on next line, indented
  1987→      console.log(`    ${chalk.gray(match.content_excerpt)}`);
  1988→    }
  1989→  }
  1990→}
  1991→
  1992→/**
  1993→ * Session log search action handler.
  1994→ *
  1995→ * AC: @session-log-search ac-1 through ac-7
  1996→ */
  1997→async function sessionLogSearchAction(
  1998→  pattern: string,
  1999→  options: SessionLogSearchOptions,
  2000→): Promise<void> {
  2001→  try {
  2002→    const ctx = await initContext();
  2003→
  2004→    // Parse options - validate limit as positive integer
  2005→    let limit = 50;
  2006→    if (options.limit) {
  2007→      const parsed = parseInt(options.limit, 10);
  2008→      if (Number.isNaN(parsed) || parsed <= 0) {
  2009→        error(`Invalid limit: ${options.limit}. Must be a positive integer.`);
  2010→        process.exit(EXIT_CODES.USAGE_ERROR);
  2011→      }
  2012→      limit = parsed;
  2013→    }
  2014→    const sinceDate = options.since ? parseTimeSpec(options.since) : undefined;
  2015→
  2016→    // AC: @session-log-search ac-1, ac-2, ac-3, ac-5, ac-7
  2017→    const results = await searchSessionEvents(ctx.specDir, pattern, {
  2018→      eventType: options.type,
  2019→      sinceDate: sinceDate || undefined,
  2020→      agentType: options.agent,
  2021→      limit,
  2022→    });
  2023→
  2024→    // AC: @session-log-search ac-6 - No matches found message
  2025→    // exit code 0 regardless (per @trait-semantic-exit-codes ac-5)
  2026→
  2027→    output(results, () => formatSessionLogSearch(results));
  2028→  } catch (err) {
  2029→    error("Failed to search session logs", err);
  2030→    process.exit(EXIT_CODES.ERROR);
  2031→  }
  2032→}
  2033→
  2034→/**
  2035→ * Register the 'session' command group and aliases
  2036→ */
  2037→export function registerSessionCommands(program: Command): void {
  2038→  const session = program
  2039→    .command("session")
  2040→    .description("Session management and context");
  2041→
  2042→  session
  2043→    .command("start")
  2044→    .alias("resume")
  2045→    .description("Surface relevant context for starting a new working session")
  2046→    .option("--brief", "Compact summary (default)")
  2047→    .option("--full", "Comprehensive context dump")
  2048→    .option(
  2049→      "--since <time>",
  2050→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  2051→    )
  2052→    .option("--no-git", "Skip git commit information")
  2053→    .option("-n, --limit <n>", "Limit items per section", "10")
  2054→    .action(sessionStartAction);
  2055→
  2056→  // Session log subcommand group
  2057→  const log = session
  2058→    .command("log")
  2059→    .description("Session log analysis commands");
  2060→
  2061→  log
  2062→    .command("list")
  2063→    .description("List session logs with summary statistics")
  2064→    .option(
  2065→      "-s, --status <status>",
  2066→      "Filter by status (active, completed, abandoned)",
  2067→    )
  2068→    .option("--agent <type>", "Filter by agent type")
  2069→    .option(
  2070→      "--since <time>",
  2071→      "Only show sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2072→    )
  2073→    .option(
  2074→      "--sort <field>",
  2075→      "Sort by field (started_at, duration, events, iterations, tasks_completed)",
  2076→      "started_at",
  2077→    )
  2078→    .option("--count", "Show only the count of matching sessions")
  2079→    .option("-n, --limit <n>", "Limit number of sessions shown")
  2080→    .action(sessionLogListAction);
  2081→
  2082→  log
  2083→    .command("show <session-id>")
  2084→    .description("Show detailed view of a single session")
  2085→    .option("-e, --events", "Include chronological event timeline")
  2086→    .option("-t, --type <type>", "Filter events by type (e.g., tool.call)")
  2087→    .option("-n, --limit <n>", "Show only the last N events")
  2088→    .option("-c, --context <n>", "Show context snapshot for iteration N")
  2089→    .action(sessionLogShowAction);
  2090→
  2091→  log
  2092→    .command("stats")
  2093→    .description("Aggregate analytics across sessions")
  2094→    .option(
  2095→      "--since <time>",
  2096→      "Only include sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2097→    )
  2098→    .option("--agent <type>", "Only include sessions with this agent type")
  2099→    .option("--tool-usage", "Display top 10 tool calls by frequency")
  2100→    .option("--by-day", "Group stats by day")
  2101→    .option("--by-week", "Group stats by week")
  2102→    .action(sessionLogStatsAction);
  2103→
  2104→  log
  2105→    .command("search <pattern>")
  2106→    .description("Search across session events by content")
  2107→    .option("-t, --type <type>", "Only search events of this type (e.g., session.update)")
  2108→    .option(
  2109→      "--since <time>",
  2110→      "Only search sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
  2111→    )
  2112→    .option("--agent <type>", "Only search sessions with this agent type")
  2113→    .option("-n, --limit <n>", "Maximum matches to return (default: 50)")
  2114→    .action(sessionLogSearchAction);
  2115→
  2116→  session
  2117→    .command("checkpoint")
  2118→    .description(
  2119→      "Pre-stop hook: check for uncommitted work before ending session",
  2120→    )
  2121→    .option("--force", "Allow session end regardless of issues")
  2122→    .action(sessionCheckpointAction);
  2123→
  2124→  session
  2125→    .command("prompt-check")
  2126→    .description("UserPromptSubmit hook: inject spec-first reminder")
  2127→    .action(sessionPromptCheckAction);
  2128→
  2129→  // Top-level alias: kspec context
  2130→  program
  2131→    .command("context")
  2132→    .description("Alias for session start - surface session context")
  2133→    .option("--brief", "Compact summary (default)")
  2134→    .option("--full", "Comprehensive context dump")
  2135→    .option(
  2136→      "--since <time>",
  2137→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  2138→    )
  2139→    .option("--no-git", "Skip git commit information")
  2140→    .option("-n, --limit <n>", "Limit items per section", "10")
  2141→    .action(sessionStartAction);
  2142→}
  2143→