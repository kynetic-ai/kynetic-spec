    50→import { executeBatchOperation, formatBatchOutput } from "../batch.js";
    51→import { EXIT_CODES } from "../exit-codes.js";
    52→import { error, isJsonMode, output, success } from "../output.js";
    53→import { parseTagsArray } from "../parse-utils.js";
    54→import { parseIntOption } from "../validators.js";
    55→
    56→/**
    57→ * Resolve a meta reference to its ULID and type.
    58→ * Wrapper around resolveMetaRef for backward compatibility with existing call sites.
    59→ * AC: @skill-meta-integration ac-4 - skills included in resolution
    60→ */
    61→function resolveMetaRefToUlid(
    62→  ref: string,
    63→  metaCtx: MetaContext,
    64→): {
    65→  ulid: string;
    66→  type: "agent" | "workflow" | "convention" | "observation" | "skill";
    67→} | null {
    68→  const result = resolveMetaRef(metaCtx, ref);
    69→  if (!result) return null;
    70→  return { ulid: result.ulid, type: result.type };
    71→}
    72→
    73→/**
    74→ * Batch-compatible resolver for observations.
    75→ * Returns null instead of calling process.exit() to allow partial failure handling.
    76→ * AC: @trait-multi-ref-batch ac-2, ac-8 - Partial failure handling and ref resolution
    77→ */
    78→function resolveObservationRefForBatch(
    79→  ref: string,
    80→  observations: Observation[],
    81→): { item: Observation | null; error?: string } {
    82→  const normalizedRef = ref.startsWith("@") ? ref.substring(1) : ref;
    83→  const observation = observations.find((o) =>
    84→    o._ulid.startsWith(normalizedRef),
    85→  );
    86→
    87→  if (!observation) {
    88→    return { item: null, error: `Observation not found: ${ref}` };
    89→  }
    90→
    91→  return { item: observation };
    92→}
    93→
    94→/**
    95→ * Format meta show output
    96→ * AC: @skill-meta-integration ac-3 - skill count included in summary
    97→ */
    98→function formatMetaShow(meta: MetaContext): void {
    99→  const stats = getMetaStats(meta);
   100→
   101→  if (!meta.manifest) {
   102→    console.log(chalk.yellow("No meta manifest found (kynetic.meta.yaml)"));
   103→    console.log(
   104→      chalk.gray(
   105→        "Create one to define agents, workflows, conventions, observations, and skills",
   106→      ),
   107→    );
   108→    return;
   109→  }
   110→
   111→  console.log(chalk.bold("Meta-Spec Summary"));
   112→  console.log(chalk.gray("─".repeat(40)));
   113→  console.log(`Agents:       ${stats.agents}`);
   114→  console.log(`Workflows:    ${stats.workflows}`);
   115→  console.log(`Conventions:  ${stats.conventions}`);
   116→  console.log(
   117→    `Observations: ${stats.observations} (${stats.unresolvedObservations} unresolved)`,
   118→  );
   119→  // AC: @skill-meta-integration ac-3 - include skill count
   120→  console.log(`Skills:       ${stats.skills}`);
   121→}
   122→
   123→/**
   124→ * Format agents table output
   125→ * AC-agent-1: outputs table with columns: ID, Name, Capabilities
   126→ */
   127→function formatAgents(agents: Agent[]): void {
   128→  if (agents.length === 0) {
   129→    console.log(chalk.yellow("No agents defined"));
   130→    return;
   131→  }
   132→
   133→  const table = new Table({
   134→    head: [chalk.bold("ID"), chalk.bold("Name"), chalk.bold("Capabilities")],
   135→    style: {
   136→      head: [],
   137→      border: [],
   138→    },
   139→  });
   140→
   141→  for (const agent of agents) {
   142→    table.push([agent.id, agent.name, agent.capabilities.join(", ")]);
   143→  }
   144→
   145→  console.log(table.toString());
   146→}
   147→
   148→/**
   149→ * Format workflows table output
   150→ * AC-workflow-1: outputs table with columns: ID, Trigger, Steps (count), Mode
   151→ */
   152→function formatWorkflows(workflows: Workflow[]): void {
   153→  if (workflows.length === 0) {
   154→    console.log(chalk.yellow("No workflows defined"));
   155→    return;
   156→  }
   157→
   158→  const table = new Table({
   159→    head: [
   160→      chalk.bold("ID"),
   161→      chalk.bold("Trigger"),
   162→      chalk.bold("Steps"),
   163→      chalk.bold("Mode"),
   164→    ],
   165→    style: {
   166→      head: [],
   167→      border: [],
   168→    },
   169→  });
   170→
   171→  for (const workflow of workflows) {
   172→    table.push([
   173→      workflow.id,
   174→      workflow.trigger,
   175→      workflow.steps.length.toString(),
   176→      workflow.mode || "interactive",
   177→    ]);
   178→  }
   179→
   180→  console.log(table.toString());
   181→}
   182→
   183→/**
   184→ * Format workflows verbose output
   185→ * AC-workflow-2: outputs each workflow with full step list
   186→ * AC: @loop-mode-workflows ac-3 (shows based_on field)
   187→ */
   188→function formatWorkflowsVerbose(workflows: Workflow[]): void {
   189→  if (workflows.length === 0) {
   190→    console.log(chalk.yellow("No workflows defined"));
   191→    return;
   192→  }
   193→
   194→  for (const workflow of workflows) {
   195→    console.log(chalk.bold(`${workflow.id} - ${workflow.trigger}`));
   196→    // Show mode if it's loop (skip for interactive as it's default)
   197→    if (workflow.mode === "loop") {
   198→      console.log(chalk.cyan(`Mode: ${workflow.mode}`));
   199→    }
   200→    // AC: @loop-mode-workflows ac-3 - Show based_on reference
   201→    if (workflow.based_on) {
   202→      console.log(chalk.cyan(`Based on: ${workflow.based_on}`));
   203→    }
   204→    if (workflow.description) {
   205→      console.log(chalk.gray(workflow.description));
   206→    }
   207→    console.log(chalk.gray("─".repeat(60)));
   208→
   209→    for (const step of workflow.steps) {
   210→      const prefix = {
   211→        check: chalk.yellow("[check]"),
   212→        action: chalk.blue("[action]"),
   213→        decision: chalk.magenta("[decision]"),
   214→      }[step.type];
   215→
   216→      console.log(`${prefix} ${step.content}`);
   217→
   218→      if (step.on_fail) {
   219→        console.log(chalk.gray(`  → on fail: ${step.on_fail}`));
   220→      }
   221→
   222→      if (step.options && step.options.length > 0) {
   223→        for (const option of step.options) {
   224→          console.log(chalk.gray(`  • ${option}`));
   225→        }
   226→      }
   227→    }
   228→
   229→    console.log("");
   230→  }
   231→}
   232→
   233→/**
   234→ * Format conventions table output
   235→ * AC-conv-1: outputs table with columns: Domain, Rules (count), Validation (yes/no)
   236→ */
   237→function formatConventions(conventions: Convention[]): void {
   238→  if (conventions.length === 0) {
   239→    console.log(chalk.yellow("No conventions defined"));
   240→    return;
   241→  }
   242→
   243→  const table = new Table({
   244→    head: [chalk.bold("Domain"), chalk.bold("Rules"), chalk.bold("Validation")],
   245→    style: {
   246→      head: [],
   247→      border: [],
   248→    },
   249→  });
   250→
   251→  for (const convention of conventions) {
   252→    table.push([
   253→      convention.domain,
   254→      convention.rules.length.toString(),
   255→      convention.validation ? "yes" : "no",
   256→    ]);
   257→  }
   258→
   259→  console.log(table.toString());
   260→}
   261→
   262→/**
   263→ * Format convention detail output
   264→ * AC-conv-2: outputs full rules list and examples
   265→ */
   266→function formatConventionDetail(convention: Convention): void {
   267→  console.log(chalk.bold(`${convention.domain} Convention`));
   268→  console.log(chalk.gray("─".repeat(60)));
   269→
   270→  console.log(chalk.bold("\nRules:"));
   271→  for (const rule of convention.rules) {
   272→    console.log(`  • ${rule}`);
   273→  }
   274→
   275→  if (convention.examples && convention.examples.length > 0) {
   276→    console.log(chalk.bold("\nExamples:"));
   277→    for (const example of convention.examples) {
   278→      console.log(chalk.green(`  ✓ ${example.good}`));
   279→      console.log(chalk.red(`  ✗ ${example.bad}`));
   280→    }
   281→  }
   282→
   283→  if (convention.validation) {
   284→    console.log(chalk.bold("\nValidation:"));
   285→    console.log(`  Type: ${convention.validation.type}`);
   286→    if (convention.validation.pattern) {
   287→      console.log(`  Pattern: ${convention.validation.pattern}`);
   288→    }
   289→    if (convention.validation.message) {
   290→      console.log(`  Message: ${convention.validation.message}`);
   291→    }
   292→  }
   293→
   294→  console.log("");
   295→}
   296→
   297→/**
   298→ * Format observations table output
   299→ * AC-obs-2: outputs table with columns: ID, Type, Workflow, Created, Content (truncated)
   300→ * AC: @obs-list-display ac-1 - When --all flag used, show Resolved column with ✓/✗
   301→ */
   302→function formatObservations(
   303→  observations: Observation[],
   304→  showResolved: boolean,
   305→): void {
   306→  const filtered = showResolved
   307→    ? observations
   308→    : observations.filter((o) => !o.resolved);
   309→
   310→  if (filtered.length === 0) {
   311→    console.log(
   312→      chalk.yellow(
   313→        showResolved ? "No observations found" : "No unresolved observations",
   314→      ),
   315→    );
   316→    return;
   317→  }
   318→
   319→  // AC: @obs-list-display ac-1 - Include Resolved column when showing all observations
   320→  const headers = showResolved
   321→    ? [
   322→        chalk.bold("ID"),
   323→        chalk.bold("Type"),
   324→        chalk.bold("Resolved"),
   325→        chalk.bold("Workflow"),
   326→        chalk.bold("Created"),
   327→        chalk.bold("Content"),
   328→      ]
   329→    : [
   330→        chalk.bold("ID"),
   331→        chalk.bold("Type"),
   332→        chalk.bold("Workflow"),
   333→        chalk.bold("Created"),
   334→        chalk.bold("Content"),
   335→      ];
   336→
   337→  const colWidths = showResolved
   338→    ? [10, 10, 10, 20, 12, 40]
   339→    : [10, 10, 20, 12, 50];
   340→
   341→  const table = new Table({
   342→    head: headers,
   343→    style: {
   344→      head: [],
   345→      border: [],
   346→    },
   347→    colWidths,
   348→    wordWrap: true,
   349→  });
   350→
   351→  for (const obs of filtered) {
   352→    const id = obs._ulid.substring(0, 8);
   353→    const workflow = obs.workflow_ref || "-";
   354→    const created = new Date(obs.created_at).toISOString().split("T")[0];
   355→    // Adjust content truncation based on available column width
   356→    const maxContentLen = showResolved ? 37 : 47;
   357→    const content =
   358→      obs.content.length > maxContentLen
   359→        ? `${obs.content.substring(0, maxContentLen)}...`
   360→        : obs.content;
   361→
   362→    // AC: @obs-list-display ac-1 - Show ✓ for resolved, ✗ for unresolved
   363→    if (showResolved) {
   364→      const resolvedIndicator = obs.resolved
   365→        ? chalk.green("✓")
   366→        : chalk.red("✗");
   367→      table.push([id, obs.type, resolvedIndicator, workflow, created, content]);
   368→    } else {
   369→      table.push([id, obs.type, workflow, created, content]);
   370→    }
   371→  }
   372→
   373→  console.log(table.toString());
   374→}
   375→
   376→/**
   377→ * Register meta commands
   378→ */
   379→export function registerMetaCommands(program: Command): void {
   380→  const meta = program
   381→    .command("meta")
   382→    .description(
   383→      "Meta-spec commands (agents, workflows, conventions, observations)",
   384→    );
   385→
   386→  // AC-meta-manifest-1: kspec meta show outputs summary with counts
   387→  meta
   388→    .command("show")
   389→    .description("Display meta-spec summary")
   390→    .action(async () => {
   391→      try {
   392→        const ctx = await initContext();
   393→
   394→        if (!ctx.manifestPath) {
   395→          error(errors.project.noKspecProject);
   396→          process.exit(EXIT_CODES.ERROR);
   397→        }
   398→
   399→        const metaCtx = await loadMetaContext(ctx);
   400→        const stats = getMetaStats(metaCtx);
   401→
   402→        output(
   403→          {
   404→            manifest: metaCtx.manifestPath,
   405→            stats,
   406→          },
   407→          () => formatMetaShow(metaCtx),
   408→        );
   409→      } catch (err) {
   410→        error(errors.failures.showMeta, err);
   411→        process.exit(EXIT_CODES.ERROR);
   412→      }
   413→    });
   414→
   415→  // AC-agent-1, AC-agent-2: kspec meta agents
   416→  meta
   417→    .command("agents")
   418→    .description("List agents defined in meta-spec")
   419→    .action(async () => {
   420→      try {
   421→        const ctx = await initContext();
   422→
   423→        if (!ctx.manifestPath) {
   424→          error(errors.project.noKspecProject);
   425→          process.exit(EXIT_CODES.ERROR);
   426→        }
   427→
   428→        const metaCtx = await loadMetaContext(ctx);
   429→        const agents = metaCtx.agents || [];
   430→
   431→        // AC-agent-2: JSON output includes full agent details
   432→        output(
   433→          agents.map((agent) => ({
   434→            id: agent.id,
   435→            name: agent.name,
   436→            description: agent.description,
   437→            capabilities: agent.capabilities,
   438→            tools: agent.tools,
   439→            session_protocol: agent.session_protocol,
   440→            conventions: agent.conventions,
   441→          })),
   442→          // AC-agent-1: Table output with ID, Name, Capabilities
   443→          () => formatAgents(agents),
   444→        );
   445→      } catch (err) {
   446→        error(errors.failures.listAgents, err);
   447→        process.exit(EXIT_CODES.ERROR);
   448→      }
   449→    });
   450→
   451→  // AC-workflow-1, AC-workflow-2, AC-workflow-4: kspec meta workflows
   452→  // AC: @loop-mode-workflows ac-1 (--tag loop filtering)
   453→  meta
   454→    .command("workflows")
   455→    .description("List workflows defined in meta-spec")
   456→    .option("--verbose", "Show full workflow details with all steps")
   457→    .option("--tag <tag>", "Filter workflows by tag (e.g., --tag loop)")
   458→    .action(async (options) => {
   459→      try {
   460→        const ctx = await initContext();
   461→
   462→        if (!ctx.manifestPath) {
   463→          error(errors.project.noKspecProject);
   464→          process.exit(EXIT_CODES.ERROR);
   465→        }
   466→
   467→        const metaCtx = await loadMetaContext(ctx);
   468→        let workflows = metaCtx.workflows || [];
   469→
   470→        // AC: @loop-mode-workflows ac-1 - Filter by tag
   471→        if (options.tag) {
   472→          workflows = workflows.filter((w) => {
   473→            // Match by explicit tags array or by mode field (for "loop" tag)
   474→            const tags = w.tags || [];
   475→            if (tags.includes(options.tag)) return true;
   476→            // Special case: --tag loop also matches mode: loop
   477→            if (options.tag === "loop" && w.mode === "loop") return true;
   478→            return false;
   479→          });
   480→        }
   481→
   482→        // AC-workflow-4: JSON output includes full workflow details
   483→        output(
   484→          workflows.map((workflow) => ({
   485→            id: workflow.id,
   486→            trigger: workflow.trigger,
   487→            description: workflow.description,
   488→            steps: workflow.steps,
   489→            mode: workflow.mode || "interactive",
   490→            based_on: workflow.based_on,
   491→            tags: workflow.tags || [],
   492→          })),
   493→          // AC-workflow-1 (table) or AC-workflow-2 (verbose)
   494→          () => {
   495→            if (options.verbose) {
   496→              formatWorkflowsVerbose(workflows);
   497→            } else {
   498→              formatWorkflows(workflows);
   499→            }
   500→          },
   501→        );
   502→      } catch (err) {
   503→        error(errors.failures.listWorkflows, err);
   504→        process.exit(EXIT_CODES.ERROR);
   505→      }
   506→    });
   507→
   508→  // AC-conv-1, AC-conv-2, AC-conv-5: kspec meta conventions
   509→  meta
   510→    .command("conventions")
   511→    .description("List conventions defined in meta-spec")
   512→    .option("--domain <domain>", "Filter by specific domain")
   513→    .action(async (options) => {
   514→      try {
   515→        const ctx = await initContext();
   516→
   517→        if (!ctx.manifestPath) {
   518→          error(errors.project.noKspecProject);
   519→          process.exit(EXIT_CODES.ERROR);
   520→        }
   521→
   522→        const metaCtx = await loadMetaContext(ctx);
   523→        const conventions = metaCtx.conventions || [];
   524→
   525→        // AC-conv-2: Filter by domain if specified
   526→        const filtered = options.domain
   527→          ? conventions.filter((c) => c.domain === options.domain)
   528→          : conventions;
   529→
   530→        // AC-conv-5: JSON output includes full convention details
   531→        output(
   532→          filtered.map((convention) => ({
   533→            domain: convention.domain,
   534→            rules: convention.rules,
   535→            examples: convention.examples,
   536→            validation: convention.validation,
   537→          })),
   538→          // AC-conv-1 (table) or AC-conv-2 (detail for single domain)
   539→          () => {
   540→            if (options.domain && filtered.length === 1) {
   541→              formatConventionDetail(filtered[0]);
   542→            } else {
   543→              formatConventions(filtered);
   544→            }
   545→          },
   546→        );
   547→      } catch (err) {
   548→        error(errors.failures.listConventions, err);
   549→        process.exit(EXIT_CODES.ERROR);
   550→      }
   551→    });
   552→
   553→  // meta-get-cmd: kspec meta get <ref>
   554→  // AC: @skill-meta-integration ac-1 - skills can be retrieved by id
   555→  meta
   556→    .command("get <ref>")
   557→    .description(
   558→      "Get a meta item by reference (agent, workflow, convention, observation, or skill)",
   559→    )
   560→    .action(async (ref: string) => {
   561→      try {
   562→        const ctx = await initContext();
   563→
   564→        if (!ctx.manifestPath) {
   565→          error(errors.project.noKspecProject);
   566→          process.exit(EXIT_CODES.ERROR);
   567→        }
   568→
   569→        const metaCtx = await loadMetaContext(ctx);
   570→
   571→        // AC: @skill-meta-integration ac-1 - Use unified resolver
   572→        const resolved = resolveMetaRef(metaCtx, ref);
   573→
   574→        if (!resolved) {
   575→          error(errors.reference.metaNotFound(ref));
   576→          process.exit(EXIT_CODES.ERROR);
   577→        }
   578→
   579→        const { item: found, type: itemType } = resolved;
   580→
   581→        // Output the item
   582→        output(found, () => {
   583→          console.log(
   584→            chalk.bold(
   585→              `${itemType.charAt(0).toUpperCase() + itemType.slice(1)}: ${ref}`,
   586→            ),
   587→          );
   588→          console.log(chalk.gray("─".repeat(60)));
   589→          console.log(JSON.stringify(found, null, 2));
   590→        });
   591→      } catch (err) {
   592→        error(errors.failures.getMetaItem, err);
   593→        process.exit(EXIT_CODES.ERROR);
   594→      }
   595→    });
   596→
   597→  // meta-list-cmd: kspec meta list
   598→  // AC: @skill-meta-integration ac-2 - skills can be filtered with --type skill
   599→  meta
   600→    .command("list")
   601→    .description("List all meta items")
   602→    .option(
   603→      "--type <type>",
   604→      "Filter by type (agent, workflow, convention, observation, skill)",
   605→    )
   606→    .action(async (options) => {
   607→      try {
   608→        const ctx = await initContext();
   609→
   610→        if (!ctx.manifestPath) {
   611→          error(errors.project.noKspecProject);
   612→          process.exit(EXIT_CODES.ERROR);
   613→        }
   614→
   615→        const metaCtx = await loadMetaContext(ctx);
   616→
   617→        // Collect all meta items with type information
   618→        interface MetaListItem {
   619→          id: string;
   620→          type: string;
   621→          context: string;
   622→          ulid: string;
   623→        }
   624→
   625→        const items: MetaListItem[] = [];
   626→
   627→        // Add agents
   628→        if (!options.type || options.type === "agent") {
   629→          for (const agent of metaCtx.agents || []) {
   630→            items.push({
   631→              id: agent.id,
   632→              type: "agent",
   633→              context: agent.name,
   634→              ulid: agent._ulid,
   635→            });
   636→          }
   637→        }
   638→
   639→        // Add workflows
   640→        if (!options.type || options.type === "workflow") {
   641→          for (const workflow of metaCtx.workflows || []) {
   642→            items.push({
   643→              id: workflow.id,
   644→              type: "workflow",
   645→              context: workflow.trigger,
   646→              ulid: workflow._ulid,
   647→            });
   648→          }
   649→        }
   650→
   651→        // Add conventions
   652→        if (!options.type || options.type === "convention") {
   653→          for (const convention of metaCtx.conventions || []) {
   654→            items.push({
   655→              id: convention.domain,
   656→              type: "convention",
   657→              context: `${convention.rules.length} rules`,
   658→              ulid: convention._ulid,
   659→            });
   660→          }
   661→        }
   662→
   663→        // Add observations
   664→        if (!options.type || options.type === "observation") {
   665→          for (const observation of metaCtx.observations || []) {
   666→            const ulidPrefix = observation._ulid.substring(0, 8);
   667→            items.push({
   668→              id: ulidPrefix,
   669→              type: "observation",
   670→              context: `${observation.type} ${observation.resolved ? "(resolved)" : ""}`,
   671→              ulid: observation._ulid,
   672→            });
   673→          }
   674→        }
   675→
   676→        // AC: @skill-meta-integration ac-2 - Add skills
   677→        if (!options.type || options.type === "skill") {
   678→          for (const skill of metaCtx.skills || []) {
   679→            items.push({
   680→              id: skill.id,
   681→              type: "skill",
   682→              context: skill.name || skill.description || skill.origin,
   683→              ulid: skill._ulid,
   684→            });
   685→          }
   686→        }
   687→
   688→        // Output
   689→        output(items, () => {
   690→          if (items.length === 0) {
   691→            console.log(chalk.yellow("No meta items found"));
   692→            return;
   693→          }
   694→
   695→          const table = new Table({
   696→            head: [chalk.bold("ID"), chalk.bold("Type"), chalk.bold("Context")],
   697→            style: {
   698→              head: [],
   699→              border: [],
   700→            },
   701→          });
   702→
   703→          for (const item of items) {
   704→            table.push([item.id, item.type, item.context]);
   705→          }
   706→
   707→          console.log(table.toString());
   708→        });
   709→      } catch (err) {
   710→        error(errors.failures.listMetaItems, err);
   711→        process.exit(EXIT_CODES.ERROR);
   712→      }
   713→    });
   714→
   715→  // AC-obs-1: kspec meta observe <type> <content>
   716→  // AC: @meta-observe-cmd from-inbox-conversion
   717→  markMutating(meta.command("observe [type] [content]"))
   718→    .description("Create an observation (friction, success, question, idea)")
   719→    .option(
   720→      "--workflow <ref>",
   721→      "Reference to workflow this observation relates to",
   722→    )
   723→    .option("--author <author>", "Author of the observation")
   724→    .option("--from-inbox <ref>", "Convert inbox item to observation")
   725→    .option(
   726→      "--type <type>",
   727→      "Override type when using --from-inbox (defaults to idea)",
   728→    )
   729→    .action(
   730→      async (
   731→        type: string | undefined,
   732→        content: string | undefined,
   733→        options,
   734→      ) => {
   735→        try {
   736→          const ctx = await initContext();
   737→
   738→          if (!ctx.manifestPath) {
   739→            error(errors.project.noKspecProject);
   740→            process.exit(EXIT_CODES.ERROR);
   741→          }
   742→
   743→          // AC: @meta-observe-cmd from-inbox-conversion
   744→          // Handle --from-inbox flag
   745→          if (options.fromInbox) {
   746→            // Load inbox items
   747→            const inboxItems = await loadInboxItems(ctx);
   748→            const item = findInboxItemByRef(inboxItems, options.fromInbox);
   749→
   750→            if (!item) {
   751→              error(errors.reference.inboxNotFound(options.fromInbox));
   752→              process.exit(EXIT_CODES.NOT_FOUND);
   753→            }
   754→
   755→            // Use inbox item content
   756→            const observationContent = item.text;
   757→
   758→            // Type defaults to 'idea' but can be overridden with --type flag
   759→            const observationType = (options.type || "idea") as ObservationType;
   760→
   761→            // Validate observation type
   762→            const validTypes: ObservationType[] = [
   763→              "friction",
   764→              "success",
   765→              "question",
   766→              "idea",
   767→            ];
   768→            if (!validTypes.includes(observationType)) {
   769→              error(errors.validation.invalidObservationType(observationType));
   770→              console.log(`Valid types: ${validTypes.join(", ")}`);
   771→              process.exit(EXIT_CODES.ERROR);
   772→            }
   773→
   774→            // Create observation
   775→            const observation = createObservation(
   776→              observationType,
   777→              observationContent,
   778→              {
   779→                workflow_ref: options.workflow,
   780→                author: options.author,
   781→                configAuthor: ctx.config?.identity?.author,
   782→              },
   783→            );
   784→
   785→            // Save observation
   786→            await saveObservation(ctx, observation);
   787→
   788→            // Delete inbox item
   789→            const deleted = await deleteInboxItem(ctx, item._ulid);
   790→            if (!deleted) {
   791→              error("Failed to delete inbox item after creating observation");
   792→              process.exit(EXIT_CODES.ERROR);
   793→            }
   794→
   795→            await commitIfShadow(
   796→              ctx.shadow,
   797→              "meta-observe-from-inbox",
   798→              observation._ulid.substring(0, 8),
   799→              `Convert inbox item to ${observationType} observation`,
   800→            );
   801→
   802→            // Return observation ref
   803→            output(observation, () =>
   804→              success(
   805→                `Created observation: ${observation._ulid.substring(0, 8)}`,
   806→              ),
   807→            );
   808→            return;
   809→          }
   810→
   811→          // Standard observe flow (without --from-inbox)
   812→          if (!type || !content) {
   813→            error("Type and content are required when not using --from-inbox");
   814→            process.exit(EXIT_CODES.ERROR);
   815→          }
   816→
   817→          // Validate observation type
   818→          const validTypes: ObservationType[] = [
   819→            "friction",
   820→            "success",
   821→            "question",
   822→            "idea",
   823→          ];
   824→          if (!validTypes.includes(type as ObservationType)) {
   825→            error(errors.validation.invalidObservationType(type));
   826→            console.log(`Valid types: ${validTypes.join(", ")}`);
   827→            process.exit(EXIT_CODES.ERROR);
   828→          }
   829→
   830→          // Create observation
   831→          const observation = createObservation(
   832→            type as ObservationType,
   833→            content,
   834→            {
   835→              workflow_ref: options.workflow,
   836→              author: options.author,
   837→              configAuthor: ctx.config?.identity?.author,
   838→            },
   839→          );
   840→
   841→          // Save to manifest
   842→          await saveObservation(ctx, observation);
   843→
   844→          // AC: @trait-shadow-commit ac-1
   845→          await commitIfShadow(
   846→            ctx.shadow,
   847→            "meta-observe",
   848→            observation._ulid.substring(0, 8),
   849→            type as string,
   850→          );
   851→
   852→          // AC-obs-1: outputs "OK Created observation: <ULID-prefix>"
   853→          // In JSON mode, return the created observation object
   854→          output(observation, () =>
   855→            success(
   856→              `Created observation: ${observation._ulid.substring(0, 8)}`,
   857→            ),
   858→          );
   859→        } catch (err) {
   860→          error(errors.failures.createObservation, err);
   861→          process.exit(EXIT_CODES.ERROR);
   862→        }
   863→      },
   864→    );
   865→
   866→  // AC-obs-2, AC-obs-5: kspec meta observations
   867→  // AC: @observation-content-search ac-search-flag, ac-regex-support, ac-combined-filters
   868→  meta
   869→    .command("observations")
   870→    .description("List observations (shows unresolved by default)")
   871→    .option(
   872→      "--type <type>",
   873→      "Filter by observation type (friction/success/question/idea)",
   874→    )
   875→    .option("--workflow <ref>", "Filter by workflow reference")
   876→    .option("--all", "Include resolved observations")
   877→    .option("--promoted", "Show only observations promoted to tasks")
   878→    .option(
   879→      "--pending-resolution",
   880→      "Show observations with completed tasks awaiting resolution",
   881→    )
   882→    .option(
   883→      "--search <pattern>",
   884→      "Search observations by regex pattern (matches content)",
   885→    )
   886→    .action(async (options) => {
   887→      try {
   888→        const ctx = await initContext();
   889→
   890→        if (!ctx.manifestPath) {
   891→          error(errors.project.noKspecProject);
   892→          process.exit(EXIT_CODES.ERROR);
   893→        }
   894→
   895→        const metaCtx = await loadMetaContext(ctx);
   896→        let observations = metaCtx.observations || [];
   897→
   898→        // Apply filters
   899→        if (options.type) {
   900→          observations = observations.filter(
   901→            (obs) => obs.type === options.type,
   902→          );
   903→        }
   904→
   905→        if (options.workflow) {
   906→          observations = observations.filter(
   907→            (obs) => obs.workflow_ref === options.workflow,
   908→          );
   909→        }
   910→
   911→        if (options.promoted) {
   912→          observations = observations.filter(
   913→            (obs) => obs.promoted_to !== undefined,
   914→          );
   915→        }
   916→
   917→        if (options.pendingResolution) {
   918→          // Load tasks to check if promoted tasks are completed
   919→          const tasks = await loadAllTasks(ctx);
   920→          const items = await loadAllItems(ctx);
   921→          const index = new ReferenceIndex(tasks, items);
   922→
   923→          observations = observations.filter((obs) => {
   924→            if (!obs.promoted_to || obs.resolved) return false;
   925→            const taskResult = index.resolve(obs.promoted_to);
   926→            if (!taskResult.ok) return false;
   927→            const item = taskResult.item;
   928→            // Type guard: check if item is a task (has status and depends_on properties)
   929→            return (
   930→              "status" in item &&
   931→              "depends_on" in item &&
   932→              item.status === "completed"
   933→            );
   934→          });
   935→        }
   936→
   937→        // AC: @observation-content-search ac-search-flag, ac-regex-support, ac-combined-filters, ac-search-all-fields
   938→        // Apply --search filter using regex pattern (consistent with kspec search behavior)
   939→        if (options.search) {
   940→          const { grepItem } = await import("../../utils/grep.js");
   941→          observations = observations.filter((obs) => {
   942→            const match = grepItem(
   943→              obs as unknown as Record<string, unknown>,
   944→              options.search,
   945→            );
   946→            return match !== null;
   947→          });
   948→        }
   949→
   950→        // AC-obs-5: JSON output includes full observation objects
   951→        output(
   952→          observations.map((obs) => ({
   953→            _ulid: obs._ulid,
   954→            type: obs.type,
   955→            content: obs.content,
   956→            workflow_ref: obs.workflow_ref ?? null,
   957→            created_at: obs.created_at,
   958→            author: obs.author ?? null,
   959→            resolved: obs.resolved,
   960→            resolution: obs.resolution ?? null,
   961→            resolved_at: obs.resolved_at ?? null,
   962→            resolved_by: obs.resolved_by ?? null,
   963→            promoted_to: obs.promoted_to ?? null,
   964→          })),
   965→          // AC-obs-2: Table output with ID, Type, Workflow, Created, Content
   966→          () => formatObservations(observations, options.all),
   967→        );
   968→      } catch (err) {
   969→        error(errors.failures.listObservations, err);
   970→        process.exit(EXIT_CODES.ERROR);
   971→      }
   972→    });
   973→
   974→  // AC-obs-3, AC-obs-6, AC-obs-8: kspec meta promote
   975→  markMutating(meta.command("promote <ref>"))
   976→    .description("Promote observation to a task")
   977→    .requiredOption("--title <title>", "Task title")
   978→    .option("--priority <priority>", "Task priority (1-5)", "2")
   979→    .option("--force", "Force promotion even if observation is resolved")
   980→    .action(async (ref: string, options) => {
   981→      try {
   982→        const ctx = await initContext();
   983→
   984→        if (!ctx.manifestPath) {
   985→          error(errors.project.noKspecProject);
   986→          process.exit(EXIT_CODES.ERROR);
   987→        }
   988→
   989→        const metaCtx = await loadMetaContext(ctx);
   990→
   991→        // Use unified resolver - promotes only observations
   992→        const resolved = resolveMetaRef(metaCtx, ref);
   993→
   994→        if (!resolved) {
   995→          error(errors.reference.observationNotFound(ref));
   996→          process.exit(EXIT_CODES.ERROR);
   997→        }
   998→
   999→        if (resolved.type !== "observation") {
  1000→          error(`Cannot promote ${resolved.type}. Only observations can be promoted to tasks.`);
  1001→          process.exit(EXIT_CODES.ERROR);
  1002→        }
  1003→
  1004→        const observation = resolved.item as Observation;
  1005→
  1006→        // AC-obs-6: Check if already promoted
  1007→        if (observation.promoted_to) {
  1008→          error(
  1009→            errors.conflict.observationAlreadyPromoted(observation.promoted_to),
  1010→          );
  1011→          process.exit(EXIT_CODES.CONFLICT);
  1012→        }
  1013→
  1014→        // AC-obs-8: Check if resolved
  1015→        if (observation.resolved && !options.force) {
  1016→          error(errors.operation.cannotPromoteResolved);
  1017→          process.exit(EXIT_CODES.ERROR);
  1018→        }
  1019→
  1020→        // Validate priority
  1021→        const priorityResult = parseIntOption(options.priority, {
  1022→          min: 1,
  1023→          max: 5,
  1024→          name: "Priority",
  1025→        });
  1026→        if (!priorityResult.ok) {
  1027→          error(priorityResult.error);
  1028→          process.exit(EXIT_CODES.VALIDATION_FAILED);
  1029→        }
  1030→
  1031→        // AC-obs-3: Create task with title, description from observation, meta_ref, and origin
  1032→        const task = createTask({
  1033→          title: options.title,
  1034→          description: observation.content,
  1035→          priority: priorityResult.value,
  1036→          meta_ref: observation.workflow_ref,
  1037→          origin: "observation_promotion",
  1038→        });
  1039→
  1040→        // Save task
  1041→        await saveTask(ctx, task);
  1042→        await commitIfShadow(
  1043→          ctx.shadow,
  1044→          "task-add",
  1045→          task.slugs[0] || task._ulid.slice(0, 8),
  1046→          task.title,
  1047→        );
  1048→        const taskRef = `@${task._ulid.substring(0, 8)}`;
  1049→
  1050→        // Update observation with promoted_to field
  1051→        observation.promoted_to = taskRef;
  1052→        await saveObservation(ctx, observation);
  1053→
  1054→        // AC: @trait-shadow-commit ac-1
  1055→        await commitIfShadow(
  1056→          ctx.shadow,
  1057→          "observation-promote",
  1058→          observation._ulid.substring(0, 8),
  1059→        );
  1060→
  1061→        // AC-obs-3: outputs "OK Created task: <ULID-prefix>"
  1062→        // In JSON mode, return the created task object
  1063→        output(task, () => success(`Created task: ${taskRef.substring(0, 9)}`));
  1064→      } catch (err) {
  1065→        error(errors.failures.promoteObservation, err);
  1066→        process.exit(EXIT_CODES.ERROR);
  1067→      }
  1068→    });
  1069→
  1070→  // AC-obs-4, AC-obs-7, AC-obs-9: kspec meta resolve
  1071→  // AC: @trait-multi-ref-batch - Batch support with --refs flag
  1072→  markMutating(meta.command("resolve [ref] [resolution]"))
  1073→    .description("Resolve an observation (or multiple with --refs)")
  1074→    .option("--refs <refs...>", "Resolve multiple observations by ref")
  1075→    .option(
  1076→      "--resolution <text>",
  1077→      "Resolution text (required for batch mode unless observations have promoted tasks)",
  1078→    )
  1079→    .addHelpText(
  1080→      "after",
  1081→      `
  1082→Examples:
  1083→  $ kspec meta resolve @obs-ref "Fixed in PR #123"
  1084→  $ kspec meta resolve --refs @obs1 @obs2 --resolution "Resolved in batch"`,
  1085→    )
  1086→    .action(
  1087→      async (
  1088→        ref: string | undefined,
  1089→        resolutionArg: string | undefined,
  1090→        options,
  1091→      ) => {
  1092→        try {
  1093→          const ctx = await initContext();
  1094→
  1095→          if (!ctx.manifestPath) {
  1096→            error(errors.project.noKspecProject);
  1097→            process.exit(EXIT_CODES.ERROR);
  1098→          }
  1099→
  1100→          const metaCtx = await loadMetaContext(ctx);
  1101→          const observations = metaCtx.observations || [];
  1102→
  1103→          // Load tasks/items for auto-resolution from promoted tasks
  1104→          const tasks = await loadAllTasks(ctx);
  1105→          const items = await loadAllItems(ctx);
  1106→          const index = new ReferenceIndex(tasks, items);
  1107→
  1108→          // Resolution can come from positional arg or --resolution flag
  1109→          const resolution = resolutionArg || options.resolution;
  1110→
  1111→          // AC: @trait-multi-ref-batch ac-8 - Deduplicate refs
  1112→          const refsFlag = options.refs
  1113→            ? [...new Set(options.refs as string[])]
  1114→            : undefined;
  1115→
  1116→          // AC: @trait-multi-ref-batch ac-1, ac-2, ac-3, ac-4, ac-5
  1117→          const result = await executeBatchOperation({
  1118→            positionalRef: ref,
  1119→            refsFlag,
  1120→            context: { ctx, observations, tasks, items, index, resolution },
  1121→            items: observations,
  1122→            index: index,
  1123→            resolveRef: (refStr, obsList) => {
  1124→              return resolveObservationRefForBatch(
  1125→                refStr,
  1126→                obsList as Observation[],
  1127→              );
  1128→            },
  1129→            executeOperation: async (
  1130→              observation: Observation,
  1131→              { ctx, tasks, items, index, resolution },
  1132→            ) => {
  1133→              // AC-obs-7: Check if already resolved
  1134→              if (observation.resolved) {
  1135→                const resolvedDate = new Date(observation.resolved_at!)
  1136→                  .toISOString()
  1137→                  .split("T")[0];
  1138→                const resolutionText = observation.resolution || "";
  1139→                const truncated =
  1140→                  resolutionText.length > 50
  1141→                    ? `${resolutionText.substring(0, 50)}...`
  1142→                    : resolutionText;
  1143→                return {
  1144→                  success: false,
  1145→                  error: `Already resolved on ${resolvedDate}: ${truncated}`,
  1146→                };
  1147→              }
  1148→
  1149→              // AC-obs-9: Auto-populate resolution from task completion if promoted
  1150→              let finalResolution = resolution;
  1151→              if (!finalResolution && observation.promoted_to) {
  1152→                const taskResult = index.resolve(observation.promoted_to);
  1153→
  1154→                if (taskResult.ok) {
  1155→                  const item = taskResult.item;
  1156→                  // Type guard: ensure this is a task
  1157→                  if ("status" in item && "depends_on" in item) {
  1158→                    const task = item as LoadedTask;
  1159→                    if (task.status === "completed" && task.closed_reason) {
  1160→                      finalResolution = `Resolved via task ${observation.promoted_to}: ${task.closed_reason}`;
  1161→                    } else if (task.status === "completed") {
  1162→                      finalResolution = `Resolved via task ${observation.promoted_to}`;
  1163→                    } else {
  1164→                      return {
  1165→                        success: false,
  1166→                        error: `Task ${observation.promoted_to} is not completed yet`,
  1167→                      };
  1168→                    }
  1169→                  } else {
  1170→                    return {
  1171→                      success: false,
  1172→                      error: `Reference ${observation.promoted_to} is not a task`,
  1173→                    };
  1174→                  }
  1175→                } else {
  1176→                  return {
  1177→                    success: false,
  1178→                    error: `Task ${observation.promoted_to} not found`,
  1179→                  };
  1180→                }
  1181→              }
  1182→
  1183→              if (!finalResolution) {
  1184→                return {
  1185→                  success: false,
  1186→                  error: "Resolution text required",
  1187→                };
  1188→              }
  1189→
  1190→              // AC-obs-4: Update observation
  1191→              observation.resolved = true;
  1192→              observation.resolution = finalResolution;
  1193→              observation.resolved_at = new Date().toISOString();
  1194→              observation.resolved_by = observation.author;
  1195→
  1196→              await saveObservation(ctx, observation);
  1197→
  1198→              // AC: @trait-shadow-commit ac-1
  1199→              await commitIfShadow(
  1200→                ctx.shadow,
  1201→                "observation-resolve",
  1202→                observation._ulid.substring(0, 8),
  1203→              );
  1204→
  1205→              return {
  1206→                success: true,
  1207→                message: `Resolved: ${observation._ulid.substring(0, 8)}`,
  1208→              };
  1209→            },
  1210→            getUlid: (obs: Observation) => obs._ulid,
  1211→          });
  1212→
  1213→          // AC: @trait-multi-ref-batch ac-5, ac-7 - Output formatting
  1214→          formatBatchOutput(result, "Resolve");
  1215→        } catch (err) {
  1216→          error(errors.failures.resolveObservation, err);
  1217→          process.exit(EXIT_CODES.ERROR);
  1218→        }
  1219→      },
  1220→    );
  1221→
  1222→  // Meta add command - create new meta items
  1223→  markMutating(meta.command("add <type>"))
  1224→    .description("Create a new meta item (agent, workflow, or convention)")
  1225→    .option("--id <id>", "Semantic ID (required for agents and workflows)")
  1226→    .option("--domain <domain>", "Domain (required for conventions)")
  1227→    .option("--name <name>", "Name (for agents)")
  1228→    .option("--trigger <trigger>", "Trigger (for workflows)")
  1229→    .option("--description <desc>", "Description")
  1230→    .option("--capability <cap...>", "Capabilities (for agents)")
  1231→    .option("--tool <tool...>", "Tools (for agents)")
  1232→    .option("--convention <conv...>", "Convention references (for agents)")
  1233→    .option("--rule <rule...>", "Rules (for conventions)")
  1234→    .option("--steps <json>", "Workflow steps as JSON array (for workflows)")
  1235→    .option(
  1236→      "--mode <mode>",
  1237→      "Workflow mode: interactive (default) or loop (for workflows)",
  1238→    )
  1239→    .option("--based-on <ref>", "Base workflow reference (for loop workflows)")
  1240→    .option("--tag <tag...>", "Tags for the workflow (for workflows)")
  1241→    .addHelpText(
  1242→      "after",
  1243→      `
  1244→Examples:
  1245→  $ kspec meta add agent --id my-agent --name "My Agent" --capability search code
  1246→  $ kspec meta add convention --domain testing --rule "Always test" --rule "Use mocks"
  1247→  $ kspec meta add workflow --id my-flow --trigger manual --tag automation ci`,
  1248→    )
  1249→    .action(async (type: string, options) => {
  1250→      try {
  1251→        const ctx = await initContext();
  1252→
  1253→        // Validate type
  1254→        const validTypes = ["agent", "workflow", "convention"];
  1255→        if (!validTypes.includes(type)) {
  1256→          error(errors.validation.invalidType(type, validTypes));
  1257→          process.exit(EXIT_CODES.ERROR);
  1258→        }
  1259→
  1260→        // Generate ULID
  1261→        const itemUlid = ulid();
  1262→
  1263→        // Create the item based on type
  1264→        let item: Agent | Workflow | Convention;
  1265→
  1266→        if (type === "agent") {
  1267→          // Validate required fields
  1268→          if (!options.id) {
  1269→            error(errors.validation.agentRequiresId);
  1270→            process.exit(EXIT_CODES.ERROR);
  1271→          }
  1272→          if (!options.name) {
  1273→            error(errors.validation.agentRequiresName);
  1274→            process.exit(EXIT_CODES.ERROR);
  1275→          }
  1276→
  1277→          item = {
  1278→            _ulid: itemUlid,
  1279→            id: options.id,
  1280→            name: options.name,
  1281→            description: options.description || "",
  1282→            capabilities: options.capability || [],
  1283→            tools: options.tool || [],
  1284→            conventions: options.convention || [],
  1285→          };
  1286→        } else if (type === "workflow") {
  1287→          // Validate required fields
  1288→          if (!options.id) {
  1289→            error(errors.validation.workflowRequiresId);
  1290→            process.exit(EXIT_CODES.ERROR);
  1291→          }
  1292→          if (!options.trigger) {
  1293→            error(errors.validation.workflowRequiresTrigger);
  1294→            process.exit(EXIT_CODES.ERROR);
  1295→          }
  1296→
  1297→          // Parse and validate --steps if provided
  1298→          let steps: WorkflowStep[] = [];
  1299→          if (options.steps) {
  1300→            // AC: @meta-add-cmd ac-2 - Parse JSON
  1301→            let parsedSteps: unknown;
  1302→            try {
  1303→              parsedSteps = JSON.parse(options.steps);
  1304→            } catch (err) {
  1305→              const message = err instanceof Error ? err.message : String(err);
  1306→              error(errors.validation.invalidStepsJson(message));
  1307→              process.exit(EXIT_CODES.ERROR);
  1308→            }
  1309→
  1310→            // AC: @meta-add-cmd ac-3 - Verify it's an array
  1311→            if (!Array.isArray(parsedSteps)) {
  1312→              error(errors.validation.stepsNotArray);
  1313→              process.exit(EXIT_CODES.ERROR);
  1314→            }
  1315→
  1316→            // AC: @meta-add-cmd ac-4 - Validate with schema
  1317→            const result = z.array(WorkflowStepSchema).safeParse(parsedSteps);
  1318→            if (!result.success) {
  1319→              const issues = result.error.issues
  1320→                .map((i) => `${i.path.join(".")}: ${i.message}`)
  1321→                .join("; ");
  1322→              error(errors.validation.invalidStepsSchema(issues));
  1323→              process.exit(EXIT_CODES.ERROR);
  1324→            }
  1325→            steps = result.data;
  1326→          }
  1327→
  1328→          // Validate mode if provided
  1329→          const validModes = ["interactive", "loop"];
  1330→          if (options.mode && !validModes.includes(options.mode)) {
  1331→            error(
  1332→              `Invalid mode: ${options.mode}. Valid modes: ${validModes.join(", ")}`,
  1333→            );
  1334→            process.exit(EXIT_CODES.ERROR);
  1335→          }
  1336→
  1337→          item = {
  1338→            _ulid: itemUlid,
  1339→            id: options.id,
  1340→            trigger: options.trigger,
  1341→            description: options.description || "",
  1342→            steps,
  1343→            ...(options.mode && { mode: options.mode }),
  1344→            ...(options.basedOn && { based_on: options.basedOn }),
  1345→            ...(options.tag && options.tag.length > 0 && { tags: parseTagsArray(options.tag) }),
  1346→          };
  1347→        } else {
  1348→          // convention
  1349→          if (!options.domain) {
  1350→            error(errors.validation.conventionRequiresDomain);
  1351→            process.exit(EXIT_CODES.ERROR);
  1352→          }
  1353→
  1354→          item = {
  1355→            _ulid: itemUlid,
  1356→            domain: options.domain,
  1357→            rules: options.rule || [],
  1358→            examples: [],
  1359→          };
  1360→        }
  1361→
  1362→        // Save the item
  1363→        await saveMetaItem(
  1364→          ctx,
  1365→          item,
  1366→          type as "agent" | "workflow" | "convention",
  1367→        );
  1368→
  1369→        // AC: @trait-shadow-commit ac-1
  1370→        await commitIfShadow(
  1371→          ctx.shadow,
  1372→          `meta-add-${type}`,
  1373→          itemUlid.substring(0, 8),
  1374→          "id" in item ? item.id : "domain" in item ? item.domain : undefined,
  1375→        );
  1376→
  1377→        if (isJsonMode()) {
  1378→          // In JSON mode, output the item data directly
  1379→          console.log(JSON.stringify(item, null, 2));
  1380→        } else {
  1381→          const idOrDomain =
  1382→            "id" in item ? item.id : "domain" in item ? item.domain : itemUlid;
  1383→          success(
  1384→            `Created ${type}: ${idOrDomain} (@${itemUlid.substring(0, 8)})`,
  1385→          );
  1386→        }
  1387→      } catch (err) {
  1388→        error(errors.failures.createMeta(type), err);
  1389→        process.exit(EXIT_CODES.ERROR);
  1390→      }
  1391→    });
  1392→
  1393→  // Meta set command - update existing meta items
  1394→  markMutating(meta.command("set <ref>"))
  1395→    .description("Update an existing meta item")
  1396→    .option("--name <name>", "Update name (for agents)")
  1397→    .option("--description <desc>", "Update description")
  1398→    .option("--trigger <trigger>", "Update trigger (for workflows)")
  1399→    .option("--add-capability <cap>", "Add capability (for agents)")
  1400→    .option("--add-tool <tool>", "Add tool (for agents)")
  1401→    .option("--add-convention <conv>", "Add convention reference (for agents)")
  1402→    .option("--add-rule <rule>", "Add rule (for conventions)")
  1403→    .action(async (ref: string, options) => {
  1404→      try {
  1405→        const ctx = await initContext();
  1406→        const metaCtx = await loadMetaContext(ctx);
  1407→
  1408→        // Use unified resolver
  1409→        const resolved = resolveMetaRef(metaCtx, ref);
  1410→
  1411→        if (!resolved) {
  1412→          error(errors.reference.metaNotFound(ref));
  1413→          process.exit(EXIT_CODES.ERROR);
  1414→        }
  1415→
  1416→        // meta set only supports agent, workflow, convention
  1417→        // Skills have their own `kspec skill set` command
  1418→        const { item, type: itemType } = resolved;
  1419→        if (itemType !== "agent" && itemType !== "workflow" && itemType !== "convention") {
  1420→          error(`Cannot use 'meta set' with ${itemType}. Use 'kspec ${itemType === "skill" ? "skill" : "meta"} ${itemType === "observation" ? "resolve" : "set"} ${ref}' instead.`);
  1421→          process.exit(EXIT_CODES.ERROR);
  1422→        }
  1423→
  1424→        const found = item as Agent | Workflow | Convention;
  1425→
  1426→        // Update fields based on type
  1427→        if (itemType === "agent") {
  1428→          const item = found as Agent;
  1429→          if (options.name) item.name = options.name;
  1430→          if (options.description !== undefined)
  1431→            item.description = options.description;
  1432→          if (options.addCapability) {
  1433→            if (!item.capabilities.includes(options.addCapability)) {
  1434→              item.capabilities.push(options.addCapability);
  1435→            }
  1436→          }
  1437→          if (options.addTool) {
  1438→            if (!item.tools.includes(options.addTool)) {
  1439→              item.tools.push(options.addTool);
  1440→            }
  1441→          }
  1442→          if (options.addConvention) {
  1443→            if (!item.conventions.includes(options.addConvention)) {
  1444→              item.conventions.push(options.addConvention);
  1445→            }
  1446→          }
  1447→        } else if (itemType === "workflow") {
  1448→          const item = found as Workflow;
  1449→          if (options.trigger) item.trigger = options.trigger;
  1450→          if (options.description !== undefined)
  1451→            item.description = options.description;
  1452→        } else {
  1453→          const item = found as Convention;
  1454→          // Convention doesn't have a description field
  1455→          if (options.addRule) {
  1456→            if (!item.rules.includes(options.addRule)) {
  1457→              item.rules.push(options.addRule);
  1458→            }
  1459→          }
  1460→        }
  1461→
  1462→        // Save the updated item
  1463→        await saveMetaItem(ctx, found, itemType);
  1464→
  1465→        // AC: @trait-shadow-commit ac-1
  1466→        await commitIfShadow(
  1467→          ctx.shadow,
  1468→          `meta-set-${itemType}`,
  1469→          found._ulid.substring(0, 8),
  1470→        );
  1471→
  1472→        if (isJsonMode()) {
  1473→          // In JSON mode, output the item data directly
  1474→          console.log(JSON.stringify(found, null, 2));
  1475→        } else {
  1476→          const idOrDomain =
  1477→            itemType === "agent"
  1478→              ? (found as Agent).id
  1479→              : itemType === "workflow"
  1480→                ? (found as Workflow).id
  1481→                : (found as Convention).domain;
  1482→          success(`Updated ${itemType}: ${idOrDomain}`);
  1483→        }
  1484→      } catch (err) {
  1485→        error(errors.failures.updateMetaItem, err);
  1486→        process.exit(EXIT_CODES.ERROR);
  1487→      }
  1488→    });
  1489→
  1490→  // Meta delete command - delete meta items
  1491→  markMutating(meta.command("delete <ref>"))
  1492→    .description("Delete a meta item")
  1493→    .option("--confirm", "Skip confirmation prompt")
  1494→    .action(async (ref: string, options) => {
  1495→      try {
  1496→        const ctx = await initContext();
  1497→        const metaCtx = await loadMetaContext(ctx);
  1498→
  1499→        // Use unified resolver
  1500→        const resolved = resolveMetaRef(metaCtx, ref);
  1501→
  1502→        if (!resolved) {
  1503→          error(errors.reference.metaNotFound(ref));
  1504→          process.exit(EXIT_CODES.ERROR);
  1505→        }
  1506→
  1507→        // meta delete does not support skills - they use `kspec skill delete`
  1508→        if (resolved.type === "skill") {
  1509→          error(`Cannot use 'meta delete' with skills. Use 'kspec skill delete ${ref}' instead.`);
  1510→          process.exit(EXIT_CODES.ERROR);
  1511→        }
  1512→
  1513→        const itemType = resolved.type as "agent" | "workflow" | "convention" | "observation";
  1514→        const itemUlid = resolved.ulid;
  1515→
  1516→        // Build human-readable label for the item
  1517→        let itemLabel: string;
  1518→        const item = resolved.item;
  1519→        if (itemType === "agent" && "id" in item) {
  1520→          itemLabel = `agent ${item.id}`;
  1521→        } else if (itemType === "workflow" && "id" in item) {
  1522→          itemLabel = `workflow ${item.id}`;
  1523→        } else if (itemType === "convention" && "domain" in item) {
  1524→          itemLabel = `convention ${item.domain}`;
  1525→        } else {
  1526→          itemLabel = `observation ${itemUlid.substring(0, 8)}`;
  1527→        }
  1528→
  1529→        // Check for dangling references (unless --confirm is used to override)
  1530→        if (!options.confirm) {
  1531→          // Check tasks with meta_ref
  1532→          const tasks = await loadAllTasks(ctx);
  1533→          const referencingTasks = tasks.filter((t) => {
  1534→            if (!t.meta_ref) return false;
  1535→            // Resolve the task's meta_ref to a ULID
  1536→            const taskMetaRef = resolveMetaRefToUlid(t.meta_ref, metaCtx);
  1537→            // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1538→            return taskMetaRef && taskMetaRef.ulid === itemUlid;
  1539→          });
  1540→
  1541→          if (referencingTasks.length > 0) {
  1542→            const taskRefs = referencingTasks
  1543→              .map((t) => `@${t.slugs?.[0] || t._ulid.substring(0, 8)}`)
  1544→              .join(", ");
  1545→            error(
  1546→              errors.operation.cannotDeleteReferencedByTasks(
  1547→                itemLabel,
  1548→                referencingTasks.length,
  1549→                taskRefs,
  1550→              ),
  1551→            );
  1552→            process.exit(EXIT_CODES.ERROR);
  1553→          }
  1554→
  1555→          // Check observations with workflow_ref (only for workflows)
  1556→          if (itemType === "workflow") {
  1557→            const observations = metaCtx.observations || [];
  1558→            const referencingObservations = observations.filter((o) => {
  1559→              if (!o.workflow_ref) return false;
  1560→              // Resolve the observation's workflow_ref to a ULID
  1561→              const obsWorkflowRef = resolveMetaRefToUlid(
  1562→                o.workflow_ref,
  1563→                metaCtx,
  1564→              );
  1565→              // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1566→              return obsWorkflowRef && obsWorkflowRef.ulid === itemUlid;
  1567→            });
  1568→
  1569→            if (referencingObservations.length > 0) {
  1570→              const obsRefs = referencingObservations
  1571→                .map((o) => `@${o._ulid.substring(0, 8)}`)
  1572→                .join(", ");
  1573→              error(
  1574→                errors.operation.cannotDeleteReferencedByObservations(
  1575→                  itemLabel,
  1576→                  referencingObservations.length,
  1577→                  obsRefs,
  1578→                ),
  1579→              );
  1580→              process.exit(EXIT_CODES.ERROR);
  1581→            }
  1582→          }
  1583→
  1584→          // Show confirmation prompt even if no references found
  1585→          error(errors.operation.confirmRequired(itemLabel));
  1586→          process.exit(EXIT_CODES.ERROR);
  1587→        }
  1588→
  1589→        // Delete the item
  1590→        const deleted = await deleteMetaItem(ctx, itemUlid, itemType);
  1591→
  1592→        if (!deleted) {
  1593→          error(errors.operation.deleteItemFailed(itemLabel));
  1594→          process.exit(EXIT_CODES.ERROR);
  1595→        }
  1596→
  1597→        // AC: @trait-shadow-commit ac-1
  1598→        await commitIfShadow(
  1599→          ctx.shadow,
  1600→          `meta-delete-${itemType}`,
  1601→          itemUlid.substring(0, 8),
  1602→        );
  1603→
  1604→        success(`Deleted ${itemLabel}`);
  1605→      } catch (err) {
  1606→        error(errors.failures.deleteMetaItem, err);
  1607→        process.exit(EXIT_CODES.ERROR);
  1608→      }
  1609→    });
  1610→
  1611→  // meta-focus-cmd: kspec meta focus [ref]
  1612→  markMutating(meta.command("focus [ref]"))
  1613→    .description("Get or set session focus")
  1614→    .option("--clear", "Clear current focus")
  1615→    .action(async (ref: string | undefined, options) => {
  1616→      try {
  1617→        const ctx = await initContext();
  1618→
  1619→        if (!ctx.manifestPath) {
  1620→          error(errors.project.noKspecProject);
  1621→          process.exit(EXIT_CODES.ERROR);
  1622→        }
  1623→
  1624→        const sessionCtx = await loadSessionContext(ctx);
  1625→
  1626→        // Clear focus
  1627→        if (options.clear) {
  1628→          sessionCtx.focus = null;
  1629→          await saveSessionContext(ctx, sessionCtx);
  1630→
  1631→          output({ focus: null }, () => success("Cleared session focus"));
  1632→          return;
  1633→        }
  1634→
  1635→        // Show current focus
  1636→        if (!ref) {
  1637→          output({ focus: sessionCtx.focus }, () => {
  1638→            if (sessionCtx.focus) {
  1639→              console.log(`Current focus: ${sessionCtx.focus}`);
  1640→            } else {
  1641→              console.log(chalk.yellow("No focus set"));
  1642→            }
  1643→          });
  1644→          return;
  1645→        }
  1646→
  1647→        // Set focus to ref
  1648→        sessionCtx.focus = ref.startsWith("@") ? ref : `@${ref}`;
  1649→        await saveSessionContext(ctx, sessionCtx);
  1650→
  1651→        output({ focus: sessionCtx.focus }, () =>
  1652→          success(`Set focus to: ${sessionCtx.focus}`),
  1653→        );
  1654→      } catch (err) {
  1655→        error(errors.failures.updateSessionContext, err);
  1656→        process.exit(EXIT_CODES.ERROR);
  1657→      }
  1658→    });
  1659→
  1660→  // meta-thread-cmd: kspec meta thread <action> [text]
  1661→  markMutating(meta.command("thread <action> [text]"))
  1662→    .description("Manage active threads")
  1663→    .action(async (action: string, text: string | undefined) => {
  1664→      try {
  1665→        const ctx = await initContext();
  1666→
  1667→        if (!ctx.manifestPath) {
  1668→          error(errors.project.noKspecProject);
  1669→          process.exit(EXIT_CODES.ERROR);
  1670→        }
  1671→
  1672→        const sessionCtx = await loadSessionContext(ctx);
  1673→
  1674→        // List threads
  1675→        if (action === "list") {
  1676→          output({ threads: sessionCtx.threads }, () => {
  1677→            if (sessionCtx.threads.length === 0) {
  1678→              console.log(chalk.yellow("No active threads"));
  1679→            } else {
  1680→              console.log("Active threads:");
  1681→              sessionCtx.threads.forEach((thread, idx) => {
  1682→                console.log(`  ${idx + 1}. ${thread}`);
  1683→              });
  1684→            }
  1685→          });
  1686→          return;
  1687→        }
  1688→
  1689→        // Clear all threads
  1690→        if (action === "clear") {
  1691→          sessionCtx.threads = [];
  1692→          await saveSessionContext(ctx, sessionCtx);
  1693→
  1694→          output({ threads: [] }, () => success("Cleared all threads"));
  1695→          return;
  1696→        }
  1697→
  1698→        // Add thread
  1699→        if (action === "add") {
  1700→          if (!text) {
  1701→            error("Thread text is required for add action");
  1702→            process.exit(EXIT_CODES.ERROR);
  1703→          }
  1704→
  1705→          sessionCtx.threads.push(text);
  1706→          await saveSessionContext(ctx, sessionCtx);
  1707→
  1708→          output({ threads: sessionCtx.threads, added: text }, () =>
  1709→            success(`Added thread: ${text}`),
  1710→          );
  1711→          return;
  1712→        }
  1713→
  1714→        // Remove thread by index (1-based)
  1715→        if (action === "remove") {
  1716→          if (!text) {
  1717→            error("Index is required for remove action");
  1718→            process.exit(EXIT_CODES.ERROR);
  1719→          }
  1720→
  1721→          const index = parseInt(text, 10);
  1722→          if (
  1723→            Number.isNaN(index) ||
  1724→            index < 1 ||
  1725→            index > sessionCtx.threads.length
  1726→          ) {
  1727→            error(
  1728→              `Invalid index: ${text}. Must be between 1 and ${sessionCtx.threads.length}`,
  1729→            );
  1730→            process.exit(EXIT_CODES.ERROR);
  1731→          }
  1732→
  1733→          const removed = sessionCtx.threads.splice(index - 1, 1)[0];
  1734→          await saveSessionContext(ctx, sessionCtx);
  1735→
  1736→          output({ threads: sessionCtx.threads, removed }, () =>
  1737→            success(`Removed thread: ${removed}`),
  1738→          );
  1739→          return;
  1740→        }
  1741→
  1742→        // Unknown action
  1743→        error(`Unknown action: ${action}. Use add, remove, list, or clear`);
  1744→        process.exit(EXIT_CODES.ERROR);
  1745→      } catch (err) {
  1746→        error(errors.failures.updateSessionContext, err);
  1747→        process.exit(EXIT_CODES.ERROR);
  1748→      }
  1749→    });
  1750→
  1751→  // meta-question-cmd: kspec meta question <action> [text]
  1752→  markMutating(meta.command("question <action> [text]"))
  1753→    .description("Manage open questions")
  1754→    .action(async (action: string, text: string | undefined) => {
  1755→      try {
  1756→        const ctx = await initContext();
  1757→
  1758→        if (!ctx.manifestPath) {
  1759→          error(errors.project.noKspecProject);
  1760→          process.exit(EXIT_CODES.ERROR);
  1761→        }
  1762→
  1763→        const sessionCtx = await loadSessionContext(ctx);
  1764→
  1765→        // List questions
  1766→        if (action === "list") {
  1767→          output({ questions: sessionCtx.open_questions }, () => {
  1768→            if (sessionCtx.open_questions.length === 0) {
  1769→              console.log(chalk.yellow("No open questions"));
  1770→            } else {
  1771→              console.log("Open questions:");
  1772→              sessionCtx.open_questions.forEach((question, idx) => {
  1773→                console.log(`  ${idx + 1}. ${question}`);
  1774→              });
  1775→            }
  1776→          });
  1777→          return;
  1778→        }
  1779→
  1780→        // Clear all questions
  1781→        if (action === "clear") {
  1782→          sessionCtx.open_questions = [];
  1783→          await saveSessionContext(ctx, sessionCtx);
  1784→
  1785→          output({ questions: [] }, () => success("Cleared all questions"));
  1786→          return;
  1787→        }
  1788→
  1789→        // Add question
  1790→        if (action === "add") {
  1791→          if (!text) {
  1792→            error("Question text is required for add action");
  1793→            process.exit(EXIT_CODES.ERROR);
  1794→          }
  1795→
  1796→          sessionCtx.open_questions.push(text);
  1797→          await saveSessionContext(ctx, sessionCtx);
  1798→
  1799→          output({ questions: sessionCtx.open_questions, added: text }, () =>
  1800→            success(`Added question: ${text}`),
  1801→          );
  1802→          return;
  1803→        }
  1804→
  1805→        // Remove question by index (1-based)
  1806→        if (action === "remove") {
  1807→          if (!text) {
  1808→            error("Index is required for remove action");
  1809→            process.exit(EXIT_CODES.ERROR);
  1810→          }
  1811→
  1812→          const index = parseInt(text, 10);
  1813→          if (
  1814→            Number.isNaN(index) ||
  1815→            index < 1 ||
  1816→            index > sessionCtx.open_questions.length
  1817→          ) {
  1818→            error(
  1819→              `Invalid index: ${text}. Must be between 1 and ${sessionCtx.open_questions.length}`,
  1820→            );
  1821→            process.exit(EXIT_CODES.ERROR);
  1822→          }
  1823→
  1824→          const removed = sessionCtx.open_questions.splice(index - 1, 1)[0];
  1825→          await saveSessionContext(ctx, sessionCtx);
  1826→
  1827→          output({ questions: sessionCtx.open_questions, removed }, () =>
  1828→            success(`Removed question: ${removed}`),
  1829→          );
  1830→          return;
  1831→        }
  1832→
  1833→        // Unknown action
  1834→        error(`Unknown action: ${action}. Use add, remove, list, or clear`);
  1835→        process.exit(EXIT_CODES.ERROR);
  1836→      } catch (err) {
  1837→        error(errors.failures.updateSessionContext, err);
  1838→        process.exit(EXIT_CODES.ERROR);
  1839→      }
  1840→    });
  1841→
  1842→  // meta-context-cmd: kspec meta context
  1843→  meta
  1844→    .command("context")
  1845→    .description("Show full session context")
  1846→    .option("--clear", "Clear all session context")
  1847→    .action(async (options) => {
  1848→      try {
  1849→        const ctx = await initContext();
  1850→
  1851→        if (!ctx.manifestPath) {
  1852→          error(errors.project.noKspecProject);
  1853→          process.exit(EXIT_CODES.ERROR);
  1854→        }
  1855→
  1856→        const sessionCtx = await loadSessionContext(ctx);
  1857→
  1858→        // Clear all context
  1859→        if (options.clear) {
  1860→          sessionCtx.focus = null;
  1861→          sessionCtx.threads = [];
  1862→          sessionCtx.open_questions = [];
  1863→          await saveSessionContext(ctx, sessionCtx);
  1864→
  1865→          output(
  1866→            {
  1867→              focus: null,
  1868→              threads: [],
  1869→              open_questions: [],
  1870→              updated_at: sessionCtx.updated_at,
  1871→            },
  1872→            () => success("Cleared all session context"),
  1873→          );
  1874→          return;
  1875→        }
  1876→
  1877→        // Show full session context
  1878→        output(
  1879→          {
  1880→            focus: sessionCtx.focus,
  1881→            threads: sessionCtx.threads,
  1882→            open_questions: sessionCtx.open_questions,
  1883→            updated_at: sessionCtx.updated_at,
  1884→          },
  1885→          () => {
  1886→            console.log(chalk.bold("Session Context"));
  1887→            console.log(chalk.gray("─".repeat(60)));
  1888→
  1889→            // Focus
  1890→            console.log(chalk.bold("\nFocus:"));
  1891→            if (sessionCtx.focus) {
  1892→              console.log(`  ${sessionCtx.focus}`);
  1893→            } else {
  1894→              console.log(chalk.gray("  (none)"));
  1895→            }
  1896→
  1897→            // Active threads
  1898→            console.log(chalk.bold("\nActive Threads:"));
  1899→            if (sessionCtx.threads.length > 0) {
  1900→              sessionCtx.threads.forEach((thread, idx) => {
  1901→                console.log(`  ${idx + 1}. ${thread}`);
  1902→              });
  1903→            } else {
  1904→              console.log(chalk.gray("  (none)"));
  1905→            }
  1906→
  1907→            // Open questions
  1908→            console.log(chalk.bold("\nOpen Questions:"));
  1909→            if (sessionCtx.open_questions.length > 0) {
  1910→              sessionCtx.open_questions.forEach((question, idx) => {
  1911→                console.log(`  ${idx + 1}. ${question}`);
  1912→              });
  1913→            } else {
  1914→              console.log(chalk.gray("  (none)"));
  1915→            }
  1916→
  1917→            // Last updated
  1918→            console.log(chalk.bold("\nLast Updated:"));
  1919→            const updatedDate = new Date(sessionCtx.updated_at);
  1920→            console.log(`  ${updatedDate.toISOString()}`);
  1921→            console.log(chalk.gray(`  (${updatedDate.toLocaleString()})`));
  1922→          },
  1923→        );
  1924→      } catch (err) {
  1925→        error(errors.failures.updateSessionContext, err);
  1926→        process.exit(EXIT_CODES.ERROR);
  1927→      }
  1928→    });
  1929→}
  1930→