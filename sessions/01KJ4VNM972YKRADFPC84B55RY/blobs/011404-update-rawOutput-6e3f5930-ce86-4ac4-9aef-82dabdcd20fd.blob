     1→/**
     2→ * Meta CLI commands for interacting with meta-spec.
     3→ *
     4→ * AC-meta-manifest-1: kspec meta show outputs summary
     5→ * AC-meta-manifest-2: kspec validate includes meta line
     6→ * AC-meta-manifest-3: kspec validate shows meta errors with prefix
     7→ * AC-agent-1: kspec meta agents outputs table
     8→ * AC-agent-2: kspec meta agents --json outputs JSON
     9→ */
    10→
    11→import chalk from "chalk";
    12→import Table from "cli-table3";
    13→import type { Command } from "commander";
    14→import { ulid } from "ulid";
    15→import { markMutating } from "../command-annotations.js";
    16→import {
    17→  type Agent,
    18→  type Convention,
    19→  createObservation,
    20→  createTask,
    21→  deleteInboxItem,
    22→  deleteMetaItem,
    23→  findInboxItemByRef,
    24→  getMetaStats,
    25→  initContext,
    26→  type LoadedTask,
    27→  loadAllItems,
    28→  loadAllTasks,
    29→  loadInboxItems,
    30→  loadMetaContext,
    31→  loadSessionContext,
    32→  type MetaContext,
    33→  type Observation,
    34→  ReferenceIndex,
    35→  resolveMetaRef,
    36→  saveMetaItem,
    37→  saveObservation,
    38→  saveSessionContext,
    39→  saveTask,
    40→  type Workflow,
    41→} from "../../parser/index.js";
