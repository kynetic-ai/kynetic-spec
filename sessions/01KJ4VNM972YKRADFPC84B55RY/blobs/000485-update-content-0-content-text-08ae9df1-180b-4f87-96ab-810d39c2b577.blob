```
     1→/**
     2→ * Meta manifest loading and operations.
     3→ *
     4→ * The meta manifest (kynetic.meta.yaml) contains process definitions:
     5→ * - Agents: roles, capabilities, conventions
     6→ * - Workflows: structured processes with steps
     7→ * - Conventions: project rules and standards
     8→ * - Observations: feedback about processes
     9→ */
    10→
    11→import * as fs from "node:fs/promises";
    12→import * as path from "node:path";
    13→import { ulid } from "ulid";
    14→import {
    15→  type Agent,
    16→  AgentSchema,
    17→  type Convention,
    18→  ConventionSchema,
    19→  getMetaItemType,
    20→  isSkill,
    21→  type MetaItem,
    22→  type MetaManifest,
    23→  MetaManifestSchema,
    24→  type Observation,
    25→  ObservationSchema,
    26→  type ObservationType,
    27→  type SessionContext,
    28→  SessionContextSchema,
    29→  type Skill,
    30→  SkillSchema,
    31→  type Workflow,
    32→  type WorkflowRun,
    33→  type WorkflowRunsFile,
    34→  WorkflowRunsFileSchema,
    35→  WorkflowSchema,
    36→} from "../schema/index.js";
    37→import type { KspecContext } from "./yaml.js";
    38→import {
    39→  expandIncludePattern,
    40→  getAuthor,
    41→  readYamlFile,
    42→  writeYamlFilePreserveFormat,
    43→} from "./yaml.js";
    44→
    45→/**
    46→ * Loaded agent with runtime metadata
    47→ */
    48→export interface LoadedAgent extends Agent {
    49→  _sourceFile?: string;
    50→}
    51→
    52→/**
    53→ * Loaded workflow with runtime metadata
    54→ */
    55→export interface LoadedWorkflow extends Workflow {
    56→  _sourceFile?: string;
    57→}
    58→
    59→/**
    60→ * Loaded convention with runtime metadata
    61→ */
    62→export interface LoadedConvention extends Convention {
    63→  _sourceFile?: string;
    64→}
    65→
    66→/**
    67→ * Loaded observation with runtime metadata
    68→ */
    69→export interface LoadedObservation extends Observation {
    70→  _sourceFile?: string;
    71→}
    72→
    73→/**
    74→ * Loaded skill with runtime metadata
    75→ */
    76→export interface LoadedSkill extends Skill {
    77→  _sourceFile?: string;
    78→}
    79→
    80→/**
    81→ * Any loaded meta item
    82→ */
    83→export type LoadedMetaItem =
    84→  | LoadedAgent
    85→  | LoadedWorkflow
    86→  | LoadedConvention
    87→  | LoadedObservation
    88→  | LoadedSkill;
    89→
    90→/**
    91→ * Meta context containing all loaded meta items
    92→ */
    93→export interface MetaContext {
    94→  manifest: MetaManifest | null;
    95→  manifestPath: string | null;
    96→  agents: LoadedAgent[];
    97→  workflows: LoadedWorkflow[];
    98→  conventions: LoadedConvention[];
    99→  observations: LoadedObservation[];
   100→  skills: LoadedSkill[];
   101→}
   102→
   103→/**
   104→ * Find the meta manifest file.
   105→ *
   106→ * Discovery algorithm:
   107→ * 1. Check for explicit name: kynetic.meta.yaml (backward compat)
   108→ * 2. If not found, scan directory for *.meta.yaml files
   109→ * 3. For each candidate, validate it contains a 'kynetic_meta:' version field
   110→ * 4. Return first valid match (alphabetically after explicit name)
   111→ *
   112→ * AC: @meta-manifest-discovery ac-1, ac-2, ac-3
   113→ */
   114→export async function findMetaManifest(
   115→  specDir: string,
   116→): Promise<string | null> {
   117→  // AC: @meta-manifest-discovery ac-1, ac-3 - explicit name has priority
   118→  const priorityPath = path.join(specDir, "kynetic.meta.yaml");
   119→  try {
   120→    await fs.access(priorityPath);
   121→    return priorityPath;
   122→  } catch {
   123→    // Continue to glob fallback
   124→  }
   125→
   126→  // AC: @meta-manifest-discovery ac-2, ac-3 - glob fallback with validation
   127→  try {
   128→    const entries = await fs.readdir(specDir);
   129→    // AC: @meta-manifest-discovery ac-3 - alphabetical order
   130→    const candidates = entries
   131→      .filter((f) => f.endsWith(".meta.yaml"))
   132→      .sort();
   133→
   134→    for (const candidate of candidates) {
   135→      const filePath = path.join(specDir, candidate);
   136→      try {
   137→        const raw = await readYamlFile<unknown>(filePath);
   138→        // AC: @meta-manifest-discovery ac-2 - validate kynetic_meta version field
   139→        if (raw && typeof raw === "object" && "kynetic_meta" in raw) {
   140→          return filePath;
   141→        }
   142→      } catch {
   143→        // Skip invalid files
   144→      }
   145→    }
   146→  } catch {
   147→    // Directory read failed
   148→  }
   149→
   150→  return null;
   151→}
   152→
   153→/**
   154→ * Get the base name (slug) from a manifest path.
   155→ * E.g., "kynetic.yaml" -> "kynetic", "myproject.spec.yaml" -> "myproject"
   156→ */
   157→function getManifestBaseName(manifestPath: string | null): string {
   158→  if (!manifestPath) return "kynetic";
   159→  const fileName = path.basename(manifestPath);
   160→  // Remove .yaml extension
   161→  let baseName = fileName.replace(/\.yaml$/, "");
   162→  // Remove .spec suffix if present
   163→  baseName = baseName.replace(/\.spec$/, "");
   164→  return baseName || "kynetic";
   165→}
   166→
   167→/**
   168→ * Get the meta manifest file path.
   169→ * Derives from main manifest name (e.g., myproject.yaml -> myproject.meta.yaml)
   170→ * Returns path even if file doesn't exist yet.
   171→ */
   172→export function getMetaManifestPath(ctx: KspecContext): string {
   173→  const baseName = getManifestBaseName(ctx.manifestPath);
   174→  return path.join(ctx.specDir, `${baseName}.meta.yaml`);
   175→}
   176→
   177→/**
   178→ * Load meta items from a single file.
   179→ */
   180→async function loadMetaFile(filePath: string): Promise<{
   181→  agents: LoadedAgent[];
   182→  workflows: LoadedWorkflow[];
   183→  conventions: LoadedConvention[];
   184→  observations: LoadedObservation[];
   185→  skills: LoadedSkill[];
   186→}> {
   187→  const result: {
   188→    agents: LoadedAgent[];
   189→    workflows: LoadedWorkflow[];
   190→    conventions: LoadedConvention[];
   191→    observations: LoadedObservation[];
   192→    skills: LoadedSkill[];
   193→  } = {
   194→    agents: [],
   195→    workflows: [],
   196→    conventions: [],
   197→    observations: [],
   198→    skills: [],
   199→  };
   200→
   201→  try {
   202→    const raw = await readYamlFile<unknown>(filePath);
   203→    if (!raw || typeof raw !== "object") {
   204→      return result;
   205→    }
   206→
   207→    const obj = raw as Record<string, unknown>;
   208→
   209→    // Parse agents
   210→    if (Array.isArray(obj.agents)) {
   211→      for (const agent of obj.agents) {
   212→        const parsed = AgentSchema.safeParse(agent);
   213→        if (parsed.success) {
   214→          result.agents.push({ ...parsed.data, _sourceFile: filePath });
   215→        }
   216→      }
   217→    }
   218→
   219→    // Parse workflows
   220→    if (Array.isArray(obj.workflows)) {
   221→      for (const workflow of obj.workflows) {
   222→        const parsed = WorkflowSchema.safeParse(workflow);
   223→        if (parsed.success) {
   224→          result.workflows.push({ ...parsed.data, _sourceFile: filePath });
   225→        }
   226→      }
   227→    }
   228→
   229→    // Parse conventions
   230→    if (Array.isArray(obj.conventions)) {
   231→      for (const convention of obj.conventions) {
   232→        const parsed = ConventionSchema.safeParse(convention);
   233→        if (parsed.success) {
   234→          result.conventions.push({ ...parsed.data, _sourceFile: filePath });
   235→        }
   236→      }
   237→    }
   238→
   239→    // Parse observations
   240→    if (Array.isArray(obj.observations)) {
   241→      for (const observation of obj.observations) {
   242→        const parsed = ObservationSchema.safeParse(observation);
   243→        if (parsed.success) {
   244→          result.observations.push({ ...parsed.data, _sourceFile: filePath });
   245→        }
   246→      }
   247→    }
   248→
   249→    // Parse skills
   250→    // AC: @skill-meta-type ac-4 - skills loaded with _sourceFile set
   251→    if (Array.isArray(obj.skills)) {
   252→      for (const skill of obj.skills) {
   253→        const parsed = SkillSchema.safeParse(skill);
   254→        if (parsed.success) {
   255→          result.skills.push({ ...parsed.data, _sourceFile: filePath });
   256→        }
   257→      }
   258→    }
   259→  } catch {
   260→    // File doesn't exist or parse error
   261→  }
   262→
   263→  return result;
   264→}
   265→
   266→/**
   267→ * Load the meta context from a kspec context.
   268→ * Loads meta manifest and follows includes.
   269→ * AC: @skill-meta-type ac-4 - MetaContext.skills contains LoadedSkill objects with _sourceFile set
   270→ */
   271→export async function loadMetaContext(ctx: KspecContext): Promise<MetaContext> {
   272→  const result: MetaContext = {
   273→    manifest: null,
   274→    manifestPath: null,
   275→    agents: [],
   276→    workflows: [],
   277→    conventions: [],
   278→    observations: [],
   279→    skills: [],
   280→  };
   281→
   282→  const manifestPath = await findMetaManifest(ctx.specDir);
   283→  if (!manifestPath) {
   284→    return result;
   285→  }
   286→
   287→  result.manifestPath = manifestPath;
   288→
   289→  try {
   290→    const raw = await readYamlFile<unknown>(manifestPath);
   291→    const parsed = MetaManifestSchema.safeParse(raw);
   292→    if (!parsed.success) {
   293→      // Invalid manifest, but we can still try to extract items
   294→      const items = await loadMetaFile(manifestPath);
   295→      result.agents.push(...items.agents);
   296→      result.workflows.push(...items.workflows);
   297→      result.conventions.push(...items.conventions);
   298→      result.observations.push(...items.observations);
   299→      result.skills.push(...items.skills);
   300→      return result;
   301→    }
   302→
   303→    result.manifest = parsed.data;
   304→
   305→    // Load items from manifest
   306→    const manifestItems = await loadMetaFile(manifestPath);
   307→    result.agents.push(...manifestItems.agents);
   308→    result.workflows.push(...manifestItems.workflows);
   309→    result.conventions.push(...manifestItems.conventions);
   310→    result.observations.push(...manifestItems.observations);
   311→    result.skills.push(...manifestItems.skills);
   312→
   313→    // Process includes
   314→    const includes = parsed.data.includes || [];
   315→    const manifestDir = path.dirname(manifestPath);
   316→
   317→    for (const include of includes) {
   318→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   319→
   320→      for (const filePath of expandedPaths) {
   321→        const items = await loadMetaFile(filePath);
   322→        result.agents.push(...items.agents);
   323→        result.workflows.push(...items.workflows);
   324→        result.conventions.push(...items.conventions);
   325→        result.observations.push(...items.observations);
   326→        result.skills.push(...items.skills);
   327→      }
   328→    }
   329→  } catch {
   330→    // Manifest exists but may be invalid
   331→  }
   332→
   333→  return result;
   334→}
   335→
   336→/**
   337→ * Get meta stats summary
   338→ */
   339→export function getMetaStats(meta: MetaContext): {
   340→  agents: number;
   341→  workflows: number;
   342→  conventions: number;
   343→  observations: number;
   344→  unresolvedObservations: number;
   345→  skills: number;
   346→} {
   347→  return {
   348→    agents: meta.agents.length,
   349→    workflows: meta.workflows.length,
   350→    conventions: meta.conventions.length,
   351→    observations: meta.observations.length,
   352→    unresolvedObservations: meta.observations.filter((o) => !o.resolved).length,
   353→    skills: meta.skills.length,
   354→  };
   355→}
   356→
   357→/**
   358→ * Meta item type string literal
   359→ */
   360→export type MetaItemTypeName =
   361→  | "agent"
   362→  | "workflow"
   363→  | "convention"
   364→  | "observation"
   365→  | "skill";
   366→
   367→/**
   368→ * Result of resolving a meta reference
   369→ */
   370→export interface ResolvedMetaRef {
   371→  item: LoadedMetaItem;
   372→  type: MetaItemTypeName;
   373→  ulid: string;
   374→}
   375→
   376→/**
   377→ * Resolve a meta reference to its item, type, and ULID.
   378→ *
   379→ * This is the unified resolver for meta items that consolidates various
   380→ * ref-to-item resolution patterns. Handles ULID prefixes, full ULIDs,
   381→ * semantic IDs (id field for agents/workflows/skills), and domains (conventions).
   382→ *
   383→ * AC: @skill-meta-type ac-5 - skills returned by semantic id lookup
   384→ * AC: @skill-meta-type ac-6 - skills returned by ULID prefix lookup
   385→ * AC: @skill-meta-integration ac-4 - skills included in resolution
   386→ */
   387→export function resolveMetaRef(
   388→  meta: MetaContext,
   389→  ref: string,
   390→): ResolvedMetaRef | null {
   391→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
   392→
   393→  // Search all item types
   394→  const allItems: LoadedMetaItem[] = [
   395→    ...meta.agents,
   396→    ...meta.workflows,
   397→    ...meta.conventions,
   398→    ...meta.observations,
   399→    ...meta.skills,
   400→  ];
   401→
   402→  for (const item of allItems) {
   403→    // Match full ULID
   404→    if (item._ulid === cleanRef) {
   405→      return { item, type: getMetaItemType(item), ulid: item._ulid };
   406→    }
   407→
   408→    // Match short ULID (prefix)
   409→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase())) {
   410→      return { item, type: getMetaItemType(item), ulid: item._ulid };
   411→    }
   412→
   413→    // Match by id (for agents, workflows, and skills)
   414→    if ("id" in item && item.id === cleanRef) {
   415→      return { item, type: getMetaItemType(item), ulid: item._ulid };
   416→    }
   417→
   418→    // Match by domain (for conventions)
   419→    if ("domain" in item && item.domain === cleanRef) {
   420→      return { item, type: getMetaItemType(item), ulid: item._ulid };
   421→    }
   422→  }
   423→
   424→  return null;
   425→}
   426→
   427→/**
   428→ * Find a meta item by reference (ULID, short ULID, or id)
   429→ *
   430→ * This is a convenience wrapper around resolveMetaRef that returns just the item.
   431→ * Use resolveMetaRef when you also need the type and ULID.
   432→ *
   433→ * AC: @skill-meta-type ac-5 - skills returned by semantic id lookup
   434→ * AC: @skill-meta-type ac-6 - skills returned by ULID prefix lookup
   435→ */
   436→export function findMetaItemByRef(
   437→  meta: MetaContext,
   438→  ref: string,
   439→): LoadedMetaItem | undefined {
   440→  const result = resolveMetaRef(meta, ref);
   441→  return result?.item;
   442→}
   443→
   444→/**
   445→ * Determine if an item is a meta item type
   446→ */
   447→export function isMetaItemType(type: string): boolean {
   448→  return ["agent", "workflow", "convention", "observation", "skill"].includes(
   449→    type,
   450→  );
   451→}
   452→
   453→// ============================================================
   454→// META ITEM CRUD
   455→// ============================================================
   456→
   457→/**
   458→ * Save the entire meta manifest to file
   459→ */
   460→async function saveMetaManifest(
   461→  manifestPath: string,
   462→  manifest: MetaManifest,
   463→): Promise<void> {
   464→  await writeYamlFilePreserveFormat(manifestPath, manifest);
   465→}
   466→
   467→/**
   468→ * Strip runtime metadata before serialization
   469→ */
   470→function stripMetaMetadata<T extends LoadedMetaItem>(
   471→  item: T,
   472→): Omit<T, "_sourceFile"> {
   473→  const { _sourceFile, ...cleanItem } = item;
   474→  return cleanItem as Omit<T, "_sourceFile">;
   475→}
   476→
   477→/**
   478→ * Create a new observation
   479→ */
   480→export function createObservation(
   481→  type: ObservationType,
   482→  content: string,
   483→  options: {
   484→    workflow_ref?: string;
   485→    author?: string;
   486→    /** Config author from kspec.config.yaml identity.author */
   487→    configAuthor?: string | null;
   488→  } = {},
   489→): Observation {
   490→  return {
   491→    _ulid: ulid(),
   492→    type,
   493→    content,
   494→    workflow_ref: options.workflow_ref,
   495→    created_at: new Date().toISOString(),
   496→    author: options.author ?? getAuthor(options.configAuthor),
   497→    resolved: false,
   498→    resolution: null,
   499→  };
   500→}
   501→
   502→/**
   503→ * Save an observation to the meta manifest
   504→ */
   505→export async function saveObservation(
   506→  ctx: KspecContext,
   507→  observation: LoadedObservation,
   508→): Promise<void> {
   509→  const manifestPath = getMetaManifestPath(ctx);
   510→
   511→  // Ensure directory exists
   512→  const dir = path.dirname(manifestPath);
   513→  await fs.mkdir(dir, { recursive: true });
   514→
   515→  // Load existing manifest
   516→  let manifest: MetaManifest = {
   517→    kynetic_meta: "1.0",
   518→    agents: [],
   519→    workflows: [],
   520→    conventions: [],
   521→    observations: [],
   522→    skills: [],
   523→    includes: [],
   524→  };
   525→
   526→  try {
   527→    const raw = await readYamlFile<unknown>(manifestPath);
   528→    const parsed = MetaManifestSchema.safeParse(raw);
   529→    if (parsed.success) {
   530→      manifest = parsed.data;
   531→    }
   532→  } catch {
   533→    // File doesn't exist, use defaults
   534→  }
   535→
   536→  // Strip runtime metadata
   537→  const cleanObs = stripMetaMetadata(observation);
   538→
   539→  // Update or add
   540→  const existingIndex = manifest.observations.findIndex(
   541→    (o) => o._ulid === observation._ulid,
   542→  );
   543→  if (existingIndex >= 0) {
   544→    manifest.observations[existingIndex] = cleanObs as Observation;
   545→  } else {
   546→    manifest.observations.push(cleanObs as Observation);
   547→  }
   548→
   549→  await saveMetaManifest(manifestPath, manifest);
   550→}
   551→
   552→/**
   553→ * Delete an observation from the meta manifest
   554→ */
   555→export async function deleteObservation(
   556→  ctx: KspecContext,
   557→  ulid: string,
   558→): Promise<boolean> {
   559→  const manifestPath = getMetaManifestPath(ctx);
   560→
   561→  try {
   562→    const raw = await readYamlFile<unknown>(manifestPath);
   563→    const parsed = MetaManifestSchema.safeParse(raw);
   564→    if (!parsed.success) {
   565→      return false;
   566→    }
   567→
   568→    const manifest = parsed.data;
   569→    const index = manifest.observations.findIndex((o) => o._ulid === ulid);
   570→    if (index < 0) {
   571→      return false;
   572→    }
   573→
   574→    manifest.observations.splice(index, 1);
   575→    await saveMetaManifest(manifestPath, manifest);
   576→    return true;
   577→  } catch {
   578→    return false;
   579→  }
   580→}
   581→
   582→/**
   583→ * Get the path for skill content file.
   584→ * Skills are stored in .kspec/skills/<id>/SKILL.md
   585→ */
   586→export function getSkillContentPath(ctx: KspecContext, skillId: string): string {
   587→  return path.join(ctx.specDir, "skills", skillId, "SKILL.md");
   588→}
   589→
   590→/**
   591→ * Load skill content from the SKILL.md file.
   592→ * AC: @skill-meta-type ac-3 - loadSkillContent returns full markdown content
   593→ * AC: @skill-content-model ac-1 - loadSkillContent returns markdown content as a string
   594→ */
   595→export async function loadSkillContent(
   596→  ctx: KspecContext,
   597→  skill: LoadedSkill,
   598→): Promise<string | null> {
   599→  const contentPath = getSkillContentPath(ctx, skill.id);
   600→  try {
   601→    const content = await fs.readFile(contentPath, "utf-8");
   602→    return content;
   603→  } catch {
   604→    return null;
   605→  }
   606→}
   607→
   608→/**
   609→ * Skill doc object returned by loadSkillDocs.
   610→ * AC: @skill-content-model ac-2
   611→ */
   612→export interface SkillDoc {
   613→  /** File name (e.g., "quickref.md") */
   614→  name: string;
   615→  /** Full file path */
   616→  path: string;
   617→  /** File content */
   618→  content: string;
   619→}
   620→
   621→/**
   622→ * Supported skill supporting directory types.
   623→ * AC: @supporting-files-convention ac-1
   624→ */
   625→export type SupportingDirType = "references" | "scripts" | "assets" | "docs";
   626→
   627→/**
   628→ * A file from a skill's supporting directory.
   629→ * AC: @supporting-files-convention ac-1
   630→ */
   631→export interface SupportingFile {
   632→  /** File name (e.g., "api.md", "helper.sh") */
   633→  name: string;
   634→  /** Full file path */
   635→  path: string;
   636→  /** File content (for text files) */
   637→  content: string;
   638→  /** Supporting directory type */
   639→  dirType: SupportingDirType;
   640→}
   641→
   642→/**
   643→ * Get the docs directory path for a skill.
   644→ * Skills can have supporting docs at .kspec/skills/<id>/docs/
   645→ */
   646→export function getSkillDocsPath(ctx: KspecContext, skillId: string): string {
   647→  return path.join(ctx.specDir, "skills", skillId, "docs");
   648→}
   649→
   650→/**
   651→ * Load skill documentation files from the docs/ subdirectory.
   652→ * AC: @skill-content-model ac-2 - loadSkillDocs returns array of doc objects
   653→ */
   654→export async function loadSkillDocs(
   655→  ctx: KspecContext,
   656→  skill: LoadedSkill,
   657→): Promise<SkillDoc[]> {
   658→  const docsPath = getSkillDocsPath(ctx, skill.id);
   659→  const docs: SkillDoc[] = [];
   660→
   661→  try {
   662→    const entries = await fs.readdir(docsPath, { withFileTypes: true });
   663→
   664→    for (const entry of entries) {
   665→      if (entry.isFile() && entry.name.endsWith(".md")) {
   666→        const filePath = path.join(docsPath, entry.name);
   667→        try {
   668→          const content = await fs.readFile(filePath, "utf-8");
   669→          docs.push({
   670→            name: entry.name,
   671→            path: filePath,
   672→            content,
   673→          });
   674→        } catch {
   675→          // Skip files that can't be read
   676→        }
   677→      }
   678→    }
   679→  } catch {
   680→    // docs directory doesn't exist or can't be read
   681→  }
   682→
   683→  return docs;
   684→}
   685→
   686→/**
   687→ * Get the path to a supporting directory for a skill.
   688→ * AC: @supporting-files-convention ac-1
   689→ */
   690→export function getSkillSupportingDirPath(
   691→  ctx: KspecContext,
   692→  skillId: string,
   693→  dirType: SupportingDirType
   694→): string {
   695→  return path.join(ctx.specDir, "skills", skillId, dirType);
   696→}
   697→
   698→/**
   699→ * Load files from a skill's supporting directory.
   700→ * AC: @supporting-files-convention ac-1 - references files are accessible
   701→ *
   702→ * @param ctx - Kspec context
   703→ * @param skill - The skill to load files from
   704→ * @param dirType - The supporting directory type (references, scripts, assets, docs)
   705→ * @returns Array of files found in the directory
   706→ */
   707→export async function loadSkillSupportingFiles(
   708→  ctx: KspecContext,
   709→  skill: LoadedSkill,
   710→  dirType: SupportingDirType
   711→): Promise<SupportingFile[]> {
   712→  const dirPath = getSkillSupportingDirPath(ctx, skill.id, dirType);
   713→  const files: SupportingFile[] = [];
   714→
   715→  try {
   716→    const entries = await fs.readdir(dirPath, { withFileTypes: true });
   717→
   718→    for (const entry of entries) {
   719→      if (entry.isFile()) {
   720→        const filePath = path.join(dirPath, entry.name);
   721→        try {
   722→          const content = await fs.readFile(filePath, "utf-8");
   723→          files.push({
   724→            name: entry.name,
   725→            path: filePath,
   726→            content,
   727→            dirType,
   728→          });
   729→        } catch {
   730→          // Skip files that can't be read (e.g., binary files)
   731→        }
   732→      }
   733→    }
   734→  } catch {
   735→    // Directory doesn't exist or can't be read - return empty array
   736→  }
   737→
   738→  return files;
   739→}
   740→
   741→/**
   742→ * List which supporting directories exist for a skill.
   743→ * AC: @supporting-files-convention ac-1
   744→ *
   745→ * @returns Array of directory types that exist for the skill
   746→ */
   747→export async function listSkillSupportingDirs(
   748→  ctx: KspecContext,
   749→  skillId: string
   750→): Promise<SupportingDirType[]> {
   751→  const dirs: SupportingDirType[] = [];
   752→  const allDirs: SupportingDirType[] = ["references", "scripts", "assets", "docs"];
   753→
   754→  for (const dirType of allDirs) {
   755→    const dirPath = getSkillSupportingDirPath(ctx, skillId, dirType);
   756→    try {
   757→      const stat = await fs.stat(dirPath);
   758→      if (stat.isDirectory()) {
   759→        dirs.push(dirType);
   760→      }
   761→    } catch {
   762→      // Directory doesn't exist
   763→    }
   764→  }
   765→
   766→  return dirs;
   767→}
   768→
   769→// Re-export the getMetaItemType and isSkill functions
   770→export { getMetaItemType, isSkill };
   771→export type { Agent, Workflow, Convention, Observation, Skill, MetaItem };
   772→
   773→// ============================================================
   774→// GENERIC META ITEM CRUD
   775→// ============================================================
   776→
   777→/**
   778→ * Save any meta item (agent, workflow, convention, skill) to the manifest
   779→ * AC: @skill-parser ac-1 - skill is appended to manifest.skills and written to disk
   780→ * AC: @skill-parser ac-2 - .kspec/skills/<id>/ directory is created for skills
   781→ */
   782→export async function saveMetaItem(
   783→  ctx: KspecContext,
   784→  item: LoadedMetaItem,
   785→  itemType: "agent" | "workflow" | "convention" | "skill",
   786→): Promise<void> {
   787→  const manifestPath = getMetaManifestPath(ctx);
   788→
   789→  // Ensure directory exists
   790→  const dir = path.dirname(manifestPath);
   791→  await fs.mkdir(dir, { recursive: true });
   792→
   793→  // Load existing manifest
   794→  let manifest: MetaManifest = {
   795→    kynetic_meta: "1.0",
   796→    agents: [],
   797→    workflows: [],
   798→    conventions: [],
   799→    observations: [],
   800→    skills: [],
   801→    includes: [],
   802→  };
   803→
   804→  try {
   805→    const raw = await readYamlFile<unknown>(manifestPath);
   806→    const parsed = MetaManifestSchema.safeParse(raw);
   807→    if (parsed.success) {
   808→      manifest = parsed.data;
   809→    }
   810→  } catch {
   811→    // File doesn't exist, use defaults
   812→  }
   813→
   814→  // Strip runtime metadata
   815→  const cleanItem = stripMetaMetadata(item);
   816→
   817→  // Get the appropriate array
   818→  const getArray = () => {
   819→    switch (itemType) {
   820→      case "agent":
   821→        return manifest.agents;
   822→      case "workflow":
   823→        return manifest.workflows;
   824→      case "convention":
   825→        return manifest.conventions;
   826→      case "skill":
   827→        return manifest.skills;
   828→    }
   829→  };
   830→
   831→  const array = getArray();
   832→
   833→  // Update or add
   834→  const existingIndex = array.findIndex((i) => i._ulid === item._ulid);
   835→  if (existingIndex >= 0) {
   836→    (array as unknown[])[existingIndex] = cleanItem;
   837→  } else {
   838→    (array as unknown[]).push(cleanItem);
   839→  }
   840→
   841→  await saveMetaManifest(manifestPath, manifest);
   842→
   843→  // AC: @skill-parser ac-2 - Create skill content directory
   844→  if (itemType === "skill" && "id" in item) {
   845→    const skillDir = path.join(ctx.specDir, "skills", item.id);
   846→    await fs.mkdir(skillDir, { recursive: true });
   847→  }
   848→}
   849→
   850→/**
   851→ * Delete any meta item from the manifest
   852→ * AC: @skill-parser ac-3 - skill is removed from manifest.skills
   853→ * AC: @skill-parser ac-4 - .kspec/skills/<id>/ directory is deleted for skills
   854→ */
   855→export async function deleteMetaItem(
   856→  ctx: KspecContext,
   857→  itemUlid: string,
   858→  itemType: "agent" | "workflow" | "convention" | "observation" | "skill",
   859→): Promise<boolean> {
   860→  const manifestPath = getMetaManifestPath(ctx);
   861→
   862→  try {
   863→    const raw = await readYamlFile<unknown>(manifestPath);
   864→    const parsed = MetaManifestSchema.safeParse(raw);
   865→    if (!parsed.success) {
   866→      return false;
   867→    }
   868→
   869→    const manifest = parsed.data;
   870→
   871→    const getArray = () => {
   872→      switch (itemType) {
   873→        case "agent":
   874→          return manifest.agents;
   875→        case "workflow":
   876→          return manifest.workflows;
   877→        case "convention":
   878→          return manifest.conventions;
   879→        case "observation":
   880→          return manifest.observations;
   881→        case "skill":
   882→          return manifest.skills;
   883→      }
   884→    };
   885→
   886→    const array = getArray();
   887→    const index = array.findIndex((i) => i._ulid === itemUlid);
   888→    if (index < 0) {
   889→      return false;
   890→    }
   891→
   892→    // AC: @skill-parser ac-4 - Delete skill directory before removing from manifest
   893→    if (itemType === "skill") {
   894→      const skill = array[index] as Skill;
   895→      if (skill.id) {
   896→        const skillDir = path.join(ctx.specDir, "skills", skill.id);
   897→        try {
   898→          await fs.rm(skillDir, { recursive: true, force: true });
   899→        } catch {
   900→          // Directory might not exist, that's fine
   901→        }
   902→      }
   903→    }
   904→
   905→    array.splice(index, 1);
   906→    await saveMetaManifest(manifestPath, manifest);
   907→    return true;
   908→  } catch {
   909→    return false;
   910→  }
   911→}
   912→
   913→// ============================================================
   914→// SESSION CONTEXT
   915→// ============================================================
   916→
   917→/**
   918→ * Get the session context file path
   919→ */
   920→export function getSessionContextPath(ctx: KspecContext): string {
   921→  return path.join(ctx.specDir, ".kspec-session");
   922→}
   923→
   924→/**
   925→ * Load session context (or return empty context if not exists)
   926→ */
   927→export async function loadSessionContext(
   928→  ctx: KspecContext,
   929→): Promise<SessionContext> {
   930→  const contextPath = getSessionContextPath(ctx);
   931→
   932→  try {
   933→    const raw = await readYamlFile<unknown>(contextPath);
   934→    if (!raw || typeof raw !== "object") {
   935→      return {
   936→        focus: null,
   937→        threads: [],
   938→        open_questions: [],
   939→        updated_at: new Date().toISOString(),
   940→      };
   941→    }
   942→
   943→    // Validate and parse using schema
   944→    const result = SessionContextSchema.safeParse(raw);
   945→    if (result.success) {
   946→      return result.data;
   947→    }
   948→
   949→    // If validation fails, return empty context
   950→    return {
   951→      focus: null,
   952→      threads: [],
   953→      open_questions: [],
   954→      updated_at: new Date().toISOString(),
   955→    };
   956→  } catch {
   957→    return {
   958→      focus: null,
   959→      threads: [],
   960→      open_questions: [],
   961→      updated_at: new Date().toISOString(),
   962→    };
   963→  }
   964→}
   965→
   966→/**
   967→ * Save session context
   968→ */
   969→export async function saveSessionContext(
   970→  ctx: KspecContext,
   971→  context: SessionContext,
   972→): Promise<void> {
   973→  const contextPath = getSessionContextPath(ctx);
   974→
   975→  // Update timestamp
   976→  context.updated_at = new Date().toISOString();
   977→
   978→  await writeYamlFilePreserveFormat(contextPath, context);
   979→}
   980→
   981→// ============================================================
   982→// WORKFLOW RUNS
   983→// ============================================================
   984→
   985→/**
   986→ * Get the workflow runs file path.
   987→ * Derives from main manifest name (e.g., myproject.yaml -> myproject.runs.yaml)
   988→ */
   989→export function getWorkflowRunsPath(ctx: KspecContext): string {
   990→  const baseName = getManifestBaseName(ctx.manifestPath);
   991→  return path.join(ctx.specDir, `${baseName}.runs.yaml`);
   992→}
   993→
   994→/**
   995→ * Load workflow runs from file
   996→ */
   997→export async function loadWorkflowRuns(
   998→  ctx: KspecContext,
   999→): Promise<WorkflowRun[]> {
  1000→  const runsPath = getWorkflowRunsPath(ctx);
  1001→
  1002→  try {
  1003→    const raw = await readYamlFile<unknown>(runsPath);
  1004→    const parsed = WorkflowRunsFileSchema.safeParse(raw);
  1005→
  1006→    if (!parsed.success) {
  1007→      return [];
  1008→    }
  1009→
  1010→    return parsed.data.runs;
  1011→  } catch {
  1012→    // File doesn't exist
  1013→    return [];
  1014→  }
  1015→}
  1016→
  1017→/**
  1018→ * Save a workflow run (create or update)
  1019→ */
  1020→export async function saveWorkflowRun(
  1021→  ctx: KspecContext,
  1022→  run: WorkflowRun,
  1023→): Promise<void> {
  1024→  const runsPath = getWorkflowRunsPath(ctx);
  1025→
  1026→  // Load existing runs
  1027→  const runs = await loadWorkflowRuns(ctx);
  1028→
  1029→  // Update or add
  1030→  const existingIndex = runs.findIndex((r) => r._ulid === run._ulid);
  1031→  if (existingIndex >= 0) {
  1032→    runs[existingIndex] = run;
  1033→  } else {
  1034→    runs.push(run);
  1035→  }
  1036→
  1037→  // Save back
  1038→  const runsFile: WorkflowRunsFile = {
  1039→    kynetic_runs: "1.0",
  1040→    runs,
  1041→  };
  1042→
  1043→  await writeYamlFilePreserveFormat(runsPath, runsFile);
  1044→}
  1045→
  1046→/**
  1047→ * Update an existing workflow run
  1048→ */
  1049→export async function updateWorkflowRun(
  1050→  ctx: KspecContext,
  1051→  run: WorkflowRun,
  1052→): Promise<void> {
  1053→  await saveWorkflowRun(ctx, run);
  1054→}
  1055→
  1056→/**
  1057→ * Find a workflow run by reference (ULID or ULID prefix)
  1058→ */
  1059→export async function findWorkflowRunByRef(
  1060→  ctx: KspecContext,
  1061→  ref: string,
  1062→): Promise<WorkflowRun | undefined> {
  1063→  const runs = await loadWorkflowRuns(ctx);
  1064→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  1065→
  1066→  return runs.find(
  1067→    (r) =>
  1068→      r._ulid === cleanRef ||
  1069→      r._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
  1070→  );
  1071→}
  1072→
  1073→/**
  1074→ * Find active workflow runs
  1075→ */
  1076→export async function findActiveRuns(
  1077→  ctx: KspecContext,
  1078→): Promise<WorkflowRun[]> {
  1079→  const runs = await loadWorkflowRuns(ctx);
  1080→  return runs.filter((r) => r.status === "active");
  1081→}
  1082→
  1083→/**
  1084→ * Delete workflow runs by ULIDs
  1085→ * AC: @workflow-prune ac-1, ac-2, ac-3, ac-4
  1086→ */
  1087→export async function deleteWorkflowRuns(
  1088→  ctx: KspecContext,
  1089→  ulidsToDelete: string[],
  1090→): Promise<void> {
  1091→  const runsPath = getWorkflowRunsPath(ctx);
  1092→  const runs = await loadWorkflowRuns(ctx);
  1093→
  1094→  // Filter out runs to delete
  1095→  const remainingRuns = runs.filter((r) => !ulidsToDelete.includes(r._ulid));
  1096→
  1097→  // Save back
  1098→  const runsFile: WorkflowRunsFile = {
  1099→    kynetic_runs: "1.0",
  1100→    runs: remainingRuns,
  1101→  };
  1102→
  1103→  await writeYamlFilePreserveFormat(runsPath, runsFile);
  1104→}
