```
     1→/**
     2→ * Skill core installation and update commands.
     3→ *
     4→ * AC: @core-skill-install ac-1 - meta entries created with origin core
     5→ * AC: @core-skill-install ac-2 - content files copied from templates to .kspec/skills/<id>/
     6→ * AC: @core-skill-install ac-3 - custom skills skipped with message
     7→ * AC: @core-skill-install ac-4 - --force overwrites custom forks
     8→ * AC: @core-skill-install ac-5 - version matches kspec package version
     9→ * AC: @core-skill-install ac-6 - marketplace registration in known_marketplaces.json
    10→ * AC: @core-skill-install ac-7 - plugin enabled in project settings
    11→ * AC: @core-skill-install ac-8 - idempotent marketplace registration
    12→ *
    13→ * AC: @core-skill-update ac-1 - skill content and version updated when version differs
    14→ * AC: @core-skill-update ac-2 - skill skipped when already at current version
    15→ * AC: @core-skill-update ac-3 - skills with origin custom/project not touched
    16→ */
    17→
    18→import * as fs from "node:fs/promises";
    19→import * as path from "node:path";
    20→import chalk from "chalk";
    21→import type { Command } from "commander";
    22→import { ulid } from "ulid";
    23→import yaml from "yaml";
    24→import { markMutating } from "../command-annotations.js";
    25→import {
    26→  getSkillContentPath,
    27→  initContext,
    28→  loadMetaContext,
    29→  type LoadedSkill,
    30→  saveMetaItem,
    31→} from "../../parser/index.js";
    32→import { commitIfShadow } from "../../parser/shadow.js";
    33→import { SkillSchema } from "../../schema/index.js";
    34→import { errors } from "../../strings/errors.js";
    35→import { EXIT_CODES } from "../exit-codes.js";
    36→import { error, output, success } from "../output.js";
    37→
    38→// ============================================================================
    39→// Types
    40→// ============================================================================
    41→
    42→/**
    43→ * Result of updating a single core skill
    44→ * AC: @core-skill-update
    45→ */
    46→interface CoreSkillUpdateResult {
    47→  id: string;
    48→  action: "updated" | "skipped";
    49→  previousVersion?: string;
    50→  newVersion?: string;
    51→  currentVersion?: string;
    52→  reason?: string;
    53→}
    54→
    55→/**
    56→ * Result of installing a single core skill
    57→ */
    58→interface CoreSkillInstallResult {
    59→  id: string;
    60→  action: "created" | "updated" | "skipped" | "failed";
    61→  version?: string;
    62→  reason?: string;
    63→}
    64→
    65→/**
    66→ * Core skill definition from manifest
    67→ */
    68→interface CoreSkillDefinition {
    69→  id: string;
    70→  name: string;
    71→  description?: string;
    72→  platforms?: string[];
    73→}
    74→
    75→// ============================================================================
    76→// Template Management Helpers
    77→// ============================================================================
    78→
    79→/**
    80→ * Get the kspec package version from package.json
    81→ * AC: @core-skill-install ac-5
    82→ */
    83→export async function getKspecPackageVersion(): Promise<string | null> {
    84→  try {
    85→    // Try to find package.json relative to this module
    86→    const packagePath = path.resolve(
    87→      import.meta.dirname || path.dirname(new URL(import.meta.url).pathname),
    88→      "../../../package.json"
    89→    );
    90→    const packageJson = JSON.parse(await fs.readFile(packagePath, "utf-8"));
    91→    return packageJson.version || null;
    92→  } catch {
    93→    return null;
    94→  }
    95→}
    96→
    97→/**
    98→ * Get the templates directory path
    99→ */
   100→function getTemplatesDir(): string {
   101→  // Templates are at <package-root>/templates/skills/
   102→  return path.resolve(
   103→    import.meta.dirname || path.dirname(new URL(import.meta.url).pathname),
   104→    "../../../templates/skills"
   105→  );
   106→}
   107→
   108→/**
   109→ * Load core skills manifest from templates/skills/manifest.yaml
   110→ * AC: @core-skill-install ac-1, ac-2
   111→ */
   112→export async function loadCoreSkillsManifest(): Promise<CoreSkillDefinition[]> {
   113→  try {
   114→    const templatesDir = getTemplatesDir();
   115→    const manifestPath = path.join(templatesDir, "manifest.yaml");
   116→    const content = await fs.readFile(manifestPath, "utf-8");
   117→    const parsed = yaml.parse(content);
   118→
   119→    if (!parsed || !Array.isArray(parsed.skills)) {
   120→      return [];
   121→    }
   122→
   123→    return parsed.skills.map((s: Record<string, unknown>) => ({
   124→      id: String(s.id || ""),
   125→      name: String(s.name || s.id || ""),
   126→      description: s.description ? String(s.description) : undefined,
   127→      platforms: Array.isArray(s.platforms) ? s.platforms.map(String) : undefined,
   128→    })).filter((s: CoreSkillDefinition) => s.id);
   129→  } catch {
   130→    return [];
   131→  }
   132→}
   133→
   134→/**
   135→ * Load SKILL.md content for a core skill from templates
   136→ * AC: @core-skill-install ac-2
   137→ */
   138→export async function loadCoreSkillContent(skillId: string): Promise<string | null> {
   139→  try {
   140→    const templatesDir = getTemplatesDir();
   141→    const skillMdPath = path.join(templatesDir, skillId, "SKILL.md");
   142→    return await fs.readFile(skillMdPath, "utf-8");
   143→  } catch {
   144→    return null;
   145→  }
   146→}
   147→
   148→/** Supporting directory names that may accompany a skill template. */
   149→const SKILL_SUPPORTING_DIRS = ["docs", "references", "scripts", "assets"] as const;
   150→
   151→/**
   152→ * Recursively copy a directory tree.
   153→ * Only copies files; creates directories as needed.
   154→ */
   155→async function copyDirRecursive(src: string, dest: string): Promise<void> {
   156→  const entries = await fs.readdir(src, { withFileTypes: true });
   157→  await fs.mkdir(dest, { recursive: true });
   158→  for (const entry of entries) {
   159→    const srcPath = path.join(src, entry.name);
   160→    const destPath = path.join(dest, entry.name);
   161→    if (entry.isDirectory()) {
   162→      await copyDirRecursive(srcPath, destPath);
   163→    } else if (entry.isFile()) {
   164→      await fs.copyFile(srcPath, destPath);
   165→    }
   166→  }
   167→}
   168→
   169→/**
   170→ * Copy all files for a core skill from templates to .kspec/skills/<id>/.
   171→ * Copies SKILL.md and any supporting directories (docs/, references/, etc.).
   172→ * AC: @core-skill-install ac-2
   173→ */
   174→export async function copyCoreSkillFiles(
   175→  skillId: string,
   176→  targetDir: string
   177→): Promise<void> {
   178→  const templatesDir = getTemplatesDir();
   179→  const sourceDir = path.join(templatesDir, skillId);
   180→
   181→  // Copy SKILL.md — skip if template doesn't exist, propagate real errors
   182→  const skillMdPath = path.join(sourceDir, "SKILL.md");
   183→  let content: string;
   184→  try {
   185→    content = await fs.readFile(skillMdPath, "utf-8");
   186→  } catch (err) {
   187→    if (err instanceof Error && "code" in err && (err as NodeJS.ErrnoException).code === "ENOENT") {
   188→      return; // No SKILL.md means nothing to copy
   189→    }
   190→    throw err;
   191→  }
   192→  await fs.mkdir(targetDir, { recursive: true });
   193→  await fs.writeFile(path.join(targetDir, "SKILL.md"), content, "utf-8");
   194→
   195→  // Copy supporting directories recursively
   196→  for (const dirName of SKILL_SUPPORTING_DIRS) {
   197→    const srcSubDir = path.join(sourceDir, dirName);
   198→    try {
   199→      await fs.access(srcSubDir);
   200→    } catch (err) {
   201→      // ENOENT: directory doesn't exist in template, skip
   202→      if (err instanceof Error && "code" in err && (err as NodeJS.ErrnoException).code === "ENOENT") {
   203→        continue;
   204→      }
   205→      throw err; // Propagate real I/O errors
   206→    }
   207→    await copyDirRecursive(srcSubDir, path.join(targetDir, dirName));
   208→  }
   209→}
   210→
   211→// ============================================================================
   212→// Command Registration
   213→// ============================================================================
   214→
   215→/**
   216→ * Register skill install/update commands (install-core, update)
   217→ */
   218→export function registerSkillInstallCommands(skill: Command): void {
   219→  // AC: @core-skill-install - kspec skill install-core
   220→  markMutating(skill.command("install-core"))
   221→    .description(
   222→      "Install core skills from kspec package templates"
   223→    )
   224→    .option("--force", "Overwrite custom forks with core versions")
   225→    .option("--dry-run", "Show what would be installed without making changes")
   226→    .action(async (options) => {
   227→      try {
   228→        const ctx = await initContext();
   229→
   230→        if (!ctx.manifestPath) {
   231→          error(errors.project.noKspecProject);
   232→          console.log(
   233→            chalk.gray("Try: kspec init to initialize a kspec project")
   234→          );
   235→          process.exit(EXIT_CODES.ERROR);
   236→        }
   237→
   238→        const metaCtx = await loadMetaContext(ctx);
   239→        const dryRun = options.dryRun || false;
   240→        const force = options.force || false;
   241→        const results: CoreSkillInstallResult[] = [];
   242→
   243→        // Load core skills manifest
   244→        const coreSkills = await loadCoreSkillsManifest();
   245→        if (coreSkills.length === 0) {
   246→          console.log(chalk.yellow("No core skills found in kspec package templates"));
   247→          return;
   248→        }
   249→
   250→        // Get kspec package version
   251→        // AC: @cross-platform-and-version-robustness ac-3
   252→        const kspecVersion = await getKspecPackageVersion();
   253→        if (!kspecVersion) {
   254→          console.log(chalk.yellow("Warning: Could not determine kspec version — skills installed without version tracking"));
   255→        }
   256→
   257→        // Process each core skill
   258→        for (const coreSkill of coreSkills) {
   259→          // AC: @core-skill-install ac-3 - Check if skill exists with custom origin
   260→          const existingSkill = metaCtx.skills.find((s) => s.id === coreSkill.id);
   261→
   262→          if (existingSkill) {
   263→            // Check origin - if "custom" or "project" and not forcing, skip
   264→            if (existingSkill.origin !== "core" && !force) {
   265→              results.push({
   266→                id: coreSkill.id,
   267→                action: "skipped",
   268→                reason: `existing ${existingSkill.origin} skill (use --force to overwrite)`,
   269→              });
   270→              continue;
   271→            }
   272→          }
   273→
   274→          // AC: @core-skill-install ac-1 - Create/update meta entry with origin core
   275→          // AC: @core-skill-install ac-5 - Version matches kspec package version
   276→          // Schema provides defaults for platforms, depends_on
   277→          const skillData = {
   278→            _ulid: existingSkill?._ulid || ulid(),
   279→            id: coreSkill.id,
   280→            name: coreSkill.name,
   281→            description: coreSkill.description,
   282→            origin: "core",
   283→            ...(kspecVersion && { version: kspecVersion }),
   284→            ...(coreSkill.platforms && { platforms: coreSkill.platforms }),
   285→            allowed_tools: [],
   286→            tags: ["core"],
   287→          };
   288→
   289→          // Validate with schema
   290→          const parsed = SkillSchema.safeParse(skillData);
   291→          if (!parsed.success) {
   292→            const issues = parsed.error.issues
   293→              .map((i) => `${i.path.join(".")}: ${i.message}`)
   294→              .join("; ");
   295→            results.push({
   296→              id: coreSkill.id,
   297→              action: "failed",
   298→              reason: `validation error: ${issues}`,
   299→            });
   300→            continue;
   301→          }
   302→
   303→          const skill: LoadedSkill = { ...parsed.data };
   304→
   305→          // Save meta entry (if not dry run)
   306→          if (!dryRun) {
   307→            await saveMetaItem(ctx, skill, "skill");
   308→
   309→            // AC: @core-skill-install ac-2 - Copy skill files (SKILL.md + supporting dirs)
   310→            const targetDir = path.dirname(getSkillContentPath(ctx, skill.id));
   311→            await copyCoreSkillFiles(coreSkill.id, targetDir);
   312→          }
   313→
   314→          results.push({
   315→            id: coreSkill.id,
   316→            action: existingSkill ? "updated" : "created",
   317→            version: kspecVersion ?? undefined,
   318→          });
   319→        }
   320→
   321→        // Commit changes if not dry run
   322→        if (!dryRun && results.some((r) => r.action === "created" || r.action === "updated")) {
   323→          await commitIfShadow(
   324→            ctx.shadow,
   325→            "skill-install-core",
   326→            `${results.filter((r) => r.action !== "skipped" && r.action !== "failed").length} core skills`
   327→          );
   328→        }
   329→
   330→        // AC: @core-skill-install ac-6, ac-7 - Register marketplace and enable plugin
   331→        const { registerCorePluginMarketplace, enablePluginInProject } = await import(
   332→          "../../lib/claude-plugin-registry.js"
   333→        );
   334→        const marketplaceResult = await registerCorePluginMarketplace({ dryRun });
   335→        const enableResult = await enablePluginInProject(ctx.rootDir, { dryRun });
   336→
   337→        // Output results
   338→        output(
   339→          {
   340→            dry_run: dryRun,
   341→            results,
   342→            marketplace: marketplaceResult,
   343→            pluginEnabled: enableResult,
   344→          },
   345→          () => {
   346→            if (dryRun) {
   347→              console.log(chalk.yellow("DRY RUN - No changes made"));
   348→              console.log();
   349→            }
   350→
   351→            const created = results.filter((r) => r.action === "created");
   352→            const updated = results.filter((r) => r.action === "updated");
   353→            const skipped = results.filter((r) => r.action === "skipped");
   354→            const failed = results.filter((r) => r.action === "failed");
   355→
   356→            if (created.length > 0) {
   357→              console.log(chalk.green(`Created: ${created.length} skill(s)`));
   358→              for (const r of created) {
   359→                console.log(`  ${chalk.green("+")} ${r.id}${r.version ? ` (v${r.version})` : ""}`);
   360→              }
   361→            }
   362→
   363→            if (updated.length > 0) {
   364→              console.log(chalk.blue(`Updated: ${updated.length} skill(s)`));
   365→              for (const r of updated) {
   366→                console.log(`  ${chalk.blue("~")} ${r.id}${r.version ? ` (v${r.version})` : ""}`);
   367→              }
   368→            }
   369→
   370→            if (skipped.length > 0) {
   371→              console.log(chalk.yellow(`Skipped: ${skipped.length} skill(s)`));
   372→              for (const r of skipped) {
   373→                console.log(`  ${chalk.yellow("!")} ${r.id}: ${r.reason}`);
   374→              }
   375→            }
   376→
   377→            if (failed.length > 0) {
   378→              console.log(chalk.red(`Failed: ${failed.length} skill(s)`));
   379→              for (const r of failed) {
   380→                console.log(`  ${chalk.red("x")} ${r.id}: ${r.reason}`);
   381→              }
   382→            }
   383→
   384→            console.log();
   385→            if (dryRun) {
   386→              console.log(
   387→                chalk.yellow("No changes were made. Run without --dry-run to apply.")
   388→              );
   389→            } else {
   390→              const changedCount = created.length + updated.length;
   391→              if (changedCount > 0) {
   392→                success(`Installed ${changedCount} core skill(s)`);
   393→              } else if (skipped.length > 0) {
   394→                console.log(chalk.gray("No skills installed (all skipped or failed)"));
   395→              }
   396→            }
   397→
   398→            // AC: @core-skill-install ac-6 - Report marketplace registration
   399→            if (marketplaceResult.success && marketplaceResult.action !== "skipped") {
   400→              console.log(chalk.green(`Plugin marketplace ${marketplaceResult.action}`));
   401→            } else if (!marketplaceResult.success) {
   402→              console.log(chalk.red(`Marketplace registration failed: ${marketplaceResult.message}`));
   403→            }
   404→
   405→            // AC: @core-skill-install ac-7 - Report plugin enablement
   406→            if (enableResult.success && enableResult.action === "enabled") {
   407→              console.log(chalk.green("Plugin enabled in project settings"));
   408→            } else if (!enableResult.success) {
   409→              console.log(chalk.red(`Plugin enablement failed: ${enableResult.message}`));
   410→            }
   411→          }
   412→        );
   413→
   414→        // Exit non-zero if plugin registration or enablement failed
   415→        if (!marketplaceResult.success || !enableResult.success) {
   416→          process.exit(EXIT_CODES.ERROR);
   417→        }
   418→      } catch (err) {
   419→        error("Failed to install core skills", err);
   420→        process.exit(EXIT_CODES.ERROR);
   421→      }
   422→    });
   423→
   424→  // AC: @core-skill-update - kspec skill update
   425→  markMutating(skill.command("update"))
   426→    .description(
   427→      "Update core skills to match the installed kspec package version"
   428→    )
   429→    .option("--dry-run", "Show what would be updated without making changes")
   430→    .action(async (options) => {
   431→      try {
   432→        const ctx = await initContext();
   433→
   434→        if (!ctx.manifestPath) {
   435→          error(errors.project.noKspecProject);
   436→          console.log(
   437→            chalk.gray("Try: kspec init to initialize a kspec project")
   438→          );
   439→          process.exit(EXIT_CODES.ERROR);
   440→        }
   441→
   442→        const metaCtx = await loadMetaContext(ctx);
   443→        const dryRun = options.dryRun || false;
   444→        const results: CoreSkillUpdateResult[] = [];
   445→
   446→        // Get kspec package version
   447→        // AC: @cross-platform-and-version-robustness ac-3
   448→        const kspecVersion = await getKspecPackageVersion();
   449→        if (!kspecVersion) {
   450→          console.log(chalk.yellow("Warning: Could not determine kspec version — updating based on content changes only"));
   451→        }
   452→
   453→        // Load core skills manifest to get current content
   454→        const coreSkillsManifest = await loadCoreSkillsManifest();
   455→        const coreSkillsMap = new Map(
   456→          coreSkillsManifest.map((s) => [s.id, s])
   457→        );
   458→
   459→        // AC: @core-skill-update ac-3 - Only process skills with origin core
   460→        const coreSkills = metaCtx.skills.filter((s) => s.origin === "core");
   461→
   462→        for (const skill of coreSkills) {
   463→          // AC: @core-skill-update ac-2 - Skip if already at current version
   464→          // If kspecVersion is null or skill has no version, always update
   465→          if (kspecVersion && skill.version === kspecVersion) {
   466→            results.push({
   467→              id: skill.id,
   468→              action: "skipped",
   469→              reason: "already at current version",
   470→              currentVersion: skill.version,
   471→            });
   472→            continue;
   473→          }
   474→
   475→          // Check if skill exists in core manifest
   476→          const coreSkill = coreSkillsMap.get(skill.id);
   477→          if (!coreSkill) {
   478→            results.push({
   479→              id: skill.id,
   480→              action: "skipped",
   481→              reason: "not found in core skills manifest",
   482→              currentVersion: skill.version,
   483→            });
   484→            continue;
   485→          }
   486→
   487→          // AC: @core-skill-update ac-1 - Update content and version
   488→          const oldVersion = skill.version;
   489→
   490→          if (!dryRun) {
   491→            // Clone before mutating to protect against partial save failure
   492→            const updated = structuredClone(skill);
   493→            if (kspecVersion) {
   494→              updated.version = kspecVersion;
   495→            }
   496→            updated.name = coreSkill.name;
   497→            if (coreSkill.description) {
   498→              updated.description = coreSkill.description;
   499→            }
   500→            if (coreSkill.platforms) {
   501→              updated.platforms = coreSkill.platforms;
   502→            }
   503→
   504→            // Save updated metadata
   505→            await saveMetaItem(ctx, updated, "skill");
   506→
   507→            // Update skill files from templates (SKILL.md + supporting dirs)
   508→            const targetDir = path.dirname(getSkillContentPath(ctx, skill.id));
   509→            await copyCoreSkillFiles(skill.id, targetDir);
   510→          }
   511→
   512→          results.push({
   513→            id: skill.id,
   514→            action: "updated",
   515→            previousVersion: oldVersion,
   516→            newVersion: kspecVersion ?? undefined,
   517→          });
   518→        }
   519→
   520→        // Commit changes if not dry run and there are updates
   521→        if (!dryRun && results.some((r) => r.action === "updated")) {
   522→          await commitIfShadow(
   523→            ctx.shadow,
   524→            "skill-update",
   525→            `${results.filter((r) => r.action === "updated").length} core skills`
   526→          );
   527→        }
   528→
   529→        // Output results
   530→        output(
   531→          {
   532→            dry_run: dryRun,
   533→            kspec_version: kspecVersion,
   534→            results,
   535→          },
   536→          () => {
   537→            if (dryRun) {
   538→              console.log(chalk.yellow("DRY RUN - No changes made"));
   539→              console.log();
   540→            }
   541→
   542→            console.log(`kspec version: ${kspecVersion ?? "unavailable"}`);
   543→            console.log();
   544→
   545→            const updated = results.filter((r) => r.action === "updated");
   546→            const skipped = results.filter((r) => r.action === "skipped");
   547→
   548→            if (updated.length > 0) {
   549→              console.log(chalk.green(`Updated: ${updated.length} skill(s)`));
   550→              for (const r of updated) {
   551→                console.log(
   552→                  `  ${chalk.green("~")} ${r.id}: ${r.previousVersion || "unknown"} → ${r.newVersion || "unavailable"}`
   553→                );
   554→              }
   555→            }
   556→
   557→            if (skipped.length > 0) {
   558→              console.log(chalk.gray(`Skipped: ${skipped.length} skill(s)`));
   559→              for (const r of skipped) {
   560→                console.log(
   561→                  `  ${chalk.gray("-")} ${r.id}: ${r.reason}${r.currentVersion ? ` (v${r.currentVersion})` : ""}`
   562→                );
   563→              }
   564→            }
   565→
   566→            console.log();
   567→            if (dryRun) {
   568→              console.log(
   569→                chalk.yellow("No changes were made. Run without --dry-run to apply.")
   570→              );
   571→            } else if (updated.length > 0) {
   572→              success(`Updated ${updated.length} core skill(s)`);
   573→            } else {
   574→              console.log(chalk.gray("No skills needed updating"));
   575→            }
   576→          }
   577→        );
   578→      } catch (err) {
   579→        error("Failed to update core skills", err);
   580→        process.exit(EXIT_CODES.ERROR);
   581→      }
   582→    });
   583→}
