   791→    const specDir = `${tempDir}/.kspec`;
   792→    // Use inbox list (read-only, always succeeds) to verify the env var works
   793→    const result = kspec("inbox list", tempDir, {
   794→      env: { KSPEC_SPEC_DIR: specDir },
   795→    });
   796→    expect(result.exitCode).toBe(0);
   797→  });
   798→});
