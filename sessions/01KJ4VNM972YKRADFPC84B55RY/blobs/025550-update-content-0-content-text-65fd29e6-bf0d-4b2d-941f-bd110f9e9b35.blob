   745→    const taskRef = addResult.task._ulid;
   746→    expect(taskRef).toBeTruthy();
   747→
   748→    // Batch patch with nested data object — this was the bug:
   749→    // the data object got stringified as "[object Object]" instead of JSON
   750→    const patchData = { priority: 2, tags: ["batch-test"] };
   751→    const batchCmd = JSON.stringify([
   752→      {
   753→        command: "task patch",
   754→        args: { ref: `@${taskRef}`, data: patchData },
   755→      },
   756→    ]);
   757→    const result = kspecJson<BatchExecResult>(
