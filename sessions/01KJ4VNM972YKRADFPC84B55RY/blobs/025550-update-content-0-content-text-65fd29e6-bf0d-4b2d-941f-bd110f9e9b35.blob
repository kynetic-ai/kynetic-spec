   610→    // Create an item, then add a note to it (notes don't require a parent ref)
   611→    // Use inbox add for self-contained test — add two items where the second
   612→    // doesn't depend on the first (forward ref is validated at pre-validation)
   613→    const result = kspecJson<BatchExecResult>(
   614→      `batch --commands '[{"command":"inbox add","args":{"text":"fwd-ref-1"}},{"command":"inbox add","args":{"text":"fwd-ref-2"}}]'`,
   615→      tempDir,
