```
     1→/**
     2→ * Tests for the batch execution engine.
     3→ *
     4→ * Unit tests for buildCommandArgv, resetCommandTree, OutputCapture, BatchExitError.
     5→ * Integration tests via CLI helper for atomic/immediate modes.
     6→ */
     7→
     8→import { describe, it, expect, beforeEach, afterEach } from "vitest";
     9→import { Command } from "commander";
    10→import {
    11→  buildCommandArgv,
    12→  resetCommandTree,
    13→} from "../src/cli/batch-exec.js";
    14→import {
    15→  BatchExitError,
    16→  OutputCapture,
    17→  installExitInterceptor,
    18→  uninstallExitInterceptor,
    19→  setBatchMode,
    20→  isBatchMode,
    21→} from "../src/cli/batch-context.js";
    22→import { extractCommandTree } from "../src/cli/introspection.js";
    23→import type { CommandMeta } from "../src/cli/introspection.js";
    24→import { markMutating } from "../src/cli/command-annotations.js";
    25→import {
    26→  kspec,
    27→  kspecJson,
    28→  setupTempFixtures,
    29→  cleanupTempDir,
    30→  initGitRepo,
    31→} from "./helpers/cli.js";
    32→import type { BatchExecResult, BatchCommandResult } from "../src/schema/batch.js";
    33→
    34→// ── Test Program for Unit Tests ──────────────────────────────────────
    35→
    36→function createTestProgram(): Command {
    37→  const program = new Command("kspec");
    38→  const task = program.command("task").description("Task management");
    39→  markMutating(
    40→    task.command("add")
    41→      .description("Add a task")
    42→      .requiredOption("--title <title>", "Task title")
    43→      .option("--spec-ref <ref>", "Spec reference")
    44→      .option("--priority <n>", "Priority level")
    45→      .option("--force", "Skip confirmation"),
    46→  );
    47→  markMutating(
    48→    task.command("start")
    49→      .description("Start a task")
    50→      .argument("<ref>", "Task reference"),
    51→  );
    52→  markMutating(
    53→    task.command("note")
    54→      .description("Add a note")
    55→      .argument("<ref>", "Task reference")
    56→      .argument("<content>", "Note content"),
    57→  );
    58→  markMutating(
    59→    task.command("patch")
    60→      .description("Patch a task")
    61→      .argument("<ref>", "Task reference")
    62→      .option("--data <json>", "JSON object with fields to update"),
    63→  );
    64→
    65→  const inbox = program.command("inbox").description("Inbox");
    66→  markMutating(
    67→    inbox.command("add")
    68→      .description("Add inbox item")
    69→      .argument("<text>", "Idea text")
    70→      .option("--tag <tag...>", "Tags"),
    71→  );
    72→
    73→  program.command("validate").description("Validate spec files");
    74→
    75→  return program;
    76→}
    77→
    78→function getTestTree(): CommandMeta {
    79→  return extractCommandTree(createTestProgram());
    80→}
    81→
    82→// ── Unit Tests: buildCommandArgv ─────────────────────────────────────
    83→
    84→describe("buildCommandArgv", () => {
    85→  const tree = getTestTree();
    86→
    87→  // AC: @batch-exec ac-confirmation-suppressed
    88→  it("maps positional args correctly", () => {
    89→    const cmdMeta = tree.subcommands
    90→      .find((c) => c.name === "inbox")!
    91→      .subcommands.find((c) => c.name === "add")!;
    92→    const argv = buildCommandArgv(
    93→      { command: "inbox add", args: { text: "hello world" } },
    94→      cmdMeta,
    95→    );
    96→    expect(argv).toEqual(["inbox", "add", "hello world"]);
    97→  });
    98→
    99→  it("maps option args correctly", () => {
   100→    const cmdMeta = tree.subcommands
   101→      .find((c) => c.name === "task")!
   102→      .subcommands.find((c) => c.name === "add")!;
   103→    const argv = buildCommandArgv(
   104→      { command: "task add", args: { title: "My Task", priority: "2" } },
   105→      cmdMeta,
   106→    );
   107→    expect(argv).toContain("--title");
   108→    expect(argv).toContain("My Task");
   109→    expect(argv).toContain("--priority");
   110→    expect(argv).toContain("2");
   111→  });
   112→
   113→  it("handles boolean options (true)", () => {
   114→    const cmdMeta = tree.subcommands
   115→      .find((c) => c.name === "task")!
   116→      .subcommands.find((c) => c.name === "add")!;
   117→    const argv = buildCommandArgv(
   118→      { command: "task add", args: { title: "T", force: true } },
   119→      cmdMeta,
   120→    );
   121→    expect(argv).toContain("--force");
   122→  });
   123→
   124→  it("handles boolean options (false = omitted)", () => {
   125→    const cmdMeta = tree.subcommands
   126→      .find((c) => c.name === "task")!
   127→      .subcommands.find((c) => c.name === "add")!;
   128→    const argv = buildCommandArgv(
   129→      { command: "task add", args: { title: "T", force: false } },
   130→      cmdMeta,
   131→    );
   132→    expect(argv).not.toContain("--force");
   133→  });
   134→
   135→  it("handles array options (variadic/repeated)", () => {
   136→    const cmdMeta = tree.subcommands
   137→      .find((c) => c.name === "inbox")!
   138→      .subcommands.find((c) => c.name === "add")!;
   139→    const argv = buildCommandArgv(
   140→      { command: "inbox add", args: { text: "idea", tag: ["a", "b"] } },
   141→      cmdMeta,
   142→    );
   143→    // Should produce: inbox add idea --tag a --tag b
   144→    expect(argv).toContain("idea");
   145→    const tagIndices = argv
   146→      .map((v, i) => (v === "--tag" ? i : -1))
   147→      .filter((i) => i >= 0);
   148→    expect(tagIndices.length).toBe(2);
   149→    expect(argv[tagIndices[0] + 1]).toBe("a");
   150→    expect(argv[tagIndices[1] + 1]).toBe("b");
   151→  });
   152→
   153→  it("handles camelCase args", () => {
   154→    const cmdMeta = tree.subcommands
   155→      .find((c) => c.name === "task")!
   156→      .subcommands.find((c) => c.name === "add")!;
   157→    const argv = buildCommandArgv(
   158→      { command: "task add", args: { title: "T", specRef: "ref1" } },
   159→      cmdMeta,
   160→    );
   161→    expect(argv).toContain("--spec-ref");
   162→    expect(argv).toContain("ref1");
   163→  });
   164→
   165→  it("handles multiple positional args", () => {
   166→    const cmdMeta = tree.subcommands
   167→      .find((c) => c.name === "task")!
   168→      .subcommands.find((c) => c.name === "note")!;
   169→    const argv = buildCommandArgv(
   170→      { command: "task note", args: { ref: "@task1", content: "my note" } },
   171→      cmdMeta,
   172→    );
   173→    expect(argv).toContain("@task1");
   174→    expect(argv).toContain("my note");
   175→  });
   176→
   177→  // AC: @batch-exec ac-stdin
   178→  it("JSON-stringifies nested object values for --data flag", () => {
   179→    const cmdMeta = tree.subcommands
   180→      .find((c) => c.name === "task")!
   181→      .subcommands.find((c) => c.name === "patch")!;
   182→    const dataObj = { status: "completed", priority: 2 };
   183→    const argv = buildCommandArgv(
   184→      { command: "task patch", args: { ref: "@task1", data: dataObj } },
   185→      cmdMeta,
   186→    );
   187→    expect(argv).toContain("--data");
   188→    const dataIdx = argv.indexOf("--data");
   189→    const dataValue = argv[dataIdx + 1];
   190→    // Must be valid JSON, not "[object Object]"
   191→    expect(dataValue).toBe(JSON.stringify(dataObj));
   192→    expect(JSON.parse(dataValue)).toEqual(dataObj);
   193→  });
   194→
   195→  it("JSON-stringifies deeply nested objects", () => {
   196→    const cmdMeta = tree.subcommands
   197→      .find((c) => c.name === "task")!
   198→      .subcommands.find((c) => c.name === "patch")!;
   199→    const dataObj = { meta: { tags: ["a", "b"], nested: { deep: true } } };
   200→    const argv = buildCommandArgv(
   201→      { command: "task patch", args: { ref: "@t1", data: dataObj } },
   202→      cmdMeta,
   203→    );
   204→    const dataIdx = argv.indexOf("--data");
   205→    expect(JSON.parse(argv[dataIdx + 1])).toEqual(dataObj);
   206→  });
   207→
   208→  it("does not double-stringify string values", () => {
   209→    const cmdMeta = tree.subcommands
   210→      .find((c) => c.name === "task")!
   211→      .subcommands.find((c) => c.name === "patch")!;
   212→    const argv = buildCommandArgv(
   213→      { command: "task patch", args: { ref: "@t1", data: '{"already":"json"}' } },
   214→      cmdMeta,
   215→    );
   216→    const dataIdx = argv.indexOf("--data");
   217→    // String values should pass through as-is
   218→    expect(argv[dataIdx + 1]).toBe('{"already":"json"}');
   219→  });
   220→
   221→  it("emits positional args in definition order, not JSON key order", () => {
   222→    const cmdMeta = tree.subcommands
   223→      .find((c) => c.name === "task")!
   224→      .subcommands.find((c) => c.name === "note")!;
   225→    // Pass keys in reverse order — content before ref
   226→    const argv = buildCommandArgv(
   227→      { command: "task note", args: { content: "my note", ref: "@task1" } },
   228→      cmdMeta,
   229→    );
   230→    // Positional args should be: ref first, then content (Commander definition order)
   231→    const positionalStart = 2; // after "task" and "note"
   232→    expect(argv[positionalStart]).toBe("@task1");
   233→    expect(argv[positionalStart + 1]).toBe("my note");
   234→  });
   235→});
   236→
   237→// ── Unit Tests: resetCommandTree ─────────────────────────────────────
   238→
   239→describe("resetCommandTree", () => {
   240→  it("clears option values across command tree", () => {
   241→    const program = createTestProgram();
   242→    // Simulate Commander setting values
   243→    (program as any)._optionValues = { json: true };
   244→    const taskCmd = program.commands.find((c) => c.name() === "task")!;
   245→    (taskCmd as any)._optionValues = { debug: true };
   246→
   247→    resetCommandTree(program);
   248→
   249→    expect((program as any)._optionValues).toEqual({});
   250→    expect((taskCmd as any)._optionValues).toEqual({});
   251→  });
   252→
   253→  it("clears processedArgs", () => {
   254→    const program = createTestProgram();
   255→    (program as any).processedArgs = ["foo", "bar"];
   256→
   257→    resetCommandTree(program);
   258→
   259→    expect((program as any).processedArgs).toEqual([]);
   260→  });
   261→});
   262→
   263→// ── Unit Tests: OutputCapture ────────────────────────────────────────
   264→
   265→describe("OutputCapture", () => {
   266→  it("captures console.log output", () => {
   267→    const capture = new OutputCapture();
   268→    const origLog = console.log;
   269→    capture.start();
   270→    console.log("hello");
   271→    console.log("world");
   272→    capture.stop();
   273→
   274→    expect(capture.getOutput()).toBe("hello\nworld");
   275→    expect(console.log).toBe(origLog);
   276→  });
   277→
   278→  it("captures console.error output", () => {
   279→    const capture = new OutputCapture();
   280→    const origError = console.error;
   281→    capture.start();
   282→    console.error("error msg");
   283→    capture.stop();
   284→
   285→    expect(capture.getOutput()).toBe("error msg");
   286→    expect(console.error).toBe(origError);
   287→  });
   288→
   289→  it("captures console.warn output", () => {
   290→    const capture = new OutputCapture();
   291→    const origWarn = console.warn;
   292→    capture.start();
   293→    console.warn("warning");
   294→    capture.stop();
   295→
   296→    expect(capture.getOutput()).toBe("warning");
   297→    expect(console.warn).toBe(origWarn);
   298→  });
   299→
   300→  it("handles non-string args via JSON.stringify", () => {
   301→    const capture = new OutputCapture();
   302→    capture.start();
   303→    console.log({ key: "val" });
   304→    capture.stop();
   305→
   306→    expect(capture.getOutput()).toBe('{"key":"val"}');
   307→  });
   308→
   309→  it("restores original methods on stop", () => {
   310→    const origLog = console.log;
   311→    const origError = console.error;
   312→    const origWarn = console.warn;
   313→
   314→    const capture = new OutputCapture();
   315→    capture.start();
   316→    capture.stop();
   317→
   318→    expect(console.log).toBe(origLog);
   319→    expect(console.error).toBe(origError);
   320→    expect(console.warn).toBe(origWarn);
   321→  });
   322→});
   323→
   324→// ── Unit Tests: BatchExitError + Exit Interceptor ────────────────────
   325→
   326→describe("BatchExitError", () => {
   327→  it("stores exit code", () => {
   328→    const err = new BatchExitError(1);
   329→    expect(err.code).toBe(1);
   330→    expect(err.name).toBe("BatchExitError");
   331→  });
   332→
   333→  it("stores exit code 0", () => {
   334→    const err = new BatchExitError(0);
   335→    expect(err.code).toBe(0);
   336→  });
   337→});
   338→
   339→describe("exit interceptor", () => {
   340→  afterEach(() => {
   341→    uninstallExitInterceptor();
   342→  });
   343→
   344→  it("throws BatchExitError on process.exit", () => {
   345→    installExitInterceptor();
   346→    expect(() => process.exit(1)).toThrow(BatchExitError);
   347→  });
   348→
   349→  it("captures exit code", () => {
   350→    installExitInterceptor();
   351→    try {
   352→      process.exit(42);
   353→    } catch (err) {
   354→      expect(err).toBeInstanceOf(BatchExitError);
   355→      expect((err as BatchExitError).code).toBe(42);
   356→    }
   357→  });
   358→
   359→  it("restores original process.exit", () => {
   360→    const origExit = process.exit;
   361→    installExitInterceptor();
   362→    uninstallExitInterceptor();
   363→    expect(process.exit).toBe(origExit);
   364→  });
   365→});
   366→
   367→// ── Unit Tests: Batch Mode Flag ──────────────────────────────────────
   368→
   369→describe("batchMode flag", () => {
   370→  afterEach(() => {
   371→    setBatchMode(false);
   372→  });
   373→
   374→  it("defaults to false", () => {
   375→    expect(isBatchMode()).toBe(false);
   376→  });
   377→
   378→  it("can be set and cleared", () => {
   379→    setBatchMode(true);
   380→    expect(isBatchMode()).toBe(true);
   381→    setBatchMode(false);
   382→    expect(isBatchMode()).toBe(false);
   383→  });
   384→});
   385→
   386→// ── Integration Tests ────────────────────────────────────────────────
   387→// Uses the real CLI via kspec() helper with temp fixtures.
   388→
   389→describe("batch command integration", () => {
   390→  let tempDir: string;
   391→
   392→  beforeEach(async () => {
   393→    tempDir = await setupTempFixtures();
   394→    initGitRepo(tempDir);
   395→    // Initialize kspec with shadow branch
   396→    kspec("init --no-prompt", tempDir);
   397→  });
   398→
   399→  afterEach(async () => {
   400→    await cleanupTempDir(tempDir);
   401→  });
   402→
   403→  // AC: @batch-exec ac-dry-run
   404→  it("--dry-run validates without executing", () => {
   405→    const result = kspecJson<BatchExecResult>(
   406→      `batch --dry-run --commands '[{"command":"inbox add","args":{"text":"test"}}]'`,
   407→      tempDir,
   408→    );
   409→    expect(result.success).toBe(true);
   410→    expect(result.mode).toBe("atomic");
   411→    expect(result.summary.succeeded).toBe(1);
   412→    expect(result.results[0].output).toBe("dry-run: would execute");
   413→
   414→    // Verify nothing was actually created
   415→    const inbox = kspec("inbox list", tempDir);
   416→    expect(inbox.stdout).not.toContain("test");
   417→  });
   418→
   419→  // AC: @batch-exec ac-prevalidate
   420→  it("pre-validates and rejects before any execution", () => {
   421→    const result = kspecJson<BatchExecResult>(
   422→      `batch --commands '[{"command":"inbox add","args":{"text":"ok"}},{"command":"nonexistent cmd","args":{}}]'`,
   423→      tempDir,
   424→      { expectFail: true },
   425→    );
   426→    expect(result.success).toBe(false);
   427→
   428→    // Nothing should have executed
   429→    const inbox = kspec("inbox list", tempDir);
   430→    expect(inbox.stdout).not.toContain("ok");
   431→  });
   432→
   433→  // AC: @batch-exec ac-mutating-only
   434→  it("rejects read-only commands", () => {
   435→    const result = kspecJson<BatchExecResult>(
   436→      `batch --commands '[{"command":"inbox list","args":{}}]'`,
   437→      tempDir,
   438→      { expectFail: true },
   439→    );
   440→    expect(result.success).toBe(false);
   441→    expect(result.results[0].error).toContain("not allowed in batch mode");
   442→  });
   443→
   444→  // AC: @batch-exec ac-invalid-json
   445→  it("rejects malformed JSON", () => {
   446→    const result = kspec(
   447→      `batch --commands 'not valid json'`,
   448→      tempDir,
   449→      { expectFail: true },
   450→    );
   451→    expect(result.exitCode).not.toBe(0);
   452→  });
   453→
   454→  // AC: @batch-exec ac-empty-batch
   455→  it("rejects empty batch", () => {
   456→    const result = kspec(
   457→      `batch --commands '[]'`,
   458→      tempDir,
   459→      { expectFail: true },
   460→    );
   461→    expect(result.exitCode).not.toBe(0);
   462→  });
   463→
   464→  // AC: @batch-exec ac-stdin — stdin tested via parseBatchInput in batch-schema.test.ts
   465→  // AC: @batch-exec ac-inline
   466→  it("accepts inline JSON commands", () => {
   467→    const result = kspecJson<BatchExecResult>(
   468→      `batch --commands '[{"command":"inbox add","args":{"text":"inline-test"}}]'`,
   469→      tempDir,
   470→    );
   471→    expect(result.success).toBe(true);
   472→    expect(result.mode).toBe("atomic");
   473→    expect(result.summary.succeeded).toBe(1);
   474→  });
   475→
   476→  // AC: @batch-exec ac-file
   477→  it("accepts file input", async () => {
   478→    const { writeFile } = await import("node:fs/promises");
   479→    const { join } = await import("node:path");
   480→    const cmdFile = join(tempDir, "cmds.json");
   481→    await writeFile(cmdFile, JSON.stringify([
   482→      { command: "inbox add", args: { text: "file-test" } },
   483→    ]));
   484→    const result = kspecJson<BatchExecResult>(
   485→      `batch --file ${cmdFile}`,
   486→      tempDir,
   487→    );
   488→    expect(result.success).toBe(true);
   489→    expect(result.summary.succeeded).toBe(1);
   490→  });
   491→
   492→  // AC: @batch-exec ac-default-atomic
   493→  // AC: @batch-exec ac-single-commit
   494→  // AC: @batch-exec ac-atomic-isolation
   495→  it("atomic mode: all succeed → single commit, changes visible", () => {
   496→    const result = kspecJson<BatchExecResult>(
   497→      `batch --commands '[{"command":"inbox add","args":{"text":"atomic-1"}},{"command":"inbox add","args":{"text":"atomic-2"}}]'`,
   498→      tempDir,
   499→    );
   500→    expect(result.success).toBe(true);
   501→    expect(result.mode).toBe("atomic");
   502→    expect(result.summary.succeeded).toBe(2);
   503→
   504→    // Verify both items were created
   505→    const inbox = kspec("inbox list", tempDir);
   506→    expect(inbox.stdout).toContain("atomic-1");
   507→    expect(inbox.stdout).toContain("atomic-2");
   508→  });
   509→
   510→  // AC: @batch-exec ac-atomic-rollback
   511→  it("atomic mode: failure → all changes rolled back", () => {
   512→    const result = kspecJson<BatchExecResult>(
   513→      `batch --commands '[{"command":"inbox add","args":{"text":"should-not-persist"}},{"command":"task start","args":{"ref":"@nonexistent-task"}}]'`,
   514→      tempDir,
   515→      { expectFail: true },
   516→    );
   517→    expect(result.success).toBe(false);
   518→    expect(result.mode).toBe("atomic");
   519→    expect(result.summary.succeeded).toBe(1);
   520→    expect(result.summary.failed).toBe(1);
   521→
   522→    // Verify the inbox item was rolled back
   523→    const inbox = kspec("inbox list", tempDir);
   524→    expect(inbox.stdout).not.toContain("should-not-persist");
   525→  });
   526→
   527→  // AC: @batch-exec ac-no-atomic-flag
   528→  // AC: @batch-exec ac-immediate-per-commit
   529→  it("immediate mode: per-command execution", () => {
   530→    const result = kspecJson<BatchExecResult>(
   531→      `batch --no-atomic --commands '[{"command":"inbox add","args":{"text":"immediate-1"}},{"command":"inbox add","args":{"text":"immediate-2"}}]'`,
   532→      tempDir,
   533→    );
   534→    expect(result.success).toBe(true);
   535→    expect(result.mode).toBe("immediate");
   536→    expect(result.summary.succeeded).toBe(2);
   537→
   538→    // Verify items exist
   539→    const inbox = kspec("inbox list", tempDir);
   540→    expect(inbox.stdout).toContain("immediate-1");
   541→    expect(inbox.stdout).toContain("immediate-2");
   542→  });
   543→
   544→  // AC: @batch-exec ac-immediate-no-rollback
   545→  it("immediate mode: failure stops execution, prior commands persist", () => {
   546→    const result = kspecJson<BatchExecResult>(
   547→      `batch --no-atomic --commands '[{"command":"inbox add","args":{"text":"persist-this"}},{"command":"task start","args":{"ref":"@bad-ref"}},{"command":"inbox add","args":{"text":"not-reached"}}]'`,
   548→      tempDir,
   549→      { expectFail: true },
   550→    );
   551→    expect(result.success).toBe(false);
   552→    expect(result.mode).toBe("immediate");
   553→    expect(result.results[0].success).toBe(true);
   554→    expect(result.results[1].success).toBe(false);
   555→    expect(result.results[2].success).toBe(false);
   556→    expect(result.results[2].error).toContain("Not executed");
   557→
   558→    // First command persisted (no rollback in immediate mode)
   559→    const inbox = kspec("inbox list", tempDir);
   560→    expect(inbox.stdout).toContain("persist-this");
   561→    expect(inbox.stdout).not.toContain("not-reached");
   562→  });
   563→
   564→  // AC: @batch-exec ac-continue
   565→  // AC: @batch-exec ac-continue-implies-immediate
   566→  // AC: @batch-exec ac-partial-commit
   567→  it("--continue: continues through failures, implies immediate mode", () => {
   568→    const result = kspecJson<BatchExecResult>(
   569→      `batch --continue --commands '[{"command":"inbox add","args":{"text":"cont-1"}},{"command":"task start","args":{"ref":"@bad"}},{"command":"inbox add","args":{"text":"cont-3"}}]'`,
   570→      tempDir,
   571→      { expectFail: true },
   572→    );
   573→    expect(result.success).toBe(false);
   574→    expect(result.mode).toBe("immediate");
   575→    expect(result.summary.succeeded).toBe(2);
   576→    expect(result.summary.failed).toBe(1);
   577→
   578→    // Commands 1 and 3 succeeded
   579→    expect(result.results[0].success).toBe(true);
   580→    expect(result.results[1].success).toBe(false);
   581→    expect(result.results[2].success).toBe(true);
   582→
   583→    // Both successful items persisted
   584→    const inbox = kspec("inbox list", tempDir);
   585→    expect(inbox.stdout).toContain("cont-1");
   586→    expect(inbox.stdout).toContain("cont-3");
   587→  });
   588→
   589→  // AC: @batch-exec ac-json-mode-field
