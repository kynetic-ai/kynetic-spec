   761→    expect(result.success).toBe(true);
   762→    expect(result.summary.succeeded).toBe(1);
   763→
   764→    // Verify the patch was applied correctly
   765→    const taskData = kspecJson<{ priority: number; tags: string[] }>(
   766→      `task get @${taskRef}`,
   767→      tempDir,
   768→    );
   769→    expect(taskData.priority).toBe(2);
   770→    expect(taskData.tags).toContain("batch-test");
   771→  });
   772→});
