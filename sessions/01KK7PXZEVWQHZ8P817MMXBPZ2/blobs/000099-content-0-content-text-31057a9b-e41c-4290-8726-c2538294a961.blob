     1→import { test, expect } from '../fixtures/test-base';
     2→
     3→/**
     4→ * Task Board (Kanban) E2E Tests
     5→ *
     6→ * Tests for the Kanban-style task board view.
     7→ *
     8→ * Covered ACs:
     9→ * - AC-1: Tasks distributed into columns by status
    10→ * - AC-2: Task cards show priority, tags, title, slug, spec ref, metadata
    11→ * - AC-3: Clicking card opens detail modal with full task info
    12→ * - AC-4: Active Fleet row shows running agents
    13→ * - AC-5: Real-time updates via WebSocket
    14→ * - AC-6: Action buttons in detail modal execute mutations via API
    15→ */
    16→
    17→test.describe('Task Board (Kanban)', () => {
    18→	// AC: @ui-task-board ac-1
    19→	test('renders board with five columns', async ({ page, daemon }) => {
    20→		await page.goto('/tasks/board');
    21→
    22→		// Wait for board to load
    23→		const columns = page.getByTestId('board-column');
    24→		await expect(columns.first()).toBeVisible();
    25→
    26→		// Should have 5 columns: Backlog, Ready, In Progress, Review, Done
    27→		await expect(columns).toHaveCount(5);
    28→	});
    29→
    30→	// AC: @ui-task-board ac-1
    31→	test('distributes tasks into correct columns based on status', async ({ page, daemon }) => {
    32→		await page.goto('/tasks/board');
    33→
    34→		const boardColumns = page.getByTestId('board-columns');
    35→		await expect(boardColumns).toBeVisible();
    36→
    37→		// Verify columns exist by their IDs
    38→		await expect(page.locator('[data-column-id="backlog"]')).toBeVisible();
    39→		await expect(page.locator('[data-column-id="ready"]')).toBeVisible();
    40→		await expect(page.locator('[data-column-id="in_progress"]')).toBeVisible();
    41→		await expect(page.locator('[data-column-id="review"]')).toBeVisible();
    42→		await expect(page.locator('[data-column-id="done"]')).toBeVisible();
    43→	});
    44→
    45→	// AC: @ui-task-board ac-2
    46→	test('task card shows priority badge, tag chips, title, slug, spec ref link, and metadata', async ({
    47→		page,
    48→		daemon
    49→	}) => {
    50→		await page.goto('/tasks/board');
    51→
    52→		// Use 'Ready task' which has tags: [test] and spec_ref: @test-feature
    53→		// It lands in backlog (no automation field = not eligible)
    54→		const backlogColumn = page.locator('[data-column-id="backlog"]');
    55→		await expect(backlogColumn).toBeVisible();
    56→		// Target the specific card by data-task-id for the ready task fixture
    57→		const card = backlogColumn.locator('[data-task-id="01KG0RR6CA45ZT43W2T6HJMVA1"]');
    58→		await expect(card).toBeVisible();
    59→
    60→		// Priority badge
    61→		await expect(card.getByTestId('priority-badge')).toBeVisible();
    62→
    63→		// Title
    64→		await expect(card.getByTestId('task-title')).toBeVisible();
    65→
    66→		// Slug (mono)
    67→		await expect(card.getByTestId('task-slug')).toBeVisible();
    68→
    69→		// Tag chips (fixture has tags: ['test'])
    70→		await expect(card.getByTestId('task-tags')).toBeVisible();
    71→		await expect(card.getByTestId('task-tags')).toContainText('test');
    72→
    73→		// Spec ref link (fixture has spec_ref: '@test-feature')
    74→		await expect(card.getByTestId('spec-ref-link')).toBeVisible();
    75→		await expect(card.getByTestId('spec-ref-link')).toContainText('@test-feature');
    76→
    77→		// Metadata footer (notes count, dependency count, age)
    78→		await expect(card.getByTestId('task-metadata')).toBeVisible();
    79→	});
    80→
    81→	// AC: @ui-task-board ac-3
    82→	test('clicking a task card opens the detail modal', async ({ page, daemon }) => {
    83→		await page.goto('/tasks/board');
    84→
    85→		// Click first task card
