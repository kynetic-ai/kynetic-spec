   389→	// AC: @ui-task-board ac-4
   390→	test('active fleet row shows running agents with title, agent name, elapsed, output, and pulse', async ({
   391→		page,
   392→		daemon
   393→	}) => {
   394→		const mockAgentStatus = {
   395→			dispatch_enabled: true,
   396→			active_invocations: [
   397→				{
   398→					session_id: 'test-session-001',
   399→					agent_id: 'task-worker',
   400→					task_ref: '@01KG0RR8CB8N4YGP991WD7XS9R',
   401→					elapsed_ms: 125000 // 2m 5s
   402→				}
   403→			],
   404→			queue_depth: 0,
   405→			agent_definitions: [
   406→				{ id: 'task-worker', name: 'Task Worker', adapter: 'claude-agent-acp' }
   407→			]
   408→		};
   409→
   410→		await page.route('**/api/agent/status', async (route) => {
   411→			await route.fulfill({
   412→				status: 200,
   413→				contentType: 'application/json',
   414→				body: JSON.stringify(mockAgentStatus)
   415→			});
   416→		});
   417→
   418→		await page.goto('/tasks/board');
   419→		await expect(page.getByTestId('board-columns')).toBeVisible();
   420→
   421→		const fleetRow = page.getByTestId('active-fleet-row');
   422→		await expect(fleetRow).toBeVisible();
   423→
   424→		const fleetCard = page.getByTestId('fleet-card');
