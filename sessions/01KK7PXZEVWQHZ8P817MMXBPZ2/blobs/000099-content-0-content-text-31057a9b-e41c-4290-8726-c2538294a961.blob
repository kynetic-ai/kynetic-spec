   448→	// AC: @ui-task-board ac-4
   449→	test('active fleet row shows last few lines of output from WebSocket', async ({
   450→		page,
   451→		daemon
   452→	}) => {
   453→		const mockAgentStatus = {
   454→			dispatch_enabled: true,
   455→			active_invocations: [
   456→				{
   457→					session_id: 'test-session-002',
   458→					agent_id: 'task-worker',
   459→					task_ref: '@01KG0RR8CB8N4YGP991WD7XS9R',
   460→					elapsed_ms: 30000
   461→				}
   462→			],
   463→			queue_depth: 0,
   464→			agent_definitions: [
   465→				{ id: 'task-worker', name: 'Task Worker', adapter: 'claude-agent-acp' }
   466→			]
   467→		};
   468→
   469→		await page.route('**/api/agent/status', async (route) => {
   470→			await route.fulfill({
   471→				status: 200,
   472→				contentType: 'application/json',
   473→				body: JSON.stringify(mockAgentStatus)
   474→			});
   475→		});
   476→
   477→		// Track WebSocket instances before page navigation
   478→		await page.addInitScript(() => {
   479→			const instances: WebSocket[] = [];
   480→			const OriginalWebSocket = window.WebSocket;
   481→			(window as any).__test_ws_instances = instances;
   482→			window.WebSocket = new Proxy(OriginalWebSocket, {
   483→				construct(target, args) {
   484→					const ws = new target(...(args as [string, ...any[]]));
   485→					instances.push(ws);
   486→					return ws;
   487→				}
   488→			});
   489→		});
   490→
   491→		await page.goto('/tasks/board');
   492→		await expect(page.getByTestId('board-columns')).toBeVisible();
   493→		await expect(page.getByTestId('active-fleet-row')).toBeVisible();
   494→
   495→		// Initially output should show empty placeholder
   496→		await expect(page.getByTestId('fleet-output-empty')).toBeVisible();
   497→		await expect(page.getByTestId('fleet-output-empty')).toHaveText(/Awaiting output/);
   498→
   499→		// Inject a synthetic agent_text_chunk WebSocket message through the live connection
   500→		const injected = await page.evaluate((sessionId) => {
   501→			const instances = (window as any).__test_ws_instances as WebSocket[];
   502→			const ws = instances?.find((s) => s.readyState === WebSocket.OPEN);
   503→			if (!ws) return false;
   504→
   505→			const msg = JSON.stringify({
   506→				msg_id: 'test-output-001',
   507→				seq: 9999,
   508→				timestamp: new Date().toISOString(),
   509→				topic: 'agents',
   510→				event: 'agent_text_chunk',
   511→				data: {
