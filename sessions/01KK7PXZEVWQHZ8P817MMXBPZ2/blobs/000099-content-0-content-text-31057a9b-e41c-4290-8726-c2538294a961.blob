   186→	// AC: @ui-task-board ac-5
   187→	test('board updates after task mutation without page refresh', async ({ page, daemon }) => {
   188→		await page.goto('/tasks/board');
   189→		await expect(page.getByTestId('board-columns')).toBeVisible();
   190→
   191→		// Find a pending task card and note its column
   192→		const backlogColumn = page.locator('[data-column-id="backlog"]');
   193→		await expect(backlogColumn).toBeVisible();
   194→		const taskCards = backlogColumn.getByTestId('task-card');
   195→		const initialBacklogCount = await taskCards.count();
   196→
   197→		// Start a pending task via API directly (simulating external state change)
   198→		// Use the ready task which is in pending status
   199→		const startResponse = await page.request.post(
   200→			`${daemon.baseUrl}/api/tasks/01KG0RR6CA45ZT43W2T6HJMVA1/start`
   201→		);
   202→		expect(startResponse.ok()).toBeTruthy();
   203→
   204→		// Wait for the board to update (WebSocket notification or polling triggers reload)
   205→		// The task should move from backlog to in_progress column
   206→		const inProgressColumn = page.locator('[data-column-id="in_progress"]');
   207→		await expect(async () => {
   208→			const inProgressCards = await inProgressColumn.getByTestId('task-card').count();
   209→			expect(inProgressCards).toBeGreaterThan(0);
   210→		}).toPass({ timeout: 10000 });
   211→	});
