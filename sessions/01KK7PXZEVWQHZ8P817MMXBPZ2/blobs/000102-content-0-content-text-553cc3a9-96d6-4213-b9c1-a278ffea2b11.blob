   291→			await expect(page.getByTestId('status-summary-section')).toBeVisible();
   292→
   293→			// Verify each count card renders the correct number
   294→			await expect(page.getByTestId('task-count-ready')).toContainText('1');
   295→			await expect(page.getByTestId('task-count-in_progress')).toContainText('1');
   296→			await expect(page.getByTestId('task-count-needs_work')).toContainText('0');
   297→			await expect(page.getByTestId('task-count-pending_review')).toContainText('1');
   298→			// Blocked card counts only status=blocked tasks, not dep-blocked pending tasks
   299→			await expect(page.getByTestId('task-count-blocked')).toContainText('0');
   300→			await expect(page.getByTestId('task-count-completed')).toContainText('1');
