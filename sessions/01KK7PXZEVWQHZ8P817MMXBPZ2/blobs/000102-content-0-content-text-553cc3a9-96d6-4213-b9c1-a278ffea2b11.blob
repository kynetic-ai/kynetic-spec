   500→	// AC: @ui-dashboard-overview ac-1 — API contract verification
   501→	// These verify the daemon API returns expected fixture data, independent of UI rendering.
   502→	test.describe('API Contract Verification', () => {
   503→		test('daemon returns task counts matching fixture data', async ({ daemon }) => {
   504→			const response = await fetch(`${daemon.baseUrl}/api/tasks?limit=1000`);
   505→			expect(response.ok).toBe(true);
   506→			const data = await response.json();
   507→
   508→			const tasks = data.items;
   509→			expect(tasks).toBeDefined();
   510→
   511→			const statusCounts: Record<string, number> = {};
   512→			for (const task of tasks) {
   513→				statusCounts[task.status] = (statusCounts[task.status] || 0) + 1;
   514→			}
   515→
   516→			// Fixture has: 2 pending (1 ready, 1 dep-blocked), 1 in_progress, 1 pending_review, 1 completed
   517→			expect(statusCounts['pending']).toBe(2);
   518→			expect(statusCounts['in_progress']).toBe(1);
   519→			expect(statusCounts['pending_review']).toBe(1);
   520→			expect(statusCounts['completed']).toBe(1);
   521→		});
   522→
