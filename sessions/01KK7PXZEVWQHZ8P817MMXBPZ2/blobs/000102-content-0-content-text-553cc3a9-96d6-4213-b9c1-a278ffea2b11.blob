   284→		// AC: @ui-dashboard-overview ac-1 — Validates UI renders correct aggregated counts
   285→		// AC: @web-dashboard ac-1
   286→		// Fixture: 2 pending (1 ready, 1 dep-blocked), 1 in_progress, 1 pending_review, 1 completed
   287→		// Expected: ready=1, in_progress=1, pending_review=1, blocked=0, completed=1
   288→		test('renders correct aggregated counts from task data', async ({ page }) => {
   289→			await interceptDashboardAPIs(page);
