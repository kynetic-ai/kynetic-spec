   207→  test.describe('Task Detail', () => {
   208→    // AC: @web-dashboard ac-5
   209→    test('opens detail panel when task clicked', async ({ page, daemon }) => {
   210→      // Capture console logs
   211→      const consoleLogs: string[] = [];
   212→      page.on('console', (msg) => {
   213→        consoleLogs.push(`${msg.type()}: ${msg.text()}`);
   214→      });
   215→
   216→      // Capture network requests
   217→      const apiCalls: string[] = [];
   218→      page.on('request', (request) => {
   219→        if (request.url().includes('/api/')) {
   220→          apiCalls.push(`${request.method()} ${request.url()}`);
   221→        }
   222→      });
   223→      page.on('response', (response) => {
   224→        if (response.url().includes('/api/')) {
   225→          apiCalls.push(`-> ${response.status()} ${response.url()}`);
   226→        }
   227→      });
   228→
   229→      await page.goto('/tasks');
   230→
   231→      // Wait for task list to load
   232→      const taskList = page.getByTestId('task-list');
   233→      await expect(taskList).toBeVisible();
   234→
   235→      // Wait for tasks to appear
   236→      const taskItem = page.getByTestId('task-list-item').first();
   237→      await expect(taskItem).toBeVisible();
   238→
   239→
   240→      // Click the first task
   241→      await taskItem.click();
   242→
   243→      // Wait briefly for API call and dialog animation
   244→      await page.waitForTimeout(2000);
   245→
   246→      // Debug output
   247→      console.log('=== Console logs ===');
   248→      consoleLogs.forEach(log => console.log(log));
   249→      console.log('=== API calls ===');
   250→      apiCalls.forEach(call => console.log(call));
   251→
   252→      // Detail panel should open
   253→      const detailPanel = page.getByTestId('task-detail-panel');
   254→      await expect(detailPanel).toBeVisible({ timeout: 5000 });
   255→
   256→      // Verify panel contains expected sections (title is in Dialog.Header)
   257→      await expect(detailPanel.getByTestId('task-detail-title')).toBeVisible();
   258→      await expect(detailPanel.getByTestId('task-notes')).toBeVisible();
   259→    });
   260→
   261→    // AC: @web-dashboard ac-5
   262→    test('displays notes in chronological order', async ({ page, daemon }) => {
   263→      await page.goto('/tasks');
   264→
   265→      // Click task to open detail
   266→      const taskItem = page.getByTestId('task-list-item').first();
   267→      await taskItem.click();
   268→
   269→      // Get notes section
   270→      const notesSection = page.getByTestId('task-notes');
   271→      await expect(notesSection).toBeVisible();
   272→
   273→      // Notes should be ordered by timestamp
   274→      const noteItems = notesSection.getByTestId('note-item');
   275→      const count = await noteItems.count();
   276→
   277→      if (count > 1) {
   278→        // Check first note timestamp is earlier than last note timestamp
   279→        const firstNoteTime = await noteItems.first().getByTestId('note-timestamp').textContent();
   280→        const lastNoteTime = await noteItems.last().getByTestId('note-timestamp').textContent();
   281→        // Both should be present (chronological order validation)
   282→        expect(firstNoteTime).toBeTruthy();
   283→        expect(lastNoteTime).toBeTruthy();
   284→      }
   285→    });
