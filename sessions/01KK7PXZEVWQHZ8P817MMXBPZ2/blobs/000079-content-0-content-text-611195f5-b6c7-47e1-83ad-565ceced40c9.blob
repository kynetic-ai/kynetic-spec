   336→  test.describe('Task Actions', () => {
   337→    // AC: @web-dashboard ac-7
   338→    test('starts a pending task', async ({ page, daemon }) => {
   339→      await page.goto('/tasks?status=pending');
   340→
   341→      // Click pending task to open detail
   342→      const taskItem = page.getByTestId('task-list-item').first();
   343→      await taskItem.click();
   344→
   345→      const detailPanel = page.getByTestId('task-detail-panel');
   346→      const startButton = detailPanel.getByTestId('action-start');
   347→      await expect(startButton).toBeVisible();
   348→
   349→      // Set up request interception to verify API call
   350→      const requestPromise = page.waitForRequest((request) => {
   351→        return request.url().includes('/api/tasks/') && request.url().includes('/start');
   352→      });
   353→
   354→      // Click start button
   355→      await startButton.click();
   356→
   357→      // Verify API request was made
   358→      const request = await requestPromise;
   359→      expect(request.method()).toBe('POST');
   360→
   361→      // Status badge should update to "pending"
   362→      const statusBadge = detailPanel.getByTestId('task-status-badge');
   363→      await expect(statusBadge).toContainText(/pending/i);
   364→    });
   365→
   366→    // AC: @web-dashboard ac-8
   367→    test('adds note to task', async ({ page, daemon }) => {
   368→      await page.goto('/tasks');
   369→
   370→      // Open task detail
   371→      const taskItem = page.getByTestId('task-list-item').first();
   372→      await taskItem.click();
   373→
   374→      const detailPanel = page.getByTestId('task-detail-panel');
   375→      const addNoteForm = detailPanel.getByTestId('task-add-note');
   376→      await expect(addNoteForm).toBeVisible();
   377→
   378→      // Type note content
   379→      const noteTextarea = addNoteForm.locator('textarea');
   380→      const noteContent = 'Test note added via E2E test';
   381→      await noteTextarea.fill(noteContent);
   382→
   383→      // Set up request interception
   384→      const requestPromise = page.waitForRequest((request) => {
   385→        return request.url().includes('/api/tasks/') && request.url().includes('/note');
   386→      });
   387→
   388→      // Submit note
   389→      const submitButton = addNoteForm.getByTestId('action-add-note');
   390→      await submitButton.click();
   391→
   392→      // Verify API request
   393→      const request = await requestPromise;
   394→      expect(request.method()).toBe('POST');
   395→
   396→      // Note should appear in notes list
   397→      const notesSection = detailPanel.getByTestId('task-notes');
   398→      await expect(notesSection).toContainText(noteContent);
   399→
   400→      // Textarea should be cleared
   401→      await expect(noteTextarea).toHaveValue('');
   402→    });
