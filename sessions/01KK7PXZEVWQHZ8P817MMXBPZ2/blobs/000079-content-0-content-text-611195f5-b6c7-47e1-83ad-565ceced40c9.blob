   164→    // AC: @web-dashboard ac-10
   165→    test('URL updates with filter query params', async ({ page, daemon }) => {
   166→      await page.goto('/tasks');
   167→
   168→      // Apply status filter
   169→      const filterStatus = page.getByTestId('filter-status');
   170→      await filterStatus.click();
   171→      await page.getByRole('option', { name: 'Pending', exact: true }).click();
   172→
   173→      // Wait for URL to update
   174→      await page.waitForURL(/\/tasks\?.*status=pending/);
   175→      expect(page.url()).toContain('status=pending');
   176→
   177→      // Apply tag filter (text input, not select)
   178→      const filterTag = page.getByTestId('filter-tag');
   179→      await filterTag.fill('e2e');
   180→
   181→      // URL should now include both filters
   182→      await page.waitForURL(/tag=e2e/);
   183→      expect(page.url()).toContain('status=pending');
   184→      expect(page.url()).toContain('tag=e2e');
   185→    });
   186→
   187→    // AC: @web-dashboard ac-10
   188→    test('restores filters from URL query params on page load', async ({ page, daemon }) => {
   189→      // Navigate directly with query params
   190→      await page.goto('/tasks?status=pending&tag=e2e');
   191→
   192→      // Wait for page to load and filters to be applied
   193→      // Select components show their value in the trigger text
   194→      const filterStatus = page.getByTestId('filter-status');
