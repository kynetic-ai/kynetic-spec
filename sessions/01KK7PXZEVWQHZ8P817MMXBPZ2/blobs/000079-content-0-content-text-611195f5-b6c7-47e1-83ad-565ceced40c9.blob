   404→    // AC: @web-dashboard ac-33
   405→    // Note: This test requires WebSocket to be working. Currently, the daemon's
   406→    // WebSocket upgrade returns 200 instead of 101 in the test environment,
   407→    // causing the connection to fail. The UI code correctly handles WebSocket
   408→    // updates when the connection is available.
   409→    test.skip('highlights task on WebSocket update', async ({ page, daemon }) => {
   410→      await page.goto('/tasks');
   411→
   412→      // Wait for page to fully load
   413→      const taskList = page.getByTestId('task-list');
   414→      const firstTask = taskList.getByTestId('task-list-item').first();
   415→      await expect(firstTask).toBeVisible();
   416→
   417→      // Get task ref from first task (this is the slug or ULID)
   418→      const taskRef = await firstTask.getAttribute('data-task-ref');
   419→      expect(taskRef).toBeTruthy();
   420→
   421→      // Simulate external update via API (would trigger WebSocket event)
   422→      const response = await fetch(`${daemon.baseUrl}/api/tasks/${taskRef}/note`, {
   423→        method: 'POST',
   424→        headers: {
   425→          'Content-Type': 'application/json',
   426→        },
   427→        body: JSON.stringify({
   428→          content: 'External note added',
   429→          author: '@external',
   430→        }),
   431→      });
   432→      expect(response.ok).toBe(true);
   433→
   434→      // Find the task by data-task-ref attribute (not by text content)
   435→      const highlightedTask = taskList.locator(`[data-task-ref="${taskRef}"]`);
   436→      await expect(highlightedTask).toBeVisible();
   437→
   438→      // Check for highlight class or animation (the component uses animate-pulse)
   439→      await expect(highlightedTask).toHaveClass(/animate-pulse/, { timeout: 5000 });
   440→
   441→      // Highlight should fade after 3 seconds (per implementation)
   442→      await page.waitForTimeout(3500);
   443→      await expect(highlightedTask).not.toHaveClass(/animate-pulse/);
   444→    });
   445→  });
