   105→    // AC: @web-dashboard ac-9
   106→    test('filters tasks by assignee', async ({ page, daemon }) => {
   107→      await page.goto('/tasks');
   108→
   109→      const filterAssignee = page.getByTestId('filter-assignee');
   110→      await expect(filterAssignee).toBeVisible();
   111→
   112→      // Type an assignee to filter (text input, not select)
