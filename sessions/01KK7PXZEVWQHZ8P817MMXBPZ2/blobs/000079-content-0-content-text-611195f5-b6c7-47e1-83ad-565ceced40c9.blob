   147→    // AC: @web-dashboard ac-9 - automation filter dropdown has correct options
   148→    test('automation filter has correct dropdown options', async ({ page, daemon }) => {
   149→      await page.goto('/tasks');
   150→
   151→      const filterAutomation = page.getByTestId('filter-automation');
   152→      await filterAutomation.click();
   153→
   154→      // Should show correct automation statuses matching AutomationStatusSchema
   155→      await expect(page.getByRole('option', { name: 'All' })).toBeVisible();
