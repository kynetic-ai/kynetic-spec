     1→/**
     2→ * Session command registration.
     3→ *
     4→ * Wires up all session sub-commands with commander. This is the thin orchestration
     5→ * layer that imports action handlers from sub-modules.
     6→ */
     7→
     8→import chalk from "chalk";
     9→import type { Command } from "commander";
    10→import {
    11→  initContext,
    12→} from "../../../parser/index.js";
    13→import {
    14→  ShadowError,
    15→  type ShadowSyncResult,
    16→  shadowPull,
    17→} from "../../../parser/shadow.js";
    18→import { isObject } from "../../../acp/types.js";
    19→import {
    20→  errors,
    21→  sessionPrompt,
    22→} from "../../../strings/index.js";
    23→import { markMutating } from "../../command-annotations.js";
    24→import { EXIT_CODES } from "../../exit-codes.js";
    25→import { error, info, isJsonMode, output, warn } from "../../output.js";
    26→import { performCheckpoint } from "./checkpoint.js";
    27→import { sessionCompactAction } from "./compact.js";
    28→import { gatherSessionContext } from "./context.js";
    29→import { sessionCreateAction } from "./create.js";
    30→import { formatCheckpointResult, formatSessionContext } from "./format.js";
    31→import {
    32→  sessionLogListAction,
    33→  sessionLogSearchAction,
    34→  sessionLogShowAction,
    35→  sessionLogStatsAction,
    36→} from "./log.js";
    37→import { sessionStaleCloseAction } from "./stale-close.js";
    38→import type { CheckpointOptions, SessionOptions, StopHookInput } from "./types.js";
    39→
    40→// ─── Debug Logging ──────────────────────────────────────────────────────────
    41→
    42→function debugLog(message: string, detail?: unknown): void {
    43→  if (process.env.KSPEC_DEBUG === "1") {
    44→    if (detail) {
    45→      console.error(`[DEBUG] session/commands: ${message}`, detail);
    46→    } else {
    47→      console.error(`[DEBUG] session/commands: ${message}`);
    48→    }
    49→  }
    50→}
    51→
    52→// ─── Action Handlers ────────────────────────────────────────────────────────
    53→
    54→async function sessionStartAction(options: SessionOptions): Promise<void> {
    55→  try {
    56→    const ctx = await initContext();
    57→
    58→    // AC: @shadow-sync ac-2 - Pull remote changes before showing session context
    59→    let syncResult: ShadowSyncResult | null = null;
    60→    if (ctx.shadow?.enabled) {
    61→      syncResult = await shadowPull(ctx.shadow.worktreeDir);
    62→      // AC: @shadow-sync ac-3 - Warn about conflicts but continue with local state
    63→      if (syncResult.hadConflict) {
    64→        warn("Shadow sync conflict detected. Run `kspec shadow resolve` to fix.");
    65→        info("Continuing with local state...");
    66→      } else if (syncResult.pulled) {
    67→        info("Synced shadow branch from remote");
    68→      }
    69→    }
    70→
    71→    const sessionCtx = await gatherSessionContext(ctx, options);
    72→
    73→    output(sessionCtx, () => formatSessionContext(sessionCtx, options));
    74→  } catch (err) {
    75→    error(errors.failures.gatherSessionContext, err);
    76→    process.exit(EXIT_CODES.ERROR);
    77→  }
    78→}
    79→
    80→/**
    81→ * Read stdin if available (non-blocking check for hook input)
    82→ */
    83→async function readStdinIfAvailable(): Promise<string | null> {
    84→  // Check if stdin is a TTY (interactive) - if so, don't try to read
    85→  if (process.stdin.isTTY) {
    86→    return null;
    87→  }
    88→
    89→  return new Promise((resolve) => {
    90→    let data = "";
    91→
    92→    const onData = (chunk: string) => {
    93→      data += chunk;
    94→    };
    95→    const onEnd = () => {
    96→      clearTimeout(timeout);
    97→      cleanup();
    98→      resolve(data || null);
    99→    };
   100→    const onError = () => {
   101→      clearTimeout(timeout);
   102→      cleanup();
   103→      resolve(null);
   104→    };
   105→    const cleanup = () => {
   106→      process.stdin.removeListener("data", onData);
   107→      process.stdin.removeListener("end", onEnd);
   108→      process.stdin.removeListener("error", onError);
   109→    };
   110→
   111→    const timeout = setTimeout(() => {
   112→      cleanup();
   113→      resolve(data || null);
   114→    }, 100); // 100ms timeout for stdin
   115→
   116→    process.stdin.setEncoding("utf8");
   117→    process.stdin.on("data", onData);
   118→    process.stdin.on("end", onEnd);
   119→    process.stdin.on("error", onError);
   120→    process.stdin.resume();
   121→  });
   122→}
   123→
   124→/**
   125→ * Parse Claude Code hook input from stdin.
   126→ * Returns null (with debug log) if input is missing, not valid JSON, or not an object.
   127→ */
   128→export function parseHookInput(stdin: string | null): StopHookInput | null {
   129→  if (!stdin) return null;
   130→  try {
   131→    const parsed: unknown = JSON.parse(stdin.trim());
   132→    if (!isObject(parsed)) {
   133→      debugLog("parseHookInput: parsed value is not an object");
   134→      return null;
   135→    }
   136→    return parsed as StopHookInput;
   137→  } catch (err) {
   138→    debugLog("parseHookInput: failed to parse stdin as JSON", err);
   139→    return null;
   140→  }
   141→}
   142→
   143→/**
   144→ * Output spec-first reminder for UserPromptSubmit hook.
   145→ *
   146→ * This is a simple context injection - always outputs the reminder,
   147→ * and Claude (Opus) is smart enough to apply it when relevant.
   148→ */
   149→async function sessionPromptCheckAction(): Promise<void> {
   150→  // Lean, instructive reminder with kspec prefix
   151→  console.log(sessionPrompt.specCheck);
   152→}
   153→
   154→async function sessionCheckpointAction(
   155→  options: CheckpointOptions,
   156→): Promise<void> {
   157→  try {
   158→    // Read stdin for Claude Code hook input
   159→    const stdin = await readStdinIfAvailable();
   160→    const hookInput = parseHookInput(stdin);
   161→
   162→    // Check if this is a retry (stop hook already active)
   163→    if (hookInput?.stop_hook_active) {
   164→      options.stopHookActive = true;
   165→    }
   166→
   167→    const ctx = await initContext();
   168→    const result = await performCheckpoint(ctx, options);
   169→
   170→    // Output format depends on mode:
   171→    // - JSON mode (--json): Output Claude Code hook format {"decision": "block", "reason": "..."}
   172→    // - Human mode: Output formatted checkpoint result
   173→    if (isJsonMode()) {
   174→      if (!result.ok) {
   175→        // Build reason message with issues and instructions
   176→        const issueLines = result.issues
   177→          .map((i) => `- ${i.description}`)
   178→          .join("\n");
   179→        const instructionLines = result.instructions
   180→          .filter((i) => i.trim())
   181→          .join("\n");
   182→        const reason = `${result.message}\n\nIssues:\n${issueLines}\n\n${instructionLines}`;
   183→        console.log(JSON.stringify({ decision: "block", reason }));
   184→      }
   185→      // If ok, exit silently (Claude Code expects no output when allowing stop)
   186→    } else {
   187→      formatCheckpointResult(result);
   188→      if (!result.ok) {
   189→        process.exit(EXIT_CODES.ERROR);
   190→      }
   191→    }
   192→  } catch (err) {
   193→    // Handle RUNNING_FROM_SHADOW gracefully - skip with warning instead of erroring
   194→    // This happens when the stop hook runs while cwd is inside .kspec/ directory
   195→    if (err instanceof ShadowError && err.code === "RUNNING_FROM_SHADOW") {
   196→      if (!isJsonMode()) {
   197→        console.log(
   198→          chalk.yellow(
   199→            "[kspec] Session checkpoint skipped - running from inside .kspec/ directory",
   200→          ),
   201→        );
   202→      }
   203→      // Allow stop to proceed (exit successfully, no JSON output blocks the stop)
   204→      return;
   205→    }
   206→    error(errors.failures.runCheckpoint, err);
   207→    process.exit(EXIT_CODES.ERROR);
   208→  }
   209→}
   210→
   211→// ─── Command Registration ───────────────────────────────────────────────────
   212→
   213→/**
   214→ * Register the 'session' command group and aliases
   215→ */
   216→export function registerSessionCommands(program: Command): void {
   217→  const session = program
   218→    .command("session")
   219→    .description("Session management and context");
   220→
   221→  // Session create subcommand
   222→  markMutating(session.command("create"))
   223→    .description("Create a new kspec session with optional budget")
   224→    .option(
   225→      "--agent-type <type>",
   226→      "Agent type (e.g., claude-code, codex-cli)",
   227→      "claude-code",
   228→    )
   229→    .option("--budget <n>", "Maximum tasks per cycle (positive integer)")
   230→    .option("--inject", "Inject KSPEC_SESSION_ID into agent environment")
   231→    .option("--task-id <id>", "Optional task ID being worked on")
   232→    .action(sessionCreateAction);
   233→
   234→  session
   235→    .command("start")
   236→    .alias("resume")
   237→    .description("Surface relevant context for starting a new working session")
   238→    .option("--brief", "Compact summary (default)")
   239→    .option("--full", "Comprehensive context dump")
   240→    .option(
   241→      "--since <time>",
   242→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
   243→    )
   244→    .option("--no-git", "Skip git commit information")
   245→    .option("-n, --limit <n>", "Limit items per section", "10")
   246→    .action(sessionStartAction);
   247→
   248→  // Session log subcommand group
   249→  const log = session
   250→    .command("log")
   251→    .description("Session log analysis commands");
   252→
   253→  log
   254→    .command("list")
   255→    .description("List session logs with summary statistics")
   256→    .option(
   257→      "-s, --status <status>",
   258→      "Filter by status (active, completed, abandoned)",
   259→    )
   260→    .option("--agent <type>", "Filter by agent type")
   261→    .option(
   262→      "--since <time>",
   263→      "Only show sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
   264→    )
   265→    .option(
   266→      "--sort <field>",
   267→      "Sort by field (started_at, duration, events, iterations, tasks_completed)",
   268→      "started_at",
   269→    )
   270→    .option("--count", "Show only the count of matching sessions")
   271→    .option("-n, --limit <n>", "Limit number of sessions shown")
   272→    .action(sessionLogListAction);
   273→
   274→  log
   275→    .command("show <session-id>")
   276→    .description("Show detailed view of a single session")
   277→    .option("-e, --events", "Include chronological event timeline")
   278→    .option("--text", "Replay assistant text output from session.update events")
   279→    .option("-t, --type <type>", "Filter events by type (e.g., tool.call)")
   280→    .option("-n, --limit <n>", "Show only the last N events")
   281→    .option("-c, --context <n>", "Show context snapshot for iteration N")
   282→    .option(
   283→      "--resolve-blobs",
   284→      "Resolve externalized event payload blobs (requires --events)",
   285→    )
   286→    .action(sessionLogShowAction);
   287→
   288→  log
   289→    .command("stats")
   290→    .description("Aggregate analytics across sessions")
   291→    .option(
   292→      "--since <time>",
   293→      "Only include sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
   294→    )
   295→    .option("--agent <type>", "Only include sessions with this agent type")
   296→    .option("--tool-usage", "Display top 10 tool calls by frequency")
   297→    .option("--by-day", "Group stats by day")
   298→    .option("--by-week", "Group stats by week")
   299→    .action(sessionLogStatsAction);
   300→
   301→  log
   302→    .command("search <pattern>")
   303→    .description("Search across session events by content")
   304→    .option("-t, --type <type>", "Only search events of this type (e.g., session.update)")
   305→    .option(
   306→      "--since <time>",
   307→      "Only search sessions started after this time (ISO8601 or relative: 1h, 2d, 1w)",
   308→    )
   309→    .option("--agent <type>", "Only search sessions with this agent type")
   310→    .option("-n, --limit <n>", "Maximum matches to return (default: 50)")
   311→    .option("--resolve-blobs", "Resolve externalized payload blobs for full-content search")
   312→    .action(sessionLogSearchAction);
   313→
   314→  markMutating(session.command("compact [session-id]"))
   315→    .description(
   316→      "Retroactively compact session events by externalizing oversized payloads",
   317→    )
   318→    .option("--all", "Compact all non-active sessions sequentially")
   319→    .option("--dry-run", "Preview compaction without modifying files")
   320→    .action(sessionCompactAction);
   321→
   322→  const stale = session
   323→    .command("stale")
   324→    .description("Stale active session cleanup commands");
   325→
   326→  markMutating(stale.command("close [session-id]"))
   327→    .description("Close stale active sessions by target or batch")
   328→    .option("--refs <session-ids...>", "Evaluate specific sessions in batch mode")
   329→    .option("--all", "Evaluate all active sessions")
   330→    .option(
   331→      "--older-than <duration>",
   332→      "Minimum session age (relative duration, e.g., 24h, 7d, 2w, 1m)",
   333→    )
   334→    .option(
   335→      "--inactive-for <duration>",
   336→      "Minimum inactivity duration (relative duration, e.g., 6h)",
   337→    )
   338→    .option(
   339→      "--liveness-guard <duration>",
   340→      "Protect recently-active sessions (default: 5m)",
   341→    )
   342→    .option("--dry-run", "Preview stale-session closures without modifying files")
   343→    .option("--force", "Skip confirmation prompts for destructive execution")
   344→    .action(sessionStaleCloseAction);
   345→
   346→  session
   347→    .command("checkpoint")
   348→    .description(
   349→      "Pre-stop hook: check for uncommitted work before ending session",
   350→    )
   351→    .option("--force", "Allow session end regardless of issues")
   352→    .action(sessionCheckpointAction);
   353→
   354→  session
   355→    .command("prompt-check")
   356→    .description("UserPromptSubmit hook: inject spec-first reminder")
   357→    .action(sessionPromptCheckAction);
   358→
   359→  // Top-level alias: kspec context
   360→  program
   361→    .command("context")
   362→    .description("Alias for session start - surface session context")
   363→    .option("--brief", "Compact summary (default)")
   364→    .option("--full", "Comprehensive context dump")
   365→    .option(
   366→      "--since <time>",
   367→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
   368→    )
   369→    .option("--no-git", "Skip git commit information")
   370→    .option("-n, --limit <n>", "Limit items per section", "10")
   371→    .action(sessionStartAction);
   372→}
