```
     1→/**
     2→ * Shadow branch utilities for transparent spec/task state tracking.
     3→ *
     4→ * Shadow branch concept:
     5→ * - Orphan branch (kspec-meta) stores kspec state
     6→ * - .kspec/ directory is a git worktree pointing to shadow branch
     7→ * - Main branch gitignores .kspec/
     8→ * - All kspec read/write operations target .kspec/
     9→ * - Changes auto-commit to shadow branch
    10→ */
    11→
    12→import { execFile, spawn, spawnSync } from "node:child_process";
    13→import * as fs from "node:fs/promises";
    14→import { tmpdir } from "node:os";
    15→import * as path from "node:path";
    16→import { promisify } from "node:util";
    17→import { fileURLToPath } from "node:url";
    18→import { isBatchMode } from "../cli/batch-context.js";
    19→
    20→const __filename = fileURLToPath(import.meta.url);
    21→const __dirname = path.dirname(__filename);
    22→
    23→const execFileAsync = promisify(execFile);
    24→
    25→interface RunCommandOptions {
    26→  cwd?: string;
    27→  env?: NodeJS.ProcessEnv;
    28→}
    29→
    30→function runCommandSync(
    31→  command: string,
    32→  args: string[],
    33→  options: RunCommandOptions = {},
    34→): { ok: boolean; stdout: string; stderr: string } {
    35→  const result = spawnSync(command, args, {
    36→    cwd: options.cwd,
    37→    env: options.env,
    38→    stdio: ["ignore", "pipe", "pipe"],
    39→    encoding: "utf-8",
    40→  });
    41→
    42→  return {
    43→    ok: !result.error && result.status === 0,
    44→    stdout: (result.stdout || "").toString(),
    45→    stderr: (result.stderr || "").toString(),
    46→  };
    47→}
    48→
    49→async function runGitAsync(
    50→  cwd: string,
    51→  args: string[],
    52→  env?: NodeJS.ProcessEnv,
    53→): Promise<{ stdout: string; stderr: string }> {
    54→  const { stdout = "", stderr = "" } = await execFileAsync("git", args, {
    55→    cwd,
    56→    env,
    57→    encoding: "utf-8",
    58→  });
    59→  return { stdout: stdout.toString(), stderr: stderr.toString() };
    60→}
    61→
    62→function runGitSync(
    63→  cwd: string,
    64→  args: string[],
    65→): { ok: boolean; stdout: string } {
    66→  const result = spawnSync("git", args, {
    67→    cwd,
    68→    stdio: ["ignore", "pipe", "pipe"],
    69→    encoding: "utf-8",
    70→  });
    71→
    72→  return {
    73→    ok: !result.error && result.status === 0,
    74→    stdout: (result.stdout || "").toString(),
    75→  };
    76→}
    77→
    78→/**
    79→ * Parse git version from `git --version` output.
    80→ * Returns [major, minor, patch] or null if unparseable.
    81→ */
    82→export function getGitVersion(
    83→  cwd?: string,
    84→): [number, number, number] | null {
    85→  const result = spawnSync("git", ["--version"], {
    86→    cwd,
    87→    stdio: ["ignore", "pipe", "pipe"],
    88→    encoding: "utf-8",
    89→  });
    90→  if (result.error || result.status !== 0) return null;
    91→  const match = (result.stdout || "").match(/(\d+)\.(\d+)\.(\d+)/);
    92→  if (!match) return null;
    93→  return [Number(match[1]), Number(match[2]), Number(match[3])];
    94→}
    95→
    96→/**
    97→ * Check if the installed git supports `git worktree add --orphan` (requires >= 2.42.0).
    98→ */
    99→export function gitSupportsOrphanWorktree(cwd?: string): boolean {
   100→  const version = getGitVersion(cwd);
   101→  if (!version) return false;
   102→  const [major, minor] = version;
   103→  return major > 2 || (major === 2 && minor >= 42);
   104→}
   105→
   106→/**
   107→ * Fallback for creating an orphan branch when git < 2.42.
   108→ *
   109→ * Strategy:
   110→ * 1. Create a temp bare repo in the OS temp directory
   111→ * 2. Create an orphan branch with an empty commit there
   112→ * 3. Push that branch to the project repo (via file:// protocol)
   113→ * 4. Clean up the temp repo
   114→ * 5. Attach using standard `git worktree add <dir> <branch>`
   115→ *
   116→ * This approach NEVER modifies the project's working tree.
   117→ *
   118→ * AC: @config-shadow ac-10
   119→ */
   120→export async function createOrphanBranchFallback(
   121→  projectRoot: string,
   122→  branchName: string,
   123→  directoryName: string,
   124→): Promise<void> {
   125→  const tmpDir = await fs.mkdtemp(path.join(tmpdir(), "kspec-orphan-"));
   126→
   127→  try {
   128→    // 1. Init a bare repo in the temp dir
   129→    await runGitAsync(tmpDir, ["init", "--bare"]);
   130→
   131→    // 2. Create the orphan branch using a temporary non-bare clone.
   132→    //    We need a working tree to make a commit, so clone the bare repo.
   133→    const workDir = await fs.mkdtemp(path.join(tmpdir(), "kspec-orphan-work-"));
   134→
   135→    try {
   136→      await runGitAsync(workDir, ["clone", tmpDir, "."]);
   137→      await runGitAsync(workDir, [
   138→        "config",
   139→        "user.email",
   140→        "kspec@localhost",
   141→      ]);
   142→      await runGitAsync(workDir, [
   143→        "config",
   144→        "user.name",
   145→        "kspec",
   146→      ]);
   147→
   148→      // Create an orphan branch (checkout --orphan works on all git versions)
   149→      await runGitAsync(workDir, [
   150→        "checkout",
   151→        "--orphan",
   152→        branchName,
   153→      ]);
   154→
   155→      // Remove any files that might have been staged
   156→      try {
   157→        await runGitAsync(workDir, ["rm", "-rf", "."]);
   158→      } catch {
   159→        // May fail if nothing to remove (empty repo) - that's fine
   160→      }
   161→
   162→      // Create an empty initial commit
   163→      await runGitAsync(workDir, [
   164→        "commit",
   165→        "--allow-empty",
   166→        "-m",
   167→        `Initialize ${branchName}`,
   168→      ]);
   169→
   170→      // Push the orphan branch back to the bare repo
   171→      await runGitAsync(workDir, [
   172→        "push",
   173→        "origin",
   174→        branchName,
   175→      ]);
   176→    } finally {
   177→      await fs.rm(workDir, { recursive: true, force: true });
   178→    }
   179→
   180→    // 3. Push from the temp bare repo to the project repo
   181→    //    Use file:// protocol to ensure git treats it as a proper remote
   182→    await runGitAsync(tmpDir, [
   183→      "push",
   184→      `file://${path.resolve(projectRoot)}`,
   185→      branchName,
   186→    ]);
   187→  } finally {
   188→    // 4. Clean up the temp bare repo
   189→    await fs.rm(tmpDir, { recursive: true, force: true });
   190→  }
   191→
   192→  // 5. Attach worktree using standard git worktree add (no --orphan flag)
   193→  await runGitAsync(projectRoot, [
   194→    "worktree",
   195→    "add",
   196→    directoryName,
   197→    branchName,
   198→  ]);
   199→
   200→  // 6. Remove all tracked files from the worktree since the fallback
   201→  //    created an empty commit but `git worktree add` may still populate
   202→  //    the index from the branch. Clear anything that appeared.
   203→  try {
   204→    const { stdout } = await runGitAsync(
   205→      path.join(projectRoot, directoryName),
   206→      ["ls-files"],
   207→    );
   208→    if (stdout.trim()) {
   209→      await runGitAsync(
   210→        path.join(projectRoot, directoryName),
   211→        ["rm", "-rf", "."],
   212→      );
   213→    }
   214→  } catch {
   215→    // Nothing to remove — expected for an empty commit
   216→  }
   217→}
   218→
   219→// Import getVerboseMode for checking CLI --debug-shadow flag
   220→// We use a getter function to avoid issues with circular dependencies
   221→let getVerboseModeFunc: (() => boolean) | null = null;
   222→
   223→export function setVerboseModeGetter(getter: () => boolean): void {
   224→  getVerboseModeFunc = getter;
   225→}
   226→
   227→/**
   228→ * Shadow branch configuration
   229→ */
   230→export interface ShadowConfig {
   231→  /** Whether shadow branch is enabled/detected */
   232→  enabled: boolean;
   233→  /** Path to .kspec/ worktree directory */
   234→  worktreeDir: string;
   235→  /** Shadow branch name (default: kspec-meta) */
   236→  branchName: string;
   237→  /** Project root (where .kspec/ lives) */
   238→  projectRoot: string;
   239→}
   240→
   241→/**
   242→ * Shadow branch status
   243→ */
   244→export interface ShadowStatus {
   245→  exists: boolean;
   246→  healthy: boolean;
   247→  branchExists: boolean;
   248→  worktreeExists: boolean;
   249→  worktreeLinked: boolean;
   250→  artifactsDirExists: boolean;
   251→  error?: string;
   252→}
   253→
   254→/**
   255→ * Error types for shadow branch issues
   256→ */
   257→export class ShadowError extends Error {
   258→  constructor(
   259→    message: string,
   260→    public code:
   261→      | "NOT_INITIALIZED"
   262→      | "WORKTREE_DISCONNECTED"
   263→      | "DIRECTORY_MISSING"
   264→      | "GIT_ERROR"
   265→      | "RUNNING_FROM_SHADOW",
   266→    public suggestion: string,
   267→  ) {
   268→    super(message);
   269→    this.name = "ShadowError";
   270→  }
   271→}
   272→
   273→/**
   274→ * Default shadow branch name
   275→ */
   276→export const SHADOW_BRANCH_NAME = "kspec-meta";
   277→
   278→/**
   279→ * Default shadow worktree directory
   280→ */
   281→export const SHADOW_WORKTREE_DIR = ".kspec";
   282→
   283→/**
   284→ * Options for shadow branch operations.
   285→ *
   286→ * AC: @config-shadow ac-7 — all fields optional for backward compatibility
   287→ *
   288→ * When not provided, functions use SHADOW_BRANCH_NAME and SHADOW_WORKTREE_DIR constants.
   289→ */
   290→export interface ShadowOptions {
   291→  /** Branch name (default: kspec-meta) */
   292→  branchName?: string;
   293→  /** Worktree directory name (default: .kspec) */
   294→  directory?: string;
   295→  /**
   296→   * Remote target for push/pull. Can be:
   297→   * - Named remote (e.g., "origin", "specs-origin")
   298→   * - Local filesystem path (starts with /, ./, or ~)
   299→   * - Git URL (contains :// or starts with git@)
   300→   */
   301→  remote?: string;
   302→  /** Type of remote (detected from remote string) */
   303→  remoteType?: "named" | "path" | "url";
   304→}
   305→
   306→/**
   307→ * Get effective branch name from options or default.
   308→ * AC: @config-shadow ac-7 — backward compat when called without config
   309→ */
   310→function getBranchName(options?: ShadowOptions): string {
   311→  return options?.branchName ?? SHADOW_BRANCH_NAME;
   312→}
   313→
   314→/**
   315→ * Get effective directory name from options or default.
   316→ * AC: @config-shadow ac-7 — backward compat when called without config
   317→ */
   318→function getDirectoryName(options?: ShadowOptions): string {
   319→  return options?.directory ?? SHADOW_WORKTREE_DIR;
   320→}
   321→
   322→/**
   323→ * Check if debug mode is enabled.
   324→ * Debug mode can be enabled via:
   325→ * - KSPEC_DEBUG=1 environment variable
   326→ * - Verbose flag (passed from CLI --debug-shadow option)
   327→ *
   328→ * When enabled, shadow branch operations output detailed information.
   329→ */
   330→export function isDebugMode(verboseFlag?: boolean): boolean {
   331→  if (process.env.KSPEC_DEBUG === "1") {
   332→    return true;
   333→  }
   334→  if (verboseFlag === true) {
   335→    return true;
   336→  }
   337→  // Check CLI --debug-shadow flag via getter
   338→  if (getVerboseModeFunc?.()) {
   339→    return true;
   340→  }
   341→  return false;
   342→}
   343→
   344→/**
   345→ * Check if we're in a git repository
   346→ */
   347→export async function isGitRepo(dir: string): Promise<boolean> {
   348→  return runGitSync(dir, ["rev-parse", "--git-dir"]).ok;
   349→}
   350→
   351→/**
   352→ * Get the git root directory
   353→ */
   354→export function getGitRoot(dir: string): string | null {
   355→  const result = runGitSync(dir, ["rev-parse", "--show-toplevel"]);
   356→  if (!result.ok) {
   357→    return null;
   358→  }
   359→  return result.stdout.trim();
   360→}
   361→
   362→/**
   363→ * Check if a branch exists
   364→ */
   365→export async function branchExists(
   366→  dir: string,
   367→  branchName: string,
   368→): Promise<boolean> {
   369→  return runGitSync(dir, [
   370→    "show-ref",
   371→    "--verify",
   372→    "--quiet",
   373→    `refs/heads/${branchName}`,
   374→  ]).ok;
   375→}
   376→
   377→/**
   378→ * Check if a directory is a valid git worktree
   379→ */
   380→export async function isValidWorktree(worktreeDir: string): Promise<boolean> {
   381→  try {
   382→    // Check if .git file exists (worktrees have a .git file, not directory)
   383→    const gitPath = path.join(worktreeDir, ".git");
   384→    const stat = await fs.stat(gitPath);
   385→
   386→    if (stat.isFile()) {
   387→      // Read the .git file to verify it points to a worktree
   388→      const content = await fs.readFile(gitPath, "utf-8");
   389→      return content.trim().startsWith("gitdir:");
   390→    }
   391→
   392→    return false;
   393→  } catch {
   394→    return false;
   395→  }
   396→}
   397→
   398→/**
   399→ * Detect if running from inside the shadow worktree directory.
   400→ * Returns the main project root if detected, null otherwise.
   401→ *
   402→ * AC: @config-shadow ac-8 — detects custom worktree directories using git metadata
   403→ *
   404→ * Detection logic:
   405→ * 1. Check if .git is a file (worktrees have .git files, not directories)
   406→ * 2. Read the gitdir reference from the .git file
   407→ * 3. Check if it points to a worktree for kspec (pattern: <project>/.git/worktrees/...)
   408→ *
   409→ * For custom directories, we detect ANY worktree that:
   410→ * - Has a kspec manifest in it (indicating it's a kspec shadow worktree)
   411→ * - Or has a worktree name containing "kspec" or the configured directory name
   412→ *
   413→ * @param cwd Current working directory
   414→ * @param configuredDirectory Optional configured directory name for matching
   415→ */
   416→export async function detectRunningFromShadowWorktree(
   417→  cwd: string,
   418→  configuredDirectory?: string,
   419→): Promise<string | null> {
   420→  try {
   421→    const gitPath = path.join(cwd, ".git");
   422→    const stat = await fs.stat(gitPath);
   423→
   424→    // Worktrees have a .git file, not directory
   425→    if (!stat.isFile()) {
   426→      return null;
   427→    }
   428→
   429→    const content = await fs.readFile(gitPath, "utf-8");
   430→    const match = content.trim().match(/^gitdir:\s*(.+)$/);
   431→    if (!match) {
   432→      return null;
   433→    }
   434→
   435→    const gitdir = match[1];
   436→
   437→    // Check if this is a worktree (pattern: <project>/.git/worktrees/<name>)
   438→    if (gitdir.includes(".git/worktrees/")) {
   439→      const worktreesMatch = gitdir.match(/^(.+)\/\.git\/worktrees\//);
   440→      if (worktreesMatch) {
   441→        const mainProjectRoot = worktreesMatch[1];
   442→        const cwdBase = path.basename(cwd);
   443→        const worktreeName = path.basename(gitdir);
   444→
   445→        // AC: ac-8 — check multiple patterns for shadow worktree detection
   446→        const directoryToCheck = configuredDirectory || SHADOW_WORKTREE_DIR;
   447→
   448→        // Check if directory name matches default, configured, or worktree contains "kspec"
   449→        if (
   450→          cwdBase === SHADOW_WORKTREE_DIR ||
   451→          cwdBase === directoryToCheck ||
   452→          worktreeName.includes("kspec")
   453→        ) {
   454→          return mainProjectRoot;
   455→        }
   456→
   457→        // Additional check: see if this directory has a kspec manifest
   458→        // This catches custom directories that don't have "kspec" in the name
   459→        try {
   460→          const files = await fs.readdir(cwd);
   461→          const hasKspecManifest = files.some(
   462→            (f) =>
   463→              (f.endsWith(".yaml") || f.endsWith(".yml")) &&
   464→              !f.includes(".tasks.") &&
   465→              !f.includes(".inbox."),
   466→          );
   467→          // Check for modules directory or tasks file as additional signals
   468→          const hasModules = files.includes("modules");
   469→          const hasTasksFile = files.some((f) => f.includes(".tasks."));
   470→
   471→          if (hasKspecManifest && (hasModules || hasTasksFile)) {
   472→            return mainProjectRoot;
   473→          }
   474→        } catch {
   475→          // Ignore read errors
   476→        }
   477→      }
   478→    }
   479→
   480→    return null;
   481→  } catch {
   482→    return null;
   483→  }
   484→}
   485→
   486→/**
   487→ * Detect shadow branch configuration from a directory.
   488→ * Returns shadow config if worktree directory exists and is valid.
   489→ *
   490→ * AC: @config-shadow ac-1 ac-2 — uses configured branch/directory names
   491→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
   492→ *
   493→ * @param startDir Directory to start detection from
   494→ * @param options Optional shadow configuration (branch name, directory)
   495→ */
   496→export async function detectShadow(
   497→  startDir: string,
   498→  options?: ShadowOptions,
   499→): Promise<ShadowConfig | null> {
   500→  const gitRoot = getGitRoot(startDir);
   501→  if (!gitRoot) {
   502→    return null;
   503→  }
   504→
   505→  const directoryName = getDirectoryName(options);
   506→  const branchName = getBranchName(options);
   507→  const worktreeDir = path.join(gitRoot, directoryName);
   508→
   509→  try {
   510→    await fs.access(worktreeDir);
   511→
   512→    // Verify it's a valid worktree
   513→    if (await isValidWorktree(worktreeDir)) {
   514→      return {
   515→        enabled: true,
   516→        worktreeDir,
   517→        branchName,
   518→        projectRoot: gitRoot,
   519→      };
   520→    }
   521→
   522→    // Directory exists but not a valid worktree
   523→    return null;
   524→  } catch {
   525→    // Worktree directory doesn't exist
   526→    return null;
   527→  }
   528→}
   529→
   530→/**
   531→ * Get detailed shadow branch status.
   532→ *
   533→ * AC: @config-shadow ac-1 ac-2 — uses configured branch/directory names
   534→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
   535→ *
   536→ * @param projectRoot Git repository root
   537→ * @param options Optional shadow configuration
   538→ */
   539→export async function getShadowStatus(
   540→  projectRoot: string,
   541→  options?: ShadowOptions,
   542→): Promise<ShadowStatus> {
   543→  const directoryName = getDirectoryName(options);
   544→  const branchName = getBranchName(options);
   545→  const worktreeDir = path.join(projectRoot, directoryName);
   546→
   547→  const status: ShadowStatus = {
   548→    exists: false,
   549→    healthy: false,
   550→    branchExists: false,
   551→    worktreeExists: false,
   552→    worktreeLinked: false,
   553→    artifactsDirExists: false,
   554→  };
   555→
   556→  // Check if we're in a git repo
   557→  if (!(await isGitRepo(projectRoot))) {
   558→    status.error = "Not a git repository";
   559→    return status;
   560→  }
   561→
   562→  // Check if branch exists
   563→  status.branchExists = await branchExists(projectRoot, branchName);
   564→
   565→  // Check if worktree directory exists
   566→  try {
   567→    await fs.access(worktreeDir);
   568→    status.worktreeExists = true;
   569→  } catch {
   570→    status.worktreeExists = false;
   571→  }
   572→
   573→  // Check if worktree is properly linked
   574→  if (status.worktreeExists) {
   575→    status.worktreeLinked = await isValidWorktree(worktreeDir);
   576→
   577→    // AC: @artifacts-directory ac-doctor-checks
   578→    try {
   579→      await fs.access(path.join(worktreeDir, "artifacts"));
   580→      status.artifactsDirExists = true;
   581→    } catch {
   582→      status.artifactsDirExists = false;
   583→    }
   584→  }
   585→
   586→  // Determine overall status
   587→  status.exists = status.branchExists || status.worktreeExists;
   588→  status.healthy =
   589→    status.branchExists && status.worktreeExists && status.worktreeLinked;
   590→
   591→  if (!status.healthy && status.exists) {
   592→    if (!status.branchExists) {
   593→      status.error = "Shadow branch missing but worktree exists";
   594→    } else if (!status.worktreeExists) {
   595→      status.error = "Shadow branch exists but worktree missing";
   596→    } else if (!status.worktreeLinked) {
   597→      status.error = "Worktree exists but not properly linked";
   598→    }
   599→  }
   600→
   601→  return status;
   602→}
   603→
   604→/**
   605→ * Result from checking config mismatch.
   606→ */
   607→export interface ShadowConfigMismatch {
   608→  /** Whether there is a mismatch */
   609→  hasMismatch: boolean;
   610→  /** Mismatched branch name (detected vs configured) */
   611→  branchMismatch?: { detected: string; configured: string };
   612→  /** Mismatched directory (detected vs configured) */
   613→  directoryMismatch?: { detected: string; configured: string };
   614→  /** Guidance message for the user */
   615→  guidance?: string;
   616→}
   617→
   618→/**
   619→ * Check if detected shadow branch settings match the configuration.
   620→ *
   621→ * AC: @config-shadow ac-9 — detect mismatch and guide user to migrate
   622→ *
   623→ * This function detects when:
   624→ * - A shadow branch exists with default settings (kspec-meta, .kspec)
   625→ * - But config specifies different settings
   626→ *
   627→ * @param projectRoot Git repository root
   628→ * @param configuredBranch Configured branch name
   629→ * @param configuredDirectory Configured directory name
   630→ */
   631→export async function checkConfigMismatch(
   632→  projectRoot: string,
   633→  configuredBranch: string,
   634→  configuredDirectory: string,
   635→): Promise<ShadowConfigMismatch> {
   636→  const result: ShadowConfigMismatch = { hasMismatch: false };
   637→
   638→  // First check if default shadow exists
   639→  const defaultStatus = await getShadowStatus(projectRoot, {
   640→    branchName: SHADOW_BRANCH_NAME,
   641→    directory: SHADOW_WORKTREE_DIR,
   642→  });
   643→
   644→  if (!defaultStatus.healthy) {
   645→    // No existing shadow with defaults - no mismatch possible
   646→    return result;
   647→  }
   648→
   649→  // Check if configured settings differ from defaults
   650→  const branchDiffers = configuredBranch !== SHADOW_BRANCH_NAME;
   651→  const directoryDiffers = configuredDirectory !== SHADOW_WORKTREE_DIR;
   652→
   653→  if (!branchDiffers && !directoryDiffers) {
   654→    // Config matches defaults - no mismatch
   655→    return result;
   656→  }
   657→
   658→  // There's a mismatch - existing shadow uses defaults but config specifies different values
   659→  result.hasMismatch = true;
   660→
   661→  if (branchDiffers) {
   662→    result.branchMismatch = {
   663→      detected: SHADOW_BRANCH_NAME,
   664→      configured: configuredBranch,
   665→    };
   666→  }
   667→
   668→  if (directoryDiffers) {
   669→    result.directoryMismatch = {
   670→      detected: SHADOW_WORKTREE_DIR,
   671→      configured: configuredDirectory,
   672→    };
   673→  }
   674→
   675→  // Build guidance message
   676→  const parts: string[] = [];
   677→  if (result.branchMismatch) {
   678→    parts.push(
   679→      `branch "${SHADOW_BRANCH_NAME}" (config wants "${configuredBranch}")`,
   680→    );
   681→  }
   682→  if (result.directoryMismatch) {
   683→    parts.push(
   684→      `directory "${SHADOW_WORKTREE_DIR}" (config wants "${configuredDirectory}")`,
   685→    );
   686→  }
   687→
   688→  result.guidance = [
   689→    `Shadow branch exists with ${parts.join(" and ")}.`,
   690→    "",
   691→    "To migrate to configured settings:",
   692→    "  1. Export your specs: kspec export --all > backup.yaml",
   693→    "  2. Remove existing shadow: rm -rf .kspec && git branch -D kspec-meta",
   694→    "  3. Re-initialize: kspec init",
   695→    "  4. Import specs: kspec import backup.yaml",
   696→    "",
   697→    "Or update kspec.config.yaml to match existing settings.",
   698→  ].join("\n");
   699→
   700→  return result;
   701→}
   702→
   703→/**
   704→ * Create an appropriate ShadowError based on status
   705→ */
   706→export function createShadowError(status: ShadowStatus): ShadowError {
   707→  if (!status.branchExists && !status.worktreeExists) {
   708→    return new ShadowError(
   709→      "Shadow branch not initialized",
   710→      "NOT_INITIALIZED",
   711→      "Run `kspec init` to create shadow branch and worktree.",
   712→    );
   713→  }
   714→
   715→  if (status.branchExists && !status.worktreeExists) {
   716→    return new ShadowError(
   717→      ".kspec/ directory missing",
   718→      "DIRECTORY_MISSING",
   719→      "Run `kspec shadow repair` to recreate the worktree.",
   720→    );
   721→  }
   722→
   723→  if (status.worktreeExists && !status.worktreeLinked) {
   724→    return new ShadowError(
   725→      "Worktree disconnected from git",
   726→      "WORKTREE_DISCONNECTED",
   727→      "Run `kspec shadow repair` to fix the worktree link.",
   728→    );
   729→  }
   730→
   731→  return new ShadowError(
   732→    status.error || "Unknown shadow branch error",
   733→    "GIT_ERROR",
   734→    "Check git status and try `kspec shadow repair`.",
   735→  );
   736→}
   737→
   738→/**
   739→ * Auto-commit changes to shadow branch.
   740→ * Called after write operations when shadow is enabled.
   741→ *
   742→ * @param worktreeDir Path to .kspec/ directory
   743→ * @param message Commit message
   744→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   745→ * @returns true if commit succeeded, false if nothing to commit
   746→ */
   747→export async function shadowAutoCommit(
   748→  worktreeDir: string,
   749→  message: string,
   750→  verbose?: boolean,
   751→): Promise<boolean> {
   752→  const debug = isDebugMode(verbose);
   753→
   754→  try {
   755→    if (debug) {
   756→      console.error(
   757→        `[DEBUG] Shadow auto-commit: git add -A (cwd: ${worktreeDir})`,
   758→      );
   759→    }
   760→
   761→    // Stage all changes
   762→    const addResult = runCommandSync("git", ["add", "-A"], { cwd: worktreeDir });
   763→    if (!addResult.ok) {
   764→      throw new Error(addResult.stderr || "git add failed");
   765→    }
   766→
   767→    // Check if there are staged changes
   768→    try {
   769→      if (debug) {
   770→        console.error(`[DEBUG] Shadow auto-commit: git diff --cached --quiet`);
   771→      }
   772→
   773→      const diffResult = runCommandSync(
   774→        "git",
   775→        ["diff", "--cached", "--quiet"],
   776→        { cwd: worktreeDir },
   777→      );
   778→      if (!diffResult.ok) {
   779→        throw new Error("changes staged");
   780→      }
   781→      // No error = no changes
   782→      if (debug) {
   783→        console.error(`[DEBUG] Shadow auto-commit: No changes to commit`);
   784→      }
   785→      return false;
   786→    } catch {
   787→      // Error = there are changes, proceed with commit
   788→    }
   789→
   790→    if (debug) {
   791→      console.error(`[DEBUG] Shadow auto-commit: git commit -m "${message}"`);
   792→    }
   793→
   794→    // Commit with message
   795→    // Set KSPEC_SHADOW_COMMIT=1 to signal authorized commit to git hooks
   796→    const commitResult = runCommandSync("git", ["commit", "-m", message], {
   797→      cwd: worktreeDir,
   798→      env: { ...process.env, KSPEC_SHADOW_COMMIT: "1" },
   799→    });
   800→    if (!commitResult.ok) {
   801→      throw new Error(commitResult.stderr || "git commit failed");
   802→    }
   803→
   804→    if (debug) {
   805→      console.error(`[DEBUG] Shadow auto-commit: Success`);
   806→    }
   807→
   808→    return true;
   809→  } catch (error) {
   810→    // AC: Only log error if debug mode enabled
   811→    if (debug) {
   812→      console.error("Shadow auto-commit failed:", error);
   813→    }
   814→    return false;
   815→  }
   816→}
   817→
   818→/**
   819→ * Generate commit message for a kspec operation.
   820→ */
   821→export function generateCommitMessage(
   822→  operation: string,
   823→  ref?: string,
   824→  detail?: string,
   825→): string {
   826→  const parts: string[] = [];
   827→
   828→  switch (operation) {
   829→    case "task-start":
   830→      parts.push(`Start @${ref}`);
   831→      break;
   832→    case "task-complete":
   833→      parts.push(`Complete @${ref}`);
   834→      if (detail) parts.push(`: ${detail}`);
   835→      break;
   836→    case "task-note":
   837→      parts.push(`Note on @${ref}`);
   838→      break;
   839→    case "task-add":
   840→      parts.push(`Add task: ${detail || ref}`);
   841→      break;
   842→    case "inbox-add":
   843→      parts.push(
   844→        `Inbox: ${detail?.slice(0, 50)}${(detail?.length || 0) > 50 ? "..." : ""}`,
   845→      );
   846→      break;
   847→    case "inbox-promote":
   848→      parts.push(`Promote to @${ref}`);
   849→      break;
   850→    case "item-add":
   851→      parts.push(`Add @${ref}`);
   852→      break;
   853→    case "item-set":
   854→      parts.push(`Update @${ref}`);
   855→      break;
   856→    case "item-delete":
   857→      parts.push(`Delete @${ref}`);
   858→      break;
   859→    case "derive":
   860→      parts.push(`Derive from @${ref}`);
   861→      break;
   862→    default:
   863→      parts.push(operation);
   864→      if (ref) parts.push(` @${ref}`);
   865→  }
   866→
   867→  return parts.join("");
   868→}
   869→
   870→/**
   871→ * Resolve a path relative to shadow worktree if enabled.
   872→ * Falls back to original path if shadow is not enabled.
   873→ *
   874→ * Uses the worktreeDir from shadowConfig for custom directory support.
   875→ */
   876→export function resolveShadowPath(
   877→  originalPath: string,
   878→  shadowConfig: ShadowConfig | null,
   879→  projectRoot: string,
   880→): string {
   881→  if (!shadowConfig?.enabled) {
   882→    return originalPath;
   883→  }
   884→
   885→  // If the path is within the project root, rewrite to shadow worktree
   886→  const relativePath = path.relative(projectRoot, originalPath);
   887→
   888→  // Get the directory name from the worktree path (supports custom directories)
   889→  const worktreeDirName = path.basename(shadowConfig.worktreeDir);
   890→
   891→  // Skip if path is outside project or already in shadow worktree
   892→  if (
   893→    relativePath.startsWith("..") ||
   894→    relativePath.startsWith(worktreeDirName)
   895→  ) {
   896→    return originalPath;
   897→  }
   898→
   899→  // Handle spec/ -> shadow worktree mapping
   900→  if (relativePath.startsWith("spec/") || relativePath.startsWith("spec\\")) {
   901→    const specRelative = relativePath.slice(5); // Remove 'spec/'
   902→    return path.join(shadowConfig.worktreeDir, specRelative);
   903→  }
   904→
   905→  // For task/inbox files at root, move to shadow worktree
   906→  if (
   907→    relativePath.endsWith(".tasks.yaml") ||
   908→    relativePath.endsWith(".inbox.yaml")
   909→  ) {
   910→    return path.join(shadowConfig.worktreeDir, relativePath);
   911→  }
   912→
   913→  return originalPath;
   914→}
   915→
   916→/**
   917→ * Commit changes to shadow branch if enabled.
   918→ * This is the primary interface for CLI commands to trigger auto-commit.
   919→ *
   920→ * @param shadowConfig Shadow configuration (from KspecContext.shadow)
   921→ * @param operation Operation type (e.g., 'task-start', 'task-complete')
   922→ * @param ref Reference slug or ULID (optional)
   923→ * @param detail Additional detail for commit message (optional)
   924→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   925→ * @returns true if committed, false if shadow not enabled or nothing to commit
   926→ */
   927→export async function commitIfShadow(
   928→  shadowConfig: ShadowConfig | null,
   929→  operation: string,
   930→  ref?: string,
   931→  detail?: string,
   932→  verbose?: boolean,
   933→): Promise<boolean> {
   934→  // Suppress auto-commits during atomic batch execution
   935→  if (isBatchMode()) {
   936→    return false;
   937→  }
   938→
   939→  if (!shadowConfig?.enabled) {
   940→    return false;
   941→  }
   942→
   943→  const message = generateCommitMessage(operation, ref, detail);
   944→  const committed = await shadowAutoCommit(
   945→    shadowConfig.worktreeDir,
   946→    message,
   947→    verbose,
   948→  );
   949→
   950→  // AC: @shadow-sync ac-1 - Fire-and-forget push after each commit
   951→  if (committed) {
   952→    shadowPushAsync(shadowConfig.worktreeDir, verbose);
   953→  }
   954→
   955→  return committed;
   956→}
   957→
   958→/**
   959→ * Check if shadow is required but not available, and throw appropriate error.
   960→ * Use this at the start of commands that require shadow mode.
   961→ *
   962→ * @param shadowConfig Shadow configuration from context
   963→ * @param projectRoot Project root for status check
   964→ * @throws ShadowError if shadow is not properly configured
   965→ */
   966→export async function requireShadow(
   967→  shadowConfig: ShadowConfig | null,
   968→  projectRoot: string,
   969→): Promise<void> {
   970→  if (shadowConfig?.enabled) {
   971→    return; // Shadow is available
   972→  }
   973→
   974→  const status = await getShadowStatus(projectRoot);
   975→  throw createShadowError(status);
   976→}
   977→
   978→/**
   979→ * Format a ShadowError for display in CLI.
   980→ * Returns a user-friendly message with suggestion.
   981→ */
   982→export function formatShadowError(error: ShadowError): string {
   983→  return `${error.message}\n\nSuggestion: ${error.suggestion}`;
   984→}
   985→
   986→/**
   987→ * Result from shadow initialization
   988→ */
   989→export interface ShadowInitResult {
   990→  success: boolean;
   991→  branchCreated: boolean;
   992→  worktreeCreated: boolean;
   993→  gitignoreUpdated: boolean;
   994→  initialCommit: boolean;
   995→  alreadyExists: boolean;
   996→  /** Whether shadow was created from existing remote branch */
   997→  createdFromRemote: boolean;
   998→  /** Whether new branch was pushed to remote to establish tracking */
   999→  pushedToRemote: boolean;
  1000→  error?: string;
  1001→}
  1002→
  1003→/**
  1004→ * Options for shadow initialization.
  1005→ *
  1006→ * AC: @config-shadow ac-1 ac-2 — branch and directory configurable
  1007→ */
  1008→export interface ShadowInitOptions {
  1009→  /** Project name for manifest */
  1010→  projectName?: string;
  1011→  /** Force reinitialize even if exists */
  1012→  force?: boolean;
  1013→  /** Shadow branch/directory/remote configuration */
  1014→  shadow?: ShadowOptions;
  1015→}
  1016→
  1017→/**
  1018→ * Check if a remote exists (default: origin)
  1019→ */
  1020→export async function hasRemote(
  1021→  projectRoot: string,
  1022→  remoteName = "origin",
  1023→): Promise<boolean> {
  1024→  try {
  1025→    const { stdout } = await runGitAsync(projectRoot, [
  1026→      "remote",
  1027→      "get-url",
  1028→      remoteName,
  1029→    ]);
  1030→    return stdout.trim().length > 0;
  1031→  } catch {
  1032→    return false;
  1033→  }
  1034→}
  1035→
  1036→/**
  1037→ * Check if a branch exists on a remote.
  1038→ * Uses git ls-remote to query the remote directly, which works in both
  1039→ * full and shallow clones.
  1040→ *
  1041→ * AC: @shadow-init-remote ac-5 — works in shallow clones
  1042→ */
  1043→export async function remoteBranchExists(
  1044→  projectRoot: string,
  1045→  branchName: string,
  1046→  remoteName = "origin",
  1047→): Promise<boolean> {
  1048→  try {
  1049→    const { stdout } = await runGitAsync(projectRoot, [
  1050→      "ls-remote",
  1051→      "--heads",
  1052→      remoteName,
  1053→      branchName,
  1054→    ]);
  1055→    return stdout.trim().length > 0;
  1056→  } catch {
  1057→    return false;
  1058→  }
  1059→}
  1060→
  1061→/**
  1062→ * Fetch from remote to ensure refs are up to date.
  1063→ * Returns true if fetch succeeded, false otherwise.
  1064→ */
  1065→export async function fetchRemote(
  1066→  projectRoot: string,
  1067→  remoteName = "origin",
  1068→): Promise<boolean> {
  1069→  try {
  1070→    await runGitAsync(projectRoot, ["fetch", remoteName]);
  1071→    return true;
  1072→  } catch {
  1073→    return false;
  1074→  }
  1075→}
  1076→
  1077→/**
  1078→ * Push shadow branch to remote with tracking.
  1079→ * Returns true if push succeeded, false otherwise.
  1080→ *
  1081→ * AC: @config-shadow ac-3 — uses configured remote name
  1082→ * AC: @config-shadow ac-7 — defaults to origin when not provided
  1083→ *
  1084→ * @param worktreeDir Path to shadow worktree
  1085→ * @param remoteName Remote name (default: origin)
  1086→ * @param options Optional shadow configuration
  1087→ */
  1088→export async function pushShadowBranch(
  1089→  worktreeDir: string,
  1090→  remoteName = "origin",
  1091→  options?: ShadowOptions,
  1092→): Promise<boolean> {
  1093→  const branchName = getBranchName(options);
  1094→  try {
  1095→    await runGitAsync(worktreeDir, ["push", "-u", remoteName, branchName]);
  1096→    return true;
  1097→  } catch {
  1098→    return false;
  1099→  }
  1100→}
  1101→
  1102→/**
  1103→ * Check if shadow branch has remote tracking configured.
  1104→ * AC-4: Used to determine whether sync should be attempted.
  1105→ *
  1106→ * AC: @config-shadow ac-7 — backward compat when called without config
  1107→ *
  1108→ * @param worktreeDir Path to shadow worktree
  1109→ * @param options Optional shadow configuration
  1110→ */
  1111→export async function hasRemoteTracking(
  1112→  worktreeDir: string,
  1113→  options?: ShadowOptions,
  1114→): Promise<boolean> {
  1115→  const branchName = getBranchName(options);
  1116→  try {
  1117→    const { stdout } = await runGitAsync(worktreeDir, [
  1118→      "config",
  1119→      `branch.${branchName}.remote`,
  1120→    ]);
  1121→    return stdout.trim().length > 0;
  1122→  } catch {
  1123→    return false;
  1124→  }
  1125→}
  1126→
  1127→/**
  1128→ * Ensure shadow branch has remote tracking configured.
  1129→ * AC-8: If shadow has no tracking but main branch has origin remote,
  1130→ * automatically configure tracking to origin/kspec-meta.
  1131→ *
  1132→ * AC: @config-shadow ac-3 ac-4 ac-5 — handles different remote types
  1133→ * AC: @config-shadow ac-6 — error with guidance if named remote doesn't exist
  1134→ * AC: @config-shadow ac-7 — backward compat when called without config
  1135→ *
  1136→ * @param worktreeDir Path to shadow worktree
  1137→ * @param projectRoot Git repository root
  1138→ * @param options Optional shadow configuration
  1139→ * @returns Result with success status and error details if applicable
  1140→ */
  1141→export async function ensureRemoteTracking(
  1142→  worktreeDir: string,
  1143→  projectRoot: string,
  1144→  options?: ShadowOptions,
  1145→): Promise<EnsureRemoteTrackingResult> {
  1146→  const branchName = getBranchName(options);
  1147→
  1148→  // Check if already has tracking
  1149→  if (await hasRemoteTracking(worktreeDir, options)) {
  1150→    return { success: true };
  1151→  }
  1152→
  1153→  // Determine remote name to use
  1154→  let remoteName = "origin";
  1155→
  1156→  if (options?.remote) {
  1157→    const remoteType = options.remoteType ?? "named";
  1158→
  1159→    if (remoteType === "named") {
  1160→      // AC: ac-3 — use the named remote directly
  1161→      remoteName = options.remote;
  1162→
  1163→      // AC: ac-6 — verify the named remote exists with guidance
  1164→      if (!(await hasRemote(projectRoot, remoteName))) {
  1165→        // Named remote doesn't exist - provide helpful guidance
  1166→        return {
  1167→          success: false,
  1168→          missingRemote: remoteName,
  1169→          guidance: `Remote '${remoteName}' does not exist. To fix this:\n` +
  1170→            `  1. Add the remote: git remote add ${remoteName} <url>\n` +
  1171→            `  2. Or update kspec.config.yaml to use an existing remote\n` +
  1172→            `  3. Or remove shadow.remote to use the default 'origin' remote`,
  1173→        };
  1174→      }
  1175→    } else if (remoteType === "path" || remoteType === "url") {
  1176→      // AC: ac-4 ac-5 — add a git remote for path/URL if not already present
  1177→      const specRemoteName = "kspec-specs";
  1178→      const hasSpecsRemote = await hasRemote(projectRoot, specRemoteName);
  1179→
  1180→      if (!hasSpecsRemote) {
  1181→        try {
  1182→          // Expand tilde for paths if needed
  1183→          let remoteTarget = options.remote;
  1184→          if (remoteType === "path" && remoteTarget.startsWith("~")) {
  1185→            remoteTarget = remoteTarget.replace(
  1186→              /^~/,
  1187→              process.env.HOME || process.env.USERPROFILE || "~",
  1188→            );
  1189→          }
  1190→
  1191→          await runGitAsync(projectRoot, [
  1192→            "remote",
  1193→            "add",
  1194→            specRemoteName,
  1195→            remoteTarget,
  1196→          ]);
  1197→        } catch {
  1198→          // Remote add failed - may already exist with different URL
  1199→          return { success: false };
  1200→        }
  1201→      }
  1202→
  1203→      remoteName = specRemoteName;
  1204→    }
  1205→  } else {
  1206→    // No remote configured - check if main branch has origin
  1207→    if (!(await hasRemote(projectRoot))) {
  1208→      return { success: false };
  1209→    }
  1210→  }
  1211→
  1212→  // Set up tracking for shadow branch
  1213→  try {
  1214→    await runGitAsync(worktreeDir, [
  1215→      "config",
  1216→      `branch.${branchName}.remote`,
  1217→      remoteName,
  1218→    ]);
  1219→    await runGitAsync(worktreeDir, [
  1220→      "config",
  1221→      `branch.${branchName}.merge`,
  1222→      `refs/heads/${branchName}`,
  1223→    ]);
  1224→    return { success: true };
  1225→  } catch {
  1226→    return { success: false };
  1227→  }
  1228→}
  1229→
  1230→/**
  1231→ * Result from ensuring remote tracking
  1232→ * AC: @config-shadow ac-6 — includes error details when named remote doesn't exist
  1233→ */
  1234→export interface EnsureRemoteTrackingResult {
  1235→  success: boolean;
  1236→  /** Error when remote doesn't exist (AC-6) */
  1237→  missingRemote?: string;
  1238→  /** Guidance message for user */
  1239→  guidance?: string;
  1240→}
  1241→
  1242→/**
  1243→ * Result from a sync operation
  1244→ */
  1245→export interface ShadowSyncResult {
  1246→  success: boolean;
  1247→  pulled: boolean;
  1248→  pushed: boolean;
  1249→  hadConflict: boolean;
  1250→  error?: string;
  1251→}
  1252→
  1253→const SHADOW_PUSH_FAILURE_ESCALATION_THRESHOLD = 3;
  1254→const shadowPushFailureCounts = new Map<string, number>();
  1255→
  1256→function summarizeShadowPushError(
  1257→  stderr: string,
  1258→  code: number | null,
  1259→  signal: NodeJS.Signals | null,
  1260→): string {
  1261→  const lines = stderr
  1262→    .split(/\r?\n/)
  1263→    .map((line) => line.trim())
  1264→    .filter(Boolean);
  1265→
  1266→  if (lines.length > 0) {
  1267→    const lastLine = lines[lines.length - 1];
  1268→    if (lastLine.length <= 240) {
  1269→      return lastLine;
  1270→    }
  1271→    return `${lastLine.slice(0, 237)}...`;
  1272→  }
  1273→
  1274→  if (code !== null) {
  1275→    return `git push exited with code ${code}`;
  1276→  }
  1277→  if (signal) {
  1278→    return `git push terminated by signal ${signal}`;
  1279→  }
  1280→  return "git push failed";
  1281→}
  1282→
  1283→function noteShadowPushFailure(worktreeDir: string, reason: string): void {
  1284→  const nextCount = (shadowPushFailureCounts.get(worktreeDir) ?? 0) + 1;
  1285→  shadowPushFailureCounts.set(worktreeDir, nextCount);
  1286→
  1287→  console.error(
  1288→    `[WARN] Shadow auto-push failed (consecutive: ${nextCount}). Local shadow commits were kept. ${reason}`,
  1289→  );
  1290→
  1291→  if (nextCount >= SHADOW_PUSH_FAILURE_ESCALATION_THRESHOLD) {
  1292→    console.error(
  1293→      `[WARN] Shadow auto-push has failed ${nextCount} times in a row. Remote shadow state is stale. Run \`kspec shadow sync\` (or \`kspec shadow resolve\` if conflicts are reported).`,
  1294→    );
  1295→  }
  1296→}
  1297→
  1298→function noteShadowPushSuccess(worktreeDir: string): void {
  1299→  shadowPushFailureCounts.delete(worktreeDir);
  1300→}
  1301→
  1302→/**
  1303→ * Pull-rebase from remote before pushing, using the kspec merge driver for
  1304→ * YAML conflict resolution.
  1305→ *
  1306→ * AC: @config-shadow ac-11 — pull-rebase before push prevents divergence
  1307→ *
  1308→ * @returns true if pull succeeded (or was unnecessary), false on conflict
  1309→ */
  1310→async function pullRebaseBeforePush(
  1311→  worktreeDir: string,
  1312→  branchName: string,
  1313→  debug: boolean,
  1314→): Promise<boolean> {
  1315→  try {
  1316→    // Fetch latest remote state for the shadow branch specifically.
  1317→    // Using the worktree dir for fetch ensures we use the branch's tracking config.
  1318→    try {
  1319→      await runGitAsync(worktreeDir, ["fetch"]);
  1320→    } catch {
  1321→      if (debug) {
  1322→        console.error("[DEBUG] Shadow pull-rebase: fetch failed, skipping pull");
  1323→      }
  1324→      // Fetch failure is non-fatal — push may still succeed if already up to date
  1325→      return true;
  1326→    }
  1327→
  1328→    // Check if remote branch exists
  1329→    const projectRoot = path.dirname(worktreeDir);
  1330→    const remoteHasBranch = await remoteBranchExists(projectRoot, branchName);
  1331→    if (!remoteHasBranch) {
  1332→      if (debug) {
  1333→        console.error("[DEBUG] Shadow pull-rebase: no remote branch yet, skipping pull");
  1334→      }
  1335→      return true;
  1336→    }
  1337→
  1338→    // Check if there are any upstream changes to integrate.
  1339→    // If local is already at or ahead of remote, skip the pull.
  1340→    try {
  1341→      const { stdout } = await runGitAsync(worktreeDir, [
  1342→        "rev-list",
  1343→        "--count",
  1344→        `${branchName}..@{upstream}`,
  1345→      ]);
  1346→      const behindCount = parseInt(stdout.trim(), 10);
  1347→      if (behindCount === 0) {
  1348→        if (debug) {
  1349→          console.error("[DEBUG] Shadow pull-rebase: already up to date with remote");
  1350→        }
  1351→        return true;
  1352→      }
  1353→    } catch {
  1354→      // rev-list may fail if upstream isn't set — proceed with pull attempt
  1355→    }
  1356→
  1357→    // Try fast-forward first (cleanest, no rebase needed)
  1358→    try {
  1359→      await runGitAsync(worktreeDir, ["pull", "--ff-only"]);
  1360→      if (debug) {
  1361→        console.error("[DEBUG] Shadow pull-rebase: fast-forward succeeded");
  1362→      }
  1363→      return true;
  1364→    } catch {
  1365→      // FF failed, need rebase
  1366→    }
  1367→
  1368→    // Fall back to rebase — the kspec merge driver handles YAML conflicts
  1369→    try {
  1370→      await runGitAsync(worktreeDir, ["pull", "--rebase"]);
  1371→      if (debug) {
  1372→        console.error("[DEBUG] Shadow pull-rebase: rebase succeeded");
  1373→      }
  1374→      return true;
  1375→    } catch {
  1376→      // Rebase failed — abort and report
  1377→    }
  1378→
  1379→    // Abort the failed rebase so local state is clean
  1380→    try {
  1381→      await runGitAsync(worktreeDir, ["rebase", "--abort"]);
  1382→    } catch {
  1383→      // May not be in rebase state
  1384→    }
  1385→
  1386→    if (debug) {
  1387→      console.error("[DEBUG] Shadow pull-rebase: conflict detected, push skipped");
  1388→    }
  1389→    return false;
  1390→  } catch (err) {
  1391→    if (debug) {
  1392→      console.error("[DEBUG] Shadow pull-rebase error:", err);
  1393→    }
  1394→    // Pull failure is non-fatal — still attempt push
  1395→    return true;
  1396→  }
  1397→}
  1398→
  1399→/**
  1400→ * Fire-and-forget push to remote with pull-rebase-before-push.
  1401→ * AC-1: Called after each auto-commit when tracking is configured.
  1402→ * AC-8: Automatically sets up tracking if main branch has remote.
  1403→ * AC: @config-shadow ac-11 — pull-rebase before push for bidirectional sync.
  1404→ * Push failures are surfaced as warnings, but local commits still succeed.
  1405→ *
  1406→ * AC: @config-shadow ac-7 — backward compat when called without config
  1407→ *
  1408→ * @param worktreeDir Path to shadow worktree
  1409→ * @param verbose Enable debug output
  1410→ * @param options Optional shadow configuration
  1411→ */
  1412→export async function shadowPushAsync(
  1413→  worktreeDir: string,
  1414→  verbose?: boolean,
  1415→  options?: ShadowOptions,
  1416→): Promise<void> {
  1417→  const debug = isDebugMode(verbose);
  1418→
  1419→  // AC: @shadow-sync ac-8 - Auto-configure tracking if main has remote but shadow doesn't
  1420→  const projectRoot = path.dirname(worktreeDir);
  1421→  const trackingResult = await ensureRemoteTracking(worktreeDir, projectRoot, options);
  1422→
  1423→  // AC: @config-shadow ac-6 — log guidance if named remote doesn't exist
  1424→  if (!trackingResult.success && trackingResult.missingRemote) {
  1425→    if (debug) {
  1426→      console.error(`[DEBUG] Shadow push: ${trackingResult.guidance}`);
  1427→    }
  1428→    return;
  1429→  }
  1430→
  1431→  // Check if tracking is configured before attempting push
  1432→  if (!(await hasRemoteTracking(worktreeDir, options))) {
  1433→    if (debug) {
  1434→      console.error(
  1435→        "[DEBUG] Shadow push: No remote tracking configured, skipping",
  1436→      );
  1437→    }
  1438→    return; // AC: @shadow-sync ac-4 - silently skip if no tracking
  1439→  }
  1440→
  1441→  // AC: @config-shadow ac-11 — pull-rebase before pushing to integrate remote changes
  1442→  const branchName = getBranchName(options);
  1443→  const pullOk = await pullRebaseBeforePush(worktreeDir, branchName, debug);
  1444→  if (!pullOk) {
  1445→    noteShadowPushFailure(
  1446→      worktreeDir,
  1447→      "Pull-rebase failed due to conflicts. Run `kspec shadow resolve` to fix.",
  1448→    );
  1449→    return;
  1450→  }
  1451→
  1452→  try {
  1453→    if (debug) {
  1454→      console.error(`[DEBUG] Shadow push: git push (cwd: ${worktreeDir})`);
  1455→    }
  1456→
  1457→    // Fire and forget: detached + unref allows CLI exit without waiting for push.
  1458→    // We still collect stderr and exit code while process is alive to surface failures.
  1459→    const child = spawn("git", ["push"], {
  1460→      cwd: worktreeDir,
  1461→      stdio: ["ignore", "ignore", "pipe"],
  1462→      detached: true,
  1463→    });
  1464→
  1465→    const stderrChunks: string[] = [];
  1466→    child.stderr?.setEncoding("utf-8");
  1467→    child.stderr?.on("data", (chunk) => {
  1468→      stderrChunks.push(chunk);
  1469→    });
  1470→    child.stderr?.resume();
  1471→
  1472→    (child.stderr as { unref?: () => void } | null)?.unref?.();
  1473→    child.unref();
  1474→    if (debug) {
  1475→      console.error("[DEBUG] Shadow push: spawned background git push");
  1476→    }
  1477→
  1478→    const exit = await new Promise<{
  1479→      code: number | null;
  1480→      signal: NodeJS.Signals | null;
  1481→      error?: Error;
  1482→    }>((resolve) => {
  1483→      let settled = false;
  1484→      const finish = (result: {
  1485→        code: number | null;
  1486→        signal: NodeJS.Signals | null;
  1487→        error?: Error;
  1488→      }) => {
  1489→        if (settled) {
  1490→          return;
  1491→        }
  1492→        settled = true;
  1493→        resolve(result);
  1494→      };
  1495→
  1496→      child.once("error", (error) => finish({ code: null, signal: null, error }));
  1497→      child.once("close", (code, signal) => finish({ code, signal }));
  1498→    });
  1499→
  1500→    if (exit.error) {
  1501→      noteShadowPushFailure(worktreeDir, exit.error.message);
  1502→      if (debug) {
  1503→        console.error("[DEBUG] Shadow push spawn error:", exit.error);
  1504→      }
  1505→      return;
  1506→    }
  1507→
  1508→    if (exit.code !== 0) {
  1509→      const reason = summarizeShadowPushError(
  1510→        stderrChunks.join(""),
  1511→        exit.code,
  1512→        exit.signal,
  1513→      );
  1514→      noteShadowPushFailure(worktreeDir, reason);
  1515→      return;
  1516→    }
  1517→
  1518→    noteShadowPushSuccess(worktreeDir);
  1519→  } catch (err) {
  1520→    const reason = err instanceof Error ? err.message : String(err);
  1521→    noteShadowPushFailure(worktreeDir, reason);
  1522→
  1523→    if (debug) {
  1524→      console.error("[DEBUG] Shadow push error:", err);
  1525→    }
  1526→  }
  1527→}
  1528→
  1529→/**
  1530→ * Pull remote changes to shadow branch.
  1531→ * AC-2: Called at session start to sync before operations.
  1532→ * AC-6: Uses --ff-only first, falls back to --rebase.
  1533→ * AC-3: On conflict, returns failure with suggestion.
  1534→ * AC-8: Automatically sets up tracking if main branch has remote.
  1535→ *
  1536→ * AC: @config-shadow ac-7 — backward compat when called without config
  1537→ *
  1538→ * @param worktreeDir Path to shadow worktree
  1539→ * @param options Optional shadow configuration
  1540→ */
  1541→export async function shadowPull(
  1542→  worktreeDir: string,
  1543→  options?: ShadowOptions,
  1544→): Promise<ShadowSyncResult> {
  1545→  const branchName = getBranchName(options);
  1546→  const result: ShadowSyncResult = {
  1547→    success: false,
  1548→    pulled: false,
  1549→    pushed: false,
  1550→    hadConflict: false,
  1551→  };
  1552→
  1553→  // AC: @shadow-sync ac-8 - Auto-configure tracking if main has remote but shadow doesn't
  1554→  const projectRoot = path.dirname(worktreeDir);
  1555→  const trackingResult = await ensureRemoteTracking(worktreeDir, projectRoot, options);
  1556→
  1557→  // AC: @config-shadow ac-6 — error with guidance if named remote doesn't exist
  1558→  if (!trackingResult.success && trackingResult.missingRemote) {
  1559→    result.error = trackingResult.guidance;
  1560→    return result;
  1561→  }
  1562→
  1563→  // AC: @shadow-sync ac-4 - Skip if no remote tracking
  1564→  if (!(await hasRemoteTracking(worktreeDir, options))) {
  1565→    result.success = true;
  1566→    return result;
  1567→  }
  1568→
  1569→  // Check if remote branch exists before attempting pull
  1570→  // Fetch first to ensure refs are up to date
  1571→  await fetchRemote(projectRoot);
  1572→  const remoteHasBranch = await remoteBranchExists(projectRoot, branchName);
  1573→  if (!remoteHasBranch) {
  1574→    // Remote branch doesn't exist yet - nothing to pull, but success
  1575→    result.success = true;
  1576→    return result;
  1577→  }
  1578→
  1579→  try {
  1580→    // Try fast-forward only first (cleanest)
  1581→    await runGitAsync(worktreeDir, ["pull", "--ff-only"]);
  1582→    result.success = true;
  1583→    result.pulled = true;
  1584→    return result;
  1585→  } catch {
  1586→    // Fast-forward failed, try rebase
  1587→  }
  1588→
  1589→  try {
  1590→    // AC: @shadow-sync ac-6 - Fall back to rebase
  1591→    await runGitAsync(worktreeDir, ["pull", "--rebase"]);
  1592→    result.success = true;
  1593→    result.pulled = true;
  1594→    return result;
  1595→  } catch {
  1596→    // Rebase failed - likely conflict
  1597→  }
  1598→
  1599→  // AC: @shadow-sync ac-3 - Conflict detected - abort rebase and report
  1600→  try {
  1601→    await runGitAsync(worktreeDir, ["rebase", "--abort"]);
  1602→  } catch {
  1603→    // May not be in rebase state, ignore
  1604→  }
  1605→
  1606→  result.hadConflict = true;
  1607→  result.error = "Sync conflict detected. Run `kspec shadow resolve` to fix.";
  1608→  return result;
  1609→}
  1610→
  1611→/**
  1612→ * Full sync operation: pull then push.
  1613→ * Used by session start and explicit sync commands.
  1614→ *
  1615→ * AC: @config-shadow ac-7 — backward compat when called without config
  1616→ *
  1617→ * @param worktreeDir Path to shadow worktree
  1618→ * @param options Optional shadow configuration
  1619→ */
  1620→export async function shadowSync(
  1621→  worktreeDir: string,
  1622→  options?: ShadowOptions,
  1623→): Promise<ShadowSyncResult> {
  1624→  // First pull
  1625→  const pullResult = await shadowPull(worktreeDir, options);
  1626→  if (!pullResult.success) {
  1627→    return pullResult;
  1628→  }
  1629→
  1630→  // Then push (only if tracking configured, checked inside)
  1631→  if (await hasRemoteTracking(worktreeDir, options)) {
  1632→    try {
  1633→      await runGitAsync(worktreeDir, ["push"]);
  1634→      pullResult.pushed = true;
  1635→    } catch {
  1636→      // Push failed - not a critical error, local state is correct
  1637→      // Could be permissions, network, etc.
  1638→    }
  1639→  }
  1640→
  1641→  return pullResult;
  1642→}
  1643→
  1644→/**
  1645→ * Check if .gitignore has uncommitted changes
  1646→ */
  1647→async function hasUncommittedGitignore(projectRoot: string): Promise<boolean> {
  1648→  try {
  1649→    // Check both staged and unstaged changes to .gitignore
  1650→    const { stdout } = await runGitAsync(projectRoot, [
  1651→      "status",
  1652→      "--porcelain",
  1653→      ".gitignore",
  1654→    ]);
  1655→    return stdout.trim().length > 0;
  1656→  } catch {
  1657→    return false;
  1658→  }
  1659→}
  1660→
  1661→/**
  1662→ * Commit only .gitignore with a message.
  1663→ *
  1664→ * @param projectRoot Git repository root
  1665→ * @param directoryName Shadow directory name (for commit message)
  1666→ */
  1667→async function commitGitignore(
  1668→  projectRoot: string,
  1669→  directoryName: string,
  1670→): Promise<void> {
  1671→  await runGitAsync(projectRoot, ["add", ".gitignore"]);
  1672→  await runGitAsync(projectRoot, [
  1673→    "commit",
  1674→    "-m",
  1675→    `chore: add ${directoryName}/ to .gitignore for shadow branch`,
  1676→  ]);
  1677→}
  1678→
  1679→/**
  1680→ * Add shadow directory to .gitignore if not already present.
  1681→ * Fails if .gitignore has uncommitted changes.
  1682→ * Commits the change after adding.
  1683→ *
  1684→ * AC: @config-shadow ac-2 — uses configured directory name
  1685→ * AC: @config-shadow ac-7 — defaults to .kspec when not provided
  1686→ *
  1687→ * @param projectRoot Git repository root
  1688→ * @param options Optional shadow configuration
  1689→ */
  1690→async function ensureGitignore(
  1691→  projectRoot: string,
  1692→  options?: ShadowOptions,
  1693→): Promise<boolean> {
  1694→  const directoryName = getDirectoryName(options);
  1695→  const gitignorePath = path.join(projectRoot, ".gitignore");
  1696→  const entry = `${directoryName}/`;
  1697→
  1698→  // Fail fast if .gitignore has uncommitted changes
  1699→  if (await hasUncommittedGitignore(projectRoot)) {
  1700→    throw new ShadowError(
  1701→      ".gitignore has uncommitted changes",
  1702→      "GIT_ERROR",
  1703→      "Commit or stash your .gitignore changes before running kspec init.",
  1704→    );
  1705→  }
  1706→
  1707→  try {
  1708→    let content = "";
  1709→    try {
  1710→      content = await fs.readFile(gitignorePath, "utf-8");
  1711→    } catch {
  1712→      // File doesn't exist, will create
  1713→    }
  1714→
  1715→    // Check if already present (handle various formats)
  1716→    const lines = content.split("\n");
  1717→    const patterns = [
  1718→      directoryName,
  1719→      `${directoryName}/`,
  1720→      `/${directoryName}`,
  1721→      `/${directoryName}/`,
  1722→    ];
  1723→
  1724→    for (const line of lines) {
  1725→      const trimmed = line.trim();
  1726→      if (patterns.includes(trimmed)) {
  1727→        return false; // Already present
  1728→      }
  1729→    }
  1730→
  1731→    // Add to gitignore
  1732→    const newContent =
  1733→      content.endsWith("\n") || content === ""
  1734→        ? `${content}${entry}\n`
  1735→        : `${content}\n${entry}\n`;
  1736→
  1737→    await fs.writeFile(gitignorePath, newContent, "utf-8");
  1738→
  1739→    // Commit the change
  1740→    await commitGitignore(projectRoot, directoryName);
  1741→
  1742→    return true;
  1743→  } catch (error) {
  1744→    if (error instanceof ShadowError) {
  1745→      throw error;
  1746→    }
  1747→    throw new ShadowError(
  1748→      `Failed to update .gitignore: ${error}`,
  1749→      "GIT_ERROR",
  1750→      "Check file permissions for .gitignore",
  1751→    );
  1752→  }
  1753→}
  1754→
  1755→/**
  1756→ * Generate initial manifest content for shadow branch
  1757→ */
  1758→function generateShadowManifest(projectName: string): string {
  1759→  return `# ${projectName} - Kynetic Spec
  1760→# Generated by kspec init
  1761→
  1762→kynetic: "1.0"
  1763→
  1764→project:
  1765→  name: "${projectName}"
  1766→  version: "0.1.0"
  1767→  status: draft
  1768→  description: |
  1769→    Add your project description here.
  1770→
  1771→# Module includes
  1772→includes:
  1773→  - modules/main.yaml
  1774→`;
  1775→}
  1776→
  1777→/**
  1778→ * Generate initial module content
  1779→ */
  1780→function generateShadowModule(projectName: string): string {
  1781→  return `# ${projectName} - Main Module
  1782→# Add your spec items here
  1783→
  1784→items: []
  1785→`;
  1786→}
  1787→
  1788→/**
  1789→ * Generate initial tasks file
  1790→ */
  1791→function generateShadowTasks(projectName: string): string {
  1792→  return `# ${projectName} - Tasks
  1793→# Track implementation work here
  1794→
  1795→tasks: []
  1796→`;
  1797→}
  1798→
  1799→/**
  1800→ * Generate initial inbox file
  1801→ */
  1802→function generateShadowInbox(): string {
  1803→  return `# Inbox - Quick Capture
  1804→# Ideas and notes that haven't been triaged yet
  1805→
  1806→items: []
  1807→`;
  1808→}
  1809→
  1810→/**
  1811→ * Get the kspec package root directory.
  1812→ * Navigates from dist/parser/ to package root.
  1813→ */
  1814→function getPackageRoot(): string {
  1815→  return path.resolve(__dirname, "..", "..");
  1816→}
  1817→
  1818→/**
  1819→ * Install pre-commit hook to protect kspec-meta branch.
  1820→ * Hook prevents direct commits to shadow branch unless KSPEC_SHADOW_COMMIT=1.
  1821→ *
  1822→ * Note: Git worktrees use hooks from the main .git/hooks directory (via commondir),
  1823→ * not from .git/worktrees/-kspec/hooks. So we install to main hooks directory.
  1824→ *
  1825→ * The hook source is located in the kspec package's templates/hooks/ directory.
  1826→ *
  1827→ * @param projectRoot Git repository root
  1828→ * @returns true if hook was installed, false if already exists
  1829→ */
  1830→async function installShadowHook(projectRoot: string): Promise<boolean> {
  1831→  const hooksDir = path.join(projectRoot, ".git", "hooks");
  1832→  const hookPath = path.join(hooksDir, "pre-commit");
  1833→
  1834→  // Look for hook in package templates directory
  1835→  const packageRoot = getPackageRoot();
  1836→  const sourceHookPath = path.join(packageRoot, "templates", "hooks", "pre-commit");
  1837→
  1838→  try {
  1839→    // Check if source hook exists in package templates
  1840→    try {
  1841→      await fs.access(sourceHookPath);
  1842→    } catch {
  1843→      // Source hook doesn't exist - skip installation
  1844→      return false;
  1845→    }
  1846→
  1847→    // Check if hook already exists
  1848→    try {
  1849→      await fs.access(hookPath);
  1850→      // Hook exists - don't overwrite (user may have custom hooks)
  1851→      return false;
  1852→    } catch {
  1853→      // Hook doesn't exist - install it
  1854→    }
  1855→
  1856→    // Copy hook from package templates
  1857→    const hookContent = await fs.readFile(sourceHookPath, "utf-8");
  1858→    await fs.writeFile(hookPath, hookContent, { mode: 0o755 });
  1859→    return true;
  1860→  } catch (_error) {
  1861→    // Silently fail - hook installation is optional
  1862→    return false;
  1863→  }
  1864→}
  1865→
  1866→/**
  1867→ * Convert project name to slug (kebab-case)
  1868→ */
  1869→function toSlug(projectName: string): string {
  1870→  return projectName
  1871→    .toLowerCase()
  1872→    .replace(/[^a-z0-9]+/g, "-")
  1873→    .replace(/^-|-$/g, "");
  1874→}
  1875→
  1876→/**
  1877→ * Configure git merge driver for kspec YAML files.
  1878→ * AC: @yaml-merge-driver ac-12
  1879→ *
  1880→ * Configures the merge driver in .git/config and adds .gitattributes in the shadow branch.
  1881→ *
  1882→ * @param projectRoot Git repository root
  1883→ * @param worktreeDir Path to shadow worktree directory
  1884→ * @returns true if configuration was successful
  1885→ */
  1886→async function configureMergeDriver(
  1887→  projectRoot: string,
  1888→  worktreeDir: string,
  1889→): Promise<boolean> {
  1890→  try {
  1891→    // Step 1: Configure merge driver in .git/config
  1892→    const kspecPathResult = runCommandSync("which", ["kspec"]);
  1893→    if (!kspecPathResult.ok) {
  1894→      throw new Error(kspecPathResult.stderr || "kspec executable not found");
  1895→    }
  1896→    const kspecPath = kspecPathResult.stdout.trim();
  1897→
  1898→    // Add merge driver configuration to git config
  1899→    try {
  1900→      const setNameResult = runCommandSync(
  1901→        "git",
  1902→        ["config", "merge.kspec.name", "Kspec YAML semantic merge driver"],
  1903→        { cwd: projectRoot },
  1904→      );
  1905→      if (!setNameResult.ok) {
  1906→        throw new Error(setNameResult.stderr || "failed to set merge.kspec.name");
  1907→      }
  1908→
  1909→      const setDriverResult = runCommandSync(
  1910→        "git",
  1911→        [
  1912→          "config",
  1913→          "merge.kspec.driver",
  1914→          `${kspecPath} merge-driver %O %A %B --non-interactive`,
  1915→        ],
  1916→        { cwd: projectRoot },
  1917→      );
  1918→      if (!setDriverResult.ok) {
  1919→        throw new Error(setDriverResult.stderr || "failed to set merge.kspec.driver");
  1920→      }
  1921→    } catch (error) {
  1922→      // Config may fail if already set - check if it's set correctly
  1923→      try {
  1924→        const existingDriverResult = runCommandSync(
  1925→          "git",
  1926→          ["config", "merge.kspec.driver"],
  1927→          { cwd: projectRoot },
  1928→        );
  1929→        if (!existingDriverResult.ok) {
  1930→          throw new Error(existingDriverResult.stderr || "failed to read merge.kspec.driver");
  1931→        }
  1932→        const existingDriver = existingDriverResult.stdout.trim();
  1933→
  1934→        if (!existingDriver.includes("kspec merge-driver")) {
  1935→          throw new Error("Merge driver config exists but is incorrect");
  1936→        }
  1937→
  1938→        // Ensure --non-interactive flag is present (older registrations may lack it)
  1939→        if (!existingDriver.includes("--non-interactive")) {
  1940→          const fixResult = runCommandSync(
  1941→            "git",
  1942→            [
  1943→              "config",
  1944→              "merge.kspec.driver",
  1945→              `${kspecPath} merge-driver %O %A %B --non-interactive`,
  1946→            ],
  1947→            { cwd: projectRoot },
  1948→          );
  1949→          if (!fixResult.ok) {
  1950→            throw new Error(
  1951→              fixResult.stderr || "failed to update merge.kspec.driver with --non-interactive",
  1952→            );
  1953→          }
  1954→        }
  1955→      } catch {
  1956→        throw error; // Re-throw original error
  1957→      }
  1958→    }
  1959→
  1960→    // Step 2: Create .gitattributes in shadow branch
  1961→    const gitattributesPath = path.join(worktreeDir, ".gitattributes");
  1962→
  1963→    // Check if .gitattributes exists
  1964→    let existingContent = "";
  1965→    try {
  1966→      existingContent = await fs.readFile(gitattributesPath, "utf-8");
  1967→    } catch {
  1968→      // File doesn't exist, that's fine
  1969→    }
  1970→
  1971→    // Check if merge driver is already configured
  1972→    if (!existingContent.includes("merge=kspec")) {
  1973→      const attributesContent = existingContent
  1974→        ? existingContent + "\n"
  1975→        : "# Git attributes for kspec\n\n";
  1976→
  1977→      await fs.writeFile(
  1978→        gitattributesPath,
  1979→        attributesContent + "*.yaml merge=kspec\n*.yml merge=kspec\n",
  1980→        "utf-8",
  1981→      );
  1982→
  1983→      // Commit .gitattributes to shadow branch
  1984→      await shadowAutoCommit(worktreeDir, "Configure kspec merge driver");
  1985→    }
  1986→
  1987→    return true;
  1988→  } catch (_error) {
  1989→    // Silently fail - merge driver configuration is optional
  1990→    return false;
  1991→  }
  1992→}
  1993→
  1994→/**
  1995→ * Initialize shadow branch and worktree.
  1996→ * Creates orphan branch, worktree, updates gitignore, and creates initial structure.
  1997→ *
  1998→ * AC: @config-shadow ac-1 — creates orphan branch with configured name
  1999→ * AC: @config-shadow ac-2 — creates worktree at configured directory
  2000→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
  2001→ *
  2002→ * @param projectRoot Git repository root
  2003→ * @param options Initialization options
  2004→ * @returns Result indicating what was created
  2005→ */
  2006→export async function initializeShadow(
  2007→  projectRoot: string,
  2008→  options: ShadowInitOptions = {},
  2009→): Promise<ShadowInitResult> {
  2010→  const result: ShadowInitResult = {
  2011→    success: false,
  2012→    branchCreated: false,
  2013→    worktreeCreated: false,
  2014→    gitignoreUpdated: false,
  2015→    initialCommit: false,
  2016→    alreadyExists: false,
  2017→    createdFromRemote: false,
  2018→    pushedToRemote: false,
  2019→  };
  2020→
  2021→  // Check if we're in a git repo
  2022→  if (!(await isGitRepo(projectRoot))) {
  2023→    result.error = "Not a git repository";
  2024→    return result;
  2025→  }
  2026→
  2027→  // AC: ac-1 ac-2 — use configured branch/directory or defaults
  2028→  const branchName = getBranchName(options.shadow);
  2029→  const directoryName = getDirectoryName(options.shadow);
  2030→  const worktreeDir = path.join(projectRoot, directoryName);
  2031→
  2032→  // Check current status with configured options
  2033→  const status = await getShadowStatus(projectRoot, options.shadow);
  2034→
  2035→  // Handle existing shadow branch
  2036→  if (status.healthy && !options.force) {
  2037→    result.alreadyExists = true;
  2038→    result.success = true;
  2039→    return result;
  2040→  }
  2041→
  2042→  // Derive project name if not provided
  2043→  const projectName =
  2044→    options.projectName ||
  2045→    path
  2046→      .basename(projectRoot)
  2047→      .replace(/[-_]/g, " ")
  2048→      .replace(/\b\w/g, (c) => c.toUpperCase());
  2049→
  2050→  const slug = toSlug(projectName);
  2051→
  2052→  // Determine remote name to use
  2053→  let remoteName = "origin";
  2054→  if (options.shadow?.remote && options.shadow.remoteType === "named") {
  2055→    remoteName = options.shadow.remote;
  2056→  }
  2057→
  2058→  // Check for remote shadow branch
  2059→  // AC: @shadow-init-remote ac-4 ac-5 — queries remote directly via ls-remote
  2060→  const remoteExists = await hasRemote(projectRoot, remoteName);
  2061→  let remoteHasShadow = false;
  2062→  if (remoteExists) {
  2063→    remoteHasShadow = await remoteBranchExists(projectRoot, branchName, remoteName);
  2064→  }
  2065→
  2066→  try {
  2067→    // Step 1: Update .gitignore first (before creating worktree)
  2068→    result.gitignoreUpdated = await ensureGitignore(projectRoot, options.shadow);
  2069→
  2070→    // Step 2: Create worktree with orphan branch (or attach to existing branch)
  2071→    if (!status.worktreeExists || !status.worktreeLinked) {
  2072→      // Remove existing directory if present but not linked
  2073→      if (status.worktreeExists && !status.worktreeLinked) {
  2074→        await fs.rm(worktreeDir, { recursive: true, force: true });
  2075→      }
  2076→
  2077→      // Remove stale worktree reference if any
  2078→      try {
  2079→        await runGitAsync(projectRoot, [
  2080→          "worktree",
  2081→          "remove",
  2082→          directoryName,
  2083→          "--force",
  2084→        ]);
  2085→      } catch {
  2086→        // Ignore - worktree may not exist in git's list
  2087→      }
  2088→
  2089→      if (remoteHasShadow) {
  2090→        // AC: @shadow-init-remote ac-1, ac-5 - Remote has shadow branch - fetch and create worktree
  2091→        // Fetch with refspec to create a local branch ref (required in shallow clones
  2092→        // where plain `git fetch origin kspec-meta` only populates FETCH_HEAD)
  2093→        await runGitAsync(projectRoot, [
  2094→          "fetch",
  2095→          remoteName,
  2096→          `${branchName}:${branchName}`,
  2097→        ]);
  2098→        await runGitAsync(projectRoot, [
  2099→          "worktree",
  2100→          "add",
  2101→          directoryName,
  2102→          branchName,
  2103→        ]);
  2104→        // Set up tracking for the branch
  2105→        // Use git config directly — `git branch --set-upstream-to` requires
  2106→        // the remote tracking ref to exist locally, which may not be the case
  2107→        // in shallow clones where we only fetched the branch itself
  2108→        await runGitAsync(projectRoot, [
  2109→          "config",
  2110→          `branch.${branchName}.remote`,
  2111→          remoteName,
  2112→        ]);
  2113→        await runGitAsync(projectRoot, [
  2114→          "config",
  2115→          `branch.${branchName}.merge`,
  2116→          `refs/heads/${branchName}`,
  2117→        ]);
  2118→        result.createdFromRemote = true;
  2119→      } else if (!status.branchExists) {
  2120→        // AC: @shadow-init-remote ac-2 ac-3 - No remote branch or no remote - create orphan branch
  2121→        // AC: @config-shadow ac-1 — use configured branch name
  2122→        // AC: @config-shadow ac-10 — fallback for git < 2.42
  2123→        if (gitSupportsOrphanWorktree(projectRoot)) {
  2124→          await runGitAsync(projectRoot, [
  2125→            "worktree",
  2126→            "add",
  2127→            "--orphan",
  2128→            "-b",
  2129→            branchName,
  2130→            directoryName,
  2131→          ]);
  2132→        } else {
  2133→          await createOrphanBranchFallback(
  2134→            projectRoot,
  2135→            branchName,
  2136→            directoryName,
  2137→          );
  2138→        }
  2139→        result.branchCreated = true;
  2140→      } else {
  2141→        // Attach to existing local branch
  2142→        await runGitAsync(projectRoot, [
  2143→          "worktree",
  2144→          "add",
  2145→          directoryName,
  2146→          branchName,
  2147→        ]);
  2148→      }
  2149→
  2150→      result.worktreeCreated = true;
  2151→    }
  2152→
  2153→    // Step 3: Create initial structure if empty (only for new branches, not remote)
  2154→    const manifestPath = path.join(worktreeDir, `${slug}.yaml`);
  2155→    const modulesDir = path.join(worktreeDir, "modules");
  2156→    const moduleFilePath = path.join(modulesDir, "main.yaml");
  2157→    const tasksPath = path.join(worktreeDir, `${slug}.tasks.yaml`);
  2158→    const inboxPath = path.join(worktreeDir, `${slug}.inbox.yaml`);
  2159→
  2160→    let filesCreated = false;
  2161→
  2162→    // Only create files if manifest doesn't exist (remote branches will have files)
  2163→    try {
  2164→      // Look for any .yaml manifest file (project name may differ)
  2165→      const files = await fs.readdir(worktreeDir);
  2166→      const hasManifest = files.some(
  2167→        (f) =>
  2168→          f.endsWith(".yaml") &&
  2169→          !f.includes(".tasks.") &&
  2170→          !f.includes(".inbox."),
  2171→      );
  2172→      if (!hasManifest) {
  2173→        throw new Error("No manifest found");
  2174→      }
  2175→    } catch {
  2176→      // Manifest doesn't exist, create initial structure
  2177→      await fs.mkdir(modulesDir, { recursive: true });
  2178→      await fs.writeFile(
  2179→        manifestPath,
  2180→        generateShadowManifest(projectName),
  2181→        "utf-8",
  2182→      );
  2183→      await fs.writeFile(
  2184→        moduleFilePath,
  2185→        generateShadowModule(projectName),
  2186→        "utf-8",
  2187→      );
  2188→      await fs.writeFile(tasksPath, generateShadowTasks(projectName), "utf-8");
  2189→      await fs.writeFile(inboxPath, generateShadowInbox(), "utf-8");
  2190→
  2191→      // AC: @artifacts-directory ac-init-creates, ac-gitignore-entry
  2192→      const artifactsDir = path.join(worktreeDir, "artifacts");
  2193→      await fs.mkdir(artifactsDir, { recursive: true });
  2194→      await fs.writeFile(
  2195→        path.join(worktreeDir, ".gitignore"),
  2196→        "# Ephemeral artifacts - reports, exports, generated files\n# Not tracked in shadow branch\nartifacts/\n",
  2197→        "utf-8",
  2198→      );
  2199→
  2200→      filesCreated = true;
  2201→    }
  2202→
  2203→    // Step 4: Initial commit if files were created
  2204→    if (filesCreated) {
  2205→      result.initialCommit = await shadowAutoCommit(
  2206→        worktreeDir,
  2207→        `Initialize ${projectName} spec`,
  2208→      );
  2209→    }
  2210→
  2211→    // Step 5: AC-2: Push new branch to remote to establish tracking
  2212→    if (result.branchCreated && remoteExists && !remoteHasShadow) {
  2213→      result.pushedToRemote = await pushShadowBranch(worktreeDir, remoteName, options.shadow);
  2214→    }
  2215→
  2216→    // Step 6: Install pre-commit hook to protect shadow branch
  2217→    await installShadowHook(projectRoot);
  2218→
  2219→    // Step 7: Configure merge driver for semantic YAML merging
  2220→    // AC: @yaml-merge-driver ac-12
  2221→    await configureMergeDriver(projectRoot, worktreeDir);
  2222→
  2223→    result.success = true;
  2224→    return result;
  2225→  } catch (error) {
  2226→    result.error = error instanceof Error ? error.message : String(error);
  2227→    return result;
  2228→  }
  2229→}
  2230→
  2231→/**
  2232→ * Repair a broken shadow branch setup.
  2233→ * Handles cases where worktree is disconnected or directory is missing.
  2234→ *
  2235→ * AC: @config-shadow ac-7 — backward compat when called without config
  2236→ *
  2237→ * @param projectRoot Git repository root
  2238→ * @param options Optional shadow configuration
  2239→ * @returns Result indicating what was repaired
  2240→ */
  2241→export async function repairShadow(
  2242→  projectRoot: string,
  2243→  options?: ShadowOptions,
  2244→): Promise<ShadowInitResult> {
  2245→  const branchName = getBranchName(options);
  2246→  const directoryName = getDirectoryName(options);
  2247→  const status = await getShadowStatus(projectRoot, options);
  2248→
  2249→  if (status.healthy) {
  2250→    return {
  2251→      success: true,
  2252→      branchCreated: false,
  2253→      worktreeCreated: false,
  2254→      gitignoreUpdated: false,
  2255→      initialCommit: false,
  2256→      alreadyExists: true,
  2257→      createdFromRemote: false,
  2258→      pushedToRemote: false,
  2259→    };
  2260→  }
  2261→
  2262→  if (!status.branchExists) {
  2263→    // Can't repair without a branch - need full init
  2264→    return {
  2265→      success: false,
  2266→      branchCreated: false,
  2267→      worktreeCreated: false,
  2268→      gitignoreUpdated: false,
  2269→      initialCommit: false,
  2270→      alreadyExists: false,
  2271→      createdFromRemote: false,
  2272→      pushedToRemote: false,
  2273→      error: "Shadow branch does not exist. Run `kspec init` instead.",
  2274→    };
  2275→  }
  2276→
  2277→  // Branch exists but worktree is broken - repair it
  2278→  const worktreeDir = path.join(projectRoot, directoryName);
  2279→
  2280→  try {
  2281→    // Remove stale worktree reference
  2282→    try {
  2283→      await runGitAsync(projectRoot, [
  2284→        "worktree",
  2285→        "remove",
  2286→        directoryName,
  2287→        "--force",
  2288→      ]);
  2289→    } catch {
  2290→      // Ignore - worktree may not be in git's list
  2291→    }
  2292→
  2293→    // Remove directory if exists (handles corrupted .git file case)
  2294→    await fs.rm(worktreeDir, { recursive: true, force: true });
  2295→
  2296→    // Prune stale worktree references (cleans up orphaned entries)
  2297→    try {
  2298→      await runGitAsync(projectRoot, ["worktree", "prune"]);
  2299→    } catch {
  2300→      // Ignore - prune is best-effort
  2301→    }
  2302→
  2303→    // Recreate worktree
  2304→    await runGitAsync(projectRoot, [
  2305→      "worktree",
  2306→      "add",
  2307→      directoryName,
  2308→      branchName,
  2309→    ]);
  2310→
  2311→    // Install pre-commit hook
  2312→    await installShadowHook(projectRoot);
  2313→
  2314→    // AC: @artifacts-directory ac-repair-recreates
  2315→    const artifactsDir = path.join(worktreeDir, "artifacts");
  2316→    await fs.mkdir(artifactsDir, { recursive: true });
  2317→
  2318→    return {
  2319→      success: true,
  2320→      branchCreated: false,
  2321→      worktreeCreated: true,
  2322→      gitignoreUpdated: false,
  2323→      initialCommit: false,
  2324→      alreadyExists: false,
  2325→      createdFromRemote: false,
  2326→      pushedToRemote: false,
  2327→    };
  2328→  } catch (error) {
  2329→    return {
  2330→      success: false,
  2331→      branchCreated: false,
  2332→      worktreeCreated: false,
  2333→      gitignoreUpdated: false,
  2334→      initialCommit: false,
  2335→      alreadyExists: false,
  2336→      createdFromRemote: false,
  2337→      pushedToRemote: false,
  2338→      error: error instanceof Error ? error.message : String(error),
  2339→    };
  2340→  }
  2341→}
  2342→
```