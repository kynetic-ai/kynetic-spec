    49→
    50→/**
    51→ * Format a spec item for display
    52→ */
    53→function formatItem(
    54→  item: LoadedSpecItem,
    55→  refIndex: ReferenceIndex,
    56→  verbose = false,
    57→  grepPattern?: string,
    58→): string {
    59→  const shortId = refIndex.shortUlid(item._ulid);
    60→  const slugStr = item.slugs.length > 0 ? chalk.cyan(`@${item.slugs[0]}`) : "";
    61→  const typeStr = chalk.gray(`[${item.type}]`);
    62→
    63→  let status = "";
    64→  if (item.status && typeof item.status === "object") {
    65→    const s = item.status as { maturity?: string; implementation?: string };
    66→    if (s.implementation) {
    67→      const implColor =
    68→        s.implementation === "verified"
    69→          ? chalk.green
    70→          : s.implementation === "implemented"
    71→            ? chalk.cyan
    72→            : s.implementation === "in_progress"
    73→              ? chalk.yellow
    74→              : chalk.gray;
    75→      status = implColor(s.implementation);
    76→    } else if (s.maturity) {
    77→      status = chalk.gray(s.maturity);
    78→    }
    79→  }
    80→
    81→  let line = `${chalk.gray(shortId)} ${typeStr} ${item.title}`;
    82→  if (slugStr) line += ` ${slugStr}`;
    83→  if (status) line += ` ${status}`;
    84→
    85→  if (verbose) {
    86→    const tags = "tags" in item && Array.isArray(item.tags) ? item.tags : [];
    87→    if (tags.length > 0) {
    88→      line += chalk.blue(` #${tags.join(" #")}`);
    89→    }
    90→  }
    91→
    92→  // Show matched fields if grep pattern provided
    93→  if (grepPattern) {
    94→    const match = grepItem(
    95→      item as unknown as Record<string, unknown>,
    96→      grepPattern,
    97→    );
    98→    if (match && match.matchedFields.length > 0) {
    99→      line +=
   100→        "\n  " +
   101→        chalk.gray(`matched: ${formatMatchedFields(match.matchedFields)}`);
   102→    }
   103→  }
   104→
   105→  return line;
   106→}
   107→
   108→/**
   109→ * Format item list for display
   110→ */
   111→function formatItemList(
   112→  items: LoadedSpecItem[],
   113→  refIndex: ReferenceIndex,
   114→  verbose = false,
   115→  grepPattern?: string,
   116→): void {
   117→  if (items.length === 0) {
   118→    console.log(chalk.gray("No items found"));
   119→    return;
   120→  }
   121→
   122→  for (const item of items) {
   123→    console.log(formatItem(item, refIndex, verbose, grepPattern));
   124→  }
   125→
   126→  console.log(chalk.gray(`\n${items.length} item(s)`));
   127→}
   128→
   129→/**
   130→ * Format item list as a tree showing parent/child hierarchy
   131→ */
   132→function formatItemTree(
   133→  items: LoadedSpecItem[],
   134→  refIndex: ReferenceIndex,
   135→  verbose = false,
   136→  grepPattern?: string,
   137→): void {
   138→  if (items.length === 0) {
   139→    console.log(chalk.gray("No items found"));
   140→    return;
   141→  }
   142→
   143→  // Build parent-child map
   144→  const childrenMap = new Map<string, LoadedSpecItem[]>();
   145→  const rootItems: LoadedSpecItem[] = [];
   146→
   147→  for (const item of items) {
   148→    const path = item._path || "";
   149→
   150→    // Determine parent path
   151→    let parentPath = "";
   152→    if (path) {
   153→      // Extract parent path from current path
   154→      // e.g., "features[0].requirements[1]" -> "features[0]"
   155→      const lastDotIndex = path.lastIndexOf(".");
   156→      if (lastDotIndex !== -1) {
   157→        parentPath = path.substring(0, lastDotIndex);
   158→      }
   159→    }
   160→
   161→    if (parentPath === "") {
   162→      // Root level item
   163→      rootItems.push(item);
   164→    } else {
   165→      // Find parent by path
   166→      const parent = items.find((i) => i._path === parentPath);
   167→      if (parent) {
   168→        const parentUlid = parent._ulid;
   169→        if (!childrenMap.has(parentUlid)) {
   170→          childrenMap.set(parentUlid, []);
   171→        }
   172→        childrenMap.get(parentUlid)?.push(item);
   173→      } else {
   174→        // Parent not in filtered list, show at root
   175→        rootItems.push(item);
   176→      }
   177→    }
   178→  }
   179→
   180→  // Recursive function to print tree
   181→  function printTree(item: LoadedSpecItem, prefix = "", isLast = true): void {
   182→    // Print current item with tree prefix
   183→    const connector = isLast ? "└── " : "├── ";
   184→    const itemLine = formatItem(item, refIndex, verbose, grepPattern);
   185→    console.log(prefix + connector + itemLine);
   186→
   187→    // Print children
   188→    const children = childrenMap.get(item._ulid) || [];
   189→    const childPrefix = prefix + (isLast ? "    " : "│   ");
   190→
   191→    children.forEach((child, index) => {
   192→      const isLastChild = index === children.length - 1;
   193→      printTree(child, childPrefix, isLastChild);
   194→    });
   195→  }
   196→
   197→  // Print all root items
   198→  rootItems.forEach((item, index) => {
   199→    const isLast = index === rootItems.length - 1;
   200→    printTree(item, "", isLast);
   201→  });
   202→
   203→  console.log(chalk.gray(`\n${items.length} item(s)`));
   204→}
   205→
   206→/**
   207→ * Handle cascading status updates to child items
   208→ * Returns array of updated child items
   209→ */
   210→async function handleStatusCascade(
   211→  ctx: Awaited<ReturnType<typeof initContext>>,
   212→  parent: LoadedSpecItem,
   213→  newStatus: string,
   214→  allItems: LoadedSpecItem[],
   215→  refIndex: ReferenceIndex,
   216→): Promise<LoadedSpecItem[]> {
   217→  // Find direct children
   218→  const children = findChildItems(parent, allItems);
   219→
   220→  if (children.length === 0) {
   221→    return [];
   222→  }
   223→
   224→  // Skip prompt in JSON mode
   225→  if (isJsonMode()) {
   226→    return [];
   227→  }
   228→
   229→  // Prompt user for cascade
   230→  const readline = await import("node:readline");
   231→  const rl = readline.createInterface({
   232→    input: process.stdin,
   233→    output: process.stdout,
   234→  });
   235→
   236→  const answer = await new Promise<string>((resolve) => {
   237→    rl.question(
   238→      `Update ${children.length} child item(s) to ${newStatus}? [y/n] `,
   239→      resolve,
   240→    );
   241→  });
   242→  rl.close();
   243→
   244→  if (answer.toLowerCase() !== "y") {
   245→    return [];
   246→  }
   247→
   248→  // Update children
   249→  const updatedChildren: LoadedSpecItem[] = [];
   250→  for (const child of children) {
   251→    const currentStatus =
   252→      child.status && typeof child.status === "object"
   253→        ? child.status
   254→        : {
   255→            maturity: "draft" as const,
   256→            implementation: "not_started" as const,
   257→          };
   258→
   259→    const updates = {
   260→      status: {
   261→        maturity: currentStatus.maturity || ("draft" as const),
   262→        implementation: newStatus as ImplementationStatus,
   263→      },
   264→    };
   265→
   266→    const updated = await updateSpecItem(ctx, child, updates);
   267→    updatedChildren.push(updated);
   268→
   269→    // Log each child update (non-JSON mode only)
   270→    const childRef = child.slugs[0] || refIndex.shortUlid(child._ulid);
   271→    console.log(chalk.gray(`  ✓ Updated @${childRef}`));
   272→  }
   273→
   274→  return updatedChildren;
   275→}
   276→
   277→/**
   278→ * Register item commands
   279→ */
   280→export function registerItemCommands(program: Command): void {
   281→  const item = program.command("item").description("Spec item commands");
   282→
   283→  // kspec item list
   284→  item
   285→    .command("list")
   286→    .description("List spec items with optional filters")
   287→    .option(
   288→      "-t, --type <type>",
   289→      "Filter by item type (module, feature, requirement, constraint, decision)",
   290→    )
   291→    .option(
   292→      "-s, --status <status>",
   293→      "Filter by implementation status (not_started, in_progress, implemented, verified)",
   294→    )
   295→    .option(
   296→      "-m, --maturity <maturity>",
   297→      "Filter by maturity (draft, proposed, stable, deferred, deprecated)",
   298→    )
   299→    .option(
   300→      "--tag <tag>",
   301→      "Filter by tag (can specify multiple)",
   302→      (val, prev: string[]) => [...prev, val],
   303→      [],
   304→    )
   305→    .option(
   306→      "--has <field>",
   307→      "Filter items that have field present",
   308→      (val, prev: string[]) => [...prev, val],
   309→      [],
   310→    )
   311→    .option("-q, --search <text>", "Search in title")
   312→    .option("-g, --grep <pattern>", "Search content with regex pattern")
   313→    .option("-v, --verbose", "Show more details")
   314→    .option("--tree", "Show parent/child hierarchy")
   315→    .option("--under <ref>", "Scope to descendants of a module or parent item")
   316→    .option("--limit <n>", "Limit results", "50")
   317→    .option("--count", "Show only the count of matching items")
   318→    .action(async (options) => {
   319→      try {
   320→        const ctx = await initContext();
   321→        const { itemIndex, items, refIndex } = await buildIndexes(ctx);
   322→
   323→        // Build filter from options
   324→        const filter: ItemFilter = {
   325→          specItemsOnly: true, // Only spec items, not tasks
   326→        };
   327→
   328→        if (options.type) {
   329→          filter.type = options.type as ItemType;
   330→        }
   331→
   332→        // AC: @multi-value-status-filter ac-item-list-parity, ac-invalid-item-status
   333→        if (options.status) {
   334→          const { parseMultiStatus } = await import("./tasks.js");
   335→          const statuses = parseMultiStatus(
   336→            options.status,
   337→            ImplementationStatusSchema.options,
   338→            "implementation status",
   339→          );
   340→          if (statuses) {
   341→            filter.implementation = statuses.length === 1 ? statuses[0] : statuses;
   342→          }
   343→        }
   344→
   345→        if (options.maturity) {
   346→          filter.maturity = options.maturity as Maturity;
   347→        }
   348→
   349→        if (options.tag && options.tag.length > 0) {
   350→          filter.tags = parseTagsArray(options.tag);
   351→        }
   352→
   353→        if (options.has && options.has.length > 0) {
   354→          filter.hasFields = options.has;
   355→        }
   356→
   357→        if (options.search) {
   358→          filter.titleContains = options.search;
   359→        }
   360→
   361→        if (options.grep) {
   362→          filter.grepSearch = options.grep;
   363→        }
   364→
   365→        // AC: @module-scoped-item-listing ac-under-filter, ac-under-invalid-ref
   366→        // Handle --under: scope to descendants of a module or parent item
   367→        let underRoot: LoadedSpecItem | undefined;
   368→        let underDescendantUlids: Set<string> | undefined;
   369→        if (options.under) {
   370→          const underResult = refIndex.resolve(options.under);
   371→          if (!underResult.ok) {
   372→            // AC: @module-scoped-item-listing ac-under-invalid-ref
   373→            error(`Reference not found: ${options.under}. Check with: kspec item get ${options.under}`);
   374→            process.exit(EXIT_CODES.NOT_FOUND);
   375→          }
   376→          underRoot = underResult.item as LoadedSpecItem;
   377→          // Check it's not a task
   378→          if ("status" in underRoot && typeof underRoot.status === "string") {
   379→            error(`Reference ${options.under} is a task, not a spec item`);
   380→            process.exit(EXIT_CODES.USAGE_ERROR);
   381→          }
   382→          // AC: @module-scoped-item-listing ac-nested-descendants
   383→          // Find all descendants based on _path and _sourceFile
   384→          const descendants = findDescendantItems(underRoot, items);
   385→          underDescendantUlids = new Set([underRoot._ulid, ...descendants.map(d => d._ulid)]);
   386→        }
   387→
   388→        const limit = parseInt(options.limit, 10) || 50;
   389→
   390→        // When --under is used, we need to get all items first, then filter by scope,
   391→        // because pagination before scoping could miss items
   392→        let specItems: LoadedSpecItem[];
   393→        let effectiveTotal: number;
   394→
   395→        if (underDescendantUlids) {
   396→          // AC: @module-scoped-item-listing ac-under-filter, ac-under-with-other-filters
   397→          // Get all items matching filters, then scope to descendants
   398→          const allResults = itemIndex.query(filter);
   399→          const allSpecItems = allResults.filter(
   400→            (item): item is LoadedSpecItem =>
   401→              !("status" in item && typeof item.status === "string"),
   402→          );
   403→          // Apply --under filtering (AND logic with other filters)
   404→          const scopedItems = allSpecItems.filter(item => underDescendantUlids!.has(item._ulid));
   405→          effectiveTotal = scopedItems.length;
   406→          specItems = scopedItems.slice(0, limit);
   407→        } else {
   408→          const result = itemIndex.queryPaginated(filter, 0, limit);
   409→          // Filter to only LoadedSpecItem (not tasks)
   410→          specItems = result.items.filter(
   411→            (item): item is LoadedSpecItem =>
   412→              !("status" in item && typeof item.status === "string"),
   413→          );
   414→          effectiveTotal = result.total;
   415→        }
   416→
   417→        // AC: @module-scoped-item-listing ac-count-with-under
   418→        // AC: @trait-filterable-list ac-8
   419→        if (options.count) {
   420→          output({ count: effectiveTotal }, () => {
   421→            console.log(effectiveTotal);
   422→          });
   423→          return;
   424→        }
   425→
   426→        output(
   427→          {
   428→            items: specItems,
   429→            total: effectiveTotal,
   430→            showing: specItems.length,
   431→            grepPattern: options.grep,
   432→            tree: options.tree,
   433→            under: options.under,
   434→          },
   435→          () => {
   436→            if (options.tree) {
   437→              // AC: @module-scoped-item-listing ac-under-with-tree
   438→              formatItemTree(specItems, refIndex, options.verbose, options.grep);
   439→            } else {
   440→              formatItemList(specItems, refIndex, options.verbose, options.grep);
   441→            }
   442→          },
   443→        );
   444→      } catch (err) {
   445→        error(errors.failures.listItems, err);
   446→        process.exit(EXIT_CODES.ERROR);
   447→      }
   448→    });
   449→
   450→  // kspec item get <ref>
   451→  item
   452→    .command("get <ref>")
   453→    .description("Get details for a specific item")
   454→    .action(async (ref) => {
   455→      try {
   456→        const ctx = await initContext();
   457→        const { refIndex, traitIndex, items } = await buildIndexes(ctx);
   458→
   459→        const result = refIndex.resolve(ref);
   460→
   461→        if (!result.ok) {
   462→          let notFoundMessage = errors.reference.itemNotFound(ref);
   463→          try {
   464→            const metaCtx = await loadMetaContext(ctx);
   465→            const resolvedMetaRef = resolveMetaRef(metaCtx, ref);
   466→            if (resolvedMetaRef?.type === "observation") {
   467→              notFoundMessage = `Item not found: ${ref}\nHint: ${ref} is an observation. Use: kspec meta observe get ${ref}`;
   468→            }
   469→          } catch {
   470→            // Fall back to the standard item-not-found error when meta context is unavailable.
   471→          }
   472→
   473→          error(notFoundMessage);
   474→          process.exit(EXIT_CODES.ERROR);
   475→        }
   476→
   477→        const item = result.item as LoadedSpecItem;
   478→
   479→        // AC: @trait-display ac-2 - JSON mode includes inherited_traits array
   480→        const inheritedTraits = traitIndex.getInheritedAC(item._ulid);
   481→        const traitsByTrait = new Map<
   482→          string,
   483→          {
   484→            trait: (typeof inheritedTraits)[0]["trait"];
   485→            acs: AcceptanceCriterion[];
   486→          }
   487→        >();
   488→        for (const { trait, ac } of inheritedTraits) {
   489→          if (!traitsByTrait.has(trait.ulid)) {
   490→            traitsByTrait.set(trait.ulid, { trait, acs: [] });
   491→          }
   492→          traitsByTrait.get(trait.ulid)?.acs.push(ac);
   493→        }
   494→
   495→        // Build JSON output with inherited traits
   496→        const jsonOutput = {
   497→          ...item,
   498→          inherited_traits: Array.from(traitsByTrait.values()).map(
   499→            ({ trait, acs }) => ({
   500→              ref: `@${trait.slug}`,
   501→              title: trait.title,
   502→              acceptance_criteria: acs,
   503→            }),
   504→          ),
   505→        };
   506→
   507→        output(jsonOutput, () => {
   508→          console.log(chalk.bold(item.title));
   509→          console.log(chalk.gray("─".repeat(40)));
   510→          console.log(`${fieldLabels.ulid}      ${item._ulid}`);
   511→          if (item.slugs.length > 0) {
   512→            console.log(`${fieldLabels.slugs}     ${item.slugs.join(", ")}`);
   513→          }
   514→          console.log(`${fieldLabels.type}      ${item.type}`);
   515→
   516→          if (item.status && typeof item.status === "object") {
   517→            const s = item.status as {
   518→              maturity?: string;
   519→              implementation?: string;
   520→            };
   521→            if (s.maturity)
   522→              console.log(`${fieldLabels.maturity}  ${s.maturity}`);
   523→            if (s.implementation) {
   524→              // AC: @trait-retrospective ac-4
   525→              // Show retrospective verification source
   526→              const isRetrospective = item.traits?.includes(
   527→                "@trait-retrospective",
   528→              );
   529→              const statusLabel = isRetrospective
   530→                ? `${s.implementation} (retrospective)`
   531→                : s.implementation;
   532→              console.log(`${fieldLabels.implementation}${statusLabel}`);
   533→            }
   534→          }
   535→
   536→          // AC: @trait-retrospective ac-4
   537→          // Show verification metadata for retrospective specs
   538→          const isRetrospective = item.traits?.includes("@trait-retrospective");
   539→          if (isRetrospective && (item.verified_at || item.verified_by)) {
   540→            const verifiedDate = item.verified_at
   541→              ? new Date(item.verified_at).toISOString().split("T")[0]
   542→              : "unknown";
   543→            const verifiedBy = item.verified_by || "unknown";
   544→            console.log(`Verified:   ${verifiedDate} by ${verifiedBy}`);
   545→          }
   546→
   547→          if (
   548→            "tags" in item &&
   549→            Array.isArray(item.tags) &&
   550→            item.tags.length > 0
   551→          ) {
   552→            console.log(`${fieldLabels.tags}      ${item.tags.join(", ")}`);
   553→          }
   554→
   555→          // AC: @item-get ac-4
   556→          if (Array.isArray(item.depends_on) && item.depends_on.length > 0) {
   557→            console.log(`${fieldLabels.dependsOn} ${item.depends_on.join(", ")}`);
   558→          }
   559→          if (Array.isArray(item.implements) && item.implements.length > 0) {
   560→            console.log(`${fieldLabels.implements} ${item.implements.join(", ")}`);
   561→          }
   562→          if (Array.isArray(item.relates_to) && item.relates_to.length > 0) {
   563→            console.log(`${fieldLabels.relatesTo} ${item.relates_to.join(", ")}`);
   564→          }
   565→
   566→          if (item.description) {
   567→            console.log(`\n${sectionHeaders.description}`);
   568→            console.log(item.description);
   569→          }
   570→
   571→          // AC: @trait-display ac-1 - Show own AC first
   572→          if (
   573→            "acceptance_criteria" in item &&
   574→            Array.isArray(item.acceptance_criteria) &&
   575→            item.acceptance_criteria.length > 0
   576→          ) {
   577→            console.log(`\n${sectionHeaders.acceptanceCriteria}`);
   578→            for (const ac of item.acceptance_criteria) {
   579→              if (ac && typeof ac === "object" && "id" in ac) {
   580→                const acObj = ac as AcceptanceCriterion;
   581→                console.log(chalk.cyan(`  [${acObj.id}]`));
   582→                if (acObj.given) console.log(`    Given: ${acObj.given}`);
   583→                if (acObj.when) console.log(`    When: ${acObj.when}`);
   584→                if (acObj.then) console.log(`    Then: ${acObj.then}`);
   585→              }
   586→            }
   587→          }
   588→
   589→          // AC: @trait-display ac-1, ac-4, ac-5 - Show inherited AC per trait in labeled sections
   590→          if (traitsByTrait.size > 0) {
   591→            for (const { trait, acs } of traitsByTrait.values()) {
   592→              console.log(
   593→                chalk.gray(`\n─── Inherited from @${trait.slug} ───`),
   594→              );
   595→              for (const ac of acs) {
   596→                console.log(
   597→                  chalk.cyan(`  [${ac.id}]`) +
   598→                    chalk.gray(` (from @${trait.slug})`),
   599→                );
   600→                if (ac.given) console.log(`    Given: ${ac.given}`);
   601→                if (ac.when) console.log(`    When: ${ac.when}`);
   602→                if (ac.then) console.log(`    Then: ${ac.then}`);
   603→              }
   604→            }
   605→          }
   606→        });
   607→      } catch (err) {
   608→        error(errors.failures.getItem, err);
   609→        process.exit(EXIT_CODES.ERROR);
   610→      }
   611→    });
   612→
   613→  // kspec item types - show available types and counts
   614→  item
   615→    .command("types")
   616→    .description("Show item types and counts")
   617→    .action(async () => {
   618→      try {
   619→        const ctx = await initContext();
   620→        const { itemIndex } = await buildIndexes(ctx);
   621→
   622→        const typeCounts = itemIndex.getTypeCounts();
   623→
   624→        output(Object.fromEntries(typeCounts), () => {
   625→          console.log(chalk.bold("Item Types"));
   626→          console.log(chalk.gray("─".repeat(30)));
   627→          for (const [type, count] of typeCounts) {
   628→            console.log(`  ${type}: ${count}`);
   629→          }
   630→          console.log(chalk.gray(`\nTotal: ${itemIndex.size} items`));
   631→        });
   632→      } catch (err) {
   633→        error(errors.failures.getTypes, err);
   634→        process.exit(EXIT_CODES.ERROR);
   635→      }
   636→    });
   637→
   638→  // kspec item tags - show available tags and counts
   639→  item
   640→    .command("tags")
   641→    .description("Show tags and counts")
   642→    .action(async () => {
   643→      try {
   644→        const ctx = await initContext();
   645→        const { itemIndex } = await buildIndexes(ctx);
   646→
   647→        const tagCounts = itemIndex.getTagCounts();
   648→
   649→        output(Object.fromEntries(tagCounts), () => {
   650→          console.log(chalk.bold("Tags"));
   651→          console.log(chalk.gray("─".repeat(30)));
   652→          for (const [tag, count] of tagCounts) {
   653→            console.log(`  #${tag}: ${count}`);
   654→          }
   655→        });
   656→      } catch (err) {
   657→        error(errors.failures.getTags, err);
   658→        process.exit(EXIT_CODES.ERROR);
   659→      }
   660→    });
   661→
   662→  // kspec item add - create a new spec item under a parent
   663→  markMutating(item.command("add"))
   664→    .description("Create a new spec item under a parent or in project root")
   665→    .option("--under <ref>", "Parent item reference (e.g., @core-primitives)")
   666→    .option("--root", "Create at project root (trait items only)")
   667→    .requiredOption("--title <title>", "Item title")
   668→    .option(
   669→      "--type <type>",
   670→      "Item type (feature, requirement, constraint, decision)",
   671→      "feature",
   672→    )
   673→    .option("--slug <slug>", "Human-friendly slug")
   674→    .option("--priority <priority>", "Priority (high, medium, low)")
   675→    .option("--tag <tag...>", "Tags")
   676→    .option("--trait <trait...>", "Traits to apply (e.g., @trait-testable)")
   677→    .option("--description <desc>", "Description")
   678→    .option(
   679→      "--as <field>",
   680→      "Child field override (e.g., requirements, constraints)",
   681→    )
   682→    .addHelpText(
   683→      "after",
   684→      `
   685→Examples:
   686→  $ kspec item add --under @parent --title "Feature name" --type feature
   687→  $ kspec item add --under @parent --title "Multi-tag" --tag api public
   688→  $ kspec item add --under @parent --title "API endpoint" --trait @trait-api-endpoint
   689→  $ kspec item add --root --type trait --title "JSON Output" --slug trait-json-output`,
   690→    )
   691→    .action(async (options) => {
   692→      try {
   693→        const ctx = await initContext();
   694→        const { refIndex, items } = await buildIndexes(ctx);
   695→        const isRootAdd = Boolean(options.root);
   696→        const itemType = options.type as ItemType;
   697→
   698→        const exitWithUsageGuidance = (
   699→          message: string,
   700→          suggestion: string,
   701→          details?: Record<string, unknown>,
   702→        ): never => {
   703→          error(message, { suggestion, ...details });
   704→          process.exit(EXIT_CODES.USAGE_ERROR);
   705→        };
   706→
   707→        if (options.under && isRootAdd) {
   708→          exitWithUsageGuidance(
   709→            `Cannot use --under (${options.under}) and --root together`,
   710→            "Use --root only for project-level traits in kynetic.yaml, or remove --root and keep --under for nested items.",
   711→            {
   712→              field: "under",
   713→              value: options.under,
   714→              conflicting_field: "root",
   715→            },
   716→          );
   717→        }
   718→
   719→        if (!options.under && !isRootAdd) {
   720→          exitWithUsageGuidance(
   721→            "item add requires either --under <ref> or --root",
   722→            "Use --under @parent to create a nested item, or use --root --type trait to create a project-level trait in kynetic.yaml.",
   723→          );
   724→        }
   725→
   726→        if (isRootAdd && itemType !== "trait") {
   727→          exitWithUsageGuidance(
   728→            `--root is only supported for --type trait (received: ${itemType || "undefined"})`,
   729→            "Change --type to trait for project-level creation, or remove --root and create the item under a parent with --under.",
   730→            {
   731→              field: "type",
   732→              value: itemType || null,
   733→            },
   734→          );
   735→        }
   736→
   737→        let parent: LoadedSpecItem | null = null;
   738→        if (options.under) {
   739→          const parentResult = refIndex.resolve(options.under);
   740→          if (!parentResult.ok) {
   741→            error(errors.reference.itemNotFound(options.under));
   742→            process.exit(EXIT_CODES.ERROR);
   743→          }
   744→
   745→          parent = parentResult.item as LoadedSpecItem;
   746→
   747→          // Check it's not a task
   748→          if ("status" in parent && typeof parent.status === "string") {
   749→            error(errors.reference.parentIsTask(options.under));
   750→            process.exit(EXIT_CODES.ERROR);
   751→          }
   752→        }
   753→
   754→        // Check slug uniqueness if provided
   755→        if (options.slug) {
   756→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   757→          if (!slugCheck.ok) {
   758→            error(
   759→              errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid),
   760→            );
   761→            process.exit(EXIT_CODES.CONFLICT);
   762→          }
   763→        }
   764→
   765→        // Validate and canonicalize traits
   766→        const validatedTraits: string[] = [];
   767→        const seenTraitUlids = new Set<string>();
   768→        let hasTraitErrors = false;
   769→
   770→        if (options.trait) {
   771→          for (const traitRef of options.trait) {
   772→            const traitResult = refIndex.resolve(traitRef);
   773→            if (!traitResult.ok) {
   774→              error(`Trait not found: ${traitRef}`);
   775→              hasTraitErrors = true;
   776→              continue;
   777→            }
   778→
   779→            const traitItem = traitResult.item as LoadedSpecItem;
   780→            if (traitItem.type !== "trait") {
   781→              error(`${traitRef} is not a trait (type: ${traitItem.type})`);
   782→              hasTraitErrors = true;
   783→              continue;
   784→            }
   785→
   786→            // Deduplicate by ULID
   787→            if (seenTraitUlids.has(traitItem._ulid)) {
   788→              continue;
   789→            }
   790→            seenTraitUlids.add(traitItem._ulid);
   791→
   792→            // Store canonical ref (prefer slug over ULID)
   793→            const canonicalRef = `@${traitItem.slugs[0] || traitItem._ulid}`;
   794→            validatedTraits.push(canonicalRef);
   795→          }
   796→        }
   797→
   798→        if (hasTraitErrors) {
   799→          process.exit(EXIT_CODES.NOT_FOUND);
   800→        }
   801→
   802→        const input: SpecItemInput = {
   803→          title: options.title,
   804→          type: itemType,
   805→          slugs: options.slug ? [options.slug] : [],
   806→          priority: options.priority,
   807→          tags: parseTagsArray(options.tag),
   808→          description: options.description,
   809→          depends_on: [],
   810→          implements: [],
   811→          relates_to: [],
   812→          tests: [],
   813→          traits: validatedTraits,
   814→          notes: [],
   815→        };
   816→
   817→        const newItem = createSpecItem(input);
   818→        const addResult = isRootAdd
   819→          ? await addProjectLevelTraitItem(ctx, newItem)
   820→          : await addChildItem(ctx, parent!, newItem, options.as);
   821→        const resultItem = {
   822→          ...(addResult.item as LoadedSpecItem),
   823→          ...(isRootAdd
   824→            ? {
   825→                _sourceFile: ctx.manifestPath!,
   826→                _path: addResult.path,
   827→              }
   828→            : {}),
   829→        } as LoadedSpecItem;
   830→
   831→        // Build index including the new item for accurate short ULID
   832→        const index = new ReferenceIndex(
   833→          [],
   834→          [...items, resultItem],
   835→        );
   836→        const itemSlug = resultItem.slugs?.[0] || index.shortUlid(resultItem._ulid);
   837→        const itemRef = `@${itemSlug}`;
   838→        await commitIfShadow(ctx.shadow, "item-add", itemSlug);
   839→        success(
   840→          isRootAdd
   841→            ? `Created item: ${itemRef} in project root traits`
   842→            : `Created item: ${index.shortUlid(resultItem._ulid)} under @${parent!.slugs[0] || index.shortUlid(parent!._ulid)}`,
   843→          {
   844→            item: resultItem,
   845→            path: addResult.path,
   846→          },
   847→        );
   848→
   849→        // Derive hint
   850→        if (!isJsonMode()) {
   851→          const refSlug =
   852→            resultItem.slugs?.[0] || index.shortUlid(resultItem._ulid);
   853→          console.log(
   854→            chalk.gray(
   855→              `\nDerive implementation task? kspec derive @${refSlug}`,
   856→            ),
   857→          );
   858→        }
   859→      } catch (err) {
   860→        error(errors.failures.createItem, err);
   861→        process.exit(EXIT_CODES.ERROR);
   862→      }
   863→    });
   864→
   865→  // kspec item set - update a spec item field
   866→  markMutating(item.command("set <ref>"))
   867→    .description("Update a spec item field")
   868→    .option("--title <title>", "Set title")
   869→    .option("--type <type>", "Set type")
   870→    .option("--slug <slug>", "Add a slug")
   871→    .option("--remove-slug <slug>", "Remove a slug")
   872→    .option("--priority <priority>", "Set priority")
   873→    .option("--tag <tag...>", "Set tags (replaces existing)")
   874→    .option("--description <desc>", "Set description")
   875→    .option(
   876→      "--status <status>",
   877→      "Set implementation status (not_started, in_progress, implemented, verified)",
   878→    )
   879→    .option(
   880→      "--maturity <maturity>",
   881→      "Set maturity (draft, proposed, stable, deferred, deprecated)",
   882→    )
   883→    .option(
   884→      "--verified-by <agent-ref>",
   885→      "Set verified_by (for retrospective specs)",
   886→    )
   887→    .option(
   888→      "--verified-at <iso-timestamp>",
   889→      "Set verified_at (defaults to now if --verified-by provided)",
   890→    )
   891→    .option("--trait <trait...>", "Set traits (replaces existing)")
   892→    .option("--relates-to <ref>", "Add a relates_to reference")
   893→    .option("--implements <ref>", "Add an implements reference")
   894→    .option("--depends-on <ref>", "Add a depends_on reference")
   895→    .option("--clear-relates-to", "Clear all relates_to references")
   896→    .option("--clear-implements", "Clear all implements references")
   897→    .option("--clear-depends-on", "Clear all depends_on references")
   898→    .addHelpText(
   899→      "after",
   900→      `
   901→Examples:
   902→  $ kspec item set @item-ref --title "New title"
   903→  $ kspec item set @item-ref --tag api internal security
   904→  $ kspec item set @item-ref --trait reusable testable
   905→  $ kspec item set @item-ref --relates-to @other-item
   906→  $ kspec item set @item-ref --implements @feature-spec
   907→  $ kspec item set @item-ref --depends-on @prereq-spec`,
   908→    )
   909→    .action(async (ref, options) => {
   910→      try {
   911→        const ctx = await initContext();
   912→        const { refIndex, items, tasks } = await buildIndexes(ctx);
   913→
   914→        const result = refIndex.resolve(ref);
   915→        if (!result.ok) {
   916→          error(errors.reference.itemNotFound(ref));
   917→          process.exit(EXIT_CODES.ERROR);
   918→        }
   919→
   920→        const foundItem = result.item as LoadedSpecItem;
   921→
   922→        // Check if it's a task (tasks should use task commands)
   923→        if ("status" in foundItem && typeof foundItem.status === "string") {
   924→          error(errors.reference.taskUseTaskCommands(ref));
   925→          process.exit(EXIT_CODES.ERROR);
   926→        }
   927→
   928→        // Check slug uniqueness if adding a new slug
   929→        if (options.slug) {
   930→          const slugCheck = checkSlugUniqueness(
   931→            refIndex,
   932→            [options.slug],
   933→            foundItem._ulid,
   934→          );
   935→          if (!slugCheck.ok) {
   936→            error(
   937→              errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid),
   938→            );
   939→            process.exit(EXIT_CODES.CONFLICT);
   940→          }
   941→        }
   942→
   943→        // Validate --remove-slug
   944→        if (options.removeSlug) {
   945→          const currentSlugs = foundItem.slugs || [];
   946→          if (!currentSlugs.includes(options.removeSlug)) {
   947→            error(errors.slug.notFound(options.removeSlug));
   948→            process.exit(EXIT_CODES.ERROR);
   949→          }
   950→          if (currentSlugs.length === 1) {
   951→            error(errors.slug.cannotRemoveLast(options.removeSlug));
   952→            process.exit(EXIT_CODES.ERROR);
   953→          }
   954→        }
   955→
   956→        // Mutual exclusivity: cannot add and clear same field
   957→        // Check this before ref resolution so usage errors take precedence
   958→        if (options.relatesTo && options.clearRelatesTo) {
   959→          error("Cannot use --relates-to and --clear-relates-to together");
   960→          process.exit(EXIT_CODES.USAGE_ERROR);
   961→        }
   962→        if (options.implements && options.clearImplements) {
   963→          error("Cannot use --implements and --clear-implements together");
   964→          process.exit(EXIT_CODES.USAGE_ERROR);
   965→        }
   966→        if (options.dependsOn && options.clearDependsOn) {
   967→          error("Cannot use --depends-on and --clear-depends-on together");
   968→          process.exit(EXIT_CODES.USAGE_ERROR);
   969→        }
   970→
   971→        // Helper to validate relationship refs (must exist and be a spec item, not a task)
   972→        // Returns { ulid, canonicalRef } for deduplication and user-friendly storage
   973→        const validateRelationshipRef = (refStr: string, flagName: string): { ulid: string; canonicalRef: string } => {
   974→          const refResult = refIndex.resolve(refStr);
   975→          if (!refResult.ok) {
   976→            error(errors.reference.itemNotFound(refStr));
   977→            process.exit(EXIT_CODES.NOT_FOUND);
   978→          }
   979→          // Ensure it's a spec item, not a task
   980→          const isTask = tasks.some((t) => t._ulid === refResult.ulid);
   981→          if (isTask) {
   982→            error(`${flagName} reference must be a spec item, not a task: ${refStr}`);
   983→            process.exit(EXIT_CODES.USAGE_ERROR);
   984→          }
   985→          // Use primary slug if available for user-friendly storage, otherwise ULID
   986→          const item = refResult.item as LoadedSpecItem;
   987→          const canonicalRef = item.slugs?.[0] ? `@${item.slugs[0]}` : `@${refResult.ulid}`;
   988→          return { ulid: refResult.ulid, canonicalRef };
   989→        };
   990→
   991→        // Helper to resolve existing refs to ULIDs for deduplication
   992→        const resolveRefsToUlids = (refs: string[]): Set<string> => {
   993→          const ulids = new Set<string>();
   994→          for (const ref of refs) {
   995→            const result = refIndex.resolve(ref);
   996→            if (result.ok) {
   997→              ulids.add(result.ulid);
   998→            }
   999→          }
  1000→          return ulids;
  1001→        };
  1002→
  1003→        // AC: @item-set ac-5 - --relates-to validation
  1004→        // Store resolved ULID for deduplication and canonical ref for storage
  1005→        let relatesToResolved: { ulid: string; canonicalRef: string } | undefined;
  1006→        if (options.relatesTo) {
  1007→          relatesToResolved = validateRelationshipRef(options.relatesTo, "--relates-to");
  1008→        }
  1009→
  1010→        // AC: @item-set ac-6 - --implements validation
  1011→        let implementsResolved: { ulid: string; canonicalRef: string } | undefined;
  1012→        if (options.implements) {
  1013→          implementsResolved = validateRelationshipRef(options.implements, "--implements");
  1014→        }
  1015→
  1016→        // AC: @item-set ac-7 - --depends-on validation
  1017→        let dependsOnResolved: { ulid: string; canonicalRef: string } | undefined;
  1018→        if (options.dependsOn) {
  1019→          dependsOnResolved = validateRelationshipRef(options.dependsOn, "--depends-on");
  1020→        }
  1021→
  1022→        // Build updates object
  1023→        const updates: Partial<SpecItemInput> = {};
  1024→
  1025→        if (options.title) updates.title = options.title;
  1026→        if (options.type) updates.type = options.type as ItemType;
  1027→        if (options.slug || options.removeSlug) {
  1028→          let slugs = [...(foundItem.slugs || [])];
  1029→          if (options.removeSlug) {
  1030→            slugs = slugs.filter((s) => s !== options.removeSlug);
  1031→          }
  1032→          if (options.slug) {
  1033→            slugs.push(options.slug);
  1034→          }
  1035→          updates.slugs = slugs;
  1036→        }
  1037→        if (options.priority) updates.priority = options.priority;
  1038→        if (options.tag) updates.tags = parseTagsArray(options.tag);
  1039→        if (options.trait) updates.traits = options.trait;
  1040→        if (options.description) updates.description = options.description;
  1041→
  1042→        // AC: @implementation-states ac-reject-invalid
  1043→        // AC: @maturity-states ac-reject-invalid
  1044→        // Validate enum values before writing
  1045→        if (options.status) {
  1046→          const valid = ImplementationStatusSchema.options as readonly string[];
  1047→          if (!valid.includes(options.status)) {
  1048→            error(`Invalid implementation status: '${options.status}'. Valid values: ${valid.join(", ")}`);
  1049→            process.exit(EXIT_CODES.USAGE_ERROR);
  1050→          }
  1051→        }
  1052→        if (options.maturity) {
  1053→          const valid = MaturitySchema.options as readonly string[];
  1054→          if (!valid.includes(options.maturity)) {
  1055→            error(`Invalid maturity: '${options.maturity}'. Valid values: ${valid.join(", ")}`);
  1056→            process.exit(EXIT_CODES.USAGE_ERROR);
  1057→          }
  1058→        }
  1059→
  1060→        // Handle status updates
  1061→        if (options.status || options.maturity) {
  1062→          const currentStatus =
  1063→            foundItem.status && typeof foundItem.status === "object"
  1064→              ? foundItem.status
  1065→              : {};
  1066→          updates.status = {
  1067→            ...currentStatus,
  1068→            ...(options.status && { implementation: options.status }),
  1069→            ...(options.maturity && { maturity: options.maturity }),
  1070→          };
  1071→        }
  1072→
  1073→        // Handle verification metadata (for retrospective specs)
  1074→        if (options.verifiedBy) {
  1075→          updates.verified_by = options.verifiedBy;
  1076→          // Default verified_at to now if not specified
  1077→          updates.verified_at = options.verifiedAt || new Date().toISOString();
  1078→        } else if (options.verifiedAt) {
  1079→          updates.verified_at = options.verifiedAt;
  1080→        }
  1081→
  1082→        // AC: @item-set ac-5 - Handle relates_to (append semantics)
  1083→        // Uses resolved ULIDs for deduplication and stores canonical slug format
  1084→        if (relatesToResolved) {
  1085→          const current = foundItem.relates_to || [];
  1086→          const existingUlids = resolveRefsToUlids(current);
  1087→          if (!existingUlids.has(relatesToResolved.ulid)) {
  1088→            updates.relates_to = [...current, relatesToResolved.canonicalRef];
  1089→          }
  1090→        }
  1091→        if (options.clearRelatesTo) {
  1092→          updates.relates_to = [];
  1093→        }
  1094→
  1095→        // AC: @item-set ac-6 - Handle implements (append semantics)
  1096→        // Uses resolved ULIDs for deduplication and stores canonical slug format
  1097→        if (implementsResolved) {
  1098→          const current = foundItem.implements || [];
  1099→          const existingUlids = resolveRefsToUlids(current);
  1100→          if (!existingUlids.has(implementsResolved.ulid)) {
  1101→            updates.implements = [...current, implementsResolved.canonicalRef];
  1102→          }
  1103→        }
  1104→        if (options.clearImplements) {
  1105→          updates.implements = [];
  1106→        }
  1107→
  1108→        // AC: @item-set ac-7 - Handle depends_on (append semantics)
  1109→        // Uses resolved ULIDs for deduplication and stores canonical slug format
  1110→        if (dependsOnResolved) {
  1111→          const current = foundItem.depends_on || [];
  1112→          const existingUlids = resolveRefsToUlids(current);
  1113→          if (!existingUlids.has(dependsOnResolved.ulid)) {
  1114→            updates.depends_on = [...current, dependsOnResolved.canonicalRef];
  1115→          }
  1116→        }
  1117→        if (options.clearDependsOn) {
  1118→          updates.depends_on = [];
  1119→        }
  1120→
  1121→        if (Object.keys(updates).length === 0) {
  1122→          warn("No updates specified");
  1123→          return;
  1124→        }
  1125→
  1126→        const updated = await updateSpecItem(ctx, foundItem, updates);
  1127→        const itemSlug =
  1128→          foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
  1129→
  1130→        // Handle cascade for implementation status updates
  1131→        const updatedItems: LoadedSpecItem[] = [updated];
  1132→        if (options.status) {
  1133→          const cascadeResult = await handleStatusCascade(
  1134→            ctx,
  1135→            updated,
  1136→            options.status,
  1137→            items,
  1138→            refIndex,
  1139→          );
  1140→          updatedItems.push(...cascadeResult);
  1141→        }
  1142→
  1143→        await commitIfShadow(ctx.shadow, "item-set", itemSlug);
  1144→        success(`Updated item: ${refIndex.shortUlid(updated._ulid)}`, {
  1145→          item: updated,
  1146→        });
  1147→
  1148→        // Derive hint
  1149→        if (!isJsonMode()) {
  1150→          const refSlug =
  1151→            updated.slugs?.[0] || refIndex.shortUlid(updated._ulid);
  1152→          console.log(
  1153→            chalk.gray(
  1154→              `\nDerive implementation task? kspec derive @${refSlug}`,
  1155→            ),
  1156→          );
  1157→        }
  1158→      } catch (err) {
  1159→        error(errors.failures.updateItem, err);
  1160→        process.exit(EXIT_CODES.ERROR);
  1161→      }
  1162→    });
  1163→
  1164→  // kspec item delete - delete a spec item
  1165→  markMutating(item.command("delete <ref>"))
  1166→    .description("Delete a spec item (including nested items)")
  1167→    .option("--force", "Skip confirmation")
  1168→    .option("--cascade", "Delete item and all descendants")
  1169→    .action(async (ref, options) => {
  1170→      try {
  1171→        const ctx = await initContext();
  1172→        const { refIndex, items } = await buildIndexes(ctx);
  1173→
  1174→        const result = refIndex.resolve(ref);
  1175→        if (!result.ok) {
  1176→          error(errors.reference.itemNotFound(ref));
  1177→          process.exit(EXIT_CODES.ERROR);
  1178→        }
  1179→
  1180→        const foundItem = result.item as LoadedSpecItem;
  1181→
  1182→        // Check if it's a task
  1183→        if ("status" in foundItem && typeof foundItem.status === "string") {
  1184→          error(errors.reference.itemUseTaskCancel(ref));
  1185→          process.exit(EXIT_CODES.ERROR);
  1186→        }
  1187→
  1188→        if (!foundItem._sourceFile) {
  1189→          error(errors.operation.cannotDeleteNoSource);
  1190→          process.exit(EXIT_CODES.ERROR);
  1191→        }
  1192→
  1193→        // AC: @spec-item-delete-children ac-7 - Check if this is a trait with implementors
  1194→        const implementors = findTraitImplementors(foundItem, items);
  1195→        if (implementors.length > 0) {
  1196→          const implementorRefs = implementors
  1197→            .map((i) => `@${i.slugs[0] || refIndex.shortUlid(i._ulid)}`)
  1198→            .join(", ");
  1199→          const errorMsg = `Cannot delete: trait is used by ${implementors.length} specs. Remove trait from specs first: ${implementorRefs}`;
  1200→
  1201→          if (isJsonMode()) {
  1202→            error(errorMsg, {
  1203→              error: "trait_in_use",
  1204→              implementors: implementors.map((i) => ({
  1205→                ulid: i._ulid,
  1206→                slug: i.slugs[0],
  1207→                title: i.title,
  1208→              })),
  1209→            });
  1210→          } else {
  1211→            error(errorMsg);
  1212→          }
  1213→          process.exit(EXIT_CODES.ERROR);
  1214→        }
  1215→
  1216→        // AC: @spec-item-delete-children ac-1 ac-8 - Check for child items (nested YAML items, not relates_to refs)
  1217→        const children = findChildItems(foundItem, items);
  1218→
  1219→        if (children.length > 0 && !options.cascade) {
  1220→          // AC: @spec-item-delete-children ac-1 - Block deletion if children exist without --cascade
  1221→          const errorMsg = `Cannot delete: item has ${children.length} children. Use --cascade to delete recursively`;
  1222→
  1223→          if (isJsonMode()) {
  1224→            // AC: @spec-item-delete-children ac-10 - JSON error includes children array
  1225→            error(errorMsg, {
  1226→              error: "has_children",
  1227→              children: children.map((c) => ({
  1228→                ulid: c._ulid,
  1229→                slug: c.slugs[0],
  1230→                title: c.title,
  1231→                ref: `@${c.slugs[0] || refIndex.shortUlid(c._ulid)}`,
  1232→              })),
  1233→            });
  1234→          } else {
  1235→            error(errorMsg);
  1236→          }
  1237→          process.exit(EXIT_CODES.ERROR);
  1238→        }
  1239→
  1240→        // AC: @spec-item-delete-children ac-9 - Custom confirmation prompt for cascade
  1241→        if (children.length > 0 && options.cascade && !options.force) {
  1242→          const itemRef = `@${foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid)}`;
  1243→
  1244→          // Check for JSON mode - requires --force
  1245→          if (isJsonMode()) {
  1246→            error("Confirmation required. Use --force with --json");
  1247→            process.exit(EXIT_CODES.ERROR);
  1248→          }
  1249→
  1250→          // Check for non-interactive environment
  1251→          const isTTY =
  1252→            process.env.KSPEC_TEST_TTY === "true" || process.stdin.isTTY;
  1253→          if (!isTTY) {
  1254→            error("Non-interactive environment. Use --force to proceed");
  1255→            process.exit(EXIT_CODES.ERROR);
  1256→          }
  1257→
  1258→          // Show confirmation prompt
  1259→          const readline = await import("node:readline");
  1260→          const rl = readline.createInterface({
  1261→            input: process.stdin,
  1262→            output: process.stdout,
  1263→          });
  1264→
  1265→          const response = await new Promise<string>((resolve) => {
  1266→            rl.question(
  1267→              chalk.yellow(
  1268→                `Delete ${itemRef} and ${children.length} descendant items? [y/N] `,
  1269→              ),
  1270→              (answer) => {
  1271→                rl.close();
  1272→                resolve(answer);
  1273→              },
  1274→            );
  1275→          });
  1276→
  1277→          if (response.toLowerCase() !== "y") {
  1278→            console.log(chalk.gray("Operation cancelled"));
  1279→            process.exit(EXIT_CODES.USAGE_ERROR);
  1280→          }
  1281→        }
  1282→
  1283→        // AC: @spec-item-delete-children ac-2 ac-3 - Delete item and all descendants with cascade
  1284→        const itemsToDelete = options.cascade
  1285→          ? [foundItem, ...children]
  1286→          : [foundItem];
  1287→        let deletedCount = 0;
  1288→
  1289→        // Delete in reverse order (deepest first) to avoid path issues
  1290→        const sortedItems = [...itemsToDelete].sort((a, b) => {
  1291→          const aDepth = a._path ? a._path.split(".").length : 0;
  1292→          const bDepth = b._path ? b._path.split(".").length : 0;
  1293→          return bDepth - aDepth;
  1294→        });
  1295→
  1296→        for (const itemToDelete of sortedItems) {
  1297→          const deleted = await deleteSpecItem(ctx, itemToDelete);
  1298→          if (deleted) {
  1299→            deletedCount++;
  1300→          }
  1301→        }
  1302→
  1303→        if (deletedCount > 0) {
  1304→          // AC: @spec-item-delete-children ac-6 - Single shadow commit with all deletions
  1305→          const itemSlug =
  1306→            foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
  1307→          const commitMsg =
  1308→            deletedCount > 1 ? `${deletedCount} items` : itemSlug;
  1309→          await commitIfShadow(ctx.shadow, "item-delete", commitMsg);
  1310→
  1311→          if (deletedCount > 1) {
  1312→            success(`Deleted ${deletedCount} items`, {
  1313→              deleted: deletedCount,
  1314→              root_ulid: foundItem._ulid,
  1315→            });
  1316→          } else {
  1317→            success(`Deleted item: ${foundItem.title}`, {
  1318→              deleted: true,
  1319→              ulid: foundItem._ulid,
  1320→            });
  1321→          }
  1322→        } else {
  1323→          error(errors.failures.deleteItem);
  1324→          console.log(
  1325→            chalk.gray(
  1326→              `Edit the source file directly: ${foundItem._sourceFile}`,
  1327→            ),
  1328→          );
  1329→          process.exit(EXIT_CODES.ERROR);
  1330→        }
  1331→      } catch (err) {
  1332→        error(errors.failures.deleteItem, err);
  1333→        process.exit(EXIT_CODES.ERROR);
  1334→      }
  1335→    });
  1336→
  1337→  // kspec item patch - update item fields via JSON
  1338→  markMutating(item.command("patch [ref]"))
  1339→    .description("Update spec item fields via JSON patch")
  1340→    .option("--data <json>", "JSON data to patch")
  1341→    .option("--bulk", "Read patches from stdin (JSONL or JSON array)")
  1342→    .option("--allow-unknown", "Allow fields not in schema")
  1343→    .option("--dry-run", "Preview changes without applying")
  1344→    .option("--fail-fast", "Stop on first error (bulk mode)")
  1345→    .action(async (ref: string | undefined, options) => {
  1346→      try {
  1347→        const ctx = await initContext();
  1348→
  1349→        if (options.bulk) {
  1350→          // Bulk mode: read from stdin
  1351→          const stdin = await readStdinFully();
  1352→          if (!stdin) {
  1353→            error(errors.validation.noInputProvided);
  1354→            process.exit(EXIT_CODES.ERROR);
  1355→          }
  1356→
  1357→          let patches: PatchOperation[];
  1358→          try {
  1359→            patches = parseBulkInput(stdin);
  1360→          } catch (err) {
  1361→            error(
  1362→              errors.validation.failedToParseBulk(
  1363→                err instanceof Error ? err.message : String(err),
  1364→              ),
  1365→            );
  1366→            process.exit(EXIT_CODES.ERROR);
  1367→          }
  1368→
  1369→          if (patches.length === 0) {
  1370→            error(errors.validation.noPatchesProvided);
  1371→            process.exit(EXIT_CODES.ERROR);
  1372→          }
  1373→
  1374→          const { refIndex, items } = await buildIndexes(ctx);
  1375→          const result = await patchSpecItems(ctx, refIndex, items, patches, {
  1376→            allowUnknown: options.allowUnknown,
  1377→            failFast: options.failFast,
  1378→            dryRun: options.dryRun,
  1379→          });
  1380→
  1381→          // Shadow commit if any updates
  1382→          if (!options.dryRun && result.summary.updated > 0) {
  1383→            await commitIfShadow(
  1384→              ctx.shadow,
  1385→              "item-patch",
  1386→              `${result.summary.updated} items`,
  1387→            );
  1388→          }
  1389→
  1390→          output(result, () => formatBulkPatchResult(result, options.dryRun));
  1391→
  1392→          if (result.summary.failed > 0) {
  1393→            process.exit(EXIT_CODES.ERROR);
  1394→          }
  1395→        } else {
  1396→          // Single item mode
  1397→          if (!ref) {
  1398→            error(errors.usage.patchNeedRef);
  1399→            process.exit(EXIT_CODES.ERROR);
  1400→          }
  1401→
  1402→          let data: Record<string, unknown>;
  1403→
  1404→          // Get data from --data option or stdin
  1405→          if (options.data) {
  1406→            try {
  1407→              data = JSON.parse(options.data);
  1408→            } catch (err) {
  1409→              error(
  1410→                errors.validation.invalidJsonInData(
  1411→                  err instanceof Error ? err.message : "",
  1412→                ),
  1413→              );
  1414→              process.exit(EXIT_CODES.ERROR);
  1415→            }
  1416→          } else {
  1417→            const stdin = await readStdinIfAvailable();
  1418→            if (stdin) {
  1419→              try {
  1420→                data = JSON.parse(stdin.trim());
  1421→              } catch (err) {
  1422→                error(
  1423→                  errors.validation.invalidJsonFromStdin(
  1424→                    err instanceof Error ? err.message : "",
  1425→                  ),
  1426→                );
  1427→                process.exit(EXIT_CODES.ERROR);
  1428→              }
  1429→            } else {
  1430→              error(errors.validation.noPatchData);
  1431→              process.exit(EXIT_CODES.ERROR);
  1432→            }
  1433→          }
  1434→
  1435→          // Validate against schema (unless --allow-unknown)
  1436→          if (!options.allowUnknown) {
  1437→            // Use strict schema (no passthrough)
  1438→            const strictSchema = SpecItemPatchSchema.strict();
  1439→            const parseResult = strictSchema.safeParse(data);
  1440→            if (!parseResult.success) {
  1441→              const issues = parseResult.error.issues
  1442→                .map((i) => `${i.path.join(".")}: ${i.message}`)
  1443→                .join("; ");
  1444→              error(errors.validation.invalidPatchDataWithIssues(issues));
  1445→              process.exit(EXIT_CODES.ERROR);
  1446→            }
  1447→          }
  1448→
  1449→          const { refIndex, items } = await buildIndexes(ctx);
  1450→
  1451→          // Resolve ref
  1452→          const resolved = refIndex.resolve(ref);
  1453→          if (!resolved.ok) {
  1454→            error(errors.reference.itemNotFound(ref));
  1455→            process.exit(EXIT_CODES.ERROR);
  1456→          }
  1457→
  1458→          // Find the item
  1459→          const foundItem = items.find((i) => i._ulid === resolved.ulid);
  1460→          if (!foundItem) {
  1461→            error(errors.reference.notItem(ref));
  1462→            process.exit(EXIT_CODES.ERROR);
  1463→          }
  1464→
  1465→          if (options.dryRun) {
  1466→            output(
  1467→              {
  1468→                ref,
  1469→                data,
  1470→                wouldApplyTo: foundItem.title,
  1471→                ulid: foundItem._ulid,
  1472→              },
  1473→            () => {
  1474→                console.log(chalk.yellow("Would patch:"), foundItem.title);
  1475→                console.log(chalk.gray("ULID:"), refIndex.shortUlid(foundItem._ulid));
  1476→                console.log(chalk.gray("Changes:"));
  1477→                console.log(JSON.stringify(data, null, 2));
  1478→              },
  1479→            );
  1480→            return;
  1481→          }
  1482→
  1483→          const updated = await updateSpecItem(ctx, foundItem, data);
  1484→          const itemSlug =
  1485→            foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
  1486→          await commitIfShadow(ctx.shadow, "item-patch", itemSlug);
  1487→
  1488→          success(`Patched item: ${itemSlug}`, { item: updated });
  1489→        }
  1490→      } catch (err) {
  1491→        error(errors.failures.patchItems, err);
  1492→        process.exit(EXIT_CODES.ERROR);
  1493→      }
  1494→    });
  1495→
  1496→  // kspec item status - show implementation status with linked tasks
  1497→  item
  1498→    .command("status <ref>")
  1499→    .description("Show implementation status and linked tasks for a spec item")
  1500→    .action(async (ref) => {
  1501→      try {
  1502→        const ctx = await initContext();
  1503→        const tasks = await loadAllTasks(ctx);
  1504→        const items = await loadAllItems(ctx);
  1505→        const refIndex = new ReferenceIndex(tasks, items);
  1506→
  1507→        const result = refIndex.resolve(ref);
  1508→        if (!result.ok) {
  1509→          error(errors.reference.itemNotFound(ref));
  1510→          process.exit(EXIT_CODES.ERROR);
  1511→        }
  1512→
  1513→        const foundItem = result.item as LoadedSpecItem;
  1514→
  1515→        // Check if it's a task
  1516→        if ("status" in foundItem && typeof foundItem.status === "string") {
  1517→          error(errors.reference.notItem(ref));
  1518→          process.exit(EXIT_CODES.ERROR);
  1519→        }
  1520→
  1521→        // Build alignment index
  1522→        const alignmentIndex = new AlignmentIndex(tasks, items);
  1523→        alignmentIndex.buildLinks(refIndex);
  1524→
  1525→        const summary = alignmentIndex.getImplementationSummary(
  1526→          foundItem._ulid,
  1527→        );
  1528→
  1529→        if (!summary) {
  1530→          error(errors.project.couldNotGetImplSummary);
  1531→          process.exit(EXIT_CODES.ERROR);
  1532→        }
  1533→
  1534→        output(summary, () => {
  1535→          console.log(chalk.bold(foundItem.title));
  1536→          console.log(chalk.gray("─".repeat(40)));
  1537→
  1538→          // Status
  1539→          const currentColor =
  1540→            summary.currentStatus === "implemented"
  1541→              ? chalk.green
  1542→              : summary.currentStatus === "in_progress"
  1543→                ? chalk.yellow
  1544→                : chalk.gray;
  1545→          const expectedColor =
  1546→            summary.expectedStatus === "implemented"
  1547→              ? chalk.green
  1548→              : summary.expectedStatus === "in_progress"
  1549→                ? chalk.yellow
  1550→                : chalk.gray;
  1551→
  1552→          console.log(
  1553→            `Current status:  ${currentColor(summary.currentStatus)}`,
  1554→          );
  1555→          console.log(
  1556→            `Expected status: ${expectedColor(summary.expectedStatus)}`,
  1557→          );
  1558→
  1559→          if (!summary.isAligned) {
  1560→            console.log(
  1561→              chalk.yellow("\n⚠ Status mismatch - run task complete to sync"),
  1562→            );
  1563→          } else {
  1564→            console.log(chalk.green("\n✓ Aligned"));
  1565→          }
  1566→
  1567→          // Linked tasks
  1568→          console.log(chalk.bold("\nLinked Tasks:"));
  1569→          if (summary.linkedTasks.length === 0) {
  1570→            console.log(chalk.gray("  No tasks reference this spec item"));
  1571→          } else {
  1572→            for (const task of summary.linkedTasks) {
  1573→              const statusColor =
  1574→                task.taskStatus === "completed"
  1575→                  ? chalk.green
  1576→                  : task.taskStatus === "in_progress"
  1577→                    ? chalk.blue
  1578→                    : chalk.gray;
  1579→              const shortId = refIndex.shortUlid(task.taskUlid);
  1580→              const notes = task.hasNotes ? chalk.gray(" (has notes)") : "";
  1581→              console.log(
  1582→                `  ${statusColor(`[${task.taskStatus}]`)} ${shortId} ${task.taskTitle}${notes}`,
  1583→              );
  1584→            }
  1585→          }
  1586→        });
  1587→      } catch (err) {
  1588→        error(errors.failures.getItemStatus, err);
  1589→        process.exit(EXIT_CODES.ERROR);
  1590→      }
  1591→    });
  1592→
  1593→  // kspec item note <ref> <message>
  1594→  markMutating(item.command("note <ref> <message>"))
  1595→    .description("Add a note to a spec item")
  1596→    .option("--author <author>", "Note author")
  1597→    .option("--supersedes <ulid>", "ULID of note this supersedes")
  1598→    .action(async (ref: string, message: string, options) => {
  1599→      try {
  1600→        const ctx = await initContext();
  1601→        const items = await loadAllItems(ctx);
  1602→        const tasks = await loadAllTasks(ctx);
  1603→        const refIndex = new ReferenceIndex(tasks, items);
  1604→
  1605→        const result = refIndex.resolve(ref);
  1606→        if (!result.ok) {
  1607→          error(errors.reference.itemNotFound(ref));
  1608→          process.exit(EXIT_CODES.ERROR);
  1609→        }
  1610→
  1611→        const foundItem = items.find((i) => i._ulid === result.ulid);
  1612→        if (!foundItem) {
  1613→          error(errors.reference.itemNotFound(ref));
  1614→          process.exit(EXIT_CODES.ERROR);
  1615→        }
  1616→
  1617→        const note = createNote(message, options.author, options.supersedes);
  1618→
  1619→        const updatedNotes = [...(foundItem.notes || []), note];
  1620→        await updateSpecItem(ctx, foundItem, { notes: updatedNotes });
  1621→
  1622→        const itemSlug =
  1623→          foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
  1624→        await commitIfShadow(ctx.shadow, "item-note", itemSlug);
  1625→        success(
  1626→          `Added note to spec item: ${refIndex.shortUlid(foundItem._ulid)}`,
  1627→          { note },
  1628→        );
  1629→      } catch (err) {
  1630→        error(errors.failures.addNote, err);
  1631→        process.exit(EXIT_CODES.ERROR);
  1632→      }
  1633→    });
  1634→
  1635→  // kspec item notes <ref>
  1636→  item
  1637→    .command("notes <ref>")
  1638→    .description("Show notes for a spec item")
  1639→    .action(async (ref: string) => {
  1640→      try {
  1641→        const ctx = await initContext();
  1642→        const items = await loadAllItems(ctx);
  1643→        const tasks = await loadAllTasks(ctx);
  1644→        const refIndex = new ReferenceIndex(tasks, items);
  1645→
  1646→        const result = refIndex.resolve(ref);
  1647→        if (!result.ok) {
  1648→          error(errors.reference.itemNotFound(ref));
  1649→          process.exit(EXIT_CODES.ERROR);
  1650→        }
  1651→
  1652→        const foundItem = items.find((i) => i._ulid === result.ulid);
  1653→        if (!foundItem) {
  1654→          error(errors.reference.itemNotFound(ref));
  1655→          process.exit(EXIT_CODES.ERROR);
  1656→        }
  1657→
  1658→        const notes = foundItem.notes || [];
  1659→        output(notes, () => {
  1660→          if (notes.length === 0) {
  1661→            console.log("No notes");
  1662→          } else {
  1663→            for (const note of notes) {
  1664→              const author = note.author || "unknown";
  1665→              console.log(`[${note.created_at}] ${author}:`);
  1666→              console.log(note.content);
  1667→              console.log("");
  1668→            }
  1669→          }
  1670→        });
  1671→      } catch (err) {
  1672→        error(errors.failures.getNotes, err);
  1673→        process.exit(EXIT_CODES.ERROR);
  1674→      }
  1675→    });
  1676→
  1677→  // Create subcommand group for acceptance criteria operations
  1678→  const acCmd = item
  1679→    .command("ac")
  1680→    .description("Manage acceptance criteria on spec items");
  1681→
  1682→  // Helper: Generate next AC ID based on existing AC
  1683→  function generateNextAcId(
  1684→    existingAc: AcceptanceCriterion[] | undefined,
  1685→  ): string {
  1686→    if (!existingAc || existingAc.length === 0) return "ac-1";
  1687→
  1688→    const numericIds = existingAc
  1689→      .map((ac) => ac.id.match(/^ac-(\d+)$/)?.[1])
  1690→      .filter((id): id is string => id !== null && id !== undefined)
  1691→      .map(Number);
  1692→
  1693→    const maxId = numericIds.length > 0 ? Math.max(...numericIds) : 0;
  1694→    return `ac-${maxId + 1}`;
  1695→  }
  1696→
  1697→  // Helper: Resolve ref to spec item (not task)
  1698→  async function resolveSpecItem(ref: string): Promise<{
  1699→    ctx: Awaited<ReturnType<typeof initContext>>;
  1700→    item: LoadedSpecItem;
  1701→    refIndex: ReferenceIndex;
  1702→  }> {
  1703→    const ctx = await initContext();
  1704→    const { refIndex, items } = await buildIndexes(ctx);
  1705→
  1706→    const result = refIndex.resolve(ref);
  1707→    if (!result.ok) {
  1708→      error(errors.reference.itemNotFound(ref));
  1709→      process.exit(EXIT_CODES.NOT_FOUND);
  1710→    }
  1711→
  1712→    const foundItem = result.item as LoadedSpecItem;
  1713→
  1714→    // Check if it's a task
  1715→    if ("status" in foundItem && typeof foundItem.status === "string") {
  1716→      error(errors.operation.tasksNoAcceptanceCriteria(ref));
  1717→      process.exit(EXIT_CODES.NOT_FOUND);
  1718→    }
  1719→
  1720→    return { ctx, item: foundItem, refIndex };
  1721→  }
  1722→
  1723→  // kspec item ac list <ref>
  1724→  acCmd
  1725→    .command("list <ref>")
  1726→    .description("List acceptance criteria for a spec item")
  1727→    .action(async (ref: string) => {
  1728→      try {
  1729→        const { item, refIndex } = await resolveSpecItem(ref);
  1730→        const ac = item.acceptance_criteria || [];
  1731→
  1732→        output(ac, () => {
  1733→          console.log(
  1734→            chalk.bold(
  1735→              `Acceptance Criteria for: ${item.title} (@${item.slugs[0] || refIndex.shortUlid(item._ulid)})`,
  1736→            ),
  1737→          );
  1738→          console.log();
  1739→
  1740→          if (ac.length === 0) {
  1741→            console.log(chalk.gray("No acceptance criteria"));
  1742→          } else {
  1743→            for (const criterion of ac) {
  1744→              console.log(chalk.cyan(`  [${criterion.id}]`));
  1745→              console.log(chalk.gray(`    Given: ${criterion.given}`));
  1746→              console.log(chalk.gray(`    When:  ${criterion.when}`));
  1747→              console.log(chalk.gray(`    Then:  ${criterion.then}`));
  1748→              console.log();
  1749→            }
  1750→          }
  1751→
  1752→          console.log(chalk.gray(`${ac.length} acceptance criteria`));
  1753→        });
  1754→      } catch (err) {
  1755→        error(errors.failures.listAc, err);
  1756→        process.exit(EXIT_CODES.ERROR);
  1757→      }
  1758→    });
  1759→
  1760→  // kspec item ac add <ref>
  1761→  markMutating(acCmd.command("add <ref>"))
  1762→    .description("Add an acceptance criterion to a spec item")
  1763→    .option("--id <id>", "AC identifier (auto-generated if not provided)")
  1764→    .requiredOption("--given <text>", "The precondition (Given...)")
  1765→    .requiredOption("--when <text>", "The action/trigger (When...)")
  1766→    .requiredOption("--then <text>", "The expected outcome (Then...)")
  1767→    .action(async (ref: string, options) => {
  1768→      try {
  1769→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
  1770→        const existingAc = item.acceptance_criteria || [];
  1771→
  1772→        // Determine ID
  1773→        const acId = options.id || generateNextAcId(existingAc);
  1774→
  1775→        // Check for duplicate ID
  1776→        if (existingAc.some((ac) => ac.id === acId)) {
  1777→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1778→          error(errors.conflict.acAlreadyExists(acId, itemRef));
  1779→          process.exit(EXIT_CODES.CONFLICT);
  1780→        }
  1781→
  1782→        // Create new AC
  1783→        const newAc: AcceptanceCriterion = {
  1784→          id: acId,
  1785→          given: options.given,
  1786→          when: options.when,
  1787→          then: options.then,
  1788→        };
  1789→
  1790→        // Update item with new AC
  1791→        const updatedAc = [...existingAc, newAc];
  1792→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
  1793→
  1794→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1795→        await commitIfShadow(ctx.shadow, "item-ac-add", itemSlug);
  1796→        success(`Added acceptance criterion: ${acId} to @${itemSlug}`, {
  1797→          ac: newAc,
  1798→        });
  1799→      } catch (err) {
  1800→        error(errors.failures.addAc, err);
  1801→        process.exit(EXIT_CODES.ERROR);
  1802→      }
  1803→    });
  1804→
  1805→  // kspec item ac set <ref> <ac-id>
  1806→  markMutating(acCmd.command("set <ref> <acId>"))
  1807→    .description("Update an acceptance criterion")
  1808→    .option("--id <newId>", "Rename the AC ID")
  1809→    .option("--given <text>", "Update the precondition")
  1810→    .option("--when <text>", "Update the action/trigger")
  1811→    .option("--then <text>", "Update the expected outcome")
  1812→    .action(async (ref: string, acId: string, options) => {
  1813→      try {
  1814→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
  1815→        const existingAc = item.acceptance_criteria || [];
  1816→
  1817→        // Find the AC
  1818→        const acIndex = existingAc.findIndex((ac) => ac.id === acId);
  1819→        if (acIndex === -1) {
  1820→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1821→          error(errors.reference.acNotFound(acId, itemRef));
  1822→          process.exit(EXIT_CODES.NOT_FOUND);
  1823→        }
  1824→
  1825→        // Check for no updates
  1826→        if (!options.id && !options.given && !options.when && !options.then) {
  1827→          warn("No updates specified");
  1828→          return;
  1829→        }
  1830→
  1831→        // Check for duplicate ID if renaming
  1832→        if (
  1833→          options.id &&
  1834→          options.id !== acId &&
  1835→          existingAc.some((ac) => ac.id === options.id)
  1836→        ) {
  1837→          error(errors.conflict.acIdAlreadyExists(options.id));
  1838→          process.exit(EXIT_CODES.CONFLICT);
  1839→        }
  1840→
  1841→        // Build updated AC
  1842→        const updatedAc = [...existingAc];
  1843→        const updatedFields: string[] = [];
  1844→
  1845→        updatedAc[acIndex] = {
  1846→          ...updatedAc[acIndex],
  1847→          ...(options.id && { id: options.id }),
  1848→          ...(options.given && { given: options.given }),
  1849→          ...(options.when && { when: options.when }),
  1850→          ...(options.then && { then: options.then }),
  1851→        };
  1852→
  1853→        if (options.id) updatedFields.push("id");
  1854→        if (options.given) updatedFields.push("given");
  1855→        if (options.when) updatedFields.push("when");
  1856→        if (options.then) updatedFields.push("then");
  1857→
  1858→        // Update item
  1859→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
  1860→
  1861→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1862→        await commitIfShadow(ctx.shadow, "item-ac-set", itemSlug);
  1863→        success(
  1864→          `Updated acceptance criterion: ${acId} on @${itemSlug} (${updatedFields.join(", ")})`,
  1865→          { ac: updatedAc[acIndex] },
  1866→        );
  1867→      } catch (err) {
  1868→        error(errors.failures.updateAc, err);
  1869→        process.exit(EXIT_CODES.ERROR);
  1870→      }
  1871→    });
  1872→
  1873→  // kspec item ac remove <ref> <ac-id>
  1874→  markMutating(acCmd.command("remove <ref> <acId>"))
  1875→    .description("Remove an acceptance criterion")
  1876→    .option("--force", "Skip confirmation")
  1877→    .action(async (ref: string, acId: string, options) => {
  1878→      try {
  1879→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
  1880→        const existingAc = item.acceptance_criteria || [];
  1881→
  1882→        // Find the AC
  1883→        const acIndex = existingAc.findIndex((ac) => ac.id === acId);
  1884→        if (acIndex === -1) {
  1885→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1886→          error(errors.reference.acNotFound(acId, itemRef));
  1887→          process.exit(EXIT_CODES.NOT_FOUND);
  1888→        }
  1889→
  1890→        // Confirmation required unless --force
  1891→        if (!options.force) {
  1892→          // AC: @spec-item-delete-children ac-5 - JSON mode requires --force
  1893→          if (isJsonMode()) {
  1894→            error("Confirmation required. Use --force with --json");
  1895→            process.exit(EXIT_CODES.ERROR);
  1896→          }
  1897→
  1898→          // AC: @spec-item-delete-children ac-6 - Non-interactive environment requires --force
  1899→          // Allow KSPEC_TEST_TTY for testing interactive prompts
  1900→          const isTTY =
  1901→            process.env.KSPEC_TEST_TTY === "1" || process.stdin.isTTY;
  1902→          if (!isTTY) {
  1903→            error("Non-interactive environment. Use --force to proceed");
  1904→            process.exit(EXIT_CODES.ERROR);
  1905→          }
  1906→
  1907→          // AC: @spec-item-delete-children ac-1 - Prompt for confirmation
  1908→          const readline = await import("node:readline");
  1909→          const rl = readline.createInterface({
  1910→            input: process.stdin,
  1911→            output: process.stdout,
  1912→          });
  1913→
  1914→          const answer = await new Promise<string>((resolve) => {
  1915→            rl.question(`Remove acceptance criterion ${acId}? [y/N] `, resolve);
  1916→          });
  1917→          rl.close();
  1918→
  1919→          // AC: @spec-item-delete-children ac-3 - User declines (n, N, or empty)
  1920→          if (answer.toLowerCase() !== "y") {
  1921→            error("Operation cancelled");
  1922→            process.exit(EXIT_CODES.USAGE_ERROR);
  1923→          }
  1924→        }
  1925→
  1926→        // AC: @spec-item-delete-children ac-4 - With --force, proceed immediately without prompt
  1927→        // AC: @spec-item-delete-children ac-2 - User confirmed, proceed with removal
  1928→        const updatedAc = existingAc.filter((ac) => ac.id !== acId);
  1929→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
  1930→
  1931→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1932→        await commitIfShadow(ctx.shadow, "item-ac-remove", itemSlug);
  1933→        success(`Removed acceptance criterion: ${acId} from @${itemSlug}`, {
  1934→          removed: acId,
  1935→        });
  1936→      } catch (err) {
  1937→        error(errors.failures.removeAc, err);
  1938→        process.exit(EXIT_CODES.ERROR);
  1939→      }
  1940→    });
  1941→}
  1942→
  1943→// ─── Patch Helpers ───────────────────────────────────────────────────────────
  1944→
  1945→/**
  1946→ * Read stdin fully with timeout (for bulk input).
  1947→ * Returns null if stdin is a TTY or empty.
  1948→ */
  1949→async function readStdinFully(): Promise<string | null> {
  1950→  if (process.stdin.isTTY) {
  1951→    return null;
  1952→  }
  1953→
  1954→  return new Promise((resolve) => {
  1955→    let data = "";
  1956→
  1957→    const onData = (chunk: string) => {
  1958→      data += chunk;
  1959→    };
  1960→    const onEnd = () => {
  1961→      clearTimeout(timeout);
  1962→      cleanup();
  1963→      resolve(data || null);
  1964→    };
  1965→    const onError = () => {
  1966→      clearTimeout(timeout);
  1967→      cleanup();
  1968→      resolve(null);
  1969→    };
  1970→    const cleanup = () => {
  1971→      process.stdin.removeListener("data", onData);
  1972→      process.stdin.removeListener("end", onEnd);
  1973→      process.stdin.removeListener("error", onError);
  1974→    };
  1975→
  1976→    const timeout = setTimeout(() => {
  1977→      cleanup();
  1978→      resolve(data || null);
  1979→    }, 5000); // 5 second timeout for bulk input
  1980→
  1981→    process.stdin.setEncoding("utf8");
  1982→    process.stdin.on("data", onData);
  1983→    process.stdin.on("end", onEnd);
  1984→    process.stdin.on("error", onError);
  1985→    process.stdin.resume();
  1986→  });
  1987→}
  1988→
  1989→/**
  1990→ * Read stdin if available (non-blocking for single item mode).
  1991→ * Returns null quickly if no data available.
  1992→ */
  1993→async function readStdinIfAvailable(): Promise<string | null> {
  1994→  if (process.stdin.isTTY) {
  1995→    return null;
  1996→  }
  1997→
  1998→  return new Promise((resolve) => {
  1999→    let data = "";
  2000→
  2001→    const onData = (chunk: string) => {
  2002→      data += chunk;
  2003→    };
  2004→    const onEnd = () => {
  2005→      clearTimeout(timeout);
  2006→      cleanup();
  2007→      resolve(data || null);
  2008→    };
  2009→    const onError = () => {
  2010→      clearTimeout(timeout);
  2011→      cleanup();
  2012→      resolve(null);
  2013→    };
  2014→    const cleanup = () => {
  2015→      process.stdin.removeListener("data", onData);
  2016→      process.stdin.removeListener("end", onEnd);
  2017→      process.stdin.removeListener("error", onError);
  2018→    };
  2019→
  2020→    const timeout = setTimeout(() => {
  2021→      cleanup();
  2022→      resolve(data || null);
  2023→    }, 100); // 100ms timeout for quick check
  2024→
  2025→    process.stdin.setEncoding("utf8");
  2026→    process.stdin.on("data", onData);
  2027→    process.stdin.on("end", onEnd);
  2028→    process.stdin.on("error", onError);
  2029→    process.stdin.resume();
  2030→  });
  2031→}
  2032→
  2033→/**
  2034→ * Parse bulk input (JSONL or JSON array)
  2035→ */
  2036→function parseBulkInput(input: string): PatchOperation[] {
  2037→  const trimmed = input.trim();
  2038→
  2039→  // Try JSON array first
  2040→  if (trimmed.startsWith("[")) {
  2041→    const parsed = JSON.parse(trimmed);
  2042→    if (!Array.isArray(parsed)) {
  2043→      throw new Error(errors.validation.expectedJsonArray);
  2044→    }
  2045→    return parsed.map((item, i) => validatePatchOperation(item, i));
  2046→  }
  2047→
  2048→  // Parse as JSONL (one JSON object per line)
  2049→  const lines = trimmed.split("\n").filter((line) => line.trim());
  2050→  return lines.map((line, i) => {
  2051→    try {
  2052→      return validatePatchOperation(JSON.parse(line), i);
  2053→    } catch (err) {
  2054→      throw new Error(
  2055→        errors.validation.jsonLineError(
  2056→          i + 1,
  2057→          err instanceof Error ? err.message : "Invalid JSON",
  2058→        ),
  2059→      );
  2060→    }
  2061→  });
  2062→}
  2063→
  2064→/**
  2065→ * Validate a patch operation object
  2066→ */
  2067→function validatePatchOperation(obj: unknown, index: number): PatchOperation {
  2068→  if (!obj || typeof obj !== "object") {
  2069→    throw new Error(errors.validation.patchMustBeObject(index));
  2070→  }
  2071→  const op = obj as Record<string, unknown>;
  2072→  if (typeof op.ref !== "string" || !op.ref) {
  2073→    throw new Error(errors.validation.patchMustHaveRef(index));
  2074→  }
  2075→  if (!op.data || typeof op.data !== "object") {
  2076→    throw new Error(errors.validation.patchMustHaveData(index));
  2077→  }
  2078→  return { ref: op.ref, data: op.data as Record<string, unknown> };
  2079→}
  2080→
  2081→/**
  2082→ * Format bulk patch result for human output
  2083→ */
  2084→function formatBulkPatchResult(
  2085→  result: BulkPatchResult,
  2086→  isDryRun = false,
  2087→): void {
  2088→  const prefix = isDryRun ? "Would patch" : "Patched";
  2089→  const updatedUlids = result.results
  2090→    .map((entry) => entry.ulid)
  2091→    .filter((ulid): ulid is string => typeof ulid === "string");
  2092→
  2093→  for (const r of result.results) {
  2094→    if (r.status === "updated") {
  2095→      const shortUlid = r.ulid
  2096→        ? shortestUniqueUlid(r.ulid, updatedUlids)
  2097→        : undefined;
  2098→      console.log(
  2099→        chalk.green("OK"),
  2100→        `${prefix}: ${r.ref} (${shortUlid})`,
  2101→      );
  2102→    } else if (r.status === "error") {
  2103→      console.log(chalk.red("ERR"), `${r.ref}: ${r.error}`);
  2104→    } else {
  2105→      console.log(chalk.gray("SKIP"), r.ref);
  2106→    }
  2107→  }
  2108→
  2109→  console.log("");
  2110→  console.log(chalk.bold("Summary:"));
  2111→  console.log(`  Total: ${result.summary.total}`);
  2112→  console.log(chalk.green(`  Updated: ${result.summary.updated}`));
  2113→  if (result.summary.failed > 0) {
  2114→    console.log(chalk.red(`  Failed: ${result.summary.failed}`));
  2115→  }
  2116→  if (result.summary.skipped > 0) {
  2117→    console.log(chalk.gray(`  Skipped: ${result.summary.skipped}`));
  2118→  }
  2119→}
  2120→
```