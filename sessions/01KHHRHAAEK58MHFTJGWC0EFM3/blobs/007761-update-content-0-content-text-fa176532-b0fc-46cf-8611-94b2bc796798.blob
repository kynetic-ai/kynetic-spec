   345→  describe('Edge cases', () => {
   346→    it('should handle skills with no source SKILL.md', async () => {
   347→      // Delete the source SKILL.md
   348→      await fs.rm(path.join(tempDir, 'skills', 'test-skill', 'SKILL.md'));
   349→
   350→      const result = kspecFull('skill render', tempDir);
   351→      expect(result.exitCode).toBe(0);
   352→
   353→      // Should create a placeholder
   354→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   355→      const content = await fs.readFile(renderedPath, 'utf-8');
   356→      expect(content).toContain('name: test-skill');
