   413→/**
   414→ * Tests for Skill Render CLI commands
   415→ * AC: @skill-render-cli ac-3, ac-4
   416→ */
   417→describe('Skill Render CLI', () => {
   418→  let tempDir: string;
   419→
   420→  beforeEach(async () => {
   421→    tempDir = await setupTempFixtures();
   422→    await initGitRepo(tempDir);
   423→
   424→    // Create a test skill
   425→    const result = kspecFull(
   426→      'skill add --id test-skill --name "Test Skill" --description "A test skill" --platform claude-code',
   427→      tempDir
   428→    );
   429→    if (result.exitCode !== 0) {
   430→      throw new Error(`skill add failed: ${result.stderr || result.stdout}`);
   431→    }
   432→
   433→    // Write custom content to the skill's SKILL.md
   434→    const skillMdPath = path.join(tempDir, 'skills', 'test-skill', 'SKILL.md');
   435→    await fs.writeFile(skillMdPath, '# Test Skill\n\nThis is test content.\n', 'utf-8');
   436→  });
   437→
   438→  afterEach(async () => {
   439→    await cleanupTempDir(tempDir);
   440→  });
   441→
   442→  // AC: @skill-render-cli ac-3
   443→  describe('ac-3: kspec skill status shows sync status table', () => {
   444→    it('should show "not-rendered" for skills not yet rendered', async () => {
   445→      const result = kspecFull('skill status', tempDir);
   446→      expect(result.exitCode).toBe(0);
   447→      expect(result.stdout).toContain('test-skill');
   448→      expect(result.stdout).toContain('not-rendered');
   449→    });
   450→
   451→    it('should show "in-sync" for skills that are in sync', async () => {
   452→      // Render the skill first
   453→      kspecFull('skill render', tempDir);
   454→
   455→      const result = kspecFull('skill status', tempDir);
   456→      expect(result.exitCode).toBe(0);
   457→      expect(result.stdout).toContain('test-skill');
   458→      expect(result.stdout).toContain('in-sync');
   459→      expect(result.stdout).toContain('All skills in sync');
   460→    });
   461→
   462→    it('should show "drifted" when rendered file differs from source', async () => {
   463→      // Render the skill
   464→      kspecFull('skill render', tempDir);
   465→
   466→      // Modify the rendered file directly
   467→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   468→      const content = await fs.readFile(renderedPath, 'utf-8');
   469→      await fs.writeFile(renderedPath, content + '\n\n# Added Section\n', 'utf-8');
   470→
   471→      const result = kspecFull('skill status', tempDir);
   472→      expect(result.exitCode).toBe(0);
   473→      expect(result.stdout).toContain('test-skill');
   474→      expect(result.stdout).toContain('drifted');
   475→      expect(result.stdout).toContain("run 'kspec skill render' to sync");
   476→    });
   477→
   478→    it('should output JSON with status fields', async () => {
   479→      kspecFull('skill render', tempDir);
   480→
   481→      const result = kspecJson<Array<{ id: string; status: string; docsStatus: string }>>(
   482→        'skill status',
   483→        tempDir
   484→      );
   485→
   486→      expect(result).toHaveLength(1);
   487→      expect(result[0].id).toBe('test-skill');
   488→      expect(result[0].status).toBe('in-sync');
   489→      expect(result[0].docsStatus).toBe('no-docs');
   490→    });
   491→
   492→    it('should track docs status separately', async () => {
   493→      // Add docs directory
   494→      const docsDir = path.join(tempDir, 'skills', 'test-skill', 'docs');
   495→      await fs.mkdir(docsDir, { recursive: true });
   496→      await fs.writeFile(path.join(docsDir, 'guide.md'), '# Guide\n', 'utf-8');
   497→
   498→      // Render
   499→      kspecFull('skill render', tempDir);
   500→
   501→      // Check status (should be in-sync)
   502→      let result = kspecJson<Array<{ id: string; status: string; docsStatus: string }>>(
   503→        'skill status',
   504→        tempDir
   505→      );
   506→      expect(result[0].docsStatus).toBe('in-sync');
   507→
   508→      // Modify source docs
   509→      await fs.writeFile(path.join(docsDir, 'guide.md'), '# Guide\n\nUpdated content.\n', 'utf-8');
   510→
   511→      // Check status again (docs should be drifted)
   512→      result = kspecJson<Array<{ id: string; status: string; docsStatus: string }>>(
   513→        'skill status',
   514→        tempDir
   515→      );
   516→      expect(result[0].docsStatus).toBe('drifted');
   517→    });
   518→  });
   519→
   520→  // AC: @skill-render-cli ac-4
   521→  describe('ac-4: kspec skill diff shows unified diff', () => {
   522→    it('should show "in sync" message when no diff', async () => {
   523→      // Render the skill
   524→      kspecFull('skill render', tempDir);
   525→
   526→      const result = kspecFull('skill diff test-skill', tempDir);
   527→      expect(result.exitCode).toBe(0);
   528→      expect(result.stdout).toContain('in sync');
   529→    });
   530→
   531→    it('should show unified diff when rendered file differs', async () => {
   532→      // Render the skill
   533→      kspecFull('skill render', tempDir);
   534→
   535→      // Modify the rendered file
   536→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   537→      const content = await fs.readFile(renderedPath, 'utf-8');
   538→      await fs.writeFile(renderedPath, content.replace('test content', 'modified content'), 'utf-8');
   539→
   540→      const result = kspecFull('skill diff test-skill', tempDir);
   541→      expect(result.exitCode).toBe(0);
   542→      expect(result.stdout).toContain('drifted');
   543→      expect(result.stdout).toContain('---'); // Diff header
   544→      expect(result.stdout).toContain('+++'); // Diff header
   545→      expect(result.stdout).toContain('@@'); // Hunk header
   546→    });
   547→
   548→    it('should show full diff when rendered file does not exist', async () => {
   549→      // Don't render, so rendered file doesn't exist
   550→      const result = kspecFull('skill diff test-skill', tempDir);
   551→      expect(result.exitCode).toBe(0);
   552→      expect(result.stdout).toContain('drifted');
   553→      expect(result.stdout).toContain('+'); // All lines are additions
   554→    });
   555→
   556→    it('should error when skill not found', async () => {
   557→      const result = kspecFull('skill diff nonexistent', tempDir);
   558→      expect(result.exitCode).not.toBe(0);
   559→      expect(result.stderr).toContain('Skill not found');
   560→    });
   561→
   562→    it('should output JSON with diff lines', async () => {
   563→      kspecFull('skill render', tempDir);
   564→
   565→      // Modify rendered file
   566→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   567→      const content = await fs.readFile(renderedPath, 'utf-8');
   568→      await fs.writeFile(renderedPath, content.replace('test content', 'changed'), 'utf-8');
   569→
   570→      const result = kspecJson<{ id: string; hasDiff: boolean; diff: string[] }>(
   571→        'skill diff test-skill',
   572→        tempDir
   573→      );
   574→
   575→      expect(result.id).toBe('test-skill');
   576→      expect(result.hasDiff).toBe(true);
   577→      expect(result.diff).toBeInstanceOf(Array);
   578→      expect(result.diff.length).toBeGreaterThan(0);
   579→      expect(result.diff.some((line) => line.startsWith('---'))).toBe(true);
   580→      expect(result.diff.some((line) => line.startsWith('+++'))).toBe(true);
   581→    });
   582→
   583→    it('should return empty diff array when in sync', async () => {
   584→      kspecFull('skill render', tempDir);
   585→
   586→      const result = kspecJson<{ id: string; hasDiff: boolean; diff: string[] }>(
   587→        'skill diff test-skill',
   588→        tempDir
   589→      );
   590→
   591→      expect(result.hasDiff).toBe(false);
   592→      expect(result.diff).toEqual([]);
   593→    });
   594→  });
   595→});
   596→
   597→/**
   598→ * Tests for Skill Drift Detection
   599→ * AC: @skill-drift-detection ac-1 through ac-5
   600→ */
   601→describe('Skill Drift Detection', () => {
   602→  let tempDir: string;
   603→
   604→  beforeEach(async () => {
   605→    tempDir = await setupTempFixtures();
   606→    await initGitRepo(tempDir);
   607→
   608→    // Create a test skill
   609→    const result = kspecFull(
   610→      'skill add --id test-skill --name "Test Skill" --description "A test skill" --platform claude-code',
   611→      tempDir
   612→    );
   613→    if (result.exitCode !== 0) {
   614→      throw new Error(`skill add failed: ${result.stderr || result.stdout}`);
   615→    }
   616→
   617→    // Write custom content to the skill's SKILL.md
   618→    const skillMdPath = path.join(tempDir, 'skills', 'test-skill', 'SKILL.md');
   619→    await fs.writeFile(skillMdPath, '# Test Skill\n\nThis is test content.\n', 'utf-8');
   620→  });
   621→
   622→  afterEach(async () => {
   623→    await cleanupTempDir(tempDir);
   624→  });
   625→
   626→  // AC: @skill-drift-detection ac-1
   627→  describe('ac-1: Skill shows as in sync when not manually edited', () => {
   628→    it('should show in-sync after rendering', async () => {
   629→      kspecFull('skill render', tempDir);
   630→
   631→      const result = kspecFull('skill status', tempDir);
   632→      expect(result.exitCode).toBe(0);
   633→      expect(result.stdout).toContain('test-skill');
   634→      expect(result.stdout).toContain('in-sync');
   635→    });
   636→
   637→    it('should show in-sync on re-render without changes', async () => {
   638→      kspecFull('skill render', tempDir);
   639→      kspecFull('skill render', tempDir);
   640→
   641→      const result = kspecFull('skill status', tempDir);
   642→      expect(result.exitCode).toBe(0);
   643→      expect(result.stdout).toContain('in-sync');
   644→    });
   645→  });
   646→
   647→  // AC: @skill-drift-detection ac-2
   648→  describe('ac-2: Skill shows as drifted when manually edited', () => {
   649→    it('should show drifted after manual edit to rendered file', async () => {
   650→      // Render the skill
   651→      kspecFull('skill render', tempDir);
   652→
   653→      // Manually edit the rendered file
   654→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   655→      const content = await fs.readFile(renderedPath, 'utf-8');
   656→      await fs.writeFile(renderedPath, content + '\n\n# Manually Added Section\n', 'utf-8');
   657→
   658→      const result = kspecFull('skill status', tempDir);
   659→      expect(result.exitCode).toBe(0);
   660→      expect(result.stdout).toContain('test-skill');
   661→      expect(result.stdout).toContain('drifted');
   662→    });
   663→
   664→    it('should show drifted with the file path in message', async () => {
   665→      kspecFull('skill render', tempDir);
   666→
   667→      // Manually edit
   668→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   669→      const content = await fs.readFile(renderedPath, 'utf-8');
   670→      await fs.writeFile(renderedPath, content + '\nEdited.\n', 'utf-8');
   671→
   672→      const result = kspecFull('skill status', tempDir);
   673→      expect(result.stdout).toContain('drifted');
   674→      expect(result.stdout).toContain("run 'kspec skill render' to sync");
   675→    });
   676→  });
   677→
   678→  // AC: @skill-drift-detection ac-3
   679→  describe('ac-3: Drifted skill is skipped without --force', () => {
   680→    it('should skip drifted skill with warning when rendering without --force', async () => {
   681→      // First render
   682→      kspecFull('skill render', tempDir);
   683→
   684→      // Manually edit the rendered file
   685→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   686→      const originalContent = await fs.readFile(renderedPath, 'utf-8');
   687→      const editedContent = originalContent + '\n\n# Manually Added\n';
   688→      await fs.writeFile(renderedPath, editedContent, 'utf-8');
   689→
   690→      // Try to render again without --force
   691→      const result = kspecFull('skill render', tempDir);
   692→      expect(result.exitCode).toBe(0);
   693→      expect(result.stdout).toContain('Skipped');
   694→      expect(result.stdout).toContain('drifted');
   695→      expect(result.stdout).toContain('--force to overwrite');
   696→
   697→      // Verify the file was NOT overwritten
   698→      const afterContent = await fs.readFile(renderedPath, 'utf-8');
   699→      expect(afterContent).toBe(editedContent);
   700→      expect(afterContent).toContain('# Manually Added');
   701→    });
   702→
   703→    it('should show skip reason in JSON output', async () => {
   704→      kspecFull('skill render', tempDir);
   705→
   706→      // Edit the file
   707→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   708→      const content = await fs.readFile(renderedPath, 'utf-8');
   709→      await fs.writeFile(renderedPath, content + '\nEdited.\n', 'utf-8');
   710→
   711→      const result = kspecJson<{
   712→        rendered: Array<{ id: string; action: string; skipReason?: string }>;
   713→      }>('skill render', tempDir);
   714→
   715→      expect(result.rendered[0].action).toBe('skipped');
   716→      expect(result.rendered[0].skipReason).toContain('drifted');
   717→    });
   718→  });
   719→
   720→  // AC: @skill-drift-detection ac-4
   721→  describe('ac-4: Drifted skill is overwritten with --force', () => {
   722→    it('should overwrite drifted skill when using --force', async () => {
   723→      // First render
   724→      kspecFull('skill render', tempDir);
   725→
   726→      // Get the original content
   727→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   728→      const originalContent = await fs.readFile(renderedPath, 'utf-8');
   729→
   730→      // Manually edit the rendered file
   731→      await fs.writeFile(renderedPath, originalContent + '\n\n# Manually Added\n', 'utf-8');
   732→
   733→      // Verify it's drifted
   734→      let status = kspecFull('skill status', tempDir);
   735→      expect(status.stdout).toContain('drifted');
   736→
   737→      // Render with --force
   738→      const result = kspecFull('skill render --force', tempDir);
   739→      expect(result.exitCode).toBe(0);
   740→      expect(result.stdout).toContain('Updated');
   741→      expect(result.stdout).toContain('test-skill');
   742→
   743→      // Verify the file was overwritten
   744→      const afterContent = await fs.readFile(renderedPath, 'utf-8');
   745→      expect(afterContent).not.toContain('# Manually Added');
   746→      expect(afterContent.trim()).toBe(originalContent.trim());
   747→
   748→      // Verify status is now in-sync
   749→      status = kspecFull('skill status', tempDir);
   750→      expect(status.stdout).toContain('in-sync');
   751→    });
   752→
   753→    it('should update hash after force overwrite', async () => {
   754→      kspecFull('skill render', tempDir);
   755→
   756→      // Edit the file
   757→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   758→      const content = await fs.readFile(renderedPath, 'utf-8');
   759→      await fs.writeFile(renderedPath, content + '\nEdited.\n', 'utf-8');
   760→
   761→      // Force render
   762→      kspecFull('skill render --force', tempDir);
   763→
   764→      // Status should be in-sync (hash was updated)
   765→      const status = kspecFull('skill status', tempDir);
   766→      expect(status.stdout).toContain('in-sync');
   767→    });
   768→  });
   769→
   770→  // AC: @skill-drift-detection ac-5
   771→  describe('ac-5: Render hash is stored in .kspec/skills/<id>/.render-hash', () => {
   772→    it('should create .render-hash file after successful render', async () => {
   773→      kspecFull('skill render', tempDir);
   774→
   775→      // Check if hash file exists
   776→      // In test fixtures, skills are stored in tempDir/skills/ not tempDir/.kspec/skills/
   777→      const hashPath = path.join(tempDir, 'skills', 'test-skill', '.render-hash');
   778→      const hashContent = await fs.readFile(hashPath, 'utf-8');
   779→
   780→      expect(hashContent.trim()).toBeTruthy();
   781→      // SHA256 hashes are 64 hex characters
   782→      expect(hashContent.trim()).toMatch(/^[a-f0-9]{64}$/);
   783→    });
   784→
   785→    it('should update .render-hash on subsequent renders', async () => {
   786→      // First render
   787→      kspecFull('skill render', tempDir);
   788→
   789→      const hashPath = path.join(tempDir, 'skills', 'test-skill', '.render-hash');
   790→      const firstHash = await fs.readFile(hashPath, 'utf-8');
   791→
   792→      // Modify source content
   793→      const skillMdPath = path.join(tempDir, 'skills', 'test-skill', 'SKILL.md');
   794→      await fs.writeFile(skillMdPath, '# Test Skill\n\nUpdated content.\n', 'utf-8');
   795→
   796→      // Second render
   797→      kspecFull('skill render', tempDir);
   798→
   799→      const secondHash = await fs.readFile(hashPath, 'utf-8');
   800→
   801→      // Hashes should be different
   802→      expect(secondHash.trim()).not.toBe(firstHash.trim());
   803→    });
   804→
   805→    it('should not create .render-hash during dry run', async () => {
   806→      kspecFull('skill render --dry-run', tempDir);
   807→
   808→      const hashPath = path.join(tempDir, 'skills', 'test-skill', '.render-hash');
   809→      await expect(fs.access(hashPath)).rejects.toThrow();
   810→    });
   811→
   812→    it('should use hash to detect drift, not content comparison', async () => {
   813→      // Render the skill
   814→      kspecFull('skill render', tempDir);
   815→
   816→      // Get the rendered content
   817→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   818→      const content = await fs.readFile(renderedPath, 'utf-8');
   819→
   820→      // Manually edit the rendered file but put back original content after
   821→      await fs.writeFile(renderedPath, content + '\nTemporary edit.\n', 'utf-8');
   822→
   823→      // Even if we restore content, hash won't match original since file was overwritten
   824→      // Actually, let's test the opposite - modify source but not rendered
   825→      // The status should still show in-sync because hash matches
   826→
   827→      // For this test, we check that modifying rendered file (even slightly) breaks hash match
   828→      await fs.writeFile(renderedPath, content + ' ', 'utf-8'); // Add trailing space
   829→
   830→      const status = kspecFull('skill status', tempDir);
   831→      expect(status.stdout).toContain('drifted');
   832→    });
   833→  });
   834→
   835→  describe('Edge cases', () => {
   836→    it('should handle missing hash file gracefully (legacy renders)', async () => {
   837→      // Render the skill
   838→      kspecFull('skill render', tempDir);
   839→
   840→      // Delete the hash file to simulate legacy render
   841→      const hashPath = path.join(tempDir, 'skills', 'test-skill', '.render-hash');
   842→      await fs.rm(hashPath);
   843→
   844→      // Status should fall back to content comparison
   845→      const status = kspecFull('skill status', tempDir);
   846→      expect(status.stdout).toContain('in-sync');
   847→    });
   848→
   849→    it('should allow rendering non-drifted skills normally', async () => {
   850→      // First render
   851→      kspecFull('skill render', tempDir);
   852→
   853→      // Modify source content (not rendered file)
   854→      const skillMdPath = path.join(tempDir, 'skills', 'test-skill', 'SKILL.md');
   855→      await fs.writeFile(skillMdPath, '# Test Skill\n\nUpdated source content.\n', 'utf-8');
   856→
   857→      // Render again - should work without --force because file isn't drifted
   858→      const result = kspecFull('skill render', tempDir);
   859→      expect(result.exitCode).toBe(0);
   860→      expect(result.stdout).toContain('Updated');
   861→      expect(result.stdout).not.toContain('Skipped');
   862→
   863→      // Verify update was applied
   864→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   865→      const renderedContent = await fs.readFile(renderedPath, 'utf-8');
   866→      expect(renderedContent).toContain('Updated source content');
   867→    });
   868→
   869→    it('should handle multiple skills with mixed drift states', async () => {
   870→      // Add another skill
   871→      kspecFull(
   872→        'skill add --id another-skill --name "Another Skill" --description "Another test" --platform claude-code',
   873→        tempDir
   874→      );
   875→      const anotherSkillMd = path.join(tempDir, 'skills', 'another-skill', 'SKILL.md');
   876→      await fs.writeFile(anotherSkillMd, '# Another Skill\n\nAnother content.\n', 'utf-8');
   877→
   878→      // Render both skills
   879→      kspecFull('skill render', tempDir);
   880→
   881→      // Edit only the first skill's rendered file
   882→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   883→      const content = await fs.readFile(renderedPath, 'utf-8');
   884→      await fs.writeFile(renderedPath, content + '\nEdited.\n', 'utf-8');
   885→
   886→      // Render without --force - should skip test-skill but render another-skill
   887→      const result = kspecFull('skill render', tempDir);
   888→      expect(result.stdout).toContain('Skipped');
   889→      expect(result.stdout).toContain('test-skill');
   890→      expect(result.stdout).toContain('Unchanged'); // another-skill
   891→
   892→      // With --force - should update both
   893→      const forceResult = kspecFull('skill render --force', tempDir);
   894→      expect(forceResult.stdout).toContain('Updated');
   895→      expect(forceResult.stdout).toContain('test-skill');
   896→    });
   897→  });
   898→});
   899→
   900→/**
   901→ * Tests for Extended Frontmatter in Claude Code Renderer
   902→ * AC: @claude-code-renderer-extended ac-1 through ac-8
   903→ */
   904→describe('Claude Code Renderer - Extended Frontmatter', () => {
   905→  let tempDir: string;
   906→
   907→  beforeEach(async () => {
   908→    tempDir = await setupTempFixtures();
   909→    await initGitRepo(tempDir);
   910→  });
   911→
   912→  afterEach(async () => {
   913→    await cleanupTempDir(tempDir);
   914→  });
   915→
   916→  // AC: @claude-code-renderer-extended ac-1
   917→  describe('ac-1: Portable fields (license, allowed-tools) in frontmatter', () => {
   918→    it('should include license field when skill has license', async () => {
   919→      // Create skill with license
   920→      const result = kspecFull(
   921→        'skill add --id licensed-skill --name "Licensed Skill" --description "A skill with license" --platform claude-code',
   922→        tempDir
   923→      );
   924→      expect(result.exitCode).toBe(0);
   925→
   926→      // Manually update meta.yaml to add license field (proper indentation with 4 spaces)
   927→      const metaPath = path.join(tempDir, 'kynetic.meta.yaml');
   928→      let metaContent = await fs.readFile(metaPath, 'utf-8');
   929→      metaContent = metaContent.replace(
   930→        /id: licensed-skill\n/,
   931→        'id: licensed-skill\n    license: MIT\n'
   932→      );
   933→      await fs.writeFile(metaPath, metaContent, 'utf-8');
   934→
   935→      // Write content
   936→      const skillMdPath = path.join(tempDir, 'skills', 'licensed-skill', 'SKILL.md');
   937→      await fs.writeFile(skillMdPath, '# Licensed Skill\n\nContent.\n', 'utf-8');
   938→
   939→      // Render
   940→      kspecFull('skill render', tempDir);
   941→
   942→      // Check frontmatter
   943→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'licensed-skill', 'SKILL.md');
   944→      const renderedContent = await fs.readFile(renderedPath, 'utf-8');
   945→      expect(renderedContent).toContain('license: MIT');
   946→    });
   947→
   948→    it('should include allowed-tools when skill has allowed_tools', async () => {
   949→      // Create skill
   950→      kspecFull(
   951→        'skill add --id tools-skill --name "Tools Skill" --description "A skill with tools" --platform claude-code',
   952→        tempDir
   953→      );
   954→
   955→      // Replace the empty allowed_tools array with actual tools
   956→      const metaPath = path.join(tempDir, 'kynetic.meta.yaml');
   957→      let metaContent = await fs.readFile(metaPath, 'utf-8');
   958→      // The skill add command creates: allowed_tools: []
   959→      // Replace that with our array
   960→      metaContent = metaContent.replace(
   961→        /    allowed_tools: \[\]/,
   962→        '    allowed_tools:\n      - Bash\n      - Read'
   963→      );
   964→      await fs.writeFile(metaPath, metaContent, 'utf-8');
   965→
   966→      // Write content
   967→      const skillMdPath = path.join(tempDir, 'skills', 'tools-skill', 'SKILL.md');
   968→      await fs.writeFile(skillMdPath, '# Tools Skill\n\nContent.\n', 'utf-8');
   969→
   970→      // Render
   971→      kspecFull('skill render', tempDir);
   972→
   973→      // Check frontmatter
   974→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'tools-skill', 'SKILL.md');
   975→      const renderedContent = await fs.readFile(renderedPath, 'utf-8');
   976→      expect(renderedContent).toContain('allowed-tools:');
   977→      expect(renderedContent).toContain('- Bash');
   978→      expect(renderedContent).toContain('- Read');
   979→    });
   980→  });
   981→
   982→  // AC: @claude-code-renderer-extended ac-2
   983→  describe('ac-2: user-invocable from platform_config.claude_code', () => {
   984→    it('should include user-invocable: false when configured', async () => {
   985→      kspecFull(
   986→        'skill add --id ui-skill --name "UI Skill" --description "A skill" --platform claude-code',
   987→        tempDir
   988→      );
   989→
   990→      // Update meta.yaml with platform_config (proper indentation)
   991→      const metaPath = path.join(tempDir, 'kynetic.meta.yaml');
   992→      let metaContent = await fs.readFile(metaPath, 'utf-8');
   993→      metaContent = metaContent.replace(
   994→        /id: ui-skill\n/,
   995→        'id: ui-skill\n    platform_config:\n      claude_code:\n        user_invocable: false\n'
   996→      );
   997→      await fs.writeFile(metaPath, metaContent, 'utf-8');
   998→
   999→      const skillMdPath = path.join(tempDir, 'skills', 'ui-skill', 'SKILL.md');
  1000→      await fs.writeFile(skillMdPath, '# UI Skill\n', 'utf-8');
  1001→
  1002→      kspecFull('skill render', tempDir);
  1003→
  1004→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'ui-skill', 'SKILL.md');
  1005→      const renderedContent = await fs.readFile(renderedPath, 'utf-8');
  1006→      expect(renderedContent).toContain('user-invocable: false');
  1007→    });
  1008→  });
  1009→
  1010→  // AC: @claude-code-renderer-extended ac-3
  1011→  describe('ac-3: context and agent from platform_config.claude_code', () => {
  1012→    it('should include context: fork and agent when configured', async () => {
  1013→      kspecFull(
