```
     1→/**
     2→ * Tests for Skill Rendering Pipeline
     3→ * AC: @skill-rendering ac-1 through ac-5
     4→ * AC: @trait-dry-run (dry run support)
     5→ */
     6→
     7→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     8→import * as fs from 'node:fs/promises';
     9→import * as path from 'node:path';
    10→import {
    11→  kspec as kspecFull,
    12→  kspecOutput as kspec,
    13→  kspecJson,
    14→  setupTempFixtures,
    15→  cleanupTempDir,
    16→  initGitRepo,
    17→} from './helpers/cli';
    18→
    19→describe('Skill Rendering Pipeline', () => {
    20→  let tempDir: string;
    21→
    22→  beforeEach(async () => {
    23→    tempDir = await setupTempFixtures();
    24→    await initGitRepo(tempDir);
    25→
    26→    // Create a test skill
    27→    const result = kspecFull(
    28→      'skill add --id test-skill --name "Test Skill" --description "A test skill for rendering" --platform claude-code',
    29→      tempDir
    30→    );
    31→    if (result.exitCode !== 0) {
    32→      throw new Error(`skill add failed: ${result.stderr || result.stdout}`);
    33→    }
    34→
    35→    // Note: In test fixtures (non-shadow mode), skills are at tempDir/skills/ not tempDir/.kspec/skills/
    36→    const skillMdPath = path.join(tempDir, 'skills', 'test-skill', 'SKILL.md');
    37→
    38→    // Write custom content to the skill's SKILL.md
    39→    await fs.writeFile(skillMdPath, '# Test Skill\n\nThis is test content.\n', 'utf-8');
    40→  });
    41→
    42→  afterEach(async () => {
    43→    await cleanupTempDir(tempDir);
    44→  });
    45→
    46→  // AC: @skill-rendering ac-1
    47→  describe('ac-1: Creates .claude/skills/<id>/SKILL.md with YAML frontmatter', () => {
    48→    it('should create SKILL.md with YAML frontmatter when rendering', async () => {
    49→      kspecFull('skill render', tempDir);
    50→
    51→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
    52→      const content = await fs.readFile(renderedPath, 'utf-8');
    53→
    54→      // Check frontmatter exists
    55→      expect(content).toMatch(/^---\n/);
    56→      expect(content).toContain('name: test-skill');
    57→      expect(content).toContain('description: A test skill for rendering');
    58→      expect(content).toContain('---');
    59→
    60→      // Check marker is present
    61→      expect(content).toContain('<!-- kspec-managed -->');
    62→
    63→      // Check original content is preserved
    64→      expect(content).toContain('# Test Skill');
    65→      expect(content).toContain('This is test content.');
    66→    });
    67→
    68→    it('should use skill id as frontmatter name', async () => {
    69→      kspecFull('skill render', tempDir);
    70→
    71→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
    72→      const content = await fs.readFile(renderedPath, 'utf-8');
    73→
    74→      // name should be the skill id, not the skill name
    75→      expect(content).toContain('name: test-skill');
    76→    });
    77→  });
    78→
    79→  // AC: @skill-rendering ac-2
    80→  describe('ac-2: Copies docs to .claude/skills/<id>/docs/', () => {
    81→    beforeEach(async () => {
    82→      // Create docs directory in source
    83→      const docsDir = path.join(tempDir, 'skills', 'test-skill', 'docs');
    84→      await fs.mkdir(docsDir, { recursive: true });
    85→      await fs.writeFile(path.join(docsDir, 'quickref.md'), '# Quick Reference\n\nSome docs.\n', 'utf-8');
    86→      await fs.writeFile(path.join(docsDir, 'advanced.md'), '# Advanced Guide\n\nMore docs.\n', 'utf-8');
    87→    });
    88→
    89→    it('should copy docs directory to rendered location', async () => {
    90→      kspecFull('skill render', tempDir);
    91→
    92→      const renderedDocsDir = path.join(tempDir, '.claude', 'skills', 'test-skill', 'docs');
    93→      const quickref = await fs.readFile(path.join(renderedDocsDir, 'quickref.md'), 'utf-8');
    94→      const advanced = await fs.readFile(path.join(renderedDocsDir, 'advanced.md'), 'utf-8');
    95→
    96→      expect(quickref).toContain('# Quick Reference');
    97→      expect(advanced).toContain('# Advanced Guide');
    98→    });
    99→
   100→    it('should work when skill has no docs directory', async () => {
   101→      // Remove the docs we just created
   102→      await fs.rm(path.join(tempDir, 'skills', 'test-skill', 'docs'), { recursive: true });
   103→
   104→      const result = kspecFull('skill render', tempDir);
   105→      expect(result.exitCode).toBe(0);
   106→
   107→      // Should still render the skill successfully
   108→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   109→      const content = await fs.readFile(renderedPath, 'utf-8');
   110→      expect(content).toContain('# Test Skill');
   111→    });
   112→  });
   113→
   114→  // AC: @skill-rendering ac-3
   115→  describe('ac-3: Idempotent rendering', () => {
   116→    it('should not modify files when called twice with no content changes', async () => {
   117→      // First render
   118→      kspecFull('skill render', tempDir);
   119→
   120→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   121→      const firstRenderStats = await fs.stat(renderedPath);
   122→      const firstRenderMtime = firstRenderStats.mtimeMs;
   123→
   124→      // Wait a bit to ensure different mtime if file is modified
   125→      await new Promise((resolve) => setTimeout(resolve, 10));
   126→
   127→      // Second render - should report unchanged
   128→      const result = kspecFull('skill render', tempDir);
   129→      expect(result.stdout).toContain('Unchanged');
   130→
   131→      // Check file was not modified
   132→      const secondRenderStats = await fs.stat(renderedPath);
   133→      expect(secondRenderStats.mtimeMs).toBe(firstRenderMtime);
   134→    });
   135→
   136→    it('should update files when source content changes', async () => {
   137→      // First render
   138→      kspecFull('skill render', tempDir);
   139→
   140→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   141→      const firstContent = await fs.readFile(renderedPath, 'utf-8');
   142→
   143→      // Modify source
   144→      const skillMdPath = path.join(tempDir, 'skills', 'test-skill', 'SKILL.md');
   145→      await fs.writeFile(skillMdPath, '# Test Skill\n\nUpdated content!\n', 'utf-8');
   146→
   147→      // Second render
   148→      const result = kspecFull('skill render', tempDir);
   149→      expect(result.stdout).toContain('Updated');
   150→
   151→      // Check file was updated
   152→      const secondContent = await fs.readFile(renderedPath, 'utf-8');
   153→      expect(secondContent).toContain('Updated content!');
   154→      expect(secondContent).not.toBe(firstContent);
   155→    });
   156→
   157→    it('should report unchanged in JSON output when no changes', async () => {
   158→      kspecFull('skill render', tempDir);
   159→
   160→      const result = kspecJson<{
   161→        dry_run: boolean;
   162→        rendered: Array<{ id: string; action: string }>;
   163→      }>('skill render', tempDir);
   164→
   165→      expect(result.rendered[0].action).toBe('unchanged');
   166→    });
   167→  });
   168→
   169→  // AC: @skill-rendering ac-4, ac-5
   170→  describe('ac-4, ac-5: Clean removes orphaned managed skills', () => {
   171→    it('should remove managed skill directories that no longer exist in meta', async () => {
   172→      // Render the skill first
   173→      kspecFull('skill render', tempDir);
   174→
   175→      // Verify it was rendered
   176→      const renderedPath = path.join(tempDir, '.claude', 'skills', 'test-skill', 'SKILL.md');
   177→      await fs.access(renderedPath);
   178→
   179→      // Delete the skill from meta
   180→      kspecFull('skill delete test-skill --confirm', tempDir);
   181→
   182→      // Run render --clean
   183→      const result = kspecFull('skill render --clean', tempDir);
   184→      expect(result.stdout).toContain('Removed');
   185→      expect(result.stdout).toContain('test-skill');
   186→
   187→      // Verify directory was removed
   188→      await expect(fs.access(path.join(tempDir, '.claude', 'skills', 'test-skill'))).rejects.toThrow();
   189→    });
   190→
   191→    it('should NOT remove unmanaged skill directories (ac-4)', async () => {
   192→      // Create an unmanaged skill directory (no kspec-managed marker)
   193→      const unmanagedDir = path.join(tempDir, '.claude', 'skills', 'unmanaged-skill');
   194→      await fs.mkdir(unmanagedDir, { recursive: true });
   195→      await fs.writeFile(
   196→        path.join(unmanagedDir, 'SKILL.md'),
   197→        '---\nname: unmanaged\n---\n\n# Unmanaged\n\nNo marker.\n',
   198→        'utf-8'
   199→      );
   200→
   201→      // Run render --clean
   202→      const result = kspecFull('skill render --clean', tempDir);
   203→      expect(result.stdout).toContain('Skipped');
   204→      expect(result.stdout).toContain('unmanaged');
   205→
   206→      // Verify directory was NOT removed
   207→      const content = await fs.readFile(path.join(unmanagedDir, 'SKILL.md'), 'utf-8');
   208→      expect(content).toContain('# Unmanaged');
   209→    });
   210→
   211→    it('should identify managed skills by kspec-managed marker', async () => {
   212→      // Render a skill (will have marker)
   213→      kspecFull('skill render', tempDir);
   214→
   215→      // Create another "orphan" with the marker manually
   216→      const orphanDir = path.join(tempDir, '.claude', 'skills', 'orphan-skill');
   217→      await fs.mkdir(orphanDir, { recursive: true });
   218→      await fs.writeFile(
   219→        path.join(orphanDir, 'SKILL.md'),
   220→        '---\nname: orphan\n---\n<!-- kspec-managed -->\n\n# Orphan\n',
   221→        'utf-8'
   222→      );
   223→
   224→      // Delete the original skill
   225→      kspecFull('skill delete test-skill --confirm', tempDir);
   226→
   227→      // Run render --clean - should remove both orphaned managed skills
   228→      const result = kspecFull('skill render --clean', tempDir);
   229→
   230→      // Both should be removed
   231→      await expect(fs.access(path.join(tempDir, '.claude', 'skills', 'test-skill'))).rejects.toThrow();
   232→      await expect(fs.access(path.join(tempDir, '.claude', 'skills', 'orphan-skill'))).rejects.toThrow();
   233→    });
   234→  });
   235→
   236→  // AC: @trait-dry-run
   237→  describe('Dry run mode (trait)', () => {
   238→    it('should not modify files when --dry-run is provided (ac-2)', async () => {
   239→      kspecFull('skill render --dry-run', tempDir);
   240→
   241→      // Rendered directory should NOT exist
   242→      await expect(
