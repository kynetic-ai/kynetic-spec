```
     1→/**
     2→ * Meta manifest loading and operations.
     3→ *
     4→ * The meta manifest (kynetic.meta.yaml) contains process definitions:
     5→ * - Agents: roles, capabilities, conventions
     6→ * - Workflows: structured processes with steps
     7→ * - Conventions: project rules and standards
     8→ * - Observations: feedback about processes
     9→ */
    10→
    11→import * as fs from "node:fs/promises";
    12→import * as path from "node:path";
    13→import { ulid } from "ulid";
    14→import {
    15→  type Agent,
    16→  AgentSchema,
    17→  type Convention,
    18→  ConventionSchema,
    19→  getMetaItemType,
    20→  type MetaItem,
    21→  type MetaManifest,
    22→  MetaManifestSchema,
    23→  type Observation,
    24→  ObservationSchema,
    25→  type ObservationType,
    26→  type SessionContext,
    27→  SessionContextSchema,
    28→  type Skill,
    29→  SkillSchema,
    30→  type Workflow,
    31→  type WorkflowRun,
    32→  type WorkflowRunsFile,
    33→  WorkflowRunsFileSchema,
    34→  WorkflowSchema,
    35→} from "../schema/index.js";
    36→import type { KspecContext } from "./yaml.js";
    37→import {
    38→  expandIncludePattern,
    39→  getAuthor,
    40→  readYamlFile,
    41→  writeYamlFilePreserveFormat,
    42→} from "./yaml.js";
    43→
    44→/**
    45→ * Loaded agent with runtime metadata
    46→ */
    47→export interface LoadedAgent extends Agent {
    48→  _sourceFile?: string;
    49→}
    50→
    51→/**
    52→ * Loaded workflow with runtime metadata
    53→ */
    54→export interface LoadedWorkflow extends Workflow {
    55→  _sourceFile?: string;
    56→}
    57→
    58→/**
    59→ * Loaded convention with runtime metadata
    60→ */
    61→export interface LoadedConvention extends Convention {
    62→  _sourceFile?: string;
    63→}
    64→
    65→/**
    66→ * Loaded observation with runtime metadata
    67→ */
    68→export interface LoadedObservation extends Observation {
    69→  _sourceFile?: string;
    70→}
    71→
    72→/**
    73→ * Loaded skill with runtime metadata
    74→ */
    75→export interface LoadedSkill extends Skill {
    76→  _sourceFile?: string;
    77→}
    78→
    79→/**
    80→ * Any loaded meta item
    81→ */
    82→export type LoadedMetaItem =
    83→  | LoadedAgent
    84→  | LoadedWorkflow
    85→  | LoadedConvention
    86→  | LoadedObservation
    87→  | LoadedSkill;
    88→
    89→/**
    90→ * Meta context containing all loaded meta items
    91→ */
    92→export interface MetaContext {
    93→  manifest: MetaManifest | null;
    94→  manifestPath: string | null;
    95→  agents: LoadedAgent[];
    96→  workflows: LoadedWorkflow[];
    97→  conventions: LoadedConvention[];
    98→  observations: LoadedObservation[];
    99→  skills: LoadedSkill[];
   100→}
   101→
   102→/**
   103→ * Find the meta manifest file.
   104→ *
   105→ * Discovery algorithm:
   106→ * 1. Check for explicit name: kynetic.meta.yaml (backward compat)
   107→ * 2. If not found, scan directory for *.meta.yaml files
   108→ * 3. For each candidate, validate it contains a 'kynetic_meta:' version field
   109→ * 4. Return first valid match (alphabetically after explicit name)
   110→ *
   111→ * AC: @meta-manifest-discovery ac-1, ac-2, ac-3
   112→ */
   113→export async function findMetaManifest(
   114→  specDir: string,
   115→): Promise<string | null> {
   116→  // AC: @meta-manifest-discovery ac-1, ac-3 - explicit name has priority
   117→  const priorityPath = path.join(specDir, "kynetic.meta.yaml");
   118→  try {
   119→    await fs.access(priorityPath);
   120→    return priorityPath;
   121→  } catch {
   122→    // Continue to glob fallback
   123→  }
   124→
   125→  // AC: @meta-manifest-discovery ac-2, ac-3 - glob fallback with validation
   126→  try {
   127→    const entries = await fs.readdir(specDir);
   128→    // AC: @meta-manifest-discovery ac-3 - alphabetical order
   129→    const candidates = entries
   130→      .filter((f) => f.endsWith(".meta.yaml"))
   131→      .sort();
   132→
   133→    for (const candidate of candidates) {
   134→      const filePath = path.join(specDir, candidate);
   135→      try {
   136→        const raw = await readYamlFile<unknown>(filePath);
   137→        // AC: @meta-manifest-discovery ac-2 - validate kynetic_meta version field
   138→        if (raw && typeof raw === "object" && "kynetic_meta" in raw) {
   139→          return filePath;
   140→        }
   141→      } catch {
   142→        // Skip invalid files
   143→      }
   144→    }
   145→  } catch {
   146→    // Directory read failed
   147→  }
   148→
   149→  return null;
   150→}
   151→
   152→/**
   153→ * Get the base name (slug) from a manifest path.
   154→ * E.g., "kynetic.yaml" -> "kynetic", "myproject.spec.yaml" -> "myproject"
   155→ */
   156→function getManifestBaseName(manifestPath: string | null): string {
   157→  if (!manifestPath) return "kynetic";
   158→  const fileName = path.basename(manifestPath);
   159→  // Remove .yaml extension
   160→  let baseName = fileName.replace(/\.yaml$/, "");
   161→  // Remove .spec suffix if present
   162→  baseName = baseName.replace(/\.spec$/, "");
   163→  return baseName || "kynetic";
   164→}
   165→
   166→/**
   167→ * Get the meta manifest file path.
   168→ * Derives from main manifest name (e.g., myproject.yaml -> myproject.meta.yaml)
   169→ * Returns path even if file doesn't exist yet.
   170→ */
   171→export function getMetaManifestPath(ctx: KspecContext): string {
   172→  const baseName = getManifestBaseName(ctx.manifestPath);
   173→  return path.join(ctx.specDir, `${baseName}.meta.yaml`);
   174→}
   175→
   176→/**
   177→ * Load meta items from a single file.
   178→ */
   179→async function loadMetaFile(filePath: string): Promise<{
   180→  agents: LoadedAgent[];
   181→  workflows: LoadedWorkflow[];
   182→  conventions: LoadedConvention[];
   183→  observations: LoadedObservation[];
   184→  skills: LoadedSkill[];
   185→}> {
   186→  const result: {
   187→    agents: LoadedAgent[];
   188→    workflows: LoadedWorkflow[];
   189→    conventions: LoadedConvention[];
   190→    observations: LoadedObservation[];
   191→    skills: LoadedSkill[];
   192→  } = {
   193→    agents: [],
   194→    workflows: [],
   195→    conventions: [],
   196→    observations: [],
   197→    skills: [],
   198→  };
   199→
   200→  try {
   201→    const raw = await readYamlFile<unknown>(filePath);
   202→    if (!raw || typeof raw !== "object") {
   203→      return result;
   204→    }
   205→
   206→    const obj = raw as Record<string, unknown>;
   207→
   208→    // Parse agents
   209→    if (Array.isArray(obj.agents)) {
   210→      for (const agent of obj.agents) {
   211→        const parsed = AgentSchema.safeParse(agent);
   212→        if (parsed.success) {
   213→          result.agents.push({ ...parsed.data, _sourceFile: filePath });
   214→        }
   215→      }
   216→    }
   217→
   218→    // Parse workflows
   219→    if (Array.isArray(obj.workflows)) {
   220→      for (const workflow of obj.workflows) {
   221→        const parsed = WorkflowSchema.safeParse(workflow);
   222→        if (parsed.success) {
   223→          result.workflows.push({ ...parsed.data, _sourceFile: filePath });
   224→        }
   225→      }
   226→    }
   227→
   228→    // Parse conventions
   229→    if (Array.isArray(obj.conventions)) {
   230→      for (const convention of obj.conventions) {
   231→        const parsed = ConventionSchema.safeParse(convention);
   232→        if (parsed.success) {
   233→          result.conventions.push({ ...parsed.data, _sourceFile: filePath });
   234→        }
   235→      }
   236→    }
   237→
   238→    // Parse observations
   239→    if (Array.isArray(obj.observations)) {
   240→      for (const observation of obj.observations) {
   241→        const parsed = ObservationSchema.safeParse(observation);
   242→        if (parsed.success) {
   243→          result.observations.push({ ...parsed.data, _sourceFile: filePath });
   244→        }
   245→      }
   246→    }
   247→
   248→    // Parse skills
   249→    // AC: @skill-meta-type ac-4 - skills loaded with _sourceFile set
   250→    if (Array.isArray(obj.skills)) {
   251→      for (const skill of obj.skills) {
   252→        const parsed = SkillSchema.safeParse(skill);
   253→        if (parsed.success) {
   254→          result.skills.push({ ...parsed.data, _sourceFile: filePath });
   255→        }
   256→      }
   257→    }
   258→  } catch {
   259→    // File doesn't exist or parse error
   260→  }
   261→
   262→  return result;
   263→}
   264→
   265→/**
   266→ * Load the meta context from a kspec context.
   267→ * Loads meta manifest and follows includes.
   268→ * AC: @skill-meta-type ac-4 - MetaContext.skills contains LoadedSkill objects with _sourceFile set
   269→ */
   270→export async function loadMetaContext(ctx: KspecContext): Promise<MetaContext> {
   271→  const result: MetaContext = {
   272→    manifest: null,
   273→    manifestPath: null,
   274→    agents: [],
   275→    workflows: [],
   276→    conventions: [],
   277→    observations: [],
   278→    skills: [],
   279→  };
   280→
   281→  const manifestPath = await findMetaManifest(ctx.specDir);
   282→  if (!manifestPath) {
   283→    return result;
   284→  }
   285→
   286→  result.manifestPath = manifestPath;
   287→
   288→  try {
   289→    const raw = await readYamlFile<unknown>(manifestPath);
   290→    const parsed = MetaManifestSchema.safeParse(raw);
   291→    if (!parsed.success) {
   292→      // Invalid manifest, but we can still try to extract items
   293→      const items = await loadMetaFile(manifestPath);
   294→      result.agents.push(...items.agents);
   295→      result.workflows.push(...items.workflows);
   296→      result.conventions.push(...items.conventions);
   297→      result.observations.push(...items.observations);
   298→      result.skills.push(...items.skills);
   299→      return result;
   300→    }
   301→
   302→    result.manifest = parsed.data;
   303→
   304→    // Load items from manifest
   305→    const manifestItems = await loadMetaFile(manifestPath);
   306→    result.agents.push(...manifestItems.agents);
   307→    result.workflows.push(...manifestItems.workflows);
   308→    result.conventions.push(...manifestItems.conventions);
   309→    result.observations.push(...manifestItems.observations);
   310→    result.skills.push(...manifestItems.skills);
   311→
   312→    // Process includes
   313→    const includes = parsed.data.includes || [];
   314→    const manifestDir = path.dirname(manifestPath);
   315→
   316→    for (const include of includes) {
   317→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   318→
   319→      for (const filePath of expandedPaths) {
   320→        const items = await loadMetaFile(filePath);
   321→        result.agents.push(...items.agents);
   322→        result.workflows.push(...items.workflows);
   323→        result.conventions.push(...items.conventions);
   324→        result.observations.push(...items.observations);
   325→        result.skills.push(...items.skills);
   326→      }
   327→    }
   328→  } catch {
   329→    // Manifest exists but may be invalid
   330→  }
   331→
   332→  return result;
   333→}
   334→
   335→/**
   336→ * Get meta stats summary
   337→ */
   338→export function getMetaStats(meta: MetaContext): {
   339→  agents: number;
   340→  workflows: number;
   341→  conventions: number;
   342→  observations: number;
   343→  unresolvedObservations: number;
   344→  skills: number;
   345→} {
   346→  return {
   347→    agents: meta.agents.length,
   348→    workflows: meta.workflows.length,
   349→    conventions: meta.conventions.length,
   350→    observations: meta.observations.length,
   351→    unresolvedObservations: meta.observations.filter((o) => !o.resolved).length,
   352→    skills: meta.skills.length,
   353→  };
   354→}
   355→
   356→/**
   357→ * Find a meta item by reference (ULID, short ULID, or id)
   358→ * AC: @skill-meta-type ac-5 - skills returned by semantic id lookup
   359→ * AC: @skill-meta-type ac-6 - skills returned by ULID prefix lookup
   360→ */
   361→export function findMetaItemByRef(
   362→  meta: MetaContext,
   363→  ref: string,
   364→): LoadedMetaItem | undefined {
   365→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
   366→
   367→  // Search all item types
   368→  const allItems: LoadedMetaItem[] = [
   369→    ...meta.agents,
   370→    ...meta.workflows,
   371→    ...meta.conventions,
   372→    ...meta.observations,
   373→    ...meta.skills,
   374→  ];
   375→
   376→  for (const item of allItems) {
   377→    // Match full ULID
   378→    if (item._ulid === cleanRef) return item;
   379→
   380→    // Match short ULID (prefix)
   381→    if (item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()))
   382→      return item;
   383→
   384→    // Match by id (for agents, workflows, and skills)
   385→    if ("id" in item && item.id === cleanRef) return item;
   386→
   387→    // Match by domain (for conventions)
   388→    if ("domain" in item && item.domain === cleanRef) return item;
   389→  }
   390→
   391→  return undefined;
   392→}
   393→
   394→/**
   395→ * Determine if an item is a meta item type
   396→ */
   397→export function isMetaItemType(type: string): boolean {
   398→  return ["agent", "workflow", "convention", "observation", "skill"].includes(
   399→    type,
   400→  );
   401→}
   402→
   403→// ============================================================
   404→// META ITEM CRUD
   405→// ============================================================
   406→
   407→/**
   408→ * Save the entire meta manifest to file
   409→ */
   410→async function saveMetaManifest(
   411→  manifestPath: string,
   412→  manifest: MetaManifest,
   413→): Promise<void> {
   414→  await writeYamlFilePreserveFormat(manifestPath, manifest);
   415→}
   416→
   417→/**
   418→ * Strip runtime metadata before serialization
   419→ */
   420→function stripMetaMetadata<T extends LoadedMetaItem>(
   421→  item: T,
   422→): Omit<T, "_sourceFile"> {
   423→  const { _sourceFile, ...cleanItem } = item;
   424→  return cleanItem as Omit<T, "_sourceFile">;
   425→}
   426→
   427→/**
   428→ * Create a new observation
   429→ */
   430→export function createObservation(
   431→  type: ObservationType,
   432→  content: string,
   433→  options: {
   434→    workflow_ref?: string;
   435→    author?: string;
   436→  } = {},
   437→): Observation {
   438→  return {
   439→    _ulid: ulid(),
   440→    type,
   441→    content,
   442→    workflow_ref: options.workflow_ref,
   443→    created_at: new Date().toISOString(),
   444→    author: options.author ?? getAuthor(),
   445→    resolved: false,
   446→    resolution: null,
   447→  };
   448→}
   449→
   450→/**
   451→ * Save an observation to the meta manifest
   452→ */
   453→export async function saveObservation(
   454→  ctx: KspecContext,
   455→  observation: LoadedObservation,
   456→): Promise<void> {
   457→  const manifestPath = getMetaManifestPath(ctx);
   458→
   459→  // Ensure directory exists
   460→  const dir = path.dirname(manifestPath);
   461→  await fs.mkdir(dir, { recursive: true });
   462→
   463→  // Load existing manifest
   464→  let manifest: MetaManifest = {
   465→    kynetic_meta: "1.0",
   466→    agents: [],
   467→    workflows: [],
   468→    conventions: [],
   469→    observations: [],
   470→    skills: [],
   471→    includes: [],
   472→  };
   473→
   474→  try {
   475→    const raw = await readYamlFile<unknown>(manifestPath);
   476→    const parsed = MetaManifestSchema.safeParse(raw);
   477→    if (parsed.success) {
   478→      manifest = parsed.data;
   479→    }
   480→  } catch {
   481→    // File doesn't exist, use defaults
   482→  }
   483→
   484→  // Strip runtime metadata
   485→  const cleanObs = stripMetaMetadata(observation);
   486→
   487→  // Update or add
   488→  const existingIndex = manifest.observations.findIndex(
   489→    (o) => o._ulid === observation._ulid,
   490→  );
   491→  if (existingIndex >= 0) {
   492→    manifest.observations[existingIndex] = cleanObs as Observation;
   493→  } else {
   494→    manifest.observations.push(cleanObs as Observation);
   495→  }
   496→
   497→  await saveMetaManifest(manifestPath, manifest);
   498→}
   499→
   500→/**
   501→ * Delete an observation from the meta manifest
   502→ */
   503→export async function deleteObservation(
   504→  ctx: KspecContext,
   505→  ulid: string,
   506→): Promise<boolean> {
   507→  const manifestPath = getMetaManifestPath(ctx);
   508→
   509→  try {
   510→    const raw = await readYamlFile<unknown>(manifestPath);
   511→    const parsed = MetaManifestSchema.safeParse(raw);
   512→    if (!parsed.success) {
   513→      return false;
   514→    }
   515→
   516→    const manifest = parsed.data;
   517→    const index = manifest.observations.findIndex((o) => o._ulid === ulid);
   518→    if (index < 0) {
   519→      return false;
   520→    }
   521→
   522→    manifest.observations.splice(index, 1);
   523→    await saveMetaManifest(manifestPath, manifest);
   524→    return true;
   525→  } catch {
   526→    return false;
   527→  }
   528→}
   529→
   530→/**
   531→ * Get the path for skill content file.
   532→ * Skills are stored in .kspec/skills/<id>/SKILL.md
   533→ */
   534→export function getSkillContentPath(ctx: KspecContext, skillId: string): string {
   535→  return path.join(ctx.specDir, "skills", skillId, "SKILL.md");
   536→}
   537→
   538→/**
   539→ * Load skill content from the SKILL.md file.
   540→ * AC: @skill-meta-type ac-3 - loadSkillContent returns full markdown content
   541→ * AC: @skill-content-model ac-1 - loadSkillContent returns markdown content as a string
   542→ */
   543→export async function loadSkillContent(
   544→  ctx: KspecContext,
   545→  skill: LoadedSkill,
   546→): Promise<string | null> {
   547→  const contentPath = getSkillContentPath(ctx, skill.id);
   548→  try {
   549→    const content = await fs.readFile(contentPath, "utf-8");
   550→    return content;
   551→  } catch {
   552→    return null;
   553→  }
   554→}
   555→
   556→/**
   557→ * Skill doc object returned by loadSkillDocs.
   558→ * AC: @skill-content-model ac-2
   559→ */
   560→export interface SkillDoc {
   561→  /** File name (e.g., "quickref.md") */
   562→  name: string;
   563→  /** Full file path */
   564→  path: string;
   565→  /** File content */
   566→  content: string;
   567→}
   568→
   569→/**
   570→ * Supported skill supporting directory types.
   571→ * AC: @supporting-files-convention ac-1
   572→ */
   573→export type SupportingDirType = "references" | "scripts" | "assets" | "docs";
   574→
   575→/**
   576→ * A file from a skill's supporting directory.
   577→ * AC: @supporting-files-convention ac-1
   578→ */
   579→export interface SupportingFile {
   580→  /** File name (e.g., "api.md", "helper.sh") */
   581→  name: string;
   582→  /** Full file path */
   583→  path: string;
   584→  /** File content (for text files) */
   585→  content: string;
   586→  /** Supporting directory type */
   587→  dirType: SupportingDirType;
   588→}
   589→
   590→/**
   591→ * Get the docs directory path for a skill.
   592→ * Skills can have supporting docs at .kspec/skills/<id>/docs/
   593→ */
   594→export function getSkillDocsPath(ctx: KspecContext, skillId: string): string {
   595→  return path.join(ctx.specDir, "skills", skillId, "docs");
   596→}
   597→
   598→/**
   599→ * Load skill documentation files from the docs/ subdirectory.
   600→ * AC: @skill-content-model ac-2 - loadSkillDocs returns array of doc objects
   601→ */
   602→export async function loadSkillDocs(
   603→  ctx: KspecContext,
   604→  skill: LoadedSkill,
   605→): Promise<SkillDoc[]> {
   606→  const docsPath = getSkillDocsPath(ctx, skill.id);
   607→  const docs: SkillDoc[] = [];
   608→
   609→  try {
   610→    const entries = await fs.readdir(docsPath, { withFileTypes: true });
   611→
   612→    for (const entry of entries) {
   613→      if (entry.isFile() && entry.name.endsWith(".md")) {
   614→        const filePath = path.join(docsPath, entry.name);
   615→        try {
   616→          const content = await fs.readFile(filePath, "utf-8");
   617→          docs.push({
   618→            name: entry.name,
   619→            path: filePath,
   620→            content,
   621→          });
   622→        } catch {
   623→          // Skip files that can't be read
   624→        }
   625→      }
   626→    }
   627→  } catch {
   628→    // docs directory doesn't exist or can't be read
   629→  }
   630→
   631→  return docs;
   632→}
   633→
   634→/**
   635→ * Get the path to a supporting directory for a skill.
   636→ * AC: @supporting-files-convention ac-1
   637→ */
   638→export function getSkillSupportingDirPath(
   639→  ctx: KspecContext,
   640→  skillId: string,
   641→  dirType: SupportingDirType
   642→): string {
   643→  return path.join(ctx.specDir, "skills", skillId, dirType);
   644→}
   645→
   646→/**
   647→ * Load files from a skill's supporting directory.
   648→ * AC: @supporting-files-convention ac-1 - references files are accessible
   649→ *
   650→ * @param ctx - Kspec context
   651→ * @param skill - The skill to load files from
   652→ * @param dirType - The supporting directory type (references, scripts, assets, docs)
   653→ * @returns Array of files found in the directory
   654→ */
   655→export async function loadSkillSupportingFiles(
   656→  ctx: KspecContext,
   657→  skill: LoadedSkill,
   658→  dirType: SupportingDirType
   659→): Promise<SupportingFile[]> {
   660→  const dirPath = getSkillSupportingDirPath(ctx, skill.id, dirType);
   661→  const files: SupportingFile[] = [];
   662→
   663→  try {
   664→    const entries = await fs.readdir(dirPath, { withFileTypes: true });
   665→
   666→    for (const entry of entries) {
   667→      if (entry.isFile()) {
   668→        const filePath = path.join(dirPath, entry.name);
   669→        try {
   670→          const content = await fs.readFile(filePath, "utf-8");
   671→          files.push({
   672→            name: entry.name,
   673→            path: filePath,
   674→            content,
   675→            dirType,
   676→          });
   677→        } catch {
   678→          // Skip files that can't be read (e.g., binary files)
   679→        }
   680→      }
   681→    }
   682→  } catch {
   683→    // Directory doesn't exist or can't be read - return empty array
   684→  }
   685→
   686→  return files;
   687→}
   688→
   689→/**
   690→ * List which supporting directories exist for a skill.
   691→ * AC: @supporting-files-convention ac-1
   692→ *
   693→ * @returns Array of directory types that exist for the skill
   694→ */
   695→export async function listSkillSupportingDirs(
   696→  ctx: KspecContext,
   697→  skillId: string
   698→): Promise<SupportingDirType[]> {
   699→  const dirs: SupportingDirType[] = [];
   700→  const allDirs: SupportingDirType[] = ["references", "scripts", "assets", "docs"];
   701→
   702→  for (const dirType of allDirs) {
   703→    const dirPath = getSkillSupportingDirPath(ctx, skillId, dirType);
   704→    try {
   705→      const stat = await fs.stat(dirPath);
   706→      if (stat.isDirectory()) {
   707→        dirs.push(dirType);
   708→      }
   709→    } catch {
   710→      // Directory doesn't exist
   711→    }
   712→  }
   713→
   714→  return dirs;
   715→}
   716→
   717→// Re-export the getMetaItemType function
   718→export { getMetaItemType };
   719→export type { Agent, Workflow, Convention, Observation, Skill, MetaItem };
   720→
   721→// ============================================================
   722→// GENERIC META ITEM CRUD
   723→// ============================================================
   724→
   725→/**
   726→ * Save any meta item (agent, workflow, convention, skill) to the manifest
   727→ * AC: @skill-parser ac-1 - skill is appended to manifest.skills and written to disk
   728→ * AC: @skill-parser ac-2 - .kspec/skills/<id>/ directory is created for skills
   729→ */
   730→export async function saveMetaItem(
   731→  ctx: KspecContext,
   732→  item: LoadedMetaItem,
   733→  itemType: "agent" | "workflow" | "convention" | "skill",
   734→): Promise<void> {
   735→  const manifestPath = getMetaManifestPath(ctx);
   736→
   737→  // Ensure directory exists
   738→  const dir = path.dirname(manifestPath);
   739→  await fs.mkdir(dir, { recursive: true });
   740→
   741→  // Load existing manifest
   742→  let manifest: MetaManifest = {
   743→    kynetic_meta: "1.0",
   744→    agents: [],
   745→    workflows: [],
   746→    conventions: [],
   747→    observations: [],
   748→    skills: [],
   749→    includes: [],
   750→  };
   751→
   752→  try {
   753→    const raw = await readYamlFile<unknown>(manifestPath);
   754→    const parsed = MetaManifestSchema.safeParse(raw);
   755→    if (parsed.success) {
   756→      manifest = parsed.data;
   757→    }
   758→  } catch {
   759→    // File doesn't exist, use defaults
   760→  }
   761→
   762→  // Strip runtime metadata
   763→  const cleanItem = stripMetaMetadata(item);
   764→
   765→  // Get the appropriate array
   766→  const getArray = () => {
   767→    switch (itemType) {
   768→      case "agent":
   769→        return manifest.agents;
   770→      case "workflow":
   771→        return manifest.workflows;
   772→      case "convention":
   773→        return manifest.conventions;
   774→      case "skill":
   775→        return manifest.skills;
   776→    }
   777→  };
   778→
   779→  const array = getArray();
   780→
   781→  // Update or add
   782→  const existingIndex = array.findIndex((i) => i._ulid === item._ulid);
   783→  if (existingIndex >= 0) {
   784→    (array as unknown[])[existingIndex] = cleanItem;
   785→  } else {
   786→    (array as unknown[]).push(cleanItem);
   787→  }
   788→
   789→  await saveMetaManifest(manifestPath, manifest);
   790→
   791→  // AC: @skill-parser ac-2 - Create skill content directory
   792→  if (itemType === "skill" && "id" in item) {
   793→    const skillDir = path.join(ctx.specDir, "skills", item.id);
   794→    await fs.mkdir(skillDir, { recursive: true });
   795→  }
   796→}
   797→
   798→/**
   799→ * Delete any meta item from the manifest
   800→ * AC: @skill-parser ac-3 - skill is removed from manifest.skills
   801→ * AC: @skill-parser ac-4 - .kspec/skills/<id>/ directory is deleted for skills
   802→ */
   803→export async function deleteMetaItem(
   804→  ctx: KspecContext,
   805→  itemUlid: string,
   806→  itemType: "agent" | "workflow" | "convention" | "observation" | "skill",
   807→): Promise<boolean> {
   808→  const manifestPath = getMetaManifestPath(ctx);
   809→
   810→  try {
   811→    const raw = await readYamlFile<unknown>(manifestPath);
   812→    const parsed = MetaManifestSchema.safeParse(raw);
   813→    if (!parsed.success) {
   814→      return false;
   815→    }
   816→
   817→    const manifest = parsed.data;
   818→
   819→    const getArray = () => {
   820→      switch (itemType) {
   821→        case "agent":
   822→          return manifest.agents;
   823→        case "workflow":
   824→          return manifest.workflows;
   825→        case "convention":
   826→          return manifest.conventions;
   827→        case "observation":
   828→          return manifest.observations;
   829→        case "skill":
   830→          return manifest.skills;
   831→      }
   832→    };
   833→
   834→    const array = getArray();
   835→    const index = array.findIndex((i) => i._ulid === itemUlid);
   836→    if (index < 0) {
   837→      return false;
   838→    }
   839→
   840→    // AC: @skill-parser ac-4 - Delete skill directory before removing from manifest
   841→    if (itemType === "skill") {
   842→      const skill = array[index] as Skill;
   843→      if (skill.id) {
   844→        const skillDir = path.join(ctx.specDir, "skills", skill.id);
   845→        try {
   846→          await fs.rm(skillDir, { recursive: true, force: true });
   847→        } catch {
   848→          // Directory might not exist, that's fine
   849→        }
   850→      }
   851→    }
   852→
   853→    array.splice(index, 1);
   854→    await saveMetaManifest(manifestPath, manifest);
   855→    return true;
   856→  } catch {
   857→    return false;
   858→  }
   859→}
   860→
   861→// ============================================================
   862→// SESSION CONTEXT
   863→// ============================================================
   864→
   865→/**
   866→ * Get the session context file path
   867→ */
   868→export function getSessionContextPath(ctx: KspecContext): string {
   869→  return path.join(ctx.specDir, ".kspec-session");
   870→}
   871→
   872→/**
   873→ * Load session context (or return empty context if not exists)
   874→ */
   875→export async function loadSessionContext(
   876→  ctx: KspecContext,
   877→): Promise<SessionContext> {
   878→  const contextPath = getSessionContextPath(ctx);
   879→
   880→  try {
   881→    const raw = await readYamlFile<unknown>(contextPath);
   882→    if (!raw || typeof raw !== "object") {
   883→      return {
   884→        focus: null,
   885→        threads: [],
   886→        open_questions: [],
   887→        updated_at: new Date().toISOString(),
   888→      };
   889→    }
   890→
   891→    // Validate and parse using schema
   892→    const result = SessionContextSchema.safeParse(raw);
   893→    if (result.success) {
   894→      return result.data;
   895→    }
   896→
   897→    // If validation fails, return empty context
   898→    return {
   899→      focus: null,
   900→      threads: [],
   901→      open_questions: [],
   902→      updated_at: new Date().toISOString(),
   903→    };
   904→  } catch {
   905→    return {
   906→      focus: null,
   907→      threads: [],
   908→      open_questions: [],
   909→      updated_at: new Date().toISOString(),
   910→    };
   911→  }
   912→}
   913→
   914→/**
   915→ * Save session context
   916→ */
   917→export async function saveSessionContext(
   918→  ctx: KspecContext,
   919→  context: SessionContext,
   920→): Promise<void> {
   921→  const contextPath = getSessionContextPath(ctx);
   922→
   923→  // Update timestamp
   924→  context.updated_at = new Date().toISOString();
   925→
   926→  await writeYamlFilePreserveFormat(contextPath, context);
   927→}
   928→
   929→// ============================================================
   930→// WORKFLOW RUNS
   931→// ============================================================
   932→
   933→/**
   934→ * Get the workflow runs file path.
   935→ * Derives from main manifest name (e.g., myproject.yaml -> myproject.runs.yaml)
   936→ */
   937→export function getWorkflowRunsPath(ctx: KspecContext): string {
   938→  const baseName = getManifestBaseName(ctx.manifestPath);
   939→  return path.join(ctx.specDir, `${baseName}.runs.yaml`);
   940→}
   941→
   942→/**
   943→ * Load workflow runs from file
   944→ */
   945→export async function loadWorkflowRuns(
   946→  ctx: KspecContext,
   947→): Promise<WorkflowRun[]> {
   948→  const runsPath = getWorkflowRunsPath(ctx);
   949→
   950→  try {
   951→    const raw = await readYamlFile<unknown>(runsPath);
   952→    const parsed = WorkflowRunsFileSchema.safeParse(raw);
   953→
   954→    if (!parsed.success) {
   955→      return [];
   956→    }
   957→
   958→    return parsed.data.runs;
   959→  } catch {
   960→    // File doesn't exist
   961→    return [];
   962→  }
   963→}
   964→
   965→/**
   966→ * Save a workflow run (create or update)
   967→ */
   968→export async function saveWorkflowRun(
   969→  ctx: KspecContext,
   970→  run: WorkflowRun,
   971→): Promise<void> {
   972→  const runsPath = getWorkflowRunsPath(ctx);
   973→
   974→  // Load existing runs
   975→  const runs = await loadWorkflowRuns(ctx);
   976→
   977→  // Update or add
   978→  const existingIndex = runs.findIndex((r) => r._ulid === run._ulid);
   979→  if (existingIndex >= 0) {
   980→    runs[existingIndex] = run;
   981→  } else {
   982→    runs.push(run);
   983→  }
   984→
   985→  // Save back
   986→  const runsFile: WorkflowRunsFile = {
   987→    kynetic_runs: "1.0",
   988→    runs,
   989→  };
   990→
   991→  await writeYamlFilePreserveFormat(runsPath, runsFile);
   992→}
   993→
   994→/**
   995→ * Update an existing workflow run
   996→ */
   997→export async function updateWorkflowRun(
   998→  ctx: KspecContext,
   999→  run: WorkflowRun,
  1000→): Promise<void> {
  1001→  await saveWorkflowRun(ctx, run);
  1002→}
  1003→
  1004→/**
  1005→ * Find a workflow run by reference (ULID or ULID prefix)
  1006→ */
  1007→export async function findWorkflowRunByRef(
  1008→  ctx: KspecContext,
  1009→  ref: string,
  1010→): Promise<WorkflowRun | undefined> {
  1011→  const runs = await loadWorkflowRuns(ctx);
  1012→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
  1013→
  1014→  return runs.find(
  1015→    (r) =>
  1016→      r._ulid === cleanRef ||
  1017→      r._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()),
  1018→  );
  1019→}
  1020→
  1021→/**
  1022→ * Find active workflow runs
  1023→ */
  1024→export async function findActiveRuns(
  1025→  ctx: KspecContext,
  1026→): Promise<WorkflowRun[]> {
  1027→  const runs = await loadWorkflowRuns(ctx);
  1028→  return runs.filter((r) => r.status === "active");
  1029→}
  1030→
  1031→/**
  1032→ * Delete workflow runs by ULIDs
  1033→ * AC: @workflow-prune ac-1, ac-2, ac-3, ac-4
  1034→ */
  1035→export async function deleteWorkflowRuns(
  1036→  ctx: KspecContext,
  1037→  ulidsToDelete: string[],
  1038→): Promise<void> {
  1039→  const runsPath = getWorkflowRunsPath(ctx);
  1040→  const runs = await loadWorkflowRuns(ctx);
  1041→
  1042→  // Filter out runs to delete
  1043→  const remainingRuns = runs.filter((r) => !ulidsToDelete.includes(r._ulid));
  1044→
  1045→  // Save back
  1046→  const runsFile: WorkflowRunsFile = {
  1047→    kynetic_runs: "1.0",
  1048→    runs: remainingRuns,
  1049→  };
  1050→
  1051→  await writeYamlFilePreserveFormat(runsPath, runsFile);
  1052→}
