```
     1→/**
     2→ * Skill CLI commands for managing skills.
     3→ *
     4→ * AC: @skill-cli ac-1 - kspec skill list outputs table with ID, Name, Origin, Version, Platforms
     5→ * AC: @skill-cli ac-2 - kspec skill list --json outputs JSON array with full skill metadata
     6→ * AC: @skill-cli ac-3 - kspec skill add creates meta entry with origin custom
     7→ * AC: @skill-cli ac-4 - kspec skill add creates .kspec/skills/<id>/SKILL.md
     8→ * AC: @skill-cli ac-5 - kspec skill get outputs metadata including id, name, origin, platforms
     9→ * AC: @skill-cli ac-6 - kspec skill get outputs SKILL.md content
    10→ * AC: @skill-cli ac-7 - kspec skill delete --confirm removes meta entry
    11→ * AC: @skill-cli ac-8 - kspec skill delete removes .kspec/skills/<id>/ directory
    12→ *
    13→ * AC: @core-skill-install ac-1 - meta entries created with origin core
    14→ * AC: @core-skill-install ac-2 - content files copied from templates to .kspec/skills/<id>/
    15→ * AC: @core-skill-install ac-3 - custom skills skipped with message
    16→ * AC: @core-skill-install ac-4 - --force overwrites custom forks
    17→ * AC: @core-skill-install ac-5 - version matches kspec package version
    18→ *
    19→ * AC: @core-skill-update ac-1 - skill content and version updated when version differs
    20→ * AC: @core-skill-update ac-2 - skill skipped when already at current version
    21→ * AC: @core-skill-update ac-3 - skills with origin custom/project not touched
    22→ */
    23→
    24→import * as fs from "node:fs/promises";
    25→import { readFileSync } from "node:fs";
    26→import * as path from "node:path";
    27→import chalk from "chalk";
    28→import Table from "cli-table3";
    29→import type { Command } from "commander";
    30→import { ulid } from "ulid";
    31→import yaml from "yaml";
    32→import { markMutating } from "../command-annotations.js";
    33→import {
    34→  deleteMetaItem,
    35→  findMetaItemByRef,
    36→  getSkillContentPath,
    37→  initContext,
    38→  type KspecContext,
    39→  loadMetaContext,
    40→  loadSkillContent,
    41→  loadSkillDocs,
    42→  type LoadedSkill,
    43→  saveMetaItem,
    44→  type Skill,
    45→} from "../../parser/index.js";
    46→import { commitIfShadow } from "../../parser/shadow.js";
    47→import {
    48→  checkSkillDrift,
    49→  computeContentHash,
    50→  generateFrontmatter,
    51→  isKspecManagedSkill as isKspecManaged,
    52→  KSPEC_MANAGED_MARKER,
    53→  readRenderHash,
    54→  renderClaudeCodeSkill,
    55→  type ClaudeCodeRenderResult,
    56→} from "../../parser/skill-render.js";
    57→import { SkillSchema, type SkillOrigin } from "../../schema/index.js";
    58→import { errors } from "../../strings/errors.js";
    59→import { EXIT_CODES } from "../exit-codes.js";
    60→import { error, output, success } from "../output.js";
    61→import { parseTagsArray } from "../parse-utils.js";
    62→
    63→/**
    64→ * Format skills as a table
    65→ * AC: @skill-cli ac-1 - table displays ID, Name, Origin, Version, Platforms
    66→ */
    67→function formatSkillsTable(skills: LoadedSkill[]): void {
    68→  if (skills.length === 0) {
    69→    console.log(chalk.yellow("No skills defined"));
    70→    return;
    71→  }
    72→
    73→  const table = new Table({
    74→    head: [
    75→      chalk.bold("ID"),
    76→      chalk.bold("Name"),
    77→      chalk.bold("Origin"),
    78→      chalk.bold("Version"),
    79→      chalk.bold("Platforms"),
    80→    ],
    81→    style: {
    82→      head: [],
    83→      border: [],
    84→    },
    85→  });
    86→
    87→  for (const skill of skills) {
    88→    table.push([
    89→      skill.id,
    90→      skill.name,
    91→      skill.origin,
    92→      skill.version || "-",
    93→      skill.platforms.join(", "),
    94→    ]);
    95→  }
    96→
    97→  console.log(table.toString());
    98→  console.log(chalk.gray(`\n${skills.length} skill(s)`));
    99→}
   100→
   101→/**
   102→ * Format skill details
   103→ * AC: @skill-cli ac-5 - outputs metadata including id, name, origin, platforms
   104→ */
   105→function formatSkillDetails(skill: LoadedSkill, content: string | null): void {
   106→  console.log(chalk.bold(skill.name));
   107→  console.log(chalk.gray("─".repeat(40)));
   108→  console.log(`ID:          ${skill.id}`);
   109→  console.log(`ULID:        ${skill._ulid}`);
   110→  console.log(`Origin:      ${skill.origin}`);
   111→  console.log(`Platforms:   ${skill.platforms.join(", ")}`);
   112→
   113→  if (skill.version) {
   114→    console.log(`Version:     ${skill.version}`);
   115→  }
   116→
   117→  if (skill.description) {
   118→    console.log(`\n─── Description ───`);
   119→    console.log(skill.description);
   120→  }
   121→
   122→  if (skill.depends_on && skill.depends_on.length > 0) {
   123→    console.log(`\n─── Dependencies ───`);
   124→    for (const dep of skill.depends_on) {
   125→      console.log(`  • ${dep}`);
   126→    }
   127→  }
   128→
   129→  if (skill.tags && skill.tags.length > 0) {
   130→    console.log(`\nTags:        ${skill.tags.join(", ")}`);
   131→  }
   132→
   133→  // AC: @skill-cli ac-6 - display SKILL.md content
   134→  if (content) {
   135→    console.log(`\n─── SKILL.md Content ───`);
   136→    console.log(content);
   137→  } else {
   138→    console.log(chalk.gray("\n(No SKILL.md content found)"));
   139→  }
   140→}
   141→
   142→/**
   143→ * Register skill commands
   144→ */
   145→export function registerSkillCommands(program: Command): void {
   146→  const skill = program
   147→    .command("skill")
   148→    .description("Skill management commands");
   149→
   150→  // AC: @skill-cli ac-1, ac-2 - kspec skill list
   151→  skill
   152→    .command("list")
   153→    .description("List all skills")
   154→    .option("--origin <origin>", "Filter by origin (core, project, local)")
   155→    .option("--tag <tag>", "Filter by tag")
   156→    .action(async (options) => {
   157→      try {
   158→        const ctx = await initContext();
   159→
   160→        if (!ctx.manifestPath) {
   161→          error(errors.project.noKspecProject);
   162→          process.exit(EXIT_CODES.ERROR);
   163→        }
   164→
   165→        const metaCtx = await loadMetaContext(ctx);
   166→        let skills = metaCtx.skills || [];
   167→
   168→        // Apply filters
   169→        if (options.origin) {
   170→          skills = skills.filter((s) => s.origin === options.origin);
   171→        }
   172→
   173→        if (options.tag) {
   174→          skills = skills.filter((s) => s.tags?.includes(options.tag));
   175→        }
   176→
   177→        // AC: @skill-cli ac-2 - JSON output includes full skill metadata
   178→        output(
   179→          skills.map((s) => ({
   180→            _ulid: s._ulid,
   181→            id: s.id,
   182→            name: s.name,
   183→            description: s.description,
   184→            origin: s.origin,
   185→            version: s.version,
   186→            platforms: s.platforms,
   187→            depends_on: s.depends_on,
   188→            tags: s.tags,
   189→          })),
   190→          // AC: @skill-cli ac-1 - Table output
   191→          () => formatSkillsTable(skills),
   192→        );
   193→      } catch (err) {
   194→        error("Failed to list skills", err);
   195→        process.exit(EXIT_CODES.ERROR);
   196→      }
   197→    });
   198→
   199→  // AC: @skill-cli ac-3, ac-4 - kspec skill add
   200→  // AC: @skill-add ac-3 - --content-file copies existing file to SKILL.md
   201→  markMutating(skill.command("add"))
   202→    .description("Create a new skill")
   203→    .requiredOption("--id <id>", "Skill ID (kebab-case)")
   204→    .requiredOption("--name <name>", "Skill name")
   205→    .option("--description <desc>", "Skill description")
   206→    .option(
   207→      "--origin <origin>",
   208→      "Skill origin (core, project, local)",
   209→      "project",
   210→    )
   211→    .option("--skill-version <version>", "Skill version")
   212→    .option("--platform <platform...>", "Target platforms")
   213→    .option("--tag <tag...>", "Tags for the skill")
   214→    .option("--depends-on <ref...>", "Skill dependencies")
   215→    .option("--content-file <path>", "Path to existing file to use as SKILL.md content")
   216→    .action(async (options) => {
   217→      try {
   218→        const ctx = await initContext();
   219→
   220→        if (!ctx.manifestPath) {
   221→          error(errors.project.noKspecProject);
   222→          process.exit(EXIT_CODES.ERROR);
   223→        }
   224→
   225→        // Validate origin
   226→        const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   227→        if (!validOrigins.includes(options.origin as SkillOrigin)) {
   228→          error(
   229→            `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   230→          );
   231→          process.exit(EXIT_CODES.ERROR);
   232→        }
   233→
   234→        // Check if skill with this ID already exists
   235→        const metaCtx = await loadMetaContext(ctx);
   236→        const existingSkill = metaCtx.skills.find((s) => s.id === options.id);
   237→        if (existingSkill) {
   238→          error(`Skill with ID '${options.id}' already exists`);
   239→          process.exit(EXIT_CODES.CONFLICT);
   240→        }
   241→
   242→        // Build skill object
   243→        const skillData: Skill = {
   244→          _ulid: ulid(),
   245→          id: options.id,
   246→          name: options.name,
   247→          description: options.description,
   248→          origin: options.origin as SkillOrigin,
   249→          version: options.skillVersion,
   250→          platforms:
   251→            options.platform && options.platform.length > 0
   252→              ? options.platform
   253→              : ["claude-code"],
   254→          depends_on:
   255→            options.dependsOn && options.dependsOn.length > 0
   256→              ? options.dependsOn
   257→              : [],
   258→          allowed_tools: [],
   259→          tags:
   260→            options.tag && options.tag.length > 0
   261→              ? parseTagsArray(options.tag)
   262→              : [],
   263→        };
   264→
   265→        // Validate with schema
   266→        const parsed = SkillSchema.safeParse(skillData);
   267→        if (!parsed.success) {
   268→          const issues = parsed.error.issues
   269→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   270→            .join("; ");
   271→          error(`Invalid skill data: ${issues}`);
   272→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   273→        }
   274→
   275→        const skill: LoadedSkill = { ...parsed.data };
   276→
   277→        // AC: @skill-cli ac-3 - save meta entry (also creates directory per ac-4)
   278→        await saveMetaItem(ctx, skill, "skill");
   279→
   280→        // AC: @skill-cli ac-4 - create SKILL.md with placeholder content
   281→        // AC: @skill-add ac-3 - if --content-file provided, copy its contents
   282→        const skillMdPath = getSkillContentPath(ctx, skill.id);
   283→        let initialContent: string;
   284→
   285→        if (options.contentFile) {
   286→          // Read content from the specified file
   287→          const contentFilePath = path.isAbsolute(options.contentFile)
   288→            ? options.contentFile
   289→            : path.resolve(process.cwd(), options.contentFile);
   290→
   291→          try {
   292→            initialContent = await fs.readFile(contentFilePath, "utf-8");
   293→          } catch (err) {
   294→            // Clean up: remove the skill we just created
   295→            await deleteMetaItem(ctx, skill._ulid, "skill");
   296→            error(`Failed to read content file: ${contentFilePath}`);
   297→            process.exit(EXIT_CODES.ERROR);
   298→          }
   299→        } else {
   300→          initialContent = `# ${skill.name}\n\n${skill.description || "Add skill content here."}\n`;
   301→        }
   302→
   303→        await fs.writeFile(skillMdPath, initialContent, "utf-8");
   304→
   305→        // Commit changes
   306→        await commitIfShadow(ctx.shadow, "skill-add", skill.id, skill.name);
   307→
   308→        output(skill, () =>
   309→          success(`Created skill: ${skill.id}`, { skill }),
   310→        );
   311→      } catch (err) {
   312→        error("Failed to create skill", err);
   313→        process.exit(EXIT_CODES.ERROR);
   314→      }
   315→    });
   316→
   317→  // AC: @skill-cli ac-5, ac-6 - kspec skill get
   318→  skill
   319→    .command("get <ref>")
   320→    .description("Show skill details")
   321→    .action(async (ref: string) => {
   322→      try {
   323→        const ctx = await initContext();
   324→
   325→        if (!ctx.manifestPath) {
   326→          error(errors.project.noKspecProject);
   327→          process.exit(EXIT_CODES.ERROR);
   328→        }
   329→
   330→        const metaCtx = await loadMetaContext(ctx);
   331→        const item = findMetaItemByRef(metaCtx, ref);
   332→
   333→        if (!item) {
   334→          error(`Skill not found: ${ref}`);
   335→          console.log(chalk.gray("Try: kspec skill list"));
   336→          process.exit(EXIT_CODES.NOT_FOUND);
   337→        }
   338→
   339→        // Check it's a skill
   340→        if (!("origin" in item)) {
   341→          error(`Item ${ref} is not a skill`);
   342→          process.exit(EXIT_CODES.ERROR);
   343→        }
   344→
   345→        const skill = item as LoadedSkill;
   346→
   347→        // AC: @skill-cli ac-6 - load SKILL.md content
   348→        const content = await loadSkillContent(ctx, skill);
   349→        const docs = await loadSkillDocs(ctx, skill);
   350→
   351→        // AC: @skill-cli ac-5, ac-6 - output metadata and content
   352→        // Include extended skill schema fields (license, compatibility, allowed_tools, metadata, platform_config)
   353→        output(
   354→          {
   355→            _ulid: skill._ulid,
   356→            id: skill.id,
   357→            name: skill.name,
   358→            description: skill.description,
   359→            origin: skill.origin,
   360→            version: skill.version,
   361→            platforms: skill.platforms,
   362→            depends_on: skill.depends_on,
   363→            tags: skill.tags,
   364→            // Extended fields from @extended-skill-schema
   365→            license: skill.license,
   366→            compatibility: skill.compatibility,
   367→            allowed_tools: skill.allowed_tools,
   368→            metadata: skill.metadata,
   369→            platform_config: skill.platform_config,
   370→            content,
   371→            docs: docs.map((d) => ({ name: d.name, path: d.path })),
   372→          },
   373→          () => formatSkillDetails(skill, content),
   374→        );
   375→      } catch (err) {
   376→        error("Failed to get skill", err);
   377→        process.exit(EXIT_CODES.ERROR);
   378→      }
   379→    });
   380→
   381→  // AC: @skill-set ac-1, ac-2, ac-3 - kspec skill set
   382→  markMutating(skill.command("set <ref>"))
   383→    .description("Update skill metadata fields")
   384→    .option("--name <name>", "Update skill name")
   385→    .option("--description <desc>", "Update skill description")
   386→    .option("--origin <origin>", "Update skill origin (core, project, local)")
   387→    .option("--skill-version <version>", "Update skill version")
   388→    .option("--add-platform <platform>", "Add a platform to the platforms array")
   389→    .option("--remove-platform <platform>", "Remove a platform from the platforms array")
   390→    .option("--add-tag <tag>", "Add a tag to the tags array")
   391→    .option("--remove-tag <tag>", "Remove a tag from the tags array")
   392→    .option("--add-depends-on <ref>", "Add a dependency reference")
   393→    .option("--remove-depends-on <ref>", "Remove a dependency reference")
   394→    .action(async (ref: string, options) => {
   395→      try {
   396→        const ctx = await initContext();
   397→
   398→        if (!ctx.manifestPath) {
   399→          error(errors.project.noKspecProject);
   400→          process.exit(EXIT_CODES.ERROR);
   401→        }
   402→
   403→        const metaCtx = await loadMetaContext(ctx);
   404→        const item = findMetaItemByRef(metaCtx, ref);
   405→
   406→        if (!item) {
   407→          error(`Skill not found: ${ref}`);
   408→          console.log(chalk.gray("Try: kspec skill list"));
   409→          process.exit(EXIT_CODES.NOT_FOUND);
   410→        }
   411→
   412→        // Check it's a skill
   413→        if (!("origin" in item)) {
   414→          error(`Item ${ref} is not a skill`);
   415→          process.exit(EXIT_CODES.ERROR);
   416→        }
   417→
   418→        const skill = item as LoadedSkill;
   419→
   420→        // AC: @skill-set ac-1 - update description field
   421→        if (options.name !== undefined) {
   422→          skill.name = options.name;
   423→        }
   424→
   425→        if (options.description !== undefined) {
   426→          skill.description = options.description;
   427→        }
   428→
   429→        // Update origin
   430→        if (options.origin !== undefined) {
   431→          const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   432→          if (!validOrigins.includes(options.origin as SkillOrigin)) {
   433→            error(
   434→              `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   435→            );
   436→            process.exit(EXIT_CODES.ERROR);
   437→          }
   438→          skill.origin = options.origin as SkillOrigin;
   439→        }
   440→
   441→        // Update version
   442→        if (options.skillVersion !== undefined) {
   443→          skill.version = options.skillVersion;
   444→        }
   445→
   446→        // AC: @skill-set ac-2 - add platform to array
   447→        if (options.addPlatform) {
   448→          if (!skill.platforms.includes(options.addPlatform)) {
   449→            skill.platforms.push(options.addPlatform);
   450→          }
   451→        }
   452→
   453→        // Remove platform
   454→        if (options.removePlatform) {
   455→          const idx = skill.platforms.indexOf(options.removePlatform);
   456→          if (idx >= 0) {
   457→            skill.platforms.splice(idx, 1);
   458→          }
   459→        }
   460→
   461→        // AC: @skill-set ac-3 - add tag to array
   462→        if (options.addTag) {
   463→          if (!skill.tags) {
   464→            skill.tags = [];
   465→          }
   466→          if (!skill.tags.includes(options.addTag)) {
   467→            skill.tags.push(options.addTag);
   468→          }
   469→        }
   470→
   471→        // Remove tag
   472→        if (options.removeTag && skill.tags) {
   473→          const idx = skill.tags.indexOf(options.removeTag);
   474→          if (idx >= 0) {
   475→            skill.tags.splice(idx, 1);
   476→          }
   477→        }
   478→
   479→        // Add dependency
   480→        if (options.addDependsOn) {
   481→          if (!skill.depends_on) {
   482→            skill.depends_on = [];
   483→          }
   484→          if (!skill.depends_on.includes(options.addDependsOn)) {
   485→            skill.depends_on.push(options.addDependsOn);
   486→          }
   487→        }
   488→
   489→        // Remove dependency
   490→        if (options.removeDependsOn && skill.depends_on) {
   491→          const idx = skill.depends_on.indexOf(options.removeDependsOn);
   492→          if (idx >= 0) {
   493→            skill.depends_on.splice(idx, 1);
   494→          }
   495→        }
   496→
   497→        // Validate updated skill
   498→        const parsed = SkillSchema.safeParse(skill);
   499→        if (!parsed.success) {
   500→          const issues = parsed.error.issues
   501→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   502→            .join("; ");
   503→          error(`Invalid skill data: ${issues}`);
   504→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   505→        }
   506→
   507→        // Save the updated skill
   508→        await saveMetaItem(ctx, skill, "skill");
   509→
   510→        // Commit changes
   511→        await commitIfShadow(ctx.shadow, "skill-set", skill.id, skill.name);
   512→
   513→        output(skill, () => success(`Updated skill: ${skill.id}`));
   514→      } catch (err) {
   515→        error("Failed to update skill", err);
   516→        process.exit(EXIT_CODES.ERROR);
   517→      }
   518→    });
   519→
   520→  // AC: @skill-cli ac-7, ac-8 - kspec skill delete
   521→  markMutating(skill.command("delete <ref>"))
   522→    .description("Delete a skill")
   523→    .option("--confirm", "Skip confirmation prompt")
   524→    .action(async (ref: string, options) => {
   525→      try {
   526→        const ctx = await initContext();
   527→
   528→        if (!ctx.manifestPath) {
   529→          error(errors.project.noKspecProject);
   530→          process.exit(EXIT_CODES.ERROR);
   531→        }
   532→
   533→        const metaCtx = await loadMetaContext(ctx);
   534→        const item = findMetaItemByRef(metaCtx, ref);
   535→
   536→        if (!item) {
   537→          error(`Skill not found: ${ref}`);
   538→          console.log(chalk.gray("Try: kspec skill list"));
   539→          process.exit(EXIT_CODES.NOT_FOUND);
   540→        }
   541→
   542→        // Check it's a skill
   543→        if (!("origin" in item)) {
   544→          error(`Item ${ref} is not a skill`);
   545→          process.exit(EXIT_CODES.ERROR);
   546→        }
   547→
   548→        const skill = item as LoadedSkill;
   549→
   550→        // Check for confirmation
   551→        if (!options.confirm) {
   552→          error(`Confirm deletion of skill '${skill.id}' with --confirm flag`);
   553→          process.exit(EXIT_CODES.ERROR);
   554→        }
   555→
   556→        // Check for dependencies from other skills
   557→        const dependentSkills = metaCtx.skills.filter(
   558→          (s) =>
   559→            s._ulid !== skill._ulid &&
   560→            s.depends_on?.some(
   561→              (dep) =>
   562→                dep === `@${skill.id}` ||
   563→                dep === skill.id ||
   564→                dep.startsWith(`@${skill._ulid.substring(0, 8)}`),
   565→            ),
   566→        );
   567→
   568→        if (dependentSkills.length > 0) {
   569→          const depRefs = dependentSkills.map((s) => `@${s.id}`).join(", ");
   570→          error(
   571→            `Cannot delete skill '${skill.id}': referenced by ${dependentSkills.length} skill(s): ${depRefs}`,
   572→          );
   573→          process.exit(EXIT_CODES.ERROR);
   574→        }
   575→
   576→        // AC: @skill-cli ac-7, ac-8 - delete meta entry and directory
   577→        const deleted = await deleteMetaItem(ctx, skill._ulid, "skill");
   578→
   579→        if (!deleted) {
   580→          error(`Failed to delete skill: ${skill.id}`);
   581→          process.exit(EXIT_CODES.ERROR);
   582→        }
   583→
   584→        // Commit changes
   585→        await commitIfShadow(ctx.shadow, "skill-delete", skill.id);
   586→
   587→        success(`Deleted skill: ${skill.id}`);
   588→      } catch (err) {
   589→        error("Failed to delete skill", err);
   590→        process.exit(EXIT_CODES.ERROR);
   591→      }
   592→    });
   593→
   594→  // AC: @skill-import ac-1 through ac-7 - kspec skill import
   595→  // AC: @import-frontmatter-strip ac-1 through ac-6 - Extended frontmatter parsing
   596→  markMutating(skill.command("import <file>"))
   597→    .description("Import an existing SKILL.md file into kspec")
   598→    .option("--id <id>", "Custom skill ID (defaults to directory name)")
   599→    .option("--name <name>", "Skill name (required if no frontmatter)")
   600→    .option("--description <desc>", "Skill description (required if no frontmatter)")
   601→    .option(
   602→      "--origin <origin>",
   603→      "Skill origin (core, project, local)",
   604→      "project",
   605→    )
   606→    .option("--skill-version <version>", "Skill version")
   607→    .action(async (file: string, options) => {
   608→      try {
   609→        const ctx = await initContext();
   610→
   611→        if (!ctx.manifestPath) {
   612→          error(errors.project.noKspecProject);
   613→          process.exit(EXIT_CODES.ERROR);
   614→        }
   615→
   616→        // Resolve file path
   617→        const filePath = path.isAbsolute(file)
   618→          ? file
   619→          : path.resolve(process.cwd(), file);
   620→
   621→        // Check file exists
   622→        try {
   623→          await fs.access(filePath);
   624→        } catch {
   625→          error(`File not found: ${filePath}`);
   626→          process.exit(EXIT_CODES.NOT_FOUND);
   627→        }
   628→
   629→        // Read file content
   630→        const content = await fs.readFile(filePath, "utf-8");
   631→
   632→        // AC: @skill-import ac-1, ac-6 - Parse YAML frontmatter
   633→        // AC: @import-frontmatter-strip ac-1, ac-3 - Parse all Agent Skills fields
   634→        const frontmatter = parseFrontmatter(content);
   635→
   636→        // Determine name and description from frontmatter or options
   637→        // AC: @import-frontmatter-strip ac-6 - CLI flags work when no frontmatter
   638→        const skillName = options.name || frontmatter?.name;
   639→        const skillDescription = options.description || frontmatter?.description;
   640→
   641→        // AC: @skill-import ac-6, @import-frontmatter-strip ac-6 - Error if no name/description and no frontmatter
   642→        if (!skillName) {
   643→          error("Name is required. Either add YAML frontmatter with 'name' field or use --name option.");
   644→          console.log(chalk.gray("Example frontmatter:\n---\nname: my-skill\ndescription: My skill description\n---"));
   645→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   646→        }
   647→
   648→        if (!skillDescription) {
   649→          error("Description is required. Either add YAML frontmatter with 'description' field or use --description option.");
   650→          console.log(chalk.gray("Example frontmatter:\n---\nname: my-skill\ndescription: My skill description\n---"));
   651→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   652→        }
   653→
   654→        // AC: @skill-import ac-5 - Derive ID from directory name or use custom
   655→        const sourceDir = path.dirname(filePath);
   656→        const derivedId = path.basename(sourceDir);
   657→        const skillId = options.id || derivedId;
   658→
   659→        // Validate origin
   660→        const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   661→        if (!validOrigins.includes(options.origin as SkillOrigin)) {
   662→          error(
   663→            `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   664→          );
   665→          process.exit(EXIT_CODES.ERROR);
   666→        }
   667→
   668→        // Check if skill with this ID already exists
   669→        const metaCtx = await loadMetaContext(ctx);
   670→        const existingSkill = metaCtx.skills.find((s) => s.id === skillId);
   671→        if (existingSkill) {
   672→          error(`Skill with ID '${skillId}' already exists. Use --id to specify a different ID.`);
   673→          process.exit(EXIT_CODES.CONFLICT);
   674→        }
   675→
   676→        // AC: @import-frontmatter-strip ac-3 - Build platform_config.claude_code from frontmatter
   677→        let platformConfig: import("../../schema/index.js").PlatformConfig | undefined;
   678→        if (frontmatter) {
   679→          const claudeCodeConfig: import("../../schema/index.js").ClaudeCodeConfig = {};
   680→          if (frontmatter.user_invocable !== undefined) {
   681→            claudeCodeConfig.user_invocable = frontmatter.user_invocable;
   682→          }
   683→          if (frontmatter.disable_model_invocation !== undefined) {
   684→            claudeCodeConfig.disable_model_invocation = frontmatter.disable_model_invocation;
   685→          }
   686→          if (frontmatter.context !== undefined) {
   687→            claudeCodeConfig.context = frontmatter.context;
   688→          }
   689→          if (frontmatter.agent !== undefined) {
   690→            claudeCodeConfig.agent = frontmatter.agent;
   691→          }
   692→          if (frontmatter.model !== undefined) {
   693→            claudeCodeConfig.model = frontmatter.model;
   694→          }
   695→          if (frontmatter.argument_hint !== undefined) {
   696→            claudeCodeConfig.argument_hint = frontmatter.argument_hint;
   697→          }
   698→
   699→          // Only set platform_config if we have Claude Code config fields
   700→          if (Object.keys(claudeCodeConfig).length > 0) {
   701→            platformConfig = { claude_code: claudeCodeConfig };
   702→          }
   703→        }
   704→
   705→        // Build skill object
   706→        // AC: @import-frontmatter-strip ac-1 - All recognized fields populate meta.yaml
   707→        const skillData: Skill = {
   708→          _ulid: ulid(),
   709→          id: skillId,
   710→          name: skillName,
   711→          description: skillDescription,
   712→          origin: options.origin as SkillOrigin,
   713→          version: options.skillVersion,
   714→          platforms: ["claude-code"],
   715→          depends_on: [],
   716→          // AC: @import-frontmatter-strip ac-1 - license, compatibility, allowed_tools from frontmatter
   717→          license: frontmatter?.license,
   718→          compatibility: frontmatter?.compatibility,
   719→          allowed_tools: frontmatter?.allowed_tools || [],
   720→          tags: [],
   721→          // AC: @import-frontmatter-strip ac-3 - platform_config.claude_code from frontmatter
   722→          platform_config: platformConfig,
   723→        };
   724→
   725→        // Validate with schema
   726→        const parsed = SkillSchema.safeParse(skillData);
   727→        if (!parsed.success) {
   728→          const issues = parsed.error.issues
   729→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   730→            .join("; ");
   731→          error(`Invalid skill data: ${issues}`);
   732→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   733→        }
   734→
   735→        const skill: LoadedSkill = { ...parsed.data };
   736→
   737→        // Save meta entry (also creates directory)
   738→        await saveMetaItem(ctx, skill, "skill");
   739→
   740→        // AC: @skill-import ac-7 - Strip/normalize base-directory paths
   741→        // AC: @import-frontmatter-strip ac-2 - Store body-only content (strip frontmatter)
   742→        const normalizedContent = normalizeBaseDirectory(content);
   743→        const bodyOnlyContent = stripFrontmatter(normalizedContent);
   744→
   745→        // AC: @skill-import ac-2 - Copy content to .kspec/skills/<id>/SKILL.md
   746→        const skillMdPath = getSkillContentPath(ctx, skill.id);
   747→        await fs.writeFile(skillMdPath, bodyOnlyContent, "utf-8");
   748→
   749→        // AC: @import-frontmatter-strip ac-4, ac-5 - Copy all supporting directories
   750→        const supportingDirs = ["references", "scripts", "assets", "docs"];
   751→        for (const dirName of supportingDirs) {
   752→          const sourceSubDir = path.join(sourceDir, dirName);
   753→          try {
   754→            const stats = await fs.stat(sourceSubDir);
   755→            if (stats.isDirectory()) {
   756→              const targetSubDir = path.join(ctx.specDir, "skills", skill.id, dirName);
   757→              await fs.mkdir(targetSubDir, { recursive: true });
   758→              await copyDirectory(sourceSubDir, targetSubDir);
   759→            }
   760→          } catch {
   761→            // Directory doesn't exist, that's fine
   762→          }
   763→        }
   764→
   765→        // Commit changes
   766→        await commitIfShadow(ctx.shadow, "skill-import", skill.id, skill.name);
   767→
   768→        output(skill, () =>
   769→          success(`Imported skill: ${skill.id}`, { skill }),
   770→        );
   771→      } catch (err) {
   772→        error("Failed to import skill", err);
   773→        process.exit(EXIT_CODES.ERROR);
   774→      }
   775→    });
   776→
   777→  // AC: @skill-rendering ac-1 through ac-5 - kspec skill render
   778→  // AC: @skill-render-cli ac-1, ac-2 - kspec skill render / kspec skill render @skill-id
   779→  // AC: @skill-drift-detection ac-3, ac-4 - drift handling with --force
   780→  // AC: @trait-dry-run - supports --dry-run
   781→  // AC: @trait-error-guidance - provides error guidance
   782→  skill
   783→    .command("render [ref]")
   784→    .description(
   785→      "Render skills from shadow branch to platform-specific files on main branch"
   786→    )
   787→    .option("--clean", "Remove orphaned managed skill directories")
   788→    .option("--dry-run", "Show what would be changed without applying")
   789→    .option("--force", "Overwrite drifted skill files (manually edited)")
   790→    .option("--skill <id>", "Render only a specific skill (deprecated, use positional arg)")
   791→    .action(async (ref: string | undefined, options) => {
   792→      try {
   793→        const ctx = await initContext();
   794→
   795→        if (!ctx.manifestPath) {
   796→          error(errors.project.noKspecProject);
   797→          console.log(
   798→            chalk.gray("Try: kspec init to initialize a kspec project")
   799→          );
   800→          process.exit(EXIT_CODES.ERROR);
   801→        }
   802→
   803→        const metaCtx = await loadMetaContext(ctx);
   804→        // Use rootDir (project root), not specDir (which is .kspec/ in shadow mode)
   805→        const projectRoot = ctx.rootDir;
   806→        const dryRun = options.dryRun || false;
   807→        const force = options.force || false;
   808→        const results: SkillRenderResult[] = [];
   809→        const cleanResults: CleanResult[] = [];
   810→
   811→        // Filter skills by platform (only claude-code for now)
   812→        let skillsToRender = metaCtx.skills.filter((s) =>
   813→          s.platforms.includes("claude-code")
   814→        );
   815→
   816→        // AC: @skill-render-cli ac-2 - Filter to specific skill if requested
   817→        // Support both positional ref argument and --skill option
   818→        const skillRef = ref || options.skill;
   819→        if (skillRef) {
   820→          // Resolve the ref to a skill
   821→          const item = findMetaItemByRef(metaCtx, skillRef);
   822→          if (!item || !("origin" in item)) {
   823→            error(`Skill not found: ${skillRef}`);
   824→            console.log(chalk.gray("Try: kspec skill list"));
   825→            process.exit(EXIT_CODES.NOT_FOUND);
   826→          }
   827→          const skill = item as LoadedSkill;
   828→          skillsToRender = skillsToRender.filter((s) => s.id === skill.id);
   829→          if (skillsToRender.length === 0) {
   830→            error(`Skill '${skill.id}' does not have claude-code platform`);
   831→            process.exit(EXIT_CODES.ERROR);
   832→          }
   833→        }
   834→
   835→        // Ensure .claude/skills directory exists
   836→        const targetSkillsDir = path.join(projectRoot, ".claude", "skills");
   837→        if (!dryRun) {
   838→          await fs.mkdir(targetSkillsDir, { recursive: true });
   839→        }
   840→
   841→        // Render each skill
   842→        // AC: @skill-drift-detection ac-3, ac-4 - Check drift and skip without --force
   843→        // AC: @consolidate-skill-render ac-1 - delegates to renderClaudeCodeSkill from skill-render.ts
   844→        for (const skill of skillsToRender) {
   845→          // Check for drift before rendering
   846→          const driftStatus = await checkSkillDrift(ctx.specDir, projectRoot, skill.id);
   847→
   848→          // AC: @skill-drift-detection ac-3 - Skip drifted skills without --force
   849→          if (driftStatus === "drifted" && !force) {
   850→            const renderedPath = path.join(
   851→              projectRoot,
   852→              ".claude",
   853→              "skills",
   854→              skill.id,
   855→              "SKILL.md"
   856→            );
   857→            results.push({
   858→              id: skill.id,
   859→              action: "skipped",
   860→              path: renderedPath,
   861→              skipReason: "drifted (use --force to overwrite)",
   862→            });
   863→            continue;
   864→          }
   865→
   866→          // AC: @skill-drift-detection ac-4 - Render (overwrite) when --force is used
   867→          // AC: @consolidate-skill-render ac-1 - use renderClaudeCodeSkill with storeHash
   868→          const result = await renderClaudeCodeSkill(ctx, projectRoot, skill, {
   869→            dryRun,
   870→            storeHash: true,
   871→          });
   872→          results.push(result);
   873→        }
   874→
   875→        // Handle --clean: remove orphaned managed skills
   876→        // AC: @skill-rendering ac-4, ac-5
   877→        if (options.clean) {
   878→          const activeSkillIds = new Set(metaCtx.skills.map((s) => s.id));
   879→
   880→          try {
   881→            const entries = await fs.readdir(targetSkillsDir, {
   882→              withFileTypes: true,
   883→            });
   884→
   885→            for (const entry of entries) {
   886→              if (!entry.isDirectory()) continue;
   887→
   888→              const skillId = entry.name;
   889→              const skillDir = path.join(targetSkillsDir, skillId);
   890→              const skillMdPath = path.join(skillDir, "SKILL.md");
   891→
   892→              // Skip if skill still exists in meta
   893→              if (activeSkillIds.has(skillId)) continue;
   894→
   895→              // AC: @skill-rendering ac-4 - Only consider kspec-managed skills
   896→              const isManaged = await isKspecManaged(skillMdPath);
   897→
   898→              if (isManaged) {
   899→                // AC: @skill-rendering ac-5 - Remove orphaned directory
   900→                if (!dryRun) {
   901→                  await fs.rm(skillDir, { recursive: true, force: true });
   902→                }
   903→                cleanResults.push({
   904→                  id: skillId,
   905→                  path: skillDir,
   906→                  action: "removed",
   907→                });
   908→              } else {
   909→                cleanResults.push({
   910→                  id: skillId,
   911→                  path: skillDir,
   912→                  action: "skipped",
   913→                  reason: "Not managed by kspec",
   914→                });
   915→              }
   916→            }
   917→          } catch {
   918→            // No .claude/skills directory, nothing to clean
   919→          }
   920→        }
   921→
   922→        // Output results
   923→        // AC: @trait-dry-run ac-6 - JSON output includes dry_run field
   924→        output(
   925→          {
   926→            dry_run: dryRun,
   927→            rendered: results,
   928→            cleaned: cleanResults,
   929→          },
   930→          () => {
   931→            // AC: @trait-dry-run ac-3 - Clear indication this is a preview
   932→            if (dryRun) {
   933→              console.log(chalk.yellow("DRY RUN - No changes made"));
   934→              console.log();
   935→            }
   936→
   937→            // Render results
   938→            const created = results.filter((r) => r.action === "created");
   939→            const updated = results.filter((r) => r.action === "updated");
   940→            const unchanged = results.filter((r) => r.action === "unchanged");
   941→            // AC: @skill-drift-detection ac-3 - Track skipped drifted skills
   942→            const skippedDrifted = results.filter((r) => r.action === "skipped");
   943→
   944→            if (created.length > 0) {
   945→              console.log(chalk.green(`Created: ${created.length} skill(s)`));
   946→              for (const r of created) {
   947→                console.log(`  ${chalk.green("+")} ${r.id}`);
   948→              }
   949→            }
   950→
   951→            if (updated.length > 0) {
   952→              console.log(chalk.blue(`Updated: ${updated.length} skill(s)`));
   953→              for (const r of updated) {
   954→                console.log(`  ${chalk.blue("~")} ${r.id}`);
   955→              }
   956→            }
   957→
   958→            if (unchanged.length > 0 && results.length <= 10) {
   959→              console.log(chalk.gray(`Unchanged: ${unchanged.length} skill(s)`));
   960→            }
   961→
   962→            // AC: @skill-drift-detection ac-3 - Show warning for skipped drifted skills
   963→            if (skippedDrifted.length > 0) {
   964→              console.log();
   965→              console.log(chalk.yellow(`Skipped: ${skippedDrifted.length} drifted skill(s)`));
   966→              for (const r of skippedDrifted) {
   967→                console.log(`  ${chalk.yellow("!")} ${r.id}: ${r.skipReason || "drifted"}`);
   968→              }
   969→              console.log();
   970→              console.log(chalk.yellow("Use --force to overwrite drifted skills"));
   971→            }
   972→
   973→            // Clean results
   974→            if (cleanResults.length > 0) {
   975→              const removed = cleanResults.filter((r) => r.action === "removed");
   976→              const skipped = cleanResults.filter((r) => r.action === "skipped");
   977→
   978→              if (removed.length > 0) {
   979→                console.log();
   980→                console.log(chalk.red(`Removed: ${removed.length} orphaned skill(s)`));
   981→                for (const r of removed) {
   982→                  console.log(`  ${chalk.red("-")} ${r.id}`);
   983→                }
   984→              }
   985→
   986→              if (skipped.length > 0) {
   987→                console.log(
   988→                  chalk.gray(`Skipped: ${skipped.length} unmanaged skill(s)`)
   989→                );
   990→              }
   991→            }
   992→
   993→            // Summary
   994→            console.log();
   995→            if (dryRun) {
   996→              console.log(
   997→                chalk.yellow("No changes were made. Run without --dry-run to apply.")
   998→              );
   999→            } else {
  1000→              const changedCount = created.length + updated.length;
  1001→              const cleanedCount = cleanResults.filter(
  1002→                (r) => r.action === "removed"
  1003→              ).length;
  1004→              if (changedCount > 0 || cleanedCount > 0) {
  1005→                success(
  1006→                  `Rendered ${changedCount} skill(s)${cleanedCount > 0 ? `, cleaned ${cleanedCount}` : ""}`
  1007→                );
  1008→              } else {
  1009→                console.log(chalk.gray("No changes needed"));
  1010→              }
  1011→            }
  1012→          }
  1013→        );
  1014→      } catch (err) {
  1015→        error("Failed to render skills", err);
  1016→        process.exit(EXIT_CODES.ERROR);
  1017→      }
  1018→    });
  1019→
  1020→  // AC: @skill-render-cli ac-3 - kspec skill status
  1021→  skill
  1022→    .command("status")
  1023→    .description("Show sync status of rendered skills")
  1024→    .action(async () => {
  1025→      try {
  1026→        const ctx = await initContext();
  1027→
  1028→        if (!ctx.manifestPath) {
  1029→          error(errors.project.noKspecProject);
  1030→          console.log(
  1031→            chalk.gray("Try: kspec init to initialize a kspec project")
  1032→          );
  1033→          process.exit(EXIT_CODES.ERROR);
  1034→        }
  1035→
  1036→        const metaCtx = await loadMetaContext(ctx);
  1037→        const projectRoot = ctx.rootDir;
  1038→
  1039→        // Filter skills by platform (only claude-code for now)
  1040→        const skillsToCheck = metaCtx.skills.filter((s) =>
  1041→          s.platforms.includes("claude-code")
  1042→        );
  1043→
  1044→        if (skillsToCheck.length === 0) {
  1045→          console.log(chalk.yellow("No skills found"));
  1046→          return;
  1047→        }
  1048→
  1049→        const statusResults: SkillStatusResult[] = [];
  1050→
  1051→        for (const skill of skillsToCheck) {
  1052→          const status = await getSkillSyncStatus(ctx, projectRoot, skill);
  1053→          statusResults.push(status);
  1054→        }
  1055→
  1056→        // Output results
  1057→        output(
  1058→          statusResults,
  1059→          () => {
  1060→            const table = new Table({
  1061→              head: [
  1062→                chalk.bold("ID"),
  1063→                chalk.bold("Status"),
  1064→                chalk.bold("Docs"),
  1065→              ],
  1066→              style: {
  1067→                head: [],
  1068→                border: [],
  1069→              },
  1070→            });
  1071→
  1072→            for (const result of statusResults) {
  1073→              const statusColor =
  1074→                result.status === "in-sync"
  1075→                  ? chalk.green
  1076→                  : result.status === "drifted"
  1077→                    ? chalk.yellow
  1078→                    : chalk.gray;
  1079→
  1080→              const docsStatusColor =
  1081→                result.docsStatus === "in-sync"
  1082→                  ? chalk.green
  1083→                  : result.docsStatus === "drifted"
  1084→                    ? chalk.yellow
  1085→                    : chalk.gray;
  1086→
  1087→              table.push([
  1088→                result.id,
  1089→                statusColor(result.status),
  1090→                docsStatusColor(result.docsStatus || "-"),
  1091→              ]);
  1092→            }
  1093→
  1094→            console.log(table.toString());
  1095→
  1096→            // Summary
  1097→            const inSync = statusResults.filter((r) => r.status === "in-sync").length;
  1098→            const drifted = statusResults.filter((r) => r.status === "drifted").length;
  1099→            const notRendered = statusResults.filter((r) => r.status === "not-rendered").length;
  1100→
  1101→            console.log();
  1102→            if (drifted > 0) {
  1103→              console.log(chalk.yellow(`${drifted} skill(s) drifted - run 'kspec skill render' to sync`));
  1104→            }
  1105→            if (notRendered > 0) {
  1106→              console.log(chalk.gray(`${notRendered} skill(s) not rendered`));
  1107→            }
  1108→            if (inSync === statusResults.length) {
  1109→              console.log(chalk.green("All skills in sync"));
  1110→            }
  1111→          }
  1112→        );
  1113→      } catch (err) {
  1114→        error("Failed to check skill status", err);
  1115→        process.exit(EXIT_CODES.ERROR);
  1116→      }
  1117→    });
  1118→
  1119→  // AC: @skill-render-cli ac-4 - kspec skill diff
  1120→  skill
  1121→    .command("diff <ref>")
  1122→    .description("Show diff between source and rendered skill")
  1123→    .action(async (ref: string) => {
  1124→      try {
  1125→        const ctx = await initContext();
  1126→
  1127→        if (!ctx.manifestPath) {
  1128→          error(errors.project.noKspecProject);
  1129→          console.log(
  1130→            chalk.gray("Try: kspec init to initialize a kspec project")
  1131→          );
  1132→          process.exit(EXIT_CODES.ERROR);
  1133→        }
  1134→
  1135→        const metaCtx = await loadMetaContext(ctx);
  1136→        const item = findMetaItemByRef(metaCtx, ref);
  1137→
  1138→        if (!item) {
  1139→          error(`Skill not found: ${ref}`);
  1140→          console.log(chalk.gray("Try: kspec skill list"));
  1141→          process.exit(EXIT_CODES.NOT_FOUND);
  1142→        }
  1143→
  1144→        // Check it's a skill
  1145→        if (!("origin" in item)) {
  1146→          error(`Item ${ref} is not a skill`);
  1147→          process.exit(EXIT_CODES.ERROR);
  1148→        }
  1149→
  1150→        const skill = item as LoadedSkill;
  1151→        const projectRoot = ctx.rootDir;
  1152→
  1153→        // Get expected rendered content
  1154→        const expectedContent = await getExpectedRenderedContent(ctx, skill);
  1155→
  1156→        // Get actual rendered content
  1157→        const renderedPath = path.join(
  1158→          projectRoot,
  1159→          ".claude",
  1160→          "skills",
  1161→          skill.id,
  1162→          "SKILL.md"
  1163→        );
  1164→
  1165→        let actualContent = "";
  1166→        try {
  1167→          actualContent = await fs.readFile(renderedPath, "utf-8");
  1168→        } catch {
  1169→          // File doesn't exist
  1170→        }
  1171→
  1172→        // Generate diff
  1173→        const diff = generateUnifiedDiff(
  1174→          actualContent,
  1175→          expectedContent,
  1176→          `a/${skill.id}/SKILL.md`,
  1177→          `b/${skill.id}/SKILL.md`
  1178→        );
  1179→
  1180→        // Output
  1181→        output(
  1182→          {
  1183→            id: skill.id,
  1184→            hasDiff: diff.length > 0,
  1185→            diff,
  1186→          },
  1187→          () => {
  1188→            if (diff.length === 0) {
  1189→              console.log(chalk.green(`${skill.id}: in sync`));
  1190→            } else {
  1191→              console.log(chalk.yellow(`${skill.id}: drifted`));
  1192→              console.log();
  1193→              // Print colored diff
  1194→              for (const line of diff) {
  1195→                if (line.startsWith("+") && !line.startsWith("+++")) {
  1196→                  console.log(chalk.green(line));
  1197→                } else if (line.startsWith("-") && !line.startsWith("---")) {
  1198→                  console.log(chalk.red(line));
  1199→                } else if (line.startsWith("@@")) {
  1200→                  console.log(chalk.cyan(line));
  1201→                } else {
  1202→                  console.log(line);
  1203→                }
  1204→              }
  1205→            }
  1206→          }
  1207→        );
  1208→      } catch (err) {
  1209→        error("Failed to generate diff", err);
  1210→        process.exit(EXIT_CODES.ERROR);
  1211→      }
  1212→    });
  1213→
  1214→  // AC: @core-skill-install - kspec skill install-core
  1215→  markMutating(skill.command("install-core"))
  1216→    .description(
  1217→      "Install core skills from kspec package templates"
  1218→    )
  1219→    .option("--force", "Overwrite custom forks with core versions")
  1220→    .option("--dry-run", "Show what would be installed without making changes")
  1221→    .action(async (options) => {
  1222→      try {
  1223→        const ctx = await initContext();
  1224→
  1225→        if (!ctx.manifestPath) {
  1226→          error(errors.project.noKspecProject);
  1227→          console.log(
  1228→            chalk.gray("Try: kspec init to initialize a kspec project")
  1229→          );
  1230→          process.exit(EXIT_CODES.ERROR);
  1231→        }
  1232→
  1233→        const metaCtx = await loadMetaContext(ctx);
  1234→        const dryRun = options.dryRun || false;
  1235→        const force = options.force || false;
  1236→        const results: CoreSkillInstallResult[] = [];
  1237→
  1238→        // Load core skills manifest
  1239→        const coreSkills = loadCoreSkillsManifest();
  1240→        if (coreSkills.length === 0) {
  1241→          console.log(chalk.yellow("No core skills found in kspec package templates"));
  1242→          return;
  1243→        }
  1244→
  1245→        // Get kspec package version
  1246→        const kspecVersion = getKspecPackageVersion();
  1247→
  1248→        // Process each core skill
  1249→        for (const coreSkill of coreSkills) {
  1250→          // AC: @core-skill-install ac-3 - Check if skill exists with custom origin
  1251→          const existingSkill = metaCtx.skills.find((s) => s.id === coreSkill.id);
  1252→
  1253→          if (existingSkill) {
  1254→            // Check origin - if "custom" or "project" and not forcing, skip
  1255→            if (existingSkill.origin !== "core" && !force) {
  1256→              results.push({
  1257→                id: coreSkill.id,
  1258→                action: "skipped",
  1259→                reason: `existing ${existingSkill.origin} skill (use --force to overwrite)`,
  1260→              });
  1261→              continue;
  1262→            }
  1263→          }
  1264→
  1265→          // AC: @core-skill-install ac-1 - Create/update meta entry with origin core
  1266→          // AC: @core-skill-install ac-5 - Version matches kspec package version
  1267→          const skillData: Skill = {
  1268→            _ulid: existingSkill?._ulid || ulid(),
  1269→            id: coreSkill.id,
  1270→            name: coreSkill.name,
  1271→            description: coreSkill.description,
  1272→            origin: "core",
  1273→            version: kspecVersion,
  1274→            platforms: coreSkill.platforms || ["claude-code"],
  1275→            depends_on: [],
  1276→            allowed_tools: [],
  1277→            tags: ["core"],
  1278→          };
  1279→
  1280→          // Validate with schema
  1281→          const parsed = SkillSchema.safeParse(skillData);
  1282→          if (!parsed.success) {
  1283→            const issues = parsed.error.issues
  1284→              .map((i) => `${i.path.join(".")}: ${i.message}`)
  1285→              .join("; ");
  1286→            results.push({
  1287→              id: coreSkill.id,
  1288→              action: "failed",
  1289→              reason: `validation error: ${issues}`,
  1290→            });
  1291→            continue;
  1292→          }
  1293→
  1294→          const skill: LoadedSkill = { ...parsed.data };
  1295→
  1296→          // Save meta entry (if not dry run)
  1297→          if (!dryRun) {
  1298→            await saveMetaItem(ctx, skill, "skill");
  1299→
  1300→            // AC: @core-skill-install ac-2 - Copy SKILL.md content
  1301→            const sourceContent = loadCoreSkillContent(coreSkill.id);
  1302→            if (sourceContent) {
  1303→              const targetPath = getSkillContentPath(ctx, skill.id);
  1304→              await fs.writeFile(targetPath, sourceContent, "utf-8");
  1305→            }
  1306→          }
  1307→
  1308→          results.push({
  1309→            id: coreSkill.id,
  1310→            action: existingSkill ? "updated" : "created",
  1311→            version: kspecVersion,
  1312→          });
  1313→        }
  1314→
  1315→        // Commit changes if not dry run
  1316→        if (!dryRun && results.some((r) => r.action === "created" || r.action === "updated")) {
  1317→          await commitIfShadow(
  1318→            ctx.shadow,
  1319→            "skill-install-core",
  1320→            `${results.filter((r) => r.action !== "skipped" && r.action !== "failed").length} core skills`
  1321→          );
  1322→        }
  1323→
  1324→        // Output results
  1325→        output(
  1326→          {
  1327→            dry_run: dryRun,
  1328→            results,
  1329→          },
  1330→          () => {
  1331→            if (dryRun) {
  1332→              console.log(chalk.yellow("DRY RUN - No changes made"));
  1333→              console.log();
  1334→            }
  1335→
  1336→            const created = results.filter((r) => r.action === "created");
  1337→            const updated = results.filter((r) => r.action === "updated");
  1338→            const skipped = results.filter((r) => r.action === "skipped");
  1339→            const failed = results.filter((r) => r.action === "failed");
  1340→
  1341→            if (created.length > 0) {
  1342→              console.log(chalk.green(`Created: ${created.length} skill(s)`));
  1343→              for (const r of created) {
  1344→                console.log(`  ${chalk.green("+")} ${r.id} (v${r.version})`);
  1345→              }
  1346→            }
  1347→
  1348→            if (updated.length > 0) {
  1349→              console.log(chalk.blue(`Updated: ${updated.length} skill(s)`));
  1350→              for (const r of updated) {
  1351→                console.log(`  ${chalk.blue("~")} ${r.id} (v${r.version})`);
  1352→              }
  1353→            }
  1354→
  1355→            if (skipped.length > 0) {
  1356→              console.log(chalk.yellow(`Skipped: ${skipped.length} skill(s)`));
  1357→              for (const r of skipped) {
  1358→                console.log(`  ${chalk.yellow("!")} ${r.id}: ${r.reason}`);
  1359→              }
  1360→            }
  1361→
  1362→            if (failed.length > 0) {
  1363→              console.log(chalk.red(`Failed: ${failed.length} skill(s)`));
  1364→              for (const r of failed) {
  1365→                console.log(`  ${chalk.red("x")} ${r.id}: ${r.reason}`);
  1366→              }
  1367→            }
  1368→
  1369→            console.log();
  1370→            if (dryRun) {
  1371→              console.log(
  1372→                chalk.yellow("No changes were made. Run without --dry-run to apply.")
  1373→              );
  1374→            } else {
  1375→              const changedCount = created.length + updated.length;
  1376→              if (changedCount > 0) {
  1377→                success(`Installed ${changedCount} core skill(s)`);
  1378→              } else if (skipped.length > 0) {
  1379→                console.log(chalk.gray("No skills installed (all skipped or failed)"));
  1380→              }
  1381→            }
  1382→          }
  1383→        );
  1384→      } catch (err) {
  1385→        error("Failed to install core skills", err);
  1386→        process.exit(EXIT_CODES.ERROR);
  1387→      }
  1388→    });
  1389→
  1390→  // AC: @core-skill-update - kspec skill update
  1391→  markMutating(skill.command("update"))
  1392→    .description(
  1393→      "Update core skills to match the installed kspec package version"
  1394→    )
  1395→    .option("--dry-run", "Show what would be updated without making changes")
  1396→    .action(async (options) => {
  1397→      try {
  1398→        const ctx = await initContext();
  1399→
  1400→        if (!ctx.manifestPath) {
  1401→          error(errors.project.noKspecProject);
  1402→          console.log(
  1403→            chalk.gray("Try: kspec init to initialize a kspec project")
  1404→          );
  1405→          process.exit(EXIT_CODES.ERROR);
  1406→        }
  1407→
  1408→        const metaCtx = await loadMetaContext(ctx);
  1409→        const dryRun = options.dryRun || false;
  1410→        const results: CoreSkillUpdateResult[] = [];
  1411→
  1412→        // Get kspec package version
  1413→        const kspecVersion = getKspecPackageVersion();
  1414→
  1415→        // Load core skills manifest to get current content
  1416→        const coreSkillsManifest = loadCoreSkillsManifest();
  1417→        const coreSkillsMap = new Map(
  1418→          coreSkillsManifest.map((s) => [s.id, s])
  1419→        );
  1420→
  1421→        // AC: @core-skill-update ac-3 - Only process skills with origin core
  1422→        const coreSkills = metaCtx.skills.filter((s) => s.origin === "core");
  1423→
  1424→        for (const skill of coreSkills) {
  1425→          // AC: @core-skill-update ac-2 - Skip if already at current version
  1426→          if (skill.version === kspecVersion) {
  1427→            results.push({
  1428→              id: skill.id,
  1429→              action: "skipped",
  1430→              reason: "already at current version",
  1431→              currentVersion: skill.version,
  1432→            });
  1433→            continue;
  1434→          }
  1435→
  1436→          // Check if skill exists in core manifest
  1437→          const coreSkill = coreSkillsMap.get(skill.id);
  1438→          if (!coreSkill) {
  1439→            results.push({
  1440→              id: skill.id,
  1441→              action: "skipped",
  1442→              reason: "not found in core skills manifest",
  1443→              currentVersion: skill.version,
  1444→            });
  1445→            continue;
  1446→          }
  1447→
  1448→          // AC: @core-skill-update ac-1 - Update content and version
  1449→          const oldVersion = skill.version;
  1450→
  1451→          if (!dryRun) {
  1452→            // Update skill metadata with new version
  1453→            skill.version = kspecVersion;
  1454→            skill.name = coreSkill.name;
  1455→            if (coreSkill.description) {
  1456→              skill.description = coreSkill.description;
  1457→            }
  1458→            if (coreSkill.platforms) {
  1459→              skill.platforms = coreSkill.platforms;
  1460→            }
  1461→
  1462→            // Save updated metadata
  1463→            await saveMetaItem(ctx, skill, "skill");
  1464→
  1465→            // Update SKILL.md content from templates
  1466→            const sourceContent = loadCoreSkillContent(skill.id);
  1467→            if (sourceContent) {
  1468→              const targetPath = getSkillContentPath(ctx, skill.id);
  1469→              await fs.writeFile(targetPath, sourceContent, "utf-8");
  1470→            }
  1471→          }
  1472→
  1473→          results.push({
  1474→            id: skill.id,
  1475→            action: "updated",
  1476→            previousVersion: oldVersion,
  1477→            newVersion: kspecVersion,
  1478→          });
  1479→        }
  1480→
  1481→        // Commit changes if not dry run and there are updates
  1482→        if (!dryRun && results.some((r) => r.action === "updated")) {
  1483→          await commitIfShadow(
  1484→            ctx.shadow,
  1485→            "skill-update",
  1486→            `${results.filter((r) => r.action === "updated").length} core skills`
  1487→          );
  1488→        }
  1489→
  1490→        // Output results
  1491→        output(
  1492→          {
  1493→            dry_run: dryRun,
  1494→            kspec_version: kspecVersion,
  1495→            results,
  1496→          },
  1497→          () => {
  1498→            if (dryRun) {
  1499→              console.log(chalk.yellow("DRY RUN - No changes made"));
  1500→              console.log();
  1501→            }
  1502→
  1503→            console.log(`kspec version: ${kspecVersion}`);
  1504→            console.log();
  1505→
  1506→            const updated = results.filter((r) => r.action === "updated");
  1507→            const skipped = results.filter((r) => r.action === "skipped");
  1508→
  1509→            if (updated.length > 0) {
  1510→              console.log(chalk.green(`Updated: ${updated.length} skill(s)`));
  1511→              for (const r of updated) {
  1512→                console.log(
  1513→                  `  ${chalk.green("~")} ${r.id}: ${r.previousVersion || "unknown"} → ${r.newVersion}`
  1514→                );
  1515→              }
  1516→            }
  1517→
  1518→            if (skipped.length > 0) {
  1519→              console.log(chalk.gray(`Skipped: ${skipped.length} skill(s)`));
  1520→              for (const r of skipped) {
  1521→                console.log(
  1522→                  `  ${chalk.gray("-")} ${r.id}: ${r.reason}${r.currentVersion ? ` (v${r.currentVersion})` : ""}`
  1523→                );
  1524→              }
  1525→            }
  1526→
  1527→            console.log();
  1528→            if (dryRun) {
  1529→              console.log(
  1530→                chalk.yellow("No changes were made. Run without --dry-run to apply.")
  1531→              );
  1532→            } else if (updated.length > 0) {
  1533→              success(`Updated ${updated.length} core skill(s)`);
  1534→            } else {
  1535→              console.log(chalk.gray("No skills needed updating"));
  1536→            }
  1537→          }
  1538→        );
  1539→      } catch (err) {
  1540→        error("Failed to update core skills", err);
  1541→        process.exit(EXIT_CODES.ERROR);
  1542→      }
  1543→    });
  1544→}
  1545→
  1546→/**
  1547→ * Result of updating a single core skill
  1548→ * AC: @core-skill-update
  1549→ */
  1550→interface CoreSkillUpdateResult {
  1551→  id: string;
  1552→  action: "updated" | "skipped";
  1553→  previousVersion?: string;
  1554→  newVersion?: string;
  1555→  currentVersion?: string;
  1556→  reason?: string;
  1557→}
  1558→
  1559→/**
  1560→ * Result of installing a single core skill
  1561→ */
  1562→interface CoreSkillInstallResult {
  1563→  id: string;
  1564→  action: "created" | "updated" | "skipped" | "failed";
  1565→  version?: string;
  1566→  reason?: string;
  1567→}
  1568→
  1569→/**
  1570→ * Core skill definition from manifest
  1571→ */
  1572→interface CoreSkillDefinition {
  1573→  id: string;
  1574→  name: string;
  1575→  description?: string;
  1576→  platforms?: string[];
  1577→}
  1578→
  1579→/**
  1580→ * Get the kspec package version from package.json
  1581→ * AC: @core-skill-install ac-5
  1582→ */
  1583→function getKspecPackageVersion(): string {
  1584→  try {
  1585→    // Try to find package.json relative to this module
  1586→    const packagePath = path.resolve(
  1587→      import.meta.dirname || path.dirname(new URL(import.meta.url).pathname),
  1588→      "../../../package.json"
  1589→    );
  1590→    const packageJson = JSON.parse(readFileSync(packagePath, "utf-8"));
  1591→    return packageJson.version || "unknown";
  1592→  } catch {
  1593→    return "unknown";
  1594→  }
  1595→}
  1596→
  1597→/**
  1598→ * Get the templates directory path
  1599→ */
  1600→function getTemplatesDir(): string {
  1601→  // Templates are at <package-root>/templates/skills/
  1602→  return path.resolve(
  1603→    import.meta.dirname || path.dirname(new URL(import.meta.url).pathname),
  1604→    "../../../templates/skills"
  1605→  );
  1606→}
  1607→
  1608→/**
  1609→ * Load core skills manifest from templates/skills/manifest.yaml
  1610→ * AC: @core-skill-install ac-1, ac-2
  1611→ */
  1612→function loadCoreSkillsManifest(): CoreSkillDefinition[] {
  1613→  try {
  1614→    const templatesDir = getTemplatesDir();
  1615→    const manifestPath = path.join(templatesDir, "manifest.yaml");
  1616→    const content = readFileSync(manifestPath, "utf-8");
  1617→    const parsed = yaml.parse(content);
  1618→
  1619→    if (!parsed || !Array.isArray(parsed.skills)) {
  1620→      return [];
  1621→    }
  1622→
  1623→    return parsed.skills.map((s: Record<string, unknown>) => ({
  1624→      id: String(s.id || ""),
  1625→      name: String(s.name || s.id || ""),
  1626→      description: s.description ? String(s.description) : undefined,
  1627→      platforms: Array.isArray(s.platforms) ? s.platforms.map(String) : undefined,
  1628→    })).filter((s: CoreSkillDefinition) => s.id);
  1629→  } catch {
  1630→    return [];
  1631→  }
  1632→}
  1633→
  1634→/**
  1635→ * Load SKILL.md content for a core skill from templates
  1636→ * AC: @core-skill-install ac-2
  1637→ */
  1638→function loadCoreSkillContent(skillId: string): string | null {
  1639→  try {
  1640→    const templatesDir = getTemplatesDir();
  1641→    const skillMdPath = path.join(templatesDir, skillId, "SKILL.md");
  1642→    return readFileSync(skillMdPath, "utf-8");
  1643→  } catch {
  1644→    return null;
  1645→  }
  1646→}
  1647→
  1648→/**
  1649→ * Parsed frontmatter from Agent Skills SKILL.md
  1650→ * AC: @import-frontmatter-strip ac-1 - All recognized Agent Skills fields
  1651→ * AC: @import-frontmatter-strip ac-3 - Claude Code platform-specific fields
  1652→ */
  1653→interface ParsedFrontmatter {
  1654→  // Core metadata
  1655→  name?: string;
  1656→  description?: string;
  1657→  // Portable Agent Skills fields (AC: ac-1)
  1658→  license?: string;
  1659→  compatibility?: string;
  1660→  allowed_tools?: string[];
  1661→  // Claude Code platform fields (AC: ac-3)
  1662→  user_invocable?: boolean;
  1663→  disable_model_invocation?: boolean;
  1664→  context?: string;
  1665→  agent?: string;
  1666→  model?: string;
  1667→  argument_hint?: string;
  1668→}
  1669→
  1670→/**
  1671→ * Parse YAML frontmatter from markdown content.
  1672→ * Returns null if no valid frontmatter found.
  1673→ *
  1674→ * AC: @import-frontmatter-strip ac-1 - Parse all Agent Skills frontmatter fields
  1675→ * AC: @import-frontmatter-strip ac-3 - Parse Claude Code platform frontmatter
  1676→ */
  1677→function parseFrontmatter(content: string): ParsedFrontmatter | null {
  1678→  const frontmatterRegex = /^---\n([\s\S]*?)\n---/;
  1679→  const match = content.match(frontmatterRegex);
  1680→
  1681→  if (!match) {
  1682→    return null;
  1683→  }
  1684→
  1685→  try {
  1686→    const parsed = yaml.parse(match[1]);
  1687→
  1688→    if (typeof parsed === "object" && parsed !== null) {
  1689→      const result: ParsedFrontmatter = {};
  1690→
  1691→      // Core metadata
  1692→      if (typeof parsed.name === "string") result.name = parsed.name;
  1693→      if (typeof parsed.description === "string") result.description = parsed.description;
  1694→
  1695→      // Portable Agent Skills fields (AC: ac-1)
  1696→      if (typeof parsed.license === "string") result.license = parsed.license;
  1697→      if (typeof parsed.compatibility === "string") result.compatibility = parsed.compatibility;
  1698→      if (Array.isArray(parsed.allowed_tools)) {
  1699→        result.allowed_tools = parsed.allowed_tools.filter((t: unknown) => typeof t === "string");
  1700→      }
  1701→
  1702→      // Claude Code platform fields (AC: ac-3)
  1703→      // Support both underscore and hyphen naming for user-invocable
  1704→      if (typeof parsed.user_invocable === "boolean") result.user_invocable = parsed.user_invocable;
  1705→      if (typeof parsed["user-invocable"] === "boolean") result.user_invocable = parsed["user-invocable"];
  1706→      if (typeof parsed.disable_model_invocation === "boolean") result.disable_model_invocation = parsed.disable_model_invocation;
  1707→      if (typeof parsed["disable-model-invocation"] === "boolean") result.disable_model_invocation = parsed["disable-model-invocation"];
  1708→      if (typeof parsed.context === "string") result.context = parsed.context;
  1709→      if (typeof parsed.agent === "string") result.agent = parsed.agent;
  1710→      if (typeof parsed.model === "string") result.model = parsed.model;
  1711→      if (typeof parsed.argument_hint === "string") result.argument_hint = parsed.argument_hint;
  1712→      if (typeof parsed["argument-hint"] === "string") result.argument_hint = parsed["argument-hint"];
  1713→
  1714→      return result;
  1715→    }
  1716→  } catch {
  1717→    // Invalid YAML in frontmatter
  1718→  }
  1719→
  1720→  return null;
  1721→}
  1722→
  1723→/**
  1724→ * Strip YAML frontmatter from markdown content.
  1725→ * AC: @import-frontmatter-strip ac-2 - Remove frontmatter for body-only storage
  1726→ */
  1727→function stripFrontmatter(content: string): string {
  1728→  return content.replace(/^---\n[\s\S]*?\n---\n?/, "");
  1729→}
  1730→
  1731→/**
  1732→ * Normalize base-directory paths in skill content.
  1733→ * AC: @skill-import ac-7 - Strip or convert absolute paths to relative.
  1734→ *
  1735→ * Matches patterns like:
  1736→ * - "Base directory for this skill: /absolute/path/to/skill"
  1737→ * - Lines starting with hardcoded paths
  1738→ */
  1739→function normalizeBaseDirectory(content: string): string {
  1740→  // Remove or normalize "Base directory for this skill:" lines with absolute paths
  1741→  // Common pattern in Claude-generated skill files
  1742→  const baseDirLineRegex = /^Base directory for this skill:.*$/gm;
  1743→
  1744→  return content.replace(baseDirLineRegex, "");
  1745→}
  1746→
  1747→/**
  1748→ * Recursively copy a directory
  1749→ */
  1750→async function copyDirectory(src: string, dest: string): Promise<void> {
  1751→  const entries = await fs.readdir(src, { withFileTypes: true });
  1752→
  1753→  for (const entry of entries) {
  1754→    const srcPath = path.join(src, entry.name);
  1755→    const destPath = path.join(dest, entry.name);
  1756→
  1757→    if (entry.isDirectory()) {
  1758→      await fs.mkdir(destPath, { recursive: true });
  1759→      await copyDirectory(srcPath, destPath);
  1760→    } else {
  1761→      await fs.copyFile(srcPath, destPath);
  1762→    }
  1763→  }
  1764→}
  1765→
  1766→/**
  1767→ * Result of rendering a single skill
  1768→ * AC: @skill-drift-detection ac-3 - Includes "skipped" action for drifted skills
  1769→ * AC: @consolidate-skill-render ac-2 - No private renderSkill function, uses imported renderClaudeCodeSkill
  1770→ */
  1771→interface SkillRenderResult {
  1772→  id: string;
  1773→  action: "created" | "updated" | "unchanged" | "skipped";
  1774→  path: string;
  1775→  docsAction?: "created" | "updated" | "unchanged" | "skipped";
  1776→  /** Reason why skill was skipped */
  1777→  skipReason?: string;
  1778→}
  1779→
  1780→/**
  1781→ * Result of a clean operation
  1782→ */
  1783→interface CleanResult {
  1784→  id: string;
  1785→  path: string;
  1786→  action: "removed" | "skipped";
  1787→  reason?: string;
  1788→}
  1789→
  1790→/**
  1791→ * Check if two contents are equal (for idempotency check)
  1792→ */
  1793→function contentsEqual(a: string, b: string): boolean {
  1794→  return a.trim() === b.trim();
  1795→}
  1796→
  1797→/**
  1798→ * Recursively check if two directories have the same contents
  1799→ */
  1800→async function directoriesEqual(src: string, dest: string): Promise<boolean> {
  1801→  try {
  1802→    const srcEntries = await fs.readdir(src, { withFileTypes: true });
  1803→    const destEntries = await fs.readdir(dest, { withFileTypes: true });
  1804→
  1805→    // Different number of entries = not equal
  1806→    if (srcEntries.length !== destEntries.length) {
  1807→      return false;
  1808→    }
  1809→
  1810→    // Create a map of dest entries for quick lookup
  1811→    const destMap = new Map(destEntries.map((e) => [e.name, e]));
  1812→
  1813→    for (const srcEntry of srcEntries) {
  1814→      const destEntry = destMap.get(srcEntry.name);
  1815→      if (!destEntry) {
  1816→        return false;
  1817→      }
  1818→
  1819→      const srcPath = path.join(src, srcEntry.name);
  1820→      const destPath = path.join(dest, srcEntry.name);
  1821→
  1822→      if (srcEntry.isDirectory() && destEntry.isDirectory()) {
  1823→        if (!(await directoriesEqual(srcPath, destPath))) {
  1824→          return false;
  1825→        }
  1826→      } else if (srcEntry.isFile() && destEntry.isFile()) {
  1827→        const srcContent = await fs.readFile(srcPath, "utf-8");
  1828→        const destContent = await fs.readFile(destPath, "utf-8");
  1829→        if (!contentsEqual(srcContent, destContent)) {
  1830→          return false;
  1831→        }
  1832→      } else {
  1833→        // Type mismatch
  1834→        return false;
  1835→      }
  1836→    }
  1837→
  1838→    return true;
  1839→  } catch {
  1840→    return false;
  1841→  }
  1842→}
  1843→
  1844→/**
  1845→ * Result of checking a skill's sync status
  1846→ * AC: @skill-render-cli ac-3
  1847→ */
  1848→interface SkillStatusResult {
  1849→  id: string;
  1850→  status: "in-sync" | "drifted" | "not-rendered";
  1851→  docsStatus?: "in-sync" | "drifted" | "not-rendered" | "no-docs";
  1852→}
  1853→
  1854→/**
  1855→ * Get the sync status of a skill
  1856→ * AC: @skill-render-cli ac-3
  1857→ * AC: @skill-drift-detection ac-1, ac-2 - Uses hash-based drift detection
  1858→ */
  1859→async function getSkillSyncStatus(
  1860→  ctx: KspecContext,
  1861→  projectRoot: string,
  1862→  skill: LoadedSkill
  1863→): Promise<SkillStatusResult> {
  1864→  // AC: @skill-drift-detection ac-1, ac-2 - Use hash-based drift detection
  1865→  const driftStatus = await checkSkillDrift(ctx.specDir, projectRoot, skill.id);
  1866→
  1867→  // Map drift status to sync status
  1868→  let status: "in-sync" | "drifted" | "not-rendered";
  1869→  switch (driftStatus) {
  1870→    case "in-sync":
  1871→      status = "in-sync";
  1872→      break;
  1873→    case "drifted":
  1874→      status = "drifted";
  1875→      break;
  1876→    case "not-rendered":
  1877→      status = "not-rendered";
  1878→      break;
  1879→    case "no-hash":
  1880→      // No hash stored - need to check if content matches expected
  1881→      // (handles edge case where skill was rendered before hash tracking was added)
  1882→      const expectedContent = await getExpectedRenderedContent(ctx, skill);
  1883→      const renderedPath = path.join(
  1884→        projectRoot,
  1885→        ".claude",
  1886→        "skills",
  1887→        skill.id,
  1888→        "SKILL.md"
  1889→      );
  1890→      try {
  1891→        const actualContent = await fs.readFile(renderedPath, "utf-8");
  1892→        status = contentsEqual(expectedContent, actualContent) ? "in-sync" : "drifted";
  1893→      } catch {
  1894→        status = "not-rendered";
  1895→      }
  1896→      break;
  1897→  }
  1898→
  1899→  // Check docs status
  1900→  const sourceDocsDir = path.join(ctx.specDir, "skills", skill.id, "docs");
  1901→  const targetDocsDir = path.join(projectRoot, ".claude", "skills", skill.id, "docs");
  1902→  let docsStatus: "in-sync" | "drifted" | "not-rendered" | "no-docs" = "no-docs";
  1903→
  1904→  try {
  1905→    await fs.stat(sourceDocsDir);
  1906→    // Source docs exist, check target
  1907→    try {
  1908→      await fs.stat(targetDocsDir);
  1909→      // Both exist, compare
  1910→      const equal = await directoriesEqual(sourceDocsDir, targetDocsDir);
  1911→      docsStatus = equal ? "in-sync" : "drifted";
  1912→    } catch {
  1913→      docsStatus = "not-rendered";
  1914→    }
  1915→  } catch {
  1916→    // No source docs
  1917→    docsStatus = "no-docs";
  1918→  }
  1919→
  1920→  return {
  1921→    id: skill.id,
  1922→    status,
  1923→    docsStatus,
  1924→  };
  1925→}
  1926→
  1927→/**
  1928→ * Get the expected rendered content for a skill
  1929→ */
  1930→async function getExpectedRenderedContent(
  1931→  ctx: KspecContext,
  1932→  skill: LoadedSkill
  1933→): Promise<string> {
  1934→  const sourceContent = await loadSkillContent(ctx, skill);
  1935→
  1936→  if (!sourceContent) {
  1937→    // No source content, generate placeholder
  1938→    const frontmatter = generateFrontmatter(skill);
  1939→    return `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
  1940→  }
  1941→
  1942→  // Generate rendered content with frontmatter and marker
  1943→  const frontmatter = generateFrontmatter(skill);
  1944→
  1945→  // Check if source already has frontmatter - if so, strip it
  1946→  const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
  1947→  const contentWithoutFrontmatter = frontmatterMatch
  1948→    ? sourceContent.slice(frontmatterMatch[0].length)
  1949→    : sourceContent;
  1950→
  1951→  return `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
  1952→}
  1953→
  1954→/**
  1955→ * Generate unified diff between two strings
  1956→ * AC: @skill-render-cli ac-4
  1957→ */
  1958→function generateUnifiedDiff(
  1959→  actual: string,
  1960→  expected: string,
  1961→  actualPath: string,
  1962→  expectedPath: string
  1963→): string[] {
  1964→  if (contentsEqual(actual, expected)) {
  1965→    return [];
  1966→  }
  1967→
  1968→  const actualLines = actual.split("\n");
  1969→  const expectedLines = expected.split("\n");
  1970→  const diffLines: string[] = [];
  1971→
  1972→  // Simple line-by-line diff (unified format)
  1973→  diffLines.push(`--- ${actualPath}`);
  1974→  diffLines.push(`+++ ${expectedPath}`);
  1975→
  1976→  // Find differing sections and create hunks
  1977→  let i = 0;
  1978→  let j = 0;
  1979→
  1980→  while (i < actualLines.length || j < expectedLines.length) {
  1981→    // Find start of difference
  1982→    const contextStart = i;
  1983→    const contextStartExpected = j;
  1984→
  1985→    // Skip matching lines
  1986→    while (
  1987→      i < actualLines.length &&
  1988→      j < expectedLines.length &&
  1989→      actualLines[i] === expectedLines[j]
  1990→    ) {
  1991→      i++;
  1992→      j++;
  1993→    }
  1994→
  1995→    // If we've reached the end, we're done
  1996→    if (i >= actualLines.length && j >= expectedLines.length) {
  1997→      break;
  1998→    }
  1999→
  2000→    // Find end of difference
  2001→    let diffEndActual = i;
  2002→    let diffEndExpected = j;
  2003→
  2004→    // Collect differing lines
  2005→    while (
  2006→      diffEndActual < actualLines.length &&
  2007→      diffEndExpected < expectedLines.length &&
  2008→      actualLines[diffEndActual] !== expectedLines[diffEndExpected]
  2009→    ) {
  2010→      diffEndActual++;
  2011→      diffEndExpected++;
  2012→    }
  2013→
  2014→    // Also handle case where one side has more lines
  2015→    while (diffEndActual < actualLines.length && diffEndExpected >= expectedLines.length) {
  2016→      diffEndActual++;
  2017→    }
  2018→    while (diffEndExpected < expectedLines.length && diffEndActual >= actualLines.length) {
  2019→      diffEndExpected++;
  2020→    }
  2021→
  2022→    // Create hunk header (show 3 lines of context)
  2023→    const hunkStartActual = Math.max(0, contextStart - 3);
  2024→    const hunkStartExpected = Math.max(0, contextStartExpected - 3);
  2025→
  2026→    // Include context after diff too
  2027→    const hunkEndActual = Math.min(actualLines.length, diffEndActual + 3);
  2028→    const hunkEndExpected = Math.min(expectedLines.length, diffEndExpected + 3);
  2029→
  2030→    const actualCount = hunkEndActual - hunkStartActual;
  2031→    const expectedCount = hunkEndExpected - hunkStartExpected;
  2032→
  2033→    diffLines.push(
  2034→      `@@ -${hunkStartActual + 1},${actualCount} +${hunkStartExpected + 1},${expectedCount} @@`
  2035→    );
  2036→
  2037→    // Leading context
  2038→    for (let k = hunkStartActual; k < contextStart; k++) {
  2039→      diffLines.push(` ${actualLines[k]}`);
  2040→    }
  2041→
  2042→    // Removed lines (from actual)
  2043→    for (let k = contextStart; k < diffEndActual; k++) {
  2044→      if (k < actualLines.length) {
  2045→        diffLines.push(`-${actualLines[k]}`);
  2046→      }
  2047→    }
  2048→
  2049→    // Added lines (from expected)
  2050→    for (let k = contextStartExpected; k < diffEndExpected; k++) {
  2051→      if (k < expectedLines.length) {
  2052→        diffLines.push(`+${expectedLines[k]}`);
  2053→      }
  2054→    }
  2055→
  2056→    // Trailing context
  2057→    for (let k = diffEndActual; k < hunkEndActual; k++) {
  2058→      if (k < actualLines.length) {
  2059→        diffLines.push(` ${actualLines[k]}`);
  2060→      }
  2061→    }
  2062→
  2063→    i = hunkEndActual;
  2064→    j = hunkEndExpected;
  2065→  }
  2066→
  2067→  return diffLines;
  2068→}
  2069→
  2070→// Re-export for testing
  2071→// Re-export for testing
  2072→// AC: @consolidate-skill-render ac-1, ac-2, ac-3 - renderClaudeCodeSkill, isKspecManaged, KSPEC_MANAGED_MARKER
  2073→// are now imported from skill-render.ts and re-exported here for API compatibility
  2074→export {
  2075→  isKspecManaged,
  2076→  KSPEC_MANAGED_MARKER,
  2077→  renderClaudeCodeSkill,
  2078→  getSkillSyncStatus,
  2079→  getExpectedRenderedContent,
  2080→  generateUnifiedDiff,
  2081→  loadCoreSkillsManifest,
  2082→  loadCoreSkillContent,
  2083→  getKspecPackageVersion,
  2084→};
  2085→

