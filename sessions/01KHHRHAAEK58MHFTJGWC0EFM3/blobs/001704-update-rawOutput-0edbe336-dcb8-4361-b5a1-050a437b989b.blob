     1→/**
     2→ * Claude Code Skill Renderer
     3→ *
     4→ * Platform-specific renderer for Claude Code. Reads from .kspec/skills/<id>/SKILL.md,
     5→ * writes to .claude/skills/<id>/SKILL.md with YAML frontmatter (name, description).
     6→ * Does NOT auto-commit to main branch — leaves files unstaged.
     7→ *
     8→ * AC: @claude-code-renderer ac-1 - renderClaudeCodeSkill creates .claude/skills/<id>/SKILL.md with YAML frontmatter
     9→ * AC: @claude-code-renderer ac-2 - rendered output has YAML frontmatter delimiters with name and description fields
    10→ * AC: @claude-code-renderer ac-3 - skill body content appears verbatim below frontmatter
    11→ * AC: @claude-code-renderer ac-4 - rendered files appear as unstaged changes on main branch
    12→ *
    13→ * AC: @skill-drift-detection ac-1 - Skill shows as in-sync when not manually edited
    14→ * AC: @skill-drift-detection ac-2 - Skill shows as drifted when manually edited
    15→ * AC: @skill-drift-detection ac-5 - Render hash stored in .kspec/skills/<id>/.render-hash
    16→ *
    17→ * AC: @consolidate-skill-render ac-3 - hash/drift functions exported from this module
    18→ */
    19→
    20→import * as crypto from "node:crypto";
    21→import * as fs from "node:fs/promises";
    22→import * as path from "node:path";
    23→import yaml from "yaml";
    24→import type { KspecContext } from "./yaml.js";
    25→import { loadSkillContent, type LoadedSkill } from "./meta.js";
    26→
    27→/**
    28→ * Result of rendering a skill to Claude Code format
    29→ */
    30→export interface ClaudeCodeRenderResult {
    31→  /** Skill ID */
    32→  id: string;
    33→  /** Action taken: created, updated, or unchanged */
    34→  action: "created" | "updated" | "unchanged";
    35→  /** Path to the rendered SKILL.md file */
    36→  path: string;
    37→  /** Action taken on docs directory */
    38→  docsAction?: "created" | "updated" | "unchanged" | "skipped";
    39→}
    40→
    41→/**
    42→ * Options for rendering a skill
    43→ */
    44→export interface RenderSkillOptions {
    45→  /** If true, don't write files, just return what would be done */
    46→  dryRun?: boolean;
    47→  /** If true, store a hash of the rendered content for drift detection */
    48→  storeHash?: boolean;
    49→}
    50→
    51→/**
    52→ * Marker comment that identifies skill directories managed by kspec
    53→ */
    54→export const KSPEC_MANAGED_MARKER = "<!-- kspec-managed -->";
    55→
    56→/**
    57→ * Generate YAML frontmatter for a skill.
    58→ * AC: @claude-code-renderer ac-2 - YAML frontmatter with name and description fields
    59→ */
    60→export function generateFrontmatter(skill: LoadedSkill): string {
    61→  const frontmatter: Record<string, unknown> = {
    62→    name: skill.id,
    63→    description: skill.description || skill.name,
    64→  };
    65→  return `---\n${yaml.stringify(frontmatter).trim()}\n---`;
    66→}
    67→
    68→/**
    69→ * Get the target directory for rendered skills on main branch.
    70→ * Returns .claude/skills/<id>/ path.
    71→ */
    72→function getRenderedSkillPath(projectRoot: string, skillId: string): string {
    73→  return path.join(projectRoot, ".claude", "skills", skillId);
    74→}
    75→
    76→/**
    77→ * Check if two contents are equal (for idempotency check)
    78→ */
    79→function contentsEqual(a: string, b: string): boolean {
    80→  return a.trim() === b.trim();
    81→}
    82→
    83→/**
    84→ * Recursively copy a directory
    85→ */
    86→async function copyDirectory(src: string, dest: string): Promise<void> {
    87→  const entries = await fs.readdir(src, { withFileTypes: true });
    88→
    89→  for (const entry of entries) {
    90→    const srcPath = path.join(src, entry.name);
    91→    const destPath = path.join(dest, entry.name);
    92→
    93→    if (entry.isDirectory()) {
    94→      await fs.mkdir(destPath, { recursive: true });
    95→      await copyDirectory(srcPath, destPath);
    96→    } else {
    97→      await fs.copyFile(srcPath, destPath);
    98→    }
    99→  }
   100→}
   101→
   102→/**
   103→ * Compute SHA256 hash of content
   104→ * AC: @skill-drift-detection ac-5 - Hash computation for render tracking
   105→ */
   106→export function computeContentHash(content: string): string {
   107→  return crypto.createHash("sha256").update(content, "utf-8").digest("hex");
   108→}
   109→
   110→/**
   111→ * Get the path to the render hash file for a skill
   112→ * AC: @skill-drift-detection ac-5 - Hash stored in .kspec/skills/<id>/.render-hash
   113→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   114→ */
   115→export function getRenderHashPath(specDir: string, skillId: string): string {
   116→  return path.join(specDir, "skills", skillId, ".render-hash");
   117→}
   118→
   119→/**
   120→ * Read the stored render hash for a skill
   121→ * AC: @skill-drift-detection ac-5 - Read hash from .kspec/skills/<id>/.render-hash
   122→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   123→ */
   124→export async function readRenderHash(specDir: string, skillId: string): Promise<string | null> {
   125→  try {
   126→    const hashPath = getRenderHashPath(specDir, skillId);
   127→    const content = await fs.readFile(hashPath, "utf-8");
   128→    return content.trim();
   129→  } catch {
   130→    return null;
   131→  }
   132→}
   133→
   134→/**
   135→ * Write the render hash for a skill
   136→ * AC: @skill-drift-detection ac-5 - Store hash in .kspec/skills/<id>/.render-hash
   137→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   138→ */
   139→export async function writeRenderHash(specDir: string, skillId: string, hash: string): Promise<void> {
   140→  const hashPath = getRenderHashPath(specDir, skillId);
   141→  await fs.mkdir(path.dirname(hashPath), { recursive: true });
   142→  await fs.writeFile(hashPath, hash + "\n", "utf-8");
   143→}
   144→
   145→/**
   146→ * Check if a rendered skill has drifted from its last render
   147→ * AC: @skill-drift-detection ac-1, ac-2 - Drift detection via hash comparison
   148→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   149→ *
   150→ * Returns:
   151→ * - "not-rendered": Rendered file doesn't exist
   152→ * - "in-sync": Rendered file matches stored hash
   153→ * - "drifted": Rendered file differs from stored hash (manually edited)
   154→ * - "no-hash": Rendered file exists but no stored hash (first render or hash deleted)
   155→ */
   156→export async function checkSkillDrift(
   157→  specDir: string,
   158→  projectRoot: string,
   159→  skillId: string
   160→): Promise<"not-rendered" | "in-sync" | "drifted" | "no-hash"> {
   161→  const renderedPath = path.join(projectRoot, ".claude", "skills", skillId, "SKILL.md");
   162→
   163→  // Check if rendered file exists
   164→  let renderedContent: string;
   165→  try {
   166→    renderedContent = await fs.readFile(renderedPath, "utf-8");
   167→  } catch {
   168→    return "not-rendered";
   169→  }
   170→
   171→  // Get stored hash
   172→  const storedHash = await readRenderHash(specDir, skillId);
   173→  if (!storedHash) {
   174→    return "no-hash";
   175→  }
   176→
   177→  // Compare hashes
   178→  const currentHash = computeContentHash(renderedContent);
   179→  return currentHash === storedHash ? "in-sync" : "drifted";
   180→}
   181→
   182→/**
   183→ * Recursively check if two directories have the same contents
   184→ */
   185→async function directoriesEqual(src: string, dest: string): Promise<boolean> {
   186→  try {
   187→    const srcEntries = await fs.readdir(src, { withFileTypes: true });
   188→    const destEntries = await fs.readdir(dest, { withFileTypes: true });
   189→
   190→    // Different number of entries = not equal
   191→    if (srcEntries.length !== destEntries.length) {
   192→      return false;
   193→    }
   194→
   195→    // Create a map of dest entries for quick lookup
   196→    const destMap = new Map(destEntries.map((e) => [e.name, e]));
   197→
   198→    for (const srcEntry of srcEntries) {
   199→      const destEntry = destMap.get(srcEntry.name);
   200→      if (!destEntry) {
   201→        return false;
   202→      }
   203→
   204→      const srcPath = path.join(src, srcEntry.name);
   205→      const destPath = path.join(dest, srcEntry.name);
   206→
   207→      if (srcEntry.isDirectory() && destEntry.isDirectory()) {
   208→        if (!(await directoriesEqual(srcPath, destPath))) {
   209→          return false;
   210→        }
   211→      } else if (srcEntry.isFile() && destEntry.isFile()) {
   212→        const srcContent = await fs.readFile(srcPath, "utf-8");
   213→        const destContent = await fs.readFile(destPath, "utf-8");
   214→        if (!contentsEqual(srcContent, destContent)) {
   215→          return false;
   216→        }
   217→      } else {
   218→        // Type mismatch
   219→        return false;
   220→      }
   221→    }
   222→
   223→    return true;
   224→  } catch {
   225→    return false;
   226→  }
   227→}
   228→
   229→/**
   230→ * Render a skill to Claude Code format.
   231→ *
   232→ * Reads skill content from .kspec/skills/<id>/SKILL.md and writes to
   233→ * .claude/skills/<id>/SKILL.md with YAML frontmatter containing name and description.
   234→ *
   235→ * AC: @claude-code-renderer ac-1 - Creates .claude/skills/<id>/SKILL.md with YAML frontmatter
   236→ * AC: @claude-code-renderer ac-2 - YAML frontmatter has name and description fields
   237→ * AC: @claude-code-renderer ac-3 - Skill body content appears verbatim below frontmatter
   238→ * AC: @claude-code-renderer ac-4 - Files are written to disk as unstaged changes (no git commit)
   239→ *
   240→ * @param ctx - Kspec context with specDir pointing to .kspec/
   241→ * @param projectRoot - Root directory of the project (where .claude/ will be created)
   242→ * @param skill - The skill to render
   243→ * @param options - Render options (dryRun, etc.)
   244→ * @returns Result indicating what action was taken
   245→ */
   246→export async function renderClaudeCodeSkill(
   247→  ctx: KspecContext,
   248→  projectRoot: string,
   249→  skill: LoadedSkill,
   250→  options: RenderSkillOptions = {},
   251→): Promise<ClaudeCodeRenderResult> {
   252→  const dryRun = options.dryRun ?? false;
   253→  const storeHash = options.storeHash ?? false;
   254→  const targetDir = getRenderedSkillPath(projectRoot, skill.id);
   255→  const targetSkillMd = path.join(targetDir, "SKILL.md");
   256→
   257→  // AC: @claude-code-renderer ac-3 - Load source content verbatim
   258→  const sourceContent = await loadSkillContent(ctx, skill);
   259→
   260→  if (!sourceContent) {
   261→    // No source content, but skill exists in meta - create placeholder
   262→    const frontmatter = generateFrontmatter(skill);
   263→    const renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
   264→
   265→    // AC: @claude-code-renderer ac-4 - Write to disk (unstaged)
   266→    if (!dryRun) {
   267→      await fs.mkdir(targetDir, { recursive: true });
   268→      await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
   269→      // AC: @skill-drift-detection ac-5 - Store hash of rendered output
   270→      if (storeHash) {
   271→        const hash = computeContentHash(renderedContent);
   272→        await writeRenderHash(ctx.specDir, skill.id, hash);
   273→      }
   274→    }
   275→
   276→    return {
   277→      id: skill.id,
   278→      action: "created",
   279→      path: targetSkillMd,
   280→    };
   281→  }
   282→
   283→  // AC: @claude-code-renderer ac-2 - Generate frontmatter with name and description
   284→  const frontmatter = generateFrontmatter(skill);
   285→
   286→  // Check if source already has frontmatter - if so, strip it
   287→  const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
   288→  const contentWithoutFrontmatter = frontmatterMatch
   289→    ? sourceContent.slice(frontmatterMatch[0].length)
   290→    : sourceContent;
   291→
   292→  // AC: @claude-code-renderer ac-1, ac-3 - Build rendered content with frontmatter + verbatim body
   293→  const renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
   294→
   295→  // Check if target exists and compare for idempotency
   296→  let targetExists = false;
   297→  let targetContent = "";
   298→  try {
   299→    targetContent = await fs.readFile(targetSkillMd, "utf-8");
   300→    targetExists = true;
   301→  } catch {
   302→    // Target doesn't exist
   303→  }
   304→
   305→  // Determine action based on comparison
   306→  let action: "created" | "updated" | "unchanged";
   307→
   308→  if (!targetExists) {
   309→    action = "created";
   310→  } else if (contentsEqual(renderedContent, targetContent)) {
   311→    action = "unchanged";
   312→  } else {
   313→    action = "updated";
   314→  }
   315→
   316→  // AC: @claude-code-renderer ac-4 - Apply changes to disk (no git commit)
   317→  if (!dryRun && action !== "unchanged") {
   318→    await fs.mkdir(targetDir, { recursive: true });
   319→    await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
   320→    // AC: @skill-drift-detection ac-5 - Store hash of rendered output
   321→    if (storeHash) {
   322→      const hash = computeContentHash(renderedContent);
   323→      await writeRenderHash(ctx.specDir, skill.id, hash);
   324→    }
   325→  }
   326→
   327→  // Handle docs directory
   328→  const sourceDocsDir = path.join(ctx.specDir, "skills", skill.id, "docs");
   329→  const targetDocsDir = path.join(targetDir, "docs");
   330→  let docsAction: "created" | "updated" | "unchanged" | "skipped" = "skipped";
   331→
   332→  try {
   333→    const stats = await fs.stat(sourceDocsDir);
   334→    if (stats.isDirectory()) {
   335→      // Check if target docs exist and compare
   336→      let targetDocsExist = false;
   337→      try {
   338→        await fs.stat(targetDocsDir);
   339→        targetDocsExist = true;
   340→      } catch {
   341→        // Target docs don't exist
   342→      }
   343→
   344→      if (!targetDocsExist) {
   345→        docsAction = "created";
   346→      } else {
   347→        // Compare directories
   348→        const equal = await directoriesEqual(sourceDocsDir, targetDocsDir);
   349→        docsAction = equal ? "unchanged" : "updated";
   350→      }
   351→
   352→      // Apply changes
   353→      if (!dryRun && docsAction !== "unchanged") {
   354→        // Remove existing docs and copy fresh
   355→        if (targetDocsExist) {
   356→          await fs.rm(targetDocsDir, { recursive: true, force: true });
   357→        }
   358→        await fs.mkdir(targetDocsDir, { recursive: true });
   359→        await copyDirectory(sourceDocsDir, targetDocsDir);
   360→      }
   361→    }
   362→  } catch {
   363→    // No source docs directory
   364→  }
   365→
   366→  return {
   367→    id: skill.id,
   368→    action,
   369→    path: targetSkillMd,
   370→    docsAction,
   371→  };
   372→}
   373→
   374→/**
   375→ * Check if a skill directory is managed by kspec.
   376→ * Looks for the KSPEC_MANAGED_MARKER in the SKILL.md file.
   377→ */
   378→export async function isKspecManagedSkill(skillMdPath: string): Promise<boolean> {
   379→  try {
   380→    const content = await fs.readFile(skillMdPath, "utf-8");
   381→    return content.includes(KSPEC_MANAGED_MARKER);
   382→  } catch {
   383→    return false;
   384→  }
   385→}
   386→

