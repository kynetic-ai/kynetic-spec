```
     1→/**
     2→ * Skill CLI commands for managing skills.
     3→ *
     4→ * AC: @skill-cli ac-1 - kspec skill list outputs table with ID, Name, Origin, Version, Platforms
     5→ * AC: @skill-cli ac-2 - kspec skill list --json outputs JSON array with full skill metadata
     6→ * AC: @skill-cli ac-3 - kspec skill add creates meta entry with origin custom
     7→ * AC: @skill-cli ac-4 - kspec skill add creates .kspec/skills/<id>/SKILL.md
     8→ * AC: @skill-cli ac-5 - kspec skill get outputs metadata including id, name, origin, platforms
     9→ * AC: @skill-cli ac-6 - kspec skill get outputs SKILL.md content
    10→ * AC: @skill-cli ac-7 - kspec skill delete --confirm removes meta entry
    11→ * AC: @skill-cli ac-8 - kspec skill delete removes .kspec/skills/<id>/ directory
    12→ *
    13→ * AC: @core-skill-install ac-1 - meta entries created with origin core
    14→ * AC: @core-skill-install ac-2 - content files copied from templates to .kspec/skills/<id>/
    15→ * AC: @core-skill-install ac-3 - custom skills skipped with message
    16→ * AC: @core-skill-install ac-4 - --force overwrites custom forks
    17→ * AC: @core-skill-install ac-5 - version matches kspec package version
    18→ *
    19→ * AC: @core-skill-update ac-1 - skill content and version updated when version differs
    20→ * AC: @core-skill-update ac-2 - skill skipped when already at current version
    21→ * AC: @core-skill-update ac-3 - skills with origin custom/project not touched
    22→ */
    23→
    24→import * as fs from "node:fs/promises";
    25→import { readFileSync } from "node:fs";
    26→import * as path from "node:path";
    27→import chalk from "chalk";
    28→import Table from "cli-table3";
    29→import type { Command } from "commander";
    30→import { ulid } from "ulid";
    31→import yaml from "yaml";
    32→import { markMutating } from "../command-annotations.js";
    33→import {
    34→  deleteMetaItem,
    35→  findMetaItemByRef,
    36→  getSkillContentPath,
    37→  initContext,
    38→  type KspecContext,
    39→  loadMetaContext,
    40→  loadSkillContent,
    41→  loadSkillDocs,
    42→  type LoadedSkill,
    43→  saveMetaItem,
    44→  type Skill,
    45→} from "../../parser/index.js";
    46→import { commitIfShadow } from "../../parser/shadow.js";
    47→import {
    48→  checkSkillDrift,
    49→  computeContentHash,
    50→  generateFrontmatter,
    51→  isKspecManagedSkill as isKspecManaged,
    52→  KSPEC_MANAGED_MARKER,
    53→  readRenderHash,
    54→  renderClaudeCodeSkill,
    55→  type ClaudeCodeRenderResult,
    56→} from "../../parser/skill-render.js";
    57→import { SkillSchema, type SkillOrigin } from "../../schema/index.js";
    58→import { errors } from "../../strings/errors.js";
    59→import { EXIT_CODES } from "../exit-codes.js";
    60→import { error, output, success } from "../output.js";
    61→import { parseTagsArray } from "../parse-utils.js";
    62→
    63→/**
    64→ * Format skills as a table
    65→ * AC: @skill-cli ac-1 - table displays ID, Name, Origin, Version, Platforms
    66→ */
    67→function formatSkillsTable(skills: LoadedSkill[]): void {
    68→  if (skills.length === 0) {
    69→    console.log(chalk.yellow("No skills defined"));
    70→    return;
    71→  }
    72→
    73→  const table = new Table({
    74→    head: [
    75→      chalk.bold("ID"),
    76→      chalk.bold("Name"),
    77→      chalk.bold("Origin"),
    78→      chalk.bold("Version"),
    79→      chalk.bold("Platforms"),
    80→    ],
    81→    style: {
    82→      head: [],
    83→      border: [],
    84→    },
    85→  });
    86→
    87→  for (const skill of skills) {
    88→    table.push([
    89→      skill.id,
    90→      skill.name,
    91→      skill.origin,
    92→      skill.version || "-",
    93→      skill.platforms.join(", "),
    94→    ]);
    95→  }
    96→
    97→  console.log(table.toString());
    98→  console.log(chalk.gray(`\n${skills.length} skill(s)`));
    99→}
   100→
   101→/**
   102→ * Format skill details
   103→ * AC: @skill-cli ac-5 - outputs metadata including id, name, origin, platforms
   104→ */
   105→function formatSkillDetails(skill: LoadedSkill, content: string | null): void {
   106→  console.log(chalk.bold(skill.name));
   107→  console.log(chalk.gray("─".repeat(40)));
   108→  console.log(`ID:          ${skill.id}`);
   109→  console.log(`ULID:        ${skill._ulid}`);
   110→  console.log(`Origin:      ${skill.origin}`);
   111→  console.log(`Platforms:   ${skill.platforms.join(", ")}`);
   112→
   113→  if (skill.version) {
   114→    console.log(`Version:     ${skill.version}`);
   115→  }
   116→
   117→  if (skill.description) {
   118→    console.log(`\n─── Description ───`);
   119→    console.log(skill.description);
   120→  }
   121→
   122→  if (skill.depends_on && skill.depends_on.length > 0) {
   123→    console.log(`\n─── Dependencies ───`);
   124→    for (const dep of skill.depends_on) {
   125→      console.log(`  • ${dep}`);
   126→    }
   127→  }
   128→
   129→  if (skill.tags && skill.tags.length > 0) {
   130→    console.log(`\nTags:        ${skill.tags.join(", ")}`);
   131→  }
   132→
   133→  // AC: @skill-cli ac-6 - display SKILL.md content
   134→  if (content) {
   135→    console.log(`\n─── SKILL.md Content ───`);
   136→    console.log(content);
   137→  } else {
   138→    console.log(chalk.gray("\n(No SKILL.md content found)"));
   139→  }
   140→}
   141→
   142→/**
   143→ * Register skill commands
   144→ */
   145→export function registerSkillCommands(program: Command): void {
   146→  const skill = program
   147→    .command("skill")
   148→    .description("Skill management commands");
   149→
   150→  // AC: @skill-cli ac-1, ac-2 - kspec skill list
   151→  skill
   152→    .command("list")
   153→    .description("List all skills")
   154→    .option("--origin <origin>", "Filter by origin (core, project, local)")
   155→    .option("--tag <tag>", "Filter by tag")
   156→    .action(async (options) => {
   157→      try {
   158→        const ctx = await initContext();
   159→
   160→        if (!ctx.manifestPath) {
   161→          error(errors.project.noKspecProject);
   162→          process.exit(EXIT_CODES.ERROR);
   163→        }
   164→
   165→        const metaCtx = await loadMetaContext(ctx);
   166→        let skills = metaCtx.skills || [];
   167→
   168→        // Apply filters
   169→        if (options.origin) {
   170→          skills = skills.filter((s) => s.origin === options.origin);
   171→        }
   172→
   173→        if (options.tag) {
   174→          skills = skills.filter((s) => s.tags?.includes(options.tag));
   175→        }
   176→
   177→        // AC: @skill-cli ac-2 - JSON output includes full skill metadata
   178→        output(
   179→          skills.map((s) => ({
   180→            _ulid: s._ulid,
   181→            id: s.id,
   182→            name: s.name,
   183→            description: s.description,
   184→            origin: s.origin,
   185→            version: s.version,
   186→            platforms: s.platforms,
   187→            depends_on: s.depends_on,
   188→            tags: s.tags,
   189→          })),
   190→          // AC: @skill-cli ac-1 - Table output
   191→          () => formatSkillsTable(skills),
   192→        );
   193→      } catch (err) {
   194→        error("Failed to list skills", err);
   195→        process.exit(EXIT_CODES.ERROR);
   196→      }
   197→    });
   198→
   199→  // AC: @skill-cli ac-3, ac-4 - kspec skill add
   200→  // AC: @skill-add ac-3 - --content-file copies existing file to SKILL.md
   201→  markMutating(skill.command("add"))
   202→    .description("Create a new skill")
   203→    .requiredOption("--id <id>", "Skill ID (kebab-case)")
   204→    .requiredOption("--name <name>", "Skill name")
   205→    .option("--description <desc>", "Skill description")
   206→    .option(
   207→      "--origin <origin>",
   208→      "Skill origin (core, project, local)",
   209→      "project",
   210→    )
   211→    .option("--skill-version <version>", "Skill version")
   212→    .option("--platform <platform...>", "Target platforms")
   213→    .option("--tag <tag...>", "Tags for the skill")
   214→    .option("--depends-on <ref...>", "Skill dependencies")
   215→    .option("--content-file <path>", "Path to existing file to use as SKILL.md content")
   216→    .action(async (options) => {
   217→      try {
   218→        const ctx = await initContext();
   219→
   220→        if (!ctx.manifestPath) {
   221→          error(errors.project.noKspecProject);
   222→          process.exit(EXIT_CODES.ERROR);
   223→        }
   224→
   225→        // Validate origin
   226→        const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   227→        if (!validOrigins.includes(options.origin as SkillOrigin)) {
   228→          error(
   229→            `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   230→          );
   231→          process.exit(EXIT_CODES.ERROR);
   232→        }
   233→
   234→        // Check if skill with this ID already exists
   235→        const metaCtx = await loadMetaContext(ctx);
   236→        const existingSkill = metaCtx.skills.find((s) => s.id === options.id);
   237→        if (existingSkill) {
   238→          error(`Skill with ID '${options.id}' already exists`);
   239→          process.exit(EXIT_CODES.CONFLICT);
   240→        }
   241→
   242→        // Build skill object
   243→        const skillData: Skill = {
   244→          _ulid: ulid(),
   245→          id: options.id,
   246→          name: options.name,
   247→          description: options.description,
   248→          origin: options.origin as SkillOrigin,
   249→          version: options.skillVersion,
   250→          platforms:
   251→            options.platform && options.platform.length > 0
   252→              ? options.platform
   253→              : ["claude-code"],
   254→          depends_on:
   255→            options.dependsOn && options.dependsOn.length > 0
   256→              ? options.dependsOn
   257→              : [],
   258→          allowed_tools: [],
   259→          tags:
   260→            options.tag && options.tag.length > 0
   261→              ? parseTagsArray(options.tag)
   262→              : [],
   263→        };
   264→
   265→        // Validate with schema
   266→        const parsed = SkillSchema.safeParse(skillData);
   267→        if (!parsed.success) {
   268→          const issues = parsed.error.issues
   269→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   270→            .join("; ");
   271→          error(`Invalid skill data: ${issues}`);
   272→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   273→        }
   274→
   275→        const skill: LoadedSkill = { ...parsed.data };
   276→
   277→        // AC: @skill-cli ac-3 - save meta entry (also creates directory per ac-4)
   278→        await saveMetaItem(ctx, skill, "skill");
   279→
   280→        // AC: @skill-cli ac-4 - create SKILL.md with placeholder content
   281→        // AC: @skill-add ac-3 - if --content-file provided, copy its contents
   282→        const skillMdPath = getSkillContentPath(ctx, skill.id);
   283→        let initialContent: string;
   284→
   285→        if (options.contentFile) {
   286→          // Read content from the specified file
   287→          const contentFilePath = path.isAbsolute(options.contentFile)
   288→            ? options.contentFile
   289→            : path.resolve(process.cwd(), options.contentFile);
   290→
   291→          try {
   292→            initialContent = await fs.readFile(contentFilePath, "utf-8");
   293→          } catch (err) {
   294→            // Clean up: remove the skill we just created
   295→            await deleteMetaItem(ctx, skill._ulid, "skill");
   296→            error(`Failed to read content file: ${contentFilePath}`);
   297→            process.exit(EXIT_CODES.ERROR);
   298→          }
   299→        } else {
   300→          initialContent = `# ${skill.name}\n\n${skill.description || "Add skill content here."}\n`;
   301→        }
   302→
   303→        await fs.writeFile(skillMdPath, initialContent, "utf-8");
   304→
   305→        // Commit changes
   306→        await commitIfShadow(ctx.shadow, "skill-add", skill.id, skill.name);
   307→
   308→        output(skill, () =>
   309→          success(`Created skill: ${skill.id}`, { skill }),
   310→        );
   311→      } catch (err) {
   312→        error("Failed to create skill", err);
   313→        process.exit(EXIT_CODES.ERROR);
   314→      }
   315→    });
   316→
   317→  // AC: @skill-cli ac-5, ac-6 - kspec skill get
   318→  skill
   319→    .command("get <ref>")
   320→    .description("Show skill details")
   321→    .action(async (ref: string) => {
   322→      try {
   323→        const ctx = await initContext();
   324→
   325→        if (!ctx.manifestPath) {
   326→          error(errors.project.noKspecProject);
   327→          process.exit(EXIT_CODES.ERROR);
   328→        }
   329→
   330→        const metaCtx = await loadMetaContext(ctx);
   331→        const item = findMetaItemByRef(metaCtx, ref);
   332→
   333→        if (!item) {
   334→          error(`Skill not found: ${ref}`);
   335→          console.log(chalk.gray("Try: kspec skill list"));
   336→          process.exit(EXIT_CODES.NOT_FOUND);
   337→        }
   338→
   339→        // Check it's a skill
   340→        if (!("origin" in item)) {
   341→          error(`Item ${ref} is not a skill`);
   342→          process.exit(EXIT_CODES.ERROR);
   343→        }
   344→
   345→        const skill = item as LoadedSkill;
   346→
   347→        // AC: @skill-cli ac-6 - load SKILL.md content
   348→        const content = await loadSkillContent(ctx, skill);
   349→        const docs = await loadSkillDocs(ctx, skill);
   350→
   351→        // AC: @skill-cli ac-5, ac-6 - output metadata and content
   352→        output(
   353→          {
   354→            _ulid: skill._ulid,
   355→            id: skill.id,
   356→            name: skill.name,
   357→            description: skill.description,
   358→            origin: skill.origin,
   359→            version: skill.version,
   360→            platforms: skill.platforms,
   361→            depends_on: skill.depends_on,
   362→            tags: skill.tags,
   363→            content,
   364→            docs: docs.map((d) => ({ name: d.name, path: d.path })),
   365→          },
   366→          () => formatSkillDetails(skill, content),
   367→        );
   368→      } catch (err) {
   369→        error("Failed to get skill", err);
   370→        process.exit(EXIT_CODES.ERROR);
   371→      }
   372→    });
   373→
   374→  // AC: @skill-set ac-1, ac-2, ac-3 - kspec skill set
   375→  markMutating(skill.command("set <ref>"))
   376→    .description("Update skill metadata fields")
   377→    .option("--name <name>", "Update skill name")
   378→    .option("--description <desc>", "Update skill description")
   379→    .option("--origin <origin>", "Update skill origin (core, project, local)")
   380→    .option("--skill-version <version>", "Update skill version")
   381→    .option("--add-platform <platform>", "Add a platform to the platforms array")
   382→    .option("--remove-platform <platform>", "Remove a platform from the platforms array")
   383→    .option("--add-tag <tag>", "Add a tag to the tags array")
   384→    .option("--remove-tag <tag>", "Remove a tag from the tags array")
   385→    .option("--add-depends-on <ref>", "Add a dependency reference")
   386→    .option("--remove-depends-on <ref>", "Remove a dependency reference")
   387→    .action(async (ref: string, options) => {
   388→      try {
   389→        const ctx = await initContext();
   390→
   391→        if (!ctx.manifestPath) {
   392→          error(errors.project.noKspecProject);
   393→          process.exit(EXIT_CODES.ERROR);
   394→        }
   395→
   396→        const metaCtx = await loadMetaContext(ctx);
   397→        const item = findMetaItemByRef(metaCtx, ref);
   398→
   399→        if (!item) {
   400→          error(`Skill not found: ${ref}`);
   401→          console.log(chalk.gray("Try: kspec skill list"));
   402→          process.exit(EXIT_CODES.NOT_FOUND);
   403→        }
   404→
   405→        // Check it's a skill
   406→        if (!("origin" in item)) {
   407→          error(`Item ${ref} is not a skill`);
   408→          process.exit(EXIT_CODES.ERROR);
   409→        }
   410→
   411→        const skill = item as LoadedSkill;
   412→
   413→        // AC: @skill-set ac-1 - update description field
   414→        if (options.name !== undefined) {
   415→          skill.name = options.name;
   416→        }
   417→
   418→        if (options.description !== undefined) {
   419→          skill.description = options.description;
   420→        }
   421→
   422→        // Update origin
   423→        if (options.origin !== undefined) {
   424→          const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   425→          if (!validOrigins.includes(options.origin as SkillOrigin)) {
   426→            error(
   427→              `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   428→            );
   429→            process.exit(EXIT_CODES.ERROR);
   430→          }
   431→          skill.origin = options.origin as SkillOrigin;
   432→        }
   433→
   434→        // Update version
   435→        if (options.skillVersion !== undefined) {
   436→          skill.version = options.skillVersion;
   437→        }
   438→
   439→        // AC: @skill-set ac-2 - add platform to array
   440→        if (options.addPlatform) {
   441→          if (!skill.platforms.includes(options.addPlatform)) {
   442→            skill.platforms.push(options.addPlatform);
   443→          }
   444→        }
   445→
   446→        // Remove platform
   447→        if (options.removePlatform) {
   448→          const idx = skill.platforms.indexOf(options.removePlatform);
   449→          if (idx >= 0) {
   450→            skill.platforms.splice(idx, 1);
   451→          }
   452→        }
   453→
   454→        // AC: @skill-set ac-3 - add tag to array
   455→        if (options.addTag) {
   456→          if (!skill.tags) {
   457→            skill.tags = [];
   458→          }
   459→          if (!skill.tags.includes(options.addTag)) {
   460→            skill.tags.push(options.addTag);
   461→          }
   462→        }
   463→
   464→        // Remove tag
   465→        if (options.removeTag && skill.tags) {
   466→          const idx = skill.tags.indexOf(options.removeTag);
   467→          if (idx >= 0) {
   468→            skill.tags.splice(idx, 1);
   469→          }
   470→        }
   471→
   472→        // Add dependency
   473→        if (options.addDependsOn) {
   474→          if (!skill.depends_on) {
   475→            skill.depends_on = [];
   476→          }
   477→          if (!skill.depends_on.includes(options.addDependsOn)) {
   478→            skill.depends_on.push(options.addDependsOn);
   479→          }
   480→        }
   481→
   482→        // Remove dependency
   483→        if (options.removeDependsOn && skill.depends_on) {
   484→          const idx = skill.depends_on.indexOf(options.removeDependsOn);
   485→          if (idx >= 0) {
   486→            skill.depends_on.splice(idx, 1);
   487→          }
   488→        }
   489→
   490→        // Validate updated skill
   491→        const parsed = SkillSchema.safeParse(skill);
   492→        if (!parsed.success) {
   493→          const issues = parsed.error.issues
   494→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   495→            .join("; ");
   496→          error(`Invalid skill data: ${issues}`);
   497→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   498→        }
   499→
   500→        // Save the updated skill
   501→        await saveMetaItem(ctx, skill, "skill");
   502→
   503→        // Commit changes
   504→        await commitIfShadow(ctx.shadow, "skill-set", skill.id, skill.name);
   505→
   506→        output(skill, () => success(`Updated skill: ${skill.id}`));
   507→      } catch (err) {
   508→        error("Failed to update skill", err);
   509→        process.exit(EXIT_CODES.ERROR);
   510→      }
   511→    });
   512→
   513→  // AC: @skill-cli ac-7, ac-8 - kspec skill delete
   514→  markMutating(skill.command("delete <ref>"))
   515→    .description("Delete a skill")
   516→    .option("--confirm", "Skip confirmation prompt")
   517→    .action(async (ref: string, options) => {
   518→      try {
   519→        const ctx = await initContext();
   520→
   521→        if (!ctx.manifestPath) {
   522→          error(errors.project.noKspecProject);
   523→          process.exit(EXIT_CODES.ERROR);
   524→        }
   525→
   526→        const metaCtx = await loadMetaContext(ctx);
   527→        const item = findMetaItemByRef(metaCtx, ref);
   528→
   529→        if (!item) {
   530→          error(`Skill not found: ${ref}`);
   531→          console.log(chalk.gray("Try: kspec skill list"));
   532→          process.exit(EXIT_CODES.NOT_FOUND);
   533→        }
   534→
   535→        // Check it's a skill
   536→        if (!("origin" in item)) {
   537→          error(`Item ${ref} is not a skill`);
   538→          process.exit(EXIT_CODES.ERROR);
   539→        }
   540→
   541→        const skill = item as LoadedSkill;
   542→
   543→        // Check for confirmation
   544→        if (!options.confirm) {
   545→          error(`Confirm deletion of skill '${skill.id}' with --confirm flag`);
   546→          process.exit(EXIT_CODES.ERROR);
   547→        }
   548→
   549→        // Check for dependencies from other skills
   550→        const dependentSkills = metaCtx.skills.filter(
   551→          (s) =>
   552→            s._ulid !== skill._ulid &&
   553→            s.depends_on?.some(
   554→              (dep) =>
   555→                dep === `@${skill.id}` ||
   556→                dep === skill.id ||
   557→                dep.startsWith(`@${skill._ulid.substring(0, 8)}`),
   558→            ),
   559→        );
   560→
   561→        if (dependentSkills.length > 0) {
   562→          const depRefs = dependentSkills.map((s) => `@${s.id}`).join(", ");
   563→          error(
   564→            `Cannot delete skill '${skill.id}': referenced by ${dependentSkills.length} skill(s): ${depRefs}`,
   565→          );
   566→          process.exit(EXIT_CODES.ERROR);
   567→        }
   568→
   569→        // AC: @skill-cli ac-7, ac-8 - delete meta entry and directory
   570→        const deleted = await deleteMetaItem(ctx, skill._ulid, "skill");
   571→
   572→        if (!deleted) {
   573→          error(`Failed to delete skill: ${skill.id}`);
   574→          process.exit(EXIT_CODES.ERROR);
   575→        }
   576→
   577→        // Commit changes
   578→        await commitIfShadow(ctx.shadow, "skill-delete", skill.id);
   579→
   580→        success(`Deleted skill: ${skill.id}`);
   581→      } catch (err) {
   582→        error("Failed to delete skill", err);
   583→        process.exit(EXIT_CODES.ERROR);
   584→      }
   585→    });
   586→
   587→  // AC: @skill-import ac-1 through ac-7 - kspec skill import
   588→  markMutating(skill.command("import <file>"))
   589→    .description("Import an existing SKILL.md file into kspec")
   590→    .option("--id <id>", "Custom skill ID (defaults to directory name)")
   591→    .option("--name <name>", "Skill name (required if no frontmatter)")
   592→    .option("--description <desc>", "Skill description (required if no frontmatter)")
   593→    .option(
   594→      "--origin <origin>",
   595→      "Skill origin (core, project, local)",
   596→      "project",
   597→    )
   598→    .option("--skill-version <version>", "Skill version")
   599→    .action(async (file: string, options) => {
   600→      try {
   601→        const ctx = await initContext();
   602→
   603→        if (!ctx.manifestPath) {
   604→          error(errors.project.noKspecProject);
   605→          process.exit(EXIT_CODES.ERROR);
   606→        }
   607→
   608→        // Resolve file path
   609→        const filePath = path.isAbsolute(file)
   610→          ? file
   611→          : path.resolve(process.cwd(), file);
   612→
   613→        // Check file exists
   614→        try {
   615→          await fs.access(filePath);
   616→        } catch {
   617→          error(`File not found: ${filePath}`);
   618→          process.exit(EXIT_CODES.NOT_FOUND);
   619→        }
   620→
   621→        // Read file content
   622→        const content = await fs.readFile(filePath, "utf-8");
   623→
   624→        // AC: @skill-import ac-1, ac-6 - Parse YAML frontmatter
   625→        const frontmatter = parseFrontmatter(content);
   626→
   627→        // Determine name and description from frontmatter or options
   628→        const skillName = options.name || frontmatter?.name;
   629→        const skillDescription = options.description || frontmatter?.description;
   630→
   631→        // AC: @skill-import ac-6 - Error if no name/description and no frontmatter
   632→        if (!skillName) {
   633→          error("Name is required. Either add YAML frontmatter with 'name' field or use --name option.");
   634→          console.log(chalk.gray("Example frontmatter:\n---\nname: my-skill\ndescription: My skill description\n---"));
   635→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   636→        }
   637→
   638→        if (!skillDescription) {
   639→          error("Description is required. Either add YAML frontmatter with 'description' field or use --description option.");
   640→          console.log(chalk.gray("Example frontmatter:\n---\nname: my-skill\ndescription: My skill description\n---"));
   641→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   642→        }
   643→
   644→        // AC: @skill-import ac-5 - Derive ID from directory name or use custom
   645→        const sourceDir = path.dirname(filePath);
   646→        const derivedId = path.basename(sourceDir);
   647→        const skillId = options.id || derivedId;
   648→
   649→        // Validate origin
   650→        const validOrigins: SkillOrigin[] = ["core", "project", "local"];
   651→        if (!validOrigins.includes(options.origin as SkillOrigin)) {
   652→          error(
   653→            `Invalid origin: ${options.origin}. Valid origins: ${validOrigins.join(", ")}`,
   654→          );
   655→          process.exit(EXIT_CODES.ERROR);
   656→        }
   657→
   658→        // Check if skill with this ID already exists
   659→        const metaCtx = await loadMetaContext(ctx);
   660→        const existingSkill = metaCtx.skills.find((s) => s.id === skillId);
   661→        if (existingSkill) {
   662→          error(`Skill with ID '${skillId}' already exists. Use --id to specify a different ID.`);
   663→          process.exit(EXIT_CODES.CONFLICT);
   664→        }
   665→
   666→        // Build skill object
   667→        const skillData: Skill = {
   668→          _ulid: ulid(),
   669→          id: skillId,
   670→          name: skillName,
   671→          description: skillDescription,
   672→          origin: options.origin as SkillOrigin,
   673→          version: options.skillVersion,
   674→          platforms: ["claude-code"],
   675→          depends_on: [],
   676→          allowed_tools: [],
   677→          tags: [],
   678→        };
   679→
   680→        // Validate with schema
   681→        const parsed = SkillSchema.safeParse(skillData);
   682→        if (!parsed.success) {
   683→          const issues = parsed.error.issues
   684→            .map((i) => `${i.path.join(".")}: ${i.message}`)
   685→            .join("; ");
   686→          error(`Invalid skill data: ${issues}`);
   687→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   688→        }
   689→
   690→        const skill: LoadedSkill = { ...parsed.data };
   691→
   692→        // Save meta entry (also creates directory)
   693→        await saveMetaItem(ctx, skill, "skill");
   694→
   695→        // AC: @skill-import ac-7 - Strip/normalize base-directory paths
   696→        const normalizedContent = normalizeBaseDirectory(content);
   697→
   698→        // AC: @skill-import ac-2 - Copy content to .kspec/skills/<id>/SKILL.md
   699→        const skillMdPath = getSkillContentPath(ctx, skill.id);
   700→        await fs.writeFile(skillMdPath, normalizedContent, "utf-8");
   701→
   702→        // AC: @skill-import ac-3 - Copy docs/ subdirectory if present
   703→        const sourceDocsDir = path.join(sourceDir, "docs");
   704→        try {
   705→          const docsStats = await fs.stat(sourceDocsDir);
   706→          if (docsStats.isDirectory()) {
   707→            const targetDocsDir = path.join(ctx.specDir, "skills", skill.id, "docs");
   708→            await fs.mkdir(targetDocsDir, { recursive: true });
   709→            await copyDirectory(sourceDocsDir, targetDocsDir);
   710→          }
   711→        } catch {
   712→          // No docs directory, that's fine
   713→        }
   714→
   715→        // Commit changes
   716→        await commitIfShadow(ctx.shadow, "skill-import", skill.id, skill.name);
   717→
   718→        output(skill, () =>
   719→          success(`Imported skill: ${skill.id}`, { skill }),
   720→        );
   721→      } catch (err) {
   722→        error("Failed to import skill", err);
   723→        process.exit(EXIT_CODES.ERROR);
   724→      }
   725→    });
   726→
   727→  // AC: @skill-rendering ac-1 through ac-5 - kspec skill render
   728→  // AC: @skill-render-cli ac-1, ac-2 - kspec skill render / kspec skill render @skill-id
   729→  // AC: @skill-drift-detection ac-3, ac-4 - drift handling with --force
   730→  // AC: @trait-dry-run - supports --dry-run
   731→  // AC: @trait-error-guidance - provides error guidance
   732→  skill
   733→    .command("render [ref]")
   734→    .description(
   735→      "Render skills from shadow branch to platform-specific files on main branch"
   736→    )
   737→    .option("--clean", "Remove orphaned managed skill directories")
   738→    .option("--dry-run", "Show what would be changed without applying")
   739→    .option("--force", "Overwrite drifted skill files (manually edited)")
   740→    .option("--skill <id>", "Render only a specific skill (deprecated, use positional arg)")
   741→    .action(async (ref: string | undefined, options) => {
   742→      try {
   743→        const ctx = await initContext();
   744→
   745→        if (!ctx.manifestPath) {
   746→          error(errors.project.noKspecProject);
   747→          console.log(
   748→            chalk.gray("Try: kspec init to initialize a kspec project")
   749→          );
   750→          process.exit(EXIT_CODES.ERROR);
   751→        }
   752→
   753→        const metaCtx = await loadMetaContext(ctx);
   754→        // Use rootDir (project root), not specDir (which is .kspec/ in shadow mode)
   755→        const projectRoot = ctx.rootDir;
   756→        const dryRun = options.dryRun || false;
   757→        const force = options.force || false;
   758→        const results: SkillRenderResult[] = [];
   759→        const cleanResults: CleanResult[] = [];
   760→
   761→        // Filter skills by platform (only claude-code for now)
   762→        let skillsToRender = metaCtx.skills.filter((s) =>
   763→          s.platforms.includes("claude-code")
   764→        );
   765→
   766→        // AC: @skill-render-cli ac-2 - Filter to specific skill if requested
   767→        // Support both positional ref argument and --skill option
   768→        const skillRef = ref || options.skill;
   769→        if (skillRef) {
   770→          // Resolve the ref to a skill
   771→          const item = findMetaItemByRef(metaCtx, skillRef);
   772→          if (!item || !("origin" in item)) {
   773→            error(`Skill not found: ${skillRef}`);
   774→            console.log(chalk.gray("Try: kspec skill list"));
   775→            process.exit(EXIT_CODES.NOT_FOUND);
   776→          }
   777→          const skill = item as LoadedSkill;
   778→          skillsToRender = skillsToRender.filter((s) => s.id === skill.id);
   779→          if (skillsToRender.length === 0) {
   780→            error(`Skill '${skill.id}' does not have claude-code platform`);
   781→            process.exit(EXIT_CODES.ERROR);
   782→          }
   783→        }
   784→
   785→        // Ensure .claude/skills directory exists
   786→        const targetSkillsDir = path.join(projectRoot, ".claude", "skills");
   787→        if (!dryRun) {
   788→          await fs.mkdir(targetSkillsDir, { recursive: true });
   789→        }
   790→
   791→        // Render each skill
   792→        // AC: @skill-drift-detection ac-3, ac-4 - Check drift and skip without --force
   793→        // AC: @consolidate-skill-render ac-1 - delegates to renderClaudeCodeSkill from skill-render.ts
   794→        for (const skill of skillsToRender) {
   795→          // Check for drift before rendering
   796→          const driftStatus = await checkSkillDrift(ctx.specDir, projectRoot, skill.id);
   797→
   798→          // AC: @skill-drift-detection ac-3 - Skip drifted skills without --force
   799→          if (driftStatus === "drifted" && !force) {
   800→            const renderedPath = path.join(
   801→              projectRoot,
   802→              ".claude",
   803→              "skills",
   804→              skill.id,
   805→              "SKILL.md"
   806→            );
   807→            results.push({
   808→              id: skill.id,
   809→              action: "skipped",
   810→              path: renderedPath,
   811→              skipReason: "drifted (use --force to overwrite)",
   812→            });
   813→            continue;
   814→          }
   815→
   816→          // AC: @skill-drift-detection ac-4 - Render (overwrite) when --force is used
   817→          // AC: @consolidate-skill-render ac-1 - use renderClaudeCodeSkill with storeHash
   818→          const result = await renderClaudeCodeSkill(ctx, projectRoot, skill, {
   819→            dryRun,
   820→            storeHash: true,
   821→          });
   822→          results.push(result);
   823→        }
   824→
   825→        // Handle --clean: remove orphaned managed skills
   826→        // AC: @skill-rendering ac-4, ac-5
   827→        if (options.clean) {
   828→          const activeSkillIds = new Set(metaCtx.skills.map((s) => s.id));
   829→
   830→          try {
   831→            const entries = await fs.readdir(targetSkillsDir, {
   832→              withFileTypes: true,
   833→            });
   834→
   835→            for (const entry of entries) {
   836→              if (!entry.isDirectory()) continue;
   837→
   838→              const skillId = entry.name;
   839→              const skillDir = path.join(targetSkillsDir, skillId);
   840→              const skillMdPath = path.join(skillDir, "SKILL.md");
   841→
   842→              // Skip if skill still exists in meta
   843→              if (activeSkillIds.has(skillId)) continue;
   844→
   845→              // AC: @skill-rendering ac-4 - Only consider kspec-managed skills
   846→              const isManaged = await isKspecManaged(skillMdPath);
   847→
   848→              if (isManaged) {
   849→                // AC: @skill-rendering ac-5 - Remove orphaned directory
   850→                if (!dryRun) {
   851→                  await fs.rm(skillDir, { recursive: true, force: true });
   852→                }
   853→                cleanResults.push({
   854→                  id: skillId,
   855→                  path: skillDir,
   856→                  action: "removed",
   857→                });
   858→              } else {
   859→                cleanResults.push({
   860→                  id: skillId,
   861→                  path: skillDir,
   862→                  action: "skipped",
   863→                  reason: "Not managed by kspec",
   864→                });
   865→              }
   866→            }
   867→          } catch {
   868→            // No .claude/skills directory, nothing to clean
   869→          }
   870→        }
   871→
   872→        // Output results
   873→        // AC: @trait-dry-run ac-6 - JSON output includes dry_run field
   874→        output(
   875→          {
   876→            dry_run: dryRun,
   877→            rendered: results,
   878→            cleaned: cleanResults,
   879→          },
   880→          () => {
   881→            // AC: @trait-dry-run ac-3 - Clear indication this is a preview
   882→            if (dryRun) {
   883→              console.log(chalk.yellow("DRY RUN - No changes made"));
   884→              console.log();
   885→            }
   886→
   887→            // Render results
   888→            const created = results.filter((r) => r.action === "created");
   889→            const updated = results.filter((r) => r.action === "updated");
   890→            const unchanged = results.filter((r) => r.action === "unchanged");
   891→            // AC: @skill-drift-detection ac-3 - Track skipped drifted skills
   892→            const skippedDrifted = results.filter((r) => r.action === "skipped");
   893→
   894→            if (created.length > 0) {
   895→              console.log(chalk.green(`Created: ${created.length} skill(s)`));
   896→              for (const r of created) {
   897→                console.log(`  ${chalk.green("+")} ${r.id}`);
   898→              }
   899→            }
   900→
   901→            if (updated.length > 0) {
   902→              console.log(chalk.blue(`Updated: ${updated.length} skill(s)`));
   903→              for (const r of updated) {
   904→                console.log(`  ${chalk.blue("~")} ${r.id}`);
   905→              }
   906→            }
   907→
   908→            if (unchanged.length > 0 && results.length <= 10) {
   909→              console.log(chalk.gray(`Unchanged: ${unchanged.length} skill(s)`));
   910→            }
   911→
   912→            // AC: @skill-drift-detection ac-3 - Show warning for skipped drifted skills
   913→            if (skippedDrifted.length > 0) {
   914→              console.log();
   915→              console.log(chalk.yellow(`Skipped: ${skippedDrifted.length} drifted skill(s)`));
   916→              for (const r of skippedDrifted) {
   917→                console.log(`  ${chalk.yellow("!")} ${r.id}: ${r.skipReason || "drifted"}`);
   918→              }
   919→              console.log();
   920→              console.log(chalk.yellow("Use --force to overwrite drifted skills"));
   921→            }
   922→
   923→            // Clean results
   924→            if (cleanResults.length > 0) {
   925→              const removed = cleanResults.filter((r) => r.action === "removed");
   926→              const skipped = cleanResults.filter((r) => r.action === "skipped");
   927→
   928→              if (removed.length > 0) {
   929→                console.log();
   930→                console.log(chalk.red(`Removed: ${removed.length} orphaned skill(s)`));
   931→                for (const r of removed) {
   932→                  console.log(`  ${chalk.red("-")} ${r.id}`);
   933→                }
   934→              }
   935→
   936→              if (skipped.length > 0) {
   937→                console.log(
   938→                  chalk.gray(`Skipped: ${skipped.length} unmanaged skill(s)`)
   939→                );
   940→              }
   941→            }
   942→
   943→            // Summary
   944→            console.log();
   945→            if (dryRun) {
   946→              console.log(
   947→                chalk.yellow("No changes were made. Run without --dry-run to apply.")
   948→              );
   949→            } else {
   950→              const changedCount = created.length + updated.length;
   951→              const cleanedCount = cleanResults.filter(
   952→                (r) => r.action === "removed"
   953→              ).length;
   954→              if (changedCount > 0 || cleanedCount > 0) {
   955→                success(
   956→                  `Rendered ${changedCount} skill(s)${cleanedCount > 0 ? `, cleaned ${cleanedCount}` : ""}`
   957→                );
   958→              } else {
   959→                console.log(chalk.gray("No changes needed"));
   960→              }
   961→            }
   962→          }
   963→        );
   964→      } catch (err) {
   965→        error("Failed to render skills", err);
   966→        process.exit(EXIT_CODES.ERROR);
   967→      }
   968→    });
   969→
   970→  // AC: @skill-render-cli ac-3 - kspec skill status
   971→  skill
   972→    .command("status")
   973→    .description("Show sync status of rendered skills")
   974→    .action(async () => {
   975→      try {
   976→        const ctx = await initContext();
   977→
   978→        if (!ctx.manifestPath) {
   979→          error(errors.project.noKspecProject);
   980→          console.log(
   981→            chalk.gray("Try: kspec init to initialize a kspec project")
   982→          );
   983→          process.exit(EXIT_CODES.ERROR);
   984→        }
   985→
   986→        const metaCtx = await loadMetaContext(ctx);
   987→        const projectRoot = ctx.rootDir;
   988→
   989→        // Filter skills by platform (only claude-code for now)
   990→        const skillsToCheck = metaCtx.skills.filter((s) =>
   991→          s.platforms.includes("claude-code")
   992→        );
   993→
   994→        if (skillsToCheck.length === 0) {
   995→          console.log(chalk.yellow("No skills found"));
   996→          return;
   997→        }
   998→
   999→        const statusResults: SkillStatusResult[] = [];
  1000→
  1001→        for (const skill of skillsToCheck) {
  1002→          const status = await getSkillSyncStatus(ctx, projectRoot, skill);
  1003→          statusResults.push(status);
  1004→        }
  1005→
  1006→        // Output results
  1007→        output(
  1008→          statusResults,
  1009→          () => {
  1010→            const table = new Table({
  1011→              head: [
  1012→                chalk.bold("ID"),
  1013→                chalk.bold("Status"),
  1014→                chalk.bold("Docs"),
  1015→              ],
  1016→              style: {
  1017→                head: [],
  1018→                border: [],
  1019→              },
  1020→            });
  1021→
  1022→            for (const result of statusResults) {
  1023→              const statusColor =
  1024→                result.status === "in-sync"
  1025→                  ? chalk.green
  1026→                  : result.status === "drifted"
  1027→                    ? chalk.yellow
  1028→                    : chalk.gray;
  1029→
  1030→              const docsStatusColor =
  1031→                result.docsStatus === "in-sync"
  1032→                  ? chalk.green
  1033→                  : result.docsStatus === "drifted"
  1034→                    ? chalk.yellow
  1035→                    : chalk.gray;
  1036→
  1037→              table.push([
  1038→                result.id,
  1039→                statusColor(result.status),
  1040→                docsStatusColor(result.docsStatus || "-"),
  1041→              ]);
  1042→            }
  1043→
  1044→            console.log(table.toString());
  1045→
  1046→            // Summary
  1047→            const inSync = statusResults.filter((r) => r.status === "in-sync").length;
  1048→            const drifted = statusResults.filter((r) => r.status === "drifted").length;
  1049→            const notRendered = statusResults.filter((r) => r.status === "not-rendered").length;
  1050→
  1051→            console.log();
  1052→            if (drifted > 0) {
  1053→              console.log(chalk.yellow(`${drifted} skill(s) drifted - run 'kspec skill render' to sync`));
  1054→            }
  1055→            if (notRendered > 0) {
  1056→              console.log(chalk.gray(`${notRendered} skill(s) not rendered`));
  1057→            }
  1058→            if (inSync === statusResults.length) {
  1059→              console.log(chalk.green("All skills in sync"));
  1060→            }
  1061→          }
  1062→        );
  1063→      } catch (err) {
  1064→        error("Failed to check skill status", err);
  1065→        process.exit(EXIT_CODES.ERROR);
  1066→      }
  1067→    });
  1068→
  1069→  // AC: @skill-render-cli ac-4 - kspec skill diff
  1070→  skill
  1071→    .command("diff <ref>")
  1072→    .description("Show diff between source and rendered skill")
  1073→    .action(async (ref: string) => {
  1074→      try {
  1075→        const ctx = await initContext();
  1076→
  1077→        if (!ctx.manifestPath) {
  1078→          error(errors.project.noKspecProject);
  1079→          console.log(
  1080→            chalk.gray("Try: kspec init to initialize a kspec project")
  1081→          );
  1082→          process.exit(EXIT_CODES.ERROR);
  1083→        }
  1084→
  1085→        const metaCtx = await loadMetaContext(ctx);
  1086→        const item = findMetaItemByRef(metaCtx, ref);
  1087→
  1088→        if (!item) {
  1089→          error(`Skill not found: ${ref}`);
  1090→          console.log(chalk.gray("Try: kspec skill list"));
  1091→          process.exit(EXIT_CODES.NOT_FOUND);
  1092→        }
  1093→
  1094→        // Check it's a skill
  1095→        if (!("origin" in item)) {
  1096→          error(`Item ${ref} is not a skill`);
  1097→          process.exit(EXIT_CODES.ERROR);
  1098→        }
  1099→
  1100→        const skill = item as LoadedSkill;
  1101→        const projectRoot = ctx.rootDir;
  1102→
  1103→        // Get expected rendered content
  1104→        const expectedContent = await getExpectedRenderedContent(ctx, skill);
  1105→
  1106→        // Get actual rendered content
  1107→        const renderedPath = path.join(
  1108→          projectRoot,
  1109→          ".claude",
  1110→          "skills",
  1111→          skill.id,
  1112→          "SKILL.md"
  1113→        );
  1114→
  1115→        let actualContent = "";
  1116→        try {
  1117→          actualContent = await fs.readFile(renderedPath, "utf-8");
  1118→        } catch {
  1119→          // File doesn't exist
  1120→        }
  1121→
  1122→        // Generate diff
  1123→        const diff = generateUnifiedDiff(
  1124→          actualContent,
  1125→          expectedContent,
  1126→          `a/${skill.id}/SKILL.md`,
  1127→          `b/${skill.id}/SKILL.md`
  1128→        );
  1129→
  1130→        // Output
  1131→        output(
  1132→          {
  1133→            id: skill.id,
  1134→            hasDiff: diff.length > 0,
  1135→            diff,
  1136→          },
  1137→          () => {
  1138→            if (diff.length === 0) {
  1139→              console.log(chalk.green(`${skill.id}: in sync`));
  1140→            } else {
  1141→              console.log(chalk.yellow(`${skill.id}: drifted`));
  1142→              console.log();
  1143→              // Print colored diff
  1144→              for (const line of diff) {
  1145→                if (line.startsWith("+") && !line.startsWith("+++")) {
  1146→                  console.log(chalk.green(line));
  1147→                } else if (line.startsWith("-") && !line.startsWith("---")) {
  1148→                  console.log(chalk.red(line));
  1149→                } else if (line.startsWith("@@")) {
  1150→                  console.log(chalk.cyan(line));
  1151→                } else {
  1152→                  console.log(line);
  1153→                }
  1154→              }
  1155→            }
  1156→          }
  1157→        );
  1158→      } catch (err) {
  1159→        error("Failed to generate diff", err);
  1160→        process.exit(EXIT_CODES.ERROR);
  1161→      }
  1162→    });
  1163→
  1164→  // AC: @core-skill-install - kspec skill install-core
  1165→  markMutating(skill.command("install-core"))
  1166→    .description(
  1167→      "Install core skills from kspec package templates"
  1168→    )
  1169→    .option("--force", "Overwrite custom forks with core versions")
  1170→    .option("--dry-run", "Show what would be installed without making changes")
  1171→    .action(async (options) => {
  1172→      try {
  1173→        const ctx = await initContext();
  1174→
  1175→        if (!ctx.manifestPath) {
  1176→          error(errors.project.noKspecProject);
  1177→          console.log(
  1178→            chalk.gray("Try: kspec init to initialize a kspec project")
  1179→          );
  1180→          process.exit(EXIT_CODES.ERROR);
  1181→        }
  1182→
  1183→        const metaCtx = await loadMetaContext(ctx);
  1184→        const dryRun = options.dryRun || false;
  1185→        const force = options.force || false;
  1186→        const results: CoreSkillInstallResult[] = [];
  1187→
  1188→        // Load core skills manifest
  1189→        const coreSkills = loadCoreSkillsManifest();
  1190→        if (coreSkills.length === 0) {
  1191→          console.log(chalk.yellow("No core skills found in kspec package templates"));
  1192→          return;
  1193→        }
  1194→
  1195→        // Get kspec package version
  1196→        const kspecVersion = getKspecPackageVersion();
  1197→
  1198→        // Process each core skill
  1199→        for (const coreSkill of coreSkills) {
  1200→          // AC: @core-skill-install ac-3 - Check if skill exists with custom origin
  1201→          const existingSkill = metaCtx.skills.find((s) => s.id === coreSkill.id);
  1202→
  1203→          if (existingSkill) {
  1204→            // Check origin - if "custom" or "project" and not forcing, skip
  1205→            if (existingSkill.origin !== "core" && !force) {
  1206→              results.push({
  1207→                id: coreSkill.id,
  1208→                action: "skipped",
  1209→                reason: `existing ${existingSkill.origin} skill (use --force to overwrite)`,
  1210→              });
  1211→              continue;
  1212→            }
  1213→          }
  1214→
  1215→          // AC: @core-skill-install ac-1 - Create/update meta entry with origin core
  1216→          // AC: @core-skill-install ac-5 - Version matches kspec package version
  1217→          const skillData: Skill = {
  1218→            _ulid: existingSkill?._ulid || ulid(),
  1219→            id: coreSkill.id,
  1220→            name: coreSkill.name,
  1221→            description: coreSkill.description,
  1222→            origin: "core",
  1223→            version: kspecVersion,
  1224→            platforms: coreSkill.platforms || ["claude-code"],
  1225→            depends_on: [],
  1226→            allowed_tools: [],
  1227→            tags: ["core"],
  1228→          };
  1229→
  1230→          // Validate with schema
  1231→          const parsed = SkillSchema.safeParse(skillData);
  1232→          if (!parsed.success) {
  1233→            const issues = parsed.error.issues
  1234→              .map((i) => `${i.path.join(".")}: ${i.message}`)
  1235→              .join("; ");
  1236→            results.push({
  1237→              id: coreSkill.id,
  1238→              action: "failed",
  1239→              reason: `validation error: ${issues}`,
  1240→            });
  1241→            continue;
  1242→          }
  1243→
  1244→          const skill: LoadedSkill = { ...parsed.data };
  1245→
  1246→          // Save meta entry (if not dry run)
  1247→          if (!dryRun) {
  1248→            await saveMetaItem(ctx, skill, "skill");
  1249→
  1250→            // AC: @core-skill-install ac-2 - Copy SKILL.md content
  1251→            const sourceContent = loadCoreSkillContent(coreSkill.id);
  1252→            if (sourceContent) {
  1253→              const targetPath = getSkillContentPath(ctx, skill.id);
  1254→              await fs.writeFile(targetPath, sourceContent, "utf-8");
  1255→            }
  1256→          }
  1257→
  1258→          results.push({
  1259→            id: coreSkill.id,
  1260→            action: existingSkill ? "updated" : "created",
  1261→            version: kspecVersion,
  1262→          });
  1263→        }
  1264→
  1265→        // Commit changes if not dry run
  1266→        if (!dryRun && results.some((r) => r.action === "created" || r.action === "updated")) {
  1267→          await commitIfShadow(
  1268→            ctx.shadow,
  1269→            "skill-install-core",
  1270→            `${results.filter((r) => r.action !== "skipped" && r.action !== "failed").length} core skills`
  1271→          );
  1272→        }
  1273→
  1274→        // Output results
  1275→        output(
  1276→          {
  1277→            dry_run: dryRun,
  1278→            results,
  1279→          },
  1280→          () => {
  1281→            if (dryRun) {
  1282→              console.log(chalk.yellow("DRY RUN - No changes made"));
  1283→              console.log();
  1284→            }
  1285→
  1286→            const created = results.filter((r) => r.action === "created");
  1287→            const updated = results.filter((r) => r.action === "updated");
  1288→            const skipped = results.filter((r) => r.action === "skipped");
  1289→            const failed = results.filter((r) => r.action === "failed");
  1290→
  1291→            if (created.length > 0) {
  1292→              console.log(chalk.green(`Created: ${created.length} skill(s)`));
  1293→              for (const r of created) {
  1294→                console.log(`  ${chalk.green("+")} ${r.id} (v${r.version})`);
  1295→              }
  1296→            }
  1297→
  1298→            if (updated.length > 0) {
  1299→              console.log(chalk.blue(`Updated: ${updated.length} skill(s)`));
  1300→              for (const r of updated) {
  1301→                console.log(`  ${chalk.blue("~")} ${r.id} (v${r.version})`);
  1302→              }
  1303→            }
  1304→
  1305→            if (skipped.length > 0) {
  1306→              console.log(chalk.yellow(`Skipped: ${skipped.length} skill(s)`));
  1307→              for (const r of skipped) {
  1308→                console.log(`  ${chalk.yellow("!")} ${r.id}: ${r.reason}`);
  1309→              }
  1310→            }
  1311→
  1312→            if (failed.length > 0) {
  1313→              console.log(chalk.red(`Failed: ${failed.length} skill(s)`));
  1314→              for (const r of failed) {
  1315→                console.log(`  ${chalk.red("x")} ${r.id}: ${r.reason}`);
  1316→              }
  1317→            }
  1318→
  1319→            console.log();
  1320→            if (dryRun) {
  1321→              console.log(
  1322→                chalk.yellow("No changes were made. Run without --dry-run to apply.")
  1323→              );
  1324→            } else {
  1325→              const changedCount = created.length + updated.length;
  1326→              if (changedCount > 0) {
  1327→                success(`Installed ${changedCount} core skill(s)`);
  1328→              } else if (skipped.length > 0) {
  1329→                console.log(chalk.gray("No skills installed (all skipped or failed)"));
  1330→              }
  1331→            }
  1332→          }
  1333→        );
  1334→      } catch (err) {
  1335→        error("Failed to install core skills", err);
  1336→        process.exit(EXIT_CODES.ERROR);
  1337→      }
  1338→    });
  1339→
  1340→  // AC: @core-skill-update - kspec skill update
  1341→  markMutating(skill.command("update"))
  1342→    .description(
  1343→      "Update core skills to match the installed kspec package version"
  1344→    )
  1345→    .option("--dry-run", "Show what would be updated without making changes")
  1346→    .action(async (options) => {
  1347→      try {
  1348→        const ctx = await initContext();
  1349→
  1350→        if (!ctx.manifestPath) {
  1351→          error(errors.project.noKspecProject);
  1352→          console.log(
  1353→            chalk.gray("Try: kspec init to initialize a kspec project")
  1354→          );
  1355→          process.exit(EXIT_CODES.ERROR);
  1356→        }
  1357→
  1358→        const metaCtx = await loadMetaContext(ctx);
  1359→        const dryRun = options.dryRun || false;
  1360→        const results: CoreSkillUpdateResult[] = [];
  1361→
  1362→        // Get kspec package version
  1363→        const kspecVersion = getKspecPackageVersion();
  1364→
  1365→        // Load core skills manifest to get current content
  1366→        const coreSkillsManifest = loadCoreSkillsManifest();
  1367→        const coreSkillsMap = new Map(
  1368→          coreSkillsManifest.map((s) => [s.id, s])
  1369→        );
  1370→
  1371→        // AC: @core-skill-update ac-3 - Only process skills with origin core
  1372→        const coreSkills = metaCtx.skills.filter((s) => s.origin === "core");
  1373→
  1374→        for (const skill of coreSkills) {
  1375→          // AC: @core-skill-update ac-2 - Skip if already at current version
  1376→          if (skill.version === kspecVersion) {
  1377→            results.push({
  1378→              id: skill.id,
  1379→              action: "skipped",
  1380→              reason: "already at current version",
  1381→              currentVersion: skill.version,
  1382→            });
  1383→            continue;
  1384→          }
  1385→
  1386→          // Check if skill exists in core manifest
  1387→          const coreSkill = coreSkillsMap.get(skill.id);
  1388→          if (!coreSkill) {
  1389→            results.push({
  1390→              id: skill.id,
  1391→              action: "skipped",
  1392→              reason: "not found in core skills manifest",
  1393→              currentVersion: skill.version,
  1394→            });
  1395→            continue;
  1396→          }
  1397→
  1398→          // AC: @core-skill-update ac-1 - Update content and version
  1399→          const oldVersion = skill.version;
  1400→
  1401→          if (!dryRun) {
  1402→            // Update skill metadata with new version
  1403→            skill.version = kspecVersion;
  1404→            skill.name = coreSkill.name;
  1405→            if (coreSkill.description) {
  1406→              skill.description = coreSkill.description;
  1407→            }
  1408→            if (coreSkill.platforms) {
  1409→              skill.platforms = coreSkill.platforms;
  1410→            }
  1411→
  1412→            // Save updated metadata
  1413→            await saveMetaItem(ctx, skill, "skill");
  1414→
  1415→            // Update SKILL.md content from templates
  1416→            const sourceContent = loadCoreSkillContent(skill.id);
  1417→            if (sourceContent) {
  1418→              const targetPath = getSkillContentPath(ctx, skill.id);
  1419→              await fs.writeFile(targetPath, sourceContent, "utf-8");
  1420→            }
  1421→          }
  1422→
  1423→          results.push({
  1424→            id: skill.id,
  1425→            action: "updated",
  1426→            previousVersion: oldVersion,
  1427→            newVersion: kspecVersion,
  1428→          });
  1429→        }
  1430→
  1431→        // Commit changes if not dry run and there are updates
  1432→        if (!dryRun && results.some((r) => r.action === "updated")) {
  1433→          await commitIfShadow(
  1434→            ctx.shadow,
  1435→            "skill-update",
  1436→            `${results.filter((r) => r.action === "updated").length} core skills`
  1437→          );
  1438→        }
  1439→
  1440→        // Output results
  1441→        output(
  1442→          {
  1443→            dry_run: dryRun,
  1444→            kspec_version: kspecVersion,
  1445→            results,
  1446→          },
  1447→          () => {
  1448→            if (dryRun) {
  1449→              console.log(chalk.yellow("DRY RUN - No changes made"));
  1450→              console.log();
  1451→            }
  1452→
  1453→            console.log(`kspec version: ${kspecVersion}`);
  1454→            console.log();
  1455→
  1456→            const updated = results.filter((r) => r.action === "updated");
  1457→            const skipped = results.filter((r) => r.action === "skipped");
  1458→
  1459→            if (updated.length > 0) {
  1460→              console.log(chalk.green(`Updated: ${updated.length} skill(s)`));
  1461→              for (const r of updated) {
  1462→                console.log(
  1463→                  `  ${chalk.green("~")} ${r.id}: ${r.previousVersion || "unknown"} → ${r.newVersion}`
  1464→                );
  1465→              }
  1466→            }
  1467→
  1468→            if (skipped.length > 0) {
  1469→              console.log(chalk.gray(`Skipped: ${skipped.length} skill(s)`));
  1470→              for (const r of skipped) {
  1471→                console.log(
  1472→                  `  ${chalk.gray("-")} ${r.id}: ${r.reason}${r.currentVersion ? ` (v${r.currentVersion})` : ""}`
  1473→                );
  1474→              }
  1475→            }
  1476→
  1477→            console.log();
  1478→            if (dryRun) {
  1479→              console.log(
  1480→                chalk.yellow("No changes were made. Run without --dry-run to apply.")
  1481→              );
  1482→            } else if (updated.length > 0) {
  1483→              success(`Updated ${updated.length} core skill(s)`);
  1484→            } else {
  1485→              console.log(chalk.gray("No skills needed updating"));
  1486→            }
  1487→          }
  1488→        );
  1489→      } catch (err) {
  1490→        error("Failed to update core skills", err);
  1491→        process.exit(EXIT_CODES.ERROR);
  1492→      }
  1493→    });
  1494→}
  1495→
  1496→/**
  1497→ * Result of updating a single core skill
  1498→ * AC: @core-skill-update
  1499→ */
  1500→interface CoreSkillUpdateResult {
  1501→  id: string;
  1502→  action: "updated" | "skipped";
  1503→  previousVersion?: string;
  1504→  newVersion?: string;
  1505→  currentVersion?: string;
  1506→  reason?: string;
  1507→}
  1508→
  1509→/**
  1510→ * Result of installing a single core skill
  1511→ */
  1512→interface CoreSkillInstallResult {
  1513→  id: string;
  1514→  action: "created" | "updated" | "skipped" | "failed";
  1515→  version?: string;
  1516→  reason?: string;
  1517→}
  1518→
  1519→/**
  1520→ * Core skill definition from manifest
  1521→ */
  1522→interface CoreSkillDefinition {
  1523→  id: string;
  1524→  name: string;
  1525→  description?: string;
  1526→  platforms?: string[];
  1527→}
  1528→
  1529→/**
  1530→ * Get the kspec package version from package.json
  1531→ * AC: @core-skill-install ac-5
  1532→ */
  1533→function getKspecPackageVersion(): string {
  1534→  try {
  1535→    // Try to find package.json relative to this module
  1536→    const packagePath = path.resolve(
  1537→      import.meta.dirname || path.dirname(new URL(import.meta.url).pathname),
  1538→      "../../../package.json"
  1539→    );
  1540→    const packageJson = JSON.parse(readFileSync(packagePath, "utf-8"));
  1541→    return packageJson.version || "unknown";
  1542→  } catch {
  1543→    return "unknown";
  1544→  }
  1545→}
  1546→
  1547→/**
  1548→ * Get the templates directory path
  1549→ */
  1550→function getTemplatesDir(): string {
  1551→  // Templates are at <package-root>/templates/skills/
  1552→  return path.resolve(
  1553→    import.meta.dirname || path.dirname(new URL(import.meta.url).pathname),
  1554→    "../../../templates/skills"
  1555→  );
  1556→}
  1557→
  1558→/**
  1559→ * Load core skills manifest from templates/skills/manifest.yaml
  1560→ * AC: @core-skill-install ac-1, ac-2
  1561→ */
  1562→function loadCoreSkillsManifest(): CoreSkillDefinition[] {
  1563→  try {
  1564→    const templatesDir = getTemplatesDir();
  1565→    const manifestPath = path.join(templatesDir, "manifest.yaml");
  1566→    const content = readFileSync(manifestPath, "utf-8");
  1567→    const parsed = yaml.parse(content);
  1568→
  1569→    if (!parsed || !Array.isArray(parsed.skills)) {
  1570→      return [];
  1571→    }
  1572→
  1573→    return parsed.skills.map((s: Record<string, unknown>) => ({
  1574→      id: String(s.id || ""),
  1575→      name: String(s.name || s.id || ""),
  1576→      description: s.description ? String(s.description) : undefined,
  1577→      platforms: Array.isArray(s.platforms) ? s.platforms.map(String) : undefined,
  1578→    })).filter((s: CoreSkillDefinition) => s.id);
  1579→  } catch {
  1580→    return [];
  1581→  }
  1582→}
  1583→
  1584→/**
  1585→ * Load SKILL.md content for a core skill from templates
  1586→ * AC: @core-skill-install ac-2
  1587→ */
  1588→function loadCoreSkillContent(skillId: string): string | null {
  1589→  try {
  1590→    const templatesDir = getTemplatesDir();
  1591→    const skillMdPath = path.join(templatesDir, skillId, "SKILL.md");
  1592→    return readFileSync(skillMdPath, "utf-8");
  1593→  } catch {
  1594→    return null;
  1595→  }
  1596→}
  1597→
  1598→/**
  1599→ * Parse YAML frontmatter from markdown content.
  1600→ * Returns null if no valid frontmatter found.
  1601→ */
  1602→function parseFrontmatter(content: string): { name?: string; description?: string } | null {
  1603→  const frontmatterRegex = /^---\n([\s\S]*?)\n---/;
  1604→  const match = content.match(frontmatterRegex);
  1605→
  1606→  if (!match) {
  1607→    return null;
  1608→  }
  1609→
  1610→  try {
  1611→    const parsed = yaml.parse(match[1]);
  1612→
  1613→    if (typeof parsed === "object" && parsed !== null) {
  1614→      return {
  1615→        name: typeof parsed.name === "string" ? parsed.name : undefined,
  1616→        description: typeof parsed.description === "string" ? parsed.description : undefined,
  1617→      };
  1618→    }
  1619→  } catch {
  1620→    // Invalid YAML in frontmatter
  1621→  }
  1622→
  1623→  return null;
  1624→}
  1625→
  1626→/**
  1627→ * Normalize base-directory paths in skill content.
  1628→ * AC: @skill-import ac-7 - Strip or convert absolute paths to relative.
  1629→ *
  1630→ * Matches patterns like:
  1631→ * - "Base directory for this skill: /absolute/path/to/skill"
  1632→ * - Lines starting with hardcoded paths
  1633→ */
  1634→function normalizeBaseDirectory(content: string): string {
  1635→  // Remove or normalize "Base directory for this skill:" lines with absolute paths
  1636→  // Common pattern in Claude-generated skill files
  1637→  const baseDirLineRegex = /^Base directory for this skill:.*$/gm;
  1638→
  1639→  return content.replace(baseDirLineRegex, "");
  1640→}
  1641→
  1642→/**
  1643→ * Recursively copy a directory
  1644→ */
  1645→async function copyDirectory(src: string, dest: string): Promise<void> {
  1646→  const entries = await fs.readdir(src, { withFileTypes: true });
  1647→
  1648→  for (const entry of entries) {
  1649→    const srcPath = path.join(src, entry.name);
  1650→    const destPath = path.join(dest, entry.name);
  1651→
  1652→    if (entry.isDirectory()) {
  1653→      await fs.mkdir(destPath, { recursive: true });
  1654→      await copyDirectory(srcPath, destPath);
  1655→    } else {
  1656→      await fs.copyFile(srcPath, destPath);
  1657→    }
  1658→  }
  1659→}
  1660→
  1661→/**
  1662→ * Result of rendering a single skill
  1663→ * AC: @skill-drift-detection ac-3 - Includes "skipped" action for drifted skills
  1664→ * AC: @consolidate-skill-render ac-2 - No private renderSkill function, uses imported renderClaudeCodeSkill
  1665→ */
  1666→interface SkillRenderResult {
  1667→  id: string;
  1668→  action: "created" | "updated" | "unchanged" | "skipped";
  1669→  path: string;
  1670→  docsAction?: "created" | "updated" | "unchanged" | "skipped";
  1671→  /** Reason why skill was skipped */
  1672→  skipReason?: string;
  1673→}
  1674→
  1675→/**
  1676→ * Result of a clean operation
  1677→ */
  1678→interface CleanResult {
  1679→  id: string;
  1680→  path: string;
  1681→  action: "removed" | "skipped";
  1682→  reason?: string;
  1683→}
  1684→
  1685→/**
  1686→ * Check if two contents are equal (for idempotency check)
  1687→ */
  1688→function contentsEqual(a: string, b: string): boolean {
  1689→  return a.trim() === b.trim();
  1690→}
  1691→
  1692→/**
  1693→ * Recursively check if two directories have the same contents
  1694→ */
  1695→async function directoriesEqual(src: string, dest: string): Promise<boolean> {
  1696→  try {
  1697→    const srcEntries = await fs.readdir(src, { withFileTypes: true });
  1698→    const destEntries = await fs.readdir(dest, { withFileTypes: true });
  1699→
  1700→    // Different number of entries = not equal
  1701→    if (srcEntries.length !== destEntries.length) {
  1702→      return false;
  1703→    }
  1704→
  1705→    // Create a map of dest entries for quick lookup
  1706→    const destMap = new Map(destEntries.map((e) => [e.name, e]));
  1707→
  1708→    for (const srcEntry of srcEntries) {
  1709→      const destEntry = destMap.get(srcEntry.name);
  1710→      if (!destEntry) {
  1711→        return false;
  1712→      }
  1713→
  1714→      const srcPath = path.join(src, srcEntry.name);
  1715→      const destPath = path.join(dest, srcEntry.name);
  1716→
  1717→      if (srcEntry.isDirectory() && destEntry.isDirectory()) {
  1718→        if (!(await directoriesEqual(srcPath, destPath))) {
  1719→          return false;
  1720→        }
  1721→      } else if (srcEntry.isFile() && destEntry.isFile()) {
  1722→        const srcContent = await fs.readFile(srcPath, "utf-8");
  1723→        const destContent = await fs.readFile(destPath, "utf-8");
  1724→        if (!contentsEqual(srcContent, destContent)) {
  1725→          return false;
  1726→        }
  1727→      } else {
  1728→        // Type mismatch
  1729→        return false;
  1730→      }
  1731→    }
  1732→
  1733→    return true;
  1734→  } catch {
  1735→    return false;
  1736→  }
  1737→}
  1738→
  1739→/**
  1740→ * Result of checking a skill's sync status
  1741→ * AC: @skill-render-cli ac-3
  1742→ */
  1743→interface SkillStatusResult {
  1744→  id: string;
  1745→  status: "in-sync" | "drifted" | "not-rendered";
  1746→  docsStatus?: "in-sync" | "drifted" | "not-rendered" | "no-docs";
  1747→}
  1748→
  1749→/**
  1750→ * Get the sync status of a skill
  1751→ * AC: @skill-render-cli ac-3
  1752→ * AC: @skill-drift-detection ac-1, ac-2 - Uses hash-based drift detection
  1753→ */
  1754→async function getSkillSyncStatus(
  1755→  ctx: KspecContext,
  1756→  projectRoot: string,
  1757→  skill: LoadedSkill
  1758→): Promise<SkillStatusResult> {
  1759→  // AC: @skill-drift-detection ac-1, ac-2 - Use hash-based drift detection
  1760→  const driftStatus = await checkSkillDrift(ctx.specDir, projectRoot, skill.id);
  1761→
  1762→  // Map drift status to sync status
  1763→  let status: "in-sync" | "drifted" | "not-rendered";
  1764→  switch (driftStatus) {
  1765→    case "in-sync":
  1766→      status = "in-sync";
  1767→      break;
  1768→    case "drifted":
  1769→      status = "drifted";
  1770→      break;
  1771→    case "not-rendered":
  1772→      status = "not-rendered";
  1773→      break;
  1774→    case "no-hash":
  1775→      // No hash stored - need to check if content matches expected
  1776→      // (handles edge case where skill was rendered before hash tracking was added)
  1777→      const expectedContent = await getExpectedRenderedContent(ctx, skill);
  1778→      const renderedPath = path.join(
  1779→        projectRoot,
  1780→        ".claude",
  1781→        "skills",
  1782→        skill.id,
  1783→        "SKILL.md"
  1784→      );
  1785→      try {
  1786→        const actualContent = await fs.readFile(renderedPath, "utf-8");
  1787→        status = contentsEqual(expectedContent, actualContent) ? "in-sync" : "drifted";
  1788→      } catch {
  1789→        status = "not-rendered";
  1790→      }
  1791→      break;
  1792→  }
  1793→
  1794→  // Check docs status
  1795→  const sourceDocsDir = path.join(ctx.specDir, "skills", skill.id, "docs");
  1796→  const targetDocsDir = path.join(projectRoot, ".claude", "skills", skill.id, "docs");
  1797→  let docsStatus: "in-sync" | "drifted" | "not-rendered" | "no-docs" = "no-docs";
  1798→
  1799→  try {
  1800→    await fs.stat(sourceDocsDir);
  1801→    // Source docs exist, check target
  1802→    try {
  1803→      await fs.stat(targetDocsDir);
  1804→      // Both exist, compare
  1805→      const equal = await directoriesEqual(sourceDocsDir, targetDocsDir);
  1806→      docsStatus = equal ? "in-sync" : "drifted";
  1807→    } catch {
  1808→      docsStatus = "not-rendered";
  1809→    }
  1810→  } catch {
  1811→    // No source docs
  1812→    docsStatus = "no-docs";
  1813→  }
  1814→
  1815→  return {
  1816→    id: skill.id,
  1817→    status,
  1818→    docsStatus,
  1819→  };
  1820→}
  1821→
  1822→/**
  1823→ * Get the expected rendered content for a skill
  1824→ */
  1825→async function getExpectedRenderedContent(
  1826→  ctx: KspecContext,
  1827→  skill: LoadedSkill
  1828→): Promise<string> {
  1829→  const sourceContent = await loadSkillContent(ctx, skill);
  1830→
  1831→  if (!sourceContent) {
  1832→    // No source content, generate placeholder
  1833→    const frontmatter = generateFrontmatter(skill);
  1834→    return `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
  1835→  }
  1836→
  1837→  // Generate rendered content with frontmatter and marker
  1838→  const frontmatter = generateFrontmatter(skill);
  1839→
  1840→  // Check if source already has frontmatter - if so, strip it
  1841→  const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
  1842→  const contentWithoutFrontmatter = frontmatterMatch
  1843→    ? sourceContent.slice(frontmatterMatch[0].length)
  1844→    : sourceContent;
  1845→
  1846→  return `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
  1847→}
  1848→
  1849→/**
  1850→ * Generate unified diff between two strings
  1851→ * AC: @skill-render-cli ac-4
  1852→ */
  1853→function generateUnifiedDiff(
  1854→  actual: string,
  1855→  expected: string,
  1856→  actualPath: string,
  1857→  expectedPath: string
  1858→): string[] {
  1859→  if (contentsEqual(actual, expected)) {
  1860→    return [];
  1861→  }
  1862→
  1863→  const actualLines = actual.split("\n");
  1864→  const expectedLines = expected.split("\n");
  1865→  const diffLines: string[] = [];
  1866→
  1867→  // Simple line-by-line diff (unified format)
  1868→  diffLines.push(`--- ${actualPath}`);
  1869→  diffLines.push(`+++ ${expectedPath}`);
  1870→
  1871→  // Find differing sections and create hunks
  1872→  let i = 0;
  1873→  let j = 0;
  1874→
  1875→  while (i < actualLines.length || j < expectedLines.length) {
  1876→    // Find start of difference
  1877→    const contextStart = i;
  1878→    const contextStartExpected = j;
  1879→
  1880→    // Skip matching lines
  1881→    while (
  1882→      i < actualLines.length &&
  1883→      j < expectedLines.length &&
  1884→      actualLines[i] === expectedLines[j]
  1885→    ) {
  1886→      i++;
  1887→      j++;
  1888→    }
  1889→
  1890→    // If we've reached the end, we're done
  1891→    if (i >= actualLines.length && j >= expectedLines.length) {
  1892→      break;
  1893→    }
  1894→
  1895→    // Find end of difference
  1896→    let diffEndActual = i;
  1897→    let diffEndExpected = j;
  1898→
  1899→    // Collect differing lines
  1900→    while (
  1901→      diffEndActual < actualLines.length &&
  1902→      diffEndExpected < expectedLines.length &&
  1903→      actualLines[diffEndActual] !== expectedLines[diffEndExpected]
  1904→    ) {
  1905→      diffEndActual++;
  1906→      diffEndExpected++;
  1907→    }
  1908→
  1909→    // Also handle case where one side has more lines
  1910→    while (diffEndActual < actualLines.length && diffEndExpected >= expectedLines.length) {
  1911→      diffEndActual++;
  1912→    }
  1913→    while (diffEndExpected < expectedLines.length && diffEndActual >= actualLines.length) {
  1914→      diffEndExpected++;
  1915→    }
  1916→
  1917→    // Create hunk header (show 3 lines of context)
  1918→    const hunkStartActual = Math.max(0, contextStart - 3);
  1919→    const hunkStartExpected = Math.max(0, contextStartExpected - 3);
  1920→
  1921→    // Include context after diff too
  1922→    const hunkEndActual = Math.min(actualLines.length, diffEndActual + 3);
  1923→    const hunkEndExpected = Math.min(expectedLines.length, diffEndExpected + 3);
  1924→
  1925→    const actualCount = hunkEndActual - hunkStartActual;
  1926→    const expectedCount = hunkEndExpected - hunkStartExpected;
  1927→
  1928→    diffLines.push(
  1929→      `@@ -${hunkStartActual + 1},${actualCount} +${hunkStartExpected + 1},${expectedCount} @@`
  1930→    );
  1931→
  1932→    // Leading context
  1933→    for (let k = hunkStartActual; k < contextStart; k++) {
  1934→      diffLines.push(` ${actualLines[k]}`);
  1935→    }
  1936→
  1937→    // Removed lines (from actual)
  1938→    for (let k = contextStart; k < diffEndActual; k++) {
  1939→      if (k < actualLines.length) {
  1940→        diffLines.push(`-${actualLines[k]}`);
  1941→      }
  1942→    }
  1943→
  1944→    // Added lines (from expected)
  1945→    for (let k = contextStartExpected; k < diffEndExpected; k++) {
  1946→      if (k < expectedLines.length) {
  1947→        diffLines.push(`+${expectedLines[k]}`);
  1948→      }
  1949→    }
  1950→
  1951→    // Trailing context
  1952→    for (let k = diffEndActual; k < hunkEndActual; k++) {
  1953→      if (k < actualLines.length) {
  1954→        diffLines.push(` ${actualLines[k]}`);
  1955→      }
  1956→    }
  1957→
  1958→    i = hunkEndActual;
  1959→    j = hunkEndExpected;
  1960→  }
  1961→
  1962→  return diffLines;
  1963→}
  1964→
  1965→// Re-export for testing
  1966→// Re-export for testing
  1967→// AC: @consolidate-skill-render ac-1, ac-2, ac-3 - renderClaudeCodeSkill, isKspecManaged, KSPEC_MANAGED_MARKER
  1968→// are now imported from skill-render.ts and re-exported here for API compatibility
  1969→export {
  1970→  isKspecManaged,
  1971→  KSPEC_MANAGED_MARKER,
  1972→  renderClaudeCodeSkill,
  1973→  getSkillSyncStatus,
  1974→  getExpectedRenderedContent,
  1975→  generateUnifiedDiff,
  1976→  loadCoreSkillsManifest,
  1977→  loadCoreSkillContent,
  1978→  getKspecPackageVersion,
  1979→};
  1980→

