     1→/**
     2→ * Platform Skill Renderers
     3→ *
     4→ * Defines the contract for platform-specific skill renderers and provides
     5→ * the Claude Code implementation. Each renderer writes platform-specific output
     6→ * (SKILL.md with frontmatter, sidecar config files, supporting directories)
     7→ * to a configurable output directory.
     8→ *
     9→ * AC: @claude-code-renderer ac-1 - renderClaudeCodeSkill creates .claude/skills/<id>/SKILL.md with YAML frontmatter
    10→ * AC: @claude-code-renderer ac-2 - rendered output has YAML frontmatter delimiters with name and description fields
    11→ * AC: @claude-code-renderer ac-3 - skill body content appears verbatim below frontmatter
    12→ * AC: @claude-code-renderer ac-4 - rendered files appear as unstaged changes on main branch
    13→ *
    14→ * AC: @skill-drift-detection ac-1 - Skill shows as in-sync when not manually edited
    15→ * AC: @skill-drift-detection ac-2 - Skill shows as drifted when manually edited
    16→ * AC: @skill-drift-detection ac-5 - Render hash stored in .kspec/skills/<id>/.render-hash
    17→ *
    18→ * AC: @consolidate-skill-render ac-3 - hash/drift functions exported from this module
    19→ *
    20→ * AC: @platform-renderer-trait ac-1 - platform-specific output files written to configured output directory
    21→ * AC: @platform-renderer-trait ac-2 - PlatformRenderResult returned with id, platform, action, paths
    22→ * AC: @platform-renderer-trait ac-3 - supporting directories (references/, scripts/, assets/) copied
    23→ * AC: @platform-renderer-trait ac-4 - dryRun mode: no files written, result reflects what would happen
    24→ * AC: @platform-renderer-trait ac-5 - custom outputDir goes to custom path instead of platform default
    25→ * AC: @platform-renderer-trait ac-6 - per-platform render hash written to .render-hash-<platform>
    26→ */
    27→
    28→import * as crypto from "node:crypto";
    29→import * as fs from "node:fs/promises";
    30→import * as path from "node:path";
    31→import yaml from "yaml";
    32→import type { KspecContext } from "./yaml.js";
    33→import { loadSkillContent, type LoadedSkill } from "./meta.js";
    34→
    35→// ============================================================================
    36→// Platform Renderer Contract (AC: @platform-renderer-trait)
    37→// ============================================================================
    38→
    39→/**
    40→ * Status of drift detection for a rendered skill
    41→ * AC: @platform-renderer-trait ac-2
    42→ */
    43→export type DriftStatus = "not-rendered" | "in-sync" | "drifted" | "no-hash";
    44→
    45→/**
    46→ * Result of rendering a skill to a specific platform
    47→ * AC: @platform-renderer-trait ac-2
    48→ */
    49→export interface PlatformRenderResult {
    50→  /** Skill ID */
    51→  id: string;
    52→  /** Platform this result is for */
    53→  platform: string;
    54→  /** Action taken: created, updated, unchanged, or skipped */
    55→  action: "created" | "updated" | "unchanged" | "skipped";
    56→  /** Paths to all output files */
    57→  paths: string[];
    58→  /** Actions taken on supporting directories (references/, scripts/, assets/, docs/) */
    59→  supportingDirsAction?: Record<string, "created" | "updated" | "unchanged" | "skipped">;
    60→  /** Reason if action is skipped */
    61→  skipReason?: string;
    62→}
    63→
    64→/**
    65→ * Options for rendering a skill to a platform
    66→ * AC: @platform-renderer-trait ac-4, ac-5
    67→ */
    68→export interface PlatformRenderOptions {
    69→  /** If true, don't write files, just return what would be done */
    70→  dryRun?: boolean;
    71→  /** If true, store a hash of the rendered content for drift detection */
    72→  storeHash?: boolean;
    73→  /** Custom output directory (overrides platform default) */
    74→  outputDir?: string;
    75→}
    76→
    77→/**
    78→ * Contract for platform-specific skill renderers
    79→ * AC: @platform-renderer-trait ac-1, ac-2
    80→ */
    81→export interface PlatformRenderer {
    82→  /** Platform identifier (e.g., "claude-code", "codex") */
    83→  platform: string;
    84→  /** Default output directory relative to project root (e.g., ".claude/skills") */
    85→  defaultOutputDir: string;
    86→  /**
    87→   * Render a skill to platform-specific output
    88→   * AC: @platform-renderer-trait ac-1, ac-2, ac-3, ac-4, ac-5
    89→   */
    90→  render(
    91→    ctx: KspecContext,
    92→    projectRoot: string,
    93→    skill: LoadedSkill,
    94→    options?: PlatformRenderOptions
    95→  ): Promise<PlatformRenderResult>;
    96→  /**
    97→   * Check if a rendered skill has drifted from its source
    98→   * AC: @platform-renderer-trait ac-6
    99→   */
   100→  checkDrift(
   101→    specDir: string,
   102→    projectRoot: string,
   103→    skillId: string,
   104→    options?: { outputDir?: string }
   105→  ): Promise<DriftStatus>;
   106→}
   107→
   108→// ============================================================================
   109→// Backward Compatibility Types
   110→// ============================================================================
   111→
   112→/**
   113→ * Result of rendering a skill to Claude Code format
   114→ * @deprecated Use PlatformRenderResult instead
   115→ */
   116→export interface ClaudeCodeRenderResult {
   117→  /** Skill ID */
   118→  id: string;
   119→  /** Action taken: created, updated, or unchanged */
   120→  action: "created" | "updated" | "unchanged";
   121→  /** Path to the rendered SKILL.md file */
   122→  path: string;
   123→  /** Action taken on docs directory */
   124→  docsAction?: "created" | "updated" | "unchanged" | "skipped";
   125→}
   126→
   127→/**
   128→ * Options for rendering a skill
   129→ * @deprecated Use PlatformRenderOptions instead
   130→ */
   131→export interface RenderSkillOptions {
   132→  /** If true, don't write files, just return what would be done */
   133→  dryRun?: boolean;
   134→  /** If true, store a hash of the rendered content for drift detection */
   135→  storeHash?: boolean;
   136→  /** Custom output directory (overrides platform default) */
   137→  outputDir?: string;
   138→}
   139→
   140→/**
   141→ * Marker comment that identifies skill directories managed by kspec
   142→ */
   143→export const KSPEC_MANAGED_MARKER = "<!-- kspec-managed -->";
   144→
   145→/**
   146→ * Convert snake_case to kebab-case for Claude Code frontmatter keys
   147→ * AC: @claude-code-renderer-extended ac-8 - snake_case to kebab-case conversion
   148→ */
   149→function toKebabCase(str: string): string {
   150→  return str.replace(/_/g, "-");
   151→}
   152→
   153→/**
   154→ * Generate YAML frontmatter for a skill.
   155→ * AC: @claude-code-renderer ac-2 - YAML frontmatter with name and description fields
   156→ * AC: @claude-code-renderer-extended ac-1 - portable fields (license, allowed-tools)
   157→ * AC: @claude-code-renderer-extended ac-2 - user-invocable from platform_config
   158→ * AC: @claude-code-renderer-extended ac-3 - context and agent from platform_config
   159→ * AC: @claude-code-renderer-extended ac-4 - disable-model-invocation from platform_config
   160→ * AC: @claude-code-renderer-extended ac-5 - only portable fields when no platform_config
   161→ * AC: @claude-code-renderer-extended ac-8 - snake_case to kebab-case conversion
   162→ */
   163→export function generateFrontmatter(skill: LoadedSkill): string {
   164→  const frontmatter: Record<string, unknown> = {
   165→    name: skill.id,
   166→    description: skill.description || skill.name,
   167→  };
   168→
   169→  // AC: @claude-code-renderer-extended ac-1 - Add portable fields
   170→  if (skill.license) {
   171→    frontmatter.license = skill.license;
   172→  }
   173→  if (skill.allowed_tools && skill.allowed_tools.length > 0) {
   174→    frontmatter["allowed-tools"] = skill.allowed_tools;
   175→  }
   176→  if (skill.compatibility) {
   177→    frontmatter.compatibility = skill.compatibility;
   178→  }
   179→
   180→  // AC: @claude-code-renderer-extended ac-2, ac-3, ac-4 - Add Claude Code platform fields
   181→  const claudeCodeConfig = skill.platform_config?.claude_code;
   182→  if (claudeCodeConfig) {
   183→    // AC: @claude-code-renderer-extended ac-2 - user_invocable
   184→    if (claudeCodeConfig.user_invocable !== undefined) {
   185→      frontmatter["user-invocable"] = claudeCodeConfig.user_invocable;
   186→    }
   187→    // AC: @claude-code-renderer-extended ac-4 - disable_model_invocation
   188→    if (claudeCodeConfig.disable_model_invocation !== undefined) {
   189→      frontmatter["disable-model-invocation"] = claudeCodeConfig.disable_model_invocation;
   190→    }
   191→    // AC: @claude-code-renderer-extended ac-3 - context and agent
   192→    if (claudeCodeConfig.context) {
   193→      frontmatter.context = claudeCodeConfig.context;
   194→    }
   195→    if (claudeCodeConfig.agent) {
   196→      frontmatter.agent = claudeCodeConfig.agent;
   197→    }
   198→    // Other Claude Code fields
   199→    if (claudeCodeConfig.model) {
   200→      frontmatter.model = claudeCodeConfig.model;
   201→    }
   202→    if (claudeCodeConfig.argument_hint) {
   203→      frontmatter["argument-hint"] = claudeCodeConfig.argument_hint;
   204→    }
   205→  }
   206→
   207→  return `---\n${yaml.stringify(frontmatter).trim()}\n---`;
   208→}
   209→
   210→/**
   211→ * Get the target directory for rendered skills on main branch.
   212→ * Returns .claude/skills/<id>/ path.
   213→ */
   214→function getRenderedSkillPath(projectRoot: string, skillId: string): string {
   215→  return path.join(projectRoot, ".claude", "skills", skillId);
   216→}
   217→
   218→/**
   219→ * Check if two contents are equal (for idempotency check)
   220→ */
   221→function contentsEqual(a: string, b: string): boolean {
   222→  return a.trim() === b.trim();
   223→}
   224→
   225→/**
   226→ * Recursively copy a directory
   227→ */
   228→async function copyDirectory(src: string, dest: string): Promise<void> {
   229→  const entries = await fs.readdir(src, { withFileTypes: true });
   230→
   231→  for (const entry of entries) {
   232→    const srcPath = path.join(src, entry.name);
   233→    const destPath = path.join(dest, entry.name);
   234→
   235→    if (entry.isDirectory()) {
   236→      await fs.mkdir(destPath, { recursive: true });
   237→      await copyDirectory(srcPath, destPath);
   238→    } else {
   239→      await fs.copyFile(srcPath, destPath);
   240→    }
   241→  }
   242→}
   243→
   244→/**
   245→ * Compute SHA256 hash of content
   246→ * AC: @skill-drift-detection ac-5 - Hash computation for render tracking
   247→ */
   248→export function computeContentHash(content: string): string {
   249→  return crypto.createHash("sha256").update(content, "utf-8").digest("hex");
   250→}
   251→
   252→/**
   253→ * Get the path to the render hash file for a skill
   254→ * AC: @skill-drift-detection ac-5 - Hash stored in .kspec/skills/<id>/.render-hash
   255→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   256→ */
   257→export function getRenderHashPath(specDir: string, skillId: string): string {
   258→  return path.join(specDir, "skills", skillId, ".render-hash");
   259→}
   260→
   261→/**
   262→ * Read the stored render hash for a skill
   263→ * AC: @skill-drift-detection ac-5 - Read hash from .kspec/skills/<id>/.render-hash
   264→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   265→ */
   266→export async function readRenderHash(specDir: string, skillId: string): Promise<string | null> {
   267→  try {
   268→    const hashPath = getRenderHashPath(specDir, skillId);
   269→    const content = await fs.readFile(hashPath, "utf-8");
   270→    return content.trim();
   271→  } catch {
   272→    return null;
   273→  }
   274→}
   275→
   276→/**
   277→ * Write the render hash for a skill
   278→ * AC: @skill-drift-detection ac-5 - Store hash in .kspec/skills/<id>/.render-hash
   279→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   280→ */
   281→export async function writeRenderHash(specDir: string, skillId: string, hash: string): Promise<void> {
   282→  const hashPath = getRenderHashPath(specDir, skillId);
   283→  await fs.mkdir(path.dirname(hashPath), { recursive: true });
   284→  await fs.writeFile(hashPath, hash + "\n", "utf-8");
   285→}
   286→
   287→/**
   288→ * Check if a rendered skill has drifted from its last render
   289→ * AC: @skill-drift-detection ac-1, ac-2 - Drift detection via hash comparison
   290→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   291→ *
   292→ * Returns:
   293→ * - "not-rendered": Rendered file doesn't exist
   294→ * - "in-sync": Rendered file matches stored hash
   295→ * - "drifted": Rendered file differs from stored hash (manually edited)
   296→ * - "no-hash": Rendered file exists but no stored hash (first render or hash deleted)
   297→ */
   298→export async function checkSkillDrift(
   299→  specDir: string,
   300→  projectRoot: string,
   301→  skillId: string
   302→): Promise<"not-rendered" | "in-sync" | "drifted" | "no-hash"> {
   303→  const renderedPath = path.join(projectRoot, ".claude", "skills", skillId, "SKILL.md");
   304→
   305→  // Check if rendered file exists
   306→  let renderedContent: string;
   307→  try {
   308→    renderedContent = await fs.readFile(renderedPath, "utf-8");
   309→  } catch {
   310→    return "not-rendered";
   311→  }
   312→
   313→  // Get stored hash
   314→  const storedHash = await readRenderHash(specDir, skillId);
   315→  if (!storedHash) {
   316→    return "no-hash";
   317→  }
   318→
   319→  // Compare hashes
   320→  const currentHash = computeContentHash(renderedContent);
   321→  return currentHash === storedHash ? "in-sync" : "drifted";
   322→}
   323→
   324→/**
   325→ * Recursively check if two directories have the same contents
   326→ */
   327→async function directoriesEqual(src: string, dest: string): Promise<boolean> {
   328→  try {
   329→    const srcEntries = await fs.readdir(src, { withFileTypes: true });
   330→    const destEntries = await fs.readdir(dest, { withFileTypes: true });
   331→
   332→    // Different number of entries = not equal
   333→    if (srcEntries.length !== destEntries.length) {
   334→      return false;
   335→    }
   336→
   337→    // Create a map of dest entries for quick lookup
   338→    const destMap = new Map(destEntries.map((e) => [e.name, e]));
   339→
   340→    for (const srcEntry of srcEntries) {
   341→      const destEntry = destMap.get(srcEntry.name);
   342→      if (!destEntry) {
   343→        return false;
   344→      }
   345→
   346→      const srcPath = path.join(src, srcEntry.name);
   347→      const destPath = path.join(dest, srcEntry.name);
   348→
   349→      if (srcEntry.isDirectory() && destEntry.isDirectory()) {
   350→        if (!(await directoriesEqual(srcPath, destPath))) {
   351→          return false;
   352→        }
   353→      } else if (srcEntry.isFile() && destEntry.isFile()) {
   354→        const srcContent = await fs.readFile(srcPath, "utf-8");
   355→        const destContent = await fs.readFile(destPath, "utf-8");
   356→        if (!contentsEqual(srcContent, destContent)) {
   357→          return false;
   358→        }
   359→      } else {
   360→        // Type mismatch
   361→        return false;
   362→      }
   363→    }
   364→
   365→    return true;
   366→  } catch {
   367→    return false;
   368→  }
   369→}
   370→
   371→// ============================================================================
   372→// Supporting Directories (AC: @platform-renderer-trait ac-3, @claude-code-renderer-extended ac-7)
   373→// ============================================================================
   374→
   375→/** Known supporting directory names */
   376→const SUPPORTING_DIRS = ["references", "scripts", "assets", "docs"] as const;
   377→
   378→/**
   379→ * Copy supporting directories from source skill to rendered output
   380→ * AC: @platform-renderer-trait ac-3 - Supporting directories copied to platform output
   381→ * AC: @claude-code-renderer-extended ac-7 - references/, scripts/, assets/ copied
   382→ */
   383→async function copySupportingDirectories(
   384→  sourceSkillDir: string,
   385→  targetSkillDir: string,
   386→  dryRun: boolean
   387→): Promise<Record<string, "created" | "updated" | "unchanged" | "skipped">> {
   388→  const results: Record<string, "created" | "updated" | "unchanged" | "skipped"> = {};
   389→
   390→  for (const dirName of SUPPORTING_DIRS) {
   391→    const sourceDir = path.join(sourceSkillDir, dirName);
   392→    const targetDir = path.join(targetSkillDir, dirName);
   393→
   394→    try {
   395→      const stats = await fs.stat(sourceDir);
   396→      if (!stats.isDirectory()) {
   397→        results[dirName] = "skipped";
   398→        continue;
   399→      }
   400→
   401→      // Check if target exists
   402→      let targetExists = false;
   403→      try {
   404→        await fs.stat(targetDir);
   405→        targetExists = true;
   406→      } catch {
   407→        // Target doesn't exist
   408→      }
   409→
   410→      if (!targetExists) {
   411→        results[dirName] = "created";
   412→      } else {
   413→        // Compare directories
   414→        const equal = await directoriesEqual(sourceDir, targetDir);
   415→        results[dirName] = equal ? "unchanged" : "updated";
   416→      }
   417→
   418→      // Apply changes
   419→      if (!dryRun && results[dirName] !== "unchanged") {
   420→        if (targetExists) {
   421→          await fs.rm(targetDir, { recursive: true, force: true });
   422→        }
   423→        await fs.mkdir(targetDir, { recursive: true });
   424→        await copyDirectory(sourceDir, targetDir);
   425→      }
   426→    } catch {
   427→      // Source directory doesn't exist
   428→      results[dirName] = "skipped";
   429→    }
   430→  }
   431→
   432→  return results;
   433→}
   434→
   435→/**
   436→ * Render a skill to Claude Code format.
   437→ *
   438→ * Reads skill content from .kspec/skills/<id>/SKILL.md and writes to
   439→ * .claude/skills/<id>/SKILL.md with YAML frontmatter containing name and description.
   440→ *
   441→ * AC: @claude-code-renderer ac-1 - Creates .claude/skills/<id>/SKILL.md with YAML frontmatter
   442→ * AC: @claude-code-renderer ac-2 - YAML frontmatter has name and description fields
   443→ * AC: @claude-code-renderer ac-3 - Skill body content appears verbatim below frontmatter
   444→ * AC: @claude-code-renderer ac-4 - Files are written to disk as unstaged changes (no git commit)
   445→ *
   446→ * @param ctx - Kspec context with specDir pointing to .kspec/
   447→ * @param projectRoot - Root directory of the project (where .claude/ will be created)
   448→ * @param skill - The skill to render
   449→ * @param options - Render options (dryRun, etc.)
   450→ * @returns Result indicating what action was taken
   451→ */
   452→export async function renderClaudeCodeSkill(
   453→  ctx: KspecContext,
   454→  projectRoot: string,
   455→  skill: LoadedSkill,
   456→  options: RenderSkillOptions = {},
   457→): Promise<ClaudeCodeRenderResult> {
   458→  const dryRun = options.dryRun ?? false;
   459→  const storeHash = options.storeHash ?? false;
   460→  const targetDir = getRenderedSkillPath(projectRoot, skill.id);
   461→  const targetSkillMd = path.join(targetDir, "SKILL.md");
   462→
   463→  // AC: @claude-code-renderer ac-3 - Load source content verbatim
   464→  const sourceContent = await loadSkillContent(ctx, skill);
   465→
   466→  if (!sourceContent) {
   467→    // No source content, but skill exists in meta - create placeholder
   468→    const frontmatter = generateFrontmatter(skill);
   469→    const renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
   470→
   471→    // AC: @claude-code-renderer ac-4 - Write to disk (unstaged)
   472→    if (!dryRun) {
   473→      await fs.mkdir(targetDir, { recursive: true });
   474→      await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
   475→      // AC: @skill-drift-detection ac-5 - Store hash of rendered output
   476→      if (storeHash) {
   477→        const hash = computeContentHash(renderedContent);
   478→        await writeRenderHash(ctx.specDir, skill.id, hash);
   479→      }
   480→    }
   481→
   482→    return {
   483→      id: skill.id,
   484→      action: "created",
   485→      path: targetSkillMd,
   486→    };
   487→  }
   488→
   489→  // AC: @claude-code-renderer ac-2 - Generate frontmatter with name and description
   490→  const frontmatter = generateFrontmatter(skill);
   491→
   492→  // Check if source already has frontmatter - if so, strip it
   493→  const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
   494→  const contentWithoutFrontmatter = frontmatterMatch
   495→    ? sourceContent.slice(frontmatterMatch[0].length)
   496→    : sourceContent;
   497→
   498→  // AC: @claude-code-renderer ac-1, ac-3 - Build rendered content with frontmatter + verbatim body
   499→  const renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
   500→
   501→  // Check if target exists and compare for idempotency
   502→  let targetExists = false;
   503→  let targetContent = "";
   504→  try {
   505→    targetContent = await fs.readFile(targetSkillMd, "utf-8");
   506→    targetExists = true;
   507→  } catch {
   508→    // Target doesn't exist
   509→  }
   510→
   511→  // Determine action based on comparison
   512→  let action: "created" | "updated" | "unchanged";
   513→
   514→  if (!targetExists) {
   515→    action = "created";
   516→  } else if (contentsEqual(renderedContent, targetContent)) {
   517→    action = "unchanged";
   518→  } else {
   519→    action = "updated";
   520→  }
   521→
   522→  // AC: @claude-code-renderer ac-4 - Apply changes to disk (no git commit)
   523→  if (!dryRun && action !== "unchanged") {
   524→    await fs.mkdir(targetDir, { recursive: true });
   525→    await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
   526→    // AC: @skill-drift-detection ac-5 - Store hash of rendered output
   527→    if (storeHash) {
   528→      const hash = computeContentHash(renderedContent);
   529→      await writeRenderHash(ctx.specDir, skill.id, hash);
   530→    }
   531→  }
   532→
   533→  // AC: @claude-code-renderer-extended ac-7 - Copy supporting directories (references/, scripts/, assets/, docs/)
   534→  const sourceSkillDir = path.join(ctx.specDir, "skills", skill.id);
   535→  const supportingDirsAction = await copySupportingDirectories(
   536→    sourceSkillDir,
   537→    targetDir,
   538→    dryRun
   539→  );
   540→
   541→  // For backward compatibility, also expose docsAction
   542→  const docsAction = supportingDirsAction.docs || "skipped";
   543→
   544→  return {
   545→    id: skill.id,
   546→    action,
   547→    path: targetSkillMd,
   548→    docsAction,
   549→  };
   550→}
   551→
   552→/**
   553→ * Check if a skill directory is managed by kspec.
   554→ * Looks for the KSPEC_MANAGED_MARKER in the SKILL.md file.
   555→ */
   556→export async function isKspecManagedSkill(skillMdPath: string): Promise<boolean> {
   557→  try {
   558→    const content = await fs.readFile(skillMdPath, "utf-8");
   559→    return content.includes(KSPEC_MANAGED_MARKER);
   560→  } catch {
   561→    return false;
   562→  }
   563→}
   564→
   565→// ============================================================================
   566→// Per-Platform Hash Functions (AC: @platform-renderer-trait ac-6)
   567→// ============================================================================
   568→
   569→/**
   570→ * Get the path to the per-platform render hash file for a skill
   571→ * AC: @platform-renderer-trait ac-6 - Per-platform hash stored in .render-hash-<platform>
   572→ */
   573→export function getPlatformRenderHashPath(specDir: string, skillId: string, platform: string): string {
   574→  return path.join(specDir, "skills", skillId, `.render-hash-${platform}`);
   575→}
   576→
   577→/**
   578→ * Read the stored render hash for a skill on a specific platform
   579→ * AC: @platform-renderer-trait ac-6 - Read per-platform hash
   580→ * AC: @claude-code-renderer-extended ac-6 - fallback to legacy hash
   581→ */
   582→export async function readPlatformRenderHash(
   583→  specDir: string,
   584→  skillId: string,
   585→  platform: string
   586→): Promise<string | null> {
   587→  try {
   588→    const hashPath = getPlatformRenderHashPath(specDir, skillId, platform);
   589→    const content = await fs.readFile(hashPath, "utf-8");
   590→    return content.trim();
   591→  } catch {
   592→    // Fall back to legacy hash (non-platform-specific)
   593→    return readRenderHash(specDir, skillId);
   594→  }
   595→}
   596→
   597→/**
   598→ * Migrate legacy .render-hash to platform-specific .render-hash-<platform>
   599→ * AC: @claude-code-renderer-extended ac-6 - hash migration
   600→ */
   601→export async function migrateLegacyRenderHash(
   602→  specDir: string,
   603→  skillId: string,
   604→  platform: string
   605→): Promise<boolean> {
   606→  const legacyHashPath = getRenderHashPath(specDir, skillId);
   607→  const platformHashPath = getPlatformRenderHashPath(specDir, skillId, platform);
   608→
   609→  try {
   610→    // Check if platform-specific hash already exists
   611→    await fs.access(platformHashPath);
   612→    return false; // Already migrated
   613→  } catch {
   614→    // Platform-specific doesn't exist, check for legacy
   615→  }
   616→
   617→  try {
   618→    const legacyHash = await fs.readFile(legacyHashPath, "utf-8");
   619→    // Write to platform-specific location
   620→    await writePlatformRenderHash(specDir, skillId, platform, legacyHash.trim());
   621→    return true; // Migrated successfully
   622→  } catch {
   623→    return false; // No legacy hash to migrate
   624→  }
   625→}
   626→
   627→/**
   628→ * Write the render hash for a skill on a specific platform
   629→ * AC: @platform-renderer-trait ac-6 - Store per-platform hash in .render-hash-<platform>
   630→ */
   631→export async function writePlatformRenderHash(
   632→  specDir: string,
   633→  skillId: string,
   634→  platform: string,
   635→  hash: string
   636→): Promise<void> {
   637→  const hashPath = getPlatformRenderHashPath(specDir, skillId, platform);
   638→  await fs.mkdir(path.dirname(hashPath), { recursive: true });
   639→  await fs.writeFile(hashPath, hash + "\n", "utf-8");
   640→}
   641→
   642→/**
   643→ * Check if a rendered skill has drifted from its last render for a specific platform
   644→ * AC: @platform-renderer-trait ac-6 - Platform-specific drift detection
   645→ */
   646→export async function checkPlatformSkillDrift(
   647→  specDir: string,
   648→  projectRoot: string,
   649→  skillId: string,
   650→  platform: string,
   651→  outputDir?: string
   652→): Promise<DriftStatus> {
   653→  // Determine the output directory - use custom or platform default
   654→  const platformOutputDir = outputDir || getPlatformDefaultOutputDir(platform);
   655→  const renderedPath = path.join(projectRoot, platformOutputDir, skillId, "SKILL.md");
   656→
   657→  // Check if rendered file exists
   658→  let renderedContent: string;
   659→  try {
   660→    renderedContent = await fs.readFile(renderedPath, "utf-8");
   661→  } catch {
   662→    return "not-rendered";
   663→  }
   664→
   665→  // AC: @claude-code-renderer-extended ac-6 - Migrate legacy hash if needed
   666→  await migrateLegacyRenderHash(specDir, skillId, platform);
   667→
   668→  // Get stored hash (try platform-specific first, then fall back to legacy)
   669→  const storedHash = await readPlatformRenderHash(specDir, skillId, platform);
   670→  if (!storedHash) {
   671→    return "no-hash";
   672→  }
   673→
   674→  // Compare hashes
   675→  const currentHash = computeContentHash(renderedContent);
   676→  return currentHash === storedHash ? "in-sync" : "drifted";
   677→}
   678→
   679→/**
   680→ * Get the default output directory for a platform
   681→ */
   682→function getPlatformDefaultOutputDir(platform: string): string {
   683→  switch (platform) {
   684→    case "claude-code":
   685→      return ".claude/skills";
   686→    case "codex":
   687→      return ".agents/skills";
   688→    default:
   689→      return `.${platform}/skills`;
   690→  }
   691→}
   692→
   693→// ============================================================================
   694→// Claude Code Renderer (implements PlatformRenderer)
   695→// ============================================================================
   696→
   697→/**
   698→ * Claude Code platform renderer implementation
   699→ * AC: @platform-renderer-trait ac-1 through ac-6
   700→ */
   701→export const claudeCodeRenderer: PlatformRenderer = {
   702→  platform: "claude-code",
   703→  defaultOutputDir: ".claude/skills",
   704→
   705→  async render(
   706→    ctx: KspecContext,
   707→    projectRoot: string,
   708→    skill: LoadedSkill,
   709→    options: PlatformRenderOptions = {}
   710→  ): Promise<PlatformRenderResult> {
   711→    const dryRun = options.dryRun ?? false;
   712→    const storeHash = options.storeHash ?? false;
   713→    // AC: @platform-renderer-trait ac-5 - Custom outputDir support
   714→    const outputDir = options.outputDir || this.defaultOutputDir;
   715→
   716→    const targetDir = path.join(projectRoot, outputDir, skill.id);
   717→    const targetSkillMd = path.join(targetDir, "SKILL.md");
   718→    const paths: string[] = [];
   719→
   720→    // Load source content
   721→    const sourceContent = await loadSkillContent(ctx, skill);
   722→
   723→    let renderedContent: string;
   724→    if (!sourceContent) {
   725→      // No source content - create placeholder
   726→      const frontmatter = generateFrontmatter(skill);
   727→      renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
   728→    } else {
   729→      // Generate frontmatter and combine with content
   730→      const frontmatter = generateFrontmatter(skill);
   731→      const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
   732→      const contentWithoutFrontmatter = frontmatterMatch
   733→        ? sourceContent.slice(frontmatterMatch[0].length)
   734→        : sourceContent;
   735→      renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
   736→    }
   737→
   738→    // Check if target exists and compare for idempotency
   739→    let targetExists = false;
   740→    let targetContent = "";
   741→    try {
   742→      targetContent = await fs.readFile(targetSkillMd, "utf-8");
   743→      targetExists = true;
   744→    } catch {
   745→      // Target doesn't exist
   746→    }
   747→
   748→    // Determine action based on comparison
   749→    let action: "created" | "updated" | "unchanged" | "skipped";
   750→    if (!targetExists) {
   751→      action = "created";
   752→    } else if (contentsEqual(renderedContent, targetContent)) {
   753→      action = "unchanged";
   754→    } else {
   755→      action = "updated";
   756→    }
   757→
   758→    // AC: @platform-renderer-trait ac-4 - dryRun: no files written
   759→    // AC: @platform-renderer-trait ac-1 - Write platform-specific output
   760→    if (!dryRun && action !== "unchanged") {
   761→      await fs.mkdir(targetDir, { recursive: true });
   762→      await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
   763→    }
   764→
   765→    paths.push(targetSkillMd);
   766→
   767→    // AC: @platform-renderer-trait ac-6 - Store per-platform hash
   768→    if (!dryRun && storeHash && action !== "unchanged") {
   769→      const hash = computeContentHash(renderedContent);
   770→      await writePlatformRenderHash(ctx.specDir, skill.id, this.platform, hash);
   771→      // Also write legacy hash for backward compatibility
   772→      await writeRenderHash(ctx.specDir, skill.id, hash);
   773→    }
   774→
   775→    // AC: @platform-renderer-trait ac-3 - Copy supporting directories
   776→    const sourceSkillDir = path.join(ctx.specDir, "skills", skill.id);
   777→    const supportingDirsAction = await copySupportingDirectories(
   778→      sourceSkillDir,
   779→      targetDir,
   780→      dryRun
   781→    );
   782→
   783→    // Add supporting directory paths to output
   784→    for (const [dirName, dirAction] of Object.entries(supportingDirsAction)) {
   785→      if (dirAction !== "skipped") {
   786→        paths.push(path.join(targetDir, dirName));
   787→      }
   788→    }
   789→
   790→    return {
   791→      id: skill.id,
   792→      platform: this.platform,
   793→      action,
   794→      paths,
   795→      supportingDirsAction,
   796→    };
   797→  },
   798→
   799→  async checkDrift(
   800→    specDir: string,
   801→    projectRoot: string,
   802→    skillId: string,
   803→    options?: { outputDir?: string }
   804→  ): Promise<DriftStatus> {
   805→    return checkPlatformSkillDrift(
   806→      specDir,
   807→      projectRoot,
   808→      skillId,
   809→      this.platform,
   810→      options?.outputDir
   811→    );
   812→  },
   813→};
   814→
   815→// ============================================================================
   816→// Renderer Registry
   817→// ============================================================================
   818→
   819→/** Map of platform name to renderer implementation */
   820→const rendererRegistry: Map<string, PlatformRenderer> = new Map([
   821→  ["claude-code", claudeCodeRenderer],
   822→]);
   823→
   824→/**
   825→ * Get the renderer for a specific platform
   826→ */
   827→export function getRenderer(platform: string): PlatformRenderer | undefined {
   828→  return rendererRegistry.get(platform);
   829→}
   830→
   831→/**
   832→ * Get all registered renderers
   833→ */
   834→export function getAllRenderers(): PlatformRenderer[] {
   835→  return Array.from(rendererRegistry.values());
   836→}
   837→
   838→/**
   839→ * Register a new platform renderer
   840→ */
   841→export function registerRenderer(renderer: PlatformRenderer): void {
   842→  rendererRegistry.set(renderer.platform, renderer);
   843→}
   844→

