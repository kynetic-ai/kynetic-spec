```
     1→/**
     2→ * Platform Skill Renderers
     3→ *
     4→ * Defines the contract for platform-specific skill renderers and provides
     5→ * the Claude Code implementation. Each renderer writes platform-specific output
     6→ * (SKILL.md with frontmatter, sidecar config files, supporting directories)
     7→ * to a configurable output directory.
     8→ *
     9→ * AC: @claude-code-renderer ac-1 - renderClaudeCodeSkill creates .claude/skills/<id>/SKILL.md with YAML frontmatter
    10→ * AC: @claude-code-renderer ac-2 - rendered output has YAML frontmatter delimiters with name and description fields
    11→ * AC: @claude-code-renderer ac-3 - skill body content appears verbatim below frontmatter
    12→ * AC: @claude-code-renderer ac-4 - rendered files appear as unstaged changes on main branch
    13→ *
    14→ * AC: @skill-drift-detection ac-1 - Skill shows as in-sync when not manually edited
    15→ * AC: @skill-drift-detection ac-2 - Skill shows as drifted when manually edited
    16→ * AC: @skill-drift-detection ac-5 - Render hash stored in .kspec/skills/<id>/.render-hash
    17→ *
    18→ * AC: @consolidate-skill-render ac-3 - hash/drift functions exported from this module
    19→ *
    20→ * AC: @platform-renderer-trait ac-1 - platform-specific output files written to configured output directory
    21→ * AC: @platform-renderer-trait ac-2 - PlatformRenderResult returned with id, platform, action, paths
    22→ * AC: @platform-renderer-trait ac-3 - supporting directories (references/, scripts/, assets/) copied
    23→ * AC: @platform-renderer-trait ac-4 - dryRun mode: no files written, result reflects what would happen
    24→ * AC: @platform-renderer-trait ac-5 - custom outputDir goes to custom path instead of platform default
    25→ * AC: @platform-renderer-trait ac-6 - per-platform render hash written to .render-hash-<platform>
    26→ *
    27→ * AC: @codex-renderer ac-1 - .agents/skills/<id>/SKILL.md with only name and description in frontmatter
    28→ * AC: @codex-renderer ac-2 - .agents/skills/<id>/agents/openai.yaml sidecar with platform_config.codex fields
    29→ * AC: @codex-renderer ac-3 - no sidecar created when no platform_config.codex
    30→ * AC: @codex-renderer ac-4 - rendered file contains <!-- kspec-managed --> marker
    31→ * AC: @codex-renderer ac-5 - supporting directories (references/, scripts/, assets/) copied
    32→ * AC: @codex-renderer ac-6 - hash written to .render-hash-codex
    33→ */
    34→
    35→import * as crypto from "node:crypto";
    36→import * as fs from "node:fs/promises";
    37→import * as path from "node:path";
    38→import yaml from "yaml";
    39→import type { KspecContext } from "./yaml.js";
    40→import { loadSkillContent, type LoadedSkill } from "./meta.js";
    41→
    42→// ============================================================================
    43→// Platform Renderer Contract (AC: @platform-renderer-trait)
    44→// ============================================================================
    45→
    46→/**
    47→ * Status of drift detection for a rendered skill
    48→ * AC: @platform-renderer-trait ac-2
    49→ */
    50→export type DriftStatus = "not-rendered" | "in-sync" | "drifted" | "no-hash";
    51→
    52→/**
    53→ * Result of rendering a skill to a specific platform
    54→ * AC: @platform-renderer-trait ac-2
    55→ */
    56→export interface PlatformRenderResult {
    57→  /** Skill ID */
    58→  id: string;
    59→  /** Platform this result is for */
    60→  platform: string;
    61→  /** Action taken: created, updated, unchanged, or skipped */
    62→  action: "created" | "updated" | "unchanged" | "skipped";
    63→  /** Paths to all output files */
    64→  paths: string[];
    65→  /** Actions taken on supporting directories (references/, scripts/, assets/, docs/) */
    66→  supportingDirsAction?: Record<string, "created" | "updated" | "unchanged" | "skipped">;
    67→  /** Reason if action is skipped */
    68→  skipReason?: string;
    69→}
    70→
    71→/**
    72→ * Options for rendering a skill to a platform
    73→ * AC: @platform-renderer-trait ac-4, ac-5
    74→ */
    75→export interface PlatformRenderOptions {
    76→  /** If true, don't write files, just return what would be done */
    77→  dryRun?: boolean;
    78→  /** If true, store a hash of the rendered content for drift detection */
    79→  storeHash?: boolean;
    80→  /** Custom output directory (overrides platform default) */
    81→  outputDir?: string;
    82→}
    83→
    84→/**
    85→ * Contract for platform-specific skill renderers
    86→ * AC: @platform-renderer-trait ac-1, ac-2
    87→ */
    88→export interface PlatformRenderer {
    89→  /** Platform identifier (e.g., "claude-code", "codex") */
    90→  platform: string;
    91→  /** Default output directory relative to project root (e.g., ".claude/skills") */
    92→  defaultOutputDir: string;
    93→  /**
    94→   * Render a skill to platform-specific output
    95→   * AC: @platform-renderer-trait ac-1, ac-2, ac-3, ac-4, ac-5
    96→   */
    97→  render(
    98→    ctx: KspecContext,
    99→    projectRoot: string,
   100→    skill: LoadedSkill,
   101→    options?: PlatformRenderOptions
   102→  ): Promise<PlatformRenderResult>;
   103→  /**
   104→   * Check if a rendered skill has drifted from its source
   105→   * AC: @platform-renderer-trait ac-6
   106→   */
   107→  checkDrift(
   108→    specDir: string,
   109→    projectRoot: string,
   110→    skillId: string,
   111→    options?: { outputDir?: string }
   112→  ): Promise<DriftStatus>;
   113→}
   114→
   115→// ============================================================================
   116→// Backward Compatibility Types
   117→// ============================================================================
   118→
   119→/**
   120→ * Result of rendering a skill to Claude Code format
   121→ * @deprecated Use PlatformRenderResult instead
   122→ */
   123→export interface ClaudeCodeRenderResult {
   124→  /** Skill ID */
   125→  id: string;
   126→  /** Action taken: created, updated, or unchanged */
   127→  action: "created" | "updated" | "unchanged";
   128→  /** Path to the rendered SKILL.md file */
   129→  path: string;
   130→  /** Action taken on docs directory */
   131→  docsAction?: "created" | "updated" | "unchanged" | "skipped";
   132→}
   133→
   134→/**
   135→ * Options for rendering a skill
   136→ * @deprecated Use PlatformRenderOptions instead
   137→ */
   138→export interface RenderSkillOptions {
   139→  /** If true, don't write files, just return what would be done */
   140→  dryRun?: boolean;
   141→  /** If true, store a hash of the rendered content for drift detection */
   142→  storeHash?: boolean;
   143→  /** Custom output directory (overrides platform default) */
   144→  outputDir?: string;
   145→}
   146→
   147→/**
   148→ * Marker comment that identifies skill directories managed by kspec
   149→ */
   150→export const KSPEC_MANAGED_MARKER = "<!-- kspec-managed -->";
   151→
   152→/**
   153→ * Convert snake_case to kebab-case for Claude Code frontmatter keys
   154→ * AC: @claude-code-renderer-extended ac-8 - snake_case to kebab-case conversion
   155→ */
   156→function toKebabCase(str: string): string {
   157→  return str.replace(/_/g, "-");
   158→}
   159→
   160→/**
   161→ * Generate YAML frontmatter for a skill.
   162→ * AC: @claude-code-renderer ac-2 - YAML frontmatter with name and description fields
   163→ * AC: @claude-code-renderer-extended ac-1 - portable fields (license, allowed-tools)
   164→ * AC: @claude-code-renderer-extended ac-2 - user-invocable from platform_config
   165→ * AC: @claude-code-renderer-extended ac-3 - context and agent from platform_config
   166→ * AC: @claude-code-renderer-extended ac-4 - disable-model-invocation from platform_config
   167→ * AC: @claude-code-renderer-extended ac-5 - only portable fields when no platform_config
   168→ * AC: @claude-code-renderer-extended ac-8 - snake_case to kebab-case conversion
   169→ */
   170→export function generateFrontmatter(skill: LoadedSkill): string {
   171→  const frontmatter: Record<string, unknown> = {
   172→    name: skill.id,
   173→    description: skill.description || skill.name,
   174→  };
   175→
   176→  // AC: @claude-code-renderer-extended ac-1 - Add portable fields
   177→  if (skill.license) {
   178→    frontmatter.license = skill.license;
   179→  }
   180→  if (skill.allowed_tools && skill.allowed_tools.length > 0) {
   181→    frontmatter["allowed-tools"] = skill.allowed_tools;
   182→  }
   183→  if (skill.compatibility) {
   184→    frontmatter.compatibility = skill.compatibility;
   185→  }
   186→
   187→  // AC: @claude-code-renderer-extended ac-2, ac-3, ac-4 - Add Claude Code platform fields
   188→  const claudeCodeConfig = skill.platform_config?.claude_code;
   189→  if (claudeCodeConfig) {
   190→    // AC: @claude-code-renderer-extended ac-2 - user_invocable
   191→    if (claudeCodeConfig.user_invocable !== undefined) {
   192→      frontmatter["user-invocable"] = claudeCodeConfig.user_invocable;
   193→    }
   194→    // AC: @claude-code-renderer-extended ac-4 - disable_model_invocation
   195→    if (claudeCodeConfig.disable_model_invocation !== undefined) {
   196→      frontmatter["disable-model-invocation"] = claudeCodeConfig.disable_model_invocation;
   197→    }
   198→    // AC: @claude-code-renderer-extended ac-3 - context and agent
   199→    if (claudeCodeConfig.context) {
   200→      frontmatter.context = claudeCodeConfig.context;
   201→    }
   202→    if (claudeCodeConfig.agent) {
   203→      frontmatter.agent = claudeCodeConfig.agent;
   204→    }
   205→    // Other Claude Code fields
   206→    if (claudeCodeConfig.model) {
   207→      frontmatter.model = claudeCodeConfig.model;
   208→    }
   209→    if (claudeCodeConfig.argument_hint) {
   210→      frontmatter["argument-hint"] = claudeCodeConfig.argument_hint;
   211→    }
   212→  }
   213→
   214→  return `---\n${yaml.stringify(frontmatter).trim()}\n---`;
   215→}
   216→
   217→/**
   218→ * Get the target directory for rendered skills on main branch.
   219→ * Returns .claude/skills/<id>/ path.
   220→ */
   221→function getRenderedSkillPath(projectRoot: string, skillId: string): string {
   222→  return path.join(projectRoot, ".claude", "skills", skillId);
   223→}
   224→
   225→/**
   226→ * Check if two contents are equal (for idempotency check)
   227→ */
   228→function contentsEqual(a: string, b: string): boolean {
   229→  return a.trim() === b.trim();
   230→}
   231→
   232→/**
   233→ * Recursively copy a directory
   234→ */
   235→async function copyDirectory(src: string, dest: string): Promise<void> {
   236→  const entries = await fs.readdir(src, { withFileTypes: true });
   237→
   238→  for (const entry of entries) {
   239→    const srcPath = path.join(src, entry.name);
   240→    const destPath = path.join(dest, entry.name);
   241→
   242→    if (entry.isDirectory()) {
   243→      await fs.mkdir(destPath, { recursive: true });
   244→      await copyDirectory(srcPath, destPath);
   245→    } else {
   246→      await fs.copyFile(srcPath, destPath);
   247→    }
   248→  }
   249→}
   250→
   251→/**
   252→ * Compute SHA256 hash of content
   253→ * AC: @skill-drift-detection ac-5 - Hash computation for render tracking
   254→ */
   255→export function computeContentHash(content: string): string {
   256→  return crypto.createHash("sha256").update(content, "utf-8").digest("hex");
   257→}
   258→
   259→/**
   260→ * Get the path to the render hash file for a skill
   261→ * AC: @skill-drift-detection ac-5 - Hash stored in .kspec/skills/<id>/.render-hash
   262→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   263→ */
   264→export function getRenderHashPath(specDir: string, skillId: string): string {
   265→  return path.join(specDir, "skills", skillId, ".render-hash");
   266→}
   267→
   268→/**
   269→ * Read the stored render hash for a skill
   270→ * AC: @skill-drift-detection ac-5 - Read hash from .kspec/skills/<id>/.render-hash
   271→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   272→ */
   273→export async function readRenderHash(specDir: string, skillId: string): Promise<string | null> {
   274→  try {
   275→    const hashPath = getRenderHashPath(specDir, skillId);
   276→    const content = await fs.readFile(hashPath, "utf-8");
   277→    return content.trim();
   278→  } catch {
   279→    return null;
   280→  }
   281→}
   282→
   283→/**
   284→ * Write the render hash for a skill
   285→ * AC: @skill-drift-detection ac-5 - Store hash in .kspec/skills/<id>/.render-hash
   286→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   287→ */
   288→export async function writeRenderHash(specDir: string, skillId: string, hash: string): Promise<void> {
   289→  const hashPath = getRenderHashPath(specDir, skillId);
   290→  await fs.mkdir(path.dirname(hashPath), { recursive: true });
   291→  await fs.writeFile(hashPath, hash + "\n", "utf-8");
   292→}
   293→
   294→/**
   295→ * Check if a rendered skill has drifted from its last render
   296→ * AC: @skill-drift-detection ac-1, ac-2 - Drift detection via hash comparison
   297→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   298→ *
   299→ * Returns:
   300→ * - "not-rendered": Rendered file doesn't exist
   301→ * - "in-sync": Rendered file matches stored hash
   302→ * - "drifted": Rendered file differs from stored hash (manually edited)
   303→ * - "no-hash": Rendered file exists but no stored hash (first render or hash deleted)
   304→ */
   305→export async function checkSkillDrift(
   306→  specDir: string,
   307→  projectRoot: string,
   308→  skillId: string
   309→): Promise<"not-rendered" | "in-sync" | "drifted" | "no-hash"> {
   310→  const renderedPath = path.join(projectRoot, ".claude", "skills", skillId, "SKILL.md");
   311→
   312→  // Check if rendered file exists
   313→  let renderedContent: string;
   314→  try {
   315→    renderedContent = await fs.readFile(renderedPath, "utf-8");
   316→  } catch {
   317→    return "not-rendered";
   318→  }
   319→
   320→  // Get stored hash
   321→  const storedHash = await readRenderHash(specDir, skillId);
   322→  if (!storedHash) {
   323→    return "no-hash";
   324→  }
   325→
   326→  // Compare hashes
   327→  const currentHash = computeContentHash(renderedContent);
   328→  return currentHash === storedHash ? "in-sync" : "drifted";
   329→}
   330→
   331→/**
   332→ * Recursively check if two directories have the same contents
   333→ */
   334→async function directoriesEqual(src: string, dest: string): Promise<boolean> {
   335→  try {
   336→    const srcEntries = await fs.readdir(src, { withFileTypes: true });
   337→    const destEntries = await fs.readdir(dest, { withFileTypes: true });
   338→
   339→    // Different number of entries = not equal
   340→    if (srcEntries.length !== destEntries.length) {
   341→      return false;
   342→    }
   343→
   344→    // Create a map of dest entries for quick lookup
   345→    const destMap = new Map(destEntries.map((e) => [e.name, e]));
   346→
   347→    for (const srcEntry of srcEntries) {
   348→      const destEntry = destMap.get(srcEntry.name);
   349→      if (!destEntry) {
   350→        return false;
   351→      }
   352→
   353→      const srcPath = path.join(src, srcEntry.name);
   354→      const destPath = path.join(dest, srcEntry.name);
   355→
   356→      if (srcEntry.isDirectory() && destEntry.isDirectory()) {
   357→        if (!(await directoriesEqual(srcPath, destPath))) {
   358→          return false;
   359→        }
   360→      } else if (srcEntry.isFile() && destEntry.isFile()) {
   361→        const srcContent = await fs.readFile(srcPath, "utf-8");
   362→        const destContent = await fs.readFile(destPath, "utf-8");
   363→        if (!contentsEqual(srcContent, destContent)) {
   364→          return false;
   365→        }
   366→      } else {
   367→        // Type mismatch
   368→        return false;
   369→      }
   370→    }
   371→
   372→    return true;
   373→  } catch {
   374→    return false;
   375→  }
   376→}
   377→
   378→// ============================================================================
   379→// Supporting Directories (AC: @platform-renderer-trait ac-3, @claude-code-renderer-extended ac-7)
   380→// ============================================================================
   381→
   382→/** Known supporting directory names */
   383→const SUPPORTING_DIRS = ["references", "scripts", "assets", "docs"] as const;
   384→
   385→/**
   386→ * Copy supporting directories from source skill to rendered output
   387→ * AC: @platform-renderer-trait ac-3 - Supporting directories copied to platform output
   388→ * AC: @claude-code-renderer-extended ac-7 - references/, scripts/, assets/ copied
   389→ */
   390→async function copySupportingDirectories(
   391→  sourceSkillDir: string,
   392→  targetSkillDir: string,
   393→  dryRun: boolean
   394→): Promise<Record<string, "created" | "updated" | "unchanged" | "skipped">> {
   395→  const results: Record<string, "created" | "updated" | "unchanged" | "skipped"> = {};
   396→
   397→  for (const dirName of SUPPORTING_DIRS) {
   398→    const sourceDir = path.join(sourceSkillDir, dirName);
   399→    const targetDir = path.join(targetSkillDir, dirName);
   400→
   401→    try {
   402→      const stats = await fs.stat(sourceDir);
   403→      if (!stats.isDirectory()) {
   404→        results[dirName] = "skipped";
   405→        continue;
   406→      }
   407→
   408→      // Check if target exists
   409→      let targetExists = false;
   410→      try {
   411→        await fs.stat(targetDir);
   412→        targetExists = true;
   413→      } catch {
   414→        // Target doesn't exist
   415→      }
   416→
   417→      if (!targetExists) {
   418→        results[dirName] = "created";
   419→      } else {
   420→        // Compare directories
   421→        const equal = await directoriesEqual(sourceDir, targetDir);
   422→        results[dirName] = equal ? "unchanged" : "updated";
   423→      }
   424→
   425→      // Apply changes
   426→      if (!dryRun && results[dirName] !== "unchanged") {
   427→        if (targetExists) {
   428→          await fs.rm(targetDir, { recursive: true, force: true });
   429→        }
   430→        await fs.mkdir(targetDir, { recursive: true });
   431→        await copyDirectory(sourceDir, targetDir);
   432→      }
   433→    } catch {
   434→      // Source directory doesn't exist
   435→      results[dirName] = "skipped";
   436→    }
   437→  }
   438→
   439→  return results;
   440→}
   441→
   442→/**
   443→ * Render a skill to Claude Code format.
   444→ *
   445→ * Reads skill content from .kspec/skills/<id>/SKILL.md and writes to
   446→ * .claude/skills/<id>/SKILL.md with YAML frontmatter containing name and description.
   447→ *
   448→ * AC: @claude-code-renderer ac-1 - Creates .claude/skills/<id>/SKILL.md with YAML frontmatter
   449→ * AC: @claude-code-renderer ac-2 - YAML frontmatter has name and description fields
   450→ * AC: @claude-code-renderer ac-3 - Skill body content appears verbatim below frontmatter
   451→ * AC: @claude-code-renderer ac-4 - Files are written to disk as unstaged changes (no git commit)
   452→ *
   453→ * @param ctx - Kspec context with specDir pointing to .kspec/
   454→ * @param projectRoot - Root directory of the project (where .claude/ will be created)
   455→ * @param skill - The skill to render
   456→ * @param options - Render options (dryRun, etc.)
   457→ * @returns Result indicating what action was taken
   458→ */
   459→export async function renderClaudeCodeSkill(
   460→  ctx: KspecContext,
   461→  projectRoot: string,
   462→  skill: LoadedSkill,
   463→  options: RenderSkillOptions = {},
   464→): Promise<ClaudeCodeRenderResult> {
   465→  const dryRun = options.dryRun ?? false;
   466→  const storeHash = options.storeHash ?? false;
   467→  const targetDir = getRenderedSkillPath(projectRoot, skill.id);
   468→  const targetSkillMd = path.join(targetDir, "SKILL.md");
   469→
   470→  // AC: @claude-code-renderer ac-3 - Load source content verbatim
   471→  const sourceContent = await loadSkillContent(ctx, skill);
   472→
   473→  if (!sourceContent) {
   474→    // No source content, but skill exists in meta - create placeholder
   475→    const frontmatter = generateFrontmatter(skill);
   476→    const renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
   477→
   478→    // AC: @claude-code-renderer ac-4 - Write to disk (unstaged)
   479→    if (!dryRun) {
   480→      await fs.mkdir(targetDir, { recursive: true });
   481→      await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
   482→      // AC: @skill-drift-detection ac-5 - Store hash of rendered output
   483→      if (storeHash) {
   484→        const hash = computeContentHash(renderedContent);
   485→        await writeRenderHash(ctx.specDir, skill.id, hash);
   486→      }
   487→    }
   488→
   489→    return {
   490→      id: skill.id,
   491→      action: "created",
   492→      path: targetSkillMd,
   493→    };
   494→  }
   495→
   496→  // AC: @claude-code-renderer ac-2 - Generate frontmatter with name and description
   497→  const frontmatter = generateFrontmatter(skill);
   498→
   499→  // Check if source already has frontmatter - if so, strip it
   500→  const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
   501→  const contentWithoutFrontmatter = frontmatterMatch
   502→    ? sourceContent.slice(frontmatterMatch[0].length)
   503→    : sourceContent;
   504→
   505→  // AC: @claude-code-renderer ac-1, ac-3 - Build rendered content with frontmatter + verbatim body
   506→  const renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
   507→
   508→  // Check if target exists and compare for idempotency
   509→  let targetExists = false;
   510→  let targetContent = "";
   511→  try {
   512→    targetContent = await fs.readFile(targetSkillMd, "utf-8");
   513→    targetExists = true;
   514→  } catch {
   515→    // Target doesn't exist
   516→  }
   517→
   518→  // Determine action based on comparison
   519→  let action: "created" | "updated" | "unchanged";
   520→
   521→  if (!targetExists) {
   522→    action = "created";
   523→  } else if (contentsEqual(renderedContent, targetContent)) {
   524→    action = "unchanged";
   525→  } else {
   526→    action = "updated";
   527→  }
   528→
   529→  // AC: @claude-code-renderer ac-4 - Apply changes to disk (no git commit)
   530→  if (!dryRun && action !== "unchanged") {
   531→    await fs.mkdir(targetDir, { recursive: true });
   532→    await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
   533→    // AC: @skill-drift-detection ac-5 - Store hash of rendered output
   534→    if (storeHash) {
   535→      const hash = computeContentHash(renderedContent);
   536→      await writeRenderHash(ctx.specDir, skill.id, hash);
   537→    }
   538→  }
   539→
   540→  // AC: @claude-code-renderer-extended ac-7 - Copy supporting directories (references/, scripts/, assets/, docs/)
   541→  const sourceSkillDir = path.join(ctx.specDir, "skills", skill.id);
   542→  const supportingDirsAction = await copySupportingDirectories(
   543→    sourceSkillDir,
   544→    targetDir,
   545→    dryRun
   546→  );
   547→
   548→  // For backward compatibility, also expose docsAction
   549→  const docsAction = supportingDirsAction.docs || "skipped";
   550→
   551→  return {
   552→    id: skill.id,
   553→    action,
   554→    path: targetSkillMd,
   555→    docsAction,
   556→  };
   557→}
   558→
   559→/**
   560→ * Check if a skill directory is managed by kspec.
   561→ * Looks for the KSPEC_MANAGED_MARKER in the SKILL.md file.
   562→ */
   563→export async function isKspecManagedSkill(skillMdPath: string): Promise<boolean> {
   564→  try {
   565→    const content = await fs.readFile(skillMdPath, "utf-8");
   566→    return content.includes(KSPEC_MANAGED_MARKER);
   567→  } catch {
   568→    return false;
   569→  }
   570→}
   571→
   572→// ============================================================================
   573→// Per-Platform Hash Functions (AC: @platform-renderer-trait ac-6)
   574→// ============================================================================
   575→
   576→/**
   577→ * Get the path to the per-platform render hash file for a skill
   578→ * AC: @platform-renderer-trait ac-6 - Per-platform hash stored in .render-hash-<platform>
   579→ */
   580→export function getPlatformRenderHashPath(specDir: string, skillId: string, platform: string): string {
   581→  return path.join(specDir, "skills", skillId, `.render-hash-${platform}`);
   582→}
   583→
   584→/**
   585→ * Read the stored render hash for a skill on a specific platform
   586→ * AC: @platform-renderer-trait ac-6 - Read per-platform hash
   587→ * AC: @claude-code-renderer-extended ac-6 - fallback to legacy hash
   588→ */
   589→export async function readPlatformRenderHash(
   590→  specDir: string,
   591→  skillId: string,
   592→  platform: string
   593→): Promise<string | null> {
   594→  try {
   595→    const hashPath = getPlatformRenderHashPath(specDir, skillId, platform);
   596→    const content = await fs.readFile(hashPath, "utf-8");
   597→    return content.trim();
   598→  } catch {
   599→    // Fall back to legacy hash (non-platform-specific)
   600→    return readRenderHash(specDir, skillId);
   601→  }
   602→}
   603→
   604→/**
   605→ * Migrate legacy .render-hash to platform-specific .render-hash-<platform>
   606→ * AC: @claude-code-renderer-extended ac-6 - hash migration
   607→ */
   608→export async function migrateLegacyRenderHash(
   609→  specDir: string,
   610→  skillId: string,
   611→  platform: string
   612→): Promise<boolean> {
   613→  const legacyHashPath = getRenderHashPath(specDir, skillId);
   614→  const platformHashPath = getPlatformRenderHashPath(specDir, skillId, platform);
   615→
   616→  try {
   617→    // Check if platform-specific hash already exists
   618→    await fs.access(platformHashPath);
   619→    return false; // Already migrated
   620→  } catch {
   621→    // Platform-specific doesn't exist, check for legacy
   622→  }
   623→
   624→  try {
   625→    const legacyHash = await fs.readFile(legacyHashPath, "utf-8");
   626→    // Write to platform-specific location
   627→    await writePlatformRenderHash(specDir, skillId, platform, legacyHash.trim());
   628→    return true; // Migrated successfully
   629→  } catch {
   630→    return false; // No legacy hash to migrate
   631→  }
   632→}
   633→
   634→/**
   635→ * Write the render hash for a skill on a specific platform
   636→ * AC: @platform-renderer-trait ac-6 - Store per-platform hash in .render-hash-<platform>
   637→ */
   638→export async function writePlatformRenderHash(
   639→  specDir: string,
   640→  skillId: string,
   641→  platform: string,
   642→  hash: string
   643→): Promise<void> {
   644→  const hashPath = getPlatformRenderHashPath(specDir, skillId, platform);
   645→  await fs.mkdir(path.dirname(hashPath), { recursive: true });
   646→  await fs.writeFile(hashPath, hash + "\n", "utf-8");
   647→}
   648→
   649→/**
   650→ * Check if a rendered skill has drifted from its last render for a specific platform
   651→ * AC: @platform-renderer-trait ac-6 - Platform-specific drift detection
   652→ */
   653→export async function checkPlatformSkillDrift(
   654→  specDir: string,
   655→  projectRoot: string,
   656→  skillId: string,
   657→  platform: string,
   658→  outputDir?: string
   659→): Promise<DriftStatus> {
   660→  // Determine the output directory - use custom or platform default
   661→  const platformOutputDir = outputDir || getPlatformDefaultOutputDir(platform);
   662→  const renderedPath = path.join(projectRoot, platformOutputDir, skillId, "SKILL.md");
   663→
   664→  // Check if rendered file exists
   665→  let renderedContent: string;
   666→  try {
   667→    renderedContent = await fs.readFile(renderedPath, "utf-8");
   668→  } catch {
   669→    return "not-rendered";
   670→  }
   671→
   672→  // AC: @claude-code-renderer-extended ac-6 - Migrate legacy hash if needed
   673→  await migrateLegacyRenderHash(specDir, skillId, platform);
   674→
   675→  // Get stored hash (try platform-specific first, then fall back to legacy)
   676→  const storedHash = await readPlatformRenderHash(specDir, skillId, platform);
   677→  if (!storedHash) {
   678→    return "no-hash";
   679→  }
   680→
   681→  // Compare hashes
   682→  const currentHash = computeContentHash(renderedContent);
   683→  return currentHash === storedHash ? "in-sync" : "drifted";
   684→}
   685→
   686→/**
   687→ * Get the default output directory for a platform
   688→ */
   689→function getPlatformDefaultOutputDir(platform: string): string {
   690→  switch (platform) {
   691→    case "claude-code":
   692→      return ".claude/skills";
   693→    case "codex":
   694→      return ".agents/skills";
   695→    default:
   696→      return `.${platform}/skills`;
   697→  }
   698→}
   699→
   700→// ============================================================================
   701→// Claude Code Renderer (implements PlatformRenderer)
   702→// ============================================================================
   703→
   704→/**
   705→ * Claude Code platform renderer implementation
   706→ * AC: @platform-renderer-trait ac-1 through ac-6
   707→ */
   708→export const claudeCodeRenderer: PlatformRenderer = {
   709→  platform: "claude-code",
   710→  defaultOutputDir: ".claude/skills",
   711→
   712→  async render(
   713→    ctx: KspecContext,
   714→    projectRoot: string,
   715→    skill: LoadedSkill,
   716→    options: PlatformRenderOptions = {}
   717→  ): Promise<PlatformRenderResult> {
   718→    const dryRun = options.dryRun ?? false;
   719→    const storeHash = options.storeHash ?? false;
   720→    // AC: @platform-renderer-trait ac-5 - Custom outputDir support
   721→    const outputDir = options.outputDir || this.defaultOutputDir;
   722→
   723→    const targetDir = path.join(projectRoot, outputDir, skill.id);
   724→    const targetSkillMd = path.join(targetDir, "SKILL.md");
   725→    const paths: string[] = [];
   726→
   727→    // Load source content
   728→    const sourceContent = await loadSkillContent(ctx, skill);
   729→
   730→    let renderedContent: string;
   731→    if (!sourceContent) {
   732→      // No source content - create placeholder
   733→      const frontmatter = generateFrontmatter(skill);
   734→      renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
   735→    } else {
   736→      // Generate frontmatter and combine with content
   737→      const frontmatter = generateFrontmatter(skill);
   738→      const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
   739→      const contentWithoutFrontmatter = frontmatterMatch
   740→        ? sourceContent.slice(frontmatterMatch[0].length)
   741→        : sourceContent;
   742→      renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
   743→    }
   744→
   745→    // Check if target exists and compare for idempotency
   746→    let targetExists = false;
   747→    let targetContent = "";
   748→    try {
   749→      targetContent = await fs.readFile(targetSkillMd, "utf-8");
   750→      targetExists = true;
   751→    } catch {
   752→      // Target doesn't exist
   753→    }
   754→
   755→    // Determine action based on comparison
   756→    let action: "created" | "updated" | "unchanged" | "skipped";
   757→    if (!targetExists) {
   758→      action = "created";
   759→    } else if (contentsEqual(renderedContent, targetContent)) {
   760→      action = "unchanged";
   761→    } else {
   762→      action = "updated";
   763→    }
   764→
   765→    // AC: @platform-renderer-trait ac-4 - dryRun: no files written
   766→    // AC: @platform-renderer-trait ac-1 - Write platform-specific output
   767→    if (!dryRun && action !== "unchanged") {
   768→      await fs.mkdir(targetDir, { recursive: true });
   769→      await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
   770→    }
   771→
   772→    paths.push(targetSkillMd);
   773→
   774→    // AC: @platform-renderer-trait ac-6 - Store per-platform hash
   775→    if (!dryRun && storeHash && action !== "unchanged") {
   776→      const hash = computeContentHash(renderedContent);
   777→      await writePlatformRenderHash(ctx.specDir, skill.id, this.platform, hash);
   778→      // Also write legacy hash for backward compatibility
   779→      await writeRenderHash(ctx.specDir, skill.id, hash);
   780→    }
   781→
   782→    // AC: @platform-renderer-trait ac-3 - Copy supporting directories
   783→    const sourceSkillDir = path.join(ctx.specDir, "skills", skill.id);
   784→    const supportingDirsAction = await copySupportingDirectories(
   785→      sourceSkillDir,
   786→      targetDir,
   787→      dryRun
   788→    );
   789→
   790→    // Add supporting directory paths to output
   791→    for (const [dirName, dirAction] of Object.entries(supportingDirsAction)) {
   792→      if (dirAction !== "skipped") {
   793→        paths.push(path.join(targetDir, dirName));
   794→      }
   795→    }
   796→
   797→    return {
   798→      id: skill.id,
   799→      platform: this.platform,
   800→      action,
   801→      paths,
   802→      supportingDirsAction,
   803→    };
   804→  },
   805→
   806→  async checkDrift(
   807→    specDir: string,
   808→    projectRoot: string,
   809→    skillId: string,
   810→    options?: { outputDir?: string }
   811→  ): Promise<DriftStatus> {
   812→    return checkPlatformSkillDrift(
   813→      specDir,
   814→      projectRoot,
   815→      skillId,
   816→      this.platform,
   817→      options?.outputDir
   818→    );
   819→  },
   820→};
   821→
   822→// ============================================================================
   823→// Codex Renderer (implements PlatformRenderer)
   824→// AC: @codex-renderer ac-1 through ac-6
   825→// ============================================================================
   826→
   827→/**
   828→ * Generate minimal YAML frontmatter for Codex (name + description only)
   829→ * AC: @codex-renderer ac-1 - Codex frontmatter contains only name and description
   830→ */
   831→function generateCodexFrontmatter(skill: LoadedSkill): string {
   832→  const frontmatter: Record<string, unknown> = {
   833→    name: skill.id,
   834→    description: skill.description || skill.name,
   835→  };
   836→  return `---\n${yaml.stringify(frontmatter).trim()}\n---`;
   837→}
   838→
   839→/**
   840→ * Generate Codex sidecar openai.yaml content from platform_config.codex
   841→ * AC: @codex-renderer ac-2 - sidecar agents/openai.yaml with Codex config fields
   842→ */
   843→function generateCodexSidecarYaml(skill: LoadedSkill): string | null {
   844→  const codexConfig = skill.platform_config?.codex;
   845→  if (!codexConfig) {
   846→    return null;
   847→  }
   848→
   849→  // Build the sidecar structure per Codex docs
   850→  const sidecar: Record<string, unknown> = {};
   851→
   852→  // Interface section (display_name, short_description, icons, colors)
   853→  const interfaceSection: Record<string, unknown> = {};
   854→  if (codexConfig.display_name) {
   855→    interfaceSection.display_name = codexConfig.display_name;
   856→  }
   857→  if (codexConfig.short_description) {
   858→    interfaceSection.short_description = codexConfig.short_description;
   859→  }
   860→  if (codexConfig.icon_small) {
   861→    interfaceSection.icon_small = codexConfig.icon_small;
   862→  }
   863→  if (codexConfig.icon_large) {
   864→    interfaceSection.icon_large = codexConfig.icon_large;
   865→  }
   866→  if (codexConfig.brand_color) {
   867→    interfaceSection.brand_color = codexConfig.brand_color;
   868→  }
   869→  if (codexConfig.default_prompt) {
   870→    interfaceSection.default_prompt = codexConfig.default_prompt;
   871→  }
   872→  if (Object.keys(interfaceSection).length > 0) {
   873→    sidecar.interface = interfaceSection;
   874→  }
   875→
   876→  // Policy section (allow_implicit_invocation)
   877→  if (codexConfig.allow_implicit_invocation !== undefined) {
   878→    sidecar.policy = {
   879→      allow_implicit_invocation: codexConfig.allow_implicit_invocation,
   880→    };
   881→  }
   882→
   883→  // Only return content if there's something to write
   884→  if (Object.keys(sidecar).length === 0) {
   885→    return null;
   886→  }
   887→
   888→  return yaml.stringify(sidecar);
   889→}
   890→
   891→/**
   892→ * Codex platform renderer implementation
   893→ * AC: @codex-renderer ac-1 - Creates .agents/skills/<id>/SKILL.md with minimal frontmatter
   894→ * AC: @codex-renderer ac-2 - Creates sidecar agents/openai.yaml when platform_config.codex exists
   895→ * AC: @codex-renderer ac-3 - No sidecar created when no platform_config.codex
   896→ * AC: @codex-renderer ac-4 - Rendered file contains <!-- kspec-managed --> marker
   897→ * AC: @codex-renderer ac-5 - Supporting directories copied to output
   898→ * AC: @codex-renderer ac-6 - Hash written to .render-hash-codex
   899→ */
   900→export const codexRenderer: PlatformRenderer = {
   901→  platform: "codex",
   902→  defaultOutputDir: ".agents/skills",
   903→
   904→  async render(
   905→    ctx: KspecContext,
   906→    projectRoot: string,
   907→    skill: LoadedSkill,
   908→    options: PlatformRenderOptions = {}
   909→  ): Promise<PlatformRenderResult> {
   910→    const dryRun = options.dryRun ?? false;
   911→    const storeHash = options.storeHash ?? false;
   912→    // AC: @platform-renderer-trait ac-5 - Custom outputDir support
   913→    const outputDir = options.outputDir || this.defaultOutputDir;
   914→
   915→    const targetDir = path.join(projectRoot, outputDir, skill.id);
   916→    const targetSkillMd = path.join(targetDir, "SKILL.md");
   917→    const paths: string[] = [];
   918→
   919→    // Load source content
   920→    const sourceContent = await loadSkillContent(ctx, skill);
   921→
   922→    // AC: @codex-renderer ac-1 - Generate minimal frontmatter (name + description only)
   923→    const frontmatter = generateCodexFrontmatter(skill);
   924→
   925→    let renderedContent: string;
   926→    if (!sourceContent) {
   927→      // No source content - create placeholder
   928→      // AC: @codex-renderer ac-4 - Include kspec-managed marker
   929→      renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
   930→    } else {
   931→      // Strip any existing frontmatter and combine with generated
   932→      const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
   933→      const contentWithoutFrontmatter = frontmatterMatch
   934→        ? sourceContent.slice(frontmatterMatch[0].length)
   935→        : sourceContent;
   936→      // AC: @codex-renderer ac-4 - Include kspec-managed marker
   937→      renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
   938→    }
   939→
   940→    // Check if target exists and compare for idempotency
   941→    let targetExists = false;
   942→    let targetContent = "";
   943→    try {
   944→      targetContent = await fs.readFile(targetSkillMd, "utf-8");
   945→      targetExists = true;
   946→    } catch {
   947→      // Target doesn't exist
   948→    }
   949→
   950→    // Determine action based on comparison
   951→    let action: "created" | "updated" | "unchanged" | "skipped";
   952→    if (!targetExists) {
   953→      action = "created";
   954→    } else if (contentsEqual(renderedContent, targetContent)) {
   955→      action = "unchanged";
   956→    } else {
   957→      action = "updated";
   958→    }
   959→
   960→    // AC: @platform-renderer-trait ac-4 - dryRun: no files written
   961→    // AC: @platform-renderer-trait ac-1 - Write platform-specific output
   962→    if (!dryRun && action !== "unchanged") {
   963→      await fs.mkdir(targetDir, { recursive: true });
   964→      await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
   965→    }
   966→
   967→    paths.push(targetSkillMd);
   968→
   969→    // AC: @codex-renderer ac-2, ac-3 - Handle sidecar agents/openai.yaml
   970→    const sidecarContent = generateCodexSidecarYaml(skill);
   971→    const sidecarDir = path.join(targetDir, "agents");
   972→    const sidecarPath = path.join(sidecarDir, "openai.yaml");
   973→
   974→    if (sidecarContent) {
   975→      // Check existing sidecar
   976→      let sidecarExists = false;
   977→      let existingSidecar = "";
   978→      try {
   979→        existingSidecar = await fs.readFile(sidecarPath, "utf-8");
   980→        sidecarExists = true;
   981→      } catch {
   982→        // Doesn't exist
   983→      }
   984→
   985→      const sidecarAction = !sidecarExists
   986→        ? "created"
   987→        : contentsEqual(sidecarContent, existingSidecar)
   988→          ? "unchanged"
   989→          : "updated";
   990→
   991→      if (!dryRun && sidecarAction !== "unchanged") {
   992→        await fs.mkdir(sidecarDir, { recursive: true });
   993→        await fs.writeFile(sidecarPath, sidecarContent, "utf-8");
   994→      }
   995→
   996→      paths.push(sidecarPath);
   997→    }
   998→
   999→    // AC: @platform-renderer-trait ac-6 - Store per-platform hash
  1000→    // AC: @codex-renderer ac-6 - Hash written to .render-hash-codex
  1001→    if (!dryRun && storeHash && action !== "unchanged") {
  1002→      const hash = computeContentHash(renderedContent);
  1003→      await writePlatformRenderHash(ctx.specDir, skill.id, this.platform, hash);
  1004→    }
  1005→
  1006→    // AC: @platform-renderer-trait ac-3 - Copy supporting directories
  1007→    // AC: @codex-renderer ac-5 - Supporting directories copied
  1008→    const sourceSkillDir = path.join(ctx.specDir, "skills", skill.id);
  1009→    const supportingDirsAction = await copySupportingDirectories(
  1010→      sourceSkillDir,
  1011→      targetDir,
  1012→      dryRun
  1013→    );
  1014→
  1015→    // Add supporting directory paths to output
  1016→    for (const [dirName, dirAction] of Object.entries(supportingDirsAction)) {
  1017→      if (dirAction !== "skipped") {
  1018→        paths.push(path.join(targetDir, dirName));
  1019→      }
  1020→    }
  1021→
  1022→    return {
  1023→      id: skill.id,
  1024→      platform: this.platform,
  1025→      action,
  1026→      paths,
  1027→      supportingDirsAction,
  1028→    };
  1029→  },
  1030→
  1031→  async checkDrift(
  1032→    specDir: string,
  1033→    projectRoot: string,
  1034→    skillId: string,
  1035→    options?: { outputDir?: string }
  1036→  ): Promise<DriftStatus> {
  1037→    return checkPlatformSkillDrift(
  1038→      specDir,
  1039→      projectRoot,
  1040→      skillId,
  1041→      this.platform,
  1042→      options?.outputDir
  1043→    );
  1044→  },
  1045→};
  1046→
  1047→// ============================================================================
  1048→// Renderer Registry
  1049→// ============================================================================
  1050→
  1051→/** Map of platform name to renderer implementation */
  1052→const rendererRegistry: Map<string, PlatformRenderer> = new Map([
  1053→  ["claude-code", claudeCodeRenderer],
  1054→  ["codex", codexRenderer],
  1055→]);
  1056→
  1057→/**
  1058→ * Get the renderer for a specific platform
  1059→ */
  1060→export function getRenderer(platform: string): PlatformRenderer | undefined {
  1061→  return rendererRegistry.get(platform);
  1062→}
  1063→
  1064→/**
  1065→ * Get all registered renderers
  1066→ */
  1067→export function getAllRenderers(): PlatformRenderer[] {
  1068→  return Array.from(rendererRegistry.values());
  1069→}
  1070→
  1071→/**
  1072→ * Register a new platform renderer
  1073→ */
  1074→export function registerRenderer(renderer: PlatformRenderer): void {
  1075→  rendererRegistry.set(renderer.platform, renderer);
  1076→}
