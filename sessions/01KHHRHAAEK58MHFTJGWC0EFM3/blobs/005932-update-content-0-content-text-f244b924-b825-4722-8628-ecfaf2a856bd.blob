```
     1→/**
     2→ * Platform Skill Renderers
     3→ *
     4→ * Defines the contract for platform-specific skill renderers and provides
     5→ * the Claude Code implementation. Each renderer writes platform-specific output
     6→ * (SKILL.md with frontmatter, sidecar config files, supporting directories)
     7→ * to a configurable output directory.
     8→ *
     9→ * AC: @claude-code-renderer ac-1 - renderClaudeCodeSkill creates .claude/skills/<id>/SKILL.md with YAML frontmatter
    10→ * AC: @claude-code-renderer ac-2 - rendered output has YAML frontmatter delimiters with name and description fields
    11→ * AC: @claude-code-renderer ac-3 - skill body content appears verbatim below frontmatter
    12→ * AC: @claude-code-renderer ac-4 - rendered files appear as unstaged changes on main branch
    13→ *
    14→ * AC: @skill-drift-detection ac-1 - Skill shows as in-sync when not manually edited
    15→ * AC: @skill-drift-detection ac-2 - Skill shows as drifted when manually edited
    16→ * AC: @skill-drift-detection ac-5 - Render hash stored in .kspec/skills/<id>/.render-hash
    17→ *
    18→ * AC: @consolidate-skill-render ac-3 - hash/drift functions exported from this module
    19→ *
    20→ * AC: @platform-renderer-trait ac-1 - platform-specific output files written to configured output directory
    21→ * AC: @platform-renderer-trait ac-2 - PlatformRenderResult returned with id, platform, action, paths
    22→ * AC: @platform-renderer-trait ac-3 - supporting directories (references/, scripts/, assets/) copied
    23→ * AC: @platform-renderer-trait ac-4 - dryRun mode: no files written, result reflects what would happen
    24→ * AC: @platform-renderer-trait ac-5 - custom outputDir goes to custom path instead of platform default
    25→ * AC: @platform-renderer-trait ac-6 - per-platform render hash written to .render-hash-<platform>
    26→ */
    27→
    28→import * as crypto from "node:crypto";
    29→import * as fs from "node:fs/promises";
    30→import * as path from "node:path";
    31→import yaml from "yaml";
    32→import type { KspecContext } from "./yaml.js";
    33→import { loadSkillContent, type LoadedSkill } from "./meta.js";
    34→
    35→// ============================================================================
    36→// Platform Renderer Contract (AC: @platform-renderer-trait)
    37→// ============================================================================
    38→
    39→/**
    40→ * Status of drift detection for a rendered skill
    41→ * AC: @platform-renderer-trait ac-2
    42→ */
    43→export type DriftStatus = "not-rendered" | "in-sync" | "drifted" | "no-hash";
    44→
    45→/**
    46→ * Result of rendering a skill to a specific platform
    47→ * AC: @platform-renderer-trait ac-2
    48→ */
    49→export interface PlatformRenderResult {
    50→  /** Skill ID */
    51→  id: string;
    52→  /** Platform this result is for */
    53→  platform: string;
    54→  /** Action taken: created, updated, unchanged, or skipped */
    55→  action: "created" | "updated" | "unchanged" | "skipped";
    56→  /** Paths to all output files */
    57→  paths: string[];
    58→  /** Actions taken on supporting directories (references/, scripts/, assets/, docs/) */
    59→  supportingDirsAction?: Record<string, "created" | "updated" | "unchanged" | "skipped">;
    60→  /** Reason if action is skipped */
    61→  skipReason?: string;
    62→}
    63→
    64→/**
    65→ * Options for rendering a skill to a platform
    66→ * AC: @platform-renderer-trait ac-4, ac-5
    67→ */
    68→export interface PlatformRenderOptions {
    69→  /** If true, don't write files, just return what would be done */
    70→  dryRun?: boolean;
    71→  /** If true, store a hash of the rendered content for drift detection */
    72→  storeHash?: boolean;
    73→  /** Custom output directory (overrides platform default) */
    74→  outputDir?: string;
    75→}
    76→
    77→/**
    78→ * Contract for platform-specific skill renderers
    79→ * AC: @platform-renderer-trait ac-1, ac-2
    80→ */
    81→export interface PlatformRenderer {
    82→  /** Platform identifier (e.g., "claude-code", "codex") */
    83→  platform: string;
    84→  /** Default output directory relative to project root (e.g., ".claude/skills") */
    85→  defaultOutputDir: string;
    86→  /**
    87→   * Render a skill to platform-specific output
    88→   * AC: @platform-renderer-trait ac-1, ac-2, ac-3, ac-4, ac-5
    89→   */
    90→  render(
    91→    ctx: KspecContext,
    92→    projectRoot: string,
    93→    skill: LoadedSkill,
    94→    options?: PlatformRenderOptions
    95→  ): Promise<PlatformRenderResult>;
    96→  /**
    97→   * Check if a rendered skill has drifted from its source
    98→   * AC: @platform-renderer-trait ac-6
    99→   */
   100→  checkDrift(
   101→    specDir: string,
   102→    projectRoot: string,
   103→    skillId: string,
   104→    options?: { outputDir?: string }
   105→  ): Promise<DriftStatus>;
   106→}
   107→
   108→// ============================================================================
   109→// Backward Compatibility Types
   110→// ============================================================================
   111→
   112→/**
   113→ * Result of rendering a skill to Claude Code format
   114→ * @deprecated Use PlatformRenderResult instead
   115→ */
   116→export interface ClaudeCodeRenderResult {
   117→  /** Skill ID */
   118→  id: string;
   119→  /** Action taken: created, updated, or unchanged */
   120→  action: "created" | "updated" | "unchanged";
   121→  /** Path to the rendered SKILL.md file */
   122→  path: string;
   123→  /** Action taken on docs directory */
   124→  docsAction?: "created" | "updated" | "unchanged" | "skipped";
   125→}
   126→
   127→/**
   128→ * Options for rendering a skill
   129→ * @deprecated Use PlatformRenderOptions instead
   130→ */
   131→export interface RenderSkillOptions {
   132→  /** If true, don't write files, just return what would be done */
   133→  dryRun?: boolean;
   134→  /** If true, store a hash of the rendered content for drift detection */
   135→  storeHash?: boolean;
   136→  /** Custom output directory (overrides platform default) */
   137→  outputDir?: string;
   138→}
   139→
   140→/**
   141→ * Marker comment that identifies skill directories managed by kspec
   142→ */
   143→export const KSPEC_MANAGED_MARKER = "<!-- kspec-managed -->";
   144→
   145→/**
   146→ * Generate YAML frontmatter for a skill.
   147→ * AC: @claude-code-renderer ac-2 - YAML frontmatter with name and description fields
   148→ */
   149→export function generateFrontmatter(skill: LoadedSkill): string {
   150→  const frontmatter: Record<string, unknown> = {
   151→    name: skill.id,
   152→    description: skill.description || skill.name,
   153→  };
   154→  return `---\n${yaml.stringify(frontmatter).trim()}\n---`;
   155→}
   156→
   157→/**
   158→ * Get the target directory for rendered skills on main branch.
   159→ * Returns .claude/skills/<id>/ path.
   160→ */
   161→function getRenderedSkillPath(projectRoot: string, skillId: string): string {
   162→  return path.join(projectRoot, ".claude", "skills", skillId);
   163→}
   164→
   165→/**
   166→ * Check if two contents are equal (for idempotency check)
   167→ */
   168→function contentsEqual(a: string, b: string): boolean {
   169→  return a.trim() === b.trim();
   170→}
   171→
   172→/**
   173→ * Recursively copy a directory
   174→ */
   175→async function copyDirectory(src: string, dest: string): Promise<void> {
   176→  const entries = await fs.readdir(src, { withFileTypes: true });
   177→
   178→  for (const entry of entries) {
   179→    const srcPath = path.join(src, entry.name);
   180→    const destPath = path.join(dest, entry.name);
   181→
   182→    if (entry.isDirectory()) {
   183→      await fs.mkdir(destPath, { recursive: true });
   184→      await copyDirectory(srcPath, destPath);
   185→    } else {
   186→      await fs.copyFile(srcPath, destPath);
   187→    }
   188→  }
   189→}
   190→
   191→/**
   192→ * Compute SHA256 hash of content
   193→ * AC: @skill-drift-detection ac-5 - Hash computation for render tracking
   194→ */
   195→export function computeContentHash(content: string): string {
   196→  return crypto.createHash("sha256").update(content, "utf-8").digest("hex");
   197→}
   198→
   199→/**
   200→ * Get the path to the render hash file for a skill
   201→ * AC: @skill-drift-detection ac-5 - Hash stored in .kspec/skills/<id>/.render-hash
   202→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   203→ */
   204→export function getRenderHashPath(specDir: string, skillId: string): string {
   205→  return path.join(specDir, "skills", skillId, ".render-hash");
   206→}
   207→
   208→/**
   209→ * Read the stored render hash for a skill
   210→ * AC: @skill-drift-detection ac-5 - Read hash from .kspec/skills/<id>/.render-hash
   211→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   212→ */
   213→export async function readRenderHash(specDir: string, skillId: string): Promise<string | null> {
   214→  try {
   215→    const hashPath = getRenderHashPath(specDir, skillId);
   216→    const content = await fs.readFile(hashPath, "utf-8");
   217→    return content.trim();
   218→  } catch {
   219→    return null;
   220→  }
   221→}
   222→
   223→/**
   224→ * Write the render hash for a skill
   225→ * AC: @skill-drift-detection ac-5 - Store hash in .kspec/skills/<id>/.render-hash
   226→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   227→ */
   228→export async function writeRenderHash(specDir: string, skillId: string, hash: string): Promise<void> {
   229→  const hashPath = getRenderHashPath(specDir, skillId);
   230→  await fs.mkdir(path.dirname(hashPath), { recursive: true });
   231→  await fs.writeFile(hashPath, hash + "\n", "utf-8");
   232→}
   233→
   234→/**
   235→ * Check if a rendered skill has drifted from its last render
   236→ * AC: @skill-drift-detection ac-1, ac-2 - Drift detection via hash comparison
   237→ * AC: @consolidate-skill-render ac-3 - exported from skill-render.ts
   238→ *
   239→ * Returns:
   240→ * - "not-rendered": Rendered file doesn't exist
   241→ * - "in-sync": Rendered file matches stored hash
   242→ * - "drifted": Rendered file differs from stored hash (manually edited)
   243→ * - "no-hash": Rendered file exists but no stored hash (first render or hash deleted)
   244→ */
   245→export async function checkSkillDrift(
   246→  specDir: string,
   247→  projectRoot: string,
   248→  skillId: string
   249→): Promise<"not-rendered" | "in-sync" | "drifted" | "no-hash"> {
   250→  const renderedPath = path.join(projectRoot, ".claude", "skills", skillId, "SKILL.md");
   251→
   252→  // Check if rendered file exists
   253→  let renderedContent: string;
   254→  try {
   255→    renderedContent = await fs.readFile(renderedPath, "utf-8");
   256→  } catch {
   257→    return "not-rendered";
   258→  }
   259→
   260→  // Get stored hash
   261→  const storedHash = await readRenderHash(specDir, skillId);
   262→  if (!storedHash) {
   263→    return "no-hash";
   264→  }
   265→
   266→  // Compare hashes
   267→  const currentHash = computeContentHash(renderedContent);
   268→  return currentHash === storedHash ? "in-sync" : "drifted";
   269→}
   270→
   271→/**
   272→ * Recursively check if two directories have the same contents
   273→ */
   274→async function directoriesEqual(src: string, dest: string): Promise<boolean> {
   275→  try {
   276→    const srcEntries = await fs.readdir(src, { withFileTypes: true });
   277→    const destEntries = await fs.readdir(dest, { withFileTypes: true });
   278→
   279→    // Different number of entries = not equal
   280→    if (srcEntries.length !== destEntries.length) {
   281→      return false;
   282→    }
   283→
   284→    // Create a map of dest entries for quick lookup
   285→    const destMap = new Map(destEntries.map((e) => [e.name, e]));
   286→
   287→    for (const srcEntry of srcEntries) {
   288→      const destEntry = destMap.get(srcEntry.name);
   289→      if (!destEntry) {
   290→        return false;
   291→      }
   292→
   293→      const srcPath = path.join(src, srcEntry.name);
   294→      const destPath = path.join(dest, srcEntry.name);
   295→
   296→      if (srcEntry.isDirectory() && destEntry.isDirectory()) {
   297→        if (!(await directoriesEqual(srcPath, destPath))) {
   298→          return false;
   299→        }
   300→      } else if (srcEntry.isFile() && destEntry.isFile()) {
   301→        const srcContent = await fs.readFile(srcPath, "utf-8");
   302→        const destContent = await fs.readFile(destPath, "utf-8");
   303→        if (!contentsEqual(srcContent, destContent)) {
   304→          return false;
   305→        }
   306→      } else {
   307→        // Type mismatch
   308→        return false;
   309→      }
   310→    }
   311→
   312→    return true;
   313→  } catch {
   314→    return false;
   315→  }
   316→}
   317→
   318→/**
   319→ * Render a skill to Claude Code format.
   320→ *
   321→ * Reads skill content from .kspec/skills/<id>/SKILL.md and writes to
   322→ * .claude/skills/<id>/SKILL.md with YAML frontmatter containing name and description.
   323→ *
   324→ * AC: @claude-code-renderer ac-1 - Creates .claude/skills/<id>/SKILL.md with YAML frontmatter
   325→ * AC: @claude-code-renderer ac-2 - YAML frontmatter has name and description fields
   326→ * AC: @claude-code-renderer ac-3 - Skill body content appears verbatim below frontmatter
   327→ * AC: @claude-code-renderer ac-4 - Files are written to disk as unstaged changes (no git commit)
   328→ *
   329→ * @param ctx - Kspec context with specDir pointing to .kspec/
   330→ * @param projectRoot - Root directory of the project (where .claude/ will be created)
   331→ * @param skill - The skill to render
   332→ * @param options - Render options (dryRun, etc.)
   333→ * @returns Result indicating what action was taken
   334→ */
   335→export async function renderClaudeCodeSkill(
   336→  ctx: KspecContext,
   337→  projectRoot: string,
   338→  skill: LoadedSkill,
   339→  options: RenderSkillOptions = {},
   340→): Promise<ClaudeCodeRenderResult> {
   341→  const dryRun = options.dryRun ?? false;
   342→  const storeHash = options.storeHash ?? false;
   343→  const targetDir = getRenderedSkillPath(projectRoot, skill.id);
   344→  const targetSkillMd = path.join(targetDir, "SKILL.md");
   345→
   346→  // AC: @claude-code-renderer ac-3 - Load source content verbatim
   347→  const sourceContent = await loadSkillContent(ctx, skill);
   348→
   349→  if (!sourceContent) {
   350→    // No source content, but skill exists in meta - create placeholder
   351→    const frontmatter = generateFrontmatter(skill);
   352→    const renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
   353→
   354→    // AC: @claude-code-renderer ac-4 - Write to disk (unstaged)
   355→    if (!dryRun) {
   356→      await fs.mkdir(targetDir, { recursive: true });
   357→      await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
   358→      // AC: @skill-drift-detection ac-5 - Store hash of rendered output
   359→      if (storeHash) {
   360→        const hash = computeContentHash(renderedContent);
   361→        await writeRenderHash(ctx.specDir, skill.id, hash);
   362→      }
   363→    }
   364→
   365→    return {
   366→      id: skill.id,
   367→      action: "created",
   368→      path: targetSkillMd,
   369→    };
   370→  }
   371→
   372→  // AC: @claude-code-renderer ac-2 - Generate frontmatter with name and description
   373→  const frontmatter = generateFrontmatter(skill);
   374→
   375→  // Check if source already has frontmatter - if so, strip it
   376→  const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
   377→  const contentWithoutFrontmatter = frontmatterMatch
   378→    ? sourceContent.slice(frontmatterMatch[0].length)
   379→    : sourceContent;
   380→
   381→  // AC: @claude-code-renderer ac-1, ac-3 - Build rendered content with frontmatter + verbatim body
   382→  const renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
   383→
   384→  // Check if target exists and compare for idempotency
   385→  let targetExists = false;
   386→  let targetContent = "";
   387→  try {
   388→    targetContent = await fs.readFile(targetSkillMd, "utf-8");
   389→    targetExists = true;
   390→  } catch {
   391→    // Target doesn't exist
   392→  }
   393→
   394→  // Determine action based on comparison
   395→  let action: "created" | "updated" | "unchanged";
   396→
   397→  if (!targetExists) {
   398→    action = "created";
   399→  } else if (contentsEqual(renderedContent, targetContent)) {
   400→    action = "unchanged";
   401→  } else {
   402→    action = "updated";
   403→  }
   404→
   405→  // AC: @claude-code-renderer ac-4 - Apply changes to disk (no git commit)
   406→  if (!dryRun && action !== "unchanged") {
   407→    await fs.mkdir(targetDir, { recursive: true });
   408→    await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
   409→    // AC: @skill-drift-detection ac-5 - Store hash of rendered output
   410→    if (storeHash) {
   411→      const hash = computeContentHash(renderedContent);
   412→      await writeRenderHash(ctx.specDir, skill.id, hash);
   413→    }
   414→  }
   415→
   416→  // Handle docs directory
   417→  const sourceDocsDir = path.join(ctx.specDir, "skills", skill.id, "docs");
   418→  const targetDocsDir = path.join(targetDir, "docs");
   419→  let docsAction: "created" | "updated" | "unchanged" | "skipped" = "skipped";
   420→
   421→  try {
   422→    const stats = await fs.stat(sourceDocsDir);
   423→    if (stats.isDirectory()) {
   424→      // Check if target docs exist and compare
   425→      let targetDocsExist = false;
   426→      try {
   427→        await fs.stat(targetDocsDir);
   428→        targetDocsExist = true;
   429→      } catch {
   430→        // Target docs don't exist
   431→      }
   432→
   433→      if (!targetDocsExist) {
   434→        docsAction = "created";
   435→      } else {
   436→        // Compare directories
   437→        const equal = await directoriesEqual(sourceDocsDir, targetDocsDir);
   438→        docsAction = equal ? "unchanged" : "updated";
   439→      }
   440→
   441→      // Apply changes
   442→      if (!dryRun && docsAction !== "unchanged") {
   443→        // Remove existing docs and copy fresh
   444→        if (targetDocsExist) {
   445→          await fs.rm(targetDocsDir, { recursive: true, force: true });
   446→        }
   447→        await fs.mkdir(targetDocsDir, { recursive: true });
   448→        await copyDirectory(sourceDocsDir, targetDocsDir);
   449→      }
   450→    }
   451→  } catch {
   452→    // No source docs directory
   453→  }
   454→
   455→  return {
   456→    id: skill.id,
   457→    action,
   458→    path: targetSkillMd,
   459→    docsAction,
   460→  };
   461→}
   462→
   463→/**
   464→ * Check if a skill directory is managed by kspec.
   465→ * Looks for the KSPEC_MANAGED_MARKER in the SKILL.md file.
   466→ */
   467→export async function isKspecManagedSkill(skillMdPath: string): Promise<boolean> {
   468→  try {
   469→    const content = await fs.readFile(skillMdPath, "utf-8");
   470→    return content.includes(KSPEC_MANAGED_MARKER);
   471→  } catch {
   472→    return false;
   473→  }
   474→}
   475→
   476→// ============================================================================
   477→// Per-Platform Hash Functions (AC: @platform-renderer-trait ac-6)
   478→// ============================================================================
   479→
   480→/**
   481→ * Get the path to the per-platform render hash file for a skill
   482→ * AC: @platform-renderer-trait ac-6 - Per-platform hash stored in .render-hash-<platform>
   483→ */
   484→export function getPlatformRenderHashPath(specDir: string, skillId: string, platform: string): string {
   485→  return path.join(specDir, "skills", skillId, `.render-hash-${platform}`);
   486→}
   487→
   488→/**
   489→ * Read the stored render hash for a skill on a specific platform
   490→ * AC: @platform-renderer-trait ac-6 - Read per-platform hash
   491→ */
   492→export async function readPlatformRenderHash(
   493→  specDir: string,
   494→  skillId: string,
   495→  platform: string
   496→): Promise<string | null> {
   497→  try {
   498→    const hashPath = getPlatformRenderHashPath(specDir, skillId, platform);
   499→    const content = await fs.readFile(hashPath, "utf-8");
   500→    return content.trim();
   501→  } catch {
   502→    // Fall back to legacy hash (non-platform-specific)
   503→    return readRenderHash(specDir, skillId);
   504→  }
   505→}
   506→
   507→/**
   508→ * Write the render hash for a skill on a specific platform
   509→ * AC: @platform-renderer-trait ac-6 - Store per-platform hash in .render-hash-<platform>
   510→ */
   511→export async function writePlatformRenderHash(
   512→  specDir: string,
   513→  skillId: string,
   514→  platform: string,
   515→  hash: string
   516→): Promise<void> {
   517→  const hashPath = getPlatformRenderHashPath(specDir, skillId, platform);
   518→  await fs.mkdir(path.dirname(hashPath), { recursive: true });
   519→  await fs.writeFile(hashPath, hash + "\n", "utf-8");
   520→}
   521→
   522→/**
   523→ * Check if a rendered skill has drifted from its last render for a specific platform
   524→ * AC: @platform-renderer-trait ac-6 - Platform-specific drift detection
   525→ */
   526→export async function checkPlatformSkillDrift(
   527→  specDir: string,
   528→  projectRoot: string,
   529→  skillId: string,
   530→  platform: string,
   531→  outputDir?: string
   532→): Promise<DriftStatus> {
   533→  // Determine the output directory - use custom or platform default
   534→  const platformOutputDir = outputDir || getPlatformDefaultOutputDir(platform);
   535→  const renderedPath = path.join(projectRoot, platformOutputDir, skillId, "SKILL.md");
   536→
   537→  // Check if rendered file exists
   538→  let renderedContent: string;
   539→  try {
   540→    renderedContent = await fs.readFile(renderedPath, "utf-8");
   541→  } catch {
   542→    return "not-rendered";
   543→  }
   544→
   545→  // Get stored hash (try platform-specific first, then fall back to legacy)
   546→  const storedHash = await readPlatformRenderHash(specDir, skillId, platform);
   547→  if (!storedHash) {
   548→    return "no-hash";
   549→  }
   550→
   551→  // Compare hashes
   552→  const currentHash = computeContentHash(renderedContent);
   553→  return currentHash === storedHash ? "in-sync" : "drifted";
   554→}
   555→
   556→/**
   557→ * Get the default output directory for a platform
   558→ */
   559→function getPlatformDefaultOutputDir(platform: string): string {
   560→  switch (platform) {
   561→    case "claude-code":
   562→      return ".claude/skills";
   563→    case "codex":
   564→      return ".agents/skills";
   565→    default:
   566→      return `.${platform}/skills`;
   567→  }
   568→}
   569→
   570→// ============================================================================
   571→// Supporting Directories (AC: @platform-renderer-trait ac-3)
   572→// ============================================================================
   573→
   574→/** Known supporting directory names */
   575→const SUPPORTING_DIRS = ["references", "scripts", "assets", "docs"] as const;
   576→
   577→/**
   578→ * Copy supporting directories from source skill to rendered output
   579→ * AC: @platform-renderer-trait ac-3 - Supporting directories copied to platform output
   580→ */
   581→async function copySupportingDirectories(
   582→  sourceSkillDir: string,
   583→  targetSkillDir: string,
   584→  dryRun: boolean
   585→): Promise<Record<string, "created" | "updated" | "unchanged" | "skipped">> {
   586→  const results: Record<string, "created" | "updated" | "unchanged" | "skipped"> = {};
   587→
   588→  for (const dirName of SUPPORTING_DIRS) {
   589→    const sourceDir = path.join(sourceSkillDir, dirName);
   590→    const targetDir = path.join(targetSkillDir, dirName);
   591→
   592→    try {
   593→      const stats = await fs.stat(sourceDir);
   594→      if (!stats.isDirectory()) {
   595→        results[dirName] = "skipped";
   596→        continue;
   597→      }
   598→
   599→      // Check if target exists
   600→      let targetExists = false;
   601→      try {
   602→        await fs.stat(targetDir);
   603→        targetExists = true;
   604→      } catch {
   605→        // Target doesn't exist
   606→      }
   607→
   608→      if (!targetExists) {
   609→        results[dirName] = "created";
   610→      } else {
   611→        // Compare directories
   612→        const equal = await directoriesEqual(sourceDir, targetDir);
   613→        results[dirName] = equal ? "unchanged" : "updated";
   614→      }
   615→
   616→      // Apply changes
   617→      if (!dryRun && results[dirName] !== "unchanged") {
   618→        if (targetExists) {
   619→          await fs.rm(targetDir, { recursive: true, force: true });
   620→        }
   621→        await fs.mkdir(targetDir, { recursive: true });
   622→        await copyDirectory(sourceDir, targetDir);
   623→      }
   624→    } catch {
   625→      // Source directory doesn't exist
   626→      results[dirName] = "skipped";
   627→    }
   628→  }
   629→
   630→  return results;
   631→}
   632→
   633→// ============================================================================
   634→// Claude Code Renderer (implements PlatformRenderer)
   635→// ============================================================================
   636→
   637→/**
   638→ * Claude Code platform renderer implementation
   639→ * AC: @platform-renderer-trait ac-1 through ac-6
   640→ */
   641→export const claudeCodeRenderer: PlatformRenderer = {
   642→  platform: "claude-code",
   643→  defaultOutputDir: ".claude/skills",
   644→
   645→  async render(
   646→    ctx: KspecContext,
   647→    projectRoot: string,
   648→    skill: LoadedSkill,
   649→    options: PlatformRenderOptions = {}
   650→  ): Promise<PlatformRenderResult> {
   651→    const dryRun = options.dryRun ?? false;
   652→    const storeHash = options.storeHash ?? false;
   653→    // AC: @platform-renderer-trait ac-5 - Custom outputDir support
   654→    const outputDir = options.outputDir || this.defaultOutputDir;
   655→
   656→    const targetDir = path.join(projectRoot, outputDir, skill.id);
   657→    const targetSkillMd = path.join(targetDir, "SKILL.md");
   658→    const paths: string[] = [];
   659→
   660→    // Load source content
   661→    const sourceContent = await loadSkillContent(ctx, skill);
   662→
   663→    let renderedContent: string;
   664→    if (!sourceContent) {
   665→      // No source content - create placeholder
   666→      const frontmatter = generateFrontmatter(skill);
   667→      renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n\n# ${skill.name}\n\n${skill.description || ""}\n`;
   668→    } else {
   669→      // Generate frontmatter and combine with content
   670→      const frontmatter = generateFrontmatter(skill);
   671→      const frontmatterMatch = sourceContent.match(/^---\n[\s\S]*?\n---\n?/);
   672→      const contentWithoutFrontmatter = frontmatterMatch
   673→        ? sourceContent.slice(frontmatterMatch[0].length)
   674→        : sourceContent;
   675→      renderedContent = `${frontmatter}\n${KSPEC_MANAGED_MARKER}\n${contentWithoutFrontmatter}`;
   676→    }
   677→
   678→    // Check if target exists and compare for idempotency
   679→    let targetExists = false;
   680→    let targetContent = "";
   681→    try {
   682→      targetContent = await fs.readFile(targetSkillMd, "utf-8");
   683→      targetExists = true;
   684→    } catch {
   685→      // Target doesn't exist
   686→    }
   687→
   688→    // Determine action based on comparison
   689→    let action: "created" | "updated" | "unchanged" | "skipped";
   690→    if (!targetExists) {
   691→      action = "created";
   692→    } else if (contentsEqual(renderedContent, targetContent)) {
   693→      action = "unchanged";
   694→    } else {
   695→      action = "updated";
   696→    }
   697→
   698→    // AC: @platform-renderer-trait ac-4 - dryRun: no files written
   699→    // AC: @platform-renderer-trait ac-1 - Write platform-specific output
   700→    if (!dryRun && action !== "unchanged") {
   701→      await fs.mkdir(targetDir, { recursive: true });
   702→      await fs.writeFile(targetSkillMd, renderedContent, "utf-8");
   703→    }
   704→
   705→    paths.push(targetSkillMd);
   706→
   707→    // AC: @platform-renderer-trait ac-6 - Store per-platform hash
   708→    if (!dryRun && storeHash && action !== "unchanged") {
   709→      const hash = computeContentHash(renderedContent);
   710→      await writePlatformRenderHash(ctx.specDir, skill.id, this.platform, hash);
   711→      // Also write legacy hash for backward compatibility
   712→      await writeRenderHash(ctx.specDir, skill.id, hash);
   713→    }
   714→
   715→    // AC: @platform-renderer-trait ac-3 - Copy supporting directories
   716→    const sourceSkillDir = path.join(ctx.specDir, "skills", skill.id);
   717→    const supportingDirsAction = await copySupportingDirectories(
   718→      sourceSkillDir,
   719→      targetDir,
   720→      dryRun
   721→    );
   722→
   723→    // Add supporting directory paths to output
   724→    for (const [dirName, dirAction] of Object.entries(supportingDirsAction)) {
   725→      if (dirAction !== "skipped") {
   726→        paths.push(path.join(targetDir, dirName));
   727→      }
   728→    }
   729→
   730→    return {
   731→      id: skill.id,
   732→      platform: this.platform,
   733→      action,
   734→      paths,
   735→      supportingDirsAction,
   736→    };
   737→  },
   738→
   739→  async checkDrift(
   740→    specDir: string,
   741→    projectRoot: string,
   742→    skillId: string,
   743→    options?: { outputDir?: string }
   744→  ): Promise<DriftStatus> {
   745→    return checkPlatformSkillDrift(
   746→      specDir,
   747→      projectRoot,
   748→      skillId,
   749→      this.platform,
   750→      options?.outputDir
   751→    );
   752→  },
   753→};
   754→
   755→// ============================================================================
   756→// Renderer Registry
   757→// ============================================================================
   758→
   759→/** Map of platform name to renderer implementation */
   760→const rendererRegistry: Map<string, PlatformRenderer> = new Map([
   761→  ["claude-code", claudeCodeRenderer],
   762→]);
   763→
   764→/**
   765→ * Get the renderer for a specific platform
   766→ */
   767→export function getRenderer(platform: string): PlatformRenderer | undefined {
   768→  return rendererRegistry.get(platform);
   769→}
   770→
   771→/**
   772→ * Get all registered renderers
   773→ */
   774→export function getAllRenderers(): PlatformRenderer[] {
   775→  return Array.from(rendererRegistry.values());
   776→}
   777→
   778→/**
   779→ * Register a new platform renderer
   780→ */
   781→export function registerRenderer(renderer: PlatformRenderer): void {
   782→  rendererRegistry.set(renderer.platform, renderer);
   783→}
   784→

