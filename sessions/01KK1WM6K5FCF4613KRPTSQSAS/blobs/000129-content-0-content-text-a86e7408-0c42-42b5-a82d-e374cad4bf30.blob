   461→				});
   462→			});
   463→			await page.route('**/api/tasks?*', (route) => {
   464→				route.fulfill({
   465→					status: 500,
   466→					contentType: 'application/json',
   467→					body: JSON.stringify({ error: 'internal_error' })
   468→				});
   469→			});
   470→
   471→			await page.goto('/validate');
   472→
   473→			// Error state should appear
