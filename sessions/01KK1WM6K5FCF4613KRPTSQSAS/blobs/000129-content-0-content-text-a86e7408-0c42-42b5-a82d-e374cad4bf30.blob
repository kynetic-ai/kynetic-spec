     1→/**
     2→ * E2E Tests for Validation and Alignment View
     3→ *
     4→ * Tests verify the /validate page renders validation summary, alignment stats,
     5→ * and issues list grouped by severity.
     6→ *
     7→ * Covered ACs:
     8→ * - @ui-validation-view ac-1: Summary shows error count, warning count, valid item count.
     9→ *   Alignment section shows spec coverage %, AC coverage %, orphaned tasks/specs counts.
    10→ *   Issues list grouped by severity.
    11→ */
    12→
    13→import { test, expect } from '../fixtures/test-base';
    14→
    15→/** Mock validation response with issues. */
    16→function mockValidationWithIssues() {
    17→	return {
    18→		valid: false,
    19→		schemaErrors: [
    20→			{
    21→				file: 'modules/broken.yaml',
    22→				path: 'features[0]',
    23→				message: 'Invalid schema: missing required field "title"'
    24→			}
    25→		],
    26→		refErrors: [
    27→			{
    28→				ref: '@nonexistent',
    29→				sourceFile: 'modules/core.yaml',
    30→				field: 'spec_ref',
    31→				error: 'not_found',
    32→				message: 'Reference @nonexistent not found'
    33→			}
    34→		],
    35→		refWarnings: [
    36→			{
    37→				ref: '@deprecated-item',
    38→				sourceFile: 'modules/core.yaml',
    39→				field: 'implements',
    40→				warning: 'deprecated_target',
    41→				message: 'Reference @deprecated-item targets a deprecated item'
    42→			}
    43→		],
    44→		orphans: [
    45→			{
    46→				ulid: '01KTEST000000000ORPHAN0001',
    47→				title: 'Orphan requirement',
    48→				type: 'requirement',
    49→				file: 'modules/orphan.yaml'
    50→			}
    51→		],
    52→		completenessWarnings: [
    53→			{
    54→				type: 'missing_acceptance_criteria',
    55→				itemRef: '@some-feature',
    56→				itemTitle: 'Some Feature',
    57→				message: 'Item @some-feature has no acceptance criteria'
    58→			},
    59→			{
    60→				type: 'missing_test_coverage',
    61→				subtype: 'own_ac',
    62→				itemRef: '@test-feature',
    63→				itemTitle: 'Test Feature',
    64→				message: 'Item @test-feature has 1 AC(s) without test coverage',
    65→				details: 'Uncovered: ac-2'
    66→			}
    67→		],
    68→		traitCycles: []
    69→	};
    70→}
    71→
    72→/** Mock validation response with no issues. */
    73→function mockValidationClean() {
    74→	return {
    75→		valid: true,
    76→		schemaErrors: [],
    77→		refErrors: [],
    78→		refWarnings: [],
    79→		orphans: [],
    80→		completenessWarnings: [],
    81→		traitCycles: []
    82→	};
    83→}
    84→
    85→/** Mock alignment response. */
    86→function mockAlignment() {
    87→	return {
    88→		stats: {
    89→			totalSpecs: 10,
    90→			specsWithTasks: 7,
    91→			alignedSpecs: 5,
    92→			orphanedSpecs: 3
    93→		},
    94→		warnings: [
    95→			{
    96→				type: 'orphaned_spec',
    97→				specUlid: '01KTEST000000000ORPHSPEC01',
    98→				specTitle: 'Unimplemented Feature',
    99→				message: 'Spec item "Unimplemented Feature" has no implementing tasks'
   100→			},
   101→			{
   102→				type: 'status_mismatch',
   103→				specUlid: '01KTEST000000000MISMATCH1',
   104→				specTitle: 'Misaligned Feature',
   105→				message:
   106→					'Spec "Misaligned Feature" status is "not_started" but should be "in_progress"'
   107→			}
   108→		]
   109→	};
   110→}
   111→
   112→/** Mock items response (with acceptance_criteria_count for AC coverage calculation). */
   113→function mockItems() {
   114→	// Total ACs: 3+2+1+2+3+1+2+1+3+2 = 20 ACs across 10 items
   115→	return {
   116→		items: [
   117→			{ _ulid: '01KTEST000000000000ITEM001', title: 'Item 1', acceptance_criteria_count: 3 },
   118→			{ _ulid: '01KTEST000000000000ITEM002', title: 'Item 2', acceptance_criteria_count: 2 },
   119→			{ _ulid: '01KTEST000000000000ITEM003', title: 'Item 3', acceptance_criteria_count: 1 },
   120→			{ _ulid: '01KTEST000000000000ITEM004', title: 'Item 4', acceptance_criteria_count: 2 },
   121→			{ _ulid: '01KTEST000000000000ITEM005', title: 'Item 5', acceptance_criteria_count: 3 },
   122→			{ _ulid: '01KTEST000000000000ITEM006', title: 'Item 6', acceptance_criteria_count: 1 },
   123→			{ _ulid: '01KTEST000000000000ITEM007', title: 'Item 7', acceptance_criteria_count: 2 },
   124→			{ _ulid: '01KTEST000000000000ITEM008', title: 'Item 8', acceptance_criteria_count: 1 },
   125→			{ _ulid: '01KTEST000000000000ITEM009', title: 'Item 9', acceptance_criteria_count: 3 },
   126→			{ _ulid: '01KTEST000000000000ITEM010', title: 'Item 10', acceptance_criteria_count: 2 }
   127→		],
   128→		total: 10,
   129→		offset: 0,
   130→		limit: 999
   131→	};
   132→}
   133→
   134→/** Mock tasks response (for orphaned task count). */
   135→function mockTasks() {
   136→	return {
   137→		items: [
   138→			{
   139→				_ulid: '01KTEST000000000000TASK001',
   140→				title: 'Task with spec',
   141→				status: 'pending',
   142→				priority: 2,
   143→				spec_ref: '@test-feature',
   144→				tags: [],
   145→				depends_on: [],
   146→				created_at: '2026-01-01T00:00:00Z',
   147→				notes_count: 0
   148→			},
   149→			{
   150→				_ulid: '01KTEST000000000000TASK002',
   151→				title: 'Task without spec',
   152→				status: 'in_progress',
   153→				priority: 3,
   154→				tags: [],
   155→				depends_on: [],
   156→				created_at: '2026-01-01T00:00:00Z',
   157→				notes_count: 0
   158→			},
   159→			{
   160→				_ulid: '01KTEST000000000000TASK003',
   161→				title: 'Another orphan task',
   162→				status: 'pending',
   163→				priority: 1,
   164→				tags: [],
   165→				depends_on: [],
   166→				created_at: '2026-01-01T00:00:00Z',
   167→				notes_count: 0
   168→			}
   169→		],
   170→		total: 3,
   171→		offset: 0,
   172→		limit: 999
   173→	};
   174→}
   175→
   176→/** Register all route mocks for the validate page. */
   177→async function setupValidateRoutes(
   178→	page: import('@playwright/test').Page,
   179→	options?: {
   180→		validation?: ReturnType<typeof mockValidationWithIssues>;
   181→		alignment?: ReturnType<typeof mockAlignment>;
   182→		items?: ReturnType<typeof mockItems>;
   183→		tasks?: ReturnType<typeof mockTasks>;
   184→	}
   185→) {
   186→	const validationData = options?.validation ?? mockValidationWithIssues();
   187→	const alignmentData = options?.alignment ?? mockAlignment();
   188→	const itemsData = options?.items ?? mockItems();
   189→	const tasksData = options?.tasks ?? mockTasks();
   190→
   191→	await page.route('**/api/validate', (route) => {
   192→		route.fulfill({
   193→			status: 200,
   194→			contentType: 'application/json',
   195→			body: JSON.stringify(validationData)
   196→		});
   197→	});
   198→
   199→	await page.route('**/api/alignment', (route) => {
   200→		route.fulfill({
   201→			status: 200,
   202→			contentType: 'application/json',
   203→			body: JSON.stringify(alignmentData)
   204→		});
   205→	});
   206→
   207→	await page.route('**/api/items?*', (route) => {
   208→		route.fulfill({
   209→			status: 200,
   210→			contentType: 'application/json',
   211→			body: JSON.stringify(itemsData)
   212→		});
   213→	});
   214→
   215→	await page.route('**/api/tasks?*', (route) => {
   216→		route.fulfill({
   217→			status: 200,
   218→			contentType: 'application/json',
   219→			body: JSON.stringify(tasksData)
   220→		});
   221→	});
   222→}
   223→
   224→test.describe('Validation and Alignment View', () => {
   225→	test.describe('Summary Cards (AC-1)', () => {
   226→		// AC: @ui-validation-view ac-1
   227→		test('displays error count, warning count, and valid item count', async ({
   228→			page,
   229→			daemon
   230→		}) => {
   231→			await setupValidateRoutes(page);
   232→			await page.goto('/validate');
   233→
   234→			// Wait for data to load
   235→			await expect(page.getByTestId('summary-cards')).toBeVisible();
   236→
   237→			// Error count card
   238→			const errorCard = page.getByTestId('error-count-card');
   239→			await expect(errorCard).toBeVisible();
   240→			// 1 schemaError + 1 refError + 0 traitCycles = 2 errors
   241→			await expect(errorCard).toContainText('2');
   242→			await expect(errorCard).toContainText('Errors');
   243→
   244→			// Warning count card
   245→			const warningCard = page.getByTestId('warning-count-card');
   246→			await expect(warningCard).toBeVisible();
   247→			// 1 refWarning + 2 completenessWarnings + 1 orphan = 4 warnings
   248→			await expect(warningCard).toContainText('4');
   249→			await expect(warningCard).toContainText('Warnings');
   250→
   251→			// Valid items card
   252→			const validCard = page.getByTestId('valid-count-card');
   253→			await expect(validCard).toBeVisible();
   254→			await expect(validCard).toContainText('Valid Items');
   255→			// 10 items total, 2 source items with errors:
   256→			// schemaError from 'modules/broken.yaml', refError from sourceFile 'modules/core.yaml'
   257→			// → 10 - 2 = 8 valid items
   258→			const validCount = page.getByTestId('valid-item-count');
   259→			await expect(validCount).toContainText('8');
   260→		});
   261→
   262→		// AC: @ui-validation-view ac-1
   263→		test('shows "Issues Found" badge when validation has errors', async ({
   264→			page,
   265→			daemon
   266→		}) => {
   267→			await setupValidateRoutes(page);
   268→			await page.goto('/validate');
   269→
   270→			await expect(page.getByTestId('status-invalid')).toBeVisible();
   271→			await expect(page.getByTestId('status-invalid')).toContainText('Issues Found');
   272→		});
   273→
   274→		// AC: @ui-validation-view ac-1
   275→		test('shows "Valid" badge when all checks pass', async ({ page, daemon }) => {
   276→			await setupValidateRoutes(page, { validation: mockValidationClean() });
   277→			await page.goto('/validate');
   278→
   279→			await expect(page.getByTestId('status-valid')).toBeVisible();
   280→			await expect(page.getByTestId('status-valid')).toContainText('Valid');
   281→		});
   282→	});
   283→
   284→	test.describe('Alignment Section (AC-1)', () => {
   285→		// AC: @ui-validation-view ac-1
   286→		test('shows spec coverage percentage', async ({ page, daemon }) => {
   287→			await setupValidateRoutes(page);
   288→			await page.goto('/validate');
   289→
   290→			const specCoverage = page.getByTestId('spec-coverage');
   291→			await expect(specCoverage).toBeVisible();
   292→			// 7/10 specs with tasks = 70%
   293→			await expect(specCoverage).toContainText('70%');
   294→			await expect(specCoverage).toContainText('Spec Coverage');
   295→		});
   296→
   297→		// AC: @ui-validation-view ac-1
   298→		test('shows AC coverage percentage', async ({ page, daemon }) => {
   299→			await setupValidateRoutes(page);
   300→			await page.goto('/validate');
   301→
   302→			const acCoverage = page.getByTestId('ac-coverage');
   303→			await expect(acCoverage).toBeVisible();
   304→			await expect(acCoverage).toContainText('AC Coverage');
   305→			// 20 total ACs (from acceptance_criteria_count), 1 uncovered (from "Uncovered: ac-2")
   306→			// Coverage = (20 - 1) / 20 = 95%
   307→			await expect(acCoverage).toContainText('95%');
   308→			await expect(acCoverage).toContainText('19/20 ACs with tests');
   309→		});
   310→
   311→		// AC: @ui-validation-view ac-1
   312→		test('shows orphaned tasks count', async ({ page, daemon }) => {
   313→			await setupValidateRoutes(page);
   314→			await page.goto('/validate');
   315→
   316→			const orphanedTasks = page.getByTestId('orphaned-tasks');
   317→			await expect(orphanedTasks).toBeVisible();
   318→			await expect(orphanedTasks).toContainText('Orphaned Tasks');
   319→			// 2 tasks without spec_ref
   320→			await expect(orphanedTasks).toContainText('2');
   321→		});
   322→
   323→		// AC: @ui-validation-view ac-1
   324→		test('shows orphaned specs count', async ({ page, daemon }) => {
   325→			await setupValidateRoutes(page);
   326→			await page.goto('/validate');
   327→
   328→			const orphanedSpecs = page.getByTestId('orphaned-specs');
   329→			await expect(orphanedSpecs).toBeVisible();
   330→			await expect(orphanedSpecs).toContainText('Orphaned Specs');
   331→			// 3 orphaned specs from alignment stats
   332→			await expect(orphanedSpecs).toContainText('3');
   333→		});
   334→	});
   335→
   336→	test.describe('Issues List (AC-1)', () => {
   337→		// AC: @ui-validation-view ac-1
   338→		test('shows issues grouped by severity', async ({ page, daemon }) => {
   339→			await setupValidateRoutes(page);
   340→			await page.goto('/validate');
   341→
   342→			const issuesList = page.getByTestId('issues-list');
   343→			await expect(issuesList).toBeVisible();
   344→
   345→			// Error issues group
   346→			const errorGroup = page.getByTestId('error-issues');
   347→			await expect(errorGroup).toBeVisible();
   348→			await expect(errorGroup).toContainText('Errors (2)');
   349→
   350→			// Warning issues group
   351→			const warningGroup = page.getByTestId('warning-issues');
   352→			await expect(warningGroup).toBeVisible();
   353→			// 1 refWarning + 2 completenessWarnings + 1 status_mismatch alignment = 4 warnings
   354→			await expect(warningGroup).toContainText('Warnings (4)');
   355→
   356→			// Info issues group
   357→			const infoGroup = page.getByTestId('info-issues');
   358→			await expect(infoGroup).toBeVisible();
   359→			// 1 orphan + 1 orphaned_spec alignment warning = 2 info
   360→			await expect(infoGroup).toContainText('Info (2)');
   361→		});
   362→
   363→		// AC: @ui-validation-view ac-1
   364→		test('error issues show category badge and message', async ({ page, daemon }) => {
   365→			await setupValidateRoutes(page);
   366→			await page.goto('/validate');
   367→
   368→			const errorIssues = page.getByTestId('issue-error');
   369→			await expect(errorIssues).toHaveCount(2);
   370→
   371→			// First error: schema error
   372→			const firstError = errorIssues.nth(0);
   373→			await expect(firstError).toContainText('Schema');
   374→			await expect(firstError).toContainText('Invalid schema');
   375→
   376→			// Second error: reference error
   377→			const secondError = errorIssues.nth(1);
   378→			await expect(secondError).toContainText('Reference');
   379→			await expect(secondError).toContainText('@nonexistent not found');
   380→		});
   381→
   382→		// AC: @ui-validation-view ac-1
   383→		test('shows no issues message when validation is clean', async ({ page, daemon }) => {
   384→			await setupValidateRoutes(page, {
   385→				validation: mockValidationClean(),
   386→				alignment: { stats: mockAlignment().stats, warnings: [] }
   387→			});
   388→			await page.goto('/validate');
   389→
   390→			const noIssues = page.getByTestId('no-issues');
   391→			await expect(noIssues).toBeVisible();
   392→			await expect(noIssues).toContainText('No issues found');
   393→		});
   394→	});
   395→
   396→	test.describe('Loading State', () => {
   397→		test('shows loading skeleton while fetching', async ({ page, daemon }) => {
   398→			// Delay the response to observe loading state
   399→			await page.route('**/api/validate', async (route) => {
   400→				await new Promise((r) => setTimeout(r, 500));
   401→				route.fulfill({
   402→					status: 200,
   403→					contentType: 'application/json',
   404→					body: JSON.stringify(mockValidationClean())
   405→				});
   406→			});
   407→			await page.route('**/api/alignment', (route) => {
   408→				route.fulfill({
   409→					status: 200,
   410→					contentType: 'application/json',
   411→					body: JSON.stringify(mockAlignment())
   412→				});
   413→			});
   414→			await page.route('**/api/items?*', (route) => {
   415→				route.fulfill({
   416→					status: 200,
   417→					contentType: 'application/json',
   418→					body: JSON.stringify(mockItems())
   419→				});
   420→			});
   421→			await page.route('**/api/tasks?*', (route) => {
   422→				route.fulfill({
   423→					status: 200,
   424→					contentType: 'application/json',
   425→					body: JSON.stringify(mockTasks())
   426→				});
   427→			});
   428→
   429→			await page.goto('/validate');
   430→
   431→			const skeleton = page.getByTestId('loading');
   432→			await expect(skeleton).toBeVisible();
   433→
   434→			// Eventually loads
   435→			await expect(page.getByTestId('summary-cards')).toBeVisible({ timeout: 5000 });
   436→		});
   437→	});
   438→
   439→	test.describe('Empty State', () => {
   440→		test('shows empty state when no data returned', async ({ page, daemon }) => {
   441→			// Return errors for all endpoints to trigger no-data state
