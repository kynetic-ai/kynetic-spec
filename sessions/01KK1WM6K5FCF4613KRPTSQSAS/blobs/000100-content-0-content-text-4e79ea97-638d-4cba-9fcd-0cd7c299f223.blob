   278→					</Badge>
   279→				{/if}
   280→			{/if}
   281→		</div>
   282→		{#if !loading}
   283→			<button
   284→				class="inline-flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-sm
   285→					text-muted-foreground transition-colors hover:bg-muted/50"
   286→				onclick={loadData}
