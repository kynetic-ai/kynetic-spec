   392→		<!-- Alignment Section -->
   393→		<!-- AC: @ui-validation-view ac-1 — spec coverage %, AC coverage %, orphaned tasks/specs counts -->
   394→		{#if alignment}
   395→			<Card data-testid="alignment-section">
