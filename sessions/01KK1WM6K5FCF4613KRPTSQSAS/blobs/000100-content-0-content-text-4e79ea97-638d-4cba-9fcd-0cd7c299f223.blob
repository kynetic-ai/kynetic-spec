   466→		{/if}
   467→
   468→		<!-- Issues List -->
   469→		<!-- AC: @ui-validation-view ac-1 — Issues list grouped by severity -->
   470→		{#if groupedIssues.length > 0}
   471→			<div class="space-y-4" data-testid="issues-list">
