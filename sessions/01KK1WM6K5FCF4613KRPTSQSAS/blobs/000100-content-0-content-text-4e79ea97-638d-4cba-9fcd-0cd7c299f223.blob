   301→		>
   302→			{error}
   303→		</div>
   304→	{/if}
   305→
   306→	<!-- Loading state -->
   307→	{#if loading}
   308→		<div class="space-y-4" data-testid="loading">
   309→			<div class="grid gap-4 md:grid-cols-3">
   310→				{#each Array(3) as _}
   311→					<Card>
   312→						<CardHeader class="pb-2">
   313→							<div class="h-4 w-24 rounded bg-muted ds-shimmer"></div>
   314→						</CardHeader>
   315→						<CardContent>
   316→							<div class="h-8 w-16 rounded bg-muted ds-shimmer"></div>
   317→						</CardContent>
   318→					</Card>
   319→				{/each}
   320→			</div>
   321→			<Card>
   322→				<CardHeader class="pb-2">
   323→					<div class="h-4 w-32 rounded bg-muted ds-shimmer"></div>
   324→				</CardHeader>
   325→				<CardContent class="space-y-3">
   326→					{#each Array(3) as _}
   327→						<div class="h-4 w-full rounded bg-muted ds-shimmer"></div>
   328→					{/each}
   329→				</CardContent>
   330→			</Card>
   331→		</div>
   332→
   333→	<!-- Empty state (no data returned) -->
   334→	{:else if !validation && !alignment && !error}
   335→		<div class="text-center text-muted-foreground py-12" data-testid="empty">
   336→			<ShieldCheck class="mx-auto h-12 w-12 mb-4 opacity-50" />
   337→			<p>No validation data available.</p>
   338→			<p class="text-sm">Connect to a running daemon to run validation.</p>
   339→		</div>
   340→
   341→	<!-- Data loaded -->
   342→	{:else}
   343→		<!-- Summary Cards -->
   344→		<!-- AC: @ui-validation-view ac-1 — error count, warning count, valid item count -->
   345→		<div class="grid gap-4 md:grid-cols-3" data-testid="summary-cards">
   346→			<Card data-testid="error-count-card">
   347→				<CardHeader class="flex flex-row items-center justify-between pb-2 space-y-0">
   348→					<CardTitle class="text-sm font-medium">Errors</CardTitle>
   349→					<AlertCircle class="h-4 w-4 text-severity-error" />
   350→				</CardHeader>
   351→				<CardContent>
   352→					<div class="text-2xl font-bold" class:text-severity-error={errorCount > 0}>
   353→						{errorCount}
   354→					</div>
   355→					<p class="text-xs text-muted-foreground">
   356→						Schema, reference, and trait cycle errors
   357→					</p>
   358→				</CardContent>
   359→			</Card>
   360→
   361→			<Card data-testid="warning-count-card">
