   492→												<span class="text-sm font-medium">{issue.message}</span>
   493→											</div>
   494→											{#if issue.detail}
   495→												<p class="text-xs text-muted-foreground mt-1 font-mono truncate">
   496→													{issue.detail}
   497→												</p>
   498→											{/if}
   499→										</div>
   500→									</div>
   501→								</div>
   502→							{/each}
   503→						</div>
   504→					</div>
   505→				{/if}
   506→
   507→				<!-- Warnings group -->
   508→				{#if warningIssues.length > 0}
   509→					<div data-testid="warning-issues">
   510→						<h3 class="text-sm font-medium text-severity-warning-muted-fg mb-2 flex items-center gap-1.5">
   511→							<AlertTriangle class="h-4 w-4" />
   512→							Warnings ({warningIssues.length})
   513→						</h3>
   514→						<div class="space-y-2">
   515→							{#each warningIssues as issue}
   516→								<div class="rounded-md border p-3 bg-severity-warning-muted border-severity-warning-border" data-testid="issue-warning">
   517→									<div class="flex items-start gap-2">
   518→										<AlertTriangle class="h-4 w-4 mt-0.5 text-severity-warning-muted-fg shrink-0" />
   519→										<div class="min-w-0">
   520→											<div class="flex items-center gap-2 flex-wrap">
   521→												<Badge variant="outline" class="text-xs">{issue.category}</Badge>
   522→												<span class="text-sm font-medium">{issue.message}</span>
   523→											</div>
   524→											{#if issue.detail}
   525→												<p class="text-xs text-muted-foreground mt-1 font-mono truncate">
   526→													{issue.detail}
   527→												</p>
   528→											{/if}
   529→										</div>
   530→									</div>
   531→								</div>
   532→							{/each}
   533→						</div>
   534→					</div>
   535→				{/if}
   536→
   537→				<!-- Info group -->
   538→				{#if infoIssues.length > 0}
   539→					<div data-testid="info-issues">
   540→						<h3 class="text-sm font-medium text-severity-info mb-2 flex items-center gap-1.5">
   541→							<Info class="h-4 w-4" />
   542→							Info ({infoIssues.length})
   543→						</h3>
   544→						<div class="space-y-2">
   545→							{#each infoIssues as issue}
   546→								<div class="rounded-md border p-3 bg-severity-info-muted border-severity-info-border" data-testid="issue-info">
   547→									<div class="flex items-start gap-2">
   548→										<Info class="h-4 w-4 mt-0.5 text-severity-info shrink-0" />
   549→										<div class="min-w-0">
   550→											<div class="flex items-center gap-2 flex-wrap">
   551→												<Badge variant="outline" class="text-xs">{issue.category}</Badge>
   552→												<span class="text-sm font-medium">{issue.message}</span>
   553→											</div>
   554→											{#if issue.detail}
   555→												<p class="text-xs text-muted-foreground mt-1 font-mono truncate">
   556→													{issue.detail}
   557→												</p>
   558→											{/if}
   559→										</div>
   560→									</div>
   561→								</div>
   562→							{/each}
   563→						</div>
   564→					</div>
   565→				{/if}
   566→			</div>
   567→		{:else if !error}
   568→			<Card data-testid="no-issues">
   569→				<CardContent class="py-8">
   570→					<div class="text-center text-muted-foreground">
   571→						<CheckCircle2 class="mx-auto h-12 w-12 mb-4 text-severity-success opacity-75" />
   572→						<p class="font-medium">No issues found</p>
   573→						<p class="text-sm">All validation checks passed.</p>
   574→					</div>
   575→				</CardContent>
   576→			</Card>
   577→		{/if}
   578→	{/if}
   579→</div>
