   368→						{warningCount}
   369→					</div>
   370→					<p class="text-xs text-muted-foreground">
   371→						Completeness, orphans, and reference warnings
   372→					</p>
   373→				</CardContent>
   374→			</Card>
   375→
   376→			<Card data-testid="valid-count-card">
