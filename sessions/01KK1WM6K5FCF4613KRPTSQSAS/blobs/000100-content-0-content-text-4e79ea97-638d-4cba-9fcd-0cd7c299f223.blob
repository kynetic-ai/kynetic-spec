```
     1→<script lang="ts">
     2→	// AC: @ui-validation-view ac-1
     3→	import { onMount } from 'svelte';
     4→	import {
     5→		fetchValidation,
     6→		fetchAlignment,
     7→		fetchItems,
     8→		fetchTasks,
     9→		type ValidationResponse,
    10→		type AlignmentResponse,
    11→		type CompletenessWarning
    12→	} from '$lib/api';
    13→	import { Card, CardContent, CardHeader, CardTitle } from '$lib/components/ui/card';
    14→	import { Badge } from '$lib/components/ui/badge';
    15→	import {
    16→		ShieldCheck,
    17→		ShieldAlert,
    18→		AlertTriangle,
    19→		AlertCircle,
    20→		CheckCircle2,
    21→		Info,
    22→		Link2Off,
    23→		FileWarning,
    24→		RefreshCw
    25→	} from 'lucide-svelte';
    26→	import { getProjectVersion } from '$lib/stores/project.svelte';
    27→
    28→	// --- State ---
    29→
    30→	let validation = $state<ValidationResponse | null>(null);
    31→	let alignment = $state<AlignmentResponse | null>(null);
    32→	let totalItemCount = $state(0);
    33→	let totalAcCount = $state(0);
    34→	let orphanedTaskCount = $state(0);
    35→	let loading = $state(true);
    36→	let error = $state('');
    37→
    38→	// --- Derived counts ---
    39→	// AC: @ui-validation-view ac-1 — error count, warning count, valid item count
    40→
    41→	let errorCount = $derived.by(() => {
    42→		if (!validation) return 0;
    43→		return (
    44→			validation.schemaErrors.length +
    45→			validation.refErrors.length +
    46→			validation.traitCycles.length
    47→		);
    48→	});
    49→
    50→	let warningCount = $derived.by(() => {
    51→		if (!validation) return 0;
    52→		return (
    53→			validation.refWarnings.length +
    54→			validation.completenessWarnings.length +
    55→			validation.orphans.length
    56→		);
    57→	});
    58→
    59→	// AC: @ui-validation-view ac-1 — valid item count
    60→	// Count unique items that have errors (using the source item, not the broken target)
    61→	let validItemCount = $derived.by(() => {
    62→		if (!validation) return 0;
    63→		const itemsWithErrors = new Set<string>();
    64→		for (const e of validation.schemaErrors) {
    65→			// schemaErrors.file = the YAML file containing the invalid item
    66→			if (e.file) itemsWithErrors.add(e.file);
    67→		}
    68→		for (const e of validation.refErrors) {
    69→			// sourceUlid/sourceFile = the item containing the broken reference
    70→			// (NOT e.ref, which is the target that doesn't exist)
    71→			const source = e.sourceUlid ?? e.sourceFile;
    72→			if (source) itemsWithErrors.add(source);
    73→		}
    74→		for (const e of validation.traitCycles) {
    75→			// traitRef = the trait involved in the cycle
    76→			if (e.traitRef) itemsWithErrors.add(e.traitRef);
    77→		}
    78→		return Math.max(0, totalItemCount - itemsWithErrors.size);
    79→	});
    80→
    81→	// AC: @ui-validation-view ac-1 — spec coverage %, AC coverage %
    82→	let specCoverage = $derived.by(() => {
    83→		if (!alignment || alignment.stats.totalSpecs === 0) return 0;
    84→		return Math.round(
    85→			(alignment.stats.specsWithTasks / alignment.stats.totalSpecs) * 100
    86→		);
    87→	});
    88→
    89→	// AC: @ui-validation-view ac-1 — AC coverage %
    90→	// Computed from total AC count (from items API) minus uncovered ACs (from completeness warnings)
    91→	let uncoveredAcCount = $derived.by(() => {
    92→		if (!validation) return 0;
    93→		return countUncoveredACs(validation.completenessWarnings);
    94→	});
    95→
    96→	let acCoverage = $derived.by(() => {
    97→		if (totalAcCount === 0) return 100;
    98→		const covered = totalAcCount - uncoveredAcCount;
    99→		return Math.round((covered / totalAcCount) * 100);
   100→	});
   101→
   102→	// --- Group issues by severity ---
   103→
   104→	type GroupedIssue = {
   105→		severity: 'error' | 'warning' | 'info';
   106→		category: string;
   107→		message: string;
   108→		detail?: string;
   109→	};
   110→
   111→	let groupedIssues = $derived.by((): GroupedIssue[] => {
   112→		if (!validation && !alignment) return [];
   113→		const issues: GroupedIssue[] = [];
   114→
   115→		if (validation) {
   116→			for (const e of validation.schemaErrors) {
   117→				issues.push({
   118→					severity: 'error',
   119→					category: 'Schema',
   120→					message: e.message,
   121→					detail: e.file + (e.path ? ` (${e.path})` : '')
   122→				});
   123→			}
   124→			for (const e of validation.refErrors) {
   125→				issues.push({
   126→					severity: 'error',
   127→					category: 'Reference',
   128→					message: e.message,
   129→					detail: `${e.ref} in ${e.field}`
   130→				});
   131→			}
   132→			for (const e of validation.traitCycles) {
   133→				issues.push({
   134→					severity: 'error',
   135→					category: 'Trait Cycle',
   136→					message: e.message,
   137→					detail: e.cycle.join(' → ')
   138→				});
   139→			}
   140→			for (const w of validation.refWarnings) {
   141→				issues.push({
   142→					severity: 'warning',
   143→					category: 'Reference',
   144→					message: w.message,
   145→					detail: `${w.ref} in ${w.field}`
   146→				});
   147→			}
   148→			for (const w of validation.completenessWarnings) {
   149→				issues.push({
   150→					severity: 'warning',
   151→					category: completenessLabel(w.type),
   152→					message: w.message,
   153→					detail: w.details ?? `${w.itemRef} — ${w.itemTitle}`
   154→				});
   155→			}
   156→			for (const o of validation.orphans) {
   157→				issues.push({
   158→					severity: 'info',
   159→					category: 'Orphan',
   160→					message: `${o.title} (${o.type})`,
   161→					detail: o.file ?? o.ulid
   162→				});
   163→			}
   164→		}
   165→
   166→		if (alignment) {
   167→			for (const w of alignment.warnings) {
   168→				issues.push({
   169→					severity: w.type === 'status_mismatch' ? 'warning' : 'info',
   170→					category: alignmentLabel(w.type),
   171→					message: w.message,
   172→					detail: w.specTitle ?? w.specUlid
   173→				});
   174→			}
   175→		}
   176→
   177→		return issues;
   178→	});
   179→
   180→	let errorIssues = $derived(groupedIssues.filter((i) => i.severity === 'error'));
   181→	let warningIssues = $derived(groupedIssues.filter((i) => i.severity === 'warning'));
   182→	let infoIssues = $derived(groupedIssues.filter((i) => i.severity === 'info'));
   183→
   184→	// --- Lifecycle ---
   185→
   186→	onMount(async () => {
   187→		await loadData();
   188→	});
   189→
   190→	$effect(() => {
   191→		const version = getProjectVersion();
   192→		if (version > 0) {
   193→			loadData();
   194→		}
   195→	});
   196→
   197→	async function loadData() {
   198→		try {
   199→			loading = true;
   200→			error = '';
   201→			const [v, a, itemsRes, tasksRes] = await Promise.all([
   202→				fetchValidation(),
   203→				fetchAlignment(),
   204→				fetchItems({ limit: 999 }),
   205→				fetchTasks({ limit: 999 })
   206→			]);
   207→			validation = v;
   208→			alignment = a;
   209→			totalItemCount = itemsRes.total;
   210→			// Sum acceptance_criteria_count from all items (field returned by daemon but not in ItemSummary type)
   211→			totalAcCount = itemsRes.items.reduce(
   212→				(sum, item) => sum + ((item as any).acceptance_criteria_count ?? 0),
   213→				0
   214→			);
   215→			// Orphaned tasks = tasks without a spec_ref
   216→			orphanedTaskCount = tasksRes.items.filter((t) => !t.spec_ref).length;
   217→		} catch (err) {
   218→			error = err instanceof Error ? err.message : 'Failed to load validation data';
   219→		} finally {
   220→			loading = false;
   221→		}
   222→	}
   223→
   224→	// --- Helpers ---
   225→
   226→	function completenessLabel(type: string): string {
   227→		const labels: Record<string, string> = {
   228→			missing_acceptance_criteria: 'Missing AC',
   229→			missing_description: 'Missing Description',
   230→			status_inconsistency: 'Status Inconsistency',
   231→			missing_test_coverage: 'Test Coverage',
   232→			automation_eligible_no_spec: 'No Spec',
   233→			ac_schema_field_mismatch: 'AC Schema Mismatch'
   234→		};
   235→		return labels[type] ?? type;
   236→	}
   237→
   238→	/** Count total uncovered ACs from completeness warnings details field ("Uncovered: ac-1, ac-2") */
   239→	function countUncoveredACs(warnings: CompletenessWarning[]): number {
   240→		let count = 0;
   241→		for (const w of warnings) {
   242→			if (w.type === 'missing_test_coverage' && w.details) {
   243→				// Parse "Uncovered: ac-1, ac-2" → count comma-separated entries
   244→				const match = w.details.match(/^Uncovered:\s*(.+)$/);
   245→				if (match) {
   246→					count += match[1].split(',').length;
   247→				}
   248→			}
   249→		}
   250→		return count;
   251→	}
   252→
   253→	function alignmentLabel(type: string): string {
   254→		const labels: Record<string, string> = {
   255→			orphaned_spec: 'Orphaned Spec',
   256→			status_mismatch: 'Status Mismatch',
   257→			stale_implementation: 'Stale Implementation'
   258→		};
   259→		return labels[type] ?? type;
   260→	}
   261→</script>
   262→
   263→<!-- AC: @ui-validation-view ac-1 -->
   264→<div class="flex flex-col gap-6" data-testid="validate-page">
   265→	<div class="flex items-center justify-between">
   266→		<div class="flex items-center gap-3">
   267→			<h1 class="text-3xl font-bold">Validate</h1>
   268→			{#if !loading && validation}
   269→				{#if validation.valid && errorCount === 0}
   270→					<Badge class="bg-severity-success text-severity-success-fg" data-testid="status-valid">
   271→						<CheckCircle2 class="mr-1 h-3 w-3" />
   272→						Valid
   273→					</Badge>
   274→				{:else}
   275→					<Badge class="bg-severity-error text-severity-error-fg" data-testid="status-invalid">
   276→						<ShieldAlert class="mr-1 h-3 w-3" />
