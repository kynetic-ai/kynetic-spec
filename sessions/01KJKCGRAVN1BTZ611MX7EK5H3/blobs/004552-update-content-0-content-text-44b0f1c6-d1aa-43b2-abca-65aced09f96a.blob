```sh
[
  {
    "id": "spec-first",
    "trigger": "behavior-change",
    "description": "Check spec coverage before implementing changes.\nCore principle: If changing behavior and spec doesn't cover it,\nupdate the spec first.\n",
    "steps": [
      {
        "type": "check",
        "content": "Does the spec cover this change?",
        "on_fail": "Update or create spec before proceeding"
      },
      {
        "type": "decision",
        "content": "What is the spec status?",
        "options": [
          "Spec exists and matches -> Derive task, proceed",
          "Spec exists but outdated -> Update spec first",
          "No spec exists -> Create spec first (behavior) or task directly (infra)"
        ]
      },
      {
        "type": "action",
        "content": "Update or create spec item if needed"
      },
      {
        "type": "action",
        "content": "Derive task from spec via kspec derive @spec-item"
      },
      {
        "type": "action",
        "content": "Implement the change"
      }
    ],
    "mode": "interactive",
    "tags": []
  },
  {
    "id": "session-start",
    "trigger": "session-start",
    "description": "Get context at the beginning of a work session.\n",
    "steps": [
      {
        "type": "action",
        "content": "Run kspec session start to get context"
      },
      {
        "type": "check",
        "content": "Are there active (in_progress) tasks?",
        "on_fail": "Pick from ready tasks or triage inbox"
      },
      {
        "type": "action",
        "content": "Review ready tasks and inbox items"
      },
      {
        "type": "action",
        "content": "Start work on chosen task via kspec task start"
      }
    ],
    "mode": "interactive",
    "tags": []
  },
  {
    "id": "task-lifecycle",
    "trigger": "task-complete",
    "description": "Complete a task properly with notes and cleanup.\n",
    "steps": [
      {
        "type": "action",
        "content": "Add completion note describing what was done"
      },
      {
        "type": "action",
        "content": "Run kspec task complete @task --reason \"summary\""
      },
      {
        "type": "check",
        "content": "Are there uncommitted changes?",
        "on_fail": "Commit changes with descriptive message"
      },
      {
        "type": "action",
        "content": "Review if task unblocked other work"
      }
    ],
    "mode": "interactive",
    "tags": []
  },
  {
    "id": "inbox-triage",
    "trigger": "session-start",
    "description": "Triage inbox items during session context review.\n",
    "steps": [
      {
        "type": "action",
        "content": "Review oldest inbox items first"
      },
      {
        "type": "decision",
        "content": "For each item, ask these questions",
        "options": [
          "Still relevant? No -> delete",
          "Scope clear? Yes -> promote to task",
          "Needs spec work? -> Create/update spec first",
          "Still unclear? -> Leave, add tag, revisit later"
        ]
      },
      {
        "type": "check",
        "content": "Has item survived 3+ triage sessions?",
        "on_fail": "Either promote with clear scope or delete"
      }
    ],
    "mode": "interactive",
    "tags": []
  },
  {
    "id": "codebase-audit",
    "trigger": "pre-release",
    "description": "Comprehensive codebase audit for release readiness. Five-phase workflow: parallel exploration (docs, code, config, tests, specs), compilation by severity, interactive triage, execution, and summary.",
    "steps": [],
    "mode": "interactive",
    "tags": []
  },
  {
    "id": "session-reflect",
    "trigger": "session-end",
    "description": "Structured reflection after work sessions. Surfaces learnings, identifies friction, and captures improvements for system evolution.",
    "steps": [
      {
        "type": "action",
        "content": "Identify what worked well this session.\nBe specific: \"categorizing items first\" not \"good planning\".\nConsider: workflows, tools/commands, communication, decisions.\n"
      },
      {
        "type": "action",
        "content": "Identify friction points - where things were harder than needed.\nFocus on systemic issues, not one-off mistakes.\nConsider: repetitive steps, missing commands, context loss, workarounds.\n"
      },
      {
        "type": "action",
        "content": "Check if friction points are already tracked.\nSearch specs, tasks, AND inbox before proposing new improvements.\nFor each: note if already tracked, partially covered, or untracked.\n",
        "exit_criteria": [
          "Searched specs for relevant features",
          "Searched tasks for existing work",
          "Searched inbox for captured ideas"
        ]
      },
      {
        "type": "action",
        "content": "For untracked friction, propose concrete improvements.\nInclude: what it would do, how it helps, rough scope (small/medium/large).\n"
      },
      {
        "type": "decision",
        "content": "Present findings to user - ask about each improvement one at a time",
        "options": [
          "Worth capturing -> proceed to capture",
          "Needs refinement -> discuss and refine",
          "Not worth it -> skip and continue",
          "Done with reflection -> complete workflow"
        ]
      },
      {
        "type": "action",
        "content": "Capture approved items using appropriate destination:\n- Actionable improvements: kspec inbox add \"...\" --tag reflection\n- Friction patterns: kspec meta observe friction \"...\"\n- Success patterns: kspec meta observe success \"...\"\n- Open questions: kspec meta question add \"...\"\n"
      }
    ],
    "mode": "interactive",
    "tags": []
  },
  {
    "id": "create-workflow",
    "trigger": "manual",
    "description": "Meta-workflow for creating new workflows. Ensures consistent structure and matching skill integration.",
    "steps": [
      {
        "type": "action",
        "content": "Identify the pattern to formalize.\nWhat process/checklist are you capturing? Where is it documented?\nLook for: step-by-step instructions, checklists, repeated sequences.\n",
        "inputs": [
          {
            "name": "pattern_source",
            "description": "Where the pattern comes from (file:line, skill name, or description)",
            "type": "string"
          }
        ]
      },
      {
        "type": "action",
        "content": "Define the trigger - when does this workflow start?\nCommon triggers: manual, session-start, session-end, task-complete,\nbehavior-change, pre-release, pr-merge\n",
        "inputs": [
          {
            "name": "trigger",
            "description": "The trigger for this workflow",
            "type": "string"
          },
          {
            "name": "workflow_id",
            "description": "Kebab-case ID for the workflow",
            "type": "string"
          }
        ]
      },
      {
        "type": "action",
        "content": "Design the steps. For each step decide:\n- Type: action (do something), check (verify condition), decision (choose path)\n- Content: clear instruction, can be multiline\n- For checks: on_fail message\n- For decisions: options list\n- Entry/exit criteria if step needs verification\n- Inputs if step captures structured data\nSee: [Step Design Guide](docs/step-design.md)\n"
      },
      {
        "type": "action",
        "content": "Create the workflow:\nkspec meta add workflow --id <id> --trigger <trigger> --description \"...\"\nThen edit .kspec/kynetic.meta.yaml to add the steps (until --steps flag exists).\n"
      },
      {
        "type": "decision",
        "content": "Does this workflow need a matching skill for additional context?",
        "options": [
          "Yes - create/update skill in .claude/skills/<name>/SKILL.md",
          "No - workflow is self-contained or context exists elsewhere"
        ]
      },
      {
        "type": "action",
        "content": "Test the workflow:\nkspec workflow start @workflow-id\nRun through each step with workflow next\nVerify inputs/notes are captured correctly\n"
      },
      {
        "type": "check",
        "content": "Commit changes to both main (skill) and shadow (workflow) branches"
      }
    ],
    "mode": "interactive",
    "tags": []
  },
  {
    "id": "task-work-session",
    "trigger": "manual",
    "description": "Core pattern for working on a task. Full lifecycle from start through PR merge.",
    "steps": [
      {
        "type": "check",
        "content": "Check for existing needs_work, in_progress, or pending_review tasks.\nUse: kspec session start (shows active work first)\nPriority: needs_work > in_progress > ready\nNote: pending_review tasks are handled by review subagent, not worker.\n",
        "on_fail": "Inherit existing work instead of starting new.\nPick up needs_work task (fix review feedback) or in_progress task and continue.\nOnly start new work if user explicitly says to ignore existing work.\n"
      },
      {
        "type": "action",
        "content": "Choose task to work on.\nUse: kspec tasks ready to see available tasks\nOr: kspec task get @task to see task details\n",
        "inputs": [
          {
            "name": "task_ref",
            "description": "Reference to the task (e.g., @task-slug)",
            "type": "ref"
          }
        ]
      },
      {
        "type": "check",
        "content": "Verify work is not already done.\nCheck git history: git log --oneline --grep=\"feature-name\"\nRead implementation code if it exists.\n",
        "on_fail": "Mark task complete with \"Already implemented\" reason"
      },
      {
        "type": "action",
        "content": "Start the task.\nUse: kspec task start @task\nThis marks the task in_progress.\n"
      },
      {
        "type": "action",
        "content": "Work on the task, adding notes as you go.\nUse: kspec task note @task \"What you're doing...\"\nAdd notes during work, not just at end.\n"
      },
      {
        "type": "check",
        "content": "All changes committed",
        "on_fail": "Commit changes with Task: @task trailer.\nExample: git commit -m \"feat: description\\n\\nTask: @task-slug\"\n"
      },
      {
        "type": "action",
        "content": "Run local review before submitting.\nSpawn a subagent using Task tool with prompt:\n\"Run /local-review for @spec-ref. Report all findings with severity.\"\n\nIf MUST-FIX findings: fix them, re-commit, re-run local review.\nIf SHOULD-FIX or SUGGESTION only: note findings, proceed to submit.\nIf actionable items not worth fixing now: kspec inbox add \"...\"\n"
      },
      {
        "type": "action",
        "content": "If this is a fix cycle (needs_work task):\n  1. Read PR review comments: gh api repos/{owner}/{repo}/pulls/{number}/reviews\n  2. Fix MUST-FIX and SHOULD-FIX issues identified in comments\n  3. Commit and push fixes to PR branch\n  4. Submit task: kspec task submit @task\n  5. Stop responding — reviewer re-reviews in next iteration\n\nOtherwise (new work):\n  1. Submit task: kspec task submit @task\n  2. Create PR: /pr skill\n  3. Stop responding — ralph handles PR review via separate subagent\n"
      },
      {
        "type": "check",
        "content": "PR merged to main",
        "on_fail": "Wait for PR review and merge before completing task."
      },
      {
        "type": "action",
        "content": "Complete task after PR merged.\nUse: kspec task complete @task --reason \"Summary of what was done\"\nThis marks the task completed.\n"
      }
    ],
    "mode": "interactive",
    "tags": []
  },
  {
    "id": "local-review",
    "trigger": "manual",
    "description": "Quality enforcement for pre-PR review. 8-step gate: own AC coverage, trait AC coverage, test quality, test strategy, test isolation, code quality, regression check, and report. Issues flagged as MUST-FIX. The goal is to find problems, not to approve.",
    "steps": [
      {
        "type": "action",
        "content": "Get spec reference and read acceptance criteria (own + inherited trait ACs).\nUse: kspec item get @spec to see own ACs and inherited trait ACs.\nBoth own ACs and inherited trait ACs need test coverage.\n",
        "inputs": [
          {
            "name": "spec_ref",
            "description": "Reference to the spec item (e.g., @spec-slug)",
            "type": "ref"
          }
        ]
      },
      {
        "type": "check",
        "content": "Every own AC has test coverage with // AC: @spec-ref ac-N annotation.\nEvery inherited trait AC has test coverage with // AC: @trait-slug ac-N annotation.\nSearch tests/ and packages/ for annotations. Run kspec validate to cross-check.\n",
        "on_fail": "MUST-FIX: Missing AC coverage (own or trait) is a blocking issue.\nList each uncovered AC. Trait AC warnings from kspec validate are blockers.\n"
      },
      {
        "type": "check",
        "content": "All tests validate real behavior (no fluff tests).\nTests should fail if the feature breaks.\nReject tests that always pass or only test implementation details.\n",
        "on_fail": "MUST-FIX: Identify and flag fluff tests.\nA test that doesn't validate behavior is not valid.\n"
      },
      {
        "type": "check",
        "content": "Test strategy prefers E2E over unit tests.\nTest the CLI as a user would invoke it.\nUnit tests are okay for complex logic, but E2E proves it works.\n",
        "on_fail": "Consider adding E2E tests for CLI functionality."
      },
      {
        "type": "check",
        "content": "Tests run in temp directories (not kspec repo).\nAll tests must use system temp or /tmp.\nThis prevents nested worktree issues and data corruption.\n",
        "on_fail": "MUST-FIX: Tests must run in temp directories.\nTest fixtures should create isolated test repos.\n"
      },
      {
        "type": "check",
        "content": "Code follows existing patterns. No duplicated logic, no ignored shared utilities.\nImplementation matches conventions in neighboring files.\n",
        "on_fail": "MUST-FIX: Flag duplicated code, ignored utilities, inconsistent patterns.\nEach finding must include file:line and description.\n"
      },
      {
        "type": "check",
        "content": "Full test suite passes (npm test). No regressions.\nNew code must not break existing spec or trait AC tests.\n",
        "on_fail": "MUST-FIX: Test failures must be fixed before PR.\n"
      },
      {
        "type": "action",
        "content": "Report findings.\nList all MUST-FIX issues that block PR creation.\nMUST-FIX findings first, each with file:line.\nNon-blocking suggestions noted separately.\nWhen invoked as subagent, return findings to caller.\nMUST-FIX items block PR creation.\n"
      }
    ],
    "mode": "interactive",
    "tags": []
  },
  {
    "id": "session-reflect-loop",
    "trigger": "loop-iteration-end",
    "description": "Autonomous reflection for loop mode. High-confidence captures only. MUST search existing before capturing. No user interaction.",
    "steps": [
      {
        "type": "action",
        "content": "MANDATORY FIRST STEP: Search existing state before identifying anything.\nRun these searches in parallel:\n- kspec meta observations list\n- kspec inbox list\n- kspec tasks list\n\nThis establishes baseline to prevent duplicates (ac-1, ac-3).\n"
      },
      {
        "type": "action",
        "content": "Identify high-confidence friction points and successes.\n\nHIGH CONFIDENCE criteria (ac-2, ac-4):\n- Concrete and specific (not vague)\n- Systemic/repeatable (not one-off)\n- Clear cause and effect\n- Agent has certainty about the pattern\n\nLOW CONFIDENCE (DO NOT capture):\n- Vague observations\n- Uncertain patterns\n- One-off issues\n- Hypothetical problems\n\nFor each item identified, check against search results from step 1.\n"
      },
      {
        "type": "decision",
        "content": "For each potential item, evaluate against existing state:\n\nAC-3: If matches existing observation/inbox/task -> SKIP IT, note existing ref\nAC-4: If unique AND high-confidence -> CAPTURE IT\nAC-2: If vague/uncertain -> SKIP IT\n\nDecision matrix:\n- Duplicate of existing item -> skip, note reference\n- Unique + high confidence -> capture\n- Vague/uncertain -> skip silently\n"
      },
      {
        "type": "action",
        "content": "Capture approved items automatically (no user prompt - ac-5, ac-6):\n\n- Systemic friction: kspec meta observe friction \"...\"\n- Successful patterns: kspec meta observe success \"...\"\n- Open questions: kspec meta question add \"...\"\n- Actionable improvements with scope: kspec inbox add \"...\" --tag reflection\n\nOnly capture items that passed the evaluation in step 3.\nBe selective - lower volume, higher quality.\n"
      }
    ],
    "mode": "interactive",
    "tags": []
  },
  {
    "id": "pr-review-loop",
    "trigger": "loop-pr-review",
    "description": "PR review subagent workflow for loop mode. Runs local review (own + trait AC coverage, code quality), verifies spec alignment, reviews code quality, checks for regressions, fixes issues, waits for CI, posts structured GitHub review with inline comments, and merges with quality gates. The goal is to find problems and verify quality — not to rubber-stamp merges. Sequential execution (ralph waits). CRITICAL: After ANY push, must re-verify CI passes before merge.",
    "steps": [
      {
        "type": "action",
        "content": "Run local review workflow first (ac-1).\nUse: /local-review skill or kspec workflow start @local-review\n\nThis checks:\n- Own AC coverage (all spec ACs have test annotations)\n- Trait AC coverage (all inherited trait ACs have test annotations)\n- Test quality (no fluff tests, proper isolation)\n- E2E preference (integration tests over unit tests where appropriate)\n- Test isolation (temp directories, cleanup)\n- Code quality (no duplicated logic, consistent patterns, shared utilities used)\n- Regression check (npm test passes fully)\n"
      },
      {
        "type": "check",
        "content": "Verify all ACs (own + trait) linked to task have test coverage (ac-2).\n\nCheck test files for own AC annotations: // AC: @spec-ref ac-N\nCheck test files for trait AC annotations: // AC: @trait-slug ac-N\nRun kspec item get @spec-ref to enumerate all ACs (own + inherited).\nRun kspec validate to cross-check trait AC coverage.\n\nMUST-FIX if:\n- Spec has own ACs but no tests reference them\n- Spec implements traits but inherited ACs lack test coverage\n- Tests exist but don't cover all ACs (own or trait)\n",
        "on_fail": "Add missing test coverage before continuing.\nTests must validate AC behavior, not just implementation.\nTrait AC warnings from kspec validate are blockers.\n"
      },
      {
        "type": "check",
        "content": "Verify implementation matches spec requirements (ac-3).\n\nThis is NOT just \"do tests pass\" - verify:\n- Implementation aligns with spec description\n- All AC conditions are actually implemented\n- No deviation from spec without justification\n\nRead spec, read implementation, compare.\n",
        "on_fail": "Fix misalignment between spec and implementation.\nUpdate code to match spec, or note why deviation is necessary.\n"
      },
      {
        "type": "decision",
        "content": "Evaluate local-review findings (ac-4).\n\nIf MUST-FIX issues found:\n- Attempt to fix them in-place\n- Run tests after fixes\n- Push changes\n\nIf issues cannot be resolved:\n- Mark task automation: needs_review with explanation (ac-8)\n- EXIT workflow\n\nDecision matrix:\n- MUST-FIX issues, can fix -> Fix and continue\n- MUST-FIX issues, cannot fix -> Mark needs_review, EXIT\n- Only advisory issues -> Continue with merge\n- No issues -> Continue with merge\n"
      },
      {
        "type": "action",
        "content": "Push changes (if any fixes were made).\nUse: git push\n\nThis triggers CI to run on latest code.\n\nNOTE: Only push if changes were actually made during issue fixing.\n"
      },
      {
        "type": "check",
        "content": "Wait for CI to complete and pass (ac-5).\n\nCRITICAL: This step MUST be executed EVERY time changes are pushed.\nDo not skip or assume prior CI checks are valid.\n\nPoll CI status until all checks complete.\nUse: gh pr view --json statusCheckRollup\n\nDo NOT proceed while checks are running or failing.\nVERIFY the checks ran against current HEAD (latest commit SHA).\n",
        "on_fail": "If CI fails:\n- Investigate failure\n- Fix if possible\n- Push changes\n- RETURN TO THIS STEP and wait for CI again (do not skip ahead)\n\nIf cannot fix:\n- Mark task automation: needs_review with CI failure details (ac-8)\n- EXIT workflow\n"
      },
      {
        "type": "action",
        "content": "Follow PR review merge gates (ac-6).\nUse: kspec workflow start @pr-review-merge\n\nThis ensures:\n- All CI checks pass\n- All review feedback addressed\n- All @claude requests completed\n- All review threads resolved\n\nOnly merge when all gates pass.\n"
      },
      {
        "type": "check",
        "content": "Verify PR was successfully merged.\nUse: gh pr view --json state,mergedAt\n\nConfirm state is MERGED.\n",
        "on_fail": "If merge failed:\n- Check for conflicts or protection rules\n- Attempt resolution\n- If cannot resolve: mark automation: needs_review (ac-8)\n- EXIT workflow\n"
      },
      {
        "type": "action",
        "content": "Mark task completed with PR reference (ac-7).\nUse: kspec task complete @task --reason \"Merged in PR #N. <summary>\"\n\nInclude in reason:\n- PR number\n- Summary of what was implemented\n- Any notable changes or deviations\n- AC coverage confirmation\n"
      },
      {
        "type": "action",
        "content": "Check for friction during PR review (ac-11).\n\nIf significant friction encountered (not one-off):\n1. Search existing observations first:\n   kspec meta observations list --type friction\n2. Only capture if unique:\n   kspec meta observe friction \"[REVIEW SUBAGENT] <description>\"\n\nBe selective - systemic patterns only, not one-off issues.\nThis step is optional - only capture if friction was encountered.\n"
      }
    ],
    "mode": "interactive",
    "tags": []
  },
  {
    "id": "spec-plan-design",
    "trigger": "manual",
    "description": "Research and design phase for plan-to-spec translation. Explore codebase, clarify requirements, design approach, review for completeness and spec gaps. Concludes with choosing import or manual execution path.",
    "steps": [
      {
        "type": "action",
        "content": "Explore and research the codebase.\nUnderstand: existing specs/items in the domain, related patterns, current code structure, traits that may apply.\nUse /spec skill knowledge for spec types, AC format, and trait reference.\nFocus on what already exists to avoid duplication. Use parallel searches for efficiency.\n",
        "inputs": [
          {
            "name": "feature_description",
            "description": "What you're planning to build",
            "type": "string"
          }
        ]
      },
      {
        "type": "action",
        "content": "Clarify requirements with the user.\nPresent structured questions with clear options. One question at a time - do not batch multiple questions.\nEach question should resolve a specific design choice or scope decision.\nContinue until no open questions remain. Capture answers as they inform the design.\n"
      },
      {
        "type": "action",
        "content": "Design the approach.\nSynthesize exploration findings, user answers, and requirements into a concrete design.\nPropose: spec items needed, AC for each, applicable traits, parent placement, and task structure.\nWrite the design to a durable artifact (plan file or document) so it survives session boundaries.\n"
      },
      {
        "type": "check",
        "content": "Design passes holistic review",
        "on_fail": "Address review feedback - fix gaps, refine AC, add missing traits. Iterate until review passes.\nReview for: (1) completeness - gaps or missing scenarios, (2) consistency - specs align with existing patterns,\n(3) spec coverage - proper types, AC quality, trait applicability per /spec skill, (4) edge cases.\nExit criteria: design written to file, all review issues addressed.\n"
      },
      {
        "type": "decision",
        "content": "Choose execution path based on the reviewed plan",
        "options": [
          "Import path - write structured plan document and auto-generate (3+ specs, batch creation)",
          "Manual path - create specs incrementally with kspec commands (1-2 specs, quick additions)"
        ]
      }
    ],
    "mode": "interactive",
    "tags": []
  },
  {
    "id": "spec-plan-import",
    "trigger": "manual",
    "description": "Execute plan via structured document import - write document, choose module, preview, import, review traits, validate, start work. Follows @spec-plan-design. Import auto-creates plan record with status active.",
    "steps": [
      {
        "type": "action",
        "content": "Write or finalize plan document.\nFormat: # Title, ## Specs with YAML code block (title required, optional: slug, type, parent, AC, traits),\n## Tasks with derive_from_specs flag, ## Implementation Notes (plain text).\n",
        "inputs": [
          {
            "name": "plan_file_path",
            "description": "Path to the markdown plan file",
            "type": "string"
          }
        ]
      },
      {
        "type": "action",
        "content": "Choose target module.\nUse: kspec item list --type module\nIf no suitable module exists, create one: kspec item add --type module --title \"Module Name\"\nNote the generated reference for the next step.\n",
        "inputs": [
          {
            "name": "module_ref",
            "description": "Reference to the target module",
            "type": "ref"
          }
        ]
      },
      {
        "type": "action",
        "content": "Preview with dry-run.\nUse: kspec plan import <path> --module @module --dry-run\nReview: spec count, task count, errors, skipped items.\n"
      },
      {
        "type": "check",
        "content": "Dry-run output acceptable - all specs valid, parents resolved, no circular deps, at least one spec found",
        "on_fail": "Fix document based on error type:\n(1) YAML parse errors - fix syntax\n(2) Missing parent refs - add parent to plan or verify existing ref\n(3) Circular deps - restructure parent chain\n(4) Missing required fields - add title to spec entries\nRe-run dry-run.\n"
      },
      {
        "type": "action",
        "content": "Run actual import.\nUse: kspec plan import <path> --module @module\nFor re-imports of revised documents, add --update to update existing specs.\nImport auto-creates plan record (status: active) with derived_specs and derived_tasks linked.\nVerify: kspec plan get @plan-slug\n"
      },
      {
        "type": "action",
        "content": "Review and apply traits.\nUse: kspec trait list for available traits.\nFor each created spec, consider cross-cutting concerns\n(json-output, dry-run, error-guidance, semantic-exit-codes, shadow-commit, filterable-list).\nApply any not already declared in plan document: kspec item trait add @spec @trait\nNote: traits add inherited AC automatically.\n"
      },
      {
        "type": "check",
        "content": "Validate references - kspec validate --refs",
        "on_fail": "Fix reference issues (dangling parent refs, missing spec_ref/plan_ref links)"
      },
      {
        "type": "action",
        "content": "Start implementation.\nPick first task from: kspec plan get @plan --json (derived_tasks).\nUse: kspec task start @task\nThen follow /task-work for task lifecycle.\n"
      }
    ],
    "mode": "interactive",
    "tags": []
  },
  {
    "id": "spec-plan-manual",
    "trigger": "manual",
    "description": "Execute plan via incremental spec creation - create plan record, find parent, create specs with AC, review traits, derive tasks with plan linking, validate, start work. Follows @spec-plan-design.",
    "steps": [
      {
        "type": "action",
        "content": "Create plan record.\nUse: kspec plan add --title \"Plan Title\" --content \"Brief description of what's being planned\" --status approved\nStatus approved because you're committing to the work.\n",
        "inputs": [
          {
            "name": "plan_ref",
            "description": "The created plan reference",
            "type": "ref"
          }
        ]
      },
      {
        "type": "action",
        "content": "Find parent and create spec items.\nSearch: kspec search \"<keyword>\", kspec item list --tag <domain>, kspec item get @parent\nIf no suitable parent exists, create a module: kspec item add --type module --title \"Module Name\"\nCreate specs: kspec item add --under @parent --title \"Title\" --type feature --slug slug\nRepeat for each spec.\n",
        "inputs": [
          {
            "name": "parent_ref",
            "description": "Reference to the parent item",
            "type": "ref"
          }
        ]
      },
      {
        "type": "action",
        "content": "Add acceptance criteria.\nFor each spec: kspec item ac add @spec --given \"precondition\" --when \"action\" --then \"expected result\"\nEach AC independently testable. 3-5 AC per spec is typical.\nCover happy path and key edge cases.\n"
      },
      {
        "type": "action",
        "content": "Review and apply traits.\nUse: kspec trait list to browse available traits.\nConsider cross-cutting concerns for the spec type\n(CLI features often need: json-output, dry-run, error-guidance, semantic-exit-codes).\nApply: kspec item trait add @spec @trait\nTraits add inherited AC automatically.\n"
      },
      {
        "type": "action",
        "content": "Derive tasks and link to plan.\nPreview: kspec derive @spec --dry-run\nCreate: kspec derive @spec (recursive by default, creates task tree with dependencies)\nLink each derived task to plan: kspec task set @task --plan-ref @plan\nSet plan active: kspec plan set @plan --status active\nAdd implementation notes: kspec task note @task \"Implementation approach: ...\"\nNote: task set --plan-ref creates a one-way link (task->plan). The plan's derived_tasks\narray is only auto-updated by kspec plan derive and kspec plan import, not by manual linking.\n"
      },
      {
        "type": "check",
        "content": "Validate all references - kspec validate --refs. Verify spec_ref and plan_ref resolve correctly on tasks.",
        "on_fail": "Fix reference issues"
      },
      {
        "type": "action",
        "content": "Verify structure.\nkspec item status @spec shows linked tasks.\nFor each task: kspec task get @task confirms plan_ref and spec_ref are set.\nNote: check task-side links (not plan's derived_tasks which is not auto-updated in manual path).\n"
      },
      {
        "type": "action",
        "content": "Start implementation.\nUse: kspec task start @first-task\nThen follow /task-work for task lifecycle.\n"
      }
    ],
    "mode": "interactive",
    "tags": []
  },
  {
    "id": "pr-review-merge",
    "trigger": "pr-merge",
    "description": "Quality gate for reviewing and merging PRs. Ensures all CI passes, all reviews\naddressed, all requests completed, and all threads resolved before merge.\n\nCRITICAL: After ANY push, you MUST re-verify CI from the beginning. Do not trust\nprior CI checks - they are invalidated by new commits. Never merge without fresh\nCI verification on the current HEAD.\n",
    "steps": [
      {
        "type": "check",
        "content": "All CI checks complete (none pending or running)",
        "on_fail": "Wait for CI to finish. Do not merge while checks are running."
      },
      {
        "type": "check",
        "content": "All CI checks pass (green)",
        "on_fail": "Fix failures, push changes.\nWAIT for CI to re-run completely.\nTHEN re-verify this step (CI passing) before continuing - do not proceed while CI is running.\n"
      },
      {
        "type": "action",
        "content": "Read ALL review comments on the PR.\nUse: gh pr view --comments or GitHub UI\nCheck for: automated reviews, human reviews, inline comments.\n"
      },
      {
        "type": "check",
        "content": "All review feedback addressed (post findings, do NOT fix code)",
        "on_fail": "Post each finding as an inline PR comment with severity prefix (MUST-FIX:, SHOULD-FIX:, SUGGESTION:).\nDo NOT fix code yourself — you are a reviewer, not a fixer.\nIf MUST-FIX or SHOULD-FIX found: transition task to needs_work and exit without merging.\nUse: kspec task needs-work @task-ref --reason \"findings summary\"\n"
      },
      {
        "type": "action",
        "content": "Check for @claude mentions or other requests in comments.\nLook for actions the PR agent couldn't complete (limited permissions).\nExamples: add inbox items, run kspec commands, update tasks.\n"
      },
      {
        "type": "check",
        "content": "All requested actions completed",
        "on_fail": "Complete the actions yourself before proceeding."
      },
      {
        "type": "check",
        "content": "All review threads resolved in GitHub UI",
        "on_fail": "Click \"Resolve conversation\" on each thread after addressing.\nThe pr-review-resolution-check CI will block merge if threads remain.\n"
      },
      {
        "type": "check",
        "content": "FINAL CI VERIFICATION: Re-check CI status NOW.\nUse: gh pr checks or gh pr view --json statusCheckRollup\nALL checks must be complete AND passing on current HEAD.\nIf ANY changes were pushed during this workflow, CI must have re-run.\n",
        "on_fail": "DO NOT MERGE. Wait for CI to complete and pass.\nIf CI is failing, fix issues and restart workflow from beginning.\n"
      },
      {
        "type": "decision",
        "content": "Ready to merge?",
        "options": [
          "Yes - all checks green, no MUST-FIX or SHOULD-FIX, all threads resolved",
          "Issues found - kick back to worker (kspec task needs-work @task --reason \"...\")",
          "No - need user approval to merge with known issues",
          "Skip - user explicitly said to merge anyway"
        ]
      },
      {
        "type": "action",
        "content": "Merge the PR.\nUse: gh pr merge --merge --delete-branch\nOr: GitHub UI merge button\n"
      }
    ],
    "mode": "interactive",
    "tags": []
  },
  {
    "id": "task-work-loop",
    "trigger": "manual",
    "description": "Loop variant of task-work-session for autonomous agents. Auto-filters to automation-eligible tasks, auto-resolves decisions. Task selection: needs_work > in_progress > unblocking > priority. Includes local-review subagent step and fix cycle handling for needs_work tasks. Verifies work needed including trait AC coverage. Implementation quality: search for existing utilities, match code style, run full test suite. PR review handled externally by ralph.",
    "steps": [
      {
        "type": "action",
        "content": "Filter to automation-eligible tasks only.\nUse: kspec tasks ready --eligible\nThis ensures only tasks marked automation: eligible are considered.\n",
        "execution": {
          "mode": "silent"
        }
      },
      {
        "type": "decision",
        "content": "Select task by priority order.\nFirst, run `kspec tasks ready --eligible` — its output is authoritative. Do not select exit based on assumptions.\nCheck in order:\n1. needs_work tasks (fix cycle — address review feedback, highest priority)\n2. in_progress tasks (continue existing work)\n3. Ready tasks that unblock others (high impact)\n4. Highest priority ready task (lowest number = higher priority)\n\nNote: pending_review tasks are handled externally by ralph spawning PR review subagents.\n",
        "options": [
          "needs_work task exists -> fix review feedback (fix cycle)",
          "in_progress task exists -> continue that task",
          "Ready task unblocks others -> select that task",
          "Only isolated ready tasks -> select highest priority (lowest number)",
          "`kspec tasks ready --eligible` returned empty -> stop responding (ralph exits automatically)",
          "`kspec tasks ready --eligible` shows all blocked -> stop responding (ralph exits automatically)"
        ],
        "execution": {
          "mode": "silent"
        }
      },
      {
        "type": "check",
        "content": "Verify work is needed - but VALIDATE, don't trust notes.\n\nNotes are context, not proof. If a task is in the queue, there's a reason.\n\nTo mark \"Already implemented\" you MUST:\n1. RUN the tests (npm test) - they must PASS, not skip\n2. VERIFY own AC coverage - each spec AC has a test annotated // AC: @spec-ref ac-N\n3. VERIFY trait AC coverage - each inherited trait AC has a test annotated // AC: @trait-slug ac-N\n4. RUN kspec validate - zero trait AC coverage warnings for your spec\n5. CHECK implementation matches spec requirements\n\nDO NOT mark complete just because:\n- Notes say \"already done\" (verify yourself)\n- Tests exist but skip in CI (that's a gap to fix)\n- Someone said it was implemented (run the tests)\n\nTreat this like a code review - validate the actual work.\n",
        "on_fail": "Only if tests PASS and ACs are COVERED:\nMark task complete with \"Already implemented\" reason and EXIT\n",
        "execution": {
          "mode": "silent"
        }
      },
      {
        "type": "action",
        "content": "Start selected task (if not already in_progress).\nUse: kspec task start @task\n\nIf task has plan_ref, load plan context before deep implementation work:\n  1. Check task link: kspec task get @task\n  2. If plan_ref is non-null: kspec plan get @plan-ref\n",
        "execution": {
          "mode": "silent"
        }
      },
      {
        "type": "action",
        "content": "Work on the task, adding notes as you go.\nUse: kspec task note @task \"What you're doing...\"\nAdd notes during work, not just at end.\n\nSCOPE EXPANSION: If you discover missing implementation while testing,\nimplementing it IS in scope. The goal is verified behavior, not just test files.\n\"Add tests for X\" means \"ensure X is verified\" - if X doesn't exist, implement it.\n"
      },
      {
        "type": "check",
        "content": "Verify Definition of Done before committing.\n\nRead task notes for any DoD criteria. Common constraints:\n- \"No test.skip() calls\" - verify no skipped tests in changes\n- \"All own ACs covered\" - verify each spec AC has corresponding test\n- \"All trait ACs covered\" - verify each inherited trait AC has test\n- \"No TODO/FIXME\" - no placeholder comments\n- \"No duplicated logic\" - search for existing utilities before writing new code\n\nCRITICAL: Never use test.skip() to document missing functionality.\nIf functionality is missing, implement it - that's in scope.\n\nIf DoD criteria exist and are not met, fix the gaps first.\n",
        "on_fail": "Do not proceed with DoD violations.\nEither fix the gaps or escalate to user if scope is unclear.\n",
        "execution": {
          "mode": "silent"
        }
      },
      {
        "type": "action",
        "content": "Commit changes with Task: @task trailer.\nAll changes must be committed before submitting.\n",
        "execution": {
          "mode": "silent"
        }
      },
      {
        "type": "action",
        "content": "Run local review via subagent before submitting.\nSpawn a subagent using Task tool with prompt:\n\"Run /local-review for @spec-ref. Report all findings with severity.\"\n\nIf MUST-FIX findings: fix them, re-commit, re-run local review.\nIf SHOULD-FIX or SUGGESTION only: note findings, proceed to submit.\nIf actionable items not worth fixing now: kspec inbox add \"...\"\n",
        "execution": {
          "mode": "silent"
        }
      },
      {
        "type": "action",
        "content": "If this is a fix cycle (needs_work task):\n  1. Read PR review comments: gh api repos/{owner}/{repo}/pulls/{number}/reviews\n  2. Fix MUST-FIX and SHOULD-FIX issues identified in comments\n  3. Commit and push fixes to PR branch\n  4. Submit task: kspec task submit @task\n  5. Stop responding — reviewer re-reviews in next iteration\n\nOtherwise (new work):\n  1. Submit task: kspec task submit @task\n  2. Create PR: /pr skill\n  3. Stop responding — ralph handles PR review via separate subagent\n",
        "execution": {
          "mode": "silent"
        }
      }
    ],
    "mode": "interactive",
    "tags": []
  }
]
```
