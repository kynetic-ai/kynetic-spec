{"call_id":"call_gd2ppFuIwL4ELaT5WuRrAbqm","process_id":"49057","turn_id":"019ca75c-4080-7a22-a72e-400c8537695b","command":["/usr/bin/bash","-lc","nl -ba packages/web-ui/tests/e2e/triage.spec.ts | sed -n '1,280p'"],"cwd":"/home/chapel/Projects/kynetic-spec","parsed_cmd":[{"type":"read","cmd":"nl -ba packages/web-ui/tests/e2e/triage.spec.ts | sed -n '1,280p'","name":"triage.spec.ts","path":"packages/web-ui/tests/e2e/triage.spec.ts"}],"source":"unified_exec_startup","stdout":"     1\t/**\n     2\t * E2E tests for Interactive Triage UI\n     3\t *\n     4\t * Tests verify triage page behavior using a real browser against the running daemon.\n     5\t * These replace the static analysis tests in tests/web-ui-triage.test.ts which read\n     6\t * Svelte component source files for string patterns instead of testing UI behavior.\n     7\t *\n     8\t * Covered ACs:\n     9\t * - @interactive-triage-ui ac-1: Card view shows item text, tags, age, added_by\n    10\t * - @interactive-triage-ui ac-2: Shows agent recommendation for triaged items\n    11\t * - @interactive-triage-ui ac-3: Submit creates/updates record and advances\n    12\t * - @interactive-triage-ui ac-4: Override captures override with user attribution\n    13\t * - @interactive-triage-ui ac-5: Next/previous navigation, decision state display\n    14\t * - @interactive-triage-ui ac-6: Real-time updates via WebSocket triage:updates\n    15\t * - @interactive-triage-ui ac-7: Tag/status/action filters with progress count\n    16\t * - @interactive-triage-ui ac-8: Static mode: read-only, action buttons hidden\n    17\t */\n    18\t\n    19\t// Trait N/A annotations — @interactive-triage-ui inherits @trait-websocket-protocol.\n    20\t// Server-side WebSocket protocol behaviors are tested in api-websocket.spec.ts.\n    21\t// AC: @trait-websocket-protocol ac-1 — N/A: server connection ID assignment tested in api-websocket.spec.ts\n    22\t// AC: @trait-websocket-protocol ac-2 — N/A: server subscribe ack tested in api-websocket.spec.ts\n    23\t// AC: @trait-websocket-protocol ac-3 — N/A: server broadcast format tested in api-websocket.spec.ts\n    24\t// AC: @trait-websocket-protocol ac-4 — N/A: server heartbeat timing tested in api-websocket.spec.ts\n    25\t// AC: @trait-websocket-protocol ac-5 — N/A: server ping/pong timeout close with code 1001 tested in api-websocket.spec.ts\n    26\t// AC: @trait-websocket-protocol ac-6 — N/A: server backpressure handling tested in api-websocket.spec.ts\n    27\t// AC: @trait-websocket-protocol ac-7 — N/A: server close codes tested in api-websocket.spec.ts\n    28\t// AC: @trait-websocket-protocol ac-8 — N/A: client sequence reset on reconnect tested in api-websocket.spec.ts\n    29\t\n    30\timport { test, expect } from '../fixtures/test-base';\n    31\t\n    32\tconst ACTION_LABELS: Record<string, string> = {\n    33\t  promote: 'Promote to Task',\n    34\t  delete: 'Delete',\n    35\t  defer: 'Defer',\n    36\t  'spec-gap': 'Spec Gap',\n    37\t  duplicate: 'Duplicate',\n    38\t};\n    39\t\n    40\ttest.describe('Interactive Triage UI', () => {\n    41\t  test.beforeEach(async ({ page, daemon }) => {\n    42\t    void daemon;\n    43\t    await page.goto('/triage');\n    44\t    // Wait for page to load — either items or empty state\n    45\t    await page.waitForLoadState('networkidle');\n    46\t  });\n    47\t\n    48\t  // AC: @interactive-triage-ui ac-1\n    49\t  test('displays card view with item text, tags, age, and added_by when items exist', async ({ page }) => {\n    50\t    const card = page.getByTestId('triage-card');\n    51\t    const hasCard = await card.isVisible().catch(() => false);\n    52\t\n    53\t    if (hasCard) {\n    54\t      // Card has text\n    55\t      await expect(card.getByTestId('triage-card-text')).toBeVisible();\n    56\t      // Meta info section is present\n    57\t      await expect(card.getByTestId('triage-card-meta')).toBeVisible();\n    58\t      // Age and added_by are shown\n    59\t      await expect(card.getByTestId('triage-card-age')).toBeVisible();\n    60\t      await expect(card.getByTestId('triage-card-added-by')).toBeVisible();\n    61\t    }\n    62\t  });\n    63\t\n    64\t  // AC: @interactive-triage-ui ac-2\n    65\t  test('shows agent recommendation section for triaged items', async ({ page }) => {\n    66\t    // Navigate to find a triaged item (may need multiple cards)\n    67\t    // The fixture data has triaged records, so if we can navigate to one we test ac-2\n    68\t    const card = page.getByTestId('triage-card');\n    69\t    const hasCard = await card.isVisible().catch(() => false);\n    70\t\n    71\t    if (hasCard) {\n    72\t      // Check if current item has recommendation (triaged status)\n    73\t      const hasRecommendation = await card.getByTestId('triage-agent-recommendation').isVisible().catch(() => false);\n    74\t      if (hasRecommendation) {\n    75\t        // AC: @interactive-triage-ui ac-2 — recommendation section shows action, reasoning, evidence\n    76\t        await expect(card.getByTestId('triage-rec-action')).toBeVisible();\n    77\t        await expect(card.getByTestId('triage-rec-reasoning')).toBeVisible();\n    78\t      }\n    79\t    }\n    80\t  });\n    81\t\n    82\t  // AC: @interactive-triage-ui ac-5\n    83\t  test('supports next/previous navigation between items', async ({ page }) => {\n    84\t    const prevBtn = page.getByTestId('triage-prev');\n    85\t    const nextBtn = page.getByTestId('triage-next');\n    86\t    const position = page.getByTestId('triage-position');\n    87\t\n    88\t    // Navigation controls and position indicator are always shown\n    89\t    await expect(prevBtn).toBeVisible();\n    90\t    await expect(nextBtn).toBeVisible();\n    91\t    await expect(position).toBeVisible();\n    92\t\n    93\t    // Position shows N/total format\n    94\t    const posText = await position.textContent();\n    95\t    expect(posText).toMatch(/\\d+\\s*\\/\\s*\\d+/);\n    96\t  });\n    97\t\n    98\t  // AC: @interactive-triage-ui ac-5\n    99\t  test('shows decision state indicator on already-triaged cards', async ({ page }) => {\n   100\t    // Triage card status badge shows when item has been triaged/acted\n   101\t    const card = page.getByTestId('triage-card');\n   102\t    const hasCard = await card.isVisible().catch(() => false);\n   103\t\n   104\t    if (hasCard) {\n   105\t      // Navigate through items looking for one with a status badge\n   106\t      const maxNavigations = 5;\n   107\t      let found = false;\n   108\t      for (let i = 0; i < maxNavigations; i++) {\n   109\t        const hasStatus = await card.getByTestId('triage-card-status').isVisible().catch(() => false);\n   110\t        if (hasStatus) {\n   111\t          found = true;\n   112\t          break;\n   113\t        }\n   114\t        const nextBtn = page.getByTestId('triage-next');\n   115\t        const isEnabled = await nextBtn.isEnabled().catch(() => false);\n   116\t        if (!isEnabled) break;\n   117\t        await nextBtn.click();\n   118\t        await page.waitForTimeout(200);\n   119\t      }\n   120\t      // Either found a status badge (AC verified) or no triaged items in current view\n   121\t      expect(found || !found).toBe(true); // non-failing assertion for optional state\n   122\t    }\n   123\t  });\n   124\t\n   125\t  // AC: @interactive-triage-ui ac-7\n   126\t  test('displays filter controls and progress count', async ({ page }) => {\n   127\t    // Filter and progress elements are always rendered on the page\n   128\t    await expect(page.getByTestId('triage-filters')).toBeVisible();\n   129\t    await expect(page.getByTestId('triage-status-filter')).toBeVisible();\n   130\t    await expect(page.getByTestId('triage-action-filter')).toBeVisible();\n   131\t    await expect(page.getByTestId('triage-progress')).toBeVisible();\n   132\t    await expect(page.getByTestId('triage-progress-bar')).toBeVisible();\n   133\t  });\n   134\t\n   135\t  // AC: @interactive-triage-ui ac-7\n   136\t  test('tag filter controls are visible', async ({ page }) => {\n   137\t    // Tag filter exists alongside status filter\n   138\t    await expect(page.getByTestId('triage-tag-filter')).toBeVisible();\n   139\t  });\n   140\t\n   141\t  // AC: @interactive-triage-ui ac-7\n   142\t  test('action filter narrows cards by triage action and resets card index', async ({ page, request }) => {\n   143\t    let targetAction = 'defer';\n   144\t    const triageListResponse = await request.get('http://localhost:3456/api/triage?limit=1000');\n   145\t    expect(triageListResponse.ok()).toBe(true);\n   146\t    const triageListBody = await triageListResponse.json();\n   147\t    const existingAction = triageListBody.items.find((item: { action?: string | null }) => item.action)?.action;\n   148\t\n   149\t    if (existingAction) {\n   150\t      targetAction = existingAction;\n   151\t    } else {\n   152\t      const inboxResponse = await request.post('http://localhost:3456/api/inbox', {\n   153\t        data: { text: `Action filter test item ${Date.now()}` },\n   154\t      });\n   155\t      expect(inboxResponse.status()).toBe(200);\n   156\t      const inboxBody = await inboxResponse.json();\n   157\t      const inboxUlid = inboxBody.item._ulid;\n   158\t\n   159\t      const triageResponse = await request.post('http://localhost:3456/api/triage', {\n   160\t        data: {\n   161\t          inbox_ref: `@${inboxUlid}`,\n   162\t          action: targetAction,\n   163\t          reasoning: 'Create deterministic action-filter test record',\n   164\t        },\n   165\t      });\n   166\t      expect(triageResponse.status()).toBe(200);\n   167\t      await page.reload();\n   168\t      await page.waitForLoadState('networkidle');\n   169\t    }\n   170\t\n   171\t    const nextBtn = page.getByTestId('triage-next');\n   172\t    if (await nextBtn.isEnabled()) {\n   173\t      await nextBtn.click();\n   174\t    }\n   175\t\n   176\t    await page.getByTestId('triage-action-filter').selectOption(targetAction);\n   177\t\n   178\t    // Filter change should reset navigation index to the first matching card.\n   179\t    await expect(page.getByTestId('triage-position')).toContainText(/^1\\s*\\/\\s*\\d+/);\n   180\t    await expect(page.getByTestId('triage-progress')).toContainText('Showing');\n   181\t    await expect(page.getByTestId('triage-rec-action')).toContainText(ACTION_LABELS[targetAction]);\n   182\t  });\n   183\t\n   184\t  // AC: @interactive-triage-ui ac-8\n   185\t  test('in daemon mode (non-static), action form is visible on triage card', async ({ page }) => {\n   186\t    const card = page.getByTestId('triage-card');\n   187\t    const hasCard = await card.isVisible().catch(() => false);\n   188\t\n   189\t    if (hasCard) {\n   190\t      // In live daemon mode (not static), action form should be available for pending items\n   191\t      const actionForm = card.getByTestId('triage-action-form');\n   192\t      const hasForm = await actionForm.isVisible().catch(() => false);\n   193\t\n   194\t      // If item is pending, form should be shown; if already acted, it may not be\n   195\t      // Either way, the page is NOT in static mode (we're running against daemon)\n   196\t      const staticNotice = page.getByTestId('triage-static-notice');\n   197\t      const hasStaticNotice = await staticNotice.isVisible().catch(() => false);\n   198\t      // In E2E with running daemon, static mode notice should NOT be shown\n   199\t      expect(hasStaticNotice).toBe(false);\n   200\t    }\n   201\t  });\n   202\t\n   203\t  // AC: @interactive-triage-ui ac-3\n   204\t  test('submit button is present and enabled for action selection', async ({ page }) => {\n   205\t    const card = page.getByTestId('triage-card');\n   206\t    const hasCard = await card.isVisible().catch(() => false);\n   207\t\n   208\t    if (hasCard) {\n   209\t      const actionForm = card.getByTestId('triage-action-form');\n   210\t      const hasForm = await actionForm.isVisible().catch(() => false);\n   211\t\n   212\t      if (hasForm) {\n   213\t        // Action buttons are shown for selecting triage decisions\n   214\t        const actionButtons = actionForm.getByTestId(/^triage-action-/);\n   215\t        const buttonCount = await actionButtons.count();\n   216\t        expect(buttonCount).toBeGreaterThan(0);\n   217\t\n   218\t        // Submit button exists (may be disabled until action selected)\n   219\t        await expect(actionForm.getByTestId('triage-submit')).toBeVisible();\n   220\t      }\n   221\t    }\n   222\t  });\n   223\t\n   224\t  // AC: @interactive-triage-ui ac-4\n   225\t  test('override button appears for already-triaged items', async ({ page }) => {\n   226\t    // Items with existing triage records show override option\n   227\t    const card = page.getByTestId('triage-card');\n   228\t    const hasCard = await card.isVisible().catch(() => false);\n   229\t\n   230\t    if (hasCard) {\n   231\t      // Navigate to find a triaged item\n   232\t      const maxNavigations = 5;\n   233\t      for (let i = 0; i < maxNavigations; i++) {\n   234\t        const hasOverride = await card.locator('text=Override Decision').isVisible().catch(() => false);\n   235\t        if (hasOverride) {\n   236\t          // AC: @interactive-triage-ui ac-4 — override button found\n   237\t          expect(hasOverride).toBe(true);\n   238\t          return;\n   239\t        }\n   240\t        const nextBtn = page.getByTestId('triage-next');\n   241\t        const isEnabled = await nextBtn.isEnabled().catch(() => false);\n   242\t        if (!isEnabled) break;\n   243\t        await nextBtn.click();\n   244\t        await page.waitForTimeout(200);\n   245\t      }\n   246\t    }\n   247\t  });\n   248\t});\n   249\t\n   250\ttest.describe('Triage real-time updates via WebSocket', () => {\n   251\t  // AC: @interactive-triage-ui ac-6\n   252\t  test('triage page updates progress count in real-time when another client submits a triage decision', async ({ page, request, daemon }) => {\n   253\t    void daemon;\n   254\t    // Open triage page — Svelte component subscribes to triage:updates on mount\n   255\t    await page.goto('/triage');\n   256\t    await page.waitForLoadState('networkidle');\n   257\t\n   258\t    // Record initial progress count from the triage-progress element\n   259\t    const progressEl = page.getByTestId('triage-progress');\n   260\t    await expect(progressEl).toBeVisible();\n   261\t    const initialProgress = await progressEl.textContent();\n   262\t\n   263\t    // Create a fresh inbox item to triage (so we don't conflict with fixture records)\n   264\t    const inboxResp = await request.post('http://localhost:3456/api/inbox', {\n   265\t      data: { text: `Real-time update test item ${Date.now()}` },\n   266\t    });\n   267\t    expect(inboxResp.status()).toBe(200);\n   268\t    const inboxBody = await inboxResp.json();\n   269\t    const newInboxUlid = inboxBody.item._ulid;\n   270\t\n   271\t    // POST triage decision via API (simulates another client acting on the item).\n   272\t    // The daemon broadcasts triage:updates after mutation, which the triage page\n   273\t    // receives and calls loadTriageData() to refresh the displayed count.\n   274\t    const triageResp = await request.post('http://localhost:3456/api/triage', {\n   275\t      data: {\n   276\t        inbox_ref: `@${newInboxUlid}`,\n   277\t        action: 'defer',\n   278\t        reasoning: 'E2E real-time test',\n   279\t      },\n   280\t    });\n","stderr":"","aggregated_output":"     1\t/**\n     2\t * E2E tests for Interactive Triage UI\n     3\t *\n     4\t * Tests verify triage page behavior using a real browser against the running daemon.\n     5\t * These replace the static analysis tests in tests/web-ui-triage.test.ts which read\n     6\t * Svelte component source files for string patterns instead of testing UI behavior.\n     7\t *\n     8\t * Covered ACs:\n     9\t * - @interactive-triage-ui ac-1: Card view shows item text, tags, age, added_by\n    10\t * - @interactive-triage-ui ac-2: Shows agent recommendation for triaged items\n    11\t * - @interactive-triage-ui ac-3: Submit creates/updates record and advances\n    12\t * - @interactive-triage-ui ac-4: Override captures override with user attribution\n    13\t * - @interactive-triage-ui ac-5: Next/previous navigation, decision state display\n    14\t * - @interactive-triage-ui ac-6: Real-time updates via WebSocket triage:updates\n    15\t * - @interactive-triage-ui ac-7: Tag/status/action filters with progress count\n    16\t * - @interactive-triage-ui ac-8: Static mode: read-only, action buttons hidden\n    17\t */\n    18\t\n    19\t// Trait N/A annotations — @interactive-triage-ui inherits @trait-websocket-protocol.\n    20\t// Server-side WebSocket protocol behaviors are tested in api-websocket.spec.ts.\n    21\t// AC: @trait-websocket-protocol ac-1 — N/A: server connection ID assignment tested in api-websocket.spec.ts\n    22\t// AC: @trait-websocket-protocol ac-2 — N/A: server subscribe ack tested in api-websocket.spec.ts\n    23\t// AC: @trait-websocket-protocol ac-3 — N/A: server broadcast format tested in api-websocket.spec.ts\n    24\t// AC: @trait-websocket-protocol ac-4 — N/A: server heartbeat timing tested in api-websocket.spec.ts\n    25\t// AC: @trait-websocket-protocol ac-5 — N/A: server ping/pong timeout close with code 1001 tested in api-websocket.spec.ts\n    26\t// AC: @trait-websocket-protocol ac-6 — N/A: server backpressure handling tested in api-websocket.spec.ts\n    27\t// AC: @trait-websocket-protocol ac-7 — N/A: server close codes tested in api-websocket.spec.ts\n    28\t// AC: @trait-websocket-protocol ac-8 — N/A: client sequence reset on reconnect tested in api-websocket.spec.ts\n    29\t\n    30\timport { test, expect } from '../fixtures/test-base';\n    31\t\n    32\tconst ACTION_LABELS: Record<string, string> = {\n    33\t  promote: 'Promote to Task',\n    34\t  delete: 'Delete',\n    35\t  defer: 'Defer',\n    36\t  'spec-gap': 'Spec Gap',\n    37\t  duplicate: 'Duplicate',\n    38\t};\n    39\t\n    40\ttest.describe('Interactive Triage UI', () => {\n    41\t  test.beforeEach(async ({ page, daemon }) => {\n    42\t    void daemon;\n    43\t    await page.goto('/triage');\n    44\t    // Wait for page to load — either items or empty state\n    45\t    await page.waitForLoadState('networkidle');\n    46\t  });\n    47\t\n    48\t  // AC: @interactive-triage-ui ac-1\n    49\t  test('displays card view with item text, tags, age, and added_by when items exist', async ({ page }) => {\n    50\t    const card = page.getByTestId('triage-card');\n    51\t    const hasCard = await card.isVisible().catch(() => false);\n    52\t\n    53\t    if (hasCard) {\n    54\t      // Card has text\n    55\t      await expect(card.getByTestId('triage-card-text')).toBeVisible();\n    56\t      // Meta info section is present\n    57\t      await expect(card.getByTestId('triage-card-meta')).toBeVisible();\n    58\t      // Age and added_by are shown\n    59\t      await expect(card.getByTestId('triage-card-age')).toBeVisible();\n    60\t      await expect(card.getByTestId('triage-card-added-by')).toBeVisible();\n    61\t    }\n    62\t  });\n    63\t\n    64\t  // AC: @interactive-triage-ui ac-2\n    65\t  test('shows agent recommendation section for triaged items', async ({ page }) => {\n    66\t    // Navigate to find a triaged item (may need multiple cards)\n    67\t    // The fixture data has triaged records, so if we can navigate to one we test ac-2\n    68\t    const card = page.getByTestId('triage-card');\n    69\t    const hasCard = await card.isVisible().catch(() => false);\n    70\t\n    71\t    if (hasCard) {\n    72\t      // Check if current item has recommendation (triaged status)\n    73\t      const hasRecommendation = await card.getByTestId('triage-agent-recommendation').isVisible().catch(() => false);\n    74\t      if (hasRecommendation) {\n    75\t        // AC: @interactive-triage-ui ac-2 — recommendation section shows action, reasoning, evidence\n    76\t        await expect(card.getByTestId('triage-rec-action')).toBeVisible();\n    77\t        await expect(card.getByTestId('triage-rec-reasoning')).toBeVisible();\n    78\t      }\n    79\t    }\n    80\t  });\n    81\t\n    82\t  // AC: @interactive-triage-ui ac-5\n    83\t  test('supports next/previous navigation between items', async ({ page }) => {\n    84\t    const prevBtn = page.getByTestId('triage-prev');\n    85\t    const nextBtn = page.getByTestId('triage-next');\n    86\t    const position = page.getByTestId('triage-position');\n    87\t\n    88\t    // Navigation controls and position indicator are always shown\n    89\t    await expect(prevBtn).toBeVisible();\n    90\t    await expect(nextBtn).toBeVisible();\n    91\t    await expect(position).toBeVisible();\n    92\t\n    93\t    // Position shows N/total format\n    94\t    const posText = await position.textContent();\n    95\t    expect(posText).toMatch(/\\d+\\s*\\/\\s*\\d+/);\n    96\t  });\n    97\t\n    98\t  // AC: @interactive-triage-ui ac-5\n    99\t  test('shows decision state indicator on already-triaged cards', async ({ page }) => {\n   100\t    // Triage card status badge shows when item has been triaged/acted\n   101\t    const card = page.getByTestId('triage-card');\n   102\t    const hasCard = await card.isVisible().catch(() => false);\n   103\t\n   104\t    if (hasCard) {\n   105\t      // Navigate through items looking for one with a status badge\n   106\t      const maxNavigations = 5;\n   107\t      let found = false;\n   108\t      for (let i = 0; i < maxNavigations; i++) {\n   109\t        const hasStatus = await card.getByTestId('triage-card-status').isVisible().catch(() => false);\n   110\t        if (hasStatus) {\n   111\t          found = true;\n   112\t          break;\n   113\t        }\n   114\t        const nextBtn = page.getByTestId('triage-next');\n   115\t        const isEnabled = await nextBtn.isEnabled().catch(() => false);\n   116\t        if (!isEnabled) break;\n   117\t        await nextBtn.click();\n   118\t        await page.waitForTimeout(200);\n   119\t      }\n   120\t      // Either found a status badge (AC verified) or no triaged items in current view\n   121\t      expect(found || !found).toBe(true); // non-failing assertion for optional state\n   122\t    }\n   123\t  });\n   124\t\n   125\t  // AC: @interactive-triage-ui ac-7\n   126\t  test('displays filter controls and progress count', async ({ page }) => {\n   127\t    // Filter and progress elements are always rendered on the page\n   128\t    await expect(page.getByTestId('triage-filters')).toBeVisible();\n   129\t    await expect(page.getByTestId('triage-status-filter')).toBeVisible();\n   130\t    await expect(page.getByTestId('triage-action-filter')).toBeVisible();\n   131\t    await expect(page.getByTestId('triage-progress')).toBeVisible();\n   132\t    await expect(page.getByTestId('triage-progress-bar')).toBeVisible();\n   133\t  });\n   134\t\n   135\t  // AC: @interactive-triage-ui ac-7\n   136\t  test('tag filter controls are visible', async ({ page }) => {\n   137\t    // Tag filter exists alongside status filter\n   138\t    await expect(page.getByTestId('triage-tag-filter')).toBeVisible();\n   139\t  });\n   140\t\n   141\t  // AC: @interactive-triage-ui ac-7\n   142\t  test('action filter narrows cards by triage action and resets card index', async ({ page, request }) => {\n   143\t    let targetAction = 'defer';\n   144\t    const triageListResponse = await request.get('http://localhost:3456/api/triage?limit=1000');\n   145\t    expect(triageListResponse.ok()).toBe(true);\n   146\t    const triageListBody = await triageListResponse.json();\n   147\t    const existingAction = triageListBody.items.find((item: { action?: string | null }) => item.action)?.action;\n   148\t\n   149\t    if (existingAction) {\n   150\t      targetAction = existingAction;\n   151\t    } else {\n   152\t      const inboxResponse = await request.post('http://localhost:3456/api/inbox', {\n   153\t        data: { text: `Action filter test item ${Date.now()}` },\n   154\t      });\n   155\t      expect(inboxResponse.status()).toBe(200);\n   156\t      const inboxBody = await inboxResponse.json();\n   157\t      const inboxUlid = inboxBody.item._ulid;\n   158\t\n   159\t      const triageResponse = await request.post('http://localhost:3456/api/triage', {\n   160\t        data: {\n   161\t          inbox_ref: `@${inboxUlid}`,\n   162\t          action: targetAction,\n   163\t          reasoning: 'Create deterministic action-filter test record',\n   164\t        },\n   165\t      });\n   166\t      expect(triageResponse.status()).toBe(200);\n   167\t      await page.reload();\n   168\t      await page.waitForLoadState('networkidle');\n   169\t    }\n   170\t\n   171\t    const nextBtn = page.getByTestId('triage-next');\n   172\t    if (await nextBtn.isEnabled()) {\n   173\t      await nextBtn.click();\n   174\t    }\n   175\t\n   176\t    await page.getByTestId('triage-action-filter').selectOption(targetAction);\n   177\t\n   178\t    // Filter change should reset navigation index to the first matching card.\n   179\t    await expect(page.getByTestId('triage-position')).toContainText(/^1\\s*\\/\\s*\\d+/);\n   180\t    await expect(page.getByTestId('triage-progress')).toContainText('Showing');\n   181\t    await expect(page.getByTestId('triage-rec-action')).toContainText(ACTION_LABELS[targetAction]);\n   182\t  });\n   183\t\n   184\t  // AC: @interactive-triage-ui ac-8\n   185\t  test('in daemon mode (non-static), action form is visible on triage card', async ({ page }) => {\n   186\t    const card = page.getByTestId('triage-card');\n   187\t    const hasCard = await card.isVisible().catch(() => false);\n   188\t\n   189\t    if (hasCard) {\n   190\t      // In live daemon mode (not static), action form should be available for pending items\n   191\t      const actionForm = card.getByTestId('triage-action-form');\n   192\t      const hasForm = await actionForm.isVisible().catch(() => false);\n   193\t\n   194\t      // If item is pending, form should be shown; if already acted, it may not be\n   195\t      // Either way, the page is NOT in static mode (we're running against daemon)\n   196\t      const staticNotice = page.getByTestId('triage-static-notice');\n   197\t      const hasStaticNotice = await staticNotice.isVisible().catch(() => false);\n   198\t      // In E2E with running daemon, static mode notice should NOT be shown\n   199\t      expect(hasStaticNotice).toBe(false);\n   200\t    }\n   201\t  });\n   202\t\n   203\t  // AC: @interactive-triage-ui ac-3\n   204\t  test('submit button is present and enabled for action selection', async ({ page }) => {\n   205\t    const card = page.getByTestId('triage-card');\n   206\t    const hasCard = await card.isVisible().catch(() => false);\n   207\t\n   208\t    if (hasCard) {\n   209\t      const actionForm = card.getByTestId('triage-action-form');\n   210\t      const hasForm = await actionForm.isVisible().catch(() => false);\n   211\t\n   212\t      if (hasForm) {\n   213\t        // Action buttons are shown for selecting triage decisions\n   214\t        const actionButtons = actionForm.getByTestId(/^triage-action-/);\n   215\t        const buttonCount = await actionButtons.count();\n   216\t        expect(buttonCount).toBeGreaterThan(0);\n   217\t\n   218\t        // Submit button exists (may be disabled until action selected)\n   219\t        await expect(actionForm.getByTestId('triage-submit')).toBeVisible();\n   220\t      }\n   221\t    }\n   222\t  });\n   223\t\n   224\t  // AC: @interactive-triage-ui ac-4\n   225\t  test('override button appears for already-triaged items', async ({ page }) => {\n   226\t    // Items with existing triage records show override option\n   227\t    const card = page.getByTestId('triage-card');\n   228\t    const hasCard = await card.isVisible().catch(() => false);\n   229\t\n   230\t    if (hasCard) {\n   231\t      // Navigate to find a triaged item\n   232\t      const maxNavigations = 5;\n   233\t      for (let i = 0; i < maxNavigations; i++) {\n   234\t        const hasOverride = await card.locator('text=Override Decision').isVisible().catch(() => false);\n   235\t        if (hasOverride) {\n   236\t          // AC: @interactive-triage-ui ac-4 — override button found\n   237\t          expect(hasOverride).toBe(true);\n   238\t          return;\n   239\t        }\n   240\t        const nextBtn = page.getByTestId('triage-next');\n   241\t        const isEnabled = await nextBtn.isEnabled().catch(() => false);\n   242\t        if (!isEnabled) break;\n   243\t        await nextBtn.click();\n   244\t        await page.waitForTimeout(200);\n   245\t      }\n   246\t    }\n   247\t  });\n   248\t});\n   249\t\n   250\ttest.describe('Triage real-time updates via WebSocket', () => {\n   251\t  // AC: @interactive-triage-ui ac-6\n   252\t  test('triage page updates progress count in real-time when another client submits a triage decision', async ({ page, request, daemon }) => {\n   253\t    void daemon;\n   254\t    // Open triage page — Svelte component subscribes to triage:updates on mount\n   255\t    await page.goto('/triage');\n   256\t    await page.waitForLoadState('networkidle');\n   257\t\n   258\t    // Record initial progress count from the triage-progress element\n   259\t    const progressEl = page.getByTestId('triage-progress');\n   260\t    await expect(progressEl).toBeVisible();\n   261\t    const initialProgress = await progressEl.textContent();\n   262\t\n   263\t    // Create a fresh inbox item to triage (so we don't conflict with fixture records)\n   264\t    const inboxResp = await request.post('http://localhost:3456/api/inbox', {\n   265\t      data: { text: `Real-time update test item ${Date.now()}` },\n   266\t    });\n   267\t    expect(inboxResp.status()).toBe(200);\n   268\t    const inboxBody = await inboxResp.json();\n   269\t    const newInboxUlid = inboxBody.item._ulid;\n   270\t\n   271\t    // POST triage decision via API (simulates another client acting on the item).\n   272\t    // The daemon broadcasts triage:updates after mutation, which the triage page\n   273\t    // receives and calls loadTriageData() to refresh the displayed count.\n   274\t    const triageResp = await request.post('http://localhost:3456/api/triage', {\n   275\t      data: {\n   276\t        inbox_ref: `@${newInboxUlid}`,\n   277\t        action: 'defer',\n   278\t        reasoning: 'E2E real-time test',\n   279\t      },\n   280\t    });\n","exit_code":0,"duration":{"secs":0,"nanos":51350629},"formatted_output":"     1\t/**\n     2\t * E2E tests for Interactive Triage UI\n     3\t *\n     4\t * Tests verify triage page behavior using a real browser against the running daemon.\n     5\t * These replace the static analysis tests in tests/web-ui-triage.test.ts which read\n     6\t * Svelte component source files for string patterns instead of testing UI behavior.\n     7\t *\n     8\t * Covered ACs:\n     9\t * - @interactive-triage-ui ac-1: Card view shows item text, tags, age, added_by\n    10\t * - @interactive-triage-ui ac-2: Shows agent recommendation for triaged items\n    11\t * - @interactive-triage-ui ac-3: Submit creates/updates record and advances\n    12\t * - @interactive-triage-ui ac-4: Override captures override with user attribution\n    13\t * - @interactive-triage-ui ac-5: Next/previous navigation, decision state display\n    14\t * - @interactive-triage-ui ac-6: Real-time updates via WebSocket triage:updates\n    15\t * - @interactive-triage-ui ac-7: Tag/status/action filters with progress count\n    16\t * - @interactive-triage-ui ac-8: Static mode: read-only, action buttons hidden\n    17\t */\n    18\t\n    19\t// Trait N/A annotations — @interactive-triage-ui inherits @trait-websocket-protocol.\n    20\t// Server-side WebSocket protocol behaviors are tested in api-websocket.spec.ts.\n    21\t// AC: @trait-websocket-protocol ac-1 — N/A: server connection ID assignment tested in api-websocket.spec.ts\n    22\t// AC: @trait-websocket-protocol ac-2 — N/A: server subscribe ack tested in api-websocket.spec.ts\n    23\t// AC: @trait-websocket-protocol ac-3 — N/A: server broadcast format tested in api-websocket.spec.ts\n    24\t// AC: @trait-websocket-protocol ac-4 — N/A: server heartbeat timing tested in api-websocket.spec.ts\n    25\t// AC: @trait-websocket-protocol ac-5 — N/A: server ping/pong timeout close with code 1001 tested in api-websocket.spec.ts\n    26\t// AC: @trait-websocket-protocol ac-6 — N/A: server backpressure handling tested in api-websocket.spec.ts\n    27\t// AC: @trait-websocket-protocol ac-7 — N/A: server close codes tested in api-websocket.spec.ts\n    28\t// AC: @trait-websocket-protocol ac-8 — N/A: client sequence reset on reconnect tested in api-websocket.spec.ts\n    29\t\n    30\timport { test, expect } from '../fixtures/test-base';\n    31\t\n    32\tconst ACTION_LABELS: Record<string, string> = {\n    33\t  promote: 'Promote to Task',\n    34\t  delete: 'Delete',\n    35\t  defer: 'Defer',\n    36\t  'spec-gap': 'Spec Gap',\n    37\t  duplicate: 'Duplicate',\n    38\t};\n    39\t\n    40\ttest.describe('Interactive Triage UI', () => {\n    41\t  test.beforeEach(async ({ page, daemon }) => {\n    42\t    void daemon;\n    43\t    await page.goto('/triage');\n    44\t    // Wait for page to load — either items or empty state\n    45\t    await page.waitForLoadState('networkidle');\n    46\t  });\n    47\t\n    48\t  // AC: @interactive-triage-ui ac-1\n    49\t  test('displays card view with item text, tags, age, and added_by when items exist', async ({ page }) => {\n    50\t    const card = page.getByTestId('triage-card');\n    51\t    const hasCard = await card.isVisible().catch(() => false);\n    52\t\n    53\t    if (hasCard) {\n    54\t      // Card has text\n    55\t      await expect(card.getByTestId('triage-card-text')).toBeVisible();\n    56\t      // Meta info section is present\n    57\t      await expect(card.getByTestId('triage-card-meta')).toBeVisible();\n    58\t      // Age and added_by are shown\n    59\t      await expect(card.getByTestId('triage-card-age')).toBeVisible();\n    60\t      await expect(card.getByTestId('triage-card-added-by')).toBeVisible();\n    61\t    }\n    62\t  });\n    63\t\n    64\t  // AC: @interactive-triage-ui ac-2\n    65\t  test('shows agent recommendation section for triaged items', async ({ page }) => {\n    66\t    // Navigate to find a triaged item (may need multiple cards)\n    67\t    // The fixture data has triaged records, so if we can navigate to one we test ac-2\n    68\t    const card = page.getByTestId('triage-card');\n    69\t    const hasCard = await card.isVisible().catch(() => false);\n    70\t\n    71\t    if (hasCard) {\n    72\t      // Check if current item has recommendation (triaged status)\n    73\t      const hasRecommendation = await card.getByTestId('triage-agent-recommendation').isVisible().catch(() => false);\n    74\t      if (hasRecommendation) {\n    75\t        // AC: @interactive-triage-ui ac-2 — recommendation section shows action, reasoning, evidence\n    76\t        await expect(card.getByTestId('triage-rec-action')).toBeVisible();\n    77\t        await expect(card.getByTestId('triage-rec-reasoning')).toBeVisible();\n    78\t      }\n    79\t    }\n    80\t  });\n    81\t\n    82\t  // AC: @interactive-triage-ui ac-5\n    83\t  test('supports next/previous navigation between items', async ({ page }) => {\n    84\t    const prevBtn = page.getByTestId('triage-prev');\n    85\t    const nextBtn = page.getByTestId('triage-next');\n    86\t    const position = page.getByTestId('triage-position');\n    87\t\n    88\t    // Navigation controls and position indicator are always shown\n    89\t    await expect(prevBtn).toBeVisible();\n    90\t    await expect(nextBtn).toBeVisible();\n    91\t    await expect(position).toBeVisible();\n    92\t\n    93\t    // Position shows N/total format\n    94\t    const posText = await position.textContent();\n    95\t    expect(posText).toMatch(/\\d+\\s*\\/\\s*\\d+/);\n    96\t  });\n    97\t\n    98\t  // AC: @interactive-triage-ui ac-5\n    99\t  test('shows decision state indicator on already-triaged cards', async ({ page }) => {\n   100\t    // Triage card status badge shows when item has been triaged/acted\n   101\t    const card = page.getByTestId('triage-card');\n   102\t    const hasCard = await card.isVisible().catch(() => false);\n   103\t\n   104\t    if (hasCard) {\n   105\t      // Navigate through items looking for one with a status badge\n   106\t      const maxNavigations = 5;\n   107\t      let found = false;\n   108\t      for (let i = 0; i < maxNavigations; i++) {\n   109\t        const hasStatus = await card.getByTestId('triage-card-status').isVisible().catch(() => false);\n   110\t        if (hasStatus) {\n   111\t          found = true;\n   112\t          break;\n   113\t        }\n   114\t        const nextBtn = page.getByTestId('triage-next');\n   115\t        const isEnabled = await nextBtn.isEnabled().catch(() => false);\n   116\t        if (!isEnabled) break;\n   117\t        await nextBtn.click();\n   118\t        await page.waitForTimeout(200);\n   119\t      }\n   120\t      // Either found a status badge (AC verified) or no triaged items in current view\n   121\t      expect(found || !found).toBe(true); // non-failing assertion for optional state\n   122\t    }\n   123\t  });\n   124\t\n   125\t  // AC: @interactive-triage-ui ac-7\n   126\t  test('displays filter controls and progress count', async ({ page }) => {\n   127\t    // Filter and progress elements are always rendered on the page\n   128\t    await expect(page.getByTestId('triage-filters')).toBeVisible();\n   129\t    await expect(page.getByTestId('triage-status-filter')).toBeVisible();\n   130\t    await expect(page.getByTestId('triage-action-filter')).toBeVisible();\n   131\t    await expect(page.getByTestId('triage-progress')).toBeVisible();\n   132\t    await expect(page.getByTestId('triage-progress-bar')).toBeVisible();\n   133\t  });\n   134\t\n   135\t  // AC: @interactive-triage-ui ac-7\n   136\t  test('tag filter controls are visible', async ({ page }) => {\n   137\t    // Tag filter exists alongside status filter\n   138\t    await expect(page.getByTestId('triage-tag-filter')).toBeVisible();\n   139\t  });\n   140\t\n   141\t  // AC: @interactive-triage-ui ac-7\n   142\t  test('action filter narrows cards by triage action and resets card index', async ({ page, request }) => {\n   143\t    let targetAction = 'defer';\n   144\t    const triageListResponse = await request.get('http://localhost:3456/api/triage?limit=1000');\n   145\t    expect(triageListResponse.ok()).toBe(true);\n   146\t    const triageListBody = await triageListResponse.json();\n   147\t    const existingAction = triageListBody.items.find((item: { action?: string | null }) => item.action)?.action;\n   148\t\n   149\t    if (existingAction) {\n   150\t      targetAction = existingAction;\n   151\t    } else {\n   152\t      const inboxResponse = await request.post('http://localhost:3456/api/inbox', {\n   153\t        data: { text: `Action filter test item ${Date.now()}` },\n   154\t      });\n   155\t      expect(inboxResponse.status()).toBe(200);\n   156\t      const inboxBody = await inboxResponse.json();\n   157\t      const inboxUlid = inboxBody.item._ulid;\n   158\t\n   159\t      const triageResponse = await request.post('http://localhost:3456/api/triage', {\n   160\t        data: {\n   161\t          inbox_ref: `@${inboxUlid}`,\n   162\t          action: targetAction,\n   163\t          reasoning: 'Create deterministic action-filter test record',\n   164\t        },\n   165\t      });\n   166\t      expect(triageResponse.status()).toBe(200);\n   167\t      await page.reload();\n   168\t      await page.waitForLoadState('networkidle');\n   169\t    }\n   170\t\n   171\t    const nextBtn = page.getByTestId('triage-next');\n   172\t    if (await nextBtn.isEnabled()) {\n   173\t      await nextBtn.click();\n   174\t    }\n   175\t\n   176\t    await page.getByTestId('triage-action-filter').selectOption(targetAction);\n   177\t\n   178\t    // Filter change should reset navigation index to the first matching card.\n   179\t    await expect(page.getByTestId('triage-position')).toContainText(/^1\\s*\\/\\s*\\d+/);\n   180\t    await expect(page.getByTestId('triage-progress')).toContainText('Showing');\n   181\t    await expect(page.getByTestId('triage-rec-action')).toContainText(ACTION_LABELS[targetAction]);\n   182\t  });\n   183\t\n   184\t  // AC: @interactive-triage-ui ac-8\n   185\t  test('in daemon mode (non-static), action form is visible on triage card', async ({ page }) => {\n   186\t    const card = page.getByTestId('triage-card');\n   187\t    const hasCard = await card.isVisible().catch(() => false);\n   188\t\n   189\t    if (hasCard) {\n   190\t      // In live daemon mode (not static), action form should be available for pending items\n   191\t      const actionForm = card.getByTestId('triage-action-form');\n   192\t      const hasForm = await actionForm.isVisible().catch(() => false);\n   193\t\n   194\t      // If item is pending, form should be shown; if already acted, it may not be\n   195\t      // Either way, the page is NOT in static mode (we're running against daemon)\n   196\t      const staticNotice = page.getByTestId('triage-static-notice');\n   197\t      const hasStaticNotice = await staticNotice.isVisible().catch(() => false);\n   198\t      // In E2E with running daemon, static mode notice should NOT be shown\n   199\t      expect(hasStaticNotice).toBe(false);\n   200\t    }\n   201\t  });\n   202\t\n   203\t  // AC: @interactive-triage-ui ac-3\n   204\t  test('submit button is present and enabled for action selection', async ({ page }) => {\n   205\t    const card = page.getByTestId('triage-card');\n   206\t    const hasCard = await card.isVisible().catch(() => false);\n   207\t\n   208\t    if (hasCard) {\n   209\t      const actionForm = card.getByTestId('triage-action-form');\n   210\t      const hasForm = await actionForm.isVisible().catch(() => false);\n   211\t\n   212\t      if (hasForm) {\n   213\t        // Action buttons are shown for selecting triage decisions\n   214\t        const actionButtons = actionForm.getByTestId(/^triage-action-/);\n   215\t        const buttonCount = await actionButtons.count();\n   216\t        expect(buttonCount).toBeGreaterThan(0);\n   217\t\n   218\t        // Submit button exists (may be disabled until action selected)\n   219\t        await expect(actionForm.getByTestId('triage-submit')).toBeVisible();\n   220\t      }\n   221\t    }\n   222\t  });\n   223\t\n   224\t  // AC: @interactive-triage-ui ac-4\n   225\t  test('override button appears for already-triaged items', async ({ page }) => {\n   226\t    // Items with existing triage records show override option\n   227\t    const card = page.getByTestId('triage-card');\n   228\t    const hasCard = await card.isVisible().catch(() => false);\n   229\t\n   230\t    if (hasCard) {\n   231\t      // Navigate to find a triaged item\n   232\t      const maxNavigations = 5;\n   233\t      for (let i = 0; i < maxNavigations; i++) {\n   234\t        const hasOverride = await card.locator('text=Override Decision').isVisible().catch(() => false);\n   235\t        if (hasOverride) {\n   236\t          // AC: @interactive-triage-ui ac-4 — override button found\n   237\t          expect(hasOverride).toBe(true);\n   238\t          return;\n   239\t        }\n   240\t        const nextBtn = page.getByTestId('triage-next');\n   241\t        const isEnabled = await nextBtn.isEnabled().catch(() => false);\n   242\t        if (!isEnabled) break;\n   243\t        await nextBtn.click();\n   244\t        await page.waitForTimeout(200);\n   245\t      }\n   246\t    }\n   247\t  });\n   248\t});\n   249\t\n   250\ttest.describe('Triage real-time updates via WebSocket', () => {\n   251\t  // AC: @interactive-triage-ui ac-6\n   252\t  test('triage page updates progress count in real-time when another client submits a triage decision', async ({ page, request, daemon }) => {\n   253\t    void daemon;\n   254\t    // Open triage page — Svelte component subscribes to triage:updates on mount\n   255\t    await page.goto('/triage');\n   256\t    await page.waitForLoadState('networkidle');\n   257\t\n   258\t    // Record initial progress count from the triage-progress element\n   259\t    const progressEl = page.getByTestId('triage-progress');\n   260\t    await expect(progressEl).toBeVisible();\n   261\t    const initialProgress = await progressEl.textContent();\n   262\t\n   263\t    // Create a fresh inbox item to triage (so we don't conflict with fixture records)\n   264\t    const inboxResp = await request.post('http://localhost:3456/api/inbox', {\n   265\t      data: { text: `Real-time update test item ${Date.now()}` },\n   266\t    });\n   267\t    expect(inboxResp.status()).toBe(200);\n   268\t    const inboxBody = await inboxResp.json();\n   269\t    const newInboxUlid = inboxBody.item._ulid;\n   270\t\n   271\t    // POST triage decision via API (simulates another client acting on the item).\n   272\t    // The daemon broadcasts triage:updates after mutation, which the triage page\n   273\t    // receives and calls loadTriageData() to refresh the displayed count.\n   274\t    const triageResp = await request.post('http://localhost:3456/api/triage', {\n   275\t      data: {\n   276\t        inbox_ref: `@${newInboxUlid}`,\n   277\t        action: 'defer',\n   278\t        reasoning: 'E2E real-time test',\n   279\t      },\n   280\t    });\n","status":"completed"}