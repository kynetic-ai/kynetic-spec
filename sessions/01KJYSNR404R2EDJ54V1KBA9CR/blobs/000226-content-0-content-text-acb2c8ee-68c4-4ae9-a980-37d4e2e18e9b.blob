   569→  });
   570→
   571→  describe('edge cases', () => {
   572→    it('handles empty content', async () => {
   573→      const { container } = render(StreamingMarkdown, {
   574→        content: '',
   575→        isStreaming: false,
   576→      });
   577→
   578→      // Should render without errors
   579→      await expect.poll(() => container.querySelector('.streaming-markdown')).not.toBeNull();
   580→    });
   581→
   582→    it('handles whitespace-only content', async () => {
   583→      const { container } = render(StreamingMarkdown, {
   584→        content: '   \n\n   ',
   585→        isStreaming: false,
   586→      });
   587→
   588→      // Should render without errors
   589→      await expect.poll(() => container.querySelector('.streaming-markdown')).not.toBeNull();
   590→    });
   591→
   592→    it('handles very long content', async () => {
   593→      const longContent = 'A'.repeat(10000);
   594→      const { container } = render(StreamingMarkdown, {
   595→        content: longContent,
   596→        isStreaming: false,
   597→      });
   598→
   599→      await expect.poll(() => container.textContent?.length).toBeGreaterThan(9000);
   600→    });
   601→
   602→    it('handles unicode content', async () => {
   603→      const { container } = render(StreamingMarkdown, {
   604→        content: 'Hello 世界 🌍 مرحبا',
   605→        isStreaming: false,
   606→      });
   607→
   608→      await expect.poll(() => container.textContent).toContain('世界');
   609→      await expect.poll(() => container.textContent).toContain('🌍');
   610→      await expect.poll(() => container.textContent).toContain('مرحبا');
   611→    });
   612→
   613→    it('handles nested markdown structures', async () => {
   614→      const { container } = render(StreamingMarkdown, {
   615→        content: '> **Bold** in a *blockquote* with `code`',
   616→        isStreaming: false,
   617→      });
   618→
   619→      await expect.poll(() => container.querySelector('blockquote')).not.toBeNull();
   620→      await expect
   621→        .poll(() => container.querySelector('blockquote')?.querySelector('strong'))
   622→        .not.toBeNull();
   623→      await expect
   624→        .poll(() => container.querySelector('blockquote')?.querySelector('em'))
   625→        .not.toBeNull();
   626→      await expect
   627→        .poll(() => container.querySelector('blockquote')?.querySelector('code'))
   628→        .not.toBeNull();
   629→    });
   630→  });
   631→
   632→  describe('styling', () => {
   633→    it('applies Tailwind classes to code blocks', async () => {
   634→      const { container } = render(StreamingMarkdown, {
   635→        content: '```javascript\ncode here\n```',
   636→        isStreaming: false,
   637→      });
   638→
   639→      // Code content should be rendered
   640→      await expect.poll(() => container.textContent).toContain('code here');
   641→      // Code block may be rendered as pre or with .code-block class
   642→      await expect
   643→        .poll(() => container.querySelector('pre') || container.querySelector('.code-block'))
   644→        .not.toBeNull();
   645→    });
   646→
   647→    it('applies Tailwind classes to inline code', async () => {
   648→      const { container } = render(StreamingMarkdown, {
   649→        content: 'Use `code` here',
   650→        isStreaming: false,
   651→      });
   652→
   653→      // Wait for code element and verify all Tailwind classes together
   654→      await expect
   655→        .poll(() => {
   656→          const code = container.querySelector('code');
   657→          return code?.classList.contains('rounded') && code?.classList.contains('font-mono');
   658→        })
   659→        .toBe(true);
   660→    });
   661→
   662→    it('applies Tailwind classes to blockquotes', async () => {
   663→      const { container } = render(StreamingMarkdown, {
   664→        content: '> Quote',
   665→        isStreaming: false,
   666→      });
   667→
   668→      // Wait for blockquote and verify all Tailwind classes together
   669→      await expect
   670→        .poll(() => {
   671→          const blockquote = container.querySelector('blockquote');
   672→          return (
   673→            blockquote?.classList.contains('border-l-2') && blockquote?.classList.contains('italic')
   674→          );
   675→        })
   676→        .toBe(true);
   677→    });
   678→  });
   679→});
