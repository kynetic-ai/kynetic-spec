   545→
   546→    it('does not apply syntax highlighting to mermaid blocks', async () => {
   547→      const { container } = render(StreamingMarkdown, {
   548→        content: '```mermaid\ngraph TD\n    A-->B\n```',
   549→        isStreaming: false,
   550→      });
