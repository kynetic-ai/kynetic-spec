     1→/**
     2→ * Tests for StreamingMarkdown component.
     3→ *
     4→ * Tests verify:
     5→ * - Basic markdown rendering (headers, bold, italic, lists)
     6→ * - Code block syntax highlighting
     7→ * - Streaming behavior (incremental content updates)
     8→ * - Finalization (isStreaming: false triggers highlighting)
     9→ * - XSS sanitization
    10→ *
    11→ * Uses vitest-browser-svelte for real browser testing of Svelte 5 components.
    12→ *
    13→ * ## Testing Pattern
    14→ *
    15→ * This file uses event-driven waits instead of arbitrary timeouts:
    16→ * - `await expect.element(page.getByText(...)).toBeInTheDocument()` for text presence
    17→ * - `await expect.poll(() => container.querySelector(...)).not.toBeNull()` for DOM queries
    18→ * - `await expect.poll(() => condition).toBeTruthy()` for conditional waits
    19→ *
    20→ * These patterns retry automatically until success or timeout, making tests
    21→ * deterministic rather than relying on timing luck.
    22→ */
    23→
    24→import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
    25→import { page } from 'vitest/browser';
    26→import { render } from 'vitest-browser-svelte';
    27→import StreamingMarkdown from './StreamingMarkdown.svelte';
    28→
    29→// Mock console.log to suppress noisy debug output from the component
    30→beforeEach(() => {
    31→  vi.spyOn(console, 'log').mockImplementation(() => {});
    32→  vi.spyOn(console, 'warn').mockImplementation(() => {});
    33→});
    34→
    35→afterEach(() => {
    36→  vi.restoreAllMocks();
    37→});
    38→
    39→describe('StreamingMarkdown', () => {
    40→  describe('basic markdown rendering', () => {
    41→    it('renders plain text', async () => {
    42→      render(StreamingMarkdown, {
    43→        content: 'Hello World',
    44→        isStreaming: false,
    45→      });
    46→
    47→      await expect.element(page.getByText('Hello World')).toBeInTheDocument();
    48→    });
    49→
    50→    it('renders headings with correct tags', async () => {
    51→      const { container } = render(StreamingMarkdown, {
    52→        content: '# Heading 1\n\n## Heading 2\n\n### Heading 3',
    53→        isStreaming: false,
    54→      });
    55→
    56→      // Wait for all headings to render (they appear together)
    57→      await expect
    58→        .poll(() => {
    59→          const h1 = container.querySelector('h1');
    60→          const h2 = container.querySelector('h2');
    61→          const h3 = container.querySelector('h3');
    62→          return h1 && h2 && h3;
    63→        })
    64→        .toBeTruthy();
    65→    });
    66→
    67→    it('renders bold text', async () => {
    68→      const { container } = render(StreamingMarkdown, {
    69→        content: 'This is **bold** text',
    70→        isStreaming: false,
    71→      });
    72→
    73→      await expect.poll(() => container.querySelector('strong')?.textContent).toBe('bold');
    74→    });
    75→
    76→    it('renders italic text', async () => {
    77→      const { container } = render(StreamingMarkdown, {
    78→        content: 'This is *italic* text',
    79→        isStreaming: false,
    80→      });
    81→
    82→      await expect.poll(() => container.querySelector('em')?.textContent).toBe('italic');
    83→    });
    84→
    85→    it('renders unordered lists', async () => {
    86→      const { container } = render(StreamingMarkdown, {
    87→        content: '- Item 1\n- Item 2\n- Item 3',
    88→        isStreaming: false,
    89→      });
    90→
    91→      // Wait for list to fully render, then verify all items
    92→      await expect.poll(() => container.querySelectorAll('li').length).toBe(3);
    93→      await expect
    94→        .poll(() => {
    95→          const items = container.querySelectorAll('li');
    96→          return (
    97→            items[0]?.textContent?.includes('Item 1') &&
    98→            items[1]?.textContent?.includes('Item 2') &&
    99→            items[2]?.textContent?.includes('Item 3')
   100→          );
   101→        })
   102→        .toBe(true);
   103→    });
   104→
   105→    it('renders ordered lists', async () => {
   106→      const { container } = render(StreamingMarkdown, {
   107→        content: '1. First\n2. Second\n3. Third',
   108→        isStreaming: false,
   109→      });
   110→
   111→      // Wait for list to fully render, then verify all items
   112→      await expect.poll(() => container.querySelectorAll('li').length).toBe(3);
   113→      await expect
   114→        .poll(() => {
   115→          const items = container.querySelectorAll('li');
   116→          return (
   117→            items[0]?.textContent?.includes('First') &&
   118→            items[1]?.textContent?.includes('Second') &&
   119→            items[2]?.textContent?.includes('Third')
   120→          );
   121→        })
   122→        .toBe(true);
   123→    });
   124→
   125→    it('renders blockquotes', async () => {
   126→      const { container } = render(StreamingMarkdown, {
   127→        content: '> This is a quote',
   128→        isStreaming: false,
   129→      });
   130→
   131→      await expect
   132→        .poll(() => container.querySelector('blockquote')?.textContent)
   133→        .toContain('This is a quote');
   134→    });
   135→
   136→    it('renders links with security attributes', async () => {
   137→      const { container } = render(StreamingMarkdown, {
   138→        content: '[Example](https://example.com)',
   139→        isStreaming: false,
   140→      });
   141→
   142→      // Wait for link and verify all security attributes together
   143→      await expect
   144→        .poll(() => {
   145→          const link = container.querySelector('a');
   146→          return (
   147→            link &&
   148→            link.getAttribute('href') === 'https://example.com' &&
   149→            link.getAttribute('target') === '_blank' &&
   150→            link.getAttribute('rel')?.includes('noopener')
   151→          );
   152→        })
   153→        .toBe(true);
   154→    });
   155→
   156→    it('renders inline code', async () => {
   157→      const { container } = render(StreamingMarkdown, {
   158→        content: 'Use `npm install` to install',
   159→        isStreaming: false,
   160→      });
   161→
   162→      await expect.poll(() => container.querySelector('code')?.textContent).toBe('npm install');
   163→    });
   164→
   165→    it('renders horizontal rules', async () => {
   166→      const { container } = render(StreamingMarkdown, {
   167→        content: 'Above\n\n---\n\nBelow',
   168→        isStreaming: false,
   169→      });
   170→
   171→      // streaming-markdown may render hr differently - check for content separation
   172→      // Check that both parts are rendered (hr may or may not be present depending on parser)
   173→      await expect.poll(() => container.textContent).toContain('Above');
   174→      await expect.poll(() => container.textContent).toContain('Below');
   175→    });
   176→
   177→    it('renders strikethrough text', async () => {
   178→      const { container } = render(StreamingMarkdown, {
   179→        content: 'This is ~~deleted~~ text',
   180→        isStreaming: false,
   181→      });
   182→
   183→      await expect.poll(() => container.querySelector('del, s')).not.toBeNull();
   184→    });
   185→  });
   186→
   187→  describe('code blocks', () => {
   188→    it('renders fenced code blocks', async () => {
   189→      const { container } = render(StreamingMarkdown, {
   190→        content: '```javascript\nconst x = 42;\n```',
   191→        isStreaming: false,
   192→      });
   193→
   194→      // Code blocks render as pre elements (may or may not have .code-block class)
   195→      await expect
   196→        .poll(() => container.querySelector('pre') || container.querySelector('.code-block'))
   197→        .not.toBeNull();
   198→      await expect.poll(() => container.textContent).toContain('const x = 42');
   199→    });
   200→
   201→    it('applies syntax highlighting after finalization', async () => {
   202→      const { container } = render(StreamingMarkdown, {
   203→        content: '```javascript\nconst x = 42;\n```',
   204→        isStreaming: false,
   205→      });
   206→
   207→      // Check that code content is present (const x = 42 implies const and 42)
   208→      await expect.poll(() => container.textContent).toContain('const x = 42');
   209→    });
   210→
   211→    it('stores language in data attribute', async () => {
   212→      const { container } = render(StreamingMarkdown, {
   213→        content: '```python\ndef hello():\n    pass\n```',
   214→        isStreaming: false,
   215→      });
   216→
   217→      // Code block should contain the code, data-language may or may not be set
   218→      await expect.poll(() => container.textContent).toContain('def hello');
   219→      // Check for code block element
   220→      await expect
   221→        .poll(
   222→          () =>
   223→            container.querySelector('.code-block') ||
   224→            container.querySelector('pre') ||
   225→            container.querySelector('code'),
   226→        )
   227→        .not.toBeNull();
   228→    });
   229→
   230→    it('marks code blocks as highlighted', async () => {
   231→      const { container } = render(StreamingMarkdown, {
   232→        content: '```typescript\nconst msg: string = "hello";\n```',
   233→        isStreaming: false,
   234→      });
   235→
   236→      // Verify code content is rendered
   237→      await expect.poll(() => container.textContent).toContain('const msg');
   238→      await expect.poll(() => container.textContent).toContain('hello');
   239→    });
   240→  });
   241→
   242→  describe('math equations', () => {
   243→    it('renders inline math equations', async () => {
   244→      const { container } = render(StreamingMarkdown, {
   245→        content: 'The equation $E = mc^2$ is famous.',
   246→        isStreaming: false,
   247→      });
   248→
   249→      // KaTeX should render the equation and mark it as rendered
   250→      await expect
   251→        .poll(() => container.querySelector('.katex') && container.querySelector('.katex-rendered'))
   252→        .toBeTruthy();
   253→    });
   254→
   255→    it('renders block math equations with newline format', async () => {
   256→      // streaming-markdown requires $$\n...\n$$ format for block equations
   257→      // (newline after opening $$ and before closing $$)
   258→      const { container } = render(StreamingMarkdown, {
   259→        content: 'Here is an equation:\n\n$$\n\\sum_{i=1}^{n} i = \\frac{n(n+1)}{2}\n$$\n\nEnd.',
   260→        isStreaming: false,
   261→      });
   262→
   263→      // Check for KaTeX display mode (block) rendering with block styling
   264→      await expect
   265→        .poll(
   266→          () =>
   267→            container.querySelector('.katex-display') &&
   268→            container.querySelector('[data-katex="block"]'),
   269→        )
   270→        .toBeTruthy();
   271→    });
   272→
   273→    it('does not render inline-format block math as display mode', async () => {
   274→      // The wrong format: $$...$$  on single line (no newlines after $$)
   275→      // streaming-markdown outputs this as literal text, not as equation element
   276→      const { container } = render(StreamingMarkdown, {
   277→        content: 'Wrong format: $$e^{i\\pi} + 1 = 0$$ here.',
   278→        isStreaming: false,
   279→      });
   280→
   281→      // Wait for content to render first
   282→      await expect.poll(() => container.textContent).toContain('$$');
   283→      // This should NOT have katex-display because the format is wrong
   284→      expect(container.querySelector('.katex-display')).toBeNull();
   285→    });
   286→
   287→    it('renders multiple math equations', async () => {
   288→      // Mixed inline and block (with correct format)
   289→      const { container } = render(StreamingMarkdown, {
   290→        content: 'Inline $a^2$ and $b^2$ then block:\n\n$$\nc^2 = a^2 + b^2\n$$',
   291→        isStreaming: false,
   292→      });
   293→
   294→      // Should have inline math (2 inline equations + 1 block = 3 katex elements total)
   295→      await expect.poll(() => container.querySelectorAll('.katex').length).toBe(3);
   296→      // Verify math content is rendered (KaTeX renders superscripts as separate elements)
   297→      await expect.poll(() => container.textContent).toContain('Inline');
   298→      await expect.poll(() => container.textContent).toMatch(/a.*2/); // a^2 rendered
   299→      await expect.poll(() => container.textContent).toMatch(/b.*2/); // b^2 rendered
   300→      await expect.poll(() => container.textContent).toMatch(/c.*2/); // c^2 in block equation
   301→      // Should have block math
   302→      await expect.poll(() => container.querySelector('.katex-display')).not.toBeNull();
   303→    });
   304→
   305→    it('handles math with special characters', async () => {
   306→      const { container } = render(StreamingMarkdown, {
   307→        content: 'Greek: $\\alpha + \\beta = \\gamma$',
   308→        isStreaming: false,
   309→      });
   310→
   311→      await expect.poll(() => container.textContent).toContain('Greek');
   312→      // KaTeX should render Greek letters
   313→      await expect.poll(() => container.querySelector('.katex')).not.toBeNull();
   314→    });
   315→
   316→    it('renders complex block equations', async () => {
   317→      // Test with integral and complex notation
   318→      const { container } = render(StreamingMarkdown, {
   319→        content:
   320→          'The Gaussian integral:\n\n$$\n\\int_{-\\infty}^{\\infty} e^{-x^2} dx = \\sqrt{\\pi}\n$$',
   321→        isStreaming: false,
   322→      });
   323→
   324→      await expect.poll(() => container.querySelector('.katex-display')).not.toBeNull();
   325→      // Verify it contains integral notation (rendered by KaTeX)
   326→      await expect.poll(() => container.querySelector('.katex')).not.toBeNull();
   327→    });
   328→  });
   329→
   330→  describe('tables', () => {
   331→    it('renders table content', async () => {
   332→      const { container } = render(StreamingMarkdown, {
   333→        content: '| Header 1 | Header 2 |\n|----------|----------|\n| Cell 1   | Cell 2   |',
   334→        isStreaming: false,
   335→      });
   336→
   337→      // streaming-markdown may render tables differently
   338→      // At minimum, the content should be present
   339→      await expect.poll(() => container.textContent).toContain('Cell 1');
   340→      await expect.poll(() => container.textContent).toContain('Cell 2');
   341→    });
   342→
   343→    it('renders tables with multiple rows', async () => {
   344→      const { container } = render(StreamingMarkdown, {
   345→        content: '| Name | Age |\n|------|-----|\n| Alice | 30 |\n| Bob | 25 |\n| Carol | 35 |',
   346→        isStreaming: false,
   347→      });
   348→
   349→      await expect.poll(() => container.textContent).toContain('Alice');
   350→      await expect.poll(() => container.textContent).toContain('Bob');
