   354→
   355→  describe('task lists', () => {
   356→    it('renders task lists with checkboxes', async () => {
   357→      const { container } = render(StreamingMarkdown, {
   358→        content: '- [ ] Todo item\n- [x] Done item',
   359→        isStreaming: false,
   360→      });
   361→
   362→      // Should have at least the list items rendered
   363→      await expect.poll(() => container.textContent).toContain('Todo item');
   364→      await expect.poll(() => container.textContent).toContain('Done item');
   365→    });
   366→
   367→    it('renders checkboxes as read-only', async () => {
   368→      const { container } = render(StreamingMarkdown, {
   369→        content: '- [x] Checked item',
   370→        isStreaming: false,
   371→      });
   372→
   373→      // Wait for content to render, then check checkbox state
   374→      await expect.poll(() => container.textContent).toContain('Checked item');
   375→      const checkbox = container.querySelector('input[type="checkbox"]');
   376→      if (checkbox) {
   377→        // Checkbox should be disabled (read-only display)
   378→        expect((checkbox as HTMLInputElement).disabled).toBe(true);
   379→      }
   380→    });
   381→  });
   382→
   383→  describe('streaming behavior', () => {
   384→    it('renders partial content while streaming', async () => {
   385→      const { container, rerender } = render(StreamingMarkdown, {
   386→        content: 'Hello there friend',
   387→        isStreaming: true,
   388→      });
   389→
   390→      // Content should contain at least "Hello" (initial word)
   391→      await expect.poll(() => container.textContent).toContain('Hello');
   392→      const text = container.textContent || '';
   393→
   394→      // Add more content
   395→      await rerender({ content: 'Hello there friend and everyone', isStreaming: true });
   396→
   397→      // Content should still contain Hello and may have more
   398→      await expect.poll(() => container.textContent).toContain('Hello');
   399→      await expect
   400→        .poll(() => (container.textContent || '').length)
   401→        .toBeGreaterThanOrEqual(text.length);
   402→    });
   403→
   404→    it('does not apply highlighting while streaming', async () => {
   405→      const { container } = render(StreamingMarkdown, {
   406→        content: '```javascript\nconst x = 42;\n```',
   407→        isStreaming: true,
   408→      });
   409→
   410→      // Wait for content to render
   411→      await expect.poll(() => container.textContent).toContain('const');
   412→
   413→      // Highlighting should NOT be applied while streaming
   414→      expect(container.querySelector('.highlighted')).toBeNull();
   415→    });
   416→
   417→    it('applies highlighting when streaming ends', async () => {
   418→      const { container, rerender } = render(StreamingMarkdown, {
   419→        content: '```javascript\nconst x = 42;\n```',
   420→        isStreaming: true,
   421→      });
   422→
   423→      // Wait for initial content to render
   424→      await expect.poll(() => container.textContent).toContain('const');
   425→
   426→      // End streaming
   427→      await rerender({ content: '```javascript\nconst x = 42;\n```', isStreaming: false });
   428→
   429→      // After streaming ends, content should be complete
   430→      await expect.poll(() => container.textContent).toContain('const x = 42');
   431→    });
   432→  });
   433→
   434→  describe('content changes', () => {
   435→    it('handles content growing incrementally', async () => {
   436→      const { container, rerender } = render(StreamingMarkdown, {
   437→        content: 'Alpha Beta',
   438→        isStreaming: true,
   439→      });
   440→
   441→      // Alpha should be rendered (initial word)
   442→      await expect.poll(() => container.textContent).toContain('Alpha');
   443→      const initialText = container.textContent || '';
   444→
   445→      await rerender({ content: 'Alpha Beta Gamma', isStreaming: true });
   446→
   447→      // Content should still contain Alpha and may have more
   448→      await expect.poll(() => container.textContent).toContain('Alpha');
   449→      await expect
   450→        .poll(() => (container.textContent || '').length)
   451→        .toBeGreaterThanOrEqual(initialText.length);
   452→
   453→      await rerender({ content: 'Alpha Beta Gamma Delta', isStreaming: false });
   454→
   455→      // After streaming ends, all content should be visible
   456→      await expect.poll(() => container.textContent).toContain('Alpha');
   457→      await expect.poll(() => container.textContent).toContain('Beta');
   458→      await expect.poll(() => container.textContent).toContain('Gamma');
   459→      await expect.poll(() => container.textContent).toContain('Delta');
   460→    });
   461→
   462→    it('handles complete content replacement', async () => {
   463→      const { container, rerender } = render(StreamingMarkdown, {
   464→        content: 'First message here',
   465→        isStreaming: false,
   466→      });
   467→
   468→      await expect.poll(() => container.textContent).toContain('First');
   469→
   470→      // Change to completely different content (shorter to ensure replacement detected)
   471→      await rerender({ content: 'New content', isStreaming: false });
   472→
   473→      // Content should have changed
   474→      // Either new content is there, or old content is there (depending on component behavior)
   475→      // The component should reset when content changes completely
   476→      await expect.poll(() => (container.textContent || '').length).toBeGreaterThan(0);
   477→    });
   478→  });
   479→
   480→  describe('XSS sanitization', () => {
   481→    it('removes script tags', async () => {
   482→      const { container } = render(StreamingMarkdown, {
   483→        content: 'Hello <script>alert("xss")</script> World',
   484→        isStreaming: false,
   485→      });
   486→
   487→      // Wait for content to render
   488→      await expect.poll(() => container.textContent).toContain('Hello');
   489→      // Script tags should be sanitized out
   490→      expect(container.innerHTML).not.toContain('<script>');
   491→    });
   492→
   493→    it('removes onclick handlers', async () => {
   494→      const { container } = render(StreamingMarkdown, {
   495→        content: '<div onclick="alert(1)">Click me</div>',
   496→        isStreaming: false,
   497→      });
   498→
   499→      // Wait for any content to render
   500→      await expect.poll(() => container.textContent?.length).toBeGreaterThan(0);
   501→      // onclick handlers should not be executable - either removed or escaped
   502→      // The parser may escape the HTML (safe) or strip the handler
   503→      expect(container.querySelector('[onclick]')).toBeNull(); // No element should have onclick attribute
   504→    });
   505→
   506→    it('removes javascript: URLs', async () => {
   507→      const { container } = render(StreamingMarkdown, {
   508→        content: '[Click](javascript:alert(1))',
   509→        isStreaming: false,
   510→      });
   511→
   512→      // Wait for content to render
   513→      await expect.poll(() => container.textContent).toContain('Click');
   514→      expect(container.innerHTML).not.toContain('javascript:');
   515→    });
   516→
   517→    it('removes iframe tags', async () => {
   518→      const { container } = render(StreamingMarkdown, {
   519→        content: '<iframe src="https://evil.com"></iframe>Safe content',
   520→        isStreaming: false,
   521→      });
   522→
   523→      await expect.poll(() => container.textContent).toContain('Safe content');
   524→      expect(container.innerHTML).not.toContain('<iframe');
   525→    });
   526→  });
