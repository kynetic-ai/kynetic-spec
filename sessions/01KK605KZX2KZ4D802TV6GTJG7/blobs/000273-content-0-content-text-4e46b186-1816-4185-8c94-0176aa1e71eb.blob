+				slugs: ['task-two'],
+				title: 'Task Two',
+				type: 'task',
+				status: 'pending',
+				priority: 3,
+				spec_ref: '@spec-two',
+				tags: ['docs'],
+				depends_on: [],
+				plan_ref: '@plan-two',
+				notes: [],
+				todos: [],
+				notes_count: 0,
+				todos_count: 0,
+				created_at: '2026-03-02T00:00:00.000Z'
+			}
+		],
+		items: [
+			{
+				_ulid: '01SPEC00000000000000000001',
+				slugs: ['spec-one'],
+				title: 'Spec One',
+				type: 'feature',
+				tags: ['ui'],
+				traits: [],
