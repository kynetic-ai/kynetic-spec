```
     1→/**
     2→ * E2E API Tests for Daemon Triage Endpoints
     3→ *
     4→ * Tests verify actual HTTP behavior by calling the running daemon directly.
     5→ * These replace the static analysis tests in tests/daemon-api-triage.test.ts
     6→ * which only read source files and check string patterns.
     7→ *
     8→ * Covered ACs:
     9→ * - @triage-daemon-api ac-1: GET /api/triage returns items sorted by created_at desc
    10→ * - @triage-daemon-api ac-2: GET /api/triage?status= filters by status
    11→ * - @triage-daemon-api ac-3: POST /api/triage creates record with item_snapshot, broadcasts
    12→ * - @triage-daemon-api ac-4: POST /api/triage/:ref/override sets override fields, broadcasts
    13→ * - @triage-daemon-api ac-5: POST /api/triage/:ref/act executes action, transitions to acted_on
    14→ * - @triage-daemon-api ac-6: GET /api/triage/export returns context markdown or JSON
    15→ * - @triage-daemon-api ac-7: POST 404 for nonexistent inbox item
    16→ * - @triage-daemon-api ac-8: POST /:ref/act 409 for already acted_on record
    17→ * - @triage-daemon-api ac-9: POST /:ref/act 422 for pending record
    18→ */
    19→
    20→// Trait N/A annotations — @triage-daemon-api inherits from @trait-api-endpoint and @trait-websocket-protocol:
    21→// AC: @trait-api-endpoint ac-5 — covered: shadow commits triggered by POST /api/triage, POST /:ref/override, POST /:ref/act mutations; commitIfShadow called in each handler and verified implicitly by mutation persistence tests
    22→// AC: @trait-api-endpoint ac-6 — N/A: X-Request-Id header is infrastructure concern; not tested in domain E2E tests
    23→// AC: @trait-websocket-protocol ac-1 — N/A: WebSocket connection lifecycle; tested in api-websocket.spec.ts
    24→// AC: @trait-websocket-protocol ac-2 — N/A: WebSocket subscribe command; tested in api-websocket.spec.ts
    25→// AC: @trait-websocket-protocol ac-3 — covered: triage mutation routes broadcast triage:updates events with protocol payload fields (see tests below)
    26→// AC: @trait-websocket-protocol ac-4 — N/A: WebSocket heartbeat timing; tested in future api-websocket E2E tests
    27→// AC: @trait-websocket-protocol ac-5 — N/A: WebSocket ping/pong timeout; tested in future api-websocket E2E tests
    28→// AC: @trait-websocket-protocol ac-6 — N/A: WebSocket backpressure handling; tested in future api-websocket E2E tests
    29→// AC: @trait-websocket-protocol ac-7 — N/A: WebSocket close codes; tested in future api-websocket E2E tests
    30→// AC: @trait-websocket-protocol ac-8 — N/A: WebSocket reconnection; tested in future api-websocket E2E tests
    31→
    32→import { test, expect } from '../fixtures/test-base';
    33→
    34→const DAEMON_URL = 'http://localhost:3456';
    35→const DAEMON_WS_URL = 'ws://localhost:3456/ws';
    36→
    37→// Fixture ULIDs defined in project.triage.yaml
    38→// TRIAGED record: inbox_ref = 01KJNBX0CA45ZT43W2T6HJMVA1 ("First inbox item for testing"), status=triaged
    39→const FIXTURE_TRIAGE_TRIAGED_ULID = '01KJC3NZ8Y268B3KFD2NVS6613';
    40→// ACTED_ON record: inbox_ref = 01KJNBX1CC9N4YGP991WD7XS8S ("Second inbox item"), status=acted_on
    41→const FIXTURE_TRIAGE_ACTED_ULID = '01KJC3NZD5QFP9N0FCKX9D90KR';
    42→// PENDING record: inbox_ref = 01KJNBX2CB8N4YGP991WD7XS9R ("Third inbox item"), status=pending
    43→const FIXTURE_TRIAGE_PENDING_ULID = '01KJC3NZHCBKZMDKQNZ28JNRG2';
    44→
    45→// Inbox item ULIDs from project.inbox.yaml (used for POST /api/triage)
    46→const INBOX_ITEM_1_ULID = '01KJNBX0CA45ZT43W2T6HJMVA1'; // First inbox item — already has a triage record
    47→const INBOX_ITEM_2_ULID = '01KJNBX1CC9N4YGP991WD7XS8S'; // Second inbox item — already acted_on
    48→const INBOX_ITEM_3_ULID = '01KJNBX2CB8N4YGP991WD7XS9R'; // Third inbox item — pending triage record
    49→
    50→async function subscribeToTriageUpdates(page: import('@playwright/test').Page): Promise<void> {
    51→  await page.goto(DAEMON_URL + '/api/health');
    52→
    53→  await page.evaluate((wsUrl: string) => {
    54→    return new Promise<void>((resolve, reject) => {
    55→      const ws = new WebSocket(wsUrl);
    56→      (window as unknown as Record<string, unknown>).__triageWs = ws;
    57→
    58→      const timeout = setTimeout(() => {
    59→        ws.close();
    60→        reject(new Error('Timed out connecting/subscribing to triage:updates'));
    61→      }, 5000);
    62→
    63→      ws.onmessage = (event) => {
    64→        try {
    65→          const data = JSON.parse(event.data);
    66→          if (data.event === 'connected') {
    67→            ws.send(
    68→              JSON.stringify({
    69→                action: 'subscribe',
    70→                request_id: 'triage-sub',
    71→                payload: { topics: ['triage:updates'] },
    72→              })
    73→            );
    74→            return;
    75→          }
    76→          if (data.ack === true && data.request_id === 'triage-sub') {
    77→            clearTimeout(timeout);
    78→            resolve();
    79→            return;
    80→          }
    81→          if (data.ack === false && data.request_id === 'triage-sub') {
    82→            clearTimeout(timeout);
    83→            reject(new Error('Subscribe failed for triage:updates'));
    84→          }
    85→        } catch {
    86→          // Ignore non-JSON messages
    87→        }
    88→      };
    89→
    90→      ws.onerror = () => {
    91→        clearTimeout(timeout);
    92→        reject(new Error('WebSocket error while subscribing to triage:updates'));
    93→      };
    94→    });
    95→  }, DAEMON_WS_URL);
    96→}
    97→
    98→async function waitForTriageBroadcast(
    99→  page: import('@playwright/test').Page,
   100→  expectedEvent: string
   101→): Promise<{
   102→  msg_id: string;
   103→  seq: number;
   104→  timestamp: string;
   105→  topic: string;
   106→  event: string;
   107→  data: {
   108→    ulid: string;
   109→    inbox_ref?: string;
   110→    action?: string;
   111→    new_action?: string;
   112→    result_ref?: string;
   113→  };
   114→}> {
   115→  return page.evaluate((eventName: string) => {
   116→    return new Promise((resolve, reject) => {
   117→      const ws = (window as unknown as Record<string, WebSocket>).__triageWs;
   118→      if (!ws || ws.readyState !== WebSocket.OPEN) {
   119→        reject(new Error('WebSocket not connected'));
   120→        return;
   121→      }
   122→
   123→      const timeout = setTimeout(() => {
   124→        ws.removeEventListener('message', onMessage);
   125→        reject(new Error(`Timed out waiting for triage broadcast: ${eventName}`));
   126→      }, 10000);
   127→
   128→      function onMessage(event: MessageEvent<string>): void {
   129→        try {
   130→          const payload = JSON.parse(event.data);
   131→          if (payload.topic === 'triage:updates' && payload.event === eventName && payload.msg_id) {
   132→            clearTimeout(timeout);
   133→            ws.removeEventListener('message', onMessage);
   134→            resolve(payload);
   135→          }
   136→        } catch {
   137→          // Ignore non-JSON messages
   138→        }
   139→      }
   140→
   141→      ws.addEventListener('message', onMessage);
   142→    });
   143→  }, expectedEvent) as Promise<{
   144→    msg_id: string;
   145→    seq: number;
   146→    timestamp: string;
   147→    topic: string;
   148→    event: string;
   149→    data: {
   150→      ulid: string;
   151→      inbox_ref?: string;
   152→      action?: string;
   153→      new_action?: string;
   154→      result_ref?: string;
   155→    };
   156→  }>;
   157→}
   158→
   159→test.describe('Triage API', () => {
   160→  test.describe('GET /api/triage', () => {
   161→    // AC: @triage-daemon-api ac-1
   162→    test('returns triage records array with total, sorted by created_at desc', async ({
   163→      request,
   164→      daemon,
   165→    }) => {
   166→      const response = await request.get(`${DAEMON_URL}/api/triage`);
   167→
   168→      expect(response.status()).toBe(200);
   169→
   170→      const body = await response.json();
   171→      expect(body).toHaveProperty('items');
   172→      expect(body).toHaveProperty('total');
   173→      expect(Array.isArray(body.items)).toBe(true);
   174→      expect(body.items.length).toBeGreaterThan(0);
   175→      expect(body.total).toBe(body.items.length);
   176→    });
   177→
   178→    // AC: @triage-daemon-api ac-1 — sorted by created_at desc
   179→    test('returns records sorted by created_at descending (newest first)', async ({
   180→      request,
   181→      daemon,
   182→    }) => {
   183→      const response = await request.get(`${DAEMON_URL}/api/triage`);
   184→      expect(response.status()).toBe(200);
   185→
   186→      const body = await response.json();
   187→      expect(body.items.length).toBeGreaterThanOrEqual(2);
   188→
   189→      // Verify descending order
   190→      for (let i = 0; i < body.items.length - 1; i++) {
   191→        const current = new Date(body.items[i].created_at).getTime();
   192→        const next = new Date(body.items[i + 1].created_at).getTime();
   193→        expect(current).toBeGreaterThanOrEqual(next);
   194→      }
   195→    });
   196→
   197→    // AC: @triage-daemon-api ac-1 — fixture records loaded
   198→    test('returns fixture triage records with correct fields', async ({ request, daemon }) => {
   199→      const response = await request.get(`${DAEMON_URL}/api/triage`);
   200→      expect(response.status()).toBe(200);
   201→
   202→      const body = await response.json();
   203→      // We have 3 fixture records
   204→      expect(body.items.length).toBe(3);
   205→
   206→      const item = body.items[0];
   207→      expect(item).toHaveProperty('_ulid');
   208→      expect(item).toHaveProperty('inbox_ref');
   209→      expect(item).toHaveProperty('item_snapshot');
   210→      expect(item).toHaveProperty('status');
   211→      expect(item).toHaveProperty('created_at');
   212→    });
   213→
   214→    // AC: @triage-daemon-api ac-1 — JSON content type
   215→    // AC: @trait-api-endpoint ac-1
   216→    test('returns JSON content type', async ({ request, daemon }) => {
   217→      const response = await request.get(`${DAEMON_URL}/api/triage`);
   218→      const contentType = response.headers()['content-type'] || '';
   219→      expect(contentType).toContain('application/json');
   220→    });
   221→
   222→    // AC: @triage-daemon-api ac-2 — status filter
   223→    test('filters records by status query parameter', async ({ request, daemon }) => {
   224→      const response = await request.get(`${DAEMON_URL}/api/triage?status=triaged`);
   225→      expect(response.status()).toBe(200);
   226→
   227→      const body = await response.json();
   228→      expect(Array.isArray(body.items)).toBe(true);
   229→
   230→      // All returned items should have status=triaged
   231→      for (const item of body.items) {
   232→        expect(item.status).toBe('triaged');
   233→      }
   234→    });
   235→
   236→    // AC: @triage-daemon-api ac-2 — filter for acted_on
   237→    test('filters records by acted_on status', async ({ request, daemon }) => {
   238→      const response = await request.get(`${DAEMON_URL}/api/triage?status=acted_on`);
   239→      expect(response.status()).toBe(200);
   240→
   241→      const body = await response.json();
   242→      expect(body.items.length).toBe(1);
   243→      expect(body.items[0]._ulid).toBe(FIXTURE_TRIAGE_ACTED_ULID);
   244→      expect(body.items[0].status).toBe('acted_on');
   245→    });
   246→
   247→    // AC: @triage-daemon-api ac-2 — filter for pending
   248→    test('filters records by pending status', async ({ request, daemon }) => {
   249→      const response = await request.get(`${DAEMON_URL}/api/triage?status=pending`);
   250→      expect(response.status()).toBe(200);
   251→
   252→      const body = await response.json();
   253→      expect(body.items.length).toBe(1);
   254→      expect(body.items[0]._ulid).toBe(FIXTURE_TRIAGE_PENDING_ULID);
   255→      expect(body.items[0].status).toBe('pending');
   256→    });
   257→
   258→    // AC: @trait-api-endpoint ac-4 — pagination
   259→    test('supports limit and offset pagination', async ({ request, daemon }) => {
   260→      // Get all records first
   261→      const allResponse = await request.get(`${DAEMON_URL}/api/triage`);
   262→      const allBody = await allResponse.json();
   263→      const totalCount = allBody.total;
   264→
   265→      // Get first page with limit=1
   266→      const pagedResponse = await request.get(`${DAEMON_URL}/api/triage?limit=1&offset=0`);
   267→      expect(pagedResponse.status()).toBe(200);
   268→
   269→      const pagedBody = await pagedResponse.json();
   270→      expect(pagedBody.items.length).toBe(1);
   271→      expect(pagedBody.total).toBe(totalCount);
   272→      expect(pagedBody.offset).toBe(0);
   273→      expect(pagedBody.limit).toBe(1);
   274→    });
   275→
   276→    // AC: @trait-api-endpoint ac-4 — pagination offset
   277→    test('pagination offset skips records', async ({ request, daemon }) => {
   278→      const firstResponse = await request.get(`${DAEMON_URL}/api/triage?limit=1&offset=0`);
   279→      const secondResponse = await request.get(`${DAEMON_URL}/api/triage?limit=1&offset=1`);
   280→
   281→      expect(firstResponse.status()).toBe(200);
   282→      expect(secondResponse.status()).toBe(200);
   283→
   284→      const firstBody = await firstResponse.json();
   285→      const secondBody = await secondResponse.json();
   286→
   287→      // First and second pages should have different records
   288→      expect(firstBody.items[0]._ulid).not.toBe(secondBody.items[0]._ulid);
   289→    });
   290→  });
