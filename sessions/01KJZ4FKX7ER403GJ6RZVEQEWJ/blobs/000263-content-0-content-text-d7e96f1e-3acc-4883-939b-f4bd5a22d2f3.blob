   943→  test.describe('Upsert correctness', () => {
   944→    // AC: @triage-daemon-api ac-3 — upsert on inbox_ref (one record per inbox item)
   945→    test('second POST for same inbox item updates existing record (upsert)', async ({
   946→      request,
   947→      daemon,
   948→    }) => {
   949→      // Create fresh inbox item
   950→      const inboxResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   951→        data: { text: `Upsert test ${Date.now()}` },
   952→      });
   953→      expect(inboxResponse.status()).toBe(200);
   954→      const inbox = await inboxResponse.json();
   955→      const inboxUlid = inbox.item._ulid;
   956→
   957→      // First triage — defer
   958→      const firstResponse = await request.post(`${DAEMON_URL}/api/triage`, {
   959→        data: {
   960→          inbox_ref: `@${inboxUlid}`,
   961→          action: 'defer',
   962→          reasoning: 'First decision',
   963→        },
   964→      });
   965→      expect(firstResponse.status()).toBe(200);
   966→      const firstBody = await firstResponse.json();
   967→      const firstUlid = firstBody.record._ulid;
   968→
   969→      // Second triage — spec-gap (should upsert, same ULID)
   970→      const secondResponse = await request.post(`${DAEMON_URL}/api/triage`, {
   971→        data: {
   972→          inbox_ref: `@${inboxUlid}`,
   973→          action: 'spec-gap',
   974→          reasoning: 'Changed mind',
   975→        },
   976→      });
   977→      expect(secondResponse.status()).toBe(200);
   978→      const secondBody = await secondResponse.json();
   979→
   980→      // Same ULID (upsert, not duplicate)
   981→      expect(secondBody.record._ulid).toBe(firstUlid);
   982→      expect(secondBody.record.action).toBe('spec-gap');
   983→
   984→      // Only 1 record for this inbox item
   985→      const listResponse = await request.get(`${DAEMON_URL}/api/triage`);
   986→      const list = await listResponse.json();
   987→      const recordsForItem = list.items.filter(
   988→        (r: { inbox_ref: string }) => r.inbox_ref === inboxUlid
   989→      );
   990→      expect(recordsForItem.length).toBe(1);
   991→    });
   992→  });
   993→});
