   387→  test.describe('POST /api/triage', () => {
   388→    // AC: @triage-daemon-api ac-3 — create record with item_snapshot
   389→    test('creates triage record with item_snapshot from inbox item', async ({
   390→      request,
   391→      daemon,
   392→    }) => {
   393→      // Use inbox item 1 which already has a "triaged" fixture record — upsert case
   394→      const response = await request.post(`${DAEMON_URL}/api/triage`, {
   395→        data: {
   396→          inbox_ref: `@${INBOX_ITEM_1_ULID}`,
   397→          action: 'defer',
   398→          reasoning: 'Not a priority right now',
   399→        },
   400→      });
   401→
   402→      expect(response.status()).toBe(200);
   403→
   404→      const body = await response.json();
   405→      expect(body).toHaveProperty('success');
   406→      expect(body.success).toBe(true);
   407→      expect(body).toHaveProperty('record');
   408→
   409→      const record = body.record;
   410→      expect(record).toHaveProperty('_ulid');
   411→      expect(record.inbox_ref).toBe(INBOX_ITEM_1_ULID);
   412→      // item_snapshot should be set from the inbox item text
   413→      expect(record.item_snapshot).toBe('First inbox item for testing');
   414→      expect(record.action).toBe('defer');
   415→      expect(record.status).toBe('triaged');
   416→    });
   417→
   418→    // AC: @triage-daemon-api ac-3 — create fresh record for new inbox item
   419→    test('creates new triage record for inbox item without existing record', async ({
   420→      request,
   421→      daemon,
   422→    }) => {
   423→      // Create a fresh inbox item first
   424→      const inboxResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   425→        data: { text: `Fresh item for triage ${Date.now()}` },
   426→      });
   427→      expect(inboxResponse.status()).toBe(200);
   428→      const inbox = await inboxResponse.json();
   429→      const newInboxUlid = inbox.item._ulid;
   430→
   431→      // Create a triage record for it
   432→      const triageResponse = await request.post(`${DAEMON_URL}/api/triage`, {
   433→        data: {
   434→          inbox_ref: `@${newInboxUlid}`,
   435→          action: 'defer',
   436→          reasoning: 'Defer this new item',
   437→        },
   438→      });
   439→
   440→      expect(triageResponse.status()).toBe(200);
   441→
   442→      const body = await triageResponse.json();
   443→      expect(body.success).toBe(true);
   444→      expect(body.record.inbox_ref).toBe(newInboxUlid);
   445→      expect(body.record.status).toBe('triaged');
   446→    });
   447→
   448→    // AC: @triage-daemon-api ac-3 — record appears in list
   449→    test('newly created record appears in subsequent GET /api/triage', async ({
   450→      request,
   451→      daemon,
   452→    }) => {
   453→      // Create a fresh inbox item
   454→      const inboxResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   455→        data: { text: `Triage list check ${Date.now()}` },
   456→      });
   457→      expect(inboxResponse.status()).toBe(200);
   458→      const inbox = await inboxResponse.json();
   459→      const newInboxUlid = inbox.item._ulid;
   460→
   461→      // Create triage record
   462→      const triageResponse = await request.post(`${DAEMON_URL}/api/triage`, {
   463→        data: {
   464→          inbox_ref: `@${newInboxUlid}`,
   465→          action: 'spec-gap',
   466→          reasoning: 'This reveals a spec gap',
   467→        },
   468→      });
   469→      expect(triageResponse.status()).toBe(200);
   470→      const created = await triageResponse.json();
   471→
   472→      // Verify it appears in the list
   473→      const listResponse = await request.get(`${DAEMON_URL}/api/triage`);
   474→      expect(listResponse.status()).toBe(200);
   475→      const list = await listResponse.json();
   476→
   477→      const found = list.items.find((r: { _ulid: string }) => r._ulid === created.record._ulid);
   478→      expect(found).toBeDefined();
   479→      expect(found.action).toBe('spec-gap');
   480→    });
   481→
   482→    // AC: @triage-daemon-api ac-3 — supports optional decided_by
   483→    test('creates record with optional decided_by field', async ({ request, daemon }) => {
   484→      // Create fresh inbox item
   485→      const inboxResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   486→        data: { text: `Decided by test ${Date.now()}` },
   487→      });
   488→      expect(inboxResponse.status()).toBe(200);
   489→      const inbox = await inboxResponse.json();
   490→
   491→      const response = await request.post(`${DAEMON_URL}/api/triage`, {
   492→        data: {
   493→          inbox_ref: `@${inbox.item._ulid}`,
   494→          action: 'delete',
   495→          reasoning: 'Duplicate item',
   496→          decided_by: '@custom-author',
   497→        },
   498→      });
   499→
   500→      expect(response.status()).toBe(200);
