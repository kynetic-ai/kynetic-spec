```
     1→<!--
     2→  AC: @ui-inbox-enhanced ac-1 — Each item shows triage status inline with quick triage action links.
     3→  AC: @ui-inbox-enhanced ac-2 — Filters by status, tags, age.
     4→-->
     5→<script lang="ts">
     6→	// AC: @multi-directory-daemon ac-27 - Reload on project change
     7→	// AC: @gh-pages-export ac-17 - Hide Add button in static mode
     8→	import { onMount, onDestroy } from 'svelte';
     9→	import { goto } from '$app/navigation';
    10→	import { base } from '$app/paths';
    11→	import { page } from '$app/stores';
    12→	import type { InboxItem, BroadcastEvent } from '@kynetic-ai/shared';
    13→	import type { TriageRecord } from '$lib/types/triage';
    14→	import {
    15→		fetchInbox,
    16→		addInboxItem,
    17→		deleteInboxItem,
    18→		fetchTriageRecords
    19→	} from '$lib/api';
    20→	import { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';
    21→	import { subscribe, unsubscribe, on, off } from '$lib/stores/connection.svelte';
    22→	import { Button } from '$lib/components/ui/button';
    23→	import { Input } from '$lib/components/ui/input';
    24→	import { Card, CardContent, CardHeader } from '$lib/components/ui/card';
    25→	import { Badge } from '$lib/components/ui/badge';
    26→	import {
    27→		Dialog,
    28→		DialogContent,
    29→		DialogDescription,
    30→		DialogFooter,
    31→		DialogHeader,
    32→		DialogTitle
    33→	} from '$lib/components/ui/dialog';
    34→	import { getProjectVersion } from '$lib/stores/project.svelte';
    35→	import Inbox from '@lucide/svelte/icons/inbox';
    36→
    37→	// ── Data state ──
    38→	let inboxItems = $state<InboxItem[]>([]);
    39→	let triageRecords = $state<TriageRecord[]>([]);
    40→	let loading = $state(true);
    41→	let error = $state('');
    42→
    43→	// ── Add item state ──
    44→	let showAddInput = $state(false);
    45→	let newItemText = $state('');
    46→	let addingItem = $state(false);
    47→
    48→	// ── Delete state ──
    49→	let deleteConfirmOpen = $state(false);
    50→	let itemToDelete = $state<InboxItem | null>(null);
    51→	let deletingItem = $state(false);
    52→
    53→	// ── Triage status labels and colors ──
    54→	const TRIAGE_STATUS_LABELS: Record<string, string> = {
    55→		untriaged: 'Untriaged',
    56→		triaged: 'Triaged',
    57→		acted_on: 'Acted On'
    58→	};
    59→
    60→	const TRIAGE_STATUS_COLORS: Record<string, string> = {
    61→		untriaged: 'bg-status-pending text-status-pending-fg',
    62→		triaged: 'bg-status-pending-review text-status-pending-review-fg',
    63→		acted_on: 'bg-status-completed text-status-completed-fg'
    64→	};
    65→
    66→	// ── Filter state ──
    67→	// AC: @ui-inbox-enhanced ac-2
    68→	type TriageFilterStatus = 'all' | 'untriaged' | 'triaged' | 'acted_on';
    69→	const TRIAGE_STATUS_VALUES: readonly TriageFilterStatus[] = ['all', 'untriaged', 'triaged', 'acted_on'];
    70→
    71→	let filterStatus = $state<TriageFilterStatus>('all');
    72→	let filterTag = $state<string>('');
    73→	let filterAge = $state<string>('');
    74→
    75→	function parseFilterStatus(raw: string | null): TriageFilterStatus {
    76→		if (raw && TRIAGE_STATUS_VALUES.includes(raw as TriageFilterStatus)) {
    77→			return raw as TriageFilterStatus;
    78→		}
    79→		return 'all';
    80→	}
    81→
    82→	// Sync filter state from URL params
    83→	$effect(() => {
    84→		const nextStatus = parseFilterStatus($page.url.searchParams.get('status'));
    85→		const nextTag = $page.url.searchParams.get('tag') || '';
    86→		const nextAge = $page.url.searchParams.get('age') || '';
    87→
    88→		if (filterStatus !== nextStatus) filterStatus = nextStatus;
    89→		if (filterTag !== nextTag) filterTag = nextTag;
    90→		if (filterAge !== nextAge) filterAge = nextAge;
    91→	});
    92→
    93→	// ── Merged inbox + triage view ──
    94→	interface InboxCardItem {
    95→		inbox: InboxItem;
    96→		record: TriageRecord | null;
    97→		triageStatus: string;
    98→	}
    99→
   100→	// AC: @ui-inbox-enhanced ac-1 — Merge inbox items with triage records
   101→	let allItems = $derived.by(() => {
   102→		return inboxItems.map((inbox) => {
   103→			const record = triageRecords.find((r) => r.inbox_ref === inbox._ulid) ?? null;
   104→			const triageStatus = record
   105→				? record.status === 'pending'
   106→					? 'untriaged'
   107→					: record.status
   108→				: 'untriaged';
   109→			return { inbox, record, triageStatus };
   110→		});
   111→	});
   112→
   113→	// AC: @ui-inbox-enhanced ac-2 — Filtered items
   114→	let filteredItems = $derived.by(() => {
   115→		let items = allItems;
   116→
   117→		// Status filter
   118→		if (filterStatus === 'untriaged') {
   119→			items = items.filter((i) => i.triageStatus === 'untriaged');
   120→		} else if (filterStatus === 'triaged') {
   121→			items = items.filter((i) => i.triageStatus === 'triaged');
   122→		} else if (filterStatus === 'acted_on') {
   123→			items = items.filter((i) => i.triageStatus === 'acted_on');
   124→		}
   125→
   126→		// Tag filter
   127→		if (filterTag) {
   128→			items = items.filter((i) => i.inbox.tags.includes(filterTag));
   129→		}
   130→
   131→		// Age filter
   132→		if (filterAge) {
   133→			const now = Date.now();
   134→			const cutoffs: Record<string, number> = {
   135→				'1d': 86400000,
   136→				'7d': 604800000,
   137→				'30d': 2592000000
   138→			};
   139→			const cutoff = cutoffs[filterAge];
   140→			if (cutoff) {
   141→				items = items.filter((i) => now - new Date(i.inbox.created_at).getTime() <= cutoff);
   142→			}
   143→		}
   144→
   145→		return items;
   146→	});
   147→
   148→	// All unique tags across inbox items
   149→	let allTags = $derived.by(() => {
   150→		const tagSet = new Set<string>();
   151→		inboxItems.forEach((item) => item.tags.forEach((t) => tagSet.add(t)));
   152→		return Array.from(tagSet).sort();
   153→	});
   154→
   155→	// Counts for status summary
   156→	let untriagedCount = $derived(allItems.filter((i) => i.triageStatus === 'untriaged').length);
   157→	let triagedCount = $derived(allItems.filter((i) => i.triageStatus === 'triaged').length);
   158→	let actedCount = $derived(allItems.filter((i) => i.triageStatus === 'acted_on').length);
   159→
   160→	// ── Lifecycle ──
   161→	onMount(async () => {
   162→		await loadData();
   163→
   164→		// Subscribe to real-time updates
   165→		if (!isStaticMode()) {
   166→			subscribe(['inbox:updates', 'triage:updates']);
   167→			on('inbox:updates', handleInboxUpdate);
   168→			on('triage:updates', handleTriageUpdate);
   169→		}
   170→	});
   171→
   172→	onDestroy(() => {
   173→		if (!isStaticMode()) {
   174→			off('inbox:updates', handleInboxUpdate);
   175→			off('triage:updates', handleTriageUpdate);
   176→			unsubscribe(['inbox:updates', 'triage:updates']);
   177→		}
   178→	});
   179→
   180→	// AC: @multi-directory-daemon ac-27 - Reload data when project changes
   181→	$effect(() => {
   182→		const version = getProjectVersion();
   183→		if (version > 0) {
   184→			loadData();
   185→		}
   186→	});
   187→
   188→	// ── Data loading ──
   189→	async function loadData() {
   190→		try {
   191→			loading = true;
   192→			error = '';
   193→			const [inboxResponse, triageResponse] = await Promise.all([
   194→				fetchInbox({ limit: 1000 }),
   195→				fetchTriageRecords({ limit: 1000 })
   196→			]);
   197→			inboxItems = inboxResponse.items;
   198→			triageRecords = triageResponse.items;
   199→		} catch (err) {
   200→			error = err instanceof Error ? err.message : 'Failed to load inbox';
   201→		} finally {
   202→			loading = false;
   203→		}
   204→	}
   205→
   206→	// ── WebSocket handlers ──
   207→	function handleInboxUpdate(_event: BroadcastEvent) {
   208→		loadData();
   209→	}
   210→
   211→	function handleTriageUpdate(_event: BroadcastEvent) {
   212→		loadTriageData();
   213→	}
   214→
   215→	async function loadTriageData() {
   216→		try {
   217→			const triageResponse = await fetchTriageRecords({ limit: 1000 });
   218→			triageRecords = triageResponse.items;
   219→		} catch (err) {
   220→			console.error('Failed to reload triage records:', err);
   221→		}
   222→	}
   223→
   224→	// ── Filter URL management ──
   225→	function updateFilterParam(key: 'status' | 'tag' | 'age', value: string) {
   226→		const params = new URLSearchParams($page.url.searchParams);
   227→
   228→		if (!value || value === 'all') {
   229→			params.delete(key);
   230→		} else {
   231→			params.set(key, value);
   232→		}
   233→
   234→		const query = params.toString();
   235→		const nextUrl = query ? `${base}/inbox?${query}` : `${base}/inbox`;
   236→		goto(nextUrl, { replaceState: false, keepFocus: true, noScroll: true });
   237→	}
   238→
   239→	// ── Add item ──
   240→	async function handleAddItem() {
   241→		if (!newItemText.trim()) return;
   242→
   243→		if (isStaticMode()) {
   244→			error = 'Cannot add items in read-only mode. Use the kspec CLI.';
   245→			return;
   246→		}
   247→
   248→		try {
   249→			addingItem = true;
   250→			error = '';
   251→			const newItem = await addInboxItem(newItemText.trim());
   252→			inboxItems = [newItem, ...inboxItems];
   253→			newItemText = '';
   254→			showAddInput = false;
   255→		} catch (err) {
   256→			if (err instanceof ReadOnlyModeError) {
   257→				error = err.message;
   258→			} else {
   259→				error = err instanceof Error ? err.message : 'Failed to add item';
   260→			}
   261→		} finally {
   262→			addingItem = false;
   263→		}
   264→	}
   265→
   266→	function handleKeydown(event: KeyboardEvent) {
   267→		if (event.key === 'Enter' && !event.shiftKey) {
   268→			event.preventDefault();
   269→			handleAddItem();
   270→		}
   271→	}
   272→
   273→	// ── Delete item ──
   274→	function confirmDelete(item: InboxItem) {
   275→		itemToDelete = item;
   276→		deleteConfirmOpen = true;
   277→	}
   278→
   279→	async function handleDelete() {
   280→		if (!itemToDelete) return;
   281→
   282→		if (isStaticMode()) {
   283→			error = 'Cannot delete items in read-only mode. Use the kspec CLI.';
   284→			deleteConfirmOpen = false;
   285→			itemToDelete = null;
   286→			return;
   287→		}
   288→
   289→		try {
   290→			deletingItem = true;
   291→			error = '';
   292→			await deleteInboxItem(itemToDelete._ulid);
   293→			inboxItems = inboxItems.filter((i) => i._ulid !== itemToDelete!._ulid);
   294→			deleteConfirmOpen = false;
   295→			itemToDelete = null;
   296→		} catch (err) {
   297→			if (err instanceof ReadOnlyModeError) {
   298→				error = err.message;
   299→			} else {
   300→				error = err instanceof Error ? err.message : 'Failed to delete item';
   301→			}
   302→		} finally {
   303→			deletingItem = false;
   304→		}
   305→	}
   306→
   307→	// ── Formatting ──
   308→	function formatDate(dateString: string): string {
   309→		const date = new Date(dateString);
   310→		const now = new Date();
   311→		const diffMs = now.getTime() - date.getTime();
   312→		const diffMins = Math.floor(diffMs / 60000);
   313→		const diffHours = Math.floor(diffMs / 3600000);
   314→		const diffDays = Math.floor(diffMs / 86400000);
   315→
   316→		if (diffMins < 1) return 'just now';
   317→		if (diffMins < 60) return `${diffMins}m ago`;
   318→		if (diffHours < 24) return `${diffHours}h ago`;
   319→		if (diffDays < 7) return `${diffDays}d ago`;
   320→
   321→		return date.toLocaleDateString();
   322→	}
   323→
   324→	function getTriageStatusLabel(item: InboxCardItem): string {
   325→		return TRIAGE_STATUS_LABELS[item.triageStatus] || 'Untriaged';
   326→	}
   327→
   328→	function getTriageStatusColor(item: InboxCardItem): string {
   329→		return TRIAGE_STATUS_COLORS[item.triageStatus] || TRIAGE_STATUS_COLORS.untriaged;
   330→	}
   331→</script>
   332→
   333→<div class="flex flex-col gap-4 p-6">
   334→	<!-- Header -->
   335→	<div class="flex items-center justify-between">
   336→		<div>
   337→			<h1 class="text-2xl font-bold">Inbox</h1>
   338→			{#if !loading}
   339→				<p class="text-sm text-muted-foreground" data-testid="inbox-summary">
   340→					{allItems.length} item{allItems.length === 1 ? '' : 's'}
   341→					&middot; {untriagedCount} untriaged, {triagedCount} triaged, {actedCount} acted on
   342→					{#if filteredItems.length !== allItems.length}
   343→						&middot; Showing {filteredItems.length} filtered
   344→					{/if}
   345→				</p>
   346→			{/if}
   347→		</div>
   348→		{#if !isStaticMode()}
   349→			<Button
   350→				data-testid="add-inbox-button"
   351→				onclick={() => (showAddInput = !showAddInput)}
   352→				variant={showAddInput ? 'secondary' : 'default'}
   353→			>
   354→				{showAddInput ? 'Cancel' : 'Add Item'}
   355→			</Button>
   356→		{/if}
   357→	</div>
   358→
   359→	<!-- AC: @ui-inbox-enhanced ac-2 — Filter controls -->
   360→	<div class="flex flex-wrap gap-2 items-center" data-testid="inbox-filters">
   361→		<select
   362→			bind:value={filterStatus}
   363→			onchange={(event) => updateFilterParam('status', (event.currentTarget as HTMLSelectElement).value)}
   364→			class="rounded-md border bg-background px-3 py-1.5 text-sm"
   365→			data-testid="inbox-status-filter"
   366→		>
   367→			<option value="all">All Status</option>
   368→			<option value="untriaged">Untriaged</option>
   369→			<option value="triaged">Triaged</option>
   370→			<option value="acted_on">Acted On</option>
   371→		</select>
   372→
   373→		{#if allTags.length > 0}
   374→			<select
   375→				bind:value={filterTag}
   376→				onchange={(event) => updateFilterParam('tag', (event.currentTarget as HTMLSelectElement).value)}
   377→				class="rounded-md border bg-background px-3 py-1.5 text-sm"
   378→				data-testid="inbox-tag-filter"
   379→			>
   380→				<option value="">All Tags</option>
   381→				{#each allTags as tag}
   382→					<option value={tag}>{tag}</option>
   383→				{/each}
   384→			</select>
   385→		{/if}
   386→
   387→		<select
   388→			bind:value={filterAge}
   389→			onchange={(event) => updateFilterParam('age', (event.currentTarget as HTMLSelectElement).value)}
   390→			class="rounded-md border bg-background px-3 py-1.5 text-sm"
   391→			data-testid="inbox-age-filter"
   392→		>
   393→			<option value="">Any Age</option>
   394→			<option value="1d">Last 24 hours</option>
   395→			<option value="7d">Last 7 days</option>
   396→			<option value="30d">Last 30 days</option>
   397→		</select>
   398→	</div>
   399→
   400→	{#if error}
   401→		<div class="bg-destructive/10 text-destructive p-4 rounded-lg text-sm" data-testid="error-message" role="alert">
   402→			{error}
   403→		</div>
   404→	{/if}
   405→
   406→	<!-- Add input field -->
   407→	{#if showAddInput}
   408→		<Card data-testid="inbox-add-form">
   409→			<CardContent class="pt-6">
   410→				<div class="flex gap-2">
   411→					<Input
   412→						data-testid="inbox-input"
   413→						bind:value={newItemText}
   414→						placeholder="Enter inbox item text (press Enter to submit)"
   415→						onkeydown={handleKeydown}
   416→						disabled={addingItem}
   417→						class="flex-1"
   418→					/>
   419→					<Button data-testid="inbox-submit" onclick={handleAddItem} disabled={addingItem || !newItemText.trim()}>
   420→						{addingItem ? 'Adding...' : 'Add'}
   421→					</Button>
   422→				</div>
   423→			</CardContent>
   424→		</Card>
   425→	{/if}
   426→
   427→	<!-- Inbox list -->
   428→	{#if loading}
   429→		<div class="space-y-2" data-testid="inbox-loading">
   430→			{#each Array(5) as _}
   431→				<div class="h-20 rounded-lg bg-muted ds-shimmer"></div>
   432→			{/each}
   433→		</div>
   434→	{:else if filteredItems.length === 0}
   435→		<div class="flex flex-col items-center justify-center py-16" data-testid="inbox-empty">
   436→			<Inbox class="size-12 text-muted-foreground/30 mb-4" />
   437→			{#if allItems.length === 0}
   438→				<h2 class="text-lg font-medium text-muted-foreground mb-1">No inbox items</h2>
   439→				<p class="text-sm text-muted-foreground">
   440→					{#if isStaticMode()}
   441→						No inbox items in the snapshot.
   442→					{:else}
   443→						Click "Add Item" to capture ideas and thoughts.
   444→					{/if}
   445→				</p>
   446→			{:else}
   447→				<h2 class="text-lg font-medium text-muted-foreground mb-1">No matching items</h2>
   448→				<p class="text-sm text-muted-foreground">Try adjusting the filters above.</p>
   449→			{/if}
   450→		</div>
   451→	{:else}
   452→		<div class="flex flex-col gap-3" data-testid="inbox-list">
   453→			{#each filteredItems as item (item.inbox._ulid)}
   454→				<!-- AC: @ui-inbox-enhanced ac-1 — Item with triage status inline -->
   455→				<Card class="transition-all duration-200 hover:shadow-md" data-testid="inbox-item">
   456→					<CardHeader class="pb-3">
   457→						<div class="flex items-start justify-between gap-4">
   458→							<div class="flex-1 min-w-0">
   459→								<div class="flex items-center gap-2 mb-1">
   460→									<!-- AC: @ui-inbox-enhanced ac-1 — Triage status badge -->
   461→									<Badge
   462→										class={getTriageStatusColor(item)}
   463→										data-testid="inbox-triage-status"
   464→									>
   465→										{getTriageStatusLabel(item)}
   466→									</Badge>
   467→									{#if item.record?.action}
   468→										<span class="text-xs text-muted-foreground" data-testid="inbox-triage-action">
   469→											{item.record.action}
   470→										</span>
   471→									{/if}
   472→								</div>
   473→								<p class="text-sm leading-relaxed" data-testid="inbox-text">{item.inbox.text}</p>
   474→							</div>
   475→							<div class="flex items-center gap-1 flex-shrink-0">
   476→								<!-- AC: @ui-inbox-enhanced ac-1 — Quick triage action link -->
   477→								{#if !isStaticMode() && item.triageStatus === 'untriaged'}
   478→									<Button
   479→										variant="ghost"
   480→										size="sm"
   481→										href="{base}/triage?status=untriaged"
   482→										data-testid="inbox-triage-link"
   483→										class="text-xs"
   484→									>
   485→										Triage
   486→									</Button>
   487→								{/if}
   488→								{#if !isStaticMode()}
   489→									<Button
   490→										data-testid="delete-inbox-button"
   491→										variant="ghost"
   492→										size="sm"
   493→										onclick={() => confirmDelete(item.inbox)}
   494→										class="text-destructive hover:text-destructive hover:bg-destructive/10"
   495→									>
   496→										Delete
   497→									</Button>
   498→								{/if}
   499→							</div>
   500→						</div>
   501→					</CardHeader>
   502→					<CardContent class="pt-0">
   503→						<div class="flex items-center gap-2 text-xs text-muted-foreground">
   504→							<span data-testid="inbox-created-at">{formatDate(item.inbox.created_at)}</span>
   505→							<span>&middot;</span>
   506→							<span data-testid="inbox-added-by">{item.inbox.added_by}</span>
   507→							{#if item.inbox.tags.length > 0}
   508→								<span>&middot;</span>
   509→								<div class="flex gap-1" data-testid="inbox-tags">
   510→									{#each item.inbox.tags as tag}
   511→										<Badge variant="secondary" class="text-xs">{tag}</Badge>
   512→									{/each}
   513→								</div>
   514→							{/if}
   515→						</div>
   516→					</CardContent>
   517→				</Card>
   518→			{/each}
   519→		</div>
   520→	{/if}
   521→</div>
   522→
   523→<!-- Delete confirmation dialog -->
   524→<Dialog bind:open={deleteConfirmOpen}>
   525→	<DialogContent data-testid="confirm-delete-dialog">
   526→		<DialogHeader>
   527→			<DialogTitle>Delete Inbox Item?</DialogTitle>
   528→			<DialogDescription>
   529→				Are you sure you want to delete this inbox item? This action cannot be undone.
   530→			</DialogDescription>
   531→		</DialogHeader>
   532→		{#if itemToDelete}
   533→			<div class="rounded-md bg-muted p-3 text-sm">
   534→				{itemToDelete.text}
   535→			</div>
   536→		{/if}
   537→		<DialogFooter>
   538→			<Button data-testid="confirm-delete-no" variant="outline" onclick={() => (deleteConfirmOpen = false)} disabled={deletingItem}>
   539→				Cancel
   540→			</Button>
   541→			<Button data-testid="confirm-delete-yes" variant="destructive" onclick={handleDelete} disabled={deletingItem}>
   542→				{deletingItem ? 'Deleting...' : 'Delete'}
   543→			</Button>
   544→		</DialogFooter>
   545→	</DialogContent>
   546→</Dialog>
   547→
```