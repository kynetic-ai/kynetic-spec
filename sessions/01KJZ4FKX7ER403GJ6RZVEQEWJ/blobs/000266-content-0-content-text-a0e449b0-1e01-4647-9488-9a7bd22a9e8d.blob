   282→	// AC: @web-dashboard ac-19
   283→	test('confirmed delete removes item from list', async ({ page }) => {
   284→		await page.getByTestId('add-inbox-button').click();
   285→		const testText = `Delete test ${Date.now()}`;
   286→		await page.getByTestId('inbox-input').fill(testText);
   287→		await page.getByTestId('inbox-submit').click();
   288→
   289→		await expect(page.getByText(testText)).toBeVisible({ timeout: 5000 });
   290→
   291→		const itemToDelete = page.getByTestId('inbox-item').filter({ hasText: testText });
