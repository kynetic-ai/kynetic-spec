   293→		await itemToDelete.getByTestId('delete-inbox-button').click();
   294→
   295→		await expect(page.getByTestId('confirm-delete-dialog')).toBeVisible();
   296→		await page.getByTestId('confirm-delete-yes').click();
   297→
