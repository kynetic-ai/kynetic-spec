    12→	// AC: @ui-inbox-enhanced ac-1
    13→	test('displays triage status inline for each inbox item', async ({ page }) => {
    14→		const inboxList = page.getByTestId('inbox-list');
    15→		await expect(inboxList).toBeVisible({ timeout: 10000 });
    16→
    17→		const items = page.getByTestId('inbox-item');
    18→		const count = await items.count();
    19→		expect(count).toBeGreaterThan(0);
    20→
    21→		// Each item should have a triage status badge
    22→		for (let i = 0; i < count; i++) {
    23→			const item = items.nth(i);
    24→			const statusBadge = item.getByTestId('inbox-triage-status');
    25→			await expect(statusBadge).toBeVisible();
    26→
    27→			// Status must be one of the valid labels
    28→			const statusText = await statusBadge.textContent();
    29→			expect(['Untriaged', 'Triaged', 'Acted On']).toContain(statusText?.trim());
    30→		}
    31→	});
