```
     1→/**
     2→ * kspec agent commands — manage and run agents.
     3→ *
     4→ * Provides subcommands for listing agent definitions, running one-shot
     5→ * invocations, and managing the dispatch engine lifecycle via the daemon.
     6→ *
     7→ * AC: @cli-agent-commands ac-1 through ac-10
     8→ * AC: @trait-json-output ac-1 through ac-6
     9→ * AC: @trait-semantic-exit-codes ac-1 through ac-8
    10→ * AC: @trait-error-guidance ac-1 through ac-6
    11→ * AC: @trait-dry-run ac-1 through ac-6
    12→ * AC: @trait-filterable-list ac-1 through ac-8
    13→ */
    14→
    15→import type { Command } from "commander";
    16→import chalk from "chalk";
    17→import {
    18→  initContext,
    19→  loadMetaContext,
    20→} from "../../parser/index.js";
    21→import { runInvocation } from "../../agent-runtime/invocation.js";
    22→import type { SessionUpdate } from "../../acp/index.js";
    23→import { buildPromptWithSkills } from "../../agent-runtime/prompts.js";
    24→import { resolveAdapter } from "../../agents/adapters.js";
    25→import { EXIT_CODES } from "../exit-codes.js";
    26→import { error, info, output, success, warn, isJsonMode } from "../output.js";
    27→import { parseIntOption } from "../validators.js";
    28→import { PidFileManager } from "../pid-utils.js";
    29→import { errors } from "../../strings/errors.js";
    30→import type { LoadedAgent } from "../../parser/meta.js";
    31→import { isEndLoopRequested, requestEndLoop } from "../../sessions/index.js";
    32→
    33→// ─── Helpers ─────────────────────────────────────────────────────────────────
    34→
    35→/**
    36→ * Get the daemon URL from the PID file manager.
    37→ * Returns null if the daemon is not running.
    38→ * AC: @cli-agent-commands ac-10
    39→ */
    40→function getDaemonUrl(): { url: string; port: number } | null {
    41→  const pidManager = new PidFileManager();
    42→  if (!pidManager.isDaemonRunning()) return null;
    43→  try {
    44→    const port = pidManager.readPort();
    45→    return { url: `http://localhost:${port}`, port };
    46→  } catch {
    47→    return null;
    48→  }
    49→}
    50→
    51→/**
    52→ * Format dispatch rules summary for display.
    53→ */
    54→function formatDispatchRules(agent: LoadedAgent): string {
    55→  if (!agent.dispatch || agent.dispatch.length === 0) {
    56→    return "(none)";
    57→  }
    58→  return agent.dispatch.map((r) => {
    59→    const filterParts: string[] = [];
    60→    if (r.filter?.automation) filterParts.push(`automation=${r.filter.automation}`);
    61→    if (r.filter?.tags?.length) filterParts.push(`tags=${r.filter.tags.join(",")}`);
    62→    if (r.filter?.priority !== undefined) filterParts.push(`priority=${r.filter.priority}`);
    63→    const filterStr = filterParts.length > 0 ? ` [${filterParts.join(", ")}]` : "";
    64→    return `${r.on}${filterStr}`;
    65→  }).join(", ");
    66→}
    67→
    68→// ─── Command Registration ─────────────────────────────────────────────────────
    69→
    70→/**
    71→ * Register the kspec agent command family.
    72→ * AC: @cli-agent-commands ac-1 through ac-10
    73→ */
    74→export function registerAgentCommands(program: Command): void {
    75→  const agent = program
    76→    .command("agent")
    77→    .description("Manage and run agents");
    78→
    79→  // ─── kspec agent list ─────────────────────────────────────────────────────
    80→
    81→  // AC: @cli-agent-commands ac-1
    82→  // AC: @trait-filterable-list ac-1 through ac-8
    83→  agent
    84→    .command("list")
    85→    .description("List all agent definitions")
    86→    .option("--json", "Output as JSON")
    87→    .option("--status <status>", "Filter by automation status (eligible|ineligible)")
    88→    .option("--tag <tag>", "Filter by tag (repeatable)", (val: string, arr: string[]) => [...arr, val], [] as string[])
    89→    .option("--limit <n>", "Maximum number of results")
    90→    .option("--offset <n>", "Skip first N results")
    91→    .option("--count", "Output only the count")
    92→    .action(async (opts) => {
    93→      try {
    94→        const ctx = await initContext();
    95→
    96→        if (!ctx.manifestPath) {
    97→          error(errors.project.noKspecProject);
    98→          process.exit(EXIT_CODES.VALIDATION_FAILED);
    99→        }
   100→
   101→        const meta = await loadMetaContext(ctx);
   102→        let agents = meta.agents;
   103→
   104→        // AC: @trait-filterable-list ac-1 - automation status filter
   105→        if (opts.status) {
   106→          agents = agents.filter((a) =>
   107→            (a as LoadedAgent & { automation?: string }).automation === opts.status,
   108→          );
   109→        }
   110→
   111→        // AC: @trait-filterable-list ac-2 - tag filter
   112→        const tags: string[] = opts.tag ?? [];
   113→        if (tags.length > 0) {
   114→          agents = agents.filter((a) => {
   115→            const agentTags = (a as LoadedAgent & { tags?: string[] }).tags ?? [];
   116→            return tags.every((t) => agentTags.includes(t));
   117→          });
   118→        }
   119→
   120→        const total = agents.length;
   121→
   122→        // AC: @trait-filterable-list ac-8 - count mode
   123→        if (opts.count) {
   124→          output({ count: total }, () => {
   125→            console.log(total);
   126→          });
   127→          return;
   128→        }
   129→
   130→        // AC: @trait-filterable-list ac-3, ac-4 - pagination
   131→        // AC: @trait-semantic-exit-codes ac-2 - invalid numeric input exits with validation error
   132→        let limit = total;
   133→        if (opts.limit !== undefined) {
   134→          const parsed = parseIntOption(opts.limit, {
   135→            min: 0,
   136→            max: Number.MAX_SAFE_INTEGER,
   137→            name: "Limit",
   138→          });
   139→          if (!parsed.ok) {
   140→            error(`Invalid --limit value: ${parsed.error}`, { suggestion: "Example: --limit 10" });
   141→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   142→          }
   143→          limit = parsed.value;
   144→        }
   145→        let offset = 0;
   146→        if (opts.offset !== undefined) {
   147→          const parsed = parseIntOption(opts.offset, {
   148→            min: 0,
   149→            max: Number.MAX_SAFE_INTEGER,
   150→            name: "Offset",
   151→          });
   152→          if (!parsed.ok) {
   153→            error(`Invalid --offset value: ${parsed.error}`, { suggestion: "Example: --offset 5" });
   154→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   155→          }
   156→          offset = parsed.value;
   157→        }
   158→        const paginated = agents.slice(offset, offset + limit);
   159→
   160→        // AC: @trait-semantic-exit-codes ac-5 - empty result set exits 0
   161→        // AC: @trait-filterable-list ac-6 - empty list with informative message
   162→        if (paginated.length === 0) {
   163→          output(
   164→            { items: [], total, offset, limit },
   165→            () => {
   166→              if (opts.status || tags.length > 0) {
   167→                console.log("No agents match the specified filters.");
   168→              } else {
   169→                console.log("No agent definitions found.");
   170→              }
   171→            },
   172→          );
   173→          return;
   174→        }
   175→
   176→        // AC: @trait-json-output ac-1 through ac-5
   177→        output(
   178→          {
   179→            items: paginated.map((a) => ({
   180→              id: a.id,
   181→              name: a.name,
   182→              adapter: a.adapter ?? "claude-agent-acp",
   183→              dispatch: a.dispatch ?? [],
   184→              concurrency: a.concurrency ?? { max_concurrent: 1 },
   185→            })),
   186→            total,
   187→            offset,
   188→            limit,
   189→          },
   190→          () => {
   191→            // AC: @trait-filterable-list ac-7 - summary with total and filter state
   192→            const filterDesc = [
   193→              opts.status ? `status=${opts.status}` : "",
   194→              tags.length > 0 ? `tags=${tags.join(",")}` : "",
   195→            ].filter(Boolean).join(", ");
   196→            const summaryStr = filterDesc ? ` (filtered: ${filterDesc})` : "";
   197→            console.log(chalk.bold(`Agents${summaryStr}: ${paginated.length} of ${total}`));
   198→            console.log();
   199→
   200→            for (const a of paginated) {
   201→              console.log(`  ${chalk.cyan(a.id)}  ${chalk.gray(a.adapter ?? "claude-agent-acp")}`);
   202→              console.log(`    ${chalk.gray("dispatch:")} ${formatDispatchRules(a)}`);
   203→              console.log(`    ${chalk.gray("concurrency:")} max ${a.concurrency?.max_concurrent ?? 1}`);
   204→            }
   205→          },
   206→        );
   207→      } catch (err) {
   208→        error("Failed to list agents", err);
   209→        process.exit(EXIT_CODES.ERROR);
   210→      }
   211→    });
   212→
   213→  // ─── kspec agent run ──────────────────────────────────────────────────────
   214→
   215→  // AC: @cli-agent-commands ac-2, ac-3, ac-7, ac-8
   216→  // AC: @trait-dry-run ac-1 through ac-6
   217→  agent
   218→    .command("run <agent-id> [prompt]")
   219→    .description("Run a one-shot agent invocation")
   220→    .option("--task <ref>", "Task reference to target")
   221→    .option("--timeout <minutes>", "Timeout in minutes (overrides agent default)")
   222→    .option("--budget <n>", "Budget override (max tasks)")
   223→    .option("--adapter <id>", "Adapter override")
   224→    .option("--dry-run", "Show prompt without spawning agent")
   225→    .option("--json", "Output as JSON")
   226→    .action(async (agentId: string, prompt: string | undefined, opts) => {
   227→      try {
   228→        const ctx = await initContext();
   229→
   230→        if (!ctx.manifestPath) {
   231→          error(errors.project.noKspecProject);
   232→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   233→        }
   234→
   235→        const meta = await loadMetaContext(ctx);
   236→        const agentDef = meta.agents.find((a) => a.id === agentId);
   237→
   238→        // AC: @trait-error-guidance ac-3 - not found error with suggestion
   239→        if (!agentDef) {
   240→          error(
   241→            `Agent "${agentId}" not found.`,
   242→            {
   243→              suggestion: `Check available agents with: kspec agent list`,
   244→            },
   245→          );
   246→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   247→        }
   248→
   249→        // Resolve the effective adapter
   250→        const adapterId = opts.adapter ?? agentDef.adapter ?? "claude-agent-acp";
   251→        const adapter = resolveAdapter(adapterId);
   252→
   253→        // Build the prompt
   254→        const taskRef = opts.task as string | undefined;
   255→        const basePrompt = prompt ?? (taskRef
   256→          ? `Work on task ${taskRef} according to your configuration and skills.`
   257→          : `Run as requested.`);
   258→
   259→        // Note: buildPromptWithSkills is called here for the dry-run preview path.
   260→        // runInvocation also calls buildPromptWithSkills internally, so we pass basePrompt
   261→        // to runInvocation (not fullPrompt) to avoid double-expansion.
   262→        const fullPromptForPreview = await buildPromptWithSkills({
   263→          basePrompt,
   264→          skillIds: agentDef.skills ?? [],
   265→          specDir: ctx.specDir,
   266→          adapterId,
   267→        });
   268→
   269→        // AC: @trait-dry-run ac-1, ac-2, ac-3 - dry run shows prompt, no changes
   270→        if (opts.dryRun) {
   271→          // Pre-compute overrides so dry-run reflects what the actual invocation would use
   272→          // AC: @cli-agent-commands ac-7 - overrides are visible in dry-run output
   273→          // AC: @trait-semantic-exit-codes ac-2 - validate numeric inputs even in dry-run
   274→          let dryTimeoutOverride: number | undefined;
   275→          if (opts.timeout) {
   276→            const parsed = parseIntOption(opts.timeout, { min: 1, max: 10080, name: "Timeout" });
   277→            if (!parsed.ok) {
   278→              error(`Invalid --timeout value: ${parsed.error}`, { suggestion: "Example: --timeout 30" });
   279→              process.exit(EXIT_CODES.VALIDATION_FAILED);
   280→            }
   281→            dryTimeoutOverride = parsed.value;
   282→          }
   283→          let dryBudgetOverride: number | undefined;
   284→          if (opts.budget) {
   285→            const parsed = parseIntOption(opts.budget, { min: 1, max: 99999, name: "Budget" });
   286→            if (!parsed.ok) {
   287→              error(`Invalid --budget value: ${parsed.error}`, { suggestion: "Example: --budget 10" });
   288→              process.exit(EXIT_CODES.VALIDATION_FAILED);
   289→            }
   290→            dryBudgetOverride = parsed.value;
   291→          }
   292→
   293→          const effectiveTimeoutMinutes = dryTimeoutOverride ?? agentDef.budget?.timeout_minutes;
   294→          const effectiveMaxTasks = dryBudgetOverride ?? agentDef.budget?.max_tasks;
   295→
   296→          // AC: @trait-dry-run ac-6 - JSON output includes dry_run field
   297→          output(
   298→            {
   299→              dry_run: true,
   300→              agent_id: agentId,
   301→              adapter: adapterId,
   302→              task_ref: taskRef ?? null,
   303→              timeout_minutes: effectiveTimeoutMinutes ?? null,
   304→              max_tasks: effectiveMaxTasks ?? null,
   305→              prompt: fullPromptForPreview,
   306→            },
   307→            () => {
   308→              console.log(chalk.yellow("DRY RUN - No agent will be spawned"));
   309→              console.log();
   310→              console.log(chalk.gray(`Agent:   ${agentId}`));
   311→              console.log(chalk.gray(`Adapter: ${adapterId}`));
   312→              if (taskRef) {
   313→                console.log(chalk.gray(`Task:    ${taskRef}`));
   314→              }
   315→              if (effectiveTimeoutMinutes !== undefined) {
   316→                console.log(chalk.gray(`Timeout: ${effectiveTimeoutMinutes} min`));
   317→              }
   318→              console.log();
   319→              console.log(chalk.gray("--- Prompt that would be sent ---"));
   320→              console.log(fullPromptForPreview);
   321→              console.log(chalk.gray("--- End prompt ---"));
   322→            },
   323→          );
   324→          return;
   325→        }
   326→
   327→        // AC: @cli-agent-commands ac-2 - one-shot invocation with task binding
   328→        // AC: @cli-agent-commands ac-3 - one-shot invocation with custom prompt (no task binding)
   329→        // AC: @cli-agent-commands ac-7 - CLI overrides agent defaults
   330→        let timeoutOverride: number | undefined;
   331→        if (opts.timeout) {
   332→          const parsed = parseIntOption(opts.timeout, { min: 1, max: 10080, name: "Timeout" });
   333→          if (!parsed.ok) {
   334→            error(`Invalid --timeout value: ${parsed.error}`, { suggestion: "Example: --timeout 30" });
   335→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   336→          }
   337→          timeoutOverride = parsed.value;
   338→        }
   339→        let budgetOverride: number | undefined;
   340→        if (opts.budget) {
   341→          const parsed = parseIntOption(opts.budget, { min: 1, max: 99999, name: "Budget" });
   342→          if (!parsed.ok) {
   343→            error(`Invalid --budget value: ${parsed.error}`, { suggestion: "Example: --budget 10" });
   344→            process.exit(EXIT_CODES.VALIDATION_FAILED);
   345→          }
   346→          budgetOverride = parsed.value;
   347→        }
   348→
   349→        const effectiveAgent = {
   350→          ...agentDef,
   351→          adapter: adapterId,
   352→          budget: timeoutOverride !== undefined || budgetOverride !== undefined
   353→            ? {
   354→                ...agentDef.budget,
   355→                timeout_minutes: timeoutOverride ?? agentDef.budget?.timeout_minutes,
   356→                max_tasks: budgetOverride ?? agentDef.budget?.max_tasks,
   357→              }
   358→            : agentDef.budget,
   359→        };
   360→
   361→        console.log(chalk.gray(`Running agent "${agentId}"...`));
   362→
   363→        // AC: @cli-agent-commands ac-12 — stream text to stdout in interactive mode
   364→        // AC: @cli-agent-commands ac-11 — suppress streaming in --json mode
   365→        let didStream = false;
   366→        const onUpdate = isJsonMode()
   367→          ? undefined
   368→          : (update: SessionUpdate) => {
   369→              if (
   370→                update.sessionUpdate === "agent_message_chunk" &&
   371→                update.content.type === "text"
   372→              ) {
   373→                process.stdout.write(update.content.text);
   374→                didStream = true;
   375→              }
   376→            };
   377→
   378→        // AC: @cli-agent-commands ac-3 - no task binding when --task not provided
   379→        // Pass basePrompt (not fullPromptForPreview) — runInvocation expands skills internally
   380→        const result = await runInvocation({
   381→          agent: effectiveAgent,
   382→          specDir: ctx.specDir,
   383→          cwd: ctx.rootDir,
   384→          taskRef: taskRef ?? undefined,
   385→          prompt: basePrompt,
   386→          trigger: "manual",
   387→          onUpdate,
   388→        });
   389→
   390→        // Ensure summary starts on its own line after streamed content
   391→        if (didStream) process.stdout.write("\n");
   392→
   393→        output(
   394→          {
   395→            outcome: result.outcome,
   396→            session_id: result.session.id,
   397→            duration_ms: result.durationMs,
   398→            stop_reason: result.stopReason,
   399→          },
   400→          () => {
   401→            if (result.outcome === "success") {
   402→              success(`Agent invocation completed`, {
   403→                session: result.session.id,
   404→                duration: `${Math.round(result.durationMs / 1000)}s`,
   405→              });
   406→            } else {
   407→              error(`Agent invocation ${result.outcome}: ${result.error ?? "unknown"}`);
   408→            }
   409→          },
   410→        );
   411→
   412→        if (result.outcome !== "success") {
   413→          process.exit(EXIT_CODES.ERROR);
   414→        }
   415→      } catch (err) {
   416→        error("Failed to run agent", err);
   417→        process.exit(EXIT_CODES.ERROR);
   418→      }
   419→    });
   420→
   421→  // ─── kspec agent status ───────────────────────────────────────────────────
   422→
   423→  // AC: @cli-agent-commands ac-6
   424→  agent
   425→    .command("status")
   426→    .description("Show active and queued agent invocations")
   427→    .option("--json", "Output as JSON")
   428→    .action(async (opts) => {
   429→      try {
   430→        const daemonConn = getDaemonUrl();
   431→
   432→        // AC: @trait-error-guidance ac-1, ac-2
   433→        if (!daemonConn) {
   434→          error(
   435→            "Daemon is not running. Cannot retrieve agent status.",
   436→            { suggestion: "Start the daemon with: kspec serve" },
   437→          );
   438→          process.exit(EXIT_CODES.ERROR);
   439→        }
   440→
   441→        const ctx = await initContext();
   442→
   443→        const headers: Record<string, string> = {};
   444→        if (ctx.rootDir) {
   445→          headers["X-Kspec-Dir"] = ctx.rootDir;
   446→        }
   447→
   448→        const response = await fetch(`${daemonConn.url}/api/agent/dispatch/status`, { headers });
   449→        if (!response.ok) {
   450→          error(`Daemon returned error: ${response.status} ${response.statusText}`);
   451→          process.exit(EXIT_CODES.ERROR);
   452→        }
   453→
   454→        // AC: @cli-agent-commands ac-6
   455→        const data = await response.json() as {
   456→          running: boolean;
   457→          activeInvocations: number;
   458→          queuedInvocations: number;
   459→          invocations: Array<{
   460→            invocationId: string;
   461→            sessionId: string;
   462→            agentId: string;
   463→            agentName: string;
   464→            taskRef: string | undefined;
   465→            elapsedMs: number;
   466→          }>;
   467→          queued: Array<{
   468→            agentId: string;
   469→            agentName: string;
   470→            taskRef: string | undefined;
   471→            waitMs: number;
   472→          }>;
   473→        };
   474→
   475→        output(data, () => {
   476→          console.log(chalk.bold("Agent Status"));
   477→          console.log();
   478→          console.log(`  Dispatch engine: ${data.running ? chalk.green("running") : chalk.gray("stopped")}`);
   479→          console.log(`  Active invocations: ${chalk.cyan(String(data.activeInvocations))}`);
   480→          console.log(`  Queued invocations: ${chalk.cyan(String(data.queuedInvocations))}`);
   481→
   482→          const invocations = data.invocations ?? [];
   483→          if (invocations.length > 0) {
   484→            console.log();
   485→            console.log(chalk.bold("Active:"));
   486→            for (const inv of invocations) {
   487→              const elapsed = Math.round(inv.elapsedMs / 1000);
   488→              const taskStr = inv.taskRef ? `  task: ${chalk.yellow(inv.taskRef)}` : "";
   489→              console.log(`  ${chalk.cyan(inv.agentId)}  ${chalk.gray(inv.agentName)}`);
   490→              console.log(`    session: ${chalk.gray(inv.sessionId)}  elapsed: ${elapsed}s${taskStr}`);
   491→            }
   492→          }
   493→
   494→          const queuedItems = data.queued ?? [];
   495→          if (queuedItems.length > 0) {
   496→            console.log();
   497→            console.log(chalk.bold("Queued:"));
   498→            for (const q of queuedItems) {
   499→              const wait = Math.round(q.waitMs / 1000);
   500→              const taskStr = q.taskRef ? `  task: ${chalk.yellow(q.taskRef)}` : "";
   501→              console.log(`  ${chalk.cyan(q.agentId)}  ${chalk.gray(q.agentName)}`);
   502→              console.log(`    waiting: ${wait}s${taskStr}`);
   503→            }
   504→          }
   505→        });
   506→      } catch (err) {
   507→        error("Failed to get agent status", err);
   508→        process.exit(EXIT_CODES.ERROR);
   509→      }
   510→    });
   511→
   512→  // ─── kspec agent dispatch ─────────────────────────────────────────────────
   513→
   514→  const dispatch = agent
   515→    .command("dispatch")
   516→    .description("Manage the agent dispatch engine");
   517→
   518→  // AC: @cli-agent-commands ac-4
   519→  // AC: @cli-agent-commands ac-10
   520→  dispatch
   521→    .command("start")
   522→    .description("Start the dispatch engine (daemon must be running)")
   523→    .option("--json", "Output as JSON")
   524→    .action(async (opts) => {
   525→      try {
   526→        const daemonConn = getDaemonUrl();
   527→
   528→        // AC: @cli-agent-commands ac-10 - error when daemon not running
   529→        if (!daemonConn) {
   530→          error(
   531→            "Daemon is not running. The dispatch engine requires the daemon.",
   532→            { suggestion: "Start the daemon first with: kspec serve" },
   533→          );
   534→          process.exit(EXIT_CODES.ERROR);
   535→        }
   536→
   537→        const ctx = await initContext();
   538→
   539→        const headers: Record<string, string> = {
   540→          "Content-Type": "application/json",
   541→        };
   542→        if (ctx.rootDir) {
   543→          headers["X-Kspec-Dir"] = ctx.rootDir;
   544→        }
   545→
   546→        const response = await fetch(`${daemonConn.url}/api/agent/dispatch/start`, {
   547→          method: "POST",
   548→          headers,
   549→        });
   550→
   551→        if (!response.ok) {
   552→          const body = await response.text();
   553→          error(`Failed to start dispatch engine: ${response.status} - ${body}`);
   554→          process.exit(EXIT_CODES.ERROR);
   555→        }
   556→
   557→        const data = await response.json() as {
   558→          started: boolean;
   559→          reason?: string;
   560→          status?: { running: boolean; activeInvocations: number; queuedInvocations: number };
   561→        };
   562→
   563→        output(data, () => {
   564→          if (data.started) {
   565→            success("Dispatch engine started");
   566→          } else {
   567→            console.log(chalk.yellow(`Dispatch engine: ${data.reason ?? "already running"}`));
   568→          }
   569→        });
   570→      } catch (err) {
   571→        error("Failed to start dispatch engine", err);
   572→        process.exit(EXIT_CODES.ERROR);
   573→      }
   574→    });
   575→
   576→  // AC: @cli-agent-commands ac-5
   577→  dispatch
   578→    .command("stop")
   579→    .description("Stop the dispatch engine gracefully")
   580→    .option("--json", "Output as JSON")
   581→    .action(async (opts) => {
   582→      try {
   583→        const daemonConn = getDaemonUrl();
   584→
   585→        if (!daemonConn) {
   586→          error(
   587→            "Daemon is not running.",
   588→            { suggestion: "Start the daemon with: kspec serve" },
   589→          );
   590→          process.exit(EXIT_CODES.ERROR);
   591→        }
   592→
   593→        const ctx = await initContext();
   594→
   595→        const headers: Record<string, string> = {
   596→          "Content-Type": "application/json",
   597→        };
   598→        if (ctx.rootDir) {
   599→          headers["X-Kspec-Dir"] = ctx.rootDir;
   600→        }
   601→
   602→        const response = await fetch(`${daemonConn.url}/api/agent/dispatch/stop`, {
   603→          method: "POST",
   604→          headers,
   605→        });
   606→
   607→        if (!response.ok) {
   608→          const body = await response.text();
   609→          error(`Failed to stop dispatch engine: ${response.status} - ${body}`);
   610→          process.exit(EXIT_CODES.ERROR);
   611→        }
   612→
   613→        const data = await response.json() as { stopped: boolean; reason?: string };
   614→
   615→        output(data, () => {
   616→          if (data.stopped) {
   617→            success("Dispatch engine stopped");
   618→          } else {
   619→            console.log(chalk.yellow(`Dispatch engine: ${data.reason ?? "not running"}`));
   620→          }
   621→        });
   622→      } catch (err) {
   623→        error("Failed to stop dispatch engine", err);
   624→        process.exit(EXIT_CODES.ERROR);
   625→      }
   626→    });
   627→
   628→  // AC: @cli-agent-commands ac-9
   629→  dispatch
   630→    .command("status")
   631→    .description("Show dispatch engine status and loaded agents")
   632→    .option("--json", "Output as JSON")
   633→    .action(async (opts) => {
   634→      try {
   635→        const daemonConn = getDaemonUrl();
   636→
   637→        if (!daemonConn) {
   638→          // Daemon not running — show as disabled
   639→          output(
   640→            { running: false, activeInvocations: 0, queuedInvocations: 0, agents: [] },
   641→            () => {
   642→              console.log(chalk.bold("Dispatch Status"));
   643→              console.log();
   644→              console.log(`  Dispatch engine: ${chalk.gray("not available (daemon offline)")}`);
   645→              console.log(chalk.gray("  Start daemon with: kspec serve"));
   646→            },
   647→          );
   648→          return;
   649→        }
   650→
   651→        const ctx = await initContext();
   652→
   653→        const headers: Record<string, string> = {};
   654→        if (ctx.rootDir) {
   655→          headers["X-Kspec-Dir"] = ctx.rootDir;
   656→        }
   657→
   658→        // Get dispatch status
   659→        const statusResponse = await fetch(`${daemonConn.url}/api/agent/dispatch/status`, { headers });
   660→        if (!statusResponse.ok) {
   661→          error(`Daemon returned error: ${statusResponse.status}`);
   662→          process.exit(EXIT_CODES.ERROR);
   663→        }
   664→
   665→        const statusData = await statusResponse.json() as {
   666→          running: boolean;
   667→          activeInvocations: number;
   668→          queuedInvocations: number;
   669→        };
   670→
   671→        // Get loaded agents
   672→        let agents: Array<{ id: string; name: string }> = [];
   673→        try {
   674→          const meta = await loadMetaContext(ctx);
   675→          agents = meta.agents.map((a) => ({ id: a.id, name: a.name }));
   676→        } catch {
   677→          // Meta may not be available
   678→        }
   679→
   680→        const fullData = { ...statusData, agents };
   681→
   682→        output(fullData, () => {
   683→          console.log(chalk.bold("Dispatch Status"));
   684→          console.log();
   685→          console.log(`  Engine:             ${statusData.running ? chalk.green("enabled") : chalk.yellow("disabled")}`);
   686→          console.log(`  Active invocations: ${chalk.cyan(String(statusData.activeInvocations))}`);
   687→          console.log(`  Queued invocations: ${chalk.cyan(String(statusData.queuedInvocations))}`);
   688→          console.log();
   689→          console.log(chalk.bold("Loaded Agents:"));
   690→          if (agents.length === 0) {
   691→            console.log(chalk.gray("  (none defined)"));
   692→          } else {
   693→            for (const a of agents) {
   694→              console.log(`  ${chalk.cyan(a.id)}  ${chalk.gray(a.name)}`);
   695→            }
   696→          }
   697→        });
   698→      } catch (err) {
   699→        error("Failed to get dispatch status", err);
   700→        process.exit(EXIT_CODES.ERROR);
   701→      }
   702→    });
   703→
   704→  // ─── kspec agent dispatch watch ───────────────────────────────────────────
   705→
   706→  // AC: @cli-agent-commands ac-13 through ac-16
   707→  dispatch
   708→    .command("watch")
   709→    .description("Stream agent text output from the dispatch engine in real time")
   710→    .option("--agent <name>", "Only show output from this agent")
   711→    .option("--session <id>", "Only show output from this session")
   712→    .option("--retries <n>", "Number of reconnect attempts on disconnect (default 5)", "5")
   713→    .action(async (opts) => {
   714→      const DEFAULT_RETRIES = 5;
   715→      const RETRY_BASE_MS = 1000;
   716→      const MAX_RETRY_MS = 30_000;
   717→
   718→      // AC: @cli-agent-commands ac-15 — error when daemon not running
   719→      const daemonConn = getDaemonUrl();
   720→      if (!daemonConn) {
   721→        error(
   722→          "Daemon is not running. The watch command requires the daemon.",
   723→        );
   724→        info("Suggestion: Start the daemon with: kspec serve");
   725→        // AC: @cli-agent-commands ac-15 — exit code 3
   726→        process.exit(EXIT_CODES.NOT_FOUND);
   727→        return;
   728→      }
   729→
   730→      const parsedRetries = parseIntOption(opts.retries, {
   731→        min: 0,
   732→        max: Number.MAX_SAFE_INTEGER,
   733→        name: "Retries",
   734→      });
   735→      if (!parsedRetries.ok) {
   736→        error(`Invalid --retries value: ${parsedRetries.error}`, {
   737→          suggestion: "Example: --retries 5",
   738→        });
   739→        process.exit(EXIT_CODES.VALIDATION_FAILED);
   740→        return;
   741→      }
   742→      const retryLimit = parsedRetries.value;
   743→      const agentFilter: string | undefined = opts.agent;
   744→      const sessionFilter: string | undefined = opts.session;
   745→      type StreamRenderState = {
   746→        atLineStart: boolean;
   747→        lineTail: string;
   748→      };
   749→      const streamRenderStates = new Map<string, StreamRenderState>();
   750→      let activeStreamKey: string | null = null;
   751→
   752→      function getStreamState(streamKey: string): StreamRenderState {
   753→        let state = streamRenderStates.get(streamKey);
   754→        if (!state) {
   755→          state = {
   756→            atLineStart: true,
   757→            lineTail: "",
   758→          };
   759→          streamRenderStates.set(streamKey, state);
   760→        }
   761→        return state;
   762→      }
   763→
   764→      function updateLineTail(state: StreamRenderState, text: string): void {
   765→        if (!text) return;
   766→        state.lineTail = `${state.lineTail}${text}`.slice(-8);
   767→      }
   768→
   769→      function shouldStartNewLogicalLine(
   770→        state: StreamRenderState,
   771→        text: string,
   772→      ): boolean {
   773→        if (state.atLineStart) return false;
   774→        if (!text.trim()) return false;
   775→
   776→        const firstNonWhitespaceMatch = text.match(/\S/);
   777→        if (!firstNonWhitespaceMatch) return false;
   778→        if (firstNonWhitespaceMatch.index !== 0) return false;
   779→
   780→        const first = firstNonWhitespaceMatch[0];
   781→        if (!/[A-Z]/.test(first)) return false;
   782→
   783→        // Some adapters omit explicit empty-chunk boundaries. If the previous
   784→        // chunk ended with sentence punctuation and the next chunk starts a new
   785→        // capitalized clause, render a new line for readability.
   786→        return /[.!?]["'`)\]]?$/.test(state.lineTail);
   787→      }
   788→
   789→      function writePrefixedText(
   790→        streamKey: string,
   791→        prefix: string,
   792→        text: string,
   793→      ): void {
   794→        if (!text) return;
   795→
   796→        const state = getStreamState(streamKey);
   797→        const parts = text.split(/(\r?\n)/);
   798→        let output = "";
   799→
   800→        for (const part of parts) {
   801→          if (part === "\n" || part === "\r\n") {
   802→            output += part;
   803→            state.atLineStart = true;
   804→            state.lineTail = "";
   805→            continue;
   806→          }
   807→
   808→          if (!part) continue;
   809→          if (state.atLineStart) {
   810→            output += `${prefix} ${part}`;
   811→            state.atLineStart = false;
   812→          } else {
   813→            output += part;
   814→          }
   815→          updateLineTail(state, part);
   816→        }
   817→
   818→        if (output) {
   819→          process.stdout.write(output);
   820→        }
   821→      }
   822→
   823→      function endStreamLine(streamKey: string): void {
   824→        const state = getStreamState(streamKey);
   825→        if (!state.atLineStart) {
   826→          process.stdout.write("\n");
   827→          state.atLineStart = true;
   828→          state.lineTail = "";
   829→        }
   830→      }
   831→
   832→      function queuePrefixedChunk(
   833→        streamKey: string,
   834→        prefix: string,
   835→        text: string,
   836→      ): void {
   837→        if (!text) return;
   838→
   839→        if (activeStreamKey && activeStreamKey !== streamKey) {
   840→          endStreamLine(activeStreamKey);
   841→        }
   842→        activeStreamKey = streamKey;
   843→        const state = getStreamState(streamKey);
   844→        if (shouldStartNewLogicalLine(state, text)) {
   845→          endStreamLine(streamKey);
   846→        }
   847→        writePrefixedText(streamKey, prefix, text);
   848→      }
   849→
   850→      function markMessageBoundary(streamKey: string): void {
   851→        if (activeStreamKey && activeStreamKey !== streamKey) {
   852→          endStreamLine(activeStreamKey);
   853→        }
   854→        activeStreamKey = streamKey;
   855→        endStreamLine(streamKey);
   856→      }
   857→
   858→      function formatSessionIdForDisplay(sessionId: string): string {
   859→        // AC: @cli-agent-commands ac-17 — shorten session ULID in watch prefix.
   860→        return sessionId ? sessionId.slice(0, 8) : "";
   861→      }
   862→
   863→      // Resolve project dir for WebSocket project binding
   864→      let projectDir: string | undefined;
   865→      try {
   866→        const ctx = await initContext();
   867→        projectDir = ctx.rootDir;
   868→      } catch {
   869→        // non-fatal: WebSocket will use daemon default
   870→      }
   871→
   872→      let retryCount = 0;
   873→
   874→      function connect(): void {
   875→        const wsUrl = new URL(`ws://localhost:${daemonConn!.port}/ws`);
   876→        if (projectDir) {
   877→          wsUrl.searchParams.set("project", projectDir);
   878→        }
   879→
   880→        // AC: @cli-agent-commands ac-15 — Node 22+ has global WebSocket
   881→        const ws = new WebSocket(wsUrl.toString());
   882→
   883→        ws.onopen = () => {
   884→          retryCount = 0;
   885→          // Subscribe to agents topic
   886→          ws.send(JSON.stringify({
   887→            action: "subscribe",
   888→            request_id: "watch-subscribe",
   889→            payload: { topics: ["agents"] },
   890→          }));
   891→        };
   892→
   893→        ws.onmessage = (event: MessageEvent) => {
   894→          let msg: Record<string, unknown>;
   895→          try {
   896→            msg = JSON.parse(event.data as string);
   897→          } catch {
   898→            return;
   899→          }
   900→
   901→          // AC: @cli-agent-commands ac-13 — stream text with per-line [agent-id session-id] prefixes
   902→          if (msg.event === "agent_text_chunk" && msg.data) {
   903→            const data = msg.data as {
   904→              session_id?: string;
   905→              agent_id?: string;
   906→              text?: string;
   907→            };
   908→            const sessionId = data.session_id ?? "";
   909→            const agentId = data.agent_id ?? "";
   910→            const text = data.text ?? "";
   911→
   912→            // AC: @cli-agent-commands ac-16 — filter by agent/session if specified
   913→            if (agentFilter && agentId !== agentFilter) return;
   914→            if (sessionFilter && sessionId !== sessionFilter) return;
   915→
   916→            const streamKey = `${agentId}\u0000${sessionId}`;
   917→            const displaySessionId = formatSessionIdForDisplay(sessionId);
   918→            const prefix = `[${agentId} ${displaySessionId}]`;
   919→            // Match old Ralph rendering semantics: empty chunk marks message end.
   920→            if (text.length === 0) {
   921→              markMessageBoundary(streamKey);
   922→              return;
   923→            }
   924→            queuePrefixedChunk(streamKey, prefix, text);
   925→          }
   926→        };
   927→
   928→        ws.onerror = () => {
   929→          // error event fires before close, handled in onclose
   930→        };
   931→
   932→        ws.onclose = () => {
   933→          if (activeStreamKey) {
   934→            endStreamLine(activeStreamKey);
   935→          }
   936→
   937→          if (retryCount >= retryLimit) {
   938→            // AC: @cli-agent-commands ac-14 — exit code 3 when retries exhausted
   939→            error(
   940→              `WebSocket connection lost and reconnection failed after ${retryLimit} attempt(s).`,
   941→            );
   942→            info("Suggestion: Verify the daemon is still running with: kspec serve");
   943→            process.exit(EXIT_CODES.NOT_FOUND);
   944→            return;
   945→          }
   946→
   947→          retryCount++;
   948→          const backoffMs = Math.min(
   949→            RETRY_BASE_MS * Math.pow(2, retryCount - 1),
   950→            MAX_RETRY_MS,
   951→          );
   952→          // AC: @cli-agent-commands ac-14 — print reconnecting message
   953→          process.stderr.write(
   954→            `[watch] Connection lost. Reconnecting in ${Math.round(backoffMs / 1000)}s (attempt ${retryCount}/${retryLimit})...\n`,
   955→          );
   956→          setTimeout(connect, backoffMs);
   957→        };
   958→      }
   959→
   960→      connect();
   961→
   962→      // Keep process alive (WebSocket is non-blocking in Node)
   963→      // Users interrupt with Ctrl+C
   964→      await new Promise<void>(() => {/* intentionally never resolves */});
   965→    });
   966→
   967→  // ─── kspec agent end-loop ─────────────────────────────────────────────────
   968→
   969→  // AC: @ralph-replacement ac-1 — equivalent to kspec ralph end-loop
   970→  // AC: @session-end-loop-signal ac-signal
   971→  agent
   972→    .command("end-loop")
   973→    .description("Signal the agent dispatch engine to stop after current iteration")
   974→    .option("--reason <reason>", "Reason for ending the loop")
   975→    .action(async (options) => {
   976→      try {
   977→        const ctx = await initContext();
   978→        const sessionId = process.env.KSPEC_SESSION_ID;
   979→
   980→        if (!sessionId) {
   981→          // AC: @trait-error-guidance ac-1, ac-2
   982→          warn("No active agent session detected (KSPEC_SESSION_ID not set).");
   983→          info(
   984→            "This command requires an active session. It is designed to be called by agents during a dispatch invocation.",
   985→          );
   986→          info(
   987→            "Suggestion: Ensure KSPEC_SESSION_ID is set, or start a session with: kspec session create",
   988→          );
   989→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   990→          return;
   991→        }
   992→
   993→        // Write end-loop state to session
   994→        const updated = await requestEndLoop(
   995→          ctx.specDir,
   996→          sessionId,
   997→          options.reason,
   998→        );
   999→
  1000→        if (!updated) {
  1001→          // AC: @trait-error-guidance ac-1, ac-2
  1002→          error(`Session not found: ${sessionId}`);
  1003→          info("Suggestion: Check session ID with: kspec session log list");
  1004→          process.exit(EXIT_CODES.NOT_FOUND);
  1005→          return;
  1006→        }
  1007→
  1008→        success("Loop end signal sent");
  1009→        if (options.reason) {
  1010→          info(`Reason: ${options.reason}`);
  1011→        }
  1012→      } catch (err) {
  1013→        // AC: @trait-error-guidance ac-1
  1014→        error("Failed to signal end-loop", err);
  1015→        process.exit(EXIT_CODES.ERROR);
  1016→      }
  1017→    });
  1018→}
