     1→/**
     2→ * kspec agent commands — manage and run agents.
     3→ *
     4→ * Provides subcommands for listing agent definitions, running one-shot
     5→ * invocations, and managing the dispatch engine lifecycle via the daemon.
     6→ *
     7→ * AC: @cli-agent-commands ac-1 through ac-10
     8→ * AC: @trait-json-output ac-1 through ac-6
     9→ * AC: @trait-semantic-exit-codes ac-1 through ac-8
    10→ * AC: @trait-error-guidance ac-1 through ac-6
    11→ * AC: @trait-dry-run ac-1 through ac-6
    12→ * AC: @trait-filterable-list ac-1 through ac-8
    13→ */
    14→
    15→import type { Command } from "commander";
    16→import chalk from "chalk";
    17→import {
    18→  initContext,
    19→  loadMetaContext,
    20→} from "../../parser/index.js";
    21→import { runInvocation } from "../../agent-runtime/invocation.js";
    22→import { buildPromptWithSkills } from "../../agent-runtime/prompts.js";
    23→import { resolveAdapter } from "../../agents/adapters.js";
    24→import { EXIT_CODES } from "../exit-codes.js";
    25→import { error, output, success, isJsonMode } from "../output.js";
    26→import { PidFileManager } from "../pid-utils.js";
    27→import { errors } from "../../strings/errors.js";
    28→import type { LoadedAgent } from "../../parser/meta.js";
    29→
    30→// ─── Helpers ─────────────────────────────────────────────────────────────────
    31→
    32→/**
    33→ * Get the daemon URL from the PID file manager.
    34→ * Returns null if the daemon is not running.
    35→ * AC: @cli-agent-commands ac-10
    36→ */
    37→function getDaemonUrl(): { url: string; port: number } | null {
    38→  const pidManager = new PidFileManager();
    39→  if (!pidManager.isDaemonRunning()) return null;
    40→  try {
    41→    const port = pidManager.readPort();
    42→    return { url: `http://localhost:${port}`, port };
    43→  } catch {
    44→    return null;
    45→  }
    46→}
    47→
    48→/**
    49→ * Format dispatch rules summary for display.
    50→ */
    51→function formatDispatchRules(agent: LoadedAgent): string {
    52→  if (!agent.dispatch || agent.dispatch.length === 0) {
    53→    return "(none)";
    54→  }
    55→  return agent.dispatch.map((r) => {
    56→    const filterParts: string[] = [];
    57→    if (r.filter?.automation) filterParts.push(`automation=${r.filter.automation}`);
    58→    if (r.filter?.tags?.length) filterParts.push(`tags=${r.filter.tags.join(",")}`);
    59→    if (r.filter?.priority !== undefined) filterParts.push(`priority=${r.filter.priority}`);
    60→    const filterStr = filterParts.length > 0 ? ` [${filterParts.join(", ")}]` : "";
    61→    return `${r.on}${filterStr}`;
    62→  }).join(", ");
    63→}
    64→
    65→// ─── Command Registration ─────────────────────────────────────────────────────
    66→
    67→/**
    68→ * Register the kspec agent command family.
    69→ * AC: @cli-agent-commands ac-1 through ac-10
    70→ */
    71→export function registerAgentCommands(program: Command): void {
    72→  const agent = program
    73→    .command("agent")
    74→    .description("Manage and run agents");
    75→
    76→  // ─── kspec agent list ─────────────────────────────────────────────────────
    77→
    78→  // AC: @cli-agent-commands ac-1
    79→  // AC: @trait-filterable-list ac-1 through ac-8
    80→  agent
    81→    .command("list")
    82→    .description("List all agent definitions")
    83→    .option("--json", "Output as JSON")
    84→    .option("--status <status>", "Filter by automation status")
    85→    .option("--tag <tag>", "Filter by tag (repeatable)", (val: string, arr: string[]) => [...arr, val], [] as string[])
    86→    .option("--limit <n>", "Maximum number of results")
    87→    .option("--offset <n>", "Skip first N results")
    88→    .option("--count", "Output only the count")
    89→    .action(async (opts) => {
    90→      try {
    91→        const ctx = await initContext();
    92→
    93→        if (!ctx.manifestPath) {
    94→          error(errors.project.noKspecProject);
    95→          process.exit(EXIT_CODES.VALIDATION_FAILED);
    96→        }
    97→
    98→        const meta = await loadMetaContext(ctx);
    99→        let agents = meta.agents;
   100→
   101→        // AC: @trait-filterable-list ac-1 - status filter
   102→        if (opts.status) {
   103→          agents = agents.filter((a) =>
   104→            (a as LoadedAgent & { automation?: string }).automation === opts.status,
   105→          );
   106→        }
   107→
   108→        // AC: @trait-filterable-list ac-2 - tag filter
   109→        const tags: string[] = opts.tag ?? [];
   110→        if (tags.length > 0) {
   111→          agents = agents.filter((a) => {
   112→            const agentTags = (a as LoadedAgent & { tags?: string[] }).tags ?? [];
   113→            return tags.every((t) => agentTags.includes(t));
   114→          });
   115→        }
   116→
   117→        const total = agents.length;
   118→
   119→        // AC: @trait-filterable-list ac-8 - count mode
   120→        if (opts.count) {
   121→          output({ count: total }, () => {
   122→            console.log(total);
   123→          });
   124→          return;
   125→        }
   126→
   127→        // AC: @trait-filterable-list ac-3, ac-4 - pagination
   128→        const limit = opts.limit ? parseInt(opts.limit, 10) : total;
   129→        const offset = opts.offset ? parseInt(opts.offset, 10) : 0;
   130→        const paginated = agents.slice(offset, offset + limit);
   131→
   132→        // AC: @trait-semantic-exit-codes ac-5 - empty result set exits 0
   133→        // AC: @trait-filterable-list ac-6 - empty list with informative message
   134→        if (paginated.length === 0) {
   135→          output(
   136→            { items: [], total, offset, limit },
   137→            () => {
   138→              if (opts.status || tags.length > 0) {
   139→                console.log("No agents match the specified filters.");
   140→              } else {
   141→                console.log("No agent definitions found.");
   142→              }
   143→            },
   144→          );
   145→          return;
   146→        }
   147→
   148→        // AC: @trait-json-output ac-1 through ac-5
   149→        output(
   150→          {
   151→            items: paginated.map((a) => ({
   152→              id: a.id,
   153→              name: a.name,
   154→              adapter: a.adapter ?? "claude-agent-acp",
   155→              dispatch: a.dispatch ?? [],
   156→              concurrency: a.concurrency ?? { max_concurrent: 1 },
   157→            })),
   158→            total,
   159→            offset,
   160→            limit,
   161→          },
   162→          () => {
   163→            // AC: @trait-filterable-list ac-7 - summary with total and filter state
   164→            const filterDesc = [
   165→              opts.status ? `status=${opts.status}` : "",
   166→              tags.length > 0 ? `tags=${tags.join(",")}` : "",
   167→            ].filter(Boolean).join(", ");
   168→            const summaryStr = filterDesc ? ` (filtered: ${filterDesc})` : "";
   169→            console.log(chalk.bold(`Agents${summaryStr}: ${paginated.length} of ${total}`));
   170→            console.log();
   171→
   172→            for (const a of paginated) {
   173→              console.log(`  ${chalk.cyan(a.id)}  ${chalk.gray(a.adapter ?? "claude-agent-acp")}`);
   174→              console.log(`    ${chalk.gray("dispatch:")} ${formatDispatchRules(a)}`);
   175→              console.log(`    ${chalk.gray("concurrency:")} max ${a.concurrency?.max_concurrent ?? 1}`);
   176→            }
   177→          },
   178→        );
   179→      } catch (err) {
   180→        error("Failed to list agents", err);
   181→        process.exit(EXIT_CODES.ERROR);
   182→      }
   183→    });
   184→
   185→  // ─── kspec agent run ──────────────────────────────────────────────────────
   186→
   187→  // AC: @cli-agent-commands ac-2, ac-3, ac-7, ac-8
   188→  // AC: @trait-dry-run ac-1 through ac-6
   189→  agent
   190→    .command("run <agent-id> [prompt]")
   191→    .description("Run a one-shot agent invocation")
   192→    .option("--task <ref>", "Task reference to target")
   193→    .option("--timeout <minutes>", "Timeout in minutes (overrides agent default)")
   194→    .option("--budget <n>", "Budget override (max tasks)")
   195→    .option("--adapter <id>", "Adapter override")
   196→    .option("--dry-run", "Show prompt without spawning agent")
   197→    .option("--json", "Output as JSON")
   198→    .action(async (agentId: string, prompt: string | undefined, opts) => {
   199→      try {
   200→        const ctx = await initContext();
   201→
   202→        if (!ctx.manifestPath) {
   203→          error(errors.project.noKspecProject);
   204→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   205→        }
   206→
   207→        const meta = await loadMetaContext(ctx);
   208→        const agentDef = meta.agents.find((a) => a.id === agentId);
   209→
   210→        // AC: @trait-error-guidance ac-3 - not found error with suggestion
   211→        if (!agentDef) {
   212→          error(
   213→            `Agent "${agentId}" not found.`,
   214→            {
   215→              suggestion: `Check available agents with: kspec agent list`,
   216→            },
   217→          );
   218→          process.exit(EXIT_CODES.VALIDATION_FAILED);
   219→        }
   220→
   221→        // Resolve the effective adapter
   222→        const adapterId = opts.adapter ?? agentDef.adapter ?? "claude-agent-acp";
   223→        const adapter = resolveAdapter(adapterId);
   224→
   225→        // Build the prompt
   226→        const taskRef = opts.task as string | undefined;
   227→        const basePrompt = prompt ?? (taskRef
   228→          ? `Work on task ${taskRef} according to your configuration and skills.`
   229→          : `Run as requested.`);
   230→
   231→        const fullPrompt = await buildPromptWithSkills({
   232→          basePrompt,
   233→          skillIds: agentDef.skills ?? [],
   234→          specDir: ctx.specDir,
   235→        });
   236→
   237→        // AC: @trait-dry-run ac-1, ac-2, ac-3 - dry run shows prompt, no changes
   238→        if (opts.dryRun) {
   239→          // AC: @trait-dry-run ac-6 - JSON output includes dry_run field
   240→          output(
   241→            {
   242→              dry_run: true,
   243→              agent_id: agentId,
   244→              adapter: adapterId,
   245→              task_ref: taskRef,
   246→              prompt: fullPrompt,
   247→            },
   248→            () => {
   249→              console.log(chalk.yellow("DRY RUN - No agent will be spawned"));
   250→              console.log();
   251→              console.log(chalk.gray(`Agent:   ${agentId}`));
   252→              console.log(chalk.gray(`Adapter: ${adapterId}`));
   253→              if (taskRef) {
   254→                console.log(chalk.gray(`Task:    ${taskRef}`));
   255→              }
   256→              console.log();
   257→              console.log(chalk.gray("--- Prompt that would be sent ---"));
   258→              console.log(fullPrompt);
   259→              console.log(chalk.gray("--- End prompt ---"));
   260→            },
   261→          );
   262→          return;
   263→        }
   264→
   265→        // AC: @cli-agent-commands ac-2 - one-shot invocation with task binding
   266→        // AC: @cli-agent-commands ac-3 - one-shot invocation with custom prompt
   267→        // AC: @cli-agent-commands ac-7 - CLI overrides agent defaults
   268→        const effectiveAgent = {
   269→          ...agentDef,
   270→          adapter: adapterId,
   271→          budget: opts.timeout || opts.budget
   272→            ? {
   273→                ...agentDef.budget,
   274→                timeout_minutes: opts.timeout ? parseInt(opts.timeout, 10) : agentDef.budget?.timeout_minutes,
   275→                max_tasks: opts.budget ? parseInt(opts.budget, 10) : agentDef.budget?.max_tasks,
   276→              }
   277→            : agentDef.budget,
   278→        };
   279→
   280→        console.log(chalk.gray(`Running agent "${agentId}"...`));
   281→
   282→        const result = await runInvocation({
   283→          agent: effectiveAgent,
   284→          specDir: ctx.specDir,
   285→          cwd: ctx.rootDir,
   286→          taskRef: taskRef ?? "",
   287→          prompt: fullPrompt,
   288→          trigger: taskRef ? "manual" : "manual",
   289→        });
   290→
   291→        output(
   292→          {
   293→            outcome: result.outcome,
   294→            session_id: result.session.id,
   295→            duration_ms: result.durationMs,
   296→            stop_reason: result.stopReason,
   297→          },
   298→          () => {
   299→            if (result.outcome === "success") {
   300→              success(`Agent invocation completed`, {
   301→                session: result.session.id,
   302→                duration: `${Math.round(result.durationMs / 1000)}s`,
   303→              });
   304→            } else {
   305→              error(`Agent invocation ${result.outcome}: ${result.error ?? "unknown"}`);
   306→            }
   307→          },
   308→        );
   309→
   310→        if (result.outcome !== "success") {
   311→          process.exit(EXIT_CODES.ERROR);
   312→        }
   313→      } catch (err) {
   314→        error("Failed to run agent", err);
   315→        process.exit(EXIT_CODES.ERROR);
   316→      }
   317→    });
   318→
   319→  // ─── kspec agent status ───────────────────────────────────────────────────
   320→
   321→  // AC: @cli-agent-commands ac-6
   322→  agent
   323→    .command("status")
   324→    .description("Show active and queued agent invocations")
   325→    .option("--json", "Output as JSON")
   326→    .action(async (opts) => {
   327→      try {
   328→        const daemonConn = getDaemonUrl();
   329→
   330→        // AC: @trait-error-guidance ac-1, ac-2
   331→        if (!daemonConn) {
   332→          error(
   333→            "Daemon is not running. Cannot retrieve agent status.",
   334→            { suggestion: "Start the daemon with: kspec serve" },
   335→          );
   336→          process.exit(EXIT_CODES.ERROR);
   337→        }
   338→
   339→        const ctx = await initContext();
   340→
   341→        const headers: Record<string, string> = {};
   342→        if (ctx.rootDir) {
   343→          headers["X-Kspec-Dir"] = ctx.rootDir;
   344→        }
   345→
   346→        const response = await fetch(`${daemonConn.url}/api/agent/dispatch/status`, { headers });
   347→        if (!response.ok) {
   348→          error(`Daemon returned error: ${response.status} ${response.statusText}`);
   349→          process.exit(EXIT_CODES.ERROR);
   350→        }
   351→
   352→        const data = await response.json() as {
   353→          running: boolean;
   354→          activeInvocations: number;
   355→          queuedInvocations: number;
   356→        };
   357→
   358→        output(data, () => {
   359→          console.log(chalk.bold("Agent Status"));
   360→          console.log();
   361→          console.log(`  Dispatch engine: ${data.running ? chalk.green("running") : chalk.gray("stopped")}`);
   362→          console.log(`  Active invocations: ${chalk.cyan(String(data.activeInvocations))}`);
   363→          console.log(`  Queued invocations: ${chalk.cyan(String(data.queuedInvocations))}`);
   364→        });
   365→      } catch (err) {
   366→        error("Failed to get agent status", err);
   367→        process.exit(EXIT_CODES.ERROR);
   368→      }
   369→    });
   370→
   371→  // ─── kspec agent dispatch ─────────────────────────────────────────────────
   372→
   373→  const dispatch = agent
   374→    .command("dispatch")
   375→    .description("Manage the agent dispatch engine");
   376→
   377→  // AC: @cli-agent-commands ac-4
   378→  // AC: @cli-agent-commands ac-10
   379→  dispatch
   380→    .command("start")
   381→    .description("Start the dispatch engine (daemon must be running)")
   382→    .option("--json", "Output as JSON")
   383→    .action(async (opts) => {
   384→      try {
   385→        const daemonConn = getDaemonUrl();
   386→
   387→        // AC: @cli-agent-commands ac-10 - error when daemon not running
   388→        if (!daemonConn) {
   389→          error(
   390→            "Daemon is not running. The dispatch engine requires the daemon.",
   391→            { suggestion: "Start the daemon first with: kspec serve" },
   392→          );
   393→          process.exit(EXIT_CODES.ERROR);
   394→        }
   395→
   396→        const ctx = await initContext();
   397→
   398→        const headers: Record<string, string> = {
   399→          "Content-Type": "application/json",
   400→        };
   401→        if (ctx.rootDir) {
   402→          headers["X-Kspec-Dir"] = ctx.rootDir;
   403→        }
   404→
   405→        const response = await fetch(`${daemonConn.url}/api/agent/dispatch/start`, {
   406→          method: "POST",
   407→          headers,
   408→        });
   409→
   410→        if (!response.ok) {
   411→          const body = await response.text();
   412→          error(`Failed to start dispatch engine: ${response.status} - ${body}`);
   413→          process.exit(EXIT_CODES.ERROR);
   414→        }
   415→
   416→        const data = await response.json() as {
   417→          started: boolean;
   418→          reason?: string;
   419→          status?: { running: boolean; activeInvocations: number; queuedInvocations: number };
   420→        };
   421→
   422→        output(data, () => {
   423→          if (data.started) {
   424→            success("Dispatch engine started");
   425→          } else {
   426→            console.log(chalk.yellow(`Dispatch engine: ${data.reason ?? "already running"}`));
   427→          }
   428→        });
   429→      } catch (err) {
   430→        error("Failed to start dispatch engine", err);
   431→        process.exit(EXIT_CODES.ERROR);
   432→      }
   433→    });
   434→
   435→  // AC: @cli-agent-commands ac-5
   436→  dispatch
   437→    .command("stop")
   438→    .description("Stop the dispatch engine gracefully")
   439→    .option("--json", "Output as JSON")
   440→    .action(async (opts) => {
   441→      try {
   442→        const daemonConn = getDaemonUrl();
   443→
   444→        if (!daemonConn) {
   445→          error(
   446→            "Daemon is not running.",
   447→            { suggestion: "Start the daemon with: kspec serve" },
   448→          );
   449→          process.exit(EXIT_CODES.ERROR);
   450→        }
   451→
   452→        const ctx = await initContext();
   453→
   454→        const headers: Record<string, string> = {
   455→          "Content-Type": "application/json",
   456→        };
   457→        if (ctx.rootDir) {
   458→          headers["X-Kspec-Dir"] = ctx.rootDir;
   459→        }
   460→
   461→        const response = await fetch(`${daemonConn.url}/api/agent/dispatch/stop`, {
   462→          method: "POST",
   463→          headers,
   464→        });
   465→
   466→        if (!response.ok) {
   467→          const body = await response.text();
   468→          error(`Failed to stop dispatch engine: ${response.status} - ${body}`);
   469→          process.exit(EXIT_CODES.ERROR);
   470→        }
   471→
   472→        const data = await response.json() as { stopped: boolean; reason?: string };
   473→
   474→        output(data, () => {
   475→          if (data.stopped) {
   476→            success("Dispatch engine stopped");
   477→          } else {
   478→            console.log(chalk.yellow(`Dispatch engine: ${data.reason ?? "not running"}`));
   479→          }
   480→        });
   481→      } catch (err) {
   482→        error("Failed to stop dispatch engine", err);
   483→        process.exit(EXIT_CODES.ERROR);
   484→      }
   485→    });
   486→
   487→  // AC: @cli-agent-commands ac-9
   488→  dispatch
   489→    .command("status")
   490→    .description("Show dispatch engine status and loaded agents")
   491→    .option("--json", "Output as JSON")
   492→    .action(async (opts) => {
   493→      try {
   494→        const daemonConn = getDaemonUrl();
   495→
   496→        if (!daemonConn) {
   497→          // Daemon not running — show as disabled
   498→          output(
   499→            { running: false, activeInvocations: 0, queuedInvocations: 0, agents: [] },
   500→            () => {
   501→              console.log(chalk.bold("Dispatch Status"));
   502→              console.log();
   503→              console.log(`  Dispatch engine: ${chalk.gray("not available (daemon offline)")}`);
   504→              console.log(chalk.gray("  Start daemon with: kspec serve"));
   505→            },
   506→          );
   507→          return;
   508→        }
   509→
   510→        const ctx = await initContext();
   511→
   512→        const headers: Record<string, string> = {};
   513→        if (ctx.rootDir) {
   514→          headers["X-Kspec-Dir"] = ctx.rootDir;
   515→        }
   516→
   517→        // Get dispatch status
   518→        const statusResponse = await fetch(`${daemonConn.url}/api/agent/dispatch/status`, { headers });
   519→        if (!statusResponse.ok) {
   520→          error(`Daemon returned error: ${statusResponse.status}`);
   521→          process.exit(EXIT_CODES.ERROR);
   522→        }
   523→
   524→        const statusData = await statusResponse.json() as {
   525→          running: boolean;
   526→          activeInvocations: number;
   527→          queuedInvocations: number;
   528→        };
   529→
   530→        // Get loaded agents
   531→        let agents: Array<{ id: string; name: string }> = [];
   532→        try {
   533→          const meta = await loadMetaContext(ctx);
   534→          agents = meta.agents.map((a) => ({ id: a.id, name: a.name }));
   535→        } catch {
   536→          // Meta may not be available
   537→        }
   538→
   539→        const fullData = { ...statusData, agents };
   540→
   541→        output(fullData, () => {
   542→          console.log(chalk.bold("Dispatch Status"));
   543→          console.log();
   544→          console.log(`  Engine:             ${statusData.running ? chalk.green("enabled") : chalk.yellow("disabled")}`);
   545→          console.log(`  Active invocations: ${chalk.cyan(String(statusData.activeInvocations))}`);
   546→          console.log(`  Queued invocations: ${chalk.cyan(String(statusData.queuedInvocations))}`);
   547→          console.log();
   548→          console.log(chalk.bold("Loaded Agents:"));
   549→          if (agents.length === 0) {
   550→            console.log(chalk.gray("  (none defined)"));
   551→          } else {
   552→            for (const a of agents) {
   553→              console.log(`  ${chalk.cyan(a.id)}  ${chalk.gray(a.name)}`);
   554→            }
   555→          }
   556→        });
   557→      } catch (err) {
   558→        error("Failed to get dispatch status", err);
   559→        process.exit(EXIT_CODES.ERROR);
   560→      }
   561→    });
   562→}
   563→

