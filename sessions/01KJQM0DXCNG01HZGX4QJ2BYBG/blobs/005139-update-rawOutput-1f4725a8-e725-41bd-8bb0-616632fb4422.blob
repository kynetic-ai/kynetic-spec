   336→// ─── AC-2, AC-3: agent not found error ───────────────────────────────────────
   337→
   338→// AC: @cli-agent-commands ac-2, ac-3
   339→// AC: @trait-error-guidance ac-3
   340→describe("AC-2/3: kspec agent run error handling", () => {
   341→  let testDir: string;
   342→
   343→  beforeEach(async () => {
   344→    testDir = await createTempDir("kspec-agent-notfound-");
   345→  });
   346→
   347→  afterEach(async () => {
   348→    await cleanupTempDir(testDir);
   349→  });
   350→
   351→  it("should error with suggestion when agent not found", () => {
   352→    initGitRepo(testDir);
   353→    const fs_sync = require("node:fs");
   354→    const path_sync = require("node:path");
   355→    fs_sync.writeFileSync(
   356→      path_sync.join(testDir, "kynetic.yaml"),
   357→      YAML.stringify({ kynetic: "1", title: "Test" }),
   358→    );
   359→    fs_sync.writeFileSync(
   360→      path_sync.join(testDir, "kynetic.meta.yaml"),
   361→      YAML.stringify({ kynetic_meta: "1.0", agents: [] }),
   362→    );
   363→    fs_sync.writeFileSync(
   364→      path_sync.join(testDir, "project.tasks.yaml"),
   365→      YAML.stringify({ tasks: [] }),
   366→    );
   367→
   368→    // AC: @trait-error-guidance ac-3 - suggests checking ref
   369→    // AC: @trait-semantic-exit-codes ac-2 - exit 1 on validation error
   370→    const result = kspec("agent run nonexistent-agent 'prompt' --dry-run", testDir, { expectFail: true });
   371→
   372→    expect(result.exitCode).not.toBe(0);
   373→    expect(result.stderr + result.stdout).toContain("nonexistent-agent");
   374→  });
   375→});
