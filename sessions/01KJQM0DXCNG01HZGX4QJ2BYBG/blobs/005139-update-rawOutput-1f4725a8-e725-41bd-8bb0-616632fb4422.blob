   377→// ─── AC-10: daemon not running error ─────────────────────────────────────────
   378→
   379→// AC: @cli-agent-commands ac-10
   380→// AC: @trait-error-guidance ac-1, ac-2
   381→describe("AC-10: kspec agent dispatch start without daemon", () => {
   382→  let testDir: string;
   383→
   384→  beforeEach(async () => {
   385→    testDir = await createTempDir("kspec-agent-dispatch-");
   386→  });
   387→
   388→  afterEach(async () => {
   389→    await cleanupTempDir(testDir);
   390→  });
   391→
   392→  it("should error with daemon suggestion when daemon is not running", () => {
   393→    initGitRepo(testDir);
   394→    const fs_sync = require("node:fs");
   395→    const path_sync = require("node:path");
   396→    fs_sync.writeFileSync(
   397→      path_sync.join(testDir, "kynetic.yaml"),
   398→      YAML.stringify({ kynetic: "1", title: "Test" }),
   399→    );
   400→    fs_sync.writeFileSync(
   401→      path_sync.join(testDir, "kynetic.meta.yaml"),
   402→      YAML.stringify({ kynetic_meta: "1.0", agents: [] }),
   403→    );
   404→    fs_sync.writeFileSync(
   405→      path_sync.join(testDir, "project.tasks.yaml"),
   406→      YAML.stringify({ tasks: [] }),
   407→    );
   408→
   409→    // AC: @cli-agent-commands ac-10 - error when daemon not running
   410→    // AC: @trait-error-guidance ac-1 - describes what went wrong
   411→    // AC: @trait-error-guidance ac-2 - suggests action (kspec serve)
   412→    const result = kspec("agent dispatch start", testDir, { expectFail: true });
   413→
   414→    expect(result.exitCode).not.toBe(0);
   415→    const combined = result.stderr + result.stdout;
   416→    expect(combined).toMatch(/daemon|not running/i);
   417→    expect(combined).toMatch(/kspec serve|start/i);
   418→  });
   419→
   420→  it("should show dispatch status as disabled when daemon is not running", () => {
   421→    initGitRepo(testDir);
   422→    const fs_sync = require("node:fs");
   423→    const path_sync = require("node:path");
   424→    fs_sync.writeFileSync(
   425→      path_sync.join(testDir, "kynetic.yaml"),
   426→      YAML.stringify({ kynetic: "1", title: "Test" }),
   427→    );
   428→    fs_sync.writeFileSync(
   429→      path_sync.join(testDir, "kynetic.meta.yaml"),
   430→      YAML.stringify({ kynetic_meta: "1.0", agents: [] }),
   431→    );
   432→    fs_sync.writeFileSync(
   433→      path_sync.join(testDir, "project.tasks.yaml"),
   434→      YAML.stringify({ tasks: [] }),
   435→    );
   436→
   437→    // AC: @cli-agent-commands ac-9 - dispatch status shows info
   438→    const result = kspec("agent dispatch status", testDir);
   439→
   440→    expect(result.exitCode).toBe(0);
   441→    const combined = result.stdout + result.stderr;
   442→    expect(combined).toMatch(/dispatch|daemon|offline|not available/i);
   443→  });
   444→});
