     1→/**
     2→ * CLI Agent Commands tests.
     3→ *
     4→ * Tests for kspec agent list, run, status, and dispatch subcommands.
     5→ *
     6→ * Task: @implement-cli-agent-commands
     7→ * Spec: @cli-agent-commands
     8→ */
     9→
    10→import { describe, it, expect, beforeEach, afterEach, vi } from "vitest";
    11→import * as path from "node:path";
    12→import * as fs from "node:fs/promises";
    13→import * as YAML from "yaml";
    14→import {
    15→  createTempDir,
    16→  cleanupTempDir,
    17→  kspec,
    18→  testUlid,
    19→  initGitRepo,
    20→} from "./helpers/cli.js";
    21→import type { Agent } from "../src/schema/meta.js";
    22→
    23→// ─── Fixtures ────────────────────────────────────────────────────────────────
    24→
    25→function makeTestAgent(overrides: Partial<Agent> = {}): Agent {
    26→  return {
    27→    _ulid: testUlid("AGNT"),
    28→    id: "test-worker",
    29→    name: "Test Worker Agent",
    30→    capabilities: [],
    31→    tools: [],
    32→    conventions: [],
    33→    dispatch: [{ on: "task.ready" }],
    34→    skills: [],
    35→    auto_approve: false,
    36→    concurrency: { max_concurrent: 1 },
    37→    adapter: "claude-agent-acp",
    38→    ...overrides,
    39→  };
    40→}
    41→
    42→/**
    43→ * Set up a minimal kspec project directory with meta containing agents.
    44→ * Uses traditional (non-shadow) layout.
    45→ */
    46→async function setupProjectWithAgents(
    47→  dir: string,
    48→  agents: Agent[],
    49→): Promise<void> {
    50→  initGitRepo(dir);
    51→
    52→  await fs.writeFile(
    53→    path.join(dir, "kynetic.yaml"),
    54→    YAML.stringify({ kynetic: "1", title: "Test Project" }),
    55→    "utf-8",
    56→  );
    57→
    58→  await fs.writeFile(
    59→    path.join(dir, "kynetic.meta.yaml"),
    60→    YAML.stringify({
    61→      kynetic_meta: "1.0",
    62→      agents: agents.map((a) => ({
    63→        _ulid: a._ulid,
    64→        id: a.id,
    65→        name: a.name,
    66→        description: a.description,
    67→        dispatch: a.dispatch ?? [],
    68→        concurrency: a.concurrency,
    69→        adapter: a.adapter,
    70→        budget: a.budget,
    71→        auto_approve: a.auto_approve ?? false,
    72→      })),
    73→    }),
    74→    "utf-8",
    75→  );
    76→
    77→  await fs.writeFile(
    78→    path.join(dir, "project.tasks.yaml"),
    79→    YAML.stringify({ tasks: [] }),
    80→    "utf-8",
    81→  );
    82→}
    83→
    84→// ─── AC-1: kspec agent list ───────────────────────────────────────────────────
    85→
    86→// AC: @cli-agent-commands ac-1
    87→describe("AC-1: kspec agent list", () => {
    88→  let testDir: string;
    89→
    90→  beforeEach(async () => {
    91→    testDir = await createTempDir("kspec-agent-list-");
    92→  });
    93→
    94→  afterEach(async () => {
    95→    await cleanupTempDir(testDir);
    96→  });
    97→
    98→  it("should list all agent definitions with id, adapter, and concurrency", () => {
    99→    const agent1 = makeTestAgent({ id: "worker-1", adapter: "claude-agent-acp" });
   100→    const agent2 = makeTestAgent({
   101→      _ulid: testUlid("AGNT", 2),
   102→      id: "worker-2",
   103→      adapter: "codex-acp",
   104→    });
   105→
   106→    // Set up project synchronously using YAML.stringify
   107→    initGitRepo(testDir);
   108→    const fs_sync = require("node:fs");
   109→    const path_sync = require("node:path");
   110→    fs_sync.writeFileSync(
   111→      path_sync.join(testDir, "kynetic.yaml"),
   112→      YAML.stringify({ kynetic: "1", title: "Test" }),
   113→    );
   114→    fs_sync.writeFileSync(
   115→      path_sync.join(testDir, "kynetic.meta.yaml"),
   116→      YAML.stringify({
   117→        kynetic_meta: "1.0",
   118→        agents: [agent1, agent2].map((a) => ({
   119→          _ulid: a._ulid,
   120→          id: a.id,
   121→          name: a.name,
   122→          dispatch: a.dispatch ?? [],
   123→          concurrency: a.concurrency,
   124→          adapter: a.adapter,
   125→          auto_approve: false,
   126→        })),
   127→      }),
   128→    );
   129→    fs_sync.writeFileSync(
   130→      path_sync.join(testDir, "project.tasks.yaml"),
   131→      YAML.stringify({ tasks: [] }),
   132→    );
   133→
   134→    const result = kspec("agent list", testDir);
   135→
   136→    expect(result.exitCode).toBe(0);
   137→    expect(result.stdout).toContain("worker-1");
   138→    expect(result.stdout).toContain("worker-2");
   139→    expect(result.stdout).toContain("claude-agent-acp");
   140→    expect(result.stdout).toContain("codex-acp");
   141→  });
   142→
   143→  it("should output JSON when --json flag is provided", () => {
   144→    const agent = makeTestAgent({ id: "json-agent" });
   145→
   146→    initGitRepo(testDir);
   147→    const fs_sync = require("node:fs");
   148→    const path_sync = require("node:path");
   149→    fs_sync.writeFileSync(
   150→      path_sync.join(testDir, "kynetic.yaml"),
   151→      YAML.stringify({ kynetic: "1", title: "Test" }),
   152→    );
   153→    fs_sync.writeFileSync(
   154→      path_sync.join(testDir, "kynetic.meta.yaml"),
   155→      YAML.stringify({
   156→        kynetic_meta: "1.0",
   157→        agents: [{
   158→          _ulid: agent._ulid,
   159→          id: agent.id,
   160→          name: agent.name,
   161→          dispatch: agent.dispatch ?? [],
   162→          concurrency: agent.concurrency,
   163→          adapter: agent.adapter,
   164→          auto_approve: false,
   165→        }],
   166→      }),
   167→    );
   168→    fs_sync.writeFileSync(
   169→      path_sync.join(testDir, "project.tasks.yaml"),
   170→      YAML.stringify({ tasks: [] }),
   171→    );
   172→
   173→    // AC: @trait-json-output ac-1 - valid JSON output
   174→    const result = kspec("agent list --json", testDir);
   175→
   176→    expect(result.exitCode).toBe(0);
   177→    const data = JSON.parse(result.stdout);
   178→    expect(data.items).toBeDefined();
   179→    expect(data.total).toBeDefined();
   180→    // AC: @trait-json-output ac-4 - references use @ prefix
   181→    expect(data.items[0].id).toBe("json-agent");
   182→  });
   183→
   184→  it("should return 0 exit code with empty list when no agents defined", () => {
   185→    initGitRepo(testDir);
   186→    const fs_sync = require("node:fs");
   187→    const path_sync = require("node:path");
   188→    fs_sync.writeFileSync(
   189→      path_sync.join(testDir, "kynetic.yaml"),
   190→      YAML.stringify({ kynetic: "1", title: "Test" }),
   191→    );
   192→    fs_sync.writeFileSync(
   193→      path_sync.join(testDir, "kynetic.meta.yaml"),
   194→      YAML.stringify({ kynetic_meta: "1.0", agents: [] }),
   195→    );
   196→    fs_sync.writeFileSync(
   197→      path_sync.join(testDir, "project.tasks.yaml"),
   198→      YAML.stringify({ tasks: [] }),
   199→    );
   200→
   201→    // AC: @trait-semantic-exit-codes ac-5 - exit 0 with empty result
   202→    const result = kspec("agent list", testDir);
   203→    expect(result.exitCode).toBe(0);
   204→    expect(result.stdout.toLowerCase()).toContain("no agent");
   205→  });
   206→
   207→  it("should support --count flag", () => {
   208→    const agent = makeTestAgent();
   209→    initGitRepo(testDir);
   210→    const fs_sync = require("node:fs");
   211→    const path_sync = require("node:path");
   212→    fs_sync.writeFileSync(
   213→      path_sync.join(testDir, "kynetic.yaml"),
   214→      YAML.stringify({ kynetic: "1", title: "Test" }),
   215→    );
   216→    fs_sync.writeFileSync(
   217→      path_sync.join(testDir, "kynetic.meta.yaml"),
   218→      YAML.stringify({
   219→        kynetic_meta: "1.0",
   220→        agents: [{
   221→          _ulid: agent._ulid,
   222→          id: agent.id,
   223→          name: agent.name,
   224→          dispatch: agent.dispatch ?? [],
   225→          concurrency: agent.concurrency,
   226→          adapter: agent.adapter,
   227→          auto_approve: false,
   228→        }],
   229→      }),
   230→    );
   231→    fs_sync.writeFileSync(
   232→      path_sync.join(testDir, "project.tasks.yaml"),
   233→      YAML.stringify({ tasks: [] }),
   234→    );
   235→
   236→    // AC: @trait-filterable-list ac-8 - count mode
   237→    const result = kspec("agent list --count", testDir);
   238→    expect(result.exitCode).toBe(0);
   239→    expect(result.stdout.trim()).toBe("1");
   240→  });
   241→});
   242→
   243→// ─── AC-7: Override flags ─────────────────────────────────────────────────────
   244→
   245→// AC: @cli-agent-commands ac-7
   246→describe("AC-7: kspec agent run --adapter override", () => {
   247→  let testDir: string;
   248→
   249→  beforeEach(async () => {
   250→    testDir = await createTempDir("kspec-agent-run-");
   251→  });
   252→
   253→  afterEach(async () => {
   254→    await cleanupTempDir(testDir);
   255→  });
   256→
   257→  it("should show --dry-run prompt without spawning", () => {
   258→    const agent = makeTestAgent({ id: "dry-run-agent" });
   259→    initGitRepo(testDir);
   260→    const fs_sync = require("node:fs");
   261→    const path_sync = require("node:path");
   262→    fs_sync.writeFileSync(
   263→      path_sync.join(testDir, "kynetic.yaml"),
   264→      YAML.stringify({ kynetic: "1", title: "Test" }),
   265→    );
   266→    fs_sync.writeFileSync(
   267→      path_sync.join(testDir, "kynetic.meta.yaml"),
   268→      YAML.stringify({
   269→        kynetic_meta: "1.0",
   270→        agents: [{
   271→          _ulid: agent._ulid,
   272→          id: agent.id,
   273→          name: agent.name,
   274→          dispatch: [],
   275→          concurrency: agent.concurrency,
   276→          adapter: agent.adapter,
   277→          auto_approve: false,
   278→        }],
   279→      }),
   280→    );
   281→    fs_sync.writeFileSync(
   282→      path_sync.join(testDir, "project.tasks.yaml"),
   283→      YAML.stringify({ tasks: [] }),
   284→    );
   285→
   286→    // AC: @cli-agent-commands ac-8 - dry-run shows prompt
   287→    // AC: @trait-dry-run ac-1, ac-2, ac-3
   288→    const result = kspec("agent run dry-run-agent 'test prompt' --dry-run", testDir);
   289→
   290→    expect(result.exitCode).toBe(0);
   291→    expect(result.stdout).toContain("DRY RUN");
   292→    expect(result.stdout).toContain("test prompt");
   293→    // AC: @trait-dry-run ac-2 - no files modified
   294→    // (verified by no side effects - no sessions created etc.)
   295→  });
   296→
   297→  it("should include dry_run:true in JSON output with --dry-run --json", () => {
   298→    const agent = makeTestAgent({ id: "dry-run-agent-json" });
   299→    initGitRepo(testDir);
   300→    const fs_sync = require("node:fs");
   301→    const path_sync = require("node:path");
   302→    fs_sync.writeFileSync(
   303→      path_sync.join(testDir, "kynetic.yaml"),
   304→      YAML.stringify({ kynetic: "1", title: "Test" }),
   305→    );
   306→    fs_sync.writeFileSync(
   307→      path_sync.join(testDir, "kynetic.meta.yaml"),
   308→      YAML.stringify({
   309→        kynetic_meta: "1.0",
   310→        agents: [{
   311→          _ulid: agent._ulid,
   312→          id: agent.id,
   313→          name: agent.name,
   314→          dispatch: [],
   315→          concurrency: agent.concurrency,
   316→          adapter: agent.adapter,
   317→          auto_approve: false,
   318→        }],
   319→      }),
   320→    );
   321→    fs_sync.writeFileSync(
   322→      path_sync.join(testDir, "project.tasks.yaml"),
   323→      YAML.stringify({ tasks: [] }),
   324→    );
   325→
   326→    // AC: @trait-dry-run ac-6 - JSON includes dry_run boolean
   327→    const result = kspec("agent run dry-run-agent-json 'test' --dry-run --json", testDir);
   328→
   329→    expect(result.exitCode).toBe(0);
   330→    const data = JSON.parse(result.stdout);
   331→    expect(data.dry_run).toBe(true);
   332→    expect(data.agent_id).toBe("dry-run-agent-json");
   333→  });
   334→});
