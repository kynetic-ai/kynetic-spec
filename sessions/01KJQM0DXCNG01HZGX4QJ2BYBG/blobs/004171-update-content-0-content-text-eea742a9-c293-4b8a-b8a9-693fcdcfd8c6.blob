```
     1→/**
     2→ * Agent Invocation Lifecycle
     3→ *
     4→ * Per-invocation session creation, ACP agent spawn, prompt delivery,
     5→ * event logging, timeout handling, and structured completion tracking.
     6→ *
     7→ * This is the core building block used by both the dispatch engine and
     8→ * CLI one-shot mode. Each invocation creates an isolated session with
     9→ * its own event log and metadata.
    10→ *
    11→ * AC: @agent-invocation-lifecycle ac-1 through ac-9
    12→ */
    13→
    14→import * as path from "node:path";
    15→import { spawnSync } from "node:child_process";
    16→import { ulid } from "ulid";
    17→import type { Agent } from "../schema/meta.js";
    18→import { buildPromptWithSkills } from "./prompts.js";
    19→import { resolveAdapter } from "../agents/adapters.js";
    20→import { spawnAndInitialize } from "../agents/spawner.js";
    21→import type { SpawnedAgent } from "../agents/spawner.js";
    22→import type { SessionUpdate } from "../acp/index.js";
    23→import {
    24→  createSession,
    25→  closeSession,
    26→  appendEvent,
    27→  injectEnvForAdapter,
    28→  removeEnvForAdapter,
    29→} from "../sessions/store.js";
    30→import type { SessionMetadata, SessionTrigger } from "../sessions/types.js";
    31→
    32→// ─── Constants ────────────────────────────────────────────────────────────────
    33→
    34→const DEFAULT_KSPEC_CLI_PATH = path.resolve(
    35→  path.dirname(new URL(import.meta.url).pathname),
    36→  "../../bin/kspec.cjs",
    37→);
    38→
    39→// ─── Types ────────────────────────────────────────────────────────────────────
    40→
    41→/**
    42→ * Options for running a single agent invocation.
    43→ */
    44→export interface InvocationOptions {
    45→  /** The agent definition describing capabilities and configuration */
    46→  agent: Agent;
    47→  /** The spec directory (.kspec/) */
    48→  specDir: string;
    49→  /** Working directory for spawned agent */
    50→  cwd: string;
    51→  /** Task reference being worked on (e.g., "@01KJP277A") */
    52→  taskRef: string;
    53→  /** The prompt to send to the agent */
    54→  prompt: string;
    55→  /** Trigger source for this invocation */
    56→  trigger: SessionTrigger;
    57→  /** Timeout in minutes (overrides agent.budget.timeout_minutes if set) */
    58→  timeoutMinutes?: number;
    59→  /** Whether to use auto-approve (yolo) args for adapter */
    60→  autoApprove?: boolean;
    61→  /** Extra environment variables for the spawned agent */
    62→  env?: Record<string, string>;
    63→  /** Called for each streaming update from the agent */
    64→  onUpdate?: (update: SessionUpdate) => void;
    65→  /** Path to kspec CLI (defaults to resolved bin/kspec.cjs) */
    66→  kspecCliPath?: string;
    67→}
    68→
    69→/**
    70→ * Result of a completed agent invocation.
    71→ */
    72→export interface InvocationResult {
    73→  /** Session that was created for this invocation */
    74→  session: SessionMetadata;
    75→  /** How the invocation ended */
    76→  outcome: "success" | "timed_out" | "failed";
    77→  /** Stop reason from ACP (e.g., "end_turn") if the invocation completed */
    78→  stopReason?: string;
    79→  /** Error message if the invocation failed */
    80→  error?: string;
    81→  /** Total duration in milliseconds */
    82→  durationMs: number;
    83→}
    84→
    85→/**
    86→ * Internal state tracked during invocation execution.
    87→ */
    88→interface InvocationState {
    89→  sessionId: string;
    90→  specDir: string;
    91→  taskRef: string;
    92→  adapterId: string;
    93→  previousEnvValue?: string | null;
    94→  agent: SpawnedAgent | null;
    95→  acpSessionId: string | null;
    96→}
    97→
    98→// ─── Helpers ──────────────────────────────────────────────────────────────────
    99→
   100→/**
   101→ * Run a kspec CLI command synchronously.
   102→ */
   103→function runKspecCli(args: string[], cwd: string, kspecCliPath: string): { stdout: string; stderr: string; status: number | null } {
   104→  const result = spawnSync(process.execPath, [kspecCliPath, ...args], {
   105→    encoding: "utf-8",
   106→    stdio: "pipe",
   107→    cwd,
   108→  });
   109→  return {
   110→    stdout: result.stdout ?? "",
   111→    stderr: result.stderr ?? "",
   112→    status: result.status,
   113→  };
   114→}
   115→
   116→/**
   117→ * Add a note to a task via kspec CLI.
   118→ */
   119→function addTaskNote(taskRef: string, note: string, cwd: string, kspecCliPath: string): void {
   120→  runKspecCli(["task", "note", taskRef, note], cwd, kspecCliPath);
   121→}
   122→
   123→/**
   124→ * Block a task via kspec CLI.
   125→ */
   126→function blockTask(taskRef: string, reason: string, cwd: string, kspecCliPath: string): void {
   127→  runKspecCli(["task", "block", taskRef, "--reason", reason], cwd, kspecCliPath);
   128→}
   129→
   130→/**
   131→ * Get the consecutive failure count for a task from its notes.
   132→ * Looks for AGENT-FAIL notes added by previous invocations.
   133→ */
   134→function getConsecutiveFailureCount(taskRef: string, cwd: string, kspecCliPath: string): number {
   135→  const result = runKspecCli(["task", "get", taskRef, "--json"], cwd, kspecCliPath);
   136→  if (result.status !== 0) return 0;
   137→
   138→  try {
   139→    const task = JSON.parse(result.stdout);
   140→    const notes: Array<{ content: string }> = task.notes ?? [];
   141→    // Count consecutive AGENT-FAIL notes from the end
   142→    let count = 0;
   143→    for (let i = notes.length - 1; i >= 0; i--) {
   144→      if (notes[i].content?.includes("[AGENT-FAIL]")) {
   145→        count++;
   146→      } else {
   147→        break;
   148→      }
   149→    }
   150→    return count;
   151→  } catch {
   152→    return 0;
   153→  }
   154→}
   155→
   156→/**
   157→ * Dispose a spawned agent, terminating the process if running.
   158→ * AC: @agent-invocation-lifecycle ac-8
   159→ */
   160→function disposeAgent(agent: SpawnedAgent | null): null {
   161→  if (agent) {
   162→    try {
   163→      agent.kill("SIGTERM");
   164→    } catch {
   165→      // Best-effort termination
   166→    }
   167→  }
   168→  return null;
   169→}
   170→
   171→// ─── Core Invocation ──────────────────────────────────────────────────────────
   172→
   173→/**
   174→ * Run a single agent invocation for a task.
   175→ *
   176→ * Creates a session, spawns the agent, injects KSPEC_SESSION_ID,
   177→ * sends the prompt, streams events, and closes the session on completion.
   178→ *
   179→ * AC: @agent-invocation-lifecycle ac-1 through ac-9
   180→ */
   181→export async function runInvocation(options: InvocationOptions): Promise<InvocationResult> {
   182→  const {
   183→    agent,
   184→    specDir,
   185→    cwd,
   186→    taskRef,
   187→    trigger,
   188→    autoApprove = agent.auto_approve,
   189→    env = {},
   190→    onUpdate,
   191→    kspecCliPath = DEFAULT_KSPEC_CLI_PATH,
   192→  } = options;
   193→
   194→  const startTime = Date.now();
   195→  const sessionId = ulid();
   196→
   197→  // Resolve adapter
   198→  const adapterId = agent.adapter ?? "claude-agent-acp";
   199→  const adapter = resolveAdapter(adapterId);
   200→
   201→  // Build extra args for auto-approve
   202→  const extraArgs = autoApprove ? (adapter.autoApproveArgs ?? []) : [];
   203→
   204→  // Resolve timeout: option overrides agent budget
   205→  const timeoutMinutes =
   206→    options.timeoutMinutes ??
   207→    agent.budget?.timeout_minutes ??
   208→    30;
   209→  const timeoutMs = timeoutMinutes * 60 * 1000;
   210→
   211→  // Resolve skill content for prompt
   212→  // AC: @agent-invocation-lifecycle ac-7
   213→  const fullPrompt = await buildPromptWithSkills({
   214→    basePrompt: options.prompt,
   215→    skillIds: agent.skills ?? [],
   216→    specDir,
   217→  });
   218→
   219→  // Capture the pre-existing KSPEC_SESSION_ID so we can restore it in finally.
   220→  // AC: @agent-invocation-lifecycle ac-8
   221→  const previousKspecSessionId = process.env.KSPEC_SESSION_ID;
   222→
   223→  const state: InvocationState = {
   224→    sessionId,
   225→    specDir,
   226→    taskRef,
   227→    adapterId,
   228→    previousEnvValue: undefined,
   229→    agent: null,
   230→    acpSessionId: null,
   231→  };
   232→
   233→  // ─── Create session ───────────────────────────────────────────────────────
   234→  // AC: @agent-invocation-lifecycle ac-1
   235→  const session = await createSession(specDir, {
   236→    id: sessionId,
   237→    agent_type: adapterId,
   238→    agent_id: agent.id,
   239→    trigger,
   240→    task_id: taskRef,
   241→  });
   242→
   243→  // ─── Log agent.dispatched event ───────────────────────────────────────────
   244→  await appendEvent(specDir, {
   245→    type: "agent.dispatched",
   246→    session_id: sessionId,
   247→    data: {
   248→      task_id: taskRef,
   249→      agent_id: agent.id,
   250→      adapter: adapterId,
   251→      trigger,
   252→    },
   253→  });
   254→
   255→  try {
   256→    // ─── Inject KSPEC_SESSION_ID ──────────────────────────────────────────
   257→    // AC: @agent-invocation-lifecycle ac-2
   258→    const injectionResult = await injectEnvForAdapter(adapterId, sessionId);
   259→    state.previousEnvValue = injectionResult?.previousValue;
   260→    process.env.KSPEC_SESSION_ID = sessionId;
   261→
   262→    // ─── Spawn agent ──────────────────────────────────────────────────────
   263→    state.agent = await spawnAndInitialize(adapter, {
   264→      cwd,
   265→      env: {
   266→        ...env,
   267→        KSPEC_SESSION_ID: sessionId,
   268→      },
   269→      extraArgs,
   270→    });
   271→
   272→    // ─── Create ACP session ───────────────────────────────────────────────
   273→    state.acpSessionId = await state.agent.client.newSession({
   274→      cwd,
   275→      mcpServers: [],
   276→    });
   277→
   278→    // ─── Log agent.started event ──────────────────────────────────────────
   279→    await appendEvent(specDir, {
   280→      type: "agent.started",
   281→      session_id: sessionId,
   282→      data: {
   283→        task_id: taskRef,
   284→        agent_id: agent.id,
   285→        acp_session_id: state.acpSessionId,
   286→      },
   287→    });
   288→
   289→    // ─── Register update handler ──────────────────────────────────────────
   290→    // AC: @agent-invocation-lifecycle ac-6
   291→    const updateHandler = async (acpSessionId: string, update: SessionUpdate) => {
   292→      if (acpSessionId !== state.acpSessionId) return;
   293→
   294→      // Log event to JSONL (with blob externalization from store.ts)
   295→      await appendEvent(specDir, {
   296→        type: "session.update",
   297→        session_id: sessionId,
   298→        data: update,
   299→      });
   300→
   301→      onUpdate?.(update);
   302→    };
   303→
   304→    state.agent.client.on("update", updateHandler);
   305→
   306→    // ─── Send prompt with timeout ─────────────────────────────────────────
   307→    // AC: @agent-invocation-lifecycle ac-3
   308→    let timeoutHandle: ReturnType<typeof setTimeout> | undefined;
   309→    const timeoutPromise = new Promise<never>((_, reject) => {
   310→      timeoutHandle = setTimeout(() => {
   311→        reject(new InvocationTimeoutError(timeoutMinutes));
   312→      }, timeoutMs);
   313→    });
   314→
   315→    const promptPromise = state.agent.client.prompt({
   316→      sessionId: state.acpSessionId,
   317→      prompt: [{ type: "text", text: fullPrompt }],
   318→    });
   319→
   320→    let promptResult: Awaited<typeof promptPromise>;
   321→    try {
   322→      promptResult = await Promise.race([promptPromise, timeoutPromise]);
   323→    } finally {
   324→      // Clear the timeout handle to prevent timer leaks whether prompt
   325→      // resolves normally or the timeout fires.
   326→      clearTimeout(timeoutHandle);
   327→    }
   328→
   329→    // ─── Log agent.completed event ────────────────────────────────────────
   330→    // AC: @agent-invocation-lifecycle ac-4
   331→    const durationMs = Date.now() - startTime;
   332→    await appendEvent(specDir, {
   333→      type: "agent.completed",
   334→      session_id: sessionId,
   335→      data: {
   336→        task_id: taskRef,
   337→        outcome: "success",
   338→        stop_reason: promptResult.stopReason,
   339→        duration_ms: durationMs,
   340→      },
   341→    });
   342→
   343→    // ─── Close session as completed ───────────────────────────────────────
   344→    const finalSession = await closeSession(specDir, sessionId, "completed", "Invocation completed normally");
   345→
   346→    // Add success note to reset consecutive failure streak
   347→    // AC: @agent-invocation-lifecycle ac-9
   348→    addTaskNote(
   349→      taskRef,
   350→      `[AGENT-SUCCESS] Invocation completed successfully`,
   351→      cwd,
   352→      kspecCliPath,
   353→    );
   354→
   355→    return {
   356→      session: finalSession ?? session,
   357→      outcome: "success",
   358→      stopReason: promptResult.stopReason,
   359→      durationMs,
   360→    };
   361→  } catch (err) {
   362→    const durationMs = Date.now() - startTime;
   363→
   364→    if (err instanceof InvocationTimeoutError) {
   365→      // ─── Handle timeout ──────────────────────────────────────────────
   366→      // AC: @agent-invocation-lifecycle ac-3
   367→      try {
   368→        if (state.acpSessionId && state.agent) {
   369→          await state.agent.client.cancel(state.acpSessionId);
   370→        }
   371→      } catch {
   372→        // Best-effort cancel
   373→      }
   374→
   375→      await appendEvent(specDir, {
   376→        type: "agent.timeout",
   377→        session_id: sessionId,
   378→        data: {
   379→          task_id: taskRef,
   380→          timeout_minutes: timeoutMinutes,
   381→          duration_ms: durationMs,
   382→        },
   383→      });
   384→
   385→      const finalSession = await closeSession(specDir, sessionId, "timed_out", `Timeout after ${timeoutMinutes} minutes`);
   386→
   387→      // Add timeout note to task
   388→      addTaskNote(
   389→        taskRef,
   390→        `[AGENT-TIMEOUT] Invocation timed out after ${timeoutMinutes} minutes`,
   391→        cwd,
   392→        kspecCliPath,
   393→      );
   394→
   395→      return {
   396→        session: finalSession ?? session,
   397→        outcome: "timed_out",
   398→        error: err.message,
   399→        durationMs,
   400→      };
   401→    }
   402→
   403→    // ─── Handle failure ──────────────────────────────────────────────────
   404→    // AC: @agent-invocation-lifecycle ac-5
   405→    const errorMessage = err instanceof Error ? err.message : String(err);
   406→
   407→    await appendEvent(specDir, {
   408→      type: "agent.failed",
   409→      session_id: sessionId,
   410→      data: {
   411→        task_id: taskRef,
   412→        error: errorMessage,
   413→        duration_ms: durationMs,
   414→      },
   415→    });
   416→
   417→    const finalSession = await closeSession(specDir, sessionId, "failed", `Invocation failed: ${errorMessage}`);
   418→
   419→    // Add failure note to task
   420→    addTaskNote(
   421→      taskRef,
   422→      `[AGENT-FAIL] Invocation failed: ${errorMessage}`,
   423→      cwd,
   424→      kspecCliPath,
   425→    );
   426→
   427→    // ─── Check retry threshold ────────────────────────────────────────────
   428→    // AC: @agent-invocation-lifecycle ac-9
   429→    const retryLimit = agent.budget?.max_tasks ?? 3;
   430→    const consecutiveFailures = getConsecutiveFailureCount(taskRef, cwd, kspecCliPath);
   431→
   432→    if (consecutiveFailures >= retryLimit) {
   433→      blockTask(
   434→        taskRef,
   435→        `Agent ${agent.id} failed ${consecutiveFailures} consecutive times: ${errorMessage}`,
   436→        cwd,
   437→        kspecCliPath,
   438→      );
   439→    }
   440→
   441→    return {
   442→      session: finalSession ?? session,
   443→      outcome: "failed",
   444→      error: errorMessage,
   445→      durationMs,
   446→    };
   447→  } finally {
   448→    // ─── Cleanup ──────────────────────────────────────────────────────────
   449→    // AC: @agent-invocation-lifecycle ac-8
   450→
   451→    // End ACP session
   452→    if (state.acpSessionId && state.agent) {
   453→      try {
   454→        state.agent.client.endSession(state.acpSessionId);
   455→      } catch {
   456→        // Best-effort
   457→      }
   458→    }
   459→
   460→    // Terminate agent process
   461→    state.agent = disposeAgent(state.agent);
   462→
   463→    // Restore env injection
   464→    await removeEnvForAdapter(adapterId, state.previousEnvValue);
   465→
   466→    // Restore process.env.KSPEC_SESSION_ID to its pre-invocation value.
   467→    // AC: @agent-invocation-lifecycle ac-8
   468→    if (previousKspecSessionId === undefined) {
   469→      delete process.env.KSPEC_SESSION_ID;
   470→    } else {
   471→      process.env.KSPEC_SESSION_ID = previousKspecSessionId;
   472→    }
   473→  }
   474→}
   475→
   476→// ─── Error Types ──────────────────────────────────────────────────────────────
   477→
   478→/**
   479→ * Thrown when an invocation exceeds its configured timeout.
   480→ */
   481→export class InvocationTimeoutError extends Error {
   482→  constructor(public readonly timeoutMinutes: number) {
   483→    super(`Agent invocation timed out after ${timeoutMinutes} minutes`);
   484→    this.name = "InvocationTimeoutError";
   485→  }
   486→}
   487→

