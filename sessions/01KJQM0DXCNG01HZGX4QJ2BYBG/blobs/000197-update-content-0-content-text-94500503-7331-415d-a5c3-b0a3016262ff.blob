   541→
   542→  it("should externalize oversized payload blobs when session updates exceed threshold", async () => {
   543→    // AC: @agent-invocation-lifecycle ac-6 — blob externalization for oversized payloads
   544→    // Register mock adapter that sends a large payload (> EVENT_FIELD_EXTERNALIZE_BYTES = 16KB)
   545→    const oversizedText = "x".repeat(20 * 1024); // 20KB text — exceeds 16KB field threshold
   546→    registerAdapter("large-payload-acp", {
   547→      command: "node",
   548→      args: [MOCK_ACP],
   549→      env: {
   550→        MOCK_ACP_RESPONSE_TEXT: oversizedText,
   551→      },
   552→      description: "Mock ACP that sends oversized updates for blob externalization tests",
   553→    });
   554→
   555→    const agent = makeTestAgent({ adapter: "large-payload-acp" });
   556→    const result = await runInvocation({
   557→      agent,
   558→      specDir: testDir,
   559→      cwd: process.cwd(),
   560→      taskRef: "@" + testUlid("TASK"),
   561→      prompt: "Test blob externalization",
   562→      trigger: "task.ready",
   563→    });
   564→
   565→    expect(result.outcome).toBe("success");
   566→
   567→    const eventsPath = path.join(testDir, "sessions", result.session.id, "events.jsonl");
   568→    const content = await fs.readFile(eventsPath, "utf-8");
   569→    const lines = content.trim().split("\n").filter(Boolean);
   570→    const events = lines.map((l) => JSON.parse(l));
   571→
   572→    // Find the session.update event that contains the large payload
   573→    const updateEvent = events.find((e: { type: string }) => e.type === "session.update");
   574→    expect(updateEvent).toBeDefined();
   575→
   576→    // The oversized text field should be externalized as a blob pointer
   577→    // Walk data to find a blob pointer anywhere in the update's data tree
   578→    function hasBlobPointer(obj: unknown): boolean {
   579→      if (isSessionBlobPointer(obj)) return true;
   580→      if (typeof obj === "object" && obj !== null) {
   581→        return Object.values(obj).some(hasBlobPointer);
   582→      }
   583→      return false;
   584→    }
   585→
   586→    expect(hasBlobPointer(updateEvent.data)).toBe(true);
   587→
   588→    // Verify the blob file was created in the session's blobs/ directory
   589→    const blobDir = path.join(testDir, "sessions", result.session.id, "blobs");
   590→    const blobFiles = await fs.readdir(blobDir);
   591→    expect(blobFiles.length).toBeGreaterThan(0);
   592→  });
   593→});
   594→
   595→// ─── AC-7: Skill resolution ───────────────────────────────────────────────────
   596→
   597→// AC: @agent-invocation-lifecycle ac-7
   598→describe("Skill resolution for agent invocations", () => {
