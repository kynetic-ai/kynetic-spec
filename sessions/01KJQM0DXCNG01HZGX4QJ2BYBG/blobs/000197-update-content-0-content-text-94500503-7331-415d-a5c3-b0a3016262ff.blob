   208→// ─── AC-3: Timeout handling ───────────────────────────────────────────────────
   209→
   210→// AC: @agent-invocation-lifecycle ac-3
   211→describe("Timeout handling", () => {
   212→  let testDir: string;
   213→
   214→  beforeEach(async () => {
   215→    testDir = await createTempDir("kspec-invoc-ac3-");
   216→
   217→    // Register a slow adapter that delays response
   218→    registerAdapter("slow-mock-acp", {
   219→      command: "node",
   220→      args: [MOCK_ACP],
   221→      env: {
   222→        MOCK_ACP_DELAY_MS: "5000", // 5 second delay
   223→      },
   224→      description: "Slow mock ACP agent for timeout tests",
   225→    });
   226→  });
   227→
   228→  afterEach(async () => {
   229→    await cleanupTempDir(testDir);
   230→  });
   231→
   232→  it("should close session as timed_out when timeout is reached", async () => {
   233→    const agent = makeTestAgent({ adapter: "slow-mock-acp" });
   234→
   235→    const result = await runInvocation({
   236→      agent,
   237→      specDir: testDir,
   238→      cwd: process.cwd(),
   239→      taskRef: "@" + testUlid("TASK"),
   240→      prompt: "Test timeout",
   241→      trigger: "task.ready",
   242→      timeoutMinutes: 0.001, // ~60ms timeout — much less than 5s delay
   243→    });
   244→
   245→    expect(result.outcome).toBe("timed_out");
   246→    expect(result.session.status).toBe("timed_out");
   247→  });
   248→
   249→  it("should log agent.timeout event when timeout occurs", async () => {
   250→    const agent = makeTestAgent({ adapter: "slow-mock-acp" });
   251→
   252→    const result = await runInvocation({
   253→      agent,
   254→      specDir: testDir,
   255→      cwd: process.cwd(),
   256→      taskRef: "@" + testUlid("TASK"),
   257→      prompt: "Test timeout event logging",
   258→      trigger: "task.ready",
   259→      timeoutMinutes: 0.001,
   260→    });
   261→
   262→    // Read the events.jsonl
   263→    const eventsPath = path.join(testDir, "sessions", result.session.id, "events.jsonl");
   264→    const content = await fs.readFile(eventsPath, "utf-8");
   265→    const events = content.trim().split("\n").filter(Boolean).map((l) => JSON.parse(l));
   266→
   267→    const timeoutEvent = events.find((e: { type: string }) => e.type === "agent.timeout");
   268→    expect(timeoutEvent).toBeDefined();
   269→    expect(timeoutEvent.data.task_id).toBeDefined();
   270→    expect(timeoutEvent.data.timeout_minutes).toBeDefined();
   271→  });
   272→
   273→  it("should add a timeout note to the task when timeout occurs", async () => {
   274→    // AC: @agent-invocation-lifecycle ac-3 — timeout note written to task
   275→    const agent = makeTestAgent({ adapter: "slow-mock-acp" });
   276→    const captureFile = path.join(testDir, "kspec-calls.json");
   277→    const taskRef = "@" + testUlid("TASK");
   278→
   279→    // Set capture env so runKspecCli's spawnSync inherits it
   280→    process.env.KSPEC_CAPTURE_FILE = captureFile;
   281→    try {
   282→      await runInvocation({
   283→        agent,
   284→        specDir: testDir,
   285→        cwd: process.cwd(),
   286→        taskRef,
   287→        prompt: "Test timeout note",
   288→        trigger: "task.ready",
   289→        timeoutMinutes: 0.001,
   290→        kspecCliPath: MOCK_KSPEC_CLI,
   291→      });
   292→    } finally {
   293→      delete process.env.KSPEC_CAPTURE_FILE;
   294→    }
   295→
   296→    // Verify that kspec task note was called with the task ref and AGENT-TIMEOUT marker
   297→    const calls = JSON.parse(fsSync.readFileSync(captureFile, "utf-8")) as Array<{ args: string[] }>;
   298→    const noteCall = calls.find((c) =>
   299→      c.args.includes("task") && c.args.includes("note") && c.args.includes(taskRef)
   300→    );
   301→    expect(noteCall).toBeDefined();
   302→    const noteText = noteCall!.args[noteCall!.args.indexOf(taskRef) + 1] ?? "";
   303→    expect(noteText).toContain("[AGENT-TIMEOUT]");
   304→  });
   305→});
