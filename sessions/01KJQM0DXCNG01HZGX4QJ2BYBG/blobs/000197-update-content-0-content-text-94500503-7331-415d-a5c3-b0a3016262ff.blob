```
     1→/**
     2→ * Agent Invocation Lifecycle tests.
     3→ *
     4→ * Tests for per-invocation session creation, ACP agent spawn, prompt delivery,
     5→ * event logging, timeout handling, and structured completion tracking.
     6→ *
     7→ * Task: @implement-agent-invocation-lifecycle
     8→ * Spec: @agent-invocation-lifecycle
     9→ */
    10→
    11→import { describe, it, expect, beforeEach, afterEach, vi } from "vitest";
    12→import * as fs from "node:fs/promises";
    13→import * as fsSync from "node:fs";
    14→import * as path from "node:path";
    15→import * as os from "node:os";
    16→import * as YAML from "yaml";
    17→import {
    18→  createSession,
    19→  appendEvent,
    20→  getSession,
    21→  closeSession,
    22→  injectEnvForAdapter,
    23→  removeEnvForAdapter,
    24→  isSessionBlobPointer,
    25→} from "../src/sessions/store.js";
    26→import * as storeModule from "../src/sessions/store.js";
    27→import { runInvocation, InvocationTimeoutError } from "../src/agent-runtime/invocation.js";
    28→import { resolveSkills, buildPromptWithSkills } from "../src/agent-runtime/prompts.js";
    29→import { registerAdapter } from "../src/agents/adapters.js";
    30→import { spawnAndInitialize } from "../src/agents/spawner.js";
    31→import type { Agent } from "../src/schema/meta.js";
    32→import {
    33→  testUlid,
    34→  createTempDir,
    35→  cleanupTempDir,
    36→} from "./helpers/cli.js";
    37→
    38→// ─── Fixtures ─────────────────────────────────────────────────────────────────
    39→
    40→const MOCK_ACP = path.join(__dirname, "mocks", "acp-mock.js");
    41→const MOCK_KSPEC_CLI = path.join(__dirname, "mocks", "kspec-capture-mock.cjs");
    42→
    43→/**
    44→ * Create a minimal Agent definition for testing.
    45→ */
    46→function makeTestAgent(overrides: Partial<Agent> = {}): Agent {
    47→  return {
    48→    _ulid: testUlid("AGNT"),
    49→    id: "test-worker",
    50→    name: "Test Worker Agent",
    51→    capabilities: [],
    52→    tools: [],
    53→    conventions: [],
    54→    dispatch: [],
    55→    skills: [],
    56→    auto_approve: false,
    57→    concurrency: { max_concurrent: 1 },
    58→    adapter: "mock-acp",
    59→    ...overrides,
    60→  };
    61→}
    62→
    63→/**
    64→ * Register the mock ACP adapter for testing.
    65→ */
    66→function registerMockAdapter(env: Record<string, string> = {}): void {
    67→  registerAdapter("mock-acp", {
    68→    command: "node",
    69→    args: [MOCK_ACP],
    70→    env: {
    71→      MOCK_ACP_PROJECT_DIR: process.cwd(),
    72→      ...env,
    73→    },
    74→    description: "Mock ACP agent for testing",
    75→  });
    76→}
    77→
    78→// ─── AC-1: Session creation with trigger, agent_id, task_id ──────────────────
    79→
    80→// AC: @agent-invocation-lifecycle ac-1
    81→describe("Session creation on invocation start", () => {
    82→  let testDir: string;
    83→
    84→  beforeEach(async () => {
    85→    testDir = await createTempDir("kspec-invoc-ac1-");
    86→    registerMockAdapter();
    87→  });
    88→
    89→  afterEach(async () => {
    90→    await cleanupTempDir(testDir);
    91→  });
    92→
    93→  it("should create session with trigger, agent_id, and task_id populated", async () => {
    94→    const agent = makeTestAgent({ id: "worker-agent" });
    95→    const taskRef = "@" + testUlid("TASK");
    96→
    97→    // Run a quick invocation (mock agent completes immediately)
    98→    const result = await runInvocation({
    99→      agent,
   100→      specDir: testDir,
   101→      cwd: process.cwd(),
   102→      taskRef,
   103→      prompt: "Test session creation",
   104→      trigger: "task.ready",
   105→    });
   106→
   107→    expect(result.session).toBeDefined();
   108→    expect(result.session.trigger).toBe("task.ready");
   109→    expect(result.session.agent_id).toBe("worker-agent");
   110→    expect(result.session.task_id).toBe(taskRef);
   111→    expect(result.session.agent_type).toBe("mock-acp");
   112→  });
   113→
   114→  it("should create session directory with session.yaml", async () => {
   115→    const agent = makeTestAgent();
   116→    const taskRef = "@" + testUlid("TASK", 1);
   117→
   118→    const result = await runInvocation({
   119→      agent,
   120→      specDir: testDir,
   121→      cwd: process.cwd(),
   122→      taskRef,
   123→      prompt: "Check session file creation",
   124→      trigger: "task.needs_work",
   125→    });
   126→
   127→    const sessionDir = path.join(testDir, "sessions", result.session.id);
   128→    const sessionYaml = path.join(sessionDir, "session.yaml");
   129→
   130→    await expect(fs.access(sessionYaml)).resolves.toBeUndefined();
   131→    const content = await fs.readFile(sessionYaml, "utf-8");
   132→    const parsed = YAML.parse(content);
   133→    expect(parsed.trigger).toBe("task.needs_work");
   134→    expect(parsed.task_id).toBe(taskRef);
   135→  });
   136→});
