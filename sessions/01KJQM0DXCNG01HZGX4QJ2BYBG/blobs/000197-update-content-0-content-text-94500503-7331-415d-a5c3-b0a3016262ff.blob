   480→// ─── AC-6: Streaming event logging ───────────────────────────────────────────
   481→
   482→// AC: @agent-invocation-lifecycle ac-6
   483→describe("Streaming event logging", () => {
   484→  let testDir: string;
   485→
   486→  beforeEach(async () => {
   487→    testDir = await createTempDir("kspec-invoc-ac6-");
   488→    registerMockAdapter({
