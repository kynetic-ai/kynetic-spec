   671→// ─── AC-8: Cleanup on completion or failure ───────────────────────────────────
   672→
   673→// AC: @agent-invocation-lifecycle ac-8
   674→describe("Cleanup on completion or failure", () => {
   675→  let testDir: string;
   676→
   677→  beforeEach(async () => {
   678→    testDir = await createTempDir("kspec-invoc-ac8-");
   679→    registerMockAdapter();
   680→  });
   681→
   682→  afterEach(async () => {
   683→    await cleanupTempDir(testDir);
   684→  });
   685→
   686→  it("should terminate agent process after successful completion", async () => {
   687→    const agent = makeTestAgent();
   688→
   689→    // If the agent process isn't terminated, the test would hang or
   690→    // leave zombie processes. The fact that runInvocation returns is
   691→    // evidence that the process was managed correctly.
   692→    const result = await runInvocation({
   693→      agent,
   694→      specDir: testDir,
   695→      cwd: process.cwd(),
   696→      taskRef: "@" + testUlid("TASK"),
   697→      prompt: "Test cleanup on success",
   698→      trigger: "task.ready",
   699→    });
   700→
   701→    expect(result.outcome).toBe("success");
   702→    // If we reach here without hanging, cleanup worked
   703→  });
   704→
   705→  it("should restore KSPEC_SESSION_ID env after invocation", async () => {
   706→    const agent = makeTestAgent();
   707→    const originalValue = process.env.KSPEC_SESSION_ID;
   708→
   709→    await runInvocation({
   710→      agent,
   711→      specDir: testDir,
   712→      cwd: process.cwd(),
   713→      taskRef: "@" + testUlid("TASK"),
   714→      prompt: "Test env restoration",
   715→      trigger: "task.ready",
   716→    });
   717→
   718→    // After invocation, env should be back to original
   719→    // (either undefined or the original value)
   720→    expect(process.env.KSPEC_SESSION_ID).toBe(originalValue);
   721→  });
   722→
   723→  it("should restore env even when invocation fails", async () => {
   724→    registerAdapter("failing-cleanup-acp", {
   725→      command: "node",
   726→      args: [MOCK_ACP],
   727→      env: { MOCK_ACP_EXIT_CODE: "1" },
   728→      description: "Failing adapter for cleanup test",
   729→    });
   730→
   731→    const agent = makeTestAgent({ adapter: "failing-cleanup-acp" });
   732→    const originalValue = process.env.KSPEC_SESSION_ID;
   733→
   734→    const result = await runInvocation({
   735→      agent,
   736→      specDir: testDir,
   737→      cwd: process.cwd(),
   738→      taskRef: "@" + testUlid("TASK"),
   739→      prompt: "Test cleanup on failure",
   740→      trigger: "task.ready",
   741→    });
   742→
   743→    expect(result.outcome).toBe("failed");
   744→    // Env should be restored
   745→    expect(process.env.KSPEC_SESSION_ID).toBe(originalValue);
   746→  });
   747→
   748→  it("should call removeEnvForAdapter to restore adapter-specific env injection", async () => {
   749→    // AC: @agent-invocation-lifecycle ac-8 — adapter env injection is restored to previous state
   750→    const removeEnvSpy = vi.spyOn(storeModule, "removeEnvForAdapter");
   751→
   752→    try {
   753→      const agent = makeTestAgent(); // uses "mock-acp" adapter
   754→      await runInvocation({
   755→        agent,
   756→        specDir: testDir,
   757→        cwd: process.cwd(),
   758→        taskRef: "@" + testUlid("TASK"),
   759→        prompt: "Test adapter env restoration",
   760→        trigger: "task.ready",
   761→      });
   762→
   763→      // removeEnvForAdapter must be called with the adapter ID on cleanup
   764→      // For "mock-acp" the injectionResult is null so previousValue is undefined
   765→      expect(removeEnvSpy).toHaveBeenCalledWith("mock-acp", undefined);
   766→    } finally {
   767→      removeEnvSpy.mockRestore();
   768→    }
   769→  });
   770→
   771→  it("should call removeEnvForAdapter even when invocation fails", async () => {
   772→    // AC: @agent-invocation-lifecycle ac-8 — adapter env injection restored on failure path too
   773→    registerAdapter("failing-env-acp", {
   774→      command: "node",
   775→      args: [MOCK_ACP],
   776→      env: { MOCK_ACP_EXIT_CODE: "1" },
   777→      description: "Failing adapter for env restoration test",
   778→    });
   779→
   780→    const removeEnvSpy = vi.spyOn(storeModule, "removeEnvForAdapter");
   781→
   782→    try {
   783→      const agent = makeTestAgent({ adapter: "failing-env-acp" });
   784→      const result = await runInvocation({
   785→        agent,
   786→        specDir: testDir,
   787→        cwd: process.cwd(),
   788→        taskRef: "@" + testUlid("TASK"),
   789→        prompt: "Test env restoration on failure",
   790→        trigger: "task.ready",
   791→      });
   792→
   793→      expect(result.outcome).toBe("failed");
   794→      // removeEnvForAdapter called once for this invocation (not from prior test since spy was scoped)
   795→      expect(removeEnvSpy).toHaveBeenCalledWith("failing-env-acp", undefined);
   796→    } finally {
   797→      removeEnvSpy.mockRestore();
   798→    }
   799→  });
   800→});
