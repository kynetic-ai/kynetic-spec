   802→// ─── AC-9: Retry threshold and task blocking ──────────────────────────────────
   803→
   804→// AC: @agent-invocation-lifecycle ac-9
   805→describe("Consecutive failure threshold and task blocking", () => {
   806→  let testDir: string;
   807→
   808→  beforeEach(async () => {
   809→    testDir = await createTempDir("kspec-invoc-ac9-");
   810→    registerAdapter("always-fail-acp", {
   811→      command: "node",
   812→      args: [MOCK_ACP],
   813→      env: { MOCK_ACP_EXIT_CODE: "1" },
   814→      description: "Always-failing adapter for retry threshold tests",
   815→    });
   816→  });
   817→
   818→  afterEach(async () => {
   819→    await cleanupTempDir(testDir);
   820→  });
   821→
   822→  it("should block the task with a failure note when consecutive failures reach retry limit", async () => {
   823→    // AC: @agent-invocation-lifecycle ac-9 — consecutive failures → task blocked with note
   824→    // The agent's retry limit is derived from agent.budget.max_tasks (default 3).
   825→    // We pre-populate the capture file to simulate prior failure notes already recorded
   826→    // by previous invocations, then trigger the threshold-crossing invocation.
   827→    const captureFile = path.join(testDir, "kspec-calls.json");
   828→    const taskRef = "@" + testUlid("TASK");
   829→
   830→    // Mock kspec CLI: simulate "task get" returning a task with 3 existing AGENT-FAIL notes.
   831→    // The implementation calls getConsecutiveFailureCount (kspec task get --json) to read
   832→    // the note history. With 3 consecutive AGENT-FAIL notes and a retry limit of 3, blocking
   833→    // must be triggered.
   834→    const taskGetMockPath = path.join(testDir, "kspec-threshold-mock.cjs");
   835→    const mockTask = {
   836→      notes: [
   837→        { content: "[AGENT-FAIL] Invocation failed: Mock failure" },
   838→        { content: "[AGENT-FAIL] Invocation failed: Mock failure" },
   839→        { content: "[AGENT-FAIL] Invocation failed: Mock failure" },
   840→      ],
   841→    };
   842→    await fs.writeFile(taskGetMockPath, `#!/usr/bin/env node
   843→'use strict';
   844→const fs = require('node:fs');
   845→const args = process.argv.slice(2);
   846→const captureFile = process.env.KSPEC_CAPTURE_FILE;
   847→
   848→if (captureFile) {
   849→  let calls = [];
   850→  try { calls = JSON.parse(fs.readFileSync(captureFile, 'utf-8')); } catch {}
   851→  calls.push({ args, timestamp: Date.now() });
   852→  fs.writeFileSync(captureFile, JSON.stringify(calls, null, 2));
   853→}
   854→
   855→// Return task JSON for "task get ... --json" to simulate 3 consecutive prior failures
   856→if (args.includes('task') && args.includes('get') && args.includes('--json')) {
   857→  process.stdout.write(JSON.stringify(${JSON.stringify(mockTask)}) + '\\n');
   858→}
   859→
   860→process.exit(0);
   861→`);
   862→
   863→    process.env.KSPEC_CAPTURE_FILE = captureFile;
   864→    try {
   865→      const agent = makeTestAgent({
   866→        adapter: "always-fail-acp",
   867→        budget: { max_tasks: 3, timeout_minutes: 30 },
   868→      } as Partial<Agent>);
   869→
   870→      await runInvocation({
   871→        agent,
   872→        specDir: testDir,
   873→        cwd: process.cwd(),
   874→        taskRef,
   875→        prompt: "Test consecutive failure blocking",
   876→        trigger: "task.ready",
   877→        kspecCliPath: taskGetMockPath,
   878→      });
   879→    } finally {
   880→      delete process.env.KSPEC_CAPTURE_FILE;
   881→    }
   882→
   883→    // Verify task block was called
   884→    const calls = JSON.parse(fsSync.readFileSync(captureFile, "utf-8")) as Array<{ args: string[] }>;
   885→    const blockCall = calls.find((c) =>
   886→      c.args.includes("task") && c.args.includes("block") && c.args.includes(taskRef)
   887→    );
   888→    expect(blockCall).toBeDefined();
   889→
   890→    // The block reason should mention consecutive failures and the agent
   891→    const reasonIdx = blockCall!.args.indexOf("--reason");
   892→    expect(reasonIdx).toBeGreaterThan(-1);
   893→    const blockReason = blockCall!.args[reasonIdx + 1] ?? "";
   894→    expect(blockReason).toContain("consecutive");
   895→  });
   896→
   897→  it("should NOT block the task when failure count is below the retry limit", async () => {
   898→    // AC: @agent-invocation-lifecycle ac-9 — below threshold: note added, no block
   899→    const captureFile = path.join(testDir, "kspec-calls-below.json");
   900→    const taskRef = "@" + testUlid("TASK");
   901→
   902→    // Mock kspec CLI: simulate task with 0 prior AGENT-FAIL notes (first failure)
   903→    const taskGetMockPath = path.join(testDir, "kspec-below-mock.cjs");
   904→    const emptyTask = { notes: [] };
   905→    await fs.writeFile(taskGetMockPath, `#!/usr/bin/env node
   906→'use strict';
   907→const fs = require('node:fs');
   908→const args = process.argv.slice(2);
   909→const captureFile = process.env.KSPEC_CAPTURE_FILE;
   910→
   911→if (captureFile) {
   912→  let calls = [];
   913→  try { calls = JSON.parse(fs.readFileSync(captureFile, 'utf-8')); } catch {}
   914→  calls.push({ args, timestamp: Date.now() });
   915→  fs.writeFileSync(captureFile, JSON.stringify(calls, null, 2));
   916→}
   917→
   918→if (args.includes('task') && args.includes('get') && args.includes('--json')) {
   919→  process.stdout.write(JSON.stringify(${JSON.stringify(emptyTask)}) + '\\n');
   920→}
   921→
   922→process.exit(0);
   923→`);
   924→
   925→    process.env.KSPEC_CAPTURE_FILE = captureFile;
   926→    try {
   927→      const agent = makeTestAgent({
   928→        adapter: "always-fail-acp",
   929→        budget: { max_tasks: 3, timeout_minutes: 30 },
   930→      } as Partial<Agent>);
   931→
   932→      await runInvocation({
   933→        agent,
   934→        specDir: testDir,
   935→        cwd: process.cwd(),
   936→        taskRef,
   937→        prompt: "Test below threshold",
   938→        trigger: "task.ready",
   939→        kspecCliPath: taskGetMockPath,
   940→      });
   941→    } finally {
   942→      delete process.env.KSPEC_CAPTURE_FILE;
   943→    }
   944→
   945→    const calls = JSON.parse(fsSync.readFileSync(captureFile, "utf-8")) as Array<{ args: string[] }>;
   946→
   947→    // Note should be written
   948→    const noteCall = calls.find((c) =>
   949→      c.args.includes("task") && c.args.includes("note") && c.args.includes(taskRef)
   950→    );
   951→    expect(noteCall).toBeDefined();
   952→
   953→    // Block should NOT be called (only 1 failure, limit is 3)
   954→    const blockCall = calls.find((c) =>
   955→      c.args.includes("task") && c.args.includes("block") && c.args.includes(taskRef)
   956→    );
   957→    expect(blockCall).toBeUndefined();
   958→  });
   959→});
