```
     1→import { Command } from 'commander';
     2→import { ulid } from 'ulid';
     3→import {
     4→  initContext,
     5→  loadAllTasks,
     6→  loadAllItems,
     7→  saveTask,
     8→  deleteTask,
     9→  createTask,
    10→  createNote,
    11→  createTodo,
    12→  syncSpecImplementationStatus,
    13→  ReferenceIndex,
    14→  checkSlugUniqueness,
    15→  type LoadedTask,
    16→} from '../../parser/index.js';
    17→import { commitIfShadow } from '../../parser/shadow.js';
    18→import {
    19→  output,
    20→  formatTaskDetails,
    21→  success,
    22→  error,
    23→  warn,
    24→  info,
    25→  isJsonMode,
    26→} from '../output.js';
    27→import { formatCommitGuidance, printCommitGuidance } from '../../utils/commit.js';
    28→import type { Task, TaskInput } from '../../schema/index.js';
    29→
    30→/**
    31→ * Find a task by reference with detailed error reporting.
    32→ * Returns the task or exits with appropriate error.
    33→ */
    34→function resolveTaskRef(
    35→  ref: string,
    36→  tasks: LoadedTask[],
    37→  index: ReferenceIndex
    38→): LoadedTask {
    39→  const result = index.resolve(ref);
    40→
    41→  if (!result.ok) {
    42→    switch (result.error) {
    43→      case 'not_found':
    44→        error(`Task not found: ${ref}`);
    45→        break;
    46→      case 'ambiguous':
    47→        error(`Reference "${ref}" is ambiguous. Matches:`);
    48→        for (const candidate of result.candidates) {
    49→          const task = tasks.find(t => t._ulid === candidate);
    50→          const slug = task?.slugs[0] || '';
    51→          console.error(`  - ${index.shortUlid(candidate)} ${slug ? `(${slug})` : ''}`);
    52→        }
    53→        break;
    54→      case 'duplicate_slug':
    55→        error(`Slug "${ref}" maps to multiple items. Use ULID instead:`);
    56→        for (const candidate of result.candidates) {
    57→          console.error(`  - ${index.shortUlid(candidate)}`);
    58→        }
    59→        break;
    60→    }
    61→    process.exit(3);
    62→  }
    63→
    64→  // Check if it's actually a task
    65→  const task = tasks.find(t => t._ulid === result.ulid);
    66→  if (!task) {
    67→    error(`Reference "${ref}" is not a task (it's a spec item)`);
    68→    process.exit(3);
    69→  }
    70→
    71→  return task;
    72→}
    73→
    74→/**
    75→ * Register the 'task' command group (singular - operations on individual tasks)
    76→ */
    77→export function registerTaskCommands(program: Command): void {
    78→  const task = program
    79→    .command('task')
    80→    .description('Operations on individual tasks');
    81→
    82→  // kspec task get <ref>
    83→  task
    84→    .command('get <ref>')
    85→    .description('Get task details')
    86→    .action(async (ref: string) => {
    87→      try {
    88→        const ctx = await initContext();
    89→        const tasks = await loadAllTasks(ctx);
    90→        const items = await loadAllItems(ctx);
    91→        const index = new ReferenceIndex(tasks, items);
    92→        const foundTask = resolveTaskRef(ref, tasks, index);
    93→
    94→        output(foundTask, () => formatTaskDetails(foundTask, index));
    95→      } catch (err) {
    96→        error('Failed to get task', err);
    97→        process.exit(1);
    98→      }
    99→    });
   100→
   101→  // kspec task add
   102→  task
   103→    .command('add')
   104→    .description('Create a new task')
   105→    .requiredOption('--title <title>', 'Task title')
   106→    .option('--type <type>', 'Task type (task, epic, bug, spike, infra)', 'task')
   107→    .option('--spec-ref <ref>', 'Reference to spec item')
   108→    .option('--priority <n>', 'Priority (1-5)', '3')
   109→    .option('--slug <slug>', 'Human-friendly slug')
   110→    .option('--tag <tag...>', 'Tags')
   111→    .action(async (options) => {
   112→      try {
   113→        const ctx = await initContext();
   114→        const tasks = await loadAllTasks(ctx);
   115→        const items = await loadAllItems(ctx);
   116→
   117→        // Check slug uniqueness if provided
   118→        if (options.slug) {
   119→          const refIndex = new ReferenceIndex(tasks, items);
   120→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   121→          if (!slugCheck.ok) {
   122→            error(`Slug '${slugCheck.slug}' already exists (used by ${slugCheck.existingUlid})`);
   123→            process.exit(1);
   124→          }
   125→        }
   126→
   127→        const input: TaskInput = {
   128→          title: options.title,
   129→          type: options.type,
   130→          spec_ref: options.specRef || null,
   131→          priority: parseInt(options.priority, 10),
   132→          slugs: options.slug ? [options.slug] : [],
   133→          tags: options.tag || [],
   134→        };
   135→
   136→        const newTask = createTask(input);
   137→        await saveTask(ctx, newTask);
   138→        await commitIfShadow(ctx.shadow, 'task-add', newTask.slugs[0] || newTask._ulid.slice(0, 8), newTask.title);
   139→
   140→        // Build index including the new task for accurate short ULID
   141→        const index = new ReferenceIndex([...tasks, newTask], items);
   142→        success(`Created task: ${index.shortUlid(newTask._ulid)}`, { task: newTask });
   143→      } catch (err) {
   144→        error('Failed to create task', err);
   145→        process.exit(1);
   146→      }
   147→    });
   148→
   149→  // kspec task set <ref>
   150→  task
   151→    .command('set <ref>')
   152→    .description('Update task fields')
   153→    .option('--title <title>', 'Update task title')
   154→    .option('--spec-ref <ref>', 'Link to spec item')
   155→    .option('--priority <n>', 'Set priority (1-5)')
   156→    .option('--slug <slug>', 'Add a slug alias')
   157→    .option('--tag <tag...>', 'Add tags')
   158→    .option('--depends-on <refs...>', 'Set dependencies (replaces existing)')
   159→    .action(async (ref: string, options) => {
   160→      try {
   161→        const ctx = await initContext();
   162→        const tasks = await loadAllTasks(ctx);
   163→        const items = await loadAllItems(ctx);
   164→        const index = new ReferenceIndex(tasks, items);
   165→        const foundTask = resolveTaskRef(ref, tasks, index);
   166→
   167→        // Check slug uniqueness if adding a new slug
   168→        if (options.slug) {
   169→          const slugCheck = checkSlugUniqueness(index, [options.slug], foundTask._ulid);
   170→          if (!slugCheck.ok) {
   171→            error(`Slug '${slugCheck.slug}' already exists (used by ${slugCheck.existingUlid})`);
   172→            process.exit(1);
   173→          }
   174→        }
   175→
   176→        // Build updated task with only provided options
   177→        const updatedTask: Task = { ...foundTask };
   178→        const changes: string[] = [];
   179→
   180→        if (options.title) {
   181→          updatedTask.title = options.title;
   182→          changes.push('title');
   183→        }
   184→
   185→        if (options.specRef) {
   186→          // Validate the spec ref exists and is a spec item
   187→          const specResult = index.resolve(options.specRef);
   188→          if (!specResult.ok) {
   189→            error(`Spec reference not found: ${options.specRef}`);
   190→            process.exit(3);
   191→          }
   192→          // Check it's not a task
   193→          const isTask = tasks.some(t => t._ulid === specResult.ulid);
   194→          if (isTask) {
   195→            error(`Reference "${options.specRef}" is a task, not a spec item`);
   196→            process.exit(3);
   197→          }
   198→          updatedTask.spec_ref = options.specRef;
   199→          changes.push('spec_ref');
   200→        }
   201→
   202→        if (options.priority) {
   203→          const priority = parseInt(options.priority, 10);
   204→          if (isNaN(priority) || priority < 1 || priority > 5) {
   205→            error('Priority must be between 1 and 5');
   206→            process.exit(3);
   207→          }
   208→          updatedTask.priority = priority;
   209→          changes.push('priority');
   210→        }
   211→
   212→        if (options.slug) {
   213→          if (!updatedTask.slugs.includes(options.slug)) {
   214→            updatedTask.slugs = [...updatedTask.slugs, options.slug];
   215→            changes.push('slug');
   216→          }
   217→        }
   218→
   219→        if (options.tag) {
   220→          const newTags = options.tag.filter((t: string) => !updatedTask.tags.includes(t));
   221→          if (newTags.length > 0) {
   222→            updatedTask.tags = [...updatedTask.tags, ...newTags];
   223→            changes.push('tags');
   224→          }
   225→        }
   226→
   227→        if (options.dependsOn) {
   228→          // Validate all dependency refs
   229→          for (const depRef of options.dependsOn) {
   230→            const depResult = index.resolve(depRef);
   231→            if (!depResult.ok) {
   232→              error(`Dependency reference not found: ${depRef}`);
   233→              process.exit(3);
   234→            }
   235→          }
   236→          updatedTask.depends_on = options.dependsOn;
   237→          changes.push('depends_on');
   238→        }
   239→
   240→        if (changes.length === 0) {
   241→          warn('No changes specified');
   242→          return;
   243→        }
   244→
   245→        await saveTask(ctx, updatedTask);
   246→        await commitIfShadow(ctx.shadow, 'task-set', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), changes.join(', '));
   247→        success(`Updated task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(', ')})`, { task: updatedTask });
   248→      } catch (err) {
   249→        error('Failed to update task', err);
   250→        process.exit(1);
   251→      }
   252→    });
   253→
   254→  // kspec task start <ref>
   255→  task
   256→    .command('start <ref>')
   257→    .description('Start working on a task (pending -> in_progress)')
   258→    .option('--no-sync', 'Skip syncing spec implementation status')
   259→    .action(async (ref: string, options) => {
   260→      try {
   261→        const ctx = await initContext();
   262→        const tasks = await loadAllTasks(ctx);
   263→        const items = await loadAllItems(ctx);
   264→        const index = new ReferenceIndex(tasks, items);
   265→        const foundTask = resolveTaskRef(ref, tasks, index);
   266→
   267→        if (foundTask.status === 'in_progress') {
   268→          warn('Task is already in progress');
   269→          output(foundTask, () => formatTaskDetails(foundTask));
   270→          return;
   271→        }
   272→
   273→        if (foundTask.status !== 'pending') {
   274→          error(`Cannot start task with status: ${foundTask.status}`);
   275→          process.exit(4); // Exit code 4 = invalid state
   276→        }
   277→
   278→        // Update status
   279→        const updatedTask: Task = {
   280→          ...foundTask,
   281→          status: 'in_progress',
   282→          started_at: new Date().toISOString(),
   283→        };
   284→
   285→        await saveTask(ctx, updatedTask);
   286→        await commitIfShadow(ctx.shadow, 'task-start', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   287→        success(`Started task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   288→
   289→        // Sync spec implementation status (unless --no-sync)
   290→        if (options.sync !== false && foundTask.spec_ref) {
   291→          const updatedTasks = tasks.map(t =>
   292→            t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t
   293→          );
   294→          const syncResult = await syncSpecImplementationStatus(
   295→            ctx,
   296→            updatedTask as LoadedTask,
   297→            updatedTasks as LoadedTask[],
   298→            items,
   299→            index
   300→          );
   301→          if (syncResult) {
   302→            info(`Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`);
   303→          }
   304→        }
   305→      } catch (err) {
   306→        error('Failed to start task', err);
   307→        process.exit(1);
   308→      }
   309→    });
   310→
   311→  // kspec task complete <ref>
   312→  task
   313→    .command('complete <ref>')
   314→    .description('Complete a task (in_progress -> completed)')
   315→    .option('--reason <reason>', 'Completion reason/notes')
   316→    .option('--no-sync', 'Skip syncing spec implementation status')
   317→    .action(async (ref: string, options) => {
   318→      try {
   319→        const ctx = await initContext();
   320→        const tasks = await loadAllTasks(ctx);
   321→        const items = await loadAllItems(ctx);
   322→        const index = new ReferenceIndex(tasks, items);
   323→        const foundTask = resolveTaskRef(ref, tasks, index);
   324→
   325→        if (foundTask.status === 'completed') {
   326→          warn('Task is already completed');
   327→          output(foundTask, () => formatTaskDetails(foundTask));
   328→          return;
   329→        }
   330→
   331→        if (foundTask.status !== 'in_progress' && foundTask.status !== 'pending') {
   332→          error(`Cannot complete task with status: ${foundTask.status}`);
   333→          process.exit(4);
   334→        }
   335→
   336→        const now = new Date().toISOString();
   337→
   338→        // Update status
   339→        const updatedTask: Task = {
   340→          ...foundTask,
   341→          status: 'completed',
   342→          completed_at: now,
   343→          closed_reason: options.reason || null,
   344→          started_at: foundTask.started_at || now, // Set started_at if not already
   345→        };
   346→
   347→        await saveTask(ctx, updatedTask);
   348→        await commitIfShadow(ctx.shadow, 'task-complete', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), options.reason);
   349→        success(`Completed task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   350→
   351→        // Output commit guidance (suppressed in JSON mode)
   352→        if (!isJsonMode()) {
   353→          const guidance = formatCommitGuidance(updatedTask);
   354→          printCommitGuidance(guidance);
   355→        }
   356→
   357→        // Sync spec implementation status (unless --no-sync)
   358→        if (options.sync !== false && foundTask.spec_ref) {
   359→          // Update task list to reflect the change we just made
   360→          const updatedTasks = tasks.map(t =>
   361→            t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t
   362→          );
   363→          const syncResult = await syncSpecImplementationStatus(
   364→            ctx,
   365→            updatedTask as LoadedTask,
   366→            updatedTasks as LoadedTask[],
   367→            items,
   368→            index
   369→          );
   370→          if (syncResult) {
   371→            info(`Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`);
   372→          }
   373→        }
   374→      } catch (err) {
   375→        error('Failed to complete task', err);
   376→        process.exit(1);
   377→      }
   378→    });
   379→
   380→  // kspec task block <ref>
   381→  task
   382→    .command('block <ref>')
   383→    .description('Block a task')
   384→    .requiredOption('--reason <reason>', 'Reason for blocking')
   385→    .action(async (ref: string, options) => {
   386→      try {
   387→        const ctx = await initContext();
   388→        const tasks = await loadAllTasks(ctx);
   389→        const items = await loadAllItems(ctx);
   390→        const index = new ReferenceIndex(tasks, items);
   391→        const foundTask = resolveTaskRef(ref, tasks, index);
   392→
   393→        if (foundTask.status === 'completed' || foundTask.status === 'cancelled') {
   394→          error(`Cannot block task with status: ${foundTask.status}`);
   395→          process.exit(4);
   396→        }
   397→
   398→        const updatedTask: Task = {
   399→          ...foundTask,
   400→          status: 'blocked',
   401→          blocked_by: [...foundTask.blocked_by, options.reason],
   402→        };
   403→
   404→        await saveTask(ctx, updatedTask);
   405→        await commitIfShadow(ctx.shadow, 'task-block', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   406→        success(`Blocked task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   407→      } catch (err) {
   408→        error('Failed to block task', err);
   409→        process.exit(1);
   410→      }
   411→    });
   412→
   413→  // kspec task unblock <ref>
   414→  task
   415→    .command('unblock <ref>')
   416→    .description('Unblock a task')
   417→    .action(async (ref: string) => {
   418→      try {
   419→        const ctx = await initContext();
   420→        const tasks = await loadAllTasks(ctx);
   421→        const items = await loadAllItems(ctx);
   422→        const index = new ReferenceIndex(tasks, items);
   423→        const foundTask = resolveTaskRef(ref, tasks, index);
   424→
   425→        if (foundTask.status !== 'blocked') {
   426→          warn('Task is not blocked');
   427→          return;
   428→        }
   429→
   430→        const updatedTask: Task = {
   431→          ...foundTask,
   432→          status: 'pending',
   433→          blocked_by: [],
   434→        };
   435→
   436→        await saveTask(ctx, updatedTask);
   437→        await commitIfShadow(ctx.shadow, 'task-unblock', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   438→        success(`Unblocked task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   439→      } catch (err) {
   440→        error('Failed to unblock task', err);
   441→        process.exit(1);
   442→      }
   443→    });
   444→
   445→  // kspec task cancel <ref>
   446→  task
   447→    .command('cancel <ref>')
   448→    .description('Cancel a task')
   449→    .option('--reason <reason>', 'Cancellation reason')
   450→    .action(async (ref: string, options) => {
   451→      try {
   452→        const ctx = await initContext();
   453→        const tasks = await loadAllTasks(ctx);
   454→        const items = await loadAllItems(ctx);
   455→        const index = new ReferenceIndex(tasks, items);
   456→        const foundTask = resolveTaskRef(ref, tasks, index);
   457→
   458→        if (foundTask.status === 'completed' || foundTask.status === 'cancelled') {
   459→          warn(`Task is already ${foundTask.status}`);
   460→          return;
   461→        }
   462→
   463→        const updatedTask: Task = {
   464→          ...foundTask,
   465→          status: 'cancelled',
   466→          closed_reason: options.reason || null,
   467→        };
   468→
   469→        await saveTask(ctx, updatedTask);
   470→        await commitIfShadow(ctx.shadow, 'task-cancel', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   471→        success(`Cancelled task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   472→      } catch (err) {
   473→        error('Failed to cancel task', err);
   474→        process.exit(1);
   475→      }
   476→    });
   477→
   478→  // kspec task delete <ref>
   479→  task
   480→    .command('delete <ref>')
   481→    .description('Delete a task permanently')
   482→    .option('--force', 'Skip confirmation')
   483→    .option('--dry-run', 'Show what would be deleted without deleting')
   484→    .action(async (ref: string, options) => {
   485→      try {
   486→        const ctx = await initContext();
   487→        const tasks = await loadAllTasks(ctx);
   488→        const items = await loadAllItems(ctx);
   489→        const index = new ReferenceIndex(tasks, items);
   490→        const foundTask = resolveTaskRef(ref, tasks, index);
   491→
   492→        const taskDisplay = `${foundTask.title} (${index.shortUlid(foundTask._ulid)})`;
   493→
   494→        if (options.dryRun) {
   495→          info(`Would delete task: ${taskDisplay}`);
   496→          console.log(`  Source file: ${foundTask._sourceFile}`);
   497→          console.log(`  Status: ${foundTask.status}`);
   498→          if (foundTask.notes.length > 0) {
   499→            console.log(`  Notes: ${foundTask.notes.length}`);
   500→          }
   501→          return;
   502→        }
   503→
   504→        // Confirm unless --force
   505→        if (!options.force) {
   506→          const readline = await import('readline');
   507→          const rl = readline.createInterface({
   508→            input: process.stdin,
   509→            output: process.stdout,
   510→          });
   511→
   512→          const answer = await new Promise<string>((resolve) => {
   513→            rl.question(`Delete task "${taskDisplay}"? [y/N] `, resolve);
   514→          });
   515→          rl.close();
   516→
   517→          if (answer.toLowerCase() !== 'y') {
   518→            info('Deletion cancelled');
   519→            return;
   520→          }
   521→        }
   522→
   523→        await deleteTask(ctx, foundTask);
   524→        await commitIfShadow(ctx.shadow, 'task-delete', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), foundTask.title);
   525→        success(`Deleted task: ${taskDisplay}`);
   526→      } catch (err) {
   527→        error('Failed to delete task', err);
   528→        process.exit(1);
   529→      }
   530→    });
   531→
   532→  // kspec task note <ref> <message>
   533→  task
   534→    .command('note <ref> <message>')
   535→    .description('Add a note to a task')
   536→    .option('--author <author>', 'Note author')
   537→    .option('--supersedes <ulid>', 'ULID of note this supersedes')
   538→    .action(async (ref: string, message: string, options) => {
   539→      try {
   540→        const ctx = await initContext();
   541→        const tasks = await loadAllTasks(ctx);
   542→        const items = await loadAllItems(ctx);
   543→        const index = new ReferenceIndex(tasks, items);
   544→        const foundTask = resolveTaskRef(ref, tasks, index);
   545→
   546→        const note = createNote(message, options.author, options.supersedes);
   547→
   548→        const updatedTask: Task = {
   549→          ...foundTask,
   550→          notes: [...foundTask.notes, note],
   551→        };
   552→
   553→        await saveTask(ctx, updatedTask);
   554→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   555→        success(`Added note to task: ${index.shortUlid(updatedTask._ulid)}`, { note });
   556→
   557→        // Proactive alignment guidance for tasks with spec_ref
   558→        if (foundTask.spec_ref) {
   559→          console.log('');
   560→          console.log('\x1b[33m--- Alignment Check ---\x1b[0m');
   561→          console.log('Did your implementation add anything beyond the original spec?');
   562→          console.log('If so, consider updating the spec:');
   563→          console.log(`  kspec item set ${foundTask.spec_ref} --description "Updated description"`);
   564→          console.log('Or add acceptance criteria for new features.');
   565→
   566→          // Check if linked spec has acceptance criteria and remind about test coverage
   567→          const specResult = index.resolve(foundTask.spec_ref);
   568→          if (specResult.ok && specResult.item) {
   569→            const specItem = specResult.item as { acceptance_criteria?: unknown[] };
   570→            if (specItem.acceptance_criteria && specItem.acceptance_criteria.length > 0) {
   571→              console.log('');
   572→              console.log(`Linked spec has ${specItem.acceptance_criteria.length} acceptance criteria - consider test coverage.`);
   573→            }
   574→          }
   575→        }
   576→      } catch (err) {
   577→        error('Failed to add note', err);
   578→        process.exit(1);
   579→      }
   580→    });
   581→
   582→  // kspec task notes <ref>
   583→  task
   584→    .command('notes <ref>')
   585→    .description('Show notes for a task')
   586→    .action(async (ref: string) => {
   587→      try {
   588→        const ctx = await initContext();
   589→        const tasks = await loadAllTasks(ctx);
   590→        const items = await loadAllItems(ctx);
   591→        const index = new ReferenceIndex(tasks, items);
   592→        const foundTask = resolveTaskRef(ref, tasks, index);
   593→
   594→        output(foundTask.notes, () => {
   595→          if (foundTask.notes.length === 0) {
   596→            console.log('No notes');
   597→          } else {
   598→            for (const note of foundTask.notes) {
   599→              const author = note.author || 'unknown';
   600→              console.log(`[${note.created_at}] ${author}:`);
   601→              console.log(note.content);
   602→              console.log('');
   603→            }
   604→          }
   605→        });
   606→      } catch (err) {
   607→        error('Failed to get notes', err);
   608→        process.exit(1);
   609→      }
   610→    });
   611→
   612→  // kspec task todos <ref>
   613→  task
   614→    .command('todos <ref>')
   615→    .description('Show todos for a task')
   616→    .action(async (ref: string) => {
   617→      try {
   618→        const ctx = await initContext();
   619→        const tasks = await loadAllTasks(ctx);
   620→        const items = await loadAllItems(ctx);
   621→        const index = new ReferenceIndex(tasks, items);
   622→        const foundTask = resolveTaskRef(ref, tasks, index);
   623→
   624→        output(foundTask.todos, () => {
   625→          if (foundTask.todos.length === 0) {
   626→            console.log('No todos');
   627→          } else {
   628→            for (const todo of foundTask.todos) {
   629→              const status = todo.done ? '[x]' : '[ ]';
   630→              const doneInfo = todo.done && todo.done_at ? ` (done ${todo.done_at})` : '';
   631→              console.log(`${status} ${todo.id}. ${todo.text}${doneInfo}`);
   632→            }
   633→          }
   634→        });
   635→      } catch (err) {
   636→        error('Failed to get todos', err);
   637→        process.exit(1);
   638→      }
   639→    });
   640→
   641→  // Create subcommand group for todo operations
   642→  const todoCmd = task
   643→    .command('todo')
   644→    .description('Manage task todos');
   645→
   646→  // kspec task todo add <ref> <text>
   647→  todoCmd
   648→    .command('add <ref> <text>')
   649→    .description('Add a todo to a task')
   650→    .option('--author <author>', 'Todo author')
   651→    .action(async (ref: string, text: string, options) => {
   652→      try {
   653→        const ctx = await initContext();
   654→        const tasks = await loadAllTasks(ctx);
   655→        const items = await loadAllItems(ctx);
   656→        const index = new ReferenceIndex(tasks, items);
   657→        const foundTask = resolveTaskRef(ref, tasks, index);
   658→
   659→        // Calculate next ID (max existing + 1, or 1 if none)
   660→        const nextId = foundTask.todos.length > 0
   661→          ? Math.max(...foundTask.todos.map(t => t.id)) + 1
   662→          : 1;
   663→
   664→        const todo = createTodo(nextId, text, options.author);
   665→
   666→        const updatedTask: Task = {
   667→          ...foundTask,
   668→          todos: [...foundTask.todos, todo],
   669→        };
   670→
   671→        await saveTask(ctx, updatedTask);
   672→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   673→        success(`Added todo #${todo.id} to task: ${index.shortUlid(updatedTask._ulid)}`, { todo });
   674→      } catch (err) {
   675→        error('Failed to add todo', err);
   676→        process.exit(1);
   677→      }
   678→    });
   679→
   680→  // kspec task todo done <ref> <id>
   681→  todoCmd
   682→    .command('done <ref> <id>')
   683→    .description('Mark a todo as done')
   684→    .action(async (ref: string, idStr: string) => {
   685→      try {
   686→        const ctx = await initContext();
   687→        const tasks = await loadAllTasks(ctx);
   688→        const items = await loadAllItems(ctx);
   689→        const index = new ReferenceIndex(tasks, items);
   690→        const foundTask = resolveTaskRef(ref, tasks, index);
   691→
   692→        const id = parseInt(idStr, 10);
   693→        if (isNaN(id)) {
   694→          error(`Invalid todo ID: ${idStr}`);
   695→          process.exit(3);
   696→        }
   697→
   698→        const todoIndex = foundTask.todos.findIndex(t => t.id === id);
   699→        if (todoIndex === -1) {
   700→          error(`Todo #${id} not found`);
   701→          process.exit(3);
   702→        }
   703→
   704→        if (foundTask.todos[todoIndex].done) {
   705→          warn(`Todo #${id} is already done`);
   706→          return;
   707→        }
   708→
   709→        const updatedTodos = [...foundTask.todos];
   710→        updatedTodos[todoIndex] = {
   711→          ...updatedTodos[todoIndex],
   712→          done: true,
   713→          done_at: new Date().toISOString(),
   714→        };
   715→
   716→        const updatedTask: Task = {
   717→          ...foundTask,
   718→          todos: updatedTodos,
   719→        };
   720→
   721→        await saveTask(ctx, updatedTask);
   722→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   723→        success(`Marked todo #${id} as done`, { todo: updatedTodos[todoIndex] });
   724→      } catch (err) {
   725→        error('Failed to mark todo as done', err);
   726→        process.exit(1);
   727→      }
   728→    });
   729→
   730→  // kspec task todo undone <ref> <id>
   731→  todoCmd
   732→    .command('undone <ref> <id>')
   733→    .description('Mark a todo as not done')
   734→    .action(async (ref: string, idStr: string) => {
   735→      try {
   736→        const ctx = await initContext();
   737→        const tasks = await loadAllTasks(ctx);
   738→        const items = await loadAllItems(ctx);
   739→        const index = new ReferenceIndex(tasks, items);
   740→        const foundTask = resolveTaskRef(ref, tasks, index);
   741→
   742→        const id = parseInt(idStr, 10);
   743→        if (isNaN(id)) {
   744→          error(`Invalid todo ID: ${idStr}`);
   745→          process.exit(3);
   746→        }
   747→
   748→        const todoIndex = foundTask.todos.findIndex(t => t.id === id);
   749→        if (todoIndex === -1) {
   750→          error(`Todo #${id} not found`);
   751→          process.exit(3);
   752→        }
   753→
   754→        if (!foundTask.todos[todoIndex].done) {
   755→          warn(`Todo #${id} is not done`);
   756→          return;
   757→        }
   758→
   759→        const updatedTodos = [...foundTask.todos];
   760→        updatedTodos[todoIndex] = {
   761→          ...updatedTodos[todoIndex],
   762→          done: false,
   763→          done_at: undefined,
   764→        };
   765→
   766→        const updatedTask: Task = {
   767→          ...foundTask,
   768→          todos: updatedTodos,
   769→        };
   770→
   771→        await saveTask(ctx, updatedTask);
   772→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   773→        success(`Marked todo #${id} as not done`, { todo: updatedTodos[todoIndex] });
   774→      } catch (err) {
   775→        error('Failed to mark todo as not done', err);
   776→        process.exit(1);
   777→      }
   778→    });
   779→}
