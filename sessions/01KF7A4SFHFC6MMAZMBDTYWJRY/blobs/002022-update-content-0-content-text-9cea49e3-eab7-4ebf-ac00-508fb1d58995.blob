     1→/**
     2→ * Integration tests for kspec meta commands
     3→ * AC: @agent-definitions ac-agent-1, ac-agent-2, ac-agent-3
     4→ * AC: @workflow-definitions ac-workflow-1, ac-workflow-2, ac-workflow-3, ac-workflow-4
     5→ */
     6→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     7→import * as fs from 'node:fs/promises';
     8→import * as path from 'node:path';
     9→import * as os from 'node:os';
    10→import { execSync } from 'node:child_process';
    11→
    12→const FIXTURES_DIR = path.join(__dirname, 'fixtures');
    13→const CLI_PATH = path.join(__dirname, '..', 'src', 'cli', 'index.ts');
    14→
    15→/**
    16→ * Run a kspec CLI command and return stdout
    17→ */
    18→function kspec(args: string, cwd: string): string {
    19→  const cmd = `npx tsx ${CLI_PATH} ${args}`;
    20→  try {
    21→    return execSync(cmd, {
    22→      cwd,
    23→      encoding: 'utf-8',
    24→      env: { ...process.env, KSPEC_AUTHOR: '@test' },
    25→    }).trim();
    26→  } catch (error: unknown) {
    27→    const execError = error as { stdout?: string; stderr?: string; message?: string };
    28→    // Return stdout even on error (some commands exit non-zero with valid output)
    29→    if (execError.stdout) return execError.stdout.trim();
    30→    throw new Error(`Command failed: ${cmd}\n${execError.stderr || execError.message}`);
    31→  }
    32→}
    33→
    34→/**
    35→ * Run kspec and return JSON output
    36→ */
    37→function kspecJson<T>(args: string, cwd: string): T {
    38→  const output = kspec(`${args} --json`, cwd);
    39→  return JSON.parse(output);
    40→}
    41→
    42→/**
    43→ * Copy fixtures to a temp directory for isolated testing
    44→ */
    45→async function setupTempFixtures(): Promise<string> {
    46→  const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-test-'));
    47→  await fs.cp(FIXTURES_DIR, tempDir, { recursive: true });
    48→  return tempDir;
    49→}
    50→
    51→/**
    52→ * Clean up temp directory
    53→ */
    54→async function cleanupTempDir(dir: string): Promise<void> {
    55→  await fs.rm(dir, { recursive: true, force: true });
    56→}
    57→
    58→describe('Integration: meta agents', () => {
    59→  let tempDir: string;
    60→
    61→  beforeEach(async () => {
    62→    tempDir = await setupTempFixtures();
    63→  });
    64→
    65→  afterEach(async () => {
    66→    await cleanupTempDir(tempDir);
    67→  });
    68→
    69→  // AC: @agent-definitions ac-agent-1
    70→  it('should output table with ID, Name, Capabilities columns', () => {
    71→    const output = kspec('meta agents', tempDir);
    72→
    73→    // Should contain table headers
    74→    expect(output).toContain('ID');
    75→    expect(output).toContain('Name');
    76→    expect(output).toContain('Capabilities');
    77→
    78→    // Should contain agent data from fixtures
    79→    expect(output).toContain('test-agent');
    80→    expect(output).toContain('Test Agent');
    81→    expect(output).toContain('code, test');
    82→
    83→    expect(output).toContain('review-agent');
    84→    expect(output).toContain('Review Agent');
    85→    expect(output).toContain('review, analyze');
    86→  });
    87→
    88→  // AC: @agent-definitions ac-agent-2
    89→  it('should output JSON array with full agent details', () => {
    90→    interface AgentJson {
    91→      id: string;
    92→      name: string;
    93→      description: string;
    94→      capabilities: string[];
    95→      tools: string[];
    96→      session_protocol: Record<string, string>;
    97→      conventions: string[];
    98→    }
    99→
   100→    const agents = kspecJson<AgentJson[]>('meta agents', tempDir);
   101→
   102→    // Should be an array (3 agents: test, test-agent, review-agent)
   103→    expect(Array.isArray(agents)).toBe(true);
   104→    expect(agents).toHaveLength(3);
   105→
   106→    // First agent
   107→    const testAgent = agents.find(a => a.id === 'test-agent');
   108→    expect(testAgent).toBeDefined();
   109→    expect(testAgent?.name).toBe('Test Agent');
   110→    expect(testAgent?.description).toBe('A test agent for integration testing');
   111→    expect(testAgent?.capabilities).toEqual(['code', 'test']);
   112→    expect(testAgent?.tools).toEqual(['kspec', 'git']);
   113→    expect(testAgent?.session_protocol).toEqual({
   114→      start: 'kspec session start',
   115→      checkpoint: 'kspec session checkpoint',
   116→    });
   117→    expect(testAgent?.conventions).toEqual([
   118→      'Test convention 1',
   119→      'Test convention 2',
   120→    ]);
   121→
   122→    // Second agent
   123→    const reviewAgent = agents.find(a => a.id === 'review-agent');
   124→    expect(reviewAgent).toBeDefined();
   125→    expect(reviewAgent?.name).toBe('Review Agent');
   126→    expect(reviewAgent?.capabilities).toEqual(['review', 'analyze']);
   127→    expect(reviewAgent?.tools).toEqual(['kspec']);
   128→  });
   129→
   130→  it('should handle empty agents list gracefully', async () => {
   131→    // Create a meta manifest with no agents
   132→    const emptyMetaPath = path.join(tempDir, 'kynetic.meta.yaml');
   133→    await fs.writeFile(emptyMetaPath, 'kynetic_meta: "1.0"\nagents: []\n');
   134→
   135→    const output = kspec('meta agents', tempDir);
   136→    expect(output).toContain('No agents defined');
   137→  });
   138→
   139→  it('should handle missing meta manifest gracefully', async () => {
   140→    // Remove meta manifest file entirely
   141→    const metaPath = path.join(tempDir, 'kynetic.meta.yaml');
   142→    await fs.rm(metaPath, { force: true });
   143→
   144→    // Also remove reference from kynetic.yaml
   145→    const manifestPath = path.join(tempDir, 'kynetic.yaml');
   146→    let content = await fs.readFile(manifestPath, 'utf-8');
   147→    content = content.replace('meta_file: kynetic.meta.yaml\n', '');
   148→    await fs.writeFile(manifestPath, content);
   149→
   150→    const output = kspec('meta agents', tempDir);
   151→    // Should show empty result, not crash
   152→    expect(output).toContain('No agents defined');
   153→  });
