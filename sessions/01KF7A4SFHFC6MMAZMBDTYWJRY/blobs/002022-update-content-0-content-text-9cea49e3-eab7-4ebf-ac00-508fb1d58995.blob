   155→  // AC: @agent-definitions ac-agent-3
   156→  it('should validate agent references in notes', async () => {
   157→    // Add a task with a note that references a valid agent
   158→    const tasksPath = path.join(tempDir, 'project.tasks.yaml');
   159→    let tasksContent = await fs.readFile(tasksPath, 'utf-8');
   160→
   161→    // Add a task with a note containing a valid agent reference
   162→    const newTask = `
   163→  - _ulid: 01KF79C0H1ZHT2T4JMECS89ARS
   164→    title: Test task with agent reference in note
   165→    status: pending
   166→    priority: 1
   167→    created_at: "2024-01-01T00:00:00Z"
   168→    slugs:
   169→      - test-task-with-agent
   170→    depends_on: []
   171→    notes:
   172→      - _ulid: 01KF79C0H1ZHT2T4JMECS89AR1
   173→        created_at: "2024-01-01T00:00:00Z"
   174→        author: "@test-agent"
   175→        content: A note from a valid agent
   176→    todos: []
   177→    blocked_by: []
   178→    tags: []
   179→`;
   180→    tasksContent = tasksContent.replace('tasks:', `tasks:${newTask}`);
   181→    await fs.writeFile(tasksPath, tasksContent);
   182→
   183→    // Validate should pass because test-agent exists
   184→    const output = kspec('validate --refs', tempDir);
   185→    expect(output).toContain('References: OK');
   186→  });
   187→
   188→  // AC: @agent-definitions ac-agent-3
   189→  it('should error on invalid agent reference in notes', async () => {
   190→    // Add a task with a note that references a non-existent agent
   191→    const tasksPath = path.join(tempDir, 'project.tasks.yaml');
   192→    let tasksContent = await fs.readFile(tasksPath, 'utf-8');
   193→
   194→    const newTask = `
   195→  - _ulid: 01KF79C0H1C6H77ZSGMMVJF994
   196→    title: Test task with invalid agent reference
   197→    status: pending
   198→    priority: 1
   199→    created_at: "2024-01-01T00:00:00Z"
   200→    slugs:
   201→      - test-task-invalid-agent
   202→    depends_on: []
   203→    notes:
   204→      - _ulid: 01KF79C0H1C6H77ZSGMMVJF991
   205→        created_at: "2024-01-01T00:00:00Z"
   206→        author: "@nonexistent-agent"
   207→        content: A note from an invalid agent
   208→    todos: []
   209→    blocked_by: []
   210→    tags: []
   211→`;
   212→    tasksContent = tasksContent.replace('tasks:', `tasks:${newTask}`);
   213→    await fs.writeFile(tasksPath, tasksContent);
   214→
   215→    // Validation should fail with reference error
   216→    // kspec() returns stdout even on failure, so we get the output
   217→    const output = kspec('validate --refs', tempDir);
   218→    expect(output).toContain('✗ Validation failed');
   219→    expect(output).toContain('Reference "@nonexistent-agent" not found');
   220→    expect(output).toContain('author');
   221→  });
   222→});
