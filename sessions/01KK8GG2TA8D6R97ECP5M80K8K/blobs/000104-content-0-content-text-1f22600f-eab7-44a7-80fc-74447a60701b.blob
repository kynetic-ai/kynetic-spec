```
     1→/**
     2→ * Enhanced setup command for kspec agent integration.
     3→ *
     4→ * Orchestrates the full onboarding pipeline:
     5→ * - Detect agent environment (Claude Code, Cline, etc.)
     6→ * - Install hooks (UserPromptSubmit, Stop, PreToolUse guards)
     7→ * - Render skills from .kspec/skills/ to .claude/skills/
     8→ * - Generate kspec-agents.md
     9→ *
    10→ * AC: @enhanced-setup ac-1 - summary displayed listing each step performed
    11→ * AC: @enhanced-setup ac-2 - all hook entries (UserPromptSubmit, Stop, PreToolUse) present
    12→ * AC: @enhanced-setup ac-3 - rendered skill files exist for each skill targeting claude-code
    13→ * AC: @enhanced-setup ac-4 - kspec-agents.md exists after setup
    14→ * AC: @enhanced-setup ac-5 - --skip-skills flag skips skill rendering
    15→ * AC: @enhanced-setup ac-6 - --dry-run displays planned actions without changes
    16→ * AC: @enhanced-setup ac-7 - --status reports current state including agent detected
    17→ * AC: @enhanced-setup ac-8 - --status shows hooks status, skills rendered count, agents.md freshness
    18→ * AC: @enhanced-setup ac-9 - skills referenced by ralph (task-work, reflect) are present
    19→ */
    20→
    21→import * as fs from "node:fs/promises";
    22→import { existsSync } from "node:fs";
    23→import * as os from "node:os";
    24→import * as path from "node:path";
    25→import * as readline from "node:readline/promises";
    26→import chalk from "chalk";
    27→import type { Command } from "commander";
    28→import {
    29→  getGitRoot,
    30→  getShadowStatus,
    31→  repairShadow,
    32→  SHADOW_BRANCH_NAME,
    33→  SESSIONS_WORKTREE_DIR,
    34→  ensureSessionsGitignore,
    35→  ensureShadowSessionsGitignore,
    36→  needsSessionsGitignore,
    37→  needsShadowSessionsGitignore,
    38→} from "../../parser/shadow.js";
    39→import {
    40→  detectAgentFromEnv,
    41→  type AgentConfidence,
    42→} from "../../parser/agent-detection.js";
    43→import { errors } from "../../strings/index.js";
    44→import { EXIT_CODES } from "../exit-codes.js";
    45→import { error, output, success, warn } from "../output.js";
    46→
    47→/**
    48→ * Log a message at debug level (only when KSPEC_DEBUG=1)
    49→ * AC: @setup-pipeline-unification ac-4
    50→ */
    51→function debugLog(message: string, detail?: unknown): void {
    52→  if (process.env.KSPEC_DEBUG === "1") {
    53→    if (detail) {
    54→      console.error(`[DEBUG] setup: ${message}`, detail);
    55→    } else {
    56→      console.error(`[DEBUG] setup: ${message}`);
    57→    }
    58→  }
    59→}
    60→
    61→/**
    62→ * Supported agent types for auto-configuration
    63→ */
    64→export type AgentType =
    65→  | "claude-code"
    66→  | "cline"
    67→  | "roo-code"
    68→  | "copilot-cli"
    69→  | "gemini-cli"
    70→  | "codex-cli"
    71→  | "aider"
    72→  | "opencode"
    73→  | "amp"
    74→  | "cursor"
    75→  | "windsurf"
    76→  | "unknown";
    77→
    78→/**
    79→ * Result of agent detection
    80→ */
    81→export interface DetectedAgent {
    82→  type: AgentType;
    83→  confidence: AgentConfidence;
    84→  configPath?: string;
    85→  envVars?: Record<string, string>;
    86→}
    87→
    88→const SETUP_AGENT_OVERRIDES = [
    89→  "claude-code",
    90→  "cline",
    91→  "cursor",
    92→  "windsurf",
    93→  "unknown",
    94→] as const;
    95→
    96→type SetupAgentOverride = (typeof SETUP_AGENT_OVERRIDES)[number];
    97→
    98→function parseSetupAgentOverride(value: string): SetupAgentOverride {
    99→  const normalized = value.trim().toLowerCase();
   100→  if (
   101→    (SETUP_AGENT_OVERRIDES as readonly string[]).includes(normalized)
   102→  ) {
   103→    return normalized as SetupAgentOverride;
   104→  }
   105→
   106→  const allowed = SETUP_AGENT_OVERRIDES.join(", ");
   107→  throw new Error(
   108→    `Invalid --agent value "${value}". Supported values: ${allowed}`,
   109→  );
   110→}
   111→
   112→function buildDetectedAgent(type: AgentType): DetectedAgent {
   113→  if (type === "claude-code") {
   114→    return {
   115→      type,
   116→      confidence: "high",
   117→      configPath: path.join(os.homedir(), ".claude", "settings.json"),
   118→    };
   119→  }
   120→  return { type, confidence: "high" };
   121→}
   122→
   123→/**
   124→ * Detect which agent environment we're running in.
   125→ * Returns the detected agent type and confidence level.
   126→ *
   127→ * Detection priority matters - more specific markers checked first.
   128→ */
   129→export function detectAgent(): DetectedAgent {
   130→  const detected = detectAgentFromEnv();
   131→  if (detected.type !== "unknown") {
   132→    return detected;
   133→  }
   134→
   135→  // Fallback for non-interactive contexts where env markers may be absent.
   136→  if (existsSync(path.join(os.homedir(), ".claude"))) {
   137→    return {
   138→      type: "claude-code",
   139→      confidence: "low",
   140→      configPath: path.join(os.homedir(), ".claude", "settings.json"),
   141→    };
   142→  }
   143→
   144→  return detected;
   145→}
   146→
   147→/**
   148→ * Install KSPEC_AUTHOR config for Claude Code (global settings)
   149→ */
   150→async function installClaudeCodeConfig(author: string): Promise<boolean> {
   151→  const configPath = path.join(os.homedir(), ".claude", "settings.json");
   152→  const configDir = path.dirname(configPath);
   153→
   154→  try {
   155→    // Ensure directory exists
   156→    await fs.mkdir(configDir, { recursive: true });
   157→
   158→    // Read existing config or start fresh
   159→    let config: Record<string, unknown> = {};
   160→    try {
   161→      const existing = await fs.readFile(configPath, "utf-8");
   162→      config = JSON.parse(existing);
   163→    } catch (err) {
   164→      debugLog("No existing Claude Code config, starting fresh", err);
   165→    }
   166→
   167→    // Merge env settings
   168→    const env = (config.env as Record<string, string>) || {};
   169→    env.KSPEC_AUTHOR = author;
   170→    config.env = env;
   171→
   172→    // Write back
   173→    await fs.writeFile(
   174→      configPath,
   175→      `${JSON.stringify(config, null, 2)}\n`,
   176→      "utf-8",
   177→    );
   178→    return true;
   179→  } catch (err) {
   180→    debugLog("Failed to install Claude Code config", err);
   181→    return false;
   182→  }
   183→}
   184→
   185→/**
   186→ * Result of installing hooks
   187→ * AC: @enhanced-setup ac-2 - tracks all hook types
   188→ */
   189→export interface HooksInstallResult {
   190→  promptCheck: boolean;
   191→  stop: boolean;
   192→  preToolUse: boolean;
   193→  guardsCreated: string[];
   194→}
   195→
   196→/**
   197→ * Native guard command for PreToolUse hooks.
   198→ * Replaces bash shell scripts with `kspec guard worktree`.
   199→ *
   200→ * AC: @native-guard-commands ac-setup-native - references kspec guard worktree
   201→ */
   202→const NATIVE_GUARD_COMMAND = "kspec guard worktree";
   203→
   204→/**
   205→ * Old bash script filenames that should be migrated to native commands.
   206→ * AC: @native-guard-commands ac-migrate-hooks
   207→ */
   208→const OLD_GUARD_SCRIPTS = [
   209→  "kspec-worktree-guard.sh",
   210→  "ralph-task-limit-guard.sh",
   211→];
   212→
   213→/**
   214→ * Install hooks to project-level Claude Code settings (.claude/settings.json)
   215→ * AC: @enhanced-setup ac-2 - all hook entries present
   216→ */
   217→async function installClaudeCodeHooks(
   218→  projectDir: string,
   219→  dryRun = false,
   220→): Promise<HooksInstallResult> {
   221→  const configPath = path.join(projectDir, ".claude", "settings.json");
   222→  const configDir = path.dirname(configPath);
   223→  const hooksDir = path.join(projectDir, ".claude", "hooks");
   224→
   225→  const result: HooksInstallResult = {
   226→    promptCheck: false,
   227→    stop: false,
   228→    preToolUse: false,
   229→    guardsCreated: [],
   230→  };
   231→
   232→  try {
   233→    // Ensure directories exist
   234→    if (!dryRun) {
   235→      await fs.mkdir(configDir, { recursive: true });
   236→      await fs.mkdir(hooksDir, { recursive: true });
   237→    }
   238→
   239→    // Read existing config or start fresh
   240→    let config: Record<string, unknown> = {};
   241→    try {
   242→      const existing = await fs.readFile(configPath, "utf-8");
   243→      config = JSON.parse(existing);
   244→    } catch (err) {
   245→      debugLog("No existing hooks config, starting fresh", err);
   246→    }
   247→
   248→    // Get or create hooks object
   249→    const hooks = (config.hooks as Record<string, unknown[]>) || {};
   250→
   251→    // Install UserPromptSubmit hook (spec-first reminder)
   252→    const promptCheckCommand = "kspec session prompt-check";
   253→    const existingPromptHooks = hooks.UserPromptSubmit as
   254→      | Array<{ hooks?: Array<{ command?: string }> }>
   255→      | undefined;
   256→    const promptAlreadyInstalled = existingPromptHooks?.some((entry) =>
   257→      entry.hooks?.some((hook) =>
   258→        hook.command?.includes("session prompt-check"),
   259→      ),
   260→    );
   261→
   262→    if (!promptAlreadyInstalled) {
   263→      hooks.UserPromptSubmit = [
   264→        ...(existingPromptHooks || []),
   265→        {
   266→          hooks: [
   267→            {
   268→              type: "command",
   269→              command: promptCheckCommand,
   270→            },
   271→          ],
   272→        },
   273→      ];
   274→      result.promptCheck = true;
   275→    } else {
   276→      result.promptCheck = true; // Already configured
   277→    }
   278→
   279→    // Install Stop hook (checkpoint)
   280→    const stopHookCommand = "kspec session checkpoint --json";
   281→    const existingStopHooks = hooks.Stop as
   282→      | Array<{ matcher?: string; hooks?: Array<{ command?: string }> }>
   283→      | undefined;
   284→    const stopAlreadyInstalled = existingStopHooks?.some((entry) =>
   285→      entry.hooks?.some((hook) => hook.command?.includes("session checkpoint")),
   286→    );
   287→
   288→    if (!stopAlreadyInstalled) {
   289→      hooks.Stop = [
   290→        ...(existingStopHooks || []),
   291→        {
   292→          matcher: "",
   293→          hooks: [
   294→            {
   295→              type: "command",
   296→              command: stopHookCommand,
   297→            },
   298→          ],
   299→        },
   300→      ];
   301→      result.stop = true;
   302→    } else {
   303→      result.stop = true; // Already configured
   304→    }
   305→
   306→    // AC: @enhanced-setup ac-2 - Install PreToolUse hooks with guards
   307→    // AC: @native-guard-commands ac-setup-native - use native kspec guard worktree
   308→    // AC: @native-guard-commands ac-no-task-limit-hook - no task-limit guard
   309→    // AC: @native-guard-commands ac-migrate-hooks - replace old bash script entries
   310→    // AC: @native-guard-commands ac-idempotent - no duplicate entries
   311→    const existingPreToolUseHooks = hooks.PreToolUse as
   312→      | Array<{ matcher?: string; hooks?: Array<{ type?: string; command?: string }> }>
   313→      | undefined;
   314→
   315→    // Check if native guard command is already installed
   316→    const nativeAlreadyInstalled = existingPreToolUseHooks?.some((entry) =>
   317→      entry.hooks?.some((hook) => hook.command === NATIVE_GUARD_COMMAND),
   318→    );
   319→
   320→    // Check for old bash script entries that need migration
   321→    const hasOldScripts = existingPreToolUseHooks?.some((entry) =>
   322→      entry.hooks?.some((hook) =>
   323→        OLD_GUARD_SCRIPTS.some(
   324→          (name) => hook.command?.includes(name),
   325→        ),
   326→      ),
   327→    );
   328→
   329→    if (hasOldScripts || !nativeAlreadyInstalled) {
   330→      // Remove any PreToolUse entries that reference old bash scripts
   331→      // AC: @native-guard-commands ac-migrate-hooks
   332→      let filteredPreToolUse = (existingPreToolUseHooks || []).map((entry) => ({
   333→        ...entry,
   334→        hooks: entry.hooks?.filter(
   335→          (hook) =>
   336→            !OLD_GUARD_SCRIPTS.some((name) => hook.command?.includes(name)),
   337→        ),
   338→      }));
   339→      // Remove entries with empty hooks arrays
   340→      filteredPreToolUse = filteredPreToolUse.filter(
   341→        (entry) => entry.hooks && entry.hooks.length > 0,
   342→      );
   343→
   344→      // Add native guard command if not already present
   345→      if (!nativeAlreadyInstalled) {
   346→        filteredPreToolUse.push({
   347→          matcher: "Bash",
   348→          hooks: [
   349→            {
   350→              type: "command",
   351→              command: NATIVE_GUARD_COMMAND,
   352→            },
   353→          ],
   354→        });
   355→      }
   356→
   357→      hooks.PreToolUse = filteredPreToolUse;
   358→      result.preToolUse = true;
   359→
   360→      // Delete old bash script files
   361→      // AC: @native-guard-commands ac-migrate-hooks - delete old files
   362→      if (!dryRun) {
   363→        for (const name of OLD_GUARD_SCRIPTS) {
   364→          const scriptPath = path.join(hooksDir, name);
   365→          try {
   366→            await fs.unlink(scriptPath);
   367→            result.guardsCreated.push(`deleted:${name}`);
   368→          } catch (err) {
   369→            debugLog(`Could not delete old guard script ${name}`, err);
   370→          }
   371→        }
   372→      }
   373→    } else {
   374→      result.preToolUse = true; // Already configured with native command
   375→    }
   376→
   377→    config.hooks = hooks;
   378→
   379→    // Write back
   380→    if (!dryRun) {
   381→      await fs.writeFile(
   382→        configPath,
   383→        `${JSON.stringify(config, null, 2)}\n`,
   384→        "utf-8",
   385→      );
   386→    }
   387→    return result;
   388→  } catch (err) {
   389→    debugLog("installClaudeCodeHooks failed", err);
   390→    return result;
   391→  }
   392→}
   393→
   394→/**
   395→ * Install KSPEC_AUTHOR config for Aider (.aider.conf.yml)
   396→ * Aider uses `set-env:` for environment variables in list format
   397→ */
   398→async function installAiderConfig(author: string): Promise<boolean> {
   399→  const configPath = path.join(os.homedir(), ".aider.conf.yml");
   400→
   401→  try {
   402→    let content = "";
   403→    try {
   404→      content = await fs.readFile(configPath, "utf-8");
   405→    } catch (err) {
   406→      debugLog("No existing Aider config, starting fresh", err);
   407→    }
   408→
   409→    // Check if KSPEC_AUTHOR is already set
   410→    if (content.includes("KSPEC_AUTHOR")) {
   411→      // Replace existing value (handles both old and new format)
   412→      content = content.replace(
   413→        /^(\s*-?\s*KSPEC_AUTHOR\s*[=:]\s*).*$/m,
   414→        `  - KSPEC_AUTHOR=${author}`,
   415→      );
   416→    } else {
   417→      // Add to set-env section or create it
   418→      if (content.includes("set-env:")) {
   419→        // Append to existing set-env section
   420→        content = content.replace(
   421→          /(set-env:\s*\n)/m,
   422→          `$1  - KSPEC_AUTHOR=${author}\n`,
   423→        );
   424→      } else {
   425→        // Add new set-env section
   426→        content += `\n# kspec author for note attribution\nset-env:\n  - KSPEC_AUTHOR=${author}\n`;
   427→      }
   428→    }
   429→
   430→    await fs.writeFile(configPath, content, "utf-8");
   431→    return true;
   432→  } catch (err) {
   433→    debugLog("installAiderConfig failed", err);
   434→    return false;
   435→  }
   436→}
   437→
   438→/**
   439→ * Install KSPEC_AUTHOR for generic JSON config files
   440→ */
   441→async function installGenericJsonConfig(
   442→  configPath: string,
   443→  author: string,
   444→): Promise<boolean> {
   445→  try {
   446→    const configDir = path.dirname(configPath);
   447→    await fs.mkdir(configDir, { recursive: true });
   448→
   449→    let config: Record<string, unknown> = {};
   450→    try {
   451→      const existing = await fs.readFile(configPath, "utf-8");
   452→      config = JSON.parse(existing);
   453→    } catch (err) {
   454→      debugLog(`No existing config at ${configPath}, starting fresh`, err);
   455→    }
   456→
   457→    const env = (config.env as Record<string, string>) || {};
   458→    env.KSPEC_AUTHOR = author;
   459→    config.env = env;
   460→
   461→    await fs.writeFile(
   462→      configPath,
   463→      `${JSON.stringify(config, null, 2)}\n`,
   464→      "utf-8",
   465→    );
   466→    return true;
   467→  } catch (err) {
   468→    debugLog(`installGenericJsonConfig failed for ${configPath}`, err);
   469→    return false;
   470→  }
   471→}
   472→
   473→/**
   474→ * Get default author value for an agent type
   475→ */
   476→function getDefaultAuthor(agentType: AgentType): string {
   477→  switch (agentType) {
   478→    case "claude-code":
   479→      return "@claude";
   480→    case "cline":
   481→      return "@cline";
   482→    case "roo-code":
   483→      return "@roo";
   484→    case "copilot-cli":
   485→      return "@copilot";
   486→    case "gemini-cli":
   487→      return "@gemini";
   488→    case "codex-cli":
   489→      return "@codex";
   490→    case "aider":
   491→      return "@aider";
   492→    case "opencode":
   493→      return "@opencode";
   494→    case "amp":
   495→      return "@amp";
   496→    default:
   497→      return "@agent";
   498→  }
   499→}
   500→
   501→/**
   502→ * Prompt user for input with Y/N answer
   503→ */
   504→async function promptYesNo(question: string): Promise<boolean> {
   505→  const rl = readline.createInterface({
   506→    input: process.stdin,
   507→    output: process.stdout,
   508→  });
   509→
   510→  try {
   511→    const answer = await rl.question(`${question} `);
   512→    return answer.toLowerCase() === "y";
   513→  } finally {
   514→    rl.close();
   515→  }
   516→}
   517→
   518→/**
   519→ * Ensure .kspec worktree exists if kspec-meta branch is present.
   520→ * AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
   521→ *
   522→ * @param autoWorktree If true, automatically create worktree without prompting
   523→ * @returns true if worktree is ready to use
   524→ */
   525→async function ensureWorktree(autoWorktree: boolean): Promise<boolean> {
   526→  const projectRoot = getGitRoot(process.cwd());
   527→  if (!projectRoot) {
   528→    // Not in a git repo, skip worktree check
   529→    return true;
   530→  }
   531→
   532→  const status = await getShadowStatus(projectRoot);
   533→
   534→  // AC: worktree-already-exists - if already valid, skip
   535→  if (status.healthy) {
   536→    return true;
   537→  }
   538→
   539→  // AC: detect-existing-repo - branch exists but worktree doesn't
   540→  if (status.branchExists && !status.worktreeExists) {
   541→    // AC: auto-worktree-flag - auto-create if flag set
   542→    if (autoWorktree) {
   543→      console.log(
   544→        `Detected ${SHADOW_BRANCH_NAME} branch without .kspec worktree. Creating...`,
   545→      );
   546→      const result = await repairShadow(projectRoot);
   547→      if (result.success) {
   548→        success("Created .kspec worktree");
   549→        return true;
   550→      } else {
   551→        error(`Failed to create worktree: ${result.error}`);
   552→        return false;
   553→      }
   554→    }
   555→
   556→    // AC: detect-existing-repo - prompt user
   557→    const shouldCreate = await promptYesNo(
   558→      `${SHADOW_BRANCH_NAME} branch exists but .kspec worktree is missing. Create it? (y/N)`,
   559→    );
   560→
   561→    if (shouldCreate) {
   562→      console.log("Creating .kspec worktree...");
   563→      const result = await repairShadow(projectRoot);
   564→      if (result.success) {
   565→        success("Created .kspec worktree");
   566→        return true;
   567→      } else {
   568→        error(`Failed to create worktree: ${result.error}`);
   569→        return false;
   570→      }
   571→    } else {
   572→      warn("Skipping worktree creation");
   573→      return false;
   574→    }
   575→  }
   576→
   577→  // No kspec-meta branch, or already healthy
   578→  return true;
   579→}
   580→
   581→/**
   582→ * Print manual setup instructions
   583→ */
   584→function printManualInstructions(agentType: AgentType): void {
   585→  const author = getDefaultAuthor(agentType);
   586→
   587→  console.log("\nManual setup instructions:\n");
   588→
   589→  switch (agentType) {
   590→    case "claude-code":
   591→      console.log("Add to ~/.claude/settings.json:");
   592→      console.log("```json");
   593→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   594→      console.log("```");
   595→      break;
   596→
   597→    case "cline":
   598→    case "roo-code":
   599→      console.log("Add to your shell profile (~/.bashrc, ~/.zshrc):");
   600→      console.log("```bash");
   601→      console.log(`export KSPEC_AUTHOR="${author}"`);
   602→      console.log("```");
   603→      console.log(
   604→        "\nThis will be inherited by terminals spawned by the VS Code extension.",
   605→      );
   606→      break;
   607→
   608→    case "copilot-cli":
   609→      console.log("Add to ~/.copilot/config.json:");
   610→      console.log("```json");
   611→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   612→      console.log("```");
   613→      break;
   614→
   615→    case "aider":
   616→      console.log("Add to ~/.aider.conf.yml:");
   617→      console.log("```yaml");
   618→      console.log("set-env:");
   619→      console.log(`  - KSPEC_AUTHOR=${author}`);
   620→      console.log("```");
   621→      break;
   622→
   623→    case "codex-cli":
   624→      console.log("Add to ~/.codex/config.toml:");
   625→      console.log("```toml");
   626→      console.log("[shell_environment_policy]");
   627→      console.log(`set = { KSPEC_AUTHOR = "${author}" }`);
   628→      console.log("```");
   629→      break;
   630→
   631→    case "opencode":
   632→      console.log("Add to ~/.config/opencode/opencode.json:");
   633→      console.log("```json");
   634→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   635→      console.log("```");
   636→      break;
   637→
   638→    case "amp":
   639→      console.log("Add to ~/.config/amp/settings.json:");
   640→      console.log("```json");
   641→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   642→      console.log("```");
   643→      break;
   644→
   645→    default:
   646→      console.log("Set the KSPEC_AUTHOR environment variable:");
   647→      console.log("```bash");
   648→      console.log(`export KSPEC_AUTHOR="${author}"`);
   649→      console.log("```");
   650→      console.log("\nOr add to your shell profile (~/.bashrc, ~/.zshrc, etc.)");
   651→  }
   652→}
   653→
   654→/**
   655→ * Result of a setup step
   656→ */
   657→interface SetupStepResult {
   658→  name: string;
   659→  status: "done" | "skipped" | "failed";
   660→  message?: string;
   661→  details?: Record<string, unknown>;
   662→}
   663→
   664→/**
   665→ * Result of running the setup pipeline
   666→ * Used by both the setup command and init --setup
   667→ * AC: @init-setup-integration ac-2, ac-3
   668→ */
   669→export interface SetupPipelineResult {
   670→  success: boolean;
   671→  steps: SetupStepResult[];
   672→  coreSkillsInstalled: number;
   673→  skillsRendered: number;
   674→  hooksInstalled: boolean;
   675→  agentsMdGenerated: boolean;
   676→  permissionsSeeded: boolean;
   677→  memorySeeded: boolean;
   678→}
   679→
   680→/**
   681→ * Options for running the setup pipeline
   682→ */
   683→export interface SetupPipelineOptions {
   684→  dryRun?: boolean;
   685→  skipSkills?: boolean;
   686→  installHooks?: boolean;
   687→  force?: boolean;
   688→  /** Explicit agent override (bypasses auto-detection) */
   689→  agent?: SetupAgentOverride;
   690→  /** Custom author string (overrides auto-detected default) */
   691→  author?: string;
   692→  /** Whether to configure author (only in command handler, not init) */
   693→  configureAuthor?: boolean;
   694→}
   695→
   696→/**
   697→ * Status of the setup state
   698→ * AC: @enhanced-setup ac-7, ac-8 - status reporting
   699→ */
   700→interface SetupStatus {
   701→  agent: {
   702→    detected: AgentType;
   703→    confidence: "high" | "medium" | "low";
   704→  };
   705→  hooks: {
   706→    promptCheck: boolean;
   707→    stop: boolean;
   708→    preToolUse: boolean;
   709→    guardsPresent: string[];
   710→  };
   711→  skills: {
   712→    total: number;
   713→    rendered: number;
   714→    drifted: number;
   715→  };
   716→  plugin: {
   717→    marketplaceRegistered: boolean;
   718→    marketplaceHealthy: boolean;
   719→    pluginEnabled: boolean;
   720→    registeredPath?: string;
   721→    healthMessage?: string;
   722→  };
   723→  agentsMd: {
   724→    exists: boolean;
   725→    // AC: @doctor-command ac-staleness-unknown — includes "unknown" for indeterminate cases
   726→    status: "current" | "stale" | "missing" | "unknown";
   727→    generatedAt?: string;
   728→  };
   729→  seeding: {
   730→    permissionsSeeded: boolean;
   731→    memorySeeded: boolean;
   732→    memoryPath?: string;
   733→  };
   734→}
   735→
   736→/**
   737→ * Check the current setup status
   738→ * AC: @enhanced-setup ac-7, ac-8
   739→ */
   740→async function getSetupStatus(
   741→  projectDir: string,
   742→  agentOverride?: SetupAgentOverride,
   743→): Promise<SetupStatus> {
   744→  const detected = agentOverride
   745→    ? buildDetectedAgent(agentOverride)
   746→    : detectAgent();
   747→  const configPath = path.join(projectDir, ".claude", "settings.json");
   748→  const hooksDir = path.join(projectDir, ".claude", "hooks");
   749→  const agentsMdPath = path.join(projectDir, "kspec-agents.md");
   750→  const hashPath = path.join(projectDir, ".kspec", ".kspec-agents-hash");
   751→  const skillsDir = path.join(projectDir, ".claude", "skills");
   752→
   753→  // Check hooks
   754→  const hooks = {
   755→    promptCheck: false,
   756→    stop: false,
   757→    preToolUse: false,
   758→    guardsPresent: [] as string[],
   759→  };
   760→
   761→  try {
   762→    const configContent = await fs.readFile(configPath, "utf-8");
   763→    const config = JSON.parse(configContent);
   764→    const hooksConfig = config.hooks || {};
   765→
   766→    // Check UserPromptSubmit
   767→    const promptHooks = hooksConfig.UserPromptSubmit as Array<{
   768→      hooks?: Array<{ command?: string }>;
   769→    }> | undefined;
   770→    hooks.promptCheck = promptHooks?.some((entry) =>
   771→      entry.hooks?.some((h) => h.command?.includes("prompt-check")),
   772→    ) ?? false;
   773→
   774→    // Check Stop
   775→    const stopHooks = hooksConfig.Stop as Array<{
   776→      hooks?: Array<{ command?: string }>;
   777→    }> | undefined;
   778→    hooks.stop = stopHooks?.some((entry) =>
   779→      entry.hooks?.some((h) => h.command?.includes("checkpoint")),
   780→    ) ?? false;
   781→
   782→    // Check PreToolUse — look for native kspec guard worktree command
   783→    const preToolUseHooks = hooksConfig.PreToolUse as Array<{
   784→      hooks?: Array<{ command?: string }>;
   785→    }> | undefined;
   786→    hooks.preToolUse = preToolUseHooks?.some((entry) =>
   787→      entry.hooks?.some((h) =>
   788→        h.command === NATIVE_GUARD_COMMAND || h.command?.includes(".claude/hooks/"),
   789→      ),
   790→    ) ?? false;
   791→
   792→    // Check for native guard command
   793→    if (preToolUseHooks?.some((entry) =>
   794→      entry.hooks?.some((h) => h.command === NATIVE_GUARD_COMMAND),
   795→    )) {
   796→      hooks.guardsPresent.push("kspec guard worktree");
   797→    }
   798→    // Check for legacy bash scripts still present
   799→    if (preToolUseHooks?.some((entry) =>
   800→      entry.hooks?.some((h) =>
   801→        OLD_GUARD_SCRIPTS.some((name) => h.command?.includes(name)),
   802→      ),
   803→    )) {
   804→      hooks.guardsPresent.push("legacy:bash-scripts");
   805→    }
   806→  } catch (err) {
   807→    debugLog("Failed to read hooks config for status", err);
   808→  }
   809→
   810→  // Check for legacy guard script files on disk
   811→  try {
   812→    const guardFiles = await fs.readdir(hooksDir);
   813→    for (const name of OLD_GUARD_SCRIPTS) {
   814→      if (guardFiles.includes(name)) {
   815→        hooks.guardsPresent.push(`legacy-file:${name}`);
   816→      }
   817→    }
   818→  } catch (err) {
   819→    debugLog("Hooks dir doesn't exist", err);
   820→  }
   821→
   822→  // Check skills
   823→  const skills = {
   824→    total: 0,
   825→    rendered: 0,
   826→    drifted: 0,
   827→  };
   828→
   829→  // Helper to scan a directory for skill subdirs with kspec-managed SKILL.md
   830→  async function scanForSkills(baseDir: string): Promise<void> {
   831→    try {
   832→      const dirs = await fs.readdir(baseDir, { withFileTypes: true });
   833→      for (const dir of dirs) {
   834→        if (dir.isDirectory()) {
   835→          const skillMdPath = path.join(baseDir, dir.name, "SKILL.md");
   836→          try {
   837→            const content = await fs.readFile(skillMdPath, "utf-8");
   838→            if (content.includes("<!-- kspec-managed -->")) {
   839→              skills.total++;
   840→              skills.rendered++;
   841→            }
   842→          } catch (_noSkillMd) {
   843→            // No SKILL.md
   844→          }
   845→        }
   846→      }
   847→    } catch (_notReadable) {
   848→      // Directory doesn't exist
   849→    }
   850→  }
   851→
   852→  // Scan .claude/skills/ (project/local skills)
   853→  await scanForSkills(skillsDir);
   854→
   855→  // Check plugin marketplace health
   856→  // AC: @enhanced-setup ac-7, ac-8
   857→  const plugin: SetupStatus["plugin"] = {
   858→    marketplaceRegistered: false,
   859→    marketplaceHealthy: false,
   860→    pluginEnabled: false,
   861→  };
   862→
   863→  try {
   864→    const { checkMarketplaceHealth } = await import(
   865→      "../../lib/claude-plugin-registry.js"
   866→    );
   867→    const health = await checkMarketplaceHealth();
   868→    plugin.marketplaceRegistered = health.status !== "missing";
   869→    plugin.marketplaceHealthy = health.status === "healthy";
   870→    plugin.registeredPath = health.registeredPath;
   871→    plugin.healthMessage = health.message;
   872→  } catch (err) {
   873→    debugLog("Could not check marketplace health", err);
   874→    plugin.healthMessage = "Health check unavailable";
   875→  }
   876→
   877→  // Check if plugin is enabled in project settings
   878→  try {
   879→    const configContent = await fs.readFile(configPath, "utf-8");
   880→    const config = JSON.parse(configContent);
   881→    plugin.pluginEnabled = config.enabledPlugins?.["kspec@kspec-plugins"] === true;
   882→  } catch (err) {
   883→    debugLog("Could not check plugin enablement", err);
   884→  }
   885→
   886→  // Check agents.md
   887→  const agentsMd: SetupStatus["agentsMd"] = {
   888→    exists: false,
   889→    status: "missing",
   890→  };
   891→
   892→  try {
   893→    await fs.access(agentsMdPath);
   894→    agentsMd.exists = true;
   895→
   896→    try {
   897→      const hashContent = await fs.readFile(hashPath, "utf-8");
   898→      const hashData = JSON.parse(hashContent);
   899→      agentsMd.generatedAt = hashData.generatedAt;
   900→
   901→      // AC: @cross-platform-and-version-robustness ac-4
   902→      // Compare stored hash against current meta to detect staleness
   903→      try {
   904→        const { initContext, loadMetaContext } = await import(
   905→          "../../parser/index.js"
   906→        );
   907→        const { computeMetaHash, loadTemplateSections, getPackageRoot } = await import("./agents.js");
   908→        const ctx = await initContext();
   909→        if (ctx.manifestPath) {
   910→          const metaCtx = await loadMetaContext(ctx);
   911→          let templateSections: string[] = [];
   912→          try {
   913→            templateSections = await loadTemplateSections(getPackageRoot());
   914→          } catch (err) {
   915→            debugLog("Templates not available for staleness check", err);
   916→          }
   917→          const currentHash = computeMetaHash(
   918→            metaCtx.skills,
   919→            metaCtx.conventions,
   920→            metaCtx.workflows,
   921→            templateSections,
   922→          );
   923→          agentsMd.status = hashData.metaHash === currentHash ? "current" : "stale";
   924→        } else {
   925→          // AC: @doctor-command ac-staleness-unknown — no manifest means we can't determine staleness
   926→          agentsMd.status = "unknown";
   927→        }
   928→      } catch (err) {
   929→        // AC: @doctor-command ac-staleness-unknown — hash computation failed
   930→        debugLog("Could not compute meta hash for staleness check", err);
   931→        agentsMd.status = "unknown";
   932→      }
   933→    } catch (err) {
   934→      debugLog("Hash file missing or invalid, marking stale", err);
   935→      agentsMd.status = "stale";
   936→    }
   937→  } catch (err) {
   938→    debugLog("kspec-agents.md doesn't exist", err);
   939→  }
   940→
   941→  // Check seeding state
   942→  const seeding: SetupStatus["seeding"] = {
   943→    permissionsSeeded: false,
   944→    memorySeeded: false,
   945→  };
   946→
   947→  try {
   948→    const configContent = await fs.readFile(
   949→      path.join(projectDir, ".claude", "settings.json"),
   950→      "utf-8",
   951→    );
   952→    const config = JSON.parse(configContent);
   953→    seeding.permissionsSeeded = !!config.permissions;
   954→  } catch (err) {
   955→    debugLog("Could not check permissions seeding state", err);
   956→  }
   957→
   958→  if (detected.type === "claude-code") {
   959→    try {
   960→      const { claudeCodeMemoryWriter } = await import("./setup-seeding.js");
   961→      const memoryExists = await claudeCodeMemoryWriter.exists(projectDir);
   962→      seeding.memorySeeded = memoryExists;
   963→      if (memoryExists) {
   964→        seeding.memoryPath = claudeCodeMemoryWriter.getMemoryPath(projectDir);
   965→      }
   966→    } catch (err) {
   967→      debugLog("Could not check memory seeding state", err);
   968→    }
   969→  }
   970→
   971→  return {
   972→    agent: {
   973→      detected: detected.type,
   974→      confidence: detected.confidence,
   975→    },
   976→    hooks,
   977→    skills,
   978→    plugin,
   979→    agentsMd,
   980→    seeding,
   981→  };
   982→}
   983→
   984→/**
   985→ * Render skills using the platform renderer registry
   986→ * AC: @setup-pipeline-unification ac-2 - uses getRenderer/getAllRenderers, not legacy renderClaudeCodeSkill
   987→ * AC: @setup-pipeline-unification ac-4 - errors logged at debug level
   988→ */
   989→async function renderSkillsForSetup(
   990→  projectDir: string,
   991→  dryRun: boolean,
   992→): Promise<{ rendered: number; skipped: number; pluginProvided: number; skillIds: string[] }> {
   993→  // Dynamically import to avoid circular dependencies
   994→  const { initContext, loadMetaContext } = await import(
   995→    "../../parser/index.js"
   996→  );
   997→  const { getRenderer } = await import("../../parser/skill-render.js");
   998→
   999→  try {
  1000→    const ctx = await initContext();
  1001→
  1002→    if (!ctx.manifestPath) {
  1003→      return { rendered: 0, skipped: 0, pluginProvided: 0, skillIds: [] };
  1004→    }
  1005→
  1006→    const metaCtx = await loadMetaContext(ctx);
  1007→
  1008→    // Collect all skills that have a registered renderer for their platform
  1009→    const skillsToRender: Array<{ skill: typeof metaCtx.skills[0]; platform: string }> = [];
  1010→    for (const skill of metaCtx.skills) {
  1011→      for (const platform of skill.platforms) {
  1012→        const renderer = getRenderer(platform);
  1013→        if (renderer) {
  1014→          skillsToRender.push({ skill, platform });
  1015→        }
  1016→      }
  1017→    }
  1018→
  1019→    if (skillsToRender.length === 0) {
  1020→      return { rendered: 0, skipped: 0, pluginProvided: 0, skillIds: [] };
  1021→    }
  1022→
  1023→    let rendered = 0;
  1024→    let skipped = 0;
  1025→    let pluginProvided = 0;
  1026→    const skillIds: string[] = [];
  1027→
  1028→    for (const { skill, platform } of skillsToRender) {
  1029→      const renderer = getRenderer(platform)!;
  1030→      try {
  1031→        const result = await renderer.render(ctx, projectDir, skill, {
  1032→          dryRun,
  1033→        });
  1034→        if (result.action === "created" || result.action === "updated") {
  1035→          rendered++;
  1036→          if (!skillIds.includes(skill.id)) {
  1037→            skillIds.push(skill.id);
  1038→          }
  1039→        } else if (result.action === "skipped" && result.skipCode === "plugin-provided") {
  1040→          pluginProvided++;
  1041→        } else {
  1042→          skipped++;
  1043→        }
  1044→      } catch (err) {
  1045→        debugLog(`Failed to render skill ${skill.id} for ${platform}`, err);
  1046→        skipped++;
  1047→      }
  1048→    }
  1049→
  1050→    return { rendered, skipped, pluginProvided, skillIds };
  1051→  } catch (err) {
  1052→    debugLog("renderSkillsForSetup failed", err);
  1053→    return { rendered: 0, skipped: 0, pluginProvided: 0, skillIds: [] };
  1054→  }
  1055→}
  1056→
  1057→/**
  1058→ * Ensure built-in worker and reviewer agent definitions exist in the project meta.
  1059→ *
  1060→ * Creates task-worker and pr-reviewer agents with dispatch rules that match
  1061→ * ralph's behavior. Skips creation if agents already exist (idempotent).
  1062→ *
  1063→ * AC: @ralph-replacement ac-2 — built-in worker and reviewer agent definitions
  1064→ * created in kynetic.meta.yaml with default dispatch rules matching ralph's behavior
  1065→ */
  1066→async function ensureBuiltInAgents(
  1067→  projectDir: string,
  1068→  dryRun: boolean,
  1069→): Promise<{ created: string[]; skipped: string[] }> {
  1070→  const { initContext } = await import("../../parser/index.js");
  1071→  const { loadMetaContext, saveMetaItem } = await import(
  1072→    "../../parser/meta.js"
  1073→  );
  1074→  const { ulid } = await import("ulid");
  1075→
  1076→  const created: string[] = [];
  1077→  const skipped: string[] = [];
  1078→
  1079→  try {
  1080→    const ctx = await initContext();
  1081→    if (!ctx.manifestPath) {
  1082→      return { created, skipped };
  1083→    }
  1084→
  1085→    const meta = await loadMetaContext(ctx);
  1086→    const existingIds = new Set((meta.agents || []).map((a) => a.id));
  1087→
  1088→    // Built-in agent definitions — match ralph's dispatch behavior
  1089→    const builtInAgents = [
  1090→      {
  1091→        id: "task-worker",
  1092→        name: "Task Worker",
  1093→        description:
  1094→          "Autonomous task worker. Picks up automation-eligible ready and needs_work tasks.",
  1095→        capabilities: ["code", "test", "refactor"],
  1096→        tools: ["kspec", "git", "npm"],
  1097→        dispatch: [
  1098→          { on: "task.in_progress", filter: { automation: "eligible" } },
  1099→          { on: "task.ready", filter: { automation: "eligible" } },
  1100→          { on: "task.needs_work", filter: { automation: "eligible" } },
  1101→        ],
  1102→        skills: ["task-work"],
  1103→        concurrency: { max_concurrent: 1 },
  1104→        auto_approve: true,
  1105→      },
  1106→      {
  1107→        id: "pr-reviewer",
  1108→        name: "PR Reviewer",
  1109→        description:
  1110→          "Automated PR reviewer. Reviews pending_review tasks and merges when quality gates pass.",
  1111→        capabilities: ["review"],
  1112→        tools: ["kspec", "git", "gh"],
  1113→        dispatch: [{ on: "task.pending_review" }],
  1114→        skills: ["pr-review"],
  1115→        concurrency: { max_concurrent: 1 },
  1116→        auto_approve: false,
  1117→      },
  1118→    ] as const;
  1119→
  1120→    for (const def of builtInAgents) {
  1121→      if (existingIds.has(def.id)) {
  1122→        skipped.push(def.id);
  1123→        continue;
  1124→      }
  1125→
  1126→      if (!dryRun) {
  1127→        await saveMetaItem(
  1128→          ctx,
  1129→          {
  1130→            _ulid: ulid(),
  1131→            id: def.id,
  1132→            name: def.name,
  1133→            description: def.description,
  1134→            capabilities: [...def.capabilities],
  1135→            tools: [...def.tools],
  1136→            conventions: [],
  1137→            dispatch: def.dispatch.map((r) => ({ ...r })),
  1138→            skills: [...def.skills],
  1139→            concurrency: { ...def.concurrency },
  1140→            auto_approve: def.auto_approve,
  1141→          },
  1142→          "agent",
  1143→        );
  1144→      }
  1145→      created.push(def.id);
  1146→    }
  1147→  } catch (err) {
  1148→    debugLog("ensureBuiltInAgents failed", err);
  1149→  }
  1150→
  1151→  return { created, skipped };
  1152→}
  1153→
  1154→/**
  1155→ * Generate kspec-agents.md using the canonical implementation from agents.ts
  1156→ * AC: @setup-pipeline-unification ac-1 - calls generateAgentsContent() from agents.ts
  1157→ * AC: @setup-pipeline-unification ac-4 - errors logged at debug level
  1158→ */
  1159→async function generateAgentInstructions(
  1160→  projectDir: string,
  1161→  dryRun: boolean,
  1162→): Promise<{ success: boolean; path: string; skipped?: boolean }> {
  1163→  const outputPath = path.join(projectDir, "kspec-agents.md");
  1164→  const hashPath = path.join(projectDir, ".kspec", ".kspec-agents-hash");
  1165→
  1166→  // Dynamically import to avoid circular dependencies
  1167→  const { initContext, loadMetaContext } = await import(
  1168→    "../../parser/index.js"
  1169→  );
  1170→  const {
  1171→    generateAgentsContent,
  1172→    loadTemplateSections,
  1173→    getPackageRoot,
  1174→    computeMetaHash,
  1175→  } = await import("./agents.js");
  1176→
  1177→  try {
  1178→    const ctx = await initContext();
  1179→
  1180→    if (!ctx.manifestPath) {
  1181→      return { success: false, path: outputPath };
  1182→    }
  1183→
  1184→    const metaCtx = await loadMetaContext(ctx);
  1185→    const timestamp = new Date().toISOString();
  1186→
  1187→    // Load templates using the canonical implementation
  1188→    let templateSections: string[] = [];
  1189→    try {
  1190→      templateSections = await loadTemplateSections(getPackageRoot());
  1191→    } catch (err) {
  1192→      debugLog("Failed to load template sections", err);
  1193→    }
  1194→
  1195→    // Generate content using the canonical implementation from agents.ts
  1196→    const content = await generateAgentsContent(
  1197→      metaCtx.skills,
  1198→      metaCtx.conventions,
  1199→      metaCtx.workflows,
  1200→      timestamp,
  1201→      templateSections,
  1202→    );
  1203→
  1204→    if (!dryRun) {
  1205→      // Compute meta hash for freshness tracking
  1206→      const metaHash = computeMetaHash(
  1207→        metaCtx.skills,
  1208→        metaCtx.conventions,
  1209→        metaCtx.workflows,
  1210→        templateSections,
  1211→      );
  1212→
  1213→      // Skip regeneration when content unchanged (same pattern as kspec agents generate)
  1214→      let storedHash: string | undefined;
  1215→      try {
  1216→        const hashContent = await fs.readFile(hashPath, "utf-8");
  1217→        const hashData = JSON.parse(hashContent);
  1218→        storedHash = hashData.metaHash;
  1219→      } catch (_err) {
  1220→        // No hash file or invalid — regenerate
  1221→      }
  1222→
  1223→      // Only skip if hash matches AND the output file actually exists
  1224→      let outputExists = false;
  1225→      try {
  1226→        await fs.access(outputPath);
  1227→        outputExists = true;
  1228→      } catch (_e) {
  1229→        // File missing — must regenerate even if hash matches
  1230→      }
  1231→
  1232→      if (storedHash === metaHash && outputExists) {
  1233→        return { success: true, path: outputPath, skipped: true };
  1234→      }
  1235→
  1236→      await fs.writeFile(outputPath, content, "utf-8");
  1237→
  1238→      await fs.mkdir(path.dirname(hashPath), { recursive: true });
  1239→      // Dynamically import version to avoid top-level require
  1240→      const { createRequire } = await import("node:module");
  1241→      const req = createRequire(import.meta.url);
  1242→      const { version } = req("../../../package.json");
  1243→
  1244→      await fs.writeFile(
  1245→        hashPath,
  1246→        JSON.stringify(
  1247→          {
  1248→            metaHash,
  1249→            generatedAt: timestamp,
  1250→            version,
  1251→          },
  1252→          null,
  1253→          2,
  1254→        ),
  1255→        "utf-8",
  1256→      );
  1257→    }
  1258→
  1259→    return { success: true, path: outputPath };
  1260→  } catch (err) {
  1261→    debugLog("generateAgentInstructions failed", err);
  1262→    return { success: false, path: outputPath };
  1263→  }
  1264→}
  1265→
  1266→/**
  1267→ * Install core skills for the setup pipeline
  1268→ * AC: @init-setup-integration ac-2 - core skills installed
  1269→ */
  1270→async function installCoreSkillsForSetup(
  1271→  projectDir: string,
  1272→  dryRun: boolean
  1273→): Promise<{
  1274→  installed: number;
  1275→  skipped: number;
  1276→  marketplaceRegistered?: boolean;
  1277→  pluginEnabled?: boolean;
  1278→  marketplaceMessage?: string;
  1279→  enableMessage?: string;
  1280→}> {
  1281→  // Dynamically import to avoid circular dependencies
  1282→  const {
  1283→    initContext,
  1284→    loadMetaContext,
  1285→    saveMetaItem,
  1286→    getSkillContentPath,
  1287→  } = await import("../../parser/index.js");
  1288→  const { commitIfShadow } = await import("../../parser/shadow.js");
  1289→  const { SkillSchema } = await import("../../schema/index.js");
  1290→  const {
  1291→    loadCoreSkillsManifest,
  1292→    copyCoreSkillFiles,
  1293→    getKspecPackageVersion,
  1294→  } = await import("./skill.js");
  1295→  const { ulid } = await import("ulid");
  1296→
  1297→  let installed = 0;
  1298→  let skipped = 0;
  1299→
  1300→  try {
  1301→    const ctx = await initContext();
  1302→
  1303→    if (!ctx.manifestPath) {
  1304→      return { installed: 0, skipped: 0 };
  1305→    }
  1306→
  1307→    const metaCtx = await loadMetaContext(ctx);
  1308→    const coreSkills = await loadCoreSkillsManifest();
  1309→    // AC: @cross-platform-and-version-robustness ac-3
  1310→    const kspecVersion = await getKspecPackageVersion();
  1311→    if (!kspecVersion) {
  1312→      debugLog("Could not determine kspec version — skills installed without version tracking");
  1313→    }
  1314→
  1315→    for (const coreSkill of coreSkills) {
  1316→      // Check if skill exists
  1317→      const existingSkill = metaCtx.skills.find((s) => s.id === coreSkill.id);
  1318→
  1319→      if (existingSkill && existingSkill.origin !== "core") {
  1320→        // Custom/project skill exists, skip
  1321→        skipped++;
  1322→        continue;
  1323→      }
  1324→
  1325→      // Build skill data
  1326→      const skillData = {
  1327→        _ulid: existingSkill?._ulid || ulid(),
  1328→        id: coreSkill.id,
  1329→        name: coreSkill.name,
  1330→        description: coreSkill.description,
  1331→        origin: "core" as const,
  1332→        ...(kspecVersion && { version: kspecVersion }),
  1333→        platforms: coreSkill.platforms || ["claude-code"],
  1334→        depends_on: [],
  1335→        tags: ["core"],
  1336→      };
  1337→
  1338→      const parsed = SkillSchema.safeParse(skillData);
  1339→      if (!parsed.success) {
  1340→        skipped++;
  1341→        continue;
  1342→      }
  1343→
  1344→      if (!dryRun) {
  1345→        await saveMetaItem(ctx, parsed.data, "skill");
  1346→
  1347→        // Copy skill files (SKILL.md + supporting dirs)
  1348→        const targetDir = path.dirname(getSkillContentPath(ctx, parsed.data.id));
  1349→        await copyCoreSkillFiles(coreSkill.id, targetDir);
  1350→      }
  1351→
  1352→      installed++;
  1353→    }
  1354→
  1355→    // Commit changes
  1356→    if (!dryRun && installed > 0) {
  1357→      const ctx2 = await initContext();
  1358→      await commitIfShadow(
  1359→        ctx2.shadow,
  1360→        "skill-install-core",
  1361→        `${installed} core skills`
  1362→      );
  1363→    }
  1364→
  1365→    // AC: @core-skill-install ac-6, ac-7 - Register marketplace and enable plugin
  1366→    let marketplaceResult;
  1367→    let enableResult;
  1368→    if (!dryRun) {
  1369→      const {
  1370→        registerCorePluginMarketplace,
  1371→        enablePluginInProject,
  1372→      } = await import("../../lib/claude-plugin-registry.js");
  1373→      marketplaceResult = await registerCorePluginMarketplace();
  1374→      enableResult = await enablePluginInProject(projectDir);
  1375→    }
  1376→
  1377→    return {
  1378→      installed,
  1379→      skipped,
  1380→      marketplaceRegistered: marketplaceResult?.success ?? false,
  1381→      pluginEnabled: enableResult?.success ?? false,
  1382→      marketplaceMessage: marketplaceResult?.message,
  1383→      enableMessage: enableResult?.message,
  1384→    };
  1385→  } catch (err) {
  1386→    debugLog("installCoreSkillsForSetup failed", err);
  1387→    return { installed: 0, skipped: 0 };
  1388→  }
  1389→}
  1390→
  1391→/**
  1392→ * Run the full setup pipeline programmatically.
  1393→ * Used by both 'kspec setup' command and 'kspec init --setup'.
  1394→ * AC: @init-setup-integration ac-2, ac-3
  1395→ */
  1396→export async function runSetupPipeline(
  1397→  projectDir: string,
  1398→  options: SetupPipelineOptions
  1399→): Promise<SetupPipelineResult> {
  1400→  const dryRun = options.dryRun ?? false;
  1401→  const skipSkills = options.skipSkills ?? false;
  1402→  const installHooksFlag = options.installHooks ?? true;
  1403→
  1404→  const steps: SetupStepResult[] = [];
  1405→  let coreSkillsInstalled = 0;
  1406→  let skillsRendered = 0;
  1407→  let hooksInstalled = false;
  1408→  let agentsMdGenerated = false;
  1409→  let permissionsSeeded = false;
  1410→  let memorySeeded = false;
  1411→
  1412→  try {
  1413→    const detected = options.agent
  1414→      ? buildDetectedAgent(options.agent)
  1415→      : detectAgent();
  1416→
  1417→    // Step 1: Agent detection
  1418→    steps.push({
  1419→      name: "Agent detection",
  1420→      status: "done",
  1421→      message: `${detected.type} (${detected.confidence} confidence)`,
  1422→    });
  1423→
  1424→    // Step 2: Install core skills
  1425→    // AC: @init-setup-integration ac-2 - core skills installed in .kspec/skills/
  1426→    const coreResult = await installCoreSkillsForSetup(projectDir, dryRun);
  1427→    coreSkillsInstalled = coreResult.installed;
  1428→
  1429→    if (coreResult.installed > 0 || coreResult.skipped > 0) {
  1430→      steps.push({
  1431→        name: "Install core skills",
  1432→        status: "done",
  1433→        message: `${coreResult.installed} installed, ${coreResult.skipped} skipped`,
  1434→      });
  1435→    } else {
  1436→      steps.push({
  1437→        name: "Install core skills",
  1438→        status: "skipped",
  1439→        message: "No core skills found in package",
  1440→      });
  1441→    }
  1442→
  1443→    // Step 2b: Register plugin marketplace (reports result from installCoreSkillsForSetup)
  1444→    // AC: @core-skill-install ac-6, ac-7
  1445→    if (!dryRun && (coreResult.installed > 0 || coreResult.skipped > 0)) {
  1446→      const bothOk = coreResult.marketplaceRegistered && coreResult.pluginEnabled;
  1447→      if (bothOk) {
  1448→        steps.push({
  1449→          name: "Register plugin marketplace",
  1450→          status: "done",
  1451→          message: "marketplace registered, plugin enabled",
  1452→        });
  1453→      } else {
  1454→        const failures: string[] = [];
  1455→        if (!coreResult.marketplaceRegistered) {
  1456→          failures.push(coreResult.marketplaceMessage || "marketplace registration failed");
  1457→        }
  1458→        if (!coreResult.pluginEnabled) {
  1459→          failures.push(coreResult.enableMessage || "plugin enablement failed");
  1460→        }
  1461→        steps.push({
  1462→          name: "Register plugin marketplace",
  1463→          status: "failed",
  1464→          message: failures.join("; "),
  1465→        });
  1466→      }
  1467→    }
  1468→
  1469→    // Step 3: Install hooks (Claude Code only)
  1470→    // AC: @init-setup-integration ac-3 - hooks present
  1471→    if (detected.type === "claude-code" && installHooksFlag) {
  1472→      const hooksResult = await installClaudeCodeHooks(projectDir, dryRun);
  1473→      const installedHooks: string[] = [];
  1474→      if (hooksResult.promptCheck) installedHooks.push("UserPromptSubmit");
  1475→      if (hooksResult.stop) installedHooks.push("Stop");
  1476→      if (hooksResult.preToolUse) installedHooks.push("PreToolUse");
  1477→
  1478→      hooksInstalled =
  1479→        hooksResult.promptCheck || hooksResult.stop || hooksResult.preToolUse;
  1480→
  1481→      steps.push({
  1482→        name: "Install hooks",
  1483→        status: "done",
  1484→        message: installedHooks.join(", "),
  1485→        details: {
  1486→          guards: hooksResult.guardsCreated,
  1487→        },
  1488→      });
  1489→    } else if (!installHooksFlag) {
  1490→      steps.push({
  1491→        name: "Install hooks",
  1492→        status: "skipped",
  1493→        message: "--no-hooks flag",
  1494→      });
  1495→    } else {
  1496→      steps.push({
  1497→        name: "Install hooks",
  1498→        status: "skipped",
  1499→        message: `not applicable for ${detected.type}`,
  1500→      });
  1501→    }
  1502→
  1503→    // Step 3a: Ensure artifacts directory exists
  1504→    // AC: @artifacts-directory ac-setup-ensures
  1505→    {
  1506→      const artifactsDir = path.join(projectDir, ".kspec", "artifacts");
  1507→      let artifactsCreated = false;
  1508→      try {
  1509→        await fs.access(artifactsDir);
  1510→      } catch (_e) {
  1511→        if (!dryRun) {
  1512→          await fs.mkdir(artifactsDir, { recursive: true });
  1513→        }
  1514→        artifactsCreated = true;
  1515→      }
  1516→      steps.push({
  1517→        name: "Ensure artifacts directory",
  1518→        status: artifactsCreated ? "done" : "skipped",
  1519→        message: artifactsCreated ? "created .kspec/artifacts/" : "already exists",
  1520→      });
  1521→    }
  1522→
  1523→    // Step 3a-ii: Ensure sessions directory and gitignore entries
  1524→    // AC: @session-storage-modes ac-gitignore, ac-sessions-dir-autocreate
  1525→    // AC: @session-legacy-migration ac-shadow-gitignore
  1526→    {
  1527→      const actions: string[] = [];
  1528→
  1529→      // Create .kspec-sessions/ directory
  1530→      const sessionsDirPath = path.join(projectDir, SESSIONS_WORKTREE_DIR);
  1531→      let sessionsCreated = false;
  1532→      try {
  1533→        await fs.access(sessionsDirPath);
  1534→      } catch (_e) {
  1535→        if (!dryRun) {
  1536→          await fs.mkdir(sessionsDirPath, { recursive: true });
  1537→        }
  1538→        sessionsCreated = true;
  1539→      }
  1540→      if (sessionsCreated) {
  1541→        actions.push(`${dryRun ? "create" : "created"} ${SESSIONS_WORKTREE_DIR}/`);
  1542→      }
  1543→
  1544→      // Add .kspec-sessions/ to root .gitignore
  1545→      if (dryRun) {
  1546→        const rootNeeded = await needsSessionsGitignore(projectDir);
  1547→        if (rootNeeded) {
  1548→          actions.push(`add ${SESSIONS_WORKTREE_DIR}/ to .gitignore`);
  1549→        }
  1550→      } else {
  1551→        const rootAdded = await ensureSessionsGitignore(projectDir);
  1552→        if (rootAdded) {
  1553→          actions.push(`added ${SESSIONS_WORKTREE_DIR}/ to .gitignore`);
  1554→        }
  1555→      }
  1556→
  1557→      // Add sessions/ to .kspec/.gitignore
  1558→      if (dryRun) {
  1559→        const shadowNeeded = await needsShadowSessionsGitignore(projectDir);
  1560→        if (shadowNeeded) {
  1561→          actions.push("add sessions/ to .kspec/.gitignore");
  1562→        }
  1563→      } else {
  1564→        const shadowAdded = await ensureShadowSessionsGitignore(projectDir);
  1565→        if (shadowAdded) {
  1566→          actions.push("added sessions/ to .kspec/.gitignore");
  1567→        }
  1568→      }
  1569→
  1570→      steps.push({
  1571→        name: "Ensure sessions directory",
  1572→        status: actions.length > 0 ? "done" : "skipped",
  1573→        message: actions.length > 0 ? actions.join(", ") : "already configured",
  1574→      });
  1575→    }
  1576→
  1577→    // Step 3b: Seed permissions (Claude Code only)
  1578→    // AC: @new-project-bootstrapping ac-1
  1579→    {
  1580→      const { seedPermissions } = await import("./setup-seeding.js");
  1581→      const permResult = await seedPermissions(projectDir, detected.type, {
  1582→        dryRun,
  1583→        force: options.force,
  1584→      });
  1585→      permissionsSeeded = permResult.seeded;
  1586→
  1587→      steps.push({
  1588→        name: "Seed permissions",
  1589→        status: permResult.seeded ? "done" : "skipped",
  1590→        message: permResult.message,
  1591→      });
  1592→    }
  1593→
  1594→    // Step 3c: Seed memory (platform-extensible)
  1595→    // AC: @new-project-bootstrapping ac-2, ac-3
  1596→    {
  1597→      const { seedMemory } = await import("./setup-seeding.js");
  1598→      const memResult = await seedMemory(projectDir, detected.type, {
  1599→        dryRun,
  1600→        force: options.force,
  1601→      });
  1602→      memorySeeded = memResult.seeded;
  1603→      const memoryStepStatus =
  1604→        memResult.message.startsWith("failed:")
  1605→          ? "failed"
  1606→          : memResult.seeded
  1607→            ? "done"
  1608→            : "skipped";
  1609→
  1610→      steps.push({
  1611→        name: "Seed memory",
  1612→        status: memoryStepStatus,
  1613→        message: memResult.seeded ? memResult.path : memResult.message,
  1614→      });
  1615→    }
  1616→
  1617→    // Step 4: Render skills
  1618→    // AC: @init-setup-integration ac-3 - rendered skill files present
  1619→    if (!skipSkills) {
  1620→      const skillsResult = await renderSkillsForSetup(projectDir, dryRun);
  1621→      skillsRendered = skillsResult.rendered;
  1622→
  1623→      if (skillsResult.rendered > 0 || skillsResult.skipped > 0 || skillsResult.pluginProvided > 0) {
  1624→        const parts = [];
  1625→        if (skillsResult.rendered > 0) parts.push(`${skillsResult.rendered} rendered`);
  1626→        if (skillsResult.pluginProvided > 0) parts.push(`${skillsResult.pluginProvided} plugin-provided`);
  1627→        if (skillsResult.skipped > 0) parts.push(`${skillsResult.skipped} unchanged`);
  1628→        steps.push({
  1629→          name: "Render skills",
  1630→          status: "done",
  1631→          message: parts.join(", "),
  1632→          details: {
  1633→            skillIds: skillsResult.skillIds,
  1634→          },
  1635→        });
  1636→      } else {
  1637→        steps.push({
  1638→          name: "Render skills",
  1639→          status: "skipped",
  1640→          message: "No skills with registered renderers in meta",
  1641→        });
  1642→      }
  1643→    } else {
  1644→      steps.push({
  1645→        name: "Render skills",
  1646→        status: "skipped",
  1647→        message: "--skip-skills flag",
  1648→      });
  1649→    }
  1650→
  1651→    // Step 4b: Ensure built-in worker and reviewer agent definitions exist
  1652→    // AC: @ralph-replacement ac-2 — built-in agents created in kynetic.meta.yaml
  1653→    {
  1654→      const agentsBuiltIn = await ensureBuiltInAgents(projectDir, dryRun);
  1655→      const totalNew = agentsBuiltIn.created.length;
  1656→      const totalSkipped = agentsBuiltIn.skipped.length;
  1657→      if (totalNew > 0 || totalSkipped > 0) {
  1658→        steps.push({
  1659→          name: "Ensure built-in agents",
  1660→          status: "done",
  1661→          message:
  1662→            totalNew > 0
  1663→              ? `created: ${agentsBuiltIn.created.join(", ")}`
  1664→              : `already exist: ${agentsBuiltIn.skipped.join(", ")}`,
  1665→        });
  1666→      }
  1667→    }
  1668→
  1669→    // Step 5: Generate kspec-agents.md
  1670→    // AC: @init-setup-integration ac-3 - kspec-agents.md present
  1671→    const agentsResult = await generateAgentInstructions(projectDir, dryRun);
  1672→    agentsMdGenerated = agentsResult.success;
  1673→
  1674→    if (agentsResult.success) {
  1675→      steps.push({
  1676→        name: "Generate kspec-agents.md",
  1677→        status: "done",
  1678→        message: agentsResult.skipped
  1679→          ? "already up to date"
  1680→          : agentsResult.path,
  1681→      });
  1682→    } else {
  1683→      steps.push({
  1684→        name: "Generate kspec-agents.md",
  1685→        status: "failed",
  1686→        message: "No kspec project found",
  1687→      });
  1688→    }
  1689→
  1690→    // Step 6: Configure author (optional, used by setup command)
  1691→    if (options.configureAuthor) {
  1692→      const author = options.author || getDefaultAuthor(detected.type);
  1693→      if (!options.force && process.env.KSPEC_AUTHOR) {
  1694→        steps.push({
  1695→          name: "Configure author",
  1696→          status: "skipped",
  1697→          message: `KSPEC_AUTHOR already set to "${process.env.KSPEC_AUTHOR}"`,
  1698→        });
  1699→      } else {
  1700→        let authorInstalled = false;
  1701→        switch (detected.type) {
  1702→          case "claude-code":
  1703→            if (!dryRun) {
  1704→              authorInstalled = await installClaudeCodeConfig(author);
  1705→            } else {
  1706→              authorInstalled = true;
  1707→            }
  1708→            break;
  1709→          case "aider":
  1710→            if (!dryRun) {
  1711→              authorInstalled = await installAiderConfig(author);
  1712→            } else {
  1713→              authorInstalled = true;
  1714→            }
  1715→            break;
  1716→          default:
  1717→            break;
  1718→        }
  1719→
  1720→        if (authorInstalled) {
  1721→          steps.push({
  1722→            name: "Configure author",
  1723→            status: "done",
  1724→            message: `KSPEC_AUTHOR="${author}"`,
  1725→          });
  1726→        } else if (detected.type === "unknown") {
  1727→          // AC: @cmd-setup ac-1 - show manual instructions for unknown agents
  1728→          steps.push({
  1729→            name: "Configure author",
  1730→            status: "skipped",
  1731→            message: `no auto-config for unknown agent — set KSPEC_AUTHOR manually`,
  1732→          });
  1733→        }
  1734→      }
  1735→    }
  1736→
  1737→    // Output summary
  1738→    if (!dryRun) {
  1739→      console.log(chalk.bold("kspec Setup Summary\n"));
  1740→
  1741→      for (const step of steps) {
  1742→        const icon =
  1743→          step.status === "done"
  1744→            ? chalk.green("✓")
  1745→            : step.status === "skipped"
  1746→              ? chalk.gray("○")
  1747→              : chalk.red("✗");
  1748→        const statusText =
  1749→          step.status === "done"
  1750→            ? ""
  1751→            : step.status === "skipped"
  1752→              ? chalk.gray(" (skipped)")
  1753→              : chalk.red(" (failed)");
  1754→
  1755→        console.log(`${icon} ${step.name}${statusText}`);
  1756→        if (step.message) {
  1757→          console.log(chalk.gray(`  ${step.message}`));
  1758→        }
  1759→      }
  1760→    }
  1761→
  1762→    const success = steps.every((s) => s.status !== "failed");
  1763→
  1764→    return {
  1765→      success,
  1766→      steps,
  1767→      coreSkillsInstalled,
  1768→      skillsRendered,
  1769→      hooksInstalled,
  1770→      agentsMdGenerated,
  1771→      permissionsSeeded,
  1772→      memorySeeded,
  1773→    };
  1774→  } catch (err) {
  1775→    debugLog("runSetupPipeline failed", err);
  1776→    return {
  1777→      success: false,
  1778→      steps,
  1779→      coreSkillsInstalled,
  1780→      skillsRendered,
  1781→      hooksInstalled,
  1782→      agentsMdGenerated,
  1783→      permissionsSeeded,
  1784→      memorySeeded,
  1785→    };
  1786→  }
  1787→}
  1788→
  1789→/**
  1790→ * Register the 'setup' command
  1791→ * AC: @enhanced-setup ac-1 through ac-9
  1792→ */
  1793→export function registerSetupCommand(program: Command): void {
  1794→  program
  1795→    .command("setup")
  1796→    .description("Configure agent environment for kspec (orchestrated pipeline)")
  1797→    .option(
  1798→      "--agent <type>",
  1799→      "Explicit agent type override (claude-code|cline|cursor|windsurf|unknown)",
  1800→    )
  1801→    .option("--dry-run", "Show what would be done without making changes")
  1802→    .option(
  1803→      "--author <author>",
  1804→      "Custom author string (default: auto-detected based on agent)",
  1805→    )
  1806→    .option("--no-hooks", "Skip installing hooks")
  1807→    .option("--skip-skills", "Skip rendering skills")
  1808→    .option("--status", "Report current setup state without making changes")
  1809→    .option("--force", "Overwrite existing configuration")
  1810→    .option(
  1811→      "--auto-worktree",
  1812→      "Automatically create .kspec worktree if kspec-meta branch exists",
  1813→    )
  1814→    .action(async (options) => {
  1815→      try {
  1816→        const projectDir = process.cwd();
  1817→        const agentOverride = options.agent
  1818→          ? parseSetupAgentOverride(options.agent)
  1819→          : undefined;
  1820→
  1821→        // AC: @enhanced-setup ac-7, ac-8 - --status mode
  1822→        if (options.status) {
  1823→          const status = await getSetupStatus(projectDir, agentOverride);
  1824→
  1825→          output(status, () => {
  1826→            console.log(chalk.bold("kspec Setup Status\n"));
  1827→
  1828→            // Agent detection
  1829→            console.log(chalk.gray("Agent:"));
  1830→            console.log(
  1831→              `  Detected: ${status.agent.detected} (${status.agent.confidence} confidence)`,
  1832→            );
  1833→            console.log();
  1834→
  1835→            // Hooks status
  1836→            console.log(chalk.gray("Hooks:"));
  1837→            console.log(
  1838→              `  UserPromptSubmit: ${status.hooks.promptCheck ? chalk.green("✓") : chalk.red("✗")}`,
  1839→            );
  1840→            console.log(
  1841→              `  Stop:             ${status.hooks.stop ? chalk.green("✓") : chalk.red("✗")}`,
  1842→            );
  1843→            console.log(
  1844→              `  PreToolUse:       ${status.hooks.preToolUse ? chalk.green("✓") : chalk.red("✗")}`,
  1845→            );
  1846→            if (status.hooks.guardsPresent.length > 0) {
  1847→              console.log(
  1848→                `  Guards:           ${status.hooks.guardsPresent.join(", ")}`,
  1849→              );
  1850→            }
  1851→            console.log();
  1852→
  1853→            // Skills status
  1854→            console.log(chalk.gray("Skills:"));
  1855→            console.log(`  Rendered: ${status.skills.rendered}`);
  1856→            if (status.skills.drifted > 0) {
  1857→              console.log(
  1858→                `  Drifted:  ${chalk.yellow(status.skills.drifted.toString())}`,
  1859→              );
  1860→            }
  1861→            console.log();
  1862→
  1863→            // Plugin marketplace status
  1864→            // AC: @enhanced-setup ac-7, ac-8
  1865→            console.log(chalk.gray("Plugin:"));
  1866→            console.log(
  1867→              `  Marketplace: ${status.plugin.marketplaceRegistered ? (status.plugin.marketplaceHealthy ? chalk.green("healthy") : chalk.yellow("registered")) : chalk.red("not registered")}`,
  1868→            );
  1869→            console.log(
  1870→              `  Enabled:     ${status.plugin.pluginEnabled ? chalk.green("✓") : chalk.red("✗")}`,
  1871→            );
  1872→            if (status.plugin.registeredPath) {
  1873→              console.log(chalk.gray(`  Path: ${status.plugin.registeredPath}`));
  1874→            }
  1875→            if (status.plugin.healthMessage && !status.plugin.marketplaceHealthy) {
  1876→              console.log(chalk.yellow(`  ${status.plugin.healthMessage}`));
  1877→            }
  1878→            console.log();
  1879→
  1880→            // Agents.md status
  1881→            console.log(chalk.gray("kspec-agents.md:"));
  1882→            if (status.agentsMd.exists) {
  1883→              // AC: @doctor-command ac-staleness-unknown — show appropriate color for unknown status
  1884→              const statusColor =
  1885→                status.agentsMd.status === "current"
  1886→                  ? chalk.green
  1887→                  : status.agentsMd.status === "unknown"
  1888→                    ? chalk.yellow
  1889→                    : chalk.yellow;
  1890→              console.log(`  Status: ${statusColor(status.agentsMd.status)}`);
  1891→              if (status.agentsMd.status === "unknown") {
  1892→                console.log(chalk.gray("  Could not determine staleness (no manifest or hash unavailable)"));
  1893→              }
  1894→              if (status.agentsMd.generatedAt) {
  1895→                console.log(`  Generated: ${status.agentsMd.generatedAt}`);
  1896→              }
  1897→            } else {
  1898→              console.log(`  Status: ${chalk.red("missing")}`);
  1899→              console.log(
  1900→                chalk.gray("  Run 'kspec setup' to generate"),
  1901→              );
  1902→            }
  1903→            console.log();
  1904→
  1905→            // Seeding status
  1906→            console.log(chalk.gray("Seeding:"));
  1907→            console.log(
  1908→              `  Permissions: ${status.seeding.permissionsSeeded ? chalk.green("✓") : chalk.gray("○")}`,
  1909→            );
  1910→            console.log(
  1911→              `  Memory:      ${status.seeding.memorySeeded ? chalk.green("✓") : chalk.gray("○")}`,
  1912→            );
  1913→            if (status.seeding.memoryPath) {
  1914→              console.log(
  1915→                chalk.gray(`  Path: ${status.seeding.memoryPath}`),
  1916→              );
  1917→            }
  1918→          });
  1919→          return;
  1920→        }
  1921→
  1922→        // AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
  1923→        const worktreeReady = await ensureWorktree(
  1924→          options.autoWorktree || false,
  1925→        );
  1926→        if (!worktreeReady) {
  1927→          // User declined worktree creation or it failed
  1928→          process.exit(EXIT_CODES.ERROR);
  1929→        }
  1930→
  1931→        const detected = agentOverride
  1932→          ? buildDetectedAgent(agentOverride)
  1933→          : detectAgent();
  1934→        const dryRun = options.dryRun || false;
  1935→
  1936→        // AC: @cmd-setup ac-1 - proceed with setup even when no agent is detected
  1937→        if (detected.type === "unknown") {
  1938→          warn("Could not auto-detect agent environment — proceeding with core setup steps");
  1939→        }
  1940→
  1941→        // AC: @setup-pipeline-unification ac-3 - delegate to runSetupPipeline()
  1942→        // One code path for both 'kspec setup' and 'kspec init --setup'
  1943→        const result = await runSetupPipeline(projectDir, {
  1944→          dryRun,
  1945→          skipSkills: options.skipSkills || false,
  1946→          installHooks: options.hooks !== false,
  1947→          force: options.force || false,
  1948→          agent: agentOverride,
  1949→          author: options.author,
  1950→          configureAuthor: true,
  1951→        });
  1952→
  1953→        // AC: @enhanced-setup ac-1 - Display summary
  1954→        // AC: @enhanced-setup ac-6 - dry-run displays planned actions
  1955→        output(
  1956→          {
  1957→            dry_run: dryRun,
  1958→            steps: result.steps.map((s) => ({
  1959→              name: s.name,
  1960→              status: s.status,
  1961→              message: s.message,
  1962→              details: s.details,
  1963→            })),
  1964→          },
  1965→          () => {
  1966→            if (dryRun) {
  1967→              console.log(chalk.yellow("DRY RUN - No changes made\n"));
  1968→            }
  1969→
  1970→            // Pipeline already prints the summary when not dry-run
  1971→            // For dry-run, print it here since the pipeline skips output
  1972→            if (dryRun) {
  1973→              console.log(chalk.bold("kspec Setup Summary\n"));
  1974→
  1975→              for (const step of result.steps) {
  1976→                const icon =
  1977→                  step.status === "done"
  1978→                    ? chalk.green("✓")
  1979→                    : step.status === "skipped"
  1980→                      ? chalk.gray("○")
  1981→                      : chalk.red("✗");
  1982→                const statusText =
  1983→                  step.status === "done"
  1984→                    ? ""
  1985→                    : step.status === "skipped"
  1986→                      ? chalk.gray(" (skipped)")
  1987→                      : chalk.red(" (failed)");
  1988→
  1989→                console.log(`${icon} ${step.name}${statusText}`);
  1990→                if (step.message) {
  1991→                  console.log(chalk.gray(`  ${step.message}`));
  1992→                }
  1993→              }
  1994→            }
  1995→
  1996→            console.log();
  1997→
  1998→            if (dryRun) {
  1999→              console.log(
  2000→                chalk.yellow("Run without --dry-run to apply changes."),
  2001→              );
  2002→            } else {
  2003→              console.log(
  2004→                chalk.green("Setup complete."),
  2005→              );
  2006→              console.log(
  2007→                chalk.gray("Restart your agent session for changes to take effect."),
  2008→              );
  2009→            }
  2010→
  2011→            // AC: @cmd-setup ac-1 - print manual KSPEC_AUTHOR instructions for unknown agents
  2012→            if (detected.type === "unknown") {
  2013→              printManualInstructions("unknown");
  2014→            }
  2015→          },
  2016→        );
  2017→      } catch (err) {
  2018→        error(errors.failures.setupFailed, err);
  2019→        process.exit(EXIT_CODES.ERROR);
  2020→      }
  2021→    });
  2022→}
  2023→
```