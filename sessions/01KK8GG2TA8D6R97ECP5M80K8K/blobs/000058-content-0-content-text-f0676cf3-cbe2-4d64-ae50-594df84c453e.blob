```
     1→/**
     2→ * Shadow branch utilities for transparent spec/task state tracking.
     3→ *
     4→ * Shadow branch concept:
     5→ * - Orphan branch (kspec-meta) stores kspec state
     6→ * - .kspec/ directory is a git worktree pointing to shadow branch
     7→ * - Main branch gitignores .kspec/
     8→ * - All kspec read/write operations target .kspec/
     9→ * - Changes auto-commit to shadow branch
    10→ */
    11→
    12→import { execFile, spawn, spawnSync } from "node:child_process";
    13→import * as fs from "node:fs/promises";
    14→import { tmpdir } from "node:os";
    15→import * as path from "node:path";
    16→import { promisify } from "node:util";
    17→import { fileURLToPath } from "node:url";
    18→import { isBatchMode } from "../cli/batch-context.js";
    19→
    20→const __filename = fileURLToPath(import.meta.url);
    21→const __dirname = path.dirname(__filename);
    22→
    23→const execFileAsync = promisify(execFile);
    24→
    25→interface RunCommandOptions {
    26→  cwd?: string;
    27→  env?: NodeJS.ProcessEnv;
    28→}
    29→
    30→function runCommandSync(
    31→  command: string,
    32→  args: string[],
    33→  options: RunCommandOptions = {},
    34→): { ok: boolean; stdout: string; stderr: string } {
    35→  const result = spawnSync(command, args, {
    36→    cwd: options.cwd,
    37→    env: options.env,
    38→    stdio: ["ignore", "pipe", "pipe"],
    39→    encoding: "utf-8",
    40→  });
    41→
    42→  return {
    43→    ok: !result.error && result.status === 0,
    44→    stdout: (result.stdout || "").toString(),
    45→    stderr: (result.stderr || "").toString(),
    46→  };
    47→}
    48→
    49→async function runGitAsync(
    50→  cwd: string,
    51→  args: string[],
    52→  env?: NodeJS.ProcessEnv,
    53→): Promise<{ stdout: string; stderr: string }> {
    54→  const { stdout = "", stderr = "" } = await execFileAsync("git", args, {
    55→    cwd,
    56→    env,
    57→    encoding: "utf-8",
    58→  });
    59→  return { stdout: stdout.toString(), stderr: stderr.toString() };
    60→}
    61→
    62→function runGitSync(
    63→  cwd: string,
    64→  args: string[],
    65→): { ok: boolean; stdout: string } {
    66→  const result = spawnSync("git", args, {
    67→    cwd,
    68→    stdio: ["ignore", "pipe", "pipe"],
    69→    encoding: "utf-8",
    70→  });
    71→
    72→  return {
    73→    ok: !result.error && result.status === 0,
    74→    stdout: (result.stdout || "").toString(),
    75→  };
    76→}
    77→
    78→/**
    79→ * Parse git version from `git --version` output.
    80→ * Returns [major, minor, patch] or null if unparseable.
    81→ */
    82→export function getGitVersion(
    83→  cwd?: string,
    84→): [number, number, number] | null {
    85→  const result = spawnSync("git", ["--version"], {
    86→    cwd,
    87→    stdio: ["ignore", "pipe", "pipe"],
    88→    encoding: "utf-8",
    89→  });
    90→  if (result.error || result.status !== 0) return null;
    91→  const match = (result.stdout || "").match(/(\d+)\.(\d+)\.(\d+)/);
    92→  if (!match) return null;
    93→  return [Number(match[1]), Number(match[2]), Number(match[3])];
    94→}
    95→
    96→/**
    97→ * Check if the installed git supports `git worktree add --orphan` (requires >= 2.42.0).
    98→ */
    99→export function gitSupportsOrphanWorktree(cwd?: string): boolean {
   100→  const version = getGitVersion(cwd);
   101→  if (!version) return false;
   102→  const [major, minor] = version;
   103→  return major > 2 || (major === 2 && minor >= 42);
   104→}
   105→
   106→/**
   107→ * Fallback for creating an orphan branch when git < 2.42.
   108→ *
   109→ * Strategy:
   110→ * 1. Create a temp bare repo in the OS temp directory
   111→ * 2. Create an orphan branch with an empty commit there
   112→ * 3. Push that branch to the project repo (via file:// protocol)
   113→ * 4. Clean up the temp repo
   114→ * 5. Attach using standard `git worktree add <dir> <branch>`
   115→ *
   116→ * This approach NEVER modifies the project's working tree.
   117→ *
   118→ * AC: @config-shadow ac-10
   119→ */
   120→export async function createOrphanBranchFallback(
   121→  projectRoot: string,
   122→  branchName: string,
   123→  directoryName: string,
   124→): Promise<void> {
   125→  const tmpDir = await fs.mkdtemp(path.join(tmpdir(), "kspec-orphan-"));
   126→
   127→  try {
   128→    // 1. Init a bare repo in the temp dir
   129→    await runGitAsync(tmpDir, ["init", "--bare"]);
   130→
   131→    // 2. Create the orphan branch using a temporary non-bare clone.
   132→    //    We need a working tree to make a commit, so clone the bare repo.
   133→    const workDir = await fs.mkdtemp(path.join(tmpdir(), "kspec-orphan-work-"));
   134→
   135→    try {
   136→      await runGitAsync(workDir, ["clone", tmpDir, "."]);
   137→      await runGitAsync(workDir, [
   138→        "config",
   139→        "user.email",
   140→        "kspec@localhost",
   141→      ]);
   142→      await runGitAsync(workDir, [
   143→        "config",
   144→        "user.name",
   145→        "kspec",
   146→      ]);
   147→
   148→      // Create an orphan branch (checkout --orphan works on all git versions)
   149→      await runGitAsync(workDir, [
   150→        "checkout",
   151→        "--orphan",
   152→        branchName,
   153→      ]);
   154→
   155→      // Remove any files that might have been staged
   156→      try {
   157→        await runGitAsync(workDir, ["rm", "-rf", "."]);
   158→      } catch {
   159→        // May fail if nothing to remove (empty repo) - that's fine
   160→      }
   161→
   162→      // Create an empty initial commit
   163→      await runGitAsync(workDir, [
   164→        "commit",
   165→        "--allow-empty",
   166→        "-m",
   167→        `Initialize ${branchName}`,
   168→      ]);
   169→
   170→      // Push the orphan branch back to the bare repo
   171→      await runGitAsync(workDir, [
   172→        "push",
   173→        "origin",
   174→        branchName,
   175→      ]);
   176→    } finally {
   177→      await fs.rm(workDir, { recursive: true, force: true });
   178→    }
   179→
   180→    // 3. Push from the temp bare repo to the project repo
   181→    //    Use file:// protocol to ensure git treats it as a proper remote
   182→    await runGitAsync(tmpDir, [
   183→      "push",
   184→      `file://${path.resolve(projectRoot)}`,
   185→      branchName,
   186→    ]);
   187→  } finally {
   188→    // 4. Clean up the temp bare repo
   189→    await fs.rm(tmpDir, { recursive: true, force: true });
   190→  }
   191→
   192→  // 5. Attach worktree using standard git worktree add (no --orphan flag)
   193→  await runGitAsync(projectRoot, [
   194→    "worktree",
   195→    "add",
   196→    directoryName,
   197→    branchName,
   198→  ]);
   199→
   200→  // 6. Remove all tracked files from the worktree since the fallback
   201→  //    created an empty commit but `git worktree add` may still populate
   202→  //    the index from the branch. Clear anything that appeared.
   203→  try {
   204→    const { stdout } = await runGitAsync(
   205→      path.join(projectRoot, directoryName),
   206→      ["ls-files"],
   207→    );
   208→    if (stdout.trim()) {
   209→      await runGitAsync(
   210→        path.join(projectRoot, directoryName),
   211→        ["rm", "-rf", "."],
   212→      );
   213→    }
   214→  } catch {
   215→    // Nothing to remove — expected for an empty commit
   216→  }
   217→}
   218→
   219→// Import getVerboseMode for checking CLI --debug-shadow flag
   220→// We use a getter function to avoid issues with circular dependencies
   221→let getVerboseModeFunc: (() => boolean) | null = null;
   222→
   223→export function setVerboseModeGetter(getter: () => boolean): void {
   224→  getVerboseModeFunc = getter;
   225→}
   226→
   227→/**
   228→ * Shadow branch configuration
   229→ */
   230→export interface ShadowConfig {
   231→  /** Whether shadow branch is enabled/detected */
   232→  enabled: boolean;
   233→  /** Path to .kspec/ worktree directory */
   234→  worktreeDir: string;
   235→  /** Shadow branch name (default: kspec-meta) */
   236→  branchName: string;
   237→  /** Project root (where .kspec/ lives) */
   238→  projectRoot: string;
   239→}
   240→
   241→/**
   242→ * Shadow branch status
   243→ */
   244→export interface ShadowStatus {
   245→  exists: boolean;
   246→  healthy: boolean;
   247→  branchExists: boolean;
   248→  worktreeExists: boolean;
   249→  worktreeLinked: boolean;
   250→  artifactsDirExists: boolean;
   251→  error?: string;
   252→}
   253→
   254→/**
   255→ * Error types for shadow branch issues
   256→ */
   257→export class ShadowError extends Error {
   258→  constructor(
   259→    message: string,
   260→    public code:
   261→      | "NOT_INITIALIZED"
   262→      | "WORKTREE_DISCONNECTED"
   263→      | "DIRECTORY_MISSING"
   264→      | "GIT_ERROR"
   265→      | "RUNNING_FROM_SHADOW",
   266→    public suggestion: string,
   267→  ) {
   268→    super(message);
   269→    this.name = "ShadowError";
   270→  }
   271→}
   272→
   273→/**
   274→ * Default shadow branch name
   275→ */
   276→export const SHADOW_BRANCH_NAME = "kspec-meta";
   277→
   278→/**
   279→ * Default shadow worktree directory
   280→ */
   281→export const SHADOW_WORKTREE_DIR = ".kspec";
   282→
   283→/**
   284→ * Sessions storage directory name (at project root, separate from shadow worktree).
   285→ * AC: @session-storage-modes ac-sessions-dir
   286→ */
   287→export const SESSIONS_WORKTREE_DIR = ".kspec-sessions";
   288→
   289→/**
   290→ * Options for shadow branch operations.
   291→ *
   292→ * AC: @config-shadow ac-7 — all fields optional for backward compatibility
   293→ *
   294→ * When not provided, functions use SHADOW_BRANCH_NAME and SHADOW_WORKTREE_DIR constants.
   295→ */
   296→export interface ShadowOptions {
   297→  /** Branch name (default: kspec-meta) */
   298→  branchName?: string;
   299→  /** Worktree directory name (default: .kspec) */
   300→  directory?: string;
   301→  /**
   302→   * Remote target for push/pull. Can be:
   303→   * - Named remote (e.g., "origin", "specs-origin")
   304→   * - Local filesystem path (starts with /, ./, or ~)
   305→   * - Git URL (contains :// or starts with git@)
   306→   */
   307→  remote?: string;
   308→  /** Type of remote (detected from remote string) */
   309→  remoteType?: "named" | "path" | "url";
   310→}
   311→
   312→/**
   313→ * Get effective branch name from options or default.
   314→ * AC: @config-shadow ac-7 — backward compat when called without config
   315→ */
   316→function getBranchName(options?: ShadowOptions): string {
   317→  return options?.branchName ?? SHADOW_BRANCH_NAME;
   318→}
   319→
   320→/**
   321→ * Get effective directory name from options or default.
   322→ * AC: @config-shadow ac-7 — backward compat when called without config
   323→ */
   324→function getDirectoryName(options?: ShadowOptions): string {
   325→  return options?.directory ?? SHADOW_WORKTREE_DIR;
   326→}
   327→
   328→/**
   329→ * Get effective remote name from options or default.
   330→ * AC: @config-shadow ac-3 ac-7 — resolves configured remote for fetch/push/pull.
   331→ * Named remotes use the name directly; path/URL remotes use the auto-created "kspec-specs".
   332→ */
   333→function getRemoteName(options?: ShadowOptions): string {
   334→  if (!options?.remote) return "origin";
   335→  const remoteType = options.remoteType ?? "named";
   336→  if (remoteType === "path" || remoteType === "url") return "kspec-specs";
   337→  return options.remote;
   338→}
   339→
   340→/**
   341→ * Check if debug mode is enabled.
   342→ * Debug mode can be enabled via:
   343→ * - KSPEC_DEBUG=1 environment variable
   344→ * - Verbose flag (passed from CLI --debug-shadow option)
   345→ *
   346→ * When enabled, shadow branch operations output detailed information.
   347→ */
   348→export function isDebugMode(verboseFlag?: boolean): boolean {
   349→  if (process.env.KSPEC_DEBUG === "1") {
   350→    return true;
   351→  }
   352→  if (verboseFlag === true) {
   353→    return true;
   354→  }
   355→  // Check CLI --debug-shadow flag via getter
   356→  if (getVerboseModeFunc?.()) {
   357→    return true;
   358→  }
   359→  return false;
   360→}
   361→
   362→/**
   363→ * Check if we're in a git repository
   364→ */
   365→export async function isGitRepo(dir: string): Promise<boolean> {
   366→  return runGitSync(dir, ["rev-parse", "--git-dir"]).ok;
   367→}
   368→
   369→/**
   370→ * Get the git root directory
   371→ */
   372→export function getGitRoot(dir: string): string | null {
   373→  const result = runGitSync(dir, ["rev-parse", "--show-toplevel"]);
   374→  if (!result.ok) {
   375→    return null;
   376→  }
   377→  return result.stdout.trim();
   378→}
   379→
   380→/**
   381→ * Check if a branch exists
   382→ */
   383→export async function branchExists(
   384→  dir: string,
   385→  branchName: string,
   386→): Promise<boolean> {
   387→  return runGitSync(dir, [
   388→    "show-ref",
   389→    "--verify",
   390→    "--quiet",
   391→    `refs/heads/${branchName}`,
   392→  ]).ok;
   393→}
   394→
   395→/**
   396→ * Check if a directory is a valid git worktree
   397→ */
   398→export async function isValidWorktree(worktreeDir: string): Promise<boolean> {
   399→  try {
   400→    // Check if .git file exists (worktrees have a .git file, not directory)
   401→    const gitPath = path.join(worktreeDir, ".git");
   402→    const stat = await fs.stat(gitPath);
   403→
   404→    if (stat.isFile()) {
   405→      // Read the .git file to verify it points to a worktree
   406→      const content = await fs.readFile(gitPath, "utf-8");
   407→      return content.trim().startsWith("gitdir:");
   408→    }
   409→
   410→    return false;
   411→  } catch {
   412→    return false;
   413→  }
   414→}
   415→
   416→/**
   417→ * Detect if running from inside the shadow worktree directory.
   418→ * Returns the main project root if detected, null otherwise.
   419→ *
   420→ * AC: @config-shadow ac-8 — detects custom worktree directories using git metadata
   421→ *
   422→ * Detection logic:
   423→ * 1. Check if .git is a file (worktrees have .git files, not directories)
   424→ * 2. Read the gitdir reference from the .git file
   425→ * 3. Check if it points to a worktree for kspec (pattern: <project>/.git/worktrees/...)
   426→ *
   427→ * For custom directories, we detect ANY worktree that:
   428→ * - Has a kspec manifest in it (indicating it's a kspec shadow worktree)
   429→ * - Or has a worktree name containing "kspec" or the configured directory name
   430→ *
   431→ * @param cwd Current working directory
   432→ * @param configuredDirectory Optional configured directory name for matching
   433→ */
   434→export async function detectRunningFromShadowWorktree(
   435→  cwd: string,
   436→  configuredDirectory?: string,
   437→): Promise<string | null> {
   438→  try {
   439→    const gitPath = path.join(cwd, ".git");
   440→    const stat = await fs.stat(gitPath);
   441→
   442→    // Worktrees have a .git file, not directory
   443→    if (!stat.isFile()) {
   444→      return null;
   445→    }
   446→
   447→    const content = await fs.readFile(gitPath, "utf-8");
   448→    const match = content.trim().match(/^gitdir:\s*(.+)$/);
   449→    if (!match) {
   450→      return null;
   451→    }
   452→
   453→    const gitdir = match[1];
   454→
   455→    // Check if this is a worktree (pattern: <project>/.git/worktrees/<name>)
   456→    if (gitdir.includes(".git/worktrees/")) {
   457→      const worktreesMatch = gitdir.match(/^(.+)\/\.git\/worktrees\//);
   458→      if (worktreesMatch) {
   459→        const mainProjectRoot = worktreesMatch[1];
   460→        const cwdBase = path.basename(cwd);
   461→        const worktreeName = path.basename(gitdir);
   462→
   463→        // AC: ac-8 — check multiple patterns for shadow worktree detection
   464→        const directoryToCheck = configuredDirectory || SHADOW_WORKTREE_DIR;
   465→
   466→        // Check if directory name matches default, configured, or worktree contains "kspec"
   467→        if (
   468→          cwdBase === SHADOW_WORKTREE_DIR ||
   469→          cwdBase === directoryToCheck ||
   470→          worktreeName.includes("kspec")
   471→        ) {
   472→          return mainProjectRoot;
   473→        }
   474→
   475→        // Additional check: see if this directory has a kspec manifest
   476→        // This catches custom directories that don't have "kspec" in the name
   477→        try {
   478→          const files = await fs.readdir(cwd);
   479→          const hasKspecManifest = files.some(
   480→            (f) =>
   481→              (f.endsWith(".yaml") || f.endsWith(".yml")) &&
   482→              !f.includes(".tasks.") &&
   483→              !f.includes(".inbox."),
   484→          );
   485→          // Check for modules directory or tasks file as additional signals
   486→          const hasModules = files.includes("modules");
   487→          const hasTasksFile = files.some((f) => f.includes(".tasks."));
   488→
   489→          if (hasKspecManifest && (hasModules || hasTasksFile)) {
   490→            return mainProjectRoot;
   491→          }
   492→        } catch {
   493→          // Ignore read errors
   494→        }
   495→      }
   496→    }
   497→
   498→    return null;
   499→  } catch {
   500→    return null;
   501→  }
   502→}
   503→
   504→/**
   505→ * Detect shadow branch configuration from a directory.
   506→ * Returns shadow config if worktree directory exists and is valid.
   507→ *
   508→ * AC: @config-shadow ac-1 ac-2 — uses configured branch/directory names
   509→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
   510→ *
   511→ * @param startDir Directory to start detection from
   512→ * @param options Optional shadow configuration (branch name, directory)
   513→ */
   514→export async function detectShadow(
   515→  startDir: string,
   516→  options?: ShadowOptions,
   517→): Promise<ShadowConfig | null> {
   518→  const gitRoot = getGitRoot(startDir);
   519→  if (!gitRoot) {
   520→    return null;
   521→  }
   522→
   523→  const directoryName = getDirectoryName(options);
   524→  const branchName = getBranchName(options);
   525→  const worktreeDir = path.join(gitRoot, directoryName);
   526→
   527→  try {
   528→    await fs.access(worktreeDir);
   529→
   530→    // Verify it's a valid worktree
   531→    if (await isValidWorktree(worktreeDir)) {
   532→      return {
   533→        enabled: true,
   534→        worktreeDir,
   535→        branchName,
   536→        projectRoot: gitRoot,
   537→      };
   538→    }
   539→
   540→    // Directory exists but not a valid worktree
   541→    return null;
   542→  } catch {
   543→    // Worktree directory doesn't exist
   544→    return null;
   545→  }
   546→}
   547→
   548→/**
   549→ * Get detailed shadow branch status.
   550→ *
   551→ * AC: @config-shadow ac-1 ac-2 — uses configured branch/directory names
   552→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
   553→ *
   554→ * @param projectRoot Git repository root
   555→ * @param options Optional shadow configuration
   556→ */
   557→export async function getShadowStatus(
   558→  projectRoot: string,
   559→  options?: ShadowOptions,
   560→): Promise<ShadowStatus> {
   561→  const directoryName = getDirectoryName(options);
   562→  const branchName = getBranchName(options);
   563→  const worktreeDir = path.join(projectRoot, directoryName);
   564→
   565→  const status: ShadowStatus = {
   566→    exists: false,
   567→    healthy: false,
   568→    branchExists: false,
   569→    worktreeExists: false,
   570→    worktreeLinked: false,
   571→    artifactsDirExists: false,
   572→  };
   573→
   574→  // Check if we're in a git repo
   575→  if (!(await isGitRepo(projectRoot))) {
   576→    status.error = "Not a git repository";
   577→    return status;
   578→  }
   579→
   580→  // Check if branch exists
   581→  status.branchExists = await branchExists(projectRoot, branchName);
   582→
   583→  // Check if worktree directory exists
   584→  try {
   585→    await fs.access(worktreeDir);
   586→    status.worktreeExists = true;
   587→  } catch {
   588→    status.worktreeExists = false;
   589→  }
   590→
   591→  // Check if worktree is properly linked
   592→  if (status.worktreeExists) {
   593→    status.worktreeLinked = await isValidWorktree(worktreeDir);
   594→
   595→    // AC: @artifacts-directory ac-doctor-checks
   596→    try {
   597→      await fs.access(path.join(worktreeDir, "artifacts"));
   598→      status.artifactsDirExists = true;
   599→    } catch {
   600→      status.artifactsDirExists = false;
   601→    }
   602→  }
   603→
   604→  // Determine overall status
   605→  status.exists = status.branchExists || status.worktreeExists;
   606→  status.healthy =
   607→    status.branchExists && status.worktreeExists && status.worktreeLinked;
   608→
   609→  if (!status.healthy && status.exists) {
   610→    if (!status.branchExists) {
   611→      status.error = "Shadow branch missing but worktree exists";
   612→    } else if (!status.worktreeExists) {
   613→      status.error = "Shadow branch exists but worktree missing";
   614→    } else if (!status.worktreeLinked) {
   615→      status.error = "Worktree exists but not properly linked";
   616→    }
   617→  }
   618→
   619→  return status;
   620→}
   621→
   622→/**
   623→ * Result from checking config mismatch.
   624→ */
   625→export interface ShadowConfigMismatch {
   626→  /** Whether there is a mismatch */
   627→  hasMismatch: boolean;
   628→  /** Mismatched branch name (detected vs configured) */
   629→  branchMismatch?: { detected: string; configured: string };
   630→  /** Mismatched directory (detected vs configured) */
   631→  directoryMismatch?: { detected: string; configured: string };
   632→  /** Guidance message for the user */
   633→  guidance?: string;
   634→}
   635→
   636→/**
   637→ * Check if detected shadow branch settings match the configuration.
   638→ *
   639→ * AC: @config-shadow ac-9 — detect mismatch and guide user to migrate
   640→ *
   641→ * This function detects when:
   642→ * - A shadow branch exists with default settings (kspec-meta, .kspec)
   643→ * - But config specifies different settings
   644→ *
   645→ * @param projectRoot Git repository root
   646→ * @param configuredBranch Configured branch name
   647→ * @param configuredDirectory Configured directory name
   648→ */
   649→export async function checkConfigMismatch(
   650→  projectRoot: string,
   651→  configuredBranch: string,
   652→  configuredDirectory: string,
   653→): Promise<ShadowConfigMismatch> {
   654→  const result: ShadowConfigMismatch = { hasMismatch: false };
   655→
   656→  // First check if default shadow exists
   657→  const defaultStatus = await getShadowStatus(projectRoot, {
   658→    branchName: SHADOW_BRANCH_NAME,
   659→    directory: SHADOW_WORKTREE_DIR,
   660→  });
   661→
   662→  if (!defaultStatus.healthy) {
   663→    // No existing shadow with defaults - no mismatch possible
   664→    return result;
   665→  }
   666→
   667→  // Check if configured settings differ from defaults
   668→  const branchDiffers = configuredBranch !== SHADOW_BRANCH_NAME;
   669→  const directoryDiffers = configuredDirectory !== SHADOW_WORKTREE_DIR;
   670→
   671→  if (!branchDiffers && !directoryDiffers) {
   672→    // Config matches defaults - no mismatch
   673→    return result;
   674→  }
   675→
   676→  // There's a mismatch - existing shadow uses defaults but config specifies different values
   677→  result.hasMismatch = true;
   678→
   679→  if (branchDiffers) {
   680→    result.branchMismatch = {
   681→      detected: SHADOW_BRANCH_NAME,
   682→      configured: configuredBranch,
   683→    };
   684→  }
   685→
   686→  if (directoryDiffers) {
   687→    result.directoryMismatch = {
   688→      detected: SHADOW_WORKTREE_DIR,
   689→      configured: configuredDirectory,
   690→    };
   691→  }
   692→
   693→  // Build guidance message
   694→  const parts: string[] = [];
   695→  if (result.branchMismatch) {
   696→    parts.push(
   697→      `branch "${SHADOW_BRANCH_NAME}" (config wants "${configuredBranch}")`,
   698→    );
   699→  }
   700→  if (result.directoryMismatch) {
   701→    parts.push(
   702→      `directory "${SHADOW_WORKTREE_DIR}" (config wants "${configuredDirectory}")`,
   703→    );
   704→  }
   705→
   706→  result.guidance = [
   707→    `Shadow branch exists with ${parts.join(" and ")}.`,
   708→    "",
   709→    "To migrate to configured settings:",
   710→    "  1. Export your specs: kspec export --all > backup.yaml",
   711→    "  2. Remove existing shadow: rm -rf .kspec && git branch -D kspec-meta",
   712→    "  3. Re-initialize: kspec init",
   713→    "  4. Import specs: kspec import backup.yaml",
   714→    "",
   715→    "Or update kspec.config.yaml to match existing settings.",
   716→  ].join("\n");
   717→
   718→  return result;
   719→}
   720→
   721→/**
   722→ * Create an appropriate ShadowError based on status
   723→ */
   724→export function createShadowError(status: ShadowStatus): ShadowError {
   725→  if (!status.branchExists && !status.worktreeExists) {
   726→    return new ShadowError(
   727→      "Shadow branch not initialized",
   728→      "NOT_INITIALIZED",
   729→      "Run `kspec init` to create shadow branch and worktree.",
   730→    );
   731→  }
   732→
   733→  if (status.branchExists && !status.worktreeExists) {
   734→    return new ShadowError(
   735→      ".kspec/ directory missing",
   736→      "DIRECTORY_MISSING",
   737→      "Run `kspec shadow repair` to recreate the worktree.",
   738→    );
   739→  }
   740→
   741→  if (status.worktreeExists && !status.worktreeLinked) {
   742→    return new ShadowError(
   743→      "Worktree disconnected from git",
   744→      "WORKTREE_DISCONNECTED",
   745→      "Run `kspec shadow repair` to fix the worktree link.",
   746→    );
   747→  }
   748→
   749→  return new ShadowError(
   750→    status.error || "Unknown shadow branch error",
   751→    "GIT_ERROR",
   752→    "Check git status and try `kspec shadow repair`.",
   753→  );
   754→}
   755→
   756→/**
   757→ * Auto-commit changes to shadow branch.
   758→ * Called after write operations when shadow is enabled.
   759→ *
   760→ * @param worktreeDir Path to .kspec/ directory
   761→ * @param message Commit message
   762→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   763→ * @returns true if commit succeeded, false if nothing to commit
   764→ */
   765→export async function shadowAutoCommit(
   766→  worktreeDir: string,
   767→  message: string,
   768→  verbose?: boolean,
   769→): Promise<boolean> {
   770→  const debug = isDebugMode(verbose);
   771→
   772→  try {
   773→    if (debug) {
   774→      console.error(
   775→        `[DEBUG] Shadow auto-commit: git add -A (cwd: ${worktreeDir})`,
   776→      );
   777→    }
   778→
   779→    // Stage all changes
   780→    const addResult = runCommandSync("git", ["add", "-A"], { cwd: worktreeDir });
   781→    if (!addResult.ok) {
   782→      throw new Error(addResult.stderr || "git add failed");
   783→    }
   784→
   785→    // Check if there are staged changes
   786→    try {
   787→      if (debug) {
   788→        console.error(`[DEBUG] Shadow auto-commit: git diff --cached --quiet`);
   789→      }
   790→
   791→      const diffResult = runCommandSync(
   792→        "git",
   793→        ["diff", "--cached", "--quiet"],
   794→        { cwd: worktreeDir },
   795→      );
   796→      if (!diffResult.ok) {
   797→        throw new Error("changes staged");
   798→      }
   799→      // No error = no changes
   800→      if (debug) {
   801→        console.error(`[DEBUG] Shadow auto-commit: No changes to commit`);
   802→      }
   803→      return false;
   804→    } catch {
   805→      // Error = there are changes, proceed with commit
   806→    }
   807→
   808→    if (debug) {
   809→      console.error(`[DEBUG] Shadow auto-commit: git commit -m "${message}"`);
   810→    }
   811→
   812→    // Commit with message
   813→    // Set KSPEC_SHADOW_COMMIT=1 to signal authorized commit to git hooks
   814→    const commitResult = runCommandSync("git", ["commit", "-m", message], {
   815→      cwd: worktreeDir,
   816→      env: { ...process.env, KSPEC_SHADOW_COMMIT: "1" },
   817→    });
   818→    if (!commitResult.ok) {
   819→      throw new Error(commitResult.stderr || "git commit failed");
   820→    }
   821→
   822→    if (debug) {
   823→      console.error(`[DEBUG] Shadow auto-commit: Success`);
   824→    }
   825→
   826→    return true;
   827→  } catch (error) {
   828→    // AC: Only log error if debug mode enabled
   829→    if (debug) {
   830→      console.error("Shadow auto-commit failed:", error);
   831→    }
   832→    return false;
   833→  }
   834→}
   835→
   836→/**
   837→ * Generate commit message for a kspec operation.
   838→ */
   839→export function generateCommitMessage(
   840→  operation: string,
   841→  ref?: string,
   842→  detail?: string,
   843→): string {
   844→  const parts: string[] = [];
   845→
   846→  switch (operation) {
   847→    case "task-start":
   848→      parts.push(`Start @${ref}`);
   849→      break;
   850→    case "task-complete":
   851→      parts.push(`Complete @${ref}`);
   852→      if (detail) parts.push(`: ${detail}`);
   853→      break;
   854→    case "task-note":
   855→      parts.push(`Note on @${ref}`);
   856→      break;
   857→    case "task-add":
   858→      parts.push(`Add task: ${detail || ref}`);
   859→      break;
   860→    case "inbox-add":
   861→      parts.push(
   862→        `Inbox: ${detail?.slice(0, 50)}${(detail?.length || 0) > 50 ? "..." : ""}`,
   863→      );
   864→      break;
   865→    case "inbox-promote":
   866→      parts.push(`Promote to @${ref}`);
   867→      break;
   868→    case "item-add":
   869→      parts.push(`Add @${ref}`);
   870→      break;
   871→    case "item-set":
   872→      parts.push(`Update @${ref}`);
   873→      break;
   874→    case "item-delete":
   875→      parts.push(`Delete @${ref}`);
   876→      break;
   877→    case "derive":
   878→      parts.push(`Derive from @${ref}`);
   879→      break;
   880→    default:
   881→      parts.push(operation);
   882→      if (ref) parts.push(` @${ref}`);
   883→  }
   884→
   885→  return parts.join("");
   886→}
   887→
   888→/**
   889→ * Resolve a path relative to shadow worktree if enabled.
   890→ * Falls back to original path if shadow is not enabled.
   891→ *
   892→ * Uses the worktreeDir from shadowConfig for custom directory support.
   893→ */
   894→export function resolveShadowPath(
   895→  originalPath: string,
   896→  shadowConfig: ShadowConfig | null,
   897→  projectRoot: string,
   898→): string {
   899→  if (!shadowConfig?.enabled) {
   900→    return originalPath;
   901→  }
   902→
   903→  // If the path is within the project root, rewrite to shadow worktree
   904→  const relativePath = path.relative(projectRoot, originalPath);
   905→
   906→  // Get the directory name from the worktree path (supports custom directories)
   907→  const worktreeDirName = path.basename(shadowConfig.worktreeDir);
   908→
   909→  // Skip if path is outside project or already in shadow worktree
   910→  if (
   911→    relativePath.startsWith("..") ||
   912→    relativePath.startsWith(worktreeDirName)
   913→  ) {
   914→    return originalPath;
   915→  }
   916→
   917→  // Handle spec/ -> shadow worktree mapping
   918→  if (relativePath.startsWith("spec/") || relativePath.startsWith("spec\\")) {
   919→    const specRelative = relativePath.slice(5); // Remove 'spec/'
   920→    return path.join(shadowConfig.worktreeDir, specRelative);
   921→  }
   922→
   923→  // For task/inbox files at root, move to shadow worktree
   924→  if (
   925→    relativePath.endsWith(".tasks.yaml") ||
   926→    relativePath.endsWith(".inbox.yaml")
   927→  ) {
   928→    return path.join(shadowConfig.worktreeDir, relativePath);
   929→  }
   930→
   931→  return originalPath;
   932→}
   933→
   934→/**
   935→ * Commit changes to shadow branch if enabled.
   936→ * This is the primary interface for CLI commands to trigger auto-commit.
   937→ *
   938→ * @param shadowConfig Shadow configuration (from KspecContext.shadow)
   939→ * @param operation Operation type (e.g., 'task-start', 'task-complete')
   940→ * @param ref Reference slug or ULID (optional)
   941→ * @param detail Additional detail for commit message (optional)
   942→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   943→ * @returns true if committed, false if shadow not enabled or nothing to commit
   944→ */
   945→export async function commitIfShadow(
   946→  shadowConfig: ShadowConfig | null,
   947→  operation: string,
   948→  ref?: string,
   949→  detail?: string,
   950→  verbose?: boolean,
   951→): Promise<boolean> {
   952→  // Suppress auto-commits during atomic batch execution
   953→  if (isBatchMode()) {
   954→    return false;
   955→  }
   956→
   957→  if (!shadowConfig?.enabled) {
   958→    return false;
   959→  }
   960→
   961→  const message = generateCommitMessage(operation, ref, detail);
   962→  const committed = await shadowAutoCommit(
   963→    shadowConfig.worktreeDir,
   964→    message,
   965→    verbose,
   966→  );
   967→
   968→  // AC: @shadow-sync ac-1 - Fire-and-forget push after each commit
   969→  if (committed) {
   970→    shadowPushAsync(shadowConfig.worktreeDir, verbose);
   971→  }
   972→
   973→  return committed;
   974→}
   975→
   976→/**
   977→ * Check if shadow is required but not available, and throw appropriate error.
   978→ * Use this at the start of commands that require shadow mode.
   979→ *
   980→ * @param shadowConfig Shadow configuration from context
   981→ * @param projectRoot Project root for status check
   982→ * @throws ShadowError if shadow is not properly configured
   983→ */
   984→export async function requireShadow(
   985→  shadowConfig: ShadowConfig | null,
   986→  projectRoot: string,
   987→): Promise<void> {
   988→  if (shadowConfig?.enabled) {
   989→    return; // Shadow is available
   990→  }
   991→
   992→  const status = await getShadowStatus(projectRoot);
   993→  throw createShadowError(status);
   994→}
   995→
   996→/**
   997→ * Format a ShadowError for display in CLI.
   998→ * Returns a user-friendly message with suggestion.
   999→ */
  1000→export function formatShadowError(error: ShadowError): string {
  1001→  return `${error.message}\n\nSuggestion: ${error.suggestion}`;
  1002→}
  1003→
  1004→/**
  1005→ * Result from shadow initialization
  1006→ */
  1007→export interface ShadowInitResult {
  1008→  success: boolean;
  1009→  branchCreated: boolean;
  1010→  worktreeCreated: boolean;
  1011→  gitignoreUpdated: boolean;
  1012→  initialCommit: boolean;
  1013→  alreadyExists: boolean;
  1014→  /** Whether shadow was created from existing remote branch */
  1015→  createdFromRemote: boolean;
  1016→  /** Whether new branch was pushed to remote to establish tracking */
  1017→  pushedToRemote: boolean;
  1018→  /** Whether .kspec-sessions/ directory was created */
  1019→  sessionsDirectoryCreated?: boolean;
  1020→  error?: string;
  1021→}
  1022→
  1023→/**
  1024→ * Options for shadow initialization.
  1025→ *
  1026→ * AC: @config-shadow ac-1 ac-2 — branch and directory configurable
  1027→ */
  1028→export interface ShadowInitOptions {
  1029→  /** Project name for manifest */
  1030→  projectName?: string;
  1031→  /** Force reinitialize even if exists */
  1032→  force?: boolean;
  1033→  /** Shadow branch/directory/remote configuration */
  1034→  shadow?: ShadowOptions;
  1035→}
  1036→
  1037→/**
  1038→ * Check if a remote exists (default: origin)
  1039→ */
  1040→export async function hasRemote(
  1041→  projectRoot: string,
  1042→  remoteName = "origin",
  1043→): Promise<boolean> {
  1044→  try {
  1045→    const { stdout } = await runGitAsync(projectRoot, [
  1046→      "remote",
  1047→      "get-url",
  1048→      remoteName,
  1049→    ]);
  1050→    return stdout.trim().length > 0;
  1051→  } catch {
  1052→    return false;
  1053→  }
  1054→}
  1055→
  1056→/**
  1057→ * Check if a branch exists on a remote.
  1058→ * Uses git ls-remote to query the remote directly, which works in both
  1059→ * full and shallow clones.
  1060→ *
  1061→ * AC: @shadow-init-remote ac-5 — works in shallow clones
  1062→ */
  1063→export async function remoteBranchExists(
  1064→  projectRoot: string,
  1065→  branchName: string,
  1066→  remoteName = "origin",
  1067→): Promise<boolean> {
  1068→  try {
  1069→    const { stdout } = await runGitAsync(projectRoot, [
  1070→      "ls-remote",
  1071→      "--heads",
  1072→      remoteName,
  1073→      branchName,
  1074→    ]);
  1075→    return stdout.trim().length > 0;
  1076→  } catch {
  1077→    return false;
  1078→  }
  1079→}
  1080→
  1081→/**
  1082→ * Fetch from remote to ensure refs are up to date.
  1083→ * Returns true if fetch succeeded, false otherwise.
  1084→ */
  1085→export async function fetchRemote(
  1086→  projectRoot: string,
  1087→  remoteName = "origin",
  1088→): Promise<boolean> {
  1089→  try {
  1090→    await runGitAsync(projectRoot, ["fetch", remoteName]);
  1091→    return true;
  1092→  } catch {
  1093→    return false;
  1094→  }
  1095→}
  1096→
  1097→/**
  1098→ * Push shadow branch to remote with tracking.
  1099→ * Returns true if push succeeded, false otherwise.
  1100→ *
  1101→ * AC: @config-shadow ac-3 — uses configured remote name
  1102→ * AC: @config-shadow ac-7 — defaults to origin when not provided
  1103→ *
  1104→ * @param worktreeDir Path to shadow worktree
  1105→ * @param remoteName Remote name (default: origin)
  1106→ * @param options Optional shadow configuration
  1107→ */
  1108→export async function pushShadowBranch(
  1109→  worktreeDir: string,
  1110→  remoteName = "origin",
  1111→  options?: ShadowOptions,
  1112→): Promise<boolean> {
  1113→  const branchName = getBranchName(options);
  1114→  try {
  1115→    await runGitAsync(worktreeDir, ["push", "-u", remoteName, branchName]);
  1116→    return true;
  1117→  } catch {
  1118→    return false;
  1119→  }
  1120→}
  1121→
  1122→/**
  1123→ * Check if shadow branch has remote tracking configured.
  1124→ * AC-4: Used to determine whether sync should be attempted.
  1125→ *
  1126→ * AC: @config-shadow ac-7 — backward compat when called without config
  1127→ *
  1128→ * @param worktreeDir Path to shadow worktree
  1129→ * @param options Optional shadow configuration
  1130→ */
  1131→export async function hasRemoteTracking(
  1132→  worktreeDir: string,
  1133→  options?: ShadowOptions,
  1134→): Promise<boolean> {
  1135→  const branchName = getBranchName(options);
  1136→  try {
  1137→    const { stdout } = await runGitAsync(worktreeDir, [
  1138→      "config",
  1139→      `branch.${branchName}.remote`,
  1140→    ]);
  1141→    return stdout.trim().length > 0;
  1142→  } catch {
  1143→    return false;
  1144→  }
  1145→}
  1146→
  1147→/**
  1148→ * Ensure shadow branch has remote tracking configured.
  1149→ * AC-8: If shadow has no tracking but main branch has origin remote,
  1150→ * automatically configure tracking to origin/kspec-meta.
  1151→ *
  1152→ * AC: @config-shadow ac-3 ac-4 ac-5 — handles different remote types
  1153→ * AC: @config-shadow ac-6 — error with guidance if named remote doesn't exist
  1154→ * AC: @config-shadow ac-7 — backward compat when called without config
  1155→ *
  1156→ * @param worktreeDir Path to shadow worktree
  1157→ * @param projectRoot Git repository root
  1158→ * @param options Optional shadow configuration
  1159→ * @returns Result with success status and error details if applicable
  1160→ */
  1161→export async function ensureRemoteTracking(
  1162→  worktreeDir: string,
  1163→  projectRoot: string,
  1164→  options?: ShadowOptions,
  1165→): Promise<EnsureRemoteTrackingResult> {
  1166→  const branchName = getBranchName(options);
  1167→
  1168→  // Check if already has tracking
  1169→  if (await hasRemoteTracking(worktreeDir, options)) {
  1170→    return { success: true };
  1171→  }
  1172→
  1173→  // Determine remote name to use
  1174→  let remoteName = "origin";
  1175→
  1176→  if (options?.remote) {
  1177→    const remoteType = options.remoteType ?? "named";
  1178→
  1179→    if (remoteType === "named") {
  1180→      // AC: ac-3 — use the named remote directly
  1181→      remoteName = options.remote;
  1182→
  1183→      // AC: ac-6 — verify the named remote exists with guidance
  1184→      if (!(await hasRemote(projectRoot, remoteName))) {
  1185→        // Named remote doesn't exist - provide helpful guidance
  1186→        return {
  1187→          success: false,
  1188→          missingRemote: remoteName,
  1189→          guidance: `Remote '${remoteName}' does not exist. To fix this:\n` +
  1190→            `  1. Add the remote: git remote add ${remoteName} <url>\n` +
  1191→            `  2. Or update kspec.config.yaml to use an existing remote\n` +
  1192→            `  3. Or remove shadow.remote to use the default 'origin' remote`,
  1193→        };
  1194→      }
  1195→    } else if (remoteType === "path" || remoteType === "url") {
  1196→      // AC: ac-4 ac-5 — add a git remote for path/URL if not already present
  1197→      const specRemoteName = "kspec-specs";
  1198→      const hasSpecsRemote = await hasRemote(projectRoot, specRemoteName);
  1199→
  1200→      if (!hasSpecsRemote) {
  1201→        try {
  1202→          // Expand tilde for paths if needed
  1203→          let remoteTarget = options.remote;
  1204→          if (remoteType === "path" && remoteTarget.startsWith("~")) {
  1205→            remoteTarget = remoteTarget.replace(
  1206→              /^~/,
  1207→              process.env.HOME || process.env.USERPROFILE || "~",
  1208→            );
  1209→          }
  1210→
  1211→          await runGitAsync(projectRoot, [
  1212→            "remote",
  1213→            "add",
  1214→            specRemoteName,
  1215→            remoteTarget,
  1216→          ]);
  1217→        } catch {
  1218→          // Remote add failed - may already exist with different URL
  1219→          return { success: false };
  1220→        }
  1221→      }
  1222→
  1223→      remoteName = specRemoteName;
  1224→    }
  1225→  } else {
  1226→    // No remote configured - check if main branch has origin
  1227→    if (!(await hasRemote(projectRoot))) {
  1228→      return { success: false };
  1229→    }
  1230→  }
  1231→
  1232→  // Set up tracking for shadow branch
  1233→  try {
  1234→    await runGitAsync(worktreeDir, [
  1235→      "config",
  1236→      `branch.${branchName}.remote`,
  1237→      remoteName,
  1238→    ]);
  1239→    await runGitAsync(worktreeDir, [
  1240→      "config",
  1241→      `branch.${branchName}.merge`,
  1242→      `refs/heads/${branchName}`,
  1243→    ]);
  1244→    return { success: true };
  1245→  } catch {
  1246→    return { success: false };
  1247→  }
  1248→}
  1249→
  1250→/**
  1251→ * Result from ensuring remote tracking
  1252→ * AC: @config-shadow ac-6 — includes error details when named remote doesn't exist
  1253→ */
  1254→export interface EnsureRemoteTrackingResult {
  1255→  success: boolean;
  1256→  /** Error when remote doesn't exist (AC-6) */
  1257→  missingRemote?: string;
  1258→  /** Guidance message for user */
  1259→  guidance?: string;
  1260→}
  1261→
  1262→/**
  1263→ * Result from a sync operation
  1264→ */
  1265→export interface ShadowSyncResult {
  1266→  success: boolean;
  1267→  pulled: boolean;
  1268→  pushed: boolean;
  1269→  hadConflict: boolean;
  1270→  error?: string;
  1271→}
  1272→
  1273→const SHADOW_PUSH_FAILURE_ESCALATION_THRESHOLD = 3;
  1274→const shadowPushFailureCounts = new Map<string, number>();
  1275→
  1276→function summarizeShadowPushError(
  1277→  stderr: string,
  1278→  code: number | null,
  1279→  signal: NodeJS.Signals | null,
  1280→): string {
  1281→  const lines = stderr
  1282→    .split(/\r?\n/)
  1283→    .map((line) => line.trim())
  1284→    .filter(Boolean);
  1285→
  1286→  if (lines.length > 0) {
  1287→    const lastLine = lines[lines.length - 1];
  1288→    if (lastLine.length <= 240) {
  1289→      return lastLine;
  1290→    }
  1291→    return `${lastLine.slice(0, 237)}...`;
  1292→  }
  1293→
  1294→  if (code !== null) {
  1295→    return `git push exited with code ${code}`;
  1296→  }
  1297→  if (signal) {
  1298→    return `git push terminated by signal ${signal}`;
  1299→  }
  1300→  return "git push failed";
  1301→}
  1302→
  1303→function noteShadowPushFailure(worktreeDir: string, reason: string): void {
  1304→  const nextCount = (shadowPushFailureCounts.get(worktreeDir) ?? 0) + 1;
  1305→  shadowPushFailureCounts.set(worktreeDir, nextCount);
  1306→
  1307→  console.error(
  1308→    `[WARN] Shadow auto-push failed (consecutive: ${nextCount}). Local shadow commits were kept. ${reason}`,
  1309→  );
  1310→
  1311→  if (nextCount >= SHADOW_PUSH_FAILURE_ESCALATION_THRESHOLD) {
  1312→    console.error(
  1313→      `[WARN] Shadow auto-push has failed ${nextCount} times in a row. Remote shadow state is stale. Run \`kspec shadow sync\` (or \`kspec shadow resolve\` if conflicts are reported).`,
  1314→    );
  1315→  }
  1316→}
  1317→
  1318→function noteShadowPushSuccess(worktreeDir: string): void {
  1319→  shadowPushFailureCounts.delete(worktreeDir);
  1320→}
  1321→
  1322→/**
  1323→ * Pull-rebase from remote before pushing, using the kspec merge driver for
  1324→ * YAML conflict resolution.
  1325→ *
  1326→ * AC: @config-shadow ac-11 — pull-rebase before push prevents divergence
  1327→ *
  1328→ * @returns true if pull succeeded (or was unnecessary), false on conflict
  1329→ */
  1330→async function pullRebaseBeforePush(
  1331→  worktreeDir: string,
  1332→  branchName: string,
  1333→  debug: boolean,
  1334→  options?: ShadowOptions,
  1335→): Promise<boolean> {
  1336→  try {
  1337→    // Fetch latest remote state for the shadow branch specifically.
  1338→    // Using the worktree dir for fetch ensures we use the branch's tracking config.
  1339→    try {
  1340→      await runGitAsync(worktreeDir, ["fetch"]);
  1341→    } catch {
  1342→      if (debug) {
  1343→        console.error("[DEBUG] Shadow pull-rebase: fetch failed, skipping pull");
  1344→      }
  1345→      // Fetch failure is non-fatal — push may still succeed if already up to date
  1346→      return true;
  1347→    }
  1348→
  1349→    // AC: @config-shadow ac-3 — resolve the configured remote name from git config
  1350→    // instead of hardcoding "origin", so custom shadow.remote setups work correctly
  1351→    const projectRoot = path.dirname(worktreeDir);
  1352→    let remoteName = "origin";
  1353→    try {
  1354→      const { stdout } = await runGitAsync(worktreeDir, [
  1355→        "config",
  1356→        `branch.${branchName}.remote`,
  1357→      ]);
  1358→      const configured = stdout.trim();
  1359→      if (configured) {
  1360→        remoteName = configured;
  1361→      }
  1362→    } catch {
  1363→      // Fall back to origin if config lookup fails
  1364→    }
  1365→
  1366→    const remoteHasBranch = await remoteBranchExists(projectRoot, branchName, remoteName);
  1367→    if (!remoteHasBranch) {
  1368→      if (debug) {
  1369→        console.error("[DEBUG] Shadow pull-rebase: no remote branch yet, skipping pull");
  1370→      }
  1371→      return true;
  1372→    }
  1373→
  1374→    // Check if there are any upstream changes to integrate.
  1375→    // If local is already at or ahead of remote, skip the pull.
  1376→    try {
  1377→      const { stdout } = await runGitAsync(worktreeDir, [
  1378→        "rev-list",
  1379→        "--count",
  1380→        `${branchName}..@{upstream}`,
  1381→      ]);
  1382→      const behindCount = parseInt(stdout.trim(), 10);
  1383→      if (behindCount === 0) {
  1384→        if (debug) {
  1385→          console.error("[DEBUG] Shadow pull-rebase: already up to date with remote");
  1386→        }
  1387→        return true;
  1388→      }
  1389→    } catch {
  1390→      // rev-list may fail if upstream isn't set — proceed with pull attempt
  1391→    }
  1392→
  1393→    // Try fast-forward first (cleanest, no rebase needed)
  1394→    try {
  1395→      await runGitAsync(worktreeDir, ["pull", "--ff-only"]);
  1396→      if (debug) {
  1397→        console.error("[DEBUG] Shadow pull-rebase: fast-forward succeeded");
  1398→      }
  1399→      return true;
  1400→    } catch {
  1401→      // FF failed, need rebase
  1402→    }
  1403→
  1404→    // Fall back to rebase — the kspec merge driver handles YAML conflicts
  1405→    try {
  1406→      await runGitAsync(worktreeDir, ["pull", "--rebase"]);
  1407→      if (debug) {
  1408→        console.error("[DEBUG] Shadow pull-rebase: rebase succeeded");
  1409→      }
  1410→      return true;
  1411→    } catch {
  1412→      // Rebase failed — abort and report
  1413→    }
  1414→
  1415→    // Abort the failed rebase so local state is clean
  1416→    try {
  1417→      await runGitAsync(worktreeDir, ["rebase", "--abort"]);
  1418→    } catch {
  1419→      // May not be in rebase state
  1420→    }
  1421→
  1422→    if (debug) {
  1423→      console.error("[DEBUG] Shadow pull-rebase: conflict detected, push skipped");
  1424→    }
  1425→    return false;
  1426→  } catch (err) {
  1427→    if (debug) {
  1428→      console.error("[DEBUG] Shadow pull-rebase error:", err);
  1429→    }
  1430→    // Pull failure is non-fatal — still attempt push
  1431→    return true;
  1432→  }
  1433→}
  1434→
  1435→/**
  1436→ * Fire-and-forget push to remote with pull-rebase-before-push.
  1437→ * AC-1: Called after each auto-commit when tracking is configured.
  1438→ * AC-8: Automatically sets up tracking if main branch has remote.
  1439→ * AC: @config-shadow ac-11 — pull-rebase before push for bidirectional sync.
  1440→ * Push failures are surfaced as warnings, but local commits still succeed.
  1441→ *
  1442→ * AC: @config-shadow ac-7 — backward compat when called without config
  1443→ *
  1444→ * @param worktreeDir Path to shadow worktree
  1445→ * @param verbose Enable debug output
  1446→ * @param options Optional shadow configuration
  1447→ */
  1448→export async function shadowPushAsync(
  1449→  worktreeDir: string,
  1450→  verbose?: boolean,
  1451→  options?: ShadowOptions,
  1452→): Promise<void> {
  1453→  const debug = isDebugMode(verbose);
  1454→
  1455→  // AC: @shadow-sync ac-8 - Auto-configure tracking if main has remote but shadow doesn't
  1456→  const projectRoot = path.dirname(worktreeDir);
  1457→  const trackingResult = await ensureRemoteTracking(worktreeDir, projectRoot, options);
  1458→
  1459→  // AC: @config-shadow ac-6 — log guidance if named remote doesn't exist
  1460→  if (!trackingResult.success && trackingResult.missingRemote) {
  1461→    if (debug) {
  1462→      console.error(`[DEBUG] Shadow push: ${trackingResult.guidance}`);
  1463→    }
  1464→    return;
  1465→  }
  1466→
  1467→  // Check if tracking is configured before attempting push
  1468→  if (!(await hasRemoteTracking(worktreeDir, options))) {
  1469→    if (debug) {
  1470→      console.error(
  1471→        "[DEBUG] Shadow push: No remote tracking configured, skipping",
  1472→      );
  1473→    }
  1474→    return; // AC: @shadow-sync ac-4 - silently skip if no tracking
  1475→  }
  1476→
  1477→  // AC: @config-shadow ac-11 — pull-rebase before pushing to integrate remote changes
  1478→  const branchName = getBranchName(options);
  1479→  const pullOk = await pullRebaseBeforePush(worktreeDir, branchName, debug, options);
  1480→  if (!pullOk) {
  1481→    noteShadowPushFailure(
  1482→      worktreeDir,
  1483→      "Pull-rebase failed due to conflicts. Run `kspec shadow resolve` to fix.",
  1484→    );
  1485→    return;
  1486→  }
  1487→
  1488→  try {
  1489→    if (debug) {
  1490→      console.error(`[DEBUG] Shadow push: git push (cwd: ${worktreeDir})`);
  1491→    }
  1492→
  1493→    // Fire and forget: detached + unref allows CLI exit without waiting for push.
  1494→    // We still collect stderr and exit code while process is alive to surface failures.
  1495→    const child = spawn("git", ["push"], {
  1496→      cwd: worktreeDir,
  1497→      stdio: ["ignore", "ignore", "pipe"],
  1498→      detached: true,
  1499→    });
  1500→
  1501→    const stderrChunks: string[] = [];
  1502→    child.stderr?.setEncoding("utf-8");
  1503→    child.stderr?.on("data", (chunk) => {
  1504→      stderrChunks.push(chunk);
  1505→    });
  1506→    child.stderr?.resume();
  1507→
  1508→    (child.stderr as { unref?: () => void } | null)?.unref?.();
  1509→    child.unref();
  1510→    if (debug) {
  1511→      console.error("[DEBUG] Shadow push: spawned background git push");
  1512→    }
  1513→
  1514→    const exit = await new Promise<{
  1515→      code: number | null;
  1516→      signal: NodeJS.Signals | null;
  1517→      error?: Error;
  1518→    }>((resolve) => {
  1519→      let settled = false;
  1520→      const finish = (result: {
  1521→        code: number | null;
  1522→        signal: NodeJS.Signals | null;
  1523→        error?: Error;
  1524→      }) => {
  1525→        if (settled) {
  1526→          return;
  1527→        }
  1528→        settled = true;
  1529→        resolve(result);
  1530→      };
  1531→
  1532→      child.once("error", (error) => finish({ code: null, signal: null, error }));
  1533→      child.once("close", (code, signal) => finish({ code, signal }));
  1534→    });
  1535→
  1536→    if (exit.error) {
  1537→      noteShadowPushFailure(worktreeDir, exit.error.message);
  1538→      if (debug) {
  1539→        console.error("[DEBUG] Shadow push spawn error:", exit.error);
  1540→      }
  1541→      return;
  1542→    }
  1543→
  1544→    if (exit.code !== 0) {
  1545→      const reason = summarizeShadowPushError(
  1546→        stderrChunks.join(""),
  1547→        exit.code,
  1548→        exit.signal,
  1549→      );
  1550→      noteShadowPushFailure(worktreeDir, reason);
  1551→      return;
  1552→    }
  1553→
  1554→    noteShadowPushSuccess(worktreeDir);
  1555→  } catch (err) {
  1556→    const reason = err instanceof Error ? err.message : String(err);
  1557→    noteShadowPushFailure(worktreeDir, reason);
  1558→
  1559→    if (debug) {
  1560→      console.error("[DEBUG] Shadow push error:", err);
  1561→    }
  1562→  }
  1563→}
  1564→
  1565→/**
  1566→ * Pull remote changes to shadow branch.
  1567→ * AC-2: Called at session start to sync before operations.
  1568→ * AC-6: Uses --ff-only first, falls back to --rebase.
  1569→ * AC-3: On conflict, returns failure with suggestion.
  1570→ * AC-8: Automatically sets up tracking if main branch has remote.
  1571→ *
  1572→ * AC: @config-shadow ac-7 — backward compat when called without config
  1573→ *
  1574→ * @param worktreeDir Path to shadow worktree
  1575→ * @param options Optional shadow configuration
  1576→ */
  1577→// In-flight dedup: if a pull is already running for this worktree, piggyback
  1578→// on its result instead of starting a concurrent stash/pull/pop sequence.
  1579→const pullInflight = new Map<string, Promise<ShadowSyncResult>>();
  1580→
  1581→export function shadowPull(
  1582→  worktreeDir: string,
  1583→  options?: ShadowOptions,
  1584→): Promise<ShadowSyncResult> {
  1585→  const key = path.resolve(worktreeDir);
  1586→  const existing = pullInflight.get(key);
  1587→  if (existing) {
  1588→    return existing;
  1589→  }
  1590→  const promise = shadowPullImpl(worktreeDir, options).finally(() => {
  1591→    pullInflight.delete(key);
  1592→  });
  1593→  pullInflight.set(key, promise);
  1594→  return promise;
  1595→}
  1596→
  1597→async function shadowPullImpl(
  1598→  worktreeDir: string,
  1599→  options?: ShadowOptions,
  1600→): Promise<ShadowSyncResult> {
  1601→  const branchName = getBranchName(options);
  1602→  const result: ShadowSyncResult = {
  1603→    success: false,
  1604→    pulled: false,
  1605→    pushed: false,
  1606→    hadConflict: false,
  1607→  };
  1608→
  1609→  // AC: @shadow-sync ac-8 - Auto-configure tracking if main has remote but shadow doesn't
  1610→  const projectRoot = path.dirname(worktreeDir);
  1611→  const trackingResult = await ensureRemoteTracking(worktreeDir, projectRoot, options);
  1612→
  1613→  // AC: @config-shadow ac-6 — error with guidance if named remote doesn't exist
  1614→  if (!trackingResult.success && trackingResult.missingRemote) {
  1615→    result.error = trackingResult.guidance;
  1616→    return result;
  1617→  }
  1618→
  1619→  // AC: @shadow-sync ac-4 - Skip if no remote tracking
  1620→  if (!(await hasRemoteTracking(worktreeDir, options))) {
  1621→    result.success = true;
  1622→    return result;
  1623→  }
  1624→
  1625→  // Check if remote branch exists before attempting pull
  1626→  // AC: @config-shadow ac-3 — use configured remote instead of hardcoded origin
  1627→  const remoteName = getRemoteName(options);
  1628→  // Fetch first to ensure refs are up to date
  1629→  await fetchRemote(projectRoot, remoteName);
  1630→  const remoteHasBranch = await remoteBranchExists(projectRoot, branchName, remoteName);
  1631→  if (!remoteHasBranch) {
  1632→    // Remote branch doesn't exist yet - nothing to pull, but success
  1633→    result.success = true;
  1634→    return result;
  1635→  }
  1636→
  1637→  // Stash uncommitted changes before pulling to avoid false conflict reports
  1638→  let stashed = false;
  1639→  try {
  1640→    const { stdout } = await runGitAsync(worktreeDir, ["stash", "push", "-m", "shadow-sync-auto"]);
  1641→    stashed = !stdout.includes("No local changes");
  1642→  } catch {
  1643→    // If stash fails, skip the pull entirely — don't risk reporting a false conflict
  1644→    result.success = true;
  1645→    return result;
  1646→  }
  1647→
  1648→  const unstash = async () => {
  1649→    if (stashed) {
  1650→      try {
  1651→        await runGitAsync(worktreeDir, ["stash", "pop"]);
  1652→      } catch {
  1653→        // Stash pop conflict is unlikely but leave stash intact if it happens
  1654→      }
  1655→    }
  1656→  };
  1657→
  1658→  try {
  1659→    // Try fast-forward only first (cleanest)
  1660→    await runGitAsync(worktreeDir, ["pull", "--ff-only"]);
  1661→    await unstash();
  1662→    result.success = true;
  1663→    result.pulled = true;
  1664→    return result;
  1665→  } catch {
  1666→    // Fast-forward failed, try rebase
  1667→  }
  1668→
  1669→  try {
  1670→    // AC: @shadow-sync ac-6 - Fall back to rebase
  1671→    await runGitAsync(worktreeDir, ["pull", "--rebase"]);
  1672→    await unstash();
  1673→    result.success = true;
  1674→    result.pulled = true;
  1675→    return result;
  1676→  } catch {
  1677→    // Rebase failed - likely conflict
  1678→  }
  1679→
  1680→  // AC: @shadow-sync ac-3 - Conflict detected - abort rebase and report
  1681→  try {
  1682→    await runGitAsync(worktreeDir, ["rebase", "--abort"]);
  1683→  } catch {
  1684→    // May not be in rebase state, ignore
  1685→  }
  1686→
  1687→  await unstash();
  1688→  result.hadConflict = true;
  1689→  result.error = "Sync conflict detected. Run `kspec shadow resolve` to fix.";
  1690→  return result;
  1691→}
  1692→
  1693→/**
  1694→ * Full sync operation: pull then push.
  1695→ * Used by session start and explicit sync commands.
  1696→ *
  1697→ * AC: @config-shadow ac-7 — backward compat when called without config
  1698→ *
  1699→ * @param worktreeDir Path to shadow worktree
  1700→ * @param options Optional shadow configuration
  1701→ */
  1702→export async function shadowSync(
  1703→  worktreeDir: string,
  1704→  options?: ShadowOptions,
  1705→): Promise<ShadowSyncResult> {
  1706→  // First pull
  1707→  const pullResult = await shadowPull(worktreeDir, options);
  1708→  if (!pullResult.success) {
  1709→    return pullResult;
  1710→  }
  1711→
  1712→  // Then push (only if tracking configured, checked inside)
  1713→  if (await hasRemoteTracking(worktreeDir, options)) {
  1714→    try {
  1715→      await runGitAsync(worktreeDir, ["push"]);
  1716→      pullResult.pushed = true;
  1717→    } catch {
  1718→      // Push failed - not a critical error, local state is correct
  1719→      // Could be permissions, network, etc.
  1720→    }
  1721→  }
  1722→
  1723→  return pullResult;
  1724→}
  1725→
  1726→/**
  1727→ * Check if .gitignore has uncommitted changes
  1728→ */
  1729→async function hasUncommittedGitignore(projectRoot: string): Promise<boolean> {
  1730→  try {
  1731→    // Check both staged and unstaged changes to .gitignore
  1732→    const { stdout } = await runGitAsync(projectRoot, [
  1733→      "status",
  1734→      "--porcelain",
  1735→      ".gitignore",
  1736→    ]);
  1737→    return stdout.trim().length > 0;
  1738→  } catch {
  1739→    return false;
  1740→  }
  1741→}
  1742→
  1743→/**
  1744→ * Commit only .gitignore with a message.
  1745→ *
  1746→ * @param projectRoot Git repository root
  1747→ * @param directoryName Shadow directory name (for commit message)
  1748→ */
  1749→async function commitGitignore(
  1750→  projectRoot: string,
  1751→  directoryName: string,
  1752→): Promise<void> {
  1753→  await runGitAsync(projectRoot, ["add", ".gitignore"]);
  1754→  await runGitAsync(projectRoot, [
  1755→    "commit",
  1756→    "-m",
  1757→    `chore: add ${directoryName}/ to .gitignore for shadow branch`,
  1758→  ]);
  1759→}
  1760→
  1761→/**
  1762→ * Add shadow directory to .gitignore if not already present.
  1763→ * Fails if .gitignore has uncommitted changes.
  1764→ * Commits the change after adding.
  1765→ *
  1766→ * AC: @config-shadow ac-2 — uses configured directory name
  1767→ * AC: @config-shadow ac-7 — defaults to .kspec when not provided
  1768→ *
  1769→ * @param projectRoot Git repository root
  1770→ * @param options Optional shadow configuration
  1771→ */
  1772→async function ensureGitignore(
  1773→  projectRoot: string,
  1774→  options?: ShadowOptions,
  1775→): Promise<boolean> {
  1776→  const directoryName = getDirectoryName(options);
  1777→  const gitignorePath = path.join(projectRoot, ".gitignore");
  1778→  const entry = `${directoryName}/`;
  1779→
  1780→  // Fail fast if .gitignore has uncommitted changes
  1781→  if (await hasUncommittedGitignore(projectRoot)) {
  1782→    throw new ShadowError(
  1783→      ".gitignore has uncommitted changes",
  1784→      "GIT_ERROR",
  1785→      "Commit or stash your .gitignore changes before running kspec init.",
  1786→    );
  1787→  }
  1788→
  1789→  try {
  1790→    let content = "";
  1791→    try {
  1792→      content = await fs.readFile(gitignorePath, "utf-8");
  1793→    } catch {
  1794→      // File doesn't exist, will create
  1795→    }
  1796→
  1797→    // Check if already present (handle various formats)
  1798→    const lines = content.split("\n");
  1799→    const patterns = [
  1800→      directoryName,
  1801→      `${directoryName}/`,
  1802→      `/${directoryName}`,
  1803→      `/${directoryName}/`,
  1804→    ];
  1805→
  1806→    for (const line of lines) {
  1807→      const trimmed = line.trim();
  1808→      if (patterns.includes(trimmed)) {
  1809→        return false; // Already present
  1810→      }
  1811→    }
  1812→
  1813→    // Add to gitignore
  1814→    const newContent =
  1815→      content.endsWith("\n") || content === ""
  1816→        ? `${content}${entry}\n`
  1817→        : `${content}\n${entry}\n`;
  1818→
  1819→    await fs.writeFile(gitignorePath, newContent, "utf-8");
  1820→
  1821→    // Commit the change
  1822→    await commitGitignore(projectRoot, directoryName);
  1823→
  1824→    return true;
  1825→  } catch (error) {
  1826→    if (error instanceof ShadowError) {
  1827→      throw error;
  1828→    }
  1829→    throw new ShadowError(
  1830→      `Failed to update .gitignore: ${error}`,
  1831→      "GIT_ERROR",
  1832→      "Check file permissions for .gitignore",
  1833→    );
  1834→  }
  1835→}
  1836→
  1837→/**
  1838→ * Add .kspec-sessions/ to root .gitignore if not already present.
  1839→ * Does NOT commit — caller is responsible for committing if needed.
  1840→ *
  1841→ * AC: @session-storage-modes ac-gitignore
  1842→ *
  1843→ * @param projectRoot Git repository root
  1844→ * @returns true if entry was added, false if already present
  1845→ */
  1846→export async function needsSessionsGitignore(
  1847→  projectRoot: string,
  1848→): Promise<boolean> {
  1849→  const gitignorePath = path.join(projectRoot, ".gitignore");
  1850→
  1851→  let content = "";
  1852→  try {
  1853→    content = await fs.readFile(gitignorePath, "utf-8");
  1854→  } catch {
  1855→    // File doesn't exist — entry is needed
  1856→    return true;
  1857→  }
  1858→
  1859→  const lines = content.split("\n");
  1860→  const patterns = [
  1861→    SESSIONS_WORKTREE_DIR,
  1862→    `${SESSIONS_WORKTREE_DIR}/`,
  1863→    `/${SESSIONS_WORKTREE_DIR}`,
  1864→    `/${SESSIONS_WORKTREE_DIR}/`,
  1865→  ];
  1866→
  1867→  for (const line of lines) {
  1868→    const trimmed = line.trim();
  1869→    if (patterns.includes(trimmed)) {
  1870→      return false; // Already present
  1871→    }
  1872→  }
  1873→
  1874→  return true;
  1875→}
  1876→
  1877→export async function ensureSessionsGitignore(
  1878→  projectRoot: string,
  1879→): Promise<boolean> {
  1880→  const gitignorePath = path.join(projectRoot, ".gitignore");
  1881→  const entry = `${SESSIONS_WORKTREE_DIR}/`;
  1882→
  1883→  try {
  1884→    const needed = await needsSessionsGitignore(projectRoot);
  1885→    if (!needed) {
  1886→      return false;
  1887→    }
  1888→
  1889→    let content = "";
  1890→    try {
  1891→      content = await fs.readFile(gitignorePath, "utf-8");
  1892→    } catch {
  1893→      // File doesn't exist, will create
  1894→    }
  1895→
  1896→    // Add to gitignore
  1897→    const newContent =
  1898→      content.endsWith("\n") || content === ""
  1899→        ? `${content}${entry}\n`
  1900→        : `${content}\n${entry}\n`;
  1901→
  1902→    await fs.writeFile(gitignorePath, newContent, "utf-8");
  1903→    return true;
  1904→  } catch (error) {
  1905→    throw new ShadowError(
  1906→      `Failed to update .gitignore with sessions directory: ${error}`,
  1907→      "GIT_ERROR",
  1908→      "Check file permissions for .gitignore",
  1909→    );
  1910→  }
  1911→}
  1912→
  1913→/**
  1914→ * Add sessions/ to .kspec/.gitignore to prevent legacy session data
  1915→ * from being tracked on kspec-meta shadow branch.
  1916→ *
  1917→ * AC: @session-legacy-migration ac-shadow-gitignore
  1918→ *
  1919→ * @param projectRoot Git repository root
  1920→ * @param options Optional shadow configuration for directory name
  1921→ * @returns true if entry was added, false if already present
  1922→ */
  1923→export async function needsShadowSessionsGitignore(
  1924→  projectRoot: string,
  1925→  options?: ShadowOptions,
  1926→): Promise<boolean> {
  1927→  const directoryName = getDirectoryName(options);
  1928→  const shadowGitignorePath = path.join(projectRoot, directoryName, ".gitignore");
  1929→  const entry = "sessions/";
  1930→
  1931→  try {
  1932→    const content = await fs.readFile(shadowGitignorePath, "utf-8");
  1933→    const lines = content.split("\n");
  1934→    if (lines.some((line) => line.trim() === entry || line.trim() === "sessions")) {
  1935→      return false; // Already present
  1936→    }
  1937→    return true;
  1938→  } catch {
  1939→    // File doesn't exist — can't add to non-existent file
  1940→    return false;
  1941→  }
  1942→}
  1943→
  1944→export async function ensureShadowSessionsGitignore(
  1945→  projectRoot: string,
  1946→  options?: ShadowOptions,
  1947→): Promise<boolean> {
  1948→  const directoryName = getDirectoryName(options);
  1949→  const shadowGitignorePath = path.join(projectRoot, directoryName, ".gitignore");
  1950→  const entry = "sessions/";
  1951→
  1952→  try {
  1953→    const needed = await needsShadowSessionsGitignore(projectRoot, options);
  1954→    if (!needed) {
  1955→      return false;
  1956→    }
  1957→
  1958→    let content = "";
  1959→    try {
  1960→      content = await fs.readFile(shadowGitignorePath, "utf-8");
  1961→    } catch {
  1962→      // File doesn't exist — this shouldn't happen since init creates it,
  1963→      // but handle gracefully
  1964→      return false;
  1965→    }
  1966→
  1967→    // Add to gitignore
  1968→    const newContent =
  1969→      content.endsWith("\n") || content === ""
  1970→        ? `${content}${entry}\n`
  1971→        : `${content}\n${entry}\n`;
  1972→
  1973→    await fs.writeFile(shadowGitignorePath, newContent, "utf-8");
  1974→    return true;
  1975→  } catch (error) {
  1976→    // Non-fatal — shadow gitignore update is best-effort
  1977→    return false;
  1978→  }
  1979→}
  1980→
  1981→/**
  1982→ * Generate initial manifest content for shadow branch
  1983→ */
  1984→function generateShadowManifest(projectName: string): string {
  1985→  return `# ${projectName} - Kynetic Spec
  1986→# Generated by kspec init
  1987→
  1988→kynetic: "1.0"
  1989→
  1990→project:
  1991→  name: "${projectName}"
  1992→  version: "0.1.0"
  1993→  status: draft
  1994→  description: |
  1995→    Add your project description here.
  1996→
  1997→# Module includes
  1998→includes:
  1999→  - modules/main.yaml
  2000→`;
  2001→}
  2002→
  2003→/**
  2004→ * Generate initial module content
  2005→ */
  2006→function generateShadowModule(projectName: string): string {
  2007→  return `# ${projectName} - Main Module
  2008→# Add your spec items here
  2009→
  2010→items: []
  2011→`;
  2012→}
  2013→
  2014→/**
  2015→ * Generate initial tasks file
  2016→ */
  2017→function generateShadowTasks(projectName: string): string {
  2018→  return `# ${projectName} - Tasks
  2019→# Track implementation work here
  2020→
  2021→tasks: []
  2022→`;
  2023→}
  2024→
  2025→/**
  2026→ * Generate initial inbox file
  2027→ */
  2028→function generateShadowInbox(): string {
  2029→  return `# Inbox - Quick Capture
  2030→# Ideas and notes that haven't been triaged yet
  2031→
  2032→items: []
  2033→`;
  2034→}
  2035→
  2036→/**
  2037→ * Get the kspec package root directory.
  2038→ * Navigates from dist/parser/ to package root.
  2039→ */
  2040→function getPackageRoot(): string {
  2041→  return path.resolve(__dirname, "..", "..");
  2042→}
  2043→
  2044→/**
  2045→ * Install pre-commit hook to protect kspec-meta branch.
  2046→ * Hook prevents direct commits to shadow branch unless KSPEC_SHADOW_COMMIT=1.
  2047→ *
  2048→ * Note: Git worktrees use hooks from the main .git/hooks directory (via commondir),
  2049→ * not from .git/worktrees/-kspec/hooks. So we install to main hooks directory.
  2050→ *
  2051→ * The hook source is located in the kspec package's templates/hooks/ directory.
  2052→ *
  2053→ * @param projectRoot Git repository root
  2054→ * @returns true if hook was installed, false if already exists
  2055→ */
  2056→async function installShadowHook(projectRoot: string): Promise<boolean> {
  2057→  const hooksDir = path.join(projectRoot, ".git", "hooks");
  2058→  const hookPath = path.join(hooksDir, "pre-commit");
  2059→
  2060→  // Look for hook in package templates directory
  2061→  const packageRoot = getPackageRoot();
  2062→  const sourceHookPath = path.join(packageRoot, "templates", "hooks", "pre-commit");
  2063→
  2064→  try {
  2065→    // Check if source hook exists in package templates
  2066→    try {
  2067→      await fs.access(sourceHookPath);
  2068→    } catch {
  2069→      // Source hook doesn't exist - skip installation
  2070→      return false;
  2071→    }
  2072→
  2073→    // Check if hook already exists
  2074→    try {
  2075→      await fs.access(hookPath);
  2076→      // Hook exists - don't overwrite (user may have custom hooks)
  2077→      return false;
  2078→    } catch {
  2079→      // Hook doesn't exist - install it
  2080→    }
  2081→
  2082→    // Copy hook from package templates
  2083→    const hookContent = await fs.readFile(sourceHookPath, "utf-8");
  2084→    await fs.writeFile(hookPath, hookContent, { mode: 0o755 });
  2085→    return true;
  2086→  } catch (_error) {
  2087→    // Silently fail - hook installation is optional
  2088→    return false;
  2089→  }
  2090→}
  2091→
  2092→/**
  2093→ * Convert project name to slug (kebab-case)
  2094→ */
  2095→function toSlug(projectName: string): string {
  2096→  return projectName
  2097→    .toLowerCase()
  2098→    .replace(/[^a-z0-9]+/g, "-")
  2099→    .replace(/^-|-$/g, "");
  2100→}
  2101→
  2102→/**
  2103→ * Configure git merge driver for kspec YAML files.
  2104→ * AC: @yaml-merge-driver ac-12
  2105→ *
  2106→ * Configures the merge driver in .git/config and adds .gitattributes in the shadow branch.
  2107→ *
  2108→ * @param projectRoot Git repository root
  2109→ * @param worktreeDir Path to shadow worktree directory
  2110→ * @returns true if configuration was successful
  2111→ */
  2112→async function configureMergeDriver(
  2113→  projectRoot: string,
  2114→  worktreeDir: string,
  2115→): Promise<boolean> {
  2116→  try {
  2117→    // Step 1: Configure merge driver in .git/config
  2118→    const kspecPathResult = runCommandSync("which", ["kspec"]);
  2119→    if (!kspecPathResult.ok) {
  2120→      throw new Error(kspecPathResult.stderr || "kspec executable not found");
  2121→    }
  2122→    const kspecPath = kspecPathResult.stdout.trim();
  2123→
  2124→    // Add merge driver configuration to git config
  2125→    try {
  2126→      const setNameResult = runCommandSync(
  2127→        "git",
  2128→        ["config", "merge.kspec.name", "Kspec YAML semantic merge driver"],
  2129→        { cwd: projectRoot },
  2130→      );
  2131→      if (!setNameResult.ok) {
  2132→        throw new Error(setNameResult.stderr || "failed to set merge.kspec.name");
  2133→      }
  2134→
  2135→      const setDriverResult = runCommandSync(
  2136→        "git",
  2137→        [
  2138→          "config",
  2139→          "merge.kspec.driver",
  2140→          `${kspecPath} merge-driver %O %A %B --non-interactive`,
  2141→        ],
  2142→        { cwd: projectRoot },
  2143→      );
  2144→      if (!setDriverResult.ok) {
  2145→        throw new Error(setDriverResult.stderr || "failed to set merge.kspec.driver");
  2146→      }
  2147→    } catch (error) {
  2148→      // Config may fail if already set - check if it's set correctly
  2149→      try {
  2150→        const existingDriverResult = runCommandSync(
  2151→          "git",
  2152→          ["config", "merge.kspec.driver"],
  2153→          { cwd: projectRoot },
  2154→        );
  2155→        if (!existingDriverResult.ok) {
  2156→          throw new Error(existingDriverResult.stderr || "failed to read merge.kspec.driver");
  2157→        }
  2158→        const existingDriver = existingDriverResult.stdout.trim();
  2159→
  2160→        if (!existingDriver.includes("kspec merge-driver")) {
  2161→          throw new Error("Merge driver config exists but is incorrect");
  2162→        }
  2163→
  2164→        // Ensure --non-interactive flag is present (older registrations may lack it)
  2165→        if (!existingDriver.includes("--non-interactive")) {
  2166→          const fixResult = runCommandSync(
  2167→            "git",
  2168→            [
  2169→              "config",
  2170→              "merge.kspec.driver",
  2171→              `${kspecPath} merge-driver %O %A %B --non-interactive`,
  2172→            ],
  2173→            { cwd: projectRoot },
  2174→          );
  2175→          if (!fixResult.ok) {
  2176→            throw new Error(
  2177→              fixResult.stderr || "failed to update merge.kspec.driver with --non-interactive",
  2178→            );
  2179→          }
  2180→        }
  2181→      } catch {
  2182→        throw error; // Re-throw original error
  2183→      }
  2184→    }
  2185→
  2186→    // Step 2: Create .gitattributes in shadow branch
  2187→    const gitattributesPath = path.join(worktreeDir, ".gitattributes");
  2188→
  2189→    // Check if .gitattributes exists
  2190→    let existingContent = "";
  2191→    try {
  2192→      existingContent = await fs.readFile(gitattributesPath, "utf-8");
  2193→    } catch {
  2194→      // File doesn't exist, that's fine
  2195→    }
  2196→
  2197→    // Check if merge driver is already configured
  2198→    if (!existingContent.includes("merge=kspec")) {
  2199→      const attributesContent = existingContent
  2200→        ? existingContent + "\n"
  2201→        : "# Git attributes for kspec\n\n";
  2202→
  2203→      await fs.writeFile(
  2204→        gitattributesPath,
  2205→        attributesContent + "*.yaml merge=kspec\n*.yml merge=kspec\n",
  2206→        "utf-8",
  2207→      );
  2208→
  2209→      // Commit .gitattributes to shadow branch
  2210→      await shadowAutoCommit(worktreeDir, "Configure kspec merge driver");
  2211→    }
  2212→
  2213→    return true;
  2214→  } catch (_error) {
  2215→    // Silently fail - merge driver configuration is optional
  2216→    return false;
  2217→  }
  2218→}
  2219→
  2220→/**
  2221→ * Initialize shadow branch and worktree.
  2222→ * Creates orphan branch, worktree, updates gitignore, and creates initial structure.
  2223→ *
  2224→ * AC: @config-shadow ac-1 — creates orphan branch with configured name
  2225→ * AC: @config-shadow ac-2 — creates worktree at configured directory
  2226→ * AC: @config-shadow ac-7 — defaults to constants when options not provided
  2227→ *
  2228→ * @param projectRoot Git repository root
  2229→ * @param options Initialization options
  2230→ * @returns Result indicating what was created
  2231→ */
  2232→export async function initializeShadow(
  2233→  projectRoot: string,
  2234→  options: ShadowInitOptions = {},
  2235→): Promise<ShadowInitResult> {
  2236→  const result: ShadowInitResult = {
  2237→    success: false,
  2238→    branchCreated: false,
  2239→    worktreeCreated: false,
  2240→    gitignoreUpdated: false,
  2241→    initialCommit: false,
  2242→    alreadyExists: false,
  2243→    createdFromRemote: false,
  2244→    pushedToRemote: false,
  2245→  };
  2246→
  2247→  // Check if we're in a git repo
  2248→  if (!(await isGitRepo(projectRoot))) {
  2249→    result.error = "Not a git repository";
  2250→    return result;
  2251→  }
  2252→
  2253→  // AC: ac-1 ac-2 — use configured branch/directory or defaults
  2254→  const branchName = getBranchName(options.shadow);
  2255→  const directoryName = getDirectoryName(options.shadow);
  2256→  const worktreeDir = path.join(projectRoot, directoryName);
  2257→
  2258→  // Check current status with configured options
  2259→  const status = await getShadowStatus(projectRoot, options.shadow);
  2260→
  2261→  // Handle existing shadow branch
  2262→  if (status.healthy && !options.force) {
  2263→    result.alreadyExists = true;
  2264→    result.success = true;
  2265→    return result;
  2266→  }
  2267→
  2268→  // Derive project name if not provided
  2269→  const projectName =
  2270→    options.projectName ||
  2271→    path
  2272→      .basename(projectRoot)
  2273→      .replace(/[-_]/g, " ")
  2274→      .replace(/\b\w/g, (c) => c.toUpperCase());
  2275→
  2276→  const slug = toSlug(projectName);
  2277→
  2278→  // Determine remote name to use
  2279→  let remoteName = "origin";
  2280→  if (options.shadow?.remote && options.shadow.remoteType === "named") {
  2281→    remoteName = options.shadow.remote;
  2282→  }
  2283→
  2284→  // Check for remote shadow branch
  2285→  // AC: @shadow-init-remote ac-4 ac-5 — queries remote directly via ls-remote
  2286→  const remoteExists = await hasRemote(projectRoot, remoteName);
  2287→  let remoteHasShadow = false;
  2288→  if (remoteExists) {
  2289→    remoteHasShadow = await remoteBranchExists(projectRoot, branchName, remoteName);
  2290→  }
  2291→
  2292→  try {
  2293→    // Step 1: Update .gitignore first (before creating worktree)
  2294→    result.gitignoreUpdated = await ensureGitignore(projectRoot, options.shadow);
  2295→
  2296→    // Step 1b: Also add .kspec-sessions/ to .gitignore
  2297→    // AC: @session-storage-modes ac-gitignore
  2298→    const sessionsAdded = await ensureSessionsGitignore(projectRoot);
  2299→    if (sessionsAdded) {
  2300→      // Commit .kspec-sessions/ gitignore entry (may be separate commit if .kspec/ was already present)
  2301→      await runGitAsync(projectRoot, ["add", ".gitignore"]);
  2302→      await runGitAsync(projectRoot, [
  2303→        "commit",
  2304→        "-m",
  2305→        `chore: add ${SESSIONS_WORKTREE_DIR}/ to .gitignore for session storage`,
  2306→      ]);
  2307→    }
  2308→
  2309→    // Step 1c: Create .kspec-sessions/ directory
  2310→    // AC: @session-storage-modes ac-sessions-dir-autocreate
  2311→    const sessionsDir = path.join(projectRoot, SESSIONS_WORKTREE_DIR);
  2312→    await fs.mkdir(sessionsDir, { recursive: true });
  2313→    result.sessionsDirectoryCreated = true;
  2314→
  2315→    // Step 2: Create worktree with orphan branch (or attach to existing branch)
  2316→    if (!status.worktreeExists || !status.worktreeLinked) {
  2317→      // Remove existing directory if present but not linked
  2318→      if (status.worktreeExists && !status.worktreeLinked) {
  2319→        await fs.rm(worktreeDir, { recursive: true, force: true });
  2320→      }
  2321→
  2322→      // Remove stale worktree reference if any
  2323→      try {
  2324→        await runGitAsync(projectRoot, [
  2325→          "worktree",
  2326→          "remove",
  2327→          directoryName,
  2328→          "--force",
  2329→        ]);
  2330→      } catch {
  2331→        // Ignore - worktree may not exist in git's list
  2332→      }
  2333→
  2334→      if (remoteHasShadow) {
  2335→        // AC: @shadow-init-remote ac-1, ac-5 - Remote has shadow branch - fetch and create worktree
  2336→        // Fetch with refspec to create a local branch ref (required in shallow clones
  2337→        // where plain `git fetch origin kspec-meta` only populates FETCH_HEAD)
  2338→        await runGitAsync(projectRoot, [
  2339→          "fetch",
  2340→          remoteName,
  2341→          `${branchName}:${branchName}`,
  2342→        ]);
  2343→        await runGitAsync(projectRoot, [
  2344→          "worktree",
  2345→          "add",
  2346→          directoryName,
  2347→          branchName,
  2348→        ]);
  2349→        // Set up tracking for the branch
  2350→        // Use git config directly — `git branch --set-upstream-to` requires
  2351→        // the remote tracking ref to exist locally, which may not be the case
  2352→        // in shallow clones where we only fetched the branch itself
  2353→        await runGitAsync(projectRoot, [
  2354→          "config",
  2355→          `branch.${branchName}.remote`,
  2356→          remoteName,
  2357→        ]);
  2358→        await runGitAsync(projectRoot, [
  2359→          "config",
  2360→          `branch.${branchName}.merge`,
  2361→          `refs/heads/${branchName}`,
  2362→        ]);
  2363→        result.createdFromRemote = true;
  2364→      } else if (!status.branchExists) {
  2365→        // AC: @shadow-init-remote ac-2 ac-3 - No remote branch or no remote - create orphan branch
  2366→        // AC: @config-shadow ac-1 — use configured branch name
  2367→        // AC: @config-shadow ac-10 — fallback for git < 2.42
  2368→        if (gitSupportsOrphanWorktree(projectRoot)) {
  2369→          await runGitAsync(projectRoot, [
  2370→            "worktree",
  2371→            "add",
  2372→            "--orphan",
  2373→            "-b",
  2374→            branchName,
  2375→            directoryName,
  2376→          ]);
  2377→        } else {
  2378→          await createOrphanBranchFallback(
  2379→            projectRoot,
  2380→            branchName,
  2381→            directoryName,
  2382→          );
  2383→        }
  2384→        result.branchCreated = true;
  2385→      } else {
  2386→        // Attach to existing local branch
  2387→        await runGitAsync(projectRoot, [
  2388→          "worktree",
  2389→          "add",
  2390→          directoryName,
  2391→          branchName,
  2392→        ]);
  2393→      }
  2394→
  2395→      result.worktreeCreated = true;
  2396→    }
  2397→
  2398→    // Step 3: Create initial structure if empty (only for new branches, not remote)
  2399→    const manifestPath = path.join(worktreeDir, `${slug}.yaml`);
  2400→    const modulesDir = path.join(worktreeDir, "modules");
  2401→    const moduleFilePath = path.join(modulesDir, "main.yaml");
  2402→    const tasksPath = path.join(worktreeDir, `${slug}.tasks.yaml`);
  2403→    const inboxPath = path.join(worktreeDir, `${slug}.inbox.yaml`);
  2404→
  2405→    let filesCreated = false;
  2406→
  2407→    // Only create files if manifest doesn't exist (remote branches will have files)
  2408→    try {
  2409→      // Look for any .yaml manifest file (project name may differ)
  2410→      const files = await fs.readdir(worktreeDir);
  2411→      const hasManifest = files.some(
  2412→        (f) =>
  2413→          f.endsWith(".yaml") &&
  2414→          !f.includes(".tasks.") &&
  2415→          !f.includes(".inbox."),
  2416→      );
  2417→      if (!hasManifest) {
  2418→        throw new Error("No manifest found");
  2419→      }
  2420→    } catch {
  2421→      // Manifest doesn't exist, create initial structure
  2422→      await fs.mkdir(modulesDir, { recursive: true });
  2423→      await fs.writeFile(
  2424→        manifestPath,
  2425→        generateShadowManifest(projectName),
  2426→        "utf-8",
  2427→      );
  2428→      await fs.writeFile(
  2429→        moduleFilePath,
  2430→        generateShadowModule(projectName),
  2431→        "utf-8",
  2432→      );
  2433→      await fs.writeFile(tasksPath, generateShadowTasks(projectName), "utf-8");
  2434→      await fs.writeFile(inboxPath, generateShadowInbox(), "utf-8");
  2435→
  2436→      // AC: @artifacts-directory ac-init-creates, ac-gitignore-entry
  2437→      const artifactsDir = path.join(worktreeDir, "artifacts");
  2438→      await fs.mkdir(artifactsDir, { recursive: true });
  2439→      // AC: @session-legacy-migration ac-shadow-gitignore — sessions/ not tracked on kspec-meta
  2440→      await fs.writeFile(
  2441→        path.join(worktreeDir, ".gitignore"),
  2442→        "# Ephemeral artifacts - reports, exports, generated files\n# Not tracked in shadow branch\nartifacts/\n\n# Sessions stored in .kspec-sessions/ at project root, not on shadow branch\nsessions/\n",
  2443→        "utf-8",
  2444→      );
  2445→
  2446→      filesCreated = true;
  2447→    }
  2448→
  2449→    // Step 4: Initial commit if files were created
  2450→    if (filesCreated) {
  2451→      result.initialCommit = await shadowAutoCommit(
  2452→        worktreeDir,
  2453→        `Initialize ${projectName} spec`,
  2454→      );
  2455→    }
  2456→
  2457→    // Step 5: AC-2: Push new branch to remote to establish tracking
  2458→    if (result.branchCreated && remoteExists && !remoteHasShadow) {
  2459→      result.pushedToRemote = await pushShadowBranch(worktreeDir, remoteName, options.shadow);
  2460→    }
  2461→
  2462→    // Step 6: Install pre-commit hook to protect shadow branch
  2463→    await installShadowHook(projectRoot);
  2464→
  2465→    // Step 7: Configure merge driver for semantic YAML merging
  2466→    // AC: @yaml-merge-driver ac-12
  2467→    await configureMergeDriver(projectRoot, worktreeDir);
  2468→
  2469→    result.success = true;
  2470→    return result;
  2471→  } catch (error) {
  2472→    result.error = error instanceof Error ? error.message : String(error);
  2473→    return result;
  2474→  }
  2475→}
  2476→
  2477→/**
  2478→ * Repair a broken shadow branch setup.
  2479→ * Handles cases where worktree is disconnected or directory is missing.
  2480→ *
  2481→ * AC: @config-shadow ac-7 — backward compat when called without config
  2482→ *
  2483→ * @param projectRoot Git repository root
  2484→ * @param options Optional shadow configuration
  2485→ * @returns Result indicating what was repaired
  2486→ */
  2487→export async function repairShadow(
  2488→  projectRoot: string,
  2489→  options?: ShadowOptions,
  2490→): Promise<ShadowInitResult> {
  2491→  const branchName = getBranchName(options);
  2492→  const directoryName = getDirectoryName(options);
  2493→  const status = await getShadowStatus(projectRoot, options);
  2494→
  2495→  if (status.healthy) {
  2496→    return {
  2497→      success: true,
  2498→      branchCreated: false,
  2499→      worktreeCreated: false,
  2500→      gitignoreUpdated: false,
  2501→      initialCommit: false,
  2502→      alreadyExists: true,
  2503→      createdFromRemote: false,
  2504→      pushedToRemote: false,
  2505→    };
  2506→  }
  2507→
  2508→  if (!status.branchExists) {
  2509→    // Can't repair without a branch - need full init
  2510→    return {
  2511→      success: false,
  2512→      branchCreated: false,
  2513→      worktreeCreated: false,
  2514→      gitignoreUpdated: false,
  2515→      initialCommit: false,
  2516→      alreadyExists: false,
  2517→      createdFromRemote: false,
  2518→      pushedToRemote: false,
  2519→      error: "Shadow branch does not exist. Run `kspec init` instead.",
  2520→    };
  2521→  }
  2522→
  2523→  // Branch exists but worktree is broken - repair it
  2524→  const worktreeDir = path.join(projectRoot, directoryName);
  2525→
  2526→  try {
  2527→    // Remove stale worktree reference
  2528→    try {
  2529→      await runGitAsync(projectRoot, [
  2530→        "worktree",
  2531→        "remove",
  2532→        directoryName,
  2533→        "--force",
  2534→      ]);
  2535→    } catch {
  2536→      // Ignore - worktree may not be in git's list
  2537→    }
  2538→
  2539→    // Remove directory if exists (handles corrupted .git file case)
  2540→    await fs.rm(worktreeDir, { recursive: true, force: true });
  2541→
  2542→    // Prune stale worktree references (cleans up orphaned entries)
  2543→    try {
  2544→      await runGitAsync(projectRoot, ["worktree", "prune"]);
  2545→    } catch {
  2546→      // Ignore - prune is best-effort
  2547→    }
  2548→
  2549→    // Recreate worktree
  2550→    await runGitAsync(projectRoot, [
  2551→      "worktree",
  2552→      "add",
  2553→      directoryName,
  2554→      branchName,
  2555→    ]);
  2556→
  2557→    // Install pre-commit hook
  2558→    await installShadowHook(projectRoot);
  2559→
  2560→    // AC: @artifacts-directory ac-repair-recreates
  2561→    const artifactsDir = path.join(worktreeDir, "artifacts");
  2562→    await fs.mkdir(artifactsDir, { recursive: true });
  2563→
  2564→    return {
  2565→      success: true,
  2566→      branchCreated: false,
  2567→      worktreeCreated: true,
  2568→      gitignoreUpdated: false,
  2569→      initialCommit: false,
  2570→      alreadyExists: false,
  2571→      createdFromRemote: false,
  2572→      pushedToRemote: false,
  2573→    };
  2574→  } catch (error) {
  2575→    return {
  2576→      success: false,
  2577→      branchCreated: false,
  2578→      worktreeCreated: false,
  2579→      gitignoreUpdated: false,
  2580→      initialCommit: false,
  2581→      alreadyExists: false,
  2582→      createdFromRemote: false,
  2583→      pushedToRemote: false,
  2584→      error: error instanceof Error ? error.message : String(error),
  2585→    };
  2586→  }
  2587→}
  2588→
