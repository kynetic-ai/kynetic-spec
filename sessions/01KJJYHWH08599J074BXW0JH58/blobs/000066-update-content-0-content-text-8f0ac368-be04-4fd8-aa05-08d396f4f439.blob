    },
    {
      "ref": "01KJ331E",
      "text": "CLI parity: kspec task add requires --title flag but kspec inbox add accepts positional text argument. task add should accept positional title for consistency. Small change in Commander.js argument definition.",
      "created_at": "2026-02-22T16:31:06.276Z",
