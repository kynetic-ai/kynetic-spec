    },
    {
      "ref": "01KJ63RW",
      "text": "Plan import warnings treated as errors in batch mode. The no YAML code block in specs section warning causes batch atomic rollback even though the task creation succeeded. Warnings should not cause batch failure — only actual errors should.",
      "created_at": "2026-02-23T20:41:37.244Z",
