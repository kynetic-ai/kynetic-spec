```
     1→/**
     2→ * Ralph command - automated task loop via ACP.
     3→ *
     4→ * Runs an ACP-compliant agent in a loop to process tasks autonomously.
     5→ * Uses session event storage for full audit trail and streaming output.
     6→ */
     7→
     8→import { Command } from 'commander';
     9→import chalk from 'chalk';
    10→import { ulid } from 'ulid';
    11→import * as fs from 'node:fs/promises';
    12→import * as path from 'node:path';
    13→import { spawn } from 'node:child_process';
    14→import { initContext } from '../../parser/index.js';
    15→import { error, info, success } from '../output.js';
    16→import { gatherSessionContext, type SessionContext } from './session.js';
    17→import { resolveAdapter, registerAdapter, type AgentAdapter } from '../../agents/index.js';
    18→import { spawnAndInitialize, type SpawnedAgent } from '../../agents/spawner.js';
    19→import type { SessionUpdate } from '../../acp/index.js';
    20→import type { ACPClient } from '../../acp/client.js';
    21→import {
    22→  createSession,
    23→  updateSessionStatus,
    24→  appendEvent,
    25→  saveSessionContext,
    26→} from '../../sessions/index.js';
    27→import { createTranslator, createCliRenderer } from '../../ralph/index.js';
    28→import { errors } from '../../strings/index.js';
    29→
    30→// ─── Prompt Template ─────────────────────────────────────────────────────────
    31→
    32→function buildPrompt(
    33→  sessionCtx: SessionContext,
    34→  iteration: number,
    35→  maxLoops: number,
    36→  focus?: string
    37→): string {
    38→  const isFinal = iteration === maxLoops;
    39→
    40→  const focusSection = focus ? `
    41→## Session Focus (applies to ALL iterations)
    42→
    43→> **${focus}**
    44→
    45→Keep this focus in mind throughout your work. It takes priority over default task selection.
    46→` : '';
    47→
    48→  return `# Kspec Automation Session
    49→
    50→You are running as part of a kspec automation loop. This is iteration ${iteration} of ${maxLoops}.
    51→${focusSection}
    52→
    53→## Current State
    54→\`\`\`json
    55→${JSON.stringify(sessionCtx, null, 2)}
    56→\`\`\`
    57→
    58→## Working Procedure
    59→
    60→1. **Pick a task**: Review ready_tasks above. Pick the highest priority task (lowest number = higher priority). If there's an active (in_progress) task, continue that instead.
    61→
    62→2. **Start the task** (if not already in_progress):
    63→   \`\`\`bash
    64→   kspec task start @task-ref
    65→   \`\`\`
    66→
    67→3. **Do the work**:
    68→   - Read relevant files to understand the task
    69→   - Make changes as needed
    70→   - Run tests if applicable
    71→   - Document as you go with task notes
    72→
    73→4. **Document progress**:
    74→   \`\`\`bash
    75→   kspec task note @task-ref "What you did, decisions made, etc."
    76→   \`\`\`
    77→
    78→5. **Complete or checkpoint**:
    79→   - If task is DONE:
    80→     \`\`\`bash
    81→     kspec task complete @task-ref --reason "Summary of completion"
    82→     \`\`\`
    83→   - If task is NOT done (WIP):
    84→     \`\`\`bash
    85→     kspec task note @task-ref "WIP: What's done, what remains..."
    86→     \`\`\`
    87→
    88→6. **Commit your work**:
    89→   \`\`\`bash
    90→   git add -A && git commit -m "feat/fix/chore: description
    91→
    92→   Task: @task-ref"
    93→   \`\`\`
    94→
    95→7. **Reflect on this iteration**:
    96→   Think about what you learned, any friction points, or patterns worth remembering.
    97→
    98→   For **systemic patterns** (friction or success worth documenting):
    99→   \`\`\`bash
   100→   kspec meta observe friction "Description of systemic issue..."
   101→   kspec meta observe success "Pattern worth replicating..."
   102→   \`\`\`
   103→
   104→   For **actionable improvements** (specific ideas that could become tasks):
   105→   \`\`\`bash
   106→   kspec inbox add "Improvement idea..." --tag reflection
   107→   \`\`\`
   108→
   109→## Important Notes
   110→- Stay focused on ONE task per iteration
   111→- The loop continues automatically - don't worry about picking the next task
   112→- kspec tracks state across iterations via task status and notes
   113→- Always commit before the iteration ends
   114→- Always reflect and capture at least one observation
   115→${isFinal ? `
   116→## FINAL ITERATION
   117→This is the last iteration of the loop. After completing your work:
   118→1. Commit any remaining changes
   119→2. Reflect on the overall session
   120→3. Capture any final insights as observations
   121→` : ''}`;
   122→}
   123→
   124→// ─── Streaming Output ────────────────────────────────────────────────────────
   125→
   126→// Translator and renderer are created per-session in the action handler.
   127→// This allows the architecture to be reused by future TUI renderers.
   128→
   129→// ─── Tool Request Handler ────────────────────────────────────────────────────
   130→
   131→/**
   132→ * Handle tool requests from ACP agent.
   133→ * Implements file operations, terminal commands, and permission handling.
   134→ */
   135→async function handleRequest(
   136→  client: ACPClient,
   137→  id: string | number,
   138→  method: string,
   139→  params: unknown,
   140→  yolo: boolean
   141→): Promise<void> {
   142→  const p = params as Record<string, unknown>;
   143→
   144→  try {
   145→    switch (method) {
   146→      case 'session/request_permission': {
   147→        // In yolo mode, auto-approve all permissions
   148→        // In normal mode, would need to implement permission UI
   149→        const options = (p.options as Array<{ optionId: string; kind: string; name: string }>) || [];
   150→
   151→        if (yolo) {
   152→          // Find an "allow" option (prefer allow_always, then allow_once)
   153→          const allowOption = options.find(o => o.kind === 'allow_always')
   154→            || options.find(o => o.kind === 'allow_once');
   155→
   156→          if (allowOption) {
   157→            client.respondPermission(id, {
   158→              outcome: { outcome: 'selected', optionId: allowOption.optionId },
   159→            });
   160→          } else {
   161→            // No allow option available - cancel
   162→            client.respondPermission(id, { outcome: { outcome: 'cancelled' } });
   163→          }
   164→        } else {
   165→          // TODO: Implement permission prompting
   166→          client.respondPermission(id, { outcome: { outcome: 'cancelled' } });
   167→        }
   168→        break;
   169→      }
   170→
   171→      case 'file/read': {
   172→        const filePath = p.path as string;
   173→        const content = await fs.readFile(filePath, 'utf-8');
   174→        client.respond(id, { content });
   175→        break;
   176→      }
   177→
   178→      case 'file/write': {
   179→        const filePath = p.path as string;
   180→        const content = p.content as string;
   181→        await fs.mkdir(path.dirname(filePath), { recursive: true });
   182→        await fs.writeFile(filePath, content, 'utf-8');
   183→        client.respond(id, {});
   184→        break;
   185→      }
   186→
   187→      case 'terminal/run': {
   188→        const command = p.command as string;
   189→        const cwd = (p.cwd as string) || process.cwd();
   190→        const timeout = (p.timeout as number) || 60000;
   191→
   192→        const result = await new Promise<{ stdout: string; stderr: string; exitCode: number }>((resolve) => {
   193→          const child = spawn(command, [], {
   194→            cwd,
   195→            shell: true,
   196→            timeout,
   197→          });
   198→
   199→          let stdout = '';
   200→          let stderr = '';
   201→
   202→          child.stdout?.on('data', (data) => {
   203→            stdout += data.toString();
   204→          });
   205→
   206→          child.stderr?.on('data', (data) => {
   207→            stderr += data.toString();
   208→          });
   209→
   210→          child.on('close', (code) => {
   211→            resolve({ stdout, stderr, exitCode: code ?? 1 });
   212→          });
   213→
   214→          child.on('error', (err) => {
   215→            resolve({ stdout, stderr: err.message, exitCode: 1 });
   216→          });
   217→        });
   218→
   219→        client.respond(id, result);
   220→        break;
   221→      }
   222→
   223→      default:
   224→        // Unknown method - return error
   225→        client.respondError(id, -32601, `Method not found: ${method}`);
   226→    }
   227→  } catch (err) {
   228→    const message = err instanceof Error ? err.message : String(err);
   229→    client.respondError(id, -32000, message);
   230→  }
   231→}
   232→
   233→// ─── Command Registration ────────────────────────────────────────────────────
   234→
   235→export function registerRalphCommand(program: Command): void {
   236→  program
   237→    .command('ralph')
   238→    .description('Run ACP agent in a loop to process ready tasks')
   239→    .option('--max-loops <n>', 'Maximum iterations', '5')
   240→    .option('--max-retries <n>', 'Max retries per iteration on error', '3')
   241→    .option('--max-failures <n>', 'Max consecutive failed iterations before exit', '3')
   242→    .option('--dry-run', 'Show prompt without executing')
   243→    .option('--yolo', 'Use dangerously-skip-permissions (default)', true)
   244→    .option('--no-yolo', 'Require normal permission prompts')
   245→    .option('--adapter <id>', 'Agent adapter to use', 'claude-code-acp')
   246→    .option('--adapter-cmd <cmd>', 'Custom adapter command (for testing)')
   247→    .option('--focus <instructions>', 'Focus instructions included in every iteration prompt')
   248→    .action(async (options) => {
   249→      try {
   250→        const maxLoops = parseInt(options.maxLoops, 10);
   251→        const maxRetries = parseInt(options.maxRetries, 10);
   252→        const maxFailures = parseInt(options.maxFailures, 10);
   253→
   254→        if (isNaN(maxLoops) || maxLoops < 1) {
   255→          error(errors.usage.maxLoopsPositive);
   256→          process.exit(1);
   257→        }
   258→
   259→        if (isNaN(maxRetries) || maxRetries < 0) {
   260→          error(errors.usage.maxRetriesNonNegative);
   261→          process.exit(1);
   262→        }
   263→
   264→        if (isNaN(maxFailures) || maxFailures < 1) {
   265→          error(errors.usage.maxFailuresPositive);
   266→          process.exit(1);
   267→        }
   268→
   269→        // Handle custom adapter command for testing
   270→        if (options.adapterCmd) {
   271→          const parts = options.adapterCmd.split(/\s+/);
   272→          const customAdapter: AgentAdapter = {
   273→            command: parts[0],
   274→            args: parts.slice(1),
   275→            description: 'Custom adapter via --adapter-cmd',
   276→          };
   277→          registerAdapter('custom', customAdapter);
   278→          options.adapter = 'custom';
   279→        }
   280→
   281→        // Resolve adapter
   282→        const adapter = resolveAdapter(options.adapter);
   283→
   284→        // Add yolo flag to adapter args if needed
   285→        if (options.yolo && options.adapter === 'claude-code-acp') {
   286→          adapter.args = [...adapter.args, '--dangerously-skip-permissions'];
   287→        }
   288→
   289→        info(`Starting ralph loop (adapter=${options.adapter}, max ${maxLoops} iterations, ${maxRetries} retries, ${maxFailures} max failures)`);
   290→        if (options.focus) {
   291→          info(`Focus: ${options.focus}`);
   292→        }
   293→
   294→        // Initialize kspec context
   295→        const ctx = await initContext();
   296→        const specDir = ctx.specDir;
   297→
   298→        // Create session for event tracking
   299→        const sessionId = ulid();
   300→        await createSession(specDir, {
   301→          id: sessionId,
   302→          agent_type: options.adapter,
   303→          task_id: undefined, // Will be determined per iteration
   304→        });
   305→
   306→        // Log session start
   307→        await appendEvent(specDir, {
   308→          session_id: sessionId,
   309→          type: 'session.start',
   310→          data: {
   311→            adapter: options.adapter,
   312→            maxLoops,
   313→            maxRetries,
   314→            maxFailures,
   315→            yolo: options.yolo,
   316→            focus: options.focus,
   317→          },
   318→        });
   319→
   320→        let consecutiveFailures = 0;
   321→        let agent: SpawnedAgent | null = null;
   322→        let acpSessionId: string | null = null;
   323→
   324→        // Create translator and renderer for this session
   325→        const translator = createTranslator();
   326→        const renderer = createCliRenderer();
   327→
   328→        try {
   329→          for (let iteration = 1; iteration <= maxLoops; iteration++) {
   330→            renderer.newSection?.(`Iteration ${iteration}/${maxLoops}`);
   331→
   332→            // Gather fresh context each iteration
   333→            const sessionCtx = await gatherSessionContext(ctx, { limit: '10' });
   334→
   335→            // Check for ready tasks or active tasks
   336→            const hasActiveTasks = sessionCtx.active_tasks.length > 0;
   337→            const hasReadyTasks = sessionCtx.ready_tasks.length > 0;
   338→
   339→            if (!hasActiveTasks && !hasReadyTasks) {
   340→              info('No active or ready tasks. Exiting loop.');
   341→              break;
   342→            }
   343→
   344→            // Build prompt
   345→            const prompt = buildPrompt(sessionCtx, iteration, maxLoops, options.focus);
   346→
   347→            if (options.dryRun) {
   348→              console.log(chalk.yellow('=== DRY RUN - Prompt that would be sent ===\n'));
   349→              console.log(prompt);
   350→              console.log(chalk.yellow('\n=== END DRY RUN ==='));
   351→              break;
   352→            }
   353→
   354→            // Log prompt
   355→            await appendEvent(specDir, {
   356→              session_id: sessionId,
   357→              type: 'prompt.sent',
   358→              data: {
   359→                iteration,
   360→                prompt,
   361→                tasks: {
   362→                  active: sessionCtx.active_tasks.map(t => t.ref),
   363→                  ready: sessionCtx.ready_tasks.map(t => t.ref),
   364→                },
   365→              },
   366→            });
   367→
   368→            // Retry loop for this iteration
   369→            let lastError: Error | null = null;
   370→            let succeeded = false;
   371→
   372→            for (let attempt = 1; attempt <= maxRetries + 1; attempt++) {
   373→              if (attempt > 1) {
   374→                console.log(chalk.yellow(`\nRetry attempt ${attempt - 1}/${maxRetries}...`));
   375→              }
   376→
   377→              try {
   378→                // Spawn agent if not already running
   379→                if (!agent) {
   380→                  info('Spawning ACP agent...');
   381→                  agent = await spawnAndInitialize(adapter, {
   382→                    cwd: process.cwd(),
   383→                    clientOptions: {
   384→                      clientInfo: {
   385→                        name: 'kspec-ralph',
   386→                        version: '0.1.0',
   387→                      },
   388→                    },
   389→                  });
   390→
   391→                  // Set up streaming update handler with translator + renderer
   392→                  agent.client.on('update', (_sid: string, update: SessionUpdate) => {
   393→                    // Translate ACP event to RalphEvent and render
   394→                    const event = translator.translate(update);
   395→                    if (event) {
   396→                      renderer.render(event);
   397→                    }
   398→                    // Log raw update event (async, non-blocking)
   399→                    appendEvent(specDir, {
   400→                      session_id: sessionId,
   401→                      type: 'session.update',
   402→                      data: { iteration, update },
   403→                    }).catch(() => {
   404→                      // Ignore logging errors during streaming
   405→                    });
   406→                  });
   407→
   408→                  // Set up tool request handler
   409→                  agent.client.on('request', (reqId: string | number, method: string, params: unknown) => {
   410→                    handleRequest(agent!.client, reqId, method, params, options.yolo).catch((err) => {
   411→                      agent!.client.respondError(reqId, -32000, err.message);
   412→                    });
   413→                  });
   414→                }
   415→
   416→                // Create fresh ACP session per iteration to keep context clean
   417→                info('Creating ACP session...');
   418→                acpSessionId = await agent.client.newSession({
   419→                  cwd: process.cwd(),
   420→                  mcpServers: [], // No MCP servers for now
   421→                });
   422→
   423→                info('Sending prompt to agent...');
   424→
   425→                // Send prompt and wait for completion
   426→                const response = await agent.client.prompt({
   427→                  sessionId: acpSessionId!,
   428→                  prompt: [{ type: 'text', text: prompt }],
   429→                });
   430→
   431→                // Log completion
   432→                await appendEvent(specDir, {
   433→                  session_id: sessionId,
   434→                  type: 'session.update',
   435→                  data: {
   436→                    iteration,
   437→                    stopReason: response.stopReason,
   438→                    completed: true,
   439→                  },
   440→                });
   441→
   442→                // Check stop reason
   443→                if (response.stopReason === 'cancelled') {
   444→                  throw new Error(errors.usage.agentPromptCancelled);
   445→                }
   446→
   447→                succeeded = true;
   448→                break;
   449→              } catch (err) {
   450→                lastError = err as Error;
   451→                error(errors.failures.iterationFailed(lastError.message));
   452→
   453→                // Clean up agent on error - will respawn next attempt
   454→                if (agent) {
   455→                  agent.kill();
   456→                  agent = null;
   457→                  acpSessionId = null;
   458→                }
   459→              }
   460→            }
   461→
   462→            if (succeeded) {
   463→              console.log(); // Newline after streaming output
   464→
   465→              // Save session context snapshot for audit trail
   466→              await saveSessionContext(specDir, sessionId, iteration, sessionCtx);
   467→
   468→              success(`Completed iteration ${iteration}`);
   469→              consecutiveFailures = 0;
   470→            } else {
   471→              consecutiveFailures++;
   472→              error(errors.failures.iterationFailedAfterRetries(iteration, maxRetries, consecutiveFailures, maxFailures));
   473→              if (lastError) {
   474→                error(errors.failures.lastError(lastError.message));
   475→              }
   476→
   477→              if (consecutiveFailures >= maxFailures) {
   478→                error(errors.failures.reachedMaxFailures(maxFailures));
   479→                break;
   480→              }
   481→
   482→              info('Continuing to next iteration...');
   483→            }
   484→          }
   485→        } finally {
   486→          // Clean up agent
   487→          if (agent) {
   488→            agent.kill();
   489→          }
   490→
   491→          // Log session end
   492→          const status = consecutiveFailures >= maxFailures ? 'abandoned' : 'completed';
   493→          await appendEvent(specDir, {
   494→            session_id: sessionId,
   495→            type: 'session.end',
   496→            data: {
   497→              status,
   498→              consecutiveFailures,
   499→            },
   500→          });
   501→          await updateSessionStatus(specDir, sessionId, status);
   502→        }
   503→
   504→        console.log(chalk.green(`\n${'─'.repeat(60)}`));
   505→        success('Ralph loop completed');
   506→        console.log(chalk.green(`${'─'.repeat(60)}\n`));
   507→
   508→      } catch (err) {
   509→        error(errors.failures.ralphLoop, err);
   510→        process.exit(1);
   511→      }
   512→    });
   513→}
   514→

