     1→/**
     2→ * Tests for ralph command and event translator.
     3→ *
     4→ * Uses a mock ACP agent to test loop behavior, retry logic,
     5→ * and failure handling without invoking the real Claude Code.
     6→ */
     7→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     8→import * as fs from 'node:fs/promises';
     9→import * as path from 'node:path';
    10→import * as os from 'node:os';
    11→import { spawnSync } from 'node:child_process';
    12→import { createTranslator } from '../src/ralph/events.js';
    13→import type { SessionUpdate } from '../src/acp/types.js';
    14→
    15→const FIXTURES_DIR = path.join(__dirname, 'fixtures');
    16→const CLI_PATH = path.join(__dirname, '..', 'src', 'cli', 'index.ts');
    17→const MOCK_ACP = path.join(__dirname, 'mocks', 'acp-mock.js');
    18→
    19→interface RalphResult {
    20→  output: string; // Combined stdout + stderr for easier assertion
    21→  stdout: string;
    22→  stderr: string;
    23→  exitCode: number;
    24→}
    25→
    26→/**
    27→ * Run ralph command with mock ACP agent
    28→ */
    29→function runRalph(
    30→  args: string,
    31→  cwd: string,
    32→  env: Record<string, string> = {}
    33→): RalphResult {
    34→  const result = spawnSync(
    35→    'npx',
    36→    ['tsx', CLI_PATH, 'ralph', ...args.split(/\s+/), '--adapter-cmd', `node ${MOCK_ACP}`],
    37→    {
    38→      cwd,
    39→      encoding: 'utf-8',
    40→      timeout: 30000,
    41→      env: {
    42→        ...process.env,
    43→        KSPEC_AUTHOR: '@test',
    44→        ...env,
    45→      },
    46→    }
    47→  );
    48→
    49→  const stdout = result.stdout || '';
    50→  const stderr = result.stderr || '';
    51→
    52→  return {
    53→    output: stdout + stderr,
    54→    stdout,
    55→    stderr,
    56→    exitCode: result.status || 0,
    57→  };
    58→}
    59→
    60→/**
    61→ * Copy fixtures to a temp directory for isolated testing
    62→ */
    63→async function setupTempFixtures(): Promise<string> {
    64→  const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-ralph-test-'));
    65→  await fs.cp(FIXTURES_DIR, tempDir, { recursive: true });
    66→  return tempDir;
    67→}
    68→
    69→describe('ralph command', () => {
    70→  let tempDir: string;
    71→  let stateFile: string;
    72→
    73→  beforeEach(async () => {
    74→    tempDir = await setupTempFixtures();
    75→    stateFile = path.join(tempDir, 'mock-state');
    76→  });
    77→
    78→  afterEach(async () => {
    79→    await fs.rm(tempDir, { recursive: true, force: true });
    80→  });
    81→
    82→  // AC-1: Basic loop execution
    83→  it('executes loop iterations when ready tasks exist', async () => {
    84→    const result = runRalph('--max-loops 2', tempDir, {
    85→      MOCK_ACP_EXIT_CODE: '0',
    86→    });
    87→
    88→    expect(result.stdout).toContain('Iteration 1/2');
    89→    expect(result.stdout).toContain('Iteration 2/2');
    90→    expect(result.stdout).toContain('Completed iteration 1');
    91→    expect(result.stdout).toContain('Completed iteration 2');
    92→    expect(result.stdout).toContain('Ralph loop completed');
    93→  });
    94→
    95→  // AC-2: No ready tasks exit
    96→  it('exits when no ready tasks exist', async () => {
    97→    // Modify fixtures to have no ready tasks - mark all pending as completed
    98→    const tasksPath = path.join(tempDir, 'project.tasks.yaml');
    99→    const content = await fs.readFile(tasksPath, 'utf-8');
   100→    // Change all pending tasks to completed (use global replace)
   101→    const modified = content.replace(/status: pending/g, 'status: completed');
   102→    await fs.writeFile(tasksPath, modified);
   103→
   104→    const result = runRalph('--max-loops 5', tempDir, {
   105→      MOCK_ACP_EXIT_CODE: '0',
   106→    });
   107→
   108→    expect(result.output).toContain('No active or ready tasks');
   109→    // Should not attempt multiple iterations
   110→    expect(result.output).not.toContain('Iteration 2/5');
   111→  });
   112→
   113→  // AC-6: Dry run mode
   114→  it('shows prompt without executing in dry-run mode', async () => {
   115→    const result = runRalph('--dry-run', tempDir);
   116→
   117→    expect(result.stdout).toContain('DRY RUN');
   118→    expect(result.stdout).toContain('Kspec Automation Session');
   119→    expect(result.stdout).toContain('Working Procedure');
   120→    // Should not show completion
   121→    expect(result.stdout).not.toContain('Completed iteration');
   122→  });
   123→
   124→  // AC-7: Retry on error
   125→  it('retries iteration on failure', async () => {
   126→    // Fail twice then succeed
   127→    const result = runRalph('--max-loops 1 --max-retries 3', tempDir, {
   128→      MOCK_ACP_FAIL_COUNT: '2',
   129→      MOCK_ACP_STATE_FILE: stateFile,
   130→    });
   131→
   132→    expect(result.stdout).toContain('Retry attempt 1/3');
   133→    expect(result.stdout).toContain('Retry attempt 2/3');
   134→    expect(result.stdout).toContain('Completed iteration 1');
   135→  });
   136→
   137→  it('continues to next iteration after retries exhausted', async () => {
   138→    // Always fail
   139→    const result = runRalph('--max-loops 2 --max-retries 1 --max-failures 3', tempDir, {
   140→      MOCK_ACP_EXIT_CODE: '1',
   141→    });
   142→
   143→    expect(result.output).toContain('failed after 2 attempts');
   144→    expect(result.output).toContain('Continuing to next iteration');
   145→    expect(result.output).toContain('Iteration 2/2');
   146→  });
   147→
   148→  // AC-8: Consecutive failure guard
   149→  it('exits after max consecutive failures', async () => {
   150→    // Always fail
   151→    const result = runRalph('--max-loops 10 --max-retries 0 --max-failures 2', tempDir, {
   152→      MOCK_ACP_EXIT_CODE: '1',
   153→    });
   154→
   155→    expect(result.output).toContain('1/2 consecutive failures');
   156→    expect(result.output).toContain('2/2 consecutive failures');
   157→    expect(result.output).toContain('Reached 2 consecutive failures');
   158→    // Should not continue to iteration 3
   159→    expect(result.output).not.toContain('Iteration 3/10');
   160→  });
   161→
   162→  it('resets failure count on success', async () => {
   163→    // For simplicity, just verify a success resets the pattern
   164→    const result = runRalph('--max-loops 2 --max-retries 0', tempDir, {
   165→      MOCK_ACP_EXIT_CODE: '0',
   166→    });
   167→
   168→    expect(result.output).toContain('Completed iteration 1');
   169→    expect(result.output).toContain('Completed iteration 2');
   170→    expect(result.output).not.toContain('consecutive failures');
   171→  });
   172→
   173→  // AC-9: Adapter selection
   174→  it('uses specified adapter', async () => {
   175→    const result = runRalph('--dry-run --adapter custom --adapter-cmd "echo test"', tempDir);
   176→
   177→    // Dry run should show the adapter being used
   178→    expect(result.stdout).toContain('adapter=custom');
   179→  });
   180→
   181→  // AC-10: Session creation
   182→  it('creates session and logs events', async () => {
   183→    const result = runRalph('--max-loops 1', tempDir, {
   184→      MOCK_ACP_EXIT_CODE: '0',
   185→    });
   186→
   187→    // Check that session directory was created
   188→    const sessionsDir = path.join(tempDir, 'sessions');
   189→    const sessions = await fs.readdir(sessionsDir).catch(() => []);
   190→    expect(sessions.length).toBeGreaterThan(0);
   191→
   192→    // Check session metadata
   193→    if (sessions.length > 0) {
   194→      const sessionDir = path.join(sessionsDir, sessions[0]);
   195→      const metadataPath = path.join(sessionDir, 'session.yaml');
   196→      const metadata = await fs.readFile(metadataPath, 'utf-8');
   197→      expect(metadata).toContain('agent_type:');
   198→      expect(metadata).toContain('status:');
   199→    }
   200→  });
   201→
   202→  // AC-11: Streaming output
   203→  it('displays streaming output from agent', async () => {
   204→    const result = runRalph('--max-loops 1', tempDir, {
   205→      MOCK_ACP_EXIT_CODE: '0',
   206→      MOCK_ACP_RESPONSE_TEXT: 'Streaming test output',
   207→    });
   208→
   209→    // The streaming text should appear in output
   210→    expect(result.stdout).toContain('Streaming test output');
   211→  });
   212→
   213→  // AC-12: Event logging
   214→  it('logs prompt.sent events', async () => {
   215→    const result = runRalph('--max-loops 1', tempDir, {
   216→      MOCK_ACP_EXIT_CODE: '0',
   217→    });
   218→
   219→    // Check events file
   220→    const sessionsDir = path.join(tempDir, 'sessions');
   221→    const sessions = await fs.readdir(sessionsDir).catch(() => []);
   222→
   223→    if (sessions.length > 0) {
   224→      const eventsPath = path.join(sessionsDir, sessions[0], 'events.jsonl');
   225→      const events = await fs.readFile(eventsPath, 'utf-8');
   226→
   227→      // Should have session.start, prompt.sent, and session.end at minimum
   228→      expect(events).toContain('"type":"session.start"');
   229→      expect(events).toContain('"type":"prompt.sent"');
   230→      expect(events).toContain('"type":"session.end"');
   231→    }
   232→  });
   233→
   234→  // AC-13: Context snapshot saving
   235→  it('saves session context snapshot after each iteration', async () => {
   236→    const result = runRalph('--max-loops 2', tempDir, {
   237→      MOCK_ACP_EXIT_CODE: '0',
   238→    });
   239→
   240→    // Check that context snapshots were saved
   241→    const sessionsDir = path.join(tempDir, 'sessions');
   242→    const sessions = await fs.readdir(sessionsDir).catch(() => []);
   243→
   244→    expect(sessions.length).toBeGreaterThan(0);
   245→
   246→    if (sessions.length > 0) {
   247→      const sessionDir = path.join(sessionsDir, sessions[0]);
   248→
   249→      // Should have context snapshots for iteration 1 and 2
   250→      const context1Path = path.join(sessionDir, 'context-iter-1.json');
   251→      const context2Path = path.join(sessionDir, 'context-iter-2.json');
   252→
   253→      const context1Exists = await fs.access(context1Path).then(() => true).catch(() => false);
   254→      const context2Exists = await fs.access(context2Path).then(() => true).catch(() => false);
   255→
   256→      expect(context1Exists).toBe(true);
   257→      expect(context2Exists).toBe(true);
   258→
   259→      // Verify context structure
   260→      const context1Content = await fs.readFile(context1Path, 'utf-8');
   261→      const context1 = JSON.parse(context1Content);
   262→
   263→      expect(context1).toHaveProperty('generated_at');
   264→      expect(context1).toHaveProperty('branch');
   265→      expect(context1).toHaveProperty('active_tasks');
   266→      expect(context1).toHaveProperty('ready_tasks');
   267→      expect(context1).toHaveProperty('stats');
   268→    }
   269→  });
   270→});
   271→
   272→// ─── Event Translator Unit Tests ────────────────────────────────────────────
   273→
   274→describe('ralph event translator', () => {
   275→  // Helper to create SessionUpdate objects
   276→  function makeChunk(
   277→    type: 'agent_message_chunk' | 'agent_thought_chunk',
   278→    text: string
   279→  ): SessionUpdate {
   280→    return {
   281→      sessionUpdate: type,
   282→      content: { type: 'text', text },
   283→    } as SessionUpdate;
   284→  }
   285→
   286→  describe('agent_message_chunk', () => {
   287→    it('translates streaming content', () => {
   288→      const translator = createTranslator();
   289→      const event = translator.translate(makeChunk('agent_message_chunk', 'Hello'));
   290→
   291→      expect(event).not.toBeNull();
   292→      expect(event!.type).toBe('agent_message');
   293→      expect(event!.data).toMatchObject({
   294→        kind: 'agent_message',
   295→        content: 'Hello',
   296→        isStreaming: true,
   297→      });
   298→    });
   299→
   300→    it('finalizes on empty string signal', () => {
   301→      const translator = createTranslator();
   302→
   303→      // First, stream some content
   304→      translator.translate(makeChunk('agent_message_chunk', 'Hello'));
   305→      translator.translate(makeChunk('agent_message_chunk', ' world'));
   306→
   307→      // Then send empty string to finalize
   308→      const finalEvent = translator.translate(makeChunk('agent_message_chunk', ''));
   309→
   310→      expect(finalEvent).not.toBeNull();
   311→      expect(finalEvent!.type).toBe('agent_message');
   312→      expect(finalEvent!.data).toMatchObject({
   313→        kind: 'agent_message',
   314→        content: 'Hello world',
   315→        isStreaming: false,
   316→      });
   317→    });
   318→
   319→    it('returns null for empty string when no active message', () => {
   320→      const translator = createTranslator();
   321→
   322→      // Send empty string without prior content
   323→      const event = translator.translate(makeChunk('agent_message_chunk', ''));
   324→
   325→      expect(event).toBeNull();
   326→    });
   327→  });
   328→
   329→  describe('agent_thought_chunk', () => {
   330→    it('translates streaming thought content', () => {
   331→      const translator = createTranslator();
   332→      const event = translator.translate(makeChunk('agent_thought_chunk', 'Thinking...'));
   333→
   334→      expect(event).not.toBeNull();
   335→      expect(event!.type).toBe('agent_thought');
   336→      expect(event!.data).toMatchObject({
   337→        kind: 'agent_thought',
   338→        content: 'Thinking...',
   339→        isStreaming: true,
   340→      });
   341→    });
   342→
   343→    it('finalizes on empty string signal', () => {
   344→      const translator = createTranslator();
   345→
   346→      // Stream some thought content
   347→      translator.translate(makeChunk('agent_thought_chunk', 'Let me think'));
   348→      translator.translate(makeChunk('agent_thought_chunk', ' about this'));
   349→
   350→      // Finalize with empty string
   351→      const finalEvent = translator.translate(makeChunk('agent_thought_chunk', ''));
   352→
   353→      expect(finalEvent).not.toBeNull();
   354→      expect(finalEvent!.type).toBe('agent_thought');
   355→      expect(finalEvent!.data).toMatchObject({
   356→        kind: 'agent_thought',
   357→        content: 'Let me think about this',
   358→        isStreaming: false,
   359→      });
   360→    });
   361→  });
   362→
   363→  describe('finalize()', () => {
   364→    it('returns final event for pending message', () => {
   365→      const translator = createTranslator();
   366→
   367→      // Stream content without empty string finalization
   368→      translator.translate(makeChunk('agent_message_chunk', 'Incomplete'));
   369→
   370→      // Call finalize explicitly
   371→      const finalEvent = translator.finalize();
   372→
   373→      expect(finalEvent).not.toBeNull();
   374→      expect(finalEvent!.type).toBe('agent_message');
   375→      expect(finalEvent!.data).toMatchObject({
   376→        kind: 'agent_message',
   377→        content: 'Incomplete',
   378→        isStreaming: false,
   379→      });
   380→    });
   381→
   382→    it('returns null when no pending message', () => {
   383→      const translator = createTranslator();
   384→
   385→      const event = translator.finalize();
   386→
   387→      expect(event).toBeNull();
   388→    });
   389→
   390→    it('clears state after finalize', () => {
   391→      const translator = createTranslator();
   392→
   393→      translator.translate(makeChunk('agent_message_chunk', 'Test'));
   394→      translator.finalize();
   395→
   396→      // Second finalize should return null
   397→      const secondFinalize = translator.finalize();
   398→      expect(secondFinalize).toBeNull();
   399→    });
   400→  });
   401→
   402→  describe('noise suppression', () => {
   403→    it('suppresses onPostToolUseHook messages', () => {
   404→      const translator = createTranslator();
   405→      const event = translator.translate(
   406→        makeChunk('agent_message_chunk', 'No onPostToolUseHook found for tool use ID: toolu_123')
   407→      );
   408→
   409→      expect(event).toBeNull();
   410→    });
   411→
   412→    it('suppresses onPreToolUseHook messages', () => {
   413→      const translator = createTranslator();
   414→      const event = translator.translate(
   415→        makeChunk('agent_message_chunk', 'No onPreToolUseHook found for tool use')
   416→      );
   417→
   418→      expect(event).toBeNull();
   419→    });
   420→  });
   421→
   422→  describe('tool_call events', () => {
   423→    it('extracts tool name and summary from rawInput (ACP format)', () => {
   424→      const translator = createTranslator();
   425→      const event = translator.translate({
   426→        sessionUpdate: 'tool_call',
   427→        toolCallId: 'toolu_123',
   428→        rawInput: { command: 'npm run build' },
   429→        _meta: { claudeCode: { toolName: 'Bash' } },
   430→      } as SessionUpdate);
   431→
   432→      expect(event).not.toBeNull();
   433→      expect(event!.type).toBe('tool_start');
   434→      expect(event!.data).toMatchObject({
   435→        kind: 'tool_start',
   436→        toolCallId: 'toolu_123',
   437→        tool: 'Bash',
   438→        summary: 'npm run build',
   439→      });
   440→    });
   441→
   442→    it('extracts file path summary for Read tool', () => {
   443→      const translator = createTranslator();
   444→      const event = translator.translate({
   445→        sessionUpdate: 'tool_call',
   446→        toolCallId: 'toolu_456',
   447→        rawInput: { file_path: '/home/user/project/src/index.ts' },
   448→        _meta: { claudeCode: { toolName: 'Read' } },
   449→      } as SessionUpdate);
   450→
   451→      expect(event).not.toBeNull();
   452→      expect(event!.data).toMatchObject({
   453→        kind: 'tool_start',
   454→        tool: 'Read',
   455→        summary: 'index.ts',
   456→      });
   457→    });
   458→
   459→    it('extracts pattern summary for Grep tool', () => {
   460→      const translator = createTranslator();
   461→      const event = translator.translate({
   462→        sessionUpdate: 'tool_call',
   463→        toolCallId: 'toolu_789',
   464→        rawInput: { pattern: 'TODO|FIXME' },
   465→        _meta: { claudeCode: { toolName: 'Grep' } },
   466→      } as SessionUpdate);
   467→
   468→      expect(event).not.toBeNull();
   469→      expect(event!.data).toMatchObject({
   470→        kind: 'tool_start',
   471→        tool: 'Grep',
   472→        summary: '/TODO|FIXME/',
   473→      });
   474→    });
   475→
   476→    it('truncates long Bash commands', () => {
   477→      const translator = createTranslator();
   478→      const longCommand = 'npm run build -- --very-long-flag --another-flag --more-options';
   479→      const event = translator.translate({
   480→        sessionUpdate: 'tool_call',
   481→        toolCallId: 'toolu_abc',
   482→        rawInput: { command: longCommand },
   483→        _meta: { claudeCode: { toolName: 'Bash' } },
   484→      } as SessionUpdate);
   485→
   486→      expect(event).not.toBeNull();
   487→      const data = event!.data as { summary: string };
   488→      expect(data.summary.length).toBeLessThanOrEqual(50);
   489→      expect(data.summary).toContain('...');
   490→    });
   491→
   492→    it('deduplicates phased tool_call events (same tool_call_id)', () => {
   493→      const translator = createTranslator();
   494→
   495→      // Phase 1: Registration with no input
   496→      const event1 = translator.translate({
   497→        sessionUpdate: 'tool_call',
   498→        toolCallId: 'toolu_phased',
   499→        rawInput: {},
   500→        _meta: { claudeCode: { toolName: 'Bash' } },
   501→      } as SessionUpdate);
   502→
   503→      expect(event1).not.toBeNull();
   504→      expect(event1!.type).toBe('tool_start');
   505→      expect((event1!.data as { summary: string }).summary).toBe('');
   506→
   507→      // Phase 2: Same tool_call_id with input now available
   508→      const event2 = translator.translate({
   509→        sessionUpdate: 'tool_call',
   510→        toolCallId: 'toolu_phased',
   511→        rawInput: { command: 'npm run build' },
   512→        _meta: { claudeCode: { toolName: 'Bash' } },
   513→      } as SessionUpdate);
   514→
   515→      // Should emit tool_update with summary, not another tool_start
   516→      expect(event2).not.toBeNull();
   517→      expect(event2!.type).toBe('tool_update');
   518→      expect((event2!.data as { summary: string }).summary).toBe('npm run build');
   519→    });
   520→
   521→    it('suppresses duplicate tool_call events with no new summary', () => {
   522→      const translator = createTranslator();
   523→
   524→      // First event with input
   525→      translator.translate({
   526→        sessionUpdate: 'tool_call',
   527→        toolCallId: 'toolu_dup',
   528→        rawInput: { command: 'npm test' },
   529→        _meta: { claudeCode: { toolName: 'Bash' } },
   530→      } as SessionUpdate);
   531→
   532→      // Same event again (duplicate)
   533→      const event2 = translator.translate({
   534→        sessionUpdate: 'tool_call',
   535→        toolCallId: 'toolu_dup',
   536→        rawInput: { command: 'npm test' },
   537→        _meta: { claudeCode: { toolName: 'Bash' } },
   538→      } as SessionUpdate);
   539→
   540→      // Should suppress since summary didn't change
   541→      expect(event2).toBeNull();
   542→    });
   543→  });
   544→
   545→  describe('tool_call_update events', () => {
   546→    it('extracts output from Claude Code toolResponse format', () => {
   547→      const translator = createTranslator();
   548→
   549→      // First send tool_call to register the tool
   550→      translator.translate({
   551→        sessionUpdate: 'tool_call',
   552→        toolCallId: 'toolu_123',
   553→        rawInput: { command: 'echo hello' },
   554→        _meta: { claudeCode: { toolName: 'Bash' } },
   555→      } as SessionUpdate);
   556→
   557→      // Then send tool_call_update with result
   558→      const event = translator.translate({
   559→        sessionUpdate: 'tool_call_update',
   560→        toolCallId: 'toolu_123',
   561→        status: 'completed',
   562→        _meta: {
   563→          claudeCode: {
   564→            toolName: 'Bash',
   565→            toolResponse: {
   566→              stdout: 'hello\n',
   567→              stderr: '',
   568→              interrupted: false,
   569→              isImage: false,
   570→            },
   571→          },
   572→        },
   573→      } as SessionUpdate);
   574→
   575→      expect(event).not.toBeNull();
   576→      expect(event!.type).toBe('tool_result');
   577→      expect(event!.data).toMatchObject({
   578→        kind: 'tool_result',
   579→        toolCallId: 'toolu_123',
   580→        tool: 'Bash',
   581→        status: 'completed',
   582→        output: 'hello',
   583→      });
   584→    });
   585→
   586→    it('combines stdout and stderr in output', () => {
   587→      const translator = createTranslator();
   588→
   589→      translator.translate({
   590→        sessionUpdate: 'tool_call',
   591→        toolCallId: 'toolu_456',
   592→        rawInput: { command: 'failing-cmd' },
   593→        _meta: { claudeCode: { toolName: 'Bash' } },
   594→      } as SessionUpdate);
   595→
   596→      const event = translator.translate({
   597→        sessionUpdate: 'tool_call_update',
   598→        toolCallId: 'toolu_456',
   599→        status: 'completed',
   600→        _meta: {
   601→          claudeCode: {
   602→            toolName: 'Bash',
   603→            toolResponse: {
   604→              stdout: 'partial output',
   605→              stderr: 'error: something went wrong',
   606→              interrupted: false,
   607→              isImage: false,
   608→            },
   609→          },
   610→        },
   611→      } as SessionUpdate);
   612→
   613→      expect(event).not.toBeNull();
   614→      const data = event!.data as { output: string };
   615→      expect(data.output).toContain('partial output');
   616→      expect(data.output).toContain('error: something went wrong');
   617→    });
   618→
   619→    it('handles non-terminal status updates', () => {
   620→      const translator = createTranslator();
   621→
   622→      translator.translate({
   623→        sessionUpdate: 'tool_call',
