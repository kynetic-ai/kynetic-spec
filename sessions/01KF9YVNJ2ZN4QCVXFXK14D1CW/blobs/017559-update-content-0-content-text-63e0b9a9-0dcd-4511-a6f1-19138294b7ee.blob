```
     1→/**
     2→ * Shadow branch utilities for transparent spec/task state tracking.
     3→ *
     4→ * Shadow branch concept:
     5→ * - Orphan branch (kspec-meta) stores kspec state
     6→ * - .kspec/ directory is a git worktree pointing to shadow branch
     7→ * - Main branch gitignores .kspec/
     8→ * - All kspec read/write operations target .kspec/
     9→ * - Changes auto-commit to shadow branch
    10→ */
    11→
    12→import * as fs from 'node:fs/promises';
    13→import * as path from 'node:path';
    14→import { execSync, exec } from 'node:child_process';
    15→import { promisify } from 'node:util';
    16→
    17→const execAsync = promisify(exec);
    18→
    19→// Import getVerboseMode for checking CLI --debug-shadow flag
    20→// We use a getter function to avoid issues with circular dependencies
    21→let getVerboseModeFunc: (() => boolean) | null = null;
    22→
    23→export function setVerboseModeGetter(getter: () => boolean): void {
    24→  getVerboseModeFunc = getter;
    25→}
    26→
    27→/**
    28→ * Shadow branch configuration
    29→ */
    30→export interface ShadowConfig {
    31→  /** Whether shadow branch is enabled/detected */
    32→  enabled: boolean;
    33→  /** Path to .kspec/ worktree directory */
    34→  worktreeDir: string;
    35→  /** Shadow branch name (default: kspec-meta) */
    36→  branchName: string;
    37→  /** Project root (where .kspec/ lives) */
    38→  projectRoot: string;
    39→}
    40→
    41→/**
    42→ * Shadow branch status
    43→ */
    44→export interface ShadowStatus {
    45→  exists: boolean;
    46→  healthy: boolean;
    47→  branchExists: boolean;
    48→  worktreeExists: boolean;
    49→  worktreeLinked: boolean;
    50→  error?: string;
    51→}
    52→
    53→/**
    54→ * Error types for shadow branch issues
    55→ */
    56→export class ShadowError extends Error {
    57→  constructor(
    58→    message: string,
    59→    public code: 'NOT_INITIALIZED' | 'WORKTREE_DISCONNECTED' | 'DIRECTORY_MISSING' | 'GIT_ERROR',
    60→    public suggestion: string
    61→  ) {
    62→    super(message);
    63→    this.name = 'ShadowError';
    64→  }
    65→}
    66→
    67→/**
    68→ * Default shadow branch name
    69→ */
    70→export const SHADOW_BRANCH_NAME = 'kspec-meta';
    71→
    72→/**
    73→ * Default shadow worktree directory
    74→ */
    75→export const SHADOW_WORKTREE_DIR = '.kspec';
    76→
    77→/**
    78→ * Check if debug mode is enabled.
    79→ * Debug mode can be enabled via:
    80→ * - KSPEC_DEBUG=1 environment variable
    81→ * - Verbose flag (passed from CLI --debug-shadow option)
    82→ *
    83→ * When enabled, shadow branch operations output detailed information.
    84→ */
    85→export function isDebugMode(verboseFlag?: boolean): boolean {
    86→  if (process.env.KSPEC_DEBUG === '1') {
    87→    return true;
    88→  }
    89→  if (verboseFlag === true) {
    90→    return true;
    91→  }
    92→  // Check CLI --debug-shadow flag via getter
    93→  if (getVerboseModeFunc?.()) {
    94→    return true;
    95→  }
    96→  return false;
    97→}
    98→
    99→/**
   100→ * Check if we're in a git repository
   101→ */
   102→export async function isGitRepo(dir: string): Promise<boolean> {
   103→  try {
   104→    execSync('git rev-parse --git-dir', {
   105→      cwd: dir,
   106→      stdio: ['pipe', 'pipe', 'pipe'],
   107→      encoding: 'utf-8',
   108→    });
   109→    return true;
   110→  } catch {
   111→    return false;
   112→  }
   113→}
   114→
   115→/**
   116→ * Get the git root directory
   117→ */
   118→export function getGitRoot(dir: string): string | null {
   119→  try {
   120→    const result = execSync('git rev-parse --show-toplevel', {
   121→      cwd: dir,
   122→      stdio: ['pipe', 'pipe', 'pipe'],
   123→      encoding: 'utf-8',
   124→    }).trim();
   125→    return result;
   126→  } catch {
   127→    return null;
   128→  }
   129→}
   130→
   131→/**
   132→ * Check if a branch exists
   133→ */
   134→export async function branchExists(dir: string, branchName: string): Promise<boolean> {
   135→  try {
   136→    execSync(`git show-ref --verify --quiet refs/heads/${branchName}`, {
   137→      cwd: dir,
   138→      stdio: ['pipe', 'pipe', 'pipe'],
   139→    });
   140→    return true;
   141→  } catch {
   142→    return false;
   143→  }
   144→}
   145→
   146→/**
   147→ * Check if a directory is a valid git worktree
   148→ */
   149→export async function isValidWorktree(worktreeDir: string): Promise<boolean> {
   150→  try {
   151→    // Check if .git file exists (worktrees have a .git file, not directory)
   152→    const gitPath = path.join(worktreeDir, '.git');
   153→    const stat = await fs.stat(gitPath);
   154→
   155→    if (stat.isFile()) {
   156→      // Read the .git file to verify it points to a worktree
   157→      const content = await fs.readFile(gitPath, 'utf-8');
   158→      return content.trim().startsWith('gitdir:');
   159→    }
   160→
   161→    return false;
   162→  } catch {
   163→    return false;
   164→  }
   165→}
   166→
   167→/**
   168→ * Detect shadow branch configuration from a directory.
   169→ * Returns shadow config if .kspec/ exists and is valid.
   170→ */
   171→export async function detectShadow(startDir: string): Promise<ShadowConfig | null> {
   172→  const gitRoot = getGitRoot(startDir);
   173→  if (!gitRoot) {
   174→    return null;
   175→  }
   176→
   177→  const worktreeDir = path.join(gitRoot, SHADOW_WORKTREE_DIR);
   178→
   179→  try {
   180→    await fs.access(worktreeDir);
   181→
   182→    // Verify it's a valid worktree
   183→    if (await isValidWorktree(worktreeDir)) {
   184→      return {
   185→        enabled: true,
   186→        worktreeDir,
   187→        branchName: SHADOW_BRANCH_NAME,
   188→        projectRoot: gitRoot,
   189→      };
   190→    }
   191→
   192→    // Directory exists but not a valid worktree
   193→    return null;
   194→  } catch {
   195→    // .kspec/ doesn't exist
   196→    return null;
   197→  }
   198→}
   199→
   200→/**
   201→ * Get detailed shadow branch status
   202→ */
   203→export async function getShadowStatus(projectRoot: string): Promise<ShadowStatus> {
   204→  const worktreeDir = path.join(projectRoot, SHADOW_WORKTREE_DIR);
   205→
   206→  const status: ShadowStatus = {
   207→    exists: false,
   208→    healthy: false,
   209→    branchExists: false,
   210→    worktreeExists: false,
   211→    worktreeLinked: false,
   212→  };
   213→
   214→  // Check if we're in a git repo
   215→  if (!(await isGitRepo(projectRoot))) {
   216→    status.error = 'Not a git repository';
   217→    return status;
   218→  }
   219→
   220→  // Check if branch exists
   221→  status.branchExists = await branchExists(projectRoot, SHADOW_BRANCH_NAME);
   222→
   223→  // Check if worktree directory exists
   224→  try {
   225→    await fs.access(worktreeDir);
   226→    status.worktreeExists = true;
   227→  } catch {
   228→    status.worktreeExists = false;
   229→  }
   230→
   231→  // Check if worktree is properly linked
   232→  if (status.worktreeExists) {
   233→    status.worktreeLinked = await isValidWorktree(worktreeDir);
   234→  }
   235→
   236→  // Determine overall status
   237→  status.exists = status.branchExists || status.worktreeExists;
   238→  status.healthy = status.branchExists && status.worktreeExists && status.worktreeLinked;
   239→
   240→  if (!status.healthy && status.exists) {
   241→    if (!status.branchExists) {
   242→      status.error = 'Shadow branch missing but worktree exists';
   243→    } else if (!status.worktreeExists) {
   244→      status.error = 'Shadow branch exists but worktree missing';
   245→    } else if (!status.worktreeLinked) {
   246→      status.error = 'Worktree exists but not properly linked';
   247→    }
   248→  }
   249→
   250→  return status;
   251→}
   252→
   253→/**
   254→ * Create an appropriate ShadowError based on status
   255→ */
   256→export function createShadowError(status: ShadowStatus): ShadowError {
   257→  if (!status.branchExists && !status.worktreeExists) {
   258→    return new ShadowError(
   259→      'Shadow branch not initialized',
   260→      'NOT_INITIALIZED',
   261→      'Run `kspec init` to create shadow branch and worktree.'
   262→    );
   263→  }
   264→
   265→  if (status.branchExists && !status.worktreeExists) {
   266→    return new ShadowError(
   267→      '.kspec/ directory missing',
   268→      'DIRECTORY_MISSING',
   269→      'Run `kspec shadow repair` to recreate the worktree.'
   270→    );
   271→  }
   272→
   273→  if (status.worktreeExists && !status.worktreeLinked) {
   274→    return new ShadowError(
   275→      'Worktree disconnected from git',
   276→      'WORKTREE_DISCONNECTED',
   277→      'Run `kspec shadow repair` to fix the worktree link.'
   278→    );
   279→  }
   280→
   281→  return new ShadowError(
   282→    status.error || 'Unknown shadow branch error',
   283→    'GIT_ERROR',
   284→    'Check git status and try `kspec shadow repair`.'
   285→  );
   286→}
   287→
   288→/**
   289→ * Auto-commit changes to shadow branch.
   290→ * Called after write operations when shadow is enabled.
   291→ *
   292→ * @param worktreeDir Path to .kspec/ directory
   293→ * @param message Commit message
   294→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   295→ * @returns true if commit succeeded, false if nothing to commit
   296→ */
   297→export async function shadowAutoCommit(
   298→  worktreeDir: string,
   299→  message: string,
   300→  verbose?: boolean
   301→): Promise<boolean> {
   302→  const debug = isDebugMode(verbose);
   303→
   304→  try {
   305→    if (debug) {
   306→      console.error(`[DEBUG] Shadow auto-commit: git add -A (cwd: ${worktreeDir})`);
   307→    }
   308→
   309→    // Stage all changes
   310→    execSync('git add -A', {
   311→      cwd: worktreeDir,
   312→      stdio: ['pipe', 'pipe', 'pipe'],
   313→    });
   314→
   315→    // Check if there are staged changes
   316→    try {
   317→      if (debug) {
   318→        console.error(`[DEBUG] Shadow auto-commit: git diff --cached --quiet`);
   319→      }
   320→
   321→      execSync('git diff --cached --quiet', {
   322→        cwd: worktreeDir,
   323→        stdio: ['pipe', 'pipe', 'pipe'],
   324→      });
   325→      // No error = no changes
   326→      if (debug) {
   327→        console.error(`[DEBUG] Shadow auto-commit: No changes to commit`);
   328→      }
   329→      return false;
   330→    } catch {
   331→      // Error = there are changes, proceed with commit
   332→    }
   333→
   334→    if (debug) {
   335→      console.error(`[DEBUG] Shadow auto-commit: git commit -m "${message}"`);
   336→    }
   337→
   338→    // Commit with message
   339→    execSync(`git commit -m "${message.replace(/"/g, '\\"')}"`, {
   340→      cwd: worktreeDir,
   341→      stdio: ['pipe', 'pipe', 'pipe'],
   342→    });
   343→
   344→    if (debug) {
   345→      console.error(`[DEBUG] Shadow auto-commit: Success`);
   346→    }
   347→
   348→    return true;
   349→  } catch (error) {
   350→    // AC: Only log error if debug mode enabled
   351→    if (debug) {
   352→      console.error('Shadow auto-commit failed:', error);
   353→    }
   354→    return false;
   355→  }
   356→}
   357→
   358→/**
   359→ * Generate commit message for a kspec operation.
   360→ */
   361→export function generateCommitMessage(
   362→  operation: string,
   363→  ref?: string,
   364→  detail?: string
   365→): string {
   366→  const parts: string[] = [];
   367→
   368→  switch (operation) {
   369→    case 'task-start':
   370→      parts.push(`Start @${ref}`);
   371→      break;
   372→    case 'task-complete':
   373→      parts.push(`Complete @${ref}`);
   374→      if (detail) parts.push(`: ${detail}`);
   375→      break;
   376→    case 'task-note':
   377→      parts.push(`Note on @${ref}`);
   378→      break;
   379→    case 'task-add':
   380→      parts.push(`Add task: ${detail || ref}`);
   381→      break;
   382→    case 'inbox-add':
   383→      parts.push(`Inbox: ${detail?.slice(0, 50)}${(detail?.length || 0) > 50 ? '...' : ''}`);
   384→      break;
   385→    case 'inbox-promote':
   386→      parts.push(`Promote to @${ref}`);
   387→      break;
   388→    case 'item-add':
   389→      parts.push(`Add @${ref}`);
   390→      break;
   391→    case 'item-set':
   392→      parts.push(`Update @${ref}`);
   393→      break;
   394→    case 'item-delete':
   395→      parts.push(`Delete @${ref}`);
   396→      break;
   397→    case 'derive':
   398→      parts.push(`Derive from @${ref}`);
   399→      break;
   400→    default:
   401→      parts.push(operation);
   402→      if (ref) parts.push(` @${ref}`);
   403→  }
   404→
   405→  return parts.join('');
   406→}
   407→
   408→/**
   409→ * Resolve a path relative to shadow worktree if enabled.
   410→ * Falls back to original path if shadow is not enabled.
   411→ */
   412→export function resolveShadowPath(
   413→  originalPath: string,
   414→  shadowConfig: ShadowConfig | null,
   415→  projectRoot: string
   416→): string {
   417→  if (!shadowConfig?.enabled) {
   418→    return originalPath;
   419→  }
   420→
   421→  // If the path is within the project root, rewrite to shadow worktree
   422→  const relativePath = path.relative(projectRoot, originalPath);
   423→
   424→  // Skip if path is outside project or already in .kspec
   425→  if (relativePath.startsWith('..') || relativePath.startsWith(SHADOW_WORKTREE_DIR)) {
   426→    return originalPath;
   427→  }
   428→
   429→  // Handle spec/ -> .kspec/ mapping
   430→  if (relativePath.startsWith('spec/') || relativePath.startsWith('spec\\')) {
   431→    const specRelative = relativePath.slice(5); // Remove 'spec/'
   432→    return path.join(shadowConfig.worktreeDir, specRelative);
   433→  }
   434→
   435→  // For task/inbox files at root, move to .kspec
   436→  if (relativePath.endsWith('.tasks.yaml') || relativePath.endsWith('.inbox.yaml')) {
   437→    return path.join(shadowConfig.worktreeDir, relativePath);
   438→  }
   439→
   440→  return originalPath;
   441→}
   442→
   443→/**
   444→ * Commit changes to shadow branch if enabled.
   445→ * This is the primary interface for CLI commands to trigger auto-commit.
   446→ *
   447→ * @param shadowConfig Shadow configuration (from KspecContext.shadow)
   448→ * @param operation Operation type (e.g., 'task-start', 'task-complete')
   449→ * @param ref Reference slug or ULID (optional)
   450→ * @param detail Additional detail for commit message (optional)
   451→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   452→ * @returns true if committed, false if shadow not enabled or nothing to commit
   453→ */
   454→export async function commitIfShadow(
   455→  shadowConfig: ShadowConfig | null,
   456→  operation: string,
   457→  ref?: string,
   458→  detail?: string,
   459→  verbose?: boolean
   460→): Promise<boolean> {
   461→  if (!shadowConfig?.enabled) {
   462→    return false;
   463→  }
   464→
   465→  const message = generateCommitMessage(operation, ref, detail);
   466→  const committed = await shadowAutoCommit(shadowConfig.worktreeDir, message, verbose);
   467→
   468→  // AC-1: Fire-and-forget push after each commit
   469→  if (committed) {
   470→    shadowPushAsync(shadowConfig.worktreeDir, verbose);
   471→  }
   472→
   473→  return committed;
   474→}
   475→
   476→/**
   477→ * Check if shadow is required but not available, and throw appropriate error.
   478→ * Use this at the start of commands that require shadow mode.
   479→ *
   480→ * @param shadowConfig Shadow configuration from context
   481→ * @param projectRoot Project root for status check
   482→ * @throws ShadowError if shadow is not properly configured
   483→ */
   484→export async function requireShadow(
   485→  shadowConfig: ShadowConfig | null,
   486→  projectRoot: string
   487→): Promise<void> {
   488→  if (shadowConfig?.enabled) {
   489→    return; // Shadow is available
   490→  }
   491→
   492→  const status = await getShadowStatus(projectRoot);
   493→  throw createShadowError(status);
   494→}
   495→
   496→/**
   497→ * Format a ShadowError for display in CLI.
   498→ * Returns a user-friendly message with suggestion.
   499→ */
   500→export function formatShadowError(error: ShadowError): string {
   501→  return `${error.message}\n\nSuggestion: ${error.suggestion}`;
   502→}
   503→
   504→/**
   505→ * Result from shadow initialization
   506→ */
   507→export interface ShadowInitResult {
   508→  success: boolean;
   509→  branchCreated: boolean;
   510→  worktreeCreated: boolean;
   511→  gitignoreUpdated: boolean;
   512→  initialCommit: boolean;
   513→  alreadyExists: boolean;
   514→  /** Whether shadow was created from existing remote branch */
   515→  createdFromRemote: boolean;
   516→  /** Whether new branch was pushed to remote to establish tracking */
   517→  pushedToRemote: boolean;
   518→  error?: string;
   519→}
   520→
   521→/**
   522→ * Options for shadow initialization
   523→ */
   524→export interface ShadowInitOptions {
   525→  /** Project name for manifest */
   526→  projectName?: string;
   527→  /** Force reinitialize even if exists */
   528→  force?: boolean;
   529→}
   530→
   531→/**
   532→ * Check if a remote exists (default: origin)
   533→ */
   534→export async function hasRemote(projectRoot: string, remoteName = 'origin'): Promise<boolean> {
   535→  try {
   536→    const { stdout } = await execAsync(`git remote get-url ${remoteName}`, {
   537→      cwd: projectRoot,
   538→    });
   539→    return stdout.trim().length > 0;
   540→  } catch {
   541→    return false;
   542→  }
   543→}
   544→
   545→/**
   546→ * Check if a branch exists on a remote
   547→ */
   548→export async function remoteBranchExists(
   549→  projectRoot: string,
   550→  branchName: string,
   551→  remoteName = 'origin'
   552→): Promise<boolean> {
   553→  try {
   554→    execSync(`git show-ref --verify --quiet refs/remotes/${remoteName}/${branchName}`, {
   555→      cwd: projectRoot,
   556→      stdio: ['pipe', 'pipe', 'pipe'],
   557→    });
   558→    return true;
   559→  } catch {
   560→    return false;
   561→  }
   562→}
   563→
   564→/**
   565→ * Fetch from remote to ensure refs are up to date.
   566→ * Returns true if fetch succeeded, false otherwise.
   567→ */
   568→export async function fetchRemote(projectRoot: string, remoteName = 'origin'): Promise<boolean> {
   569→  try {
   570→    await execAsync(`git fetch ${remoteName}`, {
   571→      cwd: projectRoot,
   572→    });
   573→    return true;
   574→  } catch {
   575→    return false;
   576→  }
   577→}
   578→
   579→/**
   580→ * Push shadow branch to remote with tracking.
   581→ * Returns true if push succeeded, false otherwise.
   582→ */
   583→export async function pushShadowBranch(
   584→  worktreeDir: string,
   585→  remoteName = 'origin'
   586→): Promise<boolean> {
   587→  try {
   588→    await execAsync(`git push -u ${remoteName} ${SHADOW_BRANCH_NAME}`, {
   589→      cwd: worktreeDir,
   590→    });
   591→    return true;
   592→  } catch {
   593→    return false;
   594→  }
   595→}
   596→
   597→/**
   598→ * Check if shadow branch has remote tracking configured.
   599→ * AC-4: Used to determine whether sync should be attempted.
   600→ */
   601→export async function hasRemoteTracking(worktreeDir: string): Promise<boolean> {
   602→  try {
   603→    const { stdout } = await execAsync(
   604→      `git config branch.${SHADOW_BRANCH_NAME}.remote`,
   605→      { cwd: worktreeDir }
   606→    );
   607→    return stdout.trim().length > 0;
   608→  } catch {
   609→    return false;
   610→  }
   611→}
   612→
   613→/**
   614→ * Ensure shadow branch has remote tracking configured.
   615→ * AC-8: If shadow has no tracking but main branch has origin remote,
   616→ * automatically configure tracking to origin/kspec-meta.
   617→ *
   618→ * @param worktreeDir Path to .kspec/ worktree
   619→ * @param projectRoot Git repository root
   620→ * @returns true if tracking is now configured (was already or just set up)
   621→ */
   622→export async function ensureRemoteTracking(
   623→  worktreeDir: string,
   624→  projectRoot: string
   625→): Promise<boolean> {
   626→  // Check if already has tracking
   627→  if (await hasRemoteTracking(worktreeDir)) {
   628→    return true;
   629→  }
   630→
   631→  // Check if main branch has origin remote
   632→  if (!(await hasRemote(projectRoot))) {
   633→    return false;
   634→  }
   635→
   636→  // Set up tracking for shadow branch to origin/kspec-meta
   637→  try {
   638→    await execAsync(
   639→      `git config branch.${SHADOW_BRANCH_NAME}.remote origin`,
   640→      { cwd: worktreeDir }
   641→    );
   642→    await execAsync(
   643→      `git config branch.${SHADOW_BRANCH_NAME}.merge refs/heads/${SHADOW_BRANCH_NAME}`,
   644→      { cwd: worktreeDir }
   645→    );
   646→    return true;
   647→  } catch {
   648→    return false;
   649→  }
   650→}
   651→
   652→/**
   653→ * Result from a sync operation
   654→ */
   655→export interface ShadowSyncResult {
   656→  success: boolean;
   657→  pulled: boolean;
   658→  pushed: boolean;
   659→  hadConflict: boolean;
   660→  error?: string;
   661→}
   662→
   663→/**
   664→ * Fire-and-forget push to remote.
   665→ * AC-1: Called after each auto-commit when tracking is configured.
   666→ * AC-8: Automatically sets up tracking if main branch has remote.
   667→ * Silently ignores errors - the local commit succeeded regardless.
   668→ *
   669→ * @param worktreeDir Path to .kspec/ worktree
   670→ * @param verbose Enable debug output
   671→ */
   672→export async function shadowPushAsync(worktreeDir: string, verbose?: boolean): Promise<void> {
   673→  const debug = isDebugMode(verbose);
   674→
   675→  // AC-8: Auto-configure tracking if main has remote but shadow doesn't
   676→  const projectRoot = path.dirname(worktreeDir);
   677→  await ensureRemoteTracking(worktreeDir, projectRoot);
   678→
   679→  // Check if tracking is configured before attempting push
   680→  if (!(await hasRemoteTracking(worktreeDir))) {
   681→    if (debug) {
   682→      console.error('[DEBUG] Shadow push: No remote tracking configured, skipping');
   683→    }
   684→    return; // AC-4: silently skip if no tracking
   685→  }
   686→
   687→  try {
   688→    if (debug) {
   689→      console.error(`[DEBUG] Shadow push: git push (cwd: ${worktreeDir})`);
   690→    }
   691→
   692→    // Don't await - fire and forget
   693→    execAsync('git push', { cwd: worktreeDir }).catch((err) => {
   694→      if (debug) {
   695→        console.error('[DEBUG] Shadow push failed:', err);
   696→      }
   697→      // Silently ignore push failures - local state is correct
   698→    });
   699→  } catch (err) {
   700→    if (debug) {
   701→      console.error('[DEBUG] Shadow push error:', err);
   702→    }
   703→  }
   704→}
   705→
   706→/**
   707→ * Pull remote changes to shadow branch.
   708→ * AC-2: Called at session start to sync before operations.
   709→ * AC-6: Uses --ff-only first, falls back to --rebase.
   710→ * AC-3: On conflict, returns failure with suggestion.
   711→ * AC-8: Automatically sets up tracking if main branch has remote.
   712→ */
   713→export async function shadowPull(worktreeDir: string): Promise<ShadowSyncResult> {
   714→  const result: ShadowSyncResult = {
   715→    success: false,
   716→    pulled: false,
   717→    pushed: false,
   718→    hadConflict: false,
   719→  };
   720→
   721→  // AC-8: Auto-configure tracking if main has remote but shadow doesn't
   722→  const projectRoot = path.dirname(worktreeDir);
   723→  await ensureRemoteTracking(worktreeDir, projectRoot);
   724→
   725→  // AC-4: Skip if no remote tracking
   726→  if (!(await hasRemoteTracking(worktreeDir))) {
   727→    result.success = true;
   728→    return result;
   729→  }
   730→
   731→  // Check if remote branch exists before attempting pull
   732→  // Fetch first to ensure refs are up to date
   733→  await fetchRemote(projectRoot);
   734→  const remoteHasBranch = await remoteBranchExists(projectRoot, SHADOW_BRANCH_NAME);
   735→  if (!remoteHasBranch) {
   736→    // Remote branch doesn't exist yet - nothing to pull, but success
   737→    result.success = true;
   738→    return result;
   739→  }
   740→
   741→  try {
   742→    // Try fast-forward only first (cleanest)
   743→    await execAsync('git pull --ff-only', { cwd: worktreeDir });
   744→    result.success = true;
   745→    result.pulled = true;
   746→    return result;
   747→  } catch {
   748→    // Fast-forward failed, try rebase
   749→  }
   750→
   751→  try {
   752→    // AC-6: Fall back to rebase
   753→    await execAsync('git pull --rebase', { cwd: worktreeDir });
   754→    result.success = true;
   755→    result.pulled = true;
   756→    return result;
   757→  } catch {
   758→    // Rebase failed - likely conflict
   759→  }
   760→
   761→  // AC-3: Conflict detected - abort rebase and report
   762→  try {
   763→    await execAsync('git rebase --abort', { cwd: worktreeDir });
   764→  } catch {
   765→    // May not be in rebase state, ignore
   766→  }
   767→
   768→  result.hadConflict = true;
   769→  result.error = 'Sync conflict detected. Run `kspec shadow resolve` to fix.';
   770→  return result;
   771→}
   772→
   773→/**
   774→ * Full sync operation: pull then push.
   775→ * Used by session start and explicit sync commands.
   776→ */
   777→export async function shadowSync(worktreeDir: string): Promise<ShadowSyncResult> {
   778→  // First pull
   779→  const pullResult = await shadowPull(worktreeDir);
   780→  if (!pullResult.success) {
   781→    return pullResult;
   782→  }
   783→
   784→  // Then push (only if tracking configured, checked inside)
   785→  if (await hasRemoteTracking(worktreeDir)) {
   786→    try {
   787→      await execAsync('git push', { cwd: worktreeDir });
   788→      pullResult.pushed = true;
   789→    } catch {
   790→      // Push failed - not a critical error, local state is correct
   791→      // Could be permissions, network, etc.
   792→    }
   793→  }
   794→
   795→  return pullResult;
   796→}
   797→
   798→/**
   799→ * Check if .gitignore has uncommitted changes
   800→ */
   801→async function hasUncommittedGitignore(projectRoot: string): Promise<boolean> {
   802→  try {
   803→    // Check both staged and unstaged changes to .gitignore
   804→    const { stdout } = await execAsync('git status --porcelain .gitignore', {
   805→      cwd: projectRoot,
   806→    });
   807→    return stdout.trim().length > 0;
   808→  } catch {
   809→    return false;
   810→  }
   811→}
   812→
   813→/**
   814→ * Commit only .gitignore with a message
   815→ */
   816→async function commitGitignore(projectRoot: string): Promise<void> {
   817→  await execAsync('git add .gitignore', { cwd: projectRoot });
   818→  await execAsync('git commit -m "chore: add .kspec/ to .gitignore for shadow branch"', {
   819→    cwd: projectRoot,
   820→  });
   821→}
   822→
   823→/**
   824→ * Add .kspec/ to .gitignore if not already present.
   825→ * Fails if .gitignore has uncommitted changes.
   826→ * Commits the change after adding.
   827→ */
   828→async function ensureGitignore(projectRoot: string): Promise<boolean> {
   829→  const gitignorePath = path.join(projectRoot, '.gitignore');
   830→  const entry = `${SHADOW_WORKTREE_DIR}/`;
   831→
   832→  // Fail fast if .gitignore has uncommitted changes
   833→  if (await hasUncommittedGitignore(projectRoot)) {
   834→    throw new ShadowError(
   835→      '.gitignore has uncommitted changes',
   836→      'GIT_ERROR',
   837→      'Commit or stash your .gitignore changes before running kspec init.'
   838→    );
   839→  }
   840→
   841→  try {
   842→    let content = '';
   843→    try {
   844→      content = await fs.readFile(gitignorePath, 'utf-8');
   845→    } catch {
   846→      // File doesn't exist, will create
   847→    }
   848→
   849→    // Check if already present (handle various formats)
   850→    const lines = content.split('\n');
   851→    const patterns = [
   852→      SHADOW_WORKTREE_DIR,
   853→      `${SHADOW_WORKTREE_DIR}/`,
   854→      `/${SHADOW_WORKTREE_DIR}`,
   855→      `/${SHADOW_WORKTREE_DIR}/`,
   856→    ];
   857→
   858→    for (const line of lines) {
   859→      const trimmed = line.trim();
   860→      if (patterns.includes(trimmed)) {
   861→        return false; // Already present
   862→      }
   863→    }
   864→
   865→    // Add to gitignore
   866→    const newContent = content.endsWith('\n') || content === ''
   867→      ? `${content}${entry}\n`
   868→      : `${content}\n${entry}\n`;
   869→
   870→    await fs.writeFile(gitignorePath, newContent, 'utf-8');
   871→
   872→    // Commit the change
   873→    await commitGitignore(projectRoot);
   874→
   875→    return true;
   876→  } catch (error) {
   877→    if (error instanceof ShadowError) {
   878→      throw error;
   879→    }
   880→    throw new ShadowError(
   881→      `Failed to update .gitignore: ${error}`,
   882→      'GIT_ERROR',
   883→      'Check file permissions for .gitignore'
   884→    );
   885→  }
   886→}
   887→
   888→/**
   889→ * Generate initial manifest content for shadow branch
   890→ */
   891→function generateShadowManifest(projectName: string): string {
   892→  return `# ${projectName} - Kynetic Spec
   893→# Generated by kspec init
   894→
   895→kynetic: "1.0"
   896→
   897→project:
   898→  name: "${projectName}"
   899→  version: "0.1.0"
   900→  status: draft
   901→  description: |
   902→    Add your project description here.
   903→
   904→# Module includes
   905→includes:
   906→  - modules/main.yaml
   907→
   908→# Configuration
   909→config:
   910→  validation:
   911→    strict_refs: true
   912→    require_acceptance: false
   913→`;
   914→}
   915→
   916→/**
   917→ * Generate initial module content
   918→ */
   919→function generateShadowModule(projectName: string): string {
   920→  return `# ${projectName} - Main Module
   921→# Add your spec items here
   922→
   923→items: []
   924→`;
   925→}
   926→
   927→/**
   928→ * Generate initial tasks file
   929→ */
   930→function generateShadowTasks(projectName: string): string {
   931→  return `# ${projectName} - Tasks
   932→# Track implementation work here
   933→
   934→tasks: []
   935→`;
   936→}
   937→
   938→/**
   939→ * Generate initial inbox file
   940→ */
   941→function generateShadowInbox(): string {
   942→  return `# Inbox - Quick Capture
   943→# Ideas and notes that haven't been triaged yet
   944→
   945→items: []
   946→`;
   947→}
   948→
   949→/**
   950→ * Convert project name to slug (kebab-case)
   951→ */
   952→function toSlug(projectName: string): string {
   953→  return projectName
   954→    .toLowerCase()
   955→    .replace(/[^a-z0-9]+/g, '-')
   956→    .replace(/^-|-$/g, '');
   957→}
   958→
   959→/**
   960→ * Initialize shadow branch and worktree.
   961→ * Creates orphan branch, worktree, updates gitignore, and creates initial structure.
   962→ *
   963→ * @param projectRoot Git repository root
   964→ * @param options Initialization options
   965→ * @returns Result indicating what was created
   966→ */
   967→export async function initializeShadow(
   968→  projectRoot: string,
   969→  options: ShadowInitOptions = {}
   970→): Promise<ShadowInitResult> {
   971→  const result: ShadowInitResult = {
   972→    success: false,
   973→    branchCreated: false,
   974→    worktreeCreated: false,
   975→    gitignoreUpdated: false,
   976→    initialCommit: false,
   977→    alreadyExists: false,
   978→    createdFromRemote: false,
   979→    pushedToRemote: false,
   980→  };
   981→
   982→  // Check if we're in a git repo
   983→  if (!(await isGitRepo(projectRoot))) {
   984→    result.error = 'Not a git repository';
   985→    return result;
   986→  }
   987→
   988→  const worktreeDir = path.join(projectRoot, SHADOW_WORKTREE_DIR);
   989→
   990→  // Check current status
   991→  const status = await getShadowStatus(projectRoot);
   992→
   993→  // Handle existing shadow branch
   994→  if (status.healthy && !options.force) {
   995→    result.alreadyExists = true;
   996→    result.success = true;
   997→    return result;
   998→  }
   999→
  1000→  // Derive project name if not provided
  1001→  const projectName = options.projectName || path.basename(projectRoot)
  1002→    .replace(/[-_]/g, ' ')
  1003→    .replace(/\b\w/g, (c) => c.toUpperCase());
  1004→
  1005→  const slug = toSlug(projectName);
  1006→
  1007→  // Check for remote shadow branch (AC-4: fetch to ensure refs are up to date)
  1008→  const remoteExists = await hasRemote(projectRoot);
  1009→  let remoteHasShadow = false;
  1010→  if (remoteExists) {
  1011→    await fetchRemote(projectRoot); // Best effort, ignore failures
  1012→    remoteHasShadow = await remoteBranchExists(projectRoot, SHADOW_BRANCH_NAME);
  1013→  }
  1014→
  1015→  try {
  1016→    // Step 1: Update .gitignore first (before creating .kspec/)
  1017→    result.gitignoreUpdated = await ensureGitignore(projectRoot);
  1018→
  1019→    // Step 2: Create worktree with orphan branch (or attach to existing branch)
  1020→    if (!status.worktreeExists || !status.worktreeLinked) {
  1021→      // Remove existing directory if present but not linked
  1022→      if (status.worktreeExists && !status.worktreeLinked) {
  1023→        await fs.rm(worktreeDir, { recursive: true, force: true });
  1024→      }
  1025→
  1026→      // Remove stale worktree reference if any
  1027→      try {
  1028→        await execAsync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, {
  1029→          cwd: projectRoot,
  1030→        });
  1031→      } catch {
  1032→        // Ignore - worktree may not exist in git's list
  1033→      }
  1034→
  1035→      if (remoteHasShadow) {
  1036→        // AC-1: Remote has shadow branch - create worktree from it with tracking
  1037→        await execAsync(
  1038→          `git worktree add ${SHADOW_WORKTREE_DIR} ${SHADOW_BRANCH_NAME}`,
  1039→          { cwd: projectRoot }
  1040→        );
  1041→        // Set up tracking for the branch
  1042→        await execAsync(
  1043→          `git branch --set-upstream-to=origin/${SHADOW_BRANCH_NAME} ${SHADOW_BRANCH_NAME}`,
  1044→          { cwd: projectRoot }
  1045→        );
  1046→        result.createdFromRemote = true;
  1047→      } else if (!status.branchExists) {
  1048→        // AC-2/AC-3: No remote branch or no remote - create orphan branch
  1049→        await execAsync(
  1050→          `git worktree add --orphan -b ${SHADOW_BRANCH_NAME} ${SHADOW_WORKTREE_DIR}`,
  1051→          { cwd: projectRoot }
  1052→        );
  1053→        result.branchCreated = true;
  1054→      } else {
  1055→        // Attach to existing local branch
  1056→        await execAsync(
  1057→          `git worktree add ${SHADOW_WORKTREE_DIR} ${SHADOW_BRANCH_NAME}`,
  1058→          { cwd: projectRoot }
  1059→        );
  1060→      }
  1061→
  1062→      result.worktreeCreated = true;
  1063→    }
  1064→
  1065→    // Step 3: Create initial structure if empty (only for new branches, not remote)
  1066→    const manifestPath = path.join(worktreeDir, `${slug}.yaml`);
  1067→    const modulesDir = path.join(worktreeDir, 'modules');
  1068→    const moduleFilePath = path.join(modulesDir, 'main.yaml');
  1069→    const tasksPath = path.join(worktreeDir, `${slug}.tasks.yaml`);
  1070→    const inboxPath = path.join(worktreeDir, `${slug}.inbox.yaml`);
  1071→
  1072→    let filesCreated = false;
  1073→
  1074→    // Only create files if manifest doesn't exist (remote branches will have files)
  1075→    try {
  1076→      // Look for any .yaml manifest file (project name may differ)
  1077→      const files = await fs.readdir(worktreeDir);
  1078→      const hasManifest = files.some(f => f.endsWith('.yaml') && !f.includes('.tasks.') && !f.includes('.inbox.'));
  1079→      if (!hasManifest) {
  1080→        throw new Error('No manifest found');
  1081→      }
  1082→    } catch {
  1083→      // Manifest doesn't exist, create initial structure
  1084→      await fs.mkdir(modulesDir, { recursive: true });
  1085→      await fs.writeFile(manifestPath, generateShadowManifest(projectName), 'utf-8');
  1086→      await fs.writeFile(moduleFilePath, generateShadowModule(projectName), 'utf-8');
  1087→      await fs.writeFile(tasksPath, generateShadowTasks(projectName), 'utf-8');
  1088→      await fs.writeFile(inboxPath, generateShadowInbox(), 'utf-8');
  1089→      filesCreated = true;
  1090→    }
  1091→
  1092→    // Step 4: Initial commit if files were created
  1093→    if (filesCreated) {
  1094→      result.initialCommit = await shadowAutoCommit(
  1095→        worktreeDir,
  1096→        `Initialize ${projectName} spec`
  1097→      );
  1098→    }
  1099→
  1100→    // Step 5: AC-2: Push new branch to remote to establish tracking
  1101→    if (result.branchCreated && remoteExists && !remoteHasShadow) {
  1102→      result.pushedToRemote = await pushShadowBranch(worktreeDir);
  1103→    }
  1104→
  1105→    result.success = true;
  1106→    return result;
  1107→  } catch (error) {
  1108→    result.error = error instanceof Error ? error.message : String(error);
  1109→    return result;
  1110→  }
  1111→}
  1112→
  1113→/**
  1114→ * Repair a broken shadow branch setup.
  1115→ * Handles cases where worktree is disconnected or directory is missing.
  1116→ *
  1117→ * @param projectRoot Git repository root
  1118→ * @returns Result indicating what was repaired
  1119→ */
  1120→export async function repairShadow(projectRoot: string): Promise<ShadowInitResult> {
  1121→  const status = await getShadowStatus(projectRoot);
  1122→
  1123→  if (status.healthy) {
  1124→    return {
  1125→      success: true,
  1126→      branchCreated: false,
  1127→      worktreeCreated: false,
  1128→      gitignoreUpdated: false,
  1129→      initialCommit: false,
  1130→      alreadyExists: true,
  1131→      createdFromRemote: false,
  1132→      pushedToRemote: false,
  1133→    };
  1134→  }
  1135→
  1136→  if (!status.branchExists) {
  1137→    // Can't repair without a branch - need full init
  1138→    return {
  1139→      success: false,
  1140→      branchCreated: false,
  1141→      worktreeCreated: false,
  1142→      gitignoreUpdated: false,
  1143→      initialCommit: false,
  1144→      alreadyExists: false,
  1145→      createdFromRemote: false,
  1146→      pushedToRemote: false,
  1147→      error: 'Shadow branch does not exist. Run `kspec init` instead.',
  1148→    };
  1149→  }
  1150→
  1151→  // Branch exists but worktree is broken - repair it
  1152→  const worktreeDir = path.join(projectRoot, SHADOW_WORKTREE_DIR);
  1153→
  1154→  try {
  1155→    // Remove stale worktree reference
  1156→    try {
  1157→      await execAsync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, {
  1158→        cwd: projectRoot,
  1159→      });
  1160→    } catch {
  1161→      // Ignore - worktree may not be in git's list
  1162→    }
  1163→
  1164→    // Remove directory if exists (handles corrupted .git file case)
  1165→    await fs.rm(worktreeDir, { recursive: true, force: true });
  1166→
  1167→    // Prune stale worktree references (cleans up orphaned entries)
  1168→    try {
  1169→      await execAsync('git worktree prune', { cwd: projectRoot });
  1170→    } catch {
  1171→      // Ignore - prune is best-effort
  1172→    }
  1173→
  1174→    // Recreate worktree
  1175→    await execAsync(
  1176→      `git worktree add ${SHADOW_WORKTREE_DIR} ${SHADOW_BRANCH_NAME}`,
  1177→      { cwd: projectRoot }
  1178→    );
  1179→
  1180→    return {
  1181→      success: true,
  1182→      branchCreated: false,
  1183→      worktreeCreated: true,
  1184→      gitignoreUpdated: false,
  1185→      initialCommit: false,
  1186→      alreadyExists: false,
  1187→      createdFromRemote: false,
  1188→      pushedToRemote: false,
  1189→    };
  1190→  } catch (error) {
  1191→    return {
  1192→      success: false,
  1193→      branchCreated: false,
  1194→      worktreeCreated: false,
  1195→      gitignoreUpdated: false,
  1196→      initialCommit: false,
  1197→      alreadyExists: false,
  1198→      createdFromRemote: false,
  1199→      pushedToRemote: false,
  1200→      error: error instanceof Error ? error.message : String(error),
  1201→    };
  1202→  }
  1203→}
  1204→

