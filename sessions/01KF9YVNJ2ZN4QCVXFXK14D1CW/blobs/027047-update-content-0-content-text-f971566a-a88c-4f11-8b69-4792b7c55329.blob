```
     1→/**
     2→ * Shadow branch utilities for transparent spec/task state tracking.
     3→ *
     4→ * Shadow branch concept:
     5→ * - Orphan branch (kspec-meta) stores kspec state
     6→ * - .kspec/ directory is a git worktree pointing to shadow branch
     7→ * - Main branch gitignores .kspec/
     8→ * - All kspec read/write operations target .kspec/
     9→ * - Changes auto-commit to shadow branch
    10→ */
    11→
    12→import * as fs from 'node:fs/promises';
    13→import * as path from 'node:path';
    14→import { execSync, exec } from 'node:child_process';
    15→import { promisify } from 'node:util';
    16→
    17→const execAsync = promisify(exec);
    18→
    19→// Import getVerboseMode for checking CLI --debug-shadow flag
    20→// We use a getter function to avoid issues with circular dependencies
    21→let getVerboseModeFunc: (() => boolean) | null = null;
    22→
    23→export function setVerboseModeGetter(getter: () => boolean): void {
    24→  getVerboseModeFunc = getter;
    25→}
    26→
    27→/**
    28→ * Shadow branch configuration
    29→ */
    30→export interface ShadowConfig {
    31→  /** Whether shadow branch is enabled/detected */
    32→  enabled: boolean;
    33→  /** Path to .kspec/ worktree directory */
    34→  worktreeDir: string;
    35→  /** Shadow branch name (default: kspec-meta) */
    36→  branchName: string;
    37→  /** Project root (where .kspec/ lives) */
    38→  projectRoot: string;
    39→}
    40→
    41→/**
    42→ * Shadow branch status
    43→ */
    44→export interface ShadowStatus {
    45→  exists: boolean;
    46→  healthy: boolean;
    47→  branchExists: boolean;
    48→  worktreeExists: boolean;
    49→  worktreeLinked: boolean;
    50→  error?: string;
    51→}
    52→
    53→/**
    54→ * Error types for shadow branch issues
    55→ */
    56→export class ShadowError extends Error {
    57→  constructor(
    58→    message: string,
    59→    public code: 'NOT_INITIALIZED' | 'WORKTREE_DISCONNECTED' | 'DIRECTORY_MISSING' | 'GIT_ERROR',
    60→    public suggestion: string
    61→  ) {
    62→    super(message);
    63→    this.name = 'ShadowError';
    64→  }
    65→}
    66→
    67→/**
    68→ * Default shadow branch name
    69→ */
    70→export const SHADOW_BRANCH_NAME = 'kspec-meta';
    71→
    72→/**
    73→ * Default shadow worktree directory
    74→ */
    75→export const SHADOW_WORKTREE_DIR = '.kspec';
    76→
    77→/**
    78→ * Check if debug mode is enabled.
    79→ * Debug mode can be enabled via:
    80→ * - KSPEC_DEBUG=1 environment variable
    81→ * - Verbose flag (passed from CLI --debug-shadow option)
    82→ *
    83→ * When enabled, shadow branch operations output detailed information.
    84→ */
    85→export function isDebugMode(verboseFlag?: boolean): boolean {
    86→  if (process.env.KSPEC_DEBUG === '1') {
    87→    return true;
    88→  }
    89→  if (verboseFlag === true) {
    90→    return true;
    91→  }
    92→  // Check CLI --debug-shadow flag via getter
    93→  if (getVerboseModeFunc?.()) {
    94→    return true;
    95→  }
    96→  return false;
    97→}
    98→
    99→/**
   100→ * Check if we're in a git repository
   101→ */
   102→export async function isGitRepo(dir: string): Promise<boolean> {
   103→  try {
   104→    execSync('git rev-parse --git-dir', {
   105→      cwd: dir,
   106→      stdio: ['pipe', 'pipe', 'pipe'],
   107→      encoding: 'utf-8',
   108→    });
   109→    return true;
   110→  } catch {
   111→    return false;
   112→  }
   113→}
   114→
   115→/**
   116→ * Get the git root directory
   117→ */
   118→export function getGitRoot(dir: string): string | null {
   119→  try {
   120→    const result = execSync('git rev-parse --show-toplevel', {
   121→      cwd: dir,
   122→      stdio: ['pipe', 'pipe', 'pipe'],
   123→      encoding: 'utf-8',
   124→    }).trim();
   125→    return result;
   126→  } catch {
   127→    return null;
   128→  }
   129→}
   130→
   131→/**
   132→ * Check if a branch exists
   133→ */
   134→export async function branchExists(dir: string, branchName: string): Promise<boolean> {
   135→  try {
   136→    execSync(`git show-ref --verify --quiet refs/heads/${branchName}`, {
   137→      cwd: dir,
   138→      stdio: ['pipe', 'pipe', 'pipe'],
   139→    });
   140→    return true;
   141→  } catch {
   142→    return false;
   143→  }
   144→}
   145→
   146→/**
   147→ * Check if a directory is a valid git worktree
   148→ */
   149→export async function isValidWorktree(worktreeDir: string): Promise<boolean> {
   150→  try {
   151→    // Check if .git file exists (worktrees have a .git file, not directory)
   152→    const gitPath = path.join(worktreeDir, '.git');
   153→    const stat = await fs.stat(gitPath);
   154→
   155→    if (stat.isFile()) {
   156→      // Read the .git file to verify it points to a worktree
   157→      const content = await fs.readFile(gitPath, 'utf-8');
   158→      return content.trim().startsWith('gitdir:');
   159→    }
   160→
   161→    return false;
   162→  } catch {
   163→    return false;
   164→  }
   165→}
   166→
   167→/**
   168→ * Detect shadow branch configuration from a directory.
   169→ * Returns shadow config if .kspec/ exists and is valid.
   170→ */
   171→export async function detectShadow(startDir: string): Promise<ShadowConfig | null> {
   172→  const gitRoot = getGitRoot(startDir);
   173→  if (!gitRoot) {
   174→    return null;
   175→  }
   176→
   177→  const worktreeDir = path.join(gitRoot, SHADOW_WORKTREE_DIR);
   178→
   179→  try {
   180→    await fs.access(worktreeDir);
   181→
   182→    // Verify it's a valid worktree
   183→    if (await isValidWorktree(worktreeDir)) {
   184→      return {
   185→        enabled: true,
   186→        worktreeDir,
   187→        branchName: SHADOW_BRANCH_NAME,
   188→        projectRoot: gitRoot,
   189→      };
   190→    }
   191→
   192→    // Directory exists but not a valid worktree
   193→    return null;
   194→  } catch {
   195→    // .kspec/ doesn't exist
   196→    return null;
   197→  }
   198→}
   199→
   200→/**
   201→ * Get detailed shadow branch status
   202→ */
   203→export async function getShadowStatus(projectRoot: string): Promise<ShadowStatus> {
   204→  const worktreeDir = path.join(projectRoot, SHADOW_WORKTREE_DIR);
   205→
   206→  const status: ShadowStatus = {
   207→    exists: false,
   208→    healthy: false,
   209→    branchExists: false,
   210→    worktreeExists: false,
   211→    worktreeLinked: false,
   212→  };
   213→
   214→  // Check if we're in a git repo
   215→  if (!(await isGitRepo(projectRoot))) {
   216→    status.error = 'Not a git repository';
   217→    return status;
   218→  }
   219→
   220→  // Check if branch exists
   221→  status.branchExists = await branchExists(projectRoot, SHADOW_BRANCH_NAME);
   222→
   223→  // Check if worktree directory exists
   224→  try {
   225→    await fs.access(worktreeDir);
   226→    status.worktreeExists = true;
   227→  } catch {
   228→    status.worktreeExists = false;
   229→  }
   230→
   231→  // Check if worktree is properly linked
   232→  if (status.worktreeExists) {
   233→    status.worktreeLinked = await isValidWorktree(worktreeDir);
   234→  }
   235→
   236→  // Determine overall status
   237→  status.exists = status.branchExists || status.worktreeExists;
   238→  status.healthy = status.branchExists && status.worktreeExists && status.worktreeLinked;
   239→
   240→  if (!status.healthy && status.exists) {
   241→    if (!status.branchExists) {
   242→      status.error = 'Shadow branch missing but worktree exists';
   243→    } else if (!status.worktreeExists) {
   244→      status.error = 'Shadow branch exists but worktree missing';
   245→    } else if (!status.worktreeLinked) {
   246→      status.error = 'Worktree exists but not properly linked';
   247→    }
   248→  }
   249→
   250→  return status;
   251→}
   252→
   253→/**
   254→ * Create an appropriate ShadowError based on status
   255→ */
   256→export function createShadowError(status: ShadowStatus): ShadowError {
   257→  if (!status.branchExists && !status.worktreeExists) {
   258→    return new ShadowError(
   259→      'Shadow branch not initialized',
   260→      'NOT_INITIALIZED',
   261→      'Run `kspec init` to create shadow branch and worktree.'
   262→    );
   263→  }
   264→
   265→  if (status.branchExists && !status.worktreeExists) {
   266→    return new ShadowError(
   267→      '.kspec/ directory missing',
   268→      'DIRECTORY_MISSING',
   269→      'Run `kspec shadow repair` to recreate the worktree.'
   270→    );
   271→  }
   272→
   273→  if (status.worktreeExists && !status.worktreeLinked) {
   274→    return new ShadowError(
   275→      'Worktree disconnected from git',
   276→      'WORKTREE_DISCONNECTED',
   277→      'Run `kspec shadow repair` to fix the worktree link.'
   278→    );
   279→  }
   280→
   281→  return new ShadowError(
   282→    status.error || 'Unknown shadow branch error',
   283→    'GIT_ERROR',
   284→    'Check git status and try `kspec shadow repair`.'
   285→  );
   286→}
   287→
   288→/**
   289→ * Auto-commit changes to shadow branch.
   290→ * Called after write operations when shadow is enabled.
   291→ *
   292→ * @param worktreeDir Path to .kspec/ directory
   293→ * @param message Commit message
   294→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   295→ * @returns true if commit succeeded, false if nothing to commit
   296→ */
   297→export async function shadowAutoCommit(
   298→  worktreeDir: string,
   299→  message: string,
   300→  verbose?: boolean
   301→): Promise<boolean> {
   302→  const debug = isDebugMode(verbose);
   303→
   304→  try {
   305→    if (debug) {
   306→      console.error(`[DEBUG] Shadow auto-commit: git add -A (cwd: ${worktreeDir})`);
   307→    }
   308→
   309→    // Stage all changes
   310→    execSync('git add -A', {
   311→      cwd: worktreeDir,
   312→      stdio: ['pipe', 'pipe', 'pipe'],
   313→    });
   314→
   315→    // Check if there are staged changes
   316→    try {
   317→      if (debug) {
   318→        console.error(`[DEBUG] Shadow auto-commit: git diff --cached --quiet`);
   319→      }
   320→
   321→      execSync('git diff --cached --quiet', {
   322→        cwd: worktreeDir,
   323→        stdio: ['pipe', 'pipe', 'pipe'],
   324→      });
   325→      // No error = no changes
   326→      if (debug) {
   327→        console.error(`[DEBUG] Shadow auto-commit: No changes to commit`);
   328→      }
   329→      return false;
   330→    } catch {
   331→      // Error = there are changes, proceed with commit
   332→    }
   333→
   334→    if (debug) {
   335→      console.error(`[DEBUG] Shadow auto-commit: git commit -m "${message}"`);
   336→    }
   337→
   338→    // Commit with message
   339→    // Set KSPEC_SHADOW_COMMIT=1 to signal authorized commit to git hooks
   340→    execSync(`git commit -m "${message.replace(/"/g, '\\"')}"`, {
   341→      cwd: worktreeDir,
   342→      stdio: ['pipe', 'pipe', 'pipe'],
   343→      env: { ...process.env, KSPEC_SHADOW_COMMIT: '1' },
   344→    });
   345→
   346→    if (debug) {
   347→      console.error(`[DEBUG] Shadow auto-commit: Success`);
   348→    }
   349→
   350→    return true;
   351→  } catch (error) {
   352→    // AC: Only log error if debug mode enabled
   353→    if (debug) {
   354→      console.error('Shadow auto-commit failed:', error);
   355→    }
   356→    return false;
   357→  }
   358→}
   359→
   360→/**
   361→ * Generate commit message for a kspec operation.
   362→ */
   363→export function generateCommitMessage(
   364→  operation: string,
   365→  ref?: string,
   366→  detail?: string
   367→): string {
   368→  const parts: string[] = [];
   369→
   370→  switch (operation) {
   371→    case 'task-start':
   372→      parts.push(`Start @${ref}`);
   373→      break;
   374→    case 'task-complete':
   375→      parts.push(`Complete @${ref}`);
   376→      if (detail) parts.push(`: ${detail}`);
   377→      break;
   378→    case 'task-note':
   379→      parts.push(`Note on @${ref}`);
   380→      break;
   381→    case 'task-add':
   382→      parts.push(`Add task: ${detail || ref}`);
   383→      break;
   384→    case 'inbox-add':
   385→      parts.push(`Inbox: ${detail?.slice(0, 50)}${(detail?.length || 0) > 50 ? '...' : ''}`);
   386→      break;
   387→    case 'inbox-promote':
   388→      parts.push(`Promote to @${ref}`);
   389→      break;
   390→    case 'item-add':
   391→      parts.push(`Add @${ref}`);
   392→      break;
   393→    case 'item-set':
   394→      parts.push(`Update @${ref}`);
   395→      break;
   396→    case 'item-delete':
   397→      parts.push(`Delete @${ref}`);
   398→      break;
   399→    case 'derive':
   400→      parts.push(`Derive from @${ref}`);
   401→      break;
   402→    default:
   403→      parts.push(operation);
   404→      if (ref) parts.push(` @${ref}`);
   405→  }
   406→
   407→  return parts.join('');
   408→}
   409→
   410→/**
   411→ * Resolve a path relative to shadow worktree if enabled.
   412→ * Falls back to original path if shadow is not enabled.
   413→ */
   414→export function resolveShadowPath(
   415→  originalPath: string,
   416→  shadowConfig: ShadowConfig | null,
   417→  projectRoot: string
   418→): string {
   419→  if (!shadowConfig?.enabled) {
   420→    return originalPath;
   421→  }
   422→
   423→  // If the path is within the project root, rewrite to shadow worktree
   424→  const relativePath = path.relative(projectRoot, originalPath);
   425→
   426→  // Skip if path is outside project or already in .kspec
   427→  if (relativePath.startsWith('..') || relativePath.startsWith(SHADOW_WORKTREE_DIR)) {
   428→    return originalPath;
   429→  }
   430→
   431→  // Handle spec/ -> .kspec/ mapping
   432→  if (relativePath.startsWith('spec/') || relativePath.startsWith('spec\\')) {
   433→    const specRelative = relativePath.slice(5); // Remove 'spec/'
   434→    return path.join(shadowConfig.worktreeDir, specRelative);
   435→  }
   436→
   437→  // For task/inbox files at root, move to .kspec
   438→  if (relativePath.endsWith('.tasks.yaml') || relativePath.endsWith('.inbox.yaml')) {
   439→    return path.join(shadowConfig.worktreeDir, relativePath);
   440→  }
   441→
   442→  return originalPath;
   443→}
   444→
   445→/**
   446→ * Commit changes to shadow branch if enabled.
   447→ * This is the primary interface for CLI commands to trigger auto-commit.
   448→ *
   449→ * @param shadowConfig Shadow configuration (from KspecContext.shadow)
   450→ * @param operation Operation type (e.g., 'task-start', 'task-complete')
   451→ * @param ref Reference slug or ULID (optional)
   452→ * @param detail Additional detail for commit message (optional)
   453→ * @param verbose Enable debug output (defaults to KSPEC_DEBUG env var)
   454→ * @returns true if committed, false if shadow not enabled or nothing to commit
   455→ */
   456→export async function commitIfShadow(
   457→  shadowConfig: ShadowConfig | null,
   458→  operation: string,
   459→  ref?: string,
   460→  detail?: string,
   461→  verbose?: boolean
   462→): Promise<boolean> {
   463→  if (!shadowConfig?.enabled) {
   464→    return false;
   465→  }
   466→
   467→  const message = generateCommitMessage(operation, ref, detail);
   468→  const committed = await shadowAutoCommit(shadowConfig.worktreeDir, message, verbose);
   469→
   470→  // AC-1: Fire-and-forget push after each commit
   471→  if (committed) {
   472→    shadowPushAsync(shadowConfig.worktreeDir, verbose);
   473→  }
   474→
   475→  return committed;
   476→}
   477→
   478→/**
   479→ * Check if shadow is required but not available, and throw appropriate error.
   480→ * Use this at the start of commands that require shadow mode.
   481→ *
   482→ * @param shadowConfig Shadow configuration from context
   483→ * @param projectRoot Project root for status check
   484→ * @throws ShadowError if shadow is not properly configured
   485→ */
   486→export async function requireShadow(
   487→  shadowConfig: ShadowConfig | null,
   488→  projectRoot: string
   489→): Promise<void> {
   490→  if (shadowConfig?.enabled) {
   491→    return; // Shadow is available
   492→  }
   493→
   494→  const status = await getShadowStatus(projectRoot);
   495→  throw createShadowError(status);
   496→}
   497→
   498→/**
   499→ * Format a ShadowError for display in CLI.
   500→ * Returns a user-friendly message with suggestion.
   501→ */
   502→export function formatShadowError(error: ShadowError): string {
   503→  return `${error.message}\n\nSuggestion: ${error.suggestion}`;
   504→}
   505→
   506→/**
   507→ * Result from shadow initialization
   508→ */
   509→export interface ShadowInitResult {
   510→  success: boolean;
   511→  branchCreated: boolean;
   512→  worktreeCreated: boolean;
   513→  gitignoreUpdated: boolean;
   514→  initialCommit: boolean;
   515→  alreadyExists: boolean;
   516→  /** Whether shadow was created from existing remote branch */
   517→  createdFromRemote: boolean;
   518→  /** Whether new branch was pushed to remote to establish tracking */
   519→  pushedToRemote: boolean;
   520→  error?: string;
   521→}
   522→
   523→/**
   524→ * Options for shadow initialization
   525→ */
   526→export interface ShadowInitOptions {
   527→  /** Project name for manifest */
   528→  projectName?: string;
   529→  /** Force reinitialize even if exists */
   530→  force?: boolean;
   531→}
   532→
   533→/**
   534→ * Check if a remote exists (default: origin)
   535→ */
   536→export async function hasRemote(projectRoot: string, remoteName = 'origin'): Promise<boolean> {
   537→  try {
   538→    const { stdout } = await execAsync(`git remote get-url ${remoteName}`, {
   539→      cwd: projectRoot,
   540→    });
   541→    return stdout.trim().length > 0;
   542→  } catch {
   543→    return false;
   544→  }
   545→}
   546→
   547→/**
   548→ * Check if a branch exists on a remote
   549→ */
   550→export async function remoteBranchExists(
   551→  projectRoot: string,
   552→  branchName: string,
   553→  remoteName = 'origin'
   554→): Promise<boolean> {
   555→  try {
   556→    execSync(`git show-ref --verify --quiet refs/remotes/${remoteName}/${branchName}`, {
   557→      cwd: projectRoot,
   558→      stdio: ['pipe', 'pipe', 'pipe'],
   559→    });
   560→    return true;
   561→  } catch {
   562→    return false;
   563→  }
   564→}
   565→
   566→/**
   567→ * Fetch from remote to ensure refs are up to date.
   568→ * Returns true if fetch succeeded, false otherwise.
   569→ */
   570→export async function fetchRemote(projectRoot: string, remoteName = 'origin'): Promise<boolean> {
   571→  try {
   572→    await execAsync(`git fetch ${remoteName}`, {
   573→      cwd: projectRoot,
   574→    });
   575→    return true;
   576→  } catch {
   577→    return false;
   578→  }
   579→}
   580→
   581→/**
   582→ * Push shadow branch to remote with tracking.
   583→ * Returns true if push succeeded, false otherwise.
   584→ */
   585→export async function pushShadowBranch(
   586→  worktreeDir: string,
   587→  remoteName = 'origin'
   588→): Promise<boolean> {
   589→  try {
   590→    await execAsync(`git push -u ${remoteName} ${SHADOW_BRANCH_NAME}`, {
   591→      cwd: worktreeDir,
   592→    });
   593→    return true;
   594→  } catch {
   595→    return false;
   596→  }
   597→}
   598→
   599→/**
   600→ * Check if shadow branch has remote tracking configured.
   601→ * AC-4: Used to determine whether sync should be attempted.
   602→ */
   603→export async function hasRemoteTracking(worktreeDir: string): Promise<boolean> {
   604→  try {
   605→    const { stdout } = await execAsync(
   606→      `git config branch.${SHADOW_BRANCH_NAME}.remote`,
   607→      { cwd: worktreeDir }
   608→    );
   609→    return stdout.trim().length > 0;
   610→  } catch {
   611→    return false;
   612→  }
   613→}
   614→
   615→/**
   616→ * Ensure shadow branch has remote tracking configured.
   617→ * AC-8: If shadow has no tracking but main branch has origin remote,
   618→ * automatically configure tracking to origin/kspec-meta.
   619→ *
   620→ * @param worktreeDir Path to .kspec/ worktree
   621→ * @param projectRoot Git repository root
   622→ * @returns true if tracking is now configured (was already or just set up)
   623→ */
   624→export async function ensureRemoteTracking(
   625→  worktreeDir: string,
   626→  projectRoot: string
   627→): Promise<boolean> {
   628→  // Check if already has tracking
   629→  if (await hasRemoteTracking(worktreeDir)) {
   630→    return true;
   631→  }
   632→
   633→  // Check if main branch has origin remote
   634→  if (!(await hasRemote(projectRoot))) {
   635→    return false;
   636→  }
   637→
   638→  // Set up tracking for shadow branch to origin/kspec-meta
   639→  try {
   640→    await execAsync(
   641→      `git config branch.${SHADOW_BRANCH_NAME}.remote origin`,
   642→      { cwd: worktreeDir }
   643→    );
   644→    await execAsync(
   645→      `git config branch.${SHADOW_BRANCH_NAME}.merge refs/heads/${SHADOW_BRANCH_NAME}`,
   646→      { cwd: worktreeDir }
   647→    );
   648→    return true;
   649→  } catch {
   650→    return false;
   651→  }
   652→}
   653→
   654→/**
   655→ * Result from a sync operation
   656→ */
   657→export interface ShadowSyncResult {
   658→  success: boolean;
   659→  pulled: boolean;
   660→  pushed: boolean;
   661→  hadConflict: boolean;
   662→  error?: string;
   663→}
   664→
   665→/**
   666→ * Fire-and-forget push to remote.
   667→ * AC-1: Called after each auto-commit when tracking is configured.
   668→ * AC-8: Automatically sets up tracking if main branch has remote.
   669→ * Silently ignores errors - the local commit succeeded regardless.
   670→ *
   671→ * @param worktreeDir Path to .kspec/ worktree
   672→ * @param verbose Enable debug output
   673→ */
   674→export async function shadowPushAsync(worktreeDir: string, verbose?: boolean): Promise<void> {
   675→  const debug = isDebugMode(verbose);
   676→
   677→  // AC-8: Auto-configure tracking if main has remote but shadow doesn't
   678→  const projectRoot = path.dirname(worktreeDir);
   679→  await ensureRemoteTracking(worktreeDir, projectRoot);
   680→
   681→  // Check if tracking is configured before attempting push
   682→  if (!(await hasRemoteTracking(worktreeDir))) {
   683→    if (debug) {
   684→      console.error('[DEBUG] Shadow push: No remote tracking configured, skipping');
   685→    }
   686→    return; // AC-4: silently skip if no tracking
   687→  }
   688→
   689→  try {
   690→    if (debug) {
   691→      console.error(`[DEBUG] Shadow push: git push (cwd: ${worktreeDir})`);
   692→    }
   693→
   694→    // Don't await - fire and forget
   695→    execAsync('git push', { cwd: worktreeDir }).catch((err) => {
   696→      if (debug) {
   697→        console.error('[DEBUG] Shadow push failed:', err);
   698→      }
   699→      // Silently ignore push failures - local state is correct
   700→    });
   701→  } catch (err) {
   702→    if (debug) {
   703→      console.error('[DEBUG] Shadow push error:', err);
   704→    }
   705→  }
   706→}
   707→
   708→/**
   709→ * Pull remote changes to shadow branch.
   710→ * AC-2: Called at session start to sync before operations.
   711→ * AC-6: Uses --ff-only first, falls back to --rebase.
   712→ * AC-3: On conflict, returns failure with suggestion.
   713→ * AC-8: Automatically sets up tracking if main branch has remote.
   714→ */
   715→export async function shadowPull(worktreeDir: string): Promise<ShadowSyncResult> {
   716→  const result: ShadowSyncResult = {
   717→    success: false,
   718→    pulled: false,
   719→    pushed: false,
   720→    hadConflict: false,
   721→  };
   722→
   723→  // AC-8: Auto-configure tracking if main has remote but shadow doesn't
   724→  const projectRoot = path.dirname(worktreeDir);
   725→  await ensureRemoteTracking(worktreeDir, projectRoot);
   726→
   727→  // AC-4: Skip if no remote tracking
   728→  if (!(await hasRemoteTracking(worktreeDir))) {
   729→    result.success = true;
   730→    return result;
   731→  }
   732→
   733→  // Check if remote branch exists before attempting pull
   734→  // Fetch first to ensure refs are up to date
   735→  await fetchRemote(projectRoot);
   736→  const remoteHasBranch = await remoteBranchExists(projectRoot, SHADOW_BRANCH_NAME);
   737→  if (!remoteHasBranch) {
   738→    // Remote branch doesn't exist yet - nothing to pull, but success
   739→    result.success = true;
   740→    return result;
   741→  }
   742→
   743→  try {
   744→    // Try fast-forward only first (cleanest)
   745→    await execAsync('git pull --ff-only', { cwd: worktreeDir });
   746→    result.success = true;
   747→    result.pulled = true;
   748→    return result;
   749→  } catch {
   750→    // Fast-forward failed, try rebase
   751→  }
   752→
   753→  try {
   754→    // AC-6: Fall back to rebase
   755→    await execAsync('git pull --rebase', { cwd: worktreeDir });
   756→    result.success = true;
   757→    result.pulled = true;
   758→    return result;
   759→  } catch {
   760→    // Rebase failed - likely conflict
   761→  }
   762→
   763→  // AC-3: Conflict detected - abort rebase and report
   764→  try {
   765→    await execAsync('git rebase --abort', { cwd: worktreeDir });
   766→  } catch {
   767→    // May not be in rebase state, ignore
   768→  }
   769→
   770→  result.hadConflict = true;
   771→  result.error = 'Sync conflict detected. Run `kspec shadow resolve` to fix.';
   772→  return result;
   773→}
   774→
   775→/**
   776→ * Full sync operation: pull then push.
   777→ * Used by session start and explicit sync commands.
   778→ */
   779→export async function shadowSync(worktreeDir: string): Promise<ShadowSyncResult> {
   780→  // First pull
   781→  const pullResult = await shadowPull(worktreeDir);
   782→  if (!pullResult.success) {
   783→    return pullResult;
   784→  }
   785→
   786→  // Then push (only if tracking configured, checked inside)
   787→  if (await hasRemoteTracking(worktreeDir)) {
   788→    try {
   789→      await execAsync('git push', { cwd: worktreeDir });
   790→      pullResult.pushed = true;
   791→    } catch {
   792→      // Push failed - not a critical error, local state is correct
   793→      // Could be permissions, network, etc.
   794→    }
   795→  }
   796→
   797→  return pullResult;
   798→}
   799→
   800→/**
   801→ * Check if .gitignore has uncommitted changes
   802→ */
   803→async function hasUncommittedGitignore(projectRoot: string): Promise<boolean> {
   804→  try {
   805→    // Check both staged and unstaged changes to .gitignore
   806→    const { stdout } = await execAsync('git status --porcelain .gitignore', {
   807→      cwd: projectRoot,
   808→    });
   809→    return stdout.trim().length > 0;
   810→  } catch {
   811→    return false;
   812→  }
   813→}
   814→
   815→/**
   816→ * Commit only .gitignore with a message
   817→ */
   818→async function commitGitignore(projectRoot: string): Promise<void> {
   819→  await execAsync('git add .gitignore', { cwd: projectRoot });
   820→  await execAsync('git commit -m "chore: add .kspec/ to .gitignore for shadow branch"', {
   821→    cwd: projectRoot,
   822→  });
   823→}
   824→
   825→/**
   826→ * Add .kspec/ to .gitignore if not already present.
   827→ * Fails if .gitignore has uncommitted changes.
   828→ * Commits the change after adding.
   829→ */
   830→async function ensureGitignore(projectRoot: string): Promise<boolean> {
   831→  const gitignorePath = path.join(projectRoot, '.gitignore');
   832→  const entry = `${SHADOW_WORKTREE_DIR}/`;
   833→
   834→  // Fail fast if .gitignore has uncommitted changes
   835→  if (await hasUncommittedGitignore(projectRoot)) {
   836→    throw new ShadowError(
   837→      '.gitignore has uncommitted changes',
   838→      'GIT_ERROR',
   839→      'Commit or stash your .gitignore changes before running kspec init.'
   840→    );
   841→  }
   842→
   843→  try {
   844→    let content = '';
   845→    try {
   846→      content = await fs.readFile(gitignorePath, 'utf-8');
   847→    } catch {
   848→      // File doesn't exist, will create
   849→    }
   850→
   851→    // Check if already present (handle various formats)
   852→    const lines = content.split('\n');
   853→    const patterns = [
   854→      SHADOW_WORKTREE_DIR,
   855→      `${SHADOW_WORKTREE_DIR}/`,
   856→      `/${SHADOW_WORKTREE_DIR}`,
   857→      `/${SHADOW_WORKTREE_DIR}/`,
   858→    ];
   859→
   860→    for (const line of lines) {
   861→      const trimmed = line.trim();
   862→      if (patterns.includes(trimmed)) {
   863→        return false; // Already present
   864→      }
   865→    }
   866→
   867→    // Add to gitignore
   868→    const newContent = content.endsWith('\n') || content === ''
   869→      ? `${content}${entry}\n`
   870→      : `${content}\n${entry}\n`;
   871→
   872→    await fs.writeFile(gitignorePath, newContent, 'utf-8');
   873→
   874→    // Commit the change
   875→    await commitGitignore(projectRoot);
   876→
   877→    return true;
   878→  } catch (error) {
   879→    if (error instanceof ShadowError) {
   880→      throw error;
   881→    }
   882→    throw new ShadowError(
   883→      `Failed to update .gitignore: ${error}`,
   884→      'GIT_ERROR',
   885→      'Check file permissions for .gitignore'
   886→    );
   887→  }
   888→}
   889→
   890→/**
   891→ * Generate initial manifest content for shadow branch
   892→ */
   893→function generateShadowManifest(projectName: string): string {
   894→  return `# ${projectName} - Kynetic Spec
   895→# Generated by kspec init
   896→
   897→kynetic: "1.0"
   898→
   899→project:
   900→  name: "${projectName}"
   901→  version: "0.1.0"
   902→  status: draft
   903→  description: |
   904→    Add your project description here.
   905→
   906→# Module includes
   907→includes:
   908→  - modules/main.yaml
   909→
   910→# Configuration
   911→config:
   912→  validation:
   913→    strict_refs: true
   914→    require_acceptance: false
   915→`;
   916→}
   917→
   918→/**
   919→ * Generate initial module content
   920→ */
   921→function generateShadowModule(projectName: string): string {
   922→  return `# ${projectName} - Main Module
   923→# Add your spec items here
   924→
   925→items: []
   926→`;
   927→}
   928→
   929→/**
   930→ * Generate initial tasks file
   931→ */
   932→function generateShadowTasks(projectName: string): string {
   933→  return `# ${projectName} - Tasks
   934→# Track implementation work here
   935→
   936→tasks: []
   937→`;
   938→}
   939→
   940→/**
   941→ * Generate initial inbox file
   942→ */
   943→function generateShadowInbox(): string {
   944→  return `# Inbox - Quick Capture
   945→# Ideas and notes that haven't been triaged yet
   946→
   947→items: []
   948→`;
   949→}
   950→
   951→/**
   952→ * Install pre-commit hook to protect kspec-meta branch.
   953→ * Hook prevents direct commits to shadow branch unless KSPEC_SHADOW_COMMIT=1.
   954→ *
   955→ * Note: Git worktrees use hooks from the main .git/hooks directory (via commondir),
   956→ * not from .git/worktrees/-kspec/hooks. So we install to main hooks directory.
   957→ *
   958→ * @param projectRoot Git repository root
   959→ * @returns true if hook was installed, false if already exists
   960→ */
   961→async function installShadowHook(projectRoot: string): Promise<boolean> {
   962→  const hooksDir = path.join(projectRoot, '.git', 'hooks');
   963→  const hookPath = path.join(hooksDir, 'pre-commit');
   964→  const sourceHookPath = path.join(projectRoot, 'hooks', 'pre-commit');
   965→
   966→  try {
   967→    // Check if source hook exists
   968→    try {
   969→      await fs.access(sourceHookPath);
   970→    } catch {
   971→      // Source hook doesn't exist - skip installation
   972→      return false;
   973→    }
   974→
   975→    // Check if hook already exists
   976→    try {
   977→      await fs.access(hookPath);
   978→      // Hook exists - don't overwrite (user may have custom hooks)
   979→      return false;
   980→    } catch {
   981→      // Hook doesn't exist - install it
   982→    }
   983→
   984→    // Copy hook from source
   985→    const hookContent = await fs.readFile(sourceHookPath, 'utf-8');
   986→    await fs.writeFile(hookPath, hookContent, { mode: 0o755 });
   987→    return true;
   988→  } catch (error) {
   989→    // Silently fail - hook installation is optional
   990→    return false;
   991→  }
   992→}
   993→
   994→/**
   995→ * Convert project name to slug (kebab-case)
   996→ */
   997→function toSlug(projectName: string): string {
   998→  return projectName
   999→    .toLowerCase()
  1000→    .replace(/[^a-z0-9]+/g, '-')
  1001→    .replace(/^-|-$/g, '');
  1002→}
  1003→
  1004→/**
  1005→ * Initialize shadow branch and worktree.
  1006→ * Creates orphan branch, worktree, updates gitignore, and creates initial structure.
  1007→ *
  1008→ * @param projectRoot Git repository root
  1009→ * @param options Initialization options
  1010→ * @returns Result indicating what was created
  1011→ */
  1012→export async function initializeShadow(
  1013→  projectRoot: string,
  1014→  options: ShadowInitOptions = {}
  1015→): Promise<ShadowInitResult> {
  1016→  const result: ShadowInitResult = {
  1017→    success: false,
  1018→    branchCreated: false,
  1019→    worktreeCreated: false,
  1020→    gitignoreUpdated: false,
  1021→    initialCommit: false,
  1022→    alreadyExists: false,
  1023→    createdFromRemote: false,
  1024→    pushedToRemote: false,
  1025→  };
  1026→
  1027→  // Check if we're in a git repo
  1028→  if (!(await isGitRepo(projectRoot))) {
  1029→    result.error = 'Not a git repository';
  1030→    return result;
  1031→  }
  1032→
  1033→  const worktreeDir = path.join(projectRoot, SHADOW_WORKTREE_DIR);
  1034→
  1035→  // Check current status
  1036→  const status = await getShadowStatus(projectRoot);
  1037→
  1038→  // Handle existing shadow branch
  1039→  if (status.healthy && !options.force) {
  1040→    result.alreadyExists = true;
  1041→    result.success = true;
  1042→    return result;
  1043→  }
  1044→
  1045→  // Derive project name if not provided
  1046→  const projectName = options.projectName || path.basename(projectRoot)
  1047→    .replace(/[-_]/g, ' ')
  1048→    .replace(/\b\w/g, (c) => c.toUpperCase());
  1049→
  1050→  const slug = toSlug(projectName);
  1051→
  1052→  // Check for remote shadow branch (AC-4: fetch to ensure refs are up to date)
  1053→  const remoteExists = await hasRemote(projectRoot);
  1054→  let remoteHasShadow = false;
  1055→  if (remoteExists) {
  1056→    await fetchRemote(projectRoot); // Best effort, ignore failures
  1057→    remoteHasShadow = await remoteBranchExists(projectRoot, SHADOW_BRANCH_NAME);
  1058→  }
  1059→
  1060→  try {
  1061→    // Step 1: Update .gitignore first (before creating .kspec/)
  1062→    result.gitignoreUpdated = await ensureGitignore(projectRoot);
  1063→
  1064→    // Step 2: Create worktree with orphan branch (or attach to existing branch)
  1065→    if (!status.worktreeExists || !status.worktreeLinked) {
  1066→      // Remove existing directory if present but not linked
  1067→      if (status.worktreeExists && !status.worktreeLinked) {
  1068→        await fs.rm(worktreeDir, { recursive: true, force: true });
  1069→      }
  1070→
  1071→      // Remove stale worktree reference if any
  1072→      try {
  1073→        await execAsync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, {
  1074→          cwd: projectRoot,
  1075→        });
  1076→      } catch {
  1077→        // Ignore - worktree may not exist in git's list
  1078→      }
  1079→
  1080→      if (remoteHasShadow) {
  1081→        // AC-1: Remote has shadow branch - create worktree from it with tracking
  1082→        await execAsync(
  1083→          `git worktree add ${SHADOW_WORKTREE_DIR} ${SHADOW_BRANCH_NAME}`,
  1084→          { cwd: projectRoot }
  1085→        );
  1086→        // Set up tracking for the branch
  1087→        await execAsync(
  1088→          `git branch --set-upstream-to=origin/${SHADOW_BRANCH_NAME} ${SHADOW_BRANCH_NAME}`,
  1089→          { cwd: projectRoot }
  1090→        );
  1091→        result.createdFromRemote = true;
  1092→      } else if (!status.branchExists) {
  1093→        // AC-2/AC-3: No remote branch or no remote - create orphan branch
  1094→        await execAsync(
  1095→          `git worktree add --orphan -b ${SHADOW_BRANCH_NAME} ${SHADOW_WORKTREE_DIR}`,
  1096→          { cwd: projectRoot }
  1097→        );
  1098→        result.branchCreated = true;
  1099→      } else {
  1100→        // Attach to existing local branch
  1101→        await execAsync(
  1102→          `git worktree add ${SHADOW_WORKTREE_DIR} ${SHADOW_BRANCH_NAME}`,
  1103→          { cwd: projectRoot }
  1104→        );
  1105→      }
  1106→
  1107→      result.worktreeCreated = true;
  1108→    }
  1109→
  1110→    // Step 3: Create initial structure if empty (only for new branches, not remote)
  1111→    const manifestPath = path.join(worktreeDir, `${slug}.yaml`);
  1112→    const modulesDir = path.join(worktreeDir, 'modules');
  1113→    const moduleFilePath = path.join(modulesDir, 'main.yaml');
  1114→    const tasksPath = path.join(worktreeDir, `${slug}.tasks.yaml`);
  1115→    const inboxPath = path.join(worktreeDir, `${slug}.inbox.yaml`);
  1116→
  1117→    let filesCreated = false;
  1118→
  1119→    // Only create files if manifest doesn't exist (remote branches will have files)
  1120→    try {
  1121→      // Look for any .yaml manifest file (project name may differ)
  1122→      const files = await fs.readdir(worktreeDir);
  1123→      const hasManifest = files.some(f => f.endsWith('.yaml') && !f.includes('.tasks.') && !f.includes('.inbox.'));
  1124→      if (!hasManifest) {
  1125→        throw new Error('No manifest found');
  1126→      }
  1127→    } catch {
  1128→      // Manifest doesn't exist, create initial structure
  1129→      await fs.mkdir(modulesDir, { recursive: true });
  1130→      await fs.writeFile(manifestPath, generateShadowManifest(projectName), 'utf-8');
  1131→      await fs.writeFile(moduleFilePath, generateShadowModule(projectName), 'utf-8');
  1132→      await fs.writeFile(tasksPath, generateShadowTasks(projectName), 'utf-8');
  1133→      await fs.writeFile(inboxPath, generateShadowInbox(), 'utf-8');
  1134→      filesCreated = true;
  1135→    }
  1136→
  1137→    // Step 4: Initial commit if files were created
  1138→    if (filesCreated) {
  1139→      result.initialCommit = await shadowAutoCommit(
  1140→        worktreeDir,
  1141→        `Initialize ${projectName} spec`
  1142→      );
  1143→    }
  1144→
  1145→    // Step 5: AC-2: Push new branch to remote to establish tracking
  1146→    if (result.branchCreated && remoteExists && !remoteHasShadow) {
  1147→      result.pushedToRemote = await pushShadowBranch(worktreeDir);
  1148→    }
  1149→
  1150→    // Step 6: Install pre-commit hook to protect shadow branch
  1151→    await installShadowHook(projectRoot);
  1152→
  1153→    result.success = true;
  1154→    return result;
  1155→  } catch (error) {
  1156→    result.error = error instanceof Error ? error.message : String(error);
  1157→    return result;
  1158→  }
  1159→}
  1160→
  1161→/**
  1162→ * Repair a broken shadow branch setup.
  1163→ * Handles cases where worktree is disconnected or directory is missing.
  1164→ *
  1165→ * @param projectRoot Git repository root
  1166→ * @returns Result indicating what was repaired
  1167→ */
  1168→export async function repairShadow(projectRoot: string): Promise<ShadowInitResult> {
  1169→  const status = await getShadowStatus(projectRoot);
  1170→
  1171→  if (status.healthy) {
  1172→    return {
  1173→      success: true,
  1174→      branchCreated: false,
  1175→      worktreeCreated: false,
  1176→      gitignoreUpdated: false,
  1177→      initialCommit: false,
  1178→      alreadyExists: true,
  1179→      createdFromRemote: false,
  1180→      pushedToRemote: false,
  1181→    };
  1182→  }
  1183→
  1184→  if (!status.branchExists) {
  1185→    // Can't repair without a branch - need full init
  1186→    return {
  1187→      success: false,
  1188→      branchCreated: false,
  1189→      worktreeCreated: false,
  1190→      gitignoreUpdated: false,
  1191→      initialCommit: false,
  1192→      alreadyExists: false,
  1193→      createdFromRemote: false,
  1194→      pushedToRemote: false,
  1195→      error: 'Shadow branch does not exist. Run `kspec init` instead.',
  1196→    };
  1197→  }
  1198→
  1199→  // Branch exists but worktree is broken - repair it
  1200→  const worktreeDir = path.join(projectRoot, SHADOW_WORKTREE_DIR);
  1201→
  1202→  try {
  1203→    // Remove stale worktree reference
  1204→    try {
  1205→      await execAsync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, {
  1206→        cwd: projectRoot,
  1207→      });
  1208→    } catch {
  1209→      // Ignore - worktree may not be in git's list
  1210→    }
  1211→
  1212→    // Remove directory if exists (handles corrupted .git file case)
  1213→    await fs.rm(worktreeDir, { recursive: true, force: true });
  1214→
  1215→    // Prune stale worktree references (cleans up orphaned entries)
  1216→    try {
  1217→      await execAsync('git worktree prune', { cwd: projectRoot });
  1218→    } catch {
  1219→      // Ignore - prune is best-effort
  1220→    }
  1221→
  1222→    // Recreate worktree
  1223→    await execAsync(
  1224→      `git worktree add ${SHADOW_WORKTREE_DIR} ${SHADOW_BRANCH_NAME}`,
  1225→      { cwd: projectRoot }
  1226→    );
  1227→
  1228→    // Install pre-commit hook
  1229→    await installShadowHook(projectRoot);
  1230→
  1231→    return {
  1232→      success: true,
  1233→      branchCreated: false,
  1234→      worktreeCreated: true,
  1235→      gitignoreUpdated: false,
  1236→      initialCommit: false,
  1237→      alreadyExists: false,
  1238→      createdFromRemote: false,
  1239→      pushedToRemote: false,
  1240→    };
  1241→  } catch (error) {
  1242→    return {
  1243→      success: false,
  1244→      branchCreated: false,
  1245→      worktreeCreated: false,
  1246→      gitignoreUpdated: false,
  1247→      initialCommit: false,
  1248→      alreadyExists: false,
  1249→      createdFromRemote: false,
  1250→      pushedToRemote: false,
  1251→      error: error instanceof Error ? error.message : String(error),
  1252→    };
  1253→  }
  1254→}
  1255→

