```
     1→import { Command } from 'commander';
     2→import {
     3→  initContext,
     4→  loadAllTasks,
     5→  loadAllItems,
     6→  saveTask,
     7→  createTask,
     8→  ReferenceIndex,
     9→  AlignmentIndex,
    10→  type LoadedTask,
    11→  type LoadedSpecItem,
    12→  type KspecContext,
    13→} from '../../parser/index.js';
    14→import { commitIfShadow } from '../../parser/shadow.js';
    15→import { output, success, error, warn, info, isJsonMode } from '../output.js';
    16→import type { TaskInput } from '../../schema/index.js';
    17→import { errors } from '../../strings/index.js';
    18→
    19→/**
    20→ * Fields that contain nested spec items (mirrors yaml.ts)
    21→ */
    22→const NESTED_ITEM_FIELDS = ['modules', 'features', 'requirements', 'constraints', 'decisions'];
    23→
    24→/**
    25→ * Get the parent path from a child's _path.
    26→ * e.g., "features[0].requirements[1]" -> "features[0]"
    27→ * Returns empty string for top-level items.
    28→ */
    29→function getParentPath(childPath: string | undefined): string {
    30→  if (!childPath) return '';
    31→  const lastDotIndex = childPath.lastIndexOf('.');
    32→  if (lastDotIndex === -1) return '';
    33→  return childPath.slice(0, lastDotIndex);
    34→}
    35→
    36→/**
    37→ * Check if an item is a direct child of another item based on _path.
    38→ * Direct children have a path that extends the parent's path by exactly one field[index].
    39→ */
    40→function isDirectChildOf(child: LoadedSpecItem, parent: LoadedSpecItem): boolean {
    41→  const childPath = child._path || '';
    42→  const parentPath = parent._path || '';
    43→
    44→  // If paths are equal, not a child
    45→  if (childPath === parentPath) return false;
    46→
    47→  // Child path must start with parent path
    48→  if (parentPath && !childPath.startsWith(parentPath + '.')) return false;
    49→
    50→  // For root parent (empty path), child must be a top-level path like "features[0]"
    51→  if (!parentPath) {
    52→    // Direct child of root has no '.' in its path
    53→    return !childPath.includes('.');
    54→  }
    55→
    56→  // Get the remaining path after parent
    57→  const remaining = childPath.slice(parentPath.length + 1);
    58→
    59→  // Direct child has no additional '.' (e.g., "requirements[0]" not "requirements[0].something")
    60→  return !remaining.includes('.');
    61→}
    62→
    63→/**
    64→ * Find the parent spec item of a given item.
    65→ * Returns undefined for root-level items.
    66→ */
    67→function findParentItem(
    68→  item: LoadedSpecItem,
    69→  allItems: LoadedSpecItem[]
    70→): LoadedSpecItem | undefined {
    71→  const parentPath = getParentPath(item._path);
    72→
    73→  // Root-level item or no path
    74→  if (!parentPath && !item._path) return undefined;
    75→  if (!parentPath) return undefined;
    76→
    77→  // Find item with matching path in the same source file
    78→  return allItems.find(
    79→    i => i._path === parentPath && i._sourceFile === item._sourceFile
    80→  );
    81→}
    82→
    83→/**
    84→ * Get direct children of a spec item.
    85→ * Only returns immediate children, not grandchildren.
    86→ */
    87→function getDirectChildren(
    88→  parent: LoadedSpecItem,
    89→  allItems: LoadedSpecItem[]
    90→): LoadedSpecItem[] {
    91→  return allItems.filter(
    92→    item => item._sourceFile === parent._sourceFile && isDirectChildOf(item, parent)
    93→  );
    94→}
    95→
    96→/**
    97→ * Collect an item and all its descendants in topological order (parent first).
    98→ * This ensures parent tasks are created before child tasks.
    99→ */
   100→function collectItemsRecursively(
   101→  root: LoadedSpecItem,
   102→  allItems: LoadedSpecItem[]
   103→): LoadedSpecItem[] {
   104→  const result: LoadedSpecItem[] = [root];
   105→  const children = getDirectChildren(root, allItems);
   106→
   107→  for (const child of children) {
   108→    const descendants = collectItemsRecursively(child, allItems);
   109→    result.push(...descendants);
   110→  }
   111→
   112→  return result;
   113→}
   114→
   115→/**
   116→ * Resolve a spec item reference.
   117→ * Returns the spec item or exits with error.
   118→ */
   119→function resolveSpecRef(
   120→  ref: string,
   121→  items: LoadedSpecItem[],
   122→  tasks: LoadedTask[],
   123→  index: ReferenceIndex
   124→): LoadedSpecItem {
   125→  const result = index.resolve(ref);
   126→
   127→  if (!result.ok) {
   128→    switch (result.error) {
   129→      case 'not_found':
   130→        error(errors.reference.specNotFound(ref));
   131→        break;
   132→      case 'ambiguous':
   133→        error(errors.reference.ambiguous(ref));
   134→        for (const candidate of result.candidates) {
   135→          const item = items.find(i => i._ulid === candidate);
   136→          const slug = item?.slugs[0] || '';
   137→          console.error(`  - ${index.shortUlid(candidate)} ${slug ? `(${slug})` : ''}`);
   138→        }
   139→        break;
   140→      case 'duplicate_slug':
   141→        error(errors.reference.slugMapsToMultiple(ref));
   142→        for (const candidate of result.candidates) {
   143→          console.error(`  - ${index.shortUlid(candidate)}`);
   144→        }
   145→        break;
   146→    }
   147→    process.exit(3);
   148→  }
   149→
   150→  // Check if it's actually a spec item (not a task)
   151→  const item = items.find(i => i._ulid === result.ulid);
   152→  if (!item) {
   153→    // Check if it's a task
   154→    const task = tasks.find(t => t._ulid === result.ulid);
   155→    if (task) {
   156→      error(errors.reference.notSpecItem(ref));
   157→    } else {
   158→      error(errors.reference.specNotFound(ref));
   159→    }
   160→    process.exit(3);
   161→  }
   162→
   163→  return item;
   164→}
   165→
   166→/**
   167→ * Generate a slug from a spec item title.
   168→ * Converts "My Feature Title" -> "task-my-feature-title"
   169→ */
   170→function generateSlugFromTitle(title: string): string {
   171→  return (
   172→    'task-' +
   173→    title
   174→      .toLowerCase()
   175→      .replace(/[^a-z0-9]+/g, '-')
   176→      .replace(/^-|-$/g, '')
   177→      .slice(0, 50)
   178→  );
   179→}
   180→
   181→/**
   182→ * Convert spec priority to task priority (number).
   183→ * Spec can use 'high', 'medium', 'low' or numeric 1-5.
   184→ */
   185→function normalizePriority(priority: string | number | undefined): number {
   186→  if (priority === undefined) return 3;
   187→  if (typeof priority === 'number') return priority;
   188→  switch (priority) {
   189→    case 'high':
   190→      return 1;
   191→    case 'medium':
   192→      return 3;
   193→    case 'low':
   194→      return 5;
   195→    default:
   196→      return 3;
   197→  }
   198→}
   199→
   200→/**
   201→ * Result of deriving a task from a spec item
   202→ */
   203→interface DeriveResult {
   204→  specItem: LoadedSpecItem;
   205→  action: 'created' | 'skipped' | 'would_create';
   206→  task?: LoadedTask;
   207→  reason?: string;
   208→  /** Task ref that was used for depends_on (if any) */
   209→  dependsOn?: string[];
   210→}
   211→
   212→/**
   213→ * Derive a task from a spec item.
   214→ * Returns result describing what happened.
   215→ *
   216→ * @param dependsOn - Task references to add as dependencies (for hierarchy-based deps)
   217→ * @param priority - Priority override (1-5), if not provided uses spec's priority
   218→ */
   219→async function deriveTaskFromSpec(
   220→  ctx: KspecContext,
   221→  specItem: LoadedSpecItem,
   222→  existingTasks: LoadedTask[],
   223→  items: LoadedSpecItem[],
   224→  index: ReferenceIndex,
   225→  alignmentIndex: AlignmentIndex,
   226→  options: { force: boolean; dryRun: boolean; dependsOn?: string[]; priority?: number }
   227→): Promise<DeriveResult> {
   228→  // Check if a task already exists for this spec
   229→  const linkedTasks = alignmentIndex.getTasksForSpec(specItem._ulid);
   230→
   231→  if (linkedTasks.length > 0 && !options.force) {
   232→    const taskRef = linkedTasks[0].slugs[0]
   233→      ? `@${linkedTasks[0].slugs[0]}`
   234→      : `@${index.shortUlid(linkedTasks[0]._ulid)}`;
   235→    return {
   236→      specItem,
   237→      action: 'skipped',
   238→      task: linkedTasks[0],
   239→      reason: `task exists: ${taskRef}`,
   240→    };
   241→  }
   242→
   243→  // Check if slug would collide with existing task
   244→  const baseSlug = generateSlugFromTitle(specItem.title);
   245→  let slug = baseSlug;
   246→  let slugSuffix = 1;
   247→
   248→  // Find unique slug if needed
   249→  while (existingTasks.some(t => t.slugs.includes(slug))) {
   250→    slug = `${baseSlug}-${slugSuffix}`;
   251→    slugSuffix++;
   252→  }
   253→
   254→  // Build task input with depends_on
   255→  const taskInput: TaskInput = {
   256→    title: `Implement: ${specItem.title}`,
   257→    type: 'task',
   258→    spec_ref: `@${specItem.slugs[0] || specItem._ulid}`,
   259→    derivation: 'auto',
   260→    priority: options.priority ?? normalizePriority(specItem.priority),
   261→    slugs: [slug],
   262→    tags: [...(specItem.tags || [])],
   263→    depends_on: options.dependsOn || [],
   264→  };
   265→
   266→  // Dry run - don't actually create
   267→  if (options.dryRun) {
   268→    const previewTask = createTask(taskInput) as LoadedTask;
   269→    return {
   270→      specItem,
   271→      action: 'would_create',
   272→      task: previewTask,
   273→      dependsOn: options.dependsOn,
   274→    };
   275→  }
   276→
   277→  // Create and save the task
   278→  const newTask = createTask(taskInput);
   279→  await saveTask(ctx, newTask);
   280→  const specSlug = specItem.slugs[0] || specItem._ulid.slice(0, 8);
   281→  await commitIfShadow(ctx.shadow, 'derive', specSlug);
   282→
   283→  // Add to existing tasks list for slug collision checks
   284→  existingTasks.push(newTask as LoadedTask);
   285→
   286→  return {
   287→    specItem,
   288→    action: 'created',
   289→    task: newTask as LoadedTask,
   290→    dependsOn: options.dependsOn,
   291→  };
   292→}
   293→
   294→/**
   295→ * Get a task reference string for use in depends_on.
   296→ * Prefers slug over ULID for readability.
   297→ */
   298→function getTaskRef(task: LoadedTask, index: ReferenceIndex): string {
   299→  return task.slugs[0] ? `@${task.slugs[0]}` : `@${index.shortUlid(task._ulid)}`;
   300→}
   301→
   302→/**
   303→ * Find or get the task for a parent spec item.
   304→ * Looks in:
   305→ * 1. Tasks created in this derive session (specToTaskMap)
   306→ * 2. Existing tasks linked to the parent spec (alignmentIndex)
   307→ */
   308→function getParentTaskRef(
   309→  parentSpec: LoadedSpecItem,
   310→  specToTaskMap: Map<string, LoadedTask>,
   311→  alignmentIndex: AlignmentIndex,
   312→  index: ReferenceIndex
   313→): string | undefined {
   314→  // Check if we created a task for this parent in this session
   315→  const sessionTask = specToTaskMap.get(parentSpec._ulid);
   316→  if (sessionTask) {
   317→    return getTaskRef(sessionTask, index);
   318→  }
   319→
   320→  // Check if an existing task is linked to this parent spec
   321→  const linkedTasks = alignmentIndex.getTasksForSpec(parentSpec._ulid);
   322→  if (linkedTasks.length > 0) {
   323→    return getTaskRef(linkedTasks[0], index);
   324→  }
   325→
   326→  return undefined;
   327→}
   328→
   329→/**
   330→ * Register the 'derive' command
   331→ */
   332→export function registerDeriveCommand(program: Command): void {
   333→  program
   334→    .command('derive [ref]')
   335→    .description('Create task(s) from spec item(s)')
   336→    .option('--all', 'Derive tasks for all spec items without linked tasks')
   337→    .option('--flat', 'Only derive for the specified item, not children (default: recursive)')
   338→    .option('--force', 'Create task even if one already exists for the spec')
   339→    .option('--dry-run', 'Show what would be created without making changes')
   340→    .option('--priority <n>', 'Set priority for created task(s) (1-5)', parseInt)
   341→    .action(async (ref: string | undefined, options) => {
   342→      try {
   343→        // Validate arguments
   344→        if (!ref && !options.all) {
   345→          error(errors.usage.deriveNoRef);
   346→          console.error('Usage:');
   347→          console.error('  kspec derive @spec-ref');
   348→          console.error('  kspec derive @spec-ref --flat');
   349→          console.error('  kspec derive --all');
   350→          process.exit(2);
   351→        }
   352→
   353→        if (ref && options.all) {
   354→          error(errors.usage.deriveRefAndAll);
   355→          process.exit(2);
   356→        }
   357→
   358→        // Validate priority if provided
   359→        if (options.priority !== undefined) {
   360→          if (isNaN(options.priority) || options.priority < 1 || options.priority > 5) {
   361→            error('Priority must be a number between 1 and 5');
   362→            process.exit(2);
   363→          }
   364→        }
   365→
   366→        const ctx = await initContext();
   367→        const tasks = await loadAllTasks(ctx);
   368→        const items = await loadAllItems(ctx);
   369→        const index = new ReferenceIndex(tasks, items);
   370→
   371→        // Build alignment index
   372→        const alignmentIndex = new AlignmentIndex(tasks, items);
   373→        alignmentIndex.buildLinks(index);
   374→
   375→        // Collect spec items to process
   376→        let specsToDerive: LoadedSpecItem[];
   377→
   378→        if (options.all) {
   379→          // Get all spec items without linked tasks
   380→          specsToDerive = items.filter(item => {
   381→            const linkedTasks = alignmentIndex.getTasksForSpec(item._ulid);
   382→            return linkedTasks.length === 0 || options.force;
   383→          });
   384→
   385→          if (specsToDerive.length === 0) {
   386→            if (isJsonMode()) {
   387→              console.log(JSON.stringify([]));
   388→            } else {
   389→              info('Nothing to derive (all items have tasks)');
   390→            }
   391→            return;
   392→          }
   393→        } else {
   394→          // Single spec item - recursive by default, flat if --flat
   395→          const specItem = resolveSpecRef(ref!, items, tasks, index);
   396→
   397→          if (options.flat) {
   398→            specsToDerive = [specItem];
   399→          } else {
   400→            // Recursive: collect item and all descendants
   401→            specsToDerive = collectItemsRecursively(specItem, items);
   402→          }
   403→        }
   404→
   405→        // Track spec ULID -> created task for dependency resolution
   406→        const specToTaskMap = new Map<string, LoadedTask>();
   407→
   408→        // Process each spec item in order (parents before children due to topological sort)
   409→        const results: DeriveResult[] = [];
   410→
   411→        for (const specItem of specsToDerive) {
   412→          // Determine depends_on based on parent spec's task
   413→          let dependsOn: string[] | undefined;
   414→
   415→          if (!options.flat && !options.all) {
   416→            // Find the parent spec item
   417→            const parentSpec = findParentItem(specItem, items);
   418→
   419→            if (parentSpec) {
   420→              const parentTaskRef = getParentTaskRef(
   421→                parentSpec,
   422→                specToTaskMap,
   423→                alignmentIndex,
   424→                index
   425→              );
   426→              if (parentTaskRef) {
   427→                dependsOn = [parentTaskRef];
   428→              }
   429→            }
   430→          }
   431→
   432→          const result = await deriveTaskFromSpec(
   433→            ctx,
   434→            specItem,
   435→            tasks,
   436→            items,
   437→            index,
   438→            alignmentIndex,
   439→            {
   440→              force: options.force || false,
   441→              dryRun: options.dryRun || false,
   442→              dependsOn,
   443→              priority: options.priority,
   444→            }
   445→          );
   446→
   447→          // Track created/would_create tasks for dependency resolution
   448→          if (result.task && (result.action === 'created' || result.action === 'would_create')) {
   449→            specToTaskMap.set(specItem._ulid, result.task);
   450→          }
   451→          // Also track skipped tasks (existing) for dependency resolution
   452→          if (result.action === 'skipped' && result.task) {
   453→            specToTaskMap.set(specItem._ulid, result.task);
   454→          }
   455→
   456→          results.push(result);
   457→        }
   458→
   459→        // Output results
   460→        if (isJsonMode()) {
   461→          // JSON output format - simplified per AC
   462→          const jsonOutput = results.map(r => ({
   463→            ulid: r.task?._ulid || null,
   464→            slug: r.task?.slugs[0] || null,
   465→            spec_ref: `@${r.specItem.slugs[0] || r.specItem._ulid}`,
   466→            depends_on: r.task?.depends_on || [],
   467→            action: r.action,
   468→          }));
   469→          console.log(JSON.stringify(jsonOutput, null, 2));
   470→          return; // Don't call output() which would output full results in global JSON mode
   471→        } else {
   472→          // Human-readable output
   473→          output(results, () => {
   474→            const created = results.filter(r => r.action === 'created');
   475→            const skipped = results.filter(r => r.action === 'skipped');
   476→            const wouldCreate = results.filter(r => r.action === 'would_create');
   477→
   478→            if (options.dryRun) {
   479→              console.log('Would create:');
   480→              for (const r of wouldCreate) {
   481→                const taskSlug = r.task?.slugs[0] || '';
   482→                const deps = r.dependsOn?.length ? ` (depends: ${r.dependsOn.join(', ')})` : '';
   483→                console.log(`  + ${r.specItem.title}`);
   484→                console.log(`    -> ${taskSlug}${deps}`);
   485→              }
   486→              if (skipped.length > 0) {
   487→                console.log('\nSkipped:');
   488→                for (const r of skipped) {
   489→                  const specRef = r.specItem.slugs[0] ? `@${r.specItem.slugs[0]}` : `@${index.shortUlid(r.specItem._ulid)}`;
   490→                  console.log(`  - ${specRef} (${r.reason})`);
   491→                }
   492→              }
   493→              console.log(`\nWould create ${wouldCreate.length} task(s)`);
   494→              if (skipped.length > 0) {
   495→                console.log(`Skipped ${skipped.length} (already have tasks)`);
   496→              }
   497→              return;
   498→            }
   499→
   500→            if (created.length > 0) {
   501→              for (const r of created) {
   502→                const taskSlug = r.task?.slugs[0] || '';
   503→                const deps = r.dependsOn?.length ? ` (depends: ${r.dependsOn.join(', ')})` : '';
   504→                console.log(`OK Created task: ${taskSlug}${deps}`);
   505→              }
   506→            }
   507→
   508→            if (skipped.length > 0 && !options.all) {
   509→              // Show skipped for explicit derive (not --all)
   510→              for (const r of skipped) {
   511→                const specRef = r.specItem.slugs[0] ? `@${r.specItem.slugs[0]}` : `@${index.shortUlid(r.specItem._ulid)}`;
   512→                console.log(`Skipped ${specRef} (${r.reason})`);
   513→              }
   514→            }
   515→
   516→            // Summary
   517→            if (created.length > 0 || skipped.length > 0) {
   518→              console.log('');
   519→              if (created.length > 0) {
   520→                console.log(`Created ${created.length} task(s)`);
   521→              }
   522→              if (skipped.length > 0) {
   523→                console.log(`Skipped ${skipped.length} (already have tasks)`);
   524→              }
   525→            }
   526→          });
   527→        }
   528→      } catch (err) {
   529→        error(errors.failures.deriveTasks, err);
   530→        process.exit(1);
   531→      }
   532→    });
   533→}
   534→

