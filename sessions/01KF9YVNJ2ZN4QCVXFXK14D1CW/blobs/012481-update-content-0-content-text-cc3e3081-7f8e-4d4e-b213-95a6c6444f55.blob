    25→/**
    26→ * Format convention validation results for display
    27→ * AC: @convention-definitions ac-3, ac-4
    28→ */
    29→function formatConventionValidationResult(result: ConventionValidationResult): void {
    30→  if (result.valid && result.skipped.length === 0) {
    31→    console.log(chalk.green('Conventions: OK'));
    32→    return;
    33→  }
    34→
    35→  // AC: @convention-definitions ac-4
    36→  // Skipped prose conventions
    37→  if (result.skipped.length > 0) {
    38→    for (const domain of result.skipped) {
    39→      console.log(chalk.gray(`ℹ Skipping prose convention: ${domain}`));
    40→    }
    41→  }
    42→
    43→  // AC: @convention-definitions ac-3
    44→  // Validation errors
    45→  if (result.errors.length > 0) {
    46→    console.log(chalk.red(`\nConvention violations: ${result.errors.length}`));
    47→    for (const err of result.errors) {
    48→      console.log(chalk.red(`  ✗ ${err.domain}`));
    49→      console.log(chalk.gray(`    ${err.message}`));
    50→      if (err.expected) {
    51→        console.log(chalk.gray(`    Expected: ${err.expected}`));
    52→      }
    53→      if (err.location) {
    54→        console.log(chalk.gray(`    Location: ${err.location}`));
    55→      }
    56→    }
    57→  } else {
    58→    console.log(chalk.green('\nConventions: OK'));
    59→  }
    60→
    61→  // Stats
    62→  console.log(chalk.gray(`\nConventions checked: ${result.stats.conventionsChecked}`));
    63→  console.log(chalk.gray(`Conventions skipped: ${result.stats.conventionsSkipped}`));
    64→}
    65→
    66→/**
    67→ * Format completeness warnings for display
    68→ * AC: @spec-completeness ac-4
    69→ */
    70→function formatCompletenessWarnings(warnings: CompletenessWarning[], verbose: boolean): void {
    71→  if (warnings.length === 0) {
    72→    console.log(chalk.green('Completeness: OK'));
    73→    return;
    74→  }
    75→
    76→  console.log(chalk.yellow(`\nCompleteness warnings: ${warnings.length}`));
    77→
    78→  // Group by type
    79→  const missingAC = warnings.filter(w => w.type === 'missing_acceptance_criteria');
    80→  const missingDesc = warnings.filter(w => w.type === 'missing_description');
    81→  const statusMismatch = warnings.filter(w => w.type === 'status_inconsistency');
    82→
    83→  // AC: @spec-completeness ac-4
    84→  // Show summary with counts by issue type
    85→  if (missingAC.length > 0) {
    86→    console.log(chalk.yellow(`  Missing acceptance criteria: ${missingAC.length}`));
    87→    const shown = verbose ? missingAC : missingAC.slice(0, 3);
    88→    for (const w of shown) {
    89→      console.log(chalk.gray(`    ○ ${w.itemRef} - ${w.itemTitle}`));
    90→    }
    91→    if (!verbose && missingAC.length > 3) {
    92→      console.log(chalk.gray(`    ... and ${missingAC.length - 3} more`));
    93→    }
    94→  }
    95→
    96→  if (missingDesc.length > 0) {
    97→    console.log(chalk.yellow(`  Missing descriptions: ${missingDesc.length}`));
    98→    const shown = verbose ? missingDesc : missingDesc.slice(0, 3);
    99→    for (const w of shown) {
   100→      console.log(chalk.gray(`    ○ ${w.itemRef} - ${w.itemTitle}`));
   101→    }
   102→    if (!verbose && missingDesc.length > 3) {
   103→      console.log(chalk.gray(`    ... and ${missingDesc.length - 3} more`));
   104→    }
   105→  }
   106→
   107→  if (statusMismatch.length > 0) {
   108→    console.log(chalk.yellow(`  Status inconsistencies: ${statusMismatch.length}`));
   109→    for (const w of statusMismatch) {
   110→      console.log(chalk.yellow(`    ! ${w.message}`));
   111→      if (w.details) {
   112→        console.log(chalk.gray(`      ${w.details}`));
   113→      }
   114→    }
   115→  }
   116→}
   117→
   118→/**
   119→ * Format alignment warnings for display
   120→ */
   121→function formatAlignmentWarnings(warnings: AlignmentWarning[], verbose: boolean): void {
   122→  if (warnings.length === 0) {
   123→    console.log(chalk.green('Alignment: OK'));
   124→    return;
   125→  }
   126→
   127→  console.log(chalk.yellow(`\nAlignment warnings: ${warnings.length}`));
   128→
   129→  // Group by type
   130→  const orphaned = warnings.filter(w => w.type === 'orphaned_spec');
   131→  const mismatches = warnings.filter(w => w.type === 'status_mismatch');
   132→  const stale = warnings.filter(w => w.type === 'stale_implementation');
   133→
   134→  if (orphaned.length > 0) {
   135→    console.log(chalk.yellow(`  Orphaned specs (no tasks): ${orphaned.length}`));
   136→    const shown = verbose ? orphaned : orphaned.slice(0, 3);
   137→    for (const w of shown) {
   138→      console.log(chalk.gray(`    ○ ${w.specTitle}`));
   139→    }
   140→    if (!verbose && orphaned.length > 3) {
   141→      console.log(chalk.gray(`    ... and ${orphaned.length - 3} more`));
   142→    }
   143→  }
   144→
   145→  if (mismatches.length > 0) {
   146→    console.log(chalk.yellow(`  Status mismatches: ${mismatches.length}`));
   147→    for (const w of mismatches) {
   148→      console.log(chalk.yellow(`    ! ${w.specTitle}`));
   149→      console.log(chalk.gray(`      ${w.message}`));
   150→    }
   151→  }
   152→
   153→  if (stale.length > 0) {
   154→    console.log(chalk.yellow(`  Stale implementation status: ${stale.length}`));
   155→    for (const w of stale) {
   156→      console.log(chalk.yellow(`    ! ${w.message}`));
   157→    }
   158→  }
   159→}
   160→
   161→/**
   162→ * Format fix results for display
   163→ */
   164→function formatFixResult(result: FixResult): void {
   165→  if (result.fixesApplied.length === 0) {
   166→    console.log(chalk.gray('\nNo auto-fixable issues found.'));
   167→    return;
   168→  }
   169→
   170→  console.log(chalk.cyan(`\n✓ Applied ${result.fixesApplied.length} fix(es) to ${result.filesModified} file(s):`));
   171→
   172→  for (const fix of result.fixesApplied) {
   173→    const typeLabel = {
   174→      ulid_regenerated: 'ULID regenerated',
   175→      timestamp_added: 'Timestamp added',
   176→      status_added: 'Status added',
   177→    }[fix.type];
   178→
   179→    const shortFile = path.basename(fix.file);
   180→    console.log(chalk.cyan(`  ✓ ${shortFile}:${fix.path} - ${typeLabel}`));
   181→  }
   182→
   183→  if (result.errors.length > 0) {
   184→    console.log(chalk.yellow(`\nFix errors: ${result.errors.length}`));
   185→    for (const err of result.errors) {
   186→      console.log(chalk.yellow(`  ! ${err.file}: ${err.message}`));
   187→    }
   188→  }
   189→}
   190→
   191→/**
   192→ * Collect all files that can be fixed
   193→ */
   194→async function collectFixableFiles(ctx: { rootDir: string; specDir?: string; manifest?: { includes?: string[] } | null; manifestPath?: string | null }): Promise<string[]> {
   195→  const files: string[] = [];
   196→
   197→  // Task files (exclude test fixtures)
   198→  const taskFiles = await findTaskFiles(ctx.rootDir);
   199→  const specTaskFiles = await findTaskFiles(path.join(ctx.rootDir, 'spec'));
   200→  const allTaskFiles = [...new Set([...taskFiles, ...specTaskFiles])];
   201→  files.push(...allTaskFiles.filter(f => !f.includes('fixtures') && !f.includes('test')));
   202→
   203→  // Spec files from includes
   204→  if (ctx.manifest && ctx.manifestPath) {
   205→    const manifestDir = path.dirname(ctx.manifestPath);
   206→    const includes = ctx.manifest.includes || [];
   207→
   208→    for (const include of includes) {
   209→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   210→      files.push(...expandedPaths);
   211→    }
   212→  }
   213→
   214→  // Inbox file
   215→  const inboxPath = path.join(ctx.rootDir, 'spec', 'kynetic.inbox.yaml');
   216→  try {
   217→    await import('node:fs/promises').then(fs => fs.access(inboxPath));
   218→    files.push(inboxPath);
   219→  } catch {
   220→    // Inbox file doesn't exist, skip
   221→  }
   222→
   223→  return [...new Set(files)];
   224→}
   225→
   226→/**
   227→ * Format validation result for display
   228→ */
   229→function formatValidationResult(result: ValidationResult, verbose: boolean): void {
   230→  // Header
   231→  if (result.valid) {
   232→    console.log(chalk.green.bold('✓ Validation passed'));
   233→  } else {
   234→    console.log(chalk.red.bold('✗ Validation failed'));
   235→  }
   236→
   237→  console.log(chalk.gray('─'.repeat(40)));
   238→  console.log(`Files checked: ${result.stats.filesChecked}`);
   239→  console.log(`Items checked: ${result.stats.itemsChecked}`);
   240→  console.log(`Tasks checked: ${result.stats.tasksChecked}`);
   241→
   242→  // AC-meta-manifest-2: Display meta summary line
   243→  if (result.metaStats) {
   244→    console.log(`Meta: ${result.metaStats.agents} agents, ${result.metaStats.workflows} workflows, ${result.metaStats.conventions} conventions`);
   245→  }
   246→
   247→  // Schema errors
   248→  if (result.schemaErrors.length > 0) {
   249→    console.log(chalk.red(`\nSchema errors: ${result.schemaErrors.length}`));
   250→    for (const err of result.schemaErrors) {
   251→      const location = err.path ? `${err.file}:${err.path}` : err.file;
   252→      console.log(chalk.red(`  ✗ ${location}`));
   253→      console.log(chalk.gray(`    ${err.message}`));
   254→      if (verbose && err.details) {
   255→        console.log(chalk.gray(`    ${JSON.stringify(err.details)}`));
   256→      }
   257→    }
   258→  } else {
   259→    console.log(chalk.green('\nSchema: OK'));
   260→  }
   261→
   262→  // Reference errors
   263→  if (result.refErrors.length > 0) {
   264→    console.log(chalk.red(`\nReference errors: ${result.refErrors.length}`));
   265→    for (const err of result.refErrors) {
   266→      const location = err.sourceFile
   267→        ? `${err.sourceFile} (${err.field})`
   268→        : `${err.sourceUlid?.slice(0, 8)} (${err.field})`;
   269→      console.log(chalk.red(`  ✗ ${err.ref}`));
   270→      console.log(chalk.gray(`    ${err.message}`));
   271→      console.log(chalk.gray(`    in: ${location}`));
   272→    }
   273→  } else {
   274→    console.log(chalk.green('References: OK'));
   275→  }
   276→
   277→  // Reference warnings (deprecated targets)
   278→  if (result.refWarnings.length > 0) {
   279→    console.log(chalk.yellow(`\nReference warnings: ${result.refWarnings.length}`));
   280→    const shown = verbose ? result.refWarnings : result.refWarnings.slice(0, 5);
   281→    for (const warn of shown) {
   282→      const location = warn.sourceFile
   283→        ? `${warn.sourceFile} (${warn.field})`
   284→        : `${warn.sourceUlid?.slice(0, 8)} (${warn.field})`;
   285→      console.log(chalk.yellow(`  ⚠ ${warn.ref}`));
   286→      console.log(chalk.gray(`    ${warn.message}`));
   287→      console.log(chalk.gray(`    in: ${location}`));
   288→    }
   289→    if (!verbose && result.refWarnings.length > 5) {
   290→      console.log(chalk.gray(`  ... and ${result.refWarnings.length - 5} more (use -v to see all)`));
   291→    }
   292→  }
   293→
   294→  // Orphans (warnings, not errors)
   295→  if (result.orphans.length > 0) {
   296→    console.log(chalk.yellow(`\nOrphans (not referenced): ${result.orphans.length}`));
   297→    if (verbose) {
   298→      for (const orphan of result.orphans) {
   299→        console.log(chalk.yellow(`  ○ ${orphan.ulid.slice(0, 8)} [${orphan.type}] ${orphan.title}`));
   300→      }
   301→    } else {
   302→      // Show first few
   303→      const shown = result.orphans.slice(0, 5);
   304→      for (const orphan of shown) {
   305→        console.log(chalk.yellow(`  ○ ${orphan.ulid.slice(0, 8)} [${orphan.type}] ${orphan.title}`));
   306→      }
   307→      if (result.orphans.length > 5) {
   308→        console.log(chalk.gray(`  ... and ${result.orphans.length - 5} more (use -v to see all)`));
   309→      }
   310→    }
   311→  }
   312→}
   313→
   314→/**
   315→ * Register validate command
   316→ */
   317→export function registerValidateCommand(program: Command): void {
   318→  program
   319→    .command('validate')
   320→    .description('Validate spec files')
   321→    .option('--schema', 'Check schema conformance only')
   322→    .option('--refs', 'Check reference resolution only')
   323→    .option('--orphans', 'Find orphaned items only')
   324→    .option('--alignment', 'Check spec-task alignment')
   325→    .option('--completeness', 'Check spec completeness (missing AC, descriptions, status inconsistencies)')
   326→    .option('--conventions', 'Validate conventions')
   327→    .option('--fix', 'Auto-fix issues where possible (invalid ULIDs, missing timestamps)')
   328→    .option('-v, --verbose', 'Show detailed output')
   329→    .option('--strict', 'Treat orphans as errors')
   330→    .action(async (options) => {
   331→      try {
   332→        const ctx = await initContext();
   333→
   334→        if (!ctx.manifestPath) {
   335→          error(validationStrings.noManifest);
   336→          console.log(validationStrings.initHint);
   337→          process.exit(1);
   338→        }
   339→
   340→        // Determine which checks to run
   341→        const runAll = !options.schema && !options.refs && !options.orphans && !options.alignment && !options.completeness && !options.conventions;
   342→        const validateOptions = {
   343→          schema: runAll || options.schema,
   344→          refs: runAll || options.refs,
   345→          orphans: runAll || options.orphans,
   346→          completeness: runAll || options.completeness,
   347→        };
   348→
   349→        const result = await validate(ctx, validateOptions);
   350→
   351→        // In strict mode, orphans are errors
   352→        if (options.strict && result.orphans.length > 0) {
   353→          result.valid = false;
   354→        }
   355→
   356→        output(result, () => formatValidationResult(result, options.verbose));
   357→
   358→        // Run auto-fix if requested
   359→        if (options.fix) {
   360→          const filesToFix = await collectFixableFiles(ctx);
   361→          const fixResult = await fixFiles(filesToFix);
   362→          formatFixResult(fixResult);
   363→
   364→          // Re-run validation after fixes to show updated status
   365→          if (fixResult.fixesApplied.length > 0) {
   366→            console.log(validationStrings.revalidating);
   367→            const revalidateResult = await validate(ctx, validateOptions);
   368→            if (revalidateResult.valid) {
   369→              console.log(validationStrings.nowPasses);
   370→            } else {
   371→              console.log(validationStrings.issuesRemain);
   372→            }
   373→            // Update result for exit code
   374→            result.valid = revalidateResult.valid;
   375→            result.schemaErrors = revalidateResult.schemaErrors;
   376→            result.refErrors = revalidateResult.refErrors;
   377→          }
   378→        }
   379→
   380→        // Run alignment check if requested or running all checks
   381→        if (options.alignment || runAll) {
   382→          const tasks = await loadAllTasks(ctx);
   383→          const items = await loadAllItems(ctx);
   384→          const refIndex = new ReferenceIndex(tasks, items);
   385→          const alignmentIndex = new AlignmentIndex(tasks, items);
   386→          alignmentIndex.buildLinks(refIndex);
   387→
   388→          const alignmentWarnings = alignmentIndex.findAlignmentWarnings();
   389→          formatAlignmentWarnings(alignmentWarnings, options.verbose);
   390→
   391→          // Show alignment stats
   392→          const stats = alignmentIndex.getStats();
   393→          console.log(
   394→            validationStrings.alignmentStats(stats.specsWithTasks, stats.totalSpecs, stats.alignedSpecs)
   395→          );
   396→        }
   397→
   398→        // Show completeness warnings if any
   399→        // AC: @spec-completeness ac-4
   400→        if (result.completenessWarnings.length > 0) {
   401→          formatCompletenessWarnings(result.completenessWarnings, options.verbose);
   402→        }
   403→
   404→        // Run convention validation if requested
   405→        // AC: @convention-definitions ac-3, ac-4
   406→        if (options.conventions) {
   407→          try {
   408→            const metaCtx = await loadMetaContext(ctx);
   409→            if (metaCtx && metaCtx.conventions.length > 0) {
   410→              // For now, we just validate that conventions are well-formed
   411→              // Full validation against actual content (commits, notes, etc.)
   412→              // would require additional content gathering logic
   413→              const conventionResult = validateConventions(metaCtx.conventions, {});
   414→              formatConventionValidationResult(conventionResult);
   415→
   416→              if (!conventionResult.valid) {
   417→                result.valid = false;
   418→              }
   419→            } else {
   420→              console.log(chalk.gray('No conventions defined in meta manifest'));
   421→            }
   422→          } catch (err) {
   423→            console.log(chalk.yellow('Warning: Could not load meta manifest for convention validation'));
   424→          }
   425→        }
   426→
   427→        if (!result.valid) {
   428→          process.exit(1);
   429→        }
   430→      } catch (err) {
   431→        error(validationStrings.failed, err);
   432→        process.exit(1);
   433→      }
   434→    });
   435→
   436→  // Alias: kspec lint
   437→  program
   438→    .command('lint')
   439→    .description('Alias for validate with style checks')
   440→    .option('--schema', 'Check schema conformance only')
   441→    .option('--refs', 'Check reference resolution only')
   442→    .option('--orphans', 'Find orphaned items only')
   443→    .option('--completeness', 'Check spec completeness (missing AC, descriptions, status inconsistencies)')
   444→    .option('--fix', 'Auto-fix issues where possible (invalid ULIDs, missing timestamps)')
   445→    .option('-v, --verbose', 'Show detailed output')
   446→    .option('--strict', 'Treat orphans as errors')
   447→    .action(async (options) => {
   448→      try {
   449→        const ctx = await initContext();
   450→
   451→        if (!ctx.manifestPath) {
   452→          error(validationStrings.noManifest);
   453→          process.exit(1);
   454→        }
   455→
   456→        const runAll = !options.schema && !options.refs && !options.orphans && !options.completeness;
   457→        const validateOptions = {
   458→          schema: runAll || options.schema,
   459→          refs: runAll || options.refs,
   460→          orphans: runAll || options.orphans,
   461→          completeness: runAll || options.completeness,
   462→        };
   463→
   464→        const result = await validate(ctx, validateOptions);
   465→
   466→        if (options.strict && result.orphans.length > 0) {
   467→          result.valid = false;
   468→        }
   469→
   470→        output(result, () => formatValidationResult(result, options.verbose));
   471→
   472→        // Run auto-fix if requested
   473→        if (options.fix) {
   474→          const filesToFix = await collectFixableFiles(ctx);
   475→          const fixResult = await fixFiles(filesToFix);
   476→          formatFixResult(fixResult);
   477→
   478→          // Re-run validation after fixes
   479→          if (fixResult.fixesApplied.length > 0) {
   480→            console.log(validationStrings.revalidating);
   481→            const revalidateResult = await validate(ctx, validateOptions);
   482→            if (revalidateResult.valid) {
   483→              console.log(validationStrings.nowPasses);
   484→            } else {
   485→              console.log(validationStrings.issuesRemain);
   486→            }
   487→            result.valid = revalidateResult.valid;
   488→          }
   489→        }
   490→
   491→        if (!result.valid) {
   492→          process.exit(1);
   493→        }
   494→      } catch (err) {
   495→        error(validationStrings.lintFailed, err);
   496→        process.exit(1);
   497→      }
   498→    });
   499→}
