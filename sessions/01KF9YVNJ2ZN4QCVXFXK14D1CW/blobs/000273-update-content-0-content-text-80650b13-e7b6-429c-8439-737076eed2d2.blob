```
     1→/**
     2→ * Meta CLI commands for interacting with meta-spec.
     3→ *
     4→ * AC-meta-manifest-1: kspec meta show outputs summary
     5→ * AC-meta-manifest-2: kspec validate includes meta line
     6→ * AC-meta-manifest-3: kspec validate shows meta errors with prefix
     7→ * AC-agent-1: kspec meta agents outputs table
     8→ * AC-agent-2: kspec meta agents --json outputs JSON
     9→ */
    10→
    11→import { Command } from 'commander';
    12→import chalk from 'chalk';
    13→import Table from 'cli-table3';
    14→import { ulid } from 'ulid';
    15→import {
    16→  initContext,
    17→  loadMetaContext,
    18→  getMetaStats,
    19→  createObservation,
    20→  saveObservation,
    21→  saveMetaItem,
    22→  deleteMetaItem,
    23→  createTask,
    24→  saveTask,
    25→  loadAllTasks,
    26→  loadAllItems,
    27→  ReferenceIndex,
    28→  loadSessionContext,
    29→  saveSessionContext,
    30→  type MetaContext,
    31→  type Agent,
    32→  type Workflow,
    33→  type Convention,
    34→  type Observation,
    35→  type LoadedTask,
    36→} from '../../parser/index.js';
    37→import { type ObservationType } from '../../schema/index.js';
    38→import { output, error, success, isJsonMode } from '../output.js';
    39→import { errors } from '../../strings/errors.js';
    40→import { commitIfShadow } from '../../parser/shadow.js';
    41→
    42→/**
    43→ * Resolve a meta reference to its ULID
    44→ * Handles semantic IDs (agent.id, workflow.id, convention.domain) and ULID prefixes
    45→ */
    46→function resolveMetaRefToUlid(
    47→  ref: string,
    48→  metaCtx: MetaContext
    49→): { ulid: string; type: 'agent' | 'workflow' | 'convention' | 'observation' } | null {
    50→  const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
    51→
    52→  // Check agents
    53→  const agent = (metaCtx.agents || []).find(
    54→    (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef)
    55→  );
    56→  if (agent) return { ulid: agent._ulid, type: 'agent' };
    57→
    58→  // Check workflows
    59→  const workflow = (metaCtx.workflows || []).find(
    60→    (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef)
    61→  );
    62→  if (workflow) return { ulid: workflow._ulid, type: 'workflow' };
    63→
    64→  // Check conventions
    65→  const convention = (metaCtx.conventions || []).find(
    66→    (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef)
    67→  );
    68→  if (convention) return { ulid: convention._ulid, type: 'convention' };
    69→
    70→  // Check observations
    71→  const observation = (metaCtx.observations || []).find((o) =>
    72→    o._ulid.startsWith(normalizedRef)
    73→  );
    74→  if (observation) return { ulid: observation._ulid, type: 'observation' };
    75→
    76→  return null;
    77→}
    78→
    79→/**
    80→ * Format meta show output
    81→ */
    82→function formatMetaShow(meta: MetaContext): void {
    83→  const stats = getMetaStats(meta);
    84→
    85→  if (!meta.manifest) {
    86→    console.log(chalk.yellow('No meta manifest found (kynetic.meta.yaml)'));
    87→    console.log(chalk.gray('Create one to define agents, workflows, conventions, and observations'));
    88→    return;
    89→  }
    90→
    91→  console.log(chalk.bold('Meta-Spec Summary'));
    92→  console.log(chalk.gray('─'.repeat(40)));
    93→  console.log(`Agents:       ${stats.agents}`);
    94→  console.log(`Workflows:    ${stats.workflows}`);
    95→  console.log(`Conventions:  ${stats.conventions}`);
    96→  console.log(`Observations: ${stats.observations} (${stats.unresolvedObservations} unresolved)`);
    97→}
    98→
    99→/**
   100→ * Format agents table output
   101→ * AC-agent-1: outputs table with columns: ID, Name, Capabilities
   102→ */
   103→function formatAgents(agents: Agent[]): void {
   104→  if (agents.length === 0) {
   105→    console.log(chalk.yellow('No agents defined'));
   106→    return;
   107→  }
   108→
   109→  const table = new Table({
   110→    head: [chalk.bold('ID'), chalk.bold('Name'), chalk.bold('Capabilities')],
   111→    style: {
   112→      head: [],
   113→      border: [],
   114→    },
   115→  });
   116→
   117→  for (const agent of agents) {
   118→    table.push([
   119→      agent.id,
   120→      agent.name,
   121→      agent.capabilities.join(', '),
   122→    ]);
   123→  }
   124→
   125→  console.log(table.toString());
   126→}
   127→
   128→/**
   129→ * Format workflows table output
   130→ * AC-workflow-1: outputs table with columns: ID, Trigger, Steps (count)
   131→ */
   132→function formatWorkflows(workflows: Workflow[]): void {
   133→  if (workflows.length === 0) {
   134→    console.log(chalk.yellow('No workflows defined'));
   135→    return;
   136→  }
   137→
   138→  const table = new Table({
   139→    head: [chalk.bold('ID'), chalk.bold('Trigger'), chalk.bold('Steps')],
   140→    style: {
   141→      head: [],
   142→      border: [],
   143→    },
   144→  });
   145→
   146→  for (const workflow of workflows) {
   147→    table.push([
   148→      workflow.id,
   149→      workflow.trigger,
   150→      workflow.steps.length.toString(),
   151→    ]);
   152→  }
   153→
   154→  console.log(table.toString());
   155→}
   156→
   157→/**
   158→ * Format workflows verbose output
   159→ * AC-workflow-2: outputs each workflow with full step list
   160→ */
   161→function formatWorkflowsVerbose(workflows: Workflow[]): void {
   162→  if (workflows.length === 0) {
   163→    console.log(chalk.yellow('No workflows defined'));
   164→    return;
   165→  }
   166→
   167→  for (const workflow of workflows) {
   168→    console.log(chalk.bold(`${workflow.id} - ${workflow.trigger}`));
   169→    if (workflow.description) {
   170→      console.log(chalk.gray(workflow.description));
   171→    }
   172→    console.log(chalk.gray('─'.repeat(60)));
   173→
   174→    for (const step of workflow.steps) {
   175→      const prefix = {
   176→        check: chalk.yellow('[check]'),
   177→        action: chalk.blue('[action]'),
   178→        decision: chalk.magenta('[decision]'),
   179→      }[step.type];
   180→
   181→      console.log(`${prefix} ${step.content}`);
   182→
   183→      if (step.on_fail) {
   184→        console.log(chalk.gray(`  → on fail: ${step.on_fail}`));
   185→      }
   186→
   187→      if (step.options && step.options.length > 0) {
   188→        for (const option of step.options) {
   189→          console.log(chalk.gray(`  • ${option}`));
   190→        }
   191→      }
   192→    }
   193→
   194→    console.log('');
   195→  }
   196→}
   197→
   198→/**
   199→ * Format conventions table output
   200→ * AC-conv-1: outputs table with columns: Domain, Rules (count), Validation (yes/no)
   201→ */
   202→function formatConventions(conventions: Convention[]): void {
   203→  if (conventions.length === 0) {
   204→    console.log(chalk.yellow('No conventions defined'));
   205→    return;
   206→  }
   207→
   208→  const table = new Table({
   209→    head: [chalk.bold('Domain'), chalk.bold('Rules'), chalk.bold('Validation')],
   210→    style: {
   211→      head: [],
   212→      border: [],
   213→    },
   214→  });
   215→
   216→  for (const convention of conventions) {
   217→    table.push([
   218→      convention.domain,
   219→      convention.rules.length.toString(),
   220→      convention.validation ? 'yes' : 'no',
   221→    ]);
   222→  }
   223→
   224→  console.log(table.toString());
   225→}
   226→
   227→/**
   228→ * Format convention detail output
   229→ * AC-conv-2: outputs full rules list and examples
   230→ */
   231→function formatConventionDetail(convention: Convention): void {
   232→  console.log(chalk.bold(`${convention.domain} Convention`));
   233→  console.log(chalk.gray('─'.repeat(60)));
   234→
   235→  console.log(chalk.bold('\nRules:'));
   236→  for (const rule of convention.rules) {
   237→    console.log(`  • ${rule}`);
   238→  }
   239→
   240→  if (convention.examples && convention.examples.length > 0) {
   241→    console.log(chalk.bold('\nExamples:'));
   242→    for (const example of convention.examples) {
   243→      console.log(chalk.green(`  ✓ ${example.good}`));
   244→      console.log(chalk.red(`  ✗ ${example.bad}`));
   245→    }
   246→  }
   247→
   248→  if (convention.validation) {
   249→    console.log(chalk.bold('\nValidation:'));
   250→    console.log(`  Type: ${convention.validation.type}`);
   251→    if (convention.validation.pattern) {
   252→      console.log(`  Pattern: ${convention.validation.pattern}`);
   253→    }
   254→    if (convention.validation.message) {
   255→      console.log(`  Message: ${convention.validation.message}`);
   256→    }
   257→  }
   258→
   259→  console.log('');
   260→}
   261→
   262→/**
   263→ * Format observations table output
   264→ * AC-obs-2: outputs table with columns: ID, Type, Workflow, Created, Content (truncated)
   265→ */
   266→function formatObservations(observations: Observation[], showResolved: boolean): void {
   267→  const filtered = showResolved ? observations : observations.filter(o => !o.resolved);
   268→
   269→  if (filtered.length === 0) {
   270→    console.log(chalk.yellow(showResolved ? 'No observations found' : 'No unresolved observations'));
   271→    return;
   272→  }
   273→
   274→  const table = new Table({
   275→    head: [
   276→      chalk.bold('ID'),
   277→      chalk.bold('Type'),
   278→      chalk.bold('Workflow'),
   279→      chalk.bold('Created'),
   280→      chalk.bold('Content'),
   281→    ],
   282→    style: {
   283→      head: [],
   284→      border: [],
   285→    },
   286→    colWidths: [10, 10, 20, 12, 50],
   287→    wordWrap: true,
   288→  });
   289→
   290→  for (const obs of filtered) {
   291→    const id = obs._ulid.substring(0, 8);
   292→    const workflow = obs.workflow_ref || '-';
   293→    const created = new Date(obs.created_at).toISOString().split('T')[0];
   294→    const content = obs.content.length > 47 ? obs.content.substring(0, 47) + '...' : obs.content;
   295→
   296→    table.push([id, obs.type, workflow, created, content]);
   297→  }
   298→
   299→  console.log(table.toString());
   300→}
   301→
   302→/**
   303→ * Register meta commands
   304→ */
   305→export function registerMetaCommands(program: Command): void {
   306→  const meta = program
   307→    .command('meta')
   308→    .description('Meta-spec commands (agents, workflows, conventions, observations)');
   309→
   310→  // AC-meta-manifest-1: kspec meta show outputs summary with counts
   311→  meta
   312→    .command('show')
   313→    .description('Display meta-spec summary')
   314→    .action(async () => {
   315→      try {
   316→        const ctx = await initContext();
   317→
   318→        if (!ctx.manifestPath) {
   319→          error(errors.project.noKspecProject);
   320→          process.exit(1);
   321→        }
   322→
   323→        const metaCtx = await loadMetaContext(ctx);
   324→        const stats = getMetaStats(metaCtx);
   325→
   326→        output(
   327→          {
   328→            manifest: metaCtx.manifestPath,
   329→            stats,
   330→          },
   331→          () => formatMetaShow(metaCtx)
   332→        );
   333→      } catch (err) {
   334→        error(errors.failures.showMeta, err);
   335→        process.exit(1);
   336→      }
   337→    });
   338→
   339→  // AC-agent-1, AC-agent-2: kspec meta agents
   340→  meta
   341→    .command('agents')
   342→    .description('List agents defined in meta-spec')
   343→    .action(async () => {
   344→      try {
   345→        const ctx = await initContext();
   346→
   347→        if (!ctx.manifestPath) {
   348→          error(errors.project.noKspecProject);
   349→          process.exit(1);
   350→        }
   351→
   352→        const metaCtx = await loadMetaContext(ctx);
   353→        const agents = metaCtx.agents || [];
   354→
   355→        // AC-agent-2: JSON output includes full agent details
   356→        output(
   357→          agents.map((agent) => ({
   358→            id: agent.id,
   359→            name: agent.name,
   360→            description: agent.description,
   361→            capabilities: agent.capabilities,
   362→            tools: agent.tools,
   363→            session_protocol: agent.session_protocol,
   364→            conventions: agent.conventions,
   365→          })),
   366→          // AC-agent-1: Table output with ID, Name, Capabilities
   367→          () => formatAgents(agents)
   368→        );
   369→      } catch (err) {
   370→        error(errors.failures.listAgents, err);
   371→        process.exit(1);
   372→      }
   373→    });
   374→
   375→  // AC-workflow-1, AC-workflow-2, AC-workflow-4: kspec meta workflows
   376→  meta
   377→    .command('workflows')
   378→    .description('List workflows defined in meta-spec')
   379→    .option('--verbose', 'Show full workflow details with all steps')
   380→    .action(async (options) => {
   381→      try {
   382→        const ctx = await initContext();
   383→
   384→        if (!ctx.manifestPath) {
   385→          error(errors.project.noKspecProject);
   386→          process.exit(1);
   387→        }
   388→
   389→        const metaCtx = await loadMetaContext(ctx);
   390→        const workflows = metaCtx.workflows || [];
   391→
   392→        // AC-workflow-4: JSON output includes full workflow details
   393→        output(
   394→          workflows.map((workflow) => ({
   395→            id: workflow.id,
   396→            trigger: workflow.trigger,
   397→            description: workflow.description,
   398→            steps: workflow.steps,
   399→          })),
   400→          // AC-workflow-1 (table) or AC-workflow-2 (verbose)
   401→          () => {
   402→            if (options.verbose) {
   403→              formatWorkflowsVerbose(workflows);
   404→            } else {
   405→              formatWorkflows(workflows);
   406→            }
   407→          }
   408→        );
   409→      } catch (err) {
   410→        error(errors.failures.listWorkflows, err);
   411→        process.exit(1);
   412→      }
   413→    });
   414→
   415→  // AC-conv-1, AC-conv-2, AC-conv-5: kspec meta conventions
   416→  meta
   417→    .command('conventions')
   418→    .description('List conventions defined in meta-spec')
   419→    .option('--domain <domain>', 'Filter by specific domain')
   420→    .action(async (options) => {
   421→      try {
   422→        const ctx = await initContext();
   423→
   424→        if (!ctx.manifestPath) {
   425→          error(errors.project.noKspecProject);
   426→          process.exit(1);
   427→        }
   428→
   429→        const metaCtx = await loadMetaContext(ctx);
   430→        const conventions = metaCtx.conventions || [];
   431→
   432→        // AC-conv-2: Filter by domain if specified
   433→        const filtered = options.domain
   434→          ? conventions.filter((c) => c.domain === options.domain)
   435→          : conventions;
   436→
   437→        // AC-conv-5: JSON output includes full convention details
   438→        output(
   439→          filtered.map((convention) => ({
   440→            domain: convention.domain,
   441→            rules: convention.rules,
   442→            examples: convention.examples,
   443→            validation: convention.validation,
   444→          })),
   445→          // AC-conv-1 (table) or AC-conv-2 (detail for single domain)
   446→          () => {
   447→            if (options.domain && filtered.length === 1) {
   448→              formatConventionDetail(filtered[0]);
   449→            } else {
   450→              formatConventions(filtered);
   451→            }
   452→          }
   453→        );
   454→      } catch (err) {
   455→        error(errors.failures.listConventions, err);
   456→        process.exit(1);
   457→      }
   458→    });
   459→
   460→  // meta-get-cmd: kspec meta get <ref>
   461→  meta
   462→    .command('get <ref>')
   463→    .description('Get a meta item by reference (agent, workflow, convention, or observation)')
   464→    .action(async (ref: string) => {
   465→      try {
   466→        const ctx = await initContext();
   467→
   468→        if (!ctx.manifestPath) {
   469→          error(errors.project.noKspecProject);
   470→          process.exit(1);
   471→        }
   472→
   473→        const metaCtx = await loadMetaContext(ctx);
   474→
   475→        // Normalize reference
   476→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   477→
   478→        // Search in all meta item types
   479→        const agents = metaCtx.agents || [];
   480→        const workflows = metaCtx.workflows || [];
   481→        const conventions = metaCtx.conventions || [];
   482→        const observations = metaCtx.observations || [];
   483→
   484→        // Try to find by ID or ULID prefix
   485→        let found: any = null;
   486→        let itemType: string = '';
   487→
   488→        // Check agents (by id or ULID)
   489→        const agent = agents.find((a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef));
   490→        if (agent) {
   491→          found = agent;
   492→          itemType = 'agent';
   493→        }
   494→
   495→        // Check workflows (by id or ULID)
   496→        if (!found) {
   497→          const workflow = workflows.find((w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef));
   498→          if (workflow) {
   499→            found = workflow;
   500→            itemType = 'workflow';
   501→          }
   502→        }
   503→
   504→        // Check conventions (by domain or ULID)
   505→        if (!found) {
   506→          const convention = conventions.find((c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef));
   507→          if (convention) {
   508→            found = convention;
   509→            itemType = 'convention';
   510→          }
   511→        }
   512→
   513→        // Check observations (by ULID)
   514→        if (!found) {
   515→          const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
   516→          if (observation) {
   517→            found = observation;
   518→            itemType = 'observation';
   519→          }
   520→        }
   521→
   522→        if (!found) {
   523→          error(errors.reference.metaNotFound(ref));
   524→          process.exit(1);
   525→        }
   526→
   527→        // Output the item
   528→        output(found, () => {
   529→          console.log(chalk.bold(`${itemType.charAt(0).toUpperCase() + itemType.slice(1)}: ${ref}`));
   530→          console.log(chalk.gray('─'.repeat(60)));
   531→          console.log(JSON.stringify(found, null, 2));
   532→        });
   533→      } catch (err) {
   534→        error(errors.failures.getMetaItem, err);
   535→        process.exit(1);
   536→      }
   537→    });
   538→
   539→  // meta-list-cmd: kspec meta list
   540→  meta
   541→    .command('list')
   542→    .description('List all meta items')
   543→    .option('--type <type>', 'Filter by type (agent, workflow, convention, observation)')
   544→    .action(async (options) => {
   545→      try {
   546→        const ctx = await initContext();
   547→
   548→        if (!ctx.manifestPath) {
   549→          error(errors.project.noKspecProject);
   550→          process.exit(1);
   551→        }
   552→
   553→        const metaCtx = await loadMetaContext(ctx);
   554→
   555→        // Collect all meta items with type information
   556→        interface MetaListItem {
   557→          id: string;
   558→          type: string;
   559→          context: string;
   560→          ulid: string;
   561→        }
   562→
   563→        const items: MetaListItem[] = [];
   564→
   565→        // Add agents
   566→        if (!options.type || options.type === 'agent') {
   567→          for (const agent of metaCtx.agents || []) {
   568→            items.push({
   569→              id: agent.id,
   570→              type: 'agent',
   571→              context: agent.name,
   572→              ulid: agent._ulid,
   573→            });
   574→          }
   575→        }
   576→
   577→        // Add workflows
   578→        if (!options.type || options.type === 'workflow') {
   579→          for (const workflow of metaCtx.workflows || []) {
   580→            items.push({
   581→              id: workflow.id,
   582→              type: 'workflow',
   583→              context: workflow.trigger,
   584→              ulid: workflow._ulid,
   585→            });
   586→          }
   587→        }
   588→
   589→        // Add conventions
   590→        if (!options.type || options.type === 'convention') {
   591→          for (const convention of metaCtx.conventions || []) {
   592→            items.push({
   593→              id: convention.domain,
   594→              type: 'convention',
   595→              context: `${convention.rules.length} rules`,
   596→              ulid: convention._ulid,
   597→            });
   598→          }
   599→        }
   600→
   601→        // Add observations
   602→        if (!options.type || options.type === 'observation') {
   603→          for (const observation of metaCtx.observations || []) {
   604→            const ulidPrefix = observation._ulid.substring(0, 8);
   605→            items.push({
   606→              id: ulidPrefix,
   607→              type: 'observation',
   608→              context: `${observation.type} ${observation.resolved ? '(resolved)' : ''}`,
   609→              ulid: observation._ulid,
   610→            });
   611→          }
   612→        }
   613→
   614→        // Output
   615→        output(items, () => {
   616→          if (items.length === 0) {
   617→            console.log(chalk.yellow('No meta items found'));
   618→            return;
   619→          }
   620→
   621→          const table = new Table({
   622→            head: [chalk.bold('ID'), chalk.bold('Type'), chalk.bold('Context')],
   623→            style: {
   624→              head: [],
   625→              border: [],
   626→            },
   627→          });
   628→
   629→          for (const item of items) {
   630→            table.push([item.id, item.type, item.context]);
   631→          }
   632→
   633→          console.log(table.toString());
   634→        });
   635→      } catch (err) {
   636→        error(errors.failures.listMetaItems, err);
   637→        process.exit(1);
   638→      }
   639→    });
   640→
   641→  // AC-obs-1: kspec meta observe <type> <content>
   642→  meta
   643→    .command('observe <type> <content>')
   644→    .description('Create an observation (friction, success, question, idea)')
   645→    .option('--workflow <ref>', 'Reference to workflow this observation relates to')
   646→    .option('--author <author>', 'Author of the observation')
   647→    .action(async (type: string, content: string, options) => {
   648→      try {
   649→        const ctx = await initContext();
   650→
   651→        if (!ctx.manifestPath) {
   652→          error(errors.project.noKspecProject);
   653→          process.exit(1);
   654→        }
   655→
   656→        // Validate observation type
   657→        const validTypes: ObservationType[] = ['friction', 'success', 'question', 'idea'];
   658→        if (!validTypes.includes(type as ObservationType)) {
   659→          error(errors.validation.invalidObservationType(type));
   660→          console.log(`Valid types: ${validTypes.join(', ')}`);
   661→          process.exit(1);
   662→        }
   663→
   664→        // Create observation
   665→        const observation = createObservation(type as ObservationType, content, {
   666→          workflow_ref: options.workflow,
   667→          author: options.author,
   668→        });
   669→
   670→        // Save to manifest
   671→        await saveObservation(ctx, observation);
   672→
   673→        // AC-obs-1: outputs "OK Created observation: <ULID-prefix>"
   674→        // In JSON mode, return the created observation object
   675→        output(
   676→          observation,
   677→          () => success(`Created observation: ${observation._ulid.substring(0, 8)}`)
   678→        );
   679→      } catch (err) {
   680→        error(errors.failures.createObservation, err);
   681→        process.exit(1);
   682→      }
   683→    });
   684→
   685→  // AC-obs-2, AC-obs-5: kspec meta observations
   686→  meta
   687→    .command('observations')
   688→    .description('List observations (shows unresolved by default)')
   689→    .option('--type <type>', 'Filter by observation type (friction/success/question/idea)')
   690→    .option('--workflow <ref>', 'Filter by workflow reference')
   691→    .option('--all', 'Include resolved observations')
   692→    .option('--promoted', 'Show only observations promoted to tasks')
   693→    .option('--pending-resolution', 'Show observations with completed tasks awaiting resolution')
   694→    .action(async (options) => {
   695→      try {
   696→        const ctx = await initContext();
   697→
   698→        if (!ctx.manifestPath) {
   699→          error(errors.project.noKspecProject);
   700→          process.exit(1);
   701→        }
   702→
   703→        const metaCtx = await loadMetaContext(ctx);
   704→        let observations = metaCtx.observations || [];
   705→
   706→        // Apply filters
   707→        if (options.type) {
   708→          observations = observations.filter((obs) => obs.type === options.type);
   709→        }
   710→
   711→        if (options.workflow) {
   712→          observations = observations.filter((obs) => obs.workflow_ref === options.workflow);
   713→        }
   714→
   715→        if (options.promoted) {
   716→          observations = observations.filter((obs) => obs.promoted_to !== undefined);
   717→        }
   718→
   719→        if (options.pendingResolution) {
   720→          // Load tasks to check if promoted tasks are completed
   721→          const tasks = await loadAllTasks(ctx);
   722→          const items = await loadAllItems(ctx);
   723→          const index = new ReferenceIndex(tasks, items);
   724→
   725→          observations = observations.filter((obs) => {
   726→            if (!obs.promoted_to || obs.resolved) return false;
   727→            const taskResult = index.resolve(obs.promoted_to);
   728→            if (!taskResult.ok) return false;
   729→            const item = taskResult.item;
   730→            // Type guard: check if item is a task (has status and depends_on properties)
   731→            return 'status' in item && 'depends_on' in item && item.status === 'completed';
   732→          });
   733→        }
   734→
   735→        // AC-obs-5: JSON output includes full observation objects
   736→        output(
   737→          observations.map((obs) => ({
   738→            _ulid: obs._ulid,
   739→            type: obs.type,
   740→            content: obs.content,
   741→            workflow_ref: obs.workflow_ref ?? null,
   742→            created_at: obs.created_at,
   743→            author: obs.author ?? null,
   744→            resolved: obs.resolved,
   745→            resolution: obs.resolution ?? null,
   746→            resolved_at: obs.resolved_at ?? null,
   747→            resolved_by: obs.resolved_by ?? null,
   748→            promoted_to: obs.promoted_to ?? null,
   749→          })),
   750→          // AC-obs-2: Table output with ID, Type, Workflow, Created, Content
   751→          () => formatObservations(observations, options.all)
   752→        );
   753→      } catch (err) {
   754→        error(errors.failures.listObservations, err);
   755→        process.exit(1);
   756→      }
   757→    });
   758→
   759→  // AC-obs-3, AC-obs-6, AC-obs-8: kspec meta promote
   760→  meta
   761→    .command('promote <ref>')
   762→    .description('Promote observation to a task')
   763→    .requiredOption('--title <title>', 'Task title')
   764→    .option('--priority <priority>', 'Task priority (1-5)', '2')
   765→    .option('--force', 'Force promotion even if observation is resolved')
   766→    .action(async (ref: string, options) => {
   767→      try {
   768→        const ctx = await initContext();
   769→
   770→        if (!ctx.manifestPath) {
   771→          error(errors.project.noKspecProject);
   772→          process.exit(1);
   773→        }
   774→
   775→        const metaCtx = await loadMetaContext(ctx);
   776→        const observations = metaCtx.observations || [];
   777→
   778→        // Find observation
   779→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   780→        const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
   781→
   782→        if (!observation) {
   783→          error(errors.reference.observationNotFound(ref));
   784→          process.exit(1);
   785→        }
   786→
   787→        // AC-obs-6: Check if already promoted
   788→        if (observation.promoted_to) {
   789→          error(errors.conflict.observationAlreadyPromoted(observation.promoted_to));
   790→          process.exit(1);
   791→        }
   792→
   793→        // AC-obs-8: Check if resolved
   794→        if (observation.resolved && !options.force) {
   795→          error(errors.operation.cannotPromoteResolved);
   796→          process.exit(1);
   797→        }
   798→
   799→        // AC-obs-3: Create task with title, description from observation, meta_ref, and origin
   800→        const task = createTask({
   801→          title: options.title,
   802→          description: observation.content,
   803→          priority: Number.parseInt(options.priority, 10),
   804→          meta_ref: observation.workflow_ref,
   805→          origin: 'observation_promotion',
   806→        });
   807→
   808→        // Save task
   809→        await saveTask(ctx, task);
   810→        await commitIfShadow(ctx.shadow, 'task-add', task.slugs[0] || task._ulid.slice(0, 8), task.title);
   811→        const taskRef = `@${task._ulid.substring(0, 8)}`;
   812→
   813→        // Update observation with promoted_to field
   814→        observation.promoted_to = taskRef;
   815→        await saveObservation(ctx, observation);
   816→
   817→        // AC-obs-3: outputs "OK Created task: <ULID-prefix>"
   818→        // In JSON mode, return the created task object
   819→        output(
   820→          task,
   821→          () => success(`Created task: ${taskRef.substring(0, 9)}`)
   822→        );
   823→      } catch (err) {
   824→        error(errors.failures.promoteObservation, err);
   825→        process.exit(1);
   826→      }
   827→    });
   828→
   829→  // AC-obs-4, AC-obs-7, AC-obs-9: kspec meta resolve
   830→  meta
   831→    .command('resolve <ref> [resolution]')
   832→    .description('Resolve an observation')
   833→    .action(async (ref: string, resolution: string | undefined) => {
   834→      try {
   835→        const ctx = await initContext();
   836→
   837→        if (!ctx.manifestPath) {
   838→          error(errors.project.noKspecProject);
   839→          process.exit(1);
   840→        }
   841→
   842→        const metaCtx = await loadMetaContext(ctx);
   843→        const observations = metaCtx.observations || [];
   844→
   845→        // Find observation
   846→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
   847→        const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
   848→
   849→        if (!observation) {
   850→          error(errors.reference.observationNotFound(ref));
   851→          process.exit(1);
   852→        }
   853→
   854→        // AC-obs-7: Check if already resolved
   855→        if (observation.resolved) {
   856→          const resolvedDate = new Date(observation.resolved_at!).toISOString().split('T')[0];
   857→          const resolutionText = observation.resolution || '';
   858→          const truncated = resolutionText.length > 50
   859→            ? resolutionText.substring(0, 50) + '...'
   860→            : resolutionText;
   861→          error(errors.conflict.observationAlreadyResolved(resolvedDate, truncated));
   862→          process.exit(1);
   863→        }
   864→
   865→        // AC-obs-9: Auto-populate resolution from task completion if promoted
   866→        let finalResolution = resolution;
   867→        if (!finalResolution && observation.promoted_to) {
   868→          // Fetch task to get completion reason
   869→          const tasks = await loadAllTasks(ctx);
   870→          const items = await loadAllItems(ctx);
   871→          const index = new ReferenceIndex(tasks, items);
   872→          const taskResult = index.resolve(observation.promoted_to);
   873→
   874→          if (taskResult.ok) {
   875→            const item = taskResult.item;
   876→            // Type guard: ensure this is a task (has status and depends_on properties)
   877→            if ('status' in item && 'depends_on' in item) {
   878→              const task = item as LoadedTask;
   879→              if (task.status === 'completed' && task.closed_reason) {
   880→                finalResolution = `Resolved via task ${observation.promoted_to}: ${task.closed_reason}`;
   881→              } else if (task.status === 'completed') {
   882→                finalResolution = `Resolved via task ${observation.promoted_to}`;
   883→              } else {
   884→                error(`Task ${observation.promoted_to} is not completed yet`);
   885→                process.exit(1);
   886→              }
   887→            } else {
   888→              error(`Reference ${observation.promoted_to} is not a task`);
   889→              process.exit(1);
   890→            }
   891→          } else {
   892→            error(`Task ${observation.promoted_to} not found`);
   893→            process.exit(1);
   894→          }
   895→        }
   896→
   897→        if (!finalResolution) {
   898→          error(errors.validation.resolutionRequired);
   899→          process.exit(1);
   900→        }
   901→
   902→        // AC-obs-4: Update observation
   903→        observation.resolved = true;
   904→        observation.resolution = finalResolution;
   905→        observation.resolved_at = new Date().toISOString();
   906→        observation.resolved_by = observation.author; // Use same author
   907→
   908→        await saveObservation(ctx, observation);
   909→
   910→        // AC-obs-4: outputs "OK Resolved: <ULID-prefix>"
   911→        success(`Resolved: ${observation._ulid.substring(0, 8)}`);
   912→      } catch (err) {
   913→        error(errors.failures.resolveObservation, err);
   914→        process.exit(1);
   915→      }
   916→    });
   917→
   918→  // Meta add command - create new meta items
   919→  meta
   920→    .command('add <type>')
   921→    .description('Create a new meta item (agent, workflow, or convention)')
   922→    .option('--id <id>', 'Semantic ID (required for agents and workflows)')
   923→    .option('--domain <domain>', 'Domain (required for conventions)')
   924→    .option('--name <name>', 'Name (for agents)')
   925→    .option('--trigger <trigger>', 'Trigger (for workflows)')
   926→    .option('--description <desc>', 'Description')
   927→    .option('--capability <cap...>', 'Capabilities (for agents)')
   928→    .option('--tool <tool...>', 'Tools (for agents)')
   929→    .option('--convention <conv...>', 'Convention references (for agents)')
   930→    .option('--rule <rule...>', 'Rules (for conventions)')
   931→    .action(async (type: string, options) => {
   932→      try {
   933→        const ctx = await initContext();
   934→
   935→        // Validate type
   936→        const validTypes = ['agent', 'workflow', 'convention'];
   937→        if (!validTypes.includes(type)) {
   938→          error(errors.validation.invalidType(type, validTypes));
   939→          process.exit(1);
   940→        }
   941→
   942→        // Generate ULID
   943→        const itemUlid = ulid();
   944→
   945→        // Create the item based on type
   946→        let item: Agent | Workflow | Convention;
   947→
   948→        if (type === 'agent') {
   949→          // Validate required fields
   950→          if (!options.id) {
   951→            error(errors.validation.agentRequiresId);
   952→            process.exit(1);
   953→          }
   954→          if (!options.name) {
   955→            error(errors.validation.agentRequiresName);
   956→            process.exit(1);
   957→          }
   958→
   959→          item = {
   960→            _ulid: itemUlid,
   961→            id: options.id,
   962→            name: options.name,
   963→            description: options.description || '',
   964→            capabilities: options.capability || [],
   965→            tools: options.tool || [],
   966→            conventions: options.convention || [],
   967→          };
   968→        } else if (type === 'workflow') {
   969→          // Validate required fields
   970→          if (!options.id) {
   971→            error(errors.validation.workflowRequiresId);
   972→            process.exit(1);
   973→          }
   974→          if (!options.trigger) {
   975→            error(errors.validation.workflowRequiresTrigger);
   976→            process.exit(1);
   977→          }
   978→
   979→          item = {
   980→            _ulid: itemUlid,
   981→            id: options.id,
   982→            trigger: options.trigger,
   983→            description: options.description || '',
   984→            steps: [],
   985→          };
   986→        } else {
   987→          // convention
   988→          if (!options.domain) {
   989→            error(errors.validation.conventionRequiresDomain);
   990→            process.exit(1);
   991→          }
   992→
   993→          item = {
   994→            _ulid: itemUlid,
   995→            domain: options.domain,
   996→            rules: options.rule || [],
   997→            examples: [],
   998→          };
   999→        }
  1000→
  1001→        // Save the item
  1002→        await saveMetaItem(ctx, item, type as 'agent' | 'workflow' | 'convention');
  1003→
  1004→        if (isJsonMode()) {
  1005→          // In JSON mode, output the item data directly
  1006→          console.log(JSON.stringify(item, null, 2));
  1007→        } else {
  1008→          const idOrDomain = 'id' in item ? item.id : 'domain' in item ? item.domain : itemUlid;
  1009→          success(`Created ${type}: ${idOrDomain} (@${itemUlid.substring(0, 8)})`);
  1010→        }
  1011→      } catch (err) {
  1012→        error(errors.failures.createMeta(type), err);
  1013→        process.exit(1);
  1014→      }
  1015→    });
  1016→
  1017→  // Meta set command - update existing meta items
  1018→  meta
  1019→    .command('set <ref>')
  1020→    .description('Update an existing meta item')
  1021→    .option('--name <name>', 'Update name (for agents)')
  1022→    .option('--description <desc>', 'Update description')
  1023→    .option('--trigger <trigger>', 'Update trigger (for workflows)')
  1024→    .option('--add-capability <cap>', 'Add capability (for agents)')
  1025→    .option('--add-tool <tool>', 'Add tool (for agents)')
  1026→    .option('--add-convention <conv>', 'Add convention reference (for agents)')
  1027→    .option('--add-rule <rule>', 'Add rule (for conventions)')
  1028→    .action(async (ref: string, options) => {
  1029→      try {
  1030→        const ctx = await initContext();
  1031→        const metaCtx = await loadMetaContext(ctx);
  1032→
  1033→        // Find the item using unified lookup
  1034→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
  1035→        let found: Agent | Workflow | Convention | null = null;
  1036→        let itemType: 'agent' | 'workflow' | 'convention' | null = null;
  1037→
  1038→        // Search in agents
  1039→        const agents = metaCtx.manifest?.agents || [];
  1040→        const agent = agents.find(
  1041→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef)
  1042→        );
  1043→        if (agent) {
  1044→          found = agent;
  1045→          itemType = 'agent';
  1046→        }
  1047→
  1048→        // Search in workflows
  1049→        if (!found) {
  1050→          const workflows = metaCtx.manifest?.workflows || [];
  1051→          const workflow = workflows.find(
  1052→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef)
  1053→          );
  1054→          if (workflow) {
  1055→            found = workflow;
  1056→            itemType = 'workflow';
  1057→          }
  1058→        }
  1059→
  1060→        // Search in conventions
  1061→        if (!found) {
  1062→          const conventions = metaCtx.manifest?.conventions || [];
  1063→          const convention = conventions.find(
  1064→            (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef)
  1065→          );
  1066→          if (convention) {
  1067→            found = convention;
  1068→            itemType = 'convention';
  1069→          }
  1070→        }
  1071→
  1072→        if (!found || !itemType) {
  1073→          error(errors.reference.metaNotFound(ref));
  1074→          process.exit(1);
  1075→        }
  1076→
  1077→        // Update fields based on type
  1078→        if (itemType === 'agent') {
  1079→          const item = found as Agent;
  1080→          if (options.name) item.name = options.name;
  1081→          if (options.description !== undefined) item.description = options.description;
  1082→          if (options.addCapability) {
  1083→            if (!item.capabilities.includes(options.addCapability)) {
  1084→              item.capabilities.push(options.addCapability);
  1085→            }
  1086→          }
  1087→          if (options.addTool) {
  1088→            if (!item.tools.includes(options.addTool)) {
  1089→              item.tools.push(options.addTool);
  1090→            }
  1091→          }
  1092→          if (options.addConvention) {
  1093→            if (!item.conventions.includes(options.addConvention)) {
  1094→              item.conventions.push(options.addConvention);
  1095→            }
  1096→          }
  1097→        } else if (itemType === 'workflow') {
  1098→          const item = found as Workflow;
  1099→          if (options.trigger) item.trigger = options.trigger;
  1100→          if (options.description !== undefined) item.description = options.description;
  1101→        } else {
  1102→          const item = found as Convention;
  1103→          // Convention doesn't have a description field
  1104→          if (options.addRule) {
  1105→            if (!item.rules.includes(options.addRule)) {
  1106→              item.rules.push(options.addRule);
  1107→            }
  1108→          }
  1109→        }
  1110→
  1111→        // Save the updated item
  1112→        await saveMetaItem(ctx, found, itemType);
  1113→
  1114→        if (isJsonMode()) {
  1115→          // In JSON mode, output the item data directly
  1116→          console.log(JSON.stringify(found, null, 2));
  1117→        } else {
  1118→          const idOrDomain =
  1119→            itemType === 'agent'
  1120→              ? (found as Agent).id
  1121→              : itemType === 'workflow'
  1122→                ? (found as Workflow).id
  1123→                : (found as Convention).domain;
  1124→          success(`Updated ${itemType}: ${idOrDomain}`);
  1125→        }
  1126→      } catch (err) {
  1127→        error(errors.failures.updateMetaItem, err);
  1128→        process.exit(1);
  1129→      }
  1130→    });
  1131→
  1132→  // Meta delete command - delete meta items
  1133→  meta
  1134→    .command('delete <ref>')
  1135→    .description('Delete a meta item')
  1136→    .option('--confirm', 'Skip confirmation prompt')
  1137→    .action(async (ref: string, options) => {
  1138→      try {
  1139→        const ctx = await initContext();
  1140→        const metaCtx = await loadMetaContext(ctx);
  1141→
  1142→        // Find the item to determine type
  1143→        const normalizedRef = ref.startsWith('@') ? ref.substring(1) : ref;
  1144→        let itemType: 'agent' | 'workflow' | 'convention' | 'observation' | null = null;
  1145→        let itemUlid: string | null = null;
  1146→        let itemLabel: string | null = null;
  1147→
  1148→        // Search in agents
  1149→        const agents = metaCtx.manifest?.agents || [];
  1150→        const agent = agents.find(
  1151→          (a) => a.id === normalizedRef || a._ulid.startsWith(normalizedRef)
  1152→        );
  1153→        if (agent) {
  1154→          itemType = 'agent';
  1155→          itemUlid = agent._ulid;
  1156→          itemLabel = `agent ${agent.id}`;
  1157→        }
  1158→
  1159→        // Search in workflows
  1160→        if (!itemType) {
  1161→          const workflows = metaCtx.manifest?.workflows || [];
  1162→          const workflow = workflows.find(
  1163→            (w) => w.id === normalizedRef || w._ulid.startsWith(normalizedRef)
  1164→          );
  1165→          if (workflow) {
  1166→            itemType = 'workflow';
  1167→            itemUlid = workflow._ulid;
  1168→            itemLabel = `workflow ${workflow.id}`;
  1169→          }
  1170→        }
  1171→
  1172→        // Search in conventions
  1173→        if (!itemType) {
  1174→          const conventions = metaCtx.manifest?.conventions || [];
  1175→          const convention = conventions.find(
  1176→            (c) => c.domain === normalizedRef || c._ulid.startsWith(normalizedRef)
  1177→          );
  1178→          if (convention) {
  1179→            itemType = 'convention';
  1180→            itemUlid = convention._ulid;
  1181→            itemLabel = `convention ${convention.domain}`;
  1182→          }
  1183→        }
  1184→
  1185→        // Search in observations
  1186→        if (!itemType) {
  1187→          const observations = metaCtx.observations || [];
  1188→          const observation = observations.find((o) => o._ulid.startsWith(normalizedRef));
  1189→          if (observation) {
  1190→            itemType = 'observation';
  1191→            itemUlid = observation._ulid;
  1192→            itemLabel = `observation ${observation._ulid.substring(0, 8)}`;
  1193→          }
  1194→        }
  1195→
  1196→        if (!itemType || !itemUlid || !itemLabel) {
  1197→          error(errors.reference.metaNotFound(ref));
  1198→          process.exit(1);
  1199→        }
  1200→
  1201→        // Check for dangling references (unless --confirm is used to override)
  1202→        if (!options.confirm) {
  1203→          // Check tasks with meta_ref
  1204→          const tasks = await loadAllTasks(ctx);
  1205→          const referencingTasks = tasks.filter((t) => {
  1206→            if (!t.meta_ref) return false;
  1207→            // Resolve the task's meta_ref to a ULID
  1208→            const taskMetaRef = resolveMetaRefToUlid(t.meta_ref, metaCtx);
  1209→            // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1210→            return taskMetaRef && taskMetaRef.ulid === itemUlid;
  1211→          });
  1212→
  1213→          if (referencingTasks.length > 0) {
  1214→            const taskRefs = referencingTasks
  1215→              .map((t) => `@${t.slugs?.[0] || t._ulid.substring(0, 8)}`)
  1216→              .join(', ');
  1217→            error(errors.operation.cannotDeleteReferencedByTasks(itemLabel, referencingTasks.length, taskRefs));
  1218→            process.exit(1);
  1219→          }
  1220→
  1221→          // Check observations with workflow_ref (only for workflows)
  1222→          if (itemType === 'workflow') {
  1223→            const observations = metaCtx.observations || [];
  1224→            const referencingObservations = observations.filter((o) => {
  1225→              if (!o.workflow_ref) return false;
  1226→              // Resolve the observation's workflow_ref to a ULID
  1227→              const obsWorkflowRef = resolveMetaRefToUlid(o.workflow_ref, metaCtx);
  1228→              // Compare ULIDs to handle both semantic IDs and ULID prefixes
  1229→              return obsWorkflowRef && obsWorkflowRef.ulid === itemUlid;
  1230→            });
  1231→
  1232→            if (referencingObservations.length > 0) {
  1233→              const obsRefs = referencingObservations
  1234→                .map((o) => `@${o._ulid.substring(0, 8)}`)
  1235→                .join(', ');
  1236→              error(errors.operation.cannotDeleteReferencedByObservations(itemLabel, referencingObservations.length, obsRefs));
  1237→              process.exit(1);
  1238→            }
  1239→          }
  1240→
  1241→          // Show confirmation prompt even if no references found
  1242→          error(errors.operation.confirmRequired(itemLabel));
  1243→          process.exit(1);
  1244→        }
  1245→
  1246→        // Delete the item
  1247→        const deleted = await deleteMetaItem(ctx, itemUlid, itemType);
  1248→
  1249→        if (!deleted) {
  1250→          error(errors.operation.deleteItemFailed(itemLabel));
  1251→          process.exit(1);
  1252→        }
  1253→
  1254→        success(`Deleted ${itemLabel}`);
  1255→      } catch (err) {
  1256→        error(errors.failures.deleteMetaItem, err);
  1257→        process.exit(1);
  1258→      }
  1259→    });
  1260→
  1261→  // meta-focus-cmd: kspec meta focus [ref]
  1262→  meta
  1263→    .command('focus [ref]')
  1264→    .description('Get or set session focus')
  1265→    .option('--clear', 'Clear current focus')
  1266→    .action(async (ref: string | undefined, options) => {
  1267→      try {
  1268→        const ctx = await initContext();
  1269→
  1270→        if (!ctx.manifestPath) {
  1271→          error(errors.project.noKspecProject);
  1272→          process.exit(1);
  1273→        }
  1274→
  1275→        const sessionCtx = await loadSessionContext(ctx);
  1276→
  1277→        // Clear focus
  1278→        if (options.clear) {
  1279→          sessionCtx.focus = null;
  1280→          await saveSessionContext(ctx, sessionCtx);
  1281→
  1282→          output(
  1283→            { focus: null },
  1284→            () => success('Cleared session focus')
  1285→          );
  1286→          return;
  1287→        }
  1288→
  1289→        // Show current focus
  1290→        if (!ref) {
  1291→          output(
  1292→            { focus: sessionCtx.focus },
  1293→            () => {
  1294→              if (sessionCtx.focus) {
  1295→                console.log(`Current focus: ${sessionCtx.focus}`);
  1296→              } else {
  1297→                console.log(chalk.yellow('No focus set'));
  1298→              }
  1299→            }
  1300→          );
  1301→          return;
  1302→        }
  1303→
  1304→        // Set focus to ref
  1305→        sessionCtx.focus = ref.startsWith('@') ? ref : `@${ref}`;
  1306→        await saveSessionContext(ctx, sessionCtx);
  1307→
  1308→        output(
  1309→          { focus: sessionCtx.focus },
  1310→          () => success(`Set focus to: ${sessionCtx.focus}`)
  1311→        );
  1312→      } catch (err) {
  1313→        error(errors.failures.updateSessionContext, err);
  1314→        process.exit(1);
  1315→      }
  1316→    });
  1317→
  1318→  // meta-thread-cmd: kspec meta thread <action> [text]
  1319→  meta
  1320→    .command('thread <action> [text]')
  1321→    .description('Manage active threads')
  1322→    .action(async (action: string, text: string | undefined) => {
  1323→      try {
  1324→        const ctx = await initContext();
  1325→
  1326→        if (!ctx.manifestPath) {
  1327→          error(errors.project.noKspecProject);
  1328→          process.exit(1);
  1329→        }
  1330→
  1331→        const sessionCtx = await loadSessionContext(ctx);
  1332→
  1333→        // List threads
  1334→        if (action === 'list') {
  1335→          output(
  1336→            { threads: sessionCtx.threads },
  1337→            () => {
  1338→              if (sessionCtx.threads.length === 0) {
  1339→                console.log(chalk.yellow('No active threads'));
  1340→              } else {
  1341→                console.log('Active threads:');
  1342→                sessionCtx.threads.forEach((thread, idx) => {
  1343→                  console.log(`  ${idx + 1}. ${thread}`);
  1344→                });
  1345→              }
  1346→            }
  1347→          );
  1348→          return;
  1349→        }
  1350→
  1351→        // Clear all threads
  1352→        if (action === 'clear') {
  1353→          sessionCtx.threads = [];
  1354→          await saveSessionContext(ctx, sessionCtx);
  1355→
  1356→          output(
  1357→            { threads: [] },
  1358→            () => success('Cleared all threads')
  1359→          );
  1360→          return;
  1361→        }
  1362→
  1363→        // Add thread
  1364→        if (action === 'add') {
  1365→          if (!text) {
  1366→            error('Thread text is required for add action');
  1367→            process.exit(1);
  1368→          }
  1369→
  1370→          sessionCtx.threads.push(text);
  1371→          await saveSessionContext(ctx, sessionCtx);
  1372→
  1373→          output(
  1374→            { threads: sessionCtx.threads, added: text },
  1375→            () => success(`Added thread: ${text}`)
  1376→          );
  1377→          return;
  1378→        }
  1379→
  1380→        // Remove thread by index (1-based)
  1381→        if (action === 'remove') {
  1382→          if (!text) {
  1383→            error('Index is required for remove action');
  1384→            process.exit(1);
  1385→          }
  1386→
  1387→          const index = parseInt(text, 10);
  1388→          if (isNaN(index) || index < 1 || index > sessionCtx.threads.length) {
  1389→            error(`Invalid index: ${text}. Must be between 1 and ${sessionCtx.threads.length}`);
  1390→            process.exit(1);
  1391→          }
  1392→
  1393→          const removed = sessionCtx.threads.splice(index - 1, 1)[0];
  1394→          await saveSessionContext(ctx, sessionCtx);
  1395→
  1396→          output(
  1397→            { threads: sessionCtx.threads, removed },
  1398→            () => success(`Removed thread: ${removed}`)
  1399→          );
  1400→          return;
  1401→        }
  1402→
  1403→        // Unknown action
  1404→        error(`Unknown action: ${action}. Use add, remove, list, or clear`);
  1405→        process.exit(1);
  1406→      } catch (err) {
  1407→        error(errors.failures.updateSessionContext, err);
  1408→        process.exit(1);
  1409→      }
  1410→    });
  1411→}
  1412→

