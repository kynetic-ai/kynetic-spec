     1→import { Command } from 'commander';
     2→import * as fs from 'node:fs/promises';
     3→import * as path from 'node:path';
     4→import * as os from 'node:os';
     5→import { success, error, warn } from '../output.js';
     6→import { errors } from '../../strings/index.js';
     7→
     8→/**
     9→ * Supported agent types for auto-configuration
    10→ */
    11→export type AgentType =
    12→  | 'claude-code'
    13→  | 'cline'
    14→  | 'roo-code'
    15→  | 'copilot-cli'
    16→  | 'gemini-cli'
    17→  | 'codex-cli'
    18→  | 'aider'
    19→  | 'opencode'
    20→  | 'amp'
    21→  | 'unknown';
    22→
    23→/**
    24→ * Result of agent detection
    25→ */
    26→export interface DetectedAgent {
    27→  type: AgentType;
    28→  confidence: 'high' | 'medium' | 'low';
    29→  configPath?: string;
    30→  envVars?: Record<string, string>;
    31→}
    32→
    33→/**
    34→ * Detect which agent environment we're running in.
    35→ * Returns the detected agent type and confidence level.
    36→ *
    37→ * Detection priority matters - more specific markers checked first.
    38→ */
    39→export function detectAgent(): DetectedAgent {
    40→  // Claude Code: Multiple possible markers
    41→  // CLAUDECODE=1 is set in CLI sessions
    42→  // CLAUDE_CODE_ENTRYPOINT indicates entry point (cli, etc.)
    43→  // CLAUDE_PROJECT_DIR is set in some contexts
    44→  if (process.env.CLAUDECODE === '1' || process.env.CLAUDE_CODE_ENTRYPOINT || process.env.CLAUDE_PROJECT_DIR) {
    45→    return {
    46→      type: 'claude-code',
    47→      confidence: 'high',
    48→      configPath: path.join(os.homedir(), '.claude', 'settings.json'),
    49→      envVars: {
    50→        ...(process.env.CLAUDECODE && { CLAUDECODE: process.env.CLAUDECODE }),
    51→        ...(process.env.CLAUDE_CODE_ENTRYPOINT && { CLAUDE_CODE_ENTRYPOINT: process.env.CLAUDE_CODE_ENTRYPOINT }),
    52→        ...(process.env.CLAUDE_PROJECT_DIR && { CLAUDE_PROJECT_DIR: process.env.CLAUDE_PROJECT_DIR }),
    53→      },
    54→    };
    55→  }
    56→
    57→  // Cline: CLINE_ACTIVE is set when running in Cline terminal
    58→  if (process.env.CLINE_ACTIVE) {
    59→    return {
    60→      type: 'cline',
    61→      confidence: 'high',
    62→      // Cline uses VS Code settings, but env vars should be in shell profile
    63→      configPath: undefined,
    64→      envVars: { CLINE_ACTIVE: process.env.CLINE_ACTIVE },
    65→    };
    66→  }
    67→
    68→  // GitHub Copilot CLI: Check for copilot-specific markers
    69→  if (process.env.COPILOT_MODEL || process.env.GH_TOKEN) {
    70→    return {
    71→      type: 'copilot-cli',
    72→      confidence: 'medium',
    73→      configPath: path.join(os.homedir(), '.copilot', 'config.json'),
    74→    };
    75→  }
    76→
    77→  // Aider: Check for AIDER_* env vars
    78→  if (process.env.AIDER_MODEL || process.env.AIDER_DARK_MODE !== undefined) {
    79→    return {
    80→      type: 'aider',
    81→      confidence: 'high',
    82→      configPath: path.join(os.homedir(), '.aider.conf.yml'),
    83→    };
    84→  }
    85→
    86→  // OpenCode: Check for OPENCODE_* env vars
    87→  if (process.env.OPENCODE_CONFIG_DIR || process.env.OPENCODE_CONFIG) {
    88→    return {
    89→      type: 'opencode',
    90→      confidence: 'high',
    91→      configPath: process.env.OPENCODE_CONFIG || path.join(os.homedir(), '.config', 'opencode', 'opencode.json'),
    92→    };
    93→  }
    94→
    95→  // Gemini CLI: GEMINI_CLI=1 is set when running in Gemini CLI
    96→  if (process.env.GEMINI_CLI === '1') {
    97→    return {
    98→      type: 'gemini-cli',
    99→      confidence: 'high',
   100→      configPath: path.join(os.homedir(), '.gemini', 'settings.json'),
   101→      envVars: { GEMINI_CLI: '1' },
   102→    };
   103→  }
   104→
   105→  // Codex CLI: CODEX_SANDBOX is set when running in sandbox
   106→  if (process.env.CODEX_SANDBOX) {
   107→    return {
   108→      type: 'codex-cli',
   109→      confidence: 'high',
   110→      configPath: path.join(os.homedir(), '.codex', 'config.toml'),
   111→      envVars: { CODEX_SANDBOX: process.env.CODEX_SANDBOX },
   112→    };
   113→  }
   114→
   115→  // Amp (Sourcegraph): Check for AMP_API_KEY or AMP_TOOLBOX
   116→  if (process.env.AMP_API_KEY || process.env.AMP_TOOLBOX) {
   117→    return {
   118→      type: 'amp',
   119→      confidence: 'medium',
   120→      configPath: path.join(os.homedir(), '.config', 'amp', 'settings.json'),
   121→    };
   122→  }
   123→
   124→  return {
   125→    type: 'unknown',
   126→    confidence: 'low',
   127→  };
   128→}
   129→
   130→/**
   131→ * Install KSPEC_AUTHOR config for Claude Code (global settings)
   132→ */
   133→async function installClaudeCodeConfig(author: string): Promise<boolean> {
   134→  const configPath = path.join(os.homedir(), '.claude', 'settings.json');
   135→  const configDir = path.dirname(configPath);
   136→
   137→  try {
   138→    // Ensure directory exists
   139→    await fs.mkdir(configDir, { recursive: true });
   140→
   141→    // Read existing config or start fresh
   142→    let config: Record<string, unknown> = {};
   143→    try {
   144→      const existing = await fs.readFile(configPath, 'utf-8');
   145→      config = JSON.parse(existing);
   146→    } catch {
   147→      // File doesn't exist or invalid JSON, start fresh
   148→    }
   149→
   150→    // Merge env settings
   151→    const env = (config.env as Record<string, string>) || {};
   152→    env.KSPEC_AUTHOR = author;
   153→    config.env = env;
   154→
   155→    // Write back
   156→    await fs.writeFile(configPath, JSON.stringify(config, null, 2) + '\n', 'utf-8');
   157→    return true;
   158→  } catch (err) {
   159→    return false;
   160→  }
   161→}
   162→
   163→/**
   164→ * Install hooks to project-level Claude Code settings (.claude/settings.json)
   165→ */
   166→async function installClaudeCodeHooks(projectDir: string): Promise<{ stop: boolean; promptCheck: boolean }> {
   167→  const configPath = path.join(projectDir, '.claude', 'settings.json');
   168→  const configDir = path.dirname(configPath);
   169→
   170→  const result = { stop: false, promptCheck: false };
   171→
   172→  try {
   173→    // Ensure directory exists
   174→    await fs.mkdir(configDir, { recursive: true });
   175→
   176→    // Read existing config or start fresh
   177→    let config: Record<string, unknown> = {};
   178→    try {
   179→      const existing = await fs.readFile(configPath, 'utf-8');
   180→      config = JSON.parse(existing);
   181→    } catch {
   182→      // File doesn't exist or invalid JSON, start fresh
   183→    }
   184→
   185→    // Get or create hooks object
   186→    const hooks = (config.hooks as Record<string, unknown[]>) || {};
   187→
   188→    // Install UserPromptSubmit hook (spec-first reminder)
   189→    const promptCheckCommand = 'npx kspec session prompt-check';
   190→    const existingPromptHooks = hooks.UserPromptSubmit as Array<{ hooks?: Array<{ command?: string }> }> | undefined;
   191→    const promptAlreadyInstalled = existingPromptHooks?.some(
   192→      (entry) => entry.hooks?.some((hook) => hook.command?.includes('session prompt-check'))
   193→    );
   194→
   195→    if (!promptAlreadyInstalled) {
   196→      hooks.UserPromptSubmit = [
   197→        ...(existingPromptHooks || []),
   198→        {
   199→          hooks: [
   200→            {
   201→              type: 'command',
   202→              command: promptCheckCommand,
   203→            },
   204→          ],
   205→        },
   206→      ];
   207→      result.promptCheck = true;
   208→    } else {
   209→      result.promptCheck = true; // Already configured
   210→    }
   211→
   212→    // Install Stop hook (checkpoint)
   213→    const stopHookCommand = 'npx kspec session checkpoint --json';
   214→    const existingStopHooks = hooks.Stop as Array<{ matcher?: string; hooks?: Array<{ command?: string }> }> | undefined;
   215→    const stopAlreadyInstalled = existingStopHooks?.some(
   216→      (entry) => entry.hooks?.some((hook) => hook.command?.includes('session checkpoint'))
   217→    );
   218→
   219→    if (!stopAlreadyInstalled) {
   220→      hooks.Stop = [
   221→        ...(existingStopHooks || []),
   222→        {
   223→          matcher: '',
   224→          hooks: [
   225→            {
   226→              type: 'command',
   227→              command: stopHookCommand,
   228→            },
   229→          ],
   230→        },
   231→      ];
   232→      result.stop = true;
   233→    } else {
   234→      result.stop = true; // Already configured
   235→    }
   236→
   237→    config.hooks = hooks;
   238→
   239→    // Write back
   240→    await fs.writeFile(configPath, JSON.stringify(config, null, 2) + '\n', 'utf-8');
   241→    return result;
   242→  } catch {
   243→    return result;
   244→  }
   245→}
   246→
   247→/**
   248→ * Install stop hook to project-level Claude Code settings (.claude/settings.json)
   249→ * @deprecated Use installClaudeCodeHooks instead
   250→ */
   251→async function installClaudeCodeStopHook(projectDir: string): Promise<boolean> {
   252→  const configPath = path.join(projectDir, '.claude', 'settings.json');
   253→  const configDir = path.dirname(configPath);
   254→
   255→  try {
   256→    // Ensure directory exists
   257→    await fs.mkdir(configDir, { recursive: true });
   258→
   259→    // Read existing config or start fresh
   260→    let config: Record<string, unknown> = {};
   261→    try {
   262→      const existing = await fs.readFile(configPath, 'utf-8');
   263→      config = JSON.parse(existing);
   264→    } catch {
   265→      // File doesn't exist or invalid JSON, start fresh
   266→    }
   267→
   268→    // Build the stop hook command
   269→    const stopHookCommand = 'npx kspec session checkpoint --json';
   270→
   271→    // Get or create hooks object
   272→    const hooks = (config.hooks as Record<string, unknown[]>) || {};
   273→
   274→    // Check if Stop hook already exists with our command
   275→    const existingStopHooks = hooks.Stop as Array<{ matcher?: object; hooks?: Array<{ command?: string }> }> | undefined;
   276→    const alreadyInstalled = existingStopHooks?.some(
   277→      (entry) => entry.hooks?.some((hook) => hook.command?.includes('session checkpoint'))
   278→    );
   279→
   280→    if (alreadyInstalled) {
   281→      return true; // Already configured
   282→    }
   283→
   284→    // Add our stop hook using Claude Code hooks format
   285→    // Note: matcher field is required even if empty string
   286→    hooks.Stop = [
   287→      ...(existingStopHooks || []),
   288→      {
   289→        matcher: '',
   290→        hooks: [
   291→          {
   292→            type: 'command',
   293→            command: stopHookCommand,
   294→          },
   295→        ],
   296→      },
   297→    ];
   298→    config.hooks = hooks;
   299→
   300→    // Write back
   301→    await fs.writeFile(configPath, JSON.stringify(config, null, 2) + '\n', 'utf-8');
   302→    return true;
   303→  } catch {
   304→    return false;
   305→  }
   306→}
