   471→/**
   472→ * Register the 'setup' command
   473→ */
   474→export function registerSetupCommand(program: Command): void {
   475→  program
   476→    .command('setup')
   477→    .description('Configure agent environment for kspec')
   478→    .option('--dry-run', 'Show what would be done without making changes')
   479→    .option('--author <author>', 'Custom author string (default: auto-detected based on agent)')
   480→    .option('--no-hooks', 'Skip installing Claude Code stop hook')
   481→    .option('--force', 'Overwrite existing configuration')
   482→    .action(async (options) => {
   483→      try {
   484→        const detected = detectAgent();
   485→        const projectDir = process.cwd();
   486→
   487→        console.log(`Detected agent: ${detected.type} (confidence: ${detected.confidence})`);
   488→
   489→        if (detected.type === 'unknown') {
   490→          warn('Could not auto-detect agent environment');
   491→          printManualInstructions('unknown');
   492→          return;
   493→        }
   494→
   495→        const author = options.author || getDefaultAuthor(detected.type);
   496→        const installHooks = options.hooks !== false && detected.type === 'claude-code';
   497→
   498→        if (options.dryRun) {
   499→          console.log(`\nWould configure:`);
   500→          console.log(`  Agent: ${detected.type}`);
   501→          console.log(`  Author: ${author}`);
   502→          if (detected.configPath) {
   503→            console.log(`  Global config: ${detected.configPath}`);
   504→          }
   505→          if (installHooks) {
   506→            console.log(`  Project config: ${path.join(projectDir, '.claude', 'settings.json')}`);
   507→            console.log(`  Hooks: UserPromptSubmit (prompt-check), Stop (checkpoint)`);
   508→          }
   509→          return;
   510→        }
   511→
   512→        // Check if already configured
   513→        if (!options.force && process.env.KSPEC_AUTHOR) {
   514→          warn(`KSPEC_AUTHOR is already set to "${process.env.KSPEC_AUTHOR}"`);
   515→          console.log('Use --force to overwrite');
   516→          return;
   517→        }
   518→
   519→        // Install config based on agent type
   520→        let installed = false;
   521→        let hooksInstalled = false;
   522→
   523→        let hooksResult: { stop: boolean; promptCheck: boolean } | null = null;
   524→
   525→        switch (detected.type) {
   526→          case 'claude-code':
   527→            installed = await installClaudeCodeConfig(author);
   528→            if (installHooks) {
   529→              hooksResult = await installClaudeCodeHooks(projectDir);
   530→              hooksInstalled = hooksResult.stop || hooksResult.promptCheck;
   531→            }
   532→            break;
   533→
   534→          case 'aider':
   535→            installed = await installAiderConfig(author);
   536→            break;
   537→
   538→          case 'cline':
   539→          case 'roo-code':
   540→            // These VS Code extensions use shell env vars, not config files
   541→            // Can't auto-install, must print instructions
   542→            printManualInstructions(detected.type);
   543→            return;
   544→
   545→          case 'copilot-cli':
   546→          case 'gemini-cli':
   547→          case 'opencode':
   548→          case 'amp':
   549→            if (detected.configPath) {
   550→              installed = await installGenericJsonConfig(detected.configPath, author);
   551→            }
   552→            break;
   553→
   554→          case 'codex-cli':
   555→            // Codex uses TOML config, would need special handling
   556→            // For now, print manual instructions
   557→            printManualInstructions(detected.type);
   558→            return;
   559→        }
   560→
   561→        if (installed) {
   562→          success(`Configured ${detected.type} with KSPEC_AUTHOR="${author}"`, {
   563→            agent: detected.type,
   564→            author,
   565→            configPath: detected.configPath,
   566→          });
   567→
   568→          if (hooksInstalled && hooksResult) {
   569→            const installedHooks: string[] = [];
   570→            if (hooksResult.promptCheck) installedHooks.push('UserPromptSubmit (prompt-check)');
   571→            if (hooksResult.stop) installedHooks.push('Stop (checkpoint)');
   572→            success(`Installed hooks to .claude/settings.json`, {
   573→              hooks: installedHooks,
   574→            });
   575→          }
   576→
   577→          console.log('\nRestart your agent session for changes to take effect.');
   578→        } else {
   579→          error(errors.failures.installConfig(detected.type));
   580→          printManualInstructions(detected.type);
   581→        }
   582→      } catch (err) {
   583→        error(errors.failures.setupFailed, err);
   584→        process.exit(1);
   585→      }
   586→    });
   587→}
