   372→/**
   373→ * Get default author value for an agent type
   374→ */
   375→function getDefaultAuthor(agentType: AgentType): string {
   376→  switch (agentType) {
   377→    case 'claude-code':
   378→      return '@claude';
   379→    case 'cline':
   380→      return '@cline';
   381→    case 'roo-code':
   382→      return '@roo';
   383→    case 'copilot-cli':
   384→      return '@copilot';
   385→    case 'gemini-cli':
   386→      return '@gemini';
   387→    case 'codex-cli':
   388→      return '@codex';
   389→    case 'aider':
   390→      return '@aider';
   391→    case 'opencode':
   392→      return '@opencode';
   393→    case 'amp':
   394→      return '@amp';
   395→    default:
   396→      return '@agent';
   397→  }
   398→}
   399→
   400→/**
   401→ * Print manual setup instructions
   402→ */
   403→function printManualInstructions(agentType: AgentType): void {
   404→  const author = getDefaultAuthor(agentType);
   405→
   406→  console.log('\nManual setup instructions:\n');
   407→
   408→  switch (agentType) {
   409→    case 'claude-code':
   410→      console.log('Add to ~/.claude/settings.json:');
   411→      console.log('```json');
   412→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   413→      console.log('```');
   414→      break;
   415→
   416→    case 'cline':
   417→    case 'roo-code':
   418→      console.log('Add to your shell profile (~/.bashrc, ~/.zshrc):');
   419→      console.log('```bash');
   420→      console.log(`export KSPEC_AUTHOR="${author}"`);
   421→      console.log('```');
   422→      console.log('\nThis will be inherited by terminals spawned by the VS Code extension.');
   423→      break;
   424→
   425→    case 'copilot-cli':
   426→      console.log('Add to ~/.copilot/config.json:');
   427→      console.log('```json');
   428→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   429→      console.log('```');
   430→      break;
   431→
   432→    case 'aider':
   433→      console.log('Add to ~/.aider.conf.yml:');
   434→      console.log('```yaml');
   435→      console.log('set-env:');
   436→      console.log(`  - KSPEC_AUTHOR=${author}`);
   437→      console.log('```');
   438→      break;
   439→
   440→    case 'codex-cli':
   441→      console.log('Add to ~/.codex/config.toml:');
   442→      console.log('```toml');
   443→      console.log('[shell_environment_policy]');
   444→      console.log(`set = { KSPEC_AUTHOR = "${author}" }`);
   445→      console.log('```');
   446→      break;
   447→
   448→    case 'opencode':
   449→      console.log('Add to ~/.config/opencode/opencode.json:');
   450→      console.log('```json');
   451→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   452→      console.log('```');
   453→      break;
   454→
   455→    case 'amp':
   456→      console.log('Add to ~/.config/amp/settings.json:');
   457→      console.log('```json');
   458→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   459→      console.log('```');
   460→      break;
   461→
   462→    default:
   463→      console.log('Set the KSPEC_AUTHOR environment variable:');
   464→      console.log('```bash');
   465→      console.log(`export KSPEC_AUTHOR="${author}"`);
   466→      console.log('```');
   467→      console.log('\nOr add to your shell profile (~/.bashrc, ~/.zshrc, etc.)');
   468→  }
   469→}
