   308→/**
   309→ * Install KSPEC_AUTHOR config for Aider (.aider.conf.yml)
   310→ * Aider uses `set-env:` for environment variables in list format
   311→ */
   312→async function installAiderConfig(author: string): Promise<boolean> {
   313→  const configPath = path.join(os.homedir(), '.aider.conf.yml');
   314→
   315→  try {
   316→    let content = '';
   317→    try {
   318→      content = await fs.readFile(configPath, 'utf-8');
   319→    } catch {
   320→      // File doesn't exist, start fresh
   321→    }
   322→
   323→    // Check if KSPEC_AUTHOR is already set
   324→    if (content.includes('KSPEC_AUTHOR')) {
   325→      // Replace existing value (handles both old and new format)
   326→      content = content.replace(/^(\s*-?\s*KSPEC_AUTHOR\s*[=:]\s*).*$/m, `  - KSPEC_AUTHOR=${author}`);
   327→    } else {
   328→      // Add to set-env section or create it
   329→      if (content.includes('set-env:')) {
   330→        // Append to existing set-env section
   331→        content = content.replace(/(set-env:\s*\n)/m, `$1  - KSPEC_AUTHOR=${author}\n`);
   332→      } else {
   333→        // Add new set-env section
   334→        content += `\n# kspec author for note attribution\nset-env:\n  - KSPEC_AUTHOR=${author}\n`;
   335→      }
   336→    }
   337→
   338→    await fs.writeFile(configPath, content, 'utf-8');
   339→    return true;
   340→  } catch {
   341→    return false;
   342→  }
   343→}
   344→
   345→/**
   346→ * Install KSPEC_AUTHOR for generic JSON config files
   347→ */
   348→async function installGenericJsonConfig(configPath: string, author: string): Promise<boolean> {
   349→  try {
   350→    const configDir = path.dirname(configPath);
   351→    await fs.mkdir(configDir, { recursive: true });
   352→
   353→    let config: Record<string, unknown> = {};
   354→    try {
   355→      const existing = await fs.readFile(configPath, 'utf-8');
   356→      config = JSON.parse(existing);
   357→    } catch {
   358→      // Start fresh
   359→    }
   360→
   361→    const env = (config.env as Record<string, string>) || {};
   362→    env.KSPEC_AUTHOR = author;
   363→    config.env = env;
   364→
   365→    await fs.writeFile(configPath, JSON.stringify(config, null, 2) + '\n', 'utf-8');
   366→    return true;
   367→  } catch {
   368→    return false;
   369→  }
   370→}
