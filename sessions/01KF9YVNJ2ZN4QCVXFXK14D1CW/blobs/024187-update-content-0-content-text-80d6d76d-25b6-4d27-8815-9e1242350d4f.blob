     4→--- /dev/null
     5→+++ b/src/cli/batch.ts
     6→@@ -0,0 +1,226 @@
     7→+/**
     8→+ * Shared utilities for batch operations on multiple refs.
     9→+ * Supports --refs @a @b @c flag pattern for commands like task complete, cancel, etc.
    10→+ */
    11→+
    12→+import chalk from 'chalk';
    13→+import type { ReferenceIndex } from '../parser/index.js';
    14→+import { error, isJsonMode } from './output.js';
    15→+
    16→+/**
    17→+ * Result of a single ref operation within a batch
    18→+ */
    19→+export interface BatchOperationResult {
    20→+  ref: string;
    21→+  ulid: string | null;
    22→+  status: 'success' | 'error';
    23→+  error?: string;
    24→+  message?: string;
    25→+  data?: unknown;
    26→+}
    27→+
    28→+/**
    29→+ * Summary of batch operation results
    30→+ */
    31→+export interface BatchSummary {
    32→+  total: number;
    33→+  succeeded: number;
    34→+  failed: number;
    35→+}
    36→+
    37→+/**
    38→+ * Complete result of a batch operation
    39→+ */
    40→+export interface BatchResult {
    41→+  success: boolean;
    42→+  summary: BatchSummary;
    43→+  results: BatchOperationResult[];
    44→+}
    45→+
    46→+/**
    47→+ * Options for executeBatchOperation
    48→+ */
    49→+export interface BatchOperationOptions<TItem, TContext> {
    50→+  /** The positional ref argument (if provided) */
    51→+  positionalRef?: string;
    52→+  /** The --refs flag values (if provided) */
    53→+  refsFlag?: string[];
    54→+  /** Context needed for operations */
    55→+  context: TContext;
    56→+  /** All items to search through */
    57→+  items: TItem[];
    58→+  /** Reference index for resolution */
    59→+  index: ReferenceIndex;
    60→+  /** Function to resolve a ref to an item - returns { item, error? } */
    61→+  resolveRef: (ref: string, items: TItem[], index: ReferenceIndex) => { item: TItem | null; error?: string };
    62→+  /** Function to execute the operation on a single item */
    63→+  executeOperation: (item: TItem, context: TContext) => Promise<{ success: boolean; message?: string; error?: string; data?: unknown }>;
    64→+  /** Function to extract ULID from an item */
    65→+  getUlid: (item: TItem) => string;
    66→+}
    67→+
    68→+/**
    69→+ * Execute a batch operation with support for single-ref (positional) or multi-ref (--refs flag).
    70→+ * Handles mutual exclusion, partial failures, and unified output formatting.
    71→+ *
    72→+ * Returns a BatchResult object. Caller should use formatBatchOutput() to render results.
    73→+ */
    74→+export async function executeBatchOperation<TItem, TContext>(
    75→+  options: BatchOperationOptions<TItem, TContext>
    76→+): Promise<BatchResult> {
    77→+  const { positionalRef, refsFlag, context, items, index, resolveRef, executeOperation, getUlid } = options;
    78→+
    79→+  // AC: @multi-ref-batch ac-3 - Mutual exclusion check
    80→+  if (positionalRef && refsFlag && refsFlag.length > 0) {
    81→+    error('Cannot use both positional ref and --refs flag');
    82→+    process.exit(3);
    83→+  }
    84→+
    85→+  // Determine which refs to process
    86→+  let refs: string[];
    87→+  if (refsFlag && refsFlag.length > 0) {
    88→+    refs = refsFlag;
    89→+  } else if (positionalRef) {
    90→+    refs = [positionalRef];
    91→+  } else {
    92→+    // AC: @multi-ref-batch ac-7 - Empty refs error
    93→+    error('--refs requires at least one reference');
    94→+    process.exit(3);
    95→+  }
    96→+
    97→+  // Process each ref
    98→+  const results: BatchOperationResult[] = [];
    99→+
   100→+  // AC: @multi-ref-batch ac-4 - Continue processing after errors (partial failure handling)
   101→+  for (const ref of refs) {
   102→+    try {
   103→+      // AC: @multi-ref-batch ac-8 - Ref resolution uses existing logic
   104→+      const resolved = resolveRef(ref, items, index);
   105→+
   106→+      if (!resolved.item) {
   107→+        // Resolution failed - record error and continue to next ref
   108→+        results.push({
   109→+          ref,
   110→+          ulid: null,
   111→+          status: 'error',
   112→+          error: resolved.error || `Failed to resolve reference: ${ref}`,
   113→+        });
   114→+        continue;
   115→+      }
   116→+
   117→+      const ulid = getUlid(resolved.item);
   118→+
   119→+      // Execute the operation
   120→+      const opResult = await executeOperation(resolved.item, context);
   121→+
   122→+      results.push({
   123→+        ref,
   124→+        ulid: index.shortUlid(ulid),
   125→+        status: opResult.success ? 'success' : 'error',
   126→+        message: opResult.message,
   127→+        error: opResult.error,
   128→+        data: opResult.data,
   129→+      });
   130→+    } catch (err) {
   131→+      // Unexpected error during operation
   132→+      results.push({
   133→+        ref,
   134→+        ulid: null,
   135→+        status: 'error',
   136→+        error: err instanceof Error ? err.message : String(err),
   137→+      });
   138→+    }
   139→+  }
   140→+
   141→+  // Calculate summary
   142→+  const succeeded = results.filter(r => r.status === 'success').length;
   143→+  const failed = results.filter(r => r.status === 'error').length;
   144→+  const summary: BatchSummary = {
   145→+    total: results.length,
   146→+    succeeded,
   147→+    failed,
   148→+  };
   149→+
   150→+  // Determine overall success
   151→+  const success = failed === 0;
   152→+
   153→+  return {
   154→+    success,
   155→+    summary,
   156→+    results,
   157→+  };
   158→+}
   159→+
   160→+/**
   161→+ * Format and output batch operation results.
   162→+ * Handles both human-readable and JSON output formats.
   163→+ * Sets appropriate exit code based on results.
   164→+ *
   165→+ * AC: @multi-ref-batch ac-5 - Human output format
   166→+ * AC: @multi-ref-batch ac-6 - JSON output format
   167→+ */
   168→+export function formatBatchOutput(result: BatchResult, operationName: string): void {
   169→+  if (isJsonMode()) {
   170→+    // AC: @multi-ref-batch ac-6 - JSON output
   171→+    console.log(JSON.stringify(result, null, 2));
   172→+  } else {
   173→+    // AC: @multi-ref-batch ac-5 - Human output format
   174→+    const { summary, results } = result;
   175→+
   176→+    // Summary line
   177→+    if (summary.total === 1) {
   178→+      // Single item - no summary needed, just show result
   179→+      const r = results[0];
   180→+      if (r.status === 'success') {
   181→+        console.log(chalk.green(`✓ ${operationName}: ${r.ulid || r.ref}`));
   182→+        if (r.message) {
   183→+          console.log(`  ${r.message}`);
   184→+        }
   185→+      } else {
   186→+        console.log(chalk.red(`✗ ${operationName} failed: ${r.ref}`));
   187→+        if (r.error) {
   188→+          console.log(chalk.red(`  ${r.error}`));
   189→+        }
   190→+      }
   191→+    } else {
   192→+      // Multiple items - show summary
   193→+      const verb = operationName.toLowerCase();
   194→+      console.log(`${chalk.bold(`${operationName}d ${summary.succeeded} of ${summary.total}:`
   195→+)}\n`);
   196→+
   197→+      // List each result
   198→+      for (const r of results) {
   199→+        if (r.status === 'success') {
   200→+          console.log(chalk.green(`✓ ${r.ulid || r.ref}`));
   201→+          if (r.message) {
   202→+            console.log(`  ${r.message}`);
   203→+          }
   204→+        } else {
   205→+          console.log(chalk.red(`✗ ${r.ref}`));
   206→+          if (r.error) {
   207→+            console.log(chalk.red(`  ${r.error}`));
   208→+          }
   209→+        }
   210→+      }
   211→+    }
   212→+  }
   213→+
   214→+  // Set exit code
   215→+  // AC: @multi-ref-batch ac-4 - Partial failure exit code
   216→+  if (!result.success) {
   217→+    if (result.summary.succeeded > 0) {
   218→+      // Partial failure
   219→+      process.exit(2);
   220→+    } else {
   221→+      // Complete failure
   222→+      process.exit(1);
   223→+    }
   224→+  }
   225→+}
   226→+
   227→+/**
   228→+ * Helper to check if refs flag is being used (for backward compatibility checks)
   229→+ */
   230→+export function isBatchMode(refsFlag?: string[]): boolean {
   231→+  return Boolean(refsFlag && refsFlag.length > 0);
   232→+}
