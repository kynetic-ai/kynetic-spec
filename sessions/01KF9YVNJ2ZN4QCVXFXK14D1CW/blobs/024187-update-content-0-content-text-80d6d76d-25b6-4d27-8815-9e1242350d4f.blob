   248→ 
   249→+/**
   250→+ * Batch-compatible resolver that returns null instead of calling process.exit().
   251→+ * Used by executeBatchOperation to handle errors without terminating the process.
   252→+ * AC: @multi-ref-batch ac-4, ac-8 - Partial failure handling and ref resolution
   253→+ */
   254→+function resolveTaskRefForBatch(
   255→+  ref: string,
   256→+  tasks: LoadedTask[],
   257→+  index: ReferenceIndex
   258→+): { task: LoadedTask | null; error?: string } {
   259→+  const result = index.resolve(ref);
   260→+
   261→+  if (!result.ok) {
   262→+    let errorMsg: string;
   263→+    switch (result.error) {
   264→+      case 'not_found':
   265→+        errorMsg = `Reference "${ref}" not found`;
   266→+        break;
   267→+      case 'ambiguous':
   268→+        errorMsg = `Reference "${ref}" is ambiguous (matches ${result.candidates.length} items)`;
   269→+        break;
   270→+      case 'duplicate_slug':
   271→+        errorMsg = `Slug "${ref}" maps to multiple items`;
   272→+        break;
   273→+    }
   274→+    return { task: null, error: errorMsg };
   275→+  }
   276→+
   277→+  // Check if it's actually a task
   278→+  const task = tasks.find(t => t._ulid === result.ulid);
   279→+  if (!task) {
   280→+    return { task: null, error: `Reference "${ref}" is not a task` };
   281→+  }
   282→+
   283→+  return { task };
   284→+}
