     1→/**
     2→ * Reference resolution system for @references.
     3→ *
     4→ * Handles resolution of @slug and @ulid references to actual items,
     5→ * with proper error handling for not-found and ambiguous cases.
     6→ */
     7→
     8→import type { LoadedSpecItem, LoadedTask, AnyLoadedItem } from './yaml.js';
     9→import type { LoadedMetaItem } from './meta.js';
    10→
    11→// ============================================================
    12→// TYPES
    13→// ============================================================
    14→
    15→/**
    16→ * Successful resolution result
    17→ * AC: @agent-definitions ac-agent-3
    18→ */
    19→export interface ResolveSuccess {
    20→  ok: true;
    21→  ulid: string;
    22→  item: AnyLoadedItem | LoadedMetaItem;
    23→  /** How the reference was matched */
    24→  matchType: 'slug' | 'ulid-full' | 'ulid-prefix';
    25→}
    26→
    27→/**
    28→ * Failed resolution - reference not found
    29→ */
    30→export interface ResolveNotFound {
    31→  ok: false;
    32→  error: 'not_found';
    33→  ref: string;
    34→}
    35→
    36→/**
    37→ * Failed resolution - ambiguous ULID prefix
    38→ */
    39→export interface ResolveAmbiguous {
    40→  ok: false;
    41→  error: 'ambiguous';
    42→  ref: string;
    43→  /** The matching ULIDs */
    44→  candidates: string[];
    45→}
    46→
    47→/**
    48→ * Failed resolution - duplicate slug
    49→ */
    50→export interface ResolveDuplicateSlug {
    51→  ok: false;
    52→  error: 'duplicate_slug';
    53→  ref: string;
    54→  /** The ULIDs that share this slug */
    55→  candidates: string[];
    56→}
    57→
    58→export type ResolveResult =
    59→  | ResolveSuccess
    60→  | ResolveNotFound
    61→  | ResolveAmbiguous
    62→  | ResolveDuplicateSlug;
    63→
    64→/**
    65→ * Validation error for a single reference
    66→ */
    67→export interface RefValidationError {
    68→  /** The reference string that failed */
    69→  ref: string;
    70→  /** Where this reference was found */
    71→  sourceFile?: string;
    72→  /** The item containing this reference */
    73→  sourceUlid?: string;
    74→  /** The field containing this reference */
    75→  field: string;
    76→  /** Error type */
    77→  error: 'not_found' | 'ambiguous' | 'duplicate_slug';
    78→  /** Additional context */
    79→  message: string;
    80→}
    81→
    82→/**
    83→ * Validation warning for a single reference
    84→ */
    85→export interface RefValidationWarning {
    86→  /** The reference string */
    87→  ref: string;
    88→  /** Where this reference was found */
    89→  sourceFile?: string;
    90→  /** The item containing this reference */
    91→  sourceUlid?: string;
    92→  /** The field containing this reference */
    93→  field: string;
    94→  /** Warning type */
    95→  warning: 'deprecated_target';
    96→  /** Additional context */
    97→  message: string;
    98→}
    99→
   100→// ============================================================
   101→// REFERENCE INDEX
   102→// ============================================================
   103→
   104→/**
   105→ * Index for efficient reference resolution.
   106→ * Build once when loading the spec, then resolve many times.
   107→ * AC: @agent-definitions ac-agent-3
   108→ */
   109→export class ReferenceIndex {
   110→  /** slug → ULID mapping */
   111→  private slugIndex = new Map<string, string[]>();
   112→
   113→  /** ULID → item mapping */
   114→  private ulidIndex = new Map<string, AnyLoadedItem | LoadedMetaItem>();
   115→
   116→  /** All ULIDs for prefix matching */
   117→  private allUlids: string[] = [];
   118→
   119→  /**
   120→   * Build index from loaded items and meta items
   121→   * AC: @agent-definitions ac-agent-3
   122→   */
   123→  constructor(
   124→    tasks: LoadedTask[],
   125→    items: LoadedSpecItem[],
   126→    metaItems: LoadedMetaItem[] = []
   127→  ) {
   128→    // Index tasks
   129→    for (const task of tasks) {
   130→      this.indexItem(task);
   131→    }
   132→
   133→    // Index spec items
   134→    for (const item of items) {
   135→      this.indexItem(item);
   136→    }
   137→
   138→    // Index meta items (agents, workflows, conventions, observations)
   139→    // AC: @agent-definitions ac-agent-3
   140→    for (const metaItem of metaItems) {
   141→      this.indexMetaItem(metaItem);
   142→    }
   143→
   144→    // Sort ULIDs for consistent ordering
   145→    this.allUlids.sort();
   146→  }
   147→
   148→  private indexItem(item: AnyLoadedItem): void {
   149→    const ulid = item._ulid;
   150→
   151→    // Index by ULID
   152→    this.ulidIndex.set(ulid, item);
   153→    this.allUlids.push(ulid);
   154→
   155→    // Index by slugs
   156→    for (const slug of item.slugs) {
   157→      const existing = this.slugIndex.get(slug);
   158→      if (existing) {
   159→        existing.push(ulid);
   160→      } else {
   161→        this.slugIndex.set(slug, [ulid]);
   162→      }
   163→    }
   164→  }
   165→
   166→  /**
   167→   * Index a meta item (agent, workflow, convention, observation)
   168→   * Meta items use 'id' field as their slug
   169→   * AC: @agent-definitions ac-agent-3
   170→   */
   171→  private indexMetaItem(item: LoadedMetaItem): void {
   172→    const ulid = item._ulid;
   173→
   174→    // Index by ULID
   175→    this.ulidIndex.set(ulid, item);
   176→    this.allUlids.push(ulid);
   177→
   178→    // Index by id (acts like a slug for meta items)
   179→    const metaItem = item as { id?: string };
   180→    if (metaItem.id) {
   181→      const existing = this.slugIndex.get(metaItem.id);
   182→      if (existing) {
   183→        existing.push(ulid);
   184→      } else {
   185→        this.slugIndex.set(metaItem.id, [ulid]);
   186→      }
   187→    }
   188→  }
   189→
   190→  /**
   191→   * Resolve a reference to an item.
   192→   *
   193→   * Resolution order:
   194→   * 1. Exact slug match
   195→   * 2. Full ULID match
   196→   * 3. ULID prefix match (must be unique)
   197→   */
   198→  resolve(ref: string): ResolveResult {
   199→    // Strip @ prefix if present
   200→    const cleanRef = ref.startsWith('@') ? ref.slice(1) : ref;
   201→    const cleanRefLower = cleanRef.toLowerCase();
   202→
   203→    // 1. Try slug match first
   204→    const slugMatches = this.slugIndex.get(cleanRef);
   205→    if (slugMatches) {
   206→      if (slugMatches.length > 1) {
   207→        return {
   208→          ok: false,
   209→          error: 'duplicate_slug',
   210→          ref,
   211→          candidates: slugMatches,
   212→        };
   213→      }
   214→      const ulid = slugMatches[0];
   215→      const item = this.ulidIndex.get(ulid)!;
   216→      return { ok: true, ulid, item, matchType: 'slug' };
   217→    }
   218→
   219→    // 2. Try full ULID match
   220→    const exactMatch = this.ulidIndex.get(cleanRef.toUpperCase());
   221→    if (exactMatch) {
   222→      return {
   223→        ok: true,
   224→        ulid: exactMatch._ulid,
   225→        item: exactMatch,
   226→        matchType: 'ulid-full',
   227→      };
   228→    }
   229→
   230→    // 3. Try ULID prefix match
   231→    const prefixMatches = this.allUlids.filter(ulid =>
   232→      ulid.toLowerCase().startsWith(cleanRefLower)
   233→    );
   234→
   235→    if (prefixMatches.length === 0) {
   236→      return { ok: false, error: 'not_found', ref };
   237→    }
   238→
   239→    if (prefixMatches.length > 1) {
   240→      return {
   241→        ok: false,
   242→        error: 'ambiguous',
   243→        ref,
   244→        candidates: prefixMatches,
   245→      };
   246→    }
   247→
   248→    const ulid = prefixMatches[0];
   249→    const item = this.ulidIndex.get(ulid)!;
   250→    return { ok: true, ulid, item, matchType: 'ulid-prefix' };
   251→  }
   252→
   253→  /**
   254→   * Get an item by exact ULID (no resolution, direct lookup)
   255→   */
   256→  getByUlid(ulid: string): AnyLoadedItem | LoadedMetaItem | undefined {
   257→    return this.ulidIndex.get(ulid);
   258→  }
   259→
   260→  /**
   261→   * Get the minimum unique prefix for a ULID.
   262→   * Returns the shortest prefix that uniquely identifies this ULID
   263→   * among all indexed items.
   264→   *
   265→   * @param ulid The full ULID to shorten
   266→   * @param minLength Minimum prefix length (default 8)
   267→   * @returns Shortest unique prefix
   268→   */
   269→  shortUlid(ulid: string, minLength = 8): string {
   270→    // Start with minimum length
   271→    let length = minLength;
   272→
   273→    while (length < ulid.length) {
   274→      const prefix = ulid.slice(0, length);
   275→      const matches = this.allUlids.filter(u =>
   276→        u.toUpperCase().startsWith(prefix.toUpperCase())
   277→      );
   278→
   279→      if (matches.length === 1) {
   280→        return prefix;
   281→      }
   282→
   283→      length++;
   284→    }
   285→
   286→    // Return full ULID if no shorter unique prefix found
   287→    return ulid;
   288→  }
   289→
   290→  /**
   291→   * Get all indexed ULIDs
   292→   */
   293→  getAllUlids(): string[] {
   294→    return [...this.allUlids];
   295→  }
   296→
   297→  /**
   298→   * Get all slugs and their mappings
   299→   */
   300→  getAllSlugs(): Map<string, string[]> {
   301→    return new Map(this.slugIndex);
   302→  }
   303→
   304→  /**
   305→   * Check if a slug exists
   306→   */
   307→  hasSlug(slug: string): boolean {
   308→    return this.slugIndex.has(slug);
   309→  }
   310→
   311→  /**
   312→   * Get count of indexed items
   313→   */
   314→  get size(): number {
   315→    return this.ulidIndex.size;
   316→  }
   317→}
   318→
   319→// ============================================================
   320→// VALIDATION
   321→// ============================================================
   322→
   323→/**
   324→ * Fields that contain references
   325→ * AC: @agent-definitions ac-agent-3 - added_by for agent references
   326→ * AC: @workflow-definitions ac-workflow-3 - meta_ref for workflow references
   327→ */
   328→const REF_FIELDS = [
   329→  'depends_on',
   330→  'blocked_by',
   331→  'implements',
   332→  'relates_to',
   333→  'tests',
   334→  'supersedes',
   335→  'spec_ref',
   336→  'context',
   337→  'added_by', // Agent reference
   338→  'author', // Agent reference
   339→  'resolved_by', // Agent reference
   340→  'workflow_ref', // Workflow reference
   341→  'meta_ref', // Meta reference (workflow, agent, convention)
   342→];
   343→
   344→/**
   345→ * Check if an item is deprecated
   346→ */
   347→function isDeprecated(item: AnyLoadedItem | LoadedMetaItem): boolean {
   348→  const obj = item as unknown as Record<string, unknown>;
   349→
   350→  // Check for deprecated_in field (truthy value means deprecated)
   351→  if ('deprecated_in' in obj && obj.deprecated_in) {
   352→    return true;
   353→  }
   354→
   355→  // Check for maturity: deprecated status
   356→  if ('status' in obj && obj.status && typeof obj.status === 'object') {
   357→    const status = obj.status as Record<string, unknown>;
   358→    if ('maturity' in status && status.maturity === 'deprecated') {
   359→      return true;
   360→    }
   361→  }
   362→
   363→  // Also check top-level maturity field (some items may have it there)
   364→  if ('maturity' in obj && obj.maturity === 'deprecated') {
   365→    return true;
   366→  }
   367→
   368→  return false;
   369→}
   370→
   371→/**
   372→ * Extract all references from an item
   373→ * AC: @agent-definitions ac-agent-3 - also checks nested notes for author refs
   374→ */
   375→function extractRefs(item: AnyLoadedItem): Array<{ field: string; ref: string }> {
   376→  const refs: Array<{ field: string; ref: string }> = [];
   377→  const obj = item as unknown as Record<string, unknown>;
   378→
   379→  for (const field of REF_FIELDS) {
   380→    const value = obj[field];
   381→
   382→    if (typeof value === 'string' && value.startsWith('@')) {
   383→      refs.push({ field, ref: value });
   384→    } else if (Array.isArray(value)) {
   385→      for (const v of value) {
   386→        if (typeof v === 'string' && v.startsWith('@')) {
   387→          refs.push({ field, ref: v });
   388→        }
   389→      }
   390→    }
   391→  }
   392→
   393→  // Check nested notes for author references
   394→  // AC: @agent-definitions ac-agent-3
   395→  if ('notes' in obj && Array.isArray(obj.notes)) {
   396→    for (const note of obj.notes) {
   397→      if (note && typeof note === 'object' && 'author' in note) {
   398→        const author = (note as { author?: string }).author;
   399→        if (typeof author === 'string' && author.startsWith('@')) {
   400→          refs.push({ field: 'notes[].author', ref: author });
   401→        }
   402→      }
   403→    }
   404→  }
   405→
   406→  // Check nested todos for added_by references
   407→  if ('todos' in obj && Array.isArray(obj.todos)) {
   408→    for (const todo of obj.todos) {
   409→      if (todo && typeof todo === 'object' && 'added_by' in todo) {
   410→        const addedBy = (todo as { added_by?: string }).added_by;
   411→        if (typeof addedBy === 'string' && addedBy.startsWith('@')) {
   412→          refs.push({ field: 'todos[].added_by', ref: addedBy });
   413→        }
   414→      }
   415→    }
   416→  }
   417→
   418→  return refs;
   419→}
   420→
   421→/**
   422→ * Validation result with errors and warnings
   423→ */
   424→export interface RefValidationResult {
   425→  errors: RefValidationError[];
   426→  warnings: RefValidationWarning[];
   427→}
   428→
   429→/**
   430→ * Validate all references in the spec.
   431→ * Returns list of validation errors and warnings.
   432→ */
   433→export function validateRefs(
   434→  index: ReferenceIndex,
   435→  tasks: LoadedTask[],
   436→  items: LoadedSpecItem[]
   437→): RefValidationResult {
   438→  const errors: RefValidationError[] = [];
   439→  const warnings: RefValidationWarning[] = [];
   440→
   441→  const allItems: AnyLoadedItem[] = [...tasks, ...items];
   442→
   443→  for (const item of allItems) {
   444→    const refs = extractRefs(item);
   445→    const sourceFile = (item as LoadedTask | LoadedSpecItem)._sourceFile;
   446→
   447→    for (const { field, ref } of refs) {
   448→      const result = index.resolve(ref);
   449→
   450→      if (!result.ok) {
   451→        let message: string;
   452→
   453→        switch (result.error) {
   454→          case 'not_found':
   455→            message = `Reference "${ref}" not found`;
   456→            break;
   457→          case 'ambiguous':
   458→            message = `Reference "${ref}" is ambiguous, matches: ${result.candidates.join(', ')}`;
   459→            break;
   460→          case 'duplicate_slug':
   461→            message = `Slug "${ref}" maps to multiple items: ${result.candidates.join(', ')}`;
   462→            break;
   463→        }
   464→
   465→        errors.push({
   466→          ref,
   467→          sourceFile,
   468→          sourceUlid: item._ulid,
   469→          field,
   470→          error: result.error,
   471→          message,
   472→        });
   473→      } else {
   474→        // Check if resolved target is deprecated
   475→        if (isDeprecated(result.item)) {
   476→          const targetTitle = (result.item as { title?: string }).title || result.ulid;
   477→          warnings.push({
   478→            ref,
   479→            sourceFile,
   480→            sourceUlid: item._ulid,
   481→            field,
   482→            warning: 'deprecated_target',
   483→            message: `Reference "${ref}" points to deprecated item: ${targetTitle}`,
   484→          });
   485→        }
   486→      }
   487→    }
   488→  }
   489→
   490→  return { errors, warnings };
   491→}
   492→
   493→/**
   494→ * Find duplicate slugs in the index.
   495→ * Returns map of slug → ULIDs for slugs with multiple items.
   496→ */
   497→export function findDuplicateSlugs(index: ReferenceIndex): Map<string, string[]> {
   498→  const duplicates = new Map<string, string[]>();
   499→
   500→  for (const [slug, ulids] of index.getAllSlugs()) {
   501→    if (ulids.length > 1) {
   502→      duplicates.set(slug, ulids);
   503→    }
   504→  }
   505→
   506→  return duplicates;
   507→}
   508→
   509→// ============================================================
   510→// SLUG UNIQUENESS CHECK
   511→// ============================================================
   512→
   513→/**
   514→ * Result of checking slug uniqueness
   515→ */
   516→export interface SlugCheckSuccess {
   517→  ok: true;
   518→}
   519→
   520→export interface SlugCheckConflict {
   521→  ok: false;
   522→  slug: string;
   523→  existingUlid: string;
   524→}
   525→
   526→export type SlugCheckResult = SlugCheckSuccess | SlugCheckConflict;
   527→
   528→/**
   529→ * Check if proposed slugs are unique (don't conflict with existing items).
   530→ *
   531→ * @param index The reference index to check against
   532→ * @param slugs Array of proposed slugs to check
   533→ * @param excludeUlid Optional ULID to exclude from conflict check (for updates)
   534→ * @returns Success if all slugs are available, or conflict info if one exists
   535→ */
   536→export function checkSlugUniqueness(
   537→  index: ReferenceIndex,
   538→  slugs: string[],
   539→  excludeUlid?: string
   540→): SlugCheckResult {
   541→  const allSlugs = index.getAllSlugs();
   542→
   543→  for (const slug of slugs) {
   544→    const existingUlids = allSlugs.get(slug);
   545→    if (existingUlids) {
   546→      // Filter out the item being updated (if provided)
   547→      const conflictingUlids = excludeUlid
   548→        ? existingUlids.filter(ulid => ulid !== excludeUlid)
   549→        : existingUlids;
   550→
   551→      if (conflictingUlids.length > 0) {
   552→        return {
   553→          ok: false,
   554→          slug,
   555→          existingUlid: conflictingUlids[0],
   556→        };
   557→      }
   558→    }
   559→  }
   560→
   561→  return { ok: true };
   562→}
   563→

