   936→
   937→  // kspec task todo add <ref> <text>
   938→  todoCmd
   939→    .command('add <ref> <text>')
   940→    .description('Add a todo to a task')
   941→    .option('--author <author>', 'Todo author')
   942→    .action(async (ref: string, text: string, options) => {
   943→      try {
   944→        const ctx = await initContext();
   945→        const tasks = await loadAllTasks(ctx);
   946→        const items = await loadAllItems(ctx);
   947→        const index = new ReferenceIndex(tasks, items);
   948→        const foundTask = resolveTaskRef(ref, tasks, index);
   949→
   950→        // Calculate next ID (max existing + 1, or 1 if none)
   951→        const nextId = foundTask.todos.length > 0
   952→          ? Math.max(...foundTask.todos.map(t => t.id)) + 1
   953→          : 1;
   954→
   955→        const todo = createTodo(nextId, text, options.author);
   956→
   957→        const updatedTask: Task = {
   958→          ...foundTask,
   959→          todos: [...foundTask.todos, todo],
   960→        };
   961→
   962→        await saveTask(ctx, updatedTask);
   963→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   964→        success(`Added todo #${todo.id} to task: ${index.shortUlid(updatedTask._ulid)}`, { todo });
   965→      } catch (err) {
   966→        error(errors.failures.addTodo, err);
   967→        process.exit(1);
   968→      }
   969→    });
   970→
   971→  // kspec task todo done <ref> <id>
   972→  todoCmd
   973→    .command('done <ref> <id>')
   974→    .description('Mark a todo as done')
   975→    .action(async (ref: string, idStr: string) => {
   976→      try {
   977→        const ctx = await initContext();
   978→        const tasks = await loadAllTasks(ctx);
   979→        const items = await loadAllItems(ctx);
   980→        const index = new ReferenceIndex(tasks, items);
   981→        const foundTask = resolveTaskRef(ref, tasks, index);
   982→
   983→        const id = parseInt(idStr, 10);
   984→        if (isNaN(id)) {
   985→          error(errors.todo.invalidId(idStr));
   986→          process.exit(3);
   987→        }
   988→
   989→        const todoIndex = foundTask.todos.findIndex(t => t.id === id);
   990→        if (todoIndex === -1) {
   991→          error(errors.todo.notFound(id));
   992→          process.exit(3);
   993→        }
   994→
   995→        if (foundTask.todos[todoIndex].done) {
   996→          warn(`Todo #${id} is already done`);
   997→          return;
   998→        }
   999→
  1000→        const updatedTodos = [...foundTask.todos];
  1001→        updatedTodos[todoIndex] = {
  1002→          ...updatedTodos[todoIndex],
  1003→          done: true,
  1004→          done_at: new Date().toISOString(),
  1005→        };
  1006→
  1007→        const updatedTask: Task = {
  1008→          ...foundTask,
  1009→          todos: updatedTodos,
  1010→        };
  1011→
  1012→        await saveTask(ctx, updatedTask);
  1013→        await commitIfShadow(ctx.shadow, 'task-note', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
  1014→        success(`Marked todo #${id} as done`, { todo: updatedTodos[todoIndex] });
  1015→      } catch (err) {
  1016→        error(errors.failures.markTodoDone, err);
  1017→        process.exit(1);
  1018→      }
  1019→    });
