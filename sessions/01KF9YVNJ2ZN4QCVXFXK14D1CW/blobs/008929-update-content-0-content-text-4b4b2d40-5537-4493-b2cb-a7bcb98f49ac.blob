   795→  // kspec task review <ref>
   796→  task
   797→    .command('review <ref>')
   798→    .description('Get task context for review (task details, spec, ACs, git diff)')
   799→    .action(async (ref: string) => {
   800→      try {
   801→        const ctx = await initContext();
   802→        const tasks = await loadAllTasks(ctx);
   803→        const items = await loadAllItems(ctx);
   804→        const index = new ReferenceIndex(tasks, items);
   805→        const foundTask = resolveTaskRef(ref, tasks, index);
   806→
   807→        // Import getDiffSince from utils
   808→        const { getDiffSince } = await import('../../utils/index.js');
   809→
   810→        // Gather review context
   811→        const reviewContext: {
   812→          task: typeof foundTask;
   813→          spec: LoadedSpecItem | null;
   814→          diff: string | null;
   815→          started_at: string | null;
   816→        } = {
   817→          task: foundTask,
   818→          spec: null,
   819→          diff: null,
   820→          started_at: foundTask.started_at || null,
   821→        };
   822→
   823→        // Get spec item if task has spec_ref
   824→        if (foundTask.spec_ref) {
   825→          const specResult = index.resolve(foundTask.spec_ref);
   826→          if (specResult.ok) {
   827→            const specItem = items.find(i => i._ulid === specResult.ulid);
   828→            reviewContext.spec = specItem || null;
   829→          }
   830→        }
   831→
   832→        // Get git diff since task started
   833→        if (foundTask.started_at) {
   834→          const startedDate = new Date(foundTask.started_at);
   835→          reviewContext.diff = getDiffSince(startedDate, ctx.rootDir);
   836→        }
   837→
   838→        output(reviewContext, () => {
   839→          console.log('='.repeat(60));
   840→          console.log('Task Review Context');
   841→          console.log('='.repeat(60));
   842→          console.log();
   843→
   844→          // Task details
   845→          console.log('TASK DETAILS');
   846→          console.log('-'.repeat(60));
   847→          console.log(formatTaskDetails(foundTask, index));
   848→          console.log();
   849→
   850→          // Spec details
   851→          if (reviewContext.spec) {
   852→            console.log('LINKED SPEC');
   853→            console.log('-'.repeat(60));
   854→            console.log(`Title: ${reviewContext.spec.title}`);
   855→            console.log(`Type: ${reviewContext.spec.type}`);
   856→            if (reviewContext.spec.description) {
   857→              console.log(`\nDescription:\n${reviewContext.spec.description}`);
   858→            }
   859→            if (reviewContext.spec.acceptance_criteria && reviewContext.spec.acceptance_criteria.length > 0) {
   860→              console.log(`\nAcceptance Criteria (${reviewContext.spec.acceptance_criteria.length}):`);
   861→              for (const ac of reviewContext.spec.acceptance_criteria) {
   862→                console.log(`  [${ac.id}]`);
   863→                console.log(`    Given: ${ac.given}`);
   864→                console.log(`    When: ${ac.when}`);
   865→                console.log(`    Then: ${ac.then}`);
   866→              }
   867→            }
   868→            console.log();
   869→          }
   870→
   871→          // Git diff
   872→          if (reviewContext.diff) {
   873→            console.log('CHANGES SINCE TASK STARTED');
   874→            console.log('-'.repeat(60));
   875→            console.log(`Started at: ${foundTask.started_at}`);
   876→            console.log();
   877→            console.log(reviewContext.diff);
   878→            console.log();
   879→          } else if (foundTask.started_at) {
   880→            console.log('CHANGES SINCE TASK STARTED');
   881→            console.log('-'.repeat(60));
   882→            console.log(`Started at: ${foundTask.started_at}`);
   883→            console.log('No changes detected');
   884→            console.log();
   885→          }
   886→
   887→          console.log('='.repeat(60));
   888→          console.log('Review Checklist:');
   889→          console.log('- Does the implementation match the task description?');
   890→          if (reviewContext.spec) {
   891→            console.log('- Are all acceptance criteria covered?');
   892→            console.log('- Is test coverage adequate?');
   893→          }
   894→          console.log('- Are there any gaps or issues?');
   895→          console.log('='.repeat(60));
   896→        });
   897→      } catch (err) {
   898→        error('Failed to generate review context', err);
   899→        process.exit(1);
   900→      }
   901→    });
