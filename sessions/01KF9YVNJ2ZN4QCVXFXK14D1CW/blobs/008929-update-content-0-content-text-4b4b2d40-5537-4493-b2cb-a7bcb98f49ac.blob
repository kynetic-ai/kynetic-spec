   650→          closed_reason: options.reason || null,
   651→        };
   652→
   653→        await saveTask(ctx, updatedTask);
   654→        await commitIfShadow(ctx.shadow, 'task-cancel', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   655→        success(`Cancelled task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   656→      } catch (err) {
   657→        error(errors.failures.cancelTask, err);
   658→        process.exit(1);
   659→      }
   660→    });
   661→
   662→  // kspec task delete <ref>
   663→  task
   664→    .command('delete <ref>')
   665→    .description('Delete a task permanently')
   666→    .option('--force', 'Skip confirmation')
   667→    .option('--dry-run', 'Show what would be deleted without deleting')
   668→    .action(async (ref: string, options) => {
   669→      try {
   670→        const ctx = await initContext();
   671→        const tasks = await loadAllTasks(ctx);
   672→        const items = await loadAllItems(ctx);
   673→        const index = new ReferenceIndex(tasks, items);
   674→        const foundTask = resolveTaskRef(ref, tasks, index);
   675→
   676→        const taskDisplay = `${foundTask.title} (${index.shortUlid(foundTask._ulid)})`;
   677→
   678→        if (options.dryRun) {
   679→          info(`Would delete task: ${taskDisplay}`);
   680→          console.log(`  Source file: ${foundTask._sourceFile}`);
   681→          console.log(`  Status: ${foundTask.status}`);
   682→          if (foundTask.notes.length > 0) {
   683→            console.log(`  Notes: ${foundTask.notes.length}`);
   684→          }
   685→          return;
   686→        }
   687→
   688→        // Confirm unless --force
   689→        if (!options.force) {
   690→          const readline = await import('readline');
   691→          const rl = readline.createInterface({
   692→            input: process.stdin,
   693→            output: process.stdout,
   694→          });
   695→
   696→          const answer = await new Promise<string>((resolve) => {
   697→            rl.question(`Delete task "${taskDisplay}"? [y/N] `, resolve);
   698→          });
   699→          rl.close();
   700→
   701→          if (answer.toLowerCase() !== 'y') {
   702→            info('Deletion cancelled');
   703→            return;
   704→          }
   705→        }
   706→
   707→        await deleteTask(ctx, foundTask);
   708→        await commitIfShadow(ctx.shadow, 'task-delete', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), foundTask.title);
   709→        success(`Deleted task: ${taskDisplay}`);
   710→      } catch (err) {
   711→        error(errors.failures.deleteTask, err);
   712→        process.exit(1);
   713→      }
   714→    });
   715→
   716→  // kspec task note <ref> <message>
   717→  task
   718→    .command('note <ref> <message>')
   719→    .description('Add a note to a task')
   720→    .option('--author <author>', 'Note author')
   721→    .option('--supersedes <ulid>', 'ULID of note this supersedes')
   722→    .action(async (ref: string, message: string, options) => {
   723→      try {
   724→        const ctx = await initContext();
