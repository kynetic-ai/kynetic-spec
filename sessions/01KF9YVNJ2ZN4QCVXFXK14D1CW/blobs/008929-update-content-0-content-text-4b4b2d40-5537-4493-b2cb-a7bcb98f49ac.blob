```
     1→import { Command } from 'commander';
     2→import { ulid } from 'ulid';
     3→import {
     4→  initContext,
     5→  loadAllTasks,
     6→  loadAllItems,
     7→  saveTask,
     8→  deleteTask,
     9→  createTask,
    10→  createNote,
    11→  createTodo,
    12→  syncSpecImplementationStatus,
    13→  ReferenceIndex,
    14→  checkSlugUniqueness,
    15→  type LoadedTask,
    16→  type LoadedSpecItem,
    17→} from '../../parser/index.js';
    18→import { commitIfShadow } from '../../parser/shadow.js';
    19→import {
    20→  output,
    21→  formatTaskDetails,
    22→  success,
    23→  error,
    24→  warn,
    25→  info,
    26→  isJsonMode,
    27→} from '../output.js';
    28→import { formatCommitGuidance, printCommitGuidance } from '../../utils/commit.js';
    29→import type { Task, TaskInput } from '../../schema/index.js';
    30→import { alignmentCheck, errors } from '../../strings/index.js';
    31→
    32→/**
    33→ * Find a task by reference with detailed error reporting.
    34→ * Returns the task or exits with appropriate error.
    35→ */
    36→function resolveTaskRef(
    37→  ref: string,
    38→  tasks: LoadedTask[],
    39→  index: ReferenceIndex
    40→): LoadedTask {
    41→  const result = index.resolve(ref);
    42→
    43→  if (!result.ok) {
    44→    switch (result.error) {
    45→      case 'not_found':
    46→        error(errors.reference.taskNotFound(ref));
    47→        break;
    48→      case 'ambiguous':
    49→        error(errors.reference.ambiguous(ref));
    50→        for (const candidate of result.candidates) {
    51→          const task = tasks.find(t => t._ulid === candidate);
    52→          const slug = task?.slugs[0] || '';
    53→          console.error(`  - ${index.shortUlid(candidate)} ${slug ? `(${slug})` : ''}`);
    54→        }
    55→        break;
    56→      case 'duplicate_slug':
    57→        error(errors.reference.slugMapsToMultiple(ref));
    58→        for (const candidate of result.candidates) {
    59→          console.error(`  - ${index.shortUlid(candidate)}`);
    60→        }
    61→        break;
    62→    }
    63→    process.exit(3);
    64→  }
    65→
    66→  // Check if it's actually a task
    67→  const task = tasks.find(t => t._ulid === result.ulid);
    68→  if (!task) {
    69→    error(errors.reference.notTask(ref));
    70→    process.exit(3);
    71→  }
    72→
    73→  return task;
    74→}
    75→
    76→/**
    77→ * Register the 'task' command group (singular - operations on individual tasks)
    78→ */
    79→export function registerTaskCommands(program: Command): void {
    80→  const task = program
    81→    .command('task')
    82→    .description('Operations on individual tasks');
    83→
    84→  // kspec task get <ref>
    85→  task
    86→    .command('get <ref>')
    87→    .description('Get task details')
    88→    .action(async (ref: string) => {
    89→      try {
    90→        const ctx = await initContext();
    91→        const tasks = await loadAllTasks(ctx);
    92→        const items = await loadAllItems(ctx);
    93→        const index = new ReferenceIndex(tasks, items);
    94→        const foundTask = resolveTaskRef(ref, tasks, index);
    95→
    96→        output(foundTask, () => formatTaskDetails(foundTask, index));
    97→      } catch (err) {
    98→        error(errors.failures.getTask, err);
    99→        process.exit(1);
   100→      }
   101→    });
   102→
   103→  // kspec task add
   104→  task
   105→    .command('add')
   106→    .description('Create a new task')
   107→    .requiredOption('--title <title>', 'Task title')
   108→    .option('--type <type>', 'Task type (task, epic, bug, spike, infra)', 'task')
   109→    .option('--spec-ref <ref>', 'Reference to spec item')
   110→    .option('--meta-ref <ref>', 'Reference to meta item (workflow, agent, or convention)')
   111→    .option('--priority <n>', 'Priority (1-5)', '3')
   112→    .option('--slug <slug>', 'Human-friendly slug')
   113→    .option('--tag <tag...>', 'Tags')
   114→    .action(async (options) => {
   115→      try {
   116→        const ctx = await initContext();
   117→        const tasks = await loadAllTasks(ctx);
   118→        const items = await loadAllItems(ctx);
   119→
   120→        // Load meta items for validation
   121→        const { loadMetaContext } = await import('../../parser/meta.js');
   122→        const metaContext = await loadMetaContext(ctx);
   123→        const allMetaItems = [
   124→          ...metaContext.agents,
   125→          ...metaContext.workflows,
   126→          ...metaContext.conventions,
   127→          ...metaContext.observations,
   128→        ];
   129→
   130→        // Build index for reference validation
   131→        const refIndex = new ReferenceIndex(tasks, items, allMetaItems);
   132→
   133→        // Check slug uniqueness if provided
   134→        if (options.slug) {
   135→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   136→          if (!slugCheck.ok) {
   137→            error(errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid));
   138→            process.exit(1);
   139→          }
   140→        }
   141→
   142→        // Validate meta_ref if provided (AC-meta-ref-3, AC-meta-ref-4)
   143→        if (options.metaRef) {
   144→          const metaRefResult = refIndex.resolve(options.metaRef);
   145→
   146→          if (!metaRefResult.ok) {
   147→            error(errors.reference.metaRefNotFound(options.metaRef));
   148→            process.exit(3);
   149→          }
   150→
   151→          // Check if the resolved item is a meta item (not a spec item or task)
   152→          const isTask = tasks.some(t => t._ulid === metaRefResult.ulid);
   153→          const isSpecItem = items.some(i => i._ulid === metaRefResult.ulid);
   154→
   155→          if (isTask || isSpecItem) {
   156→            error(errors.reference.metaRefPointsToSpec(options.metaRef));
   157→            process.exit(3);
   158→          }
   159→        }
   160→
   161→        const input: TaskInput = {
   162→          title: options.title,
   163→          type: options.type,
   164→          spec_ref: options.specRef || null,
   165→          meta_ref: options.metaRef || null,
   166→          priority: parseInt(options.priority, 10),
   167→          slugs: options.slug ? [options.slug] : [],
   168→          tags: options.tag || [],
   169→        };
   170→
   171→        const newTask = createTask(input);
   172→        await saveTask(ctx, newTask);
   173→        await commitIfShadow(ctx.shadow, 'task-add', newTask.slugs[0] || newTask._ulid.slice(0, 8), newTask.title);
   174→
   175→        // Build index including the new task for accurate short ULID
   176→        const index = new ReferenceIndex([...tasks, newTask], items, allMetaItems);
   177→        success(`Created task: ${index.shortUlid(newTask._ulid)}`, { task: newTask });
   178→      } catch (err) {
   179→        error(errors.failures.createTask, err);
   180→        process.exit(1);
   181→      }
   182→    });
   183→
   184→  // kspec task set <ref>
   185→  task
   186→    .command('set <ref>')
   187→    .description('Update task fields')
   188→    .option('--title <title>', 'Update task title')
   189→    .option('--spec-ref <ref>', 'Link to spec item')
   190→    .option('--meta-ref <ref>', 'Link to meta item (workflow, agent, or convention)')
   191→    .option('--priority <n>', 'Set priority (1-5)')
   192→    .option('--slug <slug>', 'Add a slug alias')
   193→    .option('--tag <tag...>', 'Add tags')
   194→    .option('--depends-on <refs...>', 'Set dependencies (replaces existing)')
   195→    .action(async (ref: string, options) => {
   196→      try {
   197→        const ctx = await initContext();
   198→        const tasks = await loadAllTasks(ctx);
   199→        const items = await loadAllItems(ctx);
   200→
   201→        // Load meta items for validation
   202→        const { loadMetaContext } = await import('../../parser/meta.js');
   203→        const metaContext = await loadMetaContext(ctx);
   204→        const allMetaItems = [
   205→          ...metaContext.agents,
   206→          ...metaContext.workflows,
   207→          ...metaContext.conventions,
   208→          ...metaContext.observations,
   209→        ];
   210→
   211→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   212→        const foundTask = resolveTaskRef(ref, tasks, index);
   213→
   214→        // Check slug uniqueness if adding a new slug
   215→        if (options.slug) {
   216→          const slugCheck = checkSlugUniqueness(index, [options.slug], foundTask._ulid);
   217→          if (!slugCheck.ok) {
   218→            error(errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid));
   219→            process.exit(1);
   220→          }
   221→        }
   222→
   223→        // Build updated task with only provided options
   224→        const updatedTask: Task = { ...foundTask };
   225→        const changes: string[] = [];
   226→
   227→        if (options.title) {
   228→          updatedTask.title = options.title;
   229→          changes.push('title');
   230→        }
   231→
   232→        if (options.specRef) {
   233→          // Validate the spec ref exists and is a spec item
   234→          const specResult = index.resolve(options.specRef);
   235→          if (!specResult.ok) {
   236→            error(errors.reference.specRefNotFound(options.specRef));
   237→            process.exit(3);
   238→          }
   239→          // Check it's not a task
   240→          const isTask = tasks.some(t => t._ulid === specResult.ulid);
   241→          if (isTask) {
   242→            error(errors.reference.specRefIsTask(options.specRef));
   243→            process.exit(3);
   244→          }
   245→          updatedTask.spec_ref = options.specRef;
   246→          changes.push('spec_ref');
   247→        }
   248→
   249→        if (options.metaRef) {
   250→          // Validate the meta ref exists and is a meta item
   251→          const metaRefResult = index.resolve(options.metaRef);
   252→          if (!metaRefResult.ok) {
   253→            error(errors.reference.metaRefNotFound(options.metaRef));
   254→            process.exit(3);
   255→          }
   256→
   257→          // Check if the resolved item is a meta item (not a spec item or task)
   258→          const isTask = tasks.some(t => t._ulid === metaRefResult.ulid);
   259→          const isSpecItem = items.some(i => i._ulid === metaRefResult.ulid);
   260→
   261→          if (isTask || isSpecItem) {
   262→            error(errors.reference.metaRefPointsToSpec(options.metaRef));
   263→            process.exit(3);
   264→          }
   265→
   266→          updatedTask.meta_ref = options.metaRef;
   267→          changes.push('meta_ref');
   268→        }
   269→
   270→        if (options.priority) {
   271→          const priority = parseInt(options.priority, 10);
   272→          if (isNaN(priority) || priority < 1 || priority > 5) {
   273→            error(errors.validation.priorityOutOfRange);
   274→            process.exit(3);
   275→          }
   276→          updatedTask.priority = priority;
   277→          changes.push('priority');
   278→        }
   279→
   280→        if (options.slug) {
   281→          if (!updatedTask.slugs.includes(options.slug)) {
   282→            updatedTask.slugs = [...updatedTask.slugs, options.slug];
   283→            changes.push('slug');
   284→          }
   285→        }
   286→
   287→        if (options.tag) {
   288→          const newTags = options.tag.filter((t: string) => !updatedTask.tags.includes(t));
   289→          if (newTags.length > 0) {
   290→            updatedTask.tags = [...updatedTask.tags, ...newTags];
   291→            changes.push('tags');
   292→          }
   293→        }
   294→
   295→        if (options.dependsOn) {
   296→          // Validate all dependency refs
   297→          for (const depRef of options.dependsOn) {
   298→            const depResult = index.resolve(depRef);
   299→            if (!depResult.ok) {
   300→              error(errors.reference.depNotFound(depRef));
   301→              process.exit(3);
   302→            }
   303→          }
   304→          updatedTask.depends_on = options.dependsOn;
   305→          changes.push('depends_on');
   306→        }
   307→
   308→        if (changes.length === 0) {
   309→          warn('No changes specified');
   310→          return;
   311→        }
   312→
   313→        await saveTask(ctx, updatedTask);
   314→        await commitIfShadow(ctx.shadow, 'task-set', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), changes.join(', '));
   315→        success(`Updated task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(', ')})`, { task: updatedTask });
   316→      } catch (err) {
   317→        error(errors.failures.updateTask, err);
   318→        process.exit(1);
   319→      }
   320→    });
   321→
   322→  // kspec task patch <ref>
   323→  task
   324→    .command('patch <ref>')
   325→    .description('Update task with JSON data')
   326→    .option('--data <json>', 'JSON object with fields to update')
   327→    .option('--dry-run', 'Show what would change without writing')
   328→    .option('--allow-unknown', 'Allow unknown fields (for extending format)')
   329→    .action(async (ref: string, options) => {
   330→      try {
   331→        const ctx = await initContext();
   332→        const tasks = await loadAllTasks(ctx);
   333→        const items = await loadAllItems(ctx);
   334→
   335→        // Load meta items for validation
   336→        const { loadMetaContext } = await import('../../parser/meta.js');
   337→        const metaContext = await loadMetaContext(ctx);
   338→        const allMetaItems = [
   339→          ...metaContext.agents,
   340→          ...metaContext.workflows,
   341→          ...metaContext.conventions,
   342→          ...metaContext.observations,
   343→        ];
   344→
   345→        const index = new ReferenceIndex(tasks, items, allMetaItems);
   346→        const foundTask = resolveTaskRef(ref, tasks, index);
   347→
   348→        // Get JSON data from --data flag or stdin
   349→        let jsonData: string;
   350→        if (options.data) {
   351→          jsonData = options.data;
   352→        } else {
   353→          // Read from stdin
   354→          const chunks: Buffer[] = [];
   355→          for await (const chunk of process.stdin) {
   356→            chunks.push(chunk);
   357→          }
   358→          jsonData = Buffer.concat(chunks).toString('utf-8');
   359→        }
   360→
   361→        // Parse JSON
   362→        let patchData: Record<string, unknown>;
   363→        try {
   364→          patchData = JSON.parse(jsonData);
   365→        } catch (parseErr) {
   366→          error(errors.validation.invalidJson, parseErr);
   367→          process.exit(1);
   368→        }
   369→
   370→        // Validate against TaskInputSchema (partial)
   371→        const { TaskInputSchema } = await import('../../schema/index.js');
   372→
   373→        // Create a partial schema for validation
   374→        const partialSchema = options.allowUnknown
   375→          ? TaskInputSchema.partial().passthrough()
   376→          : TaskInputSchema.partial().strict();
   377→
   378→        let validatedPatch: Partial<TaskInput>;
   379→        try {
   380→          validatedPatch = partialSchema.parse(patchData);
   381→        } catch (validationErr) {
   382→          error(errors.validation.invalidPatchData(String(validationErr)), validationErr);
   383→          process.exit(1);
   384→        }
   385→
   386→        // Check for unknown fields if strict mode
   387→        if (!options.allowUnknown) {
   388→          const knownFields = Object.keys(TaskInputSchema.shape);
   389→          const providedFields = Object.keys(patchData);
   390→          const unknownFields = providedFields.filter(f => !knownFields.includes(f));
   391→
   392→          if (unknownFields.length > 0) {
   393→            error(errors.validation.unknownFields(unknownFields));
   394→            process.exit(1);
   395→          }
   396→        }
   397→
   398→        // Build updated task
   399→        const updatedTask: Task = { ...foundTask, ...validatedPatch };
   400→
   401→        // Track changes for output
   402→        const changes = Object.keys(validatedPatch);
   403→
   404→        if (options.dryRun) {
   405→          info('Dry run - no changes will be written');
   406→          info(`Would update: ${changes.join(', ')}`);
   407→          output({ changes, updated: updatedTask }, () => {
   408→            console.log(`\nChanges: ${changes.join(', ')}\n`);
   409→            return formatTaskDetails(updatedTask, index);
   410→          });
   411→          return;
   412→        }
   413→
   414→        await saveTask(ctx, updatedTask);
   415→        await commitIfShadow(ctx.shadow, 'task-patch', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), changes.join(', '));
   416→        success(`Patched task: ${index.shortUlid(updatedTask._ulid)} (${changes.join(', ')})`, { task: updatedTask });
   417→      } catch (err) {
   418→        error(errors.failures.patchTask, err);
   419→        process.exit(1);
   420→      }
   421→    });
   422→
   423→  // kspec task start <ref>
   424→  task
   425→    .command('start <ref>')
   426→    .description('Start working on a task (pending -> in_progress)')
   427→    .option('--no-sync', 'Skip syncing spec implementation status')
   428→    .action(async (ref: string, options) => {
   429→      try {
   430→        const ctx = await initContext();
   431→        const tasks = await loadAllTasks(ctx);
   432→        const items = await loadAllItems(ctx);
   433→        const index = new ReferenceIndex(tasks, items);
   434→        const foundTask = resolveTaskRef(ref, tasks, index);
   435→
   436→        if (foundTask.status === 'in_progress') {
   437→          warn('Task is already in progress');
   438→          output(foundTask, () => formatTaskDetails(foundTask));
   439→          return;
   440→        }
   441→
   442→        if (foundTask.status !== 'pending') {
   443→          error(errors.status.cannotStart(foundTask.status));
   444→          process.exit(4); // Exit code 4 = invalid state
   445→        }
   446→
   447→        // Update status
   448→        const updatedTask: Task = {
   449→          ...foundTask,
   450→          status: 'in_progress',
   451→          started_at: new Date().toISOString(),
   452→        };
   453→
   454→        await saveTask(ctx, updatedTask);
   455→        await commitIfShadow(ctx.shadow, 'task-start', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   456→        success(`Started task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   457→
   458→        // Sync spec implementation status (unless --no-sync)
   459→        if (options.sync !== false && foundTask.spec_ref) {
   460→          const updatedTasks = tasks.map(t =>
   461→            t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t
   462→          );
   463→          const syncResult = await syncSpecImplementationStatus(
   464→            ctx,
   465→            updatedTask as LoadedTask,
   466→            updatedTasks as LoadedTask[],
   467→            items,
   468→            index
   469→          );
   470→          if (syncResult) {
   471→            info(`Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`);
   472→          }
   473→        }
   474→      } catch (err) {
   475→        error(errors.failures.startTask, err);
   476→        process.exit(1);
   477→      }
   478→    });
   479→
   480→  // kspec task complete <ref>
   481→  task
   482→    .command('complete <ref>')
   483→    .description('Complete a task (in_progress -> completed)')
   484→    .option('--reason <reason>', 'Completion reason/notes')
   485→    .option('--no-sync', 'Skip syncing spec implementation status')
   486→    .action(async (ref: string, options) => {
   487→      try {
   488→        const ctx = await initContext();
   489→        const tasks = await loadAllTasks(ctx);
   490→        const items = await loadAllItems(ctx);
   491→        const index = new ReferenceIndex(tasks, items);
   492→        const foundTask = resolveTaskRef(ref, tasks, index);
   493→
   494→        if (foundTask.status === 'completed') {
   495→          warn('Task is already completed');
   496→          output(foundTask, () => formatTaskDetails(foundTask));
   497→          return;
   498→        }
   499→
   500→        if (foundTask.status !== 'in_progress' && foundTask.status !== 'pending') {
   501→          error(errors.status.cannotComplete(foundTask.status));
   502→          process.exit(4);
   503→        }
   504→
   505→        const now = new Date().toISOString();
   506→
   507→        // Update status
   508→        const updatedTask: Task = {
   509→          ...foundTask,
   510→          status: 'completed',
   511→          completed_at: now,
   512→          closed_reason: options.reason || null,
   513→          started_at: foundTask.started_at || now, // Set started_at if not already
   514→        };
   515→
   516→        await saveTask(ctx, updatedTask);
   517→        await commitIfShadow(ctx.shadow, 'task-complete', foundTask.slugs[0] || index.shortUlid(foundTask._ulid), options.reason);
   518→        success(`Completed task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   519→
   520→        // Output commit guidance (suppressed in JSON mode)
   521→        if (!isJsonMode()) {
   522→          const guidance = formatCommitGuidance(updatedTask);
   523→          printCommitGuidance(guidance);
   524→        }
   525→
   526→        // Sync spec implementation status (unless --no-sync)
   527→        if (options.sync !== false && foundTask.spec_ref) {
   528→          // Update task list to reflect the change we just made
   529→          const updatedTasks = tasks.map(t =>
   530→            t._ulid === updatedTask._ulid ? { ...t, ...updatedTask } : t
   531→          );
   532→          const syncResult = await syncSpecImplementationStatus(
   533→            ctx,
   534→            updatedTask as LoadedTask,
   535→            updatedTasks as LoadedTask[],
   536→            items,
   537→            index
   538→          );
   539→          if (syncResult) {
   540→            info(`Synced spec "${syncResult.specTitle}" implementation: ${syncResult.previousStatus} -> ${syncResult.newStatus}`);
   541→          }
   542→        }
   543→
   544→        // AC: @task-completion-guardrails ac-2
   545→        // Show reminder about acceptance criteria if spec has them
   546→        // AC: @task-completion-guardrails ac-3
   547→        // Only show for tasks with spec_ref (skipped for non-spec tasks)
   548→        if (foundTask.spec_ref && !isJsonMode()) {
   549→          const specResult = index.resolve(foundTask.spec_ref);
   550→          if (specResult.ok && specResult.item) {
   551→            const specItem = items.find(i => i._ulid === specResult.ulid);
   552→            if (specItem && specItem.acceptance_criteria && specItem.acceptance_criteria.length > 0) {
   553→              const count = specItem.acceptance_criteria.length;
   554→              console.log(`\n⚠ Linked spec ${foundTask.spec_ref} has ${count} acceptance criteri${count === 1 ? 'on' : 'a'} - verify they are covered\n`);
   555→            }
   556→          }
   557→        }
   558→      } catch (err) {
   559→        error(errors.failures.completeTask, err);
   560→        process.exit(1);
   561→      }
   562→    });
   563→
   564→  // kspec task block <ref>
   565→  task
   566→    .command('block <ref>')
   567→    .description('Block a task')
   568→    .requiredOption('--reason <reason>', 'Reason for blocking')
   569→    .action(async (ref: string, options) => {
   570→      try {
   571→        const ctx = await initContext();
   572→        const tasks = await loadAllTasks(ctx);
   573→        const items = await loadAllItems(ctx);
   574→        const index = new ReferenceIndex(tasks, items);
   575→        const foundTask = resolveTaskRef(ref, tasks, index);
   576→
   577→        if (foundTask.status === 'completed' || foundTask.status === 'cancelled') {
   578→          error(errors.status.cannotBlock(foundTask.status));
   579→          process.exit(4);
   580→        }
   581→
   582→        const updatedTask: Task = {
   583→          ...foundTask,
   584→          status: 'blocked',
   585→          blocked_by: [...foundTask.blocked_by, options.reason],
   586→        };
   587→
   588→        await saveTask(ctx, updatedTask);
   589→        await commitIfShadow(ctx.shadow, 'task-block', foundTask.slugs[0] || index.shortUlid(foundTask._ulid));
   590→        success(`Blocked task: ${index.shortUlid(updatedTask._ulid)}`, { task: updatedTask });
   591→      } catch (err) {
   592→        error(errors.failures.blockTask, err);
   593→        process.exit(1);
   594→      }
   595→    });
   596→
   597→  // kspec task unblock <ref>
   598→  task
   599→    .command('unblock <ref>')
