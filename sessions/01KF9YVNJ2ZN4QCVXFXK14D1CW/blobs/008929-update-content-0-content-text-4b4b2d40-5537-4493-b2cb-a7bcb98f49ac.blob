   634→    .action(async (ref: string, options) => {
   635→      try {
   636→        const ctx = await initContext();
   637→        const tasks = await loadAllTasks(ctx);
   638→        const items = await loadAllItems(ctx);
   639→        const index = new ReferenceIndex(tasks, items);
   640→        const foundTask = resolveTaskRef(ref, tasks, index);
   641→
   642→        if (foundTask.status === 'completed' || foundTask.status === 'cancelled') {
