   748→
   749→          // Check if linked spec has acceptance criteria and remind about test coverage
   750→          const specResult = index.resolve(foundTask.spec_ref);
   751→          if (specResult.ok && specResult.item) {
   752→            const specItem = specResult.item as { acceptance_criteria?: unknown[] };
   753→            if (specItem.acceptance_criteria && specItem.acceptance_criteria.length > 0) {
   754→              console.log('');
   755→              console.log(alignmentCheck.testCoverage(specItem.acceptance_criteria.length));
