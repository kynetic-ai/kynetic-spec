```
     1→import { Command } from 'commander';
     2→import {
     3→  initContext,
     4→  loadAllTasks,
     5→  loadAllItems,
     6→  saveTask,
     7→  createTask,
     8→  ReferenceIndex,
     9→  AlignmentIndex,
    10→  type LoadedTask,
    11→  type LoadedSpecItem,
    12→  type KspecContext,
    13→} from '../../parser/index.js';
    14→import { commitIfShadow } from '../../parser/shadow.js';
    15→import { output, success, error, warn, info, isJsonMode } from '../output.js';
    16→import type { TaskInput } from '../../schema/index.js';
    17→import { errors } from '../../strings/index.js';
    18→
    19→/**
    20→ * Fields that contain nested spec items (mirrors yaml.ts)
    21→ */
    22→const NESTED_ITEM_FIELDS = ['modules', 'features', 'requirements', 'constraints', 'decisions'];
    23→
    24→/**
    25→ * Get the parent path from a child's _path.
    26→ * e.g., "features[0].requirements[1]" -> "features[0]"
    27→ * Returns empty string for top-level items.
    28→ */
    29→function getParentPath(childPath: string | undefined): string {
    30→  if (!childPath) return '';
    31→  const lastDotIndex = childPath.lastIndexOf('.');
    32→  if (lastDotIndex === -1) return '';
    33→  return childPath.slice(0, lastDotIndex);
    34→}
    35→
    36→/**
    37→ * Check if an item is a direct child of another item based on _path.
    38→ * Direct children have a path that extends the parent's path by exactly one field[index].
    39→ */
    40→function isDirectChildOf(child: LoadedSpecItem, parent: LoadedSpecItem): boolean {
    41→  const childPath = child._path || '';
    42→  const parentPath = parent._path || '';
    43→
    44→  // If paths are equal, not a child
    45→  if (childPath === parentPath) return false;
    46→
    47→  // Child path must start with parent path
    48→  if (parentPath && !childPath.startsWith(parentPath + '.')) return false;
    49→
    50→  // For root parent (empty path), child must be a top-level path like "features[0]"
    51→  if (!parentPath) {
    52→    // Direct child of root has no '.' in its path
    53→    return !childPath.includes('.');
    54→  }
    55→
    56→  // Get the remaining path after parent
    57→  const remaining = childPath.slice(parentPath.length + 1);
    58→
    59→  // Direct child has no additional '.' (e.g., "requirements[0]" not "requirements[0].something")
    60→  return !remaining.includes('.');
    61→}
    62→
    63→/**
    64→ * Find the parent spec item of a given item.
    65→ * Returns undefined for root-level items.
    66→ */
    67→function findParentItem(
    68→  item: LoadedSpecItem,
    69→  allItems: LoadedSpecItem[]
    70→): LoadedSpecItem | undefined {
    71→  const parentPath = getParentPath(item._path);
    72→
    73→  // Root-level item or no path
    74→  if (!parentPath && !item._path) return undefined;
    75→  if (!parentPath) return undefined;
    76→
    77→  // Find item with matching path in the same source file
    78→  return allItems.find(
    79→    i => i._path === parentPath && i._sourceFile === item._sourceFile
    80→  );
    81→}
    82→
    83→/**
    84→ * Get direct children of a spec item.
    85→ * Only returns immediate children, not grandchildren.
    86→ */
    87→function getDirectChildren(
    88→  parent: LoadedSpecItem,
    89→  allItems: LoadedSpecItem[]
    90→): LoadedSpecItem[] {
    91→  return allItems.filter(
    92→    item => item._sourceFile === parent._sourceFile && isDirectChildOf(item, parent)
    93→  );
    94→}
    95→
    96→/**
    97→ * Collect an item and all its descendants in topological order (parent first).
    98→ * This ensures parent tasks are created before child tasks.
    99→ */
   100→function collectItemsRecursively(
   101→  root: LoadedSpecItem,
   102→  allItems: LoadedSpecItem[]
   103→): LoadedSpecItem[] {
   104→  const result: LoadedSpecItem[] = [root];
   105→  const children = getDirectChildren(root, allItems);
   106→
   107→  for (const child of children) {
   108→    const descendants = collectItemsRecursively(child, allItems);
   109→    result.push(...descendants);
   110→  }
   111→
   112→  return result;
   113→}
   114→
   115→/**
   116→ * Resolve a spec item reference.
   117→ * Returns the spec item or exits with error.
   118→ */
   119→function resolveSpecRef(
   120→  ref: string,
   121→  items: LoadedSpecItem[],
   122→  tasks: LoadedTask[],
   123→  index: ReferenceIndex
   124→): LoadedSpecItem {
   125→  const result = index.resolve(ref);
   126→
   127→  if (!result.ok) {
   128→    switch (result.error) {
   129→      case 'not_found':
   130→        error(errors.reference.specNotFound(ref));
   131→        break;
   132→      case 'ambiguous':
   133→        error(errors.reference.ambiguous(ref));
   134→        for (const candidate of result.candidates) {
   135→          const item = items.find(i => i._ulid === candidate);
   136→          const slug = item?.slugs[0] || '';
   137→          console.error(`  - ${index.shortUlid(candidate)} ${slug ? `(${slug})` : ''}`);
   138→        }
   139→        break;
   140→      case 'duplicate_slug':
   141→        error(errors.reference.slugMapsToMultiple(ref));
   142→        for (const candidate of result.candidates) {
   143→          console.error(`  - ${index.shortUlid(candidate)}`);
   144→        }
   145→        break;
   146→    }
   147→    process.exit(3);
   148→  }
   149→
   150→  // Check if it's actually a spec item (not a task)
   151→  const item = items.find(i => i._ulid === result.ulid);
   152→  if (!item) {
   153→    // Check if it's a task
   154→    const task = tasks.find(t => t._ulid === result.ulid);
   155→    if (task) {
   156→      error(errors.reference.notSpecItem(ref));
   157→    } else {
   158→      error(errors.reference.specNotFound(ref));
   159→    }
   160→    process.exit(3);
   161→  }
   162→
   163→  return item;
   164→}
   165→
   166→/**
   167→ * Generate a slug from a spec item title.
   168→ * Converts "My Feature Title" -> "task-my-feature-title"
   169→ */
   170→function generateSlugFromTitle(title: string): string {
   171→  return (
   172→    'task-' +
   173→    title
   174→      .toLowerCase()
   175→      .replace(/[^a-z0-9]+/g, '-')
   176→      .replace(/^-|-$/g, '')
   177→      .slice(0, 50)
   178→  );
   179→}
   180→
   181→/**
   182→ * Convert spec priority to task priority (number).
   183→ * Spec can use 'high', 'medium', 'low' or numeric 1-5.
   184→ */
   185→function normalizePriority(priority: string | number | undefined): number {
   186→  if (priority === undefined) return 3;
   187→  if (typeof priority === 'number') return priority;
   188→  switch (priority) {
   189→    case 'high':
   190→      return 1;
   191→    case 'medium':
   192→      return 3;
   193→    case 'low':
   194→      return 5;
   195→    default:
   196→      return 3;
   197→  }
   198→}
   199→
   200→/**
   201→ * Result of deriving a task from a spec item
   202→ */
   203→interface DeriveResult {
   204→  specItem: LoadedSpecItem;
   205→  action: 'created' | 'skipped' | 'would_create';
   206→  task?: LoadedTask;
   207→  reason?: string;
   208→  /** Task ref that was used for depends_on (if any) */
   209→  dependsOn?: string[];
   210→}
   211→
   212→/**
   213→ * Derive a task from a spec item.
   214→ * Returns result describing what happened.
   215→ *
   216→ * @param dependsOn - Task references to add as dependencies (for hierarchy-based deps)
   217→ */
   218→async function deriveTaskFromSpec(
   219→  ctx: KspecContext,
   220→  specItem: LoadedSpecItem,
   221→  existingTasks: LoadedTask[],
   222→  items: LoadedSpecItem[],
   223→  index: ReferenceIndex,
   224→  alignmentIndex: AlignmentIndex,
   225→  options: { force: boolean; dryRun: boolean; dependsOn?: string[] }
   226→): Promise<DeriveResult> {
   227→  // Check if a task already exists for this spec
   228→  const linkedTasks = alignmentIndex.getTasksForSpec(specItem._ulid);
   229→
   230→  if (linkedTasks.length > 0 && !options.force) {
   231→    const taskRef = linkedTasks[0].slugs[0]
   232→      ? `@${linkedTasks[0].slugs[0]}`
   233→      : `@${index.shortUlid(linkedTasks[0]._ulid)}`;
   234→    return {
   235→      specItem,
   236→      action: 'skipped',
   237→      task: linkedTasks[0],
   238→      reason: `task exists: ${taskRef}`,
   239→    };
   240→  }
   241→
   242→  // Check if slug would collide with existing task
   243→  const baseSlug = generateSlugFromTitle(specItem.title);
   244→  let slug = baseSlug;
   245→  let slugSuffix = 1;
   246→
   247→  // Find unique slug if needed
   248→  while (existingTasks.some(t => t.slugs.includes(slug))) {
   249→    slug = `${baseSlug}-${slugSuffix}`;
   250→    slugSuffix++;
   251→  }
   252→
   253→  // Build task input with depends_on
   254→  const taskInput: TaskInput = {
   255→    title: `Implement: ${specItem.title}`,
   256→    type: 'task',
   257→    spec_ref: `@${specItem.slugs[0] || specItem._ulid}`,
   258→    derivation: 'auto',
   259→    priority: normalizePriority(specItem.priority),
   260→    slugs: [slug],
   261→    tags: [...(specItem.tags || [])],
   262→    depends_on: options.dependsOn || [],
   263→  };
   264→
   265→  // Dry run - don't actually create
   266→  if (options.dryRun) {
   267→    const previewTask = createTask(taskInput) as LoadedTask;
   268→    return {
   269→      specItem,
   270→      action: 'would_create',
   271→      task: previewTask,
   272→      dependsOn: options.dependsOn,
   273→    };
   274→  }
   275→
   276→  // Create and save the task
   277→  const newTask = createTask(taskInput);
   278→  await saveTask(ctx, newTask);
   279→  const specSlug = specItem.slugs[0] || specItem._ulid.slice(0, 8);
   280→  await commitIfShadow(ctx.shadow, 'derive', specSlug);
   281→
   282→  // Add to existing tasks list for slug collision checks
   283→  existingTasks.push(newTask as LoadedTask);
   284→
   285→  return {
   286→    specItem,
   287→    action: 'created',
   288→    task: newTask as LoadedTask,
   289→    dependsOn: options.dependsOn,
   290→  };
   291→}
   292→
   293→/**
   294→ * Get a task reference string for use in depends_on.
   295→ * Prefers slug over ULID for readability.
   296→ */
   297→function getTaskRef(task: LoadedTask, index: ReferenceIndex): string {
   298→  return task.slugs[0] ? `@${task.slugs[0]}` : `@${index.shortUlid(task._ulid)}`;
   299→}
   300→
   301→/**
   302→ * Find or get the task for a parent spec item.
   303→ * Looks in:
   304→ * 1. Tasks created in this derive session (specToTaskMap)
   305→ * 2. Existing tasks linked to the parent spec (alignmentIndex)
   306→ */
   307→function getParentTaskRef(
   308→  parentSpec: LoadedSpecItem,
   309→  specToTaskMap: Map<string, LoadedTask>,
   310→  alignmentIndex: AlignmentIndex,
   311→  index: ReferenceIndex
   312→): string | undefined {
   313→  // Check if we created a task for this parent in this session
   314→  const sessionTask = specToTaskMap.get(parentSpec._ulid);
   315→  if (sessionTask) {
   316→    return getTaskRef(sessionTask, index);
   317→  }
   318→
   319→  // Check if an existing task is linked to this parent spec
   320→  const linkedTasks = alignmentIndex.getTasksForSpec(parentSpec._ulid);
   321→  if (linkedTasks.length > 0) {
   322→    return getTaskRef(linkedTasks[0], index);
   323→  }
   324→
   325→  return undefined;
   326→}
   327→
   328→/**
   329→ * Register the 'derive' command
   330→ */
   331→export function registerDeriveCommand(program: Command): void {
   332→  program
   333→    .command('derive [ref]')
   334→    .description('Create task(s) from spec item(s)')
   335→    .option('--all', 'Derive tasks for all spec items without linked tasks')
   336→    .option('--flat', 'Only derive for the specified item, not children (default: recursive)')
   337→    .option('--force', 'Create task even if one already exists for the spec')
   338→    .option('--dry-run', 'Show what would be created without making changes')
   339→    .action(async (ref: string | undefined, options) => {
   340→      try {
   341→        // Validate arguments
   342→        if (!ref && !options.all) {
   343→          error(errors.usage.deriveNoRef);
   344→          console.error('Usage:');
   345→          console.error('  kspec derive @spec-ref');
   346→          console.error('  kspec derive @spec-ref --flat');
   347→          console.error('  kspec derive --all');
   348→          process.exit(2);
   349→        }
   350→
   351→        if (ref && options.all) {
   352→          error(errors.usage.deriveRefAndAll);
   353→          process.exit(2);
   354→        }
   355→
   356→        const ctx = await initContext();
   357→        const tasks = await loadAllTasks(ctx);
   358→        const items = await loadAllItems(ctx);
   359→        const index = new ReferenceIndex(tasks, items);
   360→
   361→        // Build alignment index
   362→        const alignmentIndex = new AlignmentIndex(tasks, items);
   363→        alignmentIndex.buildLinks(index);
   364→
   365→        // Collect spec items to process
   366→        let specsToDerive: LoadedSpecItem[];
   367→
   368→        if (options.all) {
   369→          // Get all spec items without linked tasks
   370→          specsToDerive = items.filter(item => {
   371→            const linkedTasks = alignmentIndex.getTasksForSpec(item._ulid);
   372→            return linkedTasks.length === 0 || options.force;
   373→          });
   374→
   375→          if (specsToDerive.length === 0) {
   376→            if (isJsonMode()) {
   377→              console.log(JSON.stringify([]));
   378→            } else {
   379→              info('Nothing to derive (all items have tasks)');
   380→            }
   381→            return;
   382→          }
   383→        } else {
   384→          // Single spec item - recursive by default, flat if --flat
   385→          const specItem = resolveSpecRef(ref!, items, tasks, index);
   386→
   387→          if (options.flat) {
   388→            specsToDerive = [specItem];
   389→          } else {
   390→            // Recursive: collect item and all descendants
   391→            specsToDerive = collectItemsRecursively(specItem, items);
   392→          }
   393→        }
   394→
   395→        // Track spec ULID -> created task for dependency resolution
   396→        const specToTaskMap = new Map<string, LoadedTask>();
   397→
   398→        // Process each spec item in order (parents before children due to topological sort)
   399→        const results: DeriveResult[] = [];
   400→
   401→        for (const specItem of specsToDerive) {
   402→          // Determine depends_on based on parent spec's task
   403→          let dependsOn: string[] | undefined;
   404→
   405→          if (!options.flat && !options.all) {
   406→            // Find the parent spec item
   407→            const parentSpec = findParentItem(specItem, items);
   408→
   409→            if (parentSpec) {
   410→              const parentTaskRef = getParentTaskRef(
   411→                parentSpec,
   412→                specToTaskMap,
   413→                alignmentIndex,
   414→                index
   415→              );
   416→              if (parentTaskRef) {
   417→                dependsOn = [parentTaskRef];
   418→              }
   419→            }
   420→          }
   421→
   422→          const result = await deriveTaskFromSpec(
   423→            ctx,
   424→            specItem,
   425→            tasks,
   426→            items,
   427→            index,
   428→            alignmentIndex,
   429→            {
   430→              force: options.force || false,
   431→              dryRun: options.dryRun || false,
   432→              dependsOn,
   433→            }
   434→          );
   435→
   436→          // Track created/would_create tasks for dependency resolution
   437→          if (result.task && (result.action === 'created' || result.action === 'would_create')) {
   438→            specToTaskMap.set(specItem._ulid, result.task);
   439→          }
   440→          // Also track skipped tasks (existing) for dependency resolution
   441→          if (result.action === 'skipped' && result.task) {
   442→            specToTaskMap.set(specItem._ulid, result.task);
   443→          }
   444→
   445→          results.push(result);
   446→        }
   447→
   448→        // Output results
   449→        if (isJsonMode()) {
   450→          // JSON output format - simplified per AC
   451→          const jsonOutput = results.map(r => ({
   452→            ulid: r.task?._ulid || null,
   453→            slug: r.task?.slugs[0] || null,
   454→            spec_ref: `@${r.specItem.slugs[0] || r.specItem._ulid}`,
   455→            depends_on: r.task?.depends_on || [],
   456→            action: r.action,
   457→          }));
   458→          console.log(JSON.stringify(jsonOutput, null, 2));
   459→          return; // Don't call output() which would output full results in global JSON mode
   460→        } else {
   461→          // Human-readable output
   462→          output(results, () => {
   463→            const created = results.filter(r => r.action === 'created');
   464→            const skipped = results.filter(r => r.action === 'skipped');
   465→            const wouldCreate = results.filter(r => r.action === 'would_create');
   466→
   467→            if (options.dryRun) {
   468→              console.log('Would create:');
   469→              for (const r of wouldCreate) {
   470→                const taskSlug = r.task?.slugs[0] || '';
   471→                const deps = r.dependsOn?.length ? ` (depends: ${r.dependsOn.join(', ')})` : '';
   472→                console.log(`  + ${r.specItem.title}`);
   473→                console.log(`    -> ${taskSlug}${deps}`);
   474→              }
   475→              if (skipped.length > 0) {
   476→                console.log('\nSkipped:');
   477→                for (const r of skipped) {
   478→                  const specRef = r.specItem.slugs[0] ? `@${r.specItem.slugs[0]}` : `@${index.shortUlid(r.specItem._ulid)}`;
   479→                  console.log(`  - ${specRef} (${r.reason})`);
   480→                }
   481→              }
   482→              console.log(`\nWould create ${wouldCreate.length} task(s)`);
   483→              if (skipped.length > 0) {
   484→                console.log(`Skipped ${skipped.length} (already have tasks)`);
   485→              }
   486→              return;
   487→            }
   488→
   489→            if (created.length > 0) {
   490→              for (const r of created) {
   491→                const taskSlug = r.task?.slugs[0] || '';
   492→                const deps = r.dependsOn?.length ? ` (depends: ${r.dependsOn.join(', ')})` : '';
   493→                console.log(`OK Created task: ${taskSlug}${deps}`);
   494→              }
   495→            }
   496→
   497→            if (skipped.length > 0 && !options.all) {
   498→              // Show skipped for explicit derive (not --all)
   499→              for (const r of skipped) {
   500→                const specRef = r.specItem.slugs[0] ? `@${r.specItem.slugs[0]}` : `@${index.shortUlid(r.specItem._ulid)}`;
   501→                console.log(`Skipped ${specRef} (${r.reason})`);
   502→              }
   503→            }
   504→
   505→            // Summary
   506→            if (created.length > 0 || skipped.length > 0) {
   507→              console.log('');
   508→              if (created.length > 0) {
   509→                console.log(`Created ${created.length} task(s)`);
   510→              }
   511→              if (skipped.length > 0) {
   512→                console.log(`Skipped ${skipped.length} (already have tasks)`);
   513→              }
   514→            }
   515→          });
   516→        }
   517→      } catch (err) {
   518→        error(errors.failures.deriveTasks, err);
   519→        process.exit(1);
   520→      }
   521→    });
   522→}
   523→

