```
     1→/**
     2→ * Ralph command - automated task loop via ACP.
     3→ *
     4→ * Runs an ACP-compliant agent in a loop to process tasks autonomously.
     5→ * Uses session event storage for full audit trail and streaming output.
     6→ */
     7→
     8→import { Command } from 'commander';
     9→import chalk from 'chalk';
    10→import { ulid } from 'ulid';
    11→import * as fs from 'node:fs/promises';
    12→import * as path from 'node:path';
    13→import { spawn } from 'node:child_process';
    14→import { initContext } from '../../parser/index.js';
    15→import { error, info, success } from '../output.js';
    16→import { gatherSessionContext, type SessionContext } from './session.js';
    17→import { resolveAdapter, registerAdapter, type AgentAdapter } from '../../agents/index.js';
    18→import { spawnAndInitialize, type SpawnedAgent } from '../../agents/spawner.js';
    19→import type { SessionUpdate } from '../../acp/index.js';
    20→import type { ACPClient } from '../../acp/client.js';
    21→import {
    22→  createSession,
    23→  updateSessionStatus,
    24→  appendEvent,
    25→} from '../../sessions/index.js';
    26→import { createTranslator, createCliRenderer } from '../../ralph/index.js';
    27→import { errors } from '../../strings/index.js';
    28→
    29→// ─── Prompt Template ─────────────────────────────────────────────────────────
    30→
    31→function buildPrompt(
    32→  sessionCtx: SessionContext,
    33→  iteration: number,
    34→  maxLoops: number,
    35→  focus?: string
    36→): string {
    37→  const isFinal = iteration === maxLoops;
    38→
    39→  const focusSection = focus ? `
    40→## Session Focus (applies to ALL iterations)
    41→
    42→> **${focus}**
    43→
    44→Keep this focus in mind throughout your work. It takes priority over default task selection.
    45→` : '';
    46→
    47→  return `# Kspec Automation Session
    48→
    49→You are running as part of a kspec automation loop. This is iteration ${iteration} of ${maxLoops}.
    50→${focusSection}
    51→
    52→## Current State
    53→\`\`\`json
    54→${JSON.stringify(sessionCtx, null, 2)}
    55→\`\`\`
    56→
    57→## Working Procedure
    58→
    59→1. **Pick a task**: Review ready_tasks above. Pick the highest priority task (lowest number = higher priority). If there's an active (in_progress) task, continue that instead.
    60→
    61→2. **Start the task** (if not already in_progress):
    62→   \`\`\`bash
    63→   kspec task start @task-ref
    64→   \`\`\`
    65→
    66→3. **Do the work**:
    67→   - Read relevant files to understand the task
    68→   - Make changes as needed
    69→   - Run tests if applicable
    70→   - Document as you go with task notes
    71→
    72→4. **Document progress**:
    73→   \`\`\`bash
    74→   kspec task note @task-ref "What you did, decisions made, etc."
    75→   \`\`\`
    76→
    77→5. **Complete or checkpoint**:
    78→   - If task is DONE:
    79→     \`\`\`bash
    80→     kspec task complete @task-ref --reason "Summary of completion"
    81→     \`\`\`
    82→   - If task is NOT done (WIP):
    83→     \`\`\`bash
    84→     kspec task note @task-ref "WIP: What's done, what remains..."
    85→     \`\`\`
    86→
    87→6. **Commit your work**:
    88→   \`\`\`bash
    89→   git add -A && git commit -m "feat/fix/chore: description
    90→
    91→   Task: @task-ref"
    92→   \`\`\`
    93→
    94→7. **Reflect on this iteration**:
    95→   Think about what you learned, any friction points, or patterns worth remembering.
    96→
    97→   For **systemic patterns** (friction or success worth documenting):
    98→   \`\`\`bash
    99→   kspec meta observe friction "Description of systemic issue..."
   100→   kspec meta observe success "Pattern worth replicating..."
   101→   \`\`\`
   102→
   103→   For **actionable improvements** (specific ideas that could become tasks):
   104→   \`\`\`bash
   105→   kspec inbox add "Improvement idea..." --tag reflection
   106→   \`\`\`
   107→
   108→## Important Notes
   109→- Stay focused on ONE task per iteration
   110→- The loop continues automatically - don't worry about picking the next task
   111→- kspec tracks state across iterations via task status and notes
   112→- Always commit before the iteration ends
   113→- Always reflect and capture at least one observation
   114→${isFinal ? `
   115→## FINAL ITERATION
   116→This is the last iteration of the loop. After completing your work:
   117→1. Commit any remaining changes
   118→2. Reflect on the overall session
   119→3. Capture any final insights as observations
   120→` : ''}`;
   121→}
   122→
   123→// ─── Streaming Output ────────────────────────────────────────────────────────
   124→
   125→// Translator and renderer are created per-session in the action handler.
   126→// This allows the architecture to be reused by future TUI renderers.
   127→
   128→// ─── Tool Request Handler ────────────────────────────────────────────────────
   129→
   130→/**
   131→ * Handle tool requests from ACP agent.
   132→ * Implements file operations, terminal commands, and permission handling.
   133→ */
   134→async function handleRequest(
   135→  client: ACPClient,
   136→  id: string | number,
   137→  method: string,
   138→  params: unknown,
   139→  yolo: boolean
   140→): Promise<void> {
   141→  const p = params as Record<string, unknown>;
   142→
   143→  try {
   144→    switch (method) {
   145→      case 'session/request_permission': {
   146→        // In yolo mode, auto-approve all permissions
   147→        // In normal mode, would need to implement permission UI
   148→        const options = (p.options as Array<{ optionId: string; kind: string; name: string }>) || [];
   149→
   150→        if (yolo) {
   151→          // Find an "allow" option (prefer allow_always, then allow_once)
   152→          const allowOption = options.find(o => o.kind === 'allow_always')
   153→            || options.find(o => o.kind === 'allow_once');
   154→
   155→          if (allowOption) {
   156→            client.respondPermission(id, {
   157→              outcome: { outcome: 'selected', optionId: allowOption.optionId },
   158→            });
   159→          } else {
   160→            // No allow option available - cancel
   161→            client.respondPermission(id, { outcome: { outcome: 'cancelled' } });
   162→          }
   163→        } else {
   164→          // TODO: Implement permission prompting
   165→          client.respondPermission(id, { outcome: { outcome: 'cancelled' } });
   166→        }
   167→        break;
   168→      }
   169→
   170→      case 'file/read': {
   171→        const filePath = p.path as string;
   172→        const content = await fs.readFile(filePath, 'utf-8');
   173→        client.respond(id, { content });
   174→        break;
   175→      }
   176→
   177→      case 'file/write': {
   178→        const filePath = p.path as string;
   179→        const content = p.content as string;
   180→        await fs.mkdir(path.dirname(filePath), { recursive: true });
   181→        await fs.writeFile(filePath, content, 'utf-8');
   182→        client.respond(id, {});
   183→        break;
   184→      }
   185→
   186→      case 'terminal/run': {
   187→        const command = p.command as string;
   188→        const cwd = (p.cwd as string) || process.cwd();
   189→        const timeout = (p.timeout as number) || 60000;
   190→
   191→        const result = await new Promise<{ stdout: string; stderr: string; exitCode: number }>((resolve) => {
   192→          const child = spawn(command, [], {
   193→            cwd,
   194→            shell: true,
   195→            timeout,
   196→          });
   197→
   198→          let stdout = '';
   199→          let stderr = '';
   200→
   201→          child.stdout?.on('data', (data) => {
   202→            stdout += data.toString();
   203→          });
   204→
   205→          child.stderr?.on('data', (data) => {
   206→            stderr += data.toString();
   207→          });
   208→
   209→          child.on('close', (code) => {
   210→            resolve({ stdout, stderr, exitCode: code ?? 1 });
   211→          });
   212→
   213→          child.on('error', (err) => {
   214→            resolve({ stdout, stderr: err.message, exitCode: 1 });
   215→          });
   216→        });
   217→
   218→        client.respond(id, result);
   219→        break;
   220→      }
   221→
   222→      default:
   223→        // Unknown method - return error
   224→        client.respondError(id, -32601, `Method not found: ${method}`);
   225→    }
   226→  } catch (err) {
   227→    const message = err instanceof Error ? err.message : String(err);
   228→    client.respondError(id, -32000, message);
   229→  }
   230→}
   231→
   232→// ─── Command Registration ────────────────────────────────────────────────────
   233→
   234→export function registerRalphCommand(program: Command): void {
   235→  program
   236→    .command('ralph')
   237→    .description('Run ACP agent in a loop to process ready tasks')
   238→    .option('--max-loops <n>', 'Maximum iterations', '5')
   239→    .option('--max-retries <n>', 'Max retries per iteration on error', '3')
   240→    .option('--max-failures <n>', 'Max consecutive failed iterations before exit', '3')
   241→    .option('--dry-run', 'Show prompt without executing')
   242→    .option('--yolo', 'Use dangerously-skip-permissions (default)', true)
   243→    .option('--no-yolo', 'Require normal permission prompts')
   244→    .option('--adapter <id>', 'Agent adapter to use', 'claude-code-acp')
   245→    .option('--adapter-cmd <cmd>', 'Custom adapter command (for testing)')
   246→    .option('--focus <instructions>', 'Focus instructions included in every iteration prompt')
   247→    .action(async (options) => {
   248→      try {
   249→        const maxLoops = parseInt(options.maxLoops, 10);
   250→        const maxRetries = parseInt(options.maxRetries, 10);
   251→        const maxFailures = parseInt(options.maxFailures, 10);
   252→
   253→        if (isNaN(maxLoops) || maxLoops < 1) {
   254→          error(errors.usage.maxLoopsPositive);
   255→          process.exit(1);
   256→        }
   257→
   258→        if (isNaN(maxRetries) || maxRetries < 0) {
   259→          error(errors.usage.maxRetriesNonNegative);
   260→          process.exit(1);
   261→        }
   262→
   263→        if (isNaN(maxFailures) || maxFailures < 1) {
   264→          error(errors.usage.maxFailuresPositive);
   265→          process.exit(1);
   266→        }
   267→
   268→        // Handle custom adapter command for testing
   269→        if (options.adapterCmd) {
   270→          const parts = options.adapterCmd.split(/\s+/);
   271→          const customAdapter: AgentAdapter = {
   272→            command: parts[0],
   273→            args: parts.slice(1),
   274→            description: 'Custom adapter via --adapter-cmd',
   275→          };
   276→          registerAdapter('custom', customAdapter);
   277→          options.adapter = 'custom';
   278→        }
   279→
   280→        // Resolve adapter
   281→        const adapter = resolveAdapter(options.adapter);
   282→
   283→        // Add yolo flag to adapter args if needed
   284→        if (options.yolo && options.adapter === 'claude-code-acp') {
   285→          adapter.args = [...adapter.args, '--dangerously-skip-permissions'];
   286→        }
   287→
   288→        info(`Starting ralph loop (adapter=${options.adapter}, max ${maxLoops} iterations, ${maxRetries} retries, ${maxFailures} max failures)`);
   289→        if (options.focus) {
   290→          info(`Focus: ${options.focus}`);
   291→        }
   292→
   293→        // Initialize kspec context
   294→        const ctx = await initContext();
   295→        const specDir = ctx.specDir;
   296→
   297→        // Create session for event tracking
   298→        const sessionId = ulid();
   299→        await createSession(specDir, {
   300→          id: sessionId,
   301→          agent_type: options.adapter,
   302→          task_id: undefined, // Will be determined per iteration
   303→        });
   304→
   305→        // Log session start
   306→        await appendEvent(specDir, {
   307→          session_id: sessionId,
   308→          type: 'session.start',
   309→          data: {
   310→            adapter: options.adapter,
   311→            maxLoops,
   312→            maxRetries,
   313→            maxFailures,
   314→            yolo: options.yolo,
   315→            focus: options.focus,
   316→          },
   317→        });
   318→
   319→        let consecutiveFailures = 0;
   320→        let agent: SpawnedAgent | null = null;
   321→        let acpSessionId: string | null = null;
   322→
   323→        // Create translator and renderer for this session
   324→        const translator = createTranslator();
   325→        const renderer = createCliRenderer();
   326→
   327→        try {
   328→          for (let iteration = 1; iteration <= maxLoops; iteration++) {
   329→            renderer.newSection?.(`Iteration ${iteration}/${maxLoops}`);
   330→
   331→            // Gather fresh context each iteration
   332→            const sessionCtx = await gatherSessionContext(ctx, { limit: '10' });
   333→
   334→            // Check for ready tasks or active tasks
   335→            const hasActiveTasks = sessionCtx.active_tasks.length > 0;
   336→            const hasReadyTasks = sessionCtx.ready_tasks.length > 0;
   337→
   338→            if (!hasActiveTasks && !hasReadyTasks) {
   339→              info('No active or ready tasks. Exiting loop.');
   340→              break;
   341→            }
   342→
   343→            // Build prompt
   344→            const prompt = buildPrompt(sessionCtx, iteration, maxLoops, options.focus);
   345→
   346→            if (options.dryRun) {
   347→              console.log(chalk.yellow('=== DRY RUN - Prompt that would be sent ===\n'));
   348→              console.log(prompt);
   349→              console.log(chalk.yellow('\n=== END DRY RUN ==='));
   350→              break;
   351→            }
   352→
   353→            // Log prompt
   354→            await appendEvent(specDir, {
   355→              session_id: sessionId,
   356→              type: 'prompt.sent',
   357→              data: {
   358→                iteration,
   359→                prompt,
   360→                tasks: {
   361→                  active: sessionCtx.active_tasks.map(t => t.ref),
   362→                  ready: sessionCtx.ready_tasks.map(t => t.ref),
   363→                },
   364→              },
   365→            });
   366→
   367→            // Retry loop for this iteration
   368→            let lastError: Error | null = null;
   369→            let succeeded = false;
   370→
   371→            for (let attempt = 1; attempt <= maxRetries + 1; attempt++) {
   372→              if (attempt > 1) {
   373→                console.log(chalk.yellow(`\nRetry attempt ${attempt - 1}/${maxRetries}...`));
   374→              }
   375→
   376→              try {
   377→                // Spawn agent if not already running
   378→                if (!agent) {
   379→                  info('Spawning ACP agent...');
   380→                  agent = await spawnAndInitialize(adapter, {
   381→                    cwd: process.cwd(),
   382→                    clientOptions: {
   383→                      clientInfo: {
   384→                        name: 'kspec-ralph',
   385→                        version: '0.1.0',
   386→                      },
   387→                    },
   388→                  });
   389→
   390→                  // Set up streaming update handler with translator + renderer
   391→                  agent.client.on('update', (_sid: string, update: SessionUpdate) => {
   392→                    // Translate ACP event to RalphEvent and render
   393→                    const event = translator.translate(update);
   394→                    if (event) {
   395→                      renderer.render(event);
   396→                    }
   397→                    // Log raw update event (async, non-blocking)
   398→                    appendEvent(specDir, {
   399→                      session_id: sessionId,
   400→                      type: 'session.update',
   401→                      data: { iteration, update },
   402→                    }).catch(() => {
   403→                      // Ignore logging errors during streaming
   404→                    });
   405→                  });
   406→
   407→                  // Set up tool request handler
   408→                  agent.client.on('request', (reqId: string | number, method: string, params: unknown) => {
   409→                    handleRequest(agent!.client, reqId, method, params, options.yolo).catch((err) => {
   410→                      agent!.client.respondError(reqId, -32000, err.message);
   411→                    });
   412→                  });
   413→                }
   414→
   415→                // Create fresh ACP session per iteration to keep context clean
   416→                info('Creating ACP session...');
   417→                acpSessionId = await agent.client.newSession({
   418→                  cwd: process.cwd(),
   419→                  mcpServers: [], // No MCP servers for now
   420→                });
   421→
   422→                info('Sending prompt to agent...');
   423→
   424→                // Send prompt and wait for completion
   425→                const response = await agent.client.prompt({
   426→                  sessionId: acpSessionId!,
   427→                  prompt: [{ type: 'text', text: prompt }],
   428→                });
   429→
   430→                // Log completion
   431→                await appendEvent(specDir, {
   432→                  session_id: sessionId,
   433→                  type: 'session.update',
   434→                  data: {
   435→                    iteration,
   436→                    stopReason: response.stopReason,
   437→                    completed: true,
   438→                  },
   439→                });
   440→
   441→                // Check stop reason
   442→                if (response.stopReason === 'cancelled') {
   443→                  throw new Error(errors.usage.agentPromptCancelled);
   444→                }
   445→
   446→                succeeded = true;
   447→                break;
   448→              } catch (err) {
   449→                lastError = err as Error;
   450→                error(errors.failures.iterationFailed(lastError.message));
   451→
   452→                // Clean up agent on error - will respawn next attempt
   453→                if (agent) {
   454→                  agent.kill();
   455→                  agent = null;
   456→                  acpSessionId = null;
   457→                }
   458→              }
   459→            }
   460→
   461→            if (succeeded) {
   462→              console.log(); // Newline after streaming output
   463→              success(`Completed iteration ${iteration}`);
   464→              consecutiveFailures = 0;
   465→            } else {
   466→              consecutiveFailures++;
   467→              error(errors.failures.iterationFailedAfterRetries(iteration, maxRetries, consecutiveFailures, maxFailures));
   468→              if (lastError) {
   469→                error(errors.failures.lastError(lastError.message));
   470→              }
   471→
   472→              if (consecutiveFailures >= maxFailures) {
   473→                error(errors.failures.reachedMaxFailures(maxFailures));
   474→                break;
   475→              }
   476→
   477→              info('Continuing to next iteration...');
   478→            }
   479→          }
   480→        } finally {
   481→          // Clean up agent
   482→          if (agent) {
   483→            agent.kill();
   484→          }
   485→
   486→          // Log session end
   487→          const status = consecutiveFailures >= maxFailures ? 'abandoned' : 'completed';
   488→          await appendEvent(specDir, {
   489→            session_id: sessionId,
   490→            type: 'session.end',
   491→            data: {
   492→              status,
   493→              consecutiveFailures,
   494→            },
   495→          });
   496→          await updateSessionStatus(specDir, sessionId, status);
   497→        }
   498→
   499→        console.log(chalk.green(`\n${'─'.repeat(60)}`));
   500→        success('Ralph loop completed');
   501→        console.log(chalk.green(`${'─'.repeat(60)}\n`));
   502→
   503→      } catch (err) {
   504→        error(errors.failures.ralphLoop, err);
   505→        process.exit(1);
   506→      }
   507→    });
   508→}
   509→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
