     1→/**
     2→ * Tests for ralph command and event translator.
     3→ *
     4→ * Uses a mock ACP agent to test loop behavior, retry logic,
     5→ * and failure handling without invoking the real Claude Code.
     6→ */
     7→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     8→import * as fs from 'node:fs/promises';
     9→import * as path from 'node:path';
    10→import * as os from 'node:os';
    11→import { spawnSync } from 'node:child_process';
    12→import { createTranslator } from '../src/ralph/events.js';
    13→import type { SessionUpdate } from '../src/acp/types.js';
    14→
    15→const FIXTURES_DIR = path.join(__dirname, 'fixtures');
    16→const CLI_PATH = path.join(__dirname, '..', 'src', 'cli', 'index.ts');
    17→const MOCK_ACP = path.join(__dirname, 'mocks', 'acp-mock.js');
    18→
    19→interface RalphResult {
    20→  output: string; // Combined stdout + stderr for easier assertion
    21→  stdout: string;
    22→  stderr: string;
    23→  exitCode: number;
    24→}
    25→
    26→/**
    27→ * Run ralph command with mock ACP agent
    28→ */
    29→function runRalph(
    30→  args: string,
    31→  cwd: string,
    32→  env: Record<string, string> = {}
    33→): RalphResult {
    34→  const result = spawnSync(
    35→    'npx',
    36→    ['tsx', CLI_PATH, 'ralph', ...args.split(/\s+/), '--adapter-cmd', `node ${MOCK_ACP}`],
    37→    {
    38→      cwd,
    39→      encoding: 'utf-8',
    40→      timeout: 30000,
    41→      env: {
    42→        ...process.env,
    43→        KSPEC_AUTHOR: '@test',
    44→        ...env,
    45→      },
    46→    }
    47→  );
    48→
    49→  const stdout = result.stdout || '';
    50→  const stderr = result.stderr || '';
    51→
    52→  return {
    53→    output: stdout + stderr,
    54→    stdout,
    55→    stderr,
    56→    exitCode: result.status || 0,
    57→  };
    58→}
    59→
    60→/**
    61→ * Copy fixtures to a temp directory for isolated testing
    62→ */
    63→async function setupTempFixtures(): Promise<string> {
    64→  const tempDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-ralph-test-'));
    65→  await fs.cp(FIXTURES_DIR, tempDir, { recursive: true });
    66→  return tempDir;
    67→}
    68→
    69→describe('ralph command', () => {
    70→  let tempDir: string;
    71→  let stateFile: string;
    72→
    73→  beforeEach(async () => {
    74→    tempDir = await setupTempFixtures();
    75→    stateFile = path.join(tempDir, 'mock-state');
    76→  });
    77→
    78→  afterEach(async () => {
    79→    await fs.rm(tempDir, { recursive: true, force: true });
    80→  });
    81→
    82→  // AC-1: Basic loop execution
    83→  it('executes loop iterations when ready tasks exist', async () => {
    84→    const result = runRalph('--max-loops 2', tempDir, {
    85→      MOCK_ACP_EXIT_CODE: '0',
    86→    });
    87→
    88→    expect(result.stdout).toContain('Iteration 1/2');
    89→    expect(result.stdout).toContain('Iteration 2/2');
    90→    expect(result.stdout).toContain('Completed iteration 1');
    91→    expect(result.stdout).toContain('Completed iteration 2');
    92→    expect(result.stdout).toContain('Ralph loop completed');
    93→  });
    94→
    95→  // AC-2: No ready tasks exit
    96→  it('exits when no ready tasks exist', async () => {
    97→    // Modify fixtures to have no ready tasks - mark all pending as completed
    98→    const tasksPath = path.join(tempDir, 'project.tasks.yaml');
    99→    const content = await fs.readFile(tasksPath, 'utf-8');
   100→    // Change all pending tasks to completed (use global replace)
   101→    const modified = content.replace(/status: pending/g, 'status: completed');
   102→    await fs.writeFile(tasksPath, modified);
   103→
   104→    const result = runRalph('--max-loops 5', tempDir, {
   105→      MOCK_ACP_EXIT_CODE: '0',
   106→    });
   107→
   108→    expect(result.output).toContain('No active or ready tasks');
   109→    // Should not attempt multiple iterations
   110→    expect(result.output).not.toContain('Iteration 2/5');
   111→  });
   112→
   113→  // AC-6: Dry run mode
   114→  it('shows prompt without executing in dry-run mode', async () => {
   115→    const result = runRalph('--dry-run', tempDir);
   116→
   117→    expect(result.stdout).toContain('DRY RUN');
   118→    expect(result.stdout).toContain('Kspec Automation Session');
   119→    expect(result.stdout).toContain('Working Procedure');
   120→    // Should not show completion
   121→    expect(result.stdout).not.toContain('Completed iteration');
   122→  });
   123→
   124→  // AC-7: Retry on error
   125→  it('retries iteration on failure', async () => {
   126→    // Fail twice then succeed
   127→    const result = runRalph('--max-loops 1 --max-retries 3', tempDir, {
   128→      MOCK_ACP_FAIL_COUNT: '2',
   129→      MOCK_ACP_STATE_FILE: stateFile,
   130→    });
   131→
   132→    expect(result.stdout).toContain('Retry attempt 1/3');
   133→    expect(result.stdout).toContain('Retry attempt 2/3');
   134→    expect(result.stdout).toContain('Completed iteration 1');
   135→  });
   136→
   137→  it('continues to next iteration after retries exhausted', async () => {
   138→    // Always fail
   139→    const result = runRalph('--max-loops 2 --max-retries 1 --max-failures 3', tempDir, {
   140→      MOCK_ACP_EXIT_CODE: '1',
   141→    });
   142→
   143→    expect(result.output).toContain('failed after 2 attempts');
   144→    expect(result.output).toContain('Continuing to next iteration');
   145→    expect(result.output).toContain('Iteration 2/2');
   146→  });
   147→
   148→  // AC-8: Consecutive failure guard
   149→  it('exits after max consecutive failures', async () => {
   150→    // Always fail
   151→    const result = runRalph('--max-loops 10 --max-retries 0 --max-failures 2', tempDir, {
   152→      MOCK_ACP_EXIT_CODE: '1',
   153→    });
   154→
   155→    expect(result.output).toContain('1/2 consecutive failures');
   156→    expect(result.output).toContain('2/2 consecutive failures');
   157→    expect(result.output).toContain('Reached 2 consecutive failures');
   158→    // Should not continue to iteration 3
   159→    expect(result.output).not.toContain('Iteration 3/10');
   160→  });
   161→
   162→  it('resets failure count on success', async () => {
   163→    // For simplicity, just verify a success resets the pattern
   164→    const result = runRalph('--max-loops 2 --max-retries 0', tempDir, {
   165→      MOCK_ACP_EXIT_CODE: '0',
   166→    });
   167→
   168→    expect(result.output).toContain('Completed iteration 1');
   169→    expect(result.output).toContain('Completed iteration 2');
   170→    expect(result.output).not.toContain('consecutive failures');
   171→  });
   172→
   173→  // AC-9: Adapter selection
   174→  it('uses specified adapter', async () => {
   175→    const result = runRalph('--dry-run --adapter custom --adapter-cmd "echo test"', tempDir);
   176→
   177→    // Dry run should show the adapter being used
   178→    expect(result.stdout).toContain('adapter=custom');
   179→  });
   180→
   181→  // AC-10: Session creation
   182→  it('creates session and logs events', async () => {
   183→    const result = runRalph('--max-loops 1', tempDir, {
   184→      MOCK_ACP_EXIT_CODE: '0',
   185→    });
   186→
   187→    // Check that session directory was created
   188→    const sessionsDir = path.join(tempDir, 'sessions');
   189→    const sessions = await fs.readdir(sessionsDir).catch(() => []);
   190→    expect(sessions.length).toBeGreaterThan(0);
   191→
   192→    // Check session metadata
   193→    if (sessions.length > 0) {
   194→      const sessionDir = path.join(sessionsDir, sessions[0]);
   195→      const metadataPath = path.join(sessionDir, 'session.yaml');
   196→      const metadata = await fs.readFile(metadataPath, 'utf-8');
   197→      expect(metadata).toContain('agent_type:');
   198→      expect(metadata).toContain('status:');
   199→    }
   200→  });
   201→
   202→  // AC-11: Streaming output
   203→  it('displays streaming output from agent', async () => {
   204→    const result = runRalph('--max-loops 1', tempDir, {
   205→      MOCK_ACP_EXIT_CODE: '0',
   206→      MOCK_ACP_RESPONSE_TEXT: 'Streaming test output',
   207→    });
   208→
   209→    // The streaming text should appear in output
   210→    expect(result.stdout).toContain('Streaming test output');
   211→  });
   212→
   213→  // AC-12: Event logging
   214→  it('logs prompt.sent events', async () => {
   215→    const result = runRalph('--max-loops 1', tempDir, {
   216→      MOCK_ACP_EXIT_CODE: '0',
   217→    });
   218→
   219→    // Check events file
   220→    const sessionsDir = path.join(tempDir, 'sessions');
   221→    const sessions = await fs.readdir(sessionsDir).catch(() => []);
   222→
   223→    if (sessions.length > 0) {
   224→      const eventsPath = path.join(sessionsDir, sessions[0], 'events.jsonl');
   225→      const events = await fs.readFile(eventsPath, 'utf-8');
   226→
   227→      // Should have session.start, prompt.sent, and session.end at minimum
   228→      expect(events).toContain('"type":"session.start"');
   229→      expect(events).toContain('"type":"prompt.sent"');
   230→      expect(events).toContain('"type":"session.end"');
   231→    }
   232→  });
   233→});
   234→
   235→// ─── Event Translator Unit Tests ────────────────────────────────────────────
   236→
   237→describe('ralph event translator', () => {
   238→  // Helper to create SessionUpdate objects
   239→  function makeChunk(
   240→    type: 'agent_message_chunk' | 'agent_thought_chunk',
   241→    text: string
   242→  ): SessionUpdate {
   243→    return {
   244→      sessionUpdate: type,
   245→      content: { type: 'text', text },
   246→    } as SessionUpdate;
   247→  }
   248→
   249→  describe('agent_message_chunk', () => {
   250→    it('translates streaming content', () => {
   251→      const translator = createTranslator();
   252→      const event = translator.translate(makeChunk('agent_message_chunk', 'Hello'));
   253→
   254→      expect(event).not.toBeNull();
   255→      expect(event!.type).toBe('agent_message');
   256→      expect(event!.data).toMatchObject({
   257→        kind: 'agent_message',
   258→        content: 'Hello',
   259→        isStreaming: true,
   260→      });
   261→    });
   262→
   263→    it('finalizes on empty string signal', () => {
   264→      const translator = createTranslator();
   265→
   266→      // First, stream some content
   267→      translator.translate(makeChunk('agent_message_chunk', 'Hello'));
   268→      translator.translate(makeChunk('agent_message_chunk', ' world'));
   269→
   270→      // Then send empty string to finalize
   271→      const finalEvent = translator.translate(makeChunk('agent_message_chunk', ''));
   272→
   273→      expect(finalEvent).not.toBeNull();
   274→      expect(finalEvent!.type).toBe('agent_message');
   275→      expect(finalEvent!.data).toMatchObject({
   276→        kind: 'agent_message',
   277→        content: 'Hello world',
   278→        isStreaming: false,
   279→      });
   280→    });
   281→
   282→    it('returns null for empty string when no active message', () => {
   283→      const translator = createTranslator();
   284→
   285→      // Send empty string without prior content
   286→      const event = translator.translate(makeChunk('agent_message_chunk', ''));
   287→
   288→      expect(event).toBeNull();
   289→    });
   290→  });
   291→
   292→  describe('agent_thought_chunk', () => {
   293→    it('translates streaming thought content', () => {
   294→      const translator = createTranslator();
   295→      const event = translator.translate(makeChunk('agent_thought_chunk', 'Thinking...'));
   296→
   297→      expect(event).not.toBeNull();
   298→      expect(event!.type).toBe('agent_thought');
   299→      expect(event!.data).toMatchObject({
   300→        kind: 'agent_thought',
   301→        content: 'Thinking...',
   302→        isStreaming: true,
   303→      });
   304→    });
   305→
   306→    it('finalizes on empty string signal', () => {
   307→      const translator = createTranslator();
   308→
   309→      // Stream some thought content
   310→      translator.translate(makeChunk('agent_thought_chunk', 'Let me think'));
   311→      translator.translate(makeChunk('agent_thought_chunk', ' about this'));
   312→
   313→      // Finalize with empty string
   314→      const finalEvent = translator.translate(makeChunk('agent_thought_chunk', ''));
   315→
   316→      expect(finalEvent).not.toBeNull();
   317→      expect(finalEvent!.type).toBe('agent_thought');
   318→      expect(finalEvent!.data).toMatchObject({
   319→        kind: 'agent_thought',
   320→        content: 'Let me think about this',
   321→        isStreaming: false,
   322→      });
   323→    });
   324→  });
   325→
   326→  describe('finalize()', () => {
   327→    it('returns final event for pending message', () => {
   328→      const translator = createTranslator();
   329→
   330→      // Stream content without empty string finalization
   331→      translator.translate(makeChunk('agent_message_chunk', 'Incomplete'));
   332→
   333→      // Call finalize explicitly
   334→      const finalEvent = translator.finalize();
   335→
   336→      expect(finalEvent).not.toBeNull();
   337→      expect(finalEvent!.type).toBe('agent_message');
   338→      expect(finalEvent!.data).toMatchObject({
   339→        kind: 'agent_message',
   340→        content: 'Incomplete',
   341→        isStreaming: false,
   342→      });
   343→    });
   344→
   345→    it('returns null when no pending message', () => {
   346→      const translator = createTranslator();
   347→
   348→      const event = translator.finalize();
   349→
   350→      expect(event).toBeNull();
   351→    });
   352→
   353→    it('clears state after finalize', () => {
   354→      const translator = createTranslator();
   355→
   356→      translator.translate(makeChunk('agent_message_chunk', 'Test'));
   357→      translator.finalize();
   358→
   359→      // Second finalize should return null
   360→      const secondFinalize = translator.finalize();
   361→      expect(secondFinalize).toBeNull();
   362→    });
   363→  });
   364→
   365→  describe('noise suppression', () => {
   366→    it('suppresses onPostToolUseHook messages', () => {
   367→      const translator = createTranslator();
   368→      const event = translator.translate(
   369→        makeChunk('agent_message_chunk', 'No onPostToolUseHook found for tool use ID: toolu_123')
   370→      );
   371→
   372→      expect(event).toBeNull();
   373→    });
   374→
   375→    it('suppresses onPreToolUseHook messages', () => {
   376→      const translator = createTranslator();
   377→      const event = translator.translate(
   378→        makeChunk('agent_message_chunk', 'No onPreToolUseHook found for tool use')
   379→      );
   380→
   381→      expect(event).toBeNull();
   382→    });
   383→  });
   384→
   385→  describe('tool_call events', () => {
   386→    it('extracts tool name and summary from rawInput (ACP format)', () => {
   387→      const translator = createTranslator();
   388→      const event = translator.translate({
   389→        sessionUpdate: 'tool_call',
   390→        toolCallId: 'toolu_123',
   391→        rawInput: { command: 'npm run build' },
   392→        _meta: { claudeCode: { toolName: 'Bash' } },
   393→      } as SessionUpdate);
   394→
   395→      expect(event).not.toBeNull();
   396→      expect(event!.type).toBe('tool_start');
   397→      expect(event!.data).toMatchObject({
   398→        kind: 'tool_start',
   399→        toolCallId: 'toolu_123',
   400→        tool: 'Bash',
   401→        summary: 'npm run build',
   402→      });
   403→    });
   404→
   405→    it('extracts file path summary for Read tool', () => {
   406→      const translator = createTranslator();
   407→      const event = translator.translate({
   408→        sessionUpdate: 'tool_call',
   409→        toolCallId: 'toolu_456',
   410→        rawInput: { file_path: '/home/user/project/src/index.ts' },
   411→        _meta: { claudeCode: { toolName: 'Read' } },
   412→      } as SessionUpdate);
   413→
   414→      expect(event).not.toBeNull();
   415→      expect(event!.data).toMatchObject({
   416→        kind: 'tool_start',
   417→        tool: 'Read',
   418→        summary: 'index.ts',
   419→      });
   420→    });
   421→
   422→    it('extracts pattern summary for Grep tool', () => {
   423→      const translator = createTranslator();
   424→      const event = translator.translate({
   425→        sessionUpdate: 'tool_call',
   426→        toolCallId: 'toolu_789',
   427→        rawInput: { pattern: 'TODO|FIXME' },
   428→        _meta: { claudeCode: { toolName: 'Grep' } },
   429→      } as SessionUpdate);
   430→
   431→      expect(event).not.toBeNull();
   432→      expect(event!.data).toMatchObject({
   433→        kind: 'tool_start',
   434→        tool: 'Grep',
   435→        summary: '/TODO|FIXME/',
   436→      });
   437→    });
   438→
   439→    it('truncates long Bash commands', () => {
   440→      const translator = createTranslator();
   441→      const longCommand = 'npm run build -- --very-long-flag --another-flag --more-options';
   442→      const event = translator.translate({
   443→        sessionUpdate: 'tool_call',
   444→        toolCallId: 'toolu_abc',
   445→        rawInput: { command: longCommand },
   446→        _meta: { claudeCode: { toolName: 'Bash' } },
   447→      } as SessionUpdate);
   448→
   449→      expect(event).not.toBeNull();
   450→      const data = event!.data as { summary: string };
   451→      expect(data.summary.length).toBeLessThanOrEqual(50);
   452→      expect(data.summary).toContain('...');
   453→    });
   454→
   455→    it('deduplicates phased tool_call events (same tool_call_id)', () => {
   456→      const translator = createTranslator();
   457→
   458→      // Phase 1: Registration with no input
   459→      const event1 = translator.translate({
   460→        sessionUpdate: 'tool_call',
   461→        toolCallId: 'toolu_phased',
   462→        rawInput: {},
   463→        _meta: { claudeCode: { toolName: 'Bash' } },
   464→      } as SessionUpdate);
   465→
   466→      expect(event1).not.toBeNull();
   467→      expect(event1!.type).toBe('tool_start');
   468→      expect((event1!.data as { summary: string }).summary).toBe('');
   469→
   470→      // Phase 2: Same tool_call_id with input now available
   471→      const event2 = translator.translate({
   472→        sessionUpdate: 'tool_call',
   473→        toolCallId: 'toolu_phased',
   474→        rawInput: { command: 'npm run build' },
   475→        _meta: { claudeCode: { toolName: 'Bash' } },
   476→      } as SessionUpdate);
   477→
   478→      // Should emit tool_update with summary, not another tool_start
   479→      expect(event2).not.toBeNull();
   480→      expect(event2!.type).toBe('tool_update');
   481→      expect((event2!.data as { summary: string }).summary).toBe('npm run build');
   482→    });
   483→
   484→    it('suppresses duplicate tool_call events with no new summary', () => {
   485→      const translator = createTranslator();
   486→
   487→      // First event with input
   488→      translator.translate({
   489→        sessionUpdate: 'tool_call',
   490→        toolCallId: 'toolu_dup',
   491→        rawInput: { command: 'npm test' },
   492→        _meta: { claudeCode: { toolName: 'Bash' } },
   493→      } as SessionUpdate);
   494→
   495→      // Same event again (duplicate)
   496→      const event2 = translator.translate({
   497→        sessionUpdate: 'tool_call',
   498→        toolCallId: 'toolu_dup',
   499→        rawInput: { command: 'npm test' },
   500→        _meta: { claudeCode: { toolName: 'Bash' } },
   501→      } as SessionUpdate);
   502→
   503→      // Should suppress since summary didn't change
   504→      expect(event2).toBeNull();
   505→    });
   506→  });
   507→
   508→  describe('tool_call_update events', () => {
   509→    it('extracts output from Claude Code toolResponse format', () => {
   510→      const translator = createTranslator();
   511→
   512→      // First send tool_call to register the tool
   513→      translator.translate({
   514→        sessionUpdate: 'tool_call',
   515→        toolCallId: 'toolu_123',
   516→        rawInput: { command: 'echo hello' },
   517→        _meta: { claudeCode: { toolName: 'Bash' } },
   518→      } as SessionUpdate);
   519→
   520→      // Then send tool_call_update with result
   521→      const event = translator.translate({
   522→        sessionUpdate: 'tool_call_update',
   523→        toolCallId: 'toolu_123',
   524→        status: 'completed',
   525→        _meta: {
   526→          claudeCode: {
   527→            toolName: 'Bash',
   528→            toolResponse: {
   529→              stdout: 'hello\n',
   530→              stderr: '',
   531→              interrupted: false,
   532→              isImage: false,
   533→            },
   534→          },
   535→        },
   536→      } as SessionUpdate);
   537→
   538→      expect(event).not.toBeNull();
   539→      expect(event!.type).toBe('tool_result');
   540→      expect(event!.data).toMatchObject({
   541→        kind: 'tool_result',
   542→        toolCallId: 'toolu_123',
   543→        tool: 'Bash',
   544→        status: 'completed',
   545→        output: 'hello',
   546→      });
   547→    });
   548→
   549→    it('combines stdout and stderr in output', () => {
   550→      const translator = createTranslator();
   551→
   552→      translator.translate({
   553→        sessionUpdate: 'tool_call',
   554→        toolCallId: 'toolu_456',
   555→        rawInput: { command: 'failing-cmd' },
   556→        _meta: { claudeCode: { toolName: 'Bash' } },
   557→      } as SessionUpdate);
   558→
   559→      const event = translator.translate({
   560→        sessionUpdate: 'tool_call_update',
   561→        toolCallId: 'toolu_456',
   562→        status: 'completed',
   563→        _meta: {
   564→          claudeCode: {
   565→            toolName: 'Bash',
   566→            toolResponse: {
   567→              stdout: 'partial output',
   568→              stderr: 'error: something went wrong',
   569→              interrupted: false,
   570→              isImage: false,
   571→            },
   572→          },
   573→        },
   574→      } as SessionUpdate);
   575→
   576→      expect(event).not.toBeNull();
   577→      const data = event!.data as { output: string };
   578→      expect(data.output).toContain('partial output');
   579→      expect(data.output).toContain('error: something went wrong');
   580→    });
   581→
   582→    it('handles non-terminal status updates', () => {
   583→      const translator = createTranslator();
   584→
   585→      translator.translate({
   586→        sessionUpdate: 'tool_call',
   587→        toolCallId: 'toolu_789',
   588→        rawInput: { command: 'long-running-cmd' },
   589→        _meta: { claudeCode: { toolName: 'Bash' } },
   590→      } as SessionUpdate);
   591→
   592→      const event = translator.translate({
   593→        sessionUpdate: 'tool_call_update',
   594→        toolCallId: 'toolu_789',
   595→        status: 'running',
   596→        _meta: { claudeCode: { toolName: 'Bash' } },
   597→      } as SessionUpdate);
   598→
