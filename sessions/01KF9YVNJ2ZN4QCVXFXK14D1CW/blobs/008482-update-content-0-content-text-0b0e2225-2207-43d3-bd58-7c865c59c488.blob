```
     1→import { Command } from 'commander';
     2→import chalk from 'chalk';
     3→import {
     4→  initContext,
     5→  buildIndexes,
     6→  createSpecItem,
     7→  deleteSpecItem,
     8→  updateSpecItem,
     9→  addChildItem,
    10→  loadAllItems,
    11→  loadAllTasks,
    12→  ReferenceIndex,
    13→  AlignmentIndex,
    14→  checkSlugUniqueness,
    15→  patchSpecItems,
    16→  findChildItems,
    17→  type LoadedSpecItem,
    18→  type PatchOperation,
    19→  type BulkPatchResult,
    20→} from '../../parser/index.js';
    21→import { commitIfShadow } from '../../parser/shadow.js';
    22→import type { ItemFilter } from '../../parser/items.js';
    23→import type { ItemType, Maturity, ImplementationStatus, SpecItemInput, AcceptanceCriterion } from '../../schema/index.js';
    24→import { SpecItemPatchSchema } from '../../schema/index.js';
    25→import { output, error, success, warn, isJsonMode } from '../output.js';
    26→import { grepItem, formatMatchedFields } from '../../utils/grep.js';
    27→import { errors } from '../../strings/errors.js';
    28→import { fieldLabels, sectionHeaders } from '../../strings/labels.js';
    29→
    30→/**
    31→ * Format a spec item for display
    32→ */
    33→function formatItem(item: LoadedSpecItem, verbose = false, grepPattern?: string): string {
    34→  const shortId = item._ulid.slice(0, 8);
    35→  const slugStr = item.slugs.length > 0 ? chalk.cyan(`@${item.slugs[0]}`) : '';
    36→  const typeStr = chalk.gray(`[${item.type}]`);
    37→
    38→  let status = '';
    39→  if (item.status && typeof item.status === 'object') {
    40→    const s = item.status as { maturity?: string; implementation?: string };
    41→    if (s.implementation) {
    42→      const implColor = s.implementation === 'verified' ? chalk.green
    43→        : s.implementation === 'implemented' ? chalk.cyan
    44→          : s.implementation === 'in_progress' ? chalk.yellow
    45→            : chalk.gray;
    46→      status = implColor(s.implementation);
    47→    } else if (s.maturity) {
    48→      status = chalk.gray(s.maturity);
    49→    }
    50→  }
    51→
    52→  let line = `${chalk.gray(shortId)} ${typeStr} ${item.title}`;
    53→  if (slugStr) line += ` ${slugStr}`;
    54→  if (status) line += ` ${status}`;
    55→
    56→  if (verbose) {
    57→    const tags = 'tags' in item && Array.isArray(item.tags) ? item.tags : [];
    58→    if (tags.length > 0) {
    59→      line += chalk.blue(` #${tags.join(' #')}`);
    60→    }
    61→  }
    62→
    63→  // Show matched fields if grep pattern provided
    64→  if (grepPattern) {
    65→    const match = grepItem(item as unknown as Record<string, unknown>, grepPattern);
    66→    if (match && match.matchedFields.length > 0) {
    67→      line += '\n  ' + chalk.gray(`matched: ${formatMatchedFields(match.matchedFields)}`);
    68→    }
    69→  }
    70→
    71→  return line;
    72→}
    73→
    74→/**
    75→ * Format item list for display
    76→ */
    77→function formatItemList(items: LoadedSpecItem[], verbose = false, grepPattern?: string): void {
    78→  if (items.length === 0) {
    79→    console.log(chalk.gray('No items found'));
    80→    return;
    81→  }
    82→
    83→  for (const item of items) {
    84→    console.log(formatItem(item, verbose, grepPattern));
    85→  }
    86→
    87→  console.log(chalk.gray(`\n${items.length} item(s)`));
    88→}
    89→
    90→/**
    91→ * Handle cascading status updates to child items
    92→ * Returns array of updated child items
    93→ */
    94→async function handleStatusCascade(
    95→  ctx: Awaited<ReturnType<typeof initContext>>,
    96→  parent: LoadedSpecItem,
    97→  newStatus: string,
    98→  allItems: LoadedSpecItem[],
    99→  refIndex: ReferenceIndex
   100→): Promise<LoadedSpecItem[]> {
   101→  // Find direct children
   102→  const children = findChildItems(parent, allItems);
   103→
   104→  if (children.length === 0) {
   105→    return [];
   106→  }
   107→
   108→  // Skip prompt in JSON mode
   109→  if (isJsonMode()) {
   110→    return [];
   111→  }
   112→
   113→  // Prompt user for cascade
   114→  const readline = await import('readline');
   115→  const rl = readline.createInterface({
   116→    input: process.stdin,
   117→    output: process.stdout,
   118→  });
   119→
   120→  const answer = await new Promise<string>((resolve) => {
   121→    rl.question(`Update ${children.length} child item(s) to ${newStatus}? [y/n] `, resolve);
   122→  });
   123→  rl.close();
   124→
   125→  if (answer.toLowerCase() !== 'y') {
   126→    return [];
   127→  }
   128→
   129→  // Update children
   130→  const updatedChildren: LoadedSpecItem[] = [];
   131→  for (const child of children) {
   132→    const currentStatus = child.status && typeof child.status === 'object'
   133→      ? child.status
   134→      : { maturity: 'draft' as const, implementation: 'not_started' as const };
   135→
   136→    const updates = {
   137→      status: {
   138→        maturity: currentStatus.maturity || ('draft' as const),
   139→        implementation: newStatus as ImplementationStatus,
   140→      },
   141→    };
   142→
   143→    const updated = await updateSpecItem(ctx, child, updates);
   144→    updatedChildren.push(updated);
   145→
   146→    // Log each child update (non-JSON mode only)
   147→    const childRef = child.slugs[0] || refIndex.shortUlid(child._ulid);
   148→    console.log(chalk.gray(`  ✓ Updated @${childRef}`));
   149→  }
   150→
   151→  return updatedChildren;
   152→}
   153→
   154→/**
   155→ * Register item commands
   156→ */
   157→export function registerItemCommands(program: Command): void {
   158→  const item = program
   159→    .command('item')
   160→    .description('Spec item commands');
   161→
   162→  // kspec item list
   163→  item
   164→    .command('list')
   165→    .description('List spec items with optional filters')
   166→    .option('-t, --type <type>', 'Filter by item type (module, feature, requirement, constraint, decision)')
   167→    .option('-s, --status <status>', 'Filter by implementation status (not_started, in_progress, implemented, verified)')
   168→    .option('-m, --maturity <maturity>', 'Filter by maturity (draft, proposed, stable, deprecated)')
   169→    .option('--tag <tag>', 'Filter by tag (can specify multiple)', (val, prev: string[]) => [...prev, val], [])
   170→    .option('--has <field>', 'Filter items that have field present', (val, prev: string[]) => [...prev, val], [])
   171→    .option('-q, --search <text>', 'Search in title')
   172→    .option('-g, --grep <pattern>', 'Search content with regex pattern')
   173→    .option('-v, --verbose', 'Show more details')
   174→    .option('--limit <n>', 'Limit results', '50')
   175→    .action(async (options) => {
   176→      try {
   177→        const ctx = await initContext();
   178→        const { itemIndex, items } = await buildIndexes(ctx);
   179→
   180→        // Build filter from options
   181→        const filter: ItemFilter = {
   182→          specItemsOnly: true, // Only spec items, not tasks
   183→        };
   184→
   185→        if (options.type) {
   186→          filter.type = options.type as ItemType;
   187→        }
   188→
   189→        if (options.status) {
   190→          filter.implementation = options.status as ImplementationStatus;
   191→        }
   192→
   193→        if (options.maturity) {
   194→          filter.maturity = options.maturity as Maturity;
   195→        }
   196→
   197→        if (options.tag && options.tag.length > 0) {
   198→          filter.tags = options.tag;
   199→        }
   200→
   201→        if (options.has && options.has.length > 0) {
   202→          filter.hasFields = options.has;
   203→        }
   204→
   205→        if (options.search) {
   206→          filter.titleContains = options.search;
   207→        }
   208→
   209→        if (options.grep) {
   210→          filter.grepSearch = options.grep;
   211→        }
   212→
   213→        const limit = parseInt(options.limit, 10) || 50;
   214→        const result = itemIndex.queryPaginated(filter, 0, limit);
   215→
   216→        // Filter to only LoadedSpecItem (not tasks)
   217→        const specItems = result.items.filter((item): item is LoadedSpecItem =>
   218→          !('status' in item && typeof item.status === 'string')
   219→        );
   220→
   221→        output(
   222→          {
   223→            items: specItems,
   224→            total: result.total,
   225→            showing: specItems.length,
   226→            grepPattern: options.grep,
   227→          },
   228→          () => formatItemList(specItems, options.verbose, options.grep)
   229→        );
   230→      } catch (err) {
   231→        error(errors.failures.listItems, err);
   232→        process.exit(1);
   233→      }
   234→    });
   235→
   236→  // kspec item get <ref>
   237→  item
   238→    .command('get <ref>')
   239→    .description('Get details for a specific item')
   240→    .action(async (ref) => {
   241→      try {
   242→        const ctx = await initContext();
   243→        const { refIndex, items } = await buildIndexes(ctx);
   244→
   245→        const result = refIndex.resolve(ref);
   246→
   247→        if (!result.ok) {
   248→          error(errors.reference.itemNotFound(ref));
   249→          process.exit(1);
   250→        }
   251→
   252→        const item = result.item as LoadedSpecItem;
   253→
   254→        output(item, () => {
   255→          console.log(chalk.bold(item.title));
   256→          console.log(chalk.gray('─'.repeat(40)));
   257→          console.log(`${fieldLabels.ulid}      ${item._ulid}`);
   258→          if (item.slugs.length > 0) {
   259→            console.log(`${fieldLabels.slugs}     ${item.slugs.join(', ')}`);
   260→          }
   261→          console.log(`${fieldLabels.type}      ${item.type}`);
   262→
   263→          if (item.status && typeof item.status === 'object') {
   264→            const s = item.status as { maturity?: string; implementation?: string };
   265→            if (s.maturity) console.log(`${fieldLabels.maturity}  ${s.maturity}`);
   266→            if (s.implementation) console.log(`${fieldLabels.implementation}${s.implementation}`);
   267→          }
   268→
   269→          if ('tags' in item && Array.isArray(item.tags) && item.tags.length > 0) {
   270→            console.log(`${fieldLabels.tags}      ${item.tags.join(', ')}`);
   271→          }
   272→
   273→          if (item.description) {
   274→            console.log('\n' + sectionHeaders.description);
   275→            console.log(item.description);
   276→          }
   277→
   278→          if ('acceptance_criteria' in item && Array.isArray(item.acceptance_criteria) && item.acceptance_criteria.length > 0) {
   279→            console.log('\n' + sectionHeaders.acceptanceCriteria);
   280→            for (const ac of item.acceptance_criteria) {
   281→              if (ac && typeof ac === 'object' && 'id' in ac) {
   282→                const acObj = ac as AcceptanceCriterion;
   283→                console.log(chalk.cyan(`  [${acObj.id}]`));
   284→                if (acObj.given) console.log(`    Given: ${acObj.given}`);
   285→                if (acObj.when) console.log(`    When: ${acObj.when}`);
   286→                if (acObj.then) console.log(`    Then: ${acObj.then}`);
   287→              }
   288→            }
   289→          }
   290→        });
   291→      } catch (err) {
   292→        error(errors.failures.getItem, err);
   293→        process.exit(1);
   294→      }
   295→    });
   296→
   297→  // kspec item types - show available types and counts
   298→  item
   299→    .command('types')
   300→    .description('Show item types and counts')
   301→    .action(async () => {
   302→      try {
   303→        const ctx = await initContext();
   304→        const { itemIndex } = await buildIndexes(ctx);
   305→
   306→        const typeCounts = itemIndex.getTypeCounts();
   307→
   308→        output(
   309→          Object.fromEntries(typeCounts),
   310→          () => {
   311→            console.log(chalk.bold('Item Types'));
   312→            console.log(chalk.gray('─'.repeat(30)));
   313→            for (const [type, count] of typeCounts) {
   314→              console.log(`  ${type}: ${count}`);
   315→            }
   316→            console.log(chalk.gray(`\nTotal: ${itemIndex.size} items`));
   317→          }
   318→        );
   319→      } catch (err) {
   320→        error(errors.failures.getTypes, err);
   321→        process.exit(1);
   322→      }
   323→    });
   324→
   325→  // kspec item tags - show available tags and counts
   326→  item
   327→    .command('tags')
   328→    .description('Show tags and counts')
   329→    .action(async () => {
   330→      try {
   331→        const ctx = await initContext();
   332→        const { itemIndex } = await buildIndexes(ctx);
   333→
   334→        const tagCounts = itemIndex.getTagCounts();
   335→
   336→        output(
   337→          Object.fromEntries(tagCounts),
   338→          () => {
   339→            console.log(chalk.bold('Tags'));
   340→            console.log(chalk.gray('─'.repeat(30)));
   341→            for (const [tag, count] of tagCounts) {
   342→              console.log(`  #${tag}: ${count}`);
   343→            }
   344→          }
   345→        );
   346→      } catch (err) {
   347→        error(errors.failures.getTags, err);
   348→        process.exit(1);
   349→      }
   350→    });
   351→
   352→  // kspec item add - create a new spec item under a parent
   353→  item
   354→    .command('add')
   355→    .description('Create a new spec item under a parent')
   356→    .requiredOption('--under <ref>', 'Parent item reference (e.g., @core-primitives)')
   357→    .requiredOption('--title <title>', 'Item title')
   358→    .option('--type <type>', 'Item type (feature, requirement, constraint, decision)', 'feature')
   359→    .option('--slug <slug>', 'Human-friendly slug')
   360→    .option('--priority <priority>', 'Priority (high, medium, low)')
   361→    .option('--tag <tag...>', 'Tags')
   362→    .option('--description <desc>', 'Description')
   363→    .option('--as <field>', 'Child field override (e.g., requirements, constraints)')
   364→    .action(async (options) => {
   365→      try {
   366→        const ctx = await initContext();
   367→        const { refIndex, items } = await buildIndexes(ctx);
   368→
   369→        // Find the parent item
   370→        const parentResult = refIndex.resolve(options.under);
   371→        if (!parentResult.ok) {
   372→          error(errors.reference.itemNotFound(options.under));
   373→          process.exit(1);
   374→        }
   375→
   376→        const parent = parentResult.item as LoadedSpecItem;
   377→
   378→        // Check it's not a task
   379→        if ('status' in parent && typeof parent.status === 'string') {
   380→          error(errors.reference.parentIsTask(options.under));
   381→          process.exit(1);
   382→        }
   383→
   384→        // Check slug uniqueness if provided
   385→        if (options.slug) {
   386→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug]);
   387→          if (!slugCheck.ok) {
   388→            error(errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid));
   389→            process.exit(1);
   390→          }
   391→        }
   392→
   393→        const input: SpecItemInput = {
   394→          title: options.title,
   395→          type: options.type as ItemType,
   396→          slugs: options.slug ? [options.slug] : [],
   397→          priority: options.priority,
   398→          tags: options.tag || [],
   399→          description: options.description,
   400→          depends_on: [],
   401→          implements: [],
   402→          relates_to: [],
   403→          tests: [],
   404→        };
   405→
   406→        const newItem = createSpecItem(input);
   407→        const result = await addChildItem(ctx, parent, newItem, options.as);
   408→
   409→        // Build index including the new item for accurate short ULID
   410→        const index = new ReferenceIndex([], [...items, result.item as LoadedSpecItem]);
   411→        const itemSlug = (result.item as LoadedSpecItem).slugs?.[0] || index.shortUlid(result.item._ulid);
   412→        await commitIfShadow(ctx.shadow, 'item-add', itemSlug);
   413→        success(`Created item: ${index.shortUlid(result.item._ulid)} under @${parent.slugs[0] || parent._ulid.slice(0, 8)}`, {
   414→          item: result.item,
   415→          path: result.path,
   416→        });
   417→
   418→        // Derive hint
   419→        if (!isJsonMode()) {
   420→          const refSlug = (result.item as LoadedSpecItem).slugs?.[0] || index.shortUlid(result.item._ulid);
   421→          console.log(chalk.gray(`\nDerive implementation task? kspec derive @${refSlug}`));
   422→        }
   423→      } catch (err) {
   424→        error(errors.failures.createItem, err);
   425→        process.exit(1);
   426→      }
   427→    });
   428→
   429→  // kspec item set - update a spec item field
   430→  item
   431→    .command('set <ref>')
   432→    .description('Update a spec item field')
   433→    .option('--title <title>', 'Set title')
   434→    .option('--type <type>', 'Set type')
   435→    .option('--slug <slug>', 'Add a slug')
   436→    .option('--remove-slug <slug>', 'Remove a slug')
   437→    .option('--priority <priority>', 'Set priority')
   438→    .option('--tag <tag...>', 'Set tags (replaces existing)')
   439→    .option('--description <desc>', 'Set description')
   440→    .option('--status <status>', 'Set implementation status (not_started, in_progress, implemented, verified)')
   441→    .option('--maturity <maturity>', 'Set maturity (draft, proposed, stable, deprecated)')
   442→    .action(async (ref, options) => {
   443→      try {
   444→        const ctx = await initContext();
   445→        const { refIndex, items } = await buildIndexes(ctx);
   446→
   447→        const result = refIndex.resolve(ref);
   448→        if (!result.ok) {
   449→          error(errors.reference.itemNotFound(ref));
   450→          process.exit(1);
   451→        }
   452→
   453→        const foundItem = result.item as LoadedSpecItem;
   454→
   455→        // Check if it's a task (tasks should use task commands)
   456→        if ('status' in foundItem && typeof foundItem.status === 'string') {
   457→          error(errors.reference.taskUseTaskCommands(ref));
   458→          process.exit(1);
   459→        }
   460→
   461→        // Check slug uniqueness if adding a new slug
   462→        if (options.slug) {
   463→          const slugCheck = checkSlugUniqueness(refIndex, [options.slug], foundItem._ulid);
   464→          if (!slugCheck.ok) {
   465→            error(errors.slug.alreadyExists(slugCheck.slug, slugCheck.existingUlid));
   466→            process.exit(1);
   467→          }
   468→        }
   469→
   470→        // Validate --remove-slug
   471→        if (options.removeSlug) {
   472→          const currentSlugs = foundItem.slugs || [];
   473→          if (!currentSlugs.includes(options.removeSlug)) {
   474→            error(errors.slug.notFound(options.removeSlug));
   475→            process.exit(1);
   476→          }
   477→          if (currentSlugs.length === 1) {
   478→            error(errors.slug.cannotRemoveLast(options.removeSlug));
   479→            process.exit(1);
   480→          }
   481→        }
   482→
   483→        // Build updates object
   484→        const updates: Partial<SpecItemInput> = {};
   485→
   486→        if (options.title) updates.title = options.title;
   487→        if (options.type) updates.type = options.type as ItemType;
   488→        if (options.slug || options.removeSlug) {
   489→          let slugs = [...(foundItem.slugs || [])];
   490→          if (options.removeSlug) {
   491→            slugs = slugs.filter(s => s !== options.removeSlug);
   492→          }
   493→          if (options.slug) {
   494→            slugs.push(options.slug);
   495→          }
   496→          updates.slugs = slugs;
   497→        }
   498→        if (options.priority) updates.priority = options.priority;
   499→        if (options.tag) updates.tags = options.tag;
   500→        if (options.description) updates.description = options.description;
   501→
   502→        // Handle status updates
   503→        if (options.status || options.maturity) {
   504→          const currentStatus = foundItem.status && typeof foundItem.status === 'object'
   505→            ? foundItem.status
   506→            : {};
   507→          updates.status = {
   508→            ...currentStatus,
   509→            ...(options.status && { implementation: options.status }),
   510→            ...(options.maturity && { maturity: options.maturity }),
   511→          };
   512→        }
   513→
   514→        if (Object.keys(updates).length === 0) {
   515→          warn('No updates specified');
   516→          return;
   517→        }
   518→
   519→        const updated = await updateSpecItem(ctx, foundItem, updates);
   520→        const itemSlug = foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
   521→
   522→        // Handle cascade for implementation status updates
   523→        const updatedItems: LoadedSpecItem[] = [updated];
   524→        if (options.status) {
   525→          const cascadeResult = await handleStatusCascade(ctx, updated, options.status, items, refIndex);
   526→          updatedItems.push(...cascadeResult);
   527→        }
   528→
   529→        await commitIfShadow(ctx.shadow, 'item-set', itemSlug);
   530→        success(`Updated item: ${refIndex.shortUlid(updated._ulid)}`, { item: updated });
   531→
   532→        // Derive hint
   533→        if (!isJsonMode()) {
   534→          const refSlug = updated.slugs?.[0] || refIndex.shortUlid(updated._ulid);
   535→          console.log(chalk.gray(`\nDerive implementation task? kspec derive @${refSlug}`));
   536→        }
   537→      } catch (err) {
   538→        error(errors.failures.updateItem, err);
   539→        process.exit(1);
   540→      }
   541→    });
   542→
   543→  // kspec item delete - delete a spec item
   544→  item
   545→    .command('delete <ref>')
   546→    .description('Delete a spec item (including nested items)')
   547→    .option('--force', 'Skip confirmation')
   548→    .action(async (ref, options) => {
   549→      try {
   550→        const ctx = await initContext();
   551→        const { refIndex, items } = await buildIndexes(ctx);
   552→
   553→        const result = refIndex.resolve(ref);
   554→        if (!result.ok) {
   555→          error(errors.reference.itemNotFound(ref));
   556→          process.exit(1);
   557→        }
   558→
   559→        const foundItem = result.item as LoadedSpecItem;
   560→
   561→        // Check if it's a task
   562→        if ('status' in foundItem && typeof foundItem.status === 'string') {
   563→          error(errors.reference.itemUseTaskCancel(ref));
   564→          process.exit(1);
   565→        }
   566→
   567→        if (!foundItem._sourceFile) {
   568→          error(errors.operation.cannotDeleteNoSource);
   569→          process.exit(1);
   570→        }
   571→
   572→        // Warn about nested children being deleted too
   573→        // TODO: could add a check here for child items
   574→
   575→        const deleted = await deleteSpecItem(ctx, foundItem);
   576→        if (deleted) {
   577→          const itemSlug = foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
   578→          await commitIfShadow(ctx.shadow, 'item-delete', itemSlug);
   579→          success(`Deleted item: ${foundItem.title}`, { deleted: true, ulid: foundItem._ulid });
   580→        } else {
   581→          error(errors.failures.deleteItem);
   582→          console.log(chalk.gray('Edit the source file directly: ' + foundItem._sourceFile));
   583→          process.exit(1);
   584→        }
   585→      } catch (err) {
   586→        error(errors.failures.deleteItem, err);
   587→        process.exit(1);
   588→      }
   589→    });
   590→
   591→  // kspec item patch - update item fields via JSON
   592→  item
   593→    .command('patch [ref]')
   594→    .description('Update spec item fields via JSON patch')
   595→    .option('--data <json>', 'JSON data to patch')
   596→    .option('--bulk', 'Read patches from stdin (JSONL or JSON array)')
   597→    .option('--allow-unknown', 'Allow fields not in schema')
   598→    .option('--dry-run', 'Preview changes without applying')
   599→    .option('--fail-fast', 'Stop on first error (bulk mode)')
   600→    .action(async (ref: string | undefined, options) => {
   601→      try {
   602→        const ctx = await initContext();
   603→
   604→        if (options.bulk) {
   605→          // Bulk mode: read from stdin
   606→          const stdin = await readStdinFully();
   607→          if (!stdin) {
   608→            error(errors.validation.noInputProvided);
   609→            process.exit(1);
   610→          }
   611→
   612→          let patches: PatchOperation[];
   613→          try {
   614→            patches = parseBulkInput(stdin);
   615→          } catch (err) {
   616→            error(errors.validation.failedToParseBulk(err instanceof Error ? err.message : String(err)));
   617→            process.exit(1);
   618→          }
   619→
   620→          if (patches.length === 0) {
   621→            error(errors.validation.noPatchesProvided);
   622→            process.exit(1);
   623→          }
   624→
   625→          const { refIndex, items } = await buildIndexes(ctx);
   626→          const result = await patchSpecItems(ctx, refIndex, items, patches, {
   627→            allowUnknown: options.allowUnknown,
   628→            failFast: options.failFast,
   629→            dryRun: options.dryRun,
   630→          });
   631→
   632→          // Shadow commit if any updates
   633→          if (!options.dryRun && result.summary.updated > 0) {
   634→            await commitIfShadow(ctx.shadow, 'item-patch', `${result.summary.updated} items`);
   635→          }
   636→
   637→          output(result, () => formatBulkPatchResult(result, options.dryRun));
   638→
   639→          if (result.summary.failed > 0) {
   640→            process.exit(1);
   641→          }
   642→        } else {
   643→          // Single item mode
   644→          if (!ref) {
   645→            error(errors.usage.patchNeedRef);
   646→            process.exit(1);
   647→          }
   648→
   649→          let data: Record<string, unknown>;
   650→
   651→          // Get data from --data option or stdin
   652→          if (options.data) {
   653→            try {
   654→              data = JSON.parse(options.data);
   655→            } catch (err) {
   656→              error(errors.validation.invalidJsonInData(err instanceof Error ? err.message : ''));
   657→              process.exit(1);
   658→            }
   659→          } else {
   660→            const stdin = await readStdinIfAvailable();
   661→            if (stdin) {
   662→              try {
   663→                data = JSON.parse(stdin.trim());
   664→              } catch (err) {
   665→                error(errors.validation.invalidJsonFromStdin(err instanceof Error ? err.message : ''));
   666→                process.exit(1);
   667→              }
   668→            } else {
   669→              error(errors.validation.noPatchData);
   670→              process.exit(1);
   671→            }
   672→          }
   673→
   674→          // Validate against schema (unless --allow-unknown)
   675→          if (!options.allowUnknown) {
   676→            // Use strict schema (no passthrough)
   677→            const strictSchema = SpecItemPatchSchema.strict();
   678→            const parseResult = strictSchema.safeParse(data);
   679→            if (!parseResult.success) {
   680→              const issues = parseResult.error.issues.map(i => `${i.path.join('.')}: ${i.message}`).join('; ');
   681→              error(errors.validation.invalidPatchDataWithIssues(issues));
   682→              process.exit(1);
   683→            }
   684→          }
   685→
   686→          const { refIndex, items } = await buildIndexes(ctx);
   687→
   688→          // Resolve ref
   689→          const resolved = refIndex.resolve(ref);
   690→          if (!resolved.ok) {
   691→            error(errors.reference.itemNotFound(ref));
   692→            process.exit(1);
   693→          }
   694→
   695→          // Find the item
   696→          const foundItem = items.find(i => i._ulid === resolved.ulid);
   697→          if (!foundItem) {
   698→            error(errors.reference.notItem(ref));
   699→            process.exit(1);
   700→          }
   701→
   702→          if (options.dryRun) {
   703→            output({ ref, data, wouldApplyTo: foundItem.title, ulid: foundItem._ulid }, () => {
   704→              console.log(chalk.yellow('Would patch:'), foundItem.title);
   705→              console.log(chalk.gray('ULID:'), foundItem._ulid.slice(0, 8));
   706→              console.log(chalk.gray('Changes:'));
   707→              console.log(JSON.stringify(data, null, 2));
   708→            });
   709→            return;
   710→          }
   711→
   712→          const updated = await updateSpecItem(ctx, foundItem, data);
   713→          const itemSlug = foundItem.slugs[0] || refIndex.shortUlid(foundItem._ulid);
   714→          await commitIfShadow(ctx.shadow, 'item-patch', itemSlug);
   715→
   716→          success(`Patched item: ${itemSlug}`, { item: updated });
   717→        }
   718→      } catch (err) {
   719→        error(errors.failures.patchItems, err);
   720→        process.exit(1);
   721→      }
   722→    });
   723→
   724→  // kspec item status - show implementation status with linked tasks
   725→  item
   726→    .command('status <ref>')
   727→    .description('Show implementation status and linked tasks for a spec item')
   728→    .action(async (ref) => {
   729→      try {
   730→        const ctx = await initContext();
   731→        const tasks = await loadAllTasks(ctx);
   732→        const items = await loadAllItems(ctx);
   733→        const refIndex = new ReferenceIndex(tasks, items);
   734→
   735→        const result = refIndex.resolve(ref);
   736→        if (!result.ok) {
   737→          error(errors.reference.itemNotFound(ref));
   738→          process.exit(1);
   739→        }
   740→
   741→        const foundItem = result.item as LoadedSpecItem;
   742→
   743→        // Check if it's a task
   744→        if ('status' in foundItem && typeof foundItem.status === 'string') {
   745→          error(errors.reference.notItem(ref));
   746→          process.exit(1);
   747→        }
   748→
   749→        // Build alignment index
   750→        const alignmentIndex = new AlignmentIndex(tasks, items);
   751→        alignmentIndex.buildLinks(refIndex);
   752→
   753→        const summary = alignmentIndex.getImplementationSummary(foundItem._ulid);
   754→
   755→        if (!summary) {
   756→          error(errors.project.couldNotGetImplSummary);
   757→          process.exit(1);
   758→        }
   759→
   760→        output(summary, () => {
   761→          console.log(chalk.bold(foundItem.title));
   762→          console.log(chalk.gray('─'.repeat(40)));
   763→
   764→          // Status
   765→          const currentColor = summary.currentStatus === 'implemented' ? chalk.green
   766→            : summary.currentStatus === 'in_progress' ? chalk.yellow
   767→              : chalk.gray;
   768→          const expectedColor = summary.expectedStatus === 'implemented' ? chalk.green
   769→            : summary.expectedStatus === 'in_progress' ? chalk.yellow
   770→              : chalk.gray;
   771→
   772→          console.log(`Current status:  ${currentColor(summary.currentStatus)}`);
   773→          console.log(`Expected status: ${expectedColor(summary.expectedStatus)}`);
   774→
   775→          if (!summary.isAligned) {
   776→            console.log(chalk.yellow('\n⚠ Status mismatch - run task complete to sync'));
   777→          } else {
   778→            console.log(chalk.green('\n✓ Aligned'));
   779→          }
   780→
   781→          // Linked tasks
   782→          console.log(chalk.bold('\nLinked Tasks:'));
   783→          if (summary.linkedTasks.length === 0) {
   784→            console.log(chalk.gray('  No tasks reference this spec item'));
   785→          } else {
   786→            for (const task of summary.linkedTasks) {
   787→              const statusColor = task.taskStatus === 'completed' ? chalk.green
   788→                : task.taskStatus === 'in_progress' ? chalk.blue
   789→                  : chalk.gray;
   790→              const shortId = task.taskUlid.slice(0, 8);
   791→              const notes = task.hasNotes ? chalk.gray(' (has notes)') : '';
   792→              console.log(`  ${statusColor(`[${task.taskStatus}]`)} ${shortId} ${task.taskTitle}${notes}`);
   793→            }
   794→          }
   795→        });
   796→      } catch (err) {
   797→        error(errors.failures.getItemStatus, err);
   798→        process.exit(1);
   799→      }
   800→    });
   801→
   802→  // Create subcommand group for acceptance criteria operations
   803→  const acCmd = item
   804→    .command('ac')
   805→    .description('Manage acceptance criteria on spec items');
   806→
   807→  // Helper: Generate next AC ID based on existing AC
   808→  function generateNextAcId(existingAc: AcceptanceCriterion[] | undefined): string {
   809→    if (!existingAc || existingAc.length === 0) return 'ac-1';
   810→
   811→    const numericIds = existingAc
   812→      .map(ac => ac.id.match(/^ac-(\d+)$/)?.[1])
   813→      .filter((id): id is string => id !== null && id !== undefined)
   814→      .map(Number);
   815→
   816→    const maxId = numericIds.length > 0 ? Math.max(...numericIds) : 0;
   817→    return `ac-${maxId + 1}`;
   818→  }
   819→
   820→  // Helper: Resolve ref to spec item (not task)
   821→  async function resolveSpecItem(ref: string): Promise<{ ctx: Awaited<ReturnType<typeof initContext>>; item: LoadedSpecItem; refIndex: ReferenceIndex }> {
   822→    const ctx = await initContext();
   823→    const { refIndex, items } = await buildIndexes(ctx);
   824→
   825→    const result = refIndex.resolve(ref);
   826→    if (!result.ok) {
   827→      error(errors.reference.itemNotFound(ref));
   828→      process.exit(3);
   829→    }
   830→
   831→    const foundItem = result.item as LoadedSpecItem;
   832→
   833→    // Check if it's a task
   834→    if ('status' in foundItem && typeof foundItem.status === 'string') {
   835→      error(errors.operation.tasksNoAcceptanceCriteria(ref));
   836→      process.exit(3);
   837→    }
   838→
   839→    return { ctx, item: foundItem, refIndex };
   840→  }
   841→
   842→  // kspec item ac list <ref>
   843→  acCmd
   844→    .command('list <ref>')
   845→    .description('List acceptance criteria for a spec item')
   846→    .action(async (ref: string) => {
   847→      try {
   848→        const { item, refIndex } = await resolveSpecItem(ref);
   849→        const ac = item.acceptance_criteria || [];
   850→
   851→        output(ac, () => {
   852→          console.log(chalk.bold(`Acceptance Criteria for: ${item.title} (@${item.slugs[0] || refIndex.shortUlid(item._ulid)})`));
   853→          console.log();
   854→
   855→          if (ac.length === 0) {
   856→            console.log(chalk.gray('No acceptance criteria'));
   857→          } else {
   858→            for (const criterion of ac) {
   859→              console.log(chalk.cyan(`  [${criterion.id}]`));
   860→              console.log(chalk.gray(`    Given: ${criterion.given}`));
   861→              console.log(chalk.gray(`    When:  ${criterion.when}`));
   862→              console.log(chalk.gray(`    Then:  ${criterion.then}`));
   863→              console.log();
   864→            }
   865→          }
   866→
   867→          console.log(chalk.gray(`${ac.length} acceptance criteria`));
   868→        });
   869→      } catch (err) {
   870→        error(errors.failures.listAc, err);
   871→        process.exit(1);
   872→      }
   873→    });
   874→
   875→  // kspec item ac add <ref>
   876→  acCmd
   877→    .command('add <ref>')
   878→    .description('Add an acceptance criterion to a spec item')
   879→    .option('--id <id>', 'AC identifier (auto-generated if not provided)')
   880→    .requiredOption('--given <text>', 'The precondition (Given...)')
   881→    .requiredOption('--when <text>', 'The action/trigger (When...)')
   882→    .requiredOption('--then <text>', 'The expected outcome (Then...)')
   883→    .action(async (ref: string, options) => {
   884→      try {
   885→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
   886→        const existingAc = item.acceptance_criteria || [];
   887→
   888→        // Determine ID
   889→        const acId = options.id || generateNextAcId(existingAc);
   890→
   891→        // Check for duplicate ID
   892→        if (existingAc.some(ac => ac.id === acId)) {
   893→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
   894→          error(errors.conflict.acAlreadyExists(acId, itemRef));
   895→          process.exit(3);
   896→        }
   897→
   898→        // Create new AC
   899→        const newAc: AcceptanceCriterion = {
   900→          id: acId,
   901→          given: options.given,
   902→          when: options.when,
   903→          then: options.then,
   904→        };
   905→
   906→        // Update item with new AC
   907→        const updatedAc = [...existingAc, newAc];
   908→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
   909→
   910→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
   911→        await commitIfShadow(ctx.shadow, 'item-ac-add', itemSlug);
   912→        success(`Added acceptance criterion: ${acId} to @${itemSlug}`, { ac: newAc });
   913→      } catch (err) {
   914→        error(errors.failures.addAc, err);
   915→        process.exit(1);
   916→      }
   917→    });
   918→
   919→  // kspec item ac set <ref> <ac-id>
   920→  acCmd
   921→    .command('set <ref> <acId>')
   922→    .description('Update an acceptance criterion')
   923→    .option('--id <newId>', 'Rename the AC ID')
   924→    .option('--given <text>', 'Update the precondition')
   925→    .option('--when <text>', 'Update the action/trigger')
   926→    .option('--then <text>', 'Update the expected outcome')
   927→    .action(async (ref: string, acId: string, options) => {
   928→      try {
   929→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
   930→        const existingAc = item.acceptance_criteria || [];
   931→
   932→        // Find the AC
   933→        const acIndex = existingAc.findIndex(ac => ac.id === acId);
   934→        if (acIndex === -1) {
   935→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
   936→          error(errors.reference.acNotFound(acId, itemRef));
   937→          process.exit(3);
   938→        }
   939→
   940→        // Check for no updates
   941→        if (!options.id && !options.given && !options.when && !options.then) {
   942→          warn('No updates specified');
   943→          return;
   944→        }
   945→
   946→        // Check for duplicate ID if renaming
   947→        if (options.id && options.id !== acId && existingAc.some(ac => ac.id === options.id)) {
   948→          error(errors.conflict.acIdAlreadyExists(options.id));
   949→          process.exit(3);
   950→        }
   951→
   952→        // Build updated AC
   953→        const updatedAc = [...existingAc];
   954→        const updatedFields: string[] = [];
   955→
   956→        updatedAc[acIndex] = {
   957→          ...updatedAc[acIndex],
   958→          ...(options.id && { id: options.id }),
   959→          ...(options.given && { given: options.given }),
   960→          ...(options.when && { when: options.when }),
   961→          ...(options.then && { then: options.then }),
   962→        };
   963→
   964→        if (options.id) updatedFields.push('id');
   965→        if (options.given) updatedFields.push('given');
   966→        if (options.when) updatedFields.push('when');
   967→        if (options.then) updatedFields.push('then');
   968→
   969→        // Update item
   970→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
   971→
   972→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
   973→        await commitIfShadow(ctx.shadow, 'item-ac-set', itemSlug);
   974→        success(`Updated acceptance criterion: ${acId} on @${itemSlug} (${updatedFields.join(', ')})`, { ac: updatedAc[acIndex] });
   975→      } catch (err) {
   976→        error(errors.failures.updateAc, err);
   977→        process.exit(1);
   978→      }
   979→    });
   980→
   981→  // kspec item ac remove <ref> <ac-id>
   982→  acCmd
   983→    .command('remove <ref> <acId>')
   984→    .description('Remove an acceptance criterion')
   985→    .option('--force', 'Skip confirmation')
   986→    .action(async (ref: string, acId: string, options) => {
   987→      try {
   988→        const { ctx, item, refIndex } = await resolveSpecItem(ref);
   989→        const existingAc = item.acceptance_criteria || [];
   990→
   991→        // Find the AC
   992→        const acIndex = existingAc.findIndex(ac => ac.id === acId);
   993→        if (acIndex === -1) {
   994→          const itemRef = item.slugs[0] || refIndex.shortUlid(item._ulid);
   995→          error(errors.reference.acNotFound(acId, itemRef));
   996→          process.exit(3);
   997→        }
   998→
   999→        // TODO: Add confirmation prompt when !options.force
  1000→        // For now, proceed with deletion
  1001→
  1002→        // Remove the AC
  1003→        const updatedAc = existingAc.filter(ac => ac.id !== acId);
  1004→        await updateSpecItem(ctx, item, { acceptance_criteria: updatedAc });
  1005→
  1006→        const itemSlug = item.slugs[0] || refIndex.shortUlid(item._ulid);
  1007→        await commitIfShadow(ctx.shadow, 'item-ac-remove', itemSlug);
  1008→        success(`Removed acceptance criterion: ${acId} from @${itemSlug}`, { removed: acId });
  1009→      } catch (err) {
  1010→        error(errors.failures.removeAc, err);
  1011→        process.exit(1);
  1012→      }
  1013→    });
  1014→}
  1015→
  1016→// ─── Patch Helpers ───────────────────────────────────────────────────────────
  1017→
  1018→/**
  1019→ * Read stdin fully with timeout (for bulk input).
  1020→ * Returns null if stdin is a TTY or empty.
  1021→ */
  1022→async function readStdinFully(): Promise<string | null> {
  1023→  if (process.stdin.isTTY) {
  1024→    return null;
  1025→  }
  1026→
  1027→  return new Promise((resolve) => {
  1028→    let data = '';
  1029→    const timeout = setTimeout(() => {
  1030→      process.stdin.removeAllListeners();
  1031→      resolve(data || null);
  1032→    }, 5000); // 5 second timeout for bulk input
  1033→
  1034→    process.stdin.setEncoding('utf8');
  1035→    process.stdin.on('data', (chunk) => {
  1036→      data += chunk;
  1037→    });
  1038→    process.stdin.on('end', () => {
  1039→      clearTimeout(timeout);
  1040→      resolve(data || null);
  1041→    });
  1042→    process.stdin.on('error', () => {
  1043→      clearTimeout(timeout);
  1044→      resolve(null);
  1045→    });
  1046→    process.stdin.resume();
  1047→  });
  1048→}
  1049→
  1050→/**
  1051→ * Read stdin if available (non-blocking for single item mode).
  1052→ * Returns null quickly if no data available.
  1053→ */
  1054→async function readStdinIfAvailable(): Promise<string | null> {
  1055→  if (process.stdin.isTTY) {
  1056→    return null;
  1057→  }
  1058→
  1059→  return new Promise((resolve) => {
  1060→    let data = '';
  1061→    const timeout = setTimeout(() => {
  1062→      process.stdin.removeAllListeners();
  1063→      resolve(data || null);
  1064→    }, 100); // 100ms timeout for quick check
  1065→
  1066→    process.stdin.setEncoding('utf8');
  1067→    process.stdin.on('data', (chunk) => {
  1068→      data += chunk;
  1069→    });
  1070→    process.stdin.on('end', () => {
  1071→      clearTimeout(timeout);
  1072→      resolve(data || null);
  1073→    });
  1074→    process.stdin.on('error', () => {
  1075→      clearTimeout(timeout);
  1076→      resolve(null);
  1077→    });
  1078→    process.stdin.resume();
  1079→  });
  1080→}
  1081→
  1082→/**
  1083→ * Parse bulk input (JSONL or JSON array)
  1084→ */
  1085→function parseBulkInput(input: string): PatchOperation[] {
  1086→  const trimmed = input.trim();
  1087→
  1088→  // Try JSON array first
  1089→  if (trimmed.startsWith('[')) {
  1090→    const parsed = JSON.parse(trimmed);
  1091→    if (!Array.isArray(parsed)) {
  1092→      throw new Error(errors.validation.expectedJsonArray);
  1093→    }
  1094→    return parsed.map((item, i) => validatePatchOperation(item, i));
  1095→  }
  1096→
  1097→  // Parse as JSONL (one JSON object per line)
  1098→  const lines = trimmed.split('\n').filter(line => line.trim());
  1099→  return lines.map((line, i) => {
  1100→    try {
  1101→      return validatePatchOperation(JSON.parse(line), i);
  1102→    } catch (err) {
  1103→      throw new Error(errors.validation.jsonLineError(i + 1, err instanceof Error ? err.message : 'Invalid JSON'));
  1104→    }
  1105→  });
  1106→}
  1107→
  1108→/**
  1109→ * Validate a patch operation object
  1110→ */
  1111→function validatePatchOperation(obj: unknown, index: number): PatchOperation {
  1112→  if (!obj || typeof obj !== 'object') {
  1113→    throw new Error(errors.validation.patchMustBeObject(index));
  1114→  }
  1115→  const op = obj as Record<string, unknown>;
  1116→  if (typeof op.ref !== 'string' || !op.ref) {
  1117→    throw new Error(errors.validation.patchMustHaveRef(index));
  1118→  }
  1119→  if (!op.data || typeof op.data !== 'object') {
  1120→    throw new Error(errors.validation.patchMustHaveData(index));
  1121→  }
  1122→  return { ref: op.ref, data: op.data as Record<string, unknown> };
  1123→}
  1124→
  1125→/**
  1126→ * Format bulk patch result for human output
  1127→ */
  1128→function formatBulkPatchResult(result: BulkPatchResult, isDryRun = false): void {
  1129→  const prefix = isDryRun ? 'Would patch' : 'Patched';
  1130→
  1131→  for (const r of result.results) {
  1132→    if (r.status === 'updated') {
  1133→      console.log(chalk.green('OK'), `${prefix}: ${r.ref} (${r.ulid?.slice(0, 8)})`);
  1134→    } else if (r.status === 'error') {
  1135→      console.log(chalk.red('ERR'), `${r.ref}: ${r.error}`);
  1136→    } else {
  1137→      console.log(chalk.gray('SKIP'), r.ref);
  1138→    }
  1139→  }
  1140→
  1141→  console.log('');
