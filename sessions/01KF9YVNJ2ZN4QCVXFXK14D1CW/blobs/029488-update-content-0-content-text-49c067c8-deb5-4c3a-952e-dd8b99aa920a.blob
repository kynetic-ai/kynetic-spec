     1→import * as path from 'node:path';
     2→import { Command } from 'commander';
     3→import chalk from 'chalk';
     4→import {
     5→  initContext,
     6→  validate,
     7→  loadAllTasks,
     8→  loadAllItems,
     9→  AlignmentIndex,
    10→  ReferenceIndex,
    11→  fixFiles,
    12→  findTaskFiles,
    13→  expandIncludePattern,
    14→  loadMetaContext,
    15→  validateConventions,
    16→  type ValidationResult,
    17→  type AlignmentWarning,
    18→  type CompletenessWarning,
    19→  type FixResult,
    20→  type ConventionValidationResult,
    21→} from '../../parser/index.js';
    22→import { output, success, error, info } from '../output.js';
    23→import { validation as validationStrings } from '../../strings/index.js';
    24→import { EXIT_CODES } from '../exit-codes.js';
    25→
    26→/**
    27→ * Format convention validation results for display
    28→ * AC: @convention-definitions ac-3, ac-4
    29→ */
    30→function formatConventionValidationResult(result: ConventionValidationResult): void {
    31→  if (result.valid && result.skipped.length === 0) {
    32→    console.log(chalk.green('Conventions: OK'));
    33→    return;
    34→  }
    35→
    36→  // AC: @convention-definitions ac-4
    37→  // Skipped prose conventions
    38→  if (result.skipped.length > 0) {
    39→    for (const domain of result.skipped) {
    40→      console.log(chalk.gray(`ℹ Skipping prose convention: ${domain}`));
    41→    }
    42→  }
    43→
    44→  // AC: @convention-definitions ac-3
    45→  // Validation errors
    46→  if (result.errors.length > 0) {
    47→    console.log(chalk.red(`\nConvention violations: ${result.errors.length}`));
    48→    for (const err of result.errors) {
    49→      console.log(chalk.red(`  ✗ ${err.domain}`));
    50→      console.log(chalk.gray(`    ${err.message}`));
    51→      if (err.expected) {
    52→        console.log(chalk.gray(`    Expected: ${err.expected}`));
    53→      }
    54→      if (err.location) {
    55→        console.log(chalk.gray(`    Location: ${err.location}`));
    56→      }
    57→    }
    58→  } else {
    59→    console.log(chalk.green('\nConventions: OK'));
    60→  }
    61→
    62→  // Stats
    63→  console.log(chalk.gray(`\nConventions checked: ${result.stats.conventionsChecked}`));
    64→  console.log(chalk.gray(`Conventions skipped: ${result.stats.conventionsSkipped}`));
    65→}
    66→
    67→/**
    68→ * Format completeness warnings for display
    69→ * AC: @spec-completeness ac-4
    70→ */
    71→function formatCompletenessWarnings(warnings: CompletenessWarning[], verbose: boolean): void {
    72→  if (warnings.length === 0) {
    73→    console.log(chalk.green('Completeness: OK'));
    74→    return;
    75→  }
    76→
    77→  console.log(chalk.yellow(`\nCompleteness warnings: ${warnings.length}`));
    78→
    79→  // Group by type
    80→  const missingAC = warnings.filter(w => w.type === 'missing_acceptance_criteria');
    81→  const missingDesc = warnings.filter(w => w.type === 'missing_description');
    82→  const statusMismatch = warnings.filter(w => w.type === 'status_inconsistency');
    83→  const missingTestCoverage = warnings.filter(w => w.type === 'missing_test_coverage');
    84→
    85→  // AC: @spec-completeness ac-4
    86→  // Show summary with counts by issue type
    87→  if (missingAC.length > 0) {
    88→    console.log(chalk.yellow(`  Missing acceptance criteria: ${missingAC.length}`));
    89→    const shown = verbose ? missingAC : missingAC.slice(0, 3);
    90→    for (const w of shown) {
    91→      console.log(chalk.gray(`    ○ ${w.itemRef} - ${w.itemTitle}`));
    92→    }
    93→    if (!verbose && missingAC.length > 3) {
    94→      console.log(chalk.gray(`    ... and ${missingAC.length - 3} more`));
    95→    }
    96→  }
    97→
    98→  if (missingDesc.length > 0) {
    99→    console.log(chalk.yellow(`  Missing descriptions: ${missingDesc.length}`));
   100→    const shown = verbose ? missingDesc : missingDesc.slice(0, 3);
   101→    for (const w of shown) {
   102→      console.log(chalk.gray(`    ○ ${w.itemRef} - ${w.itemTitle}`));
   103→    }
   104→    if (!verbose && missingDesc.length > 3) {
   105→      console.log(chalk.gray(`    ... and ${missingDesc.length - 3} more`));
   106→    }
   107→  }
   108→
   109→  if (statusMismatch.length > 0) {
   110→    console.log(chalk.yellow(`  Status inconsistencies: ${statusMismatch.length}`));
   111→    for (const w of statusMismatch) {
   112→      console.log(chalk.yellow(`    ! ${w.message}`));
   113→      if (w.details) {
   114→        console.log(chalk.gray(`      ${w.details}`));
   115→      }
   116→    }
   117→  }
   118→
   119→  if (missingTestCoverage.length > 0) {
   120→    console.log(chalk.yellow(`  Missing test coverage: ${missingTestCoverage.length}`));
   121→    const shown = verbose ? missingTestCoverage : missingTestCoverage.slice(0, 3);
   122→    for (const w of shown) {
   123→      console.log(chalk.yellow(`    ! ${w.itemRef} - ${w.itemTitle}`));
   124→      if (w.details) {
   125→        console.log(chalk.gray(`      ${w.details}`));
   126→      }
   127→    }
   128→    if (!verbose && missingTestCoverage.length > 3) {
   129→      console.log(chalk.gray(`    ... and ${missingTestCoverage.length - 3} more`));
   130→    }
   131→  }
   132→}
   133→
   134→/**
   135→ * Format alignment warnings for display
   136→ */
   137→function formatAlignmentWarnings(warnings: AlignmentWarning[], verbose: boolean): void {
   138→  if (warnings.length === 0) {
   139→    console.log(chalk.green('Alignment: OK'));
   140→    return;
   141→  }
   142→
   143→  console.log(chalk.yellow(`\nAlignment warnings: ${warnings.length}`));
   144→
   145→  // Group by type
   146→  const orphaned = warnings.filter(w => w.type === 'orphaned_spec');
   147→  const mismatches = warnings.filter(w => w.type === 'status_mismatch');
   148→  const stale = warnings.filter(w => w.type === 'stale_implementation');
   149→
   150→  if (orphaned.length > 0) {
   151→    console.log(chalk.yellow(`  Orphaned specs (no tasks): ${orphaned.length}`));
   152→    const shown = verbose ? orphaned : orphaned.slice(0, 3);
   153→    for (const w of shown) {
   154→      console.log(chalk.gray(`    ○ ${w.specTitle}`));
   155→    }
   156→    if (!verbose && orphaned.length > 3) {
   157→      console.log(chalk.gray(`    ... and ${orphaned.length - 3} more`));
   158→    }
   159→  }
   160→
   161→  if (mismatches.length > 0) {
   162→    console.log(chalk.yellow(`  Status mismatches: ${mismatches.length}`));
   163→    for (const w of mismatches) {
   164→      console.log(chalk.yellow(`    ! ${w.specTitle}`));
   165→      console.log(chalk.gray(`      ${w.message}`));
   166→    }
   167→  }
   168→
   169→  if (stale.length > 0) {
   170→    console.log(chalk.yellow(`  Stale implementation status: ${stale.length}`));
   171→    for (const w of stale) {
   172→      console.log(chalk.yellow(`    ! ${w.message}`));
   173→    }
   174→  }
   175→}
   176→
   177→/**
   178→ * Format fix results for display
   179→ */
   180→function formatFixResult(result: FixResult): void {
   181→  if (result.fixesApplied.length === 0) {
   182→    console.log(chalk.gray('\nNo auto-fixable issues found.'));
   183→    return;
   184→  }
   185→
   186→  console.log(chalk.cyan(`\n✓ Applied ${result.fixesApplied.length} fix(es) to ${result.filesModified} file(s):`));
   187→
   188→  for (const fix of result.fixesApplied) {
   189→    const typeLabel = {
   190→      ulid_regenerated: 'ULID regenerated',
   191→      timestamp_added: 'Timestamp added',
   192→      status_added: 'Status added',
   193→    }[fix.type];
   194→
   195→    const shortFile = path.basename(fix.file);
   196→    console.log(chalk.cyan(`  ✓ ${shortFile}:${fix.path} - ${typeLabel}`));
   197→  }
   198→
   199→  if (result.errors.length > 0) {
   200→    console.log(chalk.yellow(`\nFix errors: ${result.errors.length}`));
   201→    for (const err of result.errors) {
   202→      console.log(chalk.yellow(`  ! ${err.file}: ${err.message}`));
   203→    }
   204→  }
   205→}
   206→
   207→/**
   208→ * Collect all files that can be fixed
   209→ */
   210→async function collectFixableFiles(ctx: { rootDir: string; specDir?: string; manifest?: { includes?: string[] } | null; manifestPath?: string | null }): Promise<string[]> {
   211→  const files: string[] = [];
   212→
   213→  // Task files (exclude test fixtures)
   214→  const taskFiles = await findTaskFiles(ctx.rootDir);
   215→  const specTaskFiles = await findTaskFiles(path.join(ctx.rootDir, 'spec'));
   216→  const allTaskFiles = [...new Set([...taskFiles, ...specTaskFiles])];
   217→  files.push(...allTaskFiles.filter(f => !f.includes('fixtures') && !f.includes('test')));
   218→
   219→  // Spec files from includes
   220→  if (ctx.manifest && ctx.manifestPath) {
   221→    const manifestDir = path.dirname(ctx.manifestPath);
   222→    const includes = ctx.manifest.includes || [];
   223→
   224→    for (const include of includes) {
   225→      const expandedPaths = await expandIncludePattern(include, manifestDir);
   226→      files.push(...expandedPaths);
   227→    }
   228→  }
   229→
   230→  // Inbox file
   231→  const inboxPath = path.join(ctx.rootDir, 'spec', 'kynetic.inbox.yaml');
   232→  try {
   233→    await import('node:fs/promises').then(fs => fs.access(inboxPath));
   234→    files.push(inboxPath);
   235→  } catch {
   236→    // Inbox file doesn't exist, skip
   237→  }
   238→
   239→  return [...new Set(files)];
   240→}
   241→
   242→/**
   243→ * Format validation result for display
   244→ */
   245→function formatValidationResult(result: ValidationResult, verbose: boolean): void {
   246→  // Header
   247→  if (result.valid) {
   248→    console.log(chalk.green.bold('✓ Validation passed'));
   249→  } else {
   250→    console.log(chalk.red.bold('✗ Validation failed'));
   251→  }
   252→
   253→  console.log(chalk.gray('─'.repeat(40)));
   254→  console.log(`Files checked: ${result.stats.filesChecked}`);
   255→  console.log(`Items checked: ${result.stats.itemsChecked}`);
   256→  console.log(`Tasks checked: ${result.stats.tasksChecked}`);
   257→
   258→  // AC-meta-manifest-2: Display meta summary line
   259→  if (result.metaStats) {
   260→    console.log(`Meta: ${result.metaStats.agents} agents, ${result.metaStats.workflows} workflows, ${result.metaStats.conventions} conventions`);
   261→  }
   262→
   263→  // Schema errors
   264→  if (result.schemaErrors.length > 0) {
   265→    console.log(chalk.red(`\nSchema errors: ${result.schemaErrors.length}`));
   266→    for (const err of result.schemaErrors) {
   267→      const location = err.path ? `${err.file}:${err.path}` : err.file;
   268→      console.log(chalk.red(`  ✗ ${location}`));
   269→      console.log(chalk.gray(`    ${err.message}`));
   270→      if (verbose && err.details) {
   271→        console.log(chalk.gray(`    ${JSON.stringify(err.details)}`));
   272→      }
   273→    }
   274→  } else {
   275→    console.log(chalk.green('\nSchema: OK'));
   276→  }
   277→
   278→  // Reference errors
   279→  if (result.refErrors.length > 0) {
   280→    console.log(chalk.red(`\nReference errors: ${result.refErrors.length}`));
   281→    for (const err of result.refErrors) {
   282→      const location = err.sourceFile
   283→        ? `${err.sourceFile} (${err.field})`
   284→        : `${err.sourceUlid?.slice(0, 8)} (${err.field})`;
   285→      console.log(chalk.red(`  ✗ ${err.ref}`));
   286→      console.log(chalk.gray(`    ${err.message}`));
   287→      console.log(chalk.gray(`    in: ${location}`));
   288→    }
   289→  } else {
   290→    console.log(chalk.green('References: OK'));
   291→  }
   292→
   293→  // Reference warnings (deprecated targets)
   294→  if (result.refWarnings.length > 0) {
   295→    console.log(chalk.yellow(`\nReference warnings: ${result.refWarnings.length}`));
   296→    const shown = verbose ? result.refWarnings : result.refWarnings.slice(0, 5);
   297→    for (const warn of shown) {
   298→      const location = warn.sourceFile
   299→        ? `${warn.sourceFile} (${warn.field})`
   300→        : `${warn.sourceUlid?.slice(0, 8)} (${warn.field})`;
   301→      console.log(chalk.yellow(`  ⚠ ${warn.ref}`));
   302→      console.log(chalk.gray(`    ${warn.message}`));
   303→      console.log(chalk.gray(`    in: ${location}`));
   304→    }
   305→    if (!verbose && result.refWarnings.length > 5) {
   306→      console.log(chalk.gray(`  ... and ${result.refWarnings.length - 5} more (use -v to see all)`));
   307→    }
   308→  }
   309→
   310→  // Orphans (warnings, not errors)
   311→  if (result.orphans.length > 0) {
   312→    console.log(chalk.yellow(`\nOrphans (not referenced): ${result.orphans.length}`));
   313→    if (verbose) {
   314→      for (const orphan of result.orphans) {
   315→        console.log(chalk.yellow(`  ○ ${orphan.ulid.slice(0, 8)} [${orphan.type}] ${orphan.title}`));
   316→      }
   317→    } else {
   318→      // Show first few
   319→      const shown = result.orphans.slice(0, 5);
   320→      for (const orphan of shown) {
   321→        console.log(chalk.yellow(`  ○ ${orphan.ulid.slice(0, 8)} [${orphan.type}] ${orphan.title}`));
   322→      }
   323→      if (result.orphans.length > 5) {
   324→        console.log(chalk.gray(`  ... and ${result.orphans.length - 5} more (use -v to see all)`));
   325→      }
   326→    }
   327→  }
   328→}
   329→
   330→/**
   331→ * Register validate command
   332→ */
   333→export function registerValidateCommand(program: Command): void {
   334→  program
   335→    .command('validate')
   336→    .description('Validate spec files')
   337→    .option('--schema', 'Check schema conformance only')
   338→    .option('--refs', 'Check reference resolution only')
   339→    .option('--orphans', 'Find orphaned items only')
   340→    .option('--alignment', 'Check spec-task alignment')
   341→    .option('--completeness', 'Check spec completeness (missing AC, descriptions, status inconsistencies)')
   342→    .option('--conventions', 'Validate conventions')
   343→    .option('--fix', 'Auto-fix issues where possible (invalid ULIDs, missing timestamps)')
   344→    .option('-v, --verbose', 'Show detailed output')
   345→    .option('--strict', 'Treat orphans as errors')
   346→    .action(async (options) => {
   347→      try {
   348→        const ctx = await initContext();
   349→
   350→        if (!ctx.manifestPath) {
   351→          error(validationStrings.noManifest);
   352→          console.log(validationStrings.initHint);
   353→          process.exit(EXIT_CODES.ERROR);
   354→        }
   355→
   356→        // Determine which checks to run
   357→        const runAll = !options.schema && !options.refs && !options.orphans && !options.alignment && !options.completeness && !options.conventions;
   358→        const validateOptions = {
   359→          schema: runAll || options.schema,
   360→          refs: runAll || options.refs,
   361→          orphans: runAll || options.orphans,
   362→          completeness: runAll || options.completeness,
   363→        };
   364→
   365→        const result = await validate(ctx, validateOptions);
   366→
   367→        // In strict mode, orphans are errors
   368→        if (options.strict && result.orphans.length > 0) {
   369→          result.valid = false;
   370→        }
   371→
   372→        output(result, () => formatValidationResult(result, options.verbose));
   373→
   374→        // Run auto-fix if requested
   375→        if (options.fix) {
   376→          const filesToFix = await collectFixableFiles(ctx);
   377→          const fixResult = await fixFiles(filesToFix);
   378→          formatFixResult(fixResult);
   379→
   380→          // Re-run validation after fixes to show updated status
   381→          if (fixResult.fixesApplied.length > 0) {
   382→            console.log(validationStrings.revalidating);
   383→            const revalidateResult = await validate(ctx, validateOptions);
   384→            if (revalidateResult.valid) {
   385→              console.log(validationStrings.nowPasses);
   386→            } else {
   387→              console.log(validationStrings.issuesRemain);
   388→            }
   389→            // Update result for exit code
   390→            result.valid = revalidateResult.valid;
   391→            result.schemaErrors = revalidateResult.schemaErrors;
   392→            result.refErrors = revalidateResult.refErrors;
   393→          }
   394→        }
   395→
   396→        // Run alignment check if requested or running all checks
   397→        if (options.alignment || runAll) {
   398→          const tasks = await loadAllTasks(ctx);
   399→          const items = await loadAllItems(ctx);
   400→          const refIndex = new ReferenceIndex(tasks, items);
   401→          const alignmentIndex = new AlignmentIndex(tasks, items);
   402→          alignmentIndex.buildLinks(refIndex);
   403→
   404→          const alignmentWarnings = alignmentIndex.findAlignmentWarnings();
   405→          formatAlignmentWarnings(alignmentWarnings, options.verbose);
   406→
   407→          // Show alignment stats
   408→          const stats = alignmentIndex.getStats();
   409→          console.log(
   410→            validationStrings.alignmentStats(stats.specsWithTasks, stats.totalSpecs, stats.alignedSpecs)
   411→          );
   412→        }
   413→
   414→        // Show completeness warnings if any
   415→        // AC: @spec-completeness ac-4
   416→        if (result.completenessWarnings.length > 0) {
   417→          formatCompletenessWarnings(result.completenessWarnings, options.verbose);
   418→        }
   419→
   420→        // Run convention validation if requested
   421→        // AC: @convention-definitions ac-3, ac-4
   422→        if (options.conventions) {
   423→          try {
   424→            const metaCtx = await loadMetaContext(ctx);
   425→            if (metaCtx && metaCtx.conventions.length > 0) {
   426→              // For now, we just validate that conventions are well-formed
   427→              // Full validation against actual content (commits, notes, etc.)
   428→              // would require additional content gathering logic
   429→              const conventionResult = validateConventions(metaCtx.conventions, {});
   430→              formatConventionValidationResult(conventionResult);
   431→
   432→              if (!conventionResult.valid) {
   433→                result.valid = false;
   434→              }
   435→            } else {
   436→              console.log(chalk.gray('No conventions defined in meta manifest'));
   437→            }
   438→          } catch (err) {
   439→            console.log(chalk.yellow('Warning: Could not load meta manifest for convention validation'));
   440→          }
   441→        }
   442→
   443→        if (!result.valid) {
   444→          process.exit(EXIT_CODES.ERROR);
   445→        }
   446→      } catch (err) {
   447→        error(validationStrings.failed, err);
   448→        process.exit(EXIT_CODES.ERROR);
   449→      }
   450→    });
   451→
   452→  // Alias: kspec lint
   453→  program
   454→    .command('lint')
   455→    .description('Alias for validate with style checks')
   456→    .option('--schema', 'Check schema conformance only')
   457→    .option('--refs', 'Check reference resolution only')
   458→    .option('--orphans', 'Find orphaned items only')
   459→    .option('--completeness', 'Check spec completeness (missing AC, descriptions, status inconsistencies)')
   460→    .option('--fix', 'Auto-fix issues where possible (invalid ULIDs, missing timestamps)')
   461→    .option('-v, --verbose', 'Show detailed output')
   462→    .option('--strict', 'Treat orphans as errors')
   463→    .action(async (options) => {
   464→      try {
   465→        const ctx = await initContext();
   466→
   467→        if (!ctx.manifestPath) {
   468→          error(validationStrings.noManifest);
   469→          process.exit(EXIT_CODES.ERROR);
   470→        }
   471→
   472→        const runAll = !options.schema && !options.refs && !options.orphans && !options.completeness;
   473→        const validateOptions = {
   474→          schema: runAll || options.schema,
   475→          refs: runAll || options.refs,
   476→          orphans: runAll || options.orphans,
   477→          completeness: runAll || options.completeness,
   478→        };
   479→
   480→        const result = await validate(ctx, validateOptions);
   481→
   482→        if (options.strict && result.orphans.length > 0) {
   483→          result.valid = false;
   484→        }
   485→
   486→        output(result, () => formatValidationResult(result, options.verbose));
   487→
   488→        // Run auto-fix if requested
   489→        if (options.fix) {
   490→          const filesToFix = await collectFixableFiles(ctx);
   491→          const fixResult = await fixFiles(filesToFix);
   492→          formatFixResult(fixResult);
   493→
   494→          // Re-run validation after fixes
   495→          if (fixResult.fixesApplied.length > 0) {
   496→            console.log(validationStrings.revalidating);
   497→            const revalidateResult = await validate(ctx, validateOptions);
   498→            if (revalidateResult.valid) {
   499→              console.log(validationStrings.nowPasses);
   500→            } else {
   501→              console.log(validationStrings.issuesRemain);
   502→            }
   503→            result.valid = revalidateResult.valid;
   504→          }
   505→        }
   506→
   507→        if (!result.valid) {
   508→          process.exit(EXIT_CODES.ERROR);
   509→        }
   510→      } catch (err) {
   511→        error(validationStrings.lintFailed, err);
   512→        process.exit(EXIT_CODES.ERROR);
   513→      }
   514→    });
   515→}
