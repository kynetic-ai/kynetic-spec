   276→  describe('repairShadow', () => {
   277→    // Helper to set up a healthy shadow branch
   278→    async function setupHealthyShadow(): Promise<void> {
   279→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   280→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   281→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   282→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   283→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   284→      await initializeShadow(testDir);
   285→    }
   286→
   287→    // AC-recovery-1: Branch exists but .kspec/ deleted → repair recreates
   288→    it('recreates worktree when .kspec/ directory is deleted', async () => {
   289→      await setupHealthyShadow();
   290→      const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
   291→
   292→      // Verify healthy before breaking
   293→      let status = await getShadowStatus(testDir);
   294→      expect(status.healthy).toBe(true);
   295→
   296→      // Break: delete the worktree directory
   297→      // First remove from git worktree list to avoid stale reference
   298→      execSync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, { cwd: testDir, stdio: 'pipe' });
   299→
   300→      // Verify broken
   301→      status = await getShadowStatus(testDir);
   302→      expect(status.healthy).toBe(false);
   303→      expect(status.branchExists).toBe(true);
   304→      expect(status.worktreeExists).toBe(false);
   305→
   306→      // Repair
   307→      const result = await repairShadow(testDir);
   308→      expect(result.success).toBe(true);
   309→      expect(result.worktreeCreated).toBe(true);
   310→
   311→      // Verify healthy again
   312→      status = await getShadowStatus(testDir);
   313→      expect(status.healthy).toBe(true);
   314→      expect(await isValidWorktree(worktreeDir)).toBe(true);
   315→    });
   316→
   317→    // AC-recovery-2: .kspec/ exists but .git file corrupt → repair recreates
   318→    it('recreates worktree when .git file is corrupted', async () => {
   319→      await setupHealthyShadow();
   320→      const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
   321→      const gitFile = path.join(worktreeDir, '.git');
   322→
   323→      // Verify healthy before breaking
   324→      let status = await getShadowStatus(testDir);
   325→      expect(status.healthy).toBe(true);
   326→
   327→      // Break: corrupt the .git file
   328→      await fs.writeFile(gitFile, 'corrupted content');
   329→
   330→      // Verify broken
   331→      status = await getShadowStatus(testDir);
   332→      expect(status.healthy).toBe(false);
   333→      expect(status.worktreeExists).toBe(true);
   334→      expect(status.worktreeLinked).toBe(false);
   335→
   336→      // Repair
   337→      const result = await repairShadow(testDir);
   338→      expect(result.success).toBe(true);
   339→      expect(result.worktreeCreated).toBe(true);
   340→
   341→      // Verify healthy again
   342→      status = await getShadowStatus(testDir);
   343→      expect(status.healthy).toBe(true);
   344→    });
   345→
   346→    // AC-recovery-3: No shadow branch → repair fails suggesting init
   347→    it('fails with helpful error when shadow branch does not exist', async () => {
   348→      // Just a git repo without shadow branch
   349→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   350→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   351→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   352→
   353→      const result = await repairShadow(testDir);
   354→      expect(result.success).toBe(false);
   355→      expect(result.error).toContain('kspec init');
   356→    });
   357→
   358→    // AC-recovery-4: Healthy → repair succeeds without changes (idempotent)
   359→    it('succeeds without changes when already healthy', async () => {
   360→      await setupHealthyShadow();
   361→
   362→      const result = await repairShadow(testDir);
   363→      expect(result.success).toBe(true);
   364→      expect(result.alreadyExists).toBe(true);
   365→      expect(result.worktreeCreated).toBe(false);
   366→    });
   367→
   368→    // AC-recovery-5: Healthy → status reports healthy
   369→    it('status reports healthy when shadow is working', async () => {
   370→      await setupHealthyShadow();
   371→
   372→      const status = await getShadowStatus(testDir);
   373→      expect(status.healthy).toBe(true);
   374→      expect(status.branchExists).toBe(true);
   375→      expect(status.worktreeExists).toBe(true);
   376→      expect(status.worktreeLinked).toBe(true);
   377→      expect(status.error).toBeUndefined();
   378→    });
   379→
   380→    // AC-recovery-6: Issues → status reports issue and suggests repair
   381→    it('status reports specific issue when worktree is broken', async () => {
   382→      await setupHealthyShadow();
   383→
   384→      // Break: remove worktree
   385→      execSync(`git worktree remove ${SHADOW_WORKTREE_DIR} --force`, { cwd: testDir, stdio: 'pipe' });
   386→
   387→      const status = await getShadowStatus(testDir);
   388→      expect(status.healthy).toBe(false);
   389→      expect(status.branchExists).toBe(true);
   390→      expect(status.worktreeExists).toBe(false);
   391→      expect(status.error).toContain('worktree missing');
   392→    });
   393→  });
