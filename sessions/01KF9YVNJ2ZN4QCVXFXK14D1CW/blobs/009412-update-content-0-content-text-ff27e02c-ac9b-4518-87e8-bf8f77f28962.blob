   395→  // AC: @shadow-init-remote - Remote detection tests
   396→  describe('initializeShadow with remote', () => {
   397→    // Create a bare repo to act as a "remote"
   398→    const remoteDir = path.join('/tmp', `kspec-remote-test-${Date.now()}`);
   399→
   400→    beforeEach(async () => {
   401→      // Clean up remote directory
   402→      try {
   403→        await fs.rm(remoteDir, { recursive: true });
   404→      } catch {
   405→        // Doesn't exist
   406→      }
   407→    });
   408→
   409→    afterEach(async () => {
   410→      try {
   411→        await fs.rm(remoteDir, { recursive: true });
   412→      } catch {
   413→        // Best effort cleanup
   414→      }
   415→    });
   416→
   417→    // Helper to set up a bare repo as remote
   418→    async function setupBareRemote(): Promise<void> {
   419→      await fs.mkdir(remoteDir, { recursive: true });
   420→      execSync('git init --bare', { cwd: remoteDir, stdio: 'pipe' });
   421→    }
   422→
   423→    // Helper to set up a local repo with remote
   424→    async function setupLocalWithRemote(): Promise<void> {
   425→      execSync('git init -b main', { cwd: testDir, stdio: 'pipe' });
   426→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   427→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   428→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   429→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   430→      execSync(`git remote add origin ${remoteDir}`, { cwd: testDir, stdio: 'pipe' });
   431→      execSync('git push -u origin main', { cwd: testDir, stdio: 'pipe' });
   432→    }
   433→
   434→    // Helper to push shadow branch to remote
   435→    async function pushShadowToRemote(): Promise<void> {
   436→      execSync(`git -C ${testDir}/.kspec push -u origin ${SHADOW_BRANCH_NAME}`, { stdio: 'pipe' });
   437→    }
   438→
   439→    it('hasRemote returns false when no remote configured', async () => {
   440→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   441→      expect(await hasRemote(testDir)).toBe(false);
   442→    });
   443→
   444→    it('hasRemote returns true when origin exists', async () => {
   445→      await setupBareRemote();
   446→      await setupLocalWithRemote();
   447→      expect(await hasRemote(testDir)).toBe(true);
   448→    });
   449→
   450→    it('remoteBranchExists returns false when branch not on remote', async () => {
   451→      await setupBareRemote();
   452→      await setupLocalWithRemote();
   453→      expect(await remoteBranchExists(testDir, SHADOW_BRANCH_NAME)).toBe(false);
   454→    });
   455→
   456→    it('remoteBranchExists returns true after pushing shadow branch', async () => {
   457→      await setupBareRemote();
   458→      await setupLocalWithRemote();
   459→
   460→      // Initialize shadow locally
   461→      await initializeShadow(testDir);
   462→
   463→      // Push to remote
   464→      await pushShadowToRemote();
   465→
   466→      // Now check - need to fetch first
   467→      await fetchRemote(testDir);
   468→      expect(await remoteBranchExists(testDir, SHADOW_BRANCH_NAME)).toBe(true);
   469→    });
   470→
   471→    // AC-1: Remote has shadow branch → creates worktree from it with tracking
   472→    it('attaches to existing remote shadow branch', async () => {
   473→      await setupBareRemote();
   474→      await setupLocalWithRemote();
   475→
   476→      // Initialize shadow in first repo and push
   477→      const result1 = await initializeShadow(testDir);
   478→      expect(result1.success).toBe(true);
   479→      expect(result1.branchCreated).toBe(true);
   480→
   481→      // Push shadow to remote
   482→      await pushShadowToRemote();
   483→
   484→      // Create a "clone" (new repo pointing to same remote)
   485→      const cloneDir = path.join('/tmp', `kspec-clone-test-${Date.now()}`);
   486→      try {
   487→        execSync(`git clone ${remoteDir} ${cloneDir}`, { stdio: 'pipe' });
   488→        execSync('git config user.email "test@test.com"', { cwd: cloneDir, stdio: 'pipe' });
   489→        execSync('git config user.name "Test"', { cwd: cloneDir, stdio: 'pipe' });
   490→
   491→        // Initialize shadow in clone - should attach to remote branch
   492→        const result2 = await initializeShadow(cloneDir);
   493→        expect(result2.success).toBe(true);
   494→        expect(result2.createdFromRemote).toBe(true);
   495→        expect(result2.branchCreated).toBe(false);
   496→        expect(result2.worktreeCreated).toBe(true);
   497→
   498→        // Verify worktree is healthy
   499→        const status = await getShadowStatus(cloneDir);
   500→        expect(status.healthy).toBe(true);
   501→
   502→        // Verify tracking is set up
   503→        const tracking = execSync(`git -C ${cloneDir} config branch.${SHADOW_BRANCH_NAME}.remote`, {
   504→          encoding: 'utf-8',
   505→          stdio: ['pipe', 'pipe', 'pipe'],
   506→        }).trim();
   507→        expect(tracking).toBe('origin');
   508→      } finally {
   509→        await fs.rm(cloneDir, { recursive: true, force: true });
   510→      }
   511→    });
   512→
   513→    // AC-2: Remote exists but no shadow branch → creates orphan and pushes
   514→    it('creates orphan branch and pushes to remote', async () => {
   515→      await setupBareRemote();
   516→      await setupLocalWithRemote();
   517→
   518→      // Verify no shadow branch on remote yet
   519→      expect(await remoteBranchExists(testDir, SHADOW_BRANCH_NAME)).toBe(false);
   520→
   521→      // Initialize shadow - should create and push
   522→      const result = await initializeShadow(testDir);
   523→      expect(result.success).toBe(true);
   524→      expect(result.branchCreated).toBe(true);
   525→      expect(result.pushedToRemote).toBe(true);
   526→
   527→      // Verify shadow branch now exists on remote
   528→      await fetchRemote(testDir);
   529→      expect(await remoteBranchExists(testDir, SHADOW_BRANCH_NAME)).toBe(true);
   530→    });
   531→
   532→    // AC-3: No remote configured → creates orphan locally (no push attempt)
   533→    it('creates orphan locally when no remote configured', async () => {
   534→      // Just a local git repo, no remote
   535→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   536→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   537→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   538→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   539→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   540→
   541→      const result = await initializeShadow(testDir);
