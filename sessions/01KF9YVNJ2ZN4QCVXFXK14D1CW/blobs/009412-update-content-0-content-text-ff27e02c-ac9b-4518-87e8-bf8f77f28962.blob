    31→describe('Shadow Branch', () => {
    32→  // Use /tmp to ensure we're outside any git repo for proper isolation
    33→  const testDir = path.join('/tmp', `kspec-shadow-test-${Date.now()}`);
    34→
    35→  beforeEach(async () => {
    36→    // Clean up any previous test directory
    37→    try {
    38→      await fs.rm(testDir, { recursive: true });
    39→    } catch {
    40→      // Doesn't exist, that's fine
    41→    }
    42→    await fs.mkdir(testDir, { recursive: true });
    43→  });
    44→
    45→  afterEach(async () => {
    46→    try {
    47→      await fs.rm(testDir, { recursive: true });
    48→    } catch {
    49→      // Best effort cleanup
    50→    }
    51→  });
    52→
    53→  describe('detectShadow', () => {
    54→    it('returns null for non-git directory', async () => {
    55→      const result = await detectShadow(testDir);
    56→      expect(result).toBeNull();
    57→    });
    58→
    59→    it('returns null for git repo without .kspec', async () => {
    60→      // Initialize a git repo
    61→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
    62→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
    63→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
    64→
    65→      const result = await detectShadow(testDir);
    66→      expect(result).toBeNull();
    67→    });
    68→  });
    69→
    70→  describe('getShadowStatus', () => {
    71→    it('reports not a git repo', async () => {
    72→      const status = await getShadowStatus(testDir);
    73→      expect(status.exists).toBe(false);
    74→      expect(status.healthy).toBe(false);
    75→      expect(status.error).toBe('Not a git repository');
    76→    });
    77→
    78→    it('reports no shadow branch for fresh git repo', async () => {
    79→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
    80→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
    81→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
    82→
    83→      const status = await getShadowStatus(testDir);
    84→      expect(status.exists).toBe(false);
    85→      expect(status.healthy).toBe(false);
    86→      expect(status.branchExists).toBe(false);
    87→      expect(status.worktreeExists).toBe(false);
    88→    });
    89→  });
