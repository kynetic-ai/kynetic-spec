   221→  describe('initializeShadow', () => {
   222→    it('creates shadow branch and worktree in git repo', async () => {
   223→      // Initialize git repo with an initial commit
   224→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   225→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   226→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   227→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   228→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   229→
   230→      const result = await initializeShadow(testDir, { projectName: 'Test Project' });
   231→
   232→      expect(result.success).toBe(true);
   233→      expect(result.branchCreated).toBe(true);
   234→      expect(result.worktreeCreated).toBe(true);
   235→      expect(result.gitignoreUpdated).toBe(true);
   236→
   237→      // Verify branch exists
   238→      expect(await branchExists(testDir, SHADOW_BRANCH_NAME)).toBe(true);
   239→
   240→      // Verify worktree exists and is valid
   241→      const worktreeDir = path.join(testDir, SHADOW_WORKTREE_DIR);
   242→      expect(await isValidWorktree(worktreeDir)).toBe(true);
   243→
   244→      // Verify status is healthy
   245→      const status = await getShadowStatus(testDir);
   246→      expect(status.healthy).toBe(true);
   247→    });
   248→
   249→    it('is idempotent - succeeds if already initialized', async () => {
   250→      // Initialize git repo
   251→      execSync('git init', { cwd: testDir, stdio: 'pipe' });
   252→      execSync('git config user.email "test@test.com"', { cwd: testDir, stdio: 'pipe' });
   253→      execSync('git config user.name "Test"', { cwd: testDir, stdio: 'pipe' });
   254→      await fs.writeFile(path.join(testDir, 'README.md'), '# Test');
   255→      execSync('git add . && git commit -m "initial"', { cwd: testDir, stdio: 'pipe' });
   256→
   257→      // First init
   258→      const result1 = await initializeShadow(testDir);
   259→      expect(result1.success).toBe(true);
   260→      expect(result1.branchCreated).toBe(true);
   261→
   262→      // Second init - should succeed without creating branch again
   263→      const result2 = await initializeShadow(testDir);
   264→      expect(result2.success).toBe(true);
   265→      expect(result2.alreadyExists).toBe(true);
   266→      expect(result2.branchCreated).toBe(false);
   267→    });
   268→
   269→    it('fails if not a git repo', async () => {
   270→      const result = await initializeShadow(testDir);
   271→      expect(result.success).toBe(false);
   272→      expect(result.error).toBe('Not a git repository');
   273→    });
   274→  });
