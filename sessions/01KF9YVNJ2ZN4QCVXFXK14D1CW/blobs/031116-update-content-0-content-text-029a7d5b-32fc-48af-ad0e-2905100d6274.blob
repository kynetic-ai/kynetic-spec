   381→/**
   382→ * Get default author value for an agent type
   383→ */
   384→function getDefaultAuthor(agentType: AgentType): string {
   385→  switch (agentType) {
   386→    case 'claude-code':
   387→      return '@claude';
   388→    case 'cline':
   389→      return '@cline';
   390→    case 'roo-code':
   391→      return '@roo';
   392→    case 'copilot-cli':
   393→      return '@copilot';
   394→    case 'gemini-cli':
   395→      return '@gemini';
   396→    case 'codex-cli':
   397→      return '@codex';
   398→    case 'aider':
   399→      return '@aider';
   400→    case 'opencode':
   401→      return '@opencode';
   402→    case 'amp':
   403→      return '@amp';
   404→    default:
   405→      return '@agent';
   406→  }
   407→}
   408→
   409→/**
   410→ * Prompt user for input with Y/N answer
   411→ */
   412→async function promptYesNo(question: string): Promise<boolean> {
   413→  const rl = readline.createInterface({
   414→    input: process.stdin,
   415→    output: process.stdout,
   416→  });
   417→
   418→  try {
   419→    const answer = await rl.question(`${question} `);
   420→    return answer.toLowerCase() === 'y';
   421→  } finally {
   422→    rl.close();
   423→  }
   424→}
   425→
   426→/**
   427→ * Ensure .kspec worktree exists if kspec-meta branch is present.
   428→ * AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
   429→ *
   430→ * @param autoWorktree If true, automatically create worktree without prompting
   431→ * @returns true if worktree is ready to use
   432→ */
   433→async function ensureWorktree(autoWorktree: boolean): Promise<boolean> {
   434→  const projectRoot = getGitRoot(process.cwd());
   435→  if (!projectRoot) {
   436→    // Not in a git repo, skip worktree check
   437→    return true;
   438→  }
   439→
   440→  const status = await getShadowStatus(projectRoot);
   441→
   442→  // AC: worktree-already-exists - if already valid, skip
   443→  if (status.healthy) {
   444→    return true;
   445→  }
   446→
   447→  // AC: detect-existing-repo - branch exists but worktree doesn't
   448→  if (status.branchExists && !status.worktreeExists) {
   449→    // AC: auto-worktree-flag - auto-create if flag set
   450→    if (autoWorktree) {
   451→      console.log(`Detected ${SHADOW_BRANCH_NAME} branch without .kspec worktree. Creating...`);
   452→      const result = await repairShadow(projectRoot);
   453→      if (result.success) {
   454→        success('Created .kspec worktree');
   455→        return true;
   456→      } else {
   457→        error(`Failed to create worktree: ${result.error}`);
   458→        return false;
   459→      }
   460→    }
   461→
   462→    // AC: detect-existing-repo - prompt user
   463→    const shouldCreate = await promptYesNo(
   464→      `${SHADOW_BRANCH_NAME} branch exists but .kspec worktree is missing. Create it? (y/N)`
   465→    );
   466→
   467→    if (shouldCreate) {
   468→      console.log('Creating .kspec worktree...');
   469→      const result = await repairShadow(projectRoot);
   470→      if (result.success) {
   471→        success('Created .kspec worktree');
   472→        return true;
   473→      } else {
   474→        error(`Failed to create worktree: ${result.error}`);
   475→        return false;
   476→      }
   477→    } else {
   478→      warn('Skipping worktree creation');
   479→      return false;
   480→    }
   481→  }
   482→
   483→  // No kspec-meta branch, or already healthy
   484→  return true;
   485→}
