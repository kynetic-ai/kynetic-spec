   317→/**
   318→ * Install KSPEC_AUTHOR config for Aider (.aider.conf.yml)
   319→ * Aider uses `set-env:` for environment variables in list format
   320→ */
   321→async function installAiderConfig(author: string): Promise<boolean> {
   322→  const configPath = path.join(os.homedir(), '.aider.conf.yml');
   323→
   324→  try {
   325→    let content = '';
   326→    try {
   327→      content = await fs.readFile(configPath, 'utf-8');
   328→    } catch {
   329→      // File doesn't exist, start fresh
   330→    }
   331→
   332→    // Check if KSPEC_AUTHOR is already set
   333→    if (content.includes('KSPEC_AUTHOR')) {
   334→      // Replace existing value (handles both old and new format)
   335→      content = content.replace(/^(\s*-?\s*KSPEC_AUTHOR\s*[=:]\s*).*$/m, `  - KSPEC_AUTHOR=${author}`);
   336→    } else {
   337→      // Add to set-env section or create it
   338→      if (content.includes('set-env:')) {
   339→        // Append to existing set-env section
   340→        content = content.replace(/(set-env:\s*\n)/m, `$1  - KSPEC_AUTHOR=${author}\n`);
   341→      } else {
   342→        // Add new set-env section
   343→        content += `\n# kspec author for note attribution\nset-env:\n  - KSPEC_AUTHOR=${author}\n`;
   344→      }
   345→    }
   346→
   347→    await fs.writeFile(configPath, content, 'utf-8');
   348→    return true;
   349→  } catch {
   350→    return false;
   351→  }
   352→}
   353→
