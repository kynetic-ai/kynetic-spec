   487→/**
   488→ * Print manual setup instructions
   489→ */
   490→function printManualInstructions(agentType: AgentType): void {
   491→  const author = getDefaultAuthor(agentType);
   492→
   493→  console.log('\nManual setup instructions:\n');
   494→
   495→  switch (agentType) {
   496→    case 'claude-code':
   497→      console.log('Add to ~/.claude/settings.json:');
   498→      console.log('```json');
   499→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   500→      console.log('```');
   501→      break;
   502→
   503→    case 'cline':
   504→    case 'roo-code':
   505→      console.log('Add to your shell profile (~/.bashrc, ~/.zshrc):');
   506→      console.log('```bash');
   507→      console.log(`export KSPEC_AUTHOR="${author}"`);
   508→      console.log('```');
   509→      console.log('\nThis will be inherited by terminals spawned by the VS Code extension.');
   510→      break;
   511→
   512→    case 'copilot-cli':
   513→      console.log('Add to ~/.copilot/config.json:');
   514→      console.log('```json');
   515→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   516→      console.log('```');
   517→      break;
   518→
   519→    case 'aider':
   520→      console.log('Add to ~/.aider.conf.yml:');
   521→      console.log('```yaml');
   522→      console.log('set-env:');
   523→      console.log(`  - KSPEC_AUTHOR=${author}`);
   524→      console.log('```');
   525→      break;
   526→
   527→    case 'codex-cli':
   528→      console.log('Add to ~/.codex/config.toml:');
   529→      console.log('```toml');
   530→      console.log('[shell_environment_policy]');
   531→      console.log(`set = { KSPEC_AUTHOR = "${author}" }`);
   532→      console.log('```');
   533→      break;
   534→
   535→    case 'opencode':
   536→      console.log('Add to ~/.config/opencode/opencode.json:');
   537→      console.log('```json');
   538→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   539→      console.log('```');
   540→      break;
   541→
   542→    case 'amp':
   543→      console.log('Add to ~/.config/amp/settings.json:');
   544→      console.log('```json');
   545→      console.log(JSON.stringify({ env: { KSPEC_AUTHOR: author } }, null, 2));
   546→      console.log('```');
   547→      break;
   548→
   549→    default:
   550→      console.log('Set the KSPEC_AUTHOR environment variable:');
   551→      console.log('```bash');
   552→      console.log(`export KSPEC_AUTHOR="${author}"`);
   553→      console.log('```');
   554→      console.log('\nOr add to your shell profile (~/.bashrc, ~/.zshrc, etc.)');
   555→  }
   556→}
   557→
   558→/**
   559→ * Register the 'setup' command
   560→ */
   561→export function registerSetupCommand(program: Command): void {
   562→  program
   563→    .command('setup')
   564→    .description('Configure agent environment for kspec')
   565→    .option('--dry-run', 'Show what would be done without making changes')
   566→    .option('--author <author>', 'Custom author string (default: auto-detected based on agent)')
   567→    .option('--no-hooks', 'Skip installing Claude Code stop hook')
   568→    .option('--force', 'Overwrite existing configuration')
   569→    .option('--auto-worktree', 'Automatically create .kspec worktree if kspec-meta branch exists')
   570→    .action(async (options) => {
   571→      try {
   572→        // AC: detect-existing-repo, auto-worktree-flag, worktree-already-exists
   573→        const worktreeReady = await ensureWorktree(options.autoWorktree || false);
   574→        if (!worktreeReady) {
   575→          // User declined worktree creation or it failed
   576→          process.exit(EXIT_CODES.ERROR);
   577→        }
   578→
   579→        const detected = detectAgent();
   580→        const projectDir = process.cwd();
   581→
   582→        console.log(`Detected agent: ${detected.type} (confidence: ${detected.confidence})`);
   583→
   584→        if (detected.type === 'unknown') {
   585→          warn('Could not auto-detect agent environment');
   586→          printManualInstructions('unknown');
   587→          return;
   588→        }
   589→
   590→        const author = options.author || getDefaultAuthor(detected.type);
   591→        const installHooks = options.hooks !== false && detected.type === 'claude-code';
   592→
   593→        if (options.dryRun) {
   594→          console.log(`\nWould configure:`);
   595→          console.log(`  Agent: ${detected.type}`);
   596→          console.log(`  Author: ${author}`);
   597→          if (detected.configPath) {
   598→            console.log(`  Global config: ${detected.configPath}`);
   599→          }
   600→          if (installHooks) {
   601→            console.log(`  Project config: ${path.join(projectDir, '.claude', 'settings.json')}`);
   602→            console.log(`  Hooks: UserPromptSubmit (prompt-check), Stop (checkpoint)`);
   603→          }
   604→          return;
   605→        }
   606→
   607→        // Check if already configured
   608→        if (!options.force && process.env.KSPEC_AUTHOR) {
   609→          warn(`KSPEC_AUTHOR is already set to "${process.env.KSPEC_AUTHOR}"`);
   610→          console.log('Use --force to overwrite');
   611→          return;
   612→        }
   613→
   614→        // Install config based on agent type
   615→        let installed = false;
   616→        let hooksInstalled = false;
   617→
   618→        let hooksResult: { stop: boolean; promptCheck: boolean } | null = null;
   619→
   620→        switch (detected.type) {
   621→          case 'claude-code':
   622→            installed = await installClaudeCodeConfig(author);
   623→            if (installHooks) {
   624→              hooksResult = await installClaudeCodeHooks(projectDir);
   625→              hooksInstalled = hooksResult.stop || hooksResult.promptCheck;
   626→            }
   627→            break;
   628→
   629→          case 'aider':
   630→            installed = await installAiderConfig(author);
   631→            break;
   632→
   633→          case 'cline':
   634→          case 'roo-code':
   635→            // These VS Code extensions use shell env vars, not config files
   636→            // Can't auto-install, must print instructions
   637→            printManualInstructions(detected.type);
   638→            return;
   639→
   640→          case 'copilot-cli':
   641→          case 'gemini-cli':
   642→          case 'opencode':
   643→          case 'amp':
   644→            if (detected.configPath) {
   645→              installed = await installGenericJsonConfig(detected.configPath, author);
   646→            }
   647→            break;
   648→
   649→          case 'codex-cli':
   650→            // Codex uses TOML config, would need special handling
   651→            // For now, print manual instructions
   652→            printManualInstructions(detected.type);
   653→            return;
   654→        }
   655→
   656→        if (installed) {
   657→          success(`Configured ${detected.type} with KSPEC_AUTHOR="${author}"`, {
   658→            agent: detected.type,
   659→            author,
   660→            configPath: detected.configPath,
   661→          });
   662→
   663→          if (hooksInstalled && hooksResult) {
   664→            const installedHooks: string[] = [];
   665→            if (hooksResult.promptCheck) installedHooks.push('UserPromptSubmit (prompt-check)');
   666→            if (hooksResult.stop) installedHooks.push('Stop (checkpoint)');
   667→            success(`Installed hooks to .claude/settings.json`, {
   668→              hooks: installedHooks,
   669→            });
   670→          }
   671→
   672→          console.log('\nRestart your agent session for changes to take effect.');
   673→        } else {
   674→          error(errors.failures.installConfig(detected.type));
   675→          printManualInstructions(detected.type);
   676→        }
   677→      } catch (err) {
   678→        error(errors.failures.setupFailed, err);
   679→        process.exit(EXIT_CODES.ERROR);
   680→      }
   681→    });
   682→}
   683→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
```