```
     1→import { Command } from 'commander';
     2→import * as fs from 'node:fs/promises';
     3→import * as path from 'node:path';
     4→import * as os from 'node:os';
     5→import * as readline from 'node:readline/promises';
     6→import { success, error, warn } from '../output.js';
     7→import { errors } from '../../strings/index.js';
     8→import {
     9→  getShadowStatus,
    10→  repairShadow,
    11→  getGitRoot,
    12→  SHADOW_WORKTREE_DIR,
    13→  SHADOW_BRANCH_NAME,
    14→} from '../../parser/shadow.js';
    15→import { EXIT_CODES } from '../exit-codes.js';
    16→
    17→/**
    18→ * Supported agent types for auto-configuration
    19→ */
    20→export type AgentType =
    21→  | 'claude-code'
    22→  | 'cline'
    23→  | 'roo-code'
    24→  | 'copilot-cli'
    25→  | 'gemini-cli'
    26→  | 'codex-cli'
    27→  | 'aider'
    28→  | 'opencode'
    29→  | 'amp'
    30→  | 'unknown';
    31→
    32→/**
    33→ * Result of agent detection
    34→ */
    35→export interface DetectedAgent {
    36→  type: AgentType;
    37→  confidence: 'high' | 'medium' | 'low';
    38→  configPath?: string;
    39→  envVars?: Record<string, string>;
    40→}
    41→
    42→/**
    43→ * Detect which agent environment we're running in.
    44→ * Returns the detected agent type and confidence level.
    45→ *
    46→ * Detection priority matters - more specific markers checked first.
    47→ */
    48→export function detectAgent(): DetectedAgent {
    49→  // Claude Code: Multiple possible markers
    50→  // CLAUDECODE=1 is set in CLI sessions
    51→  // CLAUDE_CODE_ENTRYPOINT indicates entry point (cli, etc.)
    52→  // CLAUDE_PROJECT_DIR is set in some contexts
    53→  if (process.env.CLAUDECODE === '1' || process.env.CLAUDE_CODE_ENTRYPOINT || process.env.CLAUDE_PROJECT_DIR) {
    54→    return {
    55→      type: 'claude-code',
    56→      confidence: 'high',
    57→      configPath: path.join(os.homedir(), '.claude', 'settings.json'),
    58→      envVars: {
    59→        ...(process.env.CLAUDECODE && { CLAUDECODE: process.env.CLAUDECODE }),
    60→        ...(process.env.CLAUDE_CODE_ENTRYPOINT && { CLAUDE_CODE_ENTRYPOINT: process.env.CLAUDE_CODE_ENTRYPOINT }),
    61→        ...(process.env.CLAUDE_PROJECT_DIR && { CLAUDE_PROJECT_DIR: process.env.CLAUDE_PROJECT_DIR }),
    62→      },
    63→    };
    64→  }
    65→
    66→  // Cline: CLINE_ACTIVE is set when running in Cline terminal
    67→  if (process.env.CLINE_ACTIVE) {
    68→    return {
    69→      type: 'cline',
    70→      confidence: 'high',
    71→      // Cline uses VS Code settings, but env vars should be in shell profile
    72→      configPath: undefined,
    73→      envVars: { CLINE_ACTIVE: process.env.CLINE_ACTIVE },
    74→    };
    75→  }
    76→
    77→  // GitHub Copilot CLI: Check for copilot-specific markers
    78→  if (process.env.COPILOT_MODEL || process.env.GH_TOKEN) {
    79→    return {
    80→      type: 'copilot-cli',
    81→      confidence: 'medium',
    82→      configPath: path.join(os.homedir(), '.copilot', 'config.json'),
    83→    };
    84→  }
    85→
    86→  // Aider: Check for AIDER_* env vars
    87→  if (process.env.AIDER_MODEL || process.env.AIDER_DARK_MODE !== undefined) {
    88→    return {
    89→      type: 'aider',
    90→      confidence: 'high',
    91→      configPath: path.join(os.homedir(), '.aider.conf.yml'),
    92→    };
    93→  }
    94→
    95→  // OpenCode: Check for OPENCODE_* env vars
    96→  if (process.env.OPENCODE_CONFIG_DIR || process.env.OPENCODE_CONFIG) {
    97→    return {
    98→      type: 'opencode',
    99→      confidence: 'high',
   100→      configPath: process.env.OPENCODE_CONFIG || path.join(os.homedir(), '.config', 'opencode', 'opencode.json'),
   101→    };
   102→  }
   103→
   104→  // Gemini CLI: GEMINI_CLI=1 is set when running in Gemini CLI
   105→  if (process.env.GEMINI_CLI === '1') {
   106→    return {
   107→      type: 'gemini-cli',
   108→      confidence: 'high',
   109→      configPath: path.join(os.homedir(), '.gemini', 'settings.json'),
   110→      envVars: { GEMINI_CLI: '1' },
   111→    };
   112→  }
   113→
   114→  // Codex CLI: CODEX_SANDBOX is set when running in sandbox
   115→  if (process.env.CODEX_SANDBOX) {
   116→    return {
   117→      type: 'codex-cli',
   118→      confidence: 'high',
   119→      configPath: path.join(os.homedir(), '.codex', 'config.toml'),
   120→      envVars: { CODEX_SANDBOX: process.env.CODEX_SANDBOX },
   121→    };
   122→  }
   123→
   124→  // Amp (Sourcegraph): Check for AMP_API_KEY or AMP_TOOLBOX
   125→  if (process.env.AMP_API_KEY || process.env.AMP_TOOLBOX) {
   126→    return {
   127→      type: 'amp',
   128→      confidence: 'medium',
   129→      configPath: path.join(os.homedir(), '.config', 'amp', 'settings.json'),
   130→    };
   131→  }
   132→
   133→  return {
   134→    type: 'unknown',
   135→    confidence: 'low',
   136→  };
   137→}
   138→
   139→/**
   140→ * Install KSPEC_AUTHOR config for Claude Code (global settings)
   141→ */
   142→async function installClaudeCodeConfig(author: string): Promise<boolean> {
   143→  const configPath = path.join(os.homedir(), '.claude', 'settings.json');
   144→  const configDir = path.dirname(configPath);
   145→
   146→  try {
   147→    // Ensure directory exists
   148→    await fs.mkdir(configDir, { recursive: true });
   149→
   150→    // Read existing config or start fresh
   151→    let config: Record<string, unknown> = {};
   152→    try {
   153→      const existing = await fs.readFile(configPath, 'utf-8');
   154→      config = JSON.parse(existing);
   155→    } catch {
   156→      // File doesn't exist or invalid JSON, start fresh
   157→    }
   158→
   159→    // Merge env settings
   160→    const env = (config.env as Record<string, string>) || {};
   161→    env.KSPEC_AUTHOR = author;
   162→    config.env = env;
   163→
   164→    // Write back
   165→    await fs.writeFile(configPath, JSON.stringify(config, null, 2) + '\n', 'utf-8');
   166→    return true;
   167→  } catch (err) {
   168→    return false;
   169→  }
   170→}
   171→
   172→/**
   173→ * Install hooks to project-level Claude Code settings (.claude/settings.json)
   174→ */
   175→async function installClaudeCodeHooks(projectDir: string): Promise<{ stop: boolean; promptCheck: boolean }> {
   176→  const configPath = path.join(projectDir, '.claude', 'settings.json');
   177→  const configDir = path.dirname(configPath);
   178→
   179→  const result = { stop: false, promptCheck: false };
   180→
   181→  try {
   182→    // Ensure directory exists
   183→    await fs.mkdir(configDir, { recursive: true });
   184→
   185→    // Read existing config or start fresh
   186→    let config: Record<string, unknown> = {};
   187→    try {
   188→      const existing = await fs.readFile(configPath, 'utf-8');
   189→      config = JSON.parse(existing);
   190→    } catch {
   191→      // File doesn't exist or invalid JSON, start fresh
   192→    }
   193→
   194→    // Get or create hooks object
   195→    const hooks = (config.hooks as Record<string, unknown[]>) || {};
   196→
   197→    // Install UserPromptSubmit hook (spec-first reminder)
   198→    const promptCheckCommand = 'npx kspec session prompt-check';
   199→    const existingPromptHooks = hooks.UserPromptSubmit as Array<{ hooks?: Array<{ command?: string }> }> | undefined;
   200→    const promptAlreadyInstalled = existingPromptHooks?.some(
   201→      (entry) => entry.hooks?.some((hook) => hook.command?.includes('session prompt-check'))
   202→    );
   203→
   204→    if (!promptAlreadyInstalled) {
   205→      hooks.UserPromptSubmit = [
   206→        ...(existingPromptHooks || []),
   207→        {
   208→          hooks: [
   209→            {
   210→              type: 'command',
   211→              command: promptCheckCommand,
   212→            },
   213→          ],
   214→        },
   215→      ];
   216→      result.promptCheck = true;
   217→    } else {
   218→      result.promptCheck = true; // Already configured
   219→    }
   220→
   221→    // Install Stop hook (checkpoint)
   222→    const stopHookCommand = 'npx kspec session checkpoint --json';
   223→    const existingStopHooks = hooks.Stop as Array<{ matcher?: string; hooks?: Array<{ command?: string }> }> | undefined;
   224→    const stopAlreadyInstalled = existingStopHooks?.some(
   225→      (entry) => entry.hooks?.some((hook) => hook.command?.includes('session checkpoint'))
   226→    );
   227→
   228→    if (!stopAlreadyInstalled) {
   229→      hooks.Stop = [
   230→        ...(existingStopHooks || []),
   231→        {
   232→          matcher: '',
   233→          hooks: [
   234→            {
   235→              type: 'command',
   236→              command: stopHookCommand,
   237→            },
   238→          ],
   239→        },
   240→      ];
   241→      result.stop = true;
   242→    } else {
   243→      result.stop = true; // Already configured
   244→    }
   245→
   246→    config.hooks = hooks;
   247→
   248→    // Write back
   249→    await fs.writeFile(configPath, JSON.stringify(config, null, 2) + '\n', 'utf-8');
   250→    return result;
   251→  } catch {
   252→    return result;
   253→  }
   254→}
   255→
   256→/**
   257→ * Install stop hook to project-level Claude Code settings (.claude/settings.json)
   258→ * @deprecated Use installClaudeCodeHooks instead
   259→ */
   260→async function installClaudeCodeStopHook(projectDir: string): Promise<boolean> {
   261→  const configPath = path.join(projectDir, '.claude', 'settings.json');
   262→  const configDir = path.dirname(configPath);
   263→
   264→  try {
   265→    // Ensure directory exists
   266→    await fs.mkdir(configDir, { recursive: true });
   267→
   268→    // Read existing config or start fresh
   269→    let config: Record<string, unknown> = {};
   270→    try {
   271→      const existing = await fs.readFile(configPath, 'utf-8');
   272→      config = JSON.parse(existing);
   273→    } catch {
   274→      // File doesn't exist or invalid JSON, start fresh
   275→    }
   276→
   277→    // Build the stop hook command
   278→    const stopHookCommand = 'npx kspec session checkpoint --json';
   279→
   280→    // Get or create hooks object
   281→    const hooks = (config.hooks as Record<string, unknown[]>) || {};
   282→
   283→    // Check if Stop hook already exists with our command
   284→    const existingStopHooks = hooks.Stop as Array<{ matcher?: object; hooks?: Array<{ command?: string }> }> | undefined;
   285→    const alreadyInstalled = existingStopHooks?.some(
   286→      (entry) => entry.hooks?.some((hook) => hook.command?.includes('session checkpoint'))
   287→    );
   288→
   289→    if (alreadyInstalled) {
   290→      return true; // Already configured
   291→    }
   292→
   293→    // Add our stop hook using Claude Code hooks format
   294→    // Note: matcher field is required even if empty string
   295→    hooks.Stop = [
   296→      ...(existingStopHooks || []),
   297→      {
   298→        matcher: '',
   299→        hooks: [
   300→          {
   301→            type: 'command',
   302→            command: stopHookCommand,
   303→          },
   304→        ],
   305→      },
   306→    ];
   307→    config.hooks = hooks;
   308→
   309→    // Write back
   310→    await fs.writeFile(configPath, JSON.stringify(config, null, 2) + '\n', 'utf-8');
   311→    return true;
   312→  } catch {
   313→    return false;
   314→  }
   315→}
