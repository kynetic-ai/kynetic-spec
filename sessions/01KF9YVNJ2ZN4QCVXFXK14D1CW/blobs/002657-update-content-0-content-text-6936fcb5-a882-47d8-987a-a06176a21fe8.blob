```
     1→/**
     2→ * Session management commands
     3→ *
     4→ * Provides context for starting/resuming work sessions.
     5→ */
     6→
     7→import { Command } from 'commander';
     8→import chalk from 'chalk';
     9→import {
    10→  initContext,
    11→  loadAllTasks,
    12→  loadAllItems,
    13→  loadInboxItems,
    14→  loadMetaContext,
    15→  loadSessionContext,
    16→  getReadyTasks,
    17→  ReferenceIndex,
    18→  type LoadedTask,
    19→  type LoadedInboxItem,
    20→  type KspecContext,
    21→} from '../../parser/index.js';
    22→import type { SessionContext as StoredSessionContext } from '../../schema/index.js';
    23→import { output, error, info, isJsonMode } from '../output.js';
    24→import { sessionHeaders, hints, sessionPrompt, errors } from '../../strings/index.js';
    25→import {
    26→  parseTimeSpec,
    27→  formatRelativeTime,
    28→  isGitRepo,
    29→  getRecentCommits,
    30→  getCurrentBranch,
    31→  getWorkingTreeStatus,
    32→  formatCommitGuidance,
    33→  type GitCommit,
    34→  type GitWorkingTree,
    35→} from '../../utils/index.js';
    36→import { shadowPull, type ShadowSyncResult } from '../../parser/shadow.js';
    37→import type { Note, Todo } from '../../schema/index.js';
    38→
    39→// ─── Types ───────────────────────────────────────────────────────────────────
    40→
    41→export interface CheckpointResult {
    42→  /** Whether session can end cleanly */
    43→  ok: boolean;
    44→
    45→  /** Human-readable message for Claude Code */
    46→  message: string;
    47→
    48→  /** Issues that need attention before stopping */
    49→  issues: CheckpointIssue[];
    50→
    51→  /** Instructions for the agent */
    52→  instructions: string[];
    53→}
    54→
    55→export interface CheckpointIssue {
    56→  type: 'uncommitted_changes' | 'in_progress_task' | 'incomplete_todo';
    57→  description: string;
    58→  details?: Record<string, unknown>;
    59→}
    60→
    61→export interface SessionContext {
    62→  /** When this context was generated */
    63→  generated_at: string;
    64→
    65→  /** Current git branch */
    66→  branch: string | null;
    67→
    68→  /** Session context (focus, threads, questions) */
    69→  context: StoredSessionContext | null;
    70→
    71→  /** Tasks currently in progress */
    72→  active_tasks: ActiveTaskSummary[];
    73→
    74→  /** Recent notes from active tasks */
    75→  recent_notes: NoteSummary[];
    76→
    77→  /** Incomplete todos from active tasks */
    78→  active_todos: TodoSummary[];
    79→
    80→  /** Tasks ready to be picked up */
    81→  ready_tasks: ReadyTaskSummary[];
    82→
    83→  /** Blocked tasks with blockers */
    84→  blocked_tasks: BlockedTaskSummary[];
    85→
    86→  /** Recently completed tasks */
    87→  recently_completed: CompletedTaskSummary[];
    88→
    89→  /** Recent git commits */
    90→  recent_commits: CommitSummary[];
    91→
    92→  /** Working tree status */
    93→  working_tree: GitWorkingTree | null;
    94→
    95→  /** Inbox items awaiting triage (oldest first) */
    96→  inbox_items: InboxSummary[];
    97→
    98→  /** Summary statistics */
    99→  stats: SessionStats;
   100→}
   101→
   102→export interface ActiveTaskSummary {
   103→  ref: string;
   104→  title: string;
   105→  started_at: string | null;
   106→  priority: number;
   107→  spec_ref: string | null;
   108→  note_count: number;
   109→  last_note_at: string | null;
   110→  todo_count: number;
   111→  incomplete_todos: number;
   112→}
   113→
   114→export interface NoteSummary {
   115→  task_ref: string;
   116→  task_title: string;
   117→  note_ulid: string;
   118→  created_at: string;
   119→  author: string | null;
   120→  content: string;
   121→}
   122→
   123→export interface TodoSummary {
   124→  task_ref: string;
   125→  task_title: string;
   126→  id: number;
   127→  text: string;
   128→  added_at: string;
   129→  added_by: string | null;
   130→}
   131→
   132→export interface ReadyTaskSummary {
   133→  ref: string;
   134→  title: string;
   135→  priority: number;
   136→  spec_ref: string | null;
   137→  tags: string[];
   138→}
   139→
   140→export interface BlockedTaskSummary {
   141→  ref: string;
   142→  title: string;
   143→  blocked_by: string[];
   144→  unmet_deps: string[];
   145→}
   146→
   147→export interface CompletedTaskSummary {
   148→  ref: string;
   149→  title: string;
   150→  completed_at: string;
   151→  closed_reason: string | null;
   152→  origin?: 'manual' | 'derived' | 'observation_promotion';
   153→}
   154→
   155→export interface CommitSummary {
   156→  hash: string;
   157→  full_hash: string;
   158→  date: string;
   159→  message: string;
   160→  author: string;
   161→}
   162→
   163→export interface SessionStats {
   164→  total_tasks: number;
   165→  in_progress: number;
   166→  ready: number;
   167→  blocked: number;
   168→  completed: number;
   169→  inbox_items: number;
   170→}
   171→
   172→export interface InboxSummary {
   173→  ref: string;
   174→  text: string;
   175→  created_at: string;
   176→  tags: string[];
   177→  added_by: string | null;
   178→}
   179→
   180→export interface SessionOptions {
   181→  brief?: boolean;
   182→  full?: boolean;
   183→  since?: string;
   184→  git?: boolean;
   185→  limit?: string;
   186→}
   187→
   188→// ─── Data Gathering ──────────────────────────────────────────────────────────
   189→
   190→function toActiveTaskSummary(
   191→  task: LoadedTask,
   192→  index: ReferenceIndex
   193→): ActiveTaskSummary {
   194→  const lastNote =
   195→    task.notes.length > 0 ? task.notes[task.notes.length - 1] : null;
   196→  const incompleteTodos = task.todos.filter(t => !t.done).length;
   197→  return {
   198→    ref: index.shortUlid(task._ulid),
   199→    title: task.title,
   200→    started_at: task.started_at || null,
   201→    priority: task.priority,
   202→    spec_ref: task.spec_ref || null,
   203→    note_count: task.notes.length,
   204→    last_note_at: lastNote ? lastNote.created_at : null,
   205→    todo_count: task.todos.length,
   206→    incomplete_todos: incompleteTodos,
   207→  };
   208→}
   209→
   210→function toReadyTaskSummary(
   211→  task: LoadedTask,
   212→  index: ReferenceIndex
   213→): ReadyTaskSummary {
   214→  return {
   215→    ref: index.shortUlid(task._ulid),
   216→    title: task.title,
   217→    priority: task.priority,
   218→    spec_ref: task.spec_ref || null,
   219→    tags: task.tags,
   220→  };
   221→}
   222→
   223→function toBlockedTaskSummary(
   224→  task: LoadedTask,
   225→  allTasks: LoadedTask[],
   226→  index: ReferenceIndex
   227→): BlockedTaskSummary {
   228→  // Find unmet dependencies
   229→  const unmetDeps: string[] = [];
   230→  for (const depRef of task.depends_on) {
   231→    const result = index.resolve(depRef);
   232→    if (result.ok) {
   233→      const depItem = result.item;
   234→      if ('status' in depItem && depItem.status !== 'completed') {
   235→        unmetDeps.push(depRef);
   236→      }
   237→    }
   238→  }
   239→
   240→  return {
   241→    ref: index.shortUlid(task._ulid),
   242→    title: task.title,
   243→    blocked_by: task.blocked_by,
   244→    unmet_deps: unmetDeps,
   245→  };
   246→}
   247→
   248→function toCompletedTaskSummary(
   249→  task: LoadedTask,
   250→  index: ReferenceIndex
   251→): CompletedTaskSummary {
   252→  return {
   253→    ref: index.shortUlid(task._ulid),
   254→    title: task.title,
   255→    completed_at: task.completed_at || '',
   256→    closed_reason: task.closed_reason || null,
   257→    origin: task.origin,
   258→  };
   259→}
   260→
   261→function collectRecentNotes(
   262→  tasks: LoadedTask[],
   263→  index: ReferenceIndex,
   264→  options: { limit: number; since: Date | null }
   265→): NoteSummary[] {
   266→  const allNotes: NoteSummary[] = [];
   267→
   268→  for (const task of tasks) {
   269→    for (const note of task.notes) {
   270→      const noteDate = new Date(note.created_at);
   271→
   272→      // Filter by since date if provided
   273→      if (options.since && noteDate < options.since) {
   274→        continue;
   275→      }
   276→
   277→      allNotes.push({
   278→        task_ref: index.shortUlid(task._ulid),
   279→        task_title: task.title,
   280→        note_ulid: note._ulid.slice(0, 8),
   281→        created_at: note.created_at,
   282→        author: note.author || null,
   283→        content: note.content,
   284→      });
   285→    }
   286→  }
   287→
   288→  // Sort by date descending, take limit
   289→  return allNotes
   290→    .sort(
   291→      (a, b) =>
   292→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime()
   293→    )
   294→    .slice(0, options.limit);
   295→}
   296→
   297→function collectIncompleteTodos(
   298→  tasks: LoadedTask[],
   299→  index: ReferenceIndex,
   300→  options: { limit: number }
   301→): TodoSummary[] {
   302→  const allTodos: TodoSummary[] = [];
   303→
   304→  for (const task of tasks) {
   305→    for (const todo of task.todos) {
   306→      // Only include incomplete todos
   307→      if (todo.done) continue;
   308→
   309→      allTodos.push({
   310→        task_ref: index.shortUlid(task._ulid),
   311→        task_title: task.title,
   312→        id: todo.id,
   313→        text: todo.text,
   314→        added_at: todo.added_at,
   315→        added_by: todo.added_by || null,
   316→      });
   317→    }
   318→  }
   319→
   320→  // Sort by added_at descending (most recent first), take limit
   321→  return allTodos
   322→    .sort(
   323→      (a, b) =>
   324→        new Date(b.added_at).getTime() - new Date(a.added_at).getTime()
   325→    )
   326→    .slice(0, options.limit);
   327→}
   328→
   329→/**
   330→ * Gather session context data
   331→ */
   332→export async function gatherSessionContext(
   333→  ctx: KspecContext,
   334→  options: SessionOptions
   335→): Promise<SessionContext> {
   336→  const limit = parseInt(options.limit || '10', 10);
   337→  const sinceDate = options.since ? parseTimeSpec(options.since) : null;
   338→  const showGit = options.git !== false; // default true
   339→
   340→  // Load all data
   341→  const allTasks = await loadAllTasks(ctx);
   342→  const items = await loadAllItems(ctx);
   343→  const inboxItems = await loadInboxItems(ctx);
   344→  const index = new ReferenceIndex(allTasks, items);
   345→
   346→  // Compute stats
   347→  const stats: SessionStats = {
   348→    total_tasks: allTasks.length,
   349→    in_progress: allTasks.filter((t) => t.status === 'in_progress').length,
   350→    ready: getReadyTasks(allTasks).length,
   351→    blocked: allTasks.filter((t) => t.status === 'blocked').length,
   352→    completed: allTasks.filter((t) => t.status === 'completed').length,
   353→    inbox_items: inboxItems.length,
   354→  };
   355→
   356→  // Get active tasks
   357→  const activeTasks = allTasks
   358→    .filter((t) => t.status === 'in_progress')
   359→    .sort((a, b) => a.priority - b.priority)
   360→    .slice(0, options.full ? undefined : limit)
   361→    .map((t) => toActiveTaskSummary(t, index));
   362→
   363→  // Get recent notes from active tasks
   364→  const recentNotes = collectRecentNotes(
   365→    allTasks.filter((t) => t.status === 'in_progress'),
   366→    index,
   367→    { limit: options.full ? limit * 2 : limit, since: sinceDate }
   368→  );
   369→
   370→  // Get incomplete todos from active tasks
   371→  const activeTodos = collectIncompleteTodos(
   372→    allTasks.filter((t) => t.status === 'in_progress'),
   373→    index,
   374→    { limit: options.full ? limit * 2 : limit }
   375→  );
   376→
   377→  // Get ready tasks
   378→  const readyTasks = getReadyTasks(allTasks)
   379→    .slice(0, options.full ? undefined : limit)
   380→    .map((t) => toReadyTaskSummary(t, index));
   381→
   382→  // Get blocked tasks
   383→  const blockedTasks = allTasks
   384→    .filter((t) => t.status === 'blocked')
   385→    .slice(0, options.full ? undefined : limit)
   386→    .map((t) => toBlockedTaskSummary(t, allTasks, index));
   387→
   388→  // Get recently completed tasks
   389→  const recentlyCompleted = allTasks
   390→    .filter((t) => {
   391→      if (t.status !== 'completed' || !t.completed_at) return false;
   392→      const completedDate = new Date(t.completed_at);
   393→      if (sinceDate && completedDate < sinceDate) return false;
   394→      return true;
   395→    })
   396→    .sort((a, b) => {
   397→      // Sort by completed_at descending (most recent first)
   398→      const aDate = new Date(a.completed_at || 0);
   399→      const bDate = new Date(b.completed_at || 0);
   400→      return bDate.getTime() - aDate.getTime();
   401→    })
   402→    .slice(0, options.full ? undefined : limit)
   403→    .map((t) => toCompletedTaskSummary(t, index));
   404→
   405→  // Get git info
   406→  let branch: string | null = null;
   407→  let recentCommits: CommitSummary[] = [];
   408→  let workingTree: GitWorkingTree | null = null;
   409→
   410→  if (showGit && isGitRepo(ctx.rootDir)) {
   411→    branch = getCurrentBranch(ctx.rootDir);
   412→
   413→    const commits = getRecentCommits({
   414→      limit: options.full ? limit * 2 : limit,
   415→      since: sinceDate || undefined,
   416→      cwd: ctx.rootDir,
   417→    });
   418→
   419→    recentCommits = commits.map((c) => ({
   420→      hash: c.hash,
   421→      full_hash: c.fullHash,
   422→      date: c.date.toISOString(),
   423→      message: c.message,
   424→      author: c.author,
   425→    }));
   426→
   427→    workingTree = getWorkingTreeStatus(ctx.rootDir);
   428→  }
   429→
   430→  // Get inbox items (oldest first to encourage triage)
   431→  const inboxSummaries: InboxSummary[] = inboxItems
   432→    .sort((a, b) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime())
   433→    .slice(0, options.full ? undefined : limit)
   434→    .map((item) => ({
   435→      ref: item._ulid.slice(0, 8),
   436→      text: item.text,
   437→      created_at: item.created_at,
   438→      tags: item.tags,
   439→      added_by: item.added_by || null,
   440→    }));
   441→
   442→  // Load session context (focus, threads, questions)
   443→  const sessionContext = await loadSessionContext(ctx);
   444→
   445→  return {
   446→    generated_at: new Date().toISOString(),
   447→    branch,
   448→    context: sessionContext,
   449→    active_tasks: activeTasks,
   450→    recent_notes: recentNotes,
   451→    active_todos: activeTodos,
   452→    ready_tasks: readyTasks,
   453→    blocked_tasks: blockedTasks,
   454→    recently_completed: recentlyCompleted,
   455→    recent_commits: recentCommits,
   456→    working_tree: workingTree,
   457→    inbox_items: inboxSummaries,
   458→    stats,
   459→  };
   460→}
   461→
   462→// ─── Checkpoint ──────────────────────────────────────────────────────────────
   463→
   464→export interface CheckpointOptions {
   465→  force?: boolean;
   466→  /** Set when stop hook is already active (retry after previous block) */
   467→  stopHookActive?: boolean;
   468→}
   469→
   470→/** Claude Code hook input for Stop hooks */
   471→export interface StopHookInput {
   472→  session_id?: string;
   473→  transcript_path?: string;
   474→  hook_event_name?: string;
   475→  stop_hook_active?: boolean;
   476→}
   477→
   478→/**
   479→ * Perform session checkpoint - check for uncommitted work before ending session.
   480→ *
   481→ * This is designed for use as a Claude Code stop hook. It checks for:
   482→ * - Uncommitted git changes (staged, unstaged, untracked)
   483→ * - Tasks in in_progress status
   484→ * - Incomplete todos on active tasks
   485→ *
   486→ * Returns a structured result indicating whether the session can end cleanly.
   487→ */
   488→export async function performCheckpoint(
   489→  ctx: KspecContext,
   490→  options: CheckpointOptions
   491→): Promise<CheckpointResult> {
   492→  const issues: CheckpointIssue[] = [];
   493→  const instructions: string[] = [];
   494→
   495→  // Load tasks
   496→  const allTasks = await loadAllTasks(ctx);
   497→
   498→  // Check for in-progress tasks
   499→  const inProgressTasks = allTasks.filter((t) => t.status === 'in_progress');
   500→  for (const task of inProgressTasks) {
   501→    const ref = task.slugs[0] ? `@${task.slugs[0]}` : `@${task._ulid.slice(0, 8)}`;
   502→    issues.push({
   503→      type: 'in_progress_task',
   504→      description: `Task ${ref} is still in progress: ${task.title}`,
   505→      details: {
   506→        ref,
   507→        title: task.title,
   508→        started_at: task.started_at,
   509→      },
   510→    });
   511→
   512→    // Check for incomplete todos on this task
   513→    const incompleteTodos = task.todos.filter((t) => !t.done);
   514→    for (const todo of incompleteTodos) {
   515→      issues.push({
   516→        type: 'incomplete_todo',
   517→        description: `Incomplete todo on ${ref}: ${todo.text}`,
   518→        details: {
   519→          task_ref: ref,
   520→          todo_id: todo.id,
   521→          text: todo.text,
   522→        },
   523→      });
   524→    }
   525→  }
   526→
   527→  // Check for uncommitted git changes
   528→  if (isGitRepo(ctx.rootDir)) {
   529→    const workingTree = getWorkingTreeStatus(ctx.rootDir);
   530→    if (!workingTree.clean) {
   531→      const changeCount =
   532→        workingTree.staged.length +
   533→        workingTree.unstaged.length +
   534→        workingTree.untracked.length;
   535→
   536→      issues.push({
   537→        type: 'uncommitted_changes',
   538→        description: `${changeCount} uncommitted changes in working tree`,
   539→        details: {
   540→          staged: workingTree.staged.length,
   541→          unstaged: workingTree.unstaged.length,
   542→          untracked: workingTree.untracked.length,
   543→        },
   544→      });
   545→    }
   546→  }
   547→
   548→  // Build instructions based on issues
   549→  if (issues.length > 0 && !options.force) {
   550→    instructions.push('Before ending this session, please:');
   551→
   552→    const hasInProgress = issues.some((i) => i.type === 'in_progress_task');
   553→    const hasUncommitted = issues.some((i) => i.type === 'uncommitted_changes');
   554→    const hasIncompleteTodos = issues.some((i) => i.type === 'incomplete_todo');
   555→
   556→    let step = 1;
   557→
   558→    if (hasInProgress) {
   559→      instructions.push(
   560→        `${step++}. Add notes to in-progress tasks documenting current state`
   561→      );
   562→      instructions.push(
   563→        `${step++}. Either complete the tasks or leave them in_progress with clear notes for next session`
   564→      );
   565→    }
   566→
   567→    if (hasIncompleteTodos) {
   568→      instructions.push(
   569→        `${step++}. Complete or acknowledge incomplete todos on active tasks`
   570→      );
   571→    }
   572→
   573→    if (hasUncommitted) {
   574→      instructions.push(`${step++}. Commit your changes with a descriptive message`);
   575→
   576→      // Add WIP commit guidance if there are in-progress tasks
   577→      if (inProgressTasks.length > 0) {
   578→        const task = inProgressTasks[0];
   579→        const guidance = formatCommitGuidance(task, { wip: true });
   580→        instructions.push('');
   581→        instructions.push('Suggested WIP commit:');
   582→        instructions.push(`  ${guidance.message}`);
   583→        instructions.push('');
   584→        for (const trailer of guidance.trailers) {
   585→          instructions.push(`  ${trailer}`);
   586→        }
   587→      }
   588→    }
   589→
   590→    instructions.push('');
   591→    instructions.push(
   592→      'Use: kspec task note @task "Progress notes..." to document state'
   593→    );
   594→    instructions.push(
   595→      'Use: kspec task complete @task --reason "Summary" if task is done'
   596→    );
   597→  }
   598→
   599→  // Allow stop if:
   600→  // - No issues found
   601→  // - --force flag passed
   602→  // - This is a retry (stop_hook_active = true from previous block)
   603→  const isRetry = options.stopHookActive === true;
   604→  const ok = issues.length === 0 || options.force === true || isRetry;
   605→
   606→  let message: string;
   607→  if (isRetry && issues.length > 0) {
   608→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) acknowledged - allowing stop`;
   609→  } else if (ok) {
   610→    message = '[kspec] Session checkpoint passed - ready to end session';
   611→  } else {
   612→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) need attention`;
   613→  }
   614→
   615→  return {
   616→    ok,
   617→    message,
   618→    issues,
   619→    instructions,
   620→  };
   621→}
   622→
   623→// ─── Output Formatting ───────────────────────────────────────────────────────
   624→
   625→function formatCheckpointResult(result: CheckpointResult): void {
   626→  if (result.ok) {
   627→    console.log(chalk.green(result.message));
   628→  } else {
   629→    console.log(chalk.yellow(result.message));
   630→    console.log('');
   631→
   632→    for (const issue of result.issues) {
   633→      const icon =
   634→        issue.type === 'uncommitted_changes'
   635→          ? chalk.yellow('⚠')
   636→          : issue.type === 'in_progress_task'
   637→            ? chalk.blue('●')
   638→            : chalk.gray('○');
   639→      console.log(`  ${icon} ${issue.description}`);
   640→    }
   641→
   642→    if (result.instructions.length > 0) {
   643→      console.log('');
   644→      for (const instruction of result.instructions) {
   645→        console.log(chalk.gray(instruction));
   646→      }
   647→    }
   648→  }
   649→}
   650→
   651→function formatSessionContext(ctx: SessionContext, options: SessionOptions): void {
   652→  const isBrief = !options.full;
   653→
   654→  // Header
   655→  console.log(`\n${sessionHeaders.title}`);
   656→  const age = formatRelativeTime(new Date(ctx.generated_at));
   657→  if (ctx.branch) {
   658→    console.log(chalk.gray(`Branch: ${ctx.branch} | Generated: ${age}`));
   659→  } else {
   660→    console.log(chalk.gray(`Generated: ${age}`));
   661→  }
   662→
   663→  // Stats summary
   664→  const inboxNote = ctx.stats.inbox_items > 0
   665→    ? ` | Inbox: ${ctx.stats.inbox_items}`
   666→    : '';
   667→  console.log(
   668→    chalk.gray(
   669→      `Tasks: ${ctx.stats.in_progress} active, ${ctx.stats.ready} ready, ` +
   670→        `${ctx.stats.blocked} blocked, ${ctx.stats.completed}/${ctx.stats.total_tasks} completed${inboxNote}`
   671→    )
   672→  );
   673→
   674→  // Session context section (focus, threads, questions)
   675→  if (ctx.context && (ctx.context.focus || ctx.context.threads.length > 0 || ctx.context.open_questions.length > 0)) {
   676→    console.log('\n--- Session Context ---');
   677→
   678→    if (ctx.context.focus) {
   679→      console.log(`  ${chalk.cyan('Focus:')} ${ctx.context.focus}`);
   680→    }
   681→
   682→    if (ctx.context.threads.length > 0) {
   683→      console.log(`  ${chalk.cyan('Active Threads:')}`);
   684→      for (const thread of ctx.context.threads) {
   685→        console.log(`    - ${thread}`);
   686→      }
   687→    }
   688→
   689→    if (ctx.context.open_questions.length > 0) {
   690→      console.log(`  ${chalk.cyan('Open Questions:')}`);
   691→      for (const question of ctx.context.open_questions) {
   692→        console.log(`    - ${question}`);
   693→      }
   694→    }
   695→  }
   696→
   697→  // Active tasks section
   698→  if (ctx.active_tasks.length > 0) {
   699→    console.log(`\n${sessionHeaders.activeWork}`);
   700→    for (const task of ctx.active_tasks) {
   701→      const started = task.started_at
   702→        ? chalk.gray(` (started ${formatRelativeTime(new Date(task.started_at))})`)
   703→        : '';
   704→      const priority =
   705→        task.priority <= 2
   706→          ? chalk.red(`P${task.priority}`)
   707→          : chalk.gray(`P${task.priority}`);
   708→      console.log(
   709→        `  ${chalk.blue('[in_progress]')} ${priority} ${task.ref} ${task.title}${started}`
   710→      );
   711→    }
   712→  } else {
   713→    console.log(`\n${sessionHeaders.noActiveWork}`);
   714→  }
   715→
   716→  // Recently completed section
   717→  if (ctx.recently_completed.length > 0) {
   718→    console.log(`\n${sessionHeaders.recentlyCompleted}`);
   719→    const observationPromotedTasks: string[] = [];
   720→    for (const task of ctx.recently_completed) {
   721→      const completedAge = formatRelativeTime(new Date(task.completed_at));
   722→      let reason = '';
   723→      if (task.closed_reason) {
   724→        const maxLen = isBrief ? 60 : 120;
   725→        const truncated = task.closed_reason.length > maxLen
   726→          ? task.closed_reason.slice(0, maxLen).trim() + '...'
   727→          : task.closed_reason;
   728→        reason = chalk.gray(` - ${truncated}`);
   729→      }
   730→      console.log(
   731→        `  ${chalk.green('[completed]')} ${task.ref} ${task.title} ${chalk.gray(`(${completedAge})`)}${reason}`
   732→      );
   733→
   734→      // Track tasks that came from observations
   735→      if (task.origin === 'observation_promotion') {
   736→        observationPromotedTasks.push(task.ref);
   737→      }
   738→    }
   739→
   740→    // Show reminder about resolving observations
   741→    if (observationPromotedTasks.length > 0) {
   742→      console.log(chalk.yellow(`\n  ℹ Consider resolving linked observations: ${observationPromotedTasks.join(', ')}`));
   743→      console.log(chalk.gray(`    Run: kspec meta observations --pending-resolution`));
   744→    }
   745→  }
   746→
   747→  // Recent notes section
   748→  if (ctx.recent_notes.length > 0) {
   749→    console.log(`\n${sessionHeaders.recentNotes}`);
   750→    for (const note of ctx.recent_notes) {
   751→      const age = formatRelativeTime(new Date(note.created_at));
   752→      const author = note.author ? chalk.gray(` by ${note.author}`) : '';
   753→      console.log(`  ${chalk.yellow(age)} on ${note.task_ref}${author}:`);
   754→
   755→      // Truncate content in brief mode
   756→      let content = note.content.trim();
   757→      if (isBrief && content.length > 200) {
   758→        content = content.slice(0, 200).trim() + '...';
   759→      }
   760→
   761→      // Indent content, limit lines in brief mode
   762→      const lines = content.split('\n');
   763→      const maxLines = isBrief ? 3 : lines.length;
   764→      for (const line of lines.slice(0, maxLines)) {
   765→        console.log(`    ${chalk.white(line)}`);
   766→      }
   767→      if (isBrief && lines.length > maxLines) {
   768→        console.log(chalk.gray(`    ... (${lines.length - maxLines} more lines)`));
   769→      }
   770→    }
   771→  }
   772→
   773→  // Incomplete todos section
   774→  if (ctx.active_todos.length > 0) {
   775→    console.log(`\n${sessionHeaders.incompleteTodos}`);
   776→    for (const todo of ctx.active_todos) {
   777→      console.log(`  ${chalk.yellow('[ ]')} ${todo.task_ref}#${todo.id}: ${todo.text}`);
   778→    }
   779→  }
   780→
   781→  // Ready tasks section
   782→  if (ctx.ready_tasks.length > 0) {
   783→    console.log(`\n${sessionHeaders.readyTasks}`);
   784→    for (const task of ctx.ready_tasks) {
   785→      const priority =
   786→        task.priority <= 2
   787→          ? chalk.red(`P${task.priority}`)
   788→          : chalk.gray(`P${task.priority}`);
   789→      const tags =
   790→        task.tags.length > 0 ? chalk.cyan(` #${task.tags.join(' #')}`) : '';
   791→      console.log(`  ${priority} ${task.ref} ${task.title}${tags}`);
   792→    }
   793→  }
   794→
   795→  // Blocked tasks section
   796→  if (ctx.blocked_tasks.length > 0) {
   797→    console.log(`\n${sessionHeaders.blocked}`);
   798→    for (const task of ctx.blocked_tasks) {
   799→      console.log(`  ${chalk.red('[blocked]')} ${task.ref} ${task.title}`);
   800→      if (task.blocked_by.length > 0) {
   801→        console.log(chalk.gray(`    Blockers: ${task.blocked_by.join(', ')}`));
   802→      }
   803→      if (task.unmet_deps.length > 0) {
   804→        console.log(chalk.gray(`    Waiting on: ${task.unmet_deps.join(', ')}`));
   805→      }
   806→    }
   807→  }
   808→
   809→  // Git commits section
   810→  if (ctx.recent_commits.length > 0) {
   811→    console.log(`\n${sessionHeaders.recentCommits}`);
   812→    for (const commit of ctx.recent_commits) {
   813→      const age = formatRelativeTime(new Date(commit.date));
   814→      console.log(
   815→        `  ${chalk.yellow(commit.hash)} ${commit.message} ${chalk.gray(`(${age}, ${commit.author})`)}`
   816→      );
   817→    }
   818→  }
   819→
   820→  // Inbox section (oldest first to encourage triage)
   821→  if (ctx.inbox_items.length > 0) {
   822→    console.log(`\n${sessionHeaders.inbox}`);
   823→    for (const item of ctx.inbox_items) {
   824→      const age = formatRelativeTime(new Date(item.created_at));
   825→      const author = item.added_by ? ` by ${item.added_by}` : '';
   826→      const tags = item.tags.length > 0 ? chalk.cyan(` [${item.tags.join(', ')}]`) : '';
   827→      // Truncate text in brief mode
   828→      let text = item.text;
   829→      if (isBrief && text.length > 60) {
   830→        text = text.slice(0, 60).trim() + '...';
   831→      }
   832→      console.log(`  ${chalk.magenta(item.ref)} ${chalk.gray(`(${age}${author})`)}${tags}`);
   833→      console.log(`    ${text}`);
   834→    }
   835→    console.log(`  ${hints.inboxPromote}`);
   836→  }
   837→
   838→  // Working tree section
   839→  if (ctx.working_tree && !ctx.working_tree.clean) {
   840→    console.log(`\n${sessionHeaders.workingTree}`);
   841→
   842→    if (ctx.working_tree.staged.length > 0) {
   843→      console.log(chalk.green('  Staged:'));
   844→      for (const file of ctx.working_tree.staged) {
   845→        console.log(`    ${chalk.green(file.status[0].toUpperCase())} ${file.path}`);
   846→      }
   847→    }
   848→
   849→    if (ctx.working_tree.unstaged.length > 0) {
   850→      console.log(chalk.red('  Modified:'));
   851→      for (const file of ctx.working_tree.unstaged) {
   852→        console.log(`    ${chalk.red(file.status[0].toUpperCase())} ${file.path}`);
   853→      }
   854→    }
   855→
   856→    if (ctx.working_tree.untracked.length > 0) {
   857→      console.log(chalk.gray('  Untracked:'));
   858→      const limit = isBrief ? 5 : ctx.working_tree.untracked.length;
   859→      for (const path of ctx.working_tree.untracked.slice(0, limit)) {
   860→        console.log(`    ${chalk.gray('?')} ${path}`);
   861→      }
   862→      if (isBrief && ctx.working_tree.untracked.length > limit) {
   863→        console.log(chalk.gray(`    ... and ${ctx.working_tree.untracked.length - limit} more`));
   864→      }
   865→    }
   866→  } else if (ctx.working_tree?.clean) {
   867→    console.log(`\n${sessionHeaders.workingTreeClean}`);
   868→  }
   869→
   870→  // Quick Commands section - contextual hints based on state
   871→  const quickCommands: string[] = [];
   872→
   873→  if (ctx.active_tasks.length > 0) {
   874→    const ref = ctx.active_tasks[0].ref;
   875→    quickCommands.push(`kspec task note @${ref} "Progress..."  ${chalk.gray('# document work')}`);
   876→    quickCommands.push(`kspec task complete @${ref} --reason "..."  ${chalk.gray('# finish task')}`);
   877→  } else if (ctx.ready_tasks.length > 0) {
   878→    const ref = ctx.ready_tasks[0].ref;
   879→    quickCommands.push(`kspec task start @${ref}  ${chalk.gray('# begin work')}`);
   880→  }
   881→
   882→  if (ctx.inbox_items.length > 0) {
   883→    const ref = ctx.inbox_items[0].ref;
   884→    quickCommands.push(`kspec inbox promote @${ref} --title "..."  ${chalk.gray('# convert to task')}`);
   885→  }
   886→
   887→  if (ctx.working_tree && !ctx.working_tree.clean) {
   888→    quickCommands.push(`git add . && git commit -m "..."  ${chalk.gray('# commit changes')}`);
   889→  }
   890→
   891→  if (quickCommands.length > 0) {
   892→    console.log(`\n${sessionHeaders.quickCommands}`);
   893→    for (const hint of quickCommands) {
   894→      console.log(`  ${hint}`);
   895→    }
   896→  }
   897→
   898→  console.log(''); // Final newline
   899→}
   900→
   901→// ─── Command Registration ────────────────────────────────────────────────────
   902→
   903→async function sessionStartAction(options: SessionOptions): Promise<void> {
   904→  try {
   905→    const ctx = await initContext();
   906→
   907→    // AC-2: Pull remote changes before showing session context
   908→    let syncResult: ShadowSyncResult | null = null;
   909→    if (ctx.shadow?.enabled) {
   910→      syncResult = await shadowPull(ctx.shadow.worktreeDir);
   911→      // AC-3: Warn about conflicts but continue with local state
   912→      if (syncResult.hadConflict) {
   913→        console.log(
   914→          chalk.yellow('⚠ Shadow sync conflict detected. Run `kspec shadow resolve` to fix.')
   915→        );
   916→        console.log(chalk.gray('  Continuing with local state...'));
   917→        console.log('');
   918→      } else if (syncResult.pulled) {
   919→        console.log(chalk.gray('ℹ Synced shadow branch from remote'));
   920→      }
   921→    }
   922→
   923→    const sessionCtx = await gatherSessionContext(ctx, options);
   924→
   925→    output(sessionCtx, () => formatSessionContext(sessionCtx, options));
   926→  } catch (err) {
   927→    error(errors.failures.gatherSessionContext, err);
   928→    process.exit(1);
   929→  }
   930→}
   931→
   932→/**
   933→ * Read stdin if available (non-blocking check for hook input)
   934→ */
   935→async function readStdinIfAvailable(): Promise<string | null> {
   936→  // Check if stdin is a TTY (interactive) - if so, don't try to read
   937→  if (process.stdin.isTTY) {
   938→    return null;
   939→  }
   940→
   941→  return new Promise((resolve) => {
   942→    let data = '';
   943→    const timeout = setTimeout(() => {
   944→      process.stdin.removeAllListeners();
   945→      resolve(data || null);
   946→    }, 100); // 100ms timeout for stdin
   947→
   948→    process.stdin.setEncoding('utf8');
   949→    process.stdin.on('data', (chunk) => {
   950→      data += chunk;
   951→    });
   952→    process.stdin.on('end', () => {
   953→      clearTimeout(timeout);
   954→      resolve(data || null);
   955→    });
   956→    process.stdin.on('error', () => {
   957→      clearTimeout(timeout);
   958→      resolve(null);
   959→    });
   960→    process.stdin.resume();
   961→  });
   962→}
   963→
   964→/**
   965→ * Parse Claude Code hook input from stdin
   966→ */
   967→function parseHookInput(stdin: string | null): StopHookInput | null {
   968→  if (!stdin) return null;
   969→  try {
   970→    return JSON.parse(stdin.trim()) as StopHookInput;
   971→  } catch {
   972→    return null;
   973→  }
   974→}
   975→
   976→// ─── Prompt Check (UserPromptSubmit Hook) ────────────────────────────────────
   977→
   978→/**
   979→ * Output spec-first reminder for UserPromptSubmit hook.
   980→ *
   981→ * This is a simple context injection - always outputs the reminder,
   982→ * and Claude (Opus) is smart enough to apply it when relevant.
   983→ */
   984→async function sessionPromptCheckAction(): Promise<void> {
   985→  // Lean, instructive reminder with kspec prefix
   986→  console.log(sessionPrompt.specCheck);
   987→}
   988→
   989→async function sessionCheckpointAction(options: CheckpointOptions): Promise<void> {
   990→  try {
   991→    // Read stdin for Claude Code hook input
   992→    const stdin = await readStdinIfAvailable();
   993→    const hookInput = parseHookInput(stdin);
   994→
   995→    // Check if this is a retry (stop hook already active)
   996→    if (hookInput?.stop_hook_active) {
   997→      options.stopHookActive = true;
   998→    }
   999→
  1000→    const ctx = await initContext();
  1001→    const result = await performCheckpoint(ctx, options);
  1002→
  1003→    // Output format depends on mode:
  1004→    // - JSON mode (--json): Output Claude Code hook format {"decision": "block", "reason": "..."}
  1005→    // - Human mode: Output formatted checkpoint result
  1006→    if (isJsonMode()) {
  1007→      if (!result.ok) {
  1008→        // Build reason message with issues and instructions
  1009→        const issueLines = result.issues.map(i => `- ${i.description}`).join('\n');
  1010→        const instructionLines = result.instructions.filter(i => i.trim()).join('\n');
  1011→        const reason = `${result.message}\n\nIssues:\n${issueLines}\n\n${instructionLines}`;
  1012→        console.log(JSON.stringify({ decision: 'block', reason }));
  1013→      }
  1014→      // If ok, exit silently (Claude Code expects no output when allowing stop)
  1015→    } else {
  1016→      formatCheckpointResult(result);
  1017→      if (!result.ok) {
  1018→        process.exit(1);
  1019→      }
  1020→    }
  1021→  } catch (err) {
  1022→    error(errors.failures.runCheckpoint, err);
  1023→    process.exit(1);
  1024→  }
  1025→}
  1026→
  1027→/**
  1028→ * Register the 'session' command group and aliases
  1029→ */
  1030→export function registerSessionCommands(program: Command): void {
  1031→  const session = program
  1032→    .command('session')
  1033→    .description('Session management and context');
  1034→
  1035→  session
  1036→    .command('start')
  1037→    .alias('resume')
  1038→    .description('Surface relevant context for starting a new working session')
  1039→    .option('--brief', 'Compact summary (default)')
  1040→    .option('--full', 'Comprehensive context dump')
  1041→    .option('--since <time>', 'Filter by recency (ISO8601 or relative: 1h, 2d, 1w)')
  1042→    .option('--no-git', 'Skip git commit information')
  1043→    .option('-n, --limit <n>', 'Limit items per section', '10')
  1044→    .action(sessionStartAction);
  1045→
  1046→  session
  1047→    .command('checkpoint')
  1048→    .description('Pre-stop hook: check for uncommitted work before ending session')
  1049→    .option('--force', 'Allow session end regardless of issues')
  1050→    .action(sessionCheckpointAction);
  1051→
  1052→  session
  1053→    .command('prompt-check')
  1054→    .description('UserPromptSubmit hook: inject spec-first reminder')
  1055→    .action(sessionPromptCheckAction);
  1056→
  1057→  // Top-level alias: kspec context
  1058→  program
  1059→    .command('context')
  1060→    .description('Alias for session start - surface session context')
  1061→    .option('--brief', 'Compact summary (default)')
  1062→    .option('--full', 'Comprehensive context dump')
  1063→    .option('--since <time>', 'Filter by recency (ISO8601 or relative: 1h, 2d, 1w)')
  1064→    .option('--no-git', 'Skip git commit information')
  1065→    .option('-n, --limit <n>', 'Limit items per section', '10')
  1066→    .action(sessionStartAction);
  1067→}
