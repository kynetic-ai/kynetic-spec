     1→/**
     2→ * E2E API Tests for Daemon Inbox Endpoints
     3→ *
     4→ * Tests verify actual HTTP behavior by calling the running daemon directly.
     5→ * These replace the static analysis tests in tests/daemon-api-inbox.test.ts
     6→ * which only read source files and check string patterns.
     7→ *
     8→ * Covered ACs:
     9→ * - @api-contract ac-12: GET /api/inbox returns items ordered by created_at desc
    10→ * - @api-contract ac-13: POST /api/inbox creates item with generated ULID
    11→ * - @api-contract ac-14: DELETE /api/inbox/:ref removes item, returns success confirmation
    12→ */
    13→
    14→import { test, expect } from '../fixtures/test-base';
    15→
    16→const DAEMON_URL = 'http://localhost:3456';
    17→
    18→test.describe('Inbox API', () => {
    19→  test.describe('GET /api/inbox', () => {
    20→    // AC: @api-contract ac-12
    21→    test('returns inbox items as array with total', async ({ request, daemon }) => {
    22→      const response = await request.get(`${DAEMON_URL}/api/inbox`);
    23→
    24→      expect(response.status()).toBe(200);
    25→
    26→      const body = await response.json();
    27→      expect(body).toHaveProperty('items');
    28→      expect(body).toHaveProperty('total');
    29→      expect(Array.isArray(body.items)).toBe(true);
    30→      // Fixtures include 3 inbox items
    31→      expect(body.items.length).toBeGreaterThan(0);
    32→      expect(body.total).toBe(body.items.length);
    33→    });
    34→
    35→    // AC: @api-contract ac-12 - ordered by created_at desc
    36→    test('returns items ordered by created_at descending (newest first)', async ({
    37→      request,
    38→      daemon,
    39→    }) => {
    40→      const response = await request.get(`${DAEMON_URL}/api/inbox`);
    41→      expect(response.status()).toBe(200);
    42→
    43→      const body = await response.json();
    44→      const items = body.items;
    45→      // Fixtures have 3 items with different created_at timestamps
    46→      expect(items.length).toBeGreaterThanOrEqual(2);
    47→
    48→      // Verify descending order
    49→      for (let i = 0; i < items.length - 1; i++) {
    50→        const current = new Date(items[i].created_at).getTime();
    51→        const next = new Date(items[i + 1].created_at).getTime();
    52→        expect(current).toBeGreaterThanOrEqual(next);
    53→      }
    54→    });
    55→
    56→    // AC: @api-contract ac-12 - item fields
    57→    test('each inbox item has required fields', async ({ request, daemon }) => {
    58→      const response = await request.get(`${DAEMON_URL}/api/inbox`);
    59→      expect(response.status()).toBe(200);
    60→
    61→      const body = await response.json();
    62→      expect(body.items.length).toBeGreaterThan(0);
    63→
    64→      const item = body.items[0];
    65→      expect(item).toHaveProperty('_ulid');
    66→      expect(item).toHaveProperty('text');
    67→      expect(item).toHaveProperty('created_at');
    68→      expect(item).toHaveProperty('tags');
    69→      expect(Array.isArray(item.tags)).toBe(true);
    70→    });
    71→
    72→    // AC: @api-contract ac-12 - fixture data integrity
    73→    test('returns the fixture inbox items in correct order', async ({ request, daemon }) => {
    74→      const response = await request.get(`${DAEMON_URL}/api/inbox`);
    75→      expect(response.status()).toBe(200);
    76→
    77→      const body = await response.json();
    78→      // Fixture has 3 items ordered by created_at:
    79→      // 01KJNBX0CA...: 2026-01-01T10:00:00Z (newest)
    80→      // 01KJNBX1CC...: 2026-01-01T09:00:00Z
    81→      // 01KJNBX2CB...: 2026-01-01T08:00:00Z (oldest)
    82→      expect(body.items.length).toBe(3);
    83→      expect(body.items[0].text).toBe('First inbox item for testing');
    84→      expect(body.items[1].text).toBe('Second inbox item with different tags');
    85→      expect(body.items[2].text).toBe('Third inbox item - oldest');
    86→    });
    87→
    88→    // AC: @api-contract ac-12 (response format) - JSON content type
    89→    test('returns JSON content type', async ({ request, daemon }) => {
    90→      const response = await request.get(`${DAEMON_URL}/api/inbox`);
    91→      const contentType = response.headers()['content-type'] || '';
    92→      expect(contentType).toContain('application/json');
    93→    });
    94→  });
    95→
    96→  test.describe('POST /api/inbox', () => {
    97→    // AC: @api-contract ac-13
    98→    test('creates inbox item and returns it with generated ULID', async ({ request, daemon }) => {
    99→      const itemText = `E2E test inbox item ${Date.now()}`;
   100→      const response = await request.post(`${DAEMON_URL}/api/inbox`, {
   101→        data: { text: itemText },
   102→      });
   103→
   104→      expect(response.status()).toBe(200);
   105→
   106→      const body = await response.json();
   107→      expect(body).toHaveProperty('success');
   108→      expect(body.success).toBe(true);
   109→      expect(body).toHaveProperty('item');
   110→
   111→      const item = body.item;
   112→      expect(item).toHaveProperty('_ulid');
   113→      expect(typeof item._ulid).toBe('string');
   114→      expect(item._ulid.length).toBeGreaterThan(0);
   115→      expect(item.text).toBe(itemText);
   116→    });
   117→
   118→    // AC: @api-contract ac-13 - ULID is auto-generated (not provided by client)
   119→    test('assigns a ULID to the new item', async ({ request, daemon }) => {
   120→      const response = await request.post(`${DAEMON_URL}/api/inbox`, {
   121→        data: { text: 'ULID assignment test' },
   122→      });
   123→
   124→      expect(response.status()).toBe(200);
   125→      const body = await response.json();
   126→
   127→      // ULID should be a valid 26-character Crockford base32 string
   128→      expect(body.item._ulid).toMatch(/^[0-9A-HJKMNP-TV-Z]{26}$/);
   129→    });
   130→
   131→    // AC: @api-contract ac-13 - created item appears in list
   132→    test('newly created item appears in subsequent GET /api/inbox', async ({
   133→      request,
   134→      daemon,
   135→    }) => {
   136→      const itemText = `Created item check ${Date.now()}`;
   137→      const createResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   138→        data: { text: itemText },
   139→      });
   140→      expect(createResponse.status()).toBe(200);
   141→      const created = await createResponse.json();
   142→
   143→      // Now list inbox items
   144→      const listResponse = await request.get(`${DAEMON_URL}/api/inbox`);
   145→      expect(listResponse.status()).toBe(200);
   146→      const list = await listResponse.json();
   147→
   148→      // Find our newly created item
   149→      const found = list.items.find((i: { _ulid: string }) => i._ulid === created.item._ulid);
   150→      expect(found).toBeDefined();
   151→      expect(found.text).toBe(itemText);
   152→    });
   153→
   154→    // AC: @api-contract ac-13 - supports optional tags
   155→    test('creates item with optional tags', async ({ request, daemon }) => {
   156→      const response = await request.post(`${DAEMON_URL}/api/inbox`, {
   157→        data: { text: 'Tagged item', tags: ['feature', 'dx'] },
   158→      });
   159→
   160→      expect(response.status()).toBe(200);
   161→      const body = await response.json();
   162→      expect(body.item.tags).toEqual(['feature', 'dx']);
   163→    });
   164→
   165→    // AC: @api-contract ac-13 - supports optional added_by
   166→    test('creates item with optional added_by field', async ({ request, daemon }) => {
   167→      const response = await request.post(`${DAEMON_URL}/api/inbox`, {
   168→        data: { text: 'Item by author', added_by: '@testuser' },
   169→      });
   170→
   171→      expect(response.status()).toBe(200);
   172→      const body = await response.json();
   173→      expect(body.item.added_by).toBe('@testuser');
   174→    });
   175→
   176→    // AC: @api-contract ac-13 - created_at is set
   177→    test('created item has a created_at timestamp', async ({ request, daemon }) => {
   178→      const before = new Date().getTime();
   179→      const response = await request.post(`${DAEMON_URL}/api/inbox`, {
   180→        data: { text: 'Timestamp test item' },
   181→      });
   182→
   183→      expect(response.status()).toBe(200);
   184→      const body = await response.json();
   185→      const after = new Date().getTime();
   186→
   187→      const createdAt = new Date(body.item.created_at).getTime();
   188→      // created_at should be within the test window
   189→      expect(createdAt).toBeGreaterThanOrEqual(before - 5000); // 5s tolerance
   190→      expect(createdAt).toBeLessThanOrEqual(after + 5000);
   191→    });
   192→
   193→    // Error: missing text field — Elysia validates body schema, returns 422
   194→    test('returns 422 when text field is missing', async ({ request, daemon }) => {
   195→      const response = await request.post(`${DAEMON_URL}/api/inbox`, {
   196→        data: {},
   197→      });
   198→
   199→      expect(response.status()).toBe(422);
   200→    });
   201→
   202→    // Error: empty text — handler validation returns 400
   203→    test('returns 400 when text is empty string', async ({ request, daemon }) => {
   204→      const response = await request.post(`${DAEMON_URL}/api/inbox`, {
   205→        data: { text: '' },
   206→      });
   207→
   208→      expect(response.status()).toBe(400);
   209→      const body = await response.json();
   210→      expect(body.error).toBe('validation_error');
   211→      expect(body).toHaveProperty('details');
   212→      expect(Array.isArray(body.details)).toBe(true);
   213→      expect(body.details[0].field).toBe('text');
   214→    });
   215→
   216→    // Error: whitespace-only text — handler validation returns 400
   217→    test('returns 400 when text is whitespace only', async ({ request, daemon }) => {
   218→      const response = await request.post(`${DAEMON_URL}/api/inbox`, {
   219→        data: { text: '   ' },
   220→      });
   221→
   222→      expect(response.status()).toBe(400);
   223→      const body = await response.json();
   224→      expect(body.error).toBe('validation_error');
   225→    });
   226→  });
   227→
   228→  test.describe('DELETE /api/inbox/:ref', () => {
   229→    // AC: @api-contract ac-14
   230→    test('deletes an inbox item and returns success confirmation', async ({ request, daemon }) => {
   231→      // First create an item to delete
   232→      const createResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   233→        data: { text: 'Item to delete' },
   234→      });
   235→      expect(createResponse.status()).toBe(200);
   236→      const created = await createResponse.json();
   237→      const ulid = created.item._ulid;
   238→
   239→      // Delete it using its ULID ref
   240→      const deleteResponse = await request.delete(`${DAEMON_URL}/api/inbox/@${ulid}`);
   241→      expect(deleteResponse.status()).toBe(200);
   242→
   243→      const body = await deleteResponse.json();
   244→      expect(body).toHaveProperty('success');
   245→      expect(body.success).toBe(true);
   246→      expect(body).toHaveProperty('deleted');
   247→      expect(body.deleted).toBe(ulid);
   248→    });
   249→
   250→    // AC: @api-contract ac-14 - item is actually removed from list
   251→    test('deleted item no longer appears in GET /api/inbox', async ({ request, daemon }) => {
   252→      // Create an item
   253→      const createResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   254→        data: { text: 'Item to verify deletion' },
   255→      });
   256→      expect(createResponse.status()).toBe(200);
   257→      const created = await createResponse.json();
   258→      const ulid = created.item._ulid;
   259→
   260→      // Delete it
   261→      const deleteResponse = await request.delete(`${DAEMON_URL}/api/inbox/@${ulid}`);
   262→      expect(deleteResponse.status()).toBe(200);
   263→
   264→      // Verify it's gone
   265→      const listResponse = await request.get(`${DAEMON_URL}/api/inbox`);
   266→      const list = await listResponse.json();
   267→      const found = list.items.find((i: { _ulid: string }) => i._ulid === ulid);
   268→      expect(found).toBeUndefined();
   269→    });
   270→
   271→    // AC: @api-contract ac-14 - can delete using full ULID ref
   272→    test('deletes item using full ULID ref', async ({ request, daemon }) => {
   273→      // Create a new item to delete
   274→      const createResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   275→        data: { text: 'Full ULID ref deletion test' },
   276→      });
   277→      expect(createResponse.status()).toBe(200);
   278→      const created = await createResponse.json();
   279→      const ulid = created.item._ulid;
   280→
   281→      // Delete using the full ULID
   282→      const deleteResponse = await request.delete(`${DAEMON_URL}/api/inbox/@${ulid}`);
   283→      expect(deleteResponse.status()).toBe(200);
   284→      const body = await deleteResponse.json();
   285→      expect(body.success).toBe(true);
   286→      expect(body.deleted).toBe(ulid);
   287→    });
   288→
   289→    // AC: @api-contract ac-14 - error handling
   290→    // AC: @trait-api-endpoint ac-2 - 404 with {error, message, suggestion}
   291→    test('returns 404 with message and suggestion for non-existent inbox ref', async ({
   292→      request,
   293→      daemon,
   294→    }) => {
   295→      const response = await request.delete(
   296→        `${DAEMON_URL}/api/inbox/@nonexistent-inbox-ref-xyz`
   297→      );
   298→      expect(response.status()).toBe(404);
   299→
   300→      const body = await response.json();
   301→      expect(body).toHaveProperty('error');
   302→      expect(body.error).toBe('not_found');
   303→      expect(body).toHaveProperty('message');
   304→      expect(typeof body.message).toBe('string');
   305→      expect(body).toHaveProperty('suggestion');
   306→      expect(typeof body.suggestion).toBe('string');
   307→    });
   308→
   309→    // Error: can delete fixture items by ULID
   310→    test('can delete an existing fixture item by ULID', async ({ request, daemon }) => {
   311→      // Use the third fixture item (oldest) to avoid affecting ordering tests
   312→      const ulid = '01KJNBX2CB8N4YGP991WD7XS9R';
   313→
   314→      const deleteResponse = await request.delete(`${DAEMON_URL}/api/inbox/@${ulid}`);
   315→      expect(deleteResponse.status()).toBe(200);
   316→
   317→      const body = await deleteResponse.json();
   318→      expect(body.success).toBe(true);
   319→      expect(body.deleted).toBe(ulid);
   320→
   321→      // Verify list now has 2 items
   322→      const listResponse = await request.get(`${DAEMON_URL}/api/inbox`);
   323→      const list = await listResponse.json();
   324→      expect(list.items.length).toBe(2);
   325→    });
   326→  });
   327→
   328→  test.describe('Inbox ordering invariant', () => {
   329→    // AC: @api-contract ac-12 - newly created items appear at top (newest first)
   330→    test('newly created item appears at top of list (most recent first)', async ({
   331→      request,
   332→      daemon,
   333→    }) => {
   334→      // Wait a moment to ensure new item has a later timestamp
   335→      await new Promise((r) => setTimeout(r, 10));
   336→
   337→      const response = await request.post(`${DAEMON_URL}/api/inbox`, {
   338→        data: { text: 'Should be at top' },
   339→      });
   340→      expect(response.status()).toBe(200);
   341→      const created = await response.json();
   342→
   343→      const listResponse = await request.get(`${DAEMON_URL}/api/inbox`);
   344→      const list = await listResponse.json();
   345→
   346→      // Newest item should be first since fixture items are from 2026-01-01
   347→      expect(list.items[0]._ulid).toBe(created.item._ulid);
   348→    });
   349→  });
   350→});
