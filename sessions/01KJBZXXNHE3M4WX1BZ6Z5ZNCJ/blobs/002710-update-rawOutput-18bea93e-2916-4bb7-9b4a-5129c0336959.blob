     1→/**
     2→ * E2E API Tests for Daemon Triage Endpoints
     3→ *
     4→ * Tests verify actual HTTP behavior by calling the running daemon directly.
     5→ * These replace the static analysis tests in tests/daemon-api-triage.test.ts
     6→ * which only read source files and check string patterns.
     7→ *
     8→ * Covered ACs:
     9→ * - @triage-daemon-api ac-1: GET /api/triage returns items sorted by created_at desc
    10→ * - @triage-daemon-api ac-2: GET /api/triage?status= filters by status
    11→ * - @triage-daemon-api ac-3: POST /api/triage creates record with item_snapshot, broadcasts
    12→ * - @triage-daemon-api ac-4: POST /api/triage/:ref/override sets override fields, broadcasts
    13→ * - @triage-daemon-api ac-5: POST /api/triage/:ref/act executes action, transitions to acted_on
    14→ * - @triage-daemon-api ac-6: GET /api/triage/export returns context markdown or JSON
    15→ * - @triage-daemon-api ac-7: POST 404 for nonexistent inbox item
    16→ * - @triage-daemon-api ac-8: POST /:ref/act 409 for already acted_on record
    17→ * - @triage-daemon-api ac-9: POST /:ref/act 422 for pending record
    18→ */
    19→
    20→// Trait N/A annotations — @triage-daemon-api inherits from @trait-api-endpoint and @trait-websocket-protocol:
    21→// AC: @trait-api-endpoint ac-6 — N/A: X-Request-Id header is infrastructure concern; not tested in domain E2E tests
    22→// AC: @trait-websocket-protocol ac-1 — N/A: WebSocket connection lifecycle; tested separately in api-websocket E2E tests
    23→// AC: @trait-websocket-protocol ac-2 — N/A: WebSocket subscribe command; tested separately in api-websocket E2E tests
    24→// AC: @trait-websocket-protocol ac-3 — covered: broadcast events tested via verify-able state changes in create/act/override tests
    25→// AC: @trait-websocket-protocol ac-4 — N/A: WebSocket heartbeat timing; tested separately in api-websocket E2E tests
    26→// AC: @trait-websocket-protocol ac-5 — N/A: WebSocket ping/pong timeout; tested separately in api-websocket E2E tests
    27→// AC: @trait-websocket-protocol ac-6 — N/A: WebSocket backpressure handling; tested separately in api-websocket E2E tests
    28→// AC: @trait-websocket-protocol ac-7 — N/A: WebSocket close codes; tested separately in api-websocket E2E tests
    29→// AC: @trait-websocket-protocol ac-8 — N/A: WebSocket reconnection; tested separately in api-websocket E2E tests
    30→
    31→import { test, expect } from '../fixtures/test-base';
    32→
    33→const DAEMON_URL = 'http://localhost:3456';
    34→
    35→// Fixture ULIDs defined in project.triage.yaml
    36→// TRIAGED record: inbox_ref = 01KJNBX0CA45ZT43W2T6HJMVA1 ("First inbox item for testing"), status=triaged
    37→const FIXTURE_TRIAGE_TRIAGED_ULID = '01KJC3NZ8Y268B3KFD2NVS6613';
    38→// ACTED_ON record: inbox_ref = 01KJNBX1CC9N4YGP991WD7XS8S ("Second inbox item"), status=acted_on
    39→const FIXTURE_TRIAGE_ACTED_ULID = '01KJC3NZD5QFP9N0FCKX9D90KR';
    40→// PENDING record: inbox_ref = 01KJNBX2CB8N4YGP991WD7XS9R ("Third inbox item"), status=pending
    41→const FIXTURE_TRIAGE_PENDING_ULID = '01KJC3NZHCBKZMDKQNZ28JNRG2';
    42→
    43→// Inbox item ULIDs from project.inbox.yaml (used for POST /api/triage)
    44→const INBOX_ITEM_1_ULID = '01KJNBX0CA45ZT43W2T6HJMVA1'; // First inbox item — already has a triage record
    45→const INBOX_ITEM_2_ULID = '01KJNBX1CC9N4YGP991WD7XS8S'; // Second inbox item — already acted_on
    46→const INBOX_ITEM_3_ULID = '01KJNBX2CB8N4YGP991WD7XS9R'; // Third inbox item — pending triage record
    47→
    48→test.describe('Triage API', () => {
    49→  test.describe('GET /api/triage', () => {
    50→    // AC: @triage-daemon-api ac-1
    51→    test('returns triage records array with total, sorted by created_at desc', async ({
    52→      request,
    53→      daemon,
    54→    }) => {
    55→      const response = await request.get(`${DAEMON_URL}/api/triage`);
    56→
    57→      expect(response.status()).toBe(200);
    58→
    59→      const body = await response.json();
    60→      expect(body).toHaveProperty('items');
    61→      expect(body).toHaveProperty('total');
    62→      expect(Array.isArray(body.items)).toBe(true);
    63→      expect(body.items.length).toBeGreaterThan(0);
    64→      expect(body.total).toBe(body.items.length);
    65→    });
    66→
    67→    // AC: @triage-daemon-api ac-1 — sorted by created_at desc
    68→    test('returns records sorted by created_at descending (newest first)', async ({
    69→      request,
    70→      daemon,
    71→    }) => {
    72→      const response = await request.get(`${DAEMON_URL}/api/triage`);
    73→      expect(response.status()).toBe(200);
    74→
    75→      const body = await response.json();
    76→      expect(body.items.length).toBeGreaterThanOrEqual(2);
    77→
    78→      // Verify descending order
    79→      for (let i = 0; i < body.items.length - 1; i++) {
    80→        const current = new Date(body.items[i].created_at).getTime();
    81→        const next = new Date(body.items[i + 1].created_at).getTime();
    82→        expect(current).toBeGreaterThanOrEqual(next);
    83→      }
    84→    });
    85→
    86→    // AC: @triage-daemon-api ac-1 — fixture records loaded
    87→    test('returns fixture triage records with correct fields', async ({ request, daemon }) => {
    88→      const response = await request.get(`${DAEMON_URL}/api/triage`);
    89→      expect(response.status()).toBe(200);
    90→
    91→      const body = await response.json();
    92→      // We have 3 fixture records
    93→      expect(body.items.length).toBe(3);
    94→
    95→      const item = body.items[0];
    96→      expect(item).toHaveProperty('_ulid');
    97→      expect(item).toHaveProperty('inbox_ref');
    98→      expect(item).toHaveProperty('item_snapshot');
    99→      expect(item).toHaveProperty('status');
   100→      expect(item).toHaveProperty('created_at');
   101→    });
   102→
   103→    // AC: @triage-daemon-api ac-1 — JSON content type
   104→    // AC: @trait-api-endpoint ac-1
   105→    test('returns JSON content type', async ({ request, daemon }) => {
   106→      const response = await request.get(`${DAEMON_URL}/api/triage`);
   107→      const contentType = response.headers()['content-type'] || '';
   108→      expect(contentType).toContain('application/json');
   109→    });
   110→
   111→    // AC: @triage-daemon-api ac-2 — status filter
   112→    test('filters records by status query parameter', async ({ request, daemon }) => {
   113→      const response = await request.get(`${DAEMON_URL}/api/triage?status=triaged`);
   114→      expect(response.status()).toBe(200);
   115→
   116→      const body = await response.json();
   117→      expect(Array.isArray(body.items)).toBe(true);
   118→
   119→      // All returned items should have status=triaged
   120→      for (const item of body.items) {
   121→        expect(item.status).toBe('triaged');
   122→      }
   123→    });
   124→
   125→    // AC: @triage-daemon-api ac-2 — filter for acted_on
   126→    test('filters records by acted_on status', async ({ request, daemon }) => {
   127→      const response = await request.get(`${DAEMON_URL}/api/triage?status=acted_on`);
   128→      expect(response.status()).toBe(200);
   129→
   130→      const body = await response.json();
   131→      expect(body.items.length).toBe(1);
   132→      expect(body.items[0]._ulid).toBe(FIXTURE_TRIAGE_ACTED_ULID);
   133→      expect(body.items[0].status).toBe('acted_on');
   134→    });
   135→
   136→    // AC: @triage-daemon-api ac-2 — filter for pending
   137→    test('filters records by pending status', async ({ request, daemon }) => {
   138→      const response = await request.get(`${DAEMON_URL}/api/triage?status=pending`);
   139→      expect(response.status()).toBe(200);
   140→
   141→      const body = await response.json();
   142→      expect(body.items.length).toBe(1);
   143→      expect(body.items[0]._ulid).toBe(FIXTURE_TRIAGE_PENDING_ULID);
   144→      expect(body.items[0].status).toBe('pending');
   145→    });
   146→
   147→    // AC: @trait-api-endpoint ac-4 — pagination
   148→    test('supports limit and offset pagination', async ({ request, daemon }) => {
   149→      // Get all records first
   150→      const allResponse = await request.get(`${DAEMON_URL}/api/triage`);
   151→      const allBody = await allResponse.json();
   152→      const totalCount = allBody.total;
   153→
   154→      // Get first page with limit=1
   155→      const pagedResponse = await request.get(`${DAEMON_URL}/api/triage?limit=1&offset=0`);
   156→      expect(pagedResponse.status()).toBe(200);
   157→
   158→      const pagedBody = await pagedResponse.json();
   159→      expect(pagedBody.items.length).toBe(1);
   160→      expect(pagedBody.total).toBe(totalCount);
   161→      expect(pagedBody.offset).toBe(0);
   162→      expect(pagedBody.limit).toBe(1);
   163→    });
   164→
   165→    // AC: @trait-api-endpoint ac-4 — pagination offset
   166→    test('pagination offset skips records', async ({ request, daemon }) => {
   167→      const firstResponse = await request.get(`${DAEMON_URL}/api/triage?limit=1&offset=0`);
   168→      const secondResponse = await request.get(`${DAEMON_URL}/api/triage?limit=1&offset=1`);
   169→
   170→      expect(firstResponse.status()).toBe(200);
   171→      expect(secondResponse.status()).toBe(200);
   172→
   173→      const firstBody = await firstResponse.json();
   174→      const secondBody = await secondResponse.json();
   175→
   176→      // First and second pages should have different records
   177→      expect(firstBody.items[0]._ulid).not.toBe(secondBody.items[0]._ulid);
   178→    });
   179→  });
   180→
   181→  test.describe('GET /api/triage/export', () => {
   182→    // AC: @triage-daemon-api ac-6 — JSON export format
   183→    test('exports triage records as JSON by default', async ({ request, daemon }) => {
   184→      const response = await request.get(`${DAEMON_URL}/api/triage/export`);
   185→      expect(response.status()).toBe(200);
   186→
   187→      const body = await response.json();
   188→      // JSON format returns array of records or object
   189→      expect(body).toBeDefined();
   190→    });
   191→
   192→    // AC: @triage-daemon-api ac-6 — JSON format explicit
   193→    test('exports triage records as JSON when format=json', async ({ request, daemon }) => {
   194→      const response = await request.get(`${DAEMON_URL}/api/triage/export?format=json`);
   195→      expect(response.status()).toBe(200);
   196→
   197→      const body = await response.json();
   198→      expect(body).toBeDefined();
   199→    });
   200→
   201→    // AC: @triage-daemon-api ac-6 — context markdown format
   202→    test('exports triage records as context markdown when format=context', async ({
   203→      request,
   204→      daemon,
   205→    }) => {
   206→      const response = await request.get(`${DAEMON_URL}/api/triage/export?format=context`);
   207→      expect(response.status()).toBe(200);
   208→
   209→      // Context format returns a string (markdown)
   210→      const text = await response.text();
   211→      expect(typeof text).toBe('string');
   212→      // Should contain triage record content from fixture
   213→      expect(text.length).toBeGreaterThan(0);
   214→    });
   215→
   216→    // AC: @triage-daemon-api ac-6 — export with status filter
   217→    test('supports status filter on export', async ({ request, daemon }) => {
   218→      const response = await request.get(
   219→        `${DAEMON_URL}/api/triage/export?format=json&status=triaged`
   220→      );
   221→      expect(response.status()).toBe(200);
   222→
   223→      const body = await response.json();
   224→      // Should only contain triaged records
   225→      if (Array.isArray(body)) {
   226→        for (const record of body) {
   227→          expect(record.status).toBe('triaged');
   228→        }
   229→      }
   230→    });
   231→  });
   232→
   233→  test.describe('GET /api/triage/:ref', () => {
   234→    // AC: @trait-api-endpoint ac-1 — single record retrieval
   235→    test('returns single triage record by ULID ref', async ({ request, daemon }) => {
   236→      const response = await request.get(
   237→        `${DAEMON_URL}/api/triage/@${FIXTURE_TRIAGE_TRIAGED_ULID}`
   238→      );
   239→      expect(response.status()).toBe(200);
   240→
   241→      const body = await response.json();
   242→      expect(body._ulid).toBe(FIXTURE_TRIAGE_TRIAGED_ULID);
   243→      expect(body.status).toBe('triaged');
   244→      expect(body.action).toBe('defer');
   245→    });
   246→
   247→    // AC: @trait-api-endpoint ac-2 — 404 for nonexistent ref
   248→    test('returns 404 with error/message/suggestion for nonexistent ref', async ({
   249→      request,
   250→      daemon,
   251→    }) => {
   252→      const response = await request.get(`${DAEMON_URL}/api/triage/@nonexistent-triage-ref-xyz`);
   253→      expect(response.status()).toBe(404);
   254→
   255→      const body = await response.json();
   256→      expect(body).toHaveProperty('error');
   257→      expect(body.error).toBe('not_found');
   258→      expect(body).toHaveProperty('message');
   259→      expect(typeof body.message).toBe('string');
   260→      expect(body).toHaveProperty('suggestion');
   261→      expect(typeof body.suggestion).toBe('string');
   262→    });
   263→  });
   264→
   265→  test.describe('POST /api/triage', () => {
   266→    // AC: @triage-daemon-api ac-3 — create record with item_snapshot
   267→    test('creates triage record with item_snapshot from inbox item', async ({
   268→      request,
   269→      daemon,
   270→    }) => {
   271→      // Use inbox item 1 which already has a "triaged" fixture record — upsert case
   272→      const response = await request.post(`${DAEMON_URL}/api/triage`, {
   273→        data: {
   274→          inbox_ref: `@${INBOX_ITEM_1_ULID}`,
   275→          action: 'defer',
   276→          reasoning: 'Not a priority right now',
   277→        },
   278→      });
   279→
   280→      expect(response.status()).toBe(200);
   281→
   282→      const body = await response.json();
   283→      expect(body).toHaveProperty('success');
   284→      expect(body.success).toBe(true);
   285→      expect(body).toHaveProperty('record');
   286→
   287→      const record = body.record;
   288→      expect(record).toHaveProperty('_ulid');
   289→      expect(record.inbox_ref).toBe(INBOX_ITEM_1_ULID);
   290→      // item_snapshot should be set from the inbox item text
   291→      expect(record.item_snapshot).toBe('First inbox item for testing');
   292→      expect(record.action).toBe('defer');
   293→      expect(record.status).toBe('triaged');
   294→    });
   295→
   296→    // AC: @triage-daemon-api ac-3 — create fresh record for new inbox item
   297→    test('creates new triage record for inbox item without existing record', async ({
   298→      request,
   299→      daemon,
   300→    }) => {
   301→      // Create a fresh inbox item first
   302→      const inboxResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   303→        data: { text: `Fresh item for triage ${Date.now()}` },
   304→      });
   305→      expect(inboxResponse.status()).toBe(200);
   306→      const inbox = await inboxResponse.json();
   307→      const newInboxUlid = inbox.item._ulid;
   308→
   309→      // Create a triage record for it
   310→      const triageResponse = await request.post(`${DAEMON_URL}/api/triage`, {
   311→        data: {
   312→          inbox_ref: `@${newInboxUlid}`,
   313→          action: 'defer',
   314→          reasoning: 'Defer this new item',
   315→        },
   316→      });
   317→
   318→      expect(triageResponse.status()).toBe(200);
   319→
   320→      const body = await triageResponse.json();
   321→      expect(body.success).toBe(true);
   322→      expect(body.record.inbox_ref).toBe(newInboxUlid);
   323→      expect(body.record.status).toBe('triaged');
   324→    });
   325→
   326→    // AC: @triage-daemon-api ac-3 — record appears in list
   327→    test('newly created record appears in subsequent GET /api/triage', async ({
   328→      request,
   329→      daemon,
   330→    }) => {
   331→      // Create a fresh inbox item
   332→      const inboxResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   333→        data: { text: `Triage list check ${Date.now()}` },
   334→      });
   335→      expect(inboxResponse.status()).toBe(200);
   336→      const inbox = await inboxResponse.json();
   337→      const newInboxUlid = inbox.item._ulid;
   338→
   339→      // Create triage record
   340→      const triageResponse = await request.post(`${DAEMON_URL}/api/triage`, {
   341→        data: {
   342→          inbox_ref: `@${newInboxUlid}`,
   343→          action: 'spec-gap',
   344→          reasoning: 'This reveals a spec gap',
   345→        },
   346→      });
   347→      expect(triageResponse.status()).toBe(200);
   348→      const created = await triageResponse.json();
   349→
   350→      // Verify it appears in the list
   351→      const listResponse = await request.get(`${DAEMON_URL}/api/triage`);
   352→      expect(listResponse.status()).toBe(200);
   353→      const list = await listResponse.json();
   354→
   355→      const found = list.items.find((r: { _ulid: string }) => r._ulid === created.record._ulid);
   356→      expect(found).toBeDefined();
   357→      expect(found.action).toBe('spec-gap');
   358→    });
   359→
   360→    // AC: @triage-daemon-api ac-3 — supports optional decided_by
   361→    test('creates record with optional decided_by field', async ({ request, daemon }) => {
   362→      // Create fresh inbox item
   363→      const inboxResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   364→        data: { text: `Decided by test ${Date.now()}` },
   365→      });
   366→      expect(inboxResponse.status()).toBe(200);
   367→      const inbox = await inboxResponse.json();
   368→
   369→      const response = await request.post(`${DAEMON_URL}/api/triage`, {
   370→        data: {
   371→          inbox_ref: `@${inbox.item._ulid}`,
   372→          action: 'delete',
   373→          reasoning: 'Duplicate item',
   374→          decided_by: '@custom-author',
   375→        },
   376→      });
   377→
   378→      expect(response.status()).toBe(200);
   379→      const body = await response.json();
   380→      expect(body.record.decided_by).toBe('@custom-author');
   381→    });
   382→
   383→    // AC: @triage-daemon-api ac-7 — 404 for nonexistent inbox item
   384→    test('returns 404 for nonexistent inbox item reference', async ({ request, daemon }) => {
   385→      const response = await request.post(`${DAEMON_URL}/api/triage`, {
   386→        data: {
   387→          inbox_ref: '@01ZZZZZZZZZZZZZZZZZZZZZZZY',
   388→          action: 'defer',
   389→          reasoning: 'Should fail',
   390→        },
   391→      });
   392→
   393→      expect(response.status()).toBe(404);
   394→
   395→      const body = await response.json();
   396→      expect(body.error).toBe('not_found');
   397→      expect(body).toHaveProperty('message');
   398→      expect(body).toHaveProperty('suggestion');
   399→    });
   400→
   401→    // AC: @trait-api-endpoint ac-3 — validation error for invalid action
   402→    test('returns 400 with validation details for invalid action', async ({
   403→      request,
   404→      daemon,
   405→    }) => {
   406→      const response = await request.post(`${DAEMON_URL}/api/triage`, {
   407→        data: {
   408→          inbox_ref: `@${INBOX_ITEM_1_ULID}`,
   409→          action: 'invalid-action-xyz',
   410→          reasoning: 'Test invalid action',
   411→        },
   412→      });
   413→
   414→      expect(response.status()).toBe(400);
   415→
   416→      const body = await response.json();
   417→      expect(body.error).toBe('validation_error');
   418→      expect(body).toHaveProperty('details');
   419→      expect(Array.isArray(body.details)).toBe(true);
   420→      expect(body.details[0].field).toBe('action');
   421→    });
   422→
   423→    // AC: @trait-api-endpoint ac-3 — missing required fields → Elysia validation
   424→    test('returns 422 when required fields are missing', async ({ request, daemon }) => {
   425→      const response = await request.post(`${DAEMON_URL}/api/triage`, {
   426→        data: {
   427→          // Missing inbox_ref, action, reasoning
   428→        },
   429→      });
   430→
   431→      expect(response.status()).toBe(422);
   432→    });
   433→  });
   434→
   435→  test.describe('POST /api/triage/:ref/override', () => {
   436→    // AC: @triage-daemon-api ac-4 — override sets fields and updates action
   437→    test('sets override fields and updates action on triaged record', async ({
   438→      request,
   439→      daemon,
   440→    }) => {
   441→      const response = await request.post(
   442→        `${DAEMON_URL}/api/triage/@${FIXTURE_TRIAGE_TRIAGED_ULID}/override`,
   443→        {
   444→          data: {
   445→            action: 'promote',
   446→            reasoning: 'Changed my mind, this should be promoted',
   447→          },
   448→        }
   449→      );
   450→
   451→      expect(response.status()).toBe(200);
   452→
   453→      const body = await response.json();
   454→      expect(body.success).toBe(true);
   455→      expect(body).toHaveProperty('record');
   456→
   457→      const record = body.record;
   458→      expect(record.action).toBe('promote');
   459→      expect(record.override_reasoning).toBe('Changed my mind, this should be promoted');
   460→      expect(record).toHaveProperty('override_by');
   461→      expect(record).toHaveProperty('override_at');
   462→    });
   463→
   464→    // AC: @triage-daemon-api ac-4 — override on acted_on re-triages it
   465→    test('resets acted_on record back to triaged status on override', async ({
   466→      request,
   467→      daemon,
   468→    }) => {
   469→      const response = await request.post(
   470→        `${DAEMON_URL}/api/triage/@${FIXTURE_TRIAGE_ACTED_ULID}/override`,
   471→        {
   472→          data: {
   473→            action: 'defer',
   474→            reasoning: 'Actually defer this one',
   475→          },
   476→        }
   477→      );
   478→
   479→      expect(response.status()).toBe(200);
   480→
   481→      const body = await response.json();
   482→      // After override, acted_on → triaged (so it can be re-acted)
   483→      expect(body.record.status).toBe('triaged');
   484→      expect(body.record.acted_at).toBeUndefined();
   485→      expect(body.record.result_ref).toBeUndefined();
   486→    });
   487→
   488→    // AC: @triage-daemon-api ac-4 — override with custom override_by
   489→    test('accepts optional override_by field', async ({ request, daemon }) => {
   490→      const response = await request.post(
   491→        `${DAEMON_URL}/api/triage/@${FIXTURE_TRIAGE_TRIAGED_ULID}/override`,
   492→        {
   493→          data: {
   494→            action: 'delete',
   495→            reasoning: 'Override by specific author',
   496→            override_by: '@specific-reviewer',
   497→          },
   498→        }
   499→      );
   500→
   501→      expect(response.status()).toBe(200);
   502→
   503→      const body = await response.json();
