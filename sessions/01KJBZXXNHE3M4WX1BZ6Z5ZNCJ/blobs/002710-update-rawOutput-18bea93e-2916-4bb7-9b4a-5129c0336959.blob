   547→  test.describe('POST /api/triage/:ref/act', () => {
   548→    // AC: @triage-daemon-api ac-5 — execute action on triaged record
   549→    test('executes action and transitions record to acted_on', async ({ request, daemon }) => {
   550→      // First create a fresh inbox item and triage record in 'triaged' status
   551→      const inboxResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   552→        data: { text: `Act test item ${Date.now()}` },
   553→      });
   554→      expect(inboxResponse.status()).toBe(200);
   555→      const inbox = await inboxResponse.json();
   556→
   557→      // Create triage record
   558→      const triageResponse = await request.post(`${DAEMON_URL}/api/triage`, {
   559→        data: {
   560→          inbox_ref: `@${inbox.item._ulid}`,
   561→          action: 'delete',
   562→          reasoning: 'This item is stale and should be deleted',
   563→        },
   564→      });
   565→      expect(triageResponse.status()).toBe(200);
   566→      const triage = await triageResponse.json();
   567→      const triageRef = triage.record._ulid;
   568→
   569→      // Act on it (delete action — removes the inbox item)
   570→      const actResponse = await request.post(
   571→        `${DAEMON_URL}/api/triage/@${triageRef}/act`
   572→      );
   573→
   574→      expect(actResponse.status()).toBe(200);
   575→
   576→      const body = await actResponse.json();
   577→      expect(body.success).toBe(true);
   578→      expect(body.record.status).toBe('acted_on');
   579→      expect(body.record).toHaveProperty('acted_at');
   580→    });
