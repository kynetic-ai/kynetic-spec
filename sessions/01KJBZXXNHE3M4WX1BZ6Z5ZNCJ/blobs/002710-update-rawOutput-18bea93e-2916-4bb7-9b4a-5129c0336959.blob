   692→  test.describe('Upsert correctness', () => {
   693→    // AC: @triage-daemon-api ac-3 — upsert on inbox_ref (one record per inbox item)
   694→    test('second POST for same inbox item updates existing record (upsert)', async ({
   695→      request,
   696→      daemon,
   697→    }) => {
   698→      // Create fresh inbox item
   699→      const inboxResponse = await request.post(`${DAEMON_URL}/api/inbox`, {
   700→        data: { text: `Upsert test ${Date.now()}` },
   701→      });
   702→      expect(inboxResponse.status()).toBe(200);
   703→      const inbox = await inboxResponse.json();
   704→      const inboxUlid = inbox.item._ulid;
   705→
   706→      // First triage — defer
   707→      const firstResponse = await request.post(`${DAEMON_URL}/api/triage`, {
   708→        data: {
   709→          inbox_ref: `@${inboxUlid}`,
   710→          action: 'defer',
   711→          reasoning: 'First decision',
   712→        },
   713→      });
   714→      expect(firstResponse.status()).toBe(200);
   715→      const firstBody = await firstResponse.json();
   716→      const firstUlid = firstBody.record._ulid;
   717→
   718→      // Second triage — spec-gap (should upsert, same ULID)
   719→      const secondResponse = await request.post(`${DAEMON_URL}/api/triage`, {
   720→        data: {
   721→          inbox_ref: `@${inboxUlid}`,
   722→          action: 'spec-gap',
   723→          reasoning: 'Changed mind',
   724→        },
   725→      });
   726→      expect(secondResponse.status()).toBe(200);
   727→      const secondBody = await secondResponse.json();
   728→
   729→      // Same ULID (upsert, not duplicate)
   730→      expect(secondBody.record._ulid).toBe(firstUlid);
   731→      expect(secondBody.record.action).toBe('spec-gap');
   732→
   733→      // Only 1 record for this inbox item
   734→      const listResponse = await request.get(`${DAEMON_URL}/api/triage`);
   735→      const list = await listResponse.json();
   736→      const recordsForItem = list.items.filter(
   737→        (r: { inbox_ref: string }) => r.inbox_ref === inboxUlid
   738→      );
   739→      expect(recordsForItem.length).toBe(1);
   740→    });
   741→  });
   742→});
