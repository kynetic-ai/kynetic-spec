     1→/**
     2→ * Tests for Triage API endpoints
     3→ *
     4→ * Verifies triage routes are properly structured and integrated.
     5→ * Uses static analysis pattern matching existing daemon API tests.
     6→ *
     7→ * AC Coverage:
     8→ * - @triage-daemon-api ac-1: GET /api/triage returns items sorted by created_at desc
     9→ * - @triage-daemon-api ac-2: Status filter on GET list
    10→ * - @triage-daemon-api ac-3: POST creates record with item_snapshot and broadcasts
    11→ * - @triage-daemon-api ac-4: Override sets override fields and broadcasts
    12→ * - @triage-daemon-api ac-5: Act executes action, transitions to acted_on, broadcasts
    13→ * - @triage-daemon-api ac-6: GET /api/triage/export with format parameter
    14→ * - @triage-daemon-api ac-7: POST 404 for nonexistent inbox item
    15→ * - @triage-daemon-api ac-8: Act 409 for already acted_on record
    16→ * - @triage-daemon-api ac-9: Act 422 for pending record (no decision)
    17→ *
    18→ * Trait AC Coverage:
    19→ * - @trait-api-endpoint ac-1: 2xx with JSON body
    20→ * - @trait-api-endpoint ac-2: 404 with error/message/suggestion
    21→ * - @trait-api-endpoint ac-3: 400 with validation error details
    22→ * - @trait-api-endpoint ac-4: Pagination with limit/offset
    23→ * - @trait-api-endpoint ac-5: Shadow commit on mutations
    24→ * - @trait-websocket-protocol ac-3: Broadcast events on changes
    25→ */
    26→
    27→import { describe, it, expect } from 'vitest';
    28→import { readFile } from 'fs/promises';
    29→import { join } from 'path';
    30→
    31→const ROUTES_PATH = join(process.cwd(), 'packages/daemon/src/routes/triage.ts');
    32→const SERVER_PATH = join(process.cwd(), 'packages/daemon/src/server.ts');
    33→
    34→describe('Triage API Endpoints', () => {
    35→  // AC: @triage-daemon-api ac-1
    36→  it('should have GET /api/triage route with created_at desc ordering', async () => {
    37→    const content = await readFile(ROUTES_PATH, 'utf-8');
    38→
    39→    // Route definition
    40→    expect(content).toContain("prefix: '/api/triage'");
    41→    expect(content).toContain(".get(");
    42→    expect(content).toContain("'/'");
    43→
    44→    // AC: @triage-daemon-api ac-1 - Sort by created_at descending
    45→    expect(content).toContain('created_at');
    46→    expect(content).toContain('.sort(');
    47→
    48→    // Returns items with total
    49→    expect(content).toContain('items:');
    50→    expect(content).toContain('total');
    51→  });
    52→
    53→  // AC: @triage-daemon-api ac-2
    54→  it('should support status filter on GET list', async () => {
    55→    const content = await readFile(ROUTES_PATH, 'utf-8');
    56→
    57→    // AC: @triage-daemon-api ac-2 - Status filter
    58→    expect(content).toContain('query.status');
    59→    expect(content).toContain('statusFilters');
    60→    expect(content).toContain('.filter(');
    61→  });
    62→
    63→  // AC: @triage-daemon-api ac-3
    64→  it('should have POST /api/triage route that creates record with snapshot', async () => {
    65→    const content = await readFile(ROUTES_PATH, 'utf-8');
    66→
    67→    // Route definition
    68→    expect(content).toContain('.post(');
    69→
    70→    // AC: @triage-daemon-api ac-3 - Create record with item_snapshot
    71→    expect(content).toContain('item_snapshot: inboxItem.text');
    72→    expect(content).toContain('saveTriageRecord');
    73→    expect(content).toContain('commitIfShadow');
    74→
    75→    // AC: @triage-daemon-api ac-3 - Broadcast via WebSocket
    76→    expect(content).toContain("'triage:updates'");
    77→    expect(content).toContain("'triage_record_created'");
    78→
    79→    // Body schema
    80→    expect(content).toContain('inbox_ref: t.String()');
    81→    expect(content).toContain('action: t.String()');
    82→    expect(content).toContain('reasoning: t.String()');
    83→  });
    84→
    85→  // AC: @triage-daemon-api ac-4
    86→  it('should have POST /:ref/override route that sets override fields', async () => {
    87→    const content = await readFile(ROUTES_PATH, 'utf-8');
    88→
    89→    // Route definition
    90→    expect(content).toContain("'/:ref/override'");
    91→
    92→    // AC: @triage-daemon-api ac-4 - Set override fields
    93→    expect(content).toContain('override_reasoning');
    94→    expect(content).toContain('override_by');
    95→    expect(content).toContain('override_at');
    96→
    97→    // AC: @triage-daemon-api ac-4 - Update action
    98→    expect(content).toContain('record.action = body.action');
    99→
   100→    // AC: @triage-daemon-api ac-4 - Broadcast
   101→    expect(content).toContain("'triage_record_updated'");
   102→
   103→    // Shadow commit
   104→    expect(content).toContain("triage: override");
   105→  });
   106→
   107→  // AC: @triage-daemon-api ac-5
   108→  it('should have POST /:ref/act route that executes and transitions', async () => {
   109→    const content = await readFile(ROUTES_PATH, 'utf-8');
   110→
   111→    // Route definition
   112→    expect(content).toContain("'/:ref/act'");
   113→
   114→    // AC: @triage-daemon-api ac-5 - Execute action
   115→    expect(content).toContain('executeTriageAction');
   116→
   117→    // AC: @triage-daemon-api ac-5 - Transition to acted_on
   118→    expect(content).toContain("record.status = 'acted_on'");
   119→    expect(content).toContain('record.acted_at');
   120→    expect(content).toContain('record.result_ref');
   121→
   122→    // AC: @triage-daemon-api ac-5 - Broadcast
   123→    expect(content).toContain("'triage_record_acted'");
   124→
   125→    // Shadow commit
   126→    expect(content).toContain("triage: act");
   127→  });
   128→
   129→  // AC: @triage-daemon-api ac-6
   130→  it('should have GET /api/triage/export with format parameter', async () => {
   131→    const content = await readFile(ROUTES_PATH, 'utf-8');
   132→
   133→    // Route definition
   134→    expect(content).toContain("'/export'");
   135→
   136→    // AC: @triage-daemon-api ac-6 - Format parameter
   137→    expect(content).toContain('query.format');
   138→
   139→    // AC: @triage-daemon-api ac-6 - Uses shared export formatter
   140→    // AC: @triage-agent-export ac-1, ac-2 - Shared formatter for both CLI and daemon
   141→    expect(content).toContain('exportTriageRecords');
   142→
   143→    // AC: @triage-daemon-api ac-6 - Supports both json and context formats
   144→    expect(content).toContain("'json' | 'context'");
   145→  });
   146→
   147→  // AC: @triage-daemon-api ac-7
   148→  it('should return 404 for nonexistent inbox item on POST', async () => {
   149→    const content = await readFile(ROUTES_PATH, 'utf-8');
   150→
   151→    // AC: @triage-daemon-api ac-7 - Validate inbox item exists
   152→    expect(content).toContain('findInboxItemByRef');
   153→    expect(content).toContain('!inboxItem');
   154→    expect(content).toContain('errorResponse(404');
   155→    expect(content).toContain('not_found');
   156→    expect(content).toContain('suggestion');
   157→  });
   158→
   159→  // AC: @triage-daemon-api ac-8
   160→  it('should return 409 for act on already acted_on record', async () => {
   161→    const content = await readFile(ROUTES_PATH, 'utf-8');
   162→
   163→    // AC: @triage-daemon-api ac-8 - Already acted on → 409
   164→    expect(content).toContain("record.status === 'acted_on'");
   165→    expect(content).toContain('errorResponse(409');
   166→    expect(content).toContain('invalid_transition');
   167→    expect(content).toContain('already been acted on');
   168→  });
   169→
   170→  // AC: @triage-daemon-api ac-9
   171→  it('should return 422 for act on pending record', async () => {
   172→    const content = await readFile(ROUTES_PATH, 'utf-8');
   173→
   174→    // AC: @triage-daemon-api ac-9 - Pending → 422
   175→    expect(content).toContain("record.status === 'pending'");
   176→    expect(content).toContain('errorResponse(422');
   177→    expect(content).toContain('incomplete_record');
   178→    expect(content).toContain('Complete triage first');
   179→  });
   180→
   181→  // Trait: @trait-api-endpoint ac-1
   182→  it('should return JSON responses for successful operations', async () => {
   183→    const content = await readFile(ROUTES_PATH, 'utf-8');
   184→
   185→    // AC: @trait-api-endpoint ac-1 - Success returns JSON
   186→    expect(content).toContain('success: true');
   187→    expect(content).toContain('record');
   188→  });
   189→
   190→  // Trait: @trait-api-endpoint ac-2
   191→  it('should return 404 with error/message/suggestion for invalid refs', async () => {
   192→    const content = await readFile(ROUTES_PATH, 'utf-8');
   193→
   194→    // AC: @trait-api-endpoint ac-2 - 404 structure
   195→    expect(content).toContain("error: 'not_found'");
   196→    expect(content).toContain('message:');
   197→    expect(content).toContain('suggestion:');
   198→  });
   199→
   200→  // Trait: @trait-api-endpoint ac-3
   201→  it('should return 400 with validation error details for invalid body', async () => {
   202→    const content = await readFile(ROUTES_PATH, 'utf-8');
   203→
   204→    // AC: @trait-api-endpoint ac-3 - Validation error structure
   205→    expect(content).toContain('errorResponse(400');
   206→    expect(content).toContain("error: 'validation_error'");
   207→    expect(content).toContain('details:');
   208→    expect(content).toContain('field:');
   209→    expect(content).toContain('message:');
   210→  });
   211→
   212→  // Trait: @trait-api-endpoint ac-4
   213→  it('should support pagination with limit and offset', async () => {
   214→    const content = await readFile(ROUTES_PATH, 'utf-8');
   215→
   216→    // AC: @trait-api-endpoint ac-4 - Pagination wrapper
   217→    expect(content).toContain('query.limit');
   218→    expect(content).toContain('query.offset');
   219→    expect(content).toContain('offset,');
   220→    expect(content).toContain('limit,');
   221→    expect(content).toContain('.slice(offset, offset + limit)');
   222→  });
   223→
   224→  // Trait: @trait-api-endpoint ac-5
   225→  it('should create shadow commits for all mutations', async () => {
   226→    const content = await readFile(ROUTES_PATH, 'utf-8');
   227→
   228→    // AC: @trait-api-endpoint ac-5 - Shadow commit on mutations
   229→    // Count commitIfShadow calls — should appear for record, override, and act
   230→    const commitCalls = (content.match(/commitIfShadow/g) || []).length;
   231→    expect(commitCalls).toBeGreaterThanOrEqual(3);
   232→
   233→    expect(content).toContain("triage: record");
   234→    expect(content).toContain("triage: override");
   235→    expect(content).toContain("triage: act");
   236→  });
   237→
   238→  // Trait: @trait-websocket-protocol ac-3
   239→  it('should broadcast events via pubsub for all mutations', async () => {
   240→    const content = await readFile(ROUTES_PATH, 'utf-8');
   241→
   242→    // AC: @trait-websocket-protocol ac-3 - Broadcast events
   243→    const broadcastCalls = (content.match(/pubsub\.broadcast/g) || []).length;
   244→    expect(broadcastCalls).toBeGreaterThanOrEqual(3);
   245→
   246→    // All broadcasts scoped to project
   247→    expect(content).toContain('projectContext.path');
   248→  });
   249→
   250→  it('should use project context from middleware (not hardcoded kspecDir)', async () => {
   251→    const content = await readFile(ROUTES_PATH, 'utf-8');
   252→
   253→    // AC: @multi-directory-daemon ac-1, ac-24 - Project context from middleware
   254→    expect(content).toContain('projectContext');
   255→    expect(content).toContain('projectContext.path');
   256→    expect(content).toContain('initContext(projectContext.path)');
   257→
   258→    // Should NOT have hardcoded kspecDir
   259→    expect(content).not.toContain('const ctx = await initContext(kspecDir)');
   260→  });
   261→
   262→  it('should be integrated into main server', async () => {
   263→    const serverContent = await readFile(SERVER_PATH, 'utf-8');
   264→
   265→    // Check import
   266→    expect(serverContent).toContain("import { createTriageRoutes } from './routes/triage'");
   267→
   268→    // Check usage
   269→    expect(serverContent).toContain('createTriageRoutes');
   270→    expect(serverContent).toContain('pubsubManager');
   271→  });
   272→
   273→  it('should use proper TypeScript types from parser', async () => {
   274→    const content = await readFile(ROUTES_PATH, 'utf-8');
   275→
   276→    // Check imports from parser
   277→    expect(content).toContain("from '../../parser/index.js'");
   278→    expect(content).toContain('initContext');
   279→    expect(content).toContain('loadTriageRecords');
   280→    expect(content).toContain('saveTriageRecord');
   281→    expect(content).toContain('findTriageRecordByRef');
   282→    expect(content).toContain('loadInboxItems');
   283→    expect(content).toContain('findInboxItemByRef');
   284→    expect(content).toContain('LoadedTriageRecord');
   285→  });
   286→
   287→  it('should validate body parameters with Elysia schema', async () => {
   288→    const content = await readFile(ROUTES_PATH, 'utf-8');
   289→
   290→    // Body schema validation for POST /api/triage
   291→    expect(content).toContain('body: t.Object({');
   292→    expect(content).toContain('inbox_ref: t.String()');
   293→    expect(content).toContain('action: t.String()');
   294→    expect(content).toContain('reasoning: t.String()');
   295→    expect(content).toContain('t.Optional');
   296→  });
   297→
   298→  it('should define export route before /:ref to avoid route conflicts', async () => {
   299→    const content = await readFile(ROUTES_PATH, 'utf-8');
   300→
   301→    // Export route must come before /:ref to prevent "export" being parsed as ref
   302→    const exportIndex = content.indexOf("'/export'");
   303→    const refIndex = content.indexOf("'/:ref'");
   304→    expect(exportIndex).toBeGreaterThan(-1);
   305→    expect(refIndex).toBeGreaterThan(-1);
   306→    expect(exportIndex).toBeLessThan(refIndex);
   307→  });
   308→
   309→  describe('Action execution', () => {
   310→    // AC: @triage-daemon-api ac-5 - All action types handled via shared module
   311→    it('should import executeTriageAction from shared triage module', async () => {
   312→      const content = await readFile(ROUTES_PATH, 'utf-8');
   313→
   314→      // Daemon imports shared executor and constants
   315→      expect(content).toContain('executeTriageAction');
   316→      expect(content).toContain('VALID_ACTIONS');
   317→      expect(content).toContain("from '../../triage/index.js'");
   318→    });
   319→
   320→    it('shared triage module should handle all 5 action types', async () => {
   321→      const actionsPath = join(process.cwd(), 'src/triage/actions.ts');
   322→      const content = await readFile(actionsPath, 'utf-8');
   323→
   324→      // AC: @triage-daemon-api ac-5 - All action types handled
   325→      expect(content).toContain('case "promote"');
   326→      expect(content).toContain('case "delete"');
   327→      expect(content).toContain('case "defer"');
   328→      expect(content).toContain('case "spec-gap"');
   329→      expect(content).toContain('case "duplicate"');
   330→
   331→      // Promote creates task
   332→      expect(content).toContain('createTask');
   333→      expect(content).toContain('saveTask');
   334→
   335→      // Delete/duplicate removes inbox item
   336→      expect(content).toContain('deleteInboxItem');
   337→
   338→      // Spec-gap creates observation
   339→      expect(content).toContain('createObservation');
   340→      expect(content).toContain('saveObservation');
   341→    });
   342→  });
   343→
   344→  describe('Export format', () => {
   345→    it('should support context markdown format via shared formatter', async () => {
   346→      const content = await readFile(ROUTES_PATH, 'utf-8');
   347→
   348→      // AC: @triage-daemon-api ac-6 - Uses shared export formatter
   349→      // AC: @triage-agent-export ac-1 - Shared formatter for context format
   350→      expect(content).toContain('exportTriageRecords');
   351→
   352→      // Verify the shared formatter produces the expected markdown fields
   353→      const { exportTriageAsContext } = await import('../src/export/triage.js');
   354→      const mockRecord = {
   355→        _ulid: '01TESTUL1D000000000000000',
   356→        inbox_ref: '01INBOXRE000000000000000F',
   357→        item_snapshot: 'Test item',
   358→        status: 'triaged' as const,
   359→        action: 'promote' as const,
   360→        reasoning: 'Test reasoning',
   361→        decided_by: '@claude',
   362→        evidence_refs: [],
   363→        created_at: '2026-02-22T20:00:00.000Z',
   364→      };
   365→      const output = exportTriageAsContext([mockRecord]);
   366→      expect(output).toContain('**Item:**');
   367→      expect(output).toContain('**Status:**');
   368→      expect(output).toContain('**Action:**');
   369→      expect(output).toContain('**Reasoning:**');
   370→      expect(output).toContain('**Decided by:**');
   371→    });
   372→
   373→    it('should handle empty records in export via shared formatter', async () => {
   374→      // AC: @triage-daemon-api ac-6 - Empty case
   375→      // AC: @triage-agent-export ac-4 - Empty result message
   376→      const { exportTriageAsContext } = await import('../src/export/triage.js');
   377→      const output = exportTriageAsContext([]);
   378→      expect(output).toBe('No triage decisions recorded.');
   379→    });
   380→  });
   381→
   382→  describe('Override edge cases', () => {
   383→    it('should re-triage acted_on records on override', async () => {
   384→      const content = await readFile(ROUTES_PATH, 'utf-8');
   385→
   386→      // Override resets acted_on to triaged for re-acting
   387→      expect(content).toContain("record.status === 'acted_on'");
   388→      expect(content).toContain("record.status = 'triaged'");
   389→    });
   390→
   391→    it('should clear stale execution metadata on override', async () => {
   392→      const content = await readFile(ROUTES_PATH, 'utf-8');
   393→
   394→      // When overriding an acted_on record, clear acted_at and result_ref
   395→      // to prevent previous action's results leaking into re-act flow
   396→      expect(content).toContain('record.acted_at = undefined');
   397→      expect(content).toContain('record.result_ref = undefined');
   398→    });
   399→  });
   400→
   401→  describe('Upsert correctness', () => {
   402→    it('should handle duplicate POST by preserving existing record identity', async () => {
   403→      const content = await readFile(ROUTES_PATH, 'utf-8');
   404→
   405→      // Check for existing record before creating (upsert case)
   406→      expect(content).toContain('findTriageRecordByInboxRef');
   407→
   408→      // Reload persisted record after save to ensure correct ULID is returned
   409→      expect(content).toContain('savedRecords');
   410→      expect(content).toContain('savedRecord');
   411→      expect(content).toContain('record: savedRecord');
   412→    });
   413→  });
   414→});
