     1→/**
     2→ * Unit tests for the in-memory write buffer used in batch atomic execution.
     3→ *
     4→ * Tests the WriteBuffer class directly, plus integration tests verifying
     5→ * that batch execution does not copy sessions/ to disk.
     6→ */
     7→
     8→import { describe, it, expect, beforeEach, afterEach } from "vitest";
     9→import * as path from "node:path";
    10→import * as fs from "node:fs/promises";
    11→import {
    12→  WriteBuffer,
    13→  SyntheticDirent,
    14→  accessBufferAware,
    15→  activateBatchBuffer,
    16→  deactivateBatchBuffer,
    17→  getActiveBatchBuffer,
    18→  readdirBufferAware,
    19→  writeFileBufferAware,
    20→} from "../src/cli/batch-write-buffer.js";
    21→import { copyCoreSkillFiles } from "../src/cli/commands/skill-install.js";
    22→import { readFileBufferAware } from "../src/parser/yaml.js";
    23→import {
    24→  kspec,
    25→  kspecJson,
    26→  setupTempFixtures,
    27→  cleanupTempDir,
    28→  initGitRepo,
    29→  createTempDir,
    30→} from "./helpers/cli.js";
    31→import type { BatchExecResult } from "../src/schema/batch.js";
    32→
    33→// ── WriteBuffer Unit Tests ───────────────────────────────────────────
    34→
    35→describe("WriteBuffer", () => {
    36→  const specDir = "/tmp/test-spec-dir";
    37→
    38→  it("isInScope returns true for paths under specDir", () => {
    39→    const buf = new WriteBuffer(specDir);
    40→    expect(buf.isInScope(`${specDir}/kynetic.yaml`)).toBe(true);
    41→    expect(buf.isInScope(`${specDir}/modules/foo.yaml`)).toBe(true);
    42→    expect(buf.isInScope(specDir)).toBe(true);
    43→  });
    44→
    45→  it("isInScope returns false for paths outside specDir", () => {
    46→    const buf = new WriteBuffer(specDir);
    47→    expect(buf.isInScope("/tmp/other-dir/file.yaml")).toBe(false);
    48→    expect(buf.isInScope("/etc/hosts")).toBe(false);
    49→  });
    50→
    51→  // AC: @batch-write-buffer ac-1 — writes go to buffer
    52→  it("write() stores content without touching disk", () => {
    53→    const buf = new WriteBuffer(specDir);
    54→    const filePath = `${specDir}/project.tasks.yaml`;
    55→    buf.write(filePath, "tasks: []");
    56→    expect(buf.has(filePath)).toBe(true);
    57→    expect(buf.hasWrite(filePath)).toBe(true);
    58→    expect(buf.size).toBe(1);
    59→  });
    60→
    61→  // AC: @batch-write-buffer ac-2 — read-after-write returns buffered content
    62→  it("read() returns buffered content", () => {
    63→    const buf = new WriteBuffer(specDir);
    64→    const filePath = `${specDir}/project.tasks.yaml`;
    65→    buf.write(filePath, "tasks: [hello]");
    66→    const result = buf.read(filePath);
    67→    expect(result).toBe("tasks: [hello]");
    68→  });
    69→
    70→  it("read() returns undefined for non-buffered path", () => {
    71→    const buf = new WriteBuffer(specDir);
    72→    const result = buf.read(`${specDir}/kynetic.yaml`);
    73→    expect(result).toBeUndefined();
    74→  });
    75→
    76→  // AC: @batch-write-buffer ac-4 — discard clears buffer without disk writes
    77→  it("discard() clears all entries", () => {
    78→    const buf = new WriteBuffer(specDir);
    79→    buf.write(`${specDir}/a.yaml`, "a: 1");
    80→    buf.write(`${specDir}/b.yaml`, "b: 2");
    81→    expect(buf.size).toBe(2);
    82→    buf.discard();
    83→    expect(buf.size).toBe(0);
    84→    expect(buf.read(`${specDir}/a.yaml`)).toBeUndefined();
    85→  });
    86→
    87→  it("getPaths() returns all buffered paths", () => {
    88→    const buf = new WriteBuffer(specDir);
    89→    buf.write(`${specDir}/a.yaml`, "a: 1");
    90→    buf.write(`${specDir}/b.yaml`, "b: 2");
    91→    const paths = buf.getPaths();
    92→    expect(paths).toHaveLength(2);
    93→    expect(paths).toContain(path.resolve(`${specDir}/a.yaml`));
    94→    expect(paths).toContain(path.resolve(`${specDir}/b.yaml`));
    95→  });
    96→});
    97→
    98→describe("WriteBuffer.listDir() and helper dirents", () => {
    99→  let tempDir: string;
   100→
   101→  beforeEach(async () => {
   102→    tempDir = await createTempDir();
   103→    await fs.mkdir(path.join(tempDir, "existing-dir"), { recursive: true });
   104→    await fs.writeFile(path.join(tempDir, "disk.yaml"), "disk: true", "utf-8");
   105→  });
   106→
   107→  afterEach(async () => {
   108→    await cleanupTempDir(tempDir);
   109→  });
   110→
   111→  it("SyntheticDirent exposes file/directory shape", () => {
   112→    const fileDirent = new SyntheticDirent("file.md", true);
   113→    const folderDirent = new SyntheticDirent("docs", false);
   114→
   115→    expect(fileDirent.name).toBe("file.md");
   116→    expect(fileDirent.isFile()).toBe(true);
   117→    expect(fileDirent.isDirectory()).toBe(false);
   118→    expect(folderDirent.isFile()).toBe(false);
   119→    expect(folderDirent.isDirectory()).toBe(true);
   120→  });
   121→
   122→  it("listDir() overlays buffered writes, deletions, and inferred directories", async () => {
   123→    const buf = new WriteBuffer(tempDir);
   124→
   125→    buf.write(path.join(tempDir, "new.yaml"), "new: true");
   126→    buf.write(path.join(tempDir, "new-dir", "nested.yaml"), "nested: true");
   127→    buf.delete(path.join(tempDir, "disk.yaml"));
   128→
   129→    const entries = await buf.listDir(tempDir, { withFileTypes: true });
   130→    const names = entries.map((e) => e.name);
   131→
   132→    expect(names).toContain("new.yaml");
   133→    expect(names).toContain("new-dir");
   134→    expect(names).toContain("existing-dir");
   135→    expect(names).not.toContain("disk.yaml");
   136→
   137→    const newFile = entries.find((e) => e.name === "new.yaml");
   138→    const inferredDir = entries.find((e) => e.name === "new-dir");
   139→    expect(newFile?.isFile()).toBe(true);
   140→    expect(inferredDir?.isDirectory()).toBe(true);
   141→  });
   142→
   143→  it("listDir() returns buffered entries even when directory is missing on disk", async () => {
   144→    const buf = new WriteBuffer(tempDir);
   145→    const missingDir = path.join(tempDir, "from-buffer-only");
   146→    buf.write(path.join(missingDir, "child.yaml"), "x: 1");
   147→
   148→    const plainEntries = await buf.listDir(missingDir);
   149→    expect(plainEntries).toEqual(["child.yaml"]);
   150→
   151→    const direntEntries = await buf.listDir(missingDir, { withFileTypes: true });
   152→    expect(direntEntries).toHaveLength(1);
   153→    expect(direntEntries[0].name).toBe("child.yaml");
   154→    expect(direntEntries[0].isFile()).toBe(true);
   155→  });
   156→
   157→  it("listDir() throws ENOENT when directory is deleted in the overlay", async () => {
   158→    const buf = new WriteBuffer(tempDir);
   159→    const existingDir = path.join(tempDir, "existing-dir");
   160→    buf.delete(existingDir);
   161→
   162→    await expect(buf.listDir(existingDir)).rejects.toMatchObject({ code: "ENOENT" });
   163→  });
   164→
   165→  it("listDir() does not resurrect a deleted directory after buffered child writes", async () => {
   166→    const buf = new WriteBuffer(tempDir);
   167→    const deletedDir = path.join(tempDir, "deleted-dir");
   168→
   169→    buf.write(path.join(deletedDir, "child.txt"), "hello");
   170→    buf.delete(deletedDir);
   171→
   172→    const entries = await buf.listDir(tempDir);
   173→    expect(entries).not.toContain("deleted-dir");
   174→  });
   175→});
   176→
   177→describe("buffer-aware fs helpers", () => {
   178→  let tempDir: string;
   179→
   180→  beforeEach(async () => {
   181→    tempDir = await createTempDir();
   182→  });
   183→
   184→  afterEach(async () => {
   185→    deactivateBatchBuffer();
   186→    await cleanupTempDir(tempDir);
   187→  });
   188→
   189→  it("readdirBufferAware() returns buffered directory entries with file types", async () => {
   190→    activateBatchBuffer(tempDir);
   191→    const bufferedFile = path.join(tempDir, "docs", "note.md");
   192→    getActiveBatchBuffer()!.write(bufferedFile, "# note\n");
   193→
   194→    const entries = await readdirBufferAware(path.join(tempDir, "docs"), {
   195→      withFileTypes: true,
   196→    });
   197→    expect(entries).toHaveLength(1);
   198→    expect(entries[0].name).toBe("note.md");
   199→    expect(entries[0].isFile()).toBe(true);
   200→  });
   201→
   202→  it("accessBufferAware() checks buffered writes and deletions", async () => {
   203→    const buffer = activateBatchBuffer(tempDir);
   204→    const filePath = path.join(tempDir, "buffered.txt");
   205→
   206→    buffer.write(filePath, "buffered");
   207→    await expect(accessBufferAware(filePath)).resolves.toBeUndefined();
   208→
   209→    buffer.delete(filePath);
   210→    await expect(accessBufferAware(filePath)).rejects.toMatchObject({ code: "ENOENT" });
   211→
   212→    buffer.write(path.join(tempDir, "nested", "child.md"), "hello");
   213→    await expect(accessBufferAware(path.join(tempDir, "nested"))).resolves.toBeUndefined();
   214→
   215→    buffer.delete(path.join(tempDir, "gone"));
   216→    await expect(accessBufferAware(path.join(tempDir, "gone", "child.md"))).rejects.toMatchObject({
   217→      code: "ENOENT",
   218→    });
   219→  });
   220→
   221→  it("writeFileBufferAware()/readFileBufferAware() use active buffer", async () => {
   222→    activateBatchBuffer(tempDir);
   223→    const filePath = path.join(tempDir, "buffered.md");
   224→
   225→    await writeFileBufferAware(filePath, "hello from buffer");
   226→    await expect(fs.readFile(filePath, "utf-8")).rejects.toThrow();
   227→    await expect(readFileBufferAware(filePath)).resolves.toBe("hello from buffer");
   228→
   229→    getActiveBatchBuffer()!.delete(filePath);
   230→    await expect(readFileBufferAware(filePath)).rejects.toMatchObject({ code: "ENOENT" });
   231→  });
   232→
   233→  it("copyCoreSkillFiles() is read-after-write consistent within one active buffer", async () => {
   234→    const specDir = path.join(tempDir, ".kspec");
   235→    const targetDir = path.join(specDir, "skills", "triage");
   236→    activateBatchBuffer(specDir);
   237→
   238→    const first = await copyCoreSkillFiles("triage", targetDir);
   239→    const second = await copyCoreSkillFiles("triage", targetDir);
   240→
   241→    expect(first.changed).toBe(true);
   242→    expect(second.changed).toBe(false);
   243→  });
   244→});
   245→
   246→// ── WriteBuffer Flush Tests ──────────────────────────────────────────
   247→
   248→describe("WriteBuffer.flush()", () => {
   249→  let tempDir: string;
   250→
   251→  beforeEach(async () => {
   252→    tempDir = await createTempDir();
   253→    await fs.mkdir(path.join(tempDir, "modules"), { recursive: true });
   254→  });
   255→
   256→  afterEach(async () => {
   257→    await cleanupTempDir(tempDir);
   258→  });
   259→
   260→  // AC: @batch-write-buffer ac-3 — only buffered files flushed
   261→  it("flush() writes only buffered files to disk", async () => {
   262→    const buf = new WriteBuffer(tempDir);
   263→    const fileA = path.join(tempDir, "a.yaml");
   264→    const fileB = path.join(tempDir, "b.yaml");
   265→
   266→    // Write an existing file that is NOT buffered — it should remain unchanged
   267→    await fs.writeFile(fileB, "original: true", "utf-8");
   268→
   269→    buf.write(fileA, "written: true");
   270→    await buf.flush();
   271→
   272→    // a.yaml was buffered — should be written
   273→    const aContent = await fs.readFile(fileA, "utf-8");
   274→    expect(aContent).toBe("written: true");
   275→
   276→    // b.yaml was NOT buffered — should be unchanged
   277→    const bContent = await fs.readFile(fileB, "utf-8");
   278→    expect(bContent).toBe("original: true");
   279→  });
   280→
   281→  // AC: @batch-write-buffer ac-3 — only actually-written files flushed
   282→  it("flush() with empty buffer is a no-op", async () => {
   283→    const buf = new WriteBuffer(tempDir);
   284→    await expect(buf.flush()).resolves.toBeUndefined();
   285→  });
   286→
   287→  it("flush() creates parent directories if needed", async () => {
   288→    const buf = new WriteBuffer(tempDir);
   289→    const nested = path.join(tempDir, "modules", "sub", "item.yaml");
   290→    buf.write(nested, "nested: true");
   291→    await buf.flush();
   292→
   293→    const content = await fs.readFile(nested, "utf-8");
   294→    expect(content).toBe("nested: true");
   295→  });
   296→
   297→  it("flush() cleans up staging files on success", async () => {
   298→    const buf = new WriteBuffer(tempDir);
   299→    const filePath = path.join(tempDir, "task.yaml");
   300→    buf.write(filePath, "task: done");
   301→    await buf.flush();
   302→
   303→    // No staging files should remain
   304→    const entries = await fs.readdir(tempDir);
   305→    const stagingFiles = entries.filter((e) => e.includes(".kspec-batch-staging"));
   306→    expect(stagingFiles).toHaveLength(0);
   307→  });
   308→
   309→  // AC: @batch-write-buffer ac-7 — flush failure: error reported, pre-batch state preserved
   310→  it("flush() reports error and leaves no partial writes when staging write fails", async () => {
   311→    const buf = new WriteBuffer(tempDir);
   312→
   313→    // Pre-existing file that should remain unchanged
   314→    const existingFile = path.join(tempDir, "existing.yaml");
   315→    await fs.writeFile(existingFile, "original: true", "utf-8");
   316→
   317→    // Buffer a write to a path whose parent is a FILE (not a dir) — mkdir will fail,
   318→    // causing Phase 1 to throw. This exercises the "staging failed, nothing committed" path.
   319→    const blockingFile = path.join(tempDir, "not-a-dir");
   320→    await fs.writeFile(blockingFile, "i am a file, not a directory", "utf-8");
   321→    const fileInsideBlocker = path.join(blockingFile, "nested.yaml");
   322→
   323→    buf.write(fileInsideBlocker, "should not appear");
   324→
   325→    // flush() should throw with "staging failed" message
   326→    await expect(buf.flush()).rejects.toThrow("Batch flush staging failed");
   327→
   328→    // existingFile should be completely unchanged
   329→    const content = await fs.readFile(existingFile, "utf-8");
   330→    expect(content).toBe("original: true");
   331→
   332→    // No staging files should remain after cleanup
   333→    const entries = await fs.readdir(tempDir);
   334→    const stagingFiles = entries.filter((e) => e.includes(".kspec-batch-staging"));
   335→    expect(stagingFiles).toHaveLength(0);
   336→  });
   337→
   338→  // AC: @batch-write-buffer ac-4 — discard leaves disk unchanged
   339→  it("discard() does not write anything to disk", async () => {
   340→    const buf = new WriteBuffer(tempDir);
   341→    const filePath = path.join(tempDir, "task.yaml");
   342→    buf.write(filePath, "should not appear");
   343→    buf.discard();
   344→
   345→    await expect(fs.readFile(filePath, "utf-8")).rejects.toThrow();
   346→  });
   347→});
   348→
   349→// ── Module Singleton Tests ───────────────────────────────────────────
   350→
   351→describe("batch buffer singleton", () => {
   352→  afterEach(() => {
   353→    deactivateBatchBuffer();
   354→  });
   355→
   356→  it("activateBatchBuffer() creates and returns a buffer", () => {
   357→    const buf = activateBatchBuffer("/tmp/specdir");
   358→    expect(buf).toBeInstanceOf(WriteBuffer);
   359→    expect(getActiveBatchBuffer()).toBe(buf);
   360→  });
   361→
   362→  it("deactivateBatchBuffer() clears the singleton", () => {
   363→    activateBatchBuffer("/tmp/specdir");
   364→    deactivateBatchBuffer();
   365→    expect(getActiveBatchBuffer()).toBeNull();
   366→  });
   367→
   368→  it("getActiveBatchBuffer() returns null when not active", () => {
   369→    expect(getActiveBatchBuffer()).toBeNull();
   370→  });
   371→});
   372→
   373→// ── Integration Tests: No sessions/ Copy ────────────────────────────
   374→
   375→describe("batch write buffer integration", () => {
   376→  let tempDir: string;
   377→
   378→  beforeEach(async () => {
   379→    tempDir = await setupTempFixtures();
   380→    initGitRepo(tempDir);
   381→    kspec("init --no-prompt", tempDir);
   382→  });
   383→
   384→  afterEach(async () => {
   385→    await cleanupTempDir(tempDir);
   386→  });
   387→
   388→  // AC: @batch-write-buffer ac-5 — sessions/ never copied to buffer/temp
   389→  it("batch does not create any temp directory copy of specDir", async () => {
   390→    // Create a large dummy sessions directory to test it's not copied
   391→    const specDir = path.join(tempDir, ".kspec");
   392→    const sessionsDir = path.join(specDir, "sessions");
   393→    await fs.mkdir(sessionsDir, { recursive: true });
   394→    await fs.writeFile(path.join(sessionsDir, "big-blob.txt"), "x".repeat(1024));
   395→
   396→    // Capture temp dir listing before batch
   397→    const tmpBefore = await fs.readdir("/tmp");
   398→    const kspecTempsBefore = tmpBefore.filter((d) => d.startsWith("kspec-batch-"));
   399→
   400→    const result = kspecJson<BatchExecResult>(
   401→      `batch --commands '[{"command":"inbox add","args":{"text":"no-copy test"}}]'`,
   402→      tempDir,
   403→    );
   404→    expect(result.success).toBe(true);
   405→
   406→    // No new kspec-batch- temp dirs should have been created
   407→    const tmpAfter = await fs.readdir("/tmp");
   408→    const kspecTempsAfter = tmpAfter.filter((d) => d.startsWith("kspec-batch-"));
   409→    expect(kspecTempsAfter.length).toBe(kspecTempsBefore.length);
   410→  });
   411→
   412→  // AC: @batch-write-buffer ac-3 — only written files committed
   413→  it("atomic batch only writes files touched by commands", async () => {
   414→    const specDir = path.join(tempDir, ".kspec");
   415→
   416→    // Get baseline list of files in spec dir
   417→    const beforeFiles = await getAllFiles(specDir);
   418→
   419→    const result = kspecJson<BatchExecResult>(
   420→      `batch --commands '[{"command":"inbox add","args":{"text":"write-test item"}}]'`,
   421→      tempDir,
   422→    );
   423→    expect(result.success).toBe(true);
   424→
   425→    const afterFiles = await getAllFiles(specDir);
   426→
   427→    // Only inbox file should have been added/modified — no sessions/ or other unrelated dirs
   428→    const newFiles = afterFiles.filter((f) => !beforeFiles.includes(f));
   429→    for (const newFile of newFiles) {
   430→      // New files should be spec-related (inbox YAML), not sessions or blobs
   431→      expect(newFile).not.toContain("sessions");
   432→      expect(newFile).not.toContain("blobs");
   433→    }
   434→
   435→    // Verify the inbox item was actually created
   436→    const inbox = kspec("inbox list", tempDir);
   437→    expect(inbox.stdout).toContain("write-test item");
   438→  });
   439→
   440→  // AC: @batch-write-buffer ac-2 — read-after-write within same batch
   441→  it("two sequential inbox adds in same batch both succeed", () => {
   442→    // Verify read-after-write semantics: command 2 reads the inbox file
   443→    // updated by command 1 via the buffer, not from disk.
   444→    const result = kspecJson<BatchExecResult>(
   445→      `batch --commands '[{"command":"inbox add","args":{"text":"first buf item"}},{"command":"inbox add","args":{"text":"second buf item"}}]'`,
   446→      tempDir,
   447→    );
   448→    expect(result.success).toBe(true);
   449→    expect(result.summary.succeeded).toBe(2);
   450→
   451→    // Both items should be visible after batch completes (both flushed)
   452→    const inbox = kspec("inbox list", tempDir);
   453→    expect(inbox.stdout).toContain("first buf item");
   454→    expect(inbox.stdout).toContain("second buf item");
   455→  });
   456→
   457→  // AC: @batch-write-buffer ac-2 — repeated item ac add in one batch preserves both writes
   458→  // AC: @batch-write-buffer ac-8 — loadSpecFile must read buffered state, not stale fs.readFile disk state
   459→  it("two item ac add commands against the same item keep both AC entries", () => {
   460→    kspec(`module add --title "Batch Buffer Test Module" --slug batch-buffer-test-module`, tempDir);
   461→
   462→    const result = kspecJson<BatchExecResult>(
   463→      `batch --commands '[{"command":"item ac add","args":{"ref":"@batch-buffer-test-module","given":"first given","when":"first when","then":"first then"}},{"command":"item ac add","args":{"ref":"@batch-buffer-test-module","given":"second given","when":"second when","then":"second then"}}]'`,
   464→      tempDir,
   465→    );
   466→    expect(result.success).toBe(true);
   467→    expect(result.summary.succeeded).toBe(2);
   468→
   469→    const item = kspec("item get @batch-buffer-test-module", tempDir);
   470→    expect(item.stdout).toContain("first then");
   471→    expect(item.stdout).toContain("second then");
   472→  });
   473→
   474→  // AC: @batch-write-buffer ac-1, ac-4 — supporting file writes rollback in atomic batch failures
   475→  it("skill import supporting files do not persist when later batch command fails", async () => {
   476→    const sourceDir = path.join(tempDir, "skill-import-source");
   477→    const docsDir = path.join(sourceDir, "docs");
   478→    const skillMdSource = path.join(sourceDir, "SKILL.md");
   479→    await fs.mkdir(docsDir, { recursive: true });
   480→    await fs.writeFile(skillMdSource, "# Rollback Skill\n\nUsed for rollback test.\n", "utf-8");
   481→    await fs.writeFile(path.join(docsDir, "guide.md"), "guide text", "utf-8");
   482→
   483→    const commands = [
   484→      {
   485→        command: "skill import",
   486→        args: {
   487→          file: skillMdSource,
   488→          id: "rollback-skill",
   489→          name: "Rollback Skill",
   490→          description: "Rollback test skill",
   491→          origin: "local",
   492→        },
   493→      },
   494→      {
   495→        command: "task start",
   496→        args: {
   497→          ref: "@does-not-exist-task",
   498→        },
   499→      },
   500→    ];
   501→
   502→    const result = kspecJson<BatchExecResult>(
   503→      `batch --commands '${JSON.stringify(commands)}'`,
   504→      tempDir,
   505→      { expectFail: true },
   506→    );
   507→    expect(result.success).toBe(false);
   508→    expect(result.summary.succeeded).toBe(1);
   509→    expect(result.summary.failed).toBe(1);
   510→
   511→    const importedSkillMd = path.join(tempDir, ".kspec", "skills", "rollback-skill", "SKILL.md");
   512→    const importedDoc = path.join(tempDir, ".kspec", "skills", "rollback-skill", "docs", "guide.md");
   513→    await expect(fs.access(importedSkillMd)).rejects.toThrow();
   514→    await expect(fs.access(importedDoc)).rejects.toThrow();
   515→
   516→    const skills = kspec("skill list", tempDir);
   517→    expect(skills.stdout).not.toContain("rollback-skill");
   518→  });
   519→
   520→  // AC: @batch-write-buffer ac-4 — rollback on failure leaves .kspec/ unchanged
   521→  it("atomic batch with failure leaves spec dir unchanged", () => {
   522→    // Add baseline item
   523→    kspec(`inbox add "baseline for rollback test"`, tempDir);
   524→    const inboxBefore = kspec("inbox list", tempDir);
   525→
   526→    // This batch will fail pre-validation (nonexistent command) — nothing should execute
   527→    const result = kspecJson<BatchExecResult>(
   528→      `batch --commands '[{"command":"inbox add","args":{"text":"should not appear"}},{"command":"nonexistent command","args":{}}]'`,
   529→      tempDir,
   530→      { expectFail: true },
   531→    );
   532→    expect(result.success).toBe(false);
   533→
   534→    // inbox should not contain "should not appear" — buffer was discarded
   535→    const inboxAfter = kspec("inbox list", tempDir);
   536→    expect(inboxAfter.stdout).not.toContain("should not appear");
   537→    // baseline item should still be there
   538→    expect(inboxAfter.stdout).toContain("baseline for rollback test");
   539→  });
   540→
   541→  // AC: @batch-write-buffer ac-6 — other processes see pre-batch state
   542→  it("spec dir on disk is unchanged when batch fails (buffer is process-local)", () => {
   543→    // Add baseline to track state
   544→    kspec(`inbox add "ac6 baseline item"`, tempDir);
   545→    const countBefore = kspec("inbox list", tempDir).stdout.split("\n").filter(Boolean).length;
   546→
   547→    // Run a batch that fails pre-validation — writes should be discarded
   548→    const result = kspecJson<BatchExecResult>(
   549→      `batch --commands '[{"command":"inbox add","args":{"text":"ac6 should not appear"}},{"command":"nonexistent-command","args":{}}]'`,
   550→      tempDir,
   551→      { expectFail: true },
   552→    );
   553→    expect(result.success).toBe(false);
   554→
   555→    // On pre-validation failure the buffer is discarded — inbox unchanged
   556→    const inboxAfter = kspec("inbox list", tempDir);
   557→    expect(inboxAfter.stdout).not.toContain("ac6 should not appear");
   558→    // Line count should be the same
   559→    const countAfter = inboxAfter.stdout.split("\n").filter(Boolean).length;
   560→    expect(countAfter).toBe(countBefore);
   561→  });
   562→});
   563→
   564→// ── Helper ────────────────────────────────────────────────────────────
   565→
   566→async function getAllFiles(dir: string): Promise<string[]> {
   567→  const results: string[] = [];
   568→  try {
   569→    const entries = await fs.readdir(dir, { withFileTypes: true });
   570→    for (const entry of entries) {
   571→      const fullPath = path.join(dir, entry.name);
   572→      if (entry.isDirectory()) {
   573→        const sub = await getAllFiles(fullPath);
   574→        results.push(...sub);
   575→      } else {
   576→        results.push(fullPath);
   577→      }
   578→    }
   579→  } catch {
   580→    // ignore
   581→  }
   582→  return results;
   583→}
   584→
