     1→/**
     2→ * In-memory write buffer for atomic batch execution.
     3→ *
     4→ * Replaces the fs.cp(realSpecDir, tempDir) approach in batch-exec.ts.
     5→ * During batch execution, all writes to the spec directory are intercepted
     6→ * and stored in memory. On success (flush), buffered writes are committed
     7→ * to disk. On failure (discard), the buffer is dropped — real .kspec/ is
     8→ * never touched.
     9→ *
    10→ * AC: @batch-write-buffer ac-1 — writes go to buffer, not disk
    11→ * AC: @batch-write-buffer ac-2 — reads check buffer first (read-after-write)
    12→ * AC: @batch-write-buffer ac-3 — only written files flushed on commit
    13→ * AC: @batch-write-buffer ac-4 — rollback discards buffer, no disk writes
    14→ * AC: @batch-write-buffer ac-5 — sessions/ never copied (buffer is per-file)
    15→ * AC: @batch-write-buffer ac-6 — buffer is process-local, disk unchanged until flush
    16→ * AC: @batch-write-buffer ac-7 — flush failure reported, .kspec/ left in pre-batch state
    17→ */
    18→
    19→import * as fs from "node:fs/promises";
    20→import type { Dirent } from "node:fs";
    21→import * as path from "node:path";
    22→
    23→type OverlayEntryKind = "file" | "directory";
    24→type BufferedFileContent = string | Uint8Array;
    25→
    26→interface BufferedDirectoryOverlay {
    27→  directWrites: Map<string, "file" | "deleted">;
    28→  inferredDirectories: Set<string>;
    29→}
    30→
    31→function isNotFoundError(err: unknown): boolean {
    32→  return err instanceof Error && "code" in err && (err as NodeJS.ErrnoException).code === "ENOENT";
    33→}
    34→
    35→function createNotFoundError(filePath: string): NodeJS.ErrnoException {
    36→  return Object.assign(
    37→    new Error(`ENOENT: no such file or directory, open '${filePath}'`),
    38→    { code: "ENOENT" },
    39→  ) as NodeJS.ErrnoException;
    40→}
    41→
    42→export class SyntheticDirent {
    43→  name: string;
    44→  readonly parentPath = "";
    45→  readonly path = "";
    46→  private readonly _isFile: boolean;
    47→
    48→  constructor(name: string, isFile: boolean) {
    49→    this.name = name;
    50→    this._isFile = isFile;
    51→  }
    52→
    53→  isFile(): boolean {
    54→    return this._isFile;
    55→  }
    56→
    57→  isDirectory(): boolean {
    58→    return !this._isFile;
    59→  }
    60→
    61→  isBlockDevice(): boolean {
    62→    return false;
    63→  }
    64→
    65→  isCharacterDevice(): boolean {
    66→    return false;
    67→  }
    68→
    69→  isSymbolicLink(): boolean {
    70→    return false;
    71→  }
    72→
    73→  isFIFO(): boolean {
    74→    return false;
    75→  }
    76→
    77→  isSocket(): boolean {
    78→    return false;
    79→  }
    80→}
    81→
    82→/**
    83→ * In-memory write buffer for a single batch execution.
    84→ *
    85→ * Maps absolute file paths to their buffered string content.
    86→ * A null value indicates the file should be deleted on flush.
    87→ */
    88→export class WriteBuffer {
    89→  /** specDir this buffer is scoped to */
    90→  readonly specDir: string;
    91→
    92→  /** buffered writes: path → content (null = deleted) */
    93→  private readonly entries = new Map<string, BufferedFileContent | null>();
    94→
    95→  constructor(specDir: string) {
    96→    this.specDir = path.resolve(specDir);
    97→  }
    98→
    99→  /**
   100→   * Check if a file path falls within this buffer's specDir scope.
   101→   */
   102→  isInScope(filePath: string): boolean {
   103→    const resolved = path.resolve(filePath);
   104→    return resolved === this.specDir || resolved.startsWith(this.specDir + path.sep);
   105→  }
   106→
   107→  /**
   108→   * Write a file to the buffer.
   109→   * AC: @batch-write-buffer ac-1
   110→   */
   111→  write(filePath: string, content: BufferedFileContent): void {
   112→    this.entries.set(path.resolve(filePath), content);
   113→  }
   114→
   115→  /**
   116→   * Mark a file as deleted in the buffer.
   117→   */
   118→  delete(filePath: string): void {
   119→    this.entries.set(path.resolve(filePath), null);
   120→  }
   121→
   122→  /**
   123→   * Check if a file path has a buffered entry (write or delete).
   124→   */
   125→  has(filePath: string): boolean {
   126→    return this.entries.has(path.resolve(filePath));
   127→  }
   128→
   129→  /**
   130→   * Check if a file has been buffered as a write (not deleted).
   131→   */
   132→  hasWrite(filePath: string): boolean {
   133→    const resolved = path.resolve(filePath);
   134→    return this.entries.has(resolved) && this.entries.get(resolved) !== null;
   135→  }
   136→
   137→  /**
   138→   * Read a buffered file. Returns the buffered content if present,
   139→   * or undefined if not in buffer (caller should fall back to disk).
   140→   * AC: @batch-write-buffer ac-2
   141→   */
   142→  read(filePath: string): BufferedFileContent | null | undefined {
   143→    const resolved = path.resolve(filePath);
   144→    if (!this.entries.has(resolved)) return undefined;
   145→    return this.entries.get(resolved)!;
   146→  }
   147→
   148→  /**
   149→   * True when filePath or any ancestor directory has been deleted in the overlay.
   150→   */
   151→  isDeletedInOverlay(filePath: string): boolean {
   152→    if (!this.isInScope(filePath)) return false;
   153→
   154→    let current = path.resolve(filePath);
   155→    while (true) {
   156→      if (this.entries.get(current) === null) {
   157→        return true;
   158→      }
   159→      if (current === this.specDir) {
   160→        break;
   161→      }
   162→      const parent = path.dirname(current);
   163→      if (parent === current) {
   164→        break;
   165→      }
   166→      current = parent;
   167→    }
   168→
   169→    return false;
   170→  }
   171→
   172→  /**
   173→   * Get all buffered paths (for tests and diagnostics).
   174→   */
   175→  getPaths(): string[] {
   176→    return [...this.entries.keys()];
   177→  }
   178→
   179→  /**
   180→   * Get number of buffered entries.
   181→   */
   182→  get size(): number {
   183→    return this.entries.size;
   184→  }
   185→
   186→  private _buildDirectoryOverlay(directory: string): BufferedDirectoryOverlay {
   187→    const resolvedDir = path.resolve(directory);
   188→    const directWrites = new Map<string, "file" | "deleted">();
   189→    const inferredDirectories = new Set<string>();
   190→
   191→    for (const [bufferedPath, content] of this.entries) {
   192→      const relative = path.relative(resolvedDir, bufferedPath);
   193→      if (!relative || relative.startsWith("..") || path.isAbsolute(relative)) {
   194→        continue;
   195→      }
   196→
   197→      const parts = relative.split(path.sep).filter(Boolean);
   198→      if (parts.length === 0) continue;
   199→
   200→      const rootName = parts[0];
   201→      if (parts.length === 1) {
   202→        directWrites.set(rootName, content === null ? "deleted" : "file");
   203→      } else if (content !== null) {
   204→        inferredDirectories.add(rootName);
   205→      }
   206→    }
   207→
   208→    // A direct delete always wins over inferred directory presence.
   209→    for (const [name, state] of directWrites) {
   210→      if (state === "deleted") {
   211→        inferredDirectories.delete(name);
   212→      }
   213→    }
   214→
   215→    return { directWrites, inferredDirectories };
   216→  }
   217→
   218→  /**
   219→   * List a directory with buffered entries overlaid on disk entries.
   220→   * Used to keep batch read-after-write semantics for readdir callers.
   221→   */
   222→  async listDir(
   223→    directory: string,
   224→    options?: { withFileTypes?: boolean },
   225→  ): Promise<string[] | Dirent[]> {
   226→    const resolvedDir = path.resolve(directory);
   227→    const withFileTypes = options?.withFileTypes === true;
   228→    if (this.isDeletedInOverlay(resolvedDir)) {
   229→      throw createNotFoundError(resolvedDir);
   230→    }
   231→
   232→    let diskEntries: Dirent[] = [];
   233→    let diskMissing = false;
   234→    try {
   235→      diskEntries = await fs.readdir(resolvedDir, { withFileTypes: true });
   236→    } catch (err) {
   237→      if (!isNotFoundError(err)) {
   238→        throw err;
   239→      }
   240→      diskMissing = true;
   241→    }
   242→
   243→    const diskDirentsByName = new Map<string, Dirent>();
   244→    const mergedKinds = new Map<string, OverlayEntryKind>();
   245→    for (const entry of diskEntries) {
   246→      diskDirentsByName.set(entry.name, entry);
   247→      mergedKinds.set(entry.name, entry.isDirectory() ? "directory" : "file");
   248→    }
   249→
   250→    const overlay = this._buildDirectoryOverlay(resolvedDir);
   251→
   252→    for (const [name, state] of overlay.directWrites) {
   253→      if (state === "deleted") {
   254→        mergedKinds.delete(name);
   255→      } else {
   256→        mergedKinds.set(name, "file");
   257→      }
   258→    }
   259→
   260→    for (const name of overlay.inferredDirectories) {
   261→      mergedKinds.set(name, "directory");
   262→    }
   263→
   264→    if (diskMissing && mergedKinds.size === 0) {
   265→      throw createNotFoundError(resolvedDir);
   266→    }
   267→
   268→    const names = [...mergedKinds.keys()].sort((a, b) => a.localeCompare(b));
   269→    if (!withFileTypes) {
   270→      return names;
   271→    }
   272→
   273→    return names.map((name) => {
   274→      const mergedKind = mergedKinds.get(name);
   275→      const diskDirent = diskDirentsByName.get(name);
   276→      if (
   277→        mergedKind &&
   278→        diskDirent &&
   279→        ((mergedKind === "directory" && diskDirent.isDirectory()) ||
   280→          (mergedKind === "file" && diskDirent.isFile()))
   281→      ) {
   282→        return diskDirent;
   283→      }
   284→      return new SyntheticDirent(name, mergedKind === "file") as unknown as Dirent;
   285→    });
   286→  }
   287→
   288→  /**
   289→   * Flush all buffered writes to disk.
   290→   *
   291→   * Strategy for ac-7 (flush failure atomicity):
   292→   * 1. Write all buffered content to staging files (.kspec-batch-staging suffix)
   293→   * 2. If any staging write fails: delete all staging files, throw — nothing committed
   294→   * 3. Rename all staging files to final paths
   295→   * 4. If any rename fails: report error with committed/uncommitted file list
   296→   *
   297→   * Phase 1 is fully atomic: a staging write failure means no files reach disk.
   298→   * Phase 2 is best-effort: rename failures are reported with a detailed error, but
   299→   * files already renamed in Phase 2 before the failure are committed. On healthy
   300→   * filesystems, Phase 2 rename failures are extremely rare (same-device, same-dir
   301→   * renames are near-atomic). Partial Phase 2 failure is always an explicit error,
   302→   * never a silent commit.
   303→   *
   304→   * AC: @batch-write-buffer ac-3 — only buffered files are written
   305→   * AC: @batch-write-buffer ac-7 — flush failure reported; .kspec/ not silently corrupted
   306→   */
   307→  async flush(): Promise<void> {
   308→    if (this.entries.size === 0) return;
   309→
   310→    const stagingMap = new Map<string, string>(); // real path → staging path
   311→
   312→    // Phase 1: Write all entries to staging files
   313→    try {
   314→      for (const [filePath, content] of this.entries) {
   315→        if (content === null) {
   316→          // Deletions: record for phase 2 but no staging file needed
   317→          stagingMap.set(filePath, "");
   318→          continue;
   319→        }
   320→        const stagingPath = `${filePath}.kspec-batch-staging`;
   321→        await fs.mkdir(path.dirname(filePath), { recursive: true });
   322→        await fs.writeFile(stagingPath, content, "utf-8");
   323→        stagingMap.set(filePath, stagingPath);
   324→      }
   325→    } catch (err) {
   326→      // Staging failed — clean up staging files, nothing committed
   327→      await this._cleanupStaging(stagingMap);
   328→      throw new Error(
   329→        `Batch flush staging failed: ${err instanceof Error ? err.message : err}. No files were committed.`,
   330→      );
   331→    }
   332→
   333→    // Phase 2: Rename staging files to real paths (atomic per-file)
   334→    const committed: string[] = [];
   335→    const uncommitted: string[] = [];
   336→
   337→    for (const [filePath, stagingPath] of stagingMap) {
   338→      const content = this.entries.get(filePath);
   339→      try {
   340→        if (content === null) {
   341→          // Delete the real file
   342→          await fs.rm(filePath, { force: true });
   343→        } else {
   344→          // Rename staging → real (atomic)
   345→          await fs.rename(stagingPath, filePath);
   346→        }
   347→        committed.push(filePath);
   348→      } catch (err) {
   349→        // Rename/delete failed — track uncommitted
   350→        uncommitted.push(filePath);
   351→        // Clean up remaining staging files
   352→        for (const [remainingPath, remainingStagingPath] of stagingMap) {
   353→          if (!committed.includes(remainingPath) && remainingStagingPath) {
   354→            await fs.rm(remainingStagingPath, { force: true }).catch(() => {});
   355→          }
   356→        }
   357→        throw new Error(
   358→          `Batch flush commit failed: ${err instanceof Error ? err.message : err}.\n` +
   359→            `Committed (${committed.length}): ${committed.join(", ") || "none"}\n` +
   360→            `Uncommitted (${uncommitted.length + (stagingMap.size - committed.length - 1)}): remaining files`,
   361→        );
   362→      }
   363→    }
   364→  }
   365→
   366→  /**
   367→   * Discard the buffer without writing anything to disk.
   368→   * AC: @batch-write-buffer ac-4
   369→   */
   370→  discard(): void {
   371→    this.entries.clear();
   372→  }
   373→
   374→  private async _cleanupStaging(stagingMap: Map<string, string>): Promise<void> {
   375→    for (const [, stagingPath] of stagingMap) {
   376→      if (stagingPath) {
   377→        await fs.rm(stagingPath, { force: true }).catch(() => {});
   378→      }
   379→    }
   380→  }
   381→}
   382→
   383→// ── Module Singleton ─────────────────────────────────────────────────────────
   384→
   385→let _activeBuffer: WriteBuffer | null = null;
   386→
   387→/**
   388→ * Activate an in-memory write buffer for the given specDir.
   389→ * All subsequent writes to paths under specDir will go to the buffer.
   390→ * AC: @batch-write-buffer ac-1
   391→ */
   392→export function activateBatchBuffer(specDir: string): WriteBuffer {
   393→  _activeBuffer = new WriteBuffer(specDir);
   394→  return _activeBuffer;
   395→}
   396→
   397→/**
   398→ * Deactivate the active buffer (after flush or discard).
   399→ */
   400→export function deactivateBatchBuffer(): void {
   401→  _activeBuffer = null;
   402→}
   403→
   404→/**
   405→ * Get the currently active write buffer, or null if not in batch mode.
   406→ */
   407→export function getActiveBatchBuffer(): WriteBuffer | null {
   408→  return _activeBuffer;
   409→}
   410→
   411→export async function readdirBufferAware(
   412→  directory: string,
   413→  options?: { withFileTypes?: boolean },
   414→): Promise<string[] | Dirent[]> {
   415→  const buffer = getActiveBatchBuffer();
   416→  if (buffer?.isInScope(directory)) {
   417→    return buffer.listDir(directory, options);
   418→  }
   419→
   420→  if (options?.withFileTypes) {
   421→    return fs.readdir(directory, { withFileTypes: true });
   422→  }
   423→  return fs.readdir(directory);
   424→}
   425→
   426→export async function accessBufferAware(
   427→  filePath: string,
   428→  mode?: number,
   429→): Promise<void> {
   430→  const buffer = getActiveBatchBuffer();
   431→  if (buffer?.isInScope(filePath)) {
   432→    if (buffer.isDeletedInOverlay(filePath)) {
   433→      throw createNotFoundError(filePath);
   434→    }
   435→
   436→    const buffered = buffer.read(filePath);
   437→    if (buffered === null) {
   438→      throw createNotFoundError(filePath);
   439→    }
   440→    if (buffered !== undefined) {
   441→      return;
   442→    }
   443→
   444→    const resolved = path.resolve(filePath);
   445→    const prefix = `${resolved}${path.sep}`;
   446→    for (const bufferedPath of buffer.getPaths()) {
   447→      if (bufferedPath.startsWith(prefix) && buffer.read(bufferedPath) !== null) {
   448→        return;
   449→      }
   450→    }
   451→  }
   452→
   453→  await fs.access(filePath, mode);
   454→}
   455→
   456→export async function writeFileBufferAware(
   457→  filePath: string,
   458→  content: BufferedFileContent,
   459→): Promise<void> {
   460→  const buffer = getActiveBatchBuffer();
   461→  if (buffer?.isInScope(filePath)) {
   462→    buffer.write(filePath, content);
   463→    return;
   464→  }
   465→
   466→  await fs.mkdir(path.dirname(filePath), { recursive: true });
   467→  if (typeof content === "string") {
   468→    await fs.writeFile(filePath, content, "utf-8");
   469→  } else {
   470→    await fs.writeFile(filePath, content);
   471→  }
   472→}
   473→
   474→export async function mkdirBufferAware(directoryPath: string): Promise<void> {
   475→  const buffer = getActiveBatchBuffer();
   476→  if (buffer?.isInScope(directoryPath)) {
   477→    return;
   478→  }
   479→
   480→  await fs.mkdir(directoryPath, { recursive: true });
   481→}
   482→
```