```
     1→<!--
     2→  AC: @ui-inbox-enhanced ac-1 — Each item shows triage status inline with quick triage action links.
     3→  AC: @ui-inbox-enhanced ac-2 — Filters by status, tags, age.
     4→-->
     5→<script lang="ts">
     6→	// AC: @multi-directory-daemon ac-27 - Reload on project change
     7→	// AC: @gh-pages-export ac-17 - Hide Add button in static mode
     8→	import { onMount, onDestroy } from 'svelte';
     9→	import { goto } from '$app/navigation';
    10→	import { base } from '$app/paths';
    11→	import { page } from '$app/stores';
    12→	import type { InboxItem, BroadcastEvent } from '@kynetic-ai/shared';
    13→	import type { TriageRecord } from '$lib/types/triage';
    14→	import {
    15→		fetchInbox,
    16→		addInboxItem,
    17→		deleteInboxItem,
    18→		fetchTriageRecords
    19→	} from '$lib/api';
    20→	import { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';
    21→	import { subscribe, unsubscribe, on, off } from '$lib/stores/connection.svelte';
    22→	import { Button } from '$lib/components/ui/button';
    23→	import { Input } from '$lib/components/ui/input';
    24→	import { Card, CardContent, CardHeader } from '$lib/components/ui/card';
    25→	import { Badge } from '$lib/components/ui/badge';
    26→	import {
    27→		Dialog,
    28→		DialogContent,
    29→		DialogDescription,
    30→		DialogFooter,
    31→		DialogHeader,
    32→		DialogTitle
    33→	} from '$lib/components/ui/dialog';
    34→	import { getProjectVersion } from '$lib/stores/project.svelte';
    35→	import Inbox from '@lucide/svelte/icons/inbox';
    36→
    37→	// ── Data state ──
    38→	let inboxItems = $state<InboxItem[]>([]);
    39→	let triageRecords = $state<TriageRecord[]>([]);
    40→	let loading = $state(true);
    41→	let error = $state('');
    42→
    43→	// ── Add item state ──
    44→	let showAddInput = $state(false);
    45→	let newItemText = $state('');
    46→	let addingItem = $state(false);
    47→
    48→	// ── Delete state ──
    49→	let deleteConfirmOpen = $state(false);
    50→	let itemToDelete = $state<InboxItem | null>(null);
    51→	let deletingItem = $state(false);
    52→
    53→	// ── Triage status labels and colors ──
    54→	const TRIAGE_STATUS_LABELS: Record<string, string> = {
    55→		untriaged: 'Untriaged',
    56→		triaged: 'Triaged',
    57→		acted_on: 'Acted On'
    58→	};
    59→
    60→	const TRIAGE_STATUS_COLORS: Record<string, string> = {
    61→		untriaged: 'bg-status-pending text-status-pending-fg',
    62→		triaged: 'bg-status-pending-review text-status-pending-review-fg',
    63→		acted_on: 'bg-status-completed text-status-completed-fg'
    64→	};
    65→
    66→	// ── Filter state ──
    67→	// AC: @ui-inbox-enhanced ac-2
    68→	type TriageFilterStatus = 'all' | 'untriaged' | 'triaged' | 'acted_on';
    69→	const TRIAGE_STATUS_VALUES: readonly TriageFilterStatus[] = ['all', 'untriaged', 'triaged', 'acted_on'];
    70→
    71→	let filterStatus = $derived.by((): TriageFilterStatus => {
    72→		const raw = $page.url.searchParams.get('status');
    73→		if (raw && TRIAGE_STATUS_VALUES.includes(raw as TriageFilterStatus)) {
    74→			return raw as TriageFilterStatus;
    75→		}
    76→		return 'all';
    77→	});
    78→	let filterTag = $derived($page.url.searchParams.get('tag') || '');
    79→	let filterAge = $derived($page.url.searchParams.get('age') || '');
    80→
    81→	// ── Merged inbox + triage view ──
    82→	interface InboxCardItem {
    83→		inbox: InboxItem;
    84→		record: TriageRecord | null;
    85→		triageStatus: string;
    86→	}
    87→
    88→	// AC: @ui-inbox-enhanced ac-1 — Merge inbox items with triage records
    89→	let allItems = $derived.by(() => {
    90→		return inboxItems.map((inbox) => {
    91→			const record = triageRecords.find((r) => r.inbox_ref === inbox._ulid) ?? null;
    92→			const triageStatus = record
    93→				? record.status === 'pending'
    94→					? 'untriaged'
    95→					: record.status
    96→				: 'untriaged';
    97→			return { inbox, record, triageStatus };
    98→		});
    99→	});
   100→
   101→	// AC: @ui-inbox-enhanced ac-2 — Filtered items
   102→	let filteredItems = $derived.by(() => {
   103→		let items = allItems;
   104→
   105→		// Status filter
   106→		if (filterStatus === 'untriaged') {
   107→			items = items.filter((i) => i.triageStatus === 'untriaged');
   108→		} else if (filterStatus === 'triaged') {
   109→			items = items.filter((i) => i.triageStatus === 'triaged');
   110→		} else if (filterStatus === 'acted_on') {
   111→			items = items.filter((i) => i.triageStatus === 'acted_on');
   112→		}
   113→
   114→		// Tag filter
   115→		if (filterTag) {
   116→			items = items.filter((i) => i.inbox.tags.includes(filterTag));
   117→		}
   118→
   119→		// Age filter
   120→		if (filterAge) {
   121→			const now = Date.now();
   122→			const cutoffs: Record<string, number> = {
   123→				'1d': 86400000,
   124→				'7d': 604800000,
   125→				'30d': 2592000000
   126→			};
   127→			const cutoff = cutoffs[filterAge];
   128→			if (cutoff) {
   129→				items = items.filter((i) => now - new Date(i.inbox.created_at).getTime() <= cutoff);
   130→			}
   131→		}
   132→
   133→		return items;
   134→	});
   135→
   136→	// All unique tags across inbox items
   137→	let allTags = $derived.by(() => {
   138→		const tagSet = new Set<string>();
   139→		inboxItems.forEach((item) => item.tags.forEach((t) => tagSet.add(t)));
   140→		return Array.from(tagSet).sort();
   141→	});
   142→
   143→	// Counts for status summary
   144→	let untriagedCount = $derived(allItems.filter((i) => i.triageStatus === 'untriaged').length);
   145→	let triagedCount = $derived(allItems.filter((i) => i.triageStatus === 'triaged').length);
   146→	let actedCount = $derived(allItems.filter((i) => i.triageStatus === 'acted_on').length);
   147→
   148→	// ── Lifecycle ──
   149→	onMount(async () => {
   150→		await loadData();
   151→
   152→		// Subscribe to real-time updates
   153→		if (!isStaticMode()) {
   154→			subscribe(['inbox:updates', 'triage:updates']);
   155→			on('inbox:updates', handleInboxUpdate);
   156→			on('triage:updates', handleTriageUpdate);
   157→		}
   158→	});
   159→
   160→	onDestroy(() => {
   161→		if (!isStaticMode()) {
   162→			off('inbox:updates', handleInboxUpdate);
   163→			off('triage:updates', handleTriageUpdate);
   164→			unsubscribe(['inbox:updates', 'triage:updates']);
   165→		}
   166→	});
   167→
   168→	// AC: @multi-directory-daemon ac-27 - Reload data when project changes
   169→	$effect(() => {
   170→		const version = getProjectVersion();
   171→		if (version > 0) {
   172→			loadData();
   173→		}
   174→	});
   175→
   176→	// ── Data loading ──
   177→	async function loadData() {
   178→		try {
   179→			loading = true;
   180→			error = '';
   181→			const inboxResponse = await fetchInbox({ limit: 1000 });
   182→			inboxItems = inboxResponse.items;
   183→
   184→			// Load triage records separately — if triage fails, inbox still shows
   185→			try {
   186→				const triageResponse = await fetchTriageRecords({ limit: 1000 });
   187→				triageRecords = triageResponse.items;
   188→			} catch {
   189→				triageRecords = [];
   190→			}
   191→		} catch (err) {
   192→			error = err instanceof Error ? err.message : 'Failed to load inbox';
   193→		} finally {
   194→			loading = false;
   195→		}
   196→	}
   197→
   198→	// ── WebSocket handlers ──
   199→	function handleInboxUpdate(_event: BroadcastEvent) {
   200→		loadData();
   201→	}
   202→
   203→	function handleTriageUpdate(_event: BroadcastEvent) {
   204→		loadTriageData();
   205→	}
   206→
   207→	async function loadTriageData() {
   208→		try {
   209→			const triageResponse = await fetchTriageRecords({ limit: 1000 });
   210→			triageRecords = triageResponse.items;
   211→		} catch (err) {
   212→			console.error('Failed to reload triage records:', err);
   213→		}
   214→	}
   215→
   216→	// ── Filter URL management ──
   217→	function updateFilterParam(key: 'status' | 'tag' | 'age', value: string) {
   218→		const params = new URLSearchParams($page.url.searchParams);
   219→
   220→		if (!value || value === 'all') {
   221→			params.delete(key);
   222→		} else {
   223→			params.set(key, value);
   224→		}
   225→
   226→		const query = params.toString();
   227→		const nextUrl = query ? `${base}/inbox?${query}` : `${base}/inbox`;
   228→		goto(nextUrl, { replaceState: false, keepFocus: true, noScroll: true });
   229→	}
   230→
   231→	// ── Add item ──
   232→	async function handleAddItem() {
   233→		if (!newItemText.trim()) return;
   234→
   235→		if (isStaticMode()) {
   236→			error = 'Cannot add items in read-only mode. Use the kspec CLI.';
   237→			return;
   238→		}
   239→
   240→		try {
   241→			addingItem = true;
   242→			error = '';
   243→			const newItem = await addInboxItem(newItemText.trim());
   244→			inboxItems = [newItem, ...inboxItems];
   245→			newItemText = '';
   246→			showAddInput = false;
   247→		} catch (err) {
   248→			if (err instanceof ReadOnlyModeError) {
   249→				error = err.message;
   250→			} else {
   251→				error = err instanceof Error ? err.message : 'Failed to add item';
   252→			}
   253→		} finally {
   254→			addingItem = false;
   255→		}
   256→	}
   257→
   258→	function handleKeydown(event: KeyboardEvent) {
   259→		if (event.key === 'Enter' && !event.shiftKey) {
   260→			event.preventDefault();
   261→			handleAddItem();
   262→		}
   263→	}
   264→
   265→	// ── Delete item ──
   266→	function confirmDelete(item: InboxItem) {
   267→		itemToDelete = item;
   268→		deleteConfirmOpen = true;
   269→	}
   270→
   271→	async function handleDelete() {
   272→		if (!itemToDelete) return;
   273→
   274→		if (isStaticMode()) {
   275→			error = 'Cannot delete items in read-only mode. Use the kspec CLI.';
   276→			deleteConfirmOpen = false;
   277→			itemToDelete = null;
   278→			return;
   279→		}
   280→
   281→		try {
   282→			deletingItem = true;
   283→			error = '';
   284→			await deleteInboxItem(itemToDelete._ulid);
   285→			inboxItems = inboxItems.filter((i) => i._ulid !== itemToDelete!._ulid);
   286→			deleteConfirmOpen = false;
   287→			itemToDelete = null;
   288→		} catch (err) {
   289→			if (err instanceof ReadOnlyModeError) {
   290→				error = err.message;
   291→			} else {
   292→				error = err instanceof Error ? err.message : 'Failed to delete item';
   293→			}
   294→		} finally {
   295→			deletingItem = false;
   296→		}
   297→	}
   298→
   299→	// ── Formatting ──
   300→	function formatDate(dateString: string): string {
   301→		const date = new Date(dateString);
   302→		const now = new Date();
   303→		const diffMs = now.getTime() - date.getTime();
   304→		const diffMins = Math.floor(diffMs / 60000);
   305→		const diffHours = Math.floor(diffMs / 3600000);
   306→		const diffDays = Math.floor(diffMs / 86400000);
   307→
   308→		if (diffMins < 1) return 'just now';
   309→		if (diffMins < 60) return `${diffMins}m ago`;
   310→		if (diffHours < 24) return `${diffHours}h ago`;
   311→		if (diffDays < 7) return `${diffDays}d ago`;
   312→
   313→		return date.toLocaleDateString();
   314→	}
   315→
   316→	function getTriageStatusLabel(item: InboxCardItem): string {
   317→		return TRIAGE_STATUS_LABELS[item.triageStatus] || 'Untriaged';
   318→	}
   319→
   320→	function getTriageStatusColor(item: InboxCardItem): string {
   321→		return TRIAGE_STATUS_COLORS[item.triageStatus] || TRIAGE_STATUS_COLORS.untriaged;
   322→	}
   323→</script>
   324→
   325→<div class="flex flex-col gap-4 p-6">
   326→	<!-- Header -->
   327→	<div class="flex items-center justify-between">
   328→		<div>
   329→			<h1 class="text-2xl font-bold">Inbox</h1>
   330→			{#if !loading}
   331→				<p class="text-sm text-muted-foreground" data-testid="inbox-summary">
   332→					{allItems.length} item{allItems.length === 1 ? '' : 's'}
   333→					&middot; {untriagedCount} untriaged, {triagedCount} triaged, {actedCount} acted on
   334→					{#if filteredItems.length !== allItems.length}
   335→						&middot; Showing {filteredItems.length} filtered
   336→					{/if}
   337→				</p>
   338→			{/if}
   339→		</div>
   340→		{#if !isStaticMode()}
   341→			<Button
   342→				data-testid="add-inbox-button"
   343→				onclick={() => (showAddInput = !showAddInput)}
   344→				variant={showAddInput ? 'secondary' : 'default'}
   345→			>
   346→				{showAddInput ? 'Cancel' : 'Add Item'}
   347→			</Button>
   348→		{/if}
   349→	</div>
   350→
   351→	<!-- AC: @ui-inbox-enhanced ac-2 — Filter controls -->
   352→	<div class="flex flex-wrap gap-2 items-center" data-testid="inbox-filters">
   353→		<select
   354→			value={filterStatus}
   355→			onchange={(event) => updateFilterParam('status', (event.currentTarget as HTMLSelectElement).value)}
   356→			class="rounded-md border bg-background px-3 py-1.5 text-sm"
   357→			data-testid="inbox-status-filter"
   358→		>
   359→			<option value="all">All Status</option>
   360→			<option value="untriaged">Untriaged</option>
   361→			<option value="triaged">Triaged</option>
   362→			<option value="acted_on">Acted On</option>
   363→		</select>
   364→
   365→		{#if allTags.length > 0}
   366→			<select
   367→				value={filterTag}
   368→				onchange={(event) => updateFilterParam('tag', (event.currentTarget as HTMLSelectElement).value)}
   369→				class="rounded-md border bg-background px-3 py-1.5 text-sm"
   370→				data-testid="inbox-tag-filter"
   371→			>
   372→				<option value="">All Tags</option>
   373→				{#each allTags as tag}
   374→					<option value={tag}>{tag}</option>
   375→				{/each}
   376→			</select>
   377→		{/if}
   378→
   379→		<select
   380→			value={filterAge}
   381→			onchange={(event) => updateFilterParam('age', (event.currentTarget as HTMLSelectElement).value)}
   382→			class="rounded-md border bg-background px-3 py-1.5 text-sm"
   383→			data-testid="inbox-age-filter"
   384→		>
   385→			<option value="">Any Age</option>
   386→			<option value="1d">Last 24 hours</option>
   387→			<option value="7d">Last 7 days</option>
   388→			<option value="30d">Last 30 days</option>
   389→		</select>
   390→	</div>
   391→
   392→	{#if error}
   393→		<div class="bg-destructive/10 text-destructive p-4 rounded-lg text-sm" data-testid="error-message" role="alert">
   394→			{error}
   395→		</div>
   396→	{/if}
   397→
   398→	<!-- Add input field -->
   399→	{#if showAddInput}
   400→		<Card data-testid="inbox-add-form">
   401→			<CardContent class="pt-6">
   402→				<div class="flex gap-2">
   403→					<Input
   404→						data-testid="inbox-input"
   405→						bind:value={newItemText}
   406→						placeholder="Enter inbox item text (press Enter to submit)"
   407→						onkeydown={handleKeydown}
   408→						disabled={addingItem}
   409→						class="flex-1"
   410→					/>
   411→					<Button data-testid="inbox-submit" onclick={handleAddItem} disabled={addingItem || !newItemText.trim()}>
   412→						{addingItem ? 'Adding...' : 'Add'}
   413→					</Button>
   414→				</div>
   415→			</CardContent>
   416→		</Card>
   417→	{/if}
   418→
   419→	<!-- Inbox list -->
   420→	{#if loading}
   421→		<div class="space-y-2" data-testid="inbox-loading">
   422→			{#each Array(5) as _}
   423→				<div class="h-20 rounded-lg bg-muted ds-shimmer"></div>
   424→			{/each}
   425→		</div>
   426→	{:else if filteredItems.length === 0}
   427→		<div class="flex flex-col items-center justify-center py-16" data-testid="inbox-empty">
   428→			<Inbox class="size-12 text-muted-foreground/30 mb-4" />
   429→			{#if allItems.length === 0}
   430→				<h2 class="text-lg font-medium text-muted-foreground mb-1">No inbox items</h2>
   431→				<p class="text-sm text-muted-foreground">
   432→					{#if isStaticMode()}
   433→						No inbox items in the snapshot.
   434→					{:else}
   435→						Click "Add Item" to capture ideas and thoughts.
   436→					{/if}
   437→				</p>
   438→			{:else}
   439→				<h2 class="text-lg font-medium text-muted-foreground mb-1">No matching items</h2>
   440→				<p class="text-sm text-muted-foreground">Try adjusting the filters above.</p>
   441→			{/if}
   442→		</div>
   443→	{:else}
   444→		<div class="flex flex-col gap-3" data-testid="inbox-list">
   445→			{#each filteredItems as item (item.inbox._ulid)}
   446→				<!-- AC: @ui-inbox-enhanced ac-1 — Item with triage status inline -->
   447→				<Card class="transition-all duration-200 hover:shadow-md" data-testid="inbox-item">
   448→					<CardHeader class="pb-3">
   449→						<div class="flex items-start justify-between gap-4">
   450→							<div class="flex-1 min-w-0">
   451→								<div class="flex items-center gap-2 mb-1">
   452→									<!-- AC: @ui-inbox-enhanced ac-1 — Triage status badge -->
   453→									<Badge
   454→										class={getTriageStatusColor(item)}
   455→										data-testid="inbox-triage-status"
   456→									>
   457→										{getTriageStatusLabel(item)}
   458→									</Badge>
   459→									{#if item.record?.action}
   460→										<span class="text-xs text-muted-foreground" data-testid="inbox-triage-action">
   461→											{item.record.action}
   462→										</span>
   463→									{/if}
   464→								</div>
   465→								<p class="text-sm leading-relaxed" data-testid="inbox-text">{item.inbox.text}</p>
   466→							</div>
   467→							<div class="flex items-center gap-1 flex-shrink-0">
   468→								<!-- AC: @ui-inbox-enhanced ac-1 — Quick triage action link -->
   469→								{#if !isStaticMode() && item.triageStatus === 'untriaged'}
   470→									<Button
   471→										variant="ghost"
   472→										size="sm"
   473→										href="{base}/triage?status=untriaged"
   474→										data-testid="inbox-triage-link"
   475→										class="text-xs"
   476→									>
   477→										Triage
   478→									</Button>
   479→								{/if}
   480→								{#if !isStaticMode()}
   481→									<Button
   482→										data-testid="delete-inbox-button"
   483→										variant="ghost"
   484→										size="sm"
   485→										onclick={() => confirmDelete(item.inbox)}
   486→										class="text-destructive hover:text-destructive hover:bg-destructive/10"
   487→									>
   488→										Delete
   489→									</Button>
   490→								{/if}
   491→							</div>
   492→						</div>
   493→					</CardHeader>
   494→					<CardContent class="pt-0">
   495→						<div class="flex items-center gap-2 text-xs text-muted-foreground">
   496→							<span data-testid="inbox-created-at">{formatDate(item.inbox.created_at)}</span>
   497→							<span>&middot;</span>
   498→							<span data-testid="inbox-added-by">{item.inbox.added_by}</span>
   499→							{#if item.inbox.tags.length > 0}
   500→								<span>&middot;</span>
   501→								<div class="flex gap-1" data-testid="inbox-tags">
   502→									{#each item.inbox.tags as tag}
   503→										<Badge variant="secondary" class="text-xs">{tag}</Badge>
   504→									{/each}
   505→								</div>
   506→							{/if}
   507→						</div>
   508→					</CardContent>
   509→				</Card>
   510→			{/each}
   511→		</div>
   512→	{/if}
   513→</div>
   514→
   515→<!-- Delete confirmation dialog -->
   516→<Dialog bind:open={deleteConfirmOpen}>
   517→	<DialogContent data-testid="confirm-delete-dialog">
   518→		<DialogHeader>
   519→			<DialogTitle>Delete Inbox Item?</DialogTitle>
   520→			<DialogDescription>
   521→				Are you sure you want to delete this inbox item? This action cannot be undone.
   522→			</DialogDescription>
   523→		</DialogHeader>
   524→		{#if itemToDelete}
   525→			<div class="rounded-md bg-muted p-3 text-sm">
   526→				{itemToDelete.text}
   527→			</div>
   528→		{/if}
   529→		<DialogFooter>
   530→			<Button data-testid="confirm-delete-no" variant="outline" onclick={() => (deleteConfirmOpen = false)} disabled={deletingItem}>
   531→				Cancel
   532→			</Button>
   533→			<Button data-testid="confirm-delete-yes" variant="destructive" onclick={handleDelete} disabled={deletingItem}>
   534→				{deletingItem ? 'Deleting...' : 'Delete'}
   535→			</Button>
   536→		</DialogFooter>
   537→	</DialogContent>
   538→</Dialog>
