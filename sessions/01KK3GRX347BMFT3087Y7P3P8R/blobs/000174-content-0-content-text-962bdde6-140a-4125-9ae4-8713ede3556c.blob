```
     1→<script lang="ts">
     2→	// AC: @interactive-triage-ui ac-1, ac-2, ac-3, ac-4, ac-5, ac-6, ac-7, ac-8
     3→	// AC: @trait-websocket-protocol ac-1, ac-2, ac-3
     4→	import { onMount, onDestroy } from 'svelte';
     5→	import { goto } from '$app/navigation';
     6→	import { base } from '$app/paths';
     7→	import { page } from '$app/stores';
     8→	import type { InboxItem, BroadcastEvent } from '@kynetic-ai/shared';
     9→	import type { TriageRecord, TriageAction } from '$lib/types/triage';
    10→	import {
    11→		fetchInbox,
    12→		fetchTriageRecords,
    13→		createTriageRecord,
    14→		overrideTriageRecord,
    15→		actOnTriageRecord
    16→	} from '$lib/api';
    17→	import { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';
    18→	import { subscribe, unsubscribe, on, off } from '$lib/stores/connection.svelte';
    19→	import { getProjectVersion } from '$lib/stores/project.svelte';
    20→	import { Button } from '$lib/components/ui/button';
    21→	import { Card, CardContent, CardHeader, CardTitle } from '$lib/components/ui/card';
    22→	import { Badge } from '$lib/components/ui/badge';
    23→	import { Textarea } from '$lib/components/ui/textarea';
    24→	import { Separator } from '$lib/components/ui/separator';
    25→	import ChevronLeftIcon from '@lucide/svelte/icons/chevron-left';
    26→	import ChevronRightIcon from '@lucide/svelte/icons/chevron-right';
    27→
    28→	// Data state
    29→	let inboxItems = $state<InboxItem[]>([]);
    30→	let triageRecords = $state<TriageRecord[]>([]);
    31→	let loading = $state(true);
    32→	let error = $state('');
    33→
    34→	// Card navigation state
    35→	// AC: @interactive-triage-ui ac-5
    36→	let currentIndex = $state(0);
    37→	let submitting = $state(false);
    38→
    39→	// Form state
    40→	// AC: @interactive-triage-ui ac-3
    41→	let selectedAction = $state<TriageAction | ''>('');
    42→	let reasoning = $state('');
    43→
    44→	// Action labels
    45→	const ACTION_LABELS: Record<TriageAction, string> = {
    46→		promote: 'Promote to Task',
    47→		delete: 'Delete',
    48→		defer: 'Defer',
    49→		'spec-gap': 'Spec Gap',
    50→		duplicate: 'Duplicate'
    51→	};
    52→
    53→	const ACTION_COLORS: Record<TriageAction, string> = {
    54→		promote: 'bg-green-500',
    55→		delete: 'bg-red-500',
    56→		defer: 'bg-yellow-500',
    57→		'spec-gap': 'bg-purple-500',
    58→		duplicate: 'bg-gray-500'
    59→	};
    60→
    61→	type TriageFilterStatus = 'all' | 'untriaged' | 'triaged' | 'acted_on';
    62→	const TRIAGE_STATUS_VALUES: readonly TriageFilterStatus[] = ['all', 'untriaged', 'triaged', 'acted_on'];
    63→	const TRIAGE_ACTION_VALUES = Object.keys(ACTION_LABELS) as TriageAction[];
    64→
    65→	// Filter state — derived from URL params (single source of truth)
    66→	// AC: @interactive-triage-ui ac-7
    67→	let filterTag = $derived($page.url.searchParams.get('tag') || '');
    68→	let filterStatus = $derived.by((): TriageFilterStatus => {
    69→		const raw = $page.url.searchParams.get('status');
    70→		if (raw && TRIAGE_STATUS_VALUES.includes(raw as TriageFilterStatus)) {
    71→			return raw as TriageFilterStatus;
    72→		}
    73→		return 'all';
    74→	});
    75→	let filterAction = $derived.by((): TriageAction | '' => {
    76→		const raw = $page.url.searchParams.get('action');
    77→		if (raw && TRIAGE_ACTION_VALUES.includes(raw as TriageAction)) {
    78→			return raw as TriageAction;
    79→		}
    80→		return '';
    81→	});
    82→
    83→	// Merged view: inbox items with their triage records
    84→	interface TriageCardItem {
    85→		inbox: InboxItem;
    86→		record: TriageRecord | null;
    87→	}
    88→
    89→	// AC: @interactive-triage-ui ac-7 - Filtered items
    90→	let allItems = $derived.by(() => {
    91→		const items: TriageCardItem[] = inboxItems.map((inbox) => {
    92→			const record = triageRecords.find((r) => r.inbox_ref === inbox._ulid) ?? null;
    93→			return { inbox, record };
    94→		});
    95→		return items;
    96→	});
    97→
    98→	let filteredItems = $derived.by(() => {
    99→		let items = allItems;
   100→
   101→		// Tag filter
   102→		if (filterTag) {
   103→			items = items.filter((i) => i.inbox.tags.includes(filterTag));
   104→		}
   105→
   106→		// Status filter
   107→		if (filterStatus === 'untriaged') {
   108→			items = items.filter((i) => !i.record || i.record.status === 'pending');
   109→		} else if (filterStatus === 'triaged') {
   110→			items = items.filter((i) => i.record?.status === 'triaged');
   111→		} else if (filterStatus === 'acted_on') {
   112→			items = items.filter((i) => i.record?.status === 'acted_on');
   113→		}
   114→
   115→		// Action filter
   116→		if (filterAction) {
   117→			items = items.filter((i) => i.record?.action === filterAction);
   118→		}
   119→
   120→		return items;
   121→	});
   122→
   123→	let currentItem = $derived(filteredItems[currentIndex] ?? null);
   124→
   125→	// AC: @interactive-triage-ui ac-7 - Progress count
   126→	let triagedCount = $derived(allItems.filter((i) => i.record && i.record.status !== 'pending').length);
   127→	let totalCount = $derived(allItems.length);
   128→
   129→	// All unique tags for filter
   130→	let allTags = $derived.by(() => {
   131→		const tagSet = new Set<string>();
   132→		inboxItems.forEach((item) => item.tags.forEach((t) => tagSet.add(t)));
   133→		return Array.from(tagSet).sort();
   134→	});
   135→
   136→	onMount(async () => {
   137→		await loadData();
   138→
   139→		// AC: @interactive-triage-ui ac-6 - Subscribe to triage:updates
   140→		// AC: @trait-websocket-protocol ac-2 - Subscribe to topic
   141→		if (!isStaticMode()) {
   142→			subscribe(['triage:updates']);
   143→			on('triage:updates', handleTriageUpdate);
   144→		}
   145→	});
   146→
   147→	onDestroy(() => {
   148→		if (!isStaticMode()) {
   149→			off('triage:updates', handleTriageUpdate);
   150→			unsubscribe(['triage:updates']);
   151→		}
   152→	});
   153→
   154→	// AC: @multi-directory-daemon ac-27 - Reload on project change
   155→	$effect(() => {
   156→		const version = getProjectVersion();
   157→		if (version > 0) {
   158→			loadData();
   159→		}
   160→	});
   161→
   162→	// AC: @interactive-triage-ui ac-6 - Real-time update handler
   163→	// AC: @trait-websocket-protocol ac-3 - Handle broadcast event
   164→	function handleTriageUpdate(_event: BroadcastEvent) {
   165→		// Reload triage records on any triage update
   166→		loadTriageData();
   167→	}
   168→
   169→	async function loadData() {
   170→		try {
   171→			loading = true;
   172→			error = '';
   173→			const [inboxResponse, triageResponse] = await Promise.all([
   174→				fetchInbox({ limit: 1000 }),
   175→				fetchTriageRecords({ limit: 1000 })
   176→			]);
   177→			inboxItems = inboxResponse.items;
   178→			triageRecords = triageResponse.items;
   179→		} catch (err) {
   180→			error = err instanceof Error ? err.message : 'Failed to load triage data';
   181→		} finally {
   182→			loading = false;
   183→		}
   184→	}
   185→
   186→	async function loadTriageData() {
   187→		try {
   188→			const triageResponse = await fetchTriageRecords({ limit: 1000 });
   189→			triageRecords = triageResponse.items;
   190→		} catch (err) {
   191→			console.error('Failed to reload triage records:', err);
   192→		}
   193→	}
   194→
   195→	function updateFilterParam(key: 'status' | 'action' | 'tag', value: string) {
   196→		const params = new URLSearchParams($page.url.searchParams);
   197→
   198→		if (!value || value === 'all') {
   199→			params.delete(key);
   200→		} else {
   201→			params.set(key, value);
   202→		}
   203→
   204→		const query = params.toString();
   205→		const nextUrl = query ? `${base}/triage?${query}` : `${base}/triage`;
   206→		goto(nextUrl, { replaceState: false, keepFocus: true, noScroll: true });
   207→	}
   208→
   209→	// AC: @interactive-triage-ui ac-5 - Navigation
   210→	function goNext() {
   211→		if (currentIndex < filteredItems.length - 1) {
   212→			currentIndex++;
   213→			resetForm();
   214→		}
   215→	}
   216→
   217→	function goPrevious() {
   218→		if (currentIndex > 0) {
   219→			currentIndex--;
   220→			resetForm();
   221→		}
   222→	}
   223→
   224→	function resetForm() {
   225→		selectedAction = '';
   226→		reasoning = '';
   227→		error = '';
   228→	}
   229→
   230→	// Keyboard navigation - skip when focus is on input/textarea elements
   231→	function handleKeydown(e: KeyboardEvent) {
   232→		const target = e.target as HTMLElement;
   233→		if (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable) {
   234→			return;
   235→		}
   236→		if (e.key === 'ArrowLeft') {
   237→			goPrevious();
   238→		} else if (e.key === 'ArrowRight') {
   239→			goNext();
   240→		}
   241→	}
   242→
   243→	// AC: @interactive-triage-ui ac-3 - Submit triage decision
   244→	async function handleSubmit() {
   245→		if (!currentItem || !selectedAction || !reasoning.trim()) return;
   246→
   247→		if (isStaticMode()) {
   248→			error = 'Cannot submit triage decisions in read-only mode.';
   249→			return;
   250→		}
   251→
   252→		try {
   253→			submitting = true;
   254→			error = '';
   255→
   256→			const existing = currentItem.record;
   257→
   258→			if (existing && existing.status !== 'pending') {
   259→				// AC: @interactive-triage-ui ac-4 - Override existing decision
   260→				await overrideTriageRecord(existing._ulid, {
   261→					action: selectedAction,
   262→					reasoning: reasoning.trim()
   263→				});
   264→			} else {
   265→				// Create new triage record
   266→				await createTriageRecord({
   267→					inbox_ref: currentItem.inbox._ulid,
   268→					action: selectedAction,
   269→					reasoning: reasoning.trim()
   270→				});
   271→			}
   272→
   273→			// Reload triage data
   274→			await loadTriageData();
   275→
   276→			// Auto-advance to next item
   277→			// AC: @interactive-triage-ui ac-3 - advances to next item
   278→			if (currentIndex < filteredItems.length - 1) {
   279→				currentIndex++;
   280→			}
   281→			resetForm();
   282→		} catch (err) {
   283→			if (err instanceof ReadOnlyModeError) {
   284→				error = err.message;
   285→			} else {
   286→				error = err instanceof Error ? err.message : 'Failed to submit triage decision';
   287→			}
   288→		} finally {
   289→			submitting = false;
   290→		}
   291→	}
   292→
   293→	// Execute the triage action
   294→	async function handleAct() {
   295→		if (!currentItem?.record) return;
   296→
   297→		if (isStaticMode()) {
   298→			error = 'Cannot execute triage actions in read-only mode.';
   299→			return;
   300→		}
   301→
   302→		try {
   303→			submitting = true;
   304→			error = '';
   305→			await actOnTriageRecord(currentItem.record._ulid);
   306→			await loadTriageData();
   307→		} catch (err) {
   308→			if (err instanceof ReadOnlyModeError) {
   309→				error = err.message;
   310→			} else {
   311→				error = err instanceof Error ? err.message : 'Failed to execute triage action';
   312→			}
   313→		} finally {
   314→			submitting = false;
   315→		}
   316→	}
   317→
   318→	function formatDate(dateString: string): string {
   319→		const date = new Date(dateString);
   320→		const now = new Date();
   321→		const diffMs = now.getTime() - date.getTime();
   322→		const diffMins = Math.floor(diffMs / 60000);
   323→		const diffHours = Math.floor(diffMs / 3600000);
   324→		const diffDays = Math.floor(diffMs / 86400000);
   325→
   326→		if (diffMins < 1) return 'just now';
   327→		if (diffMins < 60) return `${diffMins}m ago`;
   328→		if (diffHours < 24) return `${diffHours}h ago`;
   329→		if (diffDays < 7) return `${diffDays}d ago`;
   330→
   331→		return date.toLocaleDateString();
   332→	}
   333→
   334→	// AC: @interactive-triage-ui ac-7 - Reset index when filter changes
   335→	$effect(() => {
   336→		// Reading filter values creates reactive dependencies
   337→		const _tag = filterTag;
   338→		const _status = filterStatus;
   339→		const _action = filterAction;
   340→		currentIndex = 0;
   341→		resetForm();
   342→	});
   343→</script>
   344→
   345→<svelte:window onkeydown={handleKeydown} />
   346→
   347→<!-- AC: @interactive-triage-ui ac-1, ac-5, ac-7 -->
   348→<div class="flex flex-col gap-4 p-6">
   349→	<div class="flex items-center justify-between">
   350→		<div>
   351→			<h1 class="text-3xl font-bold">Triage</h1>
   352→			{#if !loading}
   353→				<!-- AC: @interactive-triage-ui ac-7 - Progress count -->
   354→				<p class="text-muted-foreground" data-testid="triage-progress">
   355→					{triagedCount} of {totalCount} triaged
   356→					{#if filteredItems.length !== allItems.length}
   357→						&middot; Showing {filteredItems.length} filtered
   358→					{/if}
   359→				</p>
   360→			{/if}
   361→		</div>
   362→
   363→		<!-- AC: @interactive-triage-ui ac-7 - Filters -->
   364→		<div class="flex gap-2 items-center" data-testid="triage-filters">
   365→			<select
   366→				value={filterStatus}
   367→				onchange={(event) => updateFilterParam('status', (event.currentTarget as HTMLSelectElement).value)}
   368→				class="rounded-md border bg-background px-3 py-1.5 text-sm"
   369→				data-testid="triage-status-filter"
   370→			>
   371→				<option value="all">All</option>
   372→				<option value="untriaged">Untriaged</option>
   373→				<option value="triaged">Triaged</option>
   374→				<option value="acted_on">Acted On</option>
   375→			</select>
   376→			<select
   377→				value={filterAction}
   378→				onchange={(event) => updateFilterParam('action', (event.currentTarget as HTMLSelectElement).value)}
   379→				class="rounded-md border bg-background px-3 py-1.5 text-sm"
   380→				data-testid="triage-action-filter"
   381→			>
   382→				<option value="">All Actions</option>
   383→				{#each Object.entries(ACTION_LABELS) as [action, label]}
   384→					<option value={action}>{label}</option>
   385→				{/each}
   386→			</select>
   387→			{#if allTags.length > 0}
   388→				<select
   389→					value={filterTag}
   390→					onchange={(event) => updateFilterParam('tag', (event.currentTarget as HTMLSelectElement).value)}
   391→					class="rounded-md border bg-background px-3 py-1.5 text-sm"
   392→					data-testid="triage-tag-filter"
   393→				>
   394→					<option value="">All Tags</option>
   395→					{#each allTags as tag}
   396→						<option value={tag}>{tag}</option>
   397→					{/each}
   398→				</select>
   399→			{/if}
   400→		</div>
   401→	</div>
   402→
   403→	<!-- Progress bar -->
   404→	{#if totalCount > 0}
   405→		<div class="w-full bg-muted rounded-full h-2" data-testid="triage-progress-bar">
   406→			<div
   407→				class="bg-primary rounded-full h-2 transition-all duration-300"
   408→				style="width: {(triagedCount / totalCount) * 100}%"
   409→			></div>
   410→		</div>
   411→	{/if}
   412→
   413→	{#if error}
   414→		<div class="rounded-md bg-red-50 p-4 text-sm text-red-800 dark:bg-red-900/20 dark:text-red-200" data-testid="triage-error" role="alert">
   415→			{error}
   416→		</div>
   417→	{/if}
   418→
   419→	<!-- AC: @interactive-triage-ui ac-8 - Static mode notice -->
   420→	{#if isStaticMode() && !loading}
   421→		<div class="rounded-md bg-amber-50 p-3 text-sm text-amber-800 dark:bg-amber-900/20 dark:text-amber-200" data-testid="triage-static-notice">
   422→			Triage decisions are not included in static snapshots. Browse inbox items below; use the daemon for full triage functionality.
   423→		</div>
   424→	{/if}
   425→
   426→	{#if loading}
   427→		<div class="text-center text-muted-foreground py-12">Loading triage data...</div>
   428→	{:else if filteredItems.length === 0}
   429→		<div class="text-center text-muted-foreground py-12">
   430→			{#if allItems.length === 0}
   431→				<p>No inbox items to triage.</p>
   432→				<p class="text-sm mt-1">Add items to your inbox first.</p>
   433→			{:else}
   434→				<p>No items match the current filters.</p>
   435→			{/if}
   436→		</div>
   437→	{:else if currentItem}
   438→		<!-- Card navigation -->
   439→		<div class="flex items-center justify-between mb-2">
   440→			<!-- AC: @interactive-triage-ui ac-5 - Navigation controls -->
   441→			<Button
   442→				variant="outline"
   443→				size="sm"
   444→				onclick={goPrevious}
   445→				disabled={currentIndex === 0}
   446→				data-testid="triage-prev"
   447→			>
   448→				<ChevronLeftIcon class="size-4 mr-1" />
   449→				Previous
   450→			</Button>
   451→			<span class="text-sm text-muted-foreground" data-testid="triage-position">
   452→				{currentIndex + 1} / {filteredItems.length}
   453→			</span>
   454→			<Button
   455→				variant="outline"
   456→				size="sm"
   457→				onclick={goNext}
   458→				disabled={currentIndex === filteredItems.length - 1}
   459→				data-testid="triage-next"
   460→			>
   461→				Next
   462→				<ChevronRightIcon class="size-4 ml-1" />
   463→			</Button>
   464→		</div>
   465→
   466→		<!-- AC: @interactive-triage-ui ac-1 - Card view showing item text, tags, age, added_by -->
   467→		<Card class="transition-all duration-200" data-testid="triage-card">
   468→			<CardHeader>
   469→				<div class="flex items-start justify-between gap-4">
   470→					<CardTitle class="text-lg leading-relaxed" data-testid="triage-card-text">
   471→						{currentItem.inbox.text}
   472→					</CardTitle>
   473→					<!-- AC: @interactive-triage-ui ac-5 - Show decision state on already-triaged items -->
   474→					{#if currentItem.record && currentItem.record.status !== 'pending'}
   475→						<Badge
   476→							class={currentItem.record.action ? ACTION_COLORS[currentItem.record.action] : 'bg-gray-500'}
   477→							data-testid="triage-card-status"
   478→						>
   479→							{currentItem.record.status === 'acted_on' ? 'Acted' : 'Triaged'}
   480→						</Badge>
   481→					{/if}
   482→				</div>
   483→				<!-- AC: @interactive-triage-ui ac-1 - tags, age, added_by -->
   484→				<div class="flex items-center gap-2 text-xs text-muted-foreground mt-2" data-testid="triage-card-meta">
   485→					<span data-testid="triage-card-age">{formatDate(currentItem.inbox.created_at)}</span>
   486→					<span>&middot;</span>
   487→					<span data-testid="triage-card-added-by">{currentItem.inbox.added_by}</span>
   488→					{#if currentItem.inbox.tags.length > 0}
   489→						<span>&middot;</span>
   490→						<div class="flex gap-1" data-testid="triage-card-tags">
   491→							{#each currentItem.inbox.tags as tag}
   492→								<Badge variant="secondary" class="text-xs">{tag}</Badge>
   493→							{/each}
   494→						</div>
   495→					{/if}
   496→				</div>
   497→			</CardHeader>
   498→			<CardContent>
   499→				<!-- AC: @interactive-triage-ui ac-2 - Show agent recommendation if exists -->
   500→				{#if currentItem.record && currentItem.record.status !== 'pending'}
   501→					<div class="rounded-md bg-muted p-4 mb-4" data-testid="triage-agent-recommendation">
   502→						<p class="text-sm font-medium mb-2">
   503→							{#if currentItem.record.override_by}
   504→								Override Decision
   505→							{:else}
   506→								Agent Recommendation
   507→							{/if}
   508→						</p>
   509→						<div class="space-y-1 text-sm">
   510→							<p data-testid="triage-rec-action">
   511→								<span class="font-medium">Action:</span>
   512→								{currentItem.record.action ? ACTION_LABELS[currentItem.record.action] : 'None'}
   513→							</p>
   514→							<p data-testid="triage-rec-reasoning">
   515→								<span class="font-medium">Reasoning:</span>
   516→								{currentItem.record.override_reasoning || currentItem.record.reasoning}
   517→							</p>
   518→							{#if currentItem.record.evidence_refs.length > 0}
   519→								<p data-testid="triage-rec-evidence">
   520→									<span class="font-medium">Evidence:</span>
   521→									{currentItem.record.evidence_refs.join(', ')}
   522→								</p>
   523→							{/if}
   524→							<p class="text-xs text-muted-foreground">
   525→								Decided by: {currentItem.record.override_by || currentItem.record.decided_by}
   526→							</p>
   527→						</div>
   528→					</div>
   529→				{/if}
   530→
   531→				<!-- AC: @interactive-triage-ui ac-8 - Hide action UI in static mode -->
   532→				{#if !isStaticMode()}
   533→					<Separator class="my-4" />
   534→
   535→					<!-- AC: @interactive-triage-ui ac-3, ac-4 - Action selection and reasoning -->
   536→					<div class="space-y-4" data-testid="triage-action-form">
   537→						<div>
   538→							<p class="text-sm font-medium mb-2">
   539→								{currentItem.record && currentItem.record.status !== 'pending' ? 'Override Action' : 'Select Action'}
   540→							</p>
   541→							<div class="flex flex-wrap gap-2" data-testid="triage-action-buttons">
   542→								{#each Object.entries(ACTION_LABELS) as [action, label]}
   543→									<Button
   544→										variant={selectedAction === action ? 'default' : 'outline'}
   545→										size="sm"
   546→										onclick={() => (selectedAction = action as TriageAction)}
   547→										data-testid="triage-action-{action}"
   548→									>
   549→										{label}
   550→									</Button>
   551→								{/each}
   552→							</div>
   553→						</div>
   554→
   555→						<div>
   556→							<p class="text-sm font-medium mb-2">Reasoning</p>
   557→							<Textarea
   558→								placeholder="Why are you choosing this action?"
   559→								bind:value={reasoning}
   560→								rows={3}
   561→								disabled={submitting}
   562→								data-testid="triage-reasoning"
   563→							/>
   564→						</div>
   565→
   566→						<div class="flex gap-2">
   567→							<Button
   568→								onclick={handleSubmit}
   569→								disabled={submitting || !selectedAction || !reasoning.trim()}
   570→								data-testid="triage-submit"
   571→							>
   572→								{#if submitting}
   573→									Submitting...
   574→								{:else if currentItem.record && currentItem.record.status !== 'pending'}
   575→									Override Decision
   576→								{:else}
   577→									Submit Decision
   578→								{/if}
   579→							</Button>
   580→
   581→							{#if currentItem.record?.status === 'triaged'}
   582→								<Button
   583→									variant="secondary"
   584→									onclick={handleAct}
   585→									disabled={submitting}
   586→									data-testid="triage-act"
   587→								>
   588→									{submitting ? 'Executing...' : `Execute: ${currentItem.record.action ? ACTION_LABELS[currentItem.record.action] : ''}`}
   589→								</Button>
   590→							{/if}
   591→						</div>
   592→					</div>
   593→				{:else}
   594→					<!-- AC: @interactive-triage-ui ac-8 - Static mode: browsing only -->
   595→					{#if !currentItem.record}
   596→						<p class="text-sm text-muted-foreground mt-4">
   597→							No triage decision recorded. Use the CLI or daemon to triage items.
   598→						</p>
   599→					{/if}
   600→				{/if}
   601→			</CardContent>
   602→		</Card>
   603→	{/if}
   604→</div>
   605→
```