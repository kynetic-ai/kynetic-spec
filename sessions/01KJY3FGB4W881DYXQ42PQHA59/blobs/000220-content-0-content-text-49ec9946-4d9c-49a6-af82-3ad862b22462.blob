  7825→          - id: ac-2
  7826→            given: |
  7827→              The dispatch engine is running
  7828→            when: |
  7829→              The agents page renders
  7830→            then: |
  7831→              Dispatch status shows as running with a stop button, and active invocations
  7832→              show task ref, elapsed time, and link to session stream
  7833→          - id: ac-3
  7834→            given: |
  7835→              The dispatch engine is stopped
  7836→            when: |
  7837→              The agents page renders
  7838→            then: |
  7839→              Dispatch status shows as stopped with no active invocations
  7840→
  7841→      - title: "Session History"
  7842→        slug: ui-session-history
  7843→        type: feature
  7844→        parent: "@web-ui"
  7845→        description: |
  7846→          List view of past agent sessions with filtering and navigation to session detail.
