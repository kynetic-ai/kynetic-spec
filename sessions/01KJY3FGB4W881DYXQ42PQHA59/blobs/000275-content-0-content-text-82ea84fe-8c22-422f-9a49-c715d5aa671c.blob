   652→.ds-gen-bar-hint {
   653→  font-size: 0.75rem;
   654→  color: var(--design-muted-fg);
   655→}
   656→
   657→/* Progress bar */
   658→.ds-gen-bar-progress {
   659→  position: absolute;
   660→  bottom: 0;
   661→  left: 0;
   662→  height: 2px;
   663→  background: var(--design-primary);
   664→  border-radius: 0 0 var(--design-radius-xl) var(--design-radius-xl);
   665→  animation: ds-gen-progress 3s ease-out forwards;
   666→}
   667→
   668→/* Keyframes */
   669→@keyframes ds-gen-breathe {
   670→  0%,
   671→  100% {
   672→    box-shadow:
   673→      0 0 0 0 color-mix(in oklch, var(--design-accent), transparent 90%),
   674→      inset 0 0 20px color-mix(in oklch, var(--design-accent), transparent 95%);
   675→  }
   676→  50% {
   677→    box-shadow:
   678→      0 0 20px 2px color-mix(in oklch, var(--design-accent), transparent 80%),
   679→      inset 0 0 30px color-mix(in oklch, var(--design-accent), transparent 90%);
   680→  }
   681→}
   682→
   683→@keyframes ds-gen-progress {
   684→  from {
   685→    width: 0%;
   686→  }
   687→  to {
   688→    width: 100%;
   689→  }
   690→}
   691→
   692→@keyframes ds-controls-reveal {
   693→  from {
   694→    opacity: 0;
   695→    transform: translateY(-10px);
   696→  }
   697→  to {
   698→    opacity: 1;
   699→    transform: translateY(0);
   700→  }
   701→}
   702→
   703→@media (prefers-reduced-motion: reduce) {
   704→  .ds-gen-bar,
   705→  .ds-gen-bar-progress,
   706→  .ds-gen-bar-controls {
   707→    animation: none !important;
   708→    transition-duration: 0.01ms !important;
   709→  }
   710→}
   711→
   712→/* Responsive: Mobile (under 768px) */
   713→@media (max-width: 767px) {
   714→  .ds-gen-bar-section {
   715→    padding: 1rem 1rem 3rem;
   716→  }
   717→
   718→  .ds-gen-bar-section.ds-gen-bar-section-floating {
   719→    padding: 0.5rem 0.5rem calc(0.5rem + env(safe-area-inset-bottom));
   720→  }
   721→
   722→  .ds-gen-bar-input-row {
   723→    padding: 0.75rem;
   724→    gap: 0.5rem;
   725→  }
   726→
   727→  /* Stack controls vertically on mobile */
   728→  .ds-gen-bar-control-row {
   729→    flex-direction: column;
   730→    align-items: stretch;
   731→    gap: 0.5rem;
   732→  }
   733→
   734→  .ds-gen-bar-control-label {
   735→    width: auto;
   736→  }
   737→
   738→  .ds-gen-bar-chips {
   739→    justify-content: flex-start;
   740→  }
   741→
   742→  /* Touch-friendly targets (44px minimum) */
   743→  .ds-gen-bar-chip {
   744→    min-height: 2.75rem;
   745→    padding: 0.5rem 0.75rem;
   746→    font-size: 0.875rem;
   747→  }
   748→
   749→  .ds-gen-bar-image-btn,
   750→  .ds-gen-bar-overflow-btn {
   751→    width: 2.75rem;
   752→    height: 2.75rem;
   753→  }
   754→
   755→  .ds-gen-bar-submit-btn {
   756→    min-height: 2.75rem;
   757→    min-width: 4rem;
   758→  }
   759→
   760→  /* Mention popup full width on mobile */
   761→  .ds-gen-bar-mention-popup {
   762→    max-height: 12rem;
   763→  }
   764→
   765→  .ds-gen-bar-mention-item {
   766→    min-height: 2.75rem;
   767→  }
   768→
   769→  /* Thumbnails smaller on mobile */
   770→  .ds-gen-bar-thumbnail {
   771→    width: 3rem;
   772→    height: 3rem;
   773→  }
   774→
   775→  .ds-gen-bar-thumbnail-remove {
   776→    opacity: 1;
   777→  }
   778→}
   779→
```