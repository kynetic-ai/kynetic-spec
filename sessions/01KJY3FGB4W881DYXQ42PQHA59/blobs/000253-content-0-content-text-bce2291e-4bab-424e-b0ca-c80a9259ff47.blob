   410→      - id: ac-22
   411→        given: API request has invalid ref
   412→        when: any endpoint with :ref parameter
   413→        then: returns {error, message, suggestion} with 404 status, suggests similar refs if available
   414→      - id: ac-23
   415→        given: API request has validation error
