```
     1→/**
     2→ * Agent Dispatch Engine
     3→ *
     4→ * Core dispatch runtime for the daemon. Watches for task state changes via
     5→ * file watcher events and direct API event emission from CLI commands. Matches
     6→ * state changes against agent dispatch rules, queues invocations, manages
     7→ * concurrency, and handles deduplication of events from dual sources.
     8→ * Serializes shadow branch mutations when multiple agents run concurrently.
     9→ *
    10→ * AC: @agent-dispatch-engine ac-1 through ac-12
    11→ */
    12→
    13→import * as path from "node:path";
    14→import { spawnSync } from "node:child_process";
    15→import { ulid } from "ulid";
    16→import {
    17→  initContext,
    18→  loadAllTasks,
    19→  loadMetaContext,
    20→  type LoadedTask,
    21→  type LoadedAgent,
    22→} from "../parser/index.js";
    23→import { runInvocation } from "./invocation.js";
    24→import type { InvocationOptions } from "./invocation.js";
    25→import { getAdapter } from "../agents/adapters.js";
    26→import type { AgentDispatchRule } from "../schema/meta.js";
    27→import type { SessionTrigger } from "../sessions/types.js";
    28→
    29→// ─── Simple Mutex ─────────────────────────────────────────────────────────────
    30→
    31→/**
    32→ * A minimal promise-based mutex for serializing async operations.
    33→ * AC: @agent-dispatch-engine ac-12
    34→ */
    35→class Mutex {
    36→  private _queue: Array<() => void> = [];
    37→  private _locked = false;
    38→
    39→  async runExclusive<T>(fn: () => Promise<T>): Promise<T> {
    40→    await this._acquire();
    41→    try {
    42→      return await fn();
    43→    } finally {
    44→      this._release();
    45→    }
    46→  }
    47→
    48→  private _acquire(): Promise<void> {
    49→    if (!this._locked) {
    50→      this._locked = true;
    51→      return Promise.resolve();
    52→    }
    53→    return new Promise<void>((resolve) => {
    54→      this._queue.push(resolve);
    55→    });
    56→  }
    57→
    58→  private _release(): void {
    59→    const next = this._queue.shift();
    60→    if (next) {
    61→      next();
    62→    } else {
    63→      this._locked = false;
    64→    }
    65→  }
    66→}
    67→
    68→// ─── Types ────────────────────────────────────────────────────────────────────
    69→
    70→/**
    71→ * Task state as used for dispatch tracking.
    72→ */
    73→export type TaskStatus =
    74→  | "pending"
    75→  | "in_progress"
    76→  | "pending_review"
    77→  | "needs_work"
    78→  | "blocked"
    79→  | "completed"
    80→  | "cancelled";
    81→
    82→/**
    83→ * Mapping from dispatch event names to task statuses.
    84→ * AC: @agent-dispatch-engine ac-1
    85→ */
    86→const EVENT_TO_STATUS: Record<string, TaskStatus> = {
    87→  "task.in_progress": "in_progress",
    88→  "task.ready": "pending",
    89→  "task.needs_work": "needs_work",
    90→  "task.pending_review": "pending_review",
    91→};
    92→
    93→const STATUS_TO_EVENT: Record<TaskStatus, string | undefined> = {
    94→  in_progress: "task.in_progress",
    95→  pending: "task.ready",
    96→  needs_work: "task.needs_work",
    97→  pending_review: "task.pending_review",
    98→  blocked: undefined,
    99→  completed: undefined,
   100→  cancelled: undefined,
   101→};
   102→
   103→/**
   104→ * Dispatch precedence for runnable task statuses.
   105→ * Lower number = higher scheduling priority.
   106→ *
   107→ * AC: @dispatch-in-progress-priority ac-1
   108→ */
   109→const STATUS_PRECEDENCE: Record<TaskStatus, number> = {
   110→  in_progress: 0,
   111→  needs_work: 1,
   112→  pending: 2,
   113→  pending_review: 3,
   114→  blocked: 4,
   115→  completed: 5,
   116→  cancelled: 6,
   117→};
   118→
   119→// ─── Prompt Helpers (exported for testing) ───────────────────────────────────
   120→
   121→/**
   122→ * Interpolate {{variable}} placeholders in a prompt template.
   123→ * Unresolved variables pass through unchanged.
   124→ *
   125→ * AC: @agent-dispatch-engine ac-16
   126→ */
   127→export function interpolateTemplate(
   128→  template: string,
   129→  vars: Record<string, string>,
   130→): string {
   131→  return template.replace(
   132→    /\{\{(\w+)\}\}/g,
   133→    (match, key: string) => vars[key] ?? match,
   134→  );
   135→}
   136→
   137→/**
   138→ * Human-readable trigger description for orientation context.
   139→ */
   140→function triggerDescription(trigger: string): string {
   141→  switch (trigger) {
   142→    case "task.ready":
   143→      return "New task assignment.";
   144→    case "task.in_progress":
   145→      return "Continuing in-progress work.";
   146→    case "task.needs_work":
   147→      return "Fix cycle \u2014 this task was kicked back from review. Address the feedback below.";
   148→    case "task.pending_review":
   149→      return "Task submitted for review.";
   150→    default:
   151→      return `Trigger: ${trigger}`;
   152→  }
   153→}
   154→
   155→/**
   156→ * Format recent notes for inclusion in dispatch prompts.
   157→ * Takes last N notes, truncates each to maxLen characters, strips newlines.
   158→ */
   159→function formatRecentNotes(
   160→  notes: Array<{ created_at: string; author?: string; content: string }>,
   161→  count = 3,
   162→  maxLen = 200,
   163→): string {
   164→  if (!notes || notes.length === 0) return "";
   165→  const recent = notes.slice(-count);
   166→  const lines = recent.map((n) => {
   167→    const date = n.created_at.slice(0, 10);
   168→    const author = n.author ? `@${n.author}` : "unknown";
   169→    const content = n.content.replace(/\n/g, " ").slice(0, maxLen);
   170→    return `- [${date}] ${author}: ${content}`;
   171→  });
   172→  return lines.join("\n");
   173→}
   174→
   175→/**
   176→ * Build orientation context block for a dispatch prompt.
   177→ * Provides the agent with task title, trigger meaning, and relevant context.
   178→ *
   179→ * AC: @agent-dispatch-engine ac-13, ac-14, ac-15
   180→ */
   181→export function buildOrientationContext(
   182→  taskRef: string,
   183→  trigger: string,
   184→  task?: {
   185→    title: string;
   186→    notes?: Array<{ created_at: string; author?: string; content: string }>;
   187→    review_url?: string;
   188→  },
   189→): string {
   190→  const title = task?.title ?? "(unavailable)";
   191→  const lines = [
   192→    "## Task Context",
   193→    `Task: ${taskRef} \u2014 "${title}"`,
   194→    `Trigger: ${triggerDescription(trigger)}`,
   195→  ];
   196→
   197→  // AC: @agent-dispatch-engine ac-14 - Include recent notes for fix cycles
   198→  if (trigger === "task.needs_work" && task?.notes && task.notes.length > 0) {
   199→    const noteText = formatRecentNotes(task.notes);
   200→    if (noteText) {
   201→      lines.push("", "Recent notes:", noteText);
   202→    }
   203→  }
   204→
   205→  // AC: @agent-dispatch-engine ac-15 - Include review URL for reviewer
   206→  if (trigger === "task.pending_review") {
   207→    const url = task?.review_url ?? "Not provided \u2014 find PR via task notes or git log.";
   208→    lines.push(`Review URL: ${url}`);
   209→  }
   210→
   211→  return lines.join("\n");
   212→}
   213→
   214→// ─── Types ───────────────────────────────────────────────────────────────────
   215→
   216→/**
   217→ * A state change event for a single task.
   218→ */
   219→export interface TaskStateChange {
   220→  taskId: string;
   221→  taskRef: string;
   222→  fromStatus: TaskStatus;
   223→  toStatus: TaskStatus;
   224→  timestamp: number;
   225→  /** Optional task data used for filter evaluation (AC-6) */
   226→  task?: LoadedTask;
   227→}
   228→
   229→/**
   230→ * An entry in the dispatch queue.
   231→ */
   232→interface QueueEntry {
   233→  agent: LoadedAgent;
   234→  change: TaskStateChange;
   235→  retryCount: number;
   236→  nextRetryAt: number;
   237→  /** When this entry was first enqueued (for wait-time display) */
   238→  enqueuedAtMs: number;
   239→  /** Monotonic sequence for deterministic tie-breaking */
   240→  sequence: number;
   241→}
   242→
   243→/**
   244→ * Tracking record for an active invocation.
   245→ * AC: @cli-agent-commands ac-6
   246→ */
   247→interface ActiveInvocationRecord {
   248→  invocationId: string;
   249→  sessionId: string;
   250→  agentId: string;
   251→  agentName: string;
   252→  taskRef: string | undefined;
   253→  startedAtMs: number;
   254→}
   255→
   256→/**
   257→ * Deduplication key for recent state changes.
   258→ * AC: @agent-dispatch-engine ac-7
   259→ */
   260→type DedupKey = `${string}:${string}:${string}`;
   261→
   262→/**
   263→ * Invocation lifecycle event payload.
   264→ * AC: @daemon-agent-dispatch ac-3, ac-4
   265→ */
   266→export interface InvocationEvent {
   267→  type: "started" | "completed" | "failed";
   268→  session_id: string;
   269→  agent_id: string;
   270→  task_id: string | undefined;
   271→  status: "started" | "completed" | "failed";
   272→  timestamp: number;
   273→}
   274→
   275→/**
   276→ * Options for creating a DispatchEngine.
   277→ */
   278→export interface DispatchEngineOptions {
   279→  /** Project root directory */
   280→  projectDir: string;
   281→  /**
   282→   * Spec directory (.kspec/ for shadow mode, or same as projectDir for traditional mode).
   283→   * Defaults to projectDir/.kspec if not specified.
   284→   */
   285→  specDir?: string;
   286→  /** Working directory for spawned agents */
   287→  cwd?: string;
   288→  /** Deduplication window in milliseconds (default 2000) */
   289→  dedupWindowMs?: number;
   290→  /** Path to kspec CLI binary (for task notes) */
   291→  kspecCliPath?: string;
   292→  /**
   293→   * Optional callback invoked on invocation lifecycle events (start, complete, fail).
   294→   * AC: @daemon-agent-dispatch ac-3, ac-4
   295→   */
   296→  onInvocationEvent?: (event: InvocationEvent) => void;
   297→  /**
   298→   * Optional callback invoked for each text chunk produced by a running agent.
   299→   * AC: @cli-agent-commands ac-13 (broadcast to watch subscribers)
   300→   * AC: @daemon-agent-dispatch ac-8
   301→   */
   302→  onTextChunk?: (sessionId: string, agentId: string, taskId: string | null, text: string) => void;
   303→}
   304→
   305→// ─── DispatchEngine ───────────────────────────────────────────────────────────
   306→
   307→/**
   308→ * The core dispatch runtime.
   309→ *
   310→ * Lifecycle:
   311→ *   1. Create with new DispatchEngine(options)
   312→ *   2. Call start() to bootstrap and begin processing
   313→ *   3. Feed state changes via handleStateChange()
   314→ *   4. Call stop() for graceful shutdown
   315→ *
   316→ * AC: @agent-dispatch-engine ac-1 through ac-12
   317→ */
   318→export class DispatchEngine {
   319→  private projectDir: string;
   320→  private specDir: string;
   321→  private cwd: string;
   322→  private dedupWindowMs: number;
   323→  private kspecCliPath?: string;
   324→  private onInvocationEvent?: (event: InvocationEvent) => void;
   325→  private onTextChunk?: (sessionId: string, agentId: string, taskId: string | null, text: string) => void;
   326→
   327→  /** Queue of pending dispatch entries, per agent id */
   328→  private queues: Map<string, QueueEntry[]> = new Map();
   329→  /** Count of active (running) invocations per agent id */
   330→  private activeCount: Map<string, number> = new Map();
   331→  /** Recent dedup keys with their expiry timestamps */
   332→  private recentEvents: Map<DedupKey, number> = new Map();
   333→  /** Previous task states (for file watcher diffing) */
   334→  private prevTaskStates: Map<string, TaskStatus> = new Map();
   335→  /** Mutex serializing shadow branch mutations */
   336→  private shadowMutex = new Mutex();
   337→  /** Whether the engine is currently running */
   338→  private running = false;
   339→  /** Set of running invocation promises (for graceful shutdown) */
   340→  private runningInvocations: Set<Promise<void>> = new Set();
   341→  /** AbortControllers for active invocations (for graceful cancel on stop) */
   342→  private invocationAbortControllers: Set<AbortController> = new Set();
   343→  /** Per-invocation tracking records for status display */
   344→  private activeInvocationDetails: Map<string, ActiveInvocationRecord> = new Map();
   345→  /** Monotonic enqueue sequence for deterministic queue ordering */
   346→  private nextQueueSequence = 0;
   347→
   348→  constructor(options: DispatchEngineOptions) {
   349→    this.projectDir = options.projectDir;
   350→    this.specDir = options.specDir ?? path.join(options.projectDir, ".kspec");
   351→    this.cwd = options.cwd ?? options.projectDir;
   352→    this.dedupWindowMs = options.dedupWindowMs ?? 2000;
   353→    this.kspecCliPath = options.kspecCliPath;
   354→    this.onInvocationEvent = options.onInvocationEvent;
   355→    this.onTextChunk = options.onTextChunk;
   356→  }
   357→
   358→  // ─── Public API ─────────────────────────────────────────────────────────────
   359→
   360→  /**
   361→   * Start the dispatch engine.
   362→   *
   363→   * Loads current task states and evaluates dispatch rules for bootstrap.
   364→   * AC: @agent-dispatch-engine ac-8
   365→   */
   366→  async start(): Promise<void> {
   367→    this.running = true;
   368→
   369→    // AC: @agent-dispatch-engine ac-8 - Bootstrap: evaluate existing task states
   370→    await this._bootstrap();
   371→  }
   372→
   373→  /**
   374→   * Handle a task state change event from any source (file watcher or API).
   375→   *
   376→   * AC: @agent-dispatch-engine ac-1, ac-2, ac-4, ac-5, ac-6, ac-7
   377→   */
   378→  async handleStateChange(change: TaskStateChange): Promise<void> {
   379→    if (!this.running) return;
   380→
   381→    // AC: @agent-dispatch-engine ac-7 - Deduplication
   382→    if (this._isDuplicate(change)) {
   383→      return;
   384→    }
   385→    this._recordEvent(change);
   386→
   387→    // AC: @agent-dispatch-engine ac-1 - Match against dispatch rules
   388→    const agents = await this._loadAgents();
   389→    const eventType = STATUS_TO_EVENT[change.toStatus];
   390→    if (!eventType) return;
   391→
   392→    // Load task data for filter evaluation if not provided
   393→    let taskData = change.task;
   394→    if (!taskData && change.taskId) {
   395→      try {
   396→        const ctx = await initContext(this.projectDir);
   397→        const tasks = await loadAllTasks(ctx);
   398→        taskData = tasks.find((t) => t._ulid === change.taskId);
   399→      } catch {
   400→        // Can't load task, filter evaluation will be lenient
   401→      }
   402→    }
   403→    // Make loaded task available for prompt building (AC: @agent-dispatch-engine ac-13)
   404→    if (taskData && !change.task) {
   405→      change.task = taskData;
   406→    }
   407→
   408→    for (const agent of agents) {
   409→      for (const rule of (agent.dispatch ?? [])) {
   410→        if (rule.on !== eventType) continue;
   411→
   412→        // AC: @agent-dispatch-engine ac-6 - Apply filters
   413→        if (!this._matchesFilter(change, rule, taskData)) continue;
   414→
   415→        // AC: @agent-dispatch-engine ac-2 - Each matching agent queued independently
   416→        this._enqueue(agent, change);
   417→      }
   418→    }
   419→
   420→    // Drain queues after enqueuing
   421→    await this._drainQueues(agents);
   422→  }
   423→
   424→  /**
   425→   * Handle file watcher notification: diff previous vs current task states.
   426→   *
   427→   * AC: @agent-dispatch-engine ac-5
   428→   */
   429→  async handleFileChange(specDir: string): Promise<void> {
   430→    if (!this.running) return;
   431→
   432→    try {
   433→      const ctx = await initContext(this.projectDir);
   434→      const tasks = await loadAllTasks(ctx);
   435→
   436→      const changes: TaskStateChange[] = [];
   437→      const now = Date.now();
   438→
   439→      for (const task of tasks) {
   440→        const taskId = task._ulid;
   441→        const currentStatus = task.status as TaskStatus;
   442→        const prevStatus = this.prevTaskStates.get(taskId);
   443→
   444→        if (prevStatus !== undefined && prevStatus !== currentStatus) {
   445→          changes.push({
   446→            taskId,
   447→            taskRef: `@${taskId}`,
   448→            fromStatus: prevStatus,
   449→            toStatus: currentStatus,
   450→            timestamp: now,
   451→            task,
   452→          });
   453→        }
   454→
   455→        this.prevTaskStates.set(taskId, currentStatus);
   456→      }
   457→
   458→      // Emit change events for detected transitions
   459→      for (const change of changes) {
   460→        await this.handleStateChange(change);
   461→      }
   462→    } catch (err) {
   463→      console.error("[dispatch] Error processing file change:", err);
   464→    }
   465→  }
   466→
   467→  /**
   468→   * Stop the dispatch engine gracefully.
   469→   *
   470→   * Sends cancel signals to all active invocations and waits for them to finish.
   471→   * AC: @agent-dispatch-engine ac-11
   472→   */
   473→  async stop(): Promise<void> {
   474→    this.running = false;
   475→
   476→    // AC: @agent-dispatch-engine ac-11 - Send graceful cancel to all active invocations
   477→    for (const controller of this.invocationAbortControllers) {
   478→      controller.abort();
   479→    }
   480→
   481→    // Wait for all running invocations to complete (or abort)
   482→    if (this.runningInvocations.size > 0) {
   483→      await Promise.allSettled(Array.from(this.runningInvocations));
   484→    }
   485→
   486→    this.queues.clear();
   487→    this.activeCount.clear();
   488→    this.recentEvents.clear();
   489→    this.invocationAbortControllers.clear();
   490→    this.activeInvocationDetails.clear();
   491→  }
   492→
   493→  /**
   494→   * Get the shadow mutex for external callers that need to serialize mutations.
   495→   * AC: @agent-dispatch-engine ac-12
   496→   */
   497→  getShadowMutex(): Mutex {
   498→    return this.shadowMutex;
   499→  }
   500→
   501→  /**
   502→   * Returns current engine status info including per-invocation details.
   503→   * AC: @cli-agent-commands ac-6
   504→   */
   505→  getStatus(): {
   506→    running: boolean;
   507→    activeInvocations: number;
   508→    queuedInvocations: number;
   509→    invocations: Array<{
   510→      invocationId: string;
   511→      sessionId: string;
   512→      agentId: string;
   513→      agentName: string;
   514→      taskRef: string | undefined;
   515→      elapsedMs: number;
   516→    }>;
   517→    queued: Array<{
   518→      agentId: string;
   519→      agentName: string;
   520→      taskRef: string | undefined;
   521→      waitMs: number;
   522→    }>;
   523→  } {
   524→    let active = 0;
   525→    let queued = 0;
   526→    for (const count of this.activeCount.values()) active += count;
   527→    for (const entries of this.queues.values()) queued += entries.length;
   528→    const now = Date.now();
   529→    const invocations = Array.from(this.activeInvocationDetails.values()).map((r) => ({
   530→      invocationId: r.invocationId,
   531→      sessionId: r.sessionId,
   532→      agentId: r.agentId,
   533→      agentName: r.agentName,
   534→      taskRef: r.taskRef,
   535→      elapsedMs: now - r.startedAtMs,
   536→    }));
   537→    const queuedItems = Array.from(this.queues.values()).flatMap((entries) =>
   538→      entries.map((e) => ({
   539→        agentId: e.agent.id,
   540→        agentName: e.agent.name,
   541→        taskRef: e.change.taskRef,
   542→        waitMs: now - e.enqueuedAtMs,
   543→      })),
   544→    );
   545→    return { running: this.running, activeInvocations: active, queuedInvocations: queued, invocations, queued: queuedItems };
   546→  }
   547→
   548→  // ─── Private helpers ─────────────────────────────────────────────────────────
   549→
   550→  /**
   551→   * Bootstrap: evaluate all current tasks against dispatch rules.
   552→   * AC: @agent-dispatch-engine ac-8
   553→   */
   554→  private async _bootstrap(): Promise<void> {
   555→    try {
   556→      const ctx = await initContext(this.projectDir);
   557→      const tasks = await loadAllTasks(ctx);
   558→      const agents = await this._loadAgents();
   559→      const now = Date.now();
   560→
   561→      // Seed prevTaskStates so subsequent file watcher diffs work correctly
   562→      for (const task of tasks) {
   563→        this.prevTaskStates.set(task._ulid, task.status as TaskStatus);
   564→      }
   565→
   566→      // Evaluate each task against each agent's dispatch rules
   567→      for (const task of tasks) {
   568→        const currentStatus = task.status as TaskStatus;
   569→        const eventType = STATUS_TO_EVENT[currentStatus];
   570→        if (!eventType) continue;
   571→
   572→        for (const agent of agents) {
   573→          for (const rule of (agent.dispatch ?? [])) {
   574→            if (rule.on !== eventType) continue;
   575→
   576→            const change: TaskStateChange = {
   577→              taskId: task._ulid,
   578→              taskRef: `@${task._ulid}`,
   579→              fromStatus: currentStatus, // bootstrap: treated as "just entered"
   580→              toStatus: currentStatus,
   581→              timestamp: now,
   582→              task,
   583→            };
   584→
   585→            if (!this._matchesFilter(change, rule, task)) continue;
   586→
   587→            this._enqueue(agent, change);
   588→          }
   589→        }
   590→      }
   591→
   592→      await this._drainQueues(agents);
   593→    } catch (err) {
   594→      console.error("[dispatch] Bootstrap error:", err);
   595→    }
   596→  }
   597→
   598→  /**
   599→   * Load agent definitions from meta context.
   600→   */
   601→  private async _loadAgents(): Promise<LoadedAgent[]> {
   602→    try {
   603→      const ctx = await initContext(this.projectDir);
   604→      const meta = await loadMetaContext(ctx);
   605→      return meta.agents;
   606→    } catch {
   607→      return [];
   608→    }
   609→  }
   610→
   611→  /**
   612→   * Check if a state change matches a dispatch rule's filters.
   613→   * AC: @agent-dispatch-engine ac-6
   614→   */
   615→  private _matchesFilter(
   616→    change: TaskStateChange,
   617→    rule: AgentDispatchRule,
   618→    task?: LoadedTask,
   619→  ): boolean {
   620→    if (!rule.filter) return true;
   621→
   622→    // We need the task to evaluate filters — if not provided, reject to avoid
   623→    // enqueuing non-matching tasks (AC-6: all filters must match)
   624→    if (!task) return false;
   625→
   626→    const { filter } = rule;
   627→
   628→    // Automation filter
   629→    if (filter.automation !== undefined) {
   630→      if ((task as LoadedTask & { automation?: string }).automation !== filter.automation) {
   631→        return false;
   632→      }
   633→    }
   634→
   635→    // Tags filter
   636→    if (filter.tags && filter.tags.length > 0) {
   637→      const taskTags: string[] = (task as LoadedTask & { tags?: string[] }).tags ?? [];
   638→      if (!filter.tags.every((tag) => taskTags.includes(tag))) {
   639→        return false;
   640→      }
   641→    }
   642→
   643→    // Priority filter
   644→    if (filter.priority !== undefined) {
   645→      if ((task as LoadedTask & { priority?: number }).priority !== filter.priority) {
   646→        return false;
   647→      }
   648→    }
   649→
   650→    return true;
   651→  }
   652→
   653→  /**
   654→   * Build a deduplication key for a state change.
   655→   * AC: @agent-dispatch-engine ac-7
   656→   */
   657→  private _dedupKey(change: TaskStateChange): DedupKey {
   658→    return `${change.taskId}:${change.fromStatus}:${change.toStatus}`;
   659→  }
   660→
   661→  /**
   662→   * Check whether this event is a duplicate within the dedup window.
   663→   * AC: @agent-dispatch-engine ac-7
   664→   */
   665→  private _isDuplicate(change: TaskStateChange): boolean {
   666→    const key = this._dedupKey(change);
   667→    const expiry = this.recentEvents.get(key);
   668→    if (expiry === undefined) return false;
   669→    return change.timestamp < expiry;
   670→  }
   671→
   672→  /**
   673→   * Record a state change for deduplication.
   674→   * AC: @agent-dispatch-engine ac-7
   675→   */
   676→  private _recordEvent(change: TaskStateChange): void {
   677→    const key = this._dedupKey(change);
   678→    this.recentEvents.set(key, change.timestamp + this.dedupWindowMs);
   679→
   680→    // Prune expired entries periodically
   681→    if (this.recentEvents.size > 1000) {
   682→      const now = Date.now();
   683→      for (const [k, expiry] of this.recentEvents) {
   684→        if (expiry < now) this.recentEvents.delete(k);
   685→      }
   686→    }
   687→  }
   688→
   689→  /**
   690→   * Enqueue a dispatch entry for an agent.
   691→   * AC: @agent-dispatch-engine ac-3
   692→   */
   693→  private _enqueue(agent: LoadedAgent, change: TaskStateChange): void {
   694→    const queue = this.queues.get(agent.id) ?? [];
   695→    const entry: QueueEntry = {
   696→      agent,
   697→      change,
   698→      retryCount: 0,
   699→      nextRetryAt: 0,
   700→      enqueuedAtMs: Date.now(),
   701→      sequence: this.nextQueueSequence++,
   702→    };
   703→    this._insertQueueEntry(queue, entry);
   704→    this.queues.set(agent.id, queue);
   705→  }
   706→
   707→  /**
   708→   * Insert an entry into an agent queue using deterministic status precedence.
   709→   * AC: @dispatch-in-progress-priority ac-1
   710→   */
   711→  private _insertQueueEntry(queue: QueueEntry[], entry: QueueEntry): void {
   712→    const insertAt = queue.findIndex((queued) => this._compareQueueEntries(entry, queued) < 0);
   713→    if (insertAt === -1) {
   714→      queue.push(entry);
   715→      return;
   716→    }
   717→    queue.splice(insertAt, 0, entry);
   718→  }
   719→
   720→  /**
   721→   * Compare queue entries by dispatch precedence, then by enqueue sequence.
   722→   * AC: @dispatch-in-progress-priority ac-1
   723→   */
   724→  private _compareQueueEntries(a: QueueEntry, b: QueueEntry): number {
   725→    const statusDelta = STATUS_PRECEDENCE[a.change.toStatus] - STATUS_PRECEDENCE[b.change.toStatus];
   726→    if (statusDelta !== 0) return statusDelta;
   727→    return a.sequence - b.sequence;
   728→  }
   729→
   730→  /**
   731→   * Drain queues, spawning invocations up to each agent's max_concurrent limit.
   732→   * AC: @agent-dispatch-engine ac-3, ac-17
   733→   */
   734→  private async _drainQueues(agents: LoadedAgent[]): Promise<void> {
   735→    // Prevent new invocation starts during/after shutdown.
   736→    if (!this.running) return;
   737→
   738→    // AC: @agent-dispatch-engine ac-17 - Load current task states once for staleness checks
   739→    let currentTaskStates: Map<string, TaskStatus> | undefined;
   740→    try {
   741→      const ctx = await initContext(this.projectDir);
   742→      const tasks = await loadAllTasks(ctx);
   743→      currentTaskStates = new Map(
   744→        tasks.map((t) => [t._ulid, t.status as TaskStatus]),
   745→      );
   746→    } catch {
   747→      // If we can't load tasks, skip staleness checks (best effort)
   748→    }
   749→
   750→    for (const agent of agents) {
   751→      const maxConcurrent = agent.concurrency?.max_concurrent ?? 1;
   752→      const active = this.activeCount.get(agent.id) ?? 0;
   753→      const queue = this.queues.get(agent.id) ?? [];
   754→
   755→      // AC: @agent-dispatch-engine ac-17 - Discard stale entries before spawning.
   756→      // Only discard when we have positive evidence the task moved: either the task
   757→      // exists on disk with a different status, or the task was previously tracked
   758→      // (in prevTaskStates) but is no longer found (deleted).
   759→      if (currentTaskStates) {
   760→        const before = queue.length;
   761→        for (let i = queue.length - 1; i >= 0; i--) {
   762→          const entry = queue[i];
   763→          const currentStatus = currentTaskStates.get(entry.change.taskId);
   764→          const expectedEvent = STATUS_TO_EVENT[entry.change.toStatus];
   765→          if (!expectedEvent) continue; // No event mapping — skip check
   766→          if (currentStatus === undefined) {
   767→            // Task not on disk — only discard if we previously knew about it
   768→            // (it was deleted). Tasks from pure handleStateChange events without
   769→            // on-disk presence should still be processed.
   770→            if (this.prevTaskStates.has(entry.change.taskId)) {
   771→              queue.splice(i, 1);
   772→            }
   773→          } else {
   774→            const currentEvent = STATUS_TO_EVENT[currentStatus];
   775→            if (currentEvent !== expectedEvent) {
   776→              queue.splice(i, 1);
   777→            }
   778→          }
   779→        }
   780→        if (before > queue.length) {
   781→          console.log(
   782→            `[dispatch] Discarded ${before - queue.length} stale queue entries for agent "${agent.id}"`,
   783→          );
   784→        }
   785→      }
   786→
   787→      let slots = maxConcurrent - active;
   788→      while (slots > 0 && queue.length > 0) {
   789→        const now = Date.now();
   790→        const nextReadyIndex = queue.findIndex((entry) => entry.nextRetryAt <= now);
   791→        if (nextReadyIndex === -1) {
   792→          break;
   793→        }
   794→        const [entry] = queue.splice(nextReadyIndex, 1);
   795→        const spawned = this._spawnInvocation(agent, entry);
   796→        if (spawned) slots--;
   797→      }
   798→
   799→      this.queues.set(agent.id, queue);
   800→    }
   801→  }
   802→
   803→  /**
   804→   * Build dispatch-mode prompt guardrails to keep autonomous agents from
   805→   * stopping with handoff text instead of performing required actions.
   806→   *
   807→   * AC: @agent-dispatch-engine ac-13, ac-14, ac-15, ac-16
   808→   */
   809→  private _buildDispatchPrompt(agent: LoadedAgent, change: TaskStateChange): string {
   810→    const trigger = (STATUS_TO_EVENT[change.toStatus] ?? "task.ready") as SessionTrigger;
   811→    const taskRef = change.taskRef;
   812→
   813→    // AC: @agent-dispatch-engine ac-16 - Interpolate prompt_template variables
   814→    const templateVars: Record<string, string> = {
   815→      task_ref: taskRef,
   816→      task_title: change.task?.title ?? "(unavailable)",
   817→      trigger,
   818→      review_url: change.task?.review_url ?? "",
   819→    };
   820→    const rawTemplate = agent.prompt_template ?? `Work on task ${taskRef}`;
   821→    const basePrompt = interpolateTemplate(rawTemplate, templateVars);
   822→
   823→    // AC: @agent-dispatch-engine ac-13 - Orientation context
   824→    const orientation = buildOrientationContext(taskRef, trigger, change.task);
   825→
   826→    const autonomousPreamble = [
   827→      "AUTONOMOUS DISPATCH MODE (no interactive user is available).",
   828→      "- Do not ask for confirmation, approval, or next-step handoff.",
   829→      "- Execute required commands directly in this invocation.",
   830→      "- Do not end your turn with a recommendations-only summary. Perform the next required action yourself.",
   831→      "- Do not end your turn until the expected task transition is complete, or you have explicitly blocked the task with `kspec task block <task> --reason \"...\"`.",
   832→      "- If you find an open PR/branch from a different task, create or switch to a dedicated branch for this task before committing to avoid PR conflation.",
   833→    ];
   834→
   835→    const triggerSpecific =
   836→      trigger === "task.pending_review"
   837→        ? [
   838→            `Review flow completion criteria for ${taskRef}:`,
   839→            "- Execute your configured review workflow directly (no handoff).",
   840→            `- If blocking issues are found, transition ${taskRef} out of pending_review appropriately (for example needs_work).`,
   841→            `- If review gates are clean, perform your workflow's completion actions directly in this invocation.`,
   842→          ]
   843→        : [
   844→            `Work flow completion criteria for ${taskRef}:`,
   845→            "- Execute your configured work workflow directly (no handoff).",
   846→            `- Perform the required commands to move ${taskRef} to the next appropriate state in this same invocation.`,
   847→            "- If your workflow includes git or PR steps, execute them directly instead of deferring to a human.",
   848→          ];
   849→
   850→    return `${basePrompt}\n\n${orientation}\n\n${autonomousPreamble.join("\n")}\n\n${triggerSpecific.join("\n")}`;
   851→  }
   852→
   853→  /**
   854→   * Spawn a single invocation for a queue entry.
   855→   * Returns true if an invocation was actually started, false if skipped.
   856→   * AC: @agent-dispatch-engine ac-9, ac-10, ac-11, ac-12
   857→   */
   858→  private _spawnInvocation(agent: LoadedAgent, entry: QueueEntry): boolean {
   859→    const agentId = agent.id;
   860→
   861→    // Increment active count
   862→    this.activeCount.set(agentId, (this.activeCount.get(agentId) ?? 0) + 1);
   863→
   864→    // AC: @agent-dispatch-engine ac-10 - Check adapter resolvability before spawn
   865→    const adapterId = agent.adapter ?? "claude-agent-acp";
   866→    const adapter = getAdapter(adapterId);
   867→    if (!adapter) {
   868→      console.error(
   869→        `[dispatch] Cannot resolve adapter "${adapterId}" for agent "${agentId}". Skipping invocation.`,
   870→      );
   871→      // Decrement active count since we're not actually running
   872→      const currentActive = this.activeCount.get(agentId) ?? 1;
   873→      this.activeCount.set(agentId, Math.max(0, currentActive - 1));
   874→      // AC: @agent-dispatch-engine ac-10 - Add task note for unresolvable adapter
   875→      if (this.kspecCliPath) {
   876→        spawnSync(process.execPath, [
   877→          this.kspecCliPath,
   878→          "task", "note", entry.change.taskRef,
   879→          `[AGENT-SKIP] Cannot resolve adapter "${adapterId}" for agent "${agentId}". Invocation skipped.`,
   880→        ], { cwd: this.cwd });
   881→      }
   882→      return false;
   883→    }
   884→
   885→    // AC: @agent-dispatch-engine ac-11 - Create abort controller for graceful cancellation
   886→    const abortController = new AbortController();
   887→    this.invocationAbortControllers.add(abortController);
   888→
   889→    // AC: @cli-agent-commands ac-6 - Pre-assign session ID for status tracking
   890→    const preSessionId = ulid();
   891→    const invocationId = ulid();
   892→    const trackingRecord: ActiveInvocationRecord = {
   893→      invocationId,
   894→      sessionId: preSessionId,
   895→      agentId,
   896→      agentName: agent.name,
   897→      taskRef: entry.change.taskRef,
   898→      startedAtMs: Date.now(),
   899→    };
   900→    this.activeInvocationDetails.set(invocationId, trackingRecord);
   901→
   902→    // AC: @daemon-agent-dispatch ac-3, ac-4 - Emit started event
   903→    this.onInvocationEvent?.({
   904→      type: "started",
   905→      session_id: preSessionId,
   906→      agent_id: agentId,
   907→      task_id: entry.change.taskRef,
   908→      status: "started",
   909→      timestamp: Date.now(),
   910→    });
   911→
   912→    // AC: @cli-agent-commands ac-13, @daemon-agent-dispatch ac-8 - stream text chunks to watchers
   913→    const taskId = entry.change.taskRef ?? null;
   914→    const onUpdate = this.onTextChunk
   915→      ? (update: import("../acp/index.js").SessionUpdate) => {
   916→          if (
   917→            update.sessionUpdate === "agent_message_chunk" &&
   918→            update.content.type === "text"
   919→          ) {
   920→            this.onTextChunk!(preSessionId, agentId, taskId, update.content.text);
   921→            return;
   922→          }
   923→          // Non-text updates (especially tool events) delimit logical message runs.
   924→          // Emit an empty sentinel so watch renderers can end the current line
   925→          // without needing to infer boundaries from prose punctuation.
   926→          this.onTextChunk!(preSessionId, agentId, taskId, "");
   927→        }
   928→      : undefined;
   929→
   930→    const options: InvocationOptions = {
   931→      agent,
   932→      specDir: this.specDir,
   933→      cwd: this.cwd,
   934→      taskRef: entry.change.taskRef,
   935→      prompt: this._buildDispatchPrompt(agent, entry.change),
   936→      trigger: (STATUS_TO_EVENT[entry.change.toStatus] ?? "task.ready") as SessionTrigger,
   937→      kspecCliPath: this.kspecCliPath,
   938→      abortSignal: abortController.signal,
   939→      sessionId: preSessionId,
   940→      onUpdate,
   941→    };
   942→
   943→    // AC: @agent-dispatch-engine ac-12 - Wrap invocation in shadow mutex
   944→    const invocationPromise = this.shadowMutex
   945→      .runExclusive(async () => {
   946→        // AC: @agent-dispatch-engine ac-9 - Retry on transient errors
   947→        try {
   948→          await runInvocation(options);
   949→          // Reset retry count on success
   950→          entry.retryCount = 0;
   951→          // AC: @daemon-agent-dispatch ac-3, ac-4 - Emit completed event
   952→          this.onInvocationEvent?.({
   953→            type: "completed",
   954→            session_id: preSessionId,
   955→            agent_id: agentId,
   956→            task_id: entry.change.taskRef,
   957→            status: "completed",
   958→            timestamp: Date.now(),
   959→          });
   960→        } catch (err) {
   961→          const retryLimit = agent.budget?.max_tasks ?? 3;
   962→          if (entry.retryCount < retryLimit) {
   963→            entry.retryCount++;
   964→            const backoffMs = Math.min(
   965→              1000 * Math.pow(2, entry.retryCount - 1),
   966→              30_000,
   967→            );
   968→            entry.nextRetryAt = Date.now() + backoffMs;
   969→            console.warn(
   970→              `[dispatch] Invocation for agent "${agentId}" failed (attempt ${entry.retryCount}/${retryLimit}), retrying in ${backoffMs}ms`,
   971→              err,
   972→            );
   973→            // Re-enqueue for retry while preserving status precedence ordering.
   974→            const queue = this.queues.get(agentId) ?? [];
   975→            this._insertQueueEntry(queue, entry);
   976→            this.queues.set(agentId, queue);
   977→            // AC: @agent-dispatch-engine ac-9 - Schedule wake-up to drain retry
   978→            setTimeout(() => {
   979→              if (this.running) {
   980→                this._loadAgents()
   981→                  .then((agents) => this._drainQueues(agents))
   982→                  .catch(() => {/* best effort */});
   983→              }
   984→            }, backoffMs);
   985→          } else {
   986→            console.error(
   987→              `[dispatch] Agent "${agentId}" exceeded retry limit. Dropping invocation.`,
   988→              err,
   989→            );
   990→            // AC: @daemon-agent-dispatch ac-3, ac-4 - Emit failed event when retry limit exceeded
   991→            this.onInvocationEvent?.({
   992→              type: "failed",
   993→              session_id: preSessionId,
   994→              agent_id: agentId,
   995→              task_id: entry.change.taskRef,
   996→              status: "failed",
   997→              timestamp: Date.now(),
   998→            });
   999→          }
  1000→        }
  1001→      })
  1002→      .then(async () => {
  1003→        // Decrement active count and drain again
  1004→        const currentActive = this.activeCount.get(agentId) ?? 1;
  1005→        this.activeCount.set(agentId, Math.max(0, currentActive - 1));
  1006→
  1007→        if (!this.running) return;
  1008→
  1009→        // Try to drain more items
  1010→        try {
  1011→          const agents = await this._loadAgents();
  1012→          await this._drainQueues(agents);
  1013→        } catch {
  1014→          // Best effort
  1015→        }
  1016→      })
  1017→      .finally(() => {
  1018→        this.runningInvocations.delete(invocationPromise);
  1019→        this.invocationAbortControllers.delete(abortController);
  1020→        this.activeInvocationDetails.delete(invocationId);
  1021→      });
  1022→
  1023→    this.runningInvocations.add(invocationPromise);
  1024→    return true;
  1025→  }
  1026→}
