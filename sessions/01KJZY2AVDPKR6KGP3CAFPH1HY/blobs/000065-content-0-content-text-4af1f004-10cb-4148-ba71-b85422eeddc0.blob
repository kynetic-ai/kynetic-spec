   140→	// AC: @ui-task-board ac-1
   141→	test('shows empty state when no tasks exist', async ({ page }) => {
   142→		// Navigate to board (if daemon has no tasks it should show empty state)
   143→		// This test verifies the empty state component renders
   144→		await page.goto('/tasks/board');
   145→
   146→		// Either board columns or empty state should be visible
   147→		const columns = page.getByTestId('board-columns');
   148→		const empty = page.getByTestId('board-empty');
   149→
   150→		// Wait for either to appear
   151→		await expect(columns.or(empty)).toBeVisible();
   152→	});
   153→
   154→	// AC: @ui-task-board ac-5
   155→	test('board updates after task mutation without page refresh', async ({ page, daemon }) => {
   156→		await page.goto('/tasks/board');
   157→		await expect(page.getByTestId('board-columns')).toBeVisible();
   158→
   159→		// Find a pending task card and note its column
   160→		const backlogColumn = page.locator('[data-column-id="backlog"]');
   161→		await expect(backlogColumn).toBeVisible();
   162→		const taskCards = backlogColumn.getByTestId('task-card');
   163→		const initialBacklogCount = await taskCards.count();
   164→
   165→		// Start a pending task via API directly (simulating external state change)
   166→		// Use the ready task which is in pending status
   167→		const startResponse = await page.request.post(
   168→			`${daemon.baseUrl}/api/tasks/01KG0RR6CA45ZT43W2T6HJMVA1/start`
   169→		);
   170→		expect(startResponse.ok()).toBeTruthy();
   171→
   172→		// Wait for the board to update (WebSocket notification or polling triggers reload)
   173→		// The task should move from backlog to in_progress column
   174→		const inProgressColumn = page.locator('[data-column-id="in_progress"]');
   175→		await expect(async () => {
   176→			const inProgressCards = await inProgressColumn.getByTestId('task-card').count();
   177→			expect(inProgressCards).toBeGreaterThan(0);
   178→		}).toPass({ timeout: 10000 });
   179→	});
