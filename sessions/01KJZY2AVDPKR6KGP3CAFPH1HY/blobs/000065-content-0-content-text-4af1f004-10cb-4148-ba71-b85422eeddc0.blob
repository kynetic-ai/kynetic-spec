    39→		await expect(page.locator('[data-column-id="ready"]')).toBeVisible();
    40→		await expect(page.locator('[data-column-id="in_progress"]')).toBeVisible();
    41→		await expect(page.locator('[data-column-id="review"]')).toBeVisible();
    42→		await expect(page.locator('[data-column-id="done"]')).toBeVisible();
    43→	});
    44→
    45→	// AC: @ui-task-board ac-2
