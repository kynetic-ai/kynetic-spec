   272→	// AC: @ui-task-board ac-6
   273→	test('Complete action transitions task to completed with reason', async ({ page, daemon }) => {
   274→		await page.goto('/tasks/board');
   275→		await expect(page.getByTestId('board-columns')).toBeVisible();
   276→
   277→		// Click a task in the review column (pending_review supports Complete)
   278→		const reviewColumn = page.locator('[data-column-id="review"]');
   279→		await expect(reviewColumn).toBeVisible();
