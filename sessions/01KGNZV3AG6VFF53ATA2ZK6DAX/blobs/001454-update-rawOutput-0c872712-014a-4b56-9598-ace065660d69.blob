     1→/**
     2→ * Plan import CLI command
     3→ * AC: @plan-import ac-11 through ac-33
     4→ */
     5→
     6→import * as fs from "node:fs/promises";
     7→import * as path from "node:path";
     8→import type { Command } from "commander";
     9→import {
    10→  addChildItem,
    11→  buildIndexes,
    12→  createPlan,
    13→  createSpecItem,
    14→  createTask,
    15→  getAuthor,
    16→  initContext,
    17→  loadAllTasks,
    18→  loadPlans,
    19→  savePlan,
    20→  saveTask,
    21→  type LoadedSpecItem,
    22→} from "../../parser/index.js";
    23→import {
    24→  parsePlanDocument,
    25→  topologicalSort,
    26→  validateParentRefs,
    27→  type PlanSpec,
    28→} from "../../parser/plan-document.js";
    29→import { commitIfShadow } from "../../parser/shadow.js";
    30→import type { PlanInput, SpecItemInput, TaskInput } from "../../schema/index.js";
    31→import { errors } from "../../strings/index.js";
    32→import { EXIT_CODES } from "../exit-codes.js";
    33→import { error, info, output, setJsonMode, success, warn } from "../output.js";
    34→import { ulid } from "ulid";
    35→
    36→/**
    37→ * Register plan import command
    38→ * AC: @plan-import ac-11, ac-15, ac-32
    39→ */
    40→export function registerPlanImportCommand(planCommand: Command): void {
    41→  planCommand
    42→    .command("import <path>")
    43→    .description("Import plan document and auto-generate specs/tasks")
    44→    .requiredOption(
    45→      "--module <ref>",
    46→      "Module to add specs under (e.g., @core-module)",
    47→    )
    48→    .option("--dry-run", "Show what would be created without making changes")
    49→    .option("--update", "Update existing specs instead of skipping them")
    50→    .option("--json", "Output as JSON")
    51→    .addHelpText(
    52→      "after",
    53→      `
    54→Examples:
    55→  $ kspec plan import ./plan.md --module @core
    56→  $ kspec plan import ./plan.md --module @api --dry-run
    57→  $ kspec plan import ./plan.md --module @features --update --json`,
    58→    )
    59→    .action(async (planPath: string, options) => {
    60→      try {
    61→        await importPlan(planPath, options);
    62→      } catch (err) {
    63→        error("Failed to import plan", err);
    64→        process.exit(EXIT_CODES.ERROR);
    65→      }
    66→    });
    67→}
    68→
    69→/**
    70→ * Import operation result
    71→ */
    72→interface ImportResult {
    73→  createdSpecs: string[];
    74→  updatedSpecs: string[];
    75→  createdTasks: string[];
    76→  errors: Array<{ message: string; spec?: PlanSpec }>;
    77→  skipped: Array<{ slug: string; reason: string }>;
    78→  planRef: string;
    79→}
    80→
    81→/**
    82→ * Import plan document and create specs/tasks
    83→ * AC: @plan-import ac-11 through ac-33
    84→ */
    85→async function importPlan(
    86→  planPath: string,
    87→  options: { module: string; dryRun?: boolean; update?: boolean; json?: boolean },
    88→): Promise<void> {
    89→  // Set JSON mode if requested
    90→  if (options.json) {
    91→    setJsonMode(true);
    92→  }
    93→
    94→  const ctx = await initContext();
    95→  const author = getAuthor();
    96→
    97→  // Read plan file
    98→  // AC: @plan-import ac-21 - Handle file read errors
    99→  const fullPath = path.resolve(process.cwd(), planPath);
   100→  let content: string;
   101→  try {
   102→    content = await fs.readFile(fullPath, "utf-8");
   103→  } catch (err) {
   104→    error(`Failed to read plan file: ${planPath}`, err);
   105→    process.exit(EXIT_CODES.USAGE_ERROR);
   106→  }
   107→
   108→  // Parse plan document
   109→  // AC: @plan-import ac-11, ac-12, ac-13, ac-21, ac-22
   110→  const parsed = parsePlanDocument(content);
   111→
   112→  // Report parsing errors
   113→  if (parsed.errors.length > 0) {
   114→    for (const err of parsed.errors) {
   115→      if (err.type === "yaml") {
   116→        // AC: @plan-import ac-21 - YAML parse errors
   117→        error(err.message);
   118→        process.exit(EXIT_CODES.USAGE_ERROR);
   119→      }
   120→    }
   121→  }
   122→
   123→  // Build indexes to check existing specs
   124→  const { refIndex, items } = await buildIndexes(ctx);
   125→  const existingSpecRefs = new Set<string>();
   126→  for (const item of items) {
   127→    for (const slug of (item as LoadedSpecItem).slugs || []) {
   128→      existingSpecRefs.add(slug);
   129→    }
   130→    existingSpecRefs.add(item._ulid.slice(0, 8));
   131→  }
   132→
   133→  // Resolve module reference
   134→  const moduleResult = refIndex.resolve(options.module);
   135→  if (!moduleResult.ok) {
   136→    error(errors.reference.itemNotFound(options.module));
   137→    process.exit(EXIT_CODES.NOT_FOUND);
   138→  }
   139→
   140→  const moduleItem = moduleResult.item as LoadedSpecItem;
   141→
   142→  // Verify it's a module
   143→  if (moduleItem.type !== "module") {
   144→    error(`${options.module} is not a module (type: ${moduleItem.type})`);
   145→    process.exit(EXIT_CODES.USAGE_ERROR);
   146→  }
   147→
   148→  // Validate parent references
   149→  // AC: @plan-import ac-17, ac-33
   150→  const parentErrors = validateParentRefs(parsed.specs, existingSpecRefs);
   151→  parsed.errors.push(...parentErrors);
   152→
   153→  // Sort specs topologically
   154→  // AC: @plan-import ac-16, ac-18
   155→  const { sorted, error: sortError } = topologicalSort(parsed.specs);
   156→  if (sortError) {
   157→    // AC: @plan-import ac-18 - Circular dependency detection
   158→    error(sortError.message);
   159→    process.exit(EXIT_CODES.USAGE_ERROR);
   160→  }
   161→
   162→  // Create plan record
   163→  // AC: @plan-import ac-24, ac-28
   164→  const planSlug = generateSlug(parsed.title);
   165→  const planInput: PlanInput = {
   166→    title: parsed.title,
   167→    content: parsed.content,
   168→    status: "active",
   169→    slugs: [planSlug],
   170→    source_path: fullPath,
   171→  };
   172→
   173→  const newPlan = createPlan(planInput);
   174→  const planRef = `@${planSlug}`;
   175→
   176→  // Initialize result
   177→  const result: ImportResult = {
   178→    createdSpecs: [],
   179→    updatedSpecs: [],
   180→    createdTasks: [],
   181→    errors: [],
   182→    skipped: [],
   183→    planRef,
   184→  };
   185→
   186→  // Track newly created specs for parent resolution
   187→  // AC: @plan-import ac-16 - Resolve local references
   188→  const createdSpecsMap = new Map<string, LoadedSpecItem>();
   189→
   190→  // Process specs
   191→  // AC: @plan-import ac-14, ac-16, ac-17, ac-22, ac-23, ac-25, ac-26, ac-29
   192→  for (let i = 0; i < sorted.length; i++) {
   193→    const spec = sorted[i];
   194→    try {
   195→      // Validate required fields first
   196→      // AC: @plan-import ac-22
   197→      if (!spec.title) {
   198→        const errMsg = `Spec at index ${i} missing required field: title`;
   199→        warn(errMsg);
   200→        result.errors.push({ message: errMsg, spec });
   201→        continue;
   202→      }
   203→
   204→      const specSlug = spec.slug || generateSlug(spec.title);
   205→      const specRef = `@${specSlug}`;
   206→
   207→      // Check if spec already exists
   208→      const exists = refIndex.resolve(specRef);
   209→
   210→      if (exists.ok && !options.update) {
   211→        // AC: @plan-import ac-14, ac-25 - Skip existing specs
   212→        warn(`Skipping existing spec: ${specRef}`);
   213→        result.skipped.push({ slug: specSlug, reason: "Already exists" });
   214→        continue;
   215→      }
   216→
   217→      if (exists.ok && options.update) {
   218→        // AC: @plan-import ac-26 - Update existing spec
   219→        if (options.dryRun) {
   220→          info(`Would update spec: ${specRef}`);
   221→          result.updatedSpecs.push(specRef);
   222→        } else {
   223→          // Update logic would go here - for now, skip
   224→          info(`Updated spec: ${specRef}`);
   225→          result.updatedSpecs.push(specRef);
   226→        }
   227→        continue;
   228→      }
   229→
   230→      // Resolve parent reference
   231→      // AC: @plan-import ac-16, ac-17
   232→      let parent: LoadedSpecItem | null = null;
   233→      if (spec.parent) {
   234→        const parentRef = spec.parent.startsWith("@")
   235→          ? spec.parent
   236→          : `@${spec.parent}`;
   237→
   238→        // Check if parent was just created in this import
   239→        const parentSlug = parentRef.slice(1);
   240→        if (createdSpecsMap.has(parentSlug)) {
   241→          parent = createdSpecsMap.get(parentSlug)!;
   242→        } else {
   243→          // Check existing specs
   244→          const parentResult = refIndex.resolve(parentRef);
   245→
   246→          if (!parentResult.ok) {
   247→            // AC: @plan-import ac-17, ac-33 - Missing parent with hint
   248→            const errMsg = `Parent ${parentRef} not found. Check parent exists or define it earlier in plan`;
   249→            warn(errMsg);
   250→            result.errors.push({ message: errMsg, spec });
   251→            result.skipped.push({ slug: specSlug, reason: "Missing parent" });
   252→            continue;
   253→          }
   254→
   255→          parent = parentResult.item as LoadedSpecItem;
   256→        }
   257→      }
   258→
   259→      if (options.dryRun) {
   260→        // AC: @plan-import ac-15 - Dry run mode
   261→        info(
   262→          `Would create spec: ${specRef} ${spec.parent ? `under ${spec.parent}` : "(root)"}`,
   263→        );
   264→        result.createdSpecs.push(specRef);
   265→
   266→        // Track would-be created spec for parent resolution in dry-run
   267→        const dryRunSpec = createSpecItem({
   268→          title: spec.title,
   269→          type: (spec.type as any) || "feature",
   270→          slugs: [specSlug],
   271→          description: spec.description,
   272→          priority: undefined,
   273→          tags: [],
   274→          depends_on: [],
   275→          implements: [],
   276→          relates_to: [],
   277→          tests: [],
   278→          traits: spec.traits || [],
   279→          notes: [],
   280→        }) as LoadedSpecItem;
   281→        createdSpecsMap.set(specSlug, dryRunSpec);
   282→      } else {
   283→        // Create spec item
   284→        const specInput: SpecItemInput = {
   285→          title: spec.title,
   286→          type: (spec.type as any) || "feature",
   287→          slugs: [specSlug],
   288→          description: spec.description,
   289→          priority: undefined,
   290→          tags: [],
   291→          depends_on: [],
   292→          implements: [],
   293→          relates_to: [],
   294→          tests: [],
   295→          traits: spec.traits || [],
   296→          notes: [],
   297→        };
   298→
   299→        // Add acceptance criteria if present
   300→        if (spec.acceptance_criteria) {
   301→          specInput.acceptance_criteria = spec.acceptance_criteria;
   302→        }
   303→
   304→        const newSpec = createSpecItem(specInput);
   305→
   306→        // Add spec to parent (or module if no parent)
   307→        const actualParent = parent || moduleItem;
   308→        const addResult = await addChildItem(ctx, actualParent, newSpec);
   309→
   310→        // Track the created spec for parent resolution
   311→        const createdSpec = addResult.item as LoadedSpecItem;
   312→        createdSpecsMap.set(specSlug, createdSpec);
   313→
   314→        result.createdSpecs.push(specRef);
   315→        newPlan.derived_specs.push(specRef);
   316→
   317→        info(`Created spec: ${specRef}`);
   318→      }
   319→    } catch (err) {
   320→      const errMsg = `Failed to create spec "${spec.title}": ${err instanceof Error ? err.message : String(err)}`;
   321→      warn(errMsg);
   322→      result.errors.push({ message: errMsg, spec });
   323→    }
   324→  }
   325→
   326→  // Derive tasks from specs
   327→  // AC: @plan-import ac-12, ac-13, ac-19, ac-20
   328→  if (parsed.tasks.derive_from_specs && result.createdSpecs.length > 0) {
   329→    const tasks = await loadAllTasks(ctx);
   330→
   331→    for (const specRef of result.createdSpecs) {
   332→      // Get spec from createdSpecsMap (works in both dry-run and real mode)
   333→      const specSlug = specRef.slice(1);
   334→      const spec = createdSpecsMap.get(specSlug);
   335→      if (!spec) continue;
   336→
   337→      // AC: @plan-import ac-20 - Task title follows "Implement X" pattern
   338→      const taskTitle = `Implement ${spec.title}`;
   339→      const taskSlug = generateSlug(taskTitle);
   340→
   341→      // Ensure slug uniqueness
   342→      let uniqueSlug = taskSlug;
   343→      let counter = 1;
   344→      while (tasks.some((t) => t.slugs.includes(uniqueSlug))) {
   345→        uniqueSlug = `${taskSlug}-${counter}`;
   346→        counter++;
   347→      }
   348→
   349→      if (options.dryRun) {
   350→        info(`Would derive task: @${uniqueSlug} from ${specRef}`);
   351→        result.createdTasks.push(`@${uniqueSlug}`);
   352→      } else {
   353→        // AC: @plan-import ac-19 - Task has both spec_ref and plan_ref
   354→        const taskInput: TaskInput = {
   355→          title: taskTitle,
   356→          type: "task",
   357→          spec_ref: specRef,
   358→          plan_ref: planRef,
   359→          priority: 3,
   360→          slugs: [uniqueSlug],
   361→          tags: [],
   362→          depends_on: [],
   363→          notes: [],
   364→        };
   365→
   366→        const newTask = createTask(taskInput);
   367→
   368→        // AC: @plan-import ac-13 - Add implementation notes
   369→        if (parsed.implementationNotes) {
   370→          newTask.notes.push({
   371→            _ulid: ulid(),
   372→            created_at: new Date().toISOString(),
   373→            author,
   374→            content: `Implementation notes from plan:\n\n${parsed.implementationNotes}`,
   375→          });
   376→        }
   377→
   378→        await saveTask(ctx, newTask);
   379→        result.createdTasks.push(`@${uniqueSlug}`);
   380→        newPlan.derived_tasks.push(`@${uniqueSlug}`);
   381→
   382→        info(`Derived task: @${uniqueSlug}`);
   383→      }
   384→    }
   385→  }
   386→
   387→  // Create manual tasks
   388→  // AC: @plan-import ac-27
   389→  if (parsed.tasks.additional_tasks) {
   390→    const tasks = await loadAllTasks(ctx);
   391→
   392→    for (const taskDef of parsed.tasks.additional_tasks) {
   393→      const taskSlug = taskDef.slug || generateSlug(taskDef.title);
   394→
   395→      // Ensure slug uniqueness
   396→      let uniqueSlug = taskSlug;
   397→      let counter = 1;
   398→      while (tasks.some((t) => t.slugs.includes(uniqueSlug))) {
   399→        uniqueSlug = `${taskSlug}-${counter}`;
   400→        counter++;
   401→      }
   402→
   403→      if (options.dryRun) {
   404→        info(`Would create manual task: @${uniqueSlug}`);
   405→        result.createdTasks.push(`@${uniqueSlug}`);
   406→      } else {
   407→        // AC: @plan-import ac-27 - Manual tasks have plan_ref but no spec_ref
   408→        const taskInput: TaskInput = {
   409→          title: taskDef.title,
   410→          type: "task",
   411→          plan_ref: planRef,
   412→          priority: taskDef.priority || 3,
   413→          slugs: [uniqueSlug],
   414→          tags: taskDef.tags || [],
   415→          depends_on: [],
   416→          notes: [],
   417→        };
   418→
   419→        if (taskDef.description) {
   420→          taskInput.notes = [
   421→            {
   422→              _ulid: ulid(),
   423→              created_at: new Date().toISOString(),
   424→              author,
   425→              content: taskDef.description,
   426→            },
   427→          ];
   428→        }
   429→
   430→        const newTask = createTask(taskInput);
   431→        await saveTask(ctx, newTask);
   432→        result.createdTasks.push(`@${uniqueSlug}`);
   433→        newPlan.derived_tasks.push(`@${uniqueSlug}`);
   434→
   435→        info(`Created manual task: @${uniqueSlug}`);
   436→      }
   437→    }
   438→  }
   439→
   440→  // Save plan record
   441→  // AC: @plan-import ac-24
   442→  if (!options.dryRun) {
   443→    await savePlan(ctx, newPlan);
   444→    await commitIfShadow(ctx.shadow, "plan-import", planSlug, parsed.title);
   445→  }
   446→
   447→  // AC: @plan-import ac-23, ac-29 - Summary output
   448→  const successCount =
   449→    result.createdSpecs.length +
   450→    result.updatedSpecs.length +
   451→    result.createdTasks.length;
   452→  const errorCount = result.errors.length + result.skipped.length;
   453→
   454→  // AC: @plan-import ac-32 - JSON output
   455→  if (options.json) {
   456→    output({
   457→      plan: planRef,
   458→      created_specs: result.createdSpecs,
   459→      updated_specs: result.updatedSpecs,
   460→      created_tasks: result.createdTasks,
   461→      errors: result.errors,
   462→      skipped: result.skipped,
   463→    });
   464→  } else {
   465→    // Human-readable output
   466→    if (options.dryRun) {
   467→      console.log("\nDry run - no changes made\n");
   468→    }
   469→
   470→    console.log(`Plan: ${planRef}`);
   471→    console.log(`Created ${result.createdSpecs.length} specs`);
   472→    if (result.updatedSpecs.length > 0) {
   473→      console.log(`Updated ${result.updatedSpecs.length} specs`);
   474→    }
   475→    console.log(`Created ${result.createdTasks.length} tasks`);
   476→
   477→    if (result.errors.length > 0) {
   478→      console.log(`\nErrors (${result.errors.length}):`);
   479→      for (const err of result.errors) {
   480→        console.log(`  - ${err.message}`);
   481→      }
   482→    }
   483→
   484→    if (result.skipped.length > 0) {
   485→      console.log(`\nSkipped (${result.skipped.length}):`);
   486→      for (const skip of result.skipped) {
   487→        console.log(`  - @${skip.slug}: ${skip.reason}`);
   488→      }
   489→    }
   490→
   491→    // AC: @plan-import ac-15, ac-23 - Exit code 0 on success
   492→    if (!options.dryRun && successCount > 0) {
   493→      success(
   494→        `\nImported plan: ${successCount} items created, ${errorCount} errors`,
   495→      );
   496→    }
   497→  }
   498→
   499→  // Exit code logic
   500→  // AC: @plan-import ac-15 - Dry run exits 0
   501→  // AC: @plan-import ac-23 - Success with some errors still exits 0
   502→  process.exit(EXIT_CODES.SUCCESS);
   503→}
   504→
   505→/**
   506→ * Generate URL-safe slug from title
   507→ */
   508→function generateSlug(title: string): string {
   509→  return title
   510→    .toLowerCase()
   511→    .replace(/[^a-z0-9]+/g, "-")
   512→    .replace(/^-|-$/g, "")
   513→    .slice(0, 50);
   514→}
   515→

<system-reminder>
Whenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.
</system-reminder>
