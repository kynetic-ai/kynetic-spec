```
     1→/**
     2→ * Plan CLI commands
     3→ * AC: @plan-crud ac-1, ac-2, ac-3, ac-4, ac-7, ac-8, ac-9, ac-30, ac-31
     4→ */
     5→
     6→import * as fs from "node:fs/promises";
     7→import * as path from "node:path";
     8→import type { Command } from "commander";
     9→import {
    10→  createPlan,
    11→  createTask,
    12→  findPlanByRef,
    13→  filterPlansByStatus,
    14→  getAuthor,
    15→  initContext,
    16→  type LoadedPlan,
    17→  loadAllTasks,
    18→  loadPlans,
    19→  savePlan,
    20→  saveTask,
    21→} from "../../parser/index.js";
    22→import { commitIfShadow } from "../../parser/shadow.js";
    23→import type { PlanInput, TaskInput } from "../../schema/index.js";
    24→import { errors } from "../../strings/index.js";
    25→import { fieldLabels } from "../../strings/labels.js";
    26→import { formatRelativeTime as formatRelativeTimeUtil } from "../../utils/time.js";
    27→import { EXIT_CODES } from "../exit-codes.js";
    28→import { error, info, output, success } from "../output.js";
    29→import { ulid } from "ulid";
    30→
    31→/**
    32→ * Format relative time for display
    33→ */
    34→function formatRelativeTime(dateStr: string): string {
    35→  return formatRelativeTimeUtil(new Date(dateStr));
    36→}
    37→
    38→/**
    39→ * Resolve plan ref with error handling
    40→ * AC: @plan-crud ac-8 - get plan by reference
    41→ */
    42→function resolvePlanRef(ref: string, plans: LoadedPlan[]): LoadedPlan {
    43→  const cleanRef = ref.startsWith("@") ? ref.slice(1) : ref;
    44→  const plan = plans.find(
    45→    (p) =>
    46→      p._ulid === cleanRef ||
    47→      p._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()) ||
    48→      p.slugs.includes(cleanRef),
    49→  );
    50→
    51→  if (!plan) {
    52→    error(errors.reference.planNotFound(ref));
    53→    process.exit(EXIT_CODES.NOT_FOUND);
    54→  }
    55→
    56→  return plan;
    57→}
    58→
    59→/**
    60→ * Register the 'plan' command group
    61→ */
    62→export function registerPlanCommands(program: Command): void {
    63→  const plan = program
    64→    .command("plan")
    65→    .description("Manage implementation plans");
    66→
    67→  // kspec plan add
    68→  // AC: @plan-crud ac-1, ac-2
    69→  plan
    70→    .command("add")
    71→    .description("Create a new plan")
    72→    .requiredOption("--title <title>", "Plan title")
    73→    .option("--content <text>", "Plan content (markdown)")
    74→    .option("--content-file <path>", "Read content from markdown file")
    75→    .option("--status <status>", "Initial status (default: draft)")
    76→    .option("--slug <slug>", "Optional slug for the plan")
    77→    .addHelpText(
    78→      "after",
    79→      `
    80→Examples:
    81→  $ kspec plan add --title "User Auth" --content "Implement JWT auth..."
    82→  $ kspec plan add --title "API Refactor" --content-file ./plan.md`,
    83→    )
    84→    .action(async (options) => {
    85→      try {
    86→        const ctx = await initContext();
    87→
    88→        // Validate content options
    89→        if (options.content && options.contentFile) {
    90→          error(
    91→            "Cannot specify both --content and --content-file. Choose one.",
    92→          );
    93→          process.exit(EXIT_CODES.USAGE_ERROR);
    94→        }
    95→
    96→        // Read content from file if specified
    97→        // AC: @plan-crud ac-2
    98→        let content = options.content || "";
    99→        if (options.contentFile) {
   100→          const contentPath = path.resolve(process.cwd(), options.contentFile);
   101→          try {
   102→            content = await fs.readFile(contentPath, "utf-8");
   103→          } catch (err) {
   104→            error(`Failed to read content file: ${options.contentFile}`, err);
   105→            process.exit(EXIT_CODES.ERROR);
   106→          }
   107→        }
   108→
   109→        const input: PlanInput = {
   110→          title: options.title,
   111→          content,
   112→          status: options.status || "draft",
   113→          slugs: options.slug ? [options.slug] : [],
   114→        };
   115→
   116→        const newPlan = createPlan(input);
   117→        await savePlan(ctx, newPlan);
   118→
   119→        // AC: @plan-crud ac-1 - auto-commit to shadow branch
   120→        await commitIfShadow(ctx.shadow, "plan-add", newPlan.slugs[0] || newPlan._ulid.slice(0, 8), options.title);
   121→
   122→        success(`Created plan: ${newPlan._ulid.slice(0, 8)} - ${newPlan.title}`, {
   123→          plan: newPlan,
   124→        });
   125→      } catch (err) {
   126→        error(errors.failures.createPlan, err);
   127→        process.exit(EXIT_CODES.ERROR);
   128→      }
   129→    });
   130→
   131→  // kspec plan get <ref>
   132→  // AC: @plan-crud ac-8, ac-30
   133→  plan
   134→    .command("get <ref>")
   135→    .description("Show plan details")
   136→    .option("--json", "Output as JSON")
   137→    .action(async (ref: string, options) => {
   138→      try {
   139→        const ctx = await initContext();
   140→        const plans = await loadPlans(ctx);
   141→        const foundPlan = resolvePlanRef(ref, plans);
   142→
   143→        // AC: @plan-crud ac-30 - JSON output
   144→        output(foundPlan, () => {
   145→          // AC: @plan-crud ac-8 - full plan display
   146→          console.log(`${fieldLabels.ulid}     ${foundPlan._ulid}`);
   147→          console.log(`${fieldLabels.title}    ${foundPlan.title}`);
   148→          console.log(`${fieldLabels.status}   ${foundPlan.status}`);
   149→
   150→          if (foundPlan.slugs.length > 0) {
   151→            console.log(`Slugs:    ${foundPlan.slugs.join(", ")}`);
   152→          }
   153→
   154→          console.log(
   155→            `${fieldLabels.created}  ${foundPlan.created_at} (${formatRelativeTime(foundPlan.created_at)})`,
   156→          );
   157→
   158→          if (foundPlan.approved_at) {
   159→            console.log(
   160→              `Approved: ${foundPlan.approved_at} (${formatRelativeTime(foundPlan.approved_at)})`,
   161→            );
   162→          }
   163→
   164→          if (foundPlan.completed_at) {
   165→            console.log(
   166→              `Completed: ${foundPlan.completed_at} (${formatRelativeTime(foundPlan.completed_at)})`,
   167→            );
   168→          }
   169→
   170→          // Show derived work
   171→          if (
   172→            foundPlan.derived_tasks.length > 0 ||
   173→            foundPlan.derived_specs.length > 0
   174→          ) {
   175→            console.log("\nDerived Work:");
   176→            if (foundPlan.derived_specs.length > 0) {
   177→              console.log(
   178→                `  Specs: ${foundPlan.derived_specs.join(", ")}`,
   179→              );
   180→            }
   181→            if (foundPlan.derived_tasks.length > 0) {
   182→              console.log(
   183→                `  Tasks: ${foundPlan.derived_tasks.join(", ")}`,
   184→              );
   185→            }
   186→          }
   187→
   188→          // Show content
   189→          if (foundPlan.content) {
   190→            console.log("\n─── Content ───");
   191→            console.log(foundPlan.content);
   192→          }
   193→
   194→          // Show notes
   195→          if (foundPlan.notes.length > 0) {
   196→            console.log("\n─── Notes ───");
   197→            for (const note of foundPlan.notes) {
   198→              const age = formatRelativeTime(note.created_at);
   199→              const author = note.author ? ` by ${note.author}` : "";
   200→              console.log(`\n[${age}${author}]`);
   201→              console.log(note.content);
   202→            }
   203→          }
   204→        });
   205→      } catch (err) {
   206→        error(errors.failures.getPlan, err);
   207→        process.exit(EXIT_CODES.ERROR);
   208→      }
   209→    });
   210→
   211→  // kspec plan set <ref>
   212→  // AC: @plan-crud ac-3, ac-4
   213→  plan
   214→    .command("set <ref>")
   215→    .description("Update plan fields")
   216→    .option("--title <title>", "Update title")
   217→    .option("--status <status>", "Update status")
   218→    .option("--slug <slug>", "Add a slug")
   219→    .action(async (ref: string, options) => {
   220→      try {
   221→        const ctx = await initContext();
   222→        const plans = await loadPlans(ctx);
   223→        const foundPlan = resolvePlanRef(ref, plans);
   224→
   225→        // AC: @plan-crud ac-4 - prevent transitions from terminal states
   226→        if (
   227→          options.status &&
   228→          (foundPlan.status === "completed" || foundPlan.status === "rejected")
   229→        ) {
   230→          error("Cannot transition from terminal status");
   231→          process.exit(EXIT_CODES.CONFLICT);
   232→        }
   233→
   234→        const changes: string[] = [];
   235→
   236→        if (options.title) {
   237→          foundPlan.title = options.title;
   238→          changes.push("title");
   239→        }
   240→
   241→        if (options.status) {
   242→          const oldStatus = foundPlan.status;
   243→          foundPlan.status = options.status;
   244→          changes.push(`status: ${oldStatus} → ${options.status}`);
   245→
   246→          // AC: @plan-crud ac-3 - set approved_at timestamp when transitioning to approved
   247→          if (options.status === "approved" && !foundPlan.approved_at) {
   248→            foundPlan.approved_at = new Date().toISOString();
   249→          }
   250→        }
   251→
   252→        if (options.slug) {
   253→          if (!foundPlan.slugs.includes(options.slug)) {
   254→            foundPlan.slugs.push(options.slug);
   255→            changes.push(`slug: +${options.slug}`);
   256→          }
   257→        }
   258→
   259→        if (changes.length === 0) {
   260→          info("No changes specified");
   261→          return;
   262→        }
   263→
   264→        await savePlan(ctx, foundPlan);
   265→        await commitIfShadow(
   266→          ctx.shadow,
   267→          "plan-set",
   268→          foundPlan.slugs[0] || foundPlan._ulid.slice(0, 8),
   269→          changes.join(", "),
   270→        );
   271→
   272→        success(`Updated plan: ${foundPlan._ulid.slice(0, 8)}`, {
   273→          changes,
   274→          plan: foundPlan,
   275→        });
   276→      } catch (err) {
   277→        error(errors.failures.updatePlan, err);
   278→        process.exit(EXIT_CODES.ERROR);
   279→      }
   280→    });
   281→
   282→  // kspec plan list
   283→  // AC: @plan-crud ac-7, ac-31
   284→  plan
   285→    .command("list")
   286→    .description("List plans")
   287→    .option("--status <status>", "Filter by status")
   288→    .option("--json", "Output as JSON array")
   289→    .action(async (options) => {
   290→      try {
   291→        const ctx = await initContext();
   292→        let plans = await loadPlans(ctx);
   293→
   294→        // AC: @plan-crud ac-7 - status filter
   295→        if (options.status) {
   296→          plans = filterPlansByStatus(plans, options.status);
   297→        }
   298→
   299→        // Sort by created date (newest first)
   300→        plans.sort(
   301→          (a, b) =>
   302→            new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   303→        );
   304→
   305→        // AC: @plan-crud ac-31 - JSON output
   306→        output(plans, () => {
   307→          if (plans.length === 0) {
   308→            console.log("No plans found");
   309→            return;
   310→          }
   311→
   312→          console.log(`Plans (${plans.length}):\n`);
   313→
   314→          for (const p of plans) {
   315→            const ref = p._ulid.slice(0, 8);
   316→            const age = formatRelativeTime(p.created_at);
   317→            const taskCount = p.derived_tasks.length;
   318→            const tasks =
   319→              taskCount > 0 ? ` [${taskCount} task${taskCount > 1 ? "s" : ""}]` : "";
   320→
   321→            console.log(
   322→              `  ${ref} [${p.status}]${tasks} ${p.title}`,
   323→            );
   324→            console.log(`         Created ${age}`);
   325→
   326→            if (p.approved_at) {
   327→              console.log(
   328→                `         Approved ${formatRelativeTime(p.approved_at)}`,
   329→              );
   330→            }
   331→
   332→            console.log("");
   333→          }
   334→        });
   335→      } catch (err) {
   336→        error(errors.failures.listPlans, err);
   337→        process.exit(EXIT_CODES.ERROR);
   338→      }
   339→    });
   340→
   341→  // kspec plan note <ref> <text>
   342→  // AC: @plan-crud ac-9
   343→  plan
   344→    .command("note <ref> <text>")
   345→    .description("Add a note to a plan")
   346→    .action(async (ref: string, text: string) => {
   347→      try {
   348→        const ctx = await initContext();
   349→        const author = getAuthor();
   350→        const plans = await loadPlans(ctx);
   351→        const foundPlan = resolvePlanRef(ref, plans);
   352→
   353→        // AC: @plan-crud ac-9 - append note with ULID, timestamp, author
   354→        const note = {
   355→          _ulid: ulid(),
   356→          created_at: new Date().toISOString(),
   357→          author,
   358→          content: text,
   359→        };
   360→
   361→        foundPlan.notes.push(note);
   362→        await savePlan(ctx, foundPlan);
   363→        await commitIfShadow(
   364→          ctx.shadow,
   365→          "plan-note",
   366→          foundPlan.slugs[0] || foundPlan._ulid.slice(0, 8),
   367→        );
   368→
   369→        success(`Added note to plan: ${foundPlan._ulid.slice(0, 8)}`, {
   370→          note,
   371→        });
   372→      } catch (err) {
   373→        error(errors.failures.addPlanNote, err);
   374→        process.exit(EXIT_CODES.ERROR);
   375→      }
   376→    });
   377→
   378→  // kspec plan derive <ref>
   379→  // AC: @plan-derive ac-5, ac-6
   380→  plan
   381→    .command("derive <ref>")
   382→    .description("Create a task from a plan")
   383→    .option("--title <title>", "Override task title")
   384→    .option("--priority <n>", "Set task priority (1-5)", parseInt)
   385→    .addHelpText(
   386→      "after",
   387→      `
   388→Examples:
   389→  $ kspec plan derive @plan-ref
   390→  $ kspec plan derive @plan-ref --title "Custom title"
   391→  $ kspec plan derive @plan-ref --priority 1`,
   392→    )
   393→    .action(async (ref: string, options) => {
   394→      try {
   395→        const ctx = await initContext();
   396→        const plans = await loadPlans(ctx);
   397→        const tasks = await loadAllTasks(ctx);
   398→        const foundPlan = resolvePlanRef(ref, plans);
   399→
   400→        // AC: @plan-derive ac-5 - check plan status
   401→        if (foundPlan.status !== "approved" && foundPlan.status !== "active") {
   402→          error(
   403→            `Plan must be in 'approved' or 'active' status to derive tasks (current: ${foundPlan.status})`,
   404→          );
   405→          process.exit(EXIT_CODES.USAGE_ERROR);
   406→        }
   407→
   408→        // Generate task slug from plan title
   409→        const generateSlug = (title: string): string => {
   410→          return title
   411→            .toLowerCase()
   412→            .replace(/[^a-z0-9]+/g, "-")
   413→            .replace(/^-|-$/g, "")
   414→            .slice(0, 50);
   415→        };
   416→
   417→        // Generate task title and slug
   418→        const taskTitle = options.title || `Implement: ${foundPlan.title}`;
   419→        let taskSlug = generateSlug(taskTitle);
   420→
   421→        // Ensure slug uniqueness
   422→        let slugSuffix = 1;
   423→        const originalSlug = taskSlug;
   424→        while (tasks.some((t) => t.slugs.includes(taskSlug))) {
   425→          taskSlug = `${originalSlug}-${slugSuffix}`;
   426→          slugSuffix++;
   427→        }
   428→
   429→        // AC: @plan-derive ac-5 - create task with plan_ref
   430→        const planRef = foundPlan.slugs[0]
   431→          ? `@${foundPlan.slugs[0]}`
   432→          : `@${foundPlan._ulid.slice(0, 8)}`;
   433→
   434→        const taskInput: TaskInput = {
   435→          title: taskTitle,
   436→          type: "task",
   437→          plan_ref: planRef,
   438→          priority: options.priority ?? 3,
   439→          slugs: [taskSlug],
   440→          tags: [],
   441→          depends_on: [],
   442→          notes: [],
   443→        };
   444→
   445→        const newTask = createTask(taskInput);
   446→        await saveTask(ctx, newTask);
   447→
   448→        // AC: @plan-derive ac-5 - update plan's derived_tasks array
   449→        const taskRef = `@${taskSlug}`;
   450→        if (!foundPlan.derived_tasks.includes(taskRef)) {
   451→          foundPlan.derived_tasks.push(taskRef);
   452→        }
   453→
   454→        // AC: @plan-derive ac-5 - transition plan to active if not already
   455→        if (foundPlan.status === "approved") {
   456→          foundPlan.status = "active";
   457→        }
   458→
   459→        await savePlan(ctx, foundPlan);
   460→
   461→        await commitIfShadow(
   462→          ctx.shadow,
   463→          "plan-derive",
   464→          foundPlan.slugs[0] || foundPlan._ulid.slice(0, 8),
   465→          taskTitle,
   466→        );
   467→
   468→        success(`Created task from plan: ${taskRef}`, {
   469→          task: newTask,
   470→          plan: foundPlan,
   471→        });
   472→      } catch (err) {
   473→        error("Failed to derive task from plan", err);
   474→        process.exit(EXIT_CODES.ERROR);
   475→      }
   476→    });
   477→}
