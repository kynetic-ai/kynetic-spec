   319→/**
   320→ * Add a new inbox item
   321→ * AC: @web-dashboard ac-18
   322→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   323→ * AC: @gh-pages-export ac-17, ac-18 - Disabled in static mode
   324→ */
   325→export async function addInboxItem(text: string, tags?: string[]): Promise<InboxItem> {
   326→	// AC: @gh-pages-export ac-17, ac-18 - Write operations throw in static mode
   327→	assertWritable('add inbox item');
   328→
   329→	const response = await fetch(`${API_BASE}/api/inbox`, {
   330→		method: 'POST',
   331→		headers: {
   332→			'Content-Type': 'application/json',
   333→			...getProjectHeaders()
   334→		},
   335→		body: JSON.stringify({ text, tags })
   336→	});
   337→	if (!response.ok) {
   338→		await handleResponseError(response);
   339→	}
   340→
   341→	const result = await response.json();
   342→	return result.item;
   343→}
