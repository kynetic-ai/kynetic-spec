   552→/**
   553→ * Agent definition from GET /api/meta/agents
   554→ */
   555→export interface AgentDefinition {
   556→	_ulid: string;
   557→	id: string;
   558→	name: string;
   559→	description?: string;
   560→	adapter?: string;
   561→	dispatch: Array<{
   562→		on: string;
   563→		filter?: {
   564→			automation?: string;
   565→			tags?: string[];
   566→			priority?: number;
   567→		};
   568→	}>;
   569→	capabilities: string[];
   570→	tools: string[];
   571→	skills: string[];
   572→	budget?: {
   573→		max_tasks?: number;
   574→		timeout_minutes?: number;
   575→	};
   576→	concurrency: {
   577→		max_concurrent: number;
   578→	};
   579→	auto_approve: boolean;
   580→}
   581→
   582→/**
   583→ * Active invocation from GET /api/agent/status
   584→ */
