   655→/**
   656→ * Execute a triage action
   657→ * AC: @interactive-triage-ui ac-3
   658→ */
   659→export async function actOnTriageRecord(
   660→	ref: string
   661→): Promise<{ success: boolean; record: TriageRecord }> {
   662→	assertWritable('execute triage action');
   663→
   664→	const response = await fetch(`${API_BASE}/api/triage/${ref}/act`, {
   665→		method: 'POST',
   666→		headers: getProjectHeaders()
   667→	});
   668→	if (!response.ok) {
   669→		await handleResponseError(response);
   670→	}
   671→
   672→	return response.json();
   673→}
   674→
   675→// ============================================================
   676→// Session API Functions
   677→// AC: @ui-session-stream ac-1, ac-2, ac-4
   678→// ============================================================
   679→
   680→/**
   681→ * Session summary from the daemon API.
   682→ */
   683→export interface SessionSummary {
   684→	id: string;
   685→	status: 'active' | 'completed' | 'abandoned' | 'timed_out' | 'failed';
   686→	agent_type: string;
   687→	session_type: 'loop' | 'invocation';
   688→	started_at: string;
   689→	ended_at?: string;
   690→	duration_ms: number;
   691→	event_count: number;
   692→	iteration_count: number;
   693→	tasks_completed: number;
   694→}
   695→
   696→/**
   697→ * Spec context with acceptance criteria checklist.
   698→ * AC: @ui-session-stream ac-4
   699→ */
   700→export interface SessionSpecContext {
   701→	spec_ref: string;
   702→	title: string;
   703→	acceptance_criteria: Array<{ id: string; description: string }>;
   704→}
   705→
   706→/**
   707→ * Session budget info.
   708→ * AC: @ui-session-stream ac-4
   709→ */
   710→export interface SessionBudget {
   711→	max_per_cycle: number;
   712→	started_this_cycle: number;
   713→}
   714→
   715→/**
   716→ * Session detail with additional metadata.
   717→ * AC: @ui-session-stream ac-4
   718→ */
   719→export interface SessionDetail extends SessionSummary {
   720→	task_id?: string;
   721→	agent_id?: string;
   722→	trigger?: string;
   723→	spec_context?: SessionSpecContext | null;
   724→	budget?: SessionBudget | null;
   725→}
   726→
   727→/**
   728→ * A single event from events.jsonl.
   729→ */
   730→export interface SessionEvent {
   731→	ts: number;
   732→	seq: number;
   733→	type: string;
   734→	session_id: string;
   735→	trace_id?: string;
   736→	data: unknown;
   737→}
   738→
   739→/**
   740→ * Fetch all sessions with summaries.
   741→ * AC: @ui-session-stream ac-1
   742→ */
   743→export async function fetchSessions(): Promise<{ items: SessionSummary[]; total: number }> {
   744→	if (isStaticMode()) {
   745→		return { items: [], total: 0 };
   746→	}
   747→
   748→	const response = await fetch(`${API_BASE}/api/sessions`, {
   749→		headers: getProjectHeaders()
   750→	});
   751→	if (!response.ok) {
   752→		await handleResponseError(response);
   753→	}
   754→
   755→	return response.json();
   756→}
   757→
   758→/**
   759→ * Fetch a single session by ID.
   760→ * AC: @ui-session-stream ac-4
   761→ */
   762→export async function fetchSession(id: string): Promise<SessionDetail> {
   763→	if (isStaticMode()) {
   764→		throw new Error('Session data not available in static mode');
   765→	}
   766→
   767→	const response = await fetch(`${API_BASE}/api/sessions/${id}`, {
   768→		headers: getProjectHeaders()
   769→	});
   770→	if (!response.ok) {
   771→		await handleResponseError(response);
   772→	}
   773→
   774→	return response.json();
   775→}
   776→
   777→/**
   778→ * Fetch session events (optionally incremental via since_seq).
   779→ * AC: @ui-session-stream ac-1, ac-2
   780→ */
   781→export async function fetchSessionEvents(
   782→	id: string,
   783→	sinceSeq?: number
   784→): Promise<{ events: SessionEvent[]; total: number }> {
   785→	if (isStaticMode()) {
   786→		return { events: [], total: 0 };
   787→	}
   788→
   789→	const url = new URL(`${API_BASE}/api/sessions/${id}/events`);
   790→	if (sinceSeq !== undefined) {
   791→		url.searchParams.set('since_seq', String(sinceSeq));
   792→	}
   793→
   794→	const response = await fetch(url.toString(), {
   795→		headers: getProjectHeaders()
   796→	});
   797→	if (!response.ok) {
   798→		await handleResponseError(response);
   799→	}
   800→
   801→	return response.json();
   802→}
