   370→export async function fetchSessionContext(): Promise<SessionContext> {
   371→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   372→	if (isStaticMode()) {
   373→		const session = fetchSessionContextStatic();
   374→		if (!session) {
