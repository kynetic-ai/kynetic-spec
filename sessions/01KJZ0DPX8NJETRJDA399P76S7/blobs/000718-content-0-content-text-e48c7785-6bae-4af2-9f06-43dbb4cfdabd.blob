   462→
   463→  // Combined filters
   464→  it('should combine --status and --agent filters', () => {
   465→    const sessions = kspecJson<SessionLogSummary[]>(
   466→      'session log list --status active --agent custom-agent',
   467→      tempDir,
   468→    );
   469→    expect(sessions).toHaveLength(1);
   470→    expect(sessions[0].status).toBe('active');
   471→    expect(sessions[0].agent_type).toBe('custom-agent');
