   437→
   438→  // AC: @session-log-list ac-7
   439→  it('should limit output with --count flag (shows count only)', () => {
   440→    const result = kspec('session log list --count', tempDir);
   441→    expect(result.exitCode).toBe(0);
   442→    expect(result.stdout).toBe('3');
