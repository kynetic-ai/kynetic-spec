   444→
   445→  // AC: @session-log-list ac-7 (JSON --count)
   446→  it('should return count in JSON mode with --count', () => {
   447→    const data = kspecJson<{ count: number }>('session log list --count', tempDir);
   448→    expect(data.count).toBe(3);
   449→  });
   450→
   451→  // AC: @session-log-list ac-7 (--count with filters)
   452→  it('should respect filters with --count', () => {
   453→    const data = kspecJson<{ count: number }>('session log list --count --status completed', tempDir);
   454→    expect(data.count).toBe(2);
   455→  });
   456→
   457→  // --limit flag
   458→  it('should limit number of sessions with -n flag', () => {
   459→    const sessions = kspecJson<SessionLogSummary[]>('session log list -n 2', tempDir);
   460→    expect(sessions).toHaveLength(2);
