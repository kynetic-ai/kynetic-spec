     1→/**
     2→ * Session log list tests.
     3→ *
     4→ * Tests for the `kspec session log list` command and supporting store functions.
     5→ */
     6→
     7→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
     8→import * as fs from 'node:fs/promises';
     9→import * as os from 'node:os';
    10→import * as path from 'node:path';
    11→import * as YAML from 'yaml';
    12→import {
    13→  createSession,
    14→  appendEvent,
    15→  saveSessionContext,
    16→  getSessionLogSummary,
    17→  getAllSessionLogSummaries,
    18→  type SessionLogSummary,
    19→} from '../src/sessions/store.js';
    20→import type { SessionMetadataInput, SessionEventInput } from '../src/sessions/types.js';
    21→import {
    22→  setupTempFixtures,
    23→  cleanupTempDir,
    24→  kspec,
    25→  kspecJson,
    26→  testUlid,
    27→} from './helpers/cli';
    28→
    29→// ─── Store Unit Tests ───────────────────────────────────────────────────────
    30→
    31→describe('getSessionLogSummary', () => {
    32→  let testDir: string;
    33→
    34→  beforeEach(async () => {
    35→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-log-'));
    36→  });
    37→
    38→  afterEach(async () => {
    39→    await fs.rm(testDir, { recursive: true });
    40→  });
    41→
    42→  it('should return null for nonexistent session', async () => {
    43→    const summary = await getSessionLogSummary(testDir, 'nonexistent');
    44→    expect(summary).toBeNull();
    45→  });
    46→
    47→  // AC: @session-log-list ac-1
    48→  it('should return summary with all expected fields', async () => {
    49→    const sessionId = testUlid('SESS');
    50→    const startedAt = '2026-01-20T10:00:00.000Z';
    51→    const endedAt = '2026-01-20T11:30:00.000Z';
    52→
    53→    await createSession(testDir, {
    54→      id: sessionId,
    55→      agent_type: 'claude-agent-acp',
    56→      started_at: startedAt,
    57→    });
    58→
    59→    // Simulate completion by writing metadata directly
    60→    const metaPath = path.join(testDir, 'sessions', sessionId, 'session.yaml');
    61→    await fs.writeFile(metaPath, YAML.stringify({
    62→      id: sessionId,
    63→      agent_type: 'claude-agent-acp',
    64→      status: 'completed',
    65→      started_at: startedAt,
    66→      ended_at: endedAt,
    67→    }));
    68→
    69→    // Add some events
    70→    for (let i = 0; i < 5; i++) {
    71→      await appendEvent(testDir, {
    72→        type: i === 0 ? 'session.start' : 'prompt.sent',
    73→        session_id: sessionId,
    74→        data: null,
    75→      });
    76→    }
    77→
    78→    // Add context snapshots
    79→    await saveSessionContext(testDir, sessionId, 1, { iteration: 1 });
    80→    await saveSessionContext(testDir, sessionId, 2, { iteration: 2 });
    81→
    82→    const summary = await getSessionLogSummary(testDir, sessionId);
    83→    expect(summary).not.toBeNull();
    84→    expect(summary!.id).toBe(sessionId);
    85→    expect(summary!.status).toBe('completed');
    86→    expect(summary!.agent_type).toBe('claude-agent-acp');
    87→    expect(summary!.started_at).toBe(startedAt);
    88→    expect(summary!.ended_at).toBe(endedAt);
    89→    expect(summary!.duration_ms).toBe(5400000); // 1.5 hours
    90→    expect(summary!.event_count).toBe(5);
    91→    expect(summary!.iteration_count).toBe(2);
    92→    expect(summary!.tasks_completed).toBe(0);
    93→  });
    94→
    95→  it('should compute duration from now for active sessions', async () => {
    96→    const sessionId = testUlid('SESS', 1);
    97→    await createSession(testDir, {
    98→      id: sessionId,
    99→      agent_type: 'test-agent',
   100→    });
   101→
   102→    const summary = await getSessionLogSummary(testDir, sessionId);
   103→    expect(summary).not.toBeNull();
   104→    expect(summary!.status).toBe('active');
   105→    expect(summary!.duration_ms).toBeGreaterThan(0);
   106→    expect(summary!.ended_at).toBeUndefined();
   107→  });
   108→
   109→  it('should count task completions from realistic tool_call events', async () => {
   110→    const sessionId = testUlid('SESS', 2);
   111→    await createSession(testDir, {
   112→      id: sessionId,
   113→      agent_type: 'claude-agent-acp',
   114→    });
   115→
   116→    // Append events including realistic task complete tool calls
   117→    await appendEvent(testDir, {
   118→      type: 'session.start',
   119→      session_id: sessionId,
   120→      data: null,
   121→    });
   122→    // Write realistic session.update events with tool_call shape
   123→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   124→    const toolCallEvent1 = JSON.stringify({
   125→      ts: Date.now(),
   126→      seq: 1,
   127→      type: 'session.update',
   128→      session_id: sessionId,
   129→      data: {
   130→        iteration: 1,
   131→        update: {
   132→          _meta: { claudeCode: { toolName: 'Bash' } },
   133→          sessionUpdate: 'tool_call',
   134→          rawInput: { command: 'kspec task complete @my-task --reason "Done"' },
   135→        },
   136→      },
   137→    });
   138→    await fs.appendFile(eventsPath, toolCallEvent1 + '\n');
   139→    const toolCallEvent2 = JSON.stringify({
   140→      ts: Date.now(),
   141→      seq: 2,
   142→      type: 'session.update',
   143→      session_id: sessionId,
   144→      data: {
   145→        iteration: 1,
   146→        update: {
   147→          _meta: { claudeCode: { toolName: 'Bash' } },
   148→          sessionUpdate: 'tool_call',
   149→          rawInput: { command: 'npm run dev -- task complete @another-task --reason "All done"' },
   150→        },
   151→      },
   152→    });
   153→    await fs.appendFile(eventsPath, toolCallEvent2 + '\n');
   154→
   155→    const summary = await getSessionLogSummary(testDir, sessionId);
   156→    expect(summary!.tasks_completed).toBe(2);
   157→    expect(summary!.event_count).toBe(3); // session.start + 2 tool_call updates
   158→  });
   159→
   160→  // AC: @session-log-list ac-1 (claude-agent-acp: commands in tool_call_update events)
   161→  it('should count task completions from tool_call_update events (claude-agent-acp format)', async () => {
   162→    const sessionId = testUlid('SESS', 3);
   163→    await createSession(testDir, { id: sessionId, agent_type: 'claude-agent-acp' });
   164→
   165→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   166→    // claude-agent-acp: initial tool_call has empty rawInput, command arrives in tool_call_update
   167→    const emptyToolCall = JSON.stringify({
   168→      ts: Date.now(), seq: 1, type: 'session.update', session_id: sessionId,
   169→      data: { update: { sessionUpdate: 'tool_call', rawInput: {}, toolCallId: 'tc-1' } },
   170→    });
   171→    await fs.appendFile(eventsPath, emptyToolCall + '\n');
   172→    const populatedUpdate = JSON.stringify({
   173→      ts: Date.now(), seq: 2, type: 'session.update', session_id: sessionId,
   174→      data: { update: { sessionUpdate: 'tool_call_update', rawInput: { command: 'kspec task complete @my-task --reason "Done"', description: 'Complete task' }, toolCallId: 'tc-1' } },
   175→    });
   176→    await fs.appendFile(eventsPath, populatedUpdate + '\n');
   177→
   178→    const summary = await getSessionLogSummary(testDir, sessionId);
   179→    expect(summary!.tasks_completed).toBe(1);
   180→  });
   181→
   182→  // AC: @session-log-list ac-1 (codex-acp: command is array in tool_call events)
   183→  it('should count task completions from array commands (codex-acp format)', async () => {
   184→    const sessionId = testUlid('SESS', 4);
   185→    await createSession(testDir, { id: sessionId, agent_type: 'codex-acp' });
   186→
   187→    const eventsPath = path.join(testDir, 'sessions', sessionId, 'events.jsonl');
   188→    // codex-acp: command is ['/usr/bin/bash', '-lc', 'kspec task complete @ref']
   189→    const arrayCommandEvent = JSON.stringify({
   190→      ts: Date.now(), seq: 1, type: 'session.update', session_id: sessionId,
   191→      data: { update: { sessionUpdate: 'tool_call', rawInput: { command: ['/usr/bin/bash', '-lc', 'kspec task complete @my-task'] } } },
   192→    });
   193→    await fs.appendFile(eventsPath, arrayCommandEvent + '\n');
   194→
   195→    const summary = await getSessionLogSummary(testDir, sessionId);
   196→    expect(summary!.tasks_completed).toBe(1);
   197→  });
   198→});
   199→
   200→describe('getAllSessionLogSummaries', () => {
   201→  let testDir: string;
   202→
   203→  beforeEach(async () => {
   204→    testDir = await fs.mkdtemp(path.join(os.tmpdir(), 'kspec-session-log-all-'));
   205→  });
   206→
   207→  afterEach(async () => {
   208→    await fs.rm(testDir, { recursive: true });
   209→  });
   210→
   211→  // AC: @session-log-list ac-6
   212→  it('should return empty array when no sessions exist', async () => {
   213→    const summaries = await getAllSessionLogSummaries(testDir);
   214→    expect(summaries).toEqual([]);
   215→  });
   216→
   217→  it('should return summaries for all sessions', async () => {
   218→    const id1 = testUlid('SESS', 1);
   219→    const id2 = testUlid('SESS', 2);
   220→
   221→    await createSession(testDir, { id: id1, agent_type: 'agent-a' });
   222→    await createSession(testDir, { id: id2, agent_type: 'agent-b' });
   223→
   224→    const summaries = await getAllSessionLogSummaries(testDir);
   225→    expect(summaries).toHaveLength(2);
   226→    expect(summaries.map(s => s.id).sort()).toEqual([id1, id2].sort());
   227→  });
   228→});
