   481→
   482→  // Iteration counting
   483→  it('should count iterations correctly', () => {
   484→    const sessions = kspecJson<SessionLogSummary[]>('session log list --status active', tempDir);
   485→    expect(sessions).toHaveLength(1);
   486→    expect(sessions[0].iteration_count).toBe(3);
