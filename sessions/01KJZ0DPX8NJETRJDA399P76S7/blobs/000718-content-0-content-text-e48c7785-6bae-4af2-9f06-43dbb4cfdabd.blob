   230→// ─── CLI Integration Tests ──────────────────────────────────────────────────
   231→
   232→describe('kspec session log list (CLI)', () => {
   233→  let tempDir: string;
   234→
   235→  beforeEach(async () => {
   236→    tempDir = await setupTempFixtures();
   237→
   238→    // In traditional mode (no shadow branch), specDir = tempDir
   239→    // Sessions go in tempDir/sessions/
   240→    const sessionsDir = path.join(tempDir, 'sessions');
   241→    await fs.mkdir(sessionsDir, { recursive: true });
   242→
   243→    // Session 1: completed, old
   244→    const s1 = testUlid('SESS', 1);
   245→    const s1Dir = path.join(sessionsDir, s1);
   246→    await fs.mkdir(s1Dir);
   247→    await fs.writeFile(path.join(s1Dir, 'session.yaml'), YAML.stringify({
   248→      id: s1,
   249→      agent_type: 'claude-agent-acp',
   250→      status: 'completed',
   251→      started_at: '2026-01-15T10:00:00.000Z',
   252→      ended_at: '2026-01-15T11:30:00.000Z',
   253→    }));
   254→    await fs.writeFile(path.join(s1Dir, 'events.jsonl'), [
   255→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: s1, data: null }),
   256→      JSON.stringify({ ts: 2000, seq: 1, type: 'prompt.sent', session_id: s1, data: null }),
   257→      JSON.stringify({ ts: 3000, seq: 2, type: 'session.end', session_id: s1, data: null }),
   258→    ].join('\n') + '\n');
   259→    await fs.writeFile(path.join(s1Dir, 'context-iter-1.json'), '{}');
   260→
   261→    // Session 2: active, recent
   262→    const s2 = testUlid('SESS', 2);
   263→    const s2Dir = path.join(sessionsDir, s2);
   264→    await fs.mkdir(s2Dir);
   265→    await fs.writeFile(path.join(s2Dir, 'session.yaml'), YAML.stringify({
   266→      id: s2,
   267→      agent_type: 'custom-agent',
   268→      status: 'active',
   269→      started_at: '2026-02-05T08:00:00.000Z',
   270→    }));
   271→    await fs.writeFile(path.join(s2Dir, 'events.jsonl'), [
   272→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: s2, data: null }),
   273→      JSON.stringify({ ts: 2000, seq: 1, type: 'prompt.sent', session_id: s2, data: null }),
   274→      JSON.stringify({ ts: 3000, seq: 2, type: 'prompt.sent', session_id: s2, data: null }),
   275→      JSON.stringify({ ts: 4000, seq: 3, type: 'prompt.sent', session_id: s2, data: null }),
   276→      JSON.stringify({ ts: 5000, seq: 4, type: 'prompt.sent', session_id: s2, data: null }),
   277→    ].join('\n') + '\n');
   278→    await fs.writeFile(path.join(s2Dir, 'context-iter-1.json'), '{}');
   279→    await fs.writeFile(path.join(s2Dir, 'context-iter-2.json'), '{}');
   280→    await fs.writeFile(path.join(s2Dir, 'context-iter-3.json'), '{}');
   281→
   282→    // Session 3: completed, recent
   283→    const s3 = testUlid('SESS', 3);
   284→    const s3Dir = path.join(sessionsDir, s3);
   285→    await fs.mkdir(s3Dir);
   286→    await fs.writeFile(path.join(s3Dir, 'session.yaml'), YAML.stringify({
   287→      id: s3,
   288→      agent_type: 'claude-agent-acp',
   289→      status: 'completed',
   290→      started_at: '2026-02-04T14:00:00.000Z',
   291→      ended_at: '2026-02-04T15:00:00.000Z',
   292→    }));
   293→    await fs.writeFile(path.join(s3Dir, 'events.jsonl'), [
   294→      JSON.stringify({ ts: 1000, seq: 0, type: 'session.start', session_id: s3, data: null }),
   295→      JSON.stringify({
   296→        ts: 2000, seq: 1, type: 'session.update', session_id: s3,
   297→        data: {
   298→          iteration: 1,
   299→          update: {
   300→            _meta: { claudeCode: { toolName: 'Bash' } },
   301→            sessionUpdate: 'tool_call',
   302→            rawInput: { command: 'kspec task complete @task-1 --reason "Done"' },
   303→          },
   304→        },
   305→      }),
   306→    ].join('\n') + '\n');
   307→  });
   308→
   309→  afterEach(async () => {
   310→    await cleanupTempDir(tempDir);
   311→  });
   312→
   313→  // AC: @session-log-list ac-1
   314→  it('should display sessions in table format', () => {
   315→    const result = kspec('session log list', tempDir);
   316→    expect(result.exitCode).toBe(0);
   317→    expect(result.stdout).toContain('ID');
   318→    expect(result.stdout).toContain('Status');
   319→    expect(result.stdout).toContain('Agent');
   320→    expect(result.stdout).toContain('Started');
   321→    expect(result.stdout).toContain('Duration');
   322→    expect(result.stdout).toContain('Events');
   323→    expect(result.stdout).toContain('Iters');
   324→    expect(result.stdout).toContain('Tasks');
   325→    expect(result.stdout).toContain('3 session(s)');
   326→  });
   327→
   328→  // AC: @session-log-list ac-1 (JSON variant)
   329→  it('should output valid JSON with all fields in --json mode', () => {
   330→    const sessions = kspecJson<SessionLogSummary[]>('session log list', tempDir);
   331→    expect(sessions).toHaveLength(3);
   332→
   333→    for (const session of sessions) {
   334→      expect(session).toHaveProperty('id');
   335→      expect(session).toHaveProperty('status');
   336→      expect(session).toHaveProperty('agent_type');
   337→      expect(session).toHaveProperty('started_at');
   338→      expect(session).toHaveProperty('duration_ms');
   339→      expect(session).toHaveProperty('event_count');
   340→      expect(session).toHaveProperty('iteration_count');
   341→      expect(session).toHaveProperty('tasks_completed');
   342→    }
   343→  });
   344→
   345→  // AC: @session-log-list ac-2
   346→  it('should filter by --status', () => {
   347→    const sessions = kspecJson<SessionLogSummary[]>('session log list --status completed', tempDir);
   348→    expect(sessions).toHaveLength(2);
   349→    for (const s of sessions) {
   350→      expect(s.status).toBe('completed');
   351→    }
   352→  });
   353→
   354→  // AC: @session-log-list ac-2
   355→  it('should filter by --status active', () => {
   356→    const sessions = kspecJson<SessionLogSummary[]>('session log list --status active', tempDir);
   357→    expect(sessions).toHaveLength(1);
   358→    expect(sessions[0].status).toBe('active');
   359→    expect(sessions[0].agent_type).toBe('custom-agent');
   360→  });
   361→
   362→  // AC: @session-log-list ac-3
   363→  it('should filter by --since', () => {
   364→    const sessions = kspecJson<SessionLogSummary[]>('session log list --since 2026-02-01', tempDir);
   365→    // Only sessions 2 and 3 are after Feb 1
   366→    expect(sessions).toHaveLength(2);
   367→    for (const s of sessions) {
   368→      expect(new Date(s.started_at).getTime()).toBeGreaterThanOrEqual(new Date('2026-02-01').getTime());
   369→    }
   370→  });
   371→
   372→  // AC: @session-log-list ac-4
   373→  it('should filter by --agent', () => {
   374→    const sessions = kspecJson<SessionLogSummary[]>('session log list --agent custom-agent', tempDir);
   375→    expect(sessions).toHaveLength(1);
   376→    expect(sessions[0].agent_type).toBe('custom-agent');
   377→  });
   378→
   379→  // AC: @session-log-list ac-4
   380→  it('should filter by --agent for claude-agent-acp', () => {
   381→    const sessions = kspecJson<SessionLogSummary[]>('session log list --agent claude-agent-acp', tempDir);
   382→    expect(sessions).toHaveLength(2);
   383→    for (const s of sessions) {
   384→      expect(s.agent_type).toBe('claude-agent-acp');
   385→    }
   386→  });
   387→
   388→  // AC: @session-log-list ac-5
   389→  it('should sort by started_at descending by default', () => {
   390→    const sessions = kspecJson<SessionLogSummary[]>('session log list', tempDir);
   391→    expect(sessions).toHaveLength(3);
   392→    // Most recent first
   393→    for (let i = 1; i < sessions.length; i++) {
   394→      expect(new Date(sessions[i - 1].started_at).getTime())
   395→        .toBeGreaterThanOrEqual(new Date(sessions[i].started_at).getTime());
   396→    }
   397→  });
   398→
   399→  // AC: @session-log-list ac-5
   400→  it('should sort by events when --sort events is provided', () => {
   401→    const sessions = kspecJson<SessionLogSummary[]>('session log list --sort events', tempDir);
   402→    // Highest event count first
   403→    for (let i = 1; i < sessions.length; i++) {
   404→      expect(sessions[i - 1].event_count).toBeGreaterThanOrEqual(sessions[i].event_count);
   405→    }
   406→  });
   407→
   408→  // AC: @session-log-list ac-5
   409→  it('should sort by iterations when --sort iterations is provided', () => {
   410→    const sessions = kspecJson<SessionLogSummary[]>('session log list --sort iterations', tempDir);
   411→    for (let i = 1; i < sessions.length; i++) {
   412→      expect(sessions[i - 1].iteration_count).toBeGreaterThanOrEqual(sessions[i].iteration_count);
   413→    }
   414→  });
   415→
   416→  // AC: @session-log-list ac-6
   417→  it('should show "No sessions found" when no sessions exist', async () => {
   418→    // Remove all sessions
   419→    const sessionsDir = path.join(tempDir, 'sessions');
   420→    await fs.rm(sessionsDir, { recursive: true });
   421→    await fs.mkdir(sessionsDir);
   422→
   423→    const result = kspec('session log list', tempDir);
   424→    expect(result.exitCode).toBe(0);
   425→    expect(result.stdout).toContain('No sessions found');
