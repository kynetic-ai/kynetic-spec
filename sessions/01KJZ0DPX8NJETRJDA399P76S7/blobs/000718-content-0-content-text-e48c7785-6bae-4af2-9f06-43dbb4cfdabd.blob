   473→
   474→  // Task completion counting
   475→  it('should count task completions', () => {
   476→    const sessions = kspecJson<SessionLogSummary[]>('session log list --status completed', tempDir);
   477→    const withTasks = sessions.find(s => s.tasks_completed > 0);
   478→    expect(withTasks).toBeDefined();
   479→    expect(withTasks!.tasks_completed).toBe(1);
