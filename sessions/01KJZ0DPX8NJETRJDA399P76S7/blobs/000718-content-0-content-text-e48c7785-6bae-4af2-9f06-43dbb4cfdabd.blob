   427→
   428→  // AC: @session-log-list ac-6 (JSON variant)
   429→  it('should return empty array in JSON mode when no sessions exist', async () => {
   430→    const sessionsDir = path.join(tempDir, 'sessions');
   431→    await fs.rm(sessionsDir, { recursive: true });
   432→    await fs.mkdir(sessionsDir);
   433→
   434→    const sessions = kspecJson<SessionLogSummary[]>('session log list', tempDir);
   435→    expect(sessions).toEqual([]);
