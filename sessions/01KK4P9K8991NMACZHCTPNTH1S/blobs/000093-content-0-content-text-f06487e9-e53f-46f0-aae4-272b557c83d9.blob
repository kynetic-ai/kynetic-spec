```
     1→<!--
     2→  AC: @ui-settings-view ac-1 — Displays project config (name, version, remote tracking),
     3→  conventions list from meta, daemon connection info (port, uptime, version), and shadow branch
     4→  status. Read-only for v1.
     5→-->
     6→<script lang="ts">
     7→	import { onMount, onDestroy } from 'svelte';
     8→	import type { Convention } from '@kynetic-ai/shared';
     9→	import {
    10→		fetchHealth,
    11→		fetchProjectConfig,
    12→		fetchShadowStatus,
    13→		fetchConventions,
    14→		type HealthResponse,
    15→		type ProjectConfig,
    16→		type ShadowStatusResponse
    17→	} from '$lib/api';
    18→	import { isStaticMode } from '$lib/stores/mode.svelte';
    19→	import { subscribe, unsubscribe, on, off } from '$lib/stores/connection.svelte';
    20→	import { getProjectVersion, isInitialized as isProjectInitialized } from '$lib/stores/project.svelte';
    21→	import { Card, CardContent, CardHeader } from '$lib/components/ui/card';
    22→	import { Badge } from '$lib/components/ui/badge';
    23→	import SettingsIcon from '@lucide/svelte/icons/settings';
    24→	import ServerIcon from '@lucide/svelte/icons/server';
    25→	import GitBranchIcon from '@lucide/svelte/icons/git-branch';
    26→	import BookOpenIcon from '@lucide/svelte/icons/book-open';
    27→	import FolderIcon from '@lucide/svelte/icons/folder';
    28→	import ChevronDownIcon from '@lucide/svelte/icons/chevron-down';
    29→	import ChevronRightIcon from '@lucide/svelte/icons/chevron-right';
    30→
    31→	// ── Data state ──
    32→	let health = $state<HealthResponse | null>(null);
    33→	let projectConfig = $state<ProjectConfig | null>(null);
    34→	let shadowStatus = $state<ShadowStatusResponse | null>(null);
    35→	let conventions = $state<Convention[]>([]);
    36→
    37→	let loadingConfig = $state(true);
    38→	let loadingHealth = $state(true);
    39→	let loadingShadow = $state(true);
    40→	let loadingConventions = $state(true);
    41→
    42→	let errorConfig = $state('');
    43→	let errorHealth = $state('');
    44→	let errorShadow = $state('');
    45→	let errorConventions = $state('');
    46→
    47→	// Convention expand state
    48→	let expandedDomains = $state<Set<string>>(new Set());
    49→
    50→	// ── Lifecycle ──
    51→	onMount(() => {
    52→		if (!isStaticMode()) {
    53→			subscribe(['files:updates']);
    54→			on('files:updates', handleUpdate);
    55→		}
    56→	});
    57→
    58→	onDestroy(() => {
    59→		if (!isStaticMode()) {
    60→			off('files:updates', handleUpdate);
    61→			unsubscribe(['files:updates']);
    62→		}
    63→	});
    64→
    65→	// Load data when project is ready and reload on project change.
    66→	// Gates on isProjectInitialized() to prevent loading with wrong/missing project context.
    67→	$effect(() => {
    68→		const version = getProjectVersion();
    69→		const ready = isProjectInitialized();
    70→		if (!ready) return;
    71→		loadAllData();
    72→	});
    73→
    74→	// ── Data loading ──
    75→	async function loadAllData() {
    76→		await Promise.all([loadConfig(), loadHealth(), loadShadow(), loadConventions()]);
    77→	}
    78→
    79→	async function loadConfig() {
    80→		if (isStaticMode()) {
    81→			loadingConfig = false;
    82→			return;
    83→		}
    84→		try {
    85→			loadingConfig = true;
    86→			errorConfig = '';
    87→			projectConfig = await fetchProjectConfig();
    88→		} catch (err) {
    89→			errorConfig = err instanceof Error ? err.message : 'Failed to load project config';
    90→		} finally {
    91→			loadingConfig = false;
    92→		}
    93→	}
    94→
    95→	async function loadHealth() {
    96→		if (isStaticMode()) {
    97→			loadingHealth = false;
    98→			return;
    99→		}
   100→		try {
   101→			loadingHealth = true;
   102→			errorHealth = '';
   103→			health = await fetchHealth();
   104→		} catch (err) {
   105→			errorHealth = err instanceof Error ? err.message : 'Failed to connect to daemon';
   106→		} finally {
   107→			loadingHealth = false;
   108→		}
   109→	}
   110→
   111→	async function loadShadow() {
   112→		if (isStaticMode()) {
   113→			loadingShadow = false;
   114→			return;
   115→		}
   116→		try {
   117→			loadingShadow = true;
   118→			errorShadow = '';
   119→			shadowStatus = await fetchShadowStatus();
   120→		} catch (err) {
   121→			errorShadow = err instanceof Error ? err.message : 'Failed to load shadow status';
   122→		} finally {
   123→			loadingShadow = false;
   124→		}
   125→	}
   126→
   127→	async function loadConventions() {
   128→		if (isStaticMode()) {
   129→			loadingConventions = false;
   130→			return;
   131→		}
   132→		try {
   133→			loadingConventions = true;
   134→			errorConventions = '';
   135→			const response = await fetchConventions();
   136→			conventions = response.items;
   137→		} catch (err) {
   138→			errorConventions = err instanceof Error ? err.message : 'Failed to load conventions';
   139→		} finally {
   140→			loadingConventions = false;
   141→		}
   142→	}
   143→
   144→	function handleUpdate() {
   145→		loadAllData();
   146→	}
   147→
   148→	// ── Helpers ──
   149→	function formatUptime(seconds: number): string {
   150→		const h = Math.floor(seconds / 3600);
   151→		const m = Math.floor((seconds % 3600) / 60);
   152→		const s = Math.floor(seconds % 60);
   153→		if (h > 0) return `${h}h ${m}m ${s}s`;
   154→		if (m > 0) return `${m}m ${s}s`;
   155→		return `${s}s`;
   156→	}
   157→
   158→	function toggleDomain(domain: string) {
   159→		const next = new Set(expandedDomains);
   160→		if (next.has(domain)) {
   161→			next.delete(domain);
   162→		} else {
   163→			next.add(domain);
   164→		}
   165→		expandedDomains = next;
   166→	}
   167→
   168→	let loading = $derived(loadingConfig && loadingHealth && loadingShadow && loadingConventions);
   169→</script>
   170→
   171→<div class="flex flex-col gap-4 p-6">
   172→	<!-- Header -->
   173→	<div class="flex items-center justify-between">
   174→		<div>
   175→			<h1 class="text-2xl font-bold">Settings</h1>
   176→			{#if !loading}
   177→				<p class="text-sm text-muted-foreground" data-testid="settings-summary">
   178→					Project configuration and daemon status
   179→				</p>
   180→			{/if}
   181→		</div>
   182→	</div>
   183→
   184→	{#if isStaticMode()}
   185→		<!-- AC: @ui-settings-view ac-1 — Static mode graceful degradation -->
   186→		<div class="flex flex-col items-center justify-center py-16" data-testid="settings-static">
   187→			<SettingsIcon class="size-12 text-muted-foreground/30 mb-4" />
   188→			<h2 class="text-lg font-medium text-muted-foreground mb-1">Settings unavailable</h2>
   189→			<p class="text-sm text-muted-foreground">
   190→				Settings data is not available in static mode. Connect to a running daemon to view project configuration.
   191→			</p>
   192→		</div>
   193→	{:else}
   194→		<div class="grid gap-4 md:grid-cols-2">
   195→			<!-- ═══ Section 1: Project Configuration ═══ -->
   196→			<Card data-testid="settings-project-config">
   197→				<CardHeader class="pb-3">
   198→					<div class="flex items-center gap-2">
   199→						<FolderIcon class="size-4 text-muted-foreground" />
   200→						<h2 class="text-sm font-semibold">Project Configuration</h2>
   201→					</div>
   202→				</CardHeader>
   203→				<CardContent class="pt-0">
   204→					{#if loadingConfig}
   205→						<div class="flex flex-col gap-2" data-testid="settings-project-loading">
   206→							<div class="h-4 w-3/4 rounded bg-muted ds-shimmer"></div>
   207→							<div class="h-4 w-1/2 rounded bg-muted ds-shimmer"></div>
   208→							<div class="h-4 w-2/3 rounded bg-muted ds-shimmer"></div>
   209→						</div>
   210→					{:else if errorConfig}
   211→						<div class="text-sm text-destructive" data-testid="settings-project-error" role="alert">
   212→							{errorConfig}
   213→						</div>
   214→					{:else if projectConfig}
   215→						<dl class="flex flex-col gap-2 text-sm">
   216→							<div class="flex justify-between">
   217→								<dt class="text-muted-foreground">Name</dt>
   218→								<dd class="font-medium" data-testid="config-project-name">
   219→									{projectConfig.project?.name ?? 'Not configured'}
   220→								</dd>
   221→							</div>
   222→							<div class="flex justify-between">
   223→								<dt class="text-muted-foreground">Version</dt>
   224→								<dd class="font-mono text-xs" data-testid="config-project-version">
   225→									{projectConfig.project?.version ?? '—'}
   226→								</dd>
   227→							</div>
   228→							<div class="flex justify-between">
   229→								<dt class="text-muted-foreground">Status</dt>
   230→								<dd data-testid="config-project-status">
   231→									<Badge variant="secondary" class="text-xs">
   232→										{projectConfig.project?.status ?? '—'}
   233→									</Badge>
   234→								</dd>
   235→							</div>
   236→							<div class="flex justify-between">
   237→								<dt class="text-muted-foreground">Spec Version</dt>
   238→								<dd class="font-mono text-xs" data-testid="config-spec-version">
   239→									{projectConfig.spec_version ?? '—'}
   240→								</dd>
   241→							</div>
   242→							<div class="flex justify-between">
   243→								<dt class="text-muted-foreground">Root Directory</dt>
   244→								<dd class="font-mono text-xs truncate max-w-[200px]" title={projectConfig.root_dir} data-testid="config-root-dir">
   245→									{projectConfig.root_dir}
   246→								</dd>
   247→							</div>
   248→							<!-- AC: @ui-settings-view ac-1 — remote tracking -->
   249→							<div class="flex justify-between">
   250→								<dt class="text-muted-foreground">Remote Tracking</dt>
   251→								<dd data-testid="config-remote-tracking">
   252→									{#if projectConfig.remote_tracking}
   253→										<Badge variant="outline" class="text-xs">
   254→											{projectConfig.remote_tracking.type}: {projectConfig.remote_tracking.value}
   255→										</Badge>
   256→									{:else}
   257→										<span class="text-xs text-muted-foreground">None</span>
   258→									{/if}
   259→								</dd>
   260→							</div>
   261→						</dl>
   262→					{:else}
   263→						<div class="text-sm text-muted-foreground" data-testid="settings-project-empty">
   264→							No project configuration found.
   265→						</div>
   266→					{/if}
   267→				</CardContent>
   268→			</Card>
   269→
   270→			<!-- ═══ Section 2: Daemon Connection ═══ -->
   271→			<Card data-testid="settings-daemon">
   272→				<CardHeader class="pb-3">
   273→					<div class="flex items-center gap-2">
   274→						<ServerIcon class="size-4 text-muted-foreground" />
   275→						<h2 class="text-sm font-semibold">Daemon Connection</h2>
   276→					</div>
   277→				</CardHeader>
   278→				<CardContent class="pt-0">
   279→					{#if loadingHealth}
   280→						<div class="flex flex-col gap-2" data-testid="settings-daemon-loading">
   281→							<div class="h-4 w-3/4 rounded bg-muted ds-shimmer"></div>
   282→							<div class="h-4 w-1/2 rounded bg-muted ds-shimmer"></div>
   283→						</div>
   284→					{:else if errorHealth}
   285→						<div class="flex flex-col gap-2">
   286→							<div class="flex items-center gap-2">
   287→								<span class="size-2 rounded-full bg-severity-error"></span>
   288→								<span class="text-sm font-medium" data-testid="daemon-status">Disconnected</span>
   289→							</div>
   290→							<div class="text-sm text-destructive" data-testid="settings-daemon-error" role="alert">
   291→								{errorHealth}
   292→							</div>
   293→						</div>
   294→					{:else if health}
   295→						<dl class="flex flex-col gap-2 text-sm">
   296→							<div class="flex justify-between">
   297→								<dt class="text-muted-foreground">Status</dt>
   298→								<dd class="flex items-center gap-2" data-testid="daemon-status">
   299→									<span class="size-2 rounded-full bg-severity-success"></span>
   300→									<span class="font-medium">Connected</span>
   301→								</dd>
   302→							</div>
   303→							<div class="flex justify-between">
   304→								<dt class="text-muted-foreground">Version</dt>
   305→								<dd class="font-mono text-xs" data-testid="daemon-version">{health.version}</dd>
   306→							</div>
   307→							<div class="flex justify-between">
   308→								<dt class="text-muted-foreground">Uptime</dt>
   309→								<dd class="font-mono text-xs" data-testid="daemon-uptime">{formatUptime(health.uptime)}</dd>
   310→							</div>
   311→							<div class="flex justify-between">
   312→								<dt class="text-muted-foreground">Active Connections</dt>
   313→								<dd class="font-mono text-xs" data-testid="daemon-connections">{health.connections}</dd>
   314→							</div>
   315→							<!-- AC: @ui-settings-view ac-1 — daemon port -->
   316→							{#if projectConfig}
   317→								<div class="flex justify-between">
   318→									<dt class="text-muted-foreground">Port</dt>
   319→									<dd class="font-mono text-xs" data-testid="daemon-port">{projectConfig.daemon.port}</dd>
   320→								</div>
   321→							{/if}
   322→						</dl>
   323→					{/if}
   324→				</CardContent>
   325→			</Card>
   326→
   327→			<!-- ═══ Section 3: Shadow Branch ═══ -->
   328→			<Card data-testid="settings-shadow">
   329→				<CardHeader class="pb-3">
   330→					<div class="flex items-center gap-2">
   331→						<GitBranchIcon class="size-4 text-muted-foreground" />
   332→						<h2 class="text-sm font-semibold">Shadow Branch</h2>
   333→					</div>
   334→				</CardHeader>
   335→				<CardContent class="pt-0">
   336→					{#if loadingShadow}
   337→						<div class="flex flex-col gap-2" data-testid="settings-shadow-loading">
   338→							<div class="h-4 w-3/4 rounded bg-muted ds-shimmer"></div>
   339→							<div class="h-4 w-1/2 rounded bg-muted ds-shimmer"></div>
   340→						</div>
   341→					{:else if errorShadow}
   342→						<div class="text-sm text-destructive" data-testid="settings-shadow-error" role="alert">
   343→							{errorShadow}
   344→						</div>
   345→					{:else if shadowStatus}
   346→						<dl class="flex flex-col gap-2 text-sm">
   347→							<div class="flex justify-between">
   348→								<dt class="text-muted-foreground">Status</dt>
   349→								<dd class="flex items-center gap-2" data-testid="shadow-status">
   350→									{#if shadowStatus.enabled && shadowStatus.healthy}
   351→										<span class="size-2 rounded-full bg-severity-success"></span>
   352→										<span class="font-medium">Healthy</span>
   353→									{:else if shadowStatus.enabled}
   354→										<span class="size-2 rounded-full bg-severity-warning"></span>
   355→										<span class="font-medium">Unhealthy</span>
   356→									{:else}
   357→										<span class="size-2 rounded-full bg-muted-foreground"></span>
   358→										<span class="font-medium">Disabled</span>
   359→									{/if}
   360→								</dd>
   361→							</div>
   362→							{#if shadowStatus.branch_name}
   363→								<div class="flex justify-between">
   364→									<dt class="text-muted-foreground">Branch</dt>
   365→									<dd class="font-mono text-xs" data-testid="shadow-branch">{shadowStatus.branch_name}</dd>
   366→								</div>
   367→							{/if}
   368→							{#if shadowStatus.worktree_dir}
   369→								<div class="flex justify-between">
   370→									<dt class="text-muted-foreground">Worktree</dt>
   371→									<dd class="font-mono text-xs truncate max-w-[200px]" title={shadowStatus.worktree_dir} data-testid="shadow-worktree">{shadowStatus.worktree_dir}</dd>
   372→								</div>
   373→							{/if}
   374→							<div class="flex justify-between">
   375→								<dt class="text-muted-foreground">Remote Tracking</dt>
   376→								<dd data-testid="shadow-remote">
   377→									{#if shadowStatus.remote_tracking}
   378→										<Badge variant="outline" class="text-xs bg-severity-success-muted text-severity-success-muted-fg">Configured</Badge>
   379→									{:else}
   380→										<span class="text-xs text-muted-foreground">Not configured</span>
   381→									{/if}
   382→								</dd>
   383→							</div>
   384→						</dl>
   385→					{:else}
   386→						<div class="text-sm text-muted-foreground" data-testid="settings-shadow-empty">
   387→							Shadow branch not detected.
   388→						</div>
   389→					{/if}
   390→				</CardContent>
   391→			</Card>
   392→
   393→			<!-- ═══ Section 4: Conventions ═══ -->
   394→			<Card class="md:col-span-2" data-testid="settings-conventions">
   395→				<CardHeader class="pb-3">
   396→					<div class="flex items-center justify-between">
   397→						<div class="flex items-center gap-2">
   398→							<BookOpenIcon class="size-4 text-muted-foreground" />
   399→							<h2 class="text-sm font-semibold">Conventions</h2>
   400→						</div>
   401→						{#if !loadingConventions && conventions.length > 0}
   402→							<span class="text-xs text-muted-foreground" data-testid="conventions-count">
   403→								{conventions.length} domain{conventions.length === 1 ? '' : 's'}
   404→							</span>
   405→						{/if}
   406→					</div>
   407→				</CardHeader>
   408→				<CardContent class="pt-0">
   409→					{#if loadingConventions}
   410→						<div class="flex flex-col gap-2" data-testid="settings-conventions-loading">
   411→							{#each Array(3) as _}
   412→								<div class="h-10 rounded bg-muted ds-shimmer"></div>
   413→							{/each}
   414→						</div>
   415→					{:else if errorConventions}
   416→						<div class="text-sm text-destructive" data-testid="settings-conventions-error" role="alert">
   417→							{errorConventions}
   418→						</div>
   419→					{:else if conventions.length === 0}
   420→						<div class="flex flex-col items-center justify-center py-8" data-testid="settings-conventions-empty">
   421→							<BookOpenIcon class="size-8 text-muted-foreground/30 mb-2" />
   422→							<p class="text-sm text-muted-foreground">No conventions defined</p>
   423→						</div>
   424→					{:else}
   425→						<div class="flex flex-col gap-1" data-testid="conventions-list">
   426→							{#each conventions as convention (convention._ulid)}
   427→								<div class="rounded-md border" data-testid="convention-item">
   428→									<button
   429→										type="button"
   430→										class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm hover:bg-muted/50 transition-colors"
   431→										onclick={() => toggleDomain(convention.domain)}
   432→										data-testid="convention-toggle"
   433→									>
   434→										{#if expandedDomains.has(convention.domain)}
   435→											<ChevronDownIcon class="size-3.5 text-muted-foreground shrink-0" />
   436→										{:else}
   437→											<ChevronRightIcon class="size-3.5 text-muted-foreground shrink-0" />
   438→										{/if}
   439→										<span class="font-medium" data-testid="convention-domain">{convention.domain}</span>
   440→										<span class="text-xs text-muted-foreground ml-auto">
   441→											{convention.rules.length} rule{convention.rules.length === 1 ? '' : 's'}
   442→										</span>
   443→									</button>
   444→									{#if expandedDomains.has(convention.domain)}
   445→										<div class="border-t px-3 py-2 text-sm" data-testid="convention-details">
   446→											{#if convention.rules.length > 0}
   447→												<ul class="flex flex-col gap-1 mb-2">
   448→													{#each convention.rules as rule}
   449→														<li class="text-muted-foreground flex items-start gap-1.5">
   450→															<span class="text-xs mt-1 shrink-0">•</span>
   451→															<span>{rule}</span>
   452→														</li>
   453→													{/each}
   454→												</ul>
   455→											{/if}
   456→											{#if convention.examples && convention.examples.length > 0}
   457→												<div class="flex flex-col gap-1.5 mt-2 pt-2 border-t">
   458→													<h4 class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Examples</h4>
   459→													{#each convention.examples as example}
   460→														<div class="flex flex-col gap-0.5 text-xs">
   461→															<div class="flex items-center gap-1.5">
   462→																<span class="text-severity-success font-medium">Good:</span>
   463→																<code class="bg-muted px-1 py-0.5 rounded">{example.good}</code>
   464→															</div>
   465→															<div class="flex items-center gap-1.5">
   466→																<span class="text-severity-error font-medium">Bad:</span>
   467→																<code class="bg-muted px-1 py-0.5 rounded">{example.bad}</code>
   468→															</div>
   469→														</div>
   470→													{/each}
   471→												</div>
   472→											{/if}
   473→										</div>
   474→									{/if}
   475→								</div>
   476→							{/each}
   477→						</div>
   478→					{/if}
   479→				</CardContent>
   480→			</Card>
   481→		</div>
   482→	{/if}
   483→</div>
   484→
```