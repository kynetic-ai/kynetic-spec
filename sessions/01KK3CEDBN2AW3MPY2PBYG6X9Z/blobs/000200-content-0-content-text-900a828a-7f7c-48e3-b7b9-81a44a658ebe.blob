```
     1→<!--
     2→  AC: @ui-agent-dispatch ac-4 — Inline edit form for agent definitions.
     3→  Schema-driven: dispatch events from AGENT_DISPATCH_EVENTS, field structure from AgentDefinition type.
     4→-->
     5→<script lang="ts">
     6→	import {
     7→		updateAgentDefinition,
     8→		type AgentDefinition,
     9→		type AgentUpdatePayload
    10→	} from '$lib/api';
    11→	import { AGENT_DISPATCH_EVENTS } from '@kynetic-ai/shared';
    12→	import { ReadOnlyModeError } from '$lib/stores/mode.svelte';
    13→	import * as Dialog from '$lib/components/ui/dialog';
    14→	import { Button } from '$lib/components/ui/button';
    15→	import { Input } from '$lib/components/ui/input';
    16→	import { Textarea } from '$lib/components/ui/textarea';
    17→	import { Badge } from '$lib/components/ui/badge';
    18→	import { Separator } from '$lib/components/ui/separator';
    19→	import X from '@lucide/svelte/icons/x';
    20→	import Plus from '@lucide/svelte/icons/plus';
    21→
    22→	let {
    23→		open = $bindable(false),
    24→		agent,
    25→		onSaved
    26→	}: {
    27→		open?: boolean;
    28→		agent: AgentDefinition;
    29→		onSaved?: (updated: AgentDefinition) => void;
    30→	} = $props();
    31→
    32→	// Form state derived from agent prop — reset when dialog opens
    33→	let name = $state('');
    34→	let description = $state('');
    35→	let adapter = $state('');
    36→	let dispatchTriggers = $state<Array<{ on: string; filter?: { automation?: string; tags?: string[]; priority?: number } }>>([]);
    37→	let capabilities = $state<string[]>([]);
    38→	let tools = $state<string[]>([]);
    39→	let skills = $state<string[]>([]);
    40→	let maxTasks = $state<number | undefined>(undefined);
    41→	let maxRetries = $state<number | undefined>(undefined);
    42→	let timeoutMinutes = $state<number | undefined>(undefined);
    43→	let maxConcurrent = $state(1);
    44→	let autoApprove = $state(false);
    45→	let promptTemplate = $state('');
    46→
    47→	// UI state
    48→	let saving = $state(false);
    49→	let error = $state('');
    50→
    51→	// Chip input buffers
    52→	let newCapability = $state('');
    53→	let newTool = $state('');
    54→	let newSkill = $state('');
    55→
    56→	// Reset form state when dialog opens
    57→	$effect(() => {
    58→		if (open && agent) {
    59→			name = agent.name;
    60→			description = agent.description ?? '';
    61→			adapter = agent.adapter ?? '';
    62→			dispatchTriggers = agent.dispatch.map((d) => ({ ...d, filter: d.filter ? { ...d.filter } : undefined }));
    63→			capabilities = [...agent.capabilities];
    64→			tools = [...agent.tools];
    65→			skills = [...agent.skills];
    66→			maxTasks = agent.budget?.max_tasks;
    67→			maxRetries = agent.budget?.max_retries;
    68→			timeoutMinutes = agent.budget?.timeout_minutes;
    69→			maxConcurrent = agent.concurrency?.max_concurrent ?? 1;
    70→			autoApprove = agent.auto_approve;
    71→			promptTemplate = agent.prompt_template ?? '';
    72→			error = '';
    73→			newCapability = '';
    74→			newTool = '';
    75→			newSkill = '';
    76→		}
    77→	});
    78→
    79→	// Available dispatch events not yet selected
    80→	let availableEvents = $derived(
    81→		AGENT_DISPATCH_EVENTS.filter((e) => !dispatchTriggers.some((t) => t.on === e))
    82→	);
    83→
    84→	function addTrigger(event: string) {
    85→		dispatchTriggers = [...dispatchTriggers, { on: event }];
    86→	}
    87→
    88→	function removeTrigger(index: number) {
    89→		dispatchTriggers = dispatchTriggers.filter((_, i) => i !== index);
    90→	}
    91→
    92→	function addChip(list: string[], value: string, setter: (v: string[]) => void, clearInput: () => void) {
    93→		const trimmed = value.trim();
    94→		if (trimmed && !list.includes(trimmed)) {
    95→			setter([...list, trimmed]);
    96→			clearInput();
    97→		}
    98→	}
    99→
   100→	function removeChip(list: string[], index: number, setter: (v: string[]) => void) {
   101→		setter(list.filter((_, i) => i !== index));
   102→	}
   103→
   104→	async function handleSave() {
   105→		saving = true;
   106→		error = '';
   107→
   108→		const payload: AgentUpdatePayload = {
   109→			name,
   110→			description: description || undefined,
   111→			adapter: adapter || undefined,
   112→			dispatch: dispatchTriggers,
   113→			capabilities,
   114→			tools,
   115→			skills,
   116→			budget: (maxTasks !== undefined || maxRetries !== undefined || timeoutMinutes !== undefined)
   117→				? { max_tasks: maxTasks, max_retries: maxRetries, timeout_minutes: timeoutMinutes }
   118→				: undefined,
   119→			concurrency: { max_concurrent: maxConcurrent },
   120→			auto_approve: autoApprove,
   121→			prompt_template: promptTemplate || undefined
   122→		};
   123→
   124→		try {
   125→			const updated = await updateAgentDefinition(agent.id, payload);
   126→			onSaved?.(updated);
   127→			open = false;
   128→		} catch (err) {
   129→			if (err instanceof ReadOnlyModeError) {
   130→				error = err.message;
   131→			} else {
   132→				error = err instanceof Error ? err.message : 'Failed to save agent';
   133→			}
   134→		} finally {
   135→			saving = false;
   136→		}
   137→	}
   138→
   139→	function handleCancel() {
   140→		open = false;
   141→	}
   142→</script>
   143→
   144→<Dialog.Root bind:open>
   145→	<Dialog.Content class="max-w-2xl max-h-[85vh] overflow-y-auto" data-testid="agent-edit-dialog">
   146→		<Dialog.Header>
   147→			<Dialog.Title data-testid="agent-edit-title">Edit Agent: {agent.id}</Dialog.Title>
   148→			<Dialog.Description>
   149→				Modify agent definition fields. Changes are persisted to kynetic.meta.yaml.
   150→			</Dialog.Description>
   151→		</Dialog.Header>
   152→
   153→		{#if error}
   154→			<div
   155→				class="bg-destructive/10 text-destructive p-3 rounded-lg text-sm"
   156→				data-testid="agent-edit-error"
   157→				role="alert"
   158→			>
   159→				{error}
   160→			</div>
   161→		{/if}
   162→
   163→		<div class="flex flex-col gap-4">
   164→			<!-- Name -->
   165→			<div>
   166→				<label for="agent-name" class="text-sm font-medium">Name</label>
   167→				<Input
   168→					id="agent-name"
   169→					bind:value={name}
   170→					placeholder="Agent name"
   171→					data-testid="agent-edit-name"
   172→				/>
   173→			</div>
   174→
   175→			<!-- Description -->
   176→			<div>
   177→				<label for="agent-description" class="text-sm font-medium">Description</label>
   178→				<Textarea
   179→					id="agent-description"
   180→					bind:value={description}
   181→					placeholder="Agent description"
   182→					rows={2}
   183→					data-testid="agent-edit-description"
   184→				/>
   185→			</div>
   186→
   187→			<!-- Adapter -->
   188→			<div>
   189→				<label for="agent-adapter" class="text-sm font-medium">Adapter</label>
   190→				<Input
   191→					id="agent-adapter"
   192→					bind:value={adapter}
   193→					placeholder="e.g. claude-code"
   194→					data-testid="agent-edit-adapter"
   195→				/>
   196→			</div>
   197→
   198→			<Separator />
   199→
   200→			<!-- Dispatch Triggers (schema-driven from AGENT_DISPATCH_EVENTS) -->
   201→			<div>
   202→				<p class="text-sm font-medium mb-2">Dispatch Triggers</p>
   203→				<div class="flex flex-wrap gap-1.5 mb-2" data-testid="agent-edit-triggers">
   204→					{#each dispatchTriggers as trigger, i}
   205→						<Badge variant="secondary" class="gap-1 pr-1">
   206→							{trigger.on}
   207→							<button
   208→								type="button"
   209→								class="ml-0.5 rounded-full p-0.5 hover:bg-muted-foreground/20"
   210→								onclick={() => removeTrigger(i)}
   211→								aria-label="Remove trigger {trigger.on}"
   212→								data-testid="remove-trigger-{trigger.on}"
   213→							>
   214→								<X class="h-3 w-3" />
   215→							</button>
   216→						</Badge>
   217→					{/each}
   218→				</div>
   219→				{#if availableEvents.length > 0}
   220→					<div class="flex flex-wrap gap-1.5" data-testid="agent-edit-available-triggers">
   221→						{#each availableEvents as event}
   222→							<Button
   223→								size="sm"
   224→								variant="outline"
   225→								class="text-xs gap-1"
   226→								onclick={() => addTrigger(event)}
   227→								data-testid="add-trigger-{event}"
   228→							>
   229→								<Plus class="h-3 w-3" />
   230→								{event}
   231→							</Button>
   232→						{/each}
   233→					</div>
   234→				{/if}
   235→			</div>
   236→
   237→			<Separator />
   238→
   239→			<!-- Capabilities (chip input) -->
   240→			<div>
   241→				<p class="text-sm font-medium mb-1">Capabilities</p>
   242→				<div class="flex flex-wrap gap-1 mb-2" data-testid="agent-edit-capabilities">
   243→					{#each capabilities as cap, i}
   244→						<Badge variant="outline" class="gap-1 pr-1">
   245→							{cap}
   246→							<button
   247→								type="button"
   248→								class="ml-0.5 rounded-full p-0.5 hover:bg-muted-foreground/20"
   249→								onclick={() => removeChip(capabilities, i, (v) => (capabilities = v))}
   250→								aria-label="Remove capability {cap}"
   251→							>
   252→								<X class="h-3 w-3" />
   253→							</button>
   254→						</Badge>
   255→					{/each}
   256→				</div>
   257→				<div class="flex gap-2">
   258→					<Input
   259→						bind:value={newCapability}
   260→						placeholder="Add capability..."
   261→						class="flex-1"
   262→						onkeydown={(e: KeyboardEvent) => {
   263→							if (e.key === 'Enter') {
   264→								e.preventDefault();
   265→								addChip(capabilities, newCapability, (v) => (capabilities = v), () => (newCapability = ''));
   266→							}
   267→						}}
   268→						data-testid="agent-edit-capability-input"
   269→					/>
   270→					<Button
   271→						size="sm"
   272→						variant="outline"
   273→						onclick={() => addChip(capabilities, newCapability, (v) => (capabilities = v), () => (newCapability = ''))}
   274→					>
   275→						Add
   276→					</Button>
   277→				</div>
   278→			</div>
   279→
   280→			<!-- Tools (chip input) -->
   281→			<div>
   282→				<p class="text-sm font-medium mb-1">Tools</p>
   283→				<div class="flex flex-wrap gap-1 mb-2" data-testid="agent-edit-tools">
   284→					{#each tools as tool, i}
   285→						<Badge variant="outline" class="gap-1 pr-1">
   286→							{tool}
   287→							<button
   288→								type="button"
   289→								class="ml-0.5 rounded-full p-0.5 hover:bg-muted-foreground/20"
   290→								onclick={() => removeChip(tools, i, (v) => (tools = v))}
   291→								aria-label="Remove tool {tool}"
   292→							>
   293→								<X class="h-3 w-3" />
   294→							</button>
   295→						</Badge>
   296→					{/each}
   297→				</div>
   298→				<div class="flex gap-2">
   299→					<Input
   300→						bind:value={newTool}
   301→						placeholder="Add tool..."
   302→						class="flex-1"
   303→						onkeydown={(e: KeyboardEvent) => {
   304→							if (e.key === 'Enter') {
   305→								e.preventDefault();
   306→								addChip(tools, newTool, (v) => (tools = v), () => (newTool = ''));
   307→							}
   308→						}}
   309→						data-testid="agent-edit-tool-input"
   310→					/>
   311→					<Button
   312→						size="sm"
   313→						variant="outline"
   314→						onclick={() => addChip(tools, newTool, (v) => (tools = v), () => (newTool = ''))}
   315→					>
   316→						Add
   317→					</Button>
   318→				</div>
   319→			</div>
   320→
   321→			<!-- Skills (chip input) -->
   322→			<div>
   323→				<p class="text-sm font-medium mb-1">Skills</p>
   324→				<div class="flex flex-wrap gap-1 mb-2" data-testid="agent-edit-skills">
   325→					{#each skills as skill, i}
   326→						<Badge variant="outline" class="gap-1 pr-1">
   327→							{skill}
   328→							<button
   329→								type="button"
   330→								class="ml-0.5 rounded-full p-0.5 hover:bg-muted-foreground/20"
   331→								onclick={() => removeChip(skills, i, (v) => (skills = v))}
   332→								aria-label="Remove skill {skill}"
   333→							>
   334→								<X class="h-3 w-3" />
   335→							</button>
   336→						</Badge>
   337→					{/each}
   338→				</div>
   339→				<div class="flex gap-2">
   340→					<Input
   341→						bind:value={newSkill}
   342→						placeholder="Add skill..."
   343→						class="flex-1"
   344→						onkeydown={(e: KeyboardEvent) => {
   345→							if (e.key === 'Enter') {
   346→								e.preventDefault();
   347→								addChip(skills, newSkill, (v) => (skills = v), () => (newSkill = ''));
   348→							}
   349→						}}
   350→						data-testid="agent-edit-skill-input"
   351→					/>
   352→					<Button
   353→						size="sm"
   354→						variant="outline"
   355→						onclick={() => addChip(skills, newSkill, (v) => (skills = v), () => (newSkill = ''))}
   356→					>
   357→						Add
   358→					</Button>
   359→				</div>
   360→			</div>
   361→
   362→			<Separator />
   363→
   364→			<!-- Budget -->
   365→			<div>
   366→				<p class="text-sm font-medium mb-2">Budget</p>
   367→				<div class="grid grid-cols-3 gap-3">
   368→					<div>
   369→						<label for="agent-max-tasks" class="text-xs text-muted-foreground">Max Tasks</label>
   370→						<Input
   371→							id="agent-max-tasks"
   372→							type="number"
   373→							min={1}
   374→							value={maxTasks ?? ''}
   375→							oninput={(e: Event) => {
   376→								const v = (e.target as HTMLInputElement).valueAsNumber;
   377→								maxTasks = Number.isNaN(v) ? undefined : v;
   378→							}}
   379→							placeholder="—"
   380→							data-testid="agent-edit-max-tasks"
   381→						/>
   382→					</div>
   383→					<div>
   384→						<label for="agent-max-retries" class="text-xs text-muted-foreground">Max Retries</label>
   385→						<Input
   386→							id="agent-max-retries"
   387→							type="number"
   388→							min={0}
   389→							value={maxRetries ?? ''}
   390→							oninput={(e: Event) => {
   391→								const v = (e.target as HTMLInputElement).valueAsNumber;
   392→								maxRetries = Number.isNaN(v) ? undefined : v;
   393→							}}
   394→							placeholder="—"
   395→							data-testid="agent-edit-max-retries"
   396→						/>
   397→					</div>
   398→					<div>
   399→						<label for="agent-timeout" class="text-xs text-muted-foreground">Timeout (min)</label>
   400→						<Input
   401→							id="agent-timeout"
   402→							type="number"
   403→							min={1}
   404→							value={timeoutMinutes ?? ''}
   405→							oninput={(e: Event) => {
   406→								const v = (e.target as HTMLInputElement).valueAsNumber;
   407→								timeoutMinutes = Number.isNaN(v) ? undefined : v;
   408→							}}
   409→							placeholder="—"
   410→							data-testid="agent-edit-timeout"
   411→						/>
   412→					</div>
   413→				</div>
   414→			</div>
   415→
   416→			<!-- Concurrency -->
   417→			<div>
   418→				<label for="agent-concurrency" class="text-sm font-medium">Max Concurrent</label>
   419→				<Input
   420→					id="agent-concurrency"
   421→					type="number"
   422→					min={1}
   423→					bind:value={maxConcurrent}
   424→					data-testid="agent-edit-concurrency"
   425→				/>
   426→			</div>
   427→
   428→			<!-- Auto Approve -->
   429→			<div class="flex items-center gap-3">
   430→				<input
   431→					id="agent-auto-approve"
   432→					type="checkbox"
   433→					bind:checked={autoApprove}
   434→					class="h-4 w-4 rounded border-input"
   435→					data-testid="agent-edit-auto-approve"
   436→				/>
   437→				<label for="agent-auto-approve" class="text-sm font-medium">Auto Approve</label>
   438→			</div>
   439→
   440→			<Separator />
   441→
   442→			<!-- Prompt Template -->
   443→			<div>
   444→				<label for="agent-prompt-template" class="text-sm font-medium">Prompt Template</label>
   445→				<Textarea
   446→					id="agent-prompt-template"
   447→					bind:value={promptTemplate}
   448→					placeholder="Agent prompt template..."
   449→					rows={4}
   450→					class="font-mono text-xs"
   451→					data-testid="agent-edit-prompt-template"
   452→				/>
   453→			</div>
   454→		</div>
   455→
   456→		<Dialog.Footer class="mt-4">
   457→			<Button
   458→				variant="ghost"
   459→				onclick={handleCancel}
   460→				disabled={saving}
   461→				data-testid="agent-edit-cancel"
   462→			>
   463→				Cancel
   464→			</Button>
   465→			<Button
   466→				onclick={handleSave}
   467→				disabled={saving || !name.trim()}
   468→				data-testid="agent-edit-save"
   469→			>
   470→				{saving ? 'Saving...' : 'Save'}
   471→			</Button>
   472→		</Dialog.Footer>
   473→	</Dialog.Content>
   474→</Dialog.Root>
   475→
```