```
     1→import { z } from "zod";
     2→import { DateTimeSchema, RefSchema, UlidSchema } from "./common.js";
     3→
     4→/**
     5→ * ULID schema for meta items - uses the same strict validation as core items.
     6→ * All ULIDs must be exactly 26 characters in Crockford base32 format.
     7→ */
     8→const MetaUlidSchema = UlidSchema;
     9→
    10→/**
    11→ * Agent session protocol - commands to run at session lifecycle events
    12→ */
    13→export const SessionProtocolSchema = z.object({
    14→  start: z.string().nullable().optional(),
    15→  checkpoint: z.string().nullable().optional(),
    16→  end: z.string().nullable().optional(),
    17→});
    18→
    19→/**
    20→ * Agent dispatch event types - lifecycle events that can trigger agent spawning
    21→ * AC: @agent-definition-schema ac-2
    22→ */
    23→export const AgentDispatchEventSchema = z.enum([
    24→  "task.in_progress",
    25→  "task.ready",
    26→  "task.needs_work",
    27→  "task.pending_review",
    28→]);
    29→
    30→/**
    31→ * Agent dispatch filter - constraints for matching tasks during dispatch
    32→ * AC: @agent-definition-schema ac-3
    33→ */
    34→export const AgentDispatchFilterSchema = z.object({
    35→  automation: z.enum(["eligible", "ineligible"]).optional(),
    36→  tags: z.array(z.string()).optional(),
    37→  priority: z.number().optional(),
    38→});
    39→
    40→/**
    41→ * Agent dispatch rule - maps an event type to optional filters
    42→ * AC: @agent-definition-schema ac-2
    43→ */
    44→export const AgentDispatchRuleSchema = z.object({
    45→  on: AgentDispatchEventSchema,
    46→  filter: AgentDispatchFilterSchema.optional(),
    47→});
    48→
    49→/**
    50→ * Agent budget settings - limits on task count and time
    51→ * AC: @agent-definition-schema ac-4
    52→ */
    53→export const AgentBudgetSchema = z.object({
    54→  max_tasks: z.number().positive().optional(),
    55→  max_retries: z.number().int().nonnegative().optional(),
    56→  timeout_minutes: z.number().positive().optional(),
    57→});
    58→
    59→/**
    60→ * Agent concurrency settings
    61→ * AC: @agent-definition-schema ac-6
    62→ */
    63→export const AgentConcurrencySchema = z.object({
    64→  max_concurrent: z.number().int().positive().default(1),
    65→});
    66→
    67→/**
    68→ * Agent definition - describes an agent's role and capabilities
    69→ * AC: @agent-definition-schema ac-1 through ac-8
    70→ */
    71→export const AgentSchema = z.object({
    72→  _ulid: MetaUlidSchema,
    73→  id: z.string().min(1, "Agent ID is required"),
    74→  name: z.string().min(1, "Agent name is required"),
    75→  description: z.string().optional(),
    76→  capabilities: z.array(z.string()).default([]),
    77→  tools: z.array(z.string()).default([]),
    78→  session_protocol: SessionProtocolSchema.optional(),
    79→  conventions: z.array(z.string()).default([]),
    80→  // New dispatch/runtime fields (AC: @agent-definition-schema ac-1 through ac-8)
    81→  adapter: z.string().optional(),
    82→  dispatch: z.array(AgentDispatchRuleSchema).default([]),
    83→  skills: z.array(z.string()).default([]),
    84→  budget: AgentBudgetSchema.optional(),
    85→  concurrency: AgentConcurrencySchema.default({ max_concurrent: 1 }),
    86→  auto_approve: z.boolean().default(false),
    87→  prompt_template: z.string().optional(),
    88→  /** Automation eligibility for agent list filtering (eligible|ineligible) */
    89→  automation: z.enum(["eligible", "ineligible"]).optional(),
    90→  /** Tags for filtering and categorization */
    91→  tags: z.array(z.string()).default([]).optional(),
    92→});
    93→
    94→/**
    95→ * Workflow step types
    96→ */
    97→export const WorkflowStepTypeSchema = z.enum(["check", "action", "decision"]);
    98→
    99→/**
   100→ * Workflow step execution hints
   101→ */
   102→export const StepExecutionSchema = z.object({
   103→  mode: z.enum(["prompt", "silent", "skip"]).default("prompt"),
   104→  timeout: z.number().nullable().optional(),
   105→});
   106→
   107→/**
   108→ * Workflow step input definition
   109→ */
   110→export const StepInputSchema = z.object({
   111→  name: z.string().min(1, "Input name is required"),
   112→  description: z.string().optional(),
   113→  required: z.boolean().default(true).optional(),
   114→  type: z.enum(["string", "ref", "number"]).default("string").optional(),
   115→});
   116→
   117→/**
   118→ * Workflow step - a single step in a workflow
   119→ */
   120→export const WorkflowStepSchema = z.object({
   121→  type: WorkflowStepTypeSchema,
   122→  content: z.string(),
   123→  on_fail: z.string().optional(),
   124→  options: z.array(z.string()).optional(), // For decision type
   125→  execution: StepExecutionSchema.optional(),
   126→  entry_criteria: z.array(z.string()).optional(),
   127→  exit_criteria: z.array(z.string()).optional(),
   128→  inputs: z.array(StepInputSchema).optional(),
   129→});
   130→
   131→/**
   132→ * Workflow mode - interactive (default) for human-in-loop, loop for autonomous agents
   133→ */
   134→export const WorkflowModeSchema = z.enum(["interactive", "loop"]);
   135→
   136→/**
   137→ * Workflow definition - structured process definition
   138→ */
   139→export const WorkflowSchema = z.object({
   140→  _ulid: MetaUlidSchema,
   141→  id: z.string().min(1, "Workflow ID is required"),
   142→  trigger: z.string().min(1, "Workflow trigger is required"),
   143→  description: z.string().optional(),
   144→  steps: z.array(WorkflowStepSchema).default([]),
   145→  enforcement: z.enum(["advisory", "strict"]).default("advisory").optional(),
   146→  mode: WorkflowModeSchema.default("interactive").optional(),
   147→  based_on: RefSchema.optional(),
   148→  tags: z.array(z.string()).default([]).optional(),
   149→});
   150→
   151→/**
   152→ * Convention example (good/bad)
   153→ */
   154→export const ConventionExampleSchema = z.object({
   155→  good: z.string(),
   156→  bad: z.string(),
   157→});
   158→
   159→/**
   160→ * Convention validation configuration
   161→ */
   162→export const ConventionValidationSchema = z.object({
   163→  type: z.enum(["regex", "enum", "range", "prose"]),
   164→  // For regex
   165→  pattern: z.string().optional(),
   166→  message: z.string().optional(),
   167→  // For enum
   168→  allowed: z.array(z.string()).optional(),
   169→  // For range
   170→  min: z.number().optional(),
   171→  max: z.number().optional(),
   172→  unit: z.enum(["words", "chars", "lines"]).optional(),
   173→});
   174→
   175→/**
   176→ * Convention definition - project-specific rules and standards
   177→ */
   178→export const ConventionSchema = z.object({
   179→  _ulid: MetaUlidSchema,
   180→  domain: z.string().min(1, "Convention domain is required"),
   181→  rules: z.array(z.string()).default([]),
   182→  examples: z.array(ConventionExampleSchema).default([]),
   183→  validation: ConventionValidationSchema.optional(),
   184→});
   185→
   186→/**
   187→ * Observation types
   188→ */
   189→export const ObservationTypeSchema = z.enum([
   190→  "friction",
   191→  "success",
   192→  "question",
   193→  "idea",
   194→]);
   195→
   196→/**
   197→ * Observation - feedback about workflows and conventions
   198→ */
   199→export const ObservationSchema = z.object({
   200→  _ulid: MetaUlidSchema,
   201→  type: ObservationTypeSchema,
   202→  workflow_ref: RefSchema.optional(),
   203→  content: z.string().min(1, "Observation content is required"),
   204→  created_at: DateTimeSchema,
   205→  author: z.string().optional(),
   206→  resolved: z.boolean().default(false),
   207→  resolution: z.string().nullable().optional(),
   208→  resolved_at: DateTimeSchema.optional(),
   209→  resolved_by: z.string().optional(),
   210→  promoted_to: RefSchema.optional(),
   211→});
   212→
   213→/**
   214→ * Skill origin - where the skill comes from
   215→ */
   216→export const SkillOriginSchema = z.enum(["core", "project", "local"]);
   217→
   218→/**
   219→ * Claude Code platform config - settings specific to Claude Code
   220→ */
   221→export const ClaudeCodeConfigSchema = z
   222→  .object({
   223→    disable_model_invocation: z.boolean().optional(),
   224→    user_invocable: z.boolean().optional(),
   225→    context: z.string().optional(),
   226→    agent: z.string().optional(),
   227→    model: z.string().optional(),
   228→    argument_hint: z.string().optional(),
   229→  })
   230→  .strict();
   231→
   232→/**
   233→ * Codex platform config - settings specific to OpenAI Codex CLI
   234→ */
   235→export const CodexConfigSchema = z
   236→  .object({
   237→    allow_implicit_invocation: z.boolean().optional(),
   238→    display_name: z.string().optional(),
   239→    short_description: z.string().optional(),
   240→    icon_small: z.string().optional(),
   241→    icon_large: z.string().optional(),
   242→    brand_color: z.string().optional(),
   243→    default_prompt: z.string().optional(),
   244→  })
   245→  .strict();
   246→
   247→/**
   248→ * Platform config - container for platform-specific settings
   249→ * Uses passthrough for unknown platforms to support future extensibility
   250→ */
   251→export const PlatformConfigSchema = z
   252→  .object({
   253→    claude_code: ClaudeCodeConfigSchema.optional(),
   254→    codex: CodexConfigSchema.optional(),
   255→  })
   256→  .passthrough();
   257→
   258→/**
   259→ * Kebab-case regex for skill IDs - lowercase letters, numbers, and hyphens only
   260→ * Must start with a letter and not end with a hyphen
   261→ */
   262→const KEBAB_CASE_REGEX = /^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$/;
   263→
   264→/**
   265→ * Skill definition - reusable agent capabilities stored in files
   266→ * Content is stored in .kspec/skills/<id>/SKILL.md
   267→ *
   268→ * Extended with portable Agent Skills fields for multi-platform support:
   269→ * - license, compatibility, allowed_tools for portability
   270→ * - metadata for arbitrary key-value pairs
   271→ * - platform_config for platform-specific settings
   272→ */
   273→export const SkillSchema = z.object({
   274→  _ulid: MetaUlidSchema,
   275→  _type: z.literal("skill").default("skill"),
   276→  id: z
   277→    .string({ required_error: "Skill ID is required" })
   278→    .regex(
   279→      KEBAB_CASE_REGEX,
   280→      "Skill ID must be in kebab-case format (lowercase letters, numbers, and hyphens)",
   281→    ),
   282→  name: z.string().min(1, "Skill name is required"),
   283→  description: z.string().optional(),
   284→  origin: SkillOriginSchema,
   285→  version: z.string().optional(),
   286→  platforms: z.array(z.string()).default(["claude-code"]),
   287→  depends_on: z.array(RefSchema).default([]),
   288→  tags: z.array(z.string()).default([]),
   289→  // Portable Agent Skills fields
   290→  license: z.string().optional(),
   291→  compatibility: z.string().optional(),
   292→  allowed_tools: z.array(z.string()).default([]),
   293→  metadata: z.record(z.string(), z.unknown()).optional(),
   294→  platform_config: PlatformConfigSchema.optional(),
   295→});
   296→
   297→/**
   298→ * Session context schema - ephemeral session state
   299→ */
   300→export const SessionContextSchema = z.object({
   301→  focus: z.string().nullable(),
   302→  threads: z.array(z.string()).default([]),
   303→  open_questions: z.array(z.string()).default([]),
   304→  updated_at: DateTimeSchema,
   305→});
   306→
   307→/**
   308→ * Step result status
   309→ */
   310→export const StepResultStatusSchema = z.enum([
   311→  "completed",
   312→  "skipped",
   313→  "failed",
   314→]);
   315→
   316→/**
   317→ * Step result schema - result of executing a workflow step
   318→ */
   319→export const StepResultSchema = z.object({
   320→  step_index: z.number(),
   321→  status: StepResultStatusSchema,
   322→  started_at: DateTimeSchema,
   323→  completed_at: DateTimeSchema,
   324→  entry_confirmed: z.boolean().optional(),
   325→  exit_confirmed: z.boolean().optional(),
   326→  notes: z.string().optional(),
   327→  inputs: z.record(z.string()).optional(),
   328→});
   329→
   330→/**
   331→ * Workflow run status
   332→ */
   333→export const WorkflowRunStatusSchema = z.enum([
   334→  "active",
   335→  "paused",
   336→  "completed",
   337→  "aborted",
   338→]);
   339→
   340→/**
   341→ * Workflow run result - distinguishes between different completion types
   342→ */
   343→export const WorkflowRunResultSchema = z.enum([
   344→  "success", // Normal completion through all steps
   345→  "no_work_available", // Graceful exit - no eligible work to process
   346→  "early_exit", // Intentional exit before all steps (not an error)
   347→]);
   348→
   349→/**
   350→ * Workflow run schema - tracks execution of a workflow
   351→ */
   352→export const WorkflowRunSchema = z.object({
   353→  _ulid: UlidSchema,
   354→  workflow_ref: RefSchema,
   355→  status: WorkflowRunStatusSchema,
   356→  current_step: z.number(),
   357→  total_steps: z.number(),
   358→  started_at: DateTimeSchema,
   359→  paused_at: DateTimeSchema.optional(),
   360→  completed_at: DateTimeSchema.optional(),
   361→  step_results: z.array(StepResultSchema).default([]),
   362→  initiated_by: z.string().optional(),
   363→  abort_reason: z.string().optional(),
   364→  task_ref: RefSchema.optional(),
   365→  result: WorkflowRunResultSchema.optional(), // Only set for completed runs
   366→});
   367→
   368→/**
   369→ * Workflow runs file schema - container for all workflow runs
   370→ */
   371→export const WorkflowRunsFileSchema = z.object({
   372→  kynetic_runs: z.string().default("1.0"),
   373→  runs: z.array(WorkflowRunSchema).default([]),
   374→});
   375→
   376→/**
   377→ * Meta manifest schema - the root structure for kynetic.meta.yaml
   378→ */
   379→export const MetaManifestSchema = z.object({
   380→  kynetic_meta: z.string().default("1.0"),
   381→  agents: z.array(AgentSchema).default([]),
   382→  workflows: z.array(WorkflowSchema).default([]),
   383→  conventions: z.array(ConventionSchema).default([]),
   384→  observations: z.array(ObservationSchema).default([]),
   385→  skills: z.array(SkillSchema).default([]),
   386→  includes: z.array(z.string()).default([]),
   387→});
   388→
   389→// Type exports
   390→export type SessionProtocol = z.infer<typeof SessionProtocolSchema>;
   391→export type AgentDispatchEvent = z.infer<typeof AgentDispatchEventSchema>;
   392→export type AgentDispatchFilter = z.infer<typeof AgentDispatchFilterSchema>;
   393→export type AgentDispatchRule = z.infer<typeof AgentDispatchRuleSchema>;
   394→export type AgentBudget = z.infer<typeof AgentBudgetSchema>;
   395→export type AgentConcurrency = z.infer<typeof AgentConcurrencySchema>;
   396→export type Agent = z.infer<typeof AgentSchema>;
   397→export type WorkflowStepType = z.infer<typeof WorkflowStepTypeSchema>;
   398→export type StepExecution = z.infer<typeof StepExecutionSchema>;
   399→export type StepInput = z.infer<typeof StepInputSchema>;
   400→export type WorkflowStep = z.infer<typeof WorkflowStepSchema>;
   401→export type WorkflowMode = z.infer<typeof WorkflowModeSchema>;
   402→export type Workflow = z.infer<typeof WorkflowSchema>;
   403→export type ConventionExample = z.infer<typeof ConventionExampleSchema>;
   404→export type ConventionValidation = z.infer<typeof ConventionValidationSchema>;
   405→export type Convention = z.infer<typeof ConventionSchema>;
   406→export type ObservationType = z.infer<typeof ObservationTypeSchema>;
   407→export type Observation = z.infer<typeof ObservationSchema>;
   408→export type SkillOrigin = z.infer<typeof SkillOriginSchema>;
   409→export type ClaudeCodeConfig = z.infer<typeof ClaudeCodeConfigSchema>;
   410→export type CodexConfig = z.infer<typeof CodexConfigSchema>;
   411→export type PlatformConfig = z.infer<typeof PlatformConfigSchema>;
   412→export type Skill = z.infer<typeof SkillSchema>;
   413→export type SessionContext = z.infer<typeof SessionContextSchema>;
   414→export type MetaManifest = z.infer<typeof MetaManifestSchema>;
   415→export type StepResultStatus = z.infer<typeof StepResultStatusSchema>;
   416→export type StepResult = z.infer<typeof StepResultSchema>;
   417→export type WorkflowRunStatus = z.infer<typeof WorkflowRunStatusSchema>;
   418→export type WorkflowRunResult = z.infer<typeof WorkflowRunResultSchema>;
   419→export type WorkflowRun = z.infer<typeof WorkflowRunSchema>;
   420→export type WorkflowRunsFile = z.infer<typeof WorkflowRunsFileSchema>;
   421→
   422→/**
   423→ * Meta item type - union of all meta item types
   424→ */
   425→export type MetaItem = Agent | Workflow | Convention | Observation | Skill;
   426→
   427→/**
   428→ * Type guard for skill items
   429→ * Uses _type discriminant field for reliable discrimination
   430→ */
   431→export function isSkill(item: MetaItem | unknown): item is Skill {
   432→  return (
   433→    typeof item === "object" &&
   434→    item !== null &&
   435→    "_type" in item &&
   436→    (item as { _type: unknown })._type === "skill"
   437→  );
   438→}
   439→
   440→/**
   441→ * Determine the type of a meta item
   442→ * AC: @skill-meta-type ac-7 - skills discriminated by _type field
   443→ */
   444→export function getMetaItemType(
   445→  item: MetaItem,
   446→): "agent" | "workflow" | "convention" | "observation" | "skill" {
   447→  if (isSkill(item)) return "skill";
   448→  if ("capabilities" in item) return "agent";
   449→  if ("trigger" in item) return "workflow";
   450→  if ("domain" in item) return "convention";
   451→  return "observation";
   452→}
   453→
```