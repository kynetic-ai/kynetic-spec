   697→          process.exit(1);
   698→        }
   699→
   700→        // Create and save observation
   701→        const obs = createObservation(type as ObservationType, description, {
   702→          workflow_ref: options.workflow,
   703→        });
   704→
   705→        await saveObservation(ctx, { ...obs, _sourceFile: undefined });
   706→        await commitIfShadow(ctx.shadow, 'meta-observe', shortUlid(obs._ulid));
   707→
   708→        success(`Created observation: ${shortUlid(obs._ulid)}`, { observation: obs });
   709→      } catch (err) {
   710→        error('Failed to create observation', err);
   711→        process.exit(1);
   712→      }
   713→    });
   714→
   715→  // kspec meta observations
   716→  meta
   717→    .command('observations')
   718→    .description('List observations')
   719→    .option('--all', 'Include resolved observations')
   720→    .option('--type <type>', 'Filter by type (friction, success, question, idea)')
   721→    .option('--workflow <ref>', 'Filter by workflow reference')
   722→    .action(async (options) => {
   723→      try {
   724→        const ctx = await initContext();
   725→
   726→        if (!ctx.manifestPath) {
   727→          error('No kspec project found');
   728→          process.exit(1);
   729→        }
   730→
   731→        const metaCtx = await loadMetaContext(ctx);
   732→
   733→        let observations = metaCtx.observations;
   734→
   735→        // Filter by resolved status
   736→        if (!options.all) {
   737→          observations = observations.filter((o) => !o.resolved);
   738→        }
   739→
   740→        // Filter by type
   741→        if (options.type) {
   742→          if (!OBSERVATION_TYPES.includes(options.type)) {
   743→            error(`Invalid observation type: ${options.type}. Valid types: ${OBSERVATION_TYPES.join(', ')}`);
   744→            process.exit(2);
   745→          }
   746→          observations = observations.filter((o) => o.type === options.type);
   747→        }
   748→
   749→        // Filter by workflow
   750→        if (options.workflow) {
   751→          const cleanRef = options.workflow.startsWith('@') ? options.workflow : `@${options.workflow}`;
   752→          observations = observations.filter((o) => o.workflow_ref === cleanRef);
   753→        }
   754→
   755→        // Sort by created_at (newest first)
   756→        observations.sort((a, b) =>
   757→          new Date(b.created_at).getTime() - new Date(a.created_at).getTime()
   758→        );
   759→
   760→        output(
   761→          observations.map((o) => ({
   762→            _ulid: o._ulid,
   763→            type: o.type,
   764→            content: o.content,
   765→            workflow_ref: o.workflow_ref,
   766→            created_at: o.created_at,
   767→            author: o.author,
   768→            resolved: o.resolved,
   769→            resolution: o.resolution,
   770→            resolved_at: o.resolved_at,
   771→            resolved_by: o.resolved_by,
   772→            promoted_to: o.promoted_to,
   773→          })),
   774→          () => formatObservationsTable(observations)
   775→        );
   776→      } catch (err) {
   777→        error('Failed to list observations', err);
   778→        process.exit(1);
   779→      }
   780→    });
   781→
   782→  // kspec meta promote <ref>
   783→  meta
   784→    .command('promote <ref>')
   785→    .description('Promote observation to task')
   786→    .option('--title <title>', 'Task title (prompts if not provided)')
   787→    .option('--priority <n>', 'Task priority (1-5)', '3')
   788→    .option('--tag <tag...>', 'Tags for the task')
   789→    .option('--force', 'Promote even if already resolved')
   790→    .action(async (ref: string, options) => {
   791→      try {
   792→        const ctx = await initContext();
   793→
   794→        if (!ctx.manifestPath) {
   795→          error('No kspec project found');
   796→          process.exit(1);
   797→        }
   798→
   799→        const metaCtx = await loadMetaContext(ctx);
   800→        const obs = findObservationByRef(metaCtx, ref);
   801→
   802→        // AC-6: Check if already promoted
   803→        if (obs.promoted_to) {
   804→          error(`Observation already promoted to task ${obs.promoted_to}; resolve or delete the task first`);
   805→          process.exit(1);
   806→        }
   807→
   808→        // AC-8: Check if resolved (unless --force)
   809→        if (obs.resolved && !options.force) {
   810→          error('Cannot promote resolved observation; use --force to override');
   811→          process.exit(1);
   812→        }
   813→
   814→        // Get title
   815→        let title = options.title;
   816→        if (!title) {
   817→          console.log(`Promoting: "${truncate(obs.content, 60)}"`);
   818→          console.log('');
   819→          title = await prompt('Task title: ');
   820→          if (!title) {
   821→            error('Task title is required');
   822→            process.exit(2);
   823→          }
   824→        }
   825→
   826→        // Create the task
   827→        const taskInput: TaskInput = {
   828→          title,
   829→          type: 'task',
   830→          priority: parseInt(options.priority, 10),
   831→          spec_ref: null,
   832→          meta_ref: obs.workflow_ref || null, // Use workflow_ref as meta_ref
   833→          tags: options.tag || [],
   834→          description: obs.content,
   835→        };
   836→
   837→        const task = createTask(taskInput);
   838→        await saveTask(ctx, task);
   839→
   840→        // Update observation with promoted_to
   841→        obs.promoted_to = `@${shortUlid(task._ulid)}`;
   842→        await saveObservation(ctx, obs);
   843→
   844→        // Load index for display
   845→        const tasks = await loadAllTasks(ctx);
   846→        const items = await loadAllItems(ctx);
   847→        const index = new ReferenceIndex(tasks, items);
   848→
   849→        await commitIfShadow(ctx.shadow, 'meta-promote', shortUlid(task._ulid));
   850→
   851→        success(`Created task: ${index.shortUlid(task._ulid)}`, { task, observation: obs });
   852→      } catch (err) {
   853→        error('Failed to promote observation', err);
   854→        process.exit(1);
   855→      }
   856→    });
   857→
   858→  // kspec meta resolve <ref> [resolution]
   859→  meta
   860→    .command('resolve <ref> [resolution]')
   861→    .description('Resolve an observation')
   862→    .action(async (ref: string, resolution: string | undefined) => {
   863→      try {
   864→        const ctx = await initContext();
   865→
   866→        if (!ctx.manifestPath) {
   867→          error('No kspec project found');
   868→          process.exit(1);
   869→        }
   870→
   871→        const metaCtx = await loadMetaContext(ctx);
   872→        const obs = findObservationByRef(metaCtx, ref);
   873→
   874→        // AC-7: Check if already resolved
   875→        if (obs.resolved) {
   876→          const resolvedDate = obs.resolved_at
   877→            ? new Date(obs.resolved_at).toLocaleDateString()
   878→            : 'unknown date';
   879→          const resolutionText = obs.resolution
   880→            ? truncate(obs.resolution, 40)
   881→            : '';
   882→          error(`Observation already resolved on ${resolvedDate}: '${resolutionText}'`);
   883→          process.exit(1);
   884→        }
   885→
   886→        // AC-9: If promoted to a task, try to get completion reason
   887→        let finalResolution = resolution;
   888→        if (!finalResolution && obs.promoted_to) {
   889→          // Try to find the task and get its completion reason
   890→          const tasks = await loadAllTasks(ctx);
   891→          const items = await loadAllItems(ctx);
   892→          const index = new ReferenceIndex(tasks, items);
   893→          const resolved = index.resolve(obs.promoted_to);
   894→          const task = resolved.ok ? resolved.item : null;
   895→
   896→          if (task && 'status' in task && task.status === 'completed' && 'closed_reason' in task && task.closed_reason) {
   897→            finalResolution = task.closed_reason as string;
   898→            info(`Auto-populated resolution from completed task: ${truncate(finalResolution, 50)}`);
   899→          } else if (!finalResolution) {
   900→            // Prompt for resolution
   901→            finalResolution = await prompt('Resolution: ');
   902→          }
   903→        }
   904→
   905→        if (!finalResolution) {
   906→          finalResolution = await prompt('Resolution: ');
   907→        }
   908→
   909→        if (!finalResolution) {
   910→          error('Resolution text is required');
   911→          process.exit(2);
   912→        }
   913→
   914→        // Update observation
   915→        obs.resolved = true;
   916→        obs.resolution = finalResolution;
   917→        obs.resolved_at = new Date().toISOString();
   918→        obs.resolved_by = obs.author; // Use same author convention
   919→
   920→        await saveObservation(ctx, obs);
   921→        await commitIfShadow(ctx.shadow, 'meta-resolve', shortUlid(obs._ulid));
   922→
   923→        success(`Resolved: ${shortUlid(obs._ulid)}`, { observation: obs });
   924→      } catch (err) {
   925→        error('Failed to resolve observation', err);
   926→        process.exit(1);
   927→      }
   928→    });
   929→
   930→  // kspec meta get <ref>
   931→  meta
   932→    .command('get <ref>')
   933→    .description('Get a meta item by reference')
   934→    .option('--yaml', 'Output as YAML')
   935→    .action(async (ref: string, options) => {
   936→      try {
   937→        const ctx = await initContext();
