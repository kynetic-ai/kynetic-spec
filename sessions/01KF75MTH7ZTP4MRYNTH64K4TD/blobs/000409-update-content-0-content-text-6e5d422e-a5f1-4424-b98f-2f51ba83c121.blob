   965→
   966→  // kspec meta list
   967→  meta
   968→    .command('list')
   969→    .description('List all meta items')
   970→    .option('--type <type>', 'Filter by type (agent, workflow, convention, observation)')
   971→    .action(async (options) => {
   972→      try {
   973→        const ctx = await initContext();
   974→
   975→        if (!ctx.manifestPath) {
   976→          error('No kspec project found');
   977→          process.exit(1);
   978→        }
   979→
   980→        const metaCtx = await loadMetaContext(ctx);
   981→
   982→        // Build unified list for JSON output
   983→        const allItems: Array<{
   984→          type: string;
   985→          id: string;
   986→          _ulid: string;
   987→          name?: string;
   988→          trigger?: string;
   989→          domain?: string;
   990→          content?: string;
   991→        }> = [];
   992→
   993→        for (const agent of metaCtx.agents) {
   994→          if (!options.type || options.type === 'agent') {
   995→            allItems.push({
   996→              type: 'agent',
   997→              id: agent.id,
   998→              _ulid: agent._ulid,
   999→              name: agent.name,
  1000→            });
  1001→          }
  1002→        }
  1003→
  1004→        for (const workflow of metaCtx.workflows) {
  1005→          if (!options.type || options.type === 'workflow') {
  1006→            allItems.push({
  1007→              type: 'workflow',
  1008→              id: workflow.id,
  1009→              _ulid: workflow._ulid,
  1010→              trigger: workflow.trigger,
  1011→            });
  1012→          }
  1013→        }
  1014→
  1015→        for (const conv of metaCtx.conventions) {
  1016→          if (!options.type || options.type === 'convention') {
  1017→            allItems.push({
  1018→              type: 'convention',
  1019→              id: conv.domain,
  1020→              _ulid: conv._ulid,
  1021→              domain: conv.domain,
  1022→            });
  1023→          }
  1024→        }
  1025→
  1026→        for (const obs of metaCtx.observations) {
  1027→          if (!options.type || options.type === 'observation') {
  1028→            allItems.push({
  1029→              type: 'observation',
  1030→              id: shortUlid(obs._ulid),
  1031→              _ulid: obs._ulid,
  1032→              content: obs.content,
  1033→            });
  1034→          }
  1035→        }
  1036→
  1037→        output(allItems, () => formatMetaListTable(metaCtx, options.type));
  1038→      } catch (err) {
  1039→        error('Failed to list meta items', err);
  1040→        process.exit(1);
  1041→      }
  1042→    });
  1043→
  1044→  // kspec meta add <type>
  1045→  meta
  1046→    .command('add <type>')
  1047→    .description('Add a new meta item (agent, workflow, convention)')
  1048→    .option('--id <id>', 'Item ID (required for agent/workflow)')
  1049→    .option('--name <name>', 'Display name (required for agent)')
  1050→    .option('--trigger <trigger>', 'Workflow trigger (required for workflow)')
  1051→    .option('--domain <domain>', 'Convention domain (required for convention)')
  1052→    .option('--description <description>', 'Description')
  1053→    .option('--capabilities <caps>', 'Agent capabilities (comma-separated)')
  1054→    .option('--tools <tools>', 'Agent tools (comma-separated)')
  1055→    .option('--rules <rules...>', 'Convention rules (repeatable)')
  1056→    .action(async (type: string, options) => {
  1057→      try {
  1058→        if (!META_ITEM_TYPES.includes(type)) {
  1059→          error(`Invalid meta item type: ${type}. Valid types: ${META_ITEM_TYPES.join(', ')}`);
  1060→          process.exit(2);
  1061→        }
  1062→
  1063→        const ctx = await initContext();
  1064→
  1065→        if (!ctx.manifestPath) {
  1066→          error('No kspec project found');
  1067→          process.exit(1);
  1068→        }
  1069→
  1070→        const newUlid = ulid();
  1071→
  1072→        if (type === 'agent') {
  1073→          if (!options.id) {
  1074→            error('Agent requires --id');
  1075→            process.exit(2);
  1076→          }
  1077→          if (!options.name) {
  1078→            error('Agent requires --name');
  1079→            process.exit(2);
  1080→          }
  1081→
  1082→          const agent: LoadedAgent = {
  1083→            _ulid: newUlid,
  1084→            id: options.id,
  1085→            name: options.name,
  1086→            description: options.description,
  1087→            capabilities: options.capabilities ? options.capabilities.split(',').map((c: string) => c.trim()) : [],
  1088→            tools: options.tools ? options.tools.split(',').map((t: string) => t.trim()) : [],
  1089→            conventions: [],
  1090→          };
  1091→
  1092→          await saveMetaItem(ctx, agent, 'agent');
  1093→          await commitIfShadow(ctx.shadow, 'meta-add-agent', shortUlid(newUlid));
  1094→          success(`Created agent: ${shortUlid(newUlid)}`, { agent });
  1095→        } else if (type === 'workflow') {
  1096→          if (!options.id) {
  1097→            error('Workflow requires --id');
  1098→            process.exit(2);
  1099→          }
  1100→          if (!options.trigger) {
  1101→            error('Workflow requires --trigger');
  1102→            process.exit(2);
  1103→          }
  1104→
  1105→          const workflow: LoadedWorkflow = {
  1106→            _ulid: newUlid,
  1107→            id: options.id,
  1108→            trigger: options.trigger,
  1109→            description: options.description,
  1110→            steps: [],
  1111→          };
  1112→
  1113→          await saveMetaItem(ctx, workflow, 'workflow');
  1114→          await commitIfShadow(ctx.shadow, 'meta-add-workflow', shortUlid(newUlid));
  1115→          success(`Created workflow: ${shortUlid(newUlid)}`, { workflow });
  1116→        } else if (type === 'convention') {
  1117→          if (!options.domain) {
  1118→            error('Convention requires --domain');
  1119→            process.exit(2);
  1120→          }
  1121→
  1122→          const convention: LoadedConvention = {
  1123→            _ulid: newUlid,
  1124→            domain: options.domain,
  1125→            rules: options.rules || [],
  1126→            examples: [],
  1127→          };
  1128→
  1129→          await saveMetaItem(ctx, convention, 'convention');
  1130→          await commitIfShadow(ctx.shadow, 'meta-add-convention', shortUlid(newUlid));
  1131→          success(`Created convention: ${shortUlid(newUlid)}`, { convention });
  1132→        }
  1133→      } catch (err) {
  1134→        error('Failed to add meta item', err);
  1135→        process.exit(1);
  1136→      }
  1137→    });
  1138→
  1139→  // kspec meta set <ref>
  1140→  meta
  1141→    .command('set <ref>')
  1142→    .description('Update a meta item')
  1143→    .option('--name <name>', 'Update name (agents)')
  1144→    .option('--description <description>', 'Update description')
  1145→    .option('--capabilities <caps>', 'Replace capabilities (agents, comma-separated)')
  1146→    .option('--add-capability <cap>', 'Add capability (agents)')
  1147→    .option('--trigger <trigger>', 'Update trigger (workflows)')
  1148→    .option('--add-step <step>', 'Add workflow step (format: type:content)')
  1149→    .option('--add-rule <rule>', 'Add convention rule')
  1150→    .action(async (ref: string, options) => {
  1151→      try {
  1152→        const ctx = await initContext();
  1153→
  1154→        if (!ctx.manifestPath) {
  1155→          error('No kspec project found');
  1156→          process.exit(1);
  1157→        }
  1158→
  1159→        const metaCtx = await loadMetaContext(ctx);
  1160→        const item = findMetaItemByRef(metaCtx, ref);
  1161→
  1162→        if (!item) {
  1163→          error(`Meta item not found: ${ref}`);
  1164→          process.exit(3);
  1165→        }
  1166→
  1167→        const itemType = getMetaItemType(item);
  1168→
  1169→        if (itemType === 'agent') {
  1170→          const agent = item as LoadedAgent;
  1171→          if (options.name) agent.name = options.name;
  1172→          if (options.description) agent.description = options.description;
  1173→          if (options.capabilities) {
  1174→            agent.capabilities = options.capabilities.split(',').map((c: string) => c.trim());
  1175→          }
  1176→          if (options.addCapability) {
  1177→            if (!agent.capabilities.includes(options.addCapability)) {
  1178→              agent.capabilities.push(options.addCapability);
  1179→            }
  1180→          }
  1181→          await saveMetaItem(ctx, agent, 'agent');
  1182→          await commitIfShadow(ctx.shadow, 'meta-set-agent', shortUlid(agent._ulid));
  1183→          success(`Updated agent: ${shortUlid(agent._ulid)}`, { agent });
  1184→        } else if (itemType === 'workflow') {
  1185→          const workflow = item as LoadedWorkflow;
  1186→          if (options.description) workflow.description = options.description;
  1187→          if (options.trigger) workflow.trigger = options.trigger;
  1188→          if (options.addStep) {
  1189→            const [stepType, ...contentParts] = options.addStep.split(':');
  1190→            const content = contentParts.join(':');
  1191→            if (!['check', 'action', 'decision'].includes(stepType)) {
  1192→              error(`Invalid step type: ${stepType}. Valid types: check, action, decision`);
  1193→              process.exit(2);
  1194→            }
  1195→            workflow.steps.push({
  1196→              type: stepType as 'check' | 'action' | 'decision',
  1197→              content: content || 'New step',
  1198→            });
  1199→          }
  1200→          await saveMetaItem(ctx, workflow, 'workflow');
  1201→          await commitIfShadow(ctx.shadow, 'meta-set-workflow', shortUlid(workflow._ulid));
  1202→          success(`Updated workflow: ${shortUlid(workflow._ulid)}`, { workflow });
  1203→        } else if (itemType === 'convention') {
  1204→          const conv = item as LoadedConvention;
  1205→          if (options.addRule) {
  1206→            conv.rules.push(options.addRule);
  1207→          }
  1208→          await saveMetaItem(ctx, conv, 'convention');
  1209→          await commitIfShadow(ctx.shadow, 'meta-set-convention', shortUlid(conv._ulid));
  1210→          success(`Updated convention: ${shortUlid(conv._ulid)}`, { convention: conv });
  1211→        } else {
  1212→          error('Cannot update observations with meta set. Use meta resolve instead.');
  1213→          process.exit(2);
  1214→        }
  1215→      } catch (err) {
  1216→        error('Failed to update meta item', err);
  1217→        process.exit(1);
  1218→      }
  1219→    });
  1220→
  1221→  // kspec meta delete <ref>
  1222→  meta
  1223→    .command('delete <ref>')
  1224→    .description('Delete a meta item')
  1225→    .option('--force', 'Skip confirmation prompt')
  1226→    .action(async (ref: string, options) => {
  1227→      try {
  1228→        const ctx = await initContext();
  1229→
  1230→        if (!ctx.manifestPath) {
  1231→          error('No kspec project found');
  1232→          process.exit(1);
  1233→        }
  1234→
  1235→        const metaCtx = await loadMetaContext(ctx);
  1236→        const item = findMetaItemByRef(metaCtx, ref);
  1237→
  1238→        if (!item) {
  1239→          error(`Meta item not found: ${ref}`);
  1240→          process.exit(3);
  1241→        }
  1242→
  1243→        const itemType = getMetaItemType(item);
  1244→        const itemId = 'id' in item ? item.id : ('domain' in item ? item.domain : shortUlid(item._ulid));
  1245→
  1246→        // Check for references to this item
  1247→        const tasks = await loadAllTasks(ctx);
  1248→        const referencingTasks = tasks.filter((t) => {
  1249→          const metaRef = t.meta_ref;
  1250→          if (!metaRef) return false;
  1251→          const cleanRef = metaRef.startsWith('@') ? metaRef.slice(1) : metaRef;
  1252→          return cleanRef === item._ulid ||
  1253→            item._ulid.toLowerCase().startsWith(cleanRef.toLowerCase()) ||
  1254→            ('id' in item && item.id === cleanRef) ||
  1255→            ('domain' in item && item.domain === cleanRef);
  1256→        });
  1257→
  1258→        if (referencingTasks.length > 0 && !options.force) {
  1259→          error(`Cannot delete: ${referencingTasks.length} task(s) reference this item. Use --force to override.`);
  1260→          process.exit(1);
  1261→        }
  1262→
  1263→        // Confirm deletion unless --force
  1264→        if (!options.force && !isJsonMode()) {
  1265→          const answer = await prompt(`Delete ${itemType} "${itemId}"? (yes/no): `);
  1266→          if (answer.toLowerCase() !== 'yes' && answer.toLowerCase() !== 'y') {
  1267→            info('Cancelled');
  1268→            process.exit(0);
  1269→          }
  1270→        }
  1271→
  1272→        const deleted = await deleteMetaItem(ctx, item._ulid, itemType);
  1273→        if (!deleted) {
  1274→          error('Failed to delete meta item');
  1275→          process.exit(1);
  1276→        }
  1277→
  1278→        await commitIfShadow(ctx.shadow, 'meta-delete', shortUlid(item._ulid));
  1279→        success(`Deleted ${itemType}: ${itemId}`, { deleted: true, type: itemType, id: itemId });
  1280→      } catch (err) {
  1281→        error('Failed to delete meta item', err);
  1282→        process.exit(1);
  1283→      }
  1284→    });
  1285→
  1286→  // kspec meta focus [ref]
  1287→  meta
  1288→    .command('focus [ref]')
  1289→    .description('Get or set session focus')
  1290→    .option('--clear', 'Clear current focus')
  1291→    .action(async (ref: string | undefined, options) => {
  1292→      try {
  1293→        const ctx = await initContext();
  1294→
  1295→        if (!ctx.manifestPath) {
  1296→          error('No kspec project found');
  1297→          process.exit(1);
  1298→        }
  1299→
  1300→        const context = await loadSessionContext(ctx);
  1301→
  1302→        if (options.clear) {
  1303→          context.focus = null;
  1304→          await saveSessionContext(ctx, context);
  1305→          success('Cleared focus', { focus: null });
  1306→        } else if (ref) {
  1307→          const cleanRef = ref.startsWith('@') ? ref : `@${ref}`;
  1308→          context.focus = cleanRef;
  1309→          await saveSessionContext(ctx, context);
  1310→          success(`Set focus: ${cleanRef}`, { focus: cleanRef });
  1311→        } else {
  1312→          if (context.focus) {
  1313→            output({ focus: context.focus }, () => {
  1314→              console.log(`Focus: ${chalk.cyan(context.focus)}`);
  1315→            });
  1316→          } else {
  1317→            output({ focus: null }, () => {
  1318→              console.log(chalk.gray('No focus set'));
  1319→            });
  1320→          }
  1321→        }
  1322→      } catch (err) {
  1323→        error('Failed to manage focus', err);
  1324→        process.exit(1);
  1325→      }
  1326→    });
  1327→
  1328→  // kspec meta thread <action> [text]
  1329→  meta
  1330→    .command('thread <action> [text]')
  1331→    .description('Manage active threads (add, remove, list, clear)')
  1332→    .action(async (action: string, text: string | undefined) => {
  1333→      try {
  1334→        const ctx = await initContext();
  1335→
  1336→        if (!ctx.manifestPath) {
  1337→          error('No kspec project found');
  1338→          process.exit(1);
  1339→        }
  1340→
  1341→        const context = await loadSessionContext(ctx);
  1342→
  1343→        switch (action) {
  1344→          case 'add':
  1345→            if (!text) {
  1346→              error('Thread text is required');
  1347→              process.exit(2);
  1348→            }
  1349→            context.threads.push(text);
  1350→            await saveSessionContext(ctx, context);
  1351→            success(`Added thread: "${text}"`, { threads: context.threads });
  1352→            break;
  1353→          case 'remove': {
  1354→            if (!text) {
  1355→              error('Thread index is required');
  1356→              process.exit(2);
  1357→            }
  1358→            const index = parseInt(text, 10) - 1; // 1-indexed for user
  1359→            if (isNaN(index) || index < 0 || index >= context.threads.length) {
  1360→              error(`Invalid thread index: ${text}`);
  1361→              process.exit(2);
  1362→            }
  1363→            const removed = context.threads.splice(index, 1)[0];
  1364→            await saveSessionContext(ctx, context);
  1365→            success(`Removed thread: "${removed}"`, { threads: context.threads });
  1366→            break;
  1367→          }
  1368→          case 'list':
  1369→            output({ threads: context.threads }, () => {
  1370→              if (context.threads.length === 0) {
  1371→                console.log(chalk.gray('No active threads'));
  1372→              } else {
  1373→                console.log(chalk.bold('Active Threads:'));
  1374→                for (let i = 0; i < context.threads.length; i++) {
  1375→                  console.log(`  ${i + 1}. ${context.threads[i]}`);
  1376→                }
  1377→              }
  1378→            });
  1379→            break;
  1380→          case 'clear':
  1381→            context.threads = [];
  1382→            await saveSessionContext(ctx, context);
  1383→            success('Cleared all threads', { threads: [] });
  1384→            break;
  1385→          default:
  1386→            error(`Invalid action: ${action}. Valid actions: add, remove, list, clear`);
  1387→            process.exit(2);
  1388→        }
  1389→      } catch (err) {
  1390→        error('Failed to manage threads', err);
  1391→        process.exit(1);
  1392→      }
  1393→    });
  1394→
  1395→  // kspec meta question <action> [text]
  1396→  meta
  1397→    .command('question <action> [text]')
  1398→    .description('Manage open questions (add, remove, list, clear)')
  1399→    .action(async (action: string, text: string | undefined) => {
  1400→      try {
  1401→        const ctx = await initContext();
  1402→
  1403→        if (!ctx.manifestPath) {
  1404→          error('No kspec project found');
  1405→          process.exit(1);
  1406→        }
  1407→
  1408→        const context = await loadSessionContext(ctx);
