  1443→                }
  1444→              }
  1445→            });
  1446→            break;
  1447→          case 'clear':
  1448→            context.open_questions = [];
  1449→            await saveSessionContext(ctx, context);
  1450→            success('Cleared all questions', { open_questions: [] });
  1451→            break;
  1452→          default:
  1453→            error(`Invalid action: ${action}. Valid actions: add, remove, list, clear`);
  1454→            process.exit(2);
  1455→        }
  1456→      } catch (err) {
  1457→        error('Failed to manage questions', err);
  1458→        process.exit(1);
  1459→      }
  1460→    });
  1461→
  1462→  // kspec meta context
  1463→  meta
  1464→    .command('context')
  1465→    .description('Show full session context')
  1466→    .option('--clear', 'Clear all context')
  1467→    .action(async (options) => {
  1468→      try {
  1469→        const ctx = await initContext();
  1470→
  1471→        if (!ctx.manifestPath) {
  1472→          error('No kspec project found');
  1473→          process.exit(1);
  1474→        }
  1475→
  1476→        if (options.clear) {
  1477→          const emptyContext: SessionContext = {
  1478→            focus: null,
  1479→            threads: [],
  1480→            open_questions: [],
  1481→            updated_at: new Date().toISOString(),
  1482→          };
  1483→          await saveSessionContext(ctx, emptyContext);
  1484→          success('Cleared session context', { context: emptyContext });
  1485→        } else {
  1486→          const context = await loadSessionContext(ctx);
  1487→          output(context, () => formatSessionContext(context));
  1488→        }
  1489→      } catch (err) {
  1490→        error('Failed to manage context', err);
  1491→        process.exit(1);
  1492→      }
  1493→    });
  1494→}
