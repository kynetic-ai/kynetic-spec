  1414→              process.exit(2);
  1415→            }
  1416→            context.open_questions.push(text);
  1417→            await saveSessionContext(ctx, context);
  1418→            success(`Added question: "${text}"`, { open_questions: context.open_questions });
  1419→            break;
  1420→          case 'remove': {
  1421→            if (!text) {
  1422→              error('Question index is required');
  1423→              process.exit(2);
  1424→            }
  1425→            const index = parseInt(text, 10) - 1; // 1-indexed for user
  1426→            if (isNaN(index) || index < 0 || index >= context.open_questions.length) {
  1427→              error(`Invalid question index: ${text}`);
  1428→              process.exit(2);
  1429→            }
  1430→            const removed = context.open_questions.splice(index, 1)[0];
  1431→            await saveSessionContext(ctx, context);
  1432→            success(`Removed question: "${removed}"`, { open_questions: context.open_questions });
  1433→            break;
  1434→          }
  1435→          case 'list':
