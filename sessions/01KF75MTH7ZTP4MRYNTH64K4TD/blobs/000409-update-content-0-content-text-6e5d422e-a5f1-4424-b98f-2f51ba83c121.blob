```
     1→/**
     2→ * Meta CLI commands for interacting with meta-spec.
     3→ *
     4→ * Commands:
     5→ * - kspec meta show: Display meta-spec summary
     6→ * - kspec meta agents: List defined agents
     7→ * - kspec meta workflows: List defined workflows
     8→ * - kspec meta conventions: List defined conventions
     9→ * - kspec meta observe: Create an observation
    10→ * - kspec meta observations: List observations
    11→ * - kspec meta promote: Promote observation to task
    12→ * - kspec meta resolve: Resolve an observation
    13→ */
    14→
    15→import { Command } from 'commander';
    16→import chalk from 'chalk';
    17→import * as readline from 'node:readline';
    18→import { ulid } from 'ulid';
    19→import yaml from 'js-yaml';
    20→import {
    21→  initContext,
    22→  loadMetaContext,
    23→  getMetaStats,
    24→  findMetaItemByRef,
    25→  createObservation,
    26→  saveObservation,
    27→  createTask,
    28→  saveTask,
    29→  loadAllTasks,
    30→  loadAllItems,
    31→  ReferenceIndex,
    32→  saveMetaItem,
    33→  deleteMetaItem,
    34→  getSessionContextPath,
    35→  loadSessionContext,
    36→  saveSessionContext,
    37→  type MetaContext,
    38→  type LoadedObservation,
    39→  type LoadedAgent,
    40→  type LoadedWorkflow,
    41→  type LoadedConvention,
    42→  type LoadedMetaItem,
    43→  type SessionContext,
    44→} from '../../parser/index.js';
    45→import { commitIfShadow } from '../../parser/shadow.js';
    46→import type { TaskInput, ObservationType } from '../../schema/index.js';
    47→import { output, success, error, info, isJsonMode } from '../output.js';
    48→
    49→/**
    50→ * Format meta show output
    51→ */
    52→function formatMetaShow(meta: MetaContext): void {
    53→  const stats = getMetaStats(meta);
    54→
    55→  if (!meta.manifest) {
    56→    console.log(chalk.yellow('No meta manifest found (kynetic.meta.yaml)'));
    57→    console.log(chalk.gray('Run `kspec init --meta` to create one'));
    58→    return;
    59→  }
    60→
    61→  console.log(chalk.bold('Meta-Spec Summary'));
    62→  console.log(chalk.gray('─'.repeat(40)));
    63→  console.log(`Agents:       ${stats.agents}`);
    64→  console.log(`Workflows:    ${stats.workflows}`);
    65→  console.log(`Conventions:  ${stats.conventions}`);
    66→  console.log(`Observations: ${stats.observations} (${stats.unresolvedObservations} unresolved)`);
    67→}
    68→
    69→/**
    70→ * Format agents table output
    71→ */
    72→function formatAgentsTable(meta: MetaContext): void {
    73→  if (meta.agents.length === 0) {
    74→    console.log(chalk.gray('No agents defined'));
    75→    return;
    76→  }
    77→
    78→  console.log(chalk.bold('Agents'));
    79→  console.log(chalk.gray('─'.repeat(60)));
    80→
    81→  for (const agent of meta.agents) {
    82→    const caps = agent.capabilities.join(', ') || chalk.gray('none');
    83→    console.log(`${chalk.cyan(agent.id.padEnd(15))} ${agent.name.padEnd(30)} ${caps}`);
    84→  }
    85→
    86→  console.log(chalk.gray(`\n${meta.agents.length} agent(s)`));
    87→}
    88→
    89→/**
    90→ * Format workflows table output
    91→ */
    92→function formatWorkflowsTable(meta: MetaContext, verbose: boolean): void {
    93→  if (meta.workflows.length === 0) {
    94→    console.log(chalk.gray('No workflows defined'));
    95→    return;
    96→  }
    97→
    98→  console.log(chalk.bold('Workflows'));
    99→  console.log(chalk.gray('─'.repeat(60)));
   100→
   101→  for (const workflow of meta.workflows) {
   102→    const stepCount = workflow.steps.length;
   103→    console.log(`${chalk.cyan(workflow.id.padEnd(20))} ${workflow.trigger.padEnd(25)} ${stepCount} step(s)`);
   104→
   105→    if (verbose && workflow.steps.length > 0) {
   106→      for (const step of workflow.steps) {
   107→        const typePrefix = {
   108→          check: chalk.yellow('[check]'),
   109→          action: chalk.blue('[action]'),
   110→          decision: chalk.magenta('[decision]'),
   111→        }[step.type];
   112→
   113→        console.log(`  ${typePrefix} ${step.content}`);
   114→        if (step.on_fail) {
   115→          console.log(chalk.gray(`    on_fail: ${step.on_fail}`));
   116→        }
   117→      }
   118→      console.log('');
   119→    }
   120→  }
   121→
   122→  console.log(chalk.gray(`\n${meta.workflows.length} workflow(s)`));
   123→}
   124→
   125→/**
   126→ * Format conventions table output
   127→ */
   128→function formatConventionsTable(meta: MetaContext, domain?: string): void {
   129→  let conventions = meta.conventions;
   130→
   131→  if (domain) {
   132→    conventions = conventions.filter((c) => c.domain === domain);
   133→  }
   134→
   135→  if (conventions.length === 0) {
   136→    if (domain) {
   137→      console.log(chalk.gray(`No convention found for domain: ${domain}`));
   138→    } else {
   139→      console.log(chalk.gray('No conventions defined'));
   140→    }
   141→    return;
   142→  }
   143→
   144→  console.log(chalk.bold('Conventions'));
   145→  console.log(chalk.gray('─'.repeat(60)));
   146→
   147→  for (const conv of conventions) {
   148→    const ruleCount = conv.rules.length;
   149→    const hasValidation = conv.validation ? 'yes' : 'no';
   150→    console.log(
   151→      `${chalk.cyan(conv.domain.padEnd(15))} ${ruleCount} rule(s)`.padEnd(35) +
   152→        ` Validation: ${hasValidation}`
   153→    );
   154→
   155→    // If filtering by domain, show full details
   156→    if (domain) {
   157→      if (conv.rules.length > 0) {
   158→        console.log(chalk.gray('\nRules:'));
   159→        for (const rule of conv.rules) {
   160→          console.log(chalk.gray(`  - ${rule}`));
   161→        }
   162→      }
   163→      if (conv.examples.length > 0) {
   164→        console.log(chalk.gray('\nExamples:'));
   165→        for (const ex of conv.examples) {
   166→          console.log(chalk.green(`  Good: ${ex.good}`));
   167→          console.log(chalk.red(`  Bad:  ${ex.bad}`));
   168→        }
   169→      }
   170→    }
   171→  }
   172→
   173→  if (!domain) {
   174→    console.log(chalk.gray(`\n${conventions.length} convention(s)`));
   175→  }
   176→}
   177→
   178→/**
   179→ * Format relative time for display
   180→ */
   181→function formatRelativeTime(dateStr: string): string {
   182→  const date = new Date(dateStr);
   183→  const now = new Date();
   184→  const diffMs = now.getTime() - date.getTime();
   185→  const diffMins = Math.floor(diffMs / 60000);
   186→  const diffHours = Math.floor(diffMs / 3600000);
   187→  const diffDays = Math.floor(diffMs / 86400000);
   188→
   189→  if (diffMins < 1) return 'just now';
   190→  if (diffMins < 60) return `${diffMins} minute${diffMins === 1 ? '' : 's'} ago`;
   191→  if (diffHours < 24) return `${diffHours} hour${diffHours === 1 ? '' : 's'} ago`;
   192→  if (diffDays < 7) return `${diffDays} day${diffDays === 1 ? '' : 's'} ago`;
   193→  return date.toLocaleDateString();
   194→}
   195→
   196→/**
   197→ * Get short ULID for display (first 8 chars)
   198→ */
   199→function shortUlid(ulid: string): string {
   200→  return ulid.slice(0, 8);
   201→}
   202→
   203→/**
   204→ * Truncate string for display
   205→ */
   206→function truncate(str: string, maxLen: number): string {
   207→  if (str.length <= maxLen) return str;
   208→  return str.slice(0, maxLen - 3) + '...';
   209→}
   210→
   211→/**
   212→ * Simple prompt for user input
   213→ */
   214→async function prompt(question: string): Promise<string> {
   215→  const rl = readline.createInterface({
   216→    input: process.stdin,
   217→    output: process.stdout,
   218→  });
   219→
   220→  return new Promise((resolve) => {
   221→    rl.question(question, (answer) => {
   222→      rl.close();
   223→      resolve(answer.trim());
   224→    });
   225→  });
   226→}
   227→
   228→/**
   229→ * Find observation by ref with error handling
   230→ */
   231→function findObservationByRef(
   232→  meta: MetaContext,
   233→  ref: string
   234→): LoadedObservation {
   235→  const item = findMetaItemByRef(meta, ref);
   236→  if (!item) {
   237→    error(`Observation not found: ${ref}`);
   238→    process.exit(3);
   239→  }
   240→  if (!('content' in item) || !('resolved' in item)) {
   241→    error(`Reference is not an observation: ${ref}`);
   242→    process.exit(3);
   243→  }
   244→  return item as LoadedObservation;
   245→}
   246→
   247→/**
   248→ * Format observations table output
   249→ */
   250→function formatObservationsTable(observations: LoadedObservation[]): void {
   251→  if (observations.length === 0) {
   252→    console.log(chalk.gray('No observations found'));
   253→    return;
   254→  }
   255→
   256→  console.log(chalk.bold('Observations'));
   257→  console.log(chalk.gray('─'.repeat(80)));
   258→
   259→  // Header
   260→  console.log(
   261→    `${chalk.gray('ID'.padEnd(10))} ` +
   262→    `${chalk.gray('Type'.padEnd(10))} ` +
   263→    `${chalk.gray('Workflow'.padEnd(15))} ` +
   264→    `${chalk.gray('Created'.padEnd(14))} ` +
   265→    `${chalk.gray('Content')}`
   266→  );
   267→
   268→  for (const obs of observations) {
   269→    const typeColors: Record<string, (s: string) => string> = {
   270→      friction: chalk.red,
   271→      success: chalk.green,
   272→      question: chalk.yellow,
   273→      idea: chalk.blue,
   274→    };
   275→    const colorFn = typeColors[obs.type] || chalk.white;
   276→
   277→    const workflow = obs.workflow_ref ? obs.workflow_ref.slice(0, 13) : '-';
   278→    const created = formatRelativeTime(obs.created_at).padEnd(14);
   279→    const content = truncate(obs.content.replace(/\n/g, ' '), 35);
   280→    const resolved = obs.resolved ? chalk.gray(' [resolved]') : '';
   281→
   282→    console.log(
   283→      `${shortUlid(obs._ulid).padEnd(10)} ` +
   284→      `${colorFn(obs.type.padEnd(10))} ` +
   285→      `${workflow.padEnd(15)} ` +
   286→      `${created} ` +
   287→      `${content}${resolved}`
   288→    );
   289→  }
   290→
   291→  console.log(chalk.gray(`\n${observations.length} observation(s)`));
   292→}
   293→
   294→/**
   295→ * Valid observation types
   296→ */
   297→const OBSERVATION_TYPES = ['friction', 'success', 'question', 'idea'];
