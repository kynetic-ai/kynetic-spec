   684→    .option('--workflow <ref>', 'Link to a workflow')
   685→    .action(async (type: string, description: string, options) => {
   686→      try {
   687→        // Validate type
   688→        if (!OBSERVATION_TYPES.includes(type)) {
   689→          error(`Invalid observation type: ${type}. Valid types: ${OBSERVATION_TYPES.join(', ')}`);
   690→          process.exit(2);
