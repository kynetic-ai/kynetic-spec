   299→/**
   300→ * Valid meta item types for add command
   301→ */
   302→const META_ITEM_TYPES = ['agent', 'workflow', 'convention'];
   303→
   304→/**
   305→ * Format a single meta item for display (get command)
   306→ */
   307→function formatMetaItem(item: LoadedMetaItem): void {
   308→  const itemType = getMetaItemType(item);
   309→
   310→  switch (itemType) {
   311→    case 'agent': {
   312→      const agent = item as LoadedAgent;
   313→      console.log(chalk.bold(agent.name));
   314→      console.log(chalk.gray('─'.repeat(40)));
   315→      console.log(`ID:           ${chalk.cyan(agent.id)}`);
   316→      console.log(`ULID:         ${agent._ulid}`);
   317→      console.log(`Type:         agent`);
   318→      if (agent.description) {
   319→        console.log(`\n${chalk.gray('Description:')}`);
   320→        console.log(agent.description.trim());
   321→      }
   322→      if (agent.capabilities.length > 0) {
   323→        console.log(`\nCapabilities: ${agent.capabilities.join(', ')}`);
   324→      }
   325→      if (agent.tools.length > 0) {
   326→        console.log(`Tools:        ${agent.tools.join(', ')}`);
   327→      }
   328→      if (agent.session_protocol) {
   329→        console.log(`\n${chalk.gray('Session Protocol:')}`);
   330→        if (agent.session_protocol.start) console.log(`  start:      ${agent.session_protocol.start}`);
   331→        if (agent.session_protocol.checkpoint) console.log(`  checkpoint: ${agent.session_protocol.checkpoint}`);
   332→        if (agent.session_protocol.end) console.log(`  end:        ${agent.session_protocol.end}`);
   333→      }
   334→      if (agent.conventions.length > 0) {
   335→        console.log(`\n${chalk.gray('Conventions:')}`);
   336→        for (const conv of agent.conventions) {
   337→          console.log(`  - ${conv}`);
   338→        }
   339→      }
   340→      break;
   341→    }
   342→    case 'workflow': {
   343→      const workflow = item as LoadedWorkflow;
   344→      console.log(chalk.bold(workflow.id));
   345→      console.log(chalk.gray('─'.repeat(40)));
   346→      console.log(`ULID:    ${workflow._ulid}`);
   347→      console.log(`Type:    workflow`);
   348→      console.log(`Trigger: ${workflow.trigger}`);
   349→      if (workflow.description) {
   350→        console.log(`\n${chalk.gray('Description:')}`);
   351→        console.log(workflow.description.trim());
   352→      }
   353→      if (workflow.steps.length > 0) {
   354→        console.log(`\n${chalk.gray('Steps:')}`);
   355→        for (const step of workflow.steps) {
   356→          const typePrefix = {
   357→            check: chalk.yellow('[check]'),
   358→            action: chalk.blue('[action]'),
   359→            decision: chalk.magenta('[decision]'),
   360→          }[step.type];
   361→          console.log(`  ${typePrefix} ${step.content}`);
   362→          if (step.on_fail) {
   363→            console.log(chalk.gray(`    on_fail: ${step.on_fail}`));
   364→          }
   365→        }
   366→      }
   367→      break;
   368→    }
   369→    case 'convention': {
   370→      const conv = item as LoadedConvention;
   371→      console.log(chalk.bold(conv.domain));
   372→      console.log(chalk.gray('─'.repeat(40)));
   373→      console.log(`ULID: ${conv._ulid}`);
   374→      console.log(`Type: convention`);
   375→      if (conv.rules.length > 0) {
   376→        console.log(`\n${chalk.gray('Rules:')}`);
   377→        for (const rule of conv.rules) {
   378→          console.log(`  - ${rule}`);
   379→        }
   380→      }
   381→      if (conv.examples.length > 0) {
   382→        console.log(`\n${chalk.gray('Examples:')}`);
   383→        for (const ex of conv.examples) {
   384→          console.log(chalk.green(`  Good: ${ex.good}`));
   385→          console.log(chalk.red(`  Bad:  ${ex.bad}`));
   386→        }
   387→      }
   388→      if (conv.validation) {
   389→        console.log(`\n${chalk.gray('Validation:')}`);
   390→        console.log(`  type: ${conv.validation.type}`);
   391→        if (conv.validation.pattern) console.log(`  pattern: ${conv.validation.pattern}`);
   392→      }
   393→      break;
   394→    }
   395→    case 'observation': {
   396→      const obs = item as LoadedObservation;
   397→      console.log(chalk.bold(`Observation: ${obs.type}`));
   398→      console.log(chalk.gray('─'.repeat(40)));
   399→      console.log(`ULID:     ${obs._ulid}`);
   400→      console.log(`Type:     observation (${obs.type})`);
   401→      console.log(`Author:   ${obs.author || 'unknown'}`);
   402→      console.log(`Created:  ${formatRelativeTime(obs.created_at)}`);
   403→      if (obs.workflow_ref) {
   404→        console.log(`Workflow: ${obs.workflow_ref}`);
   405→      }
   406→      console.log(`Resolved: ${obs.resolved ? 'yes' : 'no'}`);
   407→      console.log(`\n${chalk.gray('Content:')}`);
   408→      console.log(obs.content.trim());
   409→      if (obs.resolved && obs.resolution) {
   410→        console.log(`\n${chalk.gray('Resolution:')}`);
   411→        console.log(obs.resolution);
   412→      }
   413→      if (obs.promoted_to) {
   414→        console.log(`\nPromoted to: ${obs.promoted_to}`);
   415→      }
   416→      break;
   417→    }
   418→  }
   419→}
   420→
   421→/**
   422→ * Get the meta item type from a loaded item
   423→ */
   424→function getMetaItemType(item: LoadedMetaItem): 'agent' | 'workflow' | 'convention' | 'observation' {
   425→  if ('capabilities' in item) return 'agent';
   426→  if ('trigger' in item) return 'workflow';
   427→  if ('domain' in item) return 'convention';
   428→  return 'observation';
   429→}
   430→
   431→/**
   432→ * Format meta list table
   433→ */
   434→function formatMetaListTable(meta: MetaContext, typeFilter?: string): void {
   435→  const items: { type: string; id: string; ulid: string; label: string }[] = [];
   436→
   437→  for (const agent of meta.agents) {
   438→    if (!typeFilter || typeFilter === 'agent') {
   439→      items.push({
   440→        type: 'agent',
   441→        id: agent.id,
   442→        ulid: agent._ulid,
   443→        label: agent.name,
   444→      });
   445→    }
   446→  }
   447→
   448→  for (const workflow of meta.workflows) {
   449→    if (!typeFilter || typeFilter === 'workflow') {
   450→      items.push({
   451→        type: 'workflow',
   452→        id: workflow.id,
   453→        ulid: workflow._ulid,
   454→        label: workflow.trigger,
   455→      });
   456→    }
   457→  }
   458→
   459→  for (const conv of meta.conventions) {
   460→    if (!typeFilter || typeFilter === 'convention') {
   461→      items.push({
   462→        type: 'convention',
   463→        id: conv.domain,
   464→        ulid: conv._ulid,
   465→        label: `${conv.rules.length} rule(s)`,
   466→      });
   467→    }
   468→  }
   469→
   470→  for (const obs of meta.observations) {
   471→    if (!typeFilter || typeFilter === 'observation') {
   472→      items.push({
   473→        type: 'observation',
   474→        id: shortUlid(obs._ulid),
   475→        ulid: obs._ulid,
   476→        label: truncate(obs.content, 30),
   477→      });
   478→    }
   479→  }
   480→
   481→  if (items.length === 0) {
   482→    console.log(chalk.gray(typeFilter ? `No ${typeFilter}s found` : 'No meta items found'));
   483→    return;
   484→  }
   485→
   486→  console.log(chalk.bold('Meta Items'));
   487→  console.log(chalk.gray('─'.repeat(70)));
   488→  console.log(
   489→    `${chalk.gray('Type'.padEnd(12))} ` +
   490→    `${chalk.gray('ID'.padEnd(20))} ` +
   491→    `${chalk.gray('Label')}`
   492→  );
   493→
   494→  for (const item of items) {
   495→    const typeColors: Record<string, (s: string) => string> = {
   496→      agent: chalk.cyan,
   497→      workflow: chalk.yellow,
   498→      convention: chalk.green,
   499→      observation: chalk.magenta,
   500→    };
   501→    const colorFn = typeColors[item.type] || chalk.white;
   502→    console.log(
   503→      `${colorFn(item.type.padEnd(12))} ` +
   504→      `${item.id.padEnd(20)} ` +
   505→      `${item.label}`
   506→    );
   507→  }
   508→
   509→  console.log(chalk.gray(`\n${items.length} item(s)`));
   510→}
   511→
   512→/**
   513→ * Format session context for display
   514→ */
   515→function formatSessionContext(context: SessionContext): void {
   516→  console.log(chalk.bold('Session Context'));
   517→  console.log(chalk.gray('─'.repeat(40)));
   518→
   519→  if (context.focus) {
   520→    console.log(`Focus: ${chalk.cyan(context.focus)}`);
   521→  } else {
   522→    console.log(`Focus: ${chalk.gray('(none)')}`);
   523→  }
   524→
   525→  if (context.threads.length > 0) {
   526→    console.log(`\n${chalk.gray('Active Threads:')}`);
   527→    for (const thread of context.threads) {
   528→      console.log(`  - ${thread}`);
   529→    }
   530→  }
   531→
   532→  if (context.open_questions.length > 0) {
   533→    console.log(`\n${chalk.gray('Open Questions:')}`);
   534→    for (const question of context.open_questions) {
   535→      console.log(`  - ${question}`);
   536→    }
   537→  }
   538→
   539→  console.log(`\nLast updated: ${formatRelativeTime(context.updated_at)}`);
   540→}
   541→
   542→/**
   543→ * Register meta commands
   544→ */
   545→export function registerMetaCommands(program: Command): void {
   546→  const meta = program
   547→    .command('meta')
   548→    .description('Meta-spec commands (agents, workflows, conventions, observations)');
   549→
   550→  // kspec meta show
   551→  meta
   552→    .command('show')
   553→    .description('Display meta-spec summary')
   554→    .action(async () => {
   555→      try {
   556→        const ctx = await initContext();
   557→
   558→        if (!ctx.manifestPath) {
   559→          error('No kspec project found');
   560→          process.exit(1);
   561→        }
   562→
   563→        const metaCtx = await loadMetaContext(ctx);
   564→        const stats = getMetaStats(metaCtx);
   565→
   566→        output(
   567→          {
   568→            manifest: metaCtx.manifestPath,
   569→            stats,
   570→          },
   571→          () => formatMetaShow(metaCtx)
   572→        );
   573→      } catch (err) {
   574→        error('Failed to show meta', err);
   575→        process.exit(1);
   576→      }
   577→    });
   578→
   579→  // kspec meta agents
   580→  meta
   581→    .command('agents')
   582→    .description('List defined agents')
   583→    .option('--capabilities', 'Group by capabilities')
   584→    .action(async (options) => {
   585→      try {
   586→        const ctx = await initContext();
   587→
   588→        if (!ctx.manifestPath) {
   589→          error('No kspec project found');
   590→          process.exit(1);
   591→        }
   592→
   593→        const metaCtx = await loadMetaContext(ctx);
   594→
   595→        output(
   596→          metaCtx.agents.map((a) => ({
   597→            id: a.id,
   598→            name: a.name,
   599→            description: a.description,
   600→            capabilities: a.capabilities,
   601→            tools: a.tools,
   602→            session_protocol: a.session_protocol,
   603→            conventions: a.conventions,
   604→          })),
   605→          () => formatAgentsTable(metaCtx)
   606→        );
   607→      } catch (err) {
   608→        error('Failed to list agents', err);
   609→        process.exit(1);
   610→      }
   611→    });
