    80→
    81→          agents:
    82→            - _ulid: ...
    83→              id: claude
    84→              name: Claude Code Agent
    85→              ...
    86→
    87→          workflows:
    88→            - _ulid: ...
    89→              id: spec-first
    90→              trigger: behavior change
    91→              ...
    92→
    93→          conventions:
    94→            - _ulid: ...
    95→              domain: commits
    96→              ...
    97→
    98→          observations:
    99→            - _ulid: ...
   100→              type: friction
   101→              ...
   102→
   103→          includes:
   104→            - meta/agents.yaml
   105→            - meta/workflows.yaml
   106→          ```
