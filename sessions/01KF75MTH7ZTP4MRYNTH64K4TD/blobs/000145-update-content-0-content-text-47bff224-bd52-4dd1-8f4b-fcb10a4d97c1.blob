  1362→    created: '2026-01-17T05:46:34.849Z'
  1363→  - _ulid: 01KF1XREF00000000000000000
  1364→    slugs:
  1365→      - meta-ref
  1366→      - meta-task-link
  1367→    title: Meta Reference Integration
  1368→    type: feature
  1369→    status:
  1370→      maturity: draft
  1371→      implementation: implemented
  1372→    priority: high
  1373→    tags:
  1374→      - mvp
  1375→      - meta
  1376→      - tasks
  1377→    description: |
  1378→      Tasks can reference meta items via meta_ref, just like spec_ref.
  1379→      This enables tracking work on process improvements - the key to
  1380→      the self-improvement loop.
  1381→    acceptance_criteria:
  1382→      - id: ac-meta-ref-1
  1383→        given: kspec task add --meta-ref @workflow-id runs
  1384→        when: the @workflow-id is a valid workflow reference
  1385→        then: >
  1386→          task created with meta_ref field set to @workflow-id; outputs "OK Created task:
  1387→          <ULID-prefix>"
  1388→      - id: ac-meta-ref-2
  1389→        given: tasks exist with meta_ref fields
  1390→        when: kspec tasks list --meta-ref @workflow runs
  1391→        then: >
  1392→          outputs only tasks where meta_ref matches @workflow; same output format as regular task
  1393→          list
  1394→      - id: ac-meta-ref-3
  1395→        given: kspec task add --meta-ref @invalid-ref runs
  1396→        when: the reference does not resolve to a meta item
  1397→        then: >
  1398→          exits with code 1; error message: "meta_ref '@invalid-ref' does not resolve to a valid
  1399→          meta item (agent, workflow, or convention)"
  1400→      - id: ac-meta-ref-4
  1401→        given: kspec task add --meta-ref @spec-item runs
  1402→        when: the reference is a product spec item (not meta)
  1403→        then: >
  1404→          exits with code 1; error message: "meta_ref '@spec-item' points to a spec item; use
  1405→          --spec-ref for product spec references"
  1406→    requirements:
  1407→      - _ulid: 01KF1XREF10000000000000000
  1408→        slugs:
