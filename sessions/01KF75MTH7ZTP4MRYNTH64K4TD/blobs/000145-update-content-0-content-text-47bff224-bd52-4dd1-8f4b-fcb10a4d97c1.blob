  1295→          --id <id> --name <name> --capabilities <cap1,cap2>
  1296→
  1297→          For workflows:
  1298→          --id <id> --trigger <trigger> --description <desc>
  1299→
  1300→          For conventions:
  1301→          --domain <domain> --rules <rule1> --rules <rule2>
  1302→
  1303→          Example:
  1304→          kspec meta add agent --id human --name "Human Developer" --capabilities code,review
  1305→          kspec meta add workflow --id pr-review --trigger "pull request opened"
