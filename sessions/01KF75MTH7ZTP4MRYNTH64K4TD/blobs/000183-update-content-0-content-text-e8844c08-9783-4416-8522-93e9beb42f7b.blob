   219→/**
   220→ * Register meta commands
   221→ */
   222→export function registerMetaCommand(program: Command): void {
   223→  const meta = program
   224→    .command('meta')
   225→    .description('Manage meta-spec (agents, workflows, conventions, observations)');
   226→
   227→  // kspec meta show
   228→  meta
   229→    .command('show')
   230→    .description('Show meta manifest summary')
   231→    .option('--json', 'Output as JSON')
   232→    .action(async (options) => {
   233→      try {
   234→        const ctx = await initContext();
   235→
   236→        if (!ctx.manifestPath) {
   237→          error('No kspec manifest found');
   238→          console.log('Run `kspec init` to create a new project');
   239→          process.exit(1);
   240→        }
   241→
   242→        const manifest = await loadMetaManifest(ctx);
   243→
   244→        if (!manifest) {
   245→          error('No meta manifest found (kynetic.meta.yaml)');
   246→          console.log('The meta manifest defines agents, workflows, and conventions for the project.');
   247→          process.exit(1);
   248→        }
   249→
   250→        output(manifest, () => formatMetaShow(manifest));
   251→      } catch (err) {
   252→        error('Failed to load meta manifest', err);
   253→        process.exit(1);
   254→      }
   255→    });
   256→
   257→  // kspec meta agents
   258→  meta
   259→    .command('agents')
   260→    .description('List agents defined in meta manifest')
   261→    .option('--json', 'Output as JSON')
   262→    .action(async (options) => {
   263→      try {
   264→        const ctx = await initContext();
   265→
   266→        if (!ctx.manifestPath) {
   267→          error('No kspec manifest found');
   268→          console.log('Run `kspec init` to create a new project');
   269→          process.exit(1);
   270→        }
   271→
   272→        const manifest = await loadMetaManifest(ctx);
   273→
   274→        if (!manifest) {
   275→          error('No meta manifest found (kynetic.meta.yaml)');
   276→          console.log('The meta manifest defines agents, workflows, and conventions for the project.');
   277→          process.exit(1);
   278→        }
   279→
   280→        output(manifest.agents, () => formatAgentsTable(manifest.agents));
   281→      } catch (err) {
   282→        error('Failed to load meta manifest', err);
   283→        process.exit(1);
   284→      }
   285→    });
   286→
   287→  // kspec meta workflows
   288→  meta
   289→    .command('workflows')
   290→    .description('List workflows defined in meta manifest')
   291→    .option('--json', 'Output as JSON')
   292→    .option('--verbose', 'Show full workflow details with steps')
   293→    .action(async (options) => {
   294→      try {
   295→        const ctx = await initContext();
   296→
   297→        if (!ctx.manifestPath) {
   298→          error('No kspec manifest found');
   299→          console.log('Run `kspec init` to create a new project');
   300→          process.exit(1);
   301→        }
   302→
   303→        const manifest = await loadMetaManifest(ctx);
   304→
   305→        if (!manifest) {
   306→          error('No meta manifest found (kynetic.meta.yaml)');
   307→          console.log('The meta manifest defines agents, workflows, and conventions for the project.');
   308→          process.exit(1);
   309→        }
   310→
   311→        if (options.verbose && !options.json) {
   312→          formatWorkflowsVerbose(manifest.workflows);
   313→        } else {
   314→          output(manifest.workflows, () => formatWorkflowsTable(manifest.workflows));
   315→        }
   316→      } catch (err) {
   317→        error('Failed to load meta manifest', err);
   318→        process.exit(1);
   319→      }
   320→    });
   321→
   322→  // kspec meta observe <type> <content>
   323→  meta
   324→    .command('observe <type> <content>')
   325→    .description('Create an observation (friction, success, question, idea)')
   326→    .option('--workflow <ref>', 'Reference to workflow this observation relates to')
   327→    .option('--author <author>', 'Author of the observation (defaults to @claude)')
   328→    .option('--tag <tag...>', 'Tags for the observation')
   329→    .action(async (type: string, content: string, options) => {
   330→      try {
   331→        const ctx = await initContext();
   332→
   333→        if (!ctx.manifestPath) {
   334→          error('No kspec manifest found');
   335→          console.log('Run `kspec init` to create a new project');
   336→          process.exit(1);
   337→        }
   338→
   339→        const manifest = await loadMetaManifest(ctx);
   340→
   341→        if (!manifest) {
   342→          error('No meta manifest found (kynetic.meta.yaml)');
   343→          console.log('The meta manifest defines agents, workflows, and conventions for the project.');
   344→          process.exit(1);
   345→        }
   346→
   347→        // Validate observation type
   348→        const validTypes: ObservationType[] = ['friction', 'success', 'question', 'idea'];
   349→        if (!validTypes.includes(type as ObservationType)) {
   350→          error(`Invalid observation type: ${type}`);
   351→          console.log(`Valid types: ${validTypes.join(', ')}`);
   352→          process.exit(1);
   353→        }
   354→
   355→        // Create observation
   356→        const observation: Observation = {
   357→          _ulid: ulid(),
   358→          type: type as ObservationType,
   359→          content,
   360→          created_at: new Date().toISOString(),
   361→          author: options.author || '@claude',
   362→          tags: options.tag || [],
   363→          workflow_ref: options.workflow,
   364→          resolved: false,
   365→        };
   366→
   367→        // Add to manifest
   368→        manifest.observations.push(observation);
   369→
   370→        // Save
   371→        await saveMetaManifest(ctx, manifest);
   372→
   373→        success(`Created observation: ${observation._ulid.substring(0, 8)}`);
   374→      } catch (err) {
   375→        error('Failed to create observation', err);
   376→        process.exit(1);
   377→      }
   378→    });
   379→
   380→  // kspec meta observations
   381→  meta
   382→    .command('observations')
   383→    .description('List observations')
   384→    .option('--json', 'Output as JSON')
   385→    .option('--all', 'Include resolved observations (default: unresolved only)')
   386→    .action(async (options) => {
   387→      try {
   388→        const ctx = await initContext();
   389→
   390→        if (!ctx.manifestPath) {
   391→          error('No kspec manifest found');
   392→          console.log('Run `kspec init` to create a new project');
   393→          process.exit(1);
   394→        }
   395→
   396→        const manifest = await loadMetaManifest(ctx);
   397→
   398→        if (!manifest) {
   399→          error('No meta manifest found (kynetic.meta.yaml)');
   400→          console.log('The meta manifest defines agents, workflows, and conventions for the project.');
   401→          process.exit(1);
   402→        }
   403→
   404→        // Filter observations
   405→        let observations = manifest.observations;
   406→        if (!options.all) {
   407→          observations = observations.filter((obs) => !obs.resolved);
   408→        }
   409→
   410→        output(observations, () => formatObservationsTable(observations));
   411→      } catch (err) {
   412→        error('Failed to load observations', err);
   413→        process.exit(1);
   414→      }
   415→    });
   416→
   417→  // kspec meta promote <ref>
   418→  meta
   419→    .command('promote <ref>')
   420→    .description('Promote observation to a task')
   421→    .requiredOption('--title <title>', 'Task title')
   422→    .option('--priority <priority>', 'Task priority', '2')
   423→    .option('--force', 'Force promotion even if observation is resolved')
   424→    .action(async (ref: string, options) => {
   425→      try {
   426→        const ctx = await initContext();
   427→
   428→        if (!ctx.manifestPath) {
   429→          error('No kspec manifest found');
   430→          console.log('Run `kspec init` to create a new project');
   431→          process.exit(1);
   432→        }
   433→
   434→        const manifest = await loadMetaManifest(ctx);
   435→
   436→        if (!manifest) {
   437→          error('No meta manifest found (kynetic.meta.yaml)');
   438→          console.log('The meta manifest defines agents, workflows, and conventions for the project.');
   439→          process.exit(1);
   440→        }
   441→
   442→        // Find observation
   443→        const observation = manifest.observations.find((obs) => obs._ulid.startsWith(ref.replace('@', '')));
   444→
   445→        if (!observation) {
   446→          error(`Observation not found: ${ref}`);
   447→          process.exit(1);
   448→        }
   449→
   450→        // Check if already promoted
   451→        if (observation.promoted_to) {
   452→          error(`Observation already promoted to task ${observation.promoted_to}; resolve or delete the task first`);
   453→          process.exit(1);
   454→        }
   455→
   456→        // Check if resolved
   457→        if (observation.resolved && !options.force) {
   458→          error(`Cannot promote resolved observation; use --force to override`);
   459→          process.exit(1);
   460→        }
   461→
   462→        // Create task
   463→        const { spawn } = await import('child_process');
   464→        const { promisify } = await import('util');
   465→        const execFile = promisify(spawn);
   466→
   467→        // Build task add command
   468→        const taskArgs = [
   469→          'run',
   470→          'dev',
   471→          '--',
   472→          'task',
   473→          'add',
   474→          '--title',
   475→          options.title,
   476→          '--priority',
   477→          options.priority,
   478→        ];
   479→
   480→        if (observation.workflow_ref) {
   481→          taskArgs.push('--meta-ref', observation.workflow_ref);
   482→        }
   483→
   484→        // Add tags
   485→        for (const tag of observation.tags) {
   486→          taskArgs.push('--tag', tag);
   487→        }
   488→
   489→        // Execute task add command
   490→        const result = await new Promise<{ taskRef: string }>((resolve, reject) => {
   491→          const proc = spawn('npm', taskArgs, {
   492→            cwd: ctx.rootDir,
   493→            stdio: ['inherit', 'pipe', 'inherit'],
   494→          });
   495→
   496→          let output = '';
   497→          proc.stdout?.on('data', (data) => {
   498→            output += data.toString();
   499→          });
   500→
   501→          proc.on('close', (code) => {
   502→            if (code !== 0) {
   503→              reject(new Error(`Failed to create task (exit code ${code})`));
   504→            } else {
   505→              // Extract task ref from output (format: "OK Created task: 01KF...")
   506→              const match = output.match(/Created task: (@?[A-Z0-9]+)/);
   507→              if (match) {
   508→                resolve({ taskRef: match[1] });
   509→              } else {
   510→                reject(new Error('Could not parse task ref from output'));
   511→              }
   512→            }
   513→          });
   514→        });
   515→
   516→        // Update observation with promoted_to (ensure @ prefix)
   517→        observation.promoted_to = result.taskRef.startsWith('@') ? result.taskRef : `@${result.taskRef}`;
   518→
   519→        // Add observation content as task description
   520→        await saveMetaManifest(ctx, manifest);
   521→
   522→        success(`Created task: ${result.taskRef.substring(0, 8)}`);
   523→      } catch (err) {
   524→        error('Failed to promote observation', err);
   525→        process.exit(1);
   526→      }
   527→    });
   528→
   529→  // kspec meta conventions
   530→  meta
   531→    .command('conventions')
   532→    .description('List conventions defined in meta manifest')
   533→    .option('--json', 'Output as JSON')
   534→    .option('--domain <domain>', 'Filter by domain')
   535→    .action(async (options) => {
   536→      try {
   537→        const ctx = await initContext();
   538→
   539→        if (!ctx.manifestPath) {
   540→          error('No kspec manifest found');
   541→          console.log('Run `kspec init` to create a new project');
   542→          process.exit(1);
   543→        }
   544→
   545→        const manifest = await loadMetaManifest(ctx);
   546→
   547→        if (!manifest) {
   548→          error('No meta manifest found (kynetic.meta.yaml)');
   549→          console.log('The meta manifest defines agents, workflows, and conventions for the project.');
   550→          process.exit(1);
   551→        }
   552→
   553→        // Filter by domain if specified
   554→        let conventions = manifest.conventions;
   555→        if (options.domain) {
   556→          conventions = conventions.filter((c) => c.domain === options.domain);
   557→        }
   558→
   559→        if (options.domain && !options.json) {
   560→          // Show full details for single domain
   561→          if (conventions.length === 0) {
   562→            console.log(`No convention found for domain: ${options.domain}`);
   563→            process.exit(0);
   564→          }
   565→
   566→          const convention = conventions[0];
   567→          console.log(chalk.bold(convention.domain));
   568→          console.log(chalk.gray('─'.repeat(40)));
   569→
   570→          console.log(chalk.gray('\nRules:'));
   571→          for (const rule of convention.rules) {
   572→            console.log(`  • ${rule}`);
   573→          }
   574→
   575→          if (convention.examples && convention.examples.length > 0) {
   576→            console.log(chalk.gray('\nExamples:'));
   577→            for (const example of convention.examples) {
   578→              console.log(`  ${chalk.green('✓')} ${example.good}`);
   579→              console.log(`  ${chalk.red('✗')} ${example.bad}`);
   580→            }
   581→          }
   582→
   583→          if (convention.validation) {
   584→            console.log(chalk.gray('\nValidation:'));
   585→            console.log(`  Type: ${convention.validation.type}`);
   586→            if (convention.validation.type === 'regex' && 'pattern' in convention.validation) {
   587→              console.log(`  Pattern: ${convention.validation.pattern}`);
   588→            }
   589→          }
   590→        } else {
   591→          output(conventions, () => {
   592→            if (conventions.length === 0) {
   593→              console.log('No conventions defined');
   594→              return;
   595→            }
   596→
   597→            // Calculate column widths
   598→            const domainWidth = Math.max(6, ...conventions.map((c) => c.domain.length));
   599→
   600→            // Header
   601→            console.log(
   602→              chalk.bold('Domain'.padEnd(domainWidth)) +
   603→                '  ' +
   604→                chalk.bold('Rules'.padEnd(5)) +
   605→                '  ' +
   606→                chalk.bold('Validation')
   607→            );
   608→            console.log(chalk.gray('─'.repeat(domainWidth + 30)));
   609→
   610→            // Rows
   611→            for (const convention of conventions) {
   612→              const rules = convention.rules.length.toString();
   613→              const validation = convention.validation ? 'yes' : 'no';
   614→              console.log(convention.domain.padEnd(domainWidth) + '  ' + rules.padEnd(5) + '  ' + validation);
   615→            }
   616→          });
   617→        }
   618→      } catch (err) {
   619→        error('Failed to load conventions', err);
   620→        process.exit(1);
   621→      }
   622→    });
   623→
   624→  // kspec meta list
   625→  meta
   626→    .command('list')
   627→    .description('List all meta items')
   628→    .option('--json', 'Output as JSON')
   629→    .option('--type <type>', 'Filter by type (agent, workflow, convention, observation)')
   630→    .action(async (options) => {
   631→      try {
   632→        const ctx = await initContext();
   633→
   634→        if (!ctx.manifestPath) {
   635→          error('No kspec manifest found');
   636→          console.log('Run `kspec init` to create a new project');
   637→          process.exit(1);
   638→        }
   639→
   640→        const manifest = await loadMetaManifest(ctx);
   641→
   642→        if (!manifest) {
   643→          error('No meta manifest found (kynetic.meta.yaml)');
   644→          console.log('The meta manifest defines agents, workflows, and conventions for the project.');
   645→          process.exit(1);
   646→        }
   647→
   648→        // Build list of all items with type
   649→        interface MetaListItem {
   650→          type: 'agent' | 'workflow' | 'convention' | 'observation';
   651→          id: string;
   652→          title: string;
   653→          ulid: string;
   654→        }
   655→
   656→        const items: MetaListItem[] = [];
   657→
   658→        // Add agents
   659→        if (!options.type || options.type === 'agent') {
   660→          for (const agent of manifest.agents) {
   661→            items.push({
   662→              type: 'agent',
   663→              id: agent.id,
   664→              title: agent.name,
   665→              ulid: agent._ulid,
   666→            });
   667→          }
   668→        }
   669→
   670→        // Add workflows
   671→        if (!options.type || options.type === 'workflow') {
   672→          for (const workflow of manifest.workflows) {
   673→            items.push({
   674→              type: 'workflow',
   675→              id: workflow.id,
   676→              title: workflow.trigger,
   677→              ulid: workflow._ulid,
   678→            });
   679→          }
   680→        }
   681→
   682→        // Add conventions
   683→        if (!options.type || options.type === 'convention') {
   684→          for (const convention of manifest.conventions) {
   685→            items.push({
   686→              type: 'convention',
   687→              id: convention.domain,
   688→              title: `${convention.rules.length} rules`,
   689→              ulid: convention._ulid,
   690→            });
   691→          }
   692→        }
   693→
   694→        // Add observations
   695→        if (!options.type || options.type === 'observation') {
   696→          // Only show unresolved by default
   697→          const observations = manifest.observations.filter((o) => !o.resolved);
   698→          for (const observation of observations) {
   699→            items.push({
   700→              type: 'observation',
   701→              id: observation._ulid.substring(0, 8),
   702→              title: observation.content.substring(0, 50) + (observation.content.length > 50 ? '...' : ''),
   703→              ulid: observation._ulid,
   704→            });
   705→          }
   706→        }
   707→
   708→        output(items, () => {
   709→          if (items.length === 0) {
   710→            console.log('No meta items found');
   711→            return;
   712→          }
   713→
   714→          // Calculate column widths
   715→          const typeWidth = Math.max(4, ...items.map((i) => i.type.length));
   716→          const idWidth = Math.max(2, ...items.map((i) => i.id.length));
   717→
   718→          // Header
   719→          console.log(
   720→            chalk.bold('Type'.padEnd(typeWidth)) +
   721→              '  ' +
   722→              chalk.bold('ID'.padEnd(idWidth)) +
   723→              '  ' +
   724→              chalk.bold('Title')
   725→          );
   726→          console.log(chalk.gray('─'.repeat(typeWidth + idWidth + 50)));
   727→
   728→          // Rows
   729→          for (const item of items) {
   730→            console.log(item.type.padEnd(typeWidth) + '  ' + item.id.padEnd(idWidth) + '  ' + item.title);
   731→          }
   732→        });
   733→      } catch (err) {
   734→        error('Failed to list meta items', err);
   735→        process.exit(1);
   736→      }
   737→    });
   738→
   739→  // kspec meta get <ref>
   740→  meta
   741→    .command('get <ref>')
   742→    .description('Get a meta item by reference')
   743→    .option('--json', 'Output as JSON')
   744→    .action(async (ref: string, options) => {
   745→      try {
   746→        const ctx = await initContext();
   747→
   748→        if (!ctx.manifestPath) {
   749→          error('No kspec manifest found');
   750→          console.log('Run `kspec init` to create a new project');
   751→          process.exit(1);
   752→        }
   753→
   754→        const manifest = await loadMetaManifest(ctx);
   755→
   756→        if (!manifest) {
   757→          error('No meta manifest found (kynetic.meta.yaml)');
   758→          console.log('The meta manifest defines agents, workflows, and conventions for the project.');
   759→          process.exit(1);
   760→        }
   761→
   762→        const refWithoutAt = ref.replace('@', '');
   763→
   764→        // Try to find in agents
   765→        const agent = manifest.agents.find((a) => a.id === refWithoutAt || a._ulid.startsWith(refWithoutAt));
   766→        if (agent) {
   767→          output(agent, () => {
   768→            console.log(chalk.bold(agent.name));
   769→            console.log(chalk.gray('─'.repeat(40)));
   770→            console.log(`ID:           ${agent.id}`);
   771→            console.log(`ULID:         ${agent._ulid}`);
   772→            console.log(`Capabilities: ${agent.capabilities.join(', ')}`);
   773→
   774→            if (agent.description) {
   775→              console.log(chalk.gray('\nDescription:'));
   776→              console.log(agent.description.trim());
   777→            }
   778→
   779→            if (agent.tools && agent.tools.length > 0) {
   780→              console.log(chalk.gray('\nTools:'));
   781→              for (const tool of agent.tools) {
   782→                console.log(`  • ${tool}`);
   783→              }
   784→            }
   785→
   786→            if (agent.session_protocol) {
   787→              console.log(chalk.gray('\nSession Protocol:'));
   788→              if (agent.session_protocol.start) {
   789→                console.log(`  Start:      ${agent.session_protocol.start}`);
   790→              }
   791→              if (agent.session_protocol.checkpoint) {
   792→                console.log(`  Checkpoint: ${agent.session_protocol.checkpoint}`);
   793→              }
   794→              if (agent.session_protocol.end) {
   795→                console.log(`  End:        ${agent.session_protocol.end}`);
   796→              }
   797→            }
   798→
   799→            if (agent.conventions && agent.conventions.length > 0) {
   800→              console.log(chalk.gray('\nConventions:'));
   801→              for (const conv of agent.conventions) {
   802→                console.log(`  • ${conv}`);
   803→              }
   804→            }
   805→          });
   806→          return;
   807→        }
   808→
   809→        // Try workflows
   810→        const workflow = manifest.workflows.find((w) => w.id === refWithoutAt || w._ulid.startsWith(refWithoutAt));
   811→        if (workflow) {
   812→          output(workflow, () => {
   813→            console.log(chalk.bold(workflow.id));
   814→            console.log(chalk.gray('─'.repeat(40)));
   815→            console.log(`ULID:    ${workflow._ulid}`);
   816→            console.log(`Trigger: ${workflow.trigger}`);
   817→
   818→            if (workflow.description) {
   819→              console.log(chalk.gray('\nDescription:'));
   820→              console.log(workflow.description.trim());
   821→            }
   822→
   823→            console.log(chalk.gray('\nSteps:'));
   824→            for (let i = 0; i < workflow.steps.length; i++) {
   825→              const step = workflow.steps[i];
   826→              const prefix =
   827→                step.type === 'check' ? '[check]' : step.type === 'action' ? '[action]' : '[decision]';
   828→              console.log(`  ${i + 1}. ${prefix} ${step.content}`);
   829→
   830→              if (step.on_fail) {
   831→                console.log(chalk.gray(`     on_fail: ${step.on_fail}`));
   832→              }
   833→            }
   834→          });
   835→          return;
   836→        }
   837→
   838→        // Try conventions
   839→        const convention = manifest.conventions.find((c) => c.domain === refWithoutAt || c._ulid.startsWith(refWithoutAt));
   840→        if (convention) {
   841→          output(convention, () => {
   842→            console.log(chalk.bold(convention.domain));
   843→            console.log(chalk.gray('─'.repeat(40)));
   844→            console.log(`ULID: ${convention._ulid}`);
   845→
   846→            console.log(chalk.gray('\nRules:'));
   847→            for (const rule of convention.rules) {
   848→              console.log(`  • ${rule}`);
   849→            }
   850→
   851→            if (convention.examples && convention.examples.length > 0) {
   852→              console.log(chalk.gray('\nExamples:'));
   853→              for (const example of convention.examples) {
   854→                console.log(`  ${chalk.green('✓')} ${example.good}`);
   855→                console.log(`  ${chalk.red('✗')} ${example.bad}`);
   856→              }
   857→            }
   858→
   859→            if (convention.validation) {
   860→              console.log(chalk.gray('\nValidation:'));
   861→              console.log(`  Type: ${convention.validation.type}`);
   862→              if (convention.validation.type === 'regex' && 'pattern' in convention.validation) {
   863→                console.log(`  Pattern: ${convention.validation.pattern}`);
   864→              }
   865→            }
   866→          });
   867→          return;
   868→        }
   869→
   870→        // Try observations
   871→        const observation = manifest.observations.find((o) => o._ulid.startsWith(refWithoutAt));
   872→        if (observation) {
   873→          output(observation, () => {
   874→            console.log(chalk.bold(`Observation (${observation.type})`));
   875→            console.log(chalk.gray('─'.repeat(40)));
   876→            console.log(`ULID:         ${observation._ulid}`);
   877→            console.log(`Type:         ${observation.type}`);
   878→            console.log(`Created:      ${observation.created_at}`);
   879→            console.log(`Author:       ${observation.author}`);
   880→            console.log(`Resolved:     ${observation.resolved ? 'yes' : 'no'}`);
   881→
   882→            if (observation.workflow_ref) {
   883→              console.log(`Workflow Ref: ${observation.workflow_ref}`);
   884→            }
   885→
   886→            if (observation.tags.length > 0) {
   887→              console.log(`Tags:         ${observation.tags.join(', ')}`);
   888→            }
   889→
   890→            if (observation.promoted_to) {
   891→              console.log(`Promoted To:  ${observation.promoted_to}`);
   892→            }
   893→
   894→            console.log(chalk.gray('\nContent:'));
   895→            console.log(observation.content.trim());
   896→
   897→            if (observation.resolved && observation.resolution) {
   898→              console.log(chalk.gray('\nResolution:'));
   899→              console.log(observation.resolution.trim());
   900→              if (observation.resolved_at) {
   901→                console.log(chalk.gray(`Resolved at: ${observation.resolved_at}`));
   902→              }
   903→              if (observation.resolved_by) {
   904→                console.log(chalk.gray(`Resolved by: ${observation.resolved_by}`));
   905→              }
   906→            }
   907→          });
   908→          return;
   909→        }
   910→
   911→        // Not found
   912→        error(`Meta item not found: ${ref}`);
   913→        process.exit(1);
   914→      } catch (err) {
   915→        error('Failed to get meta item', err);
   916→        process.exit(1);
   917→      }
   918→    });
   919→
   920→  // kspec meta resolve <ref>
   921→  meta
   922→    .command('resolve <ref>')
   923→    .description('Resolve an observation')
   924→    .argument('[resolution]', 'Resolution text (optional if observation has promoted_to)')
   925→    .action(async (ref: string, resolution: string | undefined) => {
   926→      try {
   927→        const ctx = await initContext();
   928→
   929→        if (!ctx.manifestPath) {
   930→          error('No kspec manifest found');
   931→          console.log('Run `kspec init` to create a new project');
   932→          process.exit(1);
   933→        }
   934→
   935→        const manifest = await loadMetaManifest(ctx);
   936→
   937→        if (!manifest) {
   938→          error('No meta manifest found (kynetic.meta.yaml)');
   939→          console.log('The meta manifest defines agents, workflows, and conventions for the project.');
   940→          process.exit(1);
   941→        }
   942→
   943→        // Find observation
   944→        const observation = manifest.observations.find((obs) => obs._ulid.startsWith(ref.replace('@', '')));
   945→
   946→        if (!observation) {
   947→          error(`Observation not found: ${ref}`);
   948→          process.exit(1);
   949→        }
   950→
   951→        // Check if already resolved
   952→        if (observation.resolved) {
   953→          const truncated = observation.resolution?.substring(0, 50) || '';
   954→          const suffix = observation.resolution && observation.resolution.length > 50 ? '...' : '';
   955→          error(
   956→            `Observation already resolved on ${observation.resolved_at}: '${truncated}${suffix}'`
   957→          );
   958→          process.exit(1);
   959→        }
   960→
   961→        // Handle resolution text
   962→        let resolutionText = resolution;
   963→
   964→        // If no resolution provided and observation was promoted, try to get from task
   965→        if (!resolutionText && observation.promoted_to) {
   966→          // TODO: Load task and get completion reason
   967→          // For now, require explicit resolution
   968→          error('Resolution text required (auto-populate from task not yet implemented)');
   969→          process.exit(1);
   970→        }
   971→
   972→        if (!resolutionText) {
   973→          error('Resolution text required');
   974→          process.exit(1);
   975→        }
   976→
   977→        // Update observation
   978→        observation.resolved = true;
   979→        observation.resolved_at = new Date().toISOString();
   980→        observation.resolved_by = '@claude'; // TODO: Get from context
   981→        observation.resolution = resolutionText;
   982→
   983→        // Save
   984→        await saveMetaManifest(ctx, manifest);
   985→
   986→        success(`Resolved: ${observation._ulid.substring(0, 8)}`);
   987→      } catch (err) {
   988→        error('Failed to resolve observation', err);
   989→        process.exit(1);
   990→      }
   991→    });
   992→}
   993→

