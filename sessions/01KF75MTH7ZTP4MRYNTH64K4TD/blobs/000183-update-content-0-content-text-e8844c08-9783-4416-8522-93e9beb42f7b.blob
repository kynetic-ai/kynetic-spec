```
     1→import { Command } from 'commander';
     2→import chalk from 'chalk';
     3→import { initContext, loadMetaManifest, saveMetaManifest } from '../../parser/index.js';
     4→import { output, error, success } from '../output.js';
     5→import { ulid } from 'ulid';
     6→import { Observation, ObservationType } from '../../schema/meta.js';
     7→
     8→/**
     9→ * Format meta manifest summary for display
    10→ */
    11→function formatMetaShow(manifest: NonNullable<Awaited<ReturnType<typeof loadMetaManifest>>>): void {
    12→  console.log(chalk.bold('Meta Manifest Summary'));
    13→  console.log(chalk.gray('─'.repeat(40)));
    14→  console.log(`Agents:       ${manifest.agents.length}`);
    15→  console.log(`Workflows:    ${manifest.workflows.length}`);
    16→  console.log(`Conventions:  ${manifest.conventions.length}`);
    17→  console.log(`Observations: ${manifest.observations.length}`);
    18→
    19→  if (manifest.agents.length > 0) {
    20→    console.log(chalk.gray('\nAgents:'));
    21→    for (const agent of manifest.agents) {
    22→      console.log(`  • ${agent.name} (${agent.id})`);
    23→      if (agent.capabilities.length > 0) {
    24→        console.log(chalk.gray(`    ${agent.capabilities.join(', ')}`));
    25→      }
    26→    }
    27→  }
    28→
    29→  if (manifest.workflows.length > 0) {
    30→    console.log(chalk.gray('\nWorkflows:'));
    31→    for (const workflow of manifest.workflows) {
    32→      console.log(`  • ${workflow.id} (${workflow.trigger})`);
    33→      if (workflow.description) {
    34→        const desc = workflow.description.split('\n')[0];
    35→        console.log(chalk.gray(`    ${desc}`));
    36→      }
    37→    }
    38→  }
    39→
    40→  if (manifest.conventions.length > 0) {
    41→    console.log(chalk.gray('\nConventions:'));
    42→    for (const convention of manifest.conventions) {
    43→      console.log(`  • ${convention.domain}`);
    44→      if (convention.rules.length > 0) {
    45→        console.log(chalk.gray(`    ${convention.rules.length} rule(s)`));
    46→      }
    47→    }
    48→  }
    49→
    50→  if (manifest.observations.length > 0) {
    51→    console.log(chalk.gray('\nRecent Observations:'));
    52→    const recent = manifest.observations.slice(-5);
    53→    for (const obs of recent) {
    54→      console.log(`  • [${obs.type}] ${obs.content.split('\n')[0]}`);
    55→      if (obs.promoted_to) {
    56→        console.log(chalk.gray(`    → Promoted to ${obs.promoted_to}`));
    57→      }
    58→    }
    59→    if (manifest.observations.length > 5) {
    60→      console.log(chalk.gray(`  ... and ${manifest.observations.length - 5} more`));
    61→    }
    62→  }
    63→}
    64→
    65→/**
    66→ * Format agents table for display
    67→ */
    68→function formatAgentsTable(agents: NonNullable<Awaited<ReturnType<typeof loadMetaManifest>>>['agents']): void {
    69→  if (agents.length === 0) {
    70→    console.log('No agents defined');
    71→    return;
    72→  }
    73→
    74→  // Calculate column widths
    75→  const idWidth = Math.max(2, ...agents.map((a) => a.id.length));
    76→  const nameWidth = Math.max(4, ...agents.map((a) => a.name.length));
    77→
    78→  // Header
    79→  console.log(
    80→    chalk.bold('ID'.padEnd(idWidth)) +
    81→      '  ' +
    82→      chalk.bold('Name'.padEnd(nameWidth)) +
    83→      '  ' +
    84→      chalk.bold('Capabilities')
    85→  );
    86→  console.log(chalk.gray('─'.repeat(idWidth + nameWidth + 40)));
    87→
    88→  // Rows
    89→  for (const agent of agents) {
    90→    const capabilities = agent.capabilities.join(', ') || '-';
    91→    console.log(agent.id.padEnd(idWidth) + '  ' + agent.name.padEnd(nameWidth) + '  ' + capabilities);
    92→  }
    93→}
    94→
    95→/**
    96→ * Format workflows table for display
    97→ */
    98→function formatWorkflowsTable(
    99→  workflows: NonNullable<Awaited<ReturnType<typeof loadMetaManifest>>>['workflows']
   100→): void {
   101→  if (workflows.length === 0) {
   102→    console.log('No workflows defined');
   103→    return;
   104→  }
   105→
   106→  // Calculate column widths
   107→  const idWidth = Math.max(2, ...workflows.map((w) => w.id.length));
   108→  const triggerWidth = Math.max(7, ...workflows.map((w) => w.trigger.length));
   109→
   110→  // Header
   111→  console.log(
   112→    chalk.bold('ID'.padEnd(idWidth)) +
   113→      '  ' +
   114→      chalk.bold('Trigger'.padEnd(triggerWidth)) +
   115→      '  ' +
   116→      chalk.bold('Steps')
   117→  );
   118→  console.log(chalk.gray('─'.repeat(idWidth + triggerWidth + 20)));
   119→
   120→  // Rows
   121→  for (const workflow of workflows) {
   122→    const steps = workflow.steps.length.toString();
   123→    console.log(workflow.id.padEnd(idWidth) + '  ' + workflow.trigger.padEnd(triggerWidth) + '  ' + steps);
   124→  }
   125→}
   126→
   127→/**
   128→ * Format workflows verbose for display
   129→ */
   130→function formatWorkflowsVerbose(
   131→  workflows: NonNullable<Awaited<ReturnType<typeof loadMetaManifest>>>['workflows']
   132→): void {
   133→  if (workflows.length === 0) {
   134→    console.log('No workflows defined');
   135→    return;
   136→  }
   137→
   138→  for (let i = 0; i < workflows.length; i++) {
   139→    const workflow = workflows[i];
   140→
   141→    if (i > 0) {
   142→      console.log(''); // Blank line between workflows
   143→    }
   144→
   145→    console.log(chalk.bold(workflow.id));
   146→    console.log(chalk.gray(`Trigger: ${workflow.trigger}`));
   147→
   148→    if (workflow.description) {
   149→      const desc = workflow.description.trim();
   150→      console.log(chalk.gray(desc.split('\n')[0]));
   151→    }
   152→
   153→    console.log(chalk.gray('\nSteps:'));
   154→    for (let j = 0; j < workflow.steps.length; j++) {
   155→      const step = workflow.steps[j];
   156→      const prefix = step.type === 'check' ? '[check]' : step.type === 'action' ? '[action]' : '[decision]';
   157→
   158→      console.log(`  ${j + 1}. ${prefix} ${step.content}`);
   159→
   160→      if (step.on_fail) {
   161→        console.log(chalk.gray(`     on_fail: ${step.on_fail}`));
   162→      }
   163→    }
   164→  }
   165→}
   166→
   167→/**
   168→ * Format observations table for display
   169→ */
   170→function formatObservationsTable(
   171→  observations: NonNullable<Awaited<ReturnType<typeof loadMetaManifest>>>['observations']
   172→): void {
   173→  if (observations.length === 0) {
   174→    console.log('No observations found');
   175→    return;
   176→  }
   177→
   178→  // Calculate column widths
   179→  const idWidth = 8; // ULID prefix
   180→  const typeWidth = Math.max(4, ...observations.map((o) => o.type.length));
   181→  const workflowWidth = Math.max(8, ...observations.map((o) => o.workflow_ref?.length || 0));
   182→  const contentWidth = 50;
   183→
   184→  // Header
   185→  console.log(
   186→    chalk.bold('ID'.padEnd(idWidth)) +
   187→      '  ' +
   188→      chalk.bold('Type'.padEnd(typeWidth)) +
   189→      '  ' +
   190→      chalk.bold('Workflow'.padEnd(workflowWidth)) +
   191→      '  ' +
   192→      chalk.bold('Created'.padEnd(10)) +
   193→      '  ' +
   194→      chalk.bold('Content')
   195→  );
   196→  console.log(chalk.gray('─'.repeat(idWidth + typeWidth + workflowWidth + contentWidth + 20)));
   197→
   198→  // Rows
   199→  for (const obs of observations) {
   200→    const id = obs._ulid.substring(0, 8);
   201→    const workflow = obs.workflow_ref || '-';
   202→    const created = new Date(obs.created_at).toISOString().split('T')[0];
   203→    const content = obs.content.length > contentWidth ? obs.content.substring(0, contentWidth - 3) + '...' : obs.content;
   204→
   205→    console.log(
   206→      id.padEnd(idWidth) +
   207→        '  ' +
   208→        obs.type.padEnd(typeWidth) +
   209→        '  ' +
   210→        workflow.padEnd(workflowWidth) +
   211→        '  ' +
   212→        created.padEnd(10) +
   213→        '  ' +
   214→        content
   215→    );
   216→  }
   217→}
