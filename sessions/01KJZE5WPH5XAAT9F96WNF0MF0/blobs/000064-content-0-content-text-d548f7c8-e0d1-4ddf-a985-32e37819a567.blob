```
     1→<!--
     2→  AC: @ui-inbox-enhanced ac-1 — Each item shows triage status inline with quick triage action links.
     3→  AC: @ui-inbox-enhanced ac-2 — Filters by status, tags, age.
     4→-->
     5→<script lang="ts">
     6→	// AC: @multi-directory-daemon ac-27 - Reload on project change
     7→	// AC: @gh-pages-export ac-17 - Hide Add button in static mode
     8→	import { onMount, onDestroy } from 'svelte';
     9→	import { goto } from '$app/navigation';
    10→	import { base } from '$app/paths';
    11→	import { page } from '$app/stores';
    12→	import type { InboxItem, BroadcastEvent } from '@kynetic-ai/shared';
    13→	import type { TriageRecord } from '$lib/types/triage';
    14→	import {
    15→		fetchInbox,
    16→		addInboxItem,
    17→		deleteInboxItem,
    18→		fetchTriageRecords
    19→	} from '$lib/api';
    20→	import { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';
    21→	import { subscribe, unsubscribe, on, off } from '$lib/stores/connection.svelte';
    22→	import { Button } from '$lib/components/ui/button';
    23→	import { Input } from '$lib/components/ui/input';
    24→	import { Card, CardContent, CardHeader } from '$lib/components/ui/card';
    25→	import { Badge } from '$lib/components/ui/badge';
    26→	import {
    27→		Dialog,
    28→		DialogContent,
    29→		DialogDescription,
    30→		DialogFooter,
    31→		DialogHeader,
    32→		DialogTitle
    33→	} from '$lib/components/ui/dialog';
    34→	import { getProjectVersion } from '$lib/stores/project.svelte';
    35→	import Inbox from '@lucide/svelte/icons/inbox';
    36→
    37→	// ── Data state ──
    38→	let inboxItems = $state<InboxItem[]>([]);
    39→	let triageRecords = $state<TriageRecord[]>([]);
    40→	let loading = $state(true);
    41→	let error = $state('');
    42→
    43→	// ── Add item state ──
    44→	let showAddInput = $state(false);
    45→	let newItemText = $state('');
    46→	let addingItem = $state(false);
    47→
    48→	// ── Delete state ──
    49→	let deleteConfirmOpen = $state(false);
    50→	let itemToDelete = $state<InboxItem | null>(null);
    51→	let deletingItem = $state(false);
    52→
    53→	// ── Triage status labels and colors ──
    54→	const TRIAGE_STATUS_LABELS: Record<string, string> = {
    55→		untriaged: 'Untriaged',
    56→		triaged: 'Triaged',
    57→		acted_on: 'Acted On'
    58→	};
    59→
    60→	const TRIAGE_STATUS_COLORS: Record<string, string> = {
    61→		untriaged: 'bg-status-pending text-status-pending-fg',
    62→		triaged: 'bg-status-pending-review text-status-pending-review-fg',
    63→		acted_on: 'bg-status-completed text-status-completed-fg'
    64→	};
    65→
    66→	// ── Filter state ──
    67→	// AC: @ui-inbox-enhanced ac-2
    68→	type TriageFilterStatus = 'all' | 'untriaged' | 'triaged' | 'acted_on';
    69→	const TRIAGE_STATUS_VALUES: readonly TriageFilterStatus[] = ['all', 'untriaged', 'triaged', 'acted_on'];
    70→
    71→	let filterStatus = $state<TriageFilterStatus>('all');
    72→	let filterTag = $state<string>('');
    73→	let filterAge = $state<string>('');
    74→
    75→	function parseFilterStatus(raw: string | null): TriageFilterStatus {
    76→		if (raw && TRIAGE_STATUS_VALUES.includes(raw as TriageFilterStatus)) {
    77→			return raw as TriageFilterStatus;
    78→		}
    79→		return 'all';
    80→	}
    81→
    82→	// Sync filter state from URL params
    83→	$effect(() => {
    84→		const nextStatus = parseFilterStatus($page.url.searchParams.get('status'));
    85→		const nextTag = $page.url.searchParams.get('tag') || '';
    86→		const nextAge = $page.url.searchParams.get('age') || '';
    87→
    88→		if (filterStatus !== nextStatus) filterStatus = nextStatus;
    89→		if (filterTag !== nextTag) filterTag = nextTag;
    90→		if (filterAge !== nextAge) filterAge = nextAge;
    91→	});
    92→
    93→	// ── Merged inbox + triage view ──
    94→	interface InboxCardItem {
    95→		inbox: InboxItem;
    96→		record: TriageRecord | null;
    97→		triageStatus: string;
    98→	}
    99→
   100→	// AC: @ui-inbox-enhanced ac-1 — Merge inbox items with triage records
   101→	let allItems = $derived.by(() => {
   102→		return inboxItems.map((inbox) => {
   103→			const record = triageRecords.find((r) => r.inbox_ref === inbox._ulid) ?? null;
   104→			const triageStatus = record
   105→				? record.status === 'pending'
   106→					? 'untriaged'
   107→					: record.status
   108→				: 'untriaged';
   109→			return { inbox, record, triageStatus };
   110→		});
   111→	});
   112→
   113→	// AC: @ui-inbox-enhanced ac-2 — Filtered items
   114→	let filteredItems = $derived.by(() => {
   115→		let items = allItems;
   116→
   117→		// Status filter
   118→		if (filterStatus === 'untriaged') {
   119→			items = items.filter((i) => i.triageStatus === 'untriaged');
   120→		} else if (filterStatus === 'triaged') {
   121→			items = items.filter((i) => i.triageStatus === 'triaged');
   122→		} else if (filterStatus === 'acted_on') {
   123→			items = items.filter((i) => i.triageStatus === 'acted_on');
   124→		}
   125→
   126→		// Tag filter
   127→		if (filterTag) {
   128→			items = items.filter((i) => i.inbox.tags.includes(filterTag));
   129→		}
   130→
   131→		// Age filter
   132→		if (filterAge) {
   133→			const now = Date.now();
   134→			const cutoffs: Record<string, number> = {
   135→				'1d': 86400000,
   136→				'7d': 604800000,
   137→				'30d': 2592000000
   138→			};
   139→			const cutoff = cutoffs[filterAge];
   140→			if (cutoff) {
   141→				items = items.filter((i) => now - new Date(i.inbox.created_at).getTime() <= cutoff);
   142→			}
   143→		}
   144→
   145→		return items;
   146→	});
   147→
   148→	// All unique tags across inbox items
   149→	let allTags = $derived.by(() => {
   150→		const tagSet = new Set<string>();
   151→		inboxItems.forEach((item) => item.tags.forEach((t) => tagSet.add(t)));
   152→		return Array.from(tagSet).sort();
   153→	});
   154→
   155→	// Counts for status summary
   156→	let untriagedCount = $derived(allItems.filter((i) => i.triageStatus === 'untriaged').length);
   157→	let triagedCount = $derived(allItems.filter((i) => i.triageStatus === 'triaged').length);
   158→	let actedCount = $derived(allItems.filter((i) => i.triageStatus === 'acted_on').length);
   159→
   160→	// ── Lifecycle ──
   161→	onMount(async () => {
   162→		await loadData();
   163→
   164→		// Subscribe to real-time updates
   165→		if (!isStaticMode()) {
   166→			subscribe(['inbox:updates', 'triage:updates']);
   167→			on('inbox:updates', handleInboxUpdate);
   168→			on('triage:updates', handleTriageUpdate);
   169→		}
   170→	});
   171→
   172→	onDestroy(() => {
   173→		if (!isStaticMode()) {
   174→			off('inbox:updates', handleInboxUpdate);
   175→			off('triage:updates', handleTriageUpdate);
   176→			unsubscribe(['inbox:updates', 'triage:updates']);
   177→		}
   178→	});
   179→
   180→	// AC: @multi-directory-daemon ac-27 - Reload data when project changes
   181→	$effect(() => {
   182→		const version = getProjectVersion();
   183→		if (version > 0) {
   184→			loadData();
   185→		}
   186→	});
   187→
   188→	// ── Data loading ──
   189→	async function loadData() {
   190→		try {
   191→			loading = true;
   192→			error = '';
   193→			const inboxResponse = await fetchInbox({ limit: 1000 });
   194→			inboxItems = inboxResponse.items;
   195→
   196→			// Load triage records separately — if triage fails, inbox still shows
   197→			try {
   198→				const triageResponse = await fetchTriageRecords({ limit: 1000 });
   199→				triageRecords = triageResponse.items;
   200→			} catch {
   201→				triageRecords = [];
   202→			}
   203→		} catch (err) {
   204→			error = err instanceof Error ? err.message : 'Failed to load inbox';
   205→		} finally {
   206→			loading = false;
   207→		}
   208→	}
   209→
   210→	// ── WebSocket handlers ──
   211→	function handleInboxUpdate(_event: BroadcastEvent) {
   212→		loadData();
   213→	}
   214→
   215→	function handleTriageUpdate(_event: BroadcastEvent) {
   216→		loadTriageData();
   217→	}
   218→
   219→	async function loadTriageData() {
   220→		try {
   221→			const triageResponse = await fetchTriageRecords({ limit: 1000 });
   222→			triageRecords = triageResponse.items;
   223→		} catch (err) {
   224→			console.error('Failed to reload triage records:', err);
   225→		}
   226→	}
   227→
   228→	// ── Filter URL management ──
   229→	function updateFilterParam(key: 'status' | 'tag' | 'age', value: string) {
   230→		const params = new URLSearchParams($page.url.searchParams);
   231→
   232→		if (!value || value === 'all') {
   233→			params.delete(key);
   234→		} else {
   235→			params.set(key, value);
   236→		}
   237→
   238→		const query = params.toString();
   239→		const nextUrl = query ? `${base}/inbox?${query}` : `${base}/inbox`;
   240→		goto(nextUrl, { replaceState: false, keepFocus: true, noScroll: true });
   241→	}
   242→
   243→	// ── Add item ──
   244→	async function handleAddItem() {
   245→		if (!newItemText.trim()) return;
   246→
   247→		if (isStaticMode()) {
   248→			error = 'Cannot add items in read-only mode. Use the kspec CLI.';
   249→			return;
   250→		}
   251→
   252→		try {
   253→			addingItem = true;
   254→			error = '';
   255→			const newItem = await addInboxItem(newItemText.trim());
   256→			inboxItems = [newItem, ...inboxItems];
   257→			newItemText = '';
   258→			showAddInput = false;
   259→		} catch (err) {
   260→			if (err instanceof ReadOnlyModeError) {
   261→				error = err.message;
   262→			} else {
   263→				error = err instanceof Error ? err.message : 'Failed to add item';
   264→			}
   265→		} finally {
   266→			addingItem = false;
   267→		}
   268→	}
   269→
   270→	function handleKeydown(event: KeyboardEvent) {
   271→		if (event.key === 'Enter' && !event.shiftKey) {
   272→			event.preventDefault();
   273→			handleAddItem();
   274→		}
   275→	}
   276→
   277→	// ── Delete item ──
   278→	function confirmDelete(item: InboxItem) {
   279→		itemToDelete = item;
   280→		deleteConfirmOpen = true;
   281→	}
   282→
   283→	async function handleDelete() {
   284→		if (!itemToDelete) return;
   285→
   286→		if (isStaticMode()) {
   287→			error = 'Cannot delete items in read-only mode. Use the kspec CLI.';
   288→			deleteConfirmOpen = false;
   289→			itemToDelete = null;
   290→			return;
   291→		}
   292→
   293→		try {
   294→			deletingItem = true;
   295→			error = '';
   296→			await deleteInboxItem(itemToDelete._ulid);
   297→			inboxItems = inboxItems.filter((i) => i._ulid !== itemToDelete!._ulid);
   298→			deleteConfirmOpen = false;
   299→			itemToDelete = null;
   300→		} catch (err) {
   301→			if (err instanceof ReadOnlyModeError) {
   302→				error = err.message;
   303→			} else {
   304→				error = err instanceof Error ? err.message : 'Failed to delete item';
   305→			}
   306→		} finally {
   307→			deletingItem = false;
   308→		}
   309→	}
   310→
   311→	// ── Formatting ──
   312→	function formatDate(dateString: string): string {
   313→		const date = new Date(dateString);
   314→		const now = new Date();
   315→		const diffMs = now.getTime() - date.getTime();
   316→		const diffMins = Math.floor(diffMs / 60000);
   317→		const diffHours = Math.floor(diffMs / 3600000);
   318→		const diffDays = Math.floor(diffMs / 86400000);
   319→
   320→		if (diffMins < 1) return 'just now';
   321→		if (diffMins < 60) return `${diffMins}m ago`;
   322→		if (diffHours < 24) return `${diffHours}h ago`;
   323→		if (diffDays < 7) return `${diffDays}d ago`;
   324→
   325→		return date.toLocaleDateString();
   326→	}
   327→
   328→	function getTriageStatusLabel(item: InboxCardItem): string {
   329→		return TRIAGE_STATUS_LABELS[item.triageStatus] || 'Untriaged';
   330→	}
   331→
   332→	function getTriageStatusColor(item: InboxCardItem): string {
   333→		return TRIAGE_STATUS_COLORS[item.triageStatus] || TRIAGE_STATUS_COLORS.untriaged;
   334→	}
   335→</script>
   336→
   337→<div class="flex flex-col gap-4 p-6">
   338→	<!-- Header -->
   339→	<div class="flex items-center justify-between">
   340→		<div>
   341→			<h1 class="text-2xl font-bold">Inbox</h1>
   342→			{#if !loading}
   343→				<p class="text-sm text-muted-foreground" data-testid="inbox-summary">
   344→					{allItems.length} item{allItems.length === 1 ? '' : 's'}
   345→					&middot; {untriagedCount} untriaged, {triagedCount} triaged, {actedCount} acted on
   346→					{#if filteredItems.length !== allItems.length}
   347→						&middot; Showing {filteredItems.length} filtered
   348→					{/if}
   349→				</p>
   350→			{/if}
   351→		</div>
   352→		{#if !isStaticMode()}
   353→			<Button
   354→				data-testid="add-inbox-button"
   355→				onclick={() => (showAddInput = !showAddInput)}
   356→				variant={showAddInput ? 'secondary' : 'default'}
   357→			>
   358→				{showAddInput ? 'Cancel' : 'Add Item'}
   359→			</Button>
   360→		{/if}
   361→	</div>
   362→
   363→	<!-- AC: @ui-inbox-enhanced ac-2 — Filter controls -->
   364→	<div class="flex flex-wrap gap-2 items-center" data-testid="inbox-filters">
   365→		<select
   366→			bind:value={filterStatus}
   367→			onchange={(event) => updateFilterParam('status', (event.currentTarget as HTMLSelectElement).value)}
   368→			class="rounded-md border bg-background px-3 py-1.5 text-sm"
   369→			data-testid="inbox-status-filter"
   370→		>
   371→			<option value="all">All Status</option>
   372→			<option value="untriaged">Untriaged</option>
   373→			<option value="triaged">Triaged</option>
   374→			<option value="acted_on">Acted On</option>
   375→		</select>
   376→
   377→		{#if allTags.length > 0}
   378→			<select
   379→				bind:value={filterTag}
   380→				onchange={(event) => updateFilterParam('tag', (event.currentTarget as HTMLSelectElement).value)}
   381→				class="rounded-md border bg-background px-3 py-1.5 text-sm"
   382→				data-testid="inbox-tag-filter"
   383→			>
   384→				<option value="">All Tags</option>
   385→				{#each allTags as tag}
   386→					<option value={tag}>{tag}</option>
   387→				{/each}
   388→			</select>
   389→		{/if}
   390→
   391→		<select
   392→			bind:value={filterAge}
   393→			onchange={(event) => updateFilterParam('age', (event.currentTarget as HTMLSelectElement).value)}
   394→			class="rounded-md border bg-background px-3 py-1.5 text-sm"
   395→			data-testid="inbox-age-filter"
   396→		>
   397→			<option value="">Any Age</option>
   398→			<option value="1d">Last 24 hours</option>
   399→			<option value="7d">Last 7 days</option>
   400→			<option value="30d">Last 30 days</option>
   401→		</select>
   402→	</div>
   403→
   404→	{#if error}
   405→		<div class="bg-destructive/10 text-destructive p-4 rounded-lg text-sm" data-testid="error-message" role="alert">
   406→			{error}
   407→		</div>
   408→	{/if}
   409→
   410→	<!-- Add input field -->
   411→	{#if showAddInput}
   412→		<Card data-testid="inbox-add-form">
   413→			<CardContent class="pt-6">
   414→				<div class="flex gap-2">
   415→					<Input
   416→						data-testid="inbox-input"
   417→						bind:value={newItemText}
   418→						placeholder="Enter inbox item text (press Enter to submit)"
   419→						onkeydown={handleKeydown}
   420→						disabled={addingItem}
   421→						class="flex-1"
   422→					/>
   423→					<Button data-testid="inbox-submit" onclick={handleAddItem} disabled={addingItem || !newItemText.trim()}>
   424→						{addingItem ? 'Adding...' : 'Add'}
   425→					</Button>
   426→				</div>
   427→			</CardContent>
   428→		</Card>
   429→	{/if}
   430→
   431→	<!-- Inbox list -->
   432→	{#if loading}
   433→		<div class="space-y-2" data-testid="inbox-loading">
   434→			{#each Array(5) as _}
   435→				<div class="h-20 rounded-lg bg-muted ds-shimmer"></div>
   436→			{/each}
   437→		</div>
   438→	{:else if filteredItems.length === 0}
   439→		<div class="flex flex-col items-center justify-center py-16" data-testid="inbox-empty">
   440→			<Inbox class="size-12 text-muted-foreground/30 mb-4" />
   441→			{#if allItems.length === 0}
   442→				<h2 class="text-lg font-medium text-muted-foreground mb-1">No inbox items</h2>
   443→				<p class="text-sm text-muted-foreground">
   444→					{#if isStaticMode()}
   445→						No inbox items in the snapshot.
   446→					{:else}
   447→						Click "Add Item" to capture ideas and thoughts.
   448→					{/if}
   449→				</p>
   450→			{:else}
   451→				<h2 class="text-lg font-medium text-muted-foreground mb-1">No matching items</h2>
   452→				<p class="text-sm text-muted-foreground">Try adjusting the filters above.</p>
   453→			{/if}
   454→		</div>
   455→	{:else}
   456→		<div class="flex flex-col gap-3" data-testid="inbox-list">
   457→			{#each filteredItems as item (item.inbox._ulid)}
   458→				<!-- AC: @ui-inbox-enhanced ac-1 — Item with triage status inline -->
   459→				<Card class="transition-all duration-200 hover:shadow-md" data-testid="inbox-item">
   460→					<CardHeader class="pb-3">
   461→						<div class="flex items-start justify-between gap-4">
   462→							<div class="flex-1 min-w-0">
   463→								<div class="flex items-center gap-2 mb-1">
   464→									<!-- AC: @ui-inbox-enhanced ac-1 — Triage status badge -->
   465→									<Badge
   466→										class={getTriageStatusColor(item)}
   467→										data-testid="inbox-triage-status"
   468→									>
   469→										{getTriageStatusLabel(item)}
   470→									</Badge>
   471→									{#if item.record?.action}
   472→										<span class="text-xs text-muted-foreground" data-testid="inbox-triage-action">
   473→											{item.record.action}
   474→										</span>
   475→									{/if}
   476→								</div>
   477→								<p class="text-sm leading-relaxed" data-testid="inbox-text">{item.inbox.text}</p>
   478→							</div>
   479→							<div class="flex items-center gap-1 flex-shrink-0">
   480→								<!-- AC: @ui-inbox-enhanced ac-1 — Quick triage action link -->
   481→								{#if !isStaticMode() && item.triageStatus === 'untriaged'}
   482→									<Button
   483→										variant="ghost"
   484→										size="sm"
   485→										href="{base}/triage?status=untriaged"
   486→										data-testid="inbox-triage-link"
   487→										class="text-xs"
   488→									>
   489→										Triage
   490→									</Button>
   491→								{/if}
   492→								{#if !isStaticMode()}
   493→									<Button
   494→										data-testid="delete-inbox-button"
   495→										variant="ghost"
   496→										size="sm"
   497→										onclick={() => confirmDelete(item.inbox)}
   498→										class="text-destructive hover:text-destructive hover:bg-destructive/10"
   499→									>
   500→										Delete
   501→									</Button>
   502→								{/if}
   503→							</div>
   504→						</div>
   505→					</CardHeader>
   506→					<CardContent class="pt-0">
   507→						<div class="flex items-center gap-2 text-xs text-muted-foreground">
   508→							<span data-testid="inbox-created-at">{formatDate(item.inbox.created_at)}</span>
   509→							<span>&middot;</span>
   510→							<span data-testid="inbox-added-by">{item.inbox.added_by}</span>
   511→							{#if item.inbox.tags.length > 0}
   512→								<span>&middot;</span>
   513→								<div class="flex gap-1" data-testid="inbox-tags">
   514→									{#each item.inbox.tags as tag}
   515→										<Badge variant="secondary" class="text-xs">{tag}</Badge>
   516→									{/each}
   517→								</div>
   518→							{/if}
   519→						</div>
   520→					</CardContent>
   521→				</Card>
   522→			{/each}
   523→		</div>
   524→	{/if}
   525→</div>
   526→
   527→<!-- Delete confirmation dialog -->
   528→<Dialog bind:open={deleteConfirmOpen}>
   529→	<DialogContent data-testid="confirm-delete-dialog">
   530→		<DialogHeader>
   531→			<DialogTitle>Delete Inbox Item?</DialogTitle>
   532→			<DialogDescription>
   533→				Are you sure you want to delete this inbox item? This action cannot be undone.
   534→			</DialogDescription>
   535→		</DialogHeader>
   536→		{#if itemToDelete}
   537→			<div class="rounded-md bg-muted p-3 text-sm">
   538→				{itemToDelete.text}
   539→			</div>
   540→		{/if}
   541→		<DialogFooter>
   542→			<Button data-testid="confirm-delete-no" variant="outline" onclick={() => (deleteConfirmOpen = false)} disabled={deletingItem}>
   543→				Cancel
   544→			</Button>
   545→			<Button data-testid="confirm-delete-yes" variant="destructive" onclick={handleDelete} disabled={deletingItem}>
   546→				{deletingItem ? 'Deleting...' : 'Delete'}
   547→			</Button>
   548→		</DialogFooter>
   549→	</DialogContent>
   550→</Dialog>
   551→
