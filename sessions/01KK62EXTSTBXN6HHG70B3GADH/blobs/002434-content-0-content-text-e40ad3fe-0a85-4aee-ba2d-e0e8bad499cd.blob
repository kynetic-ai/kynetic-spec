```
     1→/**
     2→ * Static API Provider
     3→ *
     4→ * Provides API responses from a static JSON snapshot.
     5→ * Used when daemon is unavailable (GitHub Pages mode).
     6→ *
     7→ * AC Coverage:
     8→ * - ac-11 (@gh-pages-export): Render from JSON snapshot
     9→ * - ac-12, ac-13 (@gh-pages-export): Deep linking with ref resolution
    10→ */
    11→
    12→import type {
    13→	TaskSummary,
    14→	TaskDetail,
    15→	ItemSummary,
    16→	ItemDetail,
    17→	InboxItem,
    18→	PlanDetail,
    19→	PlanSummary,
    20→	SessionContext,
    21→	Observation,
    22→	TriageRecord,
    23→	ValidationResponse,
    24→	AlignmentResponse,
    25→	Workflow,
    26→	PaginatedResponse,
    27→	SearchResponse,
    28→	SearchResult
    29→} from '@kynetic-ai/shared';
    30→import type { KspecSnapshot, ExportedTask, ExportedItem } from '$lib/types/snapshot';
    31→import { getSnapshot, ReadOnlyModeError } from '$lib/stores/mode.svelte';
    32→
    33→/**
    34→ * Convert ExportedTask to TaskSummary
    35→ */
    36→function toTaskSummary(task: ExportedTask): TaskSummary {
    37→	return {
    38→		_ulid: task._ulid,
    39→		slugs: task.slugs,
    40→		title: task.title,
    41→		type: task.type,
    42→		status: task.status,
    43→		priority: task.priority,
    44→		spec_ref: task.spec_ref ?? undefined,
    45→		tags: task.tags,
    46→		depends_on: task.depends_on,
    47→		created_at: task.created_at,
    48→		started_at: task.started_at ?? undefined,
    49→		automation: task.automation,
    50→		notes_count: task.notes?.length ?? 0,
    51→		todos_count: task.todos?.length ?? 0
    52→	};
    53→}
    54→
    55→/**
    56→ * Convert ExportedItem to ItemSummary
    57→ */
    58→function toItemSummary(item: ExportedItem): ItemSummary {
    59→	return {
    60→		_ulid: item._ulid,
    61→		slugs: item.slugs,
    62→		title: item.title,
    63→		type: item.type,
    64→		status: item.status,
    65→		tags: item.tags,
    66→		created_at: item.created_at ?? new Date().toISOString(),
    67→		acceptance_criteria_count: item.acceptance_criteria?.length ?? 0
    68→	};
    69→}
    70→
    71→function normalizeRef(ref: string | null | undefined): string | null {
    72→	if (!ref) return null;
    73→	return ref.startsWith('@') ? ref.slice(1) : ref;
    74→}
    75→
    76→function findPlanByRef(snapshot: KspecSnapshot, ref: string): PlanDetail | null {
    77→	const normalizedRef = normalizeRef(ref);
    78→	if (!normalizedRef) return null;
    79→
    80→	return (
    81→		snapshot.plans?.find(
    82→			(plan) =>
    83→				plan.slugs.includes(normalizedRef) ||
    84→				plan._ulid.toUpperCase().startsWith(normalizedRef.toUpperCase())
    85→		) ?? null
    86→	);
    87→}
    88→
    89→function matchesPlanRef(planRef: string | undefined, ref: string): boolean {
    90→	const normalizedPlanRef = normalizeRef(planRef);
    91→	const normalizedRef = normalizeRef(ref);
    92→
    93→	if (!normalizedPlanRef || !normalizedRef) return false;
    94→	return (
    95→		normalizedPlanRef === normalizedRef ||
    96→		normalizedPlanRef.toUpperCase().startsWith(normalizedRef.toUpperCase())
    97→	);
    98→}
    99→
   100→/**
   101→ * Filter helper for tasks
   102→ */
   103→function filterTasks(
   104→	tasks: ExportedTask[],
   105→	params?: {
   106→		status?: string;
   107→		tag?: string;
   108→		assignee?: string;
   109→		automation?: string;
   110→		plan?: string;
   111→	}
   112→): ExportedTask[] {
   113→	let result = tasks;
   114→
   115→	if (params?.status) {
   116→		result = result.filter((t) => t.status === params.status);
   117→	}
   118→	if (params?.tag) {
   119→		result = result.filter((t) => t.tags.includes(params.tag!));
   120→	}
   121→	if (params?.assignee) {
   122→		result = result.filter((t) => t.assignee === params.assignee);
   123→	}
   124→	if (params?.automation) {
   125→		result = result.filter((t) => t.automation === params.automation);
   126→	}
   127→	if (params?.plan) {
   128→		result = result.filter((t) => matchesPlanRef(t.plan_ref, params.plan!));
   129→	}
   130→
   131→	return result;
   132→}
   133→
   134→/**
   135→ * Filter helper for items
   136→ */
   137→function filterItems(
   138→	items: ExportedItem[],
   139→	params?: {
   140→		type?: string | string[];
   141→		tag?: string;
   142→		plan?: string;
   143→	}
   144→): ExportedItem[] {
   145→	let result = items;
   146→
   147→	if (params?.type) {
   148→		const types = Array.isArray(params.type) ? params.type : [params.type];
   149→		result = result.filter((i) => types.includes(i.type));
   150→	}
   151→	if (params?.tag) {
   152→		result = result.filter((i) => i.tags.includes(params.tag!));
   153→	}
   154→	if (params?.plan) {
   155→		const snapshot = getSnapshot();
   156→		const plan = snapshot ? findPlanByRef(snapshot, params.plan) : null;
   157→		if (plan) {
   158→			const planSpecRefs = new Set(plan.derived_specs.map((ref) => normalizeRef(ref)));
   159→			result = result.filter(
   160→				(i) =>
   161→					planSpecRefs.has(i._ulid) ||
   162→					i.slugs.some((slug) => planSpecRefs.has(slug))
   163→			);
   164→		} else {
   165→			result = [];
   166→		}
   167→	}
   168→
   169→	return result;
   170→}
   171→
   172→/**
   173→ * Paginate array
   174→ */
   175→function paginate<T>(
   176→	items: T[],
   177→	params?: { limit?: number; offset?: number }
   178→): PaginatedResponse<T> {
   179→	const limit = params?.limit ?? 50;
   180→	const offset = params?.offset ?? 0;
   181→	const paged = items.slice(offset, offset + limit);
   182→
   183→	return {
   184→		items: paged,
   185→		total: items.length,
   186→		offset,
   187→		limit
   188→	};
   189→}
   190→
   191→/**
   192→ * Find task by reference (slug or ULID prefix)
   193→ * AC: @gh-pages-export ac-12
   194→ */
   195→function findTaskByRef(tasks: ExportedTask[], ref: string): ExportedTask | null {
   196→	const normalizedRef = ref.startsWith('@') ? ref.slice(1) : ref;
   197→
   198→	// Try exact slug match first
   199→	const bySlug = tasks.find((t) => t.slugs.includes(normalizedRef));
   200→	if (bySlug) return bySlug;
   201→
   202→	// Try ULID prefix match
   203→	const byUlid = tasks.find((t) => t._ulid.startsWith(normalizedRef.toUpperCase()));
   204→	if (byUlid) return byUlid;
   205→
   206→	return null;
   207→}
   208→
   209→/**
   210→ * Find item by reference (slug or ULID prefix)
   211→ * AC: @gh-pages-export ac-13
   212→ */
   213→function findItemByRef(items: ExportedItem[], ref: string): ExportedItem | null {
   214→	const normalizedRef = ref.startsWith('@') ? ref.slice(1) : ref;
   215→
   216→	// Try exact slug match first
   217→	const bySlug = items.find((i) => i.slugs.includes(normalizedRef));
   218→	if (bySlug) return bySlug;
   219→
   220→	// Try ULID prefix match
   221→	const byUlid = items.find((i) => i._ulid.startsWith(normalizedRef.toUpperCase()));
   222→	if (byUlid) return byUlid;
   223→
   224→	return null;
   225→}
   226→
   227→// ============================================================
   228→// Static API Functions
   229→// ============================================================
   230→
   231→/**
   232→ * Fetch tasks from static snapshot
   233→ * AC: @gh-pages-export ac-11
   234→ */
   235→export function fetchTasksStatic(params?: {
   236→	status?: string;
   237→	tag?: string;
   238→	assignee?: string;
   239→	automation?: string;
   240→	plan?: string;
   241→	limit?: number;
   242→	offset?: number;
   243→}): PaginatedResponse<TaskSummary> {
   244→	const snapshot = getSnapshot();
   245→	if (!snapshot) {
   246→		return { items: [], total: 0, offset: 0, limit: 50 };
   247→	}
   248→
   249→	const filtered = filterTasks(snapshot.tasks, params);
   250→	const paginated = paginate(filtered, params);
   251→
   252→	return {
   253→		...paginated,
   254→		items: paginated.items.map(toTaskSummary)
   255→	};
   256→}
   257→
   258→/**
   259→ * Fetch single task from static snapshot
   260→ * AC: @gh-pages-export ac-12
   261→ */
   262→export function fetchTaskStatic(ref: string): TaskDetail | null {
   263→	const snapshot = getSnapshot();
   264→	if (!snapshot) return null;
   265→
   266→	const task = findTaskByRef(snapshot.tasks, ref);
   267→	if (!task) return null;
   268→
   269→	// ExportedTask extends TaskDetail, so we can return it directly
   270→	return task;
   271→}
   272→
   273→/**
   274→ * Fetch items from static snapshot
   275→ * AC: @gh-pages-export ac-11
   276→ */
   277→export function fetchItemsStatic(params?: {
   278→	type?: string | string[];
   279→	tag?: string;
   280→	plan?: string;
   281→	limit?: number;
   282→	offset?: number;
   283→}): PaginatedResponse<ItemSummary> {
   284→	const snapshot = getSnapshot();
   285→	if (!snapshot) {
   286→		return { items: [], total: 0, offset: 0, limit: 50 };
   287→	}
   288→
   289→	const filtered = filterItems(snapshot.items, params);
   290→	const paginated = paginate(filtered, params);
   291→
   292→	return {
   293→		...paginated,
   294→		items: paginated.items.map(toItemSummary)
   295→	};
   296→}
   297→
   298→/**
   299→ * Fetch single item from static snapshot
   300→ * AC: @gh-pages-export ac-13
   301→ */
   302→export function fetchItemStatic(ref: string): ItemDetail | null {
   303→	const snapshot = getSnapshot();
   304→	if (!snapshot) return null;
   305→
   306→	const item = findItemByRef(snapshot.items, ref);
   307→	if (!item) return null;
   308→
   309→	return item;
   310→}
   311→
   312→/**
   313→ * Fetch tasks linked to an item from static snapshot
   314→ */
   315→export function fetchItemTasksStatic(ref: string): PaginatedResponse<TaskSummary> {
   316→	const snapshot = getSnapshot();
   317→	if (!snapshot) {
   318→		return { items: [], total: 0, offset: 0, limit: 50 };
   319→	}
   320→
   321→	const item = findItemByRef(snapshot.items, ref);
   322→	if (!item) {
   323→		return { items: [], total: 0, offset: 0, limit: 50 };
   324→	}
   325→
   326→	// Find tasks that reference this item
   327→	const linkedTasks = snapshot.tasks.filter((t) => {
   328→		if (!t.spec_ref) return false;
   329→		const specRef = t.spec_ref.startsWith('@') ? t.spec_ref.slice(1) : t.spec_ref;
   330→		return item.slugs.includes(specRef) || item._ulid.startsWith(specRef.toUpperCase());
   331→	});
   332→
   333→	return {
   334→		items: linkedTasks.map(toTaskSummary),
   335→		total: linkedTasks.length,
   336→		offset: 0,
   337→		limit: linkedTasks.length
   338→	};
   339→}
   340→
   341→/**
   342→ * Fetch inbox from static snapshot
   343→ * AC: @gh-pages-export ac-11
   344→ */
   345→export function fetchInboxStatic(params?: {
   346→	limit?: number;
   347→	offset?: number;
   348→}): PaginatedResponse<InboxItem> {
   349→	const snapshot = getSnapshot();
   350→	if (!snapshot) {
   351→		return { items: [], total: 0, offset: 0, limit: 50 };
   352→	}
   353→
   354→	return paginate(snapshot.inbox, params);
   355→}
   356→
   357→/**
   358→ * Fetch session context from static snapshot
   359→ */
   360→export function fetchSessionContextStatic(): SessionContext | null {
   361→	const snapshot = getSnapshot();
   362→	return snapshot?.session ?? null;
   363→}
   364→
   365→/**
   366→ * Fetch observations from static snapshot
   367→ */
   368→export function fetchObservationsStatic(params?: {
   369→	type?: 'friction' | 'success' | 'question' | 'idea';
   370→	resolved?: boolean;
   371→}): PaginatedResponse<Observation> {
   372→	const snapshot = getSnapshot();
   373→	if (!snapshot) {
   374→		return { items: [], total: 0, offset: 0, limit: 50 };
   375→	}
   376→
   377→	let filtered = snapshot.observations;
   378→
   379→	if (params?.type) {
   380→		filtered = filtered.filter((o) => o.type === params.type);
   381→	}
   382→	if (params?.resolved !== undefined) {
   383→		filtered = filtered.filter((o) => o.resolved === params.resolved);
   384→	}
   385→
   386→	return {
   387→		items: filtered,
   388→		total: filtered.length,
   389→		offset: 0,
   390→		limit: filtered.length
   391→	};
   392→}
   393→
   394→/**
   395→ * Search across static snapshot
   396→ * AC: @gh-pages-export ac-11
   397→ */
   398→export function searchStatic(query: string): SearchResponse {
   399→	const snapshot = getSnapshot();
   400→	if (!snapshot) {
   401→		return { results: [], total: 0, showing: 0 };
   402→	}
   403→
   404→	const lowerQuery = query.toLowerCase();
   405→	const results: SearchResult[] = [];
   406→
   407→	// Search tasks
   408→	for (const task of snapshot.tasks) {
   409→		if (
   410→			task.title.toLowerCase().includes(lowerQuery) ||
   411→			task.slugs.some((s) => s.includes(lowerQuery))
   412→		) {
   413→			results.push({
   414→				type: 'task',
   415→				ulid: task._ulid,
   416→				title: task.title,
   417→				matchedFields: ['title']
   418→			});
   419→		}
   420→	}
   421→
   422→	// Search items
   423→	for (const item of snapshot.items) {
   424→		if (
   425→			item.title.toLowerCase().includes(lowerQuery) ||
   426→			item.slugs.some((s) => s.includes(lowerQuery))
   427→		) {
   428→			results.push({
   429→				type: 'item',
   430→				ulid: item._ulid,
   431→				title: item.title,
   432→				matchedFields: ['title']
   433→			});
   434→		}
   435→	}
   436→
   437→	// Search inbox
   438→	for (const inbox of snapshot.inbox) {
   439→		if (inbox.text.toLowerCase().includes(lowerQuery)) {
   440→			results.push({
   441→				type: 'inbox',
   442→				ulid: inbox._ulid,
   443→				title: inbox.text.slice(0, 50),
   444→				matchedFields: ['text']
   445→			});
   446→		}
   447→	}
   448→
   449→	return {
   450→		results: results.slice(0, 20),
   451→		total: results.length,
   452→		showing: Math.min(results.length, 20)
   453→	};
   454→}
   455→
   456→/**
   457→ * Fetch triage records from static snapshot
   458→ * AC: @interactive-triage-ui ac-8
   459→ */
   460→export function fetchTriageRecordsStatic(params?: {
   461→	status?: string;
   462→	action?: string;
   463→	limit?: number;
   464→	offset?: number;
   465→}): PaginatedResponse<TriageRecord> {
   466→	const snapshot = getSnapshot();
   467→	if (!snapshot) {
   468→		return { items: [], total: 0, offset: params?.offset ?? 0, limit: params?.limit ?? 50 };
   469→	}
   470→
   471→	let items = snapshot.triage ?? [];
   472→
   473→	if (params?.status) {
   474→		items = items.filter((item) => item.status === params.status);
   475→	}
   476→	if (params?.action) {
   477→		items = items.filter((item) => item.action === params.action);
   478→	}
   479→
   480→	return paginate(items, params);
   481→}
