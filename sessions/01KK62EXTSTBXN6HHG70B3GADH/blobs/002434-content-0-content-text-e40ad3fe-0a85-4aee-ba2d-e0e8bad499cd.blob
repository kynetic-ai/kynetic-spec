   502→
   503→// ============================================================
   504→// Plans Static Functions
   505→// ============================================================
   506→
   507→/**
   508→ * Fetch plans from static snapshot
   509→ * Plans are not included in static snapshots, so return empty.
   510→ */
   511→export function fetchPlansStatic(_params?: {
   512→	status?: string;
   513→}): { items: PlanSummary[]; total: number } {
   514→	const snapshot = getSnapshot();
   515→	if (!snapshot) {
   516→		return { items: [], total: 0 };
   517→	}
   518→
   519→	let items = snapshot.plans ?? [];
   520→	if (_params?.status) {
   521→		items = items.filter((plan) => plan.status === _params.status);
   522→	}
   523→
   524→	return {
   525→		items: items.map(({ content: _content, ...plan }) => plan),
   526→		total: items.length
   527→	};
   528→}
   529→
   530→export function fetchPlanContentStatic(ref: string): PlanDetail {
   531→	const snapshot = getSnapshot();
   532→	if (!snapshot) {
   533→		throw new Error('Plan content not available in static mode');
   534→	}
   535→
   536→	const plan = findPlanByRef(snapshot, ref);
   537→	if (!plan) {
   538→		throw new Error(`Plan not found: ${ref}`);
   539→	}
   540→
   541→	return plan;
   542→}
   543→
   544→export function fetchValidationStatic(): ValidationResponse {
   545→	const snapshot = getSnapshot();
   546→	if (!snapshot?.validation) {
   547→		return {
   548→			valid: true,
   549→			schemaErrors: [],
   550→			refErrors: [],
   551→			refWarnings: [],
   552→			orphans: [],
   553→			completenessWarnings: [],
   554→			traitCycles: []
   555→		};
   556→	}
   557→
   558→	return {
   559→		valid: snapshot.validation.valid,
   560→		schemaErrors: snapshot.validation.schemaErrors ?? [],
   561→		refErrors: snapshot.validation.refErrors ?? [],
   562→		refWarnings: snapshot.validation.refWarnings ?? [],
   563→		orphans: snapshot.validation.orphans ?? [],
   564→		completenessWarnings: snapshot.validation.completenessWarnings ?? [],
   565→		traitCycles: snapshot.validation.traitCycles ?? []
   566→	};
   567→}
   568→
   569→export function fetchAlignmentStatic(): AlignmentResponse {
   570→	return (
   571→		getSnapshot()?.alignment ?? {
   572→			stats: { totalSpecs: 0, specsWithTasks: 0, alignedSpecs: 0, orphanedSpecs: 0 },
   573→			warnings: []
   574→		}
   575→	);
   576→}
