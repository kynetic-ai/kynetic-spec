   483→// ============================================================
   484→// Workflows Static Functions
   485→// ============================================================
   486→
   487→/**
   488→ * Fetch workflows from static snapshot
   489→ * AC: @ui-workflows-view ac-1
   490→ */
   491→export function fetchWorkflowsStatic(): { items: Workflow[]; total: number } {
   492→	const snapshot = getSnapshot();
   493→	if (!snapshot) {
   494→		return { items: [], total: 0 };
   495→	}
   496→
   497→	return {
   498→		items: snapshot.workflows ?? [],
   499→		total: (snapshot.workflows ?? []).length
   500→	};
