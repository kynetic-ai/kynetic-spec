   443→export async function fetchSessionContext(): Promise<SessionContext> {
   444→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   445→	if (isStaticMode()) {
   446→		const session = fetchSessionContextStatic();
   447→		if (!session) {
   448→			return { focus: null, threads: [], open_questions: [], updated_at: new Date().toISOString() };
