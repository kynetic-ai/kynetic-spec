   880→	trigger?: string;
   881→	spec_context?: SessionSpecContext | null;
   882→	budget?: SessionBudget | null;
   883→}
   884→
   885→/**
   886→ * A single event from events.jsonl.
   887→ */
   888→export interface SessionEvent {
   889→	ts: number;
   890→	seq: number;
   891→	type: string;
   892→	session_id: string;
   893→	trace_id?: string;
   894→	data: unknown;
   895→}
   896→
   897→/**
   898→ * Fetch all sessions with summaries.
   899→ * AC: @ui-session-stream ac-1
   900→ */
   901→export async function fetchSessions(): Promise<{ items: SessionSummary[]; total: number }> {
   902→	if (isStaticMode()) {
   903→		return { items: [], total: 0 };
   904→	}
   905→
