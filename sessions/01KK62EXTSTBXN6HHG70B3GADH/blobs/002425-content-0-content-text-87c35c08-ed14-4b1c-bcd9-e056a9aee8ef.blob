   860→	title: string;
   861→	acceptance_criteria: Array<{ id: string; description: string }>;
   862→}
   863→
   864→/**
   865→ * Session budget info.
   866→ * AC: @ui-session-stream ac-4
   867→ */
   868→export interface SessionBudget {
   869→	max_per_cycle: number;
   870→	started_this_cycle: number;
   871→}
   872→
   873→/**
   874→ * Session detail with additional metadata.
