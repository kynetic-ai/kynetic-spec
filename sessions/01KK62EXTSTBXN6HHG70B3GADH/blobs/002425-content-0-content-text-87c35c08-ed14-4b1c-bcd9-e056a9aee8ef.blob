   962→// ============================================================
   963→// Validation & Alignment API Functions
   964→// AC: @ui-validation-view ac-1
   965→// ============================================================
   966→
   967→export interface SchemaValidationError {
   968→	file: string;
   969→	path?: string;
   970→	message: string;
   971→	details?: unknown;
   972→}
   973→
   974→export interface RefValidationError {
   975→	ref: string;
   976→	sourceFile?: string;
   977→	sourceUlid?: string;
   978→	field: string;
   979→	error: 'not_found' | 'ambiguous' | 'duplicate_slug';
   980→	message: string;
   981→}
   982→
   983→export interface RefValidationWarning {
   984→	ref: string;
   985→	sourceFile?: string;
   986→	sourceUlid?: string;
   987→	field: string;
   988→	warning: 'deprecated_target';
   989→	message: string;
   990→}
   991→
   992→export interface OrphanItem {
   993→	ulid: string;
   994→	title: string;
   995→	type: string;
   996→	file?: string;
   997→}
   998→
   999→export type CompletenessWarningType =
  1000→	| 'missing_acceptance_criteria'
  1001→	| 'missing_description'
  1002→	| 'status_inconsistency'
  1003→	| 'missing_test_coverage'
  1004→	| 'automation_eligible_no_spec'
  1005→	| 'ac_schema_field_mismatch';
  1006→
  1007→export interface CompletenessWarning {
  1008→	type: CompletenessWarningType;
  1009→	subtype?: 'own_ac' | 'trait_ac';
  1010→	itemRef: string;
  1011→	itemTitle: string;
  1012→	message: string;
  1013→	details?: string;
  1014→}
  1015→
  1016→export interface TraitCycleError {
  1017→	traitRef: string;
  1018→	traitTitle: string;
  1019→	cycle: string[];
  1020→	message: string;
  1021→}
  1022→
  1023→export interface ValidationResponse {
  1024→	valid: boolean;
  1025→	schemaErrors: SchemaValidationError[];
  1026→	refErrors: RefValidationError[];
  1027→	refWarnings: RefValidationWarning[];
  1028→	orphans: OrphanItem[];
  1029→	completenessWarnings: CompletenessWarning[];
  1030→	traitCycles: TraitCycleError[];
  1031→}
  1032→
  1033→/** Alias for backward compatibility with dashboard overview */
  1034→export type ValidationResult = ValidationResponse;
  1035→
  1036→export interface AlignmentWarning {
  1037→	type: 'orphaned_spec' | 'status_mismatch' | 'stale_implementation';
  1038→	specUlid?: string;
  1039→	specTitle?: string;
  1040→	taskUlid?: string;
  1041→	message: string;
  1042→}
  1043→
  1044→export interface AlignmentStats {
  1045→	totalSpecs: number;
  1046→	specsWithTasks: number;
  1047→	alignedSpecs: number;
  1048→	orphanedSpecs: number;
  1049→}
  1050→
  1051→export interface AlignmentResponse {
  1052→	stats: AlignmentStats;
  1053→	warnings: AlignmentWarning[];
  1054→}
  1055→
  1056→/**
  1057→ * Fetch validation results
  1058→ * AC: @ui-validation-view ac-1
  1059→ */
  1060→export async function fetchValidation(): Promise<ValidationResponse> {
  1061→	if (isStaticMode()) {
  1062→		return fetchValidationStatic();
  1063→	}
  1064→
  1065→	const response = await fetch(`${API_BASE}/api/validate`, {
  1066→		headers: getProjectHeaders()
  1067→	});
  1068→	if (!response.ok) {
  1069→		await handleResponseError(response);
  1070→	}
  1071→
  1072→	const data = await response.json();
  1073→	// Normalize: ensure all array fields exist even if the API omits them
  1074→	return {
  1075→		valid: data.valid ?? true,
  1076→		schemaErrors: data.schemaErrors ?? [],
  1077→		refErrors: data.refErrors ?? [],
  1078→		refWarnings: data.refWarnings ?? [],
  1079→		orphans: data.orphans ?? [],
  1080→		completenessWarnings: data.completenessWarnings ?? [],
  1081→		traitCycles: data.traitCycles ?? []
  1082→	};
  1083→}
  1084→
  1085→/**
  1086→ * Fetch alignment stats and warnings
  1087→ * AC: @ui-validation-view ac-1
  1088→ */
  1089→export async function fetchAlignment(): Promise<AlignmentResponse> {
  1090→	if (isStaticMode()) {
  1091→		return fetchAlignmentStatic();
  1092→	}
  1093→
  1094→	const response = await fetch(`${API_BASE}/api/alignment`, {
  1095→		headers: getProjectHeaders()
  1096→	});
  1097→	if (!response.ok) {
  1098→		await handleResponseError(response);
  1099→	}
  1100→
  1101→	return response.json();
  1102→}
