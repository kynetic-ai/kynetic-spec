   950→	}
   951→
   952→	const response = await fetch(url.toString(), {
   953→		headers: getProjectHeaders()
   954→	});
   955→	if (!response.ok) {
   956→		await handleResponseError(response);
   957→	}
   958→
   959→	return response.json();
   960→}
