   840→	agent_type: string;
   841→	session_type: 'loop' | 'invocation';
   842→	/** Dispatch trigger for distinguishing dispatched agent vs manual CLI run. */
   843→	trigger?: string;
   844→	/** Task ID being worked on (if any). AC: @ui-session-history ac-1 */
   845→	task_id?: string;
   846→	started_at: string;
   847→	ended_at?: string;
   848→	duration_ms: number;
   849→	event_count: number;
   850→	iteration_count: number;
   851→	tasks_completed: number;
