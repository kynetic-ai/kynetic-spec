   620→// ============================================================
   621→// Agent & Dispatch API Functions
   622→// AC: @ui-agent-dispatch ac-1, ac-2, ac-3
   623→// ============================================================
   624→
   625→// AgentDefinition and AgentUpdatePayload are imported from @kynetic-ai/shared
   626→// (schema-driven types mirroring AgentSchema from src/schema/meta.ts)
   627→// Re-exported so existing imports from '$lib/api' continue to work.
   628→// AC: @ui-agent-dispatch ac-4
   629→export type { AgentDefinition, AgentUpdatePayload };
   630→
   631→/**
   632→ * Active invocation from GET /api/agent/status
   633→ */
   634→export interface ActiveInvocation {
   635→	session_id: string;
   636→	agent_id: string;
   637→	task_ref: string | null;
   638→	elapsed_ms: number;
   639→}
   640→
   641→/**
   642→ * Agent dispatch status from GET /api/agent/status
   643→ */
   644→export interface AgentDispatchStatus {
   645→	dispatch_enabled: boolean;
   646→	active_invocations: ActiveInvocation[];
   647→	queue_depth: number;
   648→	agent_definitions: Array<{
   649→		id: string;
   650→		name: string;
   651→		adapter: string;
   652→		completed_sessions?: number;
   653→	}>;
   654→}
   655→
   656→/**
   657→ * Fetch agent dispatch status (dispatch state + active invocations)
