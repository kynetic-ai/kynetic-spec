   267→/**
   268→ * Fetch spec items with optional filters
   269→ * AC: @web-dashboard ac-11
   270→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   271→ * AC: @gh-pages-export ac-11 - Static mode support
   272→ */
   273→export async function fetchItems(params?: {
   274→	type?: string | string[];
   275→	tag?: string;
   276→	plan?: string;
   277→	limit?: number;
   278→	offset?: number;
   279→}): Promise<PaginatedResponse<ItemSummary>> {
   280→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   281→	if (isStaticMode()) {
   282→		return fetchItemsStatic(params);
   283→	}
   284→
   285→	const url = new URL(`${API_BASE}/api/items`);
   286→
   287→	if (params) {
   288→		Object.entries(params).forEach(([key, value]) => {
   289→			if (value !== undefined && value !== '') {
   290→				if (Array.isArray(value)) {
   291→					value.forEach((v) => url.searchParams.append(key, String(v)));
   292→				} else {
   293→					url.searchParams.set(key, String(value));
   294→				}
   295→			}
   296→		});
   297→	}
   298→
   299→	const response = await fetch(url.toString(), {
   300→		headers: getProjectHeaders()
   301→	});
   302→	if (!response.ok) {
   303→		await handleResponseError(response);
   304→	}
   305→
   306→	return response.json();
   307→}
