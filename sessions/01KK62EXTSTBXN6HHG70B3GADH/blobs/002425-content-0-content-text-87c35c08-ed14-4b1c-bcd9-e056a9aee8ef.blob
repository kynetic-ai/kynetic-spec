   935→/**
   936→ * Fetch session events (optionally incremental via since_seq).
   937→ * AC: @ui-session-stream ac-1, ac-2
   938→ */
   939→export async function fetchSessionEvents(
   940→	id: string,
   941→	sinceSeq?: number
