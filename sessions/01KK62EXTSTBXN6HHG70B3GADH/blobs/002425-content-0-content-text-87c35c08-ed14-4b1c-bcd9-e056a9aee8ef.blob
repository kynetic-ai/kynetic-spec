   755→/**
   756→ * Fetch plans with optional status filter
   757→ * AC: @ui-plans-view ac-1
   758→ */
   759→export async function fetchPlans(params?: {
   760→	status?: string;
   761→}): Promise<{ items: PlanSummary[]; total: number }> {
   762→	if (isStaticMode()) {
   763→		return fetchPlansStatic(params);
   764→	}
   765→
   766→	const url = new URL(`${API_BASE}/api/plans`);
   767→
   768→	if (params) {
   769→		Object.entries(params).forEach(([key, value]) => {
   770→			if (value !== undefined && value !== '') {
   771→				url.searchParams.set(key, String(value));
   772→			}
   773→		});
   774→	}
   775→
   776→	const response = await fetch(url.toString(), {
   777→		headers: getProjectHeaders()
   778→	});
   779→	if (!response.ok) {
   780→		await handleResponseError(response);
   781→	}
   782→
   783→	return response.json();
   784→}
