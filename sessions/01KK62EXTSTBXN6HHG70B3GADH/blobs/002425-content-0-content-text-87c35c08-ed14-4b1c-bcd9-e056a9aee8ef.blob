   498→/**
   499→ * Search across all entities
   500→ * AC: @web-dashboard ac-24
   501→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   502→ * AC: @gh-pages-export ac-11 - Static mode support
   503→ */
   504→export async function search(query: string): Promise<SearchResponse> {
   505→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   506→	if (isStaticMode()) {
   507→		return searchStatic(query);
   508→	}
   509→
   510→	const url = new URL(`${API_BASE}/api/search`);
   511→	url.searchParams.set('q', query);
   512→
   513→	const response = await fetch(url.toString(), {
   514→		headers: getProjectHeaders()
   515→	});
   516→	if (!response.ok) {
   517→		await handleResponseError(response);
   518→	}
   519→
   520→	return response.json();
   521→}
