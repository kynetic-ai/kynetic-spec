```
     1→/**
     2→ * API Client
     3→ *
     4→ * Helper functions for making requests to the kspec daemon API.
     5→ * Supports both daemon mode (live) and static mode (read-only JSON).
     6→ *
     7→ * AC Coverage:
     8→ * - ac-26 (@multi-directory-daemon): X-Kspec-Dir header injection
     9→ * - ac-36 (@multi-directory-daemon): Invalid project error detection
    10→ * - ac-11 (@gh-pages-export): Mode-aware API dispatch
    11→ * - ac-18 (@gh-pages-export): Graceful no-op for write operations
    12→ */
    13→
    14→import type {
    15→	TaskSummary,
    16→	TaskDetail,
    17→	ItemSummary,
    18→	ItemDetail,
    19→	InboxItem,
    20→	SessionContext,
    21→	Observation,
    22→	Workflow,
    23→	Convention,
    24→	PaginatedResponse,
    25→	PlanSummary,
    26→	PlanDetail,
    27→	ErrorResponse,
    28→	SearchResponse,
    29→	AgentDefinition,
    30→	AgentUpdatePayload
    31→} from '@kynetic-ai/shared';
    32→import type { TriageRecord } from './types/triage';
    33→import {
    34→	getSelectedProjectPath,
    35→	clearInvalidSelection,
    36→	isInvalidProjectError,
    37→	type Project
    38→} from './stores/project.svelte';
    39→import { isStaticMode, assertWritable } from './stores/mode.svelte';
    40→import {
    41→	fetchTasksStatic,
    42→	fetchTaskStatic,
    43→	fetchItemsStatic,
    44→	fetchItemStatic,
    45→	fetchItemTasksStatic,
    46→	fetchInboxStatic,
    47→	fetchSessionContextStatic,
    48→	fetchObservationsStatic,
    49→	searchStatic,
    50→	fetchTriageRecordsStatic,
    51→	fetchPlansStatic,
    52→	fetchPlanContentStatic,
    53→	fetchValidationStatic,
    54→	fetchAlignmentStatic,
    55→	fetchWorkflowsStatic
    56→} from './api-static';
    57→import { DAEMON_API_BASE } from './constants';
    58→
    59→const API_BASE = DAEMON_API_BASE;
    60→
    61→/**
    62→ * Get headers for API requests, including X-Kspec-Dir if project is selected
    63→ * AC: @multi-directory-daemon ac-26
    64→ */
    65→function getProjectHeaders(): HeadersInit {
    66→	const path = getSelectedProjectPath();
    67→	return path ? { 'X-Kspec-Dir': path } : {};
    68→}
    69→
    70→/**
    71→ * Handle response errors, detecting invalid project errors
    72→ * AC: @multi-directory-daemon ac-36
    73→ */
    74→async function handleResponseError(response: Response): Promise<never> {
    75→	const error: ErrorResponse = await response.json();
    76→	const message = error.message || error.error;
    77→
    78→	// Check if this is an invalid project error
    79→	if (isInvalidProjectError(response, message)) {
    80→		clearInvalidSelection();
    81→	}
    82→
    83→	throw new Error(message);
    84→}
    85→
    86→/**
    87→ * Fetch registered projects
    88→ * AC: @multi-directory-daemon ac-25, ac-28
    89→ */
    90→export async function fetchProjects(): Promise<{ projects: Project[] }> {
    91→	const response = await fetch(`${API_BASE}/api/projects`);
    92→	if (!response.ok) {
    93→		await handleResponseError(response);
    94→	}
    95→	return response.json();
    96→}
    97→
    98→/**
    99→ * Fetch tasks with optional filters
   100→ * AC: @web-dashboard ac-9, ac-10
   101→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   102→ * AC: @gh-pages-export ac-11 - Static mode support
   103→ */
   104→export async function fetchTasks(params?: {
   105→	status?: string;
   106→	tag?: string;
   107→	assignee?: string;
   108→	automation?: string;
   109→	plan?: string;
   110→	limit?: number;
   111→	offset?: number;
   112→}): Promise<PaginatedResponse<TaskSummary>> {
   113→	// AC: @gh-pages-export ac-11 - Use static data in static mode
   114→	if (isStaticMode()) {
   115→		return fetchTasksStatic(params);
   116→	}
   117→
   118→	const url = new URL(`${API_BASE}/api/tasks`);
   119→
   120→	if (params) {
   121→		Object.entries(params).forEach(([key, value]) => {
   122→			if (value !== undefined && value !== '') {
   123→				url.searchParams.set(key, String(value));
   124→			}
   125→		});
   126→	}
   127→
   128→	const response = await fetch(url.toString(), {
   129→		headers: getProjectHeaders()
   130→	});
   131→	if (!response.ok) {
   132→		await handleResponseError(response);
   133→	}
   134→
   135→	return response.json();
   136→}
   137→
   138→/**
   139→ * Fetch single task by reference
   140→ * AC: @web-dashboard ac-5
   141→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   142→ * AC: @gh-pages-export ac-12 - Static mode deep linking
   143→ */
   144→export async function fetchTask(ref: string): Promise<TaskDetail> {
   145→	// AC: @gh-pages-export ac-12 - Use static data in static mode
   146→	if (isStaticMode()) {
   147→		const task = fetchTaskStatic(ref);
   148→		if (!task) {
   149→			throw new Error(`Task not found: ${ref}`);
   150→		}
   151→		return task;
   152→	}
   153→
   154→	const response = await fetch(`${API_BASE}/api/tasks/${ref}`, {
   155→		headers: getProjectHeaders()
   156→	});
   157→	if (!response.ok) {
   158→		await handleResponseError(response);
   159→	}
   160→
   161→	return response.json();
   162→}
   163→
   164→/**
   165→ * Start a task (change status to in_progress)
   166→ * AC: @web-dashboard ac-7
   167→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   168→ * AC: @gh-pages-export ac-16, ac-18 - Disabled in static mode
   169→ */
   170→export async function startTask(ref: string): Promise<void> {
   171→	// AC: @gh-pages-export ac-16, ac-18 - Write operations throw in static mode
   172→	assertWritable('start task');
   173→
   174→	const response = await fetch(`${API_BASE}/api/tasks/${ref}/start`, {
   175→		method: 'POST',
   176→		headers: getProjectHeaders()
   177→	});
   178→	if (!response.ok) {
   179→		await handleResponseError(response);
   180→	}
   181→}
   182→
   183→/**
   184→ * Add a note to a task
   185→ * AC: @web-dashboard ac-8
   186→ * AC: @multi-directory-daemon ac-26 - Includes X-Kspec-Dir header
   187→ * AC: @gh-pages-export ac-18 - Disabled in static mode
   188→ */
   189→export async function addTaskNote(ref: string, content: string): Promise<void> {
   190→	// AC: @gh-pages-export ac-18 - Write operations throw in static mode
   191→	assertWritable('add note');
   192→
   193→	const response = await fetch(`${API_BASE}/api/tasks/${ref}/note`, {
   194→		method: 'POST',
   195→		headers: {
   196→			'Content-Type': 'application/json',
   197→			...getProjectHeaders()
   198→		},
   199→		body: JSON.stringify({ content })
   200→	});
   201→	if (!response.ok) {
   202→		await handleResponseError(response);
   203→	}
   204→}
