    43→
    44→      // Initially expanded or collapsed based on default state
    45→      const expandButton = firstModule.getByTestId('expand-toggle');
    46→      await expect(expandButton).toBeVisible();
    47→
    48→      // Click to toggle expansion
    49→      await expandButton.click();
    50→
    51→      // Child nodes should toggle visibility
    52→      const childNodes = firstModule.getByTestId('tree-node-child');
    53→      // If children exist, they should be visible after expansion
    54→      const childCount = await childNodes.count();
    55→      if (childCount > 0) {
    56→        await expect(childNodes.first()).toBeVisible();
    57→
    58→        // Click again to collapse
