```
     1→/**
     2→ * Session management commands
     3→ *
     4→ * Provides context for starting/resuming work sessions.
     5→ */
     6→
     7→import chalk from "chalk";
     8→import type { Command } from "commander";
     9→import {
    10→  getReadyTasks,
    11→  initContext,
    12→  type KspecContext,
    13→  type LoadedTask,
    14→  loadAllItems,
    15→  loadAllTasks,
    16→  loadInboxItems,
    17→  loadSessionContext,
    18→  ReferenceIndex,
    19→} from "../../parser/index.js";
    20→import { type ShadowSyncResult, shadowPull } from "../../parser/shadow.js";
    21→import type { SessionContext as StoredSessionContext } from "../../schema/index.js";
    22→import {
    23→  errors,
    24→  hints,
    25→  sessionHeaders,
    26→  sessionPrompt,
    27→} from "../../strings/index.js";
    28→import {
    29→  formatCommitGuidance,
    30→  formatRelativeTime,
    31→  type GitWorkingTree,
    32→  getCurrentBranch,
    33→  getRecentCommits,
    34→  getWorkingTreeStatus,
    35→  isGitRepo,
    36→  parseTimeSpec,
    37→} from "../../utils/index.js";
    38→import { EXIT_CODES } from "../exit-codes.js";
    39→import { error, isJsonMode, output } from "../output.js";
    40→
    41→// ─── Types ───────────────────────────────────────────────────────────────────
    42→
    43→export interface CheckpointResult {
    44→  /** Whether session can end cleanly */
    45→  ok: boolean;
    46→
    47→  /** Human-readable message for Claude Code */
    48→  message: string;
    49→
    50→  /** Issues that need attention before stopping */
    51→  issues: CheckpointIssue[];
    52→
    53→  /** Instructions for the agent */
    54→  instructions: string[];
    55→}
    56→
    57→export interface CheckpointIssue {
    58→  type: "uncommitted_changes" | "in_progress_task" | "incomplete_todo";
    59→  description: string;
    60→  details?: Record<string, unknown>;
    61→}
    62→
    63→export interface SessionContext {
    64→  /** When this context was generated */
    65→  generated_at: string;
    66→
    67→  /** Current git branch */
    68→  branch: string | null;
    69→
    70→  /** Session context (focus, threads, questions) */
    71→  context: StoredSessionContext | null;
    72→
    73→  /** Tasks currently in progress */
    74→  active_tasks: ActiveTaskSummary[];
    75→
    76→  /** Tasks awaiting review (code done, PR pending) */
    77→  pending_review_tasks: ActiveTaskSummary[];
    78→
    79→  /** Recent notes from active tasks */
    80→  recent_notes: NoteSummary[];
    81→
    82→  /** Incomplete todos from active tasks */
    83→  active_todos: TodoSummary[];
    84→
    85→  /** Tasks ready to be picked up */
    86→  ready_tasks: ReadyTaskSummary[];
    87→
    88→  /** Blocked tasks with blockers */
    89→  blocked_tasks: BlockedTaskSummary[];
    90→
    91→  /** Recently completed tasks */
    92→  recently_completed: CompletedTaskSummary[];
    93→
    94→  /** Recent git commits */
    95→  recent_commits: CommitSummary[];
    96→
    97→  /** Working tree status */
    98→  working_tree: GitWorkingTree | null;
    99→
   100→  /** Inbox items awaiting triage (oldest first) */
   101→  inbox_items: InboxSummary[];
   102→
   103→  /** Summary statistics */
   104→  stats: SessionStats;
   105→}
   106→
   107→export interface ActiveTaskSummary {
   108→  ref: string;
   109→  title: string;
   110→  started_at: string | null;
   111→  priority: number;
   112→  spec_ref: string | null;
   113→  note_count: number;
   114→  last_note_at: string | null;
   115→  todo_count: number;
   116→  incomplete_todos: number;
   117→}
   118→
   119→export interface NoteSummary {
   120→  task_ref: string;
   121→  task_title: string;
   122→  note_ulid: string;
   123→  created_at: string;
   124→  author: string | null;
   125→  content: string;
   126→}
   127→
   128→export interface TodoSummary {
   129→  task_ref: string;
   130→  task_title: string;
   131→  id: number;
   132→  text: string;
   133→  added_at: string;
   134→  added_by: string | null;
   135→}
   136→
   137→export interface ReadyTaskSummary {
   138→  ref: string;
   139→  title: string;
   140→  priority: number;
   141→  spec_ref: string | null;
   142→  tags: string[];
   143→}
   144→
   145→export interface BlockedTaskSummary {
   146→  ref: string;
   147→  title: string;
   148→  blocked_by: string[];
   149→  unmet_deps: string[];
   150→}
   151→
   152→export interface CompletedTaskSummary {
   153→  ref: string;
   154→  title: string;
   155→  completed_at: string;
   156→  closed_reason: string | null;
   157→  origin?: "manual" | "derived" | "observation_promotion";
   158→}
   159→
   160→export interface CommitSummary {
   161→  hash: string;
   162→  full_hash: string;
   163→  date: string;
   164→  message: string;
   165→  author: string;
   166→}
   167→
   168→export interface SessionStats {
   169→  total_tasks: number;
   170→  in_progress: number;
   171→  pending_review: number;
   172→  ready: number;
   173→  blocked: number;
   174→  completed: number;
   175→  inbox_items: number;
   176→}
   177→
   178→export interface InboxSummary {
   179→  ref: string;
   180→  text: string;
   181→  created_at: string;
   182→  tags: string[];
   183→  added_by: string | null;
   184→}
   185→
   186→export interface SessionOptions {
   187→  brief?: boolean;
   188→  full?: boolean;
   189→  since?: string;
   190→  git?: boolean;
   191→  limit?: string;
   192→  eligible?: boolean; // Only include automation-eligible tasks in ready_tasks
   193→}
   194→
   195→// ─── Data Gathering ──────────────────────────────────────────────────────────
   196→
   197→function toActiveTaskSummary(
   198→  task: LoadedTask,
   199→  index: ReferenceIndex,
   200→): ActiveTaskSummary {
   201→  const lastNote =
   202→    task.notes.length > 0 ? task.notes[task.notes.length - 1] : null;
   203→  const incompleteTodos = task.todos.filter((t) => !t.done).length;
   204→  return {
   205→    ref: index.shortUlid(task._ulid),
   206→    title: task.title,
   207→    started_at: task.started_at || null,
   208→    priority: task.priority,
   209→    spec_ref: task.spec_ref || null,
   210→    note_count: task.notes.length,
   211→    last_note_at: lastNote ? lastNote.created_at : null,
   212→    todo_count: task.todos.length,
   213→    incomplete_todos: incompleteTodos,
   214→  };
   215→}
   216→
   217→function toReadyTaskSummary(
   218→  task: LoadedTask,
   219→  index: ReferenceIndex,
   220→): ReadyTaskSummary {
   221→  return {
   222→    ref: index.shortUlid(task._ulid),
   223→    title: task.title,
   224→    priority: task.priority,
   225→    spec_ref: task.spec_ref || null,
   226→    tags: task.tags,
   227→  };
   228→}
   229→
   230→function toBlockedTaskSummary(
   231→  task: LoadedTask,
   232→  _allTasks: LoadedTask[],
   233→  index: ReferenceIndex,
   234→): BlockedTaskSummary {
   235→  // Find unmet dependencies
   236→  const unmetDeps: string[] = [];
   237→  for (const depRef of task.depends_on) {
   238→    const result = index.resolve(depRef);
   239→    if (result.ok) {
   240→      const depItem = result.item;
   241→      if ("status" in depItem && depItem.status !== "completed") {
   242→        unmetDeps.push(depRef);
   243→      }
   244→    }
   245→  }
   246→
   247→  return {
   248→    ref: index.shortUlid(task._ulid),
   249→    title: task.title,
   250→    blocked_by: task.blocked_by,
   251→    unmet_deps: unmetDeps,
   252→  };
   253→}
   254→
   255→function toCompletedTaskSummary(
   256→  task: LoadedTask,
   257→  index: ReferenceIndex,
   258→): CompletedTaskSummary {
   259→  return {
   260→    ref: index.shortUlid(task._ulid),
   261→    title: task.title,
   262→    completed_at: task.completed_at || "",
   263→    closed_reason: task.closed_reason || null,
   264→    origin: task.origin,
   265→  };
   266→}
   267→
   268→function collectRecentNotes(
   269→  tasks: LoadedTask[],
   270→  index: ReferenceIndex,
   271→  options: { limit: number; since: Date | null },
   272→): NoteSummary[] {
   273→  const allNotes: NoteSummary[] = [];
   274→
   275→  for (const task of tasks) {
   276→    for (const note of task.notes) {
   277→      const noteDate = new Date(note.created_at);
   278→
   279→      // Filter by since date if provided
   280→      if (options.since && noteDate < options.since) {
   281→        continue;
   282→      }
   283→
   284→      allNotes.push({
   285→        task_ref: index.shortUlid(task._ulid),
   286→        task_title: task.title,
   287→        note_ulid: note._ulid.slice(0, 8),
   288→        created_at: note.created_at,
   289→        author: note.author || null,
   290→        content: note.content,
   291→      });
   292→    }
   293→  }
   294→
   295→  // Sort by date descending, take limit
   296→  return allNotes
   297→    .sort(
   298→      (a, b) =>
   299→        new Date(b.created_at).getTime() - new Date(a.created_at).getTime(),
   300→    )
   301→    .slice(0, options.limit);
   302→}
   303→
   304→function collectIncompleteTodos(
   305→  tasks: LoadedTask[],
   306→  index: ReferenceIndex,
   307→  options: { limit: number },
   308→): TodoSummary[] {
   309→  const allTodos: TodoSummary[] = [];
   310→
   311→  for (const task of tasks) {
   312→    for (const todo of task.todos) {
   313→      // Only include incomplete todos
   314→      if (todo.done) continue;
   315→
   316→      allTodos.push({
   317→        task_ref: index.shortUlid(task._ulid),
   318→        task_title: task.title,
   319→        id: todo.id,
   320→        text: todo.text,
   321→        added_at: todo.added_at,
   322→        added_by: todo.added_by || null,
   323→      });
   324→    }
   325→  }
   326→
   327→  // Sort by added_at descending (most recent first), take limit
   328→  return allTodos
   329→    .sort(
   330→      (a, b) => new Date(b.added_at).getTime() - new Date(a.added_at).getTime(),
   331→    )
   332→    .slice(0, options.limit);
   333→}
   334→
   335→/**
   336→ * Gather session context data
   337→ */
   338→export async function gatherSessionContext(
   339→  ctx: KspecContext,
   340→  options: SessionOptions,
   341→): Promise<SessionContext> {
   342→  const limit = parseInt(options.limit || "10", 10);
   343→  const sinceDate = options.since ? parseTimeSpec(options.since) : null;
   344→  const showGit = options.git !== false; // default true
   345→
   346→  // Load all data
   347→  const allTasks = await loadAllTasks(ctx);
   348→  const items = await loadAllItems(ctx);
   349→  const inboxItems = await loadInboxItems(ctx);
   350→  const index = new ReferenceIndex(allTasks, items);
   351→
   352→  // Compute stats
   353→  const stats: SessionStats = {
   354→    total_tasks: allTasks.length,
   355→    in_progress: allTasks.filter((t) => t.status === "in_progress").length,
   356→    pending_review: allTasks.filter((t) => t.status === "pending_review")
   357→      .length,
   358→    ready: getReadyTasks(allTasks).length,
   359→    blocked: allTasks.filter((t) => t.status === "blocked").length,
   360→    completed: allTasks.filter((t) => t.status === "completed").length,
   361→    inbox_items: inboxItems.length,
   362→  };
   363→
   364→  // Get active tasks
   365→  const activeTasks = allTasks
   366→    .filter((t) => t.status === "in_progress")
   367→    .sort((a, b) => a.priority - b.priority)
   368→    .slice(0, options.full ? undefined : limit)
   369→    .map((t) => toActiveTaskSummary(t, index));
   370→
   371→  // Get pending review tasks
   372→  const pendingReviewTasks = allTasks
   373→    .filter((t) => t.status === "pending_review")
   374→    .sort((a, b) => a.priority - b.priority)
   375→    .slice(0, options.full ? undefined : limit)
   376→    .map((t) => toActiveTaskSummary(t, index));
   377→
   378→  // Get recent notes from active tasks
   379→  const recentNotes = collectRecentNotes(
   380→    allTasks.filter((t) => t.status === "in_progress"),
   381→    index,
   382→    { limit: options.full ? limit * 2 : limit, since: sinceDate },
   383→  );
   384→
   385→  // Get incomplete todos from active tasks
   386→  const activeTodos = collectIncompleteTodos(
   387→    allTasks.filter((t) => t.status === "in_progress"),
   388→    index,
   389→    { limit: options.full ? limit * 2 : limit },
   390→  );
   391→
   392→  // Get ready tasks (optionally filtered to automation-eligible only)
   393→  const readyTasks = getReadyTasks(allTasks)
   394→    .filter((t) => !options.eligible || t.automation === "eligible")
   395→    .slice(0, options.full ? undefined : limit)
   396→    .map((t) => toReadyTaskSummary(t, index));
   397→
   398→  // Get blocked tasks
   399→  const blockedTasks = allTasks
   400→    .filter((t) => t.status === "blocked")
   401→    .slice(0, options.full ? undefined : limit)
   402→    .map((t) => toBlockedTaskSummary(t, allTasks, index));
   403→
   404→  // Get recently completed tasks
   405→  const recentlyCompleted = allTasks
   406→    .filter((t) => {
   407→      if (t.status !== "completed" || !t.completed_at) return false;
   408→      const completedDate = new Date(t.completed_at);
   409→      if (sinceDate && completedDate < sinceDate) return false;
   410→      return true;
   411→    })
   412→    .sort((a, b) => {
   413→      // Sort by completed_at descending (most recent first)
   414→      const aDate = new Date(a.completed_at || 0);
   415→      const bDate = new Date(b.completed_at || 0);
   416→      return bDate.getTime() - aDate.getTime();
   417→    })
   418→    .slice(0, options.full ? undefined : limit)
   419→    .map((t) => toCompletedTaskSummary(t, index));
   420→
   421→  // Get git info
   422→  let branch: string | null = null;
   423→  let recentCommits: CommitSummary[] = [];
   424→  let workingTree: GitWorkingTree | null = null;
   425→
   426→  if (showGit && isGitRepo(ctx.rootDir)) {
   427→    branch = getCurrentBranch(ctx.rootDir);
   428→
   429→    const commits = getRecentCommits({
   430→      limit: options.full ? limit * 2 : limit,
   431→      since: sinceDate || undefined,
   432→      cwd: ctx.rootDir,
   433→    });
   434→
   435→    recentCommits = commits.map((c) => ({
   436→      hash: c.hash,
   437→      full_hash: c.fullHash,
   438→      date: c.date.toISOString(),
   439→      message: c.message,
   440→      author: c.author,
   441→    }));
   442→
   443→    workingTree = getWorkingTreeStatus(ctx.rootDir);
   444→  }
   445→
   446→  // Get inbox items (oldest first to encourage triage)
   447→  const inboxSummaries: InboxSummary[] = inboxItems
   448→    .sort(
   449→      (a, b) =>
   450→        new Date(a.created_at).getTime() - new Date(b.created_at).getTime(),
   451→    )
   452→    .slice(0, options.full ? undefined : limit)
   453→    .map((item) => ({
   454→      ref: item._ulid.slice(0, 8),
   455→      text: item.text,
   456→      created_at: item.created_at,
   457→      tags: item.tags,
   458→      added_by: item.added_by || null,
   459→    }));
   460→
   461→  // Load session context (focus, threads, questions)
   462→  const sessionContext = await loadSessionContext(ctx);
   463→
   464→  return {
   465→    generated_at: new Date().toISOString(),
   466→    branch,
   467→    context: sessionContext,
   468→    active_tasks: activeTasks,
   469→    pending_review_tasks: pendingReviewTasks,
   470→    recent_notes: recentNotes,
   471→    active_todos: activeTodos,
   472→    ready_tasks: readyTasks,
   473→    blocked_tasks: blockedTasks,
   474→    recently_completed: recentlyCompleted,
   475→    recent_commits: recentCommits,
   476→    working_tree: workingTree,
   477→    inbox_items: inboxSummaries,
   478→    stats,
   479→  };
   480→}
   481→
   482→// ─── Checkpoint ──────────────────────────────────────────────────────────────
   483→
   484→export interface CheckpointOptions {
   485→  force?: boolean;
   486→  /** Set when stop hook is already active (retry after previous block) */
   487→  stopHookActive?: boolean;
   488→}
   489→
   490→/** Claude Code hook input for Stop hooks */
   491→export interface StopHookInput {
   492→  session_id?: string;
   493→  transcript_path?: string;
   494→  hook_event_name?: string;
   495→  stop_hook_active?: boolean;
   496→}
   497→
   498→/**
   499→ * Perform session checkpoint - check for uncommitted work before ending session.
   500→ *
   501→ * This is designed for use as a Claude Code stop hook. It checks for:
   502→ * - Uncommitted git changes (staged, unstaged, untracked)
   503→ * - Tasks in in_progress status
   504→ * - Incomplete todos on active tasks
   505→ *
   506→ * Returns a structured result indicating whether the session can end cleanly.
   507→ */
   508→export async function performCheckpoint(
   509→  ctx: KspecContext,
   510→  options: CheckpointOptions,
   511→): Promise<CheckpointResult> {
   512→  const issues: CheckpointIssue[] = [];
   513→  const instructions: string[] = [];
   514→
   515→  // Load tasks
   516→  const allTasks = await loadAllTasks(ctx);
   517→
   518→  // Check for in-progress tasks
   519→  const inProgressTasks = allTasks.filter((t) => t.status === "in_progress");
   520→  for (const task of inProgressTasks) {
   521→    const ref = task.slugs[0]
   522→      ? `@${task.slugs[0]}`
   523→      : `@${task._ulid.slice(0, 8)}`;
   524→    issues.push({
   525→      type: "in_progress_task",
   526→      description: `Task ${ref} is still in progress: ${task.title}`,
   527→      details: {
   528→        ref,
   529→        title: task.title,
   530→        started_at: task.started_at,
   531→      },
   532→    });
   533→
   534→    // Check for incomplete todos on this task
   535→    const incompleteTodos = task.todos.filter((t) => !t.done);
   536→    for (const todo of incompleteTodos) {
   537→      issues.push({
   538→        type: "incomplete_todo",
   539→        description: `Incomplete todo on ${ref}: ${todo.text}`,
   540→        details: {
   541→          task_ref: ref,
   542→          todo_id: todo.id,
   543→          text: todo.text,
   544→        },
   545→      });
   546→    }
   547→  }
   548→
   549→  // Check for uncommitted git changes
   550→  if (isGitRepo(ctx.rootDir)) {
   551→    const workingTree = getWorkingTreeStatus(ctx.rootDir);
   552→    if (!workingTree.clean) {
   553→      const changeCount =
   554→        workingTree.staged.length +
   555→        workingTree.unstaged.length +
   556→        workingTree.untracked.length;
   557→
   558→      issues.push({
   559→        type: "uncommitted_changes",
   560→        description: `${changeCount} uncommitted changes in working tree`,
   561→        details: {
   562→          staged: workingTree.staged.length,
   563→          unstaged: workingTree.unstaged.length,
   564→          untracked: workingTree.untracked.length,
   565→        },
   566→      });
   567→    }
   568→  }
   569→
   570→  // Build instructions based on issues
   571→  if (issues.length > 0 && !options.force) {
   572→    instructions.push("Before ending this session, please:");
   573→
   574→    const hasInProgress = issues.some((i) => i.type === "in_progress_task");
   575→    const hasUncommitted = issues.some((i) => i.type === "uncommitted_changes");
   576→    const hasIncompleteTodos = issues.some((i) => i.type === "incomplete_todo");
   577→
   578→    let step = 1;
   579→
   580→    if (hasInProgress) {
   581→      instructions.push(
   582→        `${step++}. Add notes to in-progress tasks documenting current state`,
   583→      );
   584→      instructions.push(
   585→        `${step++}. Either complete the tasks or leave them in_progress with clear notes for next session`,
   586→      );
   587→    }
   588→
   589→    if (hasIncompleteTodos) {
   590→      instructions.push(
   591→        `${step++}. Complete or acknowledge incomplete todos on active tasks`,
   592→      );
   593→    }
   594→
   595→    if (hasUncommitted) {
   596→      instructions.push(
   597→        `${step++}. Commit your changes with a descriptive message`,
   598→      );
   599→
   600→      // Add WIP commit guidance if there are in-progress tasks
   601→      if (inProgressTasks.length > 0) {
   602→        const task = inProgressTasks[0];
   603→        const guidance = formatCommitGuidance(task, { wip: true });
   604→        instructions.push("");
   605→        instructions.push("Suggested WIP commit:");
   606→        instructions.push(`  ${guidance.message}`);
   607→        instructions.push("");
   608→        for (const trailer of guidance.trailers) {
   609→          instructions.push(`  ${trailer}`);
   610→        }
   611→      }
   612→    }
   613→
   614→    instructions.push("");
   615→    instructions.push(
   616→      'Use: kspec task note @task "Progress notes..." to document state',
   617→    );
   618→    instructions.push(
   619→      'Use: kspec task complete @task --reason "Summary" if task is done',
   620→    );
   621→  }
   622→
   623→  // Allow stop if:
   624→  // - No issues found
   625→  // - --force flag passed
   626→  // - This is a retry (stop_hook_active = true from previous block)
   627→  const isRetry = options.stopHookActive === true;
   628→  const ok = issues.length === 0 || options.force === true || isRetry;
   629→
   630→  let message: string;
   631→  if (isRetry && issues.length > 0) {
   632→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) acknowledged - allowing stop`;
   633→  } else if (ok) {
   634→    message = "[kspec] Session checkpoint passed - ready to end session";
   635→  } else {
   636→    message = `[kspec] Session checkpoint: ${issues.length} issue(s) need attention`;
   637→  }
   638→
   639→  return {
   640→    ok,
   641→    message,
   642→    issues,
   643→    instructions,
   644→  };
   645→}
   646→
   647→// ─── Output Formatting ───────────────────────────────────────────────────────
   648→
   649→function formatCheckpointResult(result: CheckpointResult): void {
   650→  if (result.ok) {
   651→    console.log(chalk.green(result.message));
   652→  } else {
   653→    console.log(chalk.yellow(result.message));
   654→    console.log("");
   655→
   656→    for (const issue of result.issues) {
   657→      const icon =
   658→        issue.type === "uncommitted_changes"
   659→          ? chalk.yellow("⚠")
   660→          : issue.type === "in_progress_task"
   661→            ? chalk.blue("●")
   662→            : chalk.gray("○");
   663→      console.log(`  ${icon} ${issue.description}`);
   664→    }
   665→
   666→    if (result.instructions.length > 0) {
   667→      console.log("");
   668→      for (const instruction of result.instructions) {
   669→        console.log(chalk.gray(instruction));
   670→      }
   671→    }
   672→  }
   673→}
   674→
   675→function formatSessionContext(
   676→  ctx: SessionContext,
   677→  options: SessionOptions,
   678→): void {
   679→  const isBrief = !options.full;
   680→
   681→  // Header
   682→  console.log(`\n${sessionHeaders.title}`);
   683→  const age = formatRelativeTime(new Date(ctx.generated_at));
   684→  if (ctx.branch) {
   685→    console.log(chalk.gray(`Branch: ${ctx.branch} | Generated: ${age}`));
   686→  } else {
   687→    console.log(chalk.gray(`Generated: ${age}`));
   688→  }
   689→
   690→  // Stats summary
   691→  const pendingReviewNote =
   692→    ctx.stats.pending_review > 0
   693→      ? `${ctx.stats.pending_review} awaiting review, `
   694→      : "";
   695→  const inboxNote =
   696→    ctx.stats.inbox_items > 0 ? ` | Inbox: ${ctx.stats.inbox_items}` : "";
   697→  console.log(
   698→    chalk.gray(
   699→      `Tasks: ${ctx.stats.in_progress} active, ${pendingReviewNote}${ctx.stats.ready} ready, ` +
   700→        `${ctx.stats.blocked} blocked, ${ctx.stats.completed}/${ctx.stats.total_tasks} completed${inboxNote}`,
   701→    ),
   702→  );
   703→
   704→  // Session context section (focus, threads, questions)
   705→  if (
   706→    ctx.context &&
   707→    (ctx.context.focus ||
   708→      ctx.context.threads.length > 0 ||
   709→      ctx.context.open_questions.length > 0)
   710→  ) {
   711→    console.log("\n--- Session Context ---");
   712→
   713→    if (ctx.context.focus) {
   714→      console.log(`  ${chalk.cyan("Focus:")} ${ctx.context.focus}`);
   715→    }
   716→
   717→    if (ctx.context.threads.length > 0) {
   718→      console.log(`  ${chalk.cyan("Active Threads:")}`);
   719→      for (const thread of ctx.context.threads) {
   720→        console.log(`    - ${thread}`);
   721→      }
   722→    }
   723→
   724→    if (ctx.context.open_questions.length > 0) {
   725→      console.log(`  ${chalk.cyan("Open Questions:")}`);
   726→      for (const question of ctx.context.open_questions) {
   727→        console.log(`    - ${question}`);
   728→      }
   729→    }
   730→  }
   731→
   732→  // Active tasks section
   733→  if (ctx.active_tasks.length > 0) {
   734→    console.log(`\n${sessionHeaders.activeWork}`);
   735→    for (const task of ctx.active_tasks) {
   736→      const started = task.started_at
   737→        ? chalk.gray(
   738→            ` (started ${formatRelativeTime(new Date(task.started_at))})`,
   739→          )
   740→        : "";
   741→      const priority =
   742→        task.priority <= 2
   743→          ? chalk.red(`P${task.priority}`)
   744→          : chalk.gray(`P${task.priority}`);
   745→      console.log(
   746→        `  ${chalk.blue("[in_progress]")} ${priority} ${task.ref} ${task.title}${started}`,
   747→      );
   748→    }
   749→  } else {
   750→    console.log(`\n${sessionHeaders.noActiveWork}`);
   751→  }
   752→
   753→  // Awaiting review section
   754→  if (ctx.pending_review_tasks.length > 0) {
   755→    console.log(`\n${sessionHeaders.awaitingReview}`);
   756→    for (const task of ctx.pending_review_tasks) {
   757→      const priority =
   758→        task.priority <= 2
   759→          ? chalk.red(`P${task.priority}`)
   760→          : chalk.gray(`P${task.priority}`);
   761→      console.log(
   762→        `  ${chalk.yellow("[pending_review]")} ${priority} ${task.ref} ${task.title}`,
   763→      );
   764→    }
   765→  }
   766→
   767→  // Recently completed section
   768→  if (ctx.recently_completed.length > 0) {
   769→    console.log(`\n${sessionHeaders.recentlyCompleted}`);
   770→    const observationPromotedTasks: string[] = [];
   771→    for (const task of ctx.recently_completed) {
   772→      const completedAge = formatRelativeTime(new Date(task.completed_at));
   773→      let reason = "";
   774→      if (task.closed_reason) {
   775→        const maxLen = isBrief ? 60 : 120;
   776→        const truncated =
   777→          task.closed_reason.length > maxLen
   778→            ? `${task.closed_reason.slice(0, maxLen).trim()}...`
   779→            : task.closed_reason;
   780→        reason = chalk.gray(` - ${truncated}`);
   781→      }
   782→      console.log(
   783→        `  ${chalk.green("[completed]")} ${task.ref} ${task.title} ${chalk.gray(`(${completedAge})`)}${reason}`,
   784→      );
   785→
   786→      // Track tasks that came from observations
   787→      if (task.origin === "observation_promotion") {
   788→        observationPromotedTasks.push(task.ref);
   789→      }
   790→    }
   791→
   792→    // Show reminder about resolving observations
   793→    if (observationPromotedTasks.length > 0) {
   794→      console.log(
   795→        chalk.yellow(
   796→          `\n  ℹ Consider resolving linked observations: ${observationPromotedTasks.join(", ")}`,
   797→        ),
   798→      );
   799→      console.log(
   800→        chalk.gray(`    Run: kspec meta observations --pending-resolution`),
   801→      );
   802→    }
   803→  }
   804→
   805→  // Recent notes section
   806→  if (ctx.recent_notes.length > 0) {
   807→    console.log(`\n${sessionHeaders.recentNotes}`);
   808→    for (const note of ctx.recent_notes) {
   809→      const age = formatRelativeTime(new Date(note.created_at));
   810→      const author = note.author ? chalk.gray(` by ${note.author}`) : "";
   811→      console.log(`  ${chalk.yellow(age)} on ${note.task_ref}${author}:`);
   812→
   813→      // Truncate content in brief mode
   814→      let content = note.content.trim();
   815→      if (isBrief && content.length > 200) {
   816→        content = `${content.slice(0, 200).trim()}...`;
   817→      }
   818→
   819→      // Indent content, limit lines in brief mode
   820→      const lines = content.split("\n");
   821→      const maxLines = isBrief ? 3 : lines.length;
   822→      for (const line of lines.slice(0, maxLines)) {
   823→        console.log(`    ${chalk.white(line)}`);
   824→      }
   825→      if (isBrief && lines.length > maxLines) {
   826→        console.log(
   827→          chalk.gray(`    ... (${lines.length - maxLines} more lines)`),
   828→        );
   829→      }
   830→    }
   831→  }
   832→
   833→  // Incomplete todos section
   834→  if (ctx.active_todos.length > 0) {
   835→    console.log(`\n${sessionHeaders.incompleteTodos}`);
   836→    for (const todo of ctx.active_todos) {
   837→      console.log(
   838→        `  ${chalk.yellow("[ ]")} ${todo.task_ref}#${todo.id}: ${todo.text}`,
   839→      );
   840→    }
   841→  }
   842→
   843→  // Ready tasks section
   844→  if (ctx.ready_tasks.length > 0) {
   845→    console.log(`\n${sessionHeaders.readyTasks}`);
   846→    for (const task of ctx.ready_tasks) {
   847→      const priority =
   848→        task.priority <= 2
   849→          ? chalk.red(`P${task.priority}`)
   850→          : chalk.gray(`P${task.priority}`);
   851→      const tags =
   852→        task.tags.length > 0 ? chalk.cyan(` #${task.tags.join(" #")}`) : "";
   853→      console.log(`  ${priority} ${task.ref} ${task.title}${tags}`);
   854→    }
   855→  }
   856→
   857→  // Blocked tasks section
   858→  if (ctx.blocked_tasks.length > 0) {
   859→    console.log(`\n${sessionHeaders.blocked}`);
   860→    for (const task of ctx.blocked_tasks) {
   861→      console.log(`  ${chalk.red("[blocked]")} ${task.ref} ${task.title}`);
   862→      if (task.blocked_by.length > 0) {
   863→        console.log(chalk.gray(`    Blockers: ${task.blocked_by.join(", ")}`));
   864→      }
   865→      if (task.unmet_deps.length > 0) {
   866→        console.log(
   867→          chalk.gray(`    Waiting on: ${task.unmet_deps.join(", ")}`),
   868→        );
   869→      }
   870→    }
   871→  }
   872→
   873→  // Git commits section
   874→  if (ctx.recent_commits.length > 0) {
   875→    console.log(`\n${sessionHeaders.recentCommits}`);
   876→    for (const commit of ctx.recent_commits) {
   877→      const age = formatRelativeTime(new Date(commit.date));
   878→      console.log(
   879→        `  ${chalk.yellow(commit.hash)} ${commit.message} ${chalk.gray(`(${age}, ${commit.author})`)}`,
   880→      );
   881→    }
   882→  }
   883→
   884→  // Inbox section (oldest first to encourage triage)
   885→  if (ctx.inbox_items.length > 0) {
   886→    console.log(`\n${sessionHeaders.inbox}`);
   887→    for (const item of ctx.inbox_items) {
   888→      const age = formatRelativeTime(new Date(item.created_at));
   889→      const author = item.added_by ? ` by ${item.added_by}` : "";
   890→      const tags =
   891→        item.tags.length > 0 ? chalk.cyan(` [${item.tags.join(", ")}]`) : "";
   892→      // Truncate text in brief mode
   893→      let text = item.text;
   894→      if (isBrief && text.length > 60) {
   895→        text = `${text.slice(0, 60).trim()}...`;
   896→      }
   897→      console.log(
   898→        `  ${chalk.magenta(item.ref)} ${chalk.gray(`(${age}${author})`)}${tags}`,
   899→      );
   900→      console.log(`    ${text}`);
   901→    }
   902→    console.log(`  ${hints.inboxPromote}`);
   903→  }
   904→
   905→  // Working tree section
   906→  if (ctx.working_tree && !ctx.working_tree.clean) {
   907→    console.log(`\n${sessionHeaders.workingTree}`);
   908→
   909→    if (ctx.working_tree.staged.length > 0) {
   910→      console.log(chalk.green("  Staged:"));
   911→      for (const file of ctx.working_tree.staged) {
   912→        console.log(
   913→          `    ${chalk.green(file.status[0].toUpperCase())} ${file.path}`,
   914→        );
   915→      }
   916→    }
   917→
   918→    if (ctx.working_tree.unstaged.length > 0) {
   919→      console.log(chalk.red("  Modified:"));
   920→      for (const file of ctx.working_tree.unstaged) {
   921→        console.log(
   922→          `    ${chalk.red(file.status[0].toUpperCase())} ${file.path}`,
   923→        );
   924→      }
   925→    }
   926→
   927→    if (ctx.working_tree.untracked.length > 0) {
   928→      console.log(chalk.gray("  Untracked:"));
   929→      const limit = isBrief ? 5 : ctx.working_tree.untracked.length;
   930→      for (const path of ctx.working_tree.untracked.slice(0, limit)) {
   931→        console.log(`    ${chalk.gray("?")} ${path}`);
   932→      }
   933→      if (isBrief && ctx.working_tree.untracked.length > limit) {
   934→        console.log(
   935→          chalk.gray(
   936→            `    ... and ${ctx.working_tree.untracked.length - limit} more`,
   937→          ),
   938→        );
   939→      }
   940→    }
   941→  } else if (ctx.working_tree?.clean) {
   942→    console.log(`\n${sessionHeaders.workingTreeClean}`);
   943→  }
   944→
   945→  // Quick Commands section - contextual hints based on state
   946→  const quickCommands: string[] = [];
   947→
   948→  if (ctx.active_tasks.length > 0) {
   949→    const ref = ctx.active_tasks[0].ref;
   950→    quickCommands.push(
   951→      `kspec task note @${ref} "Progress..."  ${chalk.gray("# document work")}`,
   952→    );
   953→    quickCommands.push(
   954→      `kspec task complete @${ref} --reason "..."  ${chalk.gray("# finish task")}`,
   955→    );
   956→  } else if (ctx.ready_tasks.length > 0) {
   957→    const ref = ctx.ready_tasks[0].ref;
   958→    quickCommands.push(
   959→      `kspec task start @${ref}  ${chalk.gray("# begin work")}`,
   960→    );
   961→  }
   962→
   963→  if (ctx.inbox_items.length > 0) {
   964→    const ref = ctx.inbox_items[0].ref;
   965→    quickCommands.push(
   966→      `kspec inbox promote @${ref} --title "..."  ${chalk.gray("# convert to task")}`,
   967→    );
   968→  }
   969→
   970→  if (ctx.working_tree && !ctx.working_tree.clean) {
   971→    quickCommands.push(
   972→      `git add . && git commit -m "..."  ${chalk.gray("# commit changes")}`,
   973→    );
   974→  }
   975→
   976→  if (quickCommands.length > 0) {
   977→    console.log(`\n${sessionHeaders.quickCommands}`);
   978→    for (const hint of quickCommands) {
   979→      console.log(`  ${hint}`);
   980→    }
   981→  }
   982→
   983→  console.log(""); // Final newline
   984→}
   985→
   986→// ─── Command Registration ────────────────────────────────────────────────────
   987→
   988→async function sessionStartAction(options: SessionOptions): Promise<void> {
   989→  try {
   990→    const ctx = await initContext();
   991→
   992→    // AC: @shadow-sync ac-2 - Pull remote changes before showing session context
   993→    let syncResult: ShadowSyncResult | null = null;
   994→    if (ctx.shadow?.enabled) {
   995→      syncResult = await shadowPull(ctx.shadow.worktreeDir);
   996→      // AC: @shadow-sync ac-3 - Warn about conflicts but continue with local state
   997→      if (syncResult.hadConflict) {
   998→        console.log(
   999→          chalk.yellow(
  1000→            "⚠ Shadow sync conflict detected. Run `kspec shadow resolve` to fix.",
  1001→          ),
  1002→        );
  1003→        console.log(chalk.gray("  Continuing with local state..."));
  1004→        console.log("");
  1005→      } else if (syncResult.pulled) {
  1006→        console.log(chalk.gray("ℹ Synced shadow branch from remote"));
  1007→      }
  1008→    }
  1009→
  1010→    const sessionCtx = await gatherSessionContext(ctx, options);
  1011→
  1012→    output(sessionCtx, () => formatSessionContext(sessionCtx, options));
  1013→  } catch (err) {
  1014→    error(errors.failures.gatherSessionContext, err);
  1015→    process.exit(EXIT_CODES.ERROR);
  1016→  }
  1017→}
  1018→
  1019→/**
  1020→ * Read stdin if available (non-blocking check for hook input)
  1021→ */
  1022→async function readStdinIfAvailable(): Promise<string | null> {
  1023→  // Check if stdin is a TTY (interactive) - if so, don't try to read
  1024→  if (process.stdin.isTTY) {
  1025→    return null;
  1026→  }
  1027→
  1028→  return new Promise((resolve) => {
  1029→    let data = "";
  1030→    const timeout = setTimeout(() => {
  1031→      process.stdin.removeAllListeners();
  1032→      resolve(data || null);
  1033→    }, 100); // 100ms timeout for stdin
  1034→
  1035→    process.stdin.setEncoding("utf8");
  1036→    process.stdin.on("data", (chunk) => {
  1037→      data += chunk;
  1038→    });
  1039→    process.stdin.on("end", () => {
  1040→      clearTimeout(timeout);
  1041→      resolve(data || null);
  1042→    });
  1043→    process.stdin.on("error", () => {
  1044→      clearTimeout(timeout);
  1045→      resolve(null);
  1046→    });
  1047→    process.stdin.resume();
  1048→  });
  1049→}
  1050→
  1051→/**
  1052→ * Parse Claude Code hook input from stdin
  1053→ */
  1054→function parseHookInput(stdin: string | null): StopHookInput | null {
  1055→  if (!stdin) return null;
  1056→  try {
  1057→    return JSON.parse(stdin.trim()) as StopHookInput;
  1058→  } catch {
  1059→    return null;
  1060→  }
  1061→}
  1062→
  1063→// ─── Prompt Check (UserPromptSubmit Hook) ────────────────────────────────────
  1064→
  1065→/**
  1066→ * Output spec-first reminder for UserPromptSubmit hook.
  1067→ *
  1068→ * This is a simple context injection - always outputs the reminder,
  1069→ * and Claude (Opus) is smart enough to apply it when relevant.
  1070→ */
  1071→async function sessionPromptCheckAction(): Promise<void> {
  1072→  // Lean, instructive reminder with kspec prefix
  1073→  console.log(sessionPrompt.specCheck);
  1074→}
  1075→
  1076→async function sessionCheckpointAction(
  1077→  options: CheckpointOptions,
  1078→): Promise<void> {
  1079→  try {
  1080→    // Read stdin for Claude Code hook input
  1081→    const stdin = await readStdinIfAvailable();
  1082→    const hookInput = parseHookInput(stdin);
  1083→
  1084→    // Check if this is a retry (stop hook already active)
  1085→    if (hookInput?.stop_hook_active) {
  1086→      options.stopHookActive = true;
  1087→    }
  1088→
  1089→    const ctx = await initContext();
  1090→    const result = await performCheckpoint(ctx, options);
  1091→
  1092→    // Output format depends on mode:
  1093→    // - JSON mode (--json): Output Claude Code hook format {"decision": "block", "reason": "..."}
  1094→    // - Human mode: Output formatted checkpoint result
  1095→    if (isJsonMode()) {
  1096→      if (!result.ok) {
  1097→        // Build reason message with issues and instructions
  1098→        const issueLines = result.issues
  1099→          .map((i) => `- ${i.description}`)
  1100→          .join("\n");
  1101→        const instructionLines = result.instructions
  1102→          .filter((i) => i.trim())
  1103→          .join("\n");
  1104→        const reason = `${result.message}\n\nIssues:\n${issueLines}\n\n${instructionLines}`;
  1105→        console.log(JSON.stringify({ decision: "block", reason }));
  1106→      }
  1107→      // If ok, exit silently (Claude Code expects no output when allowing stop)
  1108→    } else {
  1109→      formatCheckpointResult(result);
  1110→      if (!result.ok) {
  1111→        process.exit(EXIT_CODES.ERROR);
  1112→      }
  1113→    }
  1114→  } catch (err) {
  1115→    error(errors.failures.runCheckpoint, err);
  1116→    process.exit(EXIT_CODES.ERROR);
  1117→  }
  1118→}
  1119→
  1120→/**
  1121→ * Register the 'session' command group and aliases
  1122→ */
  1123→export function registerSessionCommands(program: Command): void {
  1124→  const session = program
  1125→    .command("session")
  1126→    .description("Session management and context");
  1127→
  1128→  session
  1129→    .command("start")
  1130→    .alias("resume")
  1131→    .description("Surface relevant context for starting a new working session")
  1132→    .option("--brief", "Compact summary (default)")
  1133→    .option("--full", "Comprehensive context dump")
  1134→    .option(
  1135→      "--since <time>",
  1136→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  1137→    )
  1138→    .option("--no-git", "Skip git commit information")
  1139→    .option("-n, --limit <n>", "Limit items per section", "10")
  1140→    .action(sessionStartAction);
  1141→
  1142→  session
  1143→    .command("checkpoint")
  1144→    .description(
  1145→      "Pre-stop hook: check for uncommitted work before ending session",
  1146→    )
  1147→    .option("--force", "Allow session end regardless of issues")
  1148→    .action(sessionCheckpointAction);
  1149→
  1150→  session
  1151→    .command("prompt-check")
  1152→    .description("UserPromptSubmit hook: inject spec-first reminder")
  1153→    .action(sessionPromptCheckAction);
  1154→
  1155→  // Top-level alias: kspec context
  1156→  program
  1157→    .command("context")
  1158→    .description("Alias for session start - surface session context")
  1159→    .option("--brief", "Compact summary (default)")
  1160→    .option("--full", "Comprehensive context dump")
  1161→    .option(
  1162→      "--since <time>",
  1163→      "Filter by recency (ISO8601 or relative: 1h, 2d, 1w)",
  1164→    )
  1165→    .option("--no-git", "Skip git commit information")
  1166→    .option("-n, --limit <n>", "Limit items per section", "10")
  1167→    .action(sessionStartAction);
  1168→}
  1169→

