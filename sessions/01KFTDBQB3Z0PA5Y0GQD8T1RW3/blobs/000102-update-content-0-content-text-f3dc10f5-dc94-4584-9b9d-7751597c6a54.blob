     1→/**
     2→ * Tests for ProjectContextManager
     3→ *
     4→ * Tests the project registration, caching, path validation, and context management
     5→ * for the multi-directory daemon architecture.
     6→ *
     7→ * AC: @multi-directory-daemon ac-1, ac-2, ac-3, ac-4, ac-5, ac-6, ac-7, ac-8, ac-8c, ac-14, ac-15, ac-16, ac-20, ac-20b
     8→ */
     9→
    10→import { describe, it, expect, beforeEach, afterEach } from 'vitest';
    11→import { setupMultiDirFixtures, cleanupTempDir } from './helpers/cli';
    12→import { join } from 'path';
    13→import { symlink } from 'fs/promises';
    14→import { ProjectContextManager } from '../packages/daemon/src/project-context';
    15→import type { ProjectContext } from '../packages/daemon/src/project-context';
    16→
    17→describe('ProjectContextManager', () => {
    18→  let fixturesRoot: string;
    19→  let projectA: string;
    20→  let projectB: string;
    21→  let projectInvalid: string;
    22→  let manager: ProjectContextManager;
    23→
    24→  beforeEach(async () => {
    25→    fixturesRoot = await setupMultiDirFixtures();
    26→    projectA = join(fixturesRoot, 'project-a');
    27→    projectB = join(fixturesRoot, 'project-b');
    28→    projectInvalid = join(fixturesRoot, 'project-invalid');
    29→    manager = new ProjectContextManager();
    30→  });
    31→
    32→  afterEach(async () => {
    33→    await cleanupTempDir(fixturesRoot);
    34→  });
    35→
    36→  describe('Project registration and caching', () => {
    37→    // AC: @multi-directory-daemon ac-4
    38→    it('should auto-register new project on first request', () => {
    39→      expect(manager.hasProject(projectA)).toBe(false);
    40→
    41→      const context = manager.registerProject(projectA);
    42→
    43→      expect(manager.hasProject(projectA)).toBe(true);
    44→      expect(context.path).toBe(projectA);
    45→      expect(context.watcherActive).toBe(false); // Watcher started separately via startWatcher()
    46→      expect(context.registeredAt).toBeInstanceOf(Date);
    47→    });
    48→
    49→    // AC: @multi-directory-daemon ac-4
    50→    it('should cache registered project', () => {
    51→      const context1 = manager.registerProject(projectA);
    52→      const context2 = manager.getProject(projectA);
    53→
    54→      expect(context1).toBe(context2); // Same object reference
    55→    });
    56→
    57→    // AC: @multi-directory-daemon ac-14
    58→    it('should register multiple projects independently', () => {
    59→      manager.registerProject(projectA);
    60→      manager.registerProject(projectB);
    61→
    62→      expect(manager.hasProject(projectA)).toBe(true);
    63→      expect(manager.hasProject(projectB)).toBe(true);
    64→
    65→      const contextA = manager.getProject(projectA);
    66→      const contextB = manager.getProject(projectB);
    67→
    68→      expect(contextA.path).toBe(projectA);
    69→      expect(contextB.path).toBe(projectB);
    70→    });
    71→
    72→    // AC: @multi-directory-daemon ac-15
    73→    it('should list all registered projects', () => {
    74→      manager.registerProject(projectA);
    75→      manager.registerProject(projectB);
    76→
    77→      const projects = manager.listProjects();
    78→
    79→      expect(projects).toHaveLength(2);
    80→      expect(projects.map(p => p.path)).toContain(projectA);
    81→      expect(projects.map(p => p.path)).toContain(projectB);
    82→    });
    83→
    84→    // AC: @multi-directory-daemon ac-16
    85→    it('should handle concurrent registration of same project', () => {
    86→      // Simulate concurrent registration
    87→      const context1 = manager.registerProject(projectA);
    88→      const context2 = manager.registerProject(projectA);
    89→
    90→      // Should return same context (no duplicate)
    91→      expect(context1).toBe(context2);
    92→      expect(manager.listProjects()).toHaveLength(1);
    93→    });
    94→
    95→    // AC: @multi-directory-daemon ac-4
    96→    it('should not re-register already cached project', () => {
    97→      const context1 = manager.registerProject(projectA);
    98→      const registeredAt1 = context1.registeredAt;
    99→
   100→      // Re-register immediately (should return same cached instance)
   101→      const context2 = manager.registerProject(projectA);
   102→
   103→      expect(context2).toBe(context1);
   104→      expect(context2.registeredAt).toBe(registeredAt1);
   105→    });
   106→  });
   107→
   108→  describe('Daemon restart behavior', () => {
   109→    // AC: @multi-directory-daemon ac-14
   110→    it('should re-register project automatically after daemon restart', () => {
   111→      // Initial registration before restart
   112→      manager.registerProject(projectA);
   113→      manager.registerProject(projectB);
   114→      expect(manager.listProjects()).toHaveLength(2);
   115→
   116→      // Simulate daemon restart (new instance)
   117→      const managerAfterRestart = new ProjectContextManager();
   118→
   119→      // Verify list is empty after restart
   120→      expect(managerAfterRestart.listProjects()).toHaveLength(0);
   121→
   122→      // Simulate first request - auto-registers project
   123→      const context = managerAfterRestart.registerProject(projectA);
   124→      expect(context.path).toBe(projectA);
   125→      expect(managerAfterRestart.hasProject(projectA)).toBe(true);
   126→
   127→      // Project B is not re-registered yet
   128→      expect(managerAfterRestart.hasProject(projectB)).toBe(false);
   129→    });
   130→
   131→    // AC: @multi-directory-daemon ac-15
   132→    it('should have empty project list after daemon restart', () => {
   133→      // Register projects before restart
   134→      manager.registerProject(projectA);
   135→      manager.registerProject(projectB);
   136→      expect(manager.listProjects()).toHaveLength(2);
   137→
   138→      // Simulate daemon restart (new instance = fresh state)
   139→      const managerAfterRestart = new ProjectContextManager();
   140→
   141→      // AC-15: No persistence across restarts
   142→      expect(managerAfterRestart.listProjects()).toHaveLength(0);
   143→      expect(managerAfterRestart.hasProject(projectA)).toBe(false);
   144→      expect(managerAfterRestart.hasProject(projectB)).toBe(false);
   145→    });
   146→
   147→    // AC: @multi-directory-daemon ac-15
   148→    it('should require re-registration of all projects after restart', () => {
   149→      // Register with default before restart
   150→      manager.registerProject(projectA, true);
   151→      manager.registerProject(projectB);
   152→
   153→      // Simulate daemon restart
   154→      const managerAfterRestart = new ProjectContextManager();
   155→
   156→      // All projects must be re-registered
   157→      expect(() => managerAfterRestart.getProject(projectA)).toThrow('Project not registered');
   158→      expect(() => managerAfterRestart.getProject(projectB)).toThrow('Project not registered');
   159→      expect(() => managerAfterRestart.getProject()).toThrow('No default project configured');
   160→
   161→      // Re-register on first request after restart
   162→      managerAfterRestart.registerProject(projectA, true);
   163→      expect(managerAfterRestart.getProject()).toBeDefined();
   164→    });
   165→  });
   166→
   167→  describe('Path validation', () => {
   168→    // AC: @multi-directory-daemon ac-5
   169→    it('should reject path without .kspec/ directory', () => {
   170→      expect(() => {
   171→        manager.registerProject(projectInvalid);
   172→      }).toThrow('Invalid kspec project - .kspec/ not found');
   173→    });
   174→
   175→    // AC: @multi-directory-daemon ac-6
   176→    it('should reject relative paths', () => {
   177→      expect(() => {
   178→        manager.registerProject('./project-a');
   179→      }).toThrow('Path must be absolute');
   180→    });
   181→
   182→    // AC: @multi-directory-daemon ac-6
   183→    it('should reject paths without leading slash', () => {
   184→      expect(() => {
   185→        manager.registerProject('project-a');
   186→      }).toThrow('Path must be absolute');
   187→    });
   188→
   189→    // AC: @multi-directory-daemon ac-7
   190→    it('should reject paths with parent traversal (..) segments', () => {
   191→      expect(() => {
   192→        manager.registerProject(`${projectA}/../project-a`);
   193→      }).toThrow('Path must not contain parent traversal');
   194→    });
   195→
   196→    // AC: @multi-directory-daemon ac-7
   197→    it('should reject paths with .. in middle', () => {
   198→      expect(() => {
   199→        manager.registerProject('/some/path/../other/path');
   200→      }).toThrow('Path must not contain parent traversal');
   201→    });
   202→  });
   203→
   204→  describe('Path normalization', () => {
   205→    // AC: @multi-directory-daemon ac-8
   206→    it('should normalize path with trailing slash', () => {
   207→      const contextWithSlash = manager.registerProject(`${projectA}/`);
   208→      const contextWithoutSlash = manager.getProject(projectA);
   209→
   210→      expect(contextWithSlash).toBe(contextWithoutSlash);
   211→      expect(contextWithSlash.path).toBe(projectA); // No trailing slash
   212→    });
   213→
   214→    // AC: @multi-directory-daemon ac-8
   215→    it('should normalize path with dot segments', () => {
   216→      const pathWithDot = `${projectA}/.`;
   217→      const context = manager.registerProject(pathWithDot);
   218→
   219→      expect(context.path).toBe(projectA); // Dot removed
   220→    });
   221→
   222→    // AC: @multi-directory-daemon ac-8
   223→    it('should normalize path with multiple slashes', () => {
   224→      const pathWithSlashes = `${fixturesRoot}//project-a`;
   225→      const context = manager.registerProject(pathWithSlashes);
   226→
   227→      expect(context.path).toBe(projectA); // Double slash normalized
   228→    });
   229→
   230→    // AC: @multi-directory-daemon ac-8c
   231→    it('should NOT resolve symlinks during normalization', async () => {
   232→      // Create symlink to project-a
   233→      const symlinkPath = join(fixturesRoot, 'project-a-symlink');
   234→      await symlink(projectA, symlinkPath, 'dir');
   235→
   236→      // Register both real path and symlink
   237→      manager.registerProject(projectA);
   238→      manager.registerProject(symlinkPath);
   239→
   240→      // Should be treated as separate projects
   241→      expect(manager.listProjects()).toHaveLength(2);
   242→
   243→      const contextReal = manager.getProject(projectA);
   244→      const contextSymlink = manager.getProject(symlinkPath);
   245→
   246→      expect(contextReal.path).toBe(projectA);
   247→      expect(contextSymlink.path).toBe(symlinkPath);
   248→      expect(contextReal).not.toBe(contextSymlink);
   249→    });
   250→  });
   251→
   252→  describe('Default project handling', () => {
   253→    // AC: @multi-directory-daemon ac-2
   254→    it('should use default project when no path specified', () => {
   255→      manager.registerProject(projectA, true);
   256→
   257→      const context = manager.getProject();
   258→      expect(context.path).toBe(projectA);
   259→    });
   260→
   261→    // AC: @multi-directory-daemon ac-2
   262→    it('should set default project explicitly', () => {
   263→      manager.registerProject(projectA);
   264→      manager.setDefaultProject(projectA);
   265→
   266→      const context = manager.getProject();
   267→      expect(context.path).toBe(projectA);
   268→    });
   269→
   270→    // AC: @multi-directory-daemon ac-3
   271→    it('should error when no default project and no path provided', () => {
   272→      expect(() => {
   273→        manager.getProject();
   274→      }).toThrow('No default project configured. Specify X-Kspec-Dir header.');
   275→    });
   276→
   277→    // AC: @multi-directory-daemon ac-2
   278→    it('should allow default project from constructor', () => {
   279→      const managerWithDefault = new ProjectContextManager(projectA);
   280→      managerWithDefault.registerProject(projectA);
   281→
   282→      const context = managerWithDefault.getProject();
   283→      expect(context.path).toBe(projectA);
   284→    });
   285→
   286→    // AC: @multi-directory-daemon ac-2
   287→    it('should switch default project when requested', () => {
   288→      manager.registerProject(projectA);
   289→      manager.registerProject(projectB);
   290→      manager.setDefaultProject(projectA);
   291→
   292→      let context = manager.getProject();
   293→      expect(context.path).toBe(projectA);
   294→
   295→      manager.setDefaultProject(projectB);
   296→      context = manager.getProject();
   297→      expect(context.path).toBe(projectB);
   298→    });
   299→
   300→    // AC: @multi-directory-daemon ac-2
   301→    it('should error when setting unregistered project as default', () => {
   302→      expect(() => {
   303→        manager.setDefaultProject(projectA);
   304→      }).toThrow('Project must be registered before setting as default');
   305→    });
   306→  });
   307→
   308→  describe('Project unregistration', () => {
   309→    // AC: @multi-directory-daemon ac-20
   310→    it('should unregister project', () => {
   311→      manager.registerProject(projectA);
   312→      expect(manager.hasProject(projectA)).toBe(true);
   313→
   314→      manager.unregisterProject(projectA);
   315→      expect(manager.hasProject(projectA)).toBe(false);
   316→    });
   317→
   318→    // AC: @multi-directory-daemon ac-20
   319→    it('should clear default project when unregistering it', () => {
   320→      manager.registerProject(projectA, true);
   321→      expect(() => manager.getProject()).not.toThrow();
   322→
   323→      manager.unregisterProject(projectA);
   324→
   325→      expect(() => {
   326→        manager.getProject();
   327→      }).toThrow('No default project configured');
   328→    });
   329→
   330→    // AC: @multi-directory-daemon ac-20
   331→    it('should not affect other projects when unregistering', () => {
   332→      manager.registerProject(projectA);
   333→      manager.registerProject(projectB);
   334→
   335→      manager.unregisterProject(projectA);
   336→
   337→      expect(manager.hasProject(projectA)).toBe(false);
   338→      expect(manager.hasProject(projectB)).toBe(true);
   339→    });
   340→  });
   341→
   342→  describe('Deleted project detection', () => {
   343→    // AC: @multi-directory-daemon ac-20b
   344→    it('should error when default project .kspec/ is deleted', async () => {
   345→      manager.registerProject(projectA, true);
   346→
   347→      // Delete .kspec/ directory
   348→      const kspecDir = join(projectA, '.kspec');
   349→      await cleanupTempDir(kspecDir);
   350→
   351→      expect(() => {
   352→        manager.getProject();
   353→      }).toThrow('Default project no longer valid. Specify X-Kspec-Dir header.');
   354→    });
   355→
   356→    // AC: @multi-directory-daemon ac-2
   357→    it('should allow non-default project access even if default is deleted', async () => {
   358→      manager.registerProject(projectA, true);
   359→      manager.registerProject(projectB);
   360→
   361→      // Delete default project's .kspec/
   362→      const kspecDir = join(projectA, '.kspec');
   363→      await cleanupTempDir(kspecDir);
   364→
   365→      // Should error without path (default deleted)
   366→      expect(() => manager.getProject()).toThrow('Default project no longer valid');
   367→
   368→      // Should succeed with explicit path
   369→      const contextB = manager.getProject(projectB);
   370→      expect(contextB.path).toBe(projectB);
   371→    });
   372→  });
   373→
   374→  describe('Get project validation', () => {
   375→    // AC: @multi-directory-daemon ac-1
   376→    it('should return registered project by path', () => {
   377→      manager.registerProject(projectA);
   378→      const context = manager.getProject(projectA);
   379→
   380→      expect(context.path).toBe(projectA);
   381→    });
   382→
   383→    // AC: @multi-directory-daemon ac-1
   384→    it('should error when getting unregistered project', () => {
   385→      expect(() => {
   386→        manager.getProject(projectA);
   387→      }).toThrow('Project not registered');
   388→    });
   389→
   390→    // AC: @multi-directory-daemon ac-8
   391→    it('should normalize path when getting project', () => {
   392→      manager.registerProject(projectA);
   393→
   394→      // Get with trailing slash
   395→      const context = manager.getProject(`${projectA}/`);
   396→      expect(context.path).toBe(projectA);
   397→    });
   398→  });
   399→});
