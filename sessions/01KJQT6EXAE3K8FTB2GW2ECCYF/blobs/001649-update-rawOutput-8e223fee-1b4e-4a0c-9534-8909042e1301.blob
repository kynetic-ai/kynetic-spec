     1→/**
     2→ * Agent Dispatch Engine
     3→ *
     4→ * Core dispatch runtime for the daemon. Watches for task state changes via
     5→ * file watcher events and direct API event emission from CLI commands. Matches
     6→ * state changes against agent dispatch rules, queues invocations, manages
     7→ * concurrency, and handles deduplication of events from dual sources.
     8→ * Serializes shadow branch mutations when multiple agents run concurrently.
     9→ *
    10→ * AC: @agent-dispatch-engine ac-1 through ac-12
    11→ */
    12→
    13→import * as path from "node:path";
    14→import { spawnSync } from "node:child_process";
    15→import {
    16→  initContext,
    17→  loadAllTasks,
    18→  loadMetaContext,
    19→  type LoadedTask,
    20→  type LoadedAgent,
    21→} from "../parser/index.js";
    22→import { runInvocation } from "./invocation.js";
    23→import type { InvocationOptions } from "./invocation.js";
    24→import { getAdapter } from "../agents/adapters.js";
    25→import type { AgentDispatchRule } from "../schema/meta.js";
    26→import type { SessionTrigger } from "../sessions/types.js";
    27→
    28→// ─── Simple Mutex ─────────────────────────────────────────────────────────────
    29→
    30→/**
    31→ * A minimal promise-based mutex for serializing async operations.
    32→ * AC: @agent-dispatch-engine ac-12
    33→ */
    34→class Mutex {
    35→  private _queue: Array<() => void> = [];
    36→  private _locked = false;
    37→
    38→  async runExclusive<T>(fn: () => Promise<T>): Promise<T> {
    39→    await this._acquire();
    40→    try {
    41→      return await fn();
    42→    } finally {
    43→      this._release();
    44→    }
    45→  }
    46→
    47→  private _acquire(): Promise<void> {
    48→    if (!this._locked) {
    49→      this._locked = true;
    50→      return Promise.resolve();
    51→    }
    52→    return new Promise<void>((resolve) => {
    53→      this._queue.push(resolve);
    54→    });
    55→  }
    56→
    57→  private _release(): void {
    58→    const next = this._queue.shift();
    59→    if (next) {
    60→      next();
    61→    } else {
    62→      this._locked = false;
    63→    }
    64→  }
    65→}
    66→
    67→// ─── Types ────────────────────────────────────────────────────────────────────
    68→
    69→/**
    70→ * Task state as used for dispatch tracking.
    71→ */
    72→export type TaskStatus =
    73→  | "pending"
    74→  | "in_progress"
    75→  | "pending_review"
    76→  | "needs_work"
    77→  | "blocked"
    78→  | "completed"
    79→  | "cancelled";
    80→
    81→/**
    82→ * Mapping from dispatch event names to task statuses.
    83→ * AC: @agent-dispatch-engine ac-1
    84→ */
    85→const EVENT_TO_STATUS: Record<string, TaskStatus> = {
    86→  "task.ready": "pending",
    87→  "task.needs_work": "needs_work",
    88→  "task.pending_review": "pending_review",
    89→};
    90→
    91→const STATUS_TO_EVENT: Record<TaskStatus, string | undefined> = {
    92→  pending: "task.ready",
    93→  needs_work: "task.needs_work",
    94→  pending_review: "task.pending_review",
    95→  in_progress: undefined,
    96→  blocked: undefined,
    97→  completed: undefined,
    98→  cancelled: undefined,
    99→};
   100→
   101→/**
   102→ * A state change event for a single task.
   103→ */
   104→export interface TaskStateChange {
   105→  taskId: string;
   106→  taskRef: string;
   107→  fromStatus: TaskStatus;
   108→  toStatus: TaskStatus;
   109→  timestamp: number;
   110→  /** Optional task data used for filter evaluation (AC-6) */
   111→  task?: LoadedTask;
   112→}
   113→
   114→/**
   115→ * An entry in the dispatch queue.
   116→ */
   117→interface QueueEntry {
   118→  agent: LoadedAgent;
   119→  change: TaskStateChange;
   120→  retryCount: number;
   121→  nextRetryAt: number;
   122→}
   123→
   124→/**
   125→ * Deduplication key for recent state changes.
   126→ * AC: @agent-dispatch-engine ac-7
   127→ */
   128→type DedupKey = `${string}:${string}:${string}`;
   129→
   130→/**
   131→ * Options for creating a DispatchEngine.
   132→ */
   133→export interface DispatchEngineOptions {
   134→  /** Project root directory */
   135→  projectDir: string;
   136→  /**
   137→   * Spec directory (.kspec/ for shadow mode, or same as projectDir for traditional mode).
   138→   * Defaults to projectDir/.kspec if not specified.
   139→   */
   140→  specDir?: string;
   141→  /** Working directory for spawned agents */
   142→  cwd?: string;
   143→  /** Deduplication window in milliseconds (default 2000) */
   144→  dedupWindowMs?: number;
   145→  /** Path to kspec CLI binary (for task notes) */
   146→  kspecCliPath?: string;
   147→}
   148→
   149→// ─── DispatchEngine ───────────────────────────────────────────────────────────
   150→
   151→/**
   152→ * The core dispatch runtime.
   153→ *
   154→ * Lifecycle:
   155→ *   1. Create with new DispatchEngine(options)
   156→ *   2. Call start() to bootstrap and begin processing
   157→ *   3. Feed state changes via handleStateChange()
   158→ *   4. Call stop() for graceful shutdown
   159→ *
   160→ * AC: @agent-dispatch-engine ac-1 through ac-12
   161→ */
   162→export class DispatchEngine {
   163→  private projectDir: string;
   164→  private specDir: string;
   165→  private cwd: string;
   166→  private dedupWindowMs: number;
   167→  private kspecCliPath?: string;
   168→
   169→  /** Queue of pending dispatch entries, per agent id */
   170→  private queues: Map<string, QueueEntry[]> = new Map();
   171→  /** Count of active (running) invocations per agent id */
   172→  private activeCount: Map<string, number> = new Map();
   173→  /** Recent dedup keys with their expiry timestamps */
   174→  private recentEvents: Map<DedupKey, number> = new Map();
   175→  /** Previous task states (for file watcher diffing) */
   176→  private prevTaskStates: Map<string, TaskStatus> = new Map();
   177→  /** Mutex serializing shadow branch mutations */
   178→  private shadowMutex = new Mutex();
   179→  /** Whether the engine is currently running */
   180→  private running = false;
   181→  /** Set of running invocation promises (for graceful shutdown) */
   182→  private runningInvocations: Set<Promise<void>> = new Set();
   183→  /** AbortControllers for active invocations (for graceful cancel on stop) */
   184→  private invocationAbortControllers: Set<AbortController> = new Set();
   185→
   186→  constructor(options: DispatchEngineOptions) {
   187→    this.projectDir = options.projectDir;
   188→    this.specDir = options.specDir ?? path.join(options.projectDir, ".kspec");
   189→    this.cwd = options.cwd ?? options.projectDir;
   190→    this.dedupWindowMs = options.dedupWindowMs ?? 2000;
   191→    this.kspecCliPath = options.kspecCliPath;
   192→  }
   193→
   194→  // ─── Public API ─────────────────────────────────────────────────────────────
   195→
   196→  /**
   197→   * Start the dispatch engine.
   198→   *
   199→   * Loads current task states and evaluates dispatch rules for bootstrap.
   200→   * AC: @agent-dispatch-engine ac-8
   201→   */
   202→  async start(): Promise<void> {
   203→    this.running = true;
   204→
   205→    // AC: @agent-dispatch-engine ac-8 - Bootstrap: evaluate existing task states
   206→    await this._bootstrap();
   207→  }
   208→
   209→  /**
   210→   * Handle a task state change event from any source (file watcher or API).
   211→   *
   212→   * AC: @agent-dispatch-engine ac-1, ac-2, ac-4, ac-5, ac-6, ac-7
   213→   */
   214→  async handleStateChange(change: TaskStateChange): Promise<void> {
   215→    if (!this.running) return;
   216→
   217→    // AC: @agent-dispatch-engine ac-7 - Deduplication
   218→    if (this._isDuplicate(change)) {
   219→      return;
   220→    }
   221→    this._recordEvent(change);
   222→
   223→    // AC: @agent-dispatch-engine ac-1 - Match against dispatch rules
   224→    const agents = await this._loadAgents();
   225→    const eventType = STATUS_TO_EVENT[change.toStatus];
   226→    if (!eventType) return;
   227→
   228→    // Load task data for filter evaluation if not provided
   229→    let taskData = change.task;
   230→    if (!taskData && change.taskId) {
   231→      try {
   232→        const ctx = await initContext(this.projectDir);
   233→        const tasks = await loadAllTasks(ctx);
   234→        taskData = tasks.find((t) => t._ulid === change.taskId);
   235→      } catch {
   236→        // Can't load task, filter evaluation will be lenient
   237→      }
   238→    }
   239→
   240→    for (const agent of agents) {
   241→      for (const rule of (agent.dispatch ?? [])) {
   242→        if (rule.on !== eventType) continue;
   243→
   244→        // AC: @agent-dispatch-engine ac-6 - Apply filters
   245→        if (!this._matchesFilter(change, rule, taskData)) continue;
   246→
   247→        // AC: @agent-dispatch-engine ac-2 - Each matching agent queued independently
   248→        this._enqueue(agent, change);
   249→      }
   250→    }
   251→
   252→    // Drain queues after enqueuing
   253→    await this._drainQueues(agents);
   254→  }
   255→
   256→  /**
   257→   * Handle file watcher notification: diff previous vs current task states.
   258→   *
   259→   * AC: @agent-dispatch-engine ac-5
   260→   */
   261→  async handleFileChange(specDir: string): Promise<void> {
   262→    if (!this.running) return;
   263→
   264→    try {
   265→      const ctx = await initContext(this.projectDir);
   266→      const tasks = await loadAllTasks(ctx);
   267→
   268→      const changes: TaskStateChange[] = [];
   269→      const now = Date.now();
   270→
   271→      for (const task of tasks) {
   272→        const taskId = task._ulid;
   273→        const currentStatus = task.status as TaskStatus;
   274→        const prevStatus = this.prevTaskStates.get(taskId);
   275→
   276→        if (prevStatus !== undefined && prevStatus !== currentStatus) {
   277→          changes.push({
   278→            taskId,
   279→            taskRef: `@${taskId}`,
   280→            fromStatus: prevStatus,
   281→            toStatus: currentStatus,
   282→            timestamp: now,
   283→            task,
   284→          });
   285→        }
   286→
   287→        this.prevTaskStates.set(taskId, currentStatus);
   288→      }
   289→
   290→      // Emit change events for detected transitions
   291→      for (const change of changes) {
   292→        await this.handleStateChange(change);
   293→      }
   294→    } catch (err) {
   295→      console.error("[dispatch] Error processing file change:", err);
   296→    }
   297→  }
   298→
   299→  /**
   300→   * Stop the dispatch engine gracefully.
   301→   *
   302→   * Sends cancel signals to all active invocations and waits for them to finish.
   303→   * AC: @agent-dispatch-engine ac-11
   304→   */
   305→  async stop(): Promise<void> {
   306→    this.running = false;
   307→
   308→    // AC: @agent-dispatch-engine ac-11 - Send graceful cancel to all active invocations
   309→    for (const controller of this.invocationAbortControllers) {
   310→      controller.abort();
   311→    }
   312→
   313→    // Wait for all running invocations to complete (or abort)
   314→    if (this.runningInvocations.size > 0) {
   315→      await Promise.allSettled(Array.from(this.runningInvocations));
   316→    }
   317→
   318→    this.queues.clear();
   319→    this.activeCount.clear();
   320→    this.recentEvents.clear();
   321→    this.invocationAbortControllers.clear();
   322→  }
   323→
   324→  /**
   325→   * Get the shadow mutex for external callers that need to serialize mutations.
   326→   * AC: @agent-dispatch-engine ac-12
   327→   */
   328→  getShadowMutex(): Mutex {
   329→    return this.shadowMutex;
   330→  }
   331→
   332→  /**
   333→   * Returns current engine status info.
   334→   */
   335→  getStatus(): {
   336→    running: boolean;
   337→    activeInvocations: number;
   338→    queuedInvocations: number;
   339→  } {
   340→    let active = 0;
   341→    let queued = 0;
   342→    for (const count of this.activeCount.values()) active += count;
   343→    for (const entries of this.queues.values()) queued += entries.length;
   344→    return { running: this.running, activeInvocations: active, queuedInvocations: queued };
   345→  }
   346→
   347→  // ─── Private helpers ─────────────────────────────────────────────────────────
   348→
   349→  /**
   350→   * Bootstrap: evaluate all current tasks against dispatch rules.
   351→   * AC: @agent-dispatch-engine ac-8
   352→   */
   353→  private async _bootstrap(): Promise<void> {
   354→    try {
   355→      const ctx = await initContext(this.projectDir);
   356→      const tasks = await loadAllTasks(ctx);
   357→      const agents = await this._loadAgents();
   358→      const now = Date.now();
   359→
   360→      // Seed prevTaskStates so subsequent file watcher diffs work correctly
   361→      for (const task of tasks) {
   362→        this.prevTaskStates.set(task._ulid, task.status as TaskStatus);
   363→      }
   364→
   365→      // Evaluate each task against each agent's dispatch rules
   366→      for (const task of tasks) {
   367→        const currentStatus = task.status as TaskStatus;
   368→        const eventType = STATUS_TO_EVENT[currentStatus];
   369→        if (!eventType) continue;
   370→
   371→        for (const agent of agents) {
   372→          for (const rule of (agent.dispatch ?? [])) {
   373→            if (rule.on !== eventType) continue;
   374→
   375→            const change: TaskStateChange = {
   376→              taskId: task._ulid,
   377→              taskRef: `@${task._ulid}`,
   378→              fromStatus: currentStatus, // bootstrap: treated as "just entered"
   379→              toStatus: currentStatus,
   380→              timestamp: now,
   381→              task,
   382→            };
   383→
   384→            if (!this._matchesFilter(change, rule, task)) continue;
   385→
   386→            this._enqueue(agent, change);
   387→          }
   388→        }
   389→      }
   390→
   391→      await this._drainQueues(agents);
   392→    } catch (err) {
   393→      console.error("[dispatch] Bootstrap error:", err);
   394→    }
   395→  }
   396→
   397→  /**
   398→   * Load agent definitions from meta context.
   399→   */
   400→  private async _loadAgents(): Promise<LoadedAgent[]> {
   401→    try {
   402→      const ctx = await initContext(this.projectDir);
   403→      const meta = await loadMetaContext(ctx);
   404→      return meta.agents;
   405→    } catch {
   406→      return [];
   407→    }
   408→  }
   409→
   410→  /**
   411→   * Check if a state change matches a dispatch rule's filters.
   412→   * AC: @agent-dispatch-engine ac-6
   413→   */
   414→  private _matchesFilter(
   415→    change: TaskStateChange,
   416→    rule: AgentDispatchRule,
   417→    task?: LoadedTask,
   418→  ): boolean {
   419→    if (!rule.filter) return true;
   420→
   421→    // We need the task to evaluate filters — if not provided, reject to avoid
   422→    // enqueuing non-matching tasks (AC-6: all filters must match)
   423→    if (!task) return false;
   424→
   425→    const { filter } = rule;
   426→
   427→    // Automation filter
   428→    if (filter.automation !== undefined) {
   429→      if ((task as LoadedTask & { automation?: string }).automation !== filter.automation) {
   430→        return false;
   431→      }
   432→    }
   433→
   434→    // Tags filter
   435→    if (filter.tags && filter.tags.length > 0) {
   436→      const taskTags: string[] = (task as LoadedTask & { tags?: string[] }).tags ?? [];
   437→      if (!filter.tags.every((tag) => taskTags.includes(tag))) {
   438→        return false;
   439→      }
   440→    }
   441→
   442→    // Priority filter
   443→    if (filter.priority !== undefined) {
   444→      if ((task as LoadedTask & { priority?: number }).priority !== filter.priority) {
   445→        return false;
   446→      }
   447→    }
   448→
   449→    return true;
   450→  }
   451→
   452→  /**
   453→   * Build a deduplication key for a state change.
   454→   * AC: @agent-dispatch-engine ac-7
   455→   */
   456→  private _dedupKey(change: TaskStateChange): DedupKey {
   457→    return `${change.taskId}:${change.fromStatus}:${change.toStatus}`;
   458→  }
   459→
   460→  /**
   461→   * Check whether this event is a duplicate within the dedup window.
   462→   * AC: @agent-dispatch-engine ac-7
   463→   */
   464→  private _isDuplicate(change: TaskStateChange): boolean {
   465→    const key = this._dedupKey(change);
   466→    const expiry = this.recentEvents.get(key);
   467→    if (expiry === undefined) return false;
   468→    return change.timestamp < expiry;
   469→  }
   470→
   471→  /**
   472→   * Record a state change for deduplication.
   473→   * AC: @agent-dispatch-engine ac-7
   474→   */
   475→  private _recordEvent(change: TaskStateChange): void {
   476→    const key = this._dedupKey(change);
   477→    this.recentEvents.set(key, change.timestamp + this.dedupWindowMs);
   478→
   479→    // Prune expired entries periodically
   480→    if (this.recentEvents.size > 1000) {
   481→      const now = Date.now();
   482→      for (const [k, expiry] of this.recentEvents) {
   483→        if (expiry < now) this.recentEvents.delete(k);
   484→      }
   485→    }
   486→  }
   487→
   488→  /**
   489→   * Enqueue a dispatch entry for an agent.
   490→   * AC: @agent-dispatch-engine ac-3
   491→   */
   492→  private _enqueue(agent: LoadedAgent, change: TaskStateChange): void {
   493→    const queue = this.queues.get(agent.id) ?? [];
   494→    queue.push({ agent, change, retryCount: 0, nextRetryAt: 0 });
   495→    this.queues.set(agent.id, queue);
   496→  }
   497→
   498→  /**
   499→   * Drain queues, spawning invocations up to each agent's max_concurrent limit.
   500→   * AC: @agent-dispatch-engine ac-3
   501→   */
   502→  private async _drainQueues(agents: LoadedAgent[]): Promise<void> {
   503→    for (const agent of agents) {
   504→      const maxConcurrent = agent.concurrency?.max_concurrent ?? 1;
   505→      const active = this.activeCount.get(agent.id) ?? 0;
   506→      const queue = this.queues.get(agent.id) ?? [];
   507→
   508→      let slots = maxConcurrent - active;
   509→      while (slots > 0 && queue.length > 0) {
   510→        const entry = queue.shift()!;
   511→        if (entry.nextRetryAt > Date.now()) {
   512→          // Not ready for retry yet; put back at front
   513→          queue.unshift(entry);
   514→          break;
   515→        }
   516→        this._spawnInvocation(agent, entry);
   517→        slots--;
   518→      }
   519→
   520→      this.queues.set(agent.id, queue);
   521→    }
   522→  }
   523→
   524→  /**
   525→   * Spawn a single invocation for a queue entry.
   526→   * AC: @agent-dispatch-engine ac-9, ac-10, ac-11, ac-12
   527→   */
   528→  private _spawnInvocation(agent: LoadedAgent, entry: QueueEntry): void {
   529→    const agentId = agent.id;
   530→
   531→    // Increment active count
   532→    this.activeCount.set(agentId, (this.activeCount.get(agentId) ?? 0) + 1);
   533→
   534→    // AC: @agent-dispatch-engine ac-10 - Check adapter resolvability before spawn
   535→    const adapterId = agent.adapter ?? "claude-agent-acp";
   536→    const adapter = getAdapter(adapterId);
   537→    if (!adapter) {
   538→      console.error(
   539→        `[dispatch] Cannot resolve adapter "${adapterId}" for agent "${agentId}". Skipping invocation.`,
   540→      );
   541→      // Decrement active count since we're not actually running
   542→      const currentActive = this.activeCount.get(agentId) ?? 1;
   543→      this.activeCount.set(agentId, Math.max(0, currentActive - 1));
   544→      // AC: @agent-dispatch-engine ac-10 - Add task note for unresolvable adapter
   545→      if (this.kspecCliPath) {
   546→        spawnSync(process.execPath, [
   547→          this.kspecCliPath,
   548→          "task", "note", entry.change.taskRef,
   549→          `[AGENT-SKIP] Cannot resolve adapter "${adapterId}" for agent "${agentId}". Invocation skipped.`,
   550→        ], { cwd: this.cwd });
   551→      }
   552→      return;
   553→    }
   554→
   555→    // AC: @agent-dispatch-engine ac-11 - Create abort controller for graceful cancellation
   556→    const abortController = new AbortController();
   557→    this.invocationAbortControllers.add(abortController);
   558→
   559→    const options: InvocationOptions = {
   560→      agent,
   561→      specDir: this.specDir,
   562→      cwd: this.cwd,
   563→      taskRef: entry.change.taskRef,
   564→      prompt: agent.prompt_template ?? `Work on task ${entry.change.taskRef}`,
   565→      trigger: (STATUS_TO_EVENT[entry.change.toStatus] ?? "task.ready") as SessionTrigger,
   566→      kspecCliPath: this.kspecCliPath,
   567→      abortSignal: abortController.signal,
   568→    };
   569→
   570→    // AC: @agent-dispatch-engine ac-12 - Wrap invocation in shadow mutex
   571→    const invocationPromise = this.shadowMutex
   572→      .runExclusive(async () => {
   573→        // AC: @agent-dispatch-engine ac-9 - Retry on transient errors
   574→        try {
   575→          await runInvocation(options);
   576→          // Reset retry count on success
   577→          entry.retryCount = 0;
   578→        } catch (err) {
   579→          const retryLimit = agent.budget?.max_tasks ?? 3;
   580→          if (entry.retryCount < retryLimit) {
   581→            entry.retryCount++;
   582→            const backoffMs = Math.min(
   583→              1000 * Math.pow(2, entry.retryCount - 1),
   584→              30_000,
   585→            );
   586→            entry.nextRetryAt = Date.now() + backoffMs;
   587→            console.warn(
   588→              `[dispatch] Invocation for agent "${agentId}" failed (attempt ${entry.retryCount}/${retryLimit}), retrying in ${backoffMs}ms`,
   589→              err,
   590→            );
   591→            // Re-enqueue at front for retry
   592→            const queue = this.queues.get(agentId) ?? [];
   593→            queue.unshift(entry);
   594→            this.queues.set(agentId, queue);
   595→            // AC: @agent-dispatch-engine ac-9 - Schedule wake-up to drain retry
   596→            setTimeout(() => {
   597→              if (this.running) {
   598→                this._loadAgents()
   599→                  .then((agents) => this._drainQueues(agents))
   600→                  .catch(() => {/* best effort */});
   601→              }
   602→            }, backoffMs);
   603→          } else {
   604→            console.error(
   605→              `[dispatch] Agent "${agentId}" exceeded retry limit. Dropping invocation.`,
   606→              err,
   607→            );
   608→          }
   609→        }
   610→      })
   611→      .then(async () => {
   612→        // Decrement active count and drain again
   613→        const currentActive = this.activeCount.get(agentId) ?? 1;
   614→        this.activeCount.set(agentId, Math.max(0, currentActive - 1));
   615→
   616→        // Try to drain more items
   617→        try {
   618→          const agents = await this._loadAgents();
   619→          await this._drainQueues(agents);
   620→        } catch {
   621→          // Best effort
   622→        }
   623→      })
   624→      .finally(() => {
   625→        this.runningInvocations.delete(invocationPromise);
   626→        this.invocationAbortControllers.delete(abortController);
   627→      });
   628→
