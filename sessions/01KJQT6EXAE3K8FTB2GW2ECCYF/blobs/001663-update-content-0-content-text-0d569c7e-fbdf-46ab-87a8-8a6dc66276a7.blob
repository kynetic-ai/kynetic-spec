   422→// ─── AC-7: Event deduplication ───────────────────────────────────────────────
   423→
   424→// AC: @agent-dispatch-engine ac-7
   425→describe("AC-7: Event deduplication within time window", () => {
   426→  let testDir: string;
   427→
   428→  beforeEach(async () => {
   429→    testDir = await createTempDir("kspec-dispatch-ac7-");
   430→  });
   431→
   432→  afterEach(async () => {
   433→    await cleanupTempDir(testDir);
   434→  });
   435→
   436→  it("should deduplicate identical state changes within dedup window", async () => {
   437→    const agent = makeTestAgent({ dispatch: [{ on: "task.ready" }] });
   438→    await setupProjectWithAgents(testDir, [agent]);
   439→
   440→    const engine = new DispatchEngine({
   441→      projectDir: testDir,
   442→      specDir: testDir,
   443→      dedupWindowMs: 5000,
   444→      kspecCliPath: MOCK_KSPEC_CLI,
   445→    });
   446→
   447→    // Spy before start to capture all enqueue calls
   448→    let enqueueCount = 0;
   449→    vi.spyOn(engine as unknown as { _enqueue: (a: unknown, c: unknown) => void }, "_enqueue").mockImplementation(() => {
   450→      enqueueCount++;
   451→    });
   452→
   453→    await engine.start();
   454→    // Reset after bootstrap
   455→    enqueueCount = 0;
   456→
   457→    const now = Date.now();
   458→    const taskId = testUlid("TASK");
   459→    const change: TaskStateChange = {
   460→      taskId,
   461→      taskRef: `@${taskId}`,
   462→      fromStatus: "in_progress",
   463→      toStatus: "pending",
   464→      timestamp: now,
   465→    };
   466→
   467→    // First event — should be dispatched
   468→    await engine.handleStateChange(change);
   469→    expect(enqueueCount).toBe(1);
   470→
   471→    // Duplicate within window — should be suppressed
   472→    await engine.handleStateChange({ ...change, timestamp: now + 100 });
   473→    expect(enqueueCount).toBe(1);
   474→
   475→    await engine.stop();
   476→  });
   477→
   478→  it("should not deduplicate events outside the dedup window", async () => {
   479→    const agent = makeTestAgent({ dispatch: [{ on: "task.ready" }] });
   480→    await setupProjectWithAgents(testDir, [agent]);
   481→
   482→    const engine = new DispatchEngine({
   483→      projectDir: testDir,
   484→      specDir: testDir,
   485→      dedupWindowMs: 100, // Very short window
   486→      kspecCliPath: MOCK_KSPEC_CLI,
   487→    });
   488→
   489→    // Spy before start
   490→    let enqueueCount = 0;
   491→    vi.spyOn(engine as unknown as { _enqueue: (a: unknown, c: unknown) => void }, "_enqueue").mockImplementation(() => {
   492→      enqueueCount++;
   493→    });
   494→
   495→    await engine.start();
   496→    // Reset after bootstrap
   497→    enqueueCount = 0;
   498→
   499→    const taskId = testUlid("TASK");
   500→    const now = Date.now();
   501→    const change: TaskStateChange = {
   502→      taskId,
   503→      taskRef: `@${taskId}`,
   504→      fromStatus: "in_progress",
   505→      toStatus: "pending",
   506→      timestamp: now,
   507→    };
   508→
   509→    await engine.handleStateChange(change);
   510→    expect(enqueueCount).toBe(1);
   511→
   512→    // After window expired — should be dispatched again
   513→    await engine.handleStateChange({ ...change, timestamp: now + 200 });
   514→    expect(enqueueCount).toBe(2);
   515→
   516→    await engine.stop();
   517→  });
   518→});
   519→
   520→// ─── AC-8: Bootstrap on start ────────────────────────────────────────────────
