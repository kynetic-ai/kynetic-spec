   272→// ─── AC-5: File watcher diffs task states ────────────────────────────────────
   273→
   274→// AC: @agent-dispatch-engine ac-5
   275→describe("AC-5: File watcher diffs task states", () => {
   276→  let testDir: string;
   277→
   278→  beforeEach(async () => {
   279→    testDir = await createTempDir("kspec-dispatch-ac5-");
   280→  });
   281→
   282→  afterEach(async () => {
   283→    await cleanupTempDir(testDir);
   284→  });
   285→
   286→  it("should detect task status transitions from file changes", async () => {
   287→    const agent = makeTestAgent({ dispatch: [{ on: "task.ready" }] });
   288→    await setupProjectWithAgents(testDir, [agent]);
   289→
   290→    const taskId = testUlid("TASK");
   291→    // Start with in_progress
   292→    await writeTasks(testDir, [{ _ulid: taskId, status: "in_progress" }]);
   293→
   294→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   295→    await engine.start();
   296→
   297→    // Update task to pending (task.ready event)
   298→    await writeTasks(testDir, [{ _ulid: taskId, status: "pending" }]);
   299→
   300→    // Trigger file change notification
   301→    const detectedChanges: TaskStateChange[] = [];
   302→    const originalHandleStateChange = engine.handleStateChange.bind(engine);
   303→    // Spy on handleStateChange to track changes
   304→    const handleSpy = vi.spyOn(engine, "handleStateChange").mockImplementation(async (change) => {
   305→      detectedChanges.push(change);
   306→    });
   307→
   308→    await engine.handleFileChange(testDir);
   309→
   310→    expect(detectedChanges).toHaveLength(1);
   311→    expect(detectedChanges[0].taskId).toBe(taskId);
   312→    expect(detectedChanges[0].fromStatus).toBe("in_progress");
   313→    expect(detectedChanges[0].toStatus).toBe("pending");
   314→
   315→    handleSpy.mockRestore();
   316→    await engine.stop();
   317→  });
   318→
   319→  it("should not emit change events when task status is unchanged", async () => {
   320→    const agent = makeTestAgent({ dispatch: [{ on: "task.ready" }] });
   321→    await setupProjectWithAgents(testDir, [agent]);
   322→
   323→    const taskId = testUlid("TASK");
   324→    await writeTasks(testDir, [{ _ulid: taskId, status: "in_progress" }]);
   325→
   326→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   327→    await engine.start();
   328→
   329→    // Same status again — no change
   330→    const detectedChanges: TaskStateChange[] = [];
   331→    vi.spyOn(engine, "handleStateChange").mockImplementation(async (change) => {
   332→      detectedChanges.push(change);
   333→    });
   334→
   335→    await engine.handleFileChange(testDir);
   336→
   337→    expect(detectedChanges).toHaveLength(0);
   338→
   339→    await engine.stop();
   340→  });
   341→});
