   663→// ─── AC-11: Graceful shutdown ─────────────────────────────────────────────────
   664→
   665→// AC: @agent-dispatch-engine ac-11
   666→describe("AC-11: Graceful shutdown waits for active invocations", () => {
   667→  let testDir: string;
   668→
   669→  beforeEach(async () => {
   670→    testDir = await createTempDir("kspec-dispatch-ac11-");
   671→  });
   672→
   673→  afterEach(async () => {
   674→    await cleanupTempDir(testDir);
   675→  });
   676→
   677→  it("should stop accepting new events after stop() is called", async () => {
   678→    const agent = makeTestAgent({ dispatch: [{ on: "task.ready" }] });
   679→    await setupProjectWithAgents(testDir, [agent]);
   680→
   681→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   682→    await engine.start();
   683→
   684→    expect(engine.getStatus().running).toBe(true);
   685→
   686→    await engine.stop();
   687→
   688→    expect(engine.getStatus().running).toBe(false);
   689→
   690→    // Triggering changes after stop should be no-ops
   691→    let enqueueCount = 0;
   692→    vi.spyOn(engine as unknown as { _enqueue: (a: unknown, c: unknown) => void }, "_enqueue").mockImplementation(() => {
   693→      enqueueCount++;
   694→    });
   695→
   696→    const change = makeStateChange({ toStatus: "pending" });
   697→    await engine.handleStateChange(change);
   698→    expect(enqueueCount).toBe(0);
   699→  });
   700→
   701→  it("should resolve stop() only after running invocations complete", async () => {
   702→    const agent = makeTestAgent({ dispatch: [{ on: "task.ready" }] });
   703→    await setupProjectWithAgents(testDir, [agent]);
   704→
   705→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   706→    await engine.start();
   707→
   708→    // Inject a fake long-running invocation
   709→    let invocationResolved = false;
   710→    const invocationPromise = new Promise<void>((resolve) => {
   711→      setTimeout(() => {
   712→        invocationResolved = true;
   713→        resolve();
   714→      }, 50);
   715→    });
   716→    (engine as unknown as { runningInvocations: Set<Promise<void>> }).runningInvocations.add(invocationPromise);
   717→
   718→    const stopStarted = Date.now();
   719→    await engine.stop();
   720→    const stopDuration = Date.now() - stopStarted;
   721→
   722→    // stop() should have waited for the invocation
   723→    expect(invocationResolved).toBe(true);
   724→    expect(stopDuration).toBeGreaterThanOrEqual(40);
   725→  });
   726→
   727→  it("should abort active invocations via abort controllers on stop()", async () => {
   728→    const agent = makeTestAgent({ dispatch: [{ on: "task.ready" }] });
   729→    await setupProjectWithAgents(testDir, [agent]);
   730→
   731→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   732→    await engine.start();
   733→
   734→    // Inject a fake abort controller to verify it gets aborted
   735→    const fakeController = new AbortController();
   736→    let aborted = false;
   737→    fakeController.signal.addEventListener("abort", () => { aborted = true; });
   738→    (engine as unknown as { invocationAbortControllers: Set<AbortController> }).invocationAbortControllers.add(fakeController);
   739→
   740→    await engine.stop();
   741→
   742→    // Abort controller should have been signalled
   743→    expect(aborted).toBe(true);
   744→  });
   745→});
   746→
   747→// ─── AC-12: Shadow branch serialization ──────────────────────────────────────
   748→
   749→// AC: @agent-dispatch-engine ac-12
   750→describe("AC-12: Shadow branch mutations serialized via mutex", () => {
   751→  let testDir: string;
   752→
   753→  beforeEach(async () => {
   754→    testDir = await createTempDir("kspec-dispatch-ac12-");
   755→  });
   756→
   757→  afterEach(async () => {
   758→    await cleanupTempDir(testDir);
   759→  });
   760→
   761→  it("should provide a shadow mutex for exclusive access to shadow branch", async () => {
   762→    const agent = makeTestAgent();
   763→    await setupProjectWithAgents(testDir, [agent]);
   764→
   765→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   766→    await engine.start();
   767→
   768→    const mutex = engine.getShadowMutex();
   769→    expect(mutex).toBeDefined();
   770→    expect(typeof mutex.runExclusive).toBe("function");
   771→
   772→    await engine.stop();
   773→  });
   774→
   775→  it("should serialize concurrent operations through the mutex", async () => {
   776→    const agent = makeTestAgent();
   777→    await setupProjectWithAgents(testDir, [agent]);
   778→
   779→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   780→    await engine.start();
   781→
   782→    const mutex = engine.getShadowMutex();
   783→    const results: number[] = [];
   784→
   785→    // Run two concurrent operations through the mutex
   786→    await Promise.all([
   787→      mutex.runExclusive(async () => {
   788→        results.push(1);
   789→        await new Promise((r) => setTimeout(r, 10));
   790→        results.push(2);
   791→      }),
   792→      mutex.runExclusive(async () => {
   793→        results.push(3);
   794→        await new Promise((r) => setTimeout(r, 10));
   795→        results.push(4);
   796→      }),
   797→    ]);
   798→
   799→    // Operations should be serialized: [1, 2, 3, 4] or [3, 4, 1, 2]
   800→    expect(results).toHaveLength(4);
   801→    // Verify the pairs are not interleaved
   802→    const firstPair = results.slice(0, 2);
   803→    const secondPair = results.slice(2, 4);
   804→    const validOrdering =
   805→      (firstPair[0] === 1 && firstPair[1] === 2 && secondPair[0] === 3 && secondPair[1] === 4) ||
   806→      (firstPair[0] === 3 && firstPair[1] === 4 && secondPair[0] === 1 && secondPair[1] === 2);
   807→    expect(validOrdering).toBe(true);
   808→
   809→    await engine.stop();
   810→  });
   811→});
