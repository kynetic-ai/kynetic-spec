   241→// ─── AC-3: Concurrency limit queues invocations FIFO ─────────────────────────
   242→
   243→// AC: @agent-dispatch-engine ac-3
   244→describe("AC-3: max_concurrent limit enforced", () => {
   245→  let testDir: string;
   246→
   247→  beforeEach(async () => {
