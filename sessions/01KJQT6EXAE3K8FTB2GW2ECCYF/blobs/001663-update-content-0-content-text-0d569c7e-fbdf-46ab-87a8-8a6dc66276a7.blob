     1→/**
     2→ * Agent Dispatch Engine tests.
     3→ *
     4→ * Tests for core dispatch runtime: state change matching, queuing, deduplication,
     5→ * concurrency limits, filter evaluation, bootstrap, and graceful shutdown.
     6→ *
     7→ * Task: @implement-agent-dispatch-engine
     8→ * Spec: @agent-dispatch-engine
     9→ */
    10→
    11→import { describe, it, expect, beforeEach, afterEach, vi } from "vitest";
    12→import * as path from "node:path";
    13→import * as fs from "node:fs/promises";
    14→import * as fsSync from "node:fs";
    15→import * as YAML from "yaml";
    16→import {
    17→  DispatchEngine,
    18→  type TaskStateChange,
    19→  type DispatchEngineOptions,
    20→} from "../src/agent-runtime/dispatch.js";
    21→import {
    22→  createTempDir,
    23→  cleanupTempDir,
    24→  testUlid,
    25→  initGitRepo,
    26→} from "./helpers/cli.js";
    27→import type { Agent } from "../src/schema/meta.js";
    28→
    29→// ─── Fixtures ────────────────────────────────────────────────────────────────
    30→
    31→const MOCK_KSPEC_CLI = path.join(__dirname, "mocks", "kspec-capture-mock.cjs");
    32→
    33→/**
    34→ * Create a minimal Agent definition for testing.
    35→ */
    36→function makeTestAgent(overrides: Partial<Agent> = {}): Agent {
    37→  return {
    38→    _ulid: testUlid("AGNT"),
    39→    id: "test-worker",
    40→    name: "Test Worker Agent",
    41→    capabilities: [],
    42→    tools: [],
    43→    conventions: [],
    44→    dispatch: [{ on: "task.ready" }],
    45→    skills: [],
    46→    auto_approve: false,
    47→    concurrency: { max_concurrent: 1 },
    48→    adapter: "mock-acp",
    49→    ...overrides,
    50→  };
    51→}
    52→
    53→/**
    54→ * Set up a minimal kspec project directory with meta containing agents.
    55→ *
    56→ * Uses traditional (non-shadow) layout: manifest and meta in the specDir directly.
    57→ * Sets KSPEC_SPEC_DIR to point to the spec directory so initContext can find it.
    58→ */
    59→async function setupProjectWithAgents(
    60→  dir: string,
    61→  agents: Agent[],
    62→): Promise<void> {
    63→  initGitRepo(dir);
    64→
    65→  // Use traditional layout: manifest in the dir root itself
    66→  // Write manifest
    67→  await fs.writeFile(
    68→    path.join(dir, "kynetic.yaml"),
    69→    YAML.stringify({ kynetic: "1", title: "Test Project" }),
    70→    "utf-8",
    71→  );
    72→
    73→  // Write meta with agents
    74→  await fs.writeFile(
    75→    path.join(dir, "kynetic.meta.yaml"),
    76→    YAML.stringify({
    77→      kynetic_meta: "1.0",
    78→      agents: agents.map((a) => ({
    79→        _ulid: a._ulid,
    80→        id: a.id,
    81→        name: a.name,
    82→        dispatch: a.dispatch ?? [],
    83→        concurrency: a.concurrency,
    84→        adapter: a.adapter,
    85→        budget: a.budget,
    86→        auto_approve: a.auto_approve ?? false,
    87→      })),
    88→    }),
    89→    "utf-8",
    90→  );
    91→
    92→  // Write empty tasks file
    93→  await fs.writeFile(
    94→    path.join(dir, "project.tasks.yaml"),
    95→    YAML.stringify({ tasks: [] }),
    96→    "utf-8",
    97→  );
    98→}
    99→
   100→/**
   101→ * Write tasks to the project tasks file.
   102→ */
   103→async function writeTasks(dir: string, tasks: Array<{
   104→  _ulid: string;
   105→  status: string;
   106→  automation?: string;
   107→  tags?: string[];
   108→  priority?: number;
   109→}>): Promise<void> {
   110→  await fs.writeFile(
   111→    path.join(dir, "project.tasks.yaml"),
   112→    YAML.stringify({
   113→      tasks: tasks.map((t) => ({
   114→        _ulid: t._ulid,
   115→        type: "task",
   116→        title: `Task ${t._ulid}`,
   117→        status: t.status,
   118→        automation: t.automation,
   119→        tags: t.tags ?? [],
   120→        priority: t.priority,
   121→        created_at: new Date().toISOString(),
   122→        notes: [],
   123→        todos: [],
   124→      })),
   125→    }),
   126→    "utf-8",
   127→  );
   128→}
   129→
   130→/**
   131→ * Create a TaskStateChange for testing.
   132→ */
   133→function makeStateChange(overrides: Partial<TaskStateChange> = {}): TaskStateChange {
   134→  return {
   135→    taskId: testUlid("TASK"),
   136→    taskRef: `@${testUlid("TASK")}`,
   137→    fromStatus: "in_progress",
   138→    toStatus: "pending",
   139→    timestamp: Date.now(),
   140→    ...overrides,
   141→  };
   142→}
   143→
   144→// ─── AC-1: Matching agents queued for dispatch ────────────────────────────────
   145→
   146→// AC: @agent-dispatch-engine ac-1
   147→describe("AC-1: Task state change queues matching agents", () => {
   148→  let testDir: string;
   149→
   150→  beforeEach(async () => {
   151→    testDir = await createTempDir("kspec-dispatch-ac1-");
   152→  });
   153→
   154→  afterEach(async () => {
   155→    await cleanupTempDir(testDir);
   156→  });
   157→
   158→  it("should queue dispatch when state change matches agent dispatch rule", async () => {
   159→    const agent = makeTestAgent({ dispatch: [{ on: "task.ready" }] });
   160→    await setupProjectWithAgents(testDir, [agent]);
   161→
   162→    const engine = new DispatchEngine({
   163→      projectDir: testDir,
   164→      specDir: testDir,
   165→      kspecCliPath: MOCK_KSPEC_CLI,
   166→    });
   167→
   168→    // Spy on _enqueue before start so all enqueue calls are captured
   169→    let enqueueCount = 0;
   170→    vi.spyOn(engine as unknown as { _enqueue: (a: unknown, c: unknown) => void }, "_enqueue").mockImplementation(() => {
   171→      enqueueCount++;
   172→    });
   173→
   174→    await engine.start();
   175→
   176→    // Trigger state change: task transitions to pending (task.ready)
   177→    const taskId = testUlid("TASK");
   178→    const change: TaskStateChange = {
   179→      taskId,
   180→      taskRef: `@${taskId}`,
   181→      fromStatus: "in_progress",
   182→      toStatus: "pending",
   183→      timestamp: Date.now(),
   184→    };
   185→    await engine.handleStateChange(change);
   186→
   187→    // Agent should have been enqueued
   188→    expect(enqueueCount).toBeGreaterThanOrEqual(1);
   189→
   190→    await engine.stop();
   191→  });
   192→});
   193→
   194→// ─── AC-2: Multiple matching agents queued independently ─────────────────────
   195→
   196→// AC: @agent-dispatch-engine ac-2
   197→describe("AC-2: Multiple matching agents queued independently", () => {
   198→  let testDir: string;
   199→
   200→  beforeEach(async () => {
   201→    testDir = await createTempDir("kspec-dispatch-ac2-");
   202→  });
   203→
   204→  afterEach(async () => {
   205→    await cleanupTempDir(testDir);
   206→  });
   207→
   208→  it("should queue each matching agent separately for the same state change", async () => {
   209→    const agent1 = makeTestAgent({ id: "worker-1", dispatch: [{ on: "task.ready" }] });
   210→    const agent2 = makeTestAgent({
   211→      _ulid: testUlid("AGNT", 2),
   212→      id: "worker-2",
   213→      dispatch: [{ on: "task.ready" }],
   214→    });
   215→    await setupProjectWithAgents(testDir, [agent1, agent2]);
   216→
   217→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   218→
   219→    // Track enqueue calls per agent
   220→    const enqueuedAgentIds: string[] = [];
   221→    vi.spyOn(engine as unknown as { _enqueue: (a: unknown, c: unknown) => void }, "_enqueue").mockImplementation((agent: unknown) => {
   222→      enqueuedAgentIds.push((agent as { id: string }).id);
   223→    });
   224→
   225→    await engine.start();
   226→    // Reset after bootstrap
   227→    enqueuedAgentIds.length = 0;
   228→
   229→    const change = makeStateChange({ toStatus: "pending", fromStatus: "in_progress" });
   230→    await engine.handleStateChange(change);
   231→
   232→    // Both agents should be enqueued independently
   233→    expect(enqueuedAgentIds).toContain("worker-1");
   234→    expect(enqueuedAgentIds).toContain("worker-2");
   235→    expect(enqueuedAgentIds).toHaveLength(2);
   236→
   237→    await engine.stop();
   238→  });
   239→});
