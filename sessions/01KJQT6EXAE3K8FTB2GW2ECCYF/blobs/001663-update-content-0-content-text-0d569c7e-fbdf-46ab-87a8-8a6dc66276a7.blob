   588→// ─── AC-10: Unresolvable adapter ─────────────────────────────────────────────
   589→
   590→// AC: @agent-dispatch-engine ac-10
   591→describe("AC-10: Unresolvable adapter skips invocation with error log", () => {
   592→  let testDir: string;
   593→
   594→  beforeEach(async () => {
   595→    testDir = await createTempDir("kspec-dispatch-ac10-");
   596→  });
   597→
   598→  afterEach(async () => {
   599→    await cleanupTempDir(testDir);
   600→  });
   601→
   602→  it("should log error and skip invocation when adapter cannot be resolved", async () => {
   603→    const agentBadAdapter = makeTestAgent({
   604→      id: "bad-adapter-agent",
   605→      adapter: "nonexistent-adapter-xyz",
   606→      dispatch: [{ on: "task.ready" }],
   607→    });
   608→    await setupProjectWithAgents(testDir, [agentBadAdapter]);
   609→
   610→    const errorSpy = vi.spyOn(console, "error").mockImplementation(() => {});
