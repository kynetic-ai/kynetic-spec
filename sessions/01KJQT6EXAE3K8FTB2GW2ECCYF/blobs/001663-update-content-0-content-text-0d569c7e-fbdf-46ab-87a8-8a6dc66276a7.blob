   343→// ─── AC-6: Filter evaluation ─────────────────────────────────────────────────
   344→
   345→// AC: @agent-dispatch-engine ac-6
   346→describe("AC-6: Dispatch rule filters applied", () => {
   347→  let testDir: string;
   348→
   349→  beforeEach(async () => {
   350→    testDir = await createTempDir("kspec-dispatch-ac6-");
   351→  });
   352→
   353→  afterEach(async () => {
   354→    await cleanupTempDir(testDir);
   355→  });
   356→
   357→  it("should only queue agent when automation filter matches", async () => {
   358→    const agentEligibleOnly = makeTestAgent({
   359→      id: "eligible-worker",
   360→      dispatch: [{ on: "task.ready", filter: { automation: "eligible" } }],
   361→    });
   362→    await setupProjectWithAgents(testDir, [agentEligibleOnly]);
   363→
   364→    const taskId = testUlid("TASK");
   365→    await writeTasks(testDir, [
   366→      { _ulid: taskId, status: "in_progress", automation: "ineligible" },
   367→    ]);
   368→
   369→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   370→    await engine.start();
   371→
   372→    // Transition to pending — should NOT be queued (automation: ineligible)
   373→    await writeTasks(testDir, [
   374→      { _ulid: taskId, status: "pending", automation: "ineligible" },
   375→    ]);
   376→
   377→    let dispatchedCount = 0;
   378→    const originalEnqueue = (engine as unknown as { _enqueue: (a: unknown, c: unknown) => void })._enqueue;
   379→    vi.spyOn(engine as unknown as { _enqueue: (a: unknown, c: unknown) => void }, "_enqueue").mockImplementation(() => {
   380→      dispatchedCount++;
   381→    });
   382→
   383→    await engine.handleFileChange(testDir);
   384→
   385→    expect(dispatchedCount).toBe(0);
   386→
   387→    await engine.stop();
   388→  });
   389→
   390→  it("should queue agent when all filters match", async () => {
   391→    const agentTagged = makeTestAgent({
   392→      id: "tagged-worker",
   393→      dispatch: [{ on: "task.ready", filter: { automation: "eligible", tags: ["mvp"] } }],
   394→    });
   395→    await setupProjectWithAgents(testDir, [agentTagged]);
   396→
   397→    const taskId = testUlid("TASK");
   398→    await writeTasks(testDir, [
   399→      { _ulid: taskId, status: "in_progress", automation: "eligible", tags: ["mvp"] },
   400→    ]);
   401→
   402→    const engine = new DispatchEngine({ projectDir: testDir, specDir: testDir, kspecCliPath: MOCK_KSPEC_CLI });
   403→    await engine.start();
   404→
   405→    await writeTasks(testDir, [
   406→      { _ulid: taskId, status: "pending", automation: "eligible", tags: ["mvp"] },
   407→    ]);
   408→
   409→    let dispatchedCount = 0;
   410→    vi.spyOn(engine as unknown as { _enqueue: (a: unknown, c: unknown) => void }, "_enqueue").mockImplementation(() => {
   411→      dispatchedCount++;
   412→    });
   413→
   414→    await engine.handleFileChange(testDir);
   415→
   416→    expect(dispatchedCount).toBe(1);
   417→
   418→    await engine.stop();
   419→  });
   420→});
