     1→/**
     2→ * Session event storage.
     3→ *
     4→ * JSONL-based event storage for agent sessions with:
     5→ * - Atomic appends for crash safety (AC-3)
     6→ * - Auto-assigned timestamps and sequence numbers (AC-2)
     7→ * - Session metadata management
     8→ *
     9→ * Storage structure:
    10→ *   .kspec/sessions/{session-id}/
    11→ *     session.yaml      # Metadata
    12→ *     events.jsonl      # Append-only event log
    13→ */
    14→
    15→import * as fs from "node:fs";
    16→import * as fsPromises from "node:fs/promises";
    17→import * as path from "node:path";
    18→import { createHash, randomUUID } from "node:crypto";
    19→import { parse as parseTOML, stringify as stringifyTOML } from "smol-toml";
    20→import * as YAML from "yaml";
    21→import { shadowAutoCommit } from "../parser/shadow.js";
    22→import {
    23→  type SessionEvent,
    24→  type SessionEventInput,
    25→  SessionEventSchema,
    26→  type SessionMetadata,
    27→  type SessionMetadataInput,
    28→  SessionMetadataSchema,
    29→  type SessionStatus,
    30→  type TaskBudget,
    31→  TaskBudgetSchema,
    32→} from "./types.js";
    33→
    34→// ─── Constants ───────────────────────────────────────────────────────────────
    35→
    36→const SESSIONS_DIR = "sessions";
    37→const METADATA_FILE = "session.yaml";
    38→const EVENTS_FILE = "events.jsonl";
    39→const BUDGET_FILE = "budget.json";
    40→const BLOBS_DIR = "blobs";
    41→
    42→// Event persistence guardrails: keep single-line events bounded in size while
    43→// preserving full payloads via externalized blob files.
    44→const EVENT_LINE_MAX_BYTES = 256 * 1024;
    45→const EVENT_FIELD_EXTERNALIZE_BYTES = 16 * 1024;
    46→const EVENT_PREVIEW_MAX_BYTES = 512;
    47→const EVENT_SEQ_TAIL_READ_BYTES = EVENT_LINE_MAX_BYTES + 1024;
    48→
    49→// ─── Path Helpers ────────────────────────────────────────────────────────────
    50→
    51→/**
    52→ * Get the sessions directory path within a spec directory.
    53→ */
    54→export function getSessionsDir(specDir: string): string {
    55→  return path.join(specDir, SESSIONS_DIR);
    56→}
    57→
    58→/**
    59→ * Get the path to a specific session's directory.
    60→ */
    61→export function getSessionDir(specDir: string, sessionId: string): string {
    62→  return path.join(getSessionsDir(specDir), sessionId);
    63→}
    64→
    65→/**
    66→ * Get the path to a session's metadata file.
    67→ */
    68→export function getSessionMetadataPath(
    69→  specDir: string,
    70→  sessionId: string,
    71→): string {
    72→  return path.join(getSessionDir(specDir, sessionId), METADATA_FILE);
    73→}
    74→
    75→/**
    76→ * Get the path to a session's events file.
    77→ */
    78→export function getSessionEventsPath(
    79→  specDir: string,
    80→  sessionId: string,
    81→): string {
    82→  return path.join(getSessionDir(specDir, sessionId), EVENTS_FILE);
    83→}
    84→
    85→/**
    86→ * Get the path to a session's context snapshot file for a given iteration.
    87→ */
    88→export function getSessionContextPath(
    89→  specDir: string,
    90→  sessionId: string,
    91→  iteration: number,
    92→): string {
    93→  return path.join(
    94→    getSessionDir(specDir, sessionId),
    95→    `context-iter-${iteration}.json`,
    96→  );
    97→}
    98→
    99→/**
   100→ * Get the path to a session's budget file.
   101→ * AC: @session-creation-and-env-injection ac-budget-local
   102→ */
   103→export function getSessionBudgetPath(
   104→  specDir: string,
   105→  sessionId: string,
   106→): string {
   107→  return path.join(getSessionDir(specDir, sessionId), BUDGET_FILE);
   108→}
   109→
   110→/**
   111→ * Get the path to a session's blob directory.
   112→ */
   113→export function getSessionBlobDir(specDir: string, sessionId: string): string {
   114→  return path.join(getSessionDir(specDir, sessionId), BLOBS_DIR);
   115→}
   116→
   117→// ─── Session CRUD ────────────────────────────────────────────────────────────
   118→
   119→/**
   120→ * Create a new session with metadata.
   121→ *
   122→ * AC-1: Creates .kspec/sessions/{id}/ directory with session.yaml metadata file.
   123→ * AC-5: Metadata includes task_id (optional), agent_type, status, started_at, ended_at.
   124→ *
   125→ * @param specDir - The .kspec directory path
   126→ * @param input - Session metadata input
   127→ * @returns The created session metadata
   128→ */
   129→export async function createSession(
   130→  specDir: string,
   131→  input: SessionMetadataInput,
   132→): Promise<SessionMetadata> {
   133→  const sessionDir = getSessionDir(specDir, input.id);
   134→  const metadataPath = getSessionMetadataPath(specDir, input.id);
   135→
   136→  // Create session directory
   137→  await fsPromises.mkdir(sessionDir, { recursive: true });
   138→
   139→  // Build full metadata
   140→  // AC: @session-model-evolution ac-1 — include trigger and agent_id when provided
   141→  const metadata: SessionMetadata = {
   142→    id: input.id,
   143→    task_id: input.task_id,
   144→    agent_type: input.agent_type,
   145→    agent_id: input.agent_id,
   146→    trigger: input.trigger,
   147→    status: input.status ?? "active",
   148→    started_at: input.started_at ?? new Date().toISOString(),
   149→    ended_at: undefined,
   150→  };
   151→
   152→  // Validate and write metadata
   153→  const validated = SessionMetadataSchema.parse(metadata);
   154→  const content = YAML.stringify(validated, {
   155→    indent: 2,
   156→    lineWidth: 100,
   157→    sortMapEntries: false,
   158→  });
   159→  await fsPromises.writeFile(metadataPath, content, "utf-8");
   160→
   161→  return validated;
   162→}
   163→
   164→/**
   165→ * Read session metadata.
   166→ *
   167→ * @param specDir - The .kspec directory path
   168→ * @param sessionId - Session ID
   169→ * @returns Session metadata or null if not found
   170→ */
   171→export async function getSession(
   172→  specDir: string,
   173→  sessionId: string,
   174→): Promise<SessionMetadata | null> {
   175→  const metadataPath = getSessionMetadataPath(specDir, sessionId);
   176→
   177→  try {
   178→    const content = await fsPromises.readFile(metadataPath, "utf-8");
   179→    const raw = YAML.parse(content);
   180→    const parsed = SessionMetadataSchema.parse(raw);
   181→    // AC: @session-model-evolution ac-2 — materialize defaults for legacy sessions
   182→    return {
   183→      ...parsed,
   184→      trigger: parsed.trigger ?? "legacy",
   185→      agent_id: parsed.agent_id ?? parsed.agent_type,
   186→    };
   187→  } catch {
   188→    return null;
   189→  }
   190→}
   191→
   192→/**
   193→ * Update session status.
   194→ *
   195→ * AC-6: Updates metadata with status and ended_at timestamp when session ends.
   196→ *
   197→ * @param specDir - The .kspec directory path
   198→ * @param sessionId - Session ID
   199→ * @param status - New status
   200→ * @returns Updated metadata or null if session not found
   201→ */
   202→export async function updateSessionStatus(
   203→  specDir: string,
   204→  sessionId: string,
   205→  status: SessionStatus,
   206→): Promise<SessionMetadata | null> {
   207→  const metadata = await getSession(specDir, sessionId);
   208→  if (!metadata) {
   209→    return null;
   210→  }
   211→
   212→  // Update status and ended_at if transitioning away from active
   213→  const updated: SessionMetadata = {
   214→    ...metadata,
   215→    status,
   216→    ended_at:
   217→      status !== "active" ? new Date().toISOString() : metadata.ended_at,
   218→  };
   219→
   220→  const metadataPath = getSessionMetadataPath(specDir, sessionId);
   221→  const content = YAML.stringify(updated, {
   222→    indent: 2,
   223→    lineWidth: 100,
   224→    sortMapEntries: false,
   225→  });
   226→  await fsPromises.writeFile(metadataPath, content, "utf-8");
   227→
   228→  return updated;
   229→}
   230→
   231→/**
   232→ * List all sessions.
   233→ *
   234→ * @param specDir - The .kspec directory path
   235→ * @returns Array of session IDs
   236→ */
   237→export async function listSessions(specDir: string): Promise<string[]> {
   238→  const sessionsDir = getSessionsDir(specDir);
   239→
   240→  try {
   241→    const entries = await fsPromises.readdir(sessionsDir, {
   242→      withFileTypes: true,
   243→    });
   244→    return entries.filter((e) => e.isDirectory()).map((e) => e.name);
   245→  } catch {
   246→    return [];
   247→  }
   248→}
   249→
   250→/**
   251→ * Check if a session exists.
   252→ */
   253→export async function sessionExists(
   254→  specDir: string,
   255→  sessionId: string,
   256→): Promise<boolean> {
   257→  const metadataPath = getSessionMetadataPath(specDir, sessionId);
   258→  try {
   259→    await fsPromises.access(metadataPath);
   260→    return true;
   261→  } catch {
   262→    return false;
   263→  }
   264→}
   265→
   266→// ─── End-Loop Signal ────────────────────────────────────────────────────────
   267→
   268→/**
   269→ * Request end-loop for a session.
   270→ *
   271→ * Writes end_requested=true and optional end_reason to the session metadata.
   272→ * This is the session-scoped replacement for the marker file approach.
   273→ *
   274→ * AC: @session-end-loop-signal ac-signal
   275→ *
   276→ * @param specDir - The .kspec directory path
   277→ * @param sessionId - Session ID
   278→ * @param reason - Optional reason for ending the loop
   279→ * @returns Updated metadata or null if session not found
   280→ */
   281→export async function requestEndLoop(
   282→  specDir: string,
   283→  sessionId: string,
   284→  reason?: string,
   285→): Promise<SessionMetadata | null> {
   286→  const metadata = await getSession(specDir, sessionId);
   287→  if (!metadata) {
   288→    return null;
   289→  }
   290→
   291→  const updated: SessionMetadata = {
   292→    ...metadata,
   293→    end_requested: true,
   294→    end_reason: reason,
   295→  };
   296→
   297→  const metadataPath = getSessionMetadataPath(specDir, sessionId);
   298→  const content = YAML.stringify(updated, {
   299→    indent: 2,
   300→    lineWidth: 100,
   301→    sortMapEntries: false,
   302→  });
   303→  await fsPromises.writeFile(metadataPath, content, "utf-8");
   304→
   305→  return updated;
   306→}
   307→
   308→/**
   309→ * Check if end-loop has been requested for a session.
   310→ *
   311→ * Only returns requested=true for active sessions. If the session is
   312→ * completed or abandoned, the end-loop signal is no longer relevant
   313→ * (prevents stale KSPEC_SESSION_ID from blocking task starts).
   314→ *
   315→ * AC: @session-end-loop-signal ac-detect
   316→ *
   317→ * @param specDir - The .kspec directory path
   318→ * @param sessionId - Session ID
   319→ * @returns Object with requested flag and optional reason, or null if session not found
   320→ */
   321→export async function isEndLoopRequested(
   322→  specDir: string,
   323→  sessionId: string,
   324→): Promise<{ requested: boolean; reason?: string } | null> {
   325→  const metadata = await getSession(specDir, sessionId);
   326→  if (!metadata) {
   327→    return null;
   328→  }
   329→
   330→  return {
   331→    requested: metadata.end_requested === true && metadata.status === "active",
   332→    reason: metadata.end_reason,
   333→  };
   334→}
   335→
   336→/**
   337→ * Close a session with a specific status and reason.
   338→ *
   339→ * Used for all session close paths: normal exit, signal, error.
   340→ *
   341→ * AC: @session-end-loop-signal ac-session-close-normal
   342→ * AC: @session-end-loop-signal ac-session-close-signal
   343→ * AC: @session-end-loop-signal ac-session-close-error
   344→ *
   345→ * @param specDir - The .kspec directory path
   346→ * @param sessionId - Session ID
   347→ * @param status - New status (completed or abandoned)
   348→ * @param reason - Reason for closing
   349→ * @returns Updated metadata or null if session not found
   350→ */
   351→export async function closeSession(
   352→  specDir: string,
   353→  sessionId: string,
   354→  status: SessionStatus,
   355→  reason: string,
   356→): Promise<SessionMetadata | null> {
   357→  const metadata = await getSession(specDir, sessionId);
   358→  if (!metadata) {
   359→    return null;
   360→  }
   361→
   362→  const updated: SessionMetadata = {
   363→    ...metadata,
   364→    status,
   365→    ended_at: new Date().toISOString(),
   366→    close_reason: reason,
   367→  };
   368→
   369→  const metadataPath = getSessionMetadataPath(specDir, sessionId);
   370→  const content = YAML.stringify(updated, {
   371→    indent: 2,
   372→    lineWidth: 100,
   373→    sortMapEntries: false,
   374→  });
   375→  await fsPromises.writeFile(metadataPath, content, "utf-8");
   376→
   377→  return updated;
   378→}
   379→
   380→// ─── Event Storage ───────────────────────────────────────────────────────────
   381→
   382→/**
   383→ * Pointer stored in events.jsonl when payload content is externalized.
   384→ *
   385→ * AC: @session-events ac-9
   386→ */
   387→export interface SessionBlobPointer {
   388→  /** Relative path from session dir (for example blobs/<file>) */
   389→  path: string;
   390→  /** UTF-8 byte length of the externalized payload */
   391→  bytes: number;
   392→  /** SHA-256 hash of externalized content */
   393→  sha256: string;
   394→  /** Always true for externalized content */
   395→  truncated: true;
   396→  /** Bounded preview stored inline for fast inspection/search */
   397→  preview: string;
   398→}
   399→
   400→/**
   401→ * Blob pointer with resolved full payload content.
   402→ */
   403→interface ResolvedSessionBlobPointer extends SessionBlobPointer {
   404→  content: string;
   405→}
   406→
   407→interface BlobWriteContext {
   408→  blobDir: string;
   409→  ensuredDir: boolean;
   410→  dryRun?: boolean;
   411→  createdBlobs?: number;
   412→  dryRunCounter?: number;
   413→}
   414→
   415→function isRecord(value: unknown): value is Record<string, unknown> {
   416→  return typeof value === "object" && value !== null && !Array.isArray(value);
   417→}
   418→
   419→export function isSessionBlobPointer(value: unknown): value is SessionBlobPointer {
   420→  if (!isRecord(value)) return false;
   421→  return (
   422→    typeof value.path === "string" &&
   423→    typeof value.bytes === "number" &&
   424→    typeof value.sha256 === "string" &&
   425→    value.truncated === true &&
   426→    typeof value.preview === "string"
   427→  );
   428→}
   429→
   430→function stringifyPayload(value: unknown): string {
   431→  if (typeof value === "string") return value;
   432→  try {
   433→    return JSON.stringify(value);
   434→  } catch {
   435→    return String(value);
   436→  }
   437→}
   438→
   439→function payloadBytes(value: unknown): number {
   440→  return Buffer.byteLength(stringifyPayload(value), "utf-8");
   441→}
   442→
   443→function toPreview(content: string): string {
   444→  const totalBytes = Buffer.byteLength(content, "utf-8");
   445→  if (totalBytes <= EVENT_PREVIEW_MAX_BYTES) {
   446→    return content;
   447→  }
   448→
   449→  let preview = "";
   450→  let usedBytes = 0;
   451→  for (const char of content) {
   452→    const charBytes = Buffer.byteLength(char, "utf-8");
   453→    if (usedBytes + charBytes > EVENT_PREVIEW_MAX_BYTES) break;
   454→    preview += char;
   455→    usedBytes += charBytes;
   456→  }
   457→
   458→  return `${preview}...`;
   459→}
   460→
   461→function normalizeFieldLabel(pathSegments: string[]): string {
   462→  const joined = pathSegments.length > 0 ? pathSegments.join("-") : "event-data";
   463→  const cleaned = joined
   464→    .replace(/[^a-zA-Z0-9._-]+/g, "-")
   465→    .replace(/-+/g, "-")
   466→    .replace(/^-|-$/g, "")
   467→    .slice(0, 48);
   468→  return cleaned || "event-data";
   469→}
   470→
   471→function shouldExternalizeField(pathSegments: string[], value: unknown): boolean {
   472→  if (value === null || value === undefined) return false;
   473→
   474→  const keyPath = pathSegments.join(".");
   475→  if (keyPath === "update.rawOutput") {
   476→    return payloadBytes(value) > EVENT_FIELD_EXTERNALIZE_BYTES;
   477→  }
   478→  if (
   479→    keyPath === "update._meta.claudeCode.toolResponse.stdout" ||
   480→    keyPath === "update._meta.claudeCode.toolResponse.stderr"
   481→  ) {
   482→    return payloadBytes(value) > EVENT_FIELD_EXTERNALIZE_BYTES;
   483→  }
   484→  if (pathSegments[pathSegments.length - 1] === "text") {
   485→    const hasChunkContext =
   486→      pathSegments.includes("content") ||
   487→      pathSegments.includes("chunk") ||
   488→      pathSegments.includes("delta");
   489→    if (hasChunkContext) {
   490→      return payloadBytes(value) > EVENT_FIELD_EXTERNALIZE_BYTES;
   491→    }
   492→  }
   493→  return false;
   494→}
   495→
