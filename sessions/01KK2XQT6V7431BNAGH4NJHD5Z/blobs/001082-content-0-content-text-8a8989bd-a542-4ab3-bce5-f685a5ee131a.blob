  1339→  describe("session metadata types", () => {
  1340→    // AC: @ui-session-stream ac-4
  1341→    it("SessionDetail includes spec_context and budget fields", () => {
  1342→      // Test that the type contract is correct by constructing mock data
  1343→      const session = {
  1344→        id: "s1",
  1345→        status: "completed" as const,
  1346→        agent_type: "worker",
  1347→        session_type: "invocation" as const,
  1348→        started_at: "2026-01-01T00:00:00Z",
  1349→        ended_at: "2026-01-01T01:00:00Z",
  1350→        duration_ms: 3600000,
  1351→        event_count: 50,
  1352→        iteration_count: 3,
  1353→        tasks_completed: 1,
  1354→        spec_context: {
  1355→          spec_ref: "@ui-session-stream",
  1356→          title: "Session Stream View",
  1357→          acceptance_criteria: [
  1358→            { id: "ac-1", description: "Structured blocks" },
  1359→            { id: "ac-2", description: "Live streaming" },
  1360→          ],
  1361→        },
  1362→        budget: {
  1363→          max_per_cycle: 10,
  1364→          started_this_cycle: 3,
  1365→        },
  1366→      };
  1367→
  1368→      // Verify spec context
  1369→      expect(session.spec_context).toBeDefined();
  1370→      expect(session.spec_context!.spec_ref).toBe("@ui-session-stream");
  1371→      expect(session.spec_context!.title).toBe("Session Stream View");
  1372→      expect(session.spec_context!.acceptance_criteria).toHaveLength(2);
  1373→      expect(session.spec_context!.acceptance_criteria[0].id).toBe("ac-1");
  1374→
  1375→      // Verify budget
  1376→      expect(session.budget).toBeDefined();
  1377→      expect(session.budget!.max_per_cycle).toBe(10);
  1378→      expect(session.budget!.started_this_cycle).toBe(3);
  1379→    });
  1380→
  1381→    // AC: @ui-session-stream ac-4
  1382→    it("spec_context and budget can be null/undefined", () => {
  1383→      const session = {
  1384→        id: "s2",
  1385→        status: "active" as const,
  1386→        spec_context: null,
  1387→        budget: undefined,
  1388→      };
  1389→      expect(session.spec_context).toBeNull();
  1390→      expect(session.budget).toBeUndefined();
  1391→    });
  1392→
  1393→    // AC: @ui-session-stream ac-4
  1394→    it("budget progress calculation is correct", () => {
  1395→      // The context panel displays a progress bar: (started / max) * 100
  1396→      const budget = { max_per_cycle: 10, started_this_cycle: 3 };
  1397→      const progress = Math.min(
  1398→        100,
  1399→        (budget.started_this_cycle / budget.max_per_cycle) * 100,
  1400→      );
  1401→      expect(progress).toBe(30);
  1402→
  1403→      // Capped at 100% even if over budget
  1404→      const overBudget = { max_per_cycle: 5, started_this_cycle: 8 };
  1405→      const cappedProgress = Math.min(
  1406→        100,
  1407→        (overBudget.started_this_cycle / overBudget.max_per_cycle) * 100,
  1408→      );
  1409→      expect(cappedProgress).toBe(100);
  1410→    });
  1411→  });
  1412→});
