  1318→  describe("extractFilesChanged integrated with parseEventsToBlocks", () => {
  1319→    // AC: @ui-session-stream ac-4
  1320→    it("end-to-end: parse events then extract files changed", () => {
  1321→      const events = [
  1322→        { ts: 1000, seq: 0, type: "session.start", session_id: "s1", data: { agent_type: "worker" } },
  1323→        { ts: 1100, seq: 1, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_call", toolCallId: "r1", tool: "Read", rawInput: { file_path: "/src/old.ts" } } } },
  1324→        { ts: 1200, seq: 2, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_result", toolCallId: "r1", output: "content" } } },
  1325→        { ts: 1300, seq: 3, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_call", toolCallId: "e1", tool: "Edit", rawInput: { file_path: "/src/old.ts", old_string: "a", new_string: "b" } } } },
  1326→        { ts: 1400, seq: 4, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_result", toolCallId: "e1", output: "OK" } } },
  1327→        { ts: 1500, seq: 5, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_call", toolCallId: "w1", tool: "Write", rawInput: { file_path: "/src/new.ts" } } } },
  1328→        { ts: 1600, seq: 6, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_result", toolCallId: "w1", output: "OK" } } },
  1329→      ];
  1330→
  1331→      const blocks = parseEventsToBlocks(events);
  1332→      const files = extractFilesChanged(blocks);
  1333→
  1334→      // Read should be excluded, Edit and Write should be included
  1335→      expect(files).toEqual(["/src/new.ts", "/src/old.ts"]);
  1336→    });
  1337→  });
