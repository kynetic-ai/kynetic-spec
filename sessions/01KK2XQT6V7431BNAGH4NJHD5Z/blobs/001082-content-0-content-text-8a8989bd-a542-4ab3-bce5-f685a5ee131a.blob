   642→  describe("parseEventsToBlocks — complex multi-event sequences", () => {
   643→    // AC: @ui-session-stream ac-1
   644→    it("produces correct block sequence for a realistic agent session", () => {
   645→      const events = [
   646→        { ts: 1000, seq: 0, type: "session.start", session_id: "s1", data: { agent_type: "worker" } },
   647→        { ts: 1100, seq: 1, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "thinking", text: "Planning..." } } },
   648→        { ts: 1200, seq: 2, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "assistant_text", text: "I'll read the file." } } },
   649→        { ts: 1300, seq: 3, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_call", toolCallId: "r1", tool: "Read", rawInput: { file_path: "/src/main.ts" } } } },
   650→        { ts: 1800, seq: 4, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_result", toolCallId: "r1", output: "export function main() {}" } } },
   651→        { ts: 1900, seq: 5, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "assistant_text", text: "Now editing." } } },
   652→        { ts: 2000, seq: 6, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_call", toolCallId: "e1", tool: "Edit", rawInput: { file_path: "/src/main.ts", old_string: "main", new_string: "start" } } } },
   653→        { ts: 2500, seq: 7, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_result", toolCallId: "e1", output: "OK" } } },
   654→        { ts: 3000, seq: 8, type: "session.end", session_id: "s1", data: { reason: "completed" } },
   655→      ];
   656→
   657→      const blocks = parseEventsToBlocks(events);
   658→
   659→      // Expected sequence: system, thinking, message, tool_call(Read), message, tool_call(Edit), system
   660→      expect(blocks.map((b) => b.type)).toEqual([
   661→        "system",
   662→        "thinking",
   663→        "message",
   664→        "tool_call",
   665→        "message",
   666→        "tool_call",
   667→        "system",
   668→      ]);
   669→
   670→      // Verify tool calls resolved correctly
   671→      const toolCalls = blocks.filter((b) => b.type === "tool_call");
   672→      expect(toolCalls[0]).toMatchObject({
   673→        type: "tool_call",
   674→        toolName: "Read",
   675→        status: "completed",
   676→        durationMs: 500,
   677→      });
   678→      expect(toolCalls[1]).toMatchObject({
   679→        type: "tool_call",
   680→        toolName: "Edit",
   681→        status: "completed",
   682→        durationMs: 500,
   683→      });
   684→    });
   685→  });
