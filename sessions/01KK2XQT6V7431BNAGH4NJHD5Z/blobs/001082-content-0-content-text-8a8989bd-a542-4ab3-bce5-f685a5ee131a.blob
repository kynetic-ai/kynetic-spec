  1041→// ─── AC-3: Auto-scroll ──────────────────────────────────────────────────────
  1042→
  1043→// AC: @ui-session-stream ac-3
  1044→describe("auto-scroll behavior (@ui-session-stream ac-3)", () => {
  1045→  describe("computeScrollDistance — distance from bottom calculation", () => {
  1046→    // AC: @ui-session-stream ac-3
  1047→    it("returns 0 when scrolled to bottom", () => {
  1048→      // scrollTop = scrollHeight - clientHeight means at bottom
  1049→      expect(computeScrollDistance(1000, 600, 400)).toBe(0);
  1050→    });
  1051→
  1052→    // AC: @ui-session-stream ac-3
  1053→    it("returns positive distance when scrolled up", () => {
  1054→      expect(computeScrollDistance(1000, 550, 400)).toBe(50);
  1055→      expect(computeScrollDistance(1000, 400, 400)).toBe(200);
  1056→    });
  1057→
  1058→    // AC: @ui-session-stream ac-3
  1059→    it("handles edge case of content shorter than viewport", () => {
  1060→      // scrollHeight <= clientHeight: can't scroll
  1061→      expect(computeScrollDistance(400, 0, 400)).toBe(0);
  1062→    });
  1063→  });
  1064→
  1065→  describe("shouldAutoScroll — threshold-based auto-scroll detection", () => {
  1066→    // AC: @ui-session-stream ac-3
  1067→    it("threshold is 100px", () => {
  1068→      expect(AUTO_SCROLL_THRESHOLD).toBe(100);
  1069→    });
  1070→
  1071→    // AC: @ui-session-stream ac-3
  1072→    it("returns true when at bottom (0px from bottom)", () => {
  1073→      expect(shouldAutoScrollFn(1000, 600, 400)).toBe(true);
  1074→    });
  1075→
  1076→    // AC: @ui-session-stream ac-3
  1077→    it("returns true when within threshold (50px from bottom)", () => {
  1078→      expect(shouldAutoScrollFn(1000, 550, 400)).toBe(true);
  1079→    });
  1080→
  1081→    // AC: @ui-session-stream ac-3
  1082→    it("returns true at exactly the threshold (100px from bottom — spec says >100px pauses)", () => {
  1083→      expect(shouldAutoScrollFn(1000, 500, 400)).toBe(true);
  1084→    });
  1085→
  1086→    // AC: @ui-session-stream ac-3
  1087→    it("returns false just beyond the threshold (101px from bottom)", () => {
  1088→      expect(shouldAutoScrollFn(1000, 499, 400)).toBe(false);
  1089→    });
  1090→
  1091→    // AC: @ui-session-stream ac-3
  1092→    it("returns false when scrolled well above threshold (200px from bottom)", () => {
  1093→      expect(shouldAutoScrollFn(1000, 400, 400)).toBe(false);
  1094→    });
  1095→
  1096→    // AC: @ui-session-stream ac-3
  1097→    it("returns true when content fits in viewport (no scrolling needed)", () => {
  1098→      expect(shouldAutoScrollFn(400, 0, 400)).toBe(true);
  1099→    });
  1100→  });
  1101→
  1102→  describe("shouldShowJumpButton — button visibility logic", () => {
  1103→    // AC: @ui-session-stream ac-3
  1104→    it("hides button when auto-scrolling (regardless of content)", () => {
  1105→      expect(shouldShowJumpButton(true, true, 10)).toBe(false);
  1106→      expect(shouldShowJumpButton(true, false, 10)).toBe(false);
  1107→    });
  1108→
  1109→    // AC: @ui-session-stream ac-3
  1110→    it("shows button when not auto-scrolling and live", () => {
  1111→      expect(shouldShowJumpButton(false, true, 10)).toBe(true);
  1112→    });
  1113→
  1114→    // AC: @ui-session-stream ac-3
  1115→    it("shows button when not auto-scrolling and has blocks", () => {
  1116→      expect(shouldShowJumpButton(false, false, 5)).toBe(true);
  1117→    });
  1118→
  1119→    // AC: @ui-session-stream ac-3
  1120→    it("hides button when not auto-scrolling but no content", () => {
  1121→      expect(shouldShowJumpButton(false, false, 0)).toBe(false);
  1122→    });
  1123→  });
  1124→});
