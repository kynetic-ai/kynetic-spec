   540→  describe("parseEventsToBlocks — agent lifecycle and other events", () => {
   541→    // AC: @ui-session-stream ac-1
   542→    it("handles all agent lifecycle event types", () => {
   543→      const agentEvents = [
   544→        "agent.dispatched",
   545→        "agent.started",
   546→        "agent.completed",
   547→        "agent.failed",
   548→        "agent.timeout",
   549→      ];
   550→      const events = agentEvents.map((type, i) => ({
   551→        ts: 1000 + i * 1000,
   552→        seq: i,
   553→        type,
   554→        session_id: "s1",
   555→        data: { task_ref: "@task-foo" },
   556→      }));
   557→      const blocks = parseEventsToBlocks(events);
   558→      expect(blocks).toHaveLength(5);
   559→
   560→      const labels = blocks.map((b) =>
   561→        b.type === "system" ? b.label : "",
   562→      );
   563→      expect(labels).toEqual([
   564→        "Agent dispatched",
   565→        "Agent started",
   566→        "Agent completed",
   567→        "Agent failed",
   568→        "Agent timed out",
   569→      ]);
   570→
   571→      // All should include task detail
   572→      for (const block of blocks) {
   573→        if (block.type === "system") {
   574→          expect(block.detail).toBe("Task: @task-foo");
   575→        }
   576→      }
   577→    });
   578→
