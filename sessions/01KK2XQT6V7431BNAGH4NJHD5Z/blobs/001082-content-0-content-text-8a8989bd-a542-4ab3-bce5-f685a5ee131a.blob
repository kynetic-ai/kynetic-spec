  1000→      text = accumulateStreamingText(text, { event: "agent_text_chunk", data: { session_id: "s1", text: "" } }, "s1");
  1001→      expect(text).toBe("existing");
  1002→      text = accumulateStreamingText(text, { event: "agent_text_chunk", data: { session_id: "s1" } }, "s1");
  1003→      expect(text).toBe("existing");
