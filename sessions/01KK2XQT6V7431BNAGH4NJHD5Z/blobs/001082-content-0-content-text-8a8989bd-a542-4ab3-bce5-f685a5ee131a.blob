  1432→describe("design tokens and accessibility", () => {
  1433→  it("no raw Tailwind color classes in session components", () => {
  1434→    // Read component sources and verify no raw emerald/red/blue/purple colors
  1435→    const { readFileSync } = require("node:fs");
  1436→    const componentFiles = [
  1437→      "SessionStream.svelte",
  1438→      "ToolCallView.svelte",
  1439→      "ThinkingBlock.svelte",
  1440→      "MessageBlock.svelte",
  1441→      "SystemBlock.svelte",
  1442→      "SessionContextPanel.svelte",
  1443→    ];
  1444→
  1445→    const rawColorPattern =
  1446→      /\b(?:text|bg|border(?:-[lrtb])?)-(?:emerald|red|blue|purple|green|amber|orange|yellow|pink|teal|cyan|indigo|violet|fuchsia|rose|lime|sky)-\d+\b/g;
  1447→
  1448→    for (const file of componentFiles) {
  1449→      const path = join(SESSION_COMPONENTS, file);
  1450→      if (existsSync(path)) {
  1451→        const src = readFileSync(path, "utf-8");
  1452→        const matches = src.match(rawColorPattern);
  1453→        expect(
  1454→          matches,
  1455→          `${file} contains raw Tailwind colors: ${matches?.join(", ")}`,
  1456→        ).toBeNull();
  1457→      }
  1458→    }
  1459→  });
  1460→
  1461→  it("no raw Tailwind color classes in session page", () => {
  1462→    const { readFileSync } = require("node:fs");
  1463→    const pagePath = join(WEB_UI_SRC, "routes", "sessions", "[id]", "+page.svelte");
  1464→    const src = readFileSync(pagePath, "utf-8");
  1465→    const rawColorPattern =
  1466→      /\b(?:text|bg|border(?:-[lrtb])?)-(?:emerald|red|blue|purple|green)-\d+\b/g;
  1467→    const matches = src.match(rawColorPattern);
  1468→    expect(
  1469→      matches,
  1470→      `Session page contains raw Tailwind colors: ${matches?.join(", ")}`,
  1471→    ).toBeNull();
  1472→  });
  1473→
  1474→  it("session stream has aria-live and role=log for screen readers", () => {
  1475→    const { readFileSync } = require("node:fs");
  1476→    const src = readFileSync(
  1477→      join(SESSION_COMPONENTS, "SessionStream.svelte"),
  1478→      "utf-8",
  1479→    );
  1480→    // Verify the stream container has accessibility attributes
  1481→    expect(src).toContain("aria-live");
  1482→    expect(src).toContain('role="log"');
  1483→  });
  1484→
  1485→  it("animations are gated behind prefers-reduced-motion", () => {
  1486→    const { readFileSync } = require("node:fs");
  1487→    const animatedFiles = [
  1488→      "SessionStream.svelte",
  1489→      "ToolCallView.svelte",
  1490→      "SessionContextPanel.svelte",
  1491→    ];
  1492→
  1493→    for (const file of animatedFiles) {
  1494→      const path = join(SESSION_COMPONENTS, file);
  1495→      if (existsSync(path)) {
  1496→        const src = readFileSync(path, "utf-8");
  1497→        // If file has @keyframes, it should also have prefers-reduced-motion
  1498→        if (src.includes("@keyframes")) {
  1499→          expect(
  1500→            src,
  1501→            `${file} has animations but missing prefers-reduced-motion media query`,
  1502→          ).toContain("prefers-reduced-motion");
  1503→        }
  1504→      }
  1505→    }
  1506→  });
  1507→});
