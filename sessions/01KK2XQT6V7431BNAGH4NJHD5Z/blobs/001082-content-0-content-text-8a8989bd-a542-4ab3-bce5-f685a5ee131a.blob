  1012→  });
  1013→
  1014→  describe("streaming text refresh pattern", () => {
  1015→    // AC: @ui-session-stream ac-2
  1016→    it("streaming text clears when structured refresh provides new blocks", () => {
  1017→      // parseEventsToBlocks produces blocks from the refreshed events
  1018→      const newEvents = [
