  1127→
  1128→// AC: @ui-session-stream ac-4
  1129→describe("session context panel (@ui-session-stream ac-4)", () => {
  1130→  describe("component and route exist", () => {
  1131→    // AC: @ui-session-stream ac-4
  1132→    it("context panel component exists", () => {
