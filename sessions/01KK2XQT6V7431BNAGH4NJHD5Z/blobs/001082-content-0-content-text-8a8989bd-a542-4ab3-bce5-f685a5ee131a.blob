```
     1→/**
     2→ * Session Stream View Tests
     3→ *
     4→ * Runtime behavior tests for the session stream view implementation.
     5→ * Tests exercise actual functions (parseEventsToBlocks, extractFilesChanged,
     6→ * renderMarkdown) rather than checking source strings.
     7→ *
     8→ * Structural tests are limited to file existence and key integration points.
     9→ *
    10→ * Spec: @ui-session-stream
    11→ */
    12→
    13→import { describe, it, expect, beforeAll } from "vitest";
    14→import { existsSync } from "node:fs";
    15→import { join } from "node:path";
    16→
    17→const WEB_UI_ROOT = join(process.cwd(), "packages", "web-ui");
    18→const WEB_UI_SRC = join(WEB_UI_ROOT, "src");
    19→const SESSION_COMPONENTS = join(WEB_UI_SRC, "lib", "components", "session");
    20→
    21→// ─── Runtime imports ─────────────────────────────────────────────────────────
    22→
    23→type SessionUtils = typeof import("../packages/web-ui/src/lib/components/session/session-utils");
    24→type MarkdownUtils = typeof import("../packages/web-ui/src/lib/utils/markdown");
    25→
    26→let parseEventsToBlocks: SessionUtils["parseEventsToBlocks"];
    27→let getToolIcon: SessionUtils["getToolIcon"];
    28→let getToolInputPreview: SessionUtils["getToolInputPreview"];
    29→let formatDuration: SessionUtils["formatDuration"];
    30→let formatTime: SessionUtils["formatTime"];
    31→let formatElapsed: SessionUtils["formatElapsed"];
    32→let formatAge: SessionUtils["formatAge"];
    33→let extractFilesChanged: SessionUtils["extractFilesChanged"];
    34→let computeScrollDistance: SessionUtils["computeScrollDistance"];
    35→let shouldAutoScrollFn: SessionUtils["shouldAutoScroll"];
    36→let AUTO_SCROLL_THRESHOLD: SessionUtils["AUTO_SCROLL_THRESHOLD"];
    37→let shouldShowJumpButton: SessionUtils["shouldShowJumpButton"];
    38→let accumulateStreamingText: SessionUtils["accumulateStreamingText"];
    39→let getLastSeq: SessionUtils["getLastSeq"];
    40→let renderMarkdown: MarkdownUtils["renderMarkdown"];
    41→
    42→beforeAll(async () => {
    43→  const sessionMod = await import(
    44→    "../packages/web-ui/src/lib/components/session/session-utils"
    45→  );
    46→  parseEventsToBlocks = sessionMod.parseEventsToBlocks;
    47→  getToolIcon = sessionMod.getToolIcon;
    48→  getToolInputPreview = sessionMod.getToolInputPreview;
    49→  formatDuration = sessionMod.formatDuration;
    50→  formatTime = sessionMod.formatTime;
    51→  formatElapsed = sessionMod.formatElapsed;
    52→  formatAge = sessionMod.formatAge;
    53→  extractFilesChanged = sessionMod.extractFilesChanged;
    54→  computeScrollDistance = sessionMod.computeScrollDistance;
    55→  shouldAutoScrollFn = sessionMod.shouldAutoScroll;
    56→  AUTO_SCROLL_THRESHOLD = sessionMod.AUTO_SCROLL_THRESHOLD;
    57→  shouldShowJumpButton = sessionMod.shouldShowJumpButton;
    58→  accumulateStreamingText = sessionMod.accumulateStreamingText;
    59→  getLastSeq = sessionMod.getLastSeq;
    60→
    61→  const markdownMod = await import(
    62→    "../packages/web-ui/src/lib/utils/markdown"
    63→  );
    64→  renderMarkdown = markdownMod.renderMarkdown;
    65→});
    66→
    67→// ─── AC-1: Structured event blocks ────────────────────────────────────────────
    68→
    69→// AC: @ui-session-stream ac-1
    70→describe("structured event blocks (@ui-session-stream ac-1)", () => {
    71→  describe("component files exist", () => {
    72→    it("session route exists at /sessions/[id]", () => {
    73→      expect(
    74→        existsSync(join(WEB_UI_SRC, "routes", "sessions", "[id]", "+page.svelte")),
    75→      ).toBe(true);
    76→    });
    77→
    78→    it("all block components exist", () => {
    79→      expect(existsSync(join(SESSION_COMPONENTS, "MessageBlock.svelte"))).toBe(true);
    80→      expect(existsSync(join(SESSION_COMPONENTS, "ToolCallView.svelte"))).toBe(true);
    81→      expect(existsSync(join(SESSION_COMPONENTS, "ThinkingBlock.svelte"))).toBe(true);
    82→      expect(existsSync(join(SESSION_COMPONENTS, "SystemBlock.svelte"))).toBe(true);
    83→      expect(existsSync(join(SESSION_COMPONENTS, "SessionStream.svelte"))).toBe(true);
    84→    });
    85→  });
    86→
    87→  describe("parseEventsToBlocks — session lifecycle events", () => {
    88→    // AC: @ui-session-stream ac-1
    89→    it("parses session.start as system block with agent type", () => {
    90→      const events = [
    91→        {
    92→          ts: 1000,
    93→          seq: 0,
    94→          type: "session.start",
    95→          session_id: "s1",
    96→          data: { agent_type: "worker" },
    97→        },
    98→      ];
    99→      const blocks = parseEventsToBlocks(events);
   100→      expect(blocks).toHaveLength(1);
   101→      expect(blocks[0]).toMatchObject({
   102→        type: "system",
   103→        label: "Session started",
   104→        detail: "Agent: worker",
   105→        timestamp: 1000,
   106→        seq: 0,
   107→      });
   108→    });
   109→
   110→    // AC: @ui-session-stream ac-1
   111→    it("parses session.end as system block", () => {
   112→      const events = [
   113→        {
   114→          ts: 5000,
   115→          seq: 10,
   116→          type: "session.end",
   117→          session_id: "s1",
   118→          data: { reason: "completed" },
   119→        },
   120→      ];
   121→      const blocks = parseEventsToBlocks(events);
   122→      expect(blocks).toHaveLength(1);
   123→      expect(blocks[0]).toMatchObject({
   124→        type: "system",
   125→        label: "Session ended",
   126→        detail: "completed",
   127→      });
   128→    });
   129→
   130→    // AC: @ui-session-stream ac-1
   131→    it("parses session.wrapup as system block", () => {
   132→      const events = [
   133→        {
   134→          ts: 4000,
   135→          seq: 8,
   136→          type: "session.wrapup",
   137→          session_id: "s1",
   138→          data: { reason: "budget exhausted" },
   139→        },
   140→      ];
   141→      const blocks = parseEventsToBlocks(events);
   142→      expect(blocks).toHaveLength(1);
   143→      expect(blocks[0]).toMatchObject({
   144→        type: "system",
   145→        label: "Session wrapping up",
   146→        detail: "budget exhausted",
   147→      });
   148→    });
   149→  });
   150→
   151→  describe("parseEventsToBlocks — message blocks", () => {
   152→    // AC: @ui-session-stream ac-1
   153→    it("parses assistant_text as message block", () => {
   154→      const events = [
   155→        {
   156→          ts: 1000,
   157→          seq: 0,
   158→          type: "session.update",
   159→          session_id: "s1",
   160→          data: {
   161→            update: { sessionUpdate: "assistant_text", text: "Hello world" },
   162→          },
   163→        },
   164→      ];
   165→      const blocks = parseEventsToBlocks(events);
   166→      expect(blocks).toHaveLength(1);
   167→      expect(blocks[0]).toMatchObject({
   168→        type: "message",
   169→        content: "Hello world",
   170→        timestamp: 1000,
   171→      });
   172→    });
   173→
   174→    // AC: @ui-session-stream ac-1
   175→    it("parses assistant variant as message block", () => {
   176→      const events = [
   177→        {
   178→          ts: 2000,
   179→          seq: 1,
   180→          type: "session.update",
   181→          session_id: "s1",
   182→          data: {
   183→            update: { sessionUpdate: "assistant", content: "Response text" },
   184→          },
   185→        },
   186→      ];
   187→      const blocks = parseEventsToBlocks(events);
   188→      expect(blocks).toHaveLength(1);
   189→      expect(blocks[0]).toMatchObject({
   190→        type: "message",
   191→        content: "Response text",
   192→      });
   193→    });
   194→
   195→    // AC: @ui-session-stream ac-1
   196→    it("merges consecutive message blocks into one", () => {
   197→      const events = [
   198→        {
   199→          ts: 1000,
   200→          seq: 0,
   201→          type: "session.update",
   202→          session_id: "s1",
   203→          data: {
   204→            update: { sessionUpdate: "assistant_text", text: "Hello " },
   205→          },
   206→        },
   207→        {
   208→          ts: 1001,
   209→          seq: 1,
   210→          type: "session.update",
   211→          session_id: "s1",
   212→          data: {
   213→            update: { sessionUpdate: "assistant_text", text: "world" },
   214→          },
   215→        },
   216→      ];
   217→      const blocks = parseEventsToBlocks(events);
   218→      expect(blocks).toHaveLength(1);
   219→      expect(blocks[0].type).toBe("message");
   220→      if (blocks[0].type === "message") {
   221→        expect(blocks[0].content).toBe("Hello world");
   222→      }
   223→    });
   224→
   225→    // AC: @ui-session-stream ac-1
   226→    it("does not merge messages separated by other block types", () => {
   227→      const events = [
   228→        {
   229→          ts: 1000,
   230→          seq: 0,
   231→          type: "session.update",
   232→          session_id: "s1",
   233→          data: {
   234→            update: { sessionUpdate: "assistant_text", text: "First" },
   235→          },
   236→        },
   237→        {
   238→          ts: 1500,
   239→          seq: 1,
   240→          type: "session.update",
   241→          session_id: "s1",
   242→          data: {
   243→            update: { sessionUpdate: "thinking", text: "hmm" },
   244→          },
   245→        },
   246→        {
   247→          ts: 2000,
   248→          seq: 2,
   249→          type: "session.update",
   250→          session_id: "s1",
   251→          data: {
   252→            update: { sessionUpdate: "assistant_text", text: "Second" },
   253→          },
   254→        },
   255→      ];
   256→      const blocks = parseEventsToBlocks(events);
   257→      expect(blocks).toHaveLength(3);
   258→      expect(blocks[0].type).toBe("message");
   259→      expect(blocks[1].type).toBe("thinking");
   260→      expect(blocks[2].type).toBe("message");
   261→      if (blocks[0].type === "message" && blocks[2].type === "message") {
   262→        expect(blocks[0].content).toBe("First");
   263→        expect(blocks[2].content).toBe("Second");
   264→      }
   265→    });
   266→
   267→    // AC: @ui-session-stream ac-1
   268→    it("ignores empty text content", () => {
   269→      const events = [
   270→        {
   271→          ts: 1000,
   272→          seq: 0,
   273→          type: "session.update",
   274→          session_id: "s1",
   275→          data: { update: { sessionUpdate: "assistant_text", text: "" } },
   276→        },
   277→      ];
   278→      const blocks = parseEventsToBlocks(events);
   279→      expect(blocks).toHaveLength(0);
   280→    });
   281→  });
   282→
   283→  describe("parseEventsToBlocks — tool call blocks", () => {
   284→    // AC: @ui-session-stream ac-1
   285→    it("creates tool call block with running status and resolves on result", () => {
   286→      const events = [
   287→        {
   288→          ts: 1000,
   289→          seq: 0,
   290→          type: "session.update",
   291→          session_id: "s1",
   292→          data: {
   293→            update: {
   294→              sessionUpdate: "tool_call",
   295→              toolCallId: "tc-1",
   296→              tool: "Bash",
   297→              rawInput: { command: "ls" },
   298→            },
   299→          },
   300→        },
   301→        {
   302→          ts: 2500,
   303→          seq: 1,
   304→          type: "session.update",
   305→          session_id: "s1",
   306→          data: {
   307→            update: {
   308→              sessionUpdate: "tool_result",
   309→              toolCallId: "tc-1",
   310→              output: "file.txt\ndir/",
   311→            },
   312→          },
   313→        },
   314→      ];
   315→      const blocks = parseEventsToBlocks(events);
   316→      expect(blocks).toHaveLength(1);
   317→      expect(blocks[0]).toMatchObject({
   318→        type: "tool_call",
   319→        toolName: "Bash",
   320→        toolCallId: "tc-1",
   321→        input: { command: "ls" },
   322→        output: "file.txt\ndir/",
   323→        status: "completed",
   324→        durationMs: 1500,
   325→        startedAt: 1000,
   326→        completedAt: 2500,
   327→      });
   328→    });
   329→
   330→    // AC: @ui-session-stream ac-1
   331→    it("marks tool call as failed when error flag is set", () => {
   332→      const events = [
   333→        {
   334→          ts: 1000,
   335→          seq: 0,
   336→          type: "session.update",
   337→          session_id: "s1",
   338→          data: {
   339→            update: {
   340→              sessionUpdate: "tool_call",
   341→              toolCallId: "tc-err",
   342→              tool: "Bash",
   343→              rawInput: { command: "false" },
   344→            },
   345→          },
   346→        },
   347→        {
   348→          ts: 2000,
   349→          seq: 1,
   350→          type: "session.update",
   351→          session_id: "s1",
   352→          data: {
   353→            update: {
   354→              sessionUpdate: "tool_result",
   355→              toolCallId: "tc-err",
   356→              output: "exit code 1",
   357→              error: true,
   358→            },
   359→          },
   360→        },
   361→      ];
   362→      const blocks = parseEventsToBlocks(events);
   363→      expect(blocks[0]).toMatchObject({
   364→        type: "tool_call",
   365→        status: "failed",
   366→        durationMs: 1000,
   367→      });
   368→    });
   369→
   370→    // AC: @ui-session-stream ac-1
   371→    it("marks tool call as failed when isError flag is set", () => {
   372→      const events = [
   373→        {
   374→          ts: 1000,
   375→          seq: 0,
   376→          type: "session.update",
   377→          session_id: "s1",
   378→          data: {
   379→            update: {
   380→              sessionUpdate: "tool_call",
   381→              toolCallId: "tc-err2",
   382→              tool: "Read",
   383→              rawInput: { file_path: "/missing" },
   384→            },
   385→          },
   386→        },
   387→        {
   388→          ts: 1200,
   389→          seq: 1,
   390→          type: "session.update",
   391→          session_id: "s1",
   392→          data: {
   393→            update: {
   394→              sessionUpdate: "tool_result",
   395→              toolCallId: "tc-err2",
   396→              output: "File not found",
   397→              isError: true,
   398→            },
   399→          },
   400→        },
   401→      ];
   402→      const blocks = parseEventsToBlocks(events);
   403→      expect(blocks[0]).toMatchObject({
   404→        type: "tool_call",
   405→        status: "failed",
   406→      });
   407→    });
   408→
   409→    // AC: @ui-session-stream ac-1
   410→    it("handles tool.call / tool.result event types (alternative format)", () => {
   411→      const events = [
   412→        {
   413→          ts: 1000,
   414→          seq: 0,
   415→          type: "tool.call",
   416→          session_id: "s1",
   417→          data: { tool: "Read", toolCallId: "tc-2", input: { file_path: "/a.ts" } },
   418→        },
   419→        {
   420→          ts: 1500,
   421→          seq: 1,
   422→          type: "tool.result",
   423→          session_id: "s1",
   424→          data: { toolCallId: "tc-2", output: "contents" },
   425→        },
   426→      ];
   427→      const blocks = parseEventsToBlocks(events);
   428→      expect(blocks).toHaveLength(1);
   429→      expect(blocks[0]).toMatchObject({
   430→        type: "tool_call",
   431→        toolName: "Read",
   432→        status: "completed",
   433→        durationMs: 500,
   434→      });
   435→    });
   436→
   437→    // AC: @ui-session-stream ac-1
   438→    it("leaves tool call as running if no result arrives", () => {
   439→      const events = [
   440→        {
   441→          ts: 1000,
   442→          seq: 0,
   443→          type: "session.update",
   444→          session_id: "s1",
   445→          data: {
   446→            update: {
   447→              sessionUpdate: "tool_call",
   448→              toolCallId: "tc-pending",
   449→              tool: "Bash",
   450→              rawInput: { command: "sleep 999" },
   451→            },
   452→          },
   453→        },
   454→      ];
   455→      const blocks = parseEventsToBlocks(events);
   456→      expect(blocks[0]).toMatchObject({
   457→        type: "tool_call",
   458→        status: "running",
   459→      });
   460→      if (blocks[0].type === "tool_call") {
   461→        expect(blocks[0].durationMs).toBeUndefined();
   462→        expect(blocks[0].output).toBeUndefined();
   463→      }
   464→    });
   465→  });
