   904→// ─── AC-2: Live streaming ────────────────────────────────────────────────────
   905→
   906→// AC: @ui-session-stream ac-2
   907→describe("live streaming logic (@ui-session-stream ac-2)", () => {
   908→  describe("incremental event loading via parseEventsToBlocks", () => {
   909→    // AC: @ui-session-stream ac-2
   910→    it("parseEventsToBlocks handles incremental event appending", () => {
   911→      // Simulate first load
   912→      const batch1 = [
   913→        { ts: 1000, seq: 0, type: "session.start", session_id: "s1", data: { agent_type: "worker" } },
   914→        { ts: 1100, seq: 1, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "assistant_text", text: "Hello" } } },
   915→      ];
   916→      let allEvents = [...batch1];
   917→      let blocks = parseEventsToBlocks(allEvents);
   918→      expect(blocks).toHaveLength(2);
   919→      expect(blocks[1]).toMatchObject({ type: "message", content: "Hello" });
   920→
   921→      // Simulate incremental refresh (new events appended)
   922→      const batch2 = [
   923→        { ts: 1200, seq: 2, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_call", toolCallId: "tc1", tool: "Bash", rawInput: { command: "echo test" } } } },
   924→        { ts: 1500, seq: 3, type: "session.update", session_id: "s1", data: { update: { sessionUpdate: "tool_result", toolCallId: "tc1", output: "test" } } },
   925→      ];
   926→      allEvents = [...allEvents, ...batch2];
   927→      blocks = parseEventsToBlocks(allEvents);
   928→      expect(blocks).toHaveLength(3);
   929→      expect(blocks.map((b) => b.type)).toEqual(["system", "message", "tool_call"]);
   930→
   931→      // Verify the tool call resolved
   932→      if (blocks[2].type === "tool_call") {
   933→        expect(blocks[2].status).toBe("completed");
   934→        expect(blocks[2].durationMs).toBe(300);
   935→      }
   936→    });
   937→  });
   938→
   939→  describe("getLastSeq — sequence tracking for incremental loading", () => {
   940→    // AC: @ui-session-stream ac-2
   941→    it("returns -1 for empty events", () => {
   942→      expect(getLastSeq([])).toBe(-1);
   943→    });
   944→
   945→    // AC: @ui-session-stream ac-2
   946→    it("returns the seq of the last event", () => {
   947→      const events = [
   948→        { seq: 0 },
   949→        { seq: 5 },
   950→        { seq: 10 },
   951→      ];
   952→      expect(getLastSeq(events)).toBe(10);
   953→    });
   954→
   955→    // AC: @ui-session-stream ac-2
   956→    it("works with single event", () => {
   957→      expect(getLastSeq([{ seq: 42 }])).toBe(42);
   958→    });
   959→
   960→    // AC: @ui-session-stream ac-2
   961→    it("tracks incremental batches correctly", () => {
   962→      const batch1 = [{ seq: 0 }, { seq: 1 }, { seq: 2 }];
   963→      const lastAfterBatch1 = getLastSeq(batch1);
   964→      expect(lastAfterBatch1).toBe(2);
   965→
   966→      const batch2 = [{ seq: 3 }, { seq: 4 }];
   967→      const allEvents = [...batch1, ...batch2];
   968→      const lastAfterBatch2 = getLastSeq(allEvents);
   969→      expect(lastAfterBatch2).toBe(4);
   970→      expect(lastAfterBatch2).toBeGreaterThan(lastAfterBatch1);
   971→    });
   972→  });
   973→
   974→  describe("accumulateStreamingText — WebSocket text chunk handling", () => {
   975→    // AC: @ui-session-stream ac-2
   976→    it("accumulates text from matching session chunks", () => {
   977→      let text = "";
   978→      text = accumulateStreamingText(text, { event: "agent_text_chunk", data: { session_id: "s1", text: "Hello " } }, "s1");
   979→      text = accumulateStreamingText(text, { event: "agent_text_chunk", data: { session_id: "s1", text: "world" } }, "s1");
   980→      expect(text).toBe("Hello world");
