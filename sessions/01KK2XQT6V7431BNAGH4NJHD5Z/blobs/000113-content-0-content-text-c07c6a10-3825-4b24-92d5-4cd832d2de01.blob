   176→// =============================================================================
   177→// Spoke Types
   178→// =============================================================================
   179→
   180→export type SpokeStatus = 'available' | 'active' | 'offline';
   181→
   182→export interface Spoke {
   183→  id: string;
   184→  name: string;
   185→  status: SpokeStatus;
   186→  capabilities: string[];
