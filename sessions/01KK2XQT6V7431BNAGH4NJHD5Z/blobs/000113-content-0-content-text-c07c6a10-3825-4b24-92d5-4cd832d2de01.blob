   496→// =============================================================================
   497→// Skill Types
   498→// =============================================================================
   499→
   500→/**
   501→ * Skill source - where to install a skill from.
   502→ */
   503→export type SkillSource =
   504→  | { type: 'local'; path: string }
   505→  | { type: 'url'; url: string }
   506→  | { type: 'registry'; registryUrl: string; package: string; version: string };
   507→
   508→/**
   509→ * Skill metadata summary (returned by list endpoint).
   510→ */
   511→export interface SkillSummary {
   512→  name: string;
   513→  description?: string;
   514→  version?: string;
   515→  license?: string;
   516→  installedAt?: string;
   517→}
   518→
   519→/**
   520→ * Full skill manifest (returned by detail endpoint).
   521→ */
   522→export interface Skill {
   523→  name: string;
   524→  description?: string;
   525→  license?: string;
   526→  metadata?: {
   527→    version?: string;
   528→    author?: string;
   529→    homepage?: string;
   530→    repository?: string;
   531→    [key: string]: unknown;
   532→  };
   533→  tools?: SkillTool[];
   534→  prompts?: SkillPrompt[];
   535→  installedAt?: string;
   536→  source?: SkillSource;
   537→}
   538→
   539→export interface SkillTool {
   540→  name: string;
   541→  description?: string;
   542→  inputSchema?: Record<string, unknown>;
   543→}
   544→
   545→export interface SkillPrompt {
   546→  name: string;
   547→  description?: string;
   548→  template?: string;
   549→}
   550→
   551→export interface SkillListResponse {
   552→  skills: SkillSummary[];
   553→}
   554→
   555→export interface SkillInstallRequest {
   556→  source: SkillSource;
   557→}
   558→
   559→export interface SkillInstallResponse {
   560→  skill: Skill;
   561→}
   562→
   563→export interface SkillRefreshResponse {
   564→  updated: boolean;
   565→  skill: Skill;
   566→}
   567→
