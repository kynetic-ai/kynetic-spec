     1→/**
     2→ * Hub API Types for the UI
     3→ *
     4→ * Types for REST API responses and WebSocket messages.
     5→ * Based on packages/hub/src/http-api/types.ts and packages/hub/src/ui/types.ts
     6→ */
     7→
     8→// =============================================================================
     9→// Task Types
    10→// =============================================================================
    11→
    12→export type TaskStatus =
    13→  | 'pending'
    14→  | 'ready'
    15→  | 'assigned'
    16→  | 'in_progress'
    17→  | 'orphaned'
    18→  | 'completed'
    19→  | 'failed'
    20→  | 'archived';
    21→
    22→/**
    23→ * VCS workspace state for task isolation.
    24→ */
    25→export type TaskWorkspaceState = 'active' | 'merging' | 'merged' | 'conflict' | 'abandoned';
    26→
    27→/**
    28→ * VCS workspace metadata attached to a task.
    29→ * Provides visibility into JJ workspace state for crash recovery and UI display.
    30→ */
    31→export interface TaskVcsData {
    32→  /** JJ workspace identifier (e.g., "main--task-42--01ARZ3NDEK") */
    33→  workspace_id: string;
    34→  /** Current JJ change ID */
    35→  change_id?: string;
    36→  /** Git commit hash (for colocated repos) */
    37→  commit_hash?: string;
    38→  /** Target branch for merge (e.g., "main") */
    39→  target_branch: string;
    40→  /** Current workspace state */
    41→  state: TaskWorkspaceState;
    42→  /** Files with conflicts (only when state = 'conflict') */
    43→  conflicted_files?: string[];
    44→}
    45→
    46→export interface Task {
    47→  id: string;
    48→  title: string;
    49→  description?: string;
    50→  status: TaskStatus;
    51→  /** 0-4 (0 = highest priority) */
    52→  priority: number;
    53→  /** Spoke ID if assigned */
    54→  assigned_to?: string;
    55→  /** Active session ID (if running) */
    56→  current_session_id?: string;
    57→  /** Past session IDs */
    58→  session_history: string[];
    59→  /** Feedback from the most recent rejection, if any */
    60→  reject_feedback?: string;
    61→  /** VCS workspace metadata (present if task has/had a workspace) */
    62→  vcs?: TaskVcsData;
    63→  /** Project this task belongs to (multi-project support) */
    64→  project_id?: string;
    65→  created_at: string;
    66→  updated_at: string;
    67→}
    68→
    69→export interface TaskListResponse {
    70→  tasks: Task[];
    71→  total_count: number;
    72→}
    73→
    74→export interface TaskCreateRequest {
    75→  title: string;
    76→  description?: string;
    77→  priority?: number;
    78→}
    79→
    80→export interface TaskUpdateRequest {
    81→  title?: string;
    82→  description?: string;
    83→  priority?: number;
    84→  status?: TaskStatus;
    85→}
    86→
    87→/**
    88→ * Response wrapper for single task endpoints.
    89→ * Most task endpoints return { task: Task } with optional additional fields.
    90→ */
    91→export interface TaskResponse {
    92→  task: Task;
    93→}
    94→
    95→// =============================================================================
    96→// Session Types
    97→// =============================================================================
    98→
    99→export type SessionStatus = 'active' | 'paused' | 'completed' | 'failed';
   100→export type AgentType = 'task' | 'planner' | 'hub';
   101→export type SessionMessageType =
   102→  | 'user_message'
   103→  | 'agent_message'
   104→  | 'agent_thought'
   105→  | 'tool_use'
   106→  | 'tool_result'
   107→  | 'interaction'
   108→  | 'status';
   109→
   110→export interface SessionContext {
   111→  task_id?: string;
   112→  spec_id?: string;
   113→  spoke_id?: string;
   114→  connected_session_id?: string;
   115→}
   116→
   117→export interface Session {
   118→  id: string;
   119→  agent_type: AgentType;
   120→  status: SessionStatus;
   121→  context?: SessionContext;
   122→  /** Project this session belongs to (multi-project support) */
   123→  project_id?: string;
   124→  created_at: string;
   125→  updated_at: string;
   126→}
   127→
   128→export interface SessionMessage {
   129→  id: string;
   130→  timestamp: string;
   131→  type: SessionMessageType;
   132→  data: unknown;
   133→}
   134→
   135→/**
   136→ * SessionDetail - REST API response format.
   137→ *
   138→ * Note: Since Phase 2, the REST API returns AggregatedMessage[] format
   139→ * instead of SessionMessage[]. Import from @kynetic/shared/aggregated-message
   140→ * for the exact types.
   141→ *
   142→ * @see specs/STREAMING_MESSAGE_AGGREGATION.md Section 7
   143→ */
   144→export interface SessionDetail extends Session {
   145→  /** Aggregated messages (AggregatedMessage[] from shared package) */
   146→  messages: unknown[];
   147→  /** Session metadata (plan, mode, commands) */
   148→  sessionMeta?: {
   149→    plan: { id: string; content: string; completed: boolean }[] | null;
   150→    currentModeId: string | null;
   151→    availableCommands: { name: string; description?: string }[] | null;
   152→  };
   153→  has_more: boolean;
   154→  total_count: number;
   155→}
   156→
   157→export interface SessionListResponse {
   158→  sessions: Session[];
   159→  total_count: number;
   160→}
   161→
   162→/**
   163→ * Response wrapper for single session endpoints.
   164→ */
   165→export interface SessionResponse {
   166→  session: Session;
   167→}
   168→
   169→/**
   170→ * Response wrapper for session detail endpoints.
   171→ */
   172→export interface SessionDetailResponse {
   173→  session: SessionDetail;
   174→}
