   196→// =============================================================================
   197→// WebSocket Types (Server → Client)
   198→// =============================================================================
   199→
   200→export interface HubEvent<T = unknown> {
   201→  /** ULID - unique event identifier */
   202→  msg_id: string;
   203→  /** Monotonic sequence number */
   204→  seq: number;
   205→  /** ISO 8601 timestamp */
   206→  timestamp: string;
   207→  /** Topic: "tasks:updates", "sessions:updates", "spokes:updates", "system" */
   208→  topic: string;
   209→  /** Event type: "created", "updated", "message", "tool_use", etc. */
   210→  event: string;
   211→  /** Event-specific payload */
   212→  data: T;
   213→  session_id?: string;
   214→  resource_id?: string;
   215→}
   216→
   217→export interface CommandAck {
   218→  ack: true;
   219→  action: string;
   220→  request_id?: string;
   221→  success: boolean;
   222→  error?: {
   223→    code: string;
   224→    message: string;
   225→  };
   226→}
   227→
   228→// =============================================================================
   229→// WebSocket Types (Client → Server)
   230→// =============================================================================
   231→
   232→export interface SubscribeCommand {
   233→  action: 'subscribe';
   234→  topics: string[];
   235→  request_id?: string;
   236→}
   237→
   238→export interface UnsubscribeCommand {
   239→  action: 'unsubscribe';
   240→  topics: string[];
   241→  request_id?: string;
   242→}
   243→
   244→export interface SessionMessageCommand {
   245→  action: 'session.message';
   246→  session_id: string;
   247→  payload: { content: string };
   248→  request_id?: string;
   249→}
   250→
   251→export interface SessionInteractionResponseCommand {
   252→  action: 'session.interaction_response';
   253→  session_id: string;
   254→  payload: {
   255→    interaction_id: string;
   256→    response: unknown;
   257→  };
   258→  request_id?: string;
   259→}
   260→
   261→export interface PongCommand {
   262→  action: 'pong';
   263→  ping_timestamp: string;
   264→  request_id?: string;
   265→}
   266→
   267→export type HubCommand =
   268→  | SubscribeCommand
   269→  | UnsubscribeCommand
   270→  | SessionMessageCommand
   271→  | SessionInteractionResponseCommand
   272→  | PongCommand;
   273→
