   660→
   661→// =============================================================================
   662→// Session Update Event Helpers
   663→// =============================================================================
   664→
   665→/**
   666→ * Raw ACP SessionUpdate structure from the Hub via sessions:updates topic.
   667→ */
   668→export interface AcpSessionUpdate {
   669→  sessionUpdate: string;
   670→  content?: { type: string; text?: string };
   671→  toolCallId?: string;
   672→  name?: string;
   673→  title?: string;
   674→  rawInput?: unknown;
   675→  rawOutput?: unknown;
   676→  status?: 'pending' | 'in_progress' | 'completed' | 'failed' | null;
   677→  _meta?: Record<string, unknown>;
   678→  [key: string]: unknown;
   679→}
   680→
   681→/**
   682→ * Session update event data from sessions:updates topic.
   683→ */
   684→export interface SessionUpdateEventData {
   685→  sessionId: string;
   686→  update: AcpSessionUpdate;
   687→  timestamp: number;
   688→}
   689→
   690→/**
   691→ * Check if a sessions:updates event is a session event update (vs status/watermark update).
   692→ */
   693→export function isSessionEventUpdate(data: unknown): data is SessionUpdateEventData {
   694→  return (
   695→    typeof data === 'object' &&
   696→    data !== null &&
   697→    'sessionId' in data &&
   698→    'update' in data &&
   699→    typeof (data as SessionUpdateEventData).update === 'object' &&
   700→    (data as SessionUpdateEventData).update !== null &&
   701→    'sessionUpdate' in (data as SessionUpdateEventData).update
   702→  );
   703→}
   704→
```