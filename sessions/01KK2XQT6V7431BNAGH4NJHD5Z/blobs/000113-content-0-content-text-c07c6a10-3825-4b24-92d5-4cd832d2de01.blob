   582→// =============================================================================
   583→// Project Types
   584→// =============================================================================
   585→
   586→/**
   587→ * Actor representing who performed an action.
   588→ * Simplified version of @kynetic/shared ActorId for UI use.
   589→ */
   590→export type ProjectActorId =
   591→  | { kind: 'user'; id: string }
   592→  | { kind: 'system' }
   593→  | { kind: 'agent'; agentType: string };
   594→
   595→/**
   596→ * Project icon configuration.
   597→ * - 'emoji': A single emoji character (e.g., "🚀")
   598→ * - 'initials': 2-letter uppercase initials (e.g., "KY")
   599→ * - 'image': Path to an uploaded image
   600→ */
   601→export interface ProjectIcon {
   602→  type: 'emoji' | 'initials' | 'image';
   603→  value: string;
   604→}
   605→
   606→/**
   607→ * Project entity representing an isolated workspace.
   608→ * Projects contain their own kanban board, bound spokes, and sessions.
   609→ */
   610→export interface Project {
   611→  id: string;
   612→  name: string;
   613→  description?: string;
   614→  icon: ProjectIcon;
   615→  created_at: string;
   616→  created_by: ProjectActorId;
   617→  deleted_at?: string;
   618→}
   619→
   620→export interface ProjectListResponse {
   621→  projects: Project[];
   622→  total: number;
   623→}
   624→
   625→export interface ProjectResponse {
   626→  project: Project;
   627→}
   628→
   629→export interface ProjectCreateRequest {
   630→  name: string;
   631→  description?: string;
   632→  icon?: Partial<ProjectIcon>;
   633→}
   634→
   635→export interface ProjectUpdateRequest {
   636→  name?: string;
   637→  description?: string | null;
   638→  icon?: ProjectIcon;
   639→}
   640→
   641→/**
   642→ * WebSocket topic for project updates.
   643→ */
   644→export const TOPIC_PROJECTS_UPDATES = 'projects:updates';
   645→
   646→/**
   647→ * Project event data types for WebSocket events.
   648→ */
   649→export interface ProjectCreatedEventData {
   650→  project: Project;
   651→}
   652→
   653→export interface ProjectUpdatedEventData {
   654→  project: Project;
   655→}
   656→
   657→export interface ProjectDeletedEventData {
