   500→  pathSegments: string[],
   501→  value: unknown,
   502→  context: BlobWriteContext,
   503→): Promise<SessionBlobPointer> {
   504→  const content = stringifyPayload(value);
   505→  const bytes = Buffer.byteLength(content, "utf-8");
   506→  const sha256 = createHash("sha256").update(content).digest("hex");
   507→
   508→  const fieldLabel = normalizeFieldLabel(pathSegments);
   509→  const dryRunCounter = context.dryRunCounter ?? 0;
   510→  const fileName = context.dryRun
   511→    ? `${String(seq).padStart(6, "0")}-${fieldLabel}-dry-run-${String(dryRunCounter).padStart(4, "0")}.blob`
   512→    : `${String(seq).padStart(6, "0")}-${fieldLabel}-${randomUUID()}.blob`;
   513→  const relativePath = path.posix.join(BLOBS_DIR, fileName);
   514→  if (!context.dryRun) {
   515→    if (!context.ensuredDir) {
   516→      await fsPromises.mkdir(context.blobDir, { recursive: true });
   517→      context.ensuredDir = true;
   518→    }
   519→    const absolutePath = path.join(getSessionDir(specDir, sessionId), relativePath);
   520→    await fsPromises.writeFile(absolutePath, content, "utf-8");
   521→  }
   522→  context.createdBlobs = (context.createdBlobs ?? 0) + 1;
   523→  context.dryRunCounter = dryRunCounter + 1;
   524→
   525→  return {
   526→    path: relativePath,
   527→    bytes,
   528→    sha256,
   529→    truncated: true,
   530→    preview: toPreview(content),
   531→  };
   532→}
   533→
   534→async function externalizeOversizedPayloads(
   535→  specDir: string,
   536→  sessionId: string,
   537→  seq: number,
   538→  value: unknown,
   539→  pathSegments: string[],
   540→  context: BlobWriteContext,
   541→): Promise<unknown> {
   542→  if (isSessionBlobPointer(value)) {
   543→    return value;
   544→  }
   545→
   546→  if (shouldExternalizeField(pathSegments, value)) {
   547→    return createBlobPointer(specDir, sessionId, seq, pathSegments, value, context);
   548→  }
   549→
   550→  if (Array.isArray(value)) {
   551→    return Promise.all(
   552→      value.map((entry, idx) =>
   553→        externalizeOversizedPayloads(specDir, sessionId, seq, entry, [
   554→          ...pathSegments,
   555→          String(idx),
   556→        ], context),
   557→      ),
   558→    );
   559→  }
   560→
   561→  if (isRecord(value)) {
   562→    const next: Record<string, unknown> = {};
   563→    for (const [key, child] of Object.entries(value)) {
   564→      next[key] = await externalizeOversizedPayloads(
   565→        specDir,
   566→        sessionId,
   567→        seq,
   568→        child,
   569→        [...pathSegments, key],
   570→        context,
   571→      );
   572→    }
   573→    return next;
   574→  }
   575→
   576→  return value;
   577→}
   578→
   579→function resolveBlobAbsolutePath(
   580→  specDir: string,
   581→  sessionId: string,
   582→  relativePath: string,
   583→): string | null {
   584→  const sessionDir = path.resolve(getSessionDir(specDir, sessionId));
   585→  const absolutePath = path.resolve(sessionDir, relativePath);
   586→  if (
   587→    absolutePath === sessionDir ||
   588→    absolutePath.startsWith(`${sessionDir}${path.sep}`)
   589→  ) {
   590→    return absolutePath;
   591→  }
   592→  return null;
   593→}
   594→
   595→async function resolveBlobPointer(
   596→  specDir: string,
   597→  sessionId: string,
   598→  pointer: SessionBlobPointer,
   599→): Promise<ResolvedSessionBlobPointer> {
   600→  const absolutePath = resolveBlobAbsolutePath(specDir, sessionId, pointer.path);
   601→  if (!absolutePath) {
   602→    return { ...pointer, content: pointer.preview };
   603→  }
   604→
   605→  try {
   606→    const content = await fsPromises.readFile(absolutePath, "utf-8");
   607→    return { ...pointer, content };
   608→  } catch {
   609→    return { ...pointer, content: pointer.preview };
   610→  }
   611→}
   612→
   613→/**
   614→ * Resolve all blob pointers in a value tree to include full payload content.
   615→ *
   616→ * Default flows keep compact pointer objects (preview-only). This helper powers
   617→ * explicit on-demand blob resolution in session log commands.
   618→ */
   619→export async function resolveSessionBlobPointers(
   620→  specDir: string,
   621→  sessionId: string,
   622→  value: unknown,
   623→): Promise<unknown> {
   624→  if (isSessionBlobPointer(value)) {
   625→    return resolveBlobPointer(specDir, sessionId, value);
   626→  }
   627→
   628→  if (Array.isArray(value)) {
   629→    return Promise.all(
   630→      value.map((entry) => resolveSessionBlobPointers(specDir, sessionId, entry)),
   631→    );
   632→  }
   633→
   634→  if (isRecord(value)) {
   635→    const next: Record<string, unknown> = {};
   636→    for (const [key, child] of Object.entries(value)) {
   637→      next[key] = await resolveSessionBlobPointers(specDir, sessionId, child);
   638→    }
   639→    return next;
   640→  }
   641→
   642→  return value;
   643→}
   644→
   645→function extractLastEventSeq(content: string): number | null {
   646→  const lines = content.split("\n");
   647→  for (let i = lines.length - 1; i >= 0; i -= 1) {
   648→    const line = lines[i].trim();
   649→    if (line.length === 0) {
   650→      continue;
   651→    }
   652→
   653→    try {
   654→      const parsed = JSON.parse(line);
   655→      if (
   656→        isRecord(parsed) &&
   657→        typeof parsed.seq === "number" &&
   658→        Number.isInteger(parsed.seq) &&
   659→        parsed.seq >= 0
   660→      ) {
   661→        return parsed.seq;
   662→      }
   663→    } catch {
   664→      // Ignore malformed lines and continue scanning backward.
   665→    }
   666→  }
   667→
   668→  return null;
   669→}
   670→
   671→/**
   672→ * Get next sequence number from the last stored event.
   673→ *
   674→ * Reads a bounded tail slice for O(1) seq lookup; falls back to full scan only
   675→ * if the tail slice cannot be parsed (for example, partial line boundary).
   676→ */
   677→async function getNextEventSeq(
   678→  specDir: string,
   679→  sessionId: string,
   680→): Promise<number> {
   681→  const eventsPath = getSessionEventsPath(specDir, sessionId);
   682→
   683→  let fileHandle: fsPromises.FileHandle | null = null;
   684→  try {
   685→    fileHandle = await fsPromises.open(eventsPath, "r");
   686→    const stats = await fileHandle.stat();
   687→    if (stats.size === 0) {
   688→      return 0;
   689→    }
   690→
   691→    const readBytes = Math.min(stats.size, EVENT_SEQ_TAIL_READ_BYTES);
   692→    const startOffset = stats.size - readBytes;
   693→    const buffer = Buffer.alloc(readBytes);
   694→    await fileHandle.read(buffer, 0, readBytes, startOffset);
   695→
   696→    let tailContent = buffer.toString("utf-8");
   697→    if (startOffset > 0) {
   698→      // Drop potential partial first line from tail slice.
   699→      const firstNewline = tailContent.indexOf("\n");
   700→      tailContent = firstNewline === -1 ? "" : tailContent.slice(firstNewline + 1);
   701→    }
   702→
   703→    const tailSeq = extractLastEventSeq(tailContent);
   704→    if (tailSeq !== null) {
   705→      return tailSeq + 1;
   706→    }
   707→  } catch (error) {
   708→    if ((error as NodeJS.ErrnoException).code === "ENOENT") {
   709→      return 0;
   710→    }
   711→  } finally {
   712→    await fileHandle?.close().catch(() => undefined);
   713→  }
   714→
   715→  try {
   716→    const fullContent = await fsPromises.readFile(eventsPath, "utf-8");
   717→    const fullSeq = extractLastEventSeq(fullContent);
   718→    return fullSeq === null ? 0 : fullSeq + 1;
   719→  } catch {
   720→    return 0;
   721→  }
   722→}
   723→
   724→/**
   725→ * Append an event to a session's event log.
   726→ *
   727→ * AC-2: Appends JSON line to events.jsonl with auto-assigned ts and seq.
   728→ * AC-3: Uses atomic append (appendFileSync) for crash safety.
   729→ *
   730→ * Creates the session directory if it doesn't exist (lazy creation).
   731→ *
   732→ * Note: This function is not safe for concurrent access to the same session.
   733→ * The sequence number assignment has a race condition between reading the
   734→ * event count and appending the event. This is acceptable for CLI use
   735→ * (single-process, sequential event logging). If concurrent access is needed
   736→ * in the future, consider file locking or an in-memory counter per session.
   737→ *
   738→ * @param specDir - The .kspec directory path
   739→ * @param input - Event input (ts and seq are auto-assigned if not provided)
   740→ * @returns The appended event with auto-assigned fields
   741→ */
   742→export async function appendEvent(
   743→  specDir: string,
   744→  input: SessionEventInput,
   745→): Promise<SessionEvent> {
   746→  const sessionDir = getSessionDir(specDir, input.session_id);
   747→  const eventsPath = getSessionEventsPath(specDir, input.session_id);
   748→
   749→  // Ensure session directory exists (lazy creation)
   750→  await fsPromises.mkdir(sessionDir, { recursive: true });
   751→
   752→  // Derive next sequence number from the last stored event.
   753→  const seq = input.seq ?? (await getNextEventSeq(specDir, input.session_id));
   754→
   755→  // Build full event
   756→  const event: SessionEvent = {
   757→    ts: input.ts ?? Date.now(),
   758→    seq,
   759→    type: input.type,
   760→    session_id: input.session_id,
   761→    trace_id: input.trace_id,
   762→    data: input.data,
   763→  };
   764→
   765→  // AC: @session-events ac-8, ac-9 - Externalize oversized payload fields
   766→  // before writing to events.jsonl.
   767→  const externalizedData = await externalizeOversizedPayloads(
   768→    specDir,
   769→    input.session_id,
   770→    seq,
   771→    event.data,
   772→    [],
   773→    {
   774→      blobDir: getSessionBlobDir(specDir, input.session_id),
   775→      ensuredDir: false,
   776→    },
   777→  );
   778→
   779→  const eventWithGuardrails: SessionEvent = {
   780→    ...event,
   781→    data: externalizedData,
   782→  };
   783→
   784→  // Validate event
   785→  let validated = SessionEventSchema.parse(eventWithGuardrails);
   786→
   787→  // Event-line safety cap: if a single JSONL line is still too large after
   788→  // targeted field externalization, externalize the entire data payload.
   789→  let line = JSON.stringify(validated);
   790→  if (Buffer.byteLength(line, "utf-8") > EVENT_LINE_MAX_BYTES) {
   791→    const blobContext: BlobWriteContext = {
   792→      blobDir: getSessionBlobDir(specDir, input.session_id),
   793→      ensuredDir: false,
   794→    };
   795→    const fullDataPointer = await createBlobPointer(
   796→      specDir,
   797→      input.session_id,
   798→      seq,
   799→      [],
   800→      validated.data,
   801→      blobContext,
   802→    );
   803→    validated = SessionEventSchema.parse({
   804→      ...validated,
   805→      data: fullDataPointer,
   806→    });
   807→    line = JSON.stringify(validated);
   808→  }
   809→
   810→  // AC: @session-events ac-3 - Use synchronous append for crash safety
   811→  // This ensures the line is fully written before returning
   812→  fs.appendFileSync(eventsPath, `${line}\n`, "utf-8");
   813→
   814→  return validated;
   815→}
