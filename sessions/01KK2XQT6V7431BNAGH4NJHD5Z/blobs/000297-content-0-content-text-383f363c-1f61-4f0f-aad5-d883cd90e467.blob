   817→export interface CompactSessionEventsOptions {
   818→  dryRun?: boolean;
   819→  renameFn?: (
   820→    oldPath: string,
   821→    newPath: string,
   822→  ) => Promise<void>;
   823→}
   824→
   825→export type CompactSessionReason =
   826→  | "missing_events_file"
   827→  | "empty_events_file"
   828→  | "already_compacted"
   829→  | "compacted"
   830→  | "would_compact";
   831→
   832→export interface CompactSessionEventsResult {
   833→  events_processed: number;
   834→  blobs_created: number;
   835→  bytes_before: number;
   836→  bytes_after: number;
   837→  bytes_reclaimed: number;
   838→  changed: boolean;
   839→  reason: CompactSessionReason;
   840→  dry_run: boolean;
   841→}
   842→
   843→/**
   844→ * Retroactively compact a session event log by externalizing oversized payloads.
   845→ *
   846→ * Reuses the same two-stage externalization pipeline as appendEvent():
   847→ * 1) Field-level externalization for known large payload fields
   848→ * 2) Full-data externalization if a line still exceeds EVENT_LINE_MAX_BYTES
   849→ *
   850→ * Writes are atomic (temp-file then rename). When dryRun is enabled, no files
   851→ * are modified and no blob files are written.
   852→ */
   853→export async function compactSessionEvents(
   854→  specDir: string,
   855→  sessionId: string,
   856→  options: CompactSessionEventsOptions = {},
   857→): Promise<CompactSessionEventsResult> {
   858→  const dryRun = options.dryRun === true;
   859→  const renameFn = options.renameFn ?? fsPromises.rename;
   860→  const eventsPath = getSessionEventsPath(specDir, sessionId);
   861→  let content: string;
   862→
   863→  try {
   864→    content = await fsPromises.readFile(eventsPath, "utf-8");
   865→  } catch (err: unknown) {
   866→    if (err instanceof Error && "code" in err && err.code === "ENOENT") {
   867→      return {
   868→        events_processed: 0,
   869→        blobs_created: 0,
   870→        bytes_before: 0,
   871→        bytes_after: 0,
   872→        bytes_reclaimed: 0,
   873→        changed: false,
   874→        reason: "missing_events_file",
   875→        dry_run: dryRun,
   876→      };
   877→    }
   878→    throw err;
   879→  }
   880→
   881→  const bytesBefore = Buffer.byteLength(content, "utf-8");
   882→  const sourceLines = content
   883→    .split("\n")
   884→    .filter((line) => line.trim().length > 0);
   885→
   886→  if (sourceLines.length === 0) {
   887→    return {
   888→      events_processed: 0,
   889→      blobs_created: 0,
   890→      bytes_before: bytesBefore,
   891→      bytes_after: bytesBefore,
   892→      bytes_reclaimed: 0,
   893→      changed: false,
   894→      reason: "empty_events_file",
   895→      dry_run: dryRun,
   896→    };
   897→  }
   898→
   899→  const blobContext: BlobWriteContext = {
   900→    blobDir: getSessionBlobDir(specDir, sessionId),
   901→    ensuredDir: false,
   902→    dryRun,
   903→    createdBlobs: 0,
   904→    dryRunCounter: 0,
   905→  };
   906→
   907→  const compactedLines: string[] = [];
   908→  for (let i = 0; i < sourceLines.length; i += 1) {
   909→    const line = sourceLines[i];
   910→    let parsed: unknown;
   911→    try {
   912→      parsed = JSON.parse(line);
   913→    } catch (err: unknown) {
   914→      throw new Error(
   915→        `Invalid JSON in events log at line ${i + 1}: ${err instanceof Error ? err.message : String(err)}`,
   916→      );
   917→    }
   918→
   919→    const event = SessionEventSchema.parse(parsed);
   920→    const externalizedData = await externalizeOversizedPayloads(
   921→      specDir,
   922→      sessionId,
   923→      event.seq,
   924→      event.data,
   925→      [],
   926→      blobContext,
   927→    );
   928→
   929→    let validated = SessionEventSchema.parse({
   930→      ...event,
   931→      data: externalizedData,
   932→    });
   933→
   934→    let compactedLine = JSON.stringify(validated);
   935→    if (Buffer.byteLength(compactedLine, "utf-8") > EVENT_LINE_MAX_BYTES) {
   936→      const fullDataPointer = await createBlobPointer(
   937→        specDir,
   938→        sessionId,
   939→        event.seq,
   940→        [],
   941→        validated.data,
   942→        blobContext,
   943→      );
   944→      validated = SessionEventSchema.parse({
   945→        ...validated,
   946→        data: fullDataPointer,
   947→      });
   948→      compactedLine = JSON.stringify(validated);
   949→    }
   950→
   951→    compactedLines.push(compactedLine);
   952→  }
   953→
   954→  const compactedContent = `${compactedLines.join("\n")}\n`;
   955→  const changed = compactedContent !== content;
   956→  const bytesAfter = changed ? Buffer.byteLength(compactedContent, "utf-8") : bytesBefore;
   957→
   958→  if (!changed) {
   959→    return {
   960→      events_processed: sourceLines.length,
   961→      blobs_created: 0,
   962→      bytes_before: bytesBefore,
   963→      bytes_after: bytesBefore,
   964→      bytes_reclaimed: 0,
   965→      changed: false,
   966→      reason: "already_compacted",
   967→      dry_run: dryRun,
   968→    };
   969→  }
   970→
   971→  if (!dryRun) {
   972→    const sessionDir = getSessionDir(specDir, sessionId);
   973→    const tmpPath = path.join(
   974→      sessionDir,
   975→      `.${EVENTS_FILE}.${process.pid}.${Date.now()}.tmp`,
   976→    );
   977→    try {
   978→      await fsPromises.writeFile(tmpPath, compactedContent, "utf-8");
   979→      await renameFn(tmpPath, eventsPath);
   980→    } catch (err) {
   981→      await fsPromises.unlink(tmpPath).catch(() => undefined);
   982→      throw err;
   983→    }
   984→  }
   985→
   986→  return {
   987→    events_processed: sourceLines.length,
   988→    blobs_created: blobContext.createdBlobs ?? 0,
   989→    bytes_before: bytesBefore,
   990→    bytes_after: bytesAfter,
   991→    bytes_reclaimed: Math.max(0, bytesBefore - bytesAfter),
   992→    changed: true,
   993→    reason: dryRun ? "would_compact" : "compacted",
   994→    dry_run: dryRun,
   995→  };
   996→}
