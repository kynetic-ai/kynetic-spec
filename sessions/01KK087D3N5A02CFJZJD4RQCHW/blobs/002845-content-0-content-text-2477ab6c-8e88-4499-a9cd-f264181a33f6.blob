```
     1→<script lang="ts">
     2→	// AC: @web-dashboard ac-4, ac-5, ac-9, ac-10, ac-33
     3→	// AC: @multi-directory-daemon ac-27 - Reload on project change
     4→	// AC: @gh-pages-export ac-16 - Disable Start Task in static mode
     5→	import { page } from '$app/stores';
     6→	import { base } from '$app/paths';
     7→	import { onMount, onDestroy, flushSync } from 'svelte';
     8→	import type { TaskSummary, TaskDetail, BroadcastEvent } from '@kynetic-ai/shared';
     9→	import TaskFilters from '$lib/components/TaskFilters.svelte';
    10→	import TaskList from '$lib/components/TaskList.svelte';
    11→	import { fetchTasks, fetchTask, startTask, addTaskNote } from '$lib/api';
    12→	import { subscribe, unsubscribe, on, off } from '$lib/stores/connection.svelte';
    13→	import { isStaticMode, ReadOnlyModeError } from '$lib/stores/mode.svelte';
    14→	import { Button } from '$lib/components/ui/button';
    15→	import { Badge } from '$lib/components/ui/badge';
    16→	import { Textarea } from '$lib/components/ui/textarea';
    17→	import { Separator } from '$lib/components/ui/separator';
    18→	import * as Tooltip from '$lib/components/ui/tooltip';
    19→	import XIcon from '@lucide/svelte/icons/x';
    20→	import { getProjectVersion } from '$lib/stores/project.svelte';
    21→
    22→	let tasks = $state<TaskSummary[]>([]);
    23→	let total = $state(0);
    24→	let loading = $state(true);
    25→	let error = $state('');
    26→	let updatedTaskIds = $state<Set<string>>(new Set());
    27→
    28→	// Use $state with an object for panel state to ensure deep reactivity
    29→	let panel = $state<{ open: boolean; task: TaskDetail | null }>({
    30→		open: false,
    31→		task: null
    32→	});
    33→
    34→	let noteContent = $state('');
    35→	let isSubmitting = $state(false);
    36→	let panelError = $state('');
    37→
    38→	// Reactive: re-fetch when URL params change
    39→	let filterParams = $derived({
    40→		status: $page.url.searchParams.get('status') || undefined,
    41→		type: $page.url.searchParams.get('type') || undefined,
    42→		tag: $page.url.searchParams.get('tag') || undefined,
    43→		assignee: $page.url.searchParams.get('assignee') || undefined,
    44→		automation: $page.url.searchParams.get('automation') || undefined,
    45→		limit: 50,
    46→		offset: 0
    47→	});
    48→
    49→	// Track the last processed ref to avoid infinite loops
    50→	let lastProcessedRef = $state('');
    51→
    52→	$effect(() => {
    53→		// Re-fetch when filterParams changes - explicitly access all properties for dependency tracking
    54→		const { status, type, tag, assignee, automation, limit, offset } = filterParams;
    55→		loadTasks();
    56→	});
    57→
    58→	// AC: @multi-directory-daemon ac-27 - Reload data when project changes
    59→	$effect(() => {
    60→		const version = getProjectVersion();
    61→		if (version > 0) {
    62→			// Only reload if version has been incremented (not on initial load)
    63→			loadTasks();
    64→		}
    65→	});
    66→
    67→	// AC: Open task detail when URL has ref param
    68→	$effect(() => {
    69→		const urlRef = $page.url.searchParams.get('ref');
    70→		if (urlRef && urlRef !== lastProcessedRef) {
    71→			lastProcessedRef = urlRef;
    72→			handleSelectTask(urlRef);
    73→		}
    74→	});
    75→
    76→	async function loadTasks() {
    77→		loading = true;
    78→		error = '';
    79→
    80→		try {
    81→			const response = await fetchTasks(filterParams);
    82→			tasks = response.items;
    83→			total = response.total;
    84→		} catch (err) {
    85→			error = err instanceof Error ? err.message : 'Failed to load tasks';
    86→			console.error('Error loading tasks:', err);
    87→		} finally {
    88→			loading = false;
    89→		}
    90→	}
    91→
    92→	async function handleSelectTask(taskId: string) {
    93→		console.log('[TasksPage] handleSelectTask called for:', taskId);
    94→		try {
    95→			console.log('[TasksPage] Fetching task details...');
    96→			const task = await fetchTask(taskId);
    97→			console.log('[TasksPage] Task fetched:', task?.title);
    98→			// Update panel state using flushSync to ensure synchronous DOM update
    99→			flushSync(() => {
   100→				panel.task = task;
   101→				panel.open = true;
   102→			});
   103→			console.log('[TasksPage] panel.open set to true, panel.task:', panel.task?.title);
   104→		} catch (err) {
   105→			error = err instanceof Error ? err.message : 'Failed to load task details';
   106→			console.error('[TasksPage] Error loading task:', err);
   107→		}
   108→	}
   109→
   110→	// Legacy event handler for backwards compatibility
   111→	function handleSelectTaskEvent(event: CustomEvent<string>) {
   112→		handleSelectTask(event.detail);
   113→	}
   114→
   115→	function handleCloseDetail() {
   116→		panel.open = false;
   117→		panel.task = null;
   118→		noteContent = '';
   119→		panelError = '';
   120→		lastProcessedRef = ''; // Reset so we can reopen same task if URL param set again
   121→	}
   122→
   123→	// Handle clicking outside the panel
   124→	function handleOverlayClick(e: MouseEvent) {
   125→		if (e.target === e.currentTarget) {
   126→			handleCloseDetail();
   127→		}
   128→	}
   129→
   130→	// Handle escape key
   131→	function handleKeydown(e: KeyboardEvent) {
   132→		if (e.key === 'Escape' && panel.open) {
   133→			handleCloseDetail();
   134→		}
   135→	}
   136→
   137→	async function handleStartTask() {
   138→		if (!panel.task) return;
   139→
   140→		// AC: @gh-pages-export ac-16, ac-18 - Check static mode
   141→		if (isStaticMode()) {
   142→			panelError = 'Cannot start task in read-only mode. Use the kspec CLI.';
   143→			return;
   144→		}
   145→
   146→		isSubmitting = true;
   147→		panelError = '';
   148→
   149→		try {
   150→			await startTask(panel.task._ulid);
   151→			// Reload task to get updated status
   152→			const updated = await fetchTask(panel.task._ulid);
   153→			panel.task = updated;
   154→			loadTasks();
   155→		} catch (err) {
   156→			// AC: @gh-pages-export ac-18 - Graceful error message
   157→			if (err instanceof ReadOnlyModeError) {
   158→				panelError = err.message;
   159→			} else {
   160→				panelError = err instanceof Error ? err.message : 'Failed to start task';
   161→			}
   162→		} finally {
   163→			isSubmitting = false;
   164→		}
   165→	}
   166→
   167→	async function handleAddNote() {
   168→		if (!panel.task || !noteContent.trim()) return;
   169→
   170→		// AC: @gh-pages-export ac-18 - Check static mode
   171→		if (isStaticMode()) {
   172→			panelError = 'Cannot add notes in read-only mode. Use the kspec CLI.';
   173→			return;
   174→		}
   175→
   176→		isSubmitting = true;
   177→		panelError = '';
   178→
   179→		try {
   180→			await addTaskNote(panel.task._ulid, noteContent);
   181→			noteContent = '';
   182→			// Reload task to get updated notes
   183→			const updated = await fetchTask(panel.task._ulid);
   184→			panel.task = updated;
   185→			loadTasks();
   186→		} catch (err) {
   187→			// AC: @gh-pages-export ac-18 - Graceful error message
   188→			if (err instanceof ReadOnlyModeError) {
   189→				panelError = err.message;
   190→			} else {
   191→				panelError = err instanceof Error ? err.message : 'Failed to add note';
   192→			}
   193→		} finally {
   194→			isSubmitting = false;
   195→		}
   196→	}
   197→
   198→	function formatDate(dateStr: string): string {
   199→		const date = new Date(dateStr);
   200→		return new Intl.DateTimeFormat('en-US', {
   201→			year: 'numeric',
   202→			month: 'short',
   203→			day: 'numeric',
   204→			hour: '2-digit',
   205→			minute: '2-digit'
   206→		}).format(date);
   207→	}
   208→
   209→	function getStatusColor(status: string): string {
   210→		const colors: Record<string, string> = {
   211→			pending: 'bg-amber-500',
   212→			in_progress: 'bg-orange-500',
   213→			pending_review: 'bg-blue-500',
   214→			needs_work: 'bg-yellow-500',
   215→			blocked: 'bg-red-500',
   216→			completed: 'bg-emerald-500',
   217→			cancelled: 'bg-gray-400'
   218→		};
   219→		return colors[status] || 'bg-gray-500';
   220→	}
   221→
   222→	function formatStatus(status: string): string {
   223→		const labels: Record<string, string> = {
   224→			pending: 'Pending',
   225→			in_progress: 'In Progress',
   226→			pending_review: 'Pending Review',
   227→			needs_work: 'Needs Work',
   228→			blocked: 'Blocked',
   229→			completed: 'Completed',
   230→			cancelled: 'Cancelled'
   231→		};
   232→		return labels[status] || status;
   233→	}
   234→
   235→	// AC: @web-dashboard ac-33 - Handle WebSocket task updates
   236→	function handleTaskUpdate(event: BroadcastEvent) {
   237→		console.log('[TasksPage] Task update received:', event);
   238→
   239→		// Mark task as updated for highlight animation
   240→		if (event.data?.ulid) {
   241→			updatedTaskIds.add(event.data.ulid);
   242→			updatedTaskIds = new Set(updatedTaskIds);
   243→
   244→			// Remove highlight after 3s
   245→			setTimeout(() => {
   246→				updatedTaskIds.delete(event.data.ulid);
   247→				updatedTaskIds = new Set(updatedTaskIds);
   248→			}, 3000);
   249→		}
   250→
   251→		// Reload tasks list
   252→		loadTasks();
   253→
   254→		// Reload selected task if it's the one that updated
   255→		if (panel.task && event.data?.ulid === panel.task._ulid) {
   256→			fetchTask(panel.task._ulid)
   257→				.then((updated) => {
   258→					panel.task = updated;
   259→				})
   260→				.catch((err) => {
   261→					console.error('Error reloading task:', err);
   262→				});
   263→		}
   264→	}
   265→
   266→	onMount(() => {
   267→		loadTasks();
   268→
   269→		// AC: @web-dashboard ac-32, ac-33 - Subscribe to task updates
   270→		subscribe(['tasks']);
   271→		on('tasks', handleTaskUpdate);
   272→	});
   273→
   274→	onDestroy(() => {
   275→		// Clean up subscription
   276→		off('tasks', handleTaskUpdate);
   277→		unsubscribe(['tasks']);
   278→	});
   279→</script>
   280→
   281→<svelte:window onkeydown={handleKeydown} />
   282→
   283→<div class="flex flex-col gap-6 p-6">
   284→	<div>
   285→		<h1 class="text-3xl font-bold mb-2">Tasks</h1>
   286→		{#if !loading}
   287→			<p class="text-muted-foreground">
   288→				Showing {tasks.length} of {total} tasks
   289→			</p>
   290→		{/if}
   291→	</div>
   292→
   293→	<TaskFilters />
   294→
   295→	{#if error}
   296→		<div class="bg-destructive/10 text-destructive p-4 rounded-lg" data-testid="error-message" role="alert">
   297→			{error}
   298→		</div>
   299→	{/if}
   300→
   301→	{#if loading}
   302→		<div class="flex justify-center items-center py-12">
   303→			<p class="text-muted-foreground">Loading tasks...</p>
   304→		</div>
   305→	{:else}
   306→		<!-- AC: @web-dashboard ac-33 -->
   307→		<TaskList {tasks} {updatedTaskIds} onSelectTask={handleSelectTask} on:select={handleSelectTaskEvent} />
   308→	{/if}
   309→</div>
   310→
   311→<!-- Inline Task Detail Panel - AC: @web-dashboard ac-5, ac-6, ac-7, ac-8 -->
   312→{#if panel.open && panel.task}
   313→	<div
   314→		class="fixed inset-0 z-50 bg-black/50"
   315→		onclick={handleOverlayClick}
   316→		onkeydown={(e) => e.key === 'Enter' && handleCloseDetail()}
   317→		role="button"
   318→		tabindex="-1"
   319→		aria-label="Close panel"
   320→	>
   321→		<!-- Panel -->
   322→		<div
   323→			class="fixed inset-y-0 right-0 z-50 w-3/4 max-w-lg bg-background shadow-lg border-l overflow-y-auto"
   324→			data-testid="task-detail-panel"
   325→			role="dialog"
   326→			aria-modal="true"
   327→			tabindex="0"
   328→			onclick={(e) => e.stopPropagation()}
   329→			onkeydown={(e) => e.stopPropagation()}
   330→		>
   331→			<!-- Header -->
   332→			<div class="flex items-center justify-between p-6 border-b">
   333→				<h2 class="text-lg font-semibold" data-testid="task-description">{panel.task.title}</h2>
   334→				<button
   335→					onclick={handleCloseDetail}
   336→					class="rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
   337→				>
   338→					<XIcon class="size-4" />
   339→					<span class="sr-only">Close</span>
   340→				</button>
   341→			</div>
   342→
   343→			<!-- Content -->
   344→			<div class="flex flex-col gap-4 p-6">
   345→				<!-- Status and Priority -->
   346→				<div class="flex gap-2 items-center">
   347→					<Badge data-testid="task-status-badge" class={getStatusColor(panel.task.status)}>{formatStatus(panel.task.status)}</Badge>
   348→					<Badge variant="outline">Priority: {panel.task.priority}</Badge>
   349→					{#if panel.task.type !== 'task'}
   350→						<Badge variant="outline">{panel.task.type}</Badge>
   351→					{/if}
   352→				</div>
   353→
   354→				<!-- Spec Reference -->
   355→				<!-- AC: @web-dashboard ac-6 -->
   356→				{#if panel.task.spec_ref}
   357→					<div data-testid="task-spec-ref-link">
   358→						<p class="text-sm font-medium mb-1">Spec Reference:</p>
   359→						<a
   360→							href="{base}/specs?ref={encodeURIComponent(panel.task.spec_ref)}"
   361→							class="text-sm text-primary hover:underline"
   362→						>
   363→							{panel.task.spec_ref}
   364→						</a>
   365→					</div>
   366→				{/if}
   367→
   368→				<!-- Tags -->
   369→				{#if panel.task.tags?.length > 0}
   370→					<div>
   371→						<p class="text-sm font-medium mb-1">Tags:</p>
   372→						<div class="flex flex-wrap gap-1">
   373→							{#each panel.task.tags as tag}
   374→								<Badge variant="secondary">{tag}</Badge>
   375→							{/each}
   376→						</div>
   377→					</div>
   378→				{/if}
   379→
   380→				<!-- Dependencies -->
   381→				<div data-testid="task-dependencies">
   382→					{#if panel.task.depends_on?.length > 0}
   383→						<p class="text-sm font-medium mb-1">Dependencies:</p>
   384→						<ul class="text-sm space-y-1">
   385→							{#each panel.task.depends_on as dep}
   386→								<li>
   387→									<a href="{base}/tasks?ref={encodeURIComponent(dep)}" class="text-primary hover:underline">
   388→										{dep}
   389→									</a>
   390→								</li>
   391→							{/each}
   392→						</ul>
   393→					{:else}
   394→						<p class="text-sm text-muted-foreground">No dependencies</p>
   395→					{/if}
   396→				</div>
   397→
   398→				<!-- Blocked By -->
   399→				{#if panel.task.blocked_by?.length > 0}
   400→					<div>
   401→						<p class="text-sm font-medium mb-1 text-destructive">Blocked By:</p>
   402→						<ul class="text-sm space-y-1">
   403→							{#each panel.task.blocked_by as blocker}
   404→								<li class="text-muted-foreground">{blocker}</li>
   405→							{/each}
   406→						</ul>
   407→					</div>
   408→				{/if}
   409→
   410→				<Separator />
   411→
   412→				<!-- Actions -->
   413→				<!-- AC: @web-dashboard ac-7 -->
   414→				<!-- AC: @gh-pages-export ac-16 - Disabled with tooltip in static mode -->
   415→				{#if panel.task.status === 'pending'}
   416→					<div>
   417→						{#if isStaticMode()}
   418→							<Tooltip.Root>
   419→								<Tooltip.Trigger>
   420→									{#snippet child({ props })}
   421→										<Button
   422→											{...props}
   423→											data-testid="start-task-button"
   424→											disabled={true}
   425→											class="w-full"
   426→										>
   427→											Start Task
   428→										</Button>
   429→									{/snippet}
   430→								</Tooltip.Trigger>
   431→								<Tooltip.Content>
   432→									<p>Read-only mode - use CLI to start task</p>
   433→								</Tooltip.Content>
   434→							</Tooltip.Root>
   435→						{:else}
   436→							<Button data-testid="start-task-button" onclick={handleStartTask} disabled={isSubmitting} class="w-full">
   437→								{isSubmitting ? 'Starting...' : 'Start Task'}
   438→							</Button>
   439→						{/if}
   440→					</div>
   441→				{/if}
   442→
   443→				{#if panelError}
   444→					<p class="text-sm text-destructive">{panelError}</p>
   445→				{/if}
   446→
   447→				<Separator />
   448→
   449→				<!-- Todos -->
   450→				<div data-testid="task-todos">
   451→					{#if panel.task.todos && panel.task.todos.length > 0}
   452→						<p class="text-sm font-medium mb-2">Todos:</p>
   453→						<ul class="space-y-2">
   454→							{#each panel.task.todos as todo}
   455→								<li class="flex items-start gap-2 text-sm">
   456→									<span class="mt-0.5">
   457→										{#if todo.status === 'completed'}
   458→											✅
   459→										{:else if todo.status === 'in_progress'}
   460→											⏳
   461→										{:else}
   462→											⏸️
   463→										{/if}
   464→									</span>
   465→									<span class:line-through={todo.status === 'completed'}>
   466→										{todo.content}
   467→									</span>
   468→								</li>
   469→							{/each}
   470→						</ul>
   471→					{:else}
   472→						<p class="text-sm text-muted-foreground">No todos</p>
   473→					{/if}
   474→				</div>
   475→
   476→				<Separator />
   477→
   478→				<!-- Notes -->
   479→				<!-- AC: @web-dashboard ac-5 -->
   480→				<div data-testid="task-notes">
   481→					<p class="text-sm font-medium mb-2">Notes ({panel.task.notes?.length ?? 0}):</p>
   482→
   483→					<!-- Add Note Form -->
   484→					<!-- AC: @web-dashboard ac-8 -->
   485→					<!-- AC: @gh-pages-export ac-18 - Disabled in static mode -->
   486→					{#if !isStaticMode()}
   487→						<div class="mb-4 space-y-2" data-testid="add-note-form">
   488→							<Textarea
   489→								placeholder="Add a note..."
   490→								bind:value={noteContent}
   491→								disabled={isSubmitting}
   492→								rows={3}
   493→								data-testid="note-textarea"
   494→							/>
   495→							<Button
   496→								onclick={handleAddNote}
   497→								disabled={isSubmitting || !noteContent.trim()}
   498→								size="sm"
   499→								data-testid="add-note-button"
   500→							>
   501→								{isSubmitting ? 'Adding...' : 'Add Note'}
   502→							</Button>
   503→						</div>
   504→					{/if}
   505→
   506→					<!-- Notes List -->
   507→					<div class="space-y-4" data-testid="task-notes-list">
   508→						{#each panel.task.notes ?? [] as note}
   509→							<div class="border rounded-lg p-3" data-testid="note-item">
   510→								<div class="flex justify-between items-start mb-2">
   511→									<span class="text-xs text-muted-foreground">{note.author}</span>
   512→									<span class="text-xs text-muted-foreground" data-testid="note-timestamp">{formatDate(note.created_at)}</span>
   513→								</div>
   514→								<p class="text-sm whitespace-pre-wrap">{note.content}</p>
   515→							</div>
   516→						{/each}
   517→					</div>
   518→				</div>
   519→			</div>
   520→		</div>
   521→	</div>
   522→{/if}
   523→
```